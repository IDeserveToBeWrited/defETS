#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Driving Through Complex Turns"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In this scenario, we'll explore manoeuvring the trailer through a short obstacle course with more complex turns."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "First Turns"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Driving Through a Narrow Passage"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Tight 90 Degree Turn"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Driving Around the Barriers"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Ahead are a variety of complex corners and obstacles.<br>Take everything you've learned so far into account and it shouldn't be too difficult."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "The road markings can help give you an idea of how to proceed through each set of obstacles."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Keep the tractor to the outside of the corner. <br>You'll need to swing wide as the trailer follows a shorter path."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "The next corner is an easy 90 degree turn. <br> Once again, keep the truck to the outside of the turn and utilize all the space available to you."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Take your time here. The course opens up, but you will still need to be precise."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Keep a wide berth around the barriers."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Take care as you enter this narrow section. <br>Swing the tractor wide well before you enter to set your trailer up for entry."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "The final 90 degree turn is much sharper than the first, but there is plenty of room if you use your space wisely."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Stop in the designated area, then secure the truck and switch off the engine."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Remember to utilize the road markings to help you navigate the course.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Using your mirrors will also help you to navigate the course safely. You must always be aware of how the trailer is tracking behind you.<br><br><font face=/font/big_bold.font>Proceed through the first corner. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observe the trailer as you exit the turn and prepare to enter the next one.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Proceed through the next turn. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Remember to observe your trailer to ensure you are clear of the obstacles around you before turning the truck.<br><br><font face=/font/big_bold.font>Continue around the barrier obstacle ahead. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "When your trailer is clear of the barrier, turn hard to the passenger's side to line yourself up for the narrow passage. <br><br><font face=/font/big_bold.font>Proceed towards the narrow passage.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "This section will require very precise driving. Take your time and use your mirrors.<br><br><font face=/font/big_bold.font>Stay towards the outside of each corner. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "This turn is very sharp, but you can utilize all the space in front of you to clear it easily.<br><br><font face=/font/big_bold.font>Make the final turn. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Advanced Training Course - Trailer"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "In the final scenario of Chapter 3, we'll take a drive on a longer training course with a variety of different turns to see how well you've learned to manoeuvre with a trailer."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Dogleg Turn"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVE THIS GOAL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Median Crossover"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "First Slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Second Slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Roundabout"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Straight Section"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Tight Turn"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Final Turns"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Driving to Parking Spot"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "In this scenario, you'll face a variety of different turns to help you get used to driving with a trailer. Stay focused, adjust your speed to each situation, and make full use of the space available on the training course."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "The first turn is a dogleg turn - two turns in one. You'll have to set up for a left turn, but transition to a right turn in the middle of the manoeuvre."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "This next turn crosses you over to the other side of the median. It's not particularly difficult but you will need to watch that you leave enough space for your trailer."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Next you'll have to negotiate a tight slalom through the concrete barriers. Go slow and use your mirrors, and make sure you swing wide enough so your trailer can clear the barriers."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "At this point, you'll enter another slalom complimented by extra cones at the apex of each curve <br>Be sure not to hit any of them!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Next are a couple of easy corners on your way to the roundabout."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Use the straight section to prepare for entering the roundabout. Stay to the outside before you enter it."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Enter the roundabout and watch the placement of your trailer. It will track differently once you are inside the roundabout compared to how you entered."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Exit the roundabout and drive on to the next set of turns."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "REMOVE THIS CUTSCENE"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "The turn here is extremely sharp. Take it slow and use the space around you smartly. Be mindful of the trailer's tail swing as well."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "As you drive through the next few turns, remember to try and set yourself up for the next turn as you exit the previous one."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Don't rush the final corner. It looks easy, but there is less room to manoeuvre than there appears to be."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Stop in the designated area, secure the truck and shut down the engine."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Accelerate towards the first turn. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "The first turn is an easy dogleg turn.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "REMOVE THIS CHECK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Ahead the course continues on the left of the median.<br><br><font face=/font/big_bold.font>Make your way through the crossover. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manoeuvre through the barriers and remember to watch your trailer.<br><br><font face=/font/big_bold.font>Drive through the slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "This slalom is more straightforward, but the traffic cones make it significantly tighter.<br><br><font face=/font/big_bold.font>Drive through the slalom and avoid hitting any cones. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Ahead are a couple of easy corners, you'll still need to set up properly to keep your trailer away from the inside barriers.<br><br><font face=/font/big_bold.font>Make the turns. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "You're approaching a roundabout. Remember to leave enough room for your trailer not only when entering and exiting, but also as you drive through it.<br><br><font face=/font/big_bold.font>Drive through the roundabout. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "There's short straight section ahead of you, you can pick up a bit of speed if you like.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "The turn here is extremely sharp. Go slow, use all the space available to you, and keep your trailer's tail swing in mind. <br><br><font face=/font/big_bold.font>Drive through the sharp turn. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "The last few turns are straight forward. Remember to keep your trailer in mind.<br><br><font face=/font/big_bold.font>Continue on. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Continue towards the final parking spot. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

