#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Stopping Close to an Obstacle"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "In this scenario, we'll talk about the front mirror - its location and how to utilize it effectively to stop close to an obstacle in front."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Check the Front Mirror"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Understanding it's Function"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Stopping Near the Obstacle"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Trucks have a large blind spot in the area in front of the tractor. It's easy to lose sight of a pedestrian or even a car in this area, so trucks are equipped with a front mirror that can be seen through the windscreen."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "The front mirror is designed to give the driver a view into this blind spot.<br>It is an essential tool to ensure you don't collide with any obstacles when manoeuvring in tight spaces."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Start driving, proceed towards the barrier ahead of you, then slow down as you approach it.<br>Keep an eye on the front mirror."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Stop between the line and the obstacle."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "In this scenario, we'll learn to use the front mirror shown in the diagram.<br><br><font face=/font/big_bold.font>Look through the top portion of the windscreen to see it.</font>@@aca_goal_tip@@ You have to be inside the vehicle."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "The front mirror allows you to see into the blind spot in front of the truck. It can help you to be safe and precise in your driving.<br><br>If you're not satisfied with the adjustment, open '@@adjust_link_t@@' (can be accessed via the pause menu) to adjust it to your liking.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to continue. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Straight ahead of the truck there is a marked spot. You'll notice that there's an obstacle on the other side of the spot; when you're near it, drive very slowly and check the distance to the obstacle in the front mirror.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "The truck still isn't ready to move, maybe you've forgotten something?<br><br>Is the engine on? Have you released the parking brake?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Drive towards the parking spot. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Stop the front of the truck between the obstacle and the painted road marking. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

