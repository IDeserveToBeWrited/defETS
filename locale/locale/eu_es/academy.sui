#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Basic Controls and Movement"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Learn basic vehicle controls and how to move the truck in forward and reverse."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 1: @@aca_chapter_book1_1_title@@.<br><br>You have learned how to prepare the truck before driving,<br>forward and reverse driving and how to use lights and wipers.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Basic Manoeuvres"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Learn to drive, manoeuvre and park with a tractor unit. Explore the purpose of each type of mirror and how to use it."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book1_2_title@@.<br><br>You have learned how to utilize each mirror on the truck, check the space around the truck before moving, and perform both basic and advanced manoeuvres.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manoeuvring with a Trailer"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Learn to connect to and manoeuvre with a trailer through different situations."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book1_3_title@@.<br><br>You have learned connecting and disconnecting a trailer,<br>feel for the weight and dimensions of the truck with a trailer<br>and driving on challenging courses with a trailer.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Reversing with a Trailer"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Learn new manoeuvres to effectively reverse and park with a trailer."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 4: @@aca_chapter_book1_4_title@@.<br><br>You have learned reversing with a trailer<br>and various parking techniques.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Final Exam"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Demonstrate your knowledge and skill to prove your worth as a trucker!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 5: @@aca_chapter_book1_5_title@@.<br><br>You have proven that you have all the necessary skills<br>for driving, manoeuvring, and parking a truck!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Warming Up the Engine"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>You've completed training: @@aca_chapter_book2_0_title@@.<br><br>You have learned rules and features of Driving Proficiency.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Back in Gear"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book2_1_title@@.<br><br>You have warmed up the engine, tested the gears, spun the wheels properly, and checked the brake efficiency. The next chapters will be more challenging.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Wheels in Motion"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book2_2_title@@.<br><br>You have mastered difficult and varied scenarios. You have demonstrated skill and performance.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "The Home Stretch"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 4: @@aca_chapter_book2_3_title@@.<br><br>You have handled many difficult situations in manoeuvring, parking, and reversing with a trailer. You have proven that you are a skilled driver, capable of managing all challenging truck driving situations."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Going Forward"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Learn all the essential techniques for handling double trailers when driving forward."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 1: @@aca_chapter_book3_1_title@@.<br><br>You have experienced how to drive and manoeuvre with double trailers effectively.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Reverse Control"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Understand the necessary steps for manoeuvring double trailers when reversing."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book3_2_title@@.<br><br>You have have learned the formidable skill of reversing with double trailers.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Real World Preparation"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Apply your new knowledge in more advanced, scenarios."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book3_3_title@@.<br><br>You have handled many difficult situations in manoeuvring, parking, and reversing with double trailers. You've proven yourself here, now it's time to pull some doubles on the roads of Euro Truck Simulator 2!</font><br><br>"


#@}

