	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/convex_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "adj_tut_set_mirrors_t1_2_adj_pml"
	val[]: "<align vstyle=top hstyle=center><img color=FFFFFFFF src=/material/ui/academy/book/book1/illustration/big_mirror_left.mat $UK_VARIANT$ height=336></align><offset vshift=336><br><color value=@@clr_txt@@>@@adj_tut_set_mirrors_t1_2_adj@@<br><br><font face=/font/big_bold.font>@@adj_tut_set_mirrors_t1_2_adj_big@@<br></font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_pml"
