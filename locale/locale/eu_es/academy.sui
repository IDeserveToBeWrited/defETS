	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Reverse Parking Next to an Obstacle"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "In this scenario, we'll reverse the truck into a parking spot next to a kerb."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instructions"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Reversing Towards the Kerb"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parking the Truck"
