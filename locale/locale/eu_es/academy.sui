 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "In this scenario, we'll perform a reverse manoeuvre to park next to a kerb."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Reverse towards the kerb.<br>You must be aware of your surroundings when reversing, so use your mirrors."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "As you get closer you can start to align the truck with the parking spot. Watch both sides of the truck as you reverse."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Stop in the parking spot and secure the truck."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "The parking spot is behind you towards the passenger's side. Use your mirrors to navigate your way towards the spot.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Remember to use your mirrors to check your surroundings before moving the truck.<br><br><font face=/font/big_bold.font>Begin reversing towards the kerb. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continue to monitor your surroundings as you reverse into the parking spot.<br><br><font face=/font/big_bold.font>Stop at the designated spot. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Advanced Training Course"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "The last scenario in this chapter is a drive on an advanced training course. We'll put the skills you've learned with a tractor unit to the test!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Hairpin Turn"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "90 Degree Turn"

	key[]: "aca_goal_book1_2_06_check3"
	val[]: "Bridge Obstacle"

	key[]: "aca_goal_book1_2_06_check4"
	val[]: "Easy 90 Degree Corner"

	key[]: "aca_goal_book1_2_06_check5"
	val[]: "Approaching the Barrier"

	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Changing Direction"




	key[]: "aca_goal_book1_2_06_check8"
	val[]: "Median Crossover"

	key[]: "aca_goal_book1_2_06_check9"
	val[]: "Narrow S-Curve"

	key[]: "aca_goal_book1_2_06_check10"
	val[]: "Easy 90 Degree Turn"

	key[]: "aca_goal_book1_2_06_check11"
	val[]: "Hard 90 Degree Turn"

	key[]: "aca_goal_book1_2_06_check12"
	val[]: "Straight Section"

	key[]: "aca_goal_book1_2_06_check13"
	val[]: "Gentle Curve"

	key[]: "aca_goal_book1_2_06_check14"
	val[]: "Decreasing Radius Curve"

	key[]: "aca_goal_book1_2_06_check15"
