#+ Book 3 Scenario lucky
#@{

#### lucky common
	key[]: "aca_scenario_book3_lucky_title"
	val[]: "Truck Stop Escape: Double Down"

	key[]: "aca_scenario_book3_lucky_desc"
	val[]: "In this scenario, you must escape not only a busy truck stop, but also navigate the busy intersections on the road."

#### lucky goal

#!{
		key[]: "aca_goal_book3_lucky_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_lucky_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_lucky_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

