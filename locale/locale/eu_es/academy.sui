#!}
#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "For the final scenario of this chapter, we'll drive on the test track with a complex configuration."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "The first obstacle is a slalom through some barriers. Drive through it and remember to use your mirrors."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Next is a hairpin turn. Keep your turn wide and it shouldn't pose you any problems."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "There is a 90 degree left turn here. Remember to drive in deep so that the rear of the truck clears the inside barriers."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "The ramp obstacle can be a bit tricky. Line yourself up as best as you can before you drive onto it and use your front and side mirrors to help orient yourself."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "The next section must be done in reverse. Approach the barriers ahead with that in mind."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Follow the road markings back and to the right of you."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Reverse to the barriers, then stop and proceed forwards to the left."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Proceed through the break in the median to the next section."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Remember to drive in deep on 90 degree turns."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "You are entering a nice open section of road. You can pick up some speed, but keep in mind you'll need to slow down soon for the curve up ahead."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "At the bottom of the hill there are some barriers across the road. Drive up to them, then reverse into the parking spot on the left."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Reverse to the parking spot."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Park, then shut down the engine and secure the truck."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "In front of you is a slalom made of barriers.<br><br><font face=/font/big_bold.font>Drive through the slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Keep towards the outside of the turn to ensure the rear of the tractor doesn't go over the kerb.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "You are coming up to a 90 degree left turn. Remember to use all the space you have available.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Align yourself with the ramp. There isn't much room to make corrections once you are on it.<br><br><font face=/font/big_bold.font>Drive over the ramp. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Follow the course to the left. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Reverse towards the area behind you and to the right. There are arrows on the road to help assist you.<br><br><font face=/font/big_bold.font>Reverse towards the next section. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Keep reversing towards the barriers behind you.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stop and change into a forward gear, then continue to the left. <br><br><font face=/font/big_bold.font>Drive forwards. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "There is a break in the median to the left. Drive through it.<br><br><font face=/font/big_bold.font>Continue onwards. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continue through the course.<br><br><font face=/font/big_bold.font>Turn left. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Remember to keep left before the turn to give yourself as much room as possible.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "You can pick some speed up here, but there is a curve coming up ahead.<br><br><font face=/font/big_bold.font>Continue along the course. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "The curve gets sharper as you make your way through it.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly and carry on.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "At the bottom of the hill you will see barriers blocking the road. <br><br><font face=/font/big_bold.font>Stop near the barriers. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Behind you and to the left, there is a parking spot.<br><br><font face=/font/big_bold.font>Reverse into the parking spot. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Stop in the marked spot. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Driving on a Handling Track"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In this scenario, we'll take a drive on a track designed to test your ability to handle the truck through different kind of curves and corners."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entering the Course"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Making a Gradual Left Turn"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Driving Through S-Bends"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Straight Section"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Exiting the Training Course"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Approaching the Parking Spot"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In this scenario, we'll take the tractor unit for a short drive to see how you handle it with your newly acquired skills."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "There are various types and combinations of turns on the track. It's not a race and it's not about time. Be patient and adjust your driving speed to the turns and obstacles you encounter."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "At the beginning the course is gentle and easy, but more the turns will get more complex as you go."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Be mindful of your speed; it's easy to get going too fast and then misjudge a turn."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "The exit from the track is a very tight hairpin turn. Go slow and use all the space available to you."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Park between the barriers and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "To complete this scenario successfully, you must not crash, drive off of the track, or hit any traffic cones.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Proceed forwards into the sharp right turn to enter the course. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Drive through the turn at a nice steady speed. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "You're approaching a more complex section of winding turns.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly and continue.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continue towards the next set of turns.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "There are some easy, gentle turns coming. Keep your speed steady.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "The turn out of the course is a sharp hairpin turn. Slow down and stay to the outside before the turn. Be sure to use your mirrors!<br><br><font face=/font/big_bold.font>Turn out of the course. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Ahead of you there is a parking spot between some barriers.<br><br><font face=/font/big_bold.font>Proceed towards the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parallel Parking"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "In this scenario, we'll take a look at parallel parking between two other trucks."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Stopping in Front of the Parking Spot"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Checking the Rear View Mirror"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Reversing into the Parking Spot"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Aligning Truck Inside Parking Spot"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parallel parking is a crucial skill every trucker should know.<br>Prepare to set off."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Drive towards the parking spot.<br>Pay attention to your surroundings."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Align yourself with the truck in front of your parking spot. Don't be too close to it, keep some distance from it so you have room to work."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Turn sharply towards the space and start reversing."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "When looking out your driver's side mirror, aim for kerb just in front of the truck behind you."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Once your front bumper clears the truck ahead of you, you can begin steering the front end of the truck into the spot, aligning the truck with the parking spot."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Straighten out the wheel and centre out the truck within the parking spot.<br>Park and secure the truck."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Ahead of you there are some parked trucks. There's one open space left for you to park in. <br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Remember to be aware of your surroundings. Make good use of your mirrors throughout this manoeuvre. <br><br><font face=/font/big_bold.font>Drive forwards. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Drive past the parking spot and into the marked area. From there you can begin your reversing manoeuvre.<br><br><font face=/font/big_bold.font>Stop in the marked spot. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Check your surroundings for obstacles and to make sure you are clear to reverse.<br><br><font face=/font/big_bold.font>Look through the passenger's side mirror. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Turn your wheels and reverse into the parking spot.<br><br><font face=/font/big_bold.font>Start reversing. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Start straightening the truck out when appropriate. Don't drive over the kerb!<br><br><font face=/font/big_bold.font>Align the truck with the spot. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Connecting a Trailer"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "In this scenario, we'll explain the basics of connecting and disconnecting the tractor unit to a trailer."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Reversing to the Trailer"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Connecting the Trailer"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Releasing the Parking Brake"





	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Disconnecting the Trailer"


	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Disconnecting the Trailer"



	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Disconnecting the Trailer"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Stopping in Designated Area"
#!{

	key[]: "aca_goal_book1_3_01_check_discon"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_01_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_disc6"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_stop5"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_01_park_br_off3"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_parking_brake5"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"
 #!}


#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "In this scenario, we'll try connecting and disconnecting a trailer for the first time. Get the truck ready to go, then reverse under the trailer behind you."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Connect the trailer, then pull forwards."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Stop in the marked area."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Disconnect the trailer, pull forwards."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Park in the parking spot and secure the truck."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "In this scenario, we'll discuss the procedures for connecting and disconnecting the tractor and trailer. This is a simplified procedure compared to what a trucker will encounter in real life. <br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "There's a trailer located behind the tractor unit. Slowly reverse under the trailer until the fifth wheel hits the kingpin. Currently, the truck is correctly aligned so there is no need to steer, just reverse straight.<br><br><font face=/font/big_bold.font>Reverse slowly until you feel a connection. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "The fifth wheel has coupled to the kingpin.<br><br><font face=/font/big_bold.font>Secure the truck by applying the parking brake. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "In real life, the fifth wheel automatically locks the kingpin, then the trucker would need to exit the vehicle to retract the landing gear and connect the air and electrical lines. <br><br><font face=/font/big_bold.font>For us, simply pressing @@imv_nrm_attach@@ will connect the trailer. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Now that the tractor is safely connected to the trailer, you're ready to move forwards. Keep in mind that your vehicle is now considerably longer and heavier and will require a new set of skills to operate. <br><br><font face=/font/big_bold.font>Release your parking brake and prepare to drive forwards. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Drive forwards.<br><br><font face=/font/big_bold.font>Stop in the marked area ahead. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Apply the parking brake. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Activate the parking brake. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Once again, in real life, the trucker would have to exit the vehicle, lower the landing gear, disconnect the air and electrical lines, and release the fifth wheel locking mechanism. <br><br><font face=/font/big_bold.font>We simplify this process for you, so pressing @@imv_nrm_attach@@ will disconnect the trailer. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Release your parking brake. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Pull the tractor out from under the trailer and move forwards.<br><br><font face=/font/big_bold.font>Stop in the marked area. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Stop in the marked area. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Braking with a Trailer"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "In this scenario, you'll get a feel for driving and braking with a trailer attached."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Setting Off"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Driving Down the Hill"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Reaching a Speed of 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Applying Brakes"
