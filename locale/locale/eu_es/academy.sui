	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ is not intended to replace in cab training.</font><br><br><color value=@@clr_txt@@>We strongly recommend seeking out instruction from an accredited truck training institution before attempting to operate a truck in real life.<br><br>Training institutions interested in using @@driving_academy@@ to supplement in cab driver training can contact us at academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Truck Driving Basics"

	key[]: "aca_book_book1_desc"
	val[]: "Learn the basics of driving a truck, from basic functions and controls to manoeuvring with a trailer."

	key[]: "aca_book_book2_title"
	val[]: "Truck Driving Proficiency"

	key[]: "aca_book_book2_desc"
	val[]: "Hone your truck driving skills with new scenarios in more challenging conditions."

	key[]: "aca_book_book3_title"
	val[]: "Double Trailer Handling"

	key[]: "aca_book_book3_desc"
	val[]: "Take on the curious challenges of driving and reversing with a set of doubles."

#@}

