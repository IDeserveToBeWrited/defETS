#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Final Exam (Part 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "The last part of the final exam awaits you, where the parking skills you've learned in previous scenarios will be evaluated. Park carefully and accurately and you'll be ready to hit the roads of Europe as a skilled trucker!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Offset Manoeuvre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Diagonal Parking"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Driving Through the Parking Lot"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parallel Parking"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Final Parking"
