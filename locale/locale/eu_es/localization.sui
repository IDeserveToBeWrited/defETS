	val[]: "Dimentsioak"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Garraio berezia"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Mesedez, abiadura moteldu eskolta-ibilgailua ez jotzeko..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Mesedez, itxaron atzeko eskolta-ibilgailuari..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Kontuz orain, mesedez, ibilbidearen zati estu bat dator..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Errei-aldaketa maniobra iristen ari da. Egokitu zure abiadura istripurik gerta ez dadin..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Aurreko eskolta-ibilgailuak beste gidari batzuei ohartaraziko die...<br>Egokitu zure abiadura istripurik gerta ez dadin..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Eskolta-ibilgailuak zain dituzu hurbileko bidegurutze batean. Mesedez, ibilbideari segi."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Kontuz!<br>Atzeko ibilgailura mugitzen ari zara!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Kontuz!<br>Atzeko ibilgailura gehiegi hurbiltzen ari zara!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Mesedez, sakatu tekla hau lan bereziko eskaintza ikusteko:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Lan bereziko eskaintza:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "You're about to haul a Special Transport cargo! There are two escort vehicles which will lead you. Please be careful and follow their lead and suggestion notifications. Special transports like this don't stop on a red signal and have the right of way in most situations. During these deliveries, checkpoints are made more often to save your current progress."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Arreta berezia jarri honi:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Sahiestu edozein arazo eskolta-ibilgailuekin eta eutsi kargari haien artean."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ez gidatu ezarritako bidetik kanpora, ez gasolindegietara, ez atseden lekuetara etab."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Aurreko eskolta-ibilgailuak markatzen dituen abiadura-mugak bete."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Kontuz aurreratzen ari zaren trafikoarekin eta errepideetako beste gidari batzuekin."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Errei-aldaketa maniobra:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Arau hauek betetzen ez badituzu, zure garraio bereziaren misioak huts egin dezake!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "<color value=@@clr_sel@@>Atzeko<color value=@@clr_txt@@> eskoltak abiarazten du maniobra, esleitutako erreia aldatuz eta blokeatuz."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Aurreko<color value=@@clr_txt@@> eskoltak erreia hutsik egon arte itxaron behar du, eta ondoren erreia ere aldatuko du."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Ondoren, segurua da <color value=@@clr_sel@@>jokalariarentzat<color value=@@clr_txt@@> esleitutako erreira mugitzea."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Kamioiaren tangak bete dira eta gidatze-orduak berrezarri dira."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Ezin diozu laguntzari deitu garraio bereziko misio batean."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Ezin duzu ferrya erabili garraio bereziko misio batean."

