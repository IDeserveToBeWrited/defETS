	key[]: "trailerman_swap_blocked"
	val[]: "Trukatzeko, trailerraren garajea bisitatu" #+ Tooltip message shown when player is not able to swap his currently attached trailer with the currently previewed trailer in trailer manager because he is not in the garage where previewed trailer is stored at.

	key[]: "trailerman_relocate_blocked"
