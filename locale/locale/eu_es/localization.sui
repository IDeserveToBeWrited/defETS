#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Jarraitu ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Ongi etorri Euro Truck Simulator 2-ra!"

	key[]: "intro_2"
	val[]: "Azkenik badaukazu zure ametsetako lana frogatzeko aukera, kamioi bat gidatzea!"

	key[]: "intro_3"
	val[]: "Zure garraio-enpresa irekita dago jadanik, baina zoritxarrez kamioia erosteko dirua falta duzu. Oraingoz, beste enpresa batzuentzat lan egin beharko duzu alokairuko gidari gisa."

	key[]: "intro_4"
	val[]: "Zure eginbeharra $JOB_TARGET_CITY$-ko $JOB_TARGET_COMPANY$ enpresara $JOB_CARGO$-karga bat segurtasunez eramatea da. Zure nagusiak ibilgailu bat utzi dizu eta gastu guztiak ordainduko ditu. Ez huts egin inori eta garaiz iritsi."


	key[]: "intro_garage_1"
	val[]: "Hau da zure egoitza."

	key[]: "intro_garage_2"
	val[]: "Garaje oinarrizkoa da. Ez da asko, baina zerbaitengatik hasi beharra dago."

	key[]: "intro_garage_3"
	val[]: "Tamalez, ez daukazu hemen aparkatzeko ezer ez."

	key[]: "intro_garage_4"
	val[]: "Diru nahikoa irabazi eta kamioi propioa erosi ostean, munduan zehar libre ibili eta zure negozioa antolatzeko aukera izango dizu."

	key[]: "intro_garage_5"
	val[]: "Sorte on!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE UNLOCKED"

	key[]: "desktop_tut_job"
	val[]: "Aukera ezazu zure hurrengoko lana"

	key[]: "desktop_tut_cargo_market"
	val[]: "Erabil ezazu zeure trailer berria Karga-merkatura sartzeko karga-aukera handia bere norakoetara entregatzeko." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Hemen ikus dezakezu zure aurrerapena."

	key[]: "desktop_tut_company"
	val[]: "Zure garajeak kontrolatu, gidari berriak kontratatu edota konpainia maneiatu."

	key[]: "desktop_tut_trailers"
	val[]: "Hemendik aurrera, zure trailerrak eros ditzakezu, eta hobetu edo margotu zure kamioiarekin ondo emateko.<br><br>Zure trailerrak zure aukeratutako garaje(et)an gorde daitezke; zure gidariek erabil ditzakete irabaziak handitzeko. Trailerrak kudeatzeko, trailer-kudeatzailea erabili."

	key[]: "desktop_tut_visit_directive"
	val[]: "Bisitatu $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "ONGI ETORRI"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Welcome to the new Desktop.<br>From here you can interface with all functionality within the game."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Below, the Main Menu provides direct access to all of the core game functions that you are familiar with."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "At the top, the new Status Bar provides constant visibility to helpful player profile statistics and local travel regulations."

	key[]: "desktop_tut_tour_home"
	val[]: "The Desktop button is always there to return you to your Desktop."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "A permanent Quick Menu provides handy shortcut access to all game functions from any screen."

	key[]: "desktop_tut_tour_drive"
	val[]: "The updated Drive button remains your connection to the driving world, ready to place you back on the road."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIALA AMAITUTA"

	key[]: "desktop_tut_tour_finish"
	val[]: "Thanks for reviewing our Desktop update."
#@}


