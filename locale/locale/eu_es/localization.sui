	key[]: "load_save"
	val[]: "Gorde eta kargatu" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Aldaketak hauteman dira! Gordetako partidekin arazoak ekiditeko, amaitu gabeko lanak atzera bota dira inolako penalizaziorik gabe." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Aldaketak hauteman dira!<br><br>Gordetako partidekin arazoak ekiditeko, amaitu gabeko lanak atzera bota dira inolako penalizaziorik gabe. Kamioia leku segurura eraman behar da.<br><br>Mesedez, aukeratu bidaia azkarreko helmuga bat jarraitu ahal izateko." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Gordetzen..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Sakatu $KEY$ zinematika pasatzeko." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
#@{

	key[]: "no_drive_t"
	val[]: "NO VEHICLE" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "You cannot move freely about the world because you don't have a vehicle to drive! You could purchase one or take one from your fleet.<br><br>Would you like to take a quick job now?"
