#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Online serbitsua erabilezina. Mesedez zihurtatu zure kliente konfigurazioa."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Ezinezkoa izan da online serbitzariarekin konektatzea. Mesedez zure internet konekzioa egiaztatu."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Arazoak online serbitsuarekin kontaktuan jartzeko. Mesedez, saia zaitez geroago."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Informazio okerra jaso da online serbitsariarengandik. HTTP proxy-a gaitua badago, bere konfigurazioa errebisatu. Bestela, saia zaitez geroago."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Informazio okerra bueltatu da online serbitzariarengandik. Mesedez, saia zaitez geroago."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Serbitsua ez dago erabilgarria zure jokoaren bertsioarekin. Mesedez egiaztatu zure bertsioa eguneratua dagoela."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Serbitsua erabilezin dago momentuz. Mesedez, saia zaitez geroago."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Serbitsua jauzi da mantenimendu arrazoiengatik. Mesedez, saia zaitez geroago."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Zure autentifikazioa ez da zuzena. Mesedez, saia zaitez geroago."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Online kontua blokeatua izan da sartzeko gehiegizko saiakerak erabili ostean. Mesedez, saiatu berriro ordu erdi barru."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Online kontua blokeaturik dago sarrera susmagarriengatik. Mesedez, saiatu berriro 24 ordu barru."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Joko hau ez dago online kontu honekin registratuta."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Kontua ez da oraindik aktibatu. Mesedez posta begiratu zure kontuaren aktibazio kodearen bila."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Kontu hau blokeaturik dago. Mesedez kontaktuan jarri soporte teknikoarekin."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Kontu hau deuseztatu egin da. Mesedez kontaktuan jarri soporte teknikoarekin."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Jokoak ez du zure Proxy konekzioa baimentzen. Mesedez, saia zaitez beste proxy edo konexio mota erabiltzen."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Nahi duzun objetua ez dago aukeragarri. Mesedez, saia zaitez minutu gutxira."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL error. Unable to establish a secure connection."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Barne arazoa. Net.log artxiboak informazio gehiago izan dezake."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 arazoak izaten hari ditu zure ordenagailuan grafikoak mugitzerakoan (ez da txartel grafiko egokirik aurkitu).\nProposatutako pausoak:\n\n1. Ziurtatu zure ordenagailuak jokoaren beharrezko baldintzak betetzen dituela.\n2. Eguneratu zure Microsoft DirectX bertsioa.\n3. Azkeneko kontroladore grafikoak deskargatu eta instalatu itzazu.\n4. Jokoaren renderizazio metodoa aldatu OpenGL-tik DirectX-era edota alderantziz.\n5. Ezaba ezazu zure dokumentuetan dagoen 'config.cfg' artxiboa, 'Euro Truck Simulator 2' karpetan.\n    Artxiboa lehenetsitako balioekin birsortuko da jokoa berriro irekitzerakoan."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 arazoak izaten hari ditu zure ordenagailuan grafikoak eraikitzerakoan (ez da gailu grafikorik aurkitu)."
#@}

