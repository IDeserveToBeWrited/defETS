#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "PARTIDA KARGATU"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Partida kargatu" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Lehenago gordetako partida bat kargatu. Uneko aurrerapena galduko da!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Ziur zaude beste partida bat kargatu nahi duzula?<br><br>Gorde gabeko aurrerapena galduko da."

	key[]: "load_progress_lost_mp"
	val[]: "Are you sure you want to load another game?<br>Doing so in multiplayer may result in job cancellation or suspension, teleportation to the nearest service, or unavailability of the selected job.<br><br>Your current progress will be lost unless saved earlier."

	key[]: "load_game_mp_suspended_job"
	val[]: "Save was successfully loaded, but your active World of Trucks job was suspended and is unavailable while in this session."

	key[]: "autosave"
	val[]: "- Auto-gordetzea -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Gordetze azkarra -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Auto-gordetzeak erakutsi" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "No manual saves found." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Kargatu" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Incompatible save!<br><color value=@@clr_txt@@>Try to upgrade the game to the latest available version." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Failed to load and display all save files for this profile." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "ADI" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@> Arazoak partida kargatzean. <color value=@@clr_txt@@><br><br> Partidaren karga okertu da. Arazoa zuzentzen saia zaitez ondorengo informazioaren laguntzaz. Bestela, beste partida kargatzea gomendatzen da. <br><br> Ondorengoak izan ohi dira arazoaren kausak: <br><br>1. Partida bateraezina da instalatutako MOD batekin. <br><br>2. Partida faltan edo desaktibaturik dagoen MOD baten beharra du. <br><br>3. Partida apurtu da MOD oker baten erabileragatik. <br><br>4. Ordenagailuaren okerren bat partida gorde bitartean partida apur dezake."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>MOD bat faltan botatzen da. <color value=@@clr_txt@@><br><br> Gorde den azkeneko partida falta den MOD baten falta botatzen du. <br><br> Espero ez izatekotan, MOD-en egoera ziurtatu. <br><br> Bestela, edonola partida kargatzen saia zaitezke. Hala ere, MOD horren aldaketen arabera, posible da karga okertzea edo bestelako arazoak sortzea. <br><br> Baita ere karga dezakezu beste partida bat, faltan dagoen MOD hori erabiltzen ez duena."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>DLC-a faltan botata.<color value=@@clr_txt@@><br><br>Azkeneko partida faltan botatzen den DLC batekin gorde da.<br><br>Sorpresa izatekotan, mesedez egiaztatu zure DLC-aren egoera.<br><br>Dena den partida karga dezakezu, zenbait funtzio galtzen badira ere.<br><br>Beste partidaren bat kargatzen saia zaitezke, DLC horren baitan ez egotekotan."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>DLC-a falta da <color value=@@clr_txt@@><br><br> Gordetako azkeneko partida faltan dagoen DLC batekin gorde zen. <br><br> Partida hori kargatzeko, beharrezkoa izango duzu DLC-a. <br><br> Bestela, gordetako beste partidaren bat kargatzen saia zaitezke, DLC horen baitan gorde ez bada."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Modifikazioa DLC baten baitan dago. <color value=@@clr_txt@@><br><br>Behintzat modifikazio batek  instalaturik ez dagoen DLC bat behar du. <br><br> Modifikazio hauek ezabatu edo beharrezko daukaten DLCa instalatu beharko duzu."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Arazoak detektatu dira <color value=@@clr_txt@@><br><br> Badirudi jokoa okertu dela aurreneko karga batekin. <br><br> Arazoa zuzentzen saia zaitez ondorengo informazioaren laguntzaz. Bestela, beste partida kargatzea gomendatzen da. <br><br> Ondorengoak izan ohi dira arazoaren kausak: <br><br>1. Partida bateraezina da instalatutako MOD batekin. <br><br>2. Partida faltan edo desaktibaturik dagoen MOD baten beharra du. <br><br>3. Partida apurtu da MOD oker baten erabileragatik. <br><br>4. Kasu batzuetan hardware edo driver batzuen funtzionamendu okerra jokoa apur dezakete."

	key[]: "mods_detected_warning"
	val[]: "MOD-ak aurkitu dira. MOD hautsiek, zaharkituek edo bateraezinek egonkortasun arazoak sor ditzakete. Aztertu aktibo dituzun MOD-ak Mod kudeatzailean." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

