#+ Names of various functionalities.
#@{

	key[]: "o_im_throttle"
	val[]: "Azeleragailua"

	key[]: "o_im_back_reverse"
	val[]: "Balazta / Atzerako martxa"

	key[]: "o_im_steering"
	val[]: "Direkzioa" #+ Rotates wheel to the left or right.

	key[]: "o_im_left"
	val[]: "Ezkerretara biratu" #+ Rotates wheel to the left.

	key[]: "o_im_right"
	val[]: "Eskuinetara biratu" #+ Rotates wheel to the right.

	key[]: "o_im_look_left"
	val[]: "Ezkerrera begiratu" #+ Rotates view to the left.

	key[]: "o_im_look_right"
