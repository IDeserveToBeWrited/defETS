	val[]: "Erabil ezazu zeure trailerra karga-aukera handia bere norakoetara entregatzeko." #+ The description of an Cargo Planner icon, used to open a window for selecting cargo with owned trailer.

	key[]: "trailerman_title"
	val[]: "NIRE TRAILERRAK"

	key[]: "trailerman_link_title"
	val[]: "Trailer kudeatzailea"

	key[]: "trailerman_notice_t"
	val[]: "TRAILER KUDEATZAILEA"

	key[]: "trailerman_help"
	val[]: "Zure enpresaren trailerrak kudeatu, esleitu zure gidariei, erosi, trukatu eta askoz gehiago."

	key[]: "trailerman_summary_hint"
	val[]: "Aukeratu eskuinaldeko trailer bat bere xehetasunak ikusteko"

	key[]: "trailerman_tut_utilization"
	val[]: "Uneko egoera ekonomikoan atoien erabileraren ehunekoa, egunean. Zure gidarien atoion erabilera orduetan oinarritzen da. Grafikoa egun bakoitzaren hasieran eguneratzen da. Ehuneko balio handiagoak atoi motak garajean duen eskaera handiagoa adierazten du." #+ The utilization graph hint text.

	key[]: "trailerman_tut_overview"
	val[]: "Zure erositako trailer guztiak hemendik zerrendatzen eta kudeatzen dira.<br><br>Trailerrak garaje berean dauden gidariei ematen zaizkie automatikoki eta bere entregetarako erabiltzen hasiko dira.<br><br>Trailer bat pribatua egin bere erabilera zuretzat soilik murrizteko, eta publikoa egin zure gidarientzat eskuragai egiteko, garajearen ekonomia sustatzeko." #+ The text shown in trailer manager overview tutorial box.

	key[]: "trailer_config"
	val[]: "Trailer konfiguratzailea"

	key[]: "trailer_config_about"
	val[]: "Trailerraren konfigurazioa pertsonalizatu, doitu edo margotu, zure behar operatibo eta estetikoekin bat etor dadin."

	key[]: "truckman_gar_trailers"
	val[]: "Trailerrak:"

	key[]: "garage_name"
	val[]: "Garajea:"

