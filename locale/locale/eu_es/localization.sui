#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "AUKERATU KONTROL-MODUA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Kontroladoreak"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Konfigurazio morroiak ezarpen gomendatuak aplikatuko ditu konektatutako gailuetan oinarriturik.<br><color value=@@clr_sel@@>Steam-ekin bateragarria den gailua erabiltzen ari bazara, konfigurazio laguntza aktibatu dezakezu hemen: <br><color value=@@clr_txt_d@@>\"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Teklatuarekin gidatu eta sagua erabili zure ingurura begiratzeko. Gidatzeko modu sinple eta merkeena, baina zehaztugabeena."

	key[]: "wiz_control_mouse"
	val[]: "Erabili sagua zehaztasun handiagoko direkzioarentzat. Beste guztia teklatuarekin gauzatuko da. Erabil dezakezu sagua aldi berean zure ingurura begiratzeko beste kamera botoi bat sakatzen baduzu."

	key[]: "wiz_control_controller"
	val[]: "Bolante, gamepad, edota joystick bat erabili esperientzia errealistena lortzeko. Teklatua hainbat funtzio aukeratzeko erabilgarri jarraituko du, eta saguaren bitartez zure ingurura begira dezakezu."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Ez da kontroladorerik aurkitu. Konekta ezazu bat orain aukera hau nahi izatekotan!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Aukeran dauden kontroladoreak antzematen ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECT CONTROLLER API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - In-game Mapping Mode (recommended)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Steam Client Mapping Mode"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Classical controller"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepads like @@controller_ps5@@, @@controller_xbox_one@@ or @@controller_steam_deck@@ opted into the Steam Input interface and using simple layout.<br><br>Supports full in-game key binding configurations."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepads opted into the Steam Input interface and using standalone layouts configured through the Steam Client.<br><br>Limited support for in-game button hints and no in-game binding configurations."

	key[]: "wiz_api_classical"
	val[]: "Controller, driving wheel or joystick using DirectInput, XInput or similar interface."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "AUKERATU KONTROLAGAILU-MOTA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Bolantea"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Agintea edo joystick-a"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Kontroladorea bolantea da edo baten modura ibiltzen da. Kontroladorearen posizioa direkzio gurpilen posizioa markatuko du momentu oro."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Kontroladora Aginte edo Joystick-a da. Bere posizioa markatuko du gurpilen biraketa abiadura."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECT GEARBOX TYPE" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ezaugarri hau bolante, gamepad, edota joystick bat behar du."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Ez da H-Martxa palankarik aurkitu. Ezaugarri hau erabilezina izango da."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECT H-SHIFTER LAYOUT"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Irismen transmisioa aukera sinpleena da. Bi martxa talde ditu. Lehenengokoa 1.-tik 6.-enera eta bigarrena 7.-etik 12.-era. Alternadore botoiak batetik bestera aldatzen du kutxak taldeko martxa bat aukeratzen duen bitartean."

	key[]: "wiz_hs_splitter"
	val[]: "Transmisio banatua alternatiba simplea da. Bi martxa talde ditu ere. Lehengokoak martxa bakoitiak ditu (1,3,5,...) eta bigarrenekoak bikoitiak (2,4,6,...). Alternadore botoiak batetik bestera aldatzen du kutxak martxa bat aukeratzen duen bitartean."

	key[]: "wiz_hs_range_splitter"
	val[]: "Range-splitter transmission is based on the layout of the real manual range-splitters. Gears are grouped by four per each H-shifter position and use two toggles. Thus it is recommended for advanced drivers only."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Jokoa ondoren aurkitutako doiketak lehenetsi ditu. Edozer aldatu dezakezu doiketa aurreratuetara joz, edo jokora jarrai dezakezu."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Doikuntza aurreratua"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "The game is now configured and you can continue. You can change the configuration later in Options."

	key[]: "wiz_cfg_steam"
	val[]: "You can check and configure button and axis mapping for this controller using the Steam client. Steam gamepad settings for the game are available in Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Open controller settings"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Erabili @@imm_wiz_dsteerleft@@ eta @@imm_wiz_dsteerright@@ direkzioarentzat."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Mugitu arratoia ezker-eskuinera direkzio gurpilak bertara mugitzeko."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Erabili @@ima_wiz_j_steer@@ direkzioarentzako."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Erabili @@imm_wiz_dforward@@ aurrera gidatzeko eta @@imm_wiz_dbackward@@ atzeranzkorako."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Mugitu @@ima_wiz_j_throttle@@ aurrera azkartzeko eta atzera atzeranzko martxan joateko."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Erabili @@ima_wiz_j_throttle@@ aurrerantz gidatzeko eta @@ima_wiz_j_brake@@ atzeranskoarentzat."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Erabili @@imm_wiz_dforward@@ azkartzeko eta @@imm_wiz_dbackward@@ balaztatzeko."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Mugitu @@ima_wiz_j_throttle@@ aurrera azkartzeko eta atzera balaztatzeko."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Erabili @@ima_wiz_j_throttle@@ azkartzeko eta @@ima_wiz_j_brake@@ balaztatzeko."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Erabili @@imv_wiz_gearup@@ aurrera martxarako eta @@imv_wiz_geardown@@ atxera martxarako."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Teklatua edo kontroladorearen botoiak erabiltzekotan @@imv_wiz_gearup@@ erabili aurrera martxa jartzeko eta @@imv_wiz_geardown@@ atzera martxarako. @@imv_wiz_drive@@ eta @@imv_wiz_reverse@@ erabil itzazu gidatze norabidea hautatzeko H-transmisioa erabiltzekotan."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Erabili @@imv_wiz_gearup@@ eta @@imv_wiz_geardown@@ nahi duzun martxa aukeratzeko."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Erabili zure H-palanka @@ima_wiz_j_clutch@@-rekin batera nahi duzun martxa aukeratzeko."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "SETUP CONTROLLER AXES" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualization of Axes"

	key[]: "wiz_setup_axes_desc"
	val[]: "You can try the function of all selected axes visually. Use the controller and watch the moving bars. It will tell you the limits, centring, orientation and overall behavior of each used axis."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Axis Setup"

	key[]: "wiz_setup_axes_desc2"
	val[]: "To choose an axis, click on the button next to the axis name. This will switch you into input mode. Then, use your controller to bind the selected axis by moving the stick, wheel, or pedal to your chosen axis."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Deadzones"

	key[]: "wiz_setup_axes_desc3"
	val[]: "The deadzone refers to an axis area intentionally designed to provide no input. To adjust the deadzone of a chosen axis, move the corresponding slider. Increasing the slider to the right will enlarge the deadzone. This feature is particularly beneficial for older controllers, as defining a larger deadzone can mitigate issues such as inaccuracy or false input caused by hardware wear."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Axis Modes"

	key[]: "wiz_setup_axes_desc4"
	val[]: "The axis mode determines how it is handled in the game. Inverted axis flips its reported direction, resulting in steering left instead of right, for example. A centred axis has its default position in the middle of its range, such as in a joystick. This mode is useful for correcting an axis that has been detected incorrectly."

	key[]: "normal"
	val[]: "Normala" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Alderantzikatua" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Zentratua" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Alderantzikatua eta zentratua" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATIC GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Transmisio automatikoarekin aurrerako, neutro, eta atzerako posizioekin baino ez duzu lan egingo. Ondoko kontrolak baino ez erabilita lortuko duzu. Edozein aldatzeko, botoian bertan sakatu eta nahi duzun kontroladore edo botoia sakatu."

	key[]: "automatic_gb_setup_desc2"
	val[]: "H-Martxa palankarik ezatekotan, benetako transmisio automatiko bat simula dezakezu. Aukera hau erabili palankak aurrerako eta atzerako posizioak izateko. Beste edozein H-posizioa neutral modura hartuko da. Aukera hau erabilgarri da bakarrik H-Martxa palankentzat, eta ez du beste kontroladore edo botoiekin funtzionatuko. Atxikitutakoa aldatzeko, botoian sakatu eta mugitu palanka nahi duzun posiziora, ondoren neutrora bueltatuz."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEQUENTIAL GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Transmisio sekuentziala aurreranzko martxen, neutroaren, eta atzeranzkoaren artean aldatzen du. Hemen daude gora eta behera aldatzeko erabiltzen diren kontrolak. Atxikitutakoa aldatzeko, botoia sakatu eta ostean atxikitu nahi diozun kontroladore edo botoi berriari eman."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-SHIFTER GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Hemen aukera eta froga ditzakezu H-transmisioaren doikuntzak. Irudian ikus dezakezu oraingo posizioa eta aukeratutako martxa. Martxa Kutxak palankak dituen posizioak baino martxa gehiago dituenez, alternadore moduko botoiak erabili beharko dituzu martxa taldeen artean aldatzeko."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Momentuak aukeratutako posizioa eta atxikitutako funtzioak indikaturik daude izenaren alboan. Atxikitutako kontrol bat aldatzeko, botoia sakatu eta mugitu martxa palanka nahi duzun lekura, eta neutrora berriro ere amaitzeko."
#@}

