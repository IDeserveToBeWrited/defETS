#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Irudia handiegia da. Mesedez saiatu monitorearen resoluzioa txikitzen." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Artxiboa hondatuta edo formatu okerrean aurkitzen da." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Irudia handiegia da. Saia saitez resoluzioa txikitzen." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Serbitsuak igoera ezeztatu du." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Kontu hau ez dago argazkiak igotzeko baimendua." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Beste igoera bat aurkitu da leku berberean." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Igoerak desaktibaturik daude. Mesedez, saiatu geroago." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Arazo ezezaguna igoera bitartean. Mesedez, saia zaitez geroago." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Argazkiaren tamaina $LIMIT$ baino handiagoa zen eta txikituta izan da." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Argazkiaren tamaina $LIMIT$KB baino handiagoa zen eta txikituta izan da." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

