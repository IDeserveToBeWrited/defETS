#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFORMASJON OM LASTEBILFØRERFERDIGHETER" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Fullføringskrav"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Scenarioer fullføres ved å oppfylle alle betingelser for bestått"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Stjerner opptjenes ved å fullføre bonusbetingelser"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Betingelser"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maksimalt antall endringer mellom framover- og bakoverbevegelse"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maksimal tid tillatt for å fullføre et scenario for en gitt betingelse"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Eksklusiv bruk av interiørkamera – eksteriørkameraer kan fortsatt brukes mens det står stille"

	key[]: "aca_book_book2_completed_t"
	val[]: "LASTEBILKJØREFERDIGHETER BESTÅTT"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br><br>Du har fullført alle betingelsene for bestått i Lastebilkjøringsferdigheter-modulen og opptjent belønninger for din karriereprofil. Du kan fortsatt utfordre deg selv til å få flere belønninger ved å fullføre alle bonusbetingelsene.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "LASTEBILKJØREFERDIGHETER FULLFØRT"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br><br>Du har fullført alle bestått- og bonusbetingelsene i Lastebilkjøringsferdigheter-modulen og opptjent belønninger for din karriereprofil.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Lastebilkjøringsferdigheter"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Velkommen tilbake til @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Følgende scenarioer representerer det neste steget på din reise til profesjonell lastebilkjøring."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Vi kommer ikke til å veilede deg gjennom hver oppgave denne gangen, så det er opp til deg å bruke dine ferdigheter og erfaring å jobbe med."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Du kan støte på noen kjente manøvrer, men denne gangen i nye miljøer laget for å se mer ut som scenarioer i den virkelige verden."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Nytt for @@driving_academy@@ er tillegget av betingelsene «Bestått» og «Bonus»."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Som før må du fortsatt fullføre hvert scenario uten å treffe noe, ved å parkere vellykket og sikre lastebilen..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...men nå må du også gjøre det innenfor den tildelte tidsfristen, og med en grense i antall retningsendringer mellom framover- og ryggekjøring."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bonusbetingelser kan oppfylles ved å fullføre hvert scenario med enda mer utfordrende betingelser..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...som strengere tidsbegrensninger, færre retningsendringer og bruker interiørkameraet eksklusivt."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Ved å fullføre alle scenarier kan du se på deg selv som en dyktig lastebilsjåfør og klar for neste utfordring på veien.<br><br>For å utfordre deg selv ytterligere, fullfør alle bonusbetingelsene for hvert scenario; da vil du virkelig bli en lastebilsjåførstjerne!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Veiledning"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "I dette veiledningsscenarioet vil vi hjelpe deg med å bli kjent med de nye funksjonene som finnes i Lastebilkjøringsferdigheter."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Ved starten av hvert scenario vil du se et <color value=@@clr_sel@@>\"Scenario Briefing\"<color value=@@clr_txt@@>-vindu. Dette vil gi deg informasjon om de nye bestått- og bonusbetingelsene for scenarioet. <br><br>Beståttbetingelsene må oppfylles for å fullføre scenarioet, mens bonusbetingelsene er en valgfri ekstra utfordring for erfarne og dyktige spillere. <br><br><font face=/font/big_bold.font>For å fortsette, skru på tenningen.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "En av bonusbetingelsene krever at du fullfører scenarioet mens du bruker <color value=@@clr_sel@@>Interiørkamera<color value=@@clr_txt@@>. Du kan fortsatt bruke eksteriørkameraene til å sjekke omgivelsene, men bare mens lastebilen står stille.<br><br>Du kan se deg rundt nå for å orientere deg, og deretter bytte tilbake til interiørkameraet.<br><br><font face=/font/big_bold.font>Bytt til jaktkamera for å sjekke omgivelsene</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Få peiling, og bytt deretter tilbake til interiørkameraet.<br><br><font face=/font/big_bold.font>Se deg rundt i lastebilen</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Bytt tilbake til interiørkamera</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Tid<color value=@@clr_txt@@> vil også være en faktor i Lastebilkjøringsferdigheter. Alle scenarioer vil ha en individuell tidsgrense der scenarioet må fullføres som en bestått betingelse, og mange vil også ha en ekstra, strengere grense som en bonusbetingelse.<br><br>Tiden starter bare etter at lastebilen er flyttet.<br><br><font face=/font/big_bold.font>Start motoren og slipp parkeringsbremsen for å fortsette.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Et annet nytt tillegg for lastebilkjøringsferdigheter er veipunkter. Alle veipunkter må nås før et scenario kan fullføres. <br><br>I tillegg er veipunkter følsomme for hvilken retning lastebilen vender mot når veipunktet nås, så vær oppmerksom på eventuelle bakkemarkeringer i nærheten av veipunktet for å orientere deg riktig.<br><br><font face=/font/big_bold.font>Kjør fremover til veipunktet foran deg.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Du har nådd veipunktet, og kan nå gå videre til neste trinn. <br><br>Det er et annet veipunkt bak deg som du må rygge inn i. Legg merke til pilen på bakken som indikerer hvilken vei lastebilen skal vende når du når veipunktet. <br><br>En annen betingelse for bestått og bonus som må vurderes er <color value=@@clr_sel@@>Retningsendringer<color value=@@clr_txt@@>. Vi teller hvor mange ganger du endrer retning mellom å kjøre fremover og rygge. Hold deg under grensen for å fullføre betingelsen.<br><br><font face=/font/big_bold.font>Rygge til veipunktet og stopp.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Så nå burde du ha samlet én retningsendring. <br><br>Plukk opp hengeren bak deg for å fortsette til neste trinn. <br><br><font face=/font/big_bold.font>Rygge under hengeren for å koble den til.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Det siste parkeringsområdet er til høyre for deg. Noen scenarioer kan bare ha en parkeringsplass, mens andre har flere å velge mellom. Riktig parkering på en av plassene vil la deg fullføre scenarioet. <br><br><font face=/font/big_bold.font> Trykk @@imv_nrm_attach@@ for å koble til hengeren. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Parkeringsplassene indikerer også hvilken vei lastebilen skal orienteres på stedet. Parkere i feil retning, og du vil ikke kunne fullføre scenarioet før du korrigerer deg selv, noe som vil koste deg tid og retningsendringer.<br><br><font face=/font/big_bold.font>Kjør til en av parkeringsplassene og parkere riktig.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Du skal nå være kjent med de nye parameterne for beståtte betingelser og bonusmål, og være klar til å takle de nye scenarioene i Lastebilkjøringsferdigheter!<br><br><font face=/font/big_bold.font>Sikre lastebilen ved å sette på parkeringsbremsen og skru av motoren for å fullføre scenarioet.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Snarvei"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "I dette scenarioet vil du forsøke å bruke en snarvei som dessverre er blokkert på slutten. Du må deretter rygge tilbake ned samme vei som du kom."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Kjør til veipunktet oppe på toppen av bakken og rygge deretter samme vei ned igjen. <br><br>Når du er tilbake på veien, kjør til den siste parkeringsplassen."



#@}

