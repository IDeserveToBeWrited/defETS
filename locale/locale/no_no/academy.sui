#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Kjøring gjennom komplekse svinger"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "I dette scenarioet vil vi utforske å manøvrere hengeren gjennom en kort hinderløype med mer komplekse svinger."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Første svinger"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Kjører gjennom en smal passasje"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Trang 90 graders sving"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Kjøring rundt barrierene"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Forut er en rekke komplekse hjørner og hindringer.<br>Ta i betraktning alt du har lært så langt, så burde det ikke være for vanskelig."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Veimerkingene kan bidra til å gi deg en idé om hvordan du skal gå gjennom hvert sett med hindringer."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Hold traktoren på utsiden av hjørnet. <br>Du må svinge bredt ettersom hengeren følger en kortere vei."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Neste hjørne er en enkel 90 graders sving. <br> Nok en gang, hold lastebilen på utsiden av svingen og utnytte all plassen som er tilgjengelig for deg."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Ta deg god tid her. Banen åpner opp, men du må fortsatt være presis."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Hold en bred køye rundt barrierene."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Vær forsiktig når du kommer inn i denne smale seksjonen. <br>Sving traktoren bredt i god tid før du kommer inn for å sette opp din henger for innkjøring."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Den siste 90 graders svingen er mye skarpere enn den første, men det er god plass hvis du bruker plassen din klokt."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Stopp på det angitte området, deretter sikre lastebilen og skru av motoren."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Husk å bruke veimerkingene for å hjelpe deg med å navigere på banen.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Bruk av speilene vil også hjelpe deg å navigere på banen trygt. Du må alltid være klar over hvordan hengeren sporer bak deg.<br><br><font face=/font/big_bold.font>Fortsett gjennom det første hjørnet. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observere hengeren når du kommer ut av svingen og forberede deg til å komme inn i neste.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fortsett gjennom neste sving. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Husk å observere din henger for å sikre at du er fri av hindringene rundt deg før du snur lastebilen.<br><br><font face=/font/big_bold.font>Fortsett rundt barrierehindringen foran. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Når din henger er fri av barrieren, sving hardt til passasjersiden for å stille deg opp for den smale passasjen. <br><br><font face=/font/big_bold.font>Fortsett mot den smale passasjen.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Denne delen vil kreve svært presis kjøring. Ta deg god tid og bruk speilene dine.<br><br><font face=/font/big_bold.font>Hold deg mot utsiden av hvert hjørne. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Denne svingen er veldig skarp, men du kan bruke all plassen foran deg til å rydde den enkelt.<br><br><font face=/font/big_bold.font>Gjør den siste svingen. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Avansert opplæringsbane - Henger"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "I det siste scenarioet i kapittel 3 tar vi en kjøretur på et lengre treningsbane med en rekke forskjellige svinger for å se hvor godt du har lært å manøvrere med en henger."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Skarp sving"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "FJERN DETTE MÅLET"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Median kryssover"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Første slålåm"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Andre slålåm"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Enkle svinger"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rundkjøring"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Rett seksjon"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Trang sving"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Siste svinger"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Kjøring til parkeringsplassen"
