#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Rundkjøringer er litt mer kompliserte å forsere med doble hengere enn med en enkel henger."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Du må kjøre langt nok inn til at begge hengerne kommer inn uten problemer, men du må deretter kjøre utover for å holde hengerne unna midten."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "Det er greit om ikke begge hengerne får plass i ett kjørefelt – faktisk kan det til og med være bedre å kjøre over begge kjørefeltene, slik at en optimistisk bilist ikke prøver å kjøre forbi deg."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Kjør til den andre siden av utkjøringsfeltet for å sikre at begge hengerne er fri for potensielle kollisjoner."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Fortsett til den andre rundkjøringen."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Denne rundkjøringen har bare ett kjørefelt, så ta deg god tid og vær presis."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Bruk all tilgjengelig plass – å ta snarveier her vil bare gjøre ting vanskeligere."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Ta avkjørselen og fortsett mot parkeringsplassen."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Parkere og sikre lastebilen."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Du er på en bane som er utformet for å gjøre deg kjent med å kjøre i rundkjøringer. Fortsett videre når du er klar."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Kjør godt inn i rundkjøringen før du kjører mot de ytre kjeglene for å sikre at begge hengerne kommer trygt inn."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Du bør kjøre til den andre siden av avkjørselen for å holde hengerne unna kjeglene. <br><br>Det kan være lurt å svinge mot midten av rundkjøringen rett før du kjører ut."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Dette skal du kunne å gjøre på egenhånd, ta deg god tid og bruke plassen din klokt."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Kjør forsiktig ut av rundkjøringen."

#!{
	key[]: "aca_msg_book3_3_11_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_3_11_end"
