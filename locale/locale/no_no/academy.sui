#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Rygge med en henger"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "I dette scenarioet vil du prøve deg på å rygge med en henger for første gang. Det er en ganske enkel manøvre, men du må fortsatt styre riktig for å sette hengeren i riktig posisjon."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Rygge mot hengeren"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Kobler til hengeren"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Løsne parkeringsbremsen"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Rygge med hengeren"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Fortsetter mot parkeringsplassen"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "La oss prøve oss på å rygge med en henger. Det er enklere enn det ser ut; du må bare være tålmodig."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Begynn å rygge og få traktoren på linje med hengeren."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Pass på at du er riktig stilt opp, ellers kan du ikke opprette forbindelsen. Hvis det ikke er riktig, kan du alltids trekke deg framover og prøve igjen."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Traktorens femte hjul vil låse seg på hengerens kongenål."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Sett på parkeringsbremsen og koble til hengeren. I det virkelige liv må du gå ut av lastebilen for å koble sammen luft- og elektriske ledninger og heve landingsutstyret, men her vil vi gjøre det for deg."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Hengeren vil alltid svinge <color value=@@clr_sel@@>mot <color value=@@clr_txt@@>til traktoren."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>For å snu hengeren må du styre traktoren i<color value=@@clr_sel@@> motsatt <color value=@@clr_txt@@> retning du vil at hengeren skal gå mot."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>For å rette ut hengeren igjen, drei traktoren <br><color value=@@clr_sel@@>mot<color value=@@clr_txt@@> hengeren."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Prøv å holde deg på linje med hengeren - du må gjøre konstante mindre korrigeringer for å holde hengeren pekt mot det merkede området."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Korrigere avvik fra banen din med små svinger på rattet så snart det skjer. Hvis du overstyrer den, kan du havne langt utenfor ønsket sti."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Stopp på det angitte området. Sikre lastebilen og skru av motoren."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Bak deg og til passasjersiden vil du se en henger. Din første oppgave blir å rygge til den.<br><br><font face=/font/big_bold.font>Forberede lastebilen til å rygge. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Begynn å rygge mot hengeren. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Still deg inn på en slik måte at du står rett med hengeren. Det femte hjulet må fange kongenålen. Trekk framover for å justere om nødvendig.<br><br><font face=/font/big_bold.font>Fortsett å rygge til du kjenner en tilkobling. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Det femte hjulet er koblet til kongenål, og du er klar til å fullføre koblingen til hengeren.<br><br><font face=/font/big_bold.font>Sett på parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Trykk på @@imv_nrm_attach@@ for å koble til hengeren. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Nå er hengeren trygt koblet til traktoren, luft- og elektriske ledninger er koblet til, og landingsstellet har blitt hevet.<br><br><font face=/font/big_bold.font>Løsne parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Du må rygge inn på parkeringsplassen rett bak deg. Husk at hengeren vil svinge i motsatt retning av hvordan du styrer traktoren. En liten dreining på rattet kan føre til betydelig bevegelse av hengeren.<br><br><font face=/font/big_bold.font>Begynn å rygge hengeren. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Ikke overstyr, bare prøv å holde hengeren på linje med stedet. <br><br><font face=/font/big_bold.font>Fortsett mot parkeringsplassen. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkering på en smal plass"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "I dette scenarioet vil vi parkere på en smal plass.<br><br>Du må manøvrere hengeren for å stille opp rett med en forskjøvet parkeringsplass."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manøvrering mot plassen"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkering mens du kjører framover, eller \"nese inn\", er ganske enkelt når det gjelder parkeringsmanøvrer. <br>Du må fortsatt kompensere for forskyvningssporingen av hengeren."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Du må kjøre forbi punktet der du normalt ville snudd traktoren av seg selv. Dette vil tillate deg å få hengeren oppstilt mer effektivt."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Når du nærmer deg parkeringsplassen, sving inn for å få traktoren foran hengeren. Still deg i kø og fortsett til stedet. <br>Stopp, parkere og sikre lastebilen og skru av motoren."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Foran deg er det en parkeringsplass som du må kjøre til og parkere på innsiden av.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Begynn å kjøre og sving mot parkeringsplassen.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Kjør forbi parkeringsplassen for å få hengeren på linje med det merkede området, deretter bring traktoren inn på stedet og rett ut.<br><br><font face=/font/big_bold.font>Parkere på det angitte området. </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Stopp i det angitte området.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Sikre lastebilen og skru av motoren.</font>"
#@}

