	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kamerakontroller"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "I dette scenarioet lærer vi om de ulike kameratypene som er tilgjengelige for deg og hvordan de kan hjelpe deg med å kontrollere og manøvrere lastebilen."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Seteposisjon"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Utsikt mot baksiden"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Speilsjekk"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Bytt til ekstern kamera"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Se rundt lastebilen"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "I dette scenarioet går vi gjennom de forskjellige kameraene<br>som er tilgjengelige for bruk."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Det er syv kameraer å velge mellom totalt, vi skal gå gjennom<br> noen av dem nå og forklare deres tiltenkte funksjoner."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "De ulike kameraene og deres forskjellige vinkler kan hjelpe deg når du manøvrerer på trange steder."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Å se hvor du skal er kjernegrunnlaget for sikker og profesjonell kjøring. Hvis den nåværende sittestillingen ikke passer deg, kan du endre den i '@@adjust_link_t@@' (Få tilgang til den via pausemenyen).<br><br><font face=/font/big_bold.font>Bekreft når du er klar med @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Når du rygger, gir speilene dine ikke alltid fri sikt. Det kan være nødvendig å se ut av vinduet bak deg for å få bedre utsikt.<br><br><font face=/font/big_bold.font>Drei kameraet helt til førersiden for å se ut av vinduet mot bak på hengeren.</font>@@aca_goal_tip@@ Du må være inne i kjøretøyet."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Bruk denne visningen for å sjekke hengeren under ryggemanøvrer med en henger. Det er alltid bedre å rygge til førersiden slik at du kan bruke denne utsikten. Når du rygger til passasjersiden, har du mye mer begrenset utsikt over hva som foregår bak deg.<br><br><font face=/font/big_bold.font>Se mot passasjersiden. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Dette er grunnen til at det vanligvis ikke anbefales å rygge mot passasjersiden; du kan se at utsikten er ganske begrenset. Heldigvis er det syv utvendige kameraer tilgjengelige for deg også. <br><br>Knappen @@imv_nrm_camcycle@@ kan brukes til å bytte til neste kamera i rekkefølge. Etter å ha gått gjennom alle de syv kameraene, går du tilbake til begynnelsen av syklusen. <br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_camcycle@@ for å bytte til neste kamera. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Den eksterne kameraet gir det beste perspektivet på hva som skjer rundt lastebilen.<br><br><font face=/font/big_bold.font>Se deg rundt i lastebilen.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Hvis du trykker på @@imv_nrm_camcycle@@ igjen, kan du bytte til neste kamera. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Ovenfra-ned-visningen gir en utmerket oversikt over situasjonen rundt lastebilen, noe som forenkler parkering og kjøring på trange steder betydelig.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_camcycle@@ for å bytte til neste kamera.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Takkameraet gir fri sikt over veien langt foran lastebilen uten store hindringer.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_camcycle@@ for å bytte til det endelige kameraet vi skal se på foreløpig.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Bakoversikten er en snarvei til visningen du fikk tidligere ved å vri på interiørkameraet. Som vi diskuterte, er det nyttig når du rygger eller parkerer.<br><br>I spillet har vi flere kameraer som du kan prøve ved å trykke på @@imv_nrm_camcycle@@ gjentatte ganger.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_cam1@@ for å gå tilbake til interiøret.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For en autentisk kjøreskoleopplevelse, anbefaler vi at du holder deg med \"Interiørkamera\"-visningen mens du går gjennom hvert av scenarioene.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_activate@@ for å bekreft og avslutt scenarioet.</font>@@aca_goal_tip@@ Du kan bruke @@o_im_cam_zoom@@-funksjonen for en bedre oversikt over omgivelsene. Det er spesielt nyttig når du ser gjennom speilene. Sjekk Alternativer-skjermen - '@@options_bindings_screen@@' - for å se og/eller endre tilsvarende kontroller."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Første kjøring"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "I dette scenarioet lærer vi hvordan du forbereder lastebilen til kjøring, og deretter kjører den framover for første gang."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Start tenningen"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Tenn motoren"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Sjekke omgivelsene"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Sette på driftsbremsen"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Sett i gir"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Løsne parkeringsbremsen"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Kjør framover"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Stopper"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Sette på parkeringsbremsen"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Skifter over til Nøytral"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Skrur av motoren"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "For de første kjøreturene dine bruker vi kun trekkvognen.<br>En lastebil blir referert til som en traktor når den ikke har et eget lasterom, og i stedet er avhengig av bruk av en henger for å transportere varer og materialer."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Traktorer er vanlige fordi de gir større allsidighet: de kan slippe en tom henger og hente en lastet uten å måtte vente, eller bytte helt til en annen type henger."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "For din første kjøretur vil oppgaven din være å kjøre framover og stoppe etter den stiplede linjen.<br>Start motoren, følg instruksjonene for å gjøre lastebilen klar til å flytte. Når du er klargjort, kjør rett frem."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Kjør forbi den stiplede linjen, stopp, skru av motoren og sikre lastebilen."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "For det neste trinnet i treningen din, flytter du lastebilen for første gang.<br><br>Selvfølgelig vil det ikke fungere uten motoren i gang, så først må du slå på tenningen.<br><br><font face=/font/big_bold.font>Trykk på $input engineelect$ for å slå på tenningen.</font>@@aca_goal_tip@@ På Karriere ved standard er motoren slått på sammen med strøm automatisk. For Karriere, du kan justere denne oppførselen i Alternativer-skjermen - 'Spill' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Tenningen aktiverer lastebilens elektronikk. Du har kanskje lagt merke til at varsellamper blinker på dashbordet - det er normalt. Hvis de forblir på når motoren er startet, signaliserer det sannsynligvis et problem med lastebilen. Unntaket er parkeringsbremselampen, som vil slå seg av når vi slipper parkeringsbremsene.<br><br>Heldigvis er denne lastebilen i god stand og vi er klare til å fortsette.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_engine@@ for å starte motoren. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Nå som motoren er startet, er det avgjørende å sjekke omgivelsene dine før du starter noen bevegelse.<br><br><font face=/font/big_bold.font>Se deg rundt i lastebilen og på sidespeilene til sjåføren og passasjerene for å bekrefte at området rundt lastebilen er klart.</font>@@aca_goal_tip@@ Du må være inne i kjøretøyet."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Det kan virke opplagt, men du bør vite hvordan du stopper før du starter noen bevegelse.<br><br><font face=/font/big_bold.font>Aktivere driftsbremsen ved å bruke $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Neste, du vil lære hvordan du endrer kjøreretningen.<br><br>Med en forenklet automatgir er det ikke nødvendig å skifte gir, alt gjøres automatisk for deg.<font face=/font/big_bold.font><br><br>Bruk $input forward$ for å aktivere et framovergir. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Neste, du vil lære hvordan du endrer kjøreretningen.<br><br>Den realistiske automatgirkassen lar deg skifte mellom Kjør, Nøytral og Revers akkurat som ekte automatgir.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_gearup@@ for å aktivere et framovergir. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Neste, du vil lære hvordan du endrer kjøreretningen.<br><br>Den sekvensielle girkassen gir mulighet for trinnvis giring, akkurat som ekte sekvensielle girkasser.<br><br>På samme måte som du legger inn et framovergir, mens du akselererer må du skifte til høyere gir.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_gearup@@ for å sette i første gir.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Neste, du vil lære hvordan du endrer kjøreretningen.<br><br>Med girspaken og kløtsjen vil du oppleve den samme følelsen av å fysisk skifte gir som med en ekte manuell girkasse.<br><br>Trykk ned kløtsjen og driftsbremsen helt. <font face=/font/big_bold.font>Bruk girspaken til å legge i første gir. <color value=@@clr_txt@@>Hold kløtsjen og driftsbremsen helt nede.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "For å begynne å bevege seg, må du først løsne parkeringsbremsen.<br><br><font face=/font/big_bold.font>Bruk @@imv_nrm_parkingbrake@@ for å løsne parkeringsbremsen.</font> @@aca_goal_tip@@ På Karriere er parkeringsbremsen i utgangspunktet deaktivert. Du kan justere denne oppførselen i Alternativer-skjermen - 'Spill' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Nå er lastebilen klar til å kjøre framover. Begynn å bevege deg og kryss den stiplede linjen.<br><br><font face=/font/big_bold.font>Start bevegelse ved å bruke gasspedalen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Nå er lastebilen klar til å kjøre framover. Begynn å bevege deg og kryss den stiplede linjen.<br><br><font face=/font/big_bold.font>Start bevegelse ved å bruke gasspedalen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Nå er lastebilen klar til å kjøre framover. Begynn å bevege deg og kryss den stiplede linjen.<br><br><font face=/font/big_bold.font>Start bevegelse ved å bruke gasspedalen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Nå er lastebilen klar til å kjøre framover. Begynn å bevege deg og kryss den stiplede linjen.<br><br><font face=/font/big_bold.font>Slipp opp driftsbremsen, slipp gradvis kløtsjen for å koble den inn mens du samtidig bruker gasspedalen for å holde turtallet oppe slik at lastebilen stanser ikke. Når kløtsjen er helt utløst, kan du akselerere og gire etter behov. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Bruk driftsbremsen for å stoppe.<br><br><font face=/font/big_bold.font>Bruk $input backward$ for å stoppe lastebilen. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Bruk driftsbremsen for å stoppe.<br><br><font face=/font/big_bold.font>Bruk $input backward$ for å stoppe lastebilen. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Bruk driftsbremsen for å stoppe.<br><br><font face=/font/big_bold.font>Bruk $input backward$ for å stoppe lastebilen. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Når det er på tide å stoppe, trykker du kløtsjen helt inn <font face=/font/big_bold.font>og stanser deretter lastebilen ved hjelp av driftsbremsen.<color value=@@clr_txt@@> Skift til Nøytral ved hjelp av girspaken, og da kan du slippe kløtsjen. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Sikre lastebilen nå. Parkeringsbremsen sikrer at lastebilen ikke beveger seg utilsiktet etter at du har parkert.<br><br><font face=/font/big_bold.font>Bruk @@imv_nrm_parkingbrake@@ for å aktivere parkeringsbremsen.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Med en forenklet automatgir er det ikke nødvendig å skifte gir, alt gjøres automatisk for deg.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_activate@@ for å bekrefte. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Skift til Nøytral ved å trykke på @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Skift til Nøytral ved å trykke på @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Skift girspaken i Nøytral, og deretter slipp kløtsjen. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Du vet nå hvordan du får lastebilen i bevegelse og hvordan du får den til å stoppe på en sikker måte.<br><br><font face=/font/big_bold.font>Trykk på $input engineelect$ for å skru av motoren. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Rygging"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "I dette scenarioet vil vi prøve å rygge for første gang. Vi vil også snakke om hvordan du kan bruke speilene dine til å se bak deg, hva du bør se etter og hvordan du forbereder deg på omvendt bevegelse."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Tenn motoren"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Sjekke passasjerens sidespeil"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Sjekke førersidespeil"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Sett i gir"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Løsne parkeringsbremsen"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Skifter over til Nøytral"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Skrur av motoren"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "For denne kjøreturen vil vi rygge i en rett linje. Du må rygge forbi den stiplede linjen og stoppe der."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Når du rygger med lastebilen, er det viktig å se deg rundt hele tiden, observere alle speilene og sørge for at plassen rundt og bak deg er fri."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Start motoren, skift til revers og begynn å bevege seg."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Rygg forbi den stiplede linjen, stopp, skru av motoren og sikre lastebilen."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Forberede lastebilen til å kjøres slik du lærte i forrige scenarioet.<br><br><font face=/font/big_bold.font>Når du er klar, skru på motoren. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Sjekk speilene dine for å sikre at området rundt deg er klart. Hvis du er misfornøyd med posisjonene deres, kan du justere dem i '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Se på din passasjerens sidespeil.</font>@@aca_goal_tip @@ Du må være inne i kjøretøyet."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Du vil bevege deg forbi den brutte linjen. Feltet er fri nå, men under vanlig kjøring er det viktig å hele tiden overvåke omgivelsene dine ved å se deg rundt og bruke speilene.<br><br><font face=/font/big_bold.font>Sjekk førersidespeilet.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Bruk $input backward$ for å sette i reversgir. </font>@@aca_goal_tip@@ Ved rygging aktiveres ryggealarmen automatisk på de fleste lastebiler. Du kan skru den av i Alternativer-skjermen - 'Lyd' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Trykk på @@imv_nrm_geardown@@ for å skifte til revers. </font>@@aca_goal_tip@@ Ved rygging aktiveres ryggealarmen automatisk på de fleste lastebiler. Du kan skru den av i Alternativer-skjermen - 'Lyd' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Trykk på @@imv_nrm_geardown@@ for å skifte til revers. </font>@@aca_goal_tip@@ Ved rygging aktiveres ryggealarmen automatisk på de fleste lastebiler. Du kan skru den av i Alternativer-skjermen - 'Lyd' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Trykk kløtsjen helt ned og flytt girspaken i revers. </font>@@aca_goal_tip@@ Ved rygging aktiveres ryggealarmen automatisk på de fleste lastebiler. Du kan slå den av i Alternativer-skjermen - 'Lyd' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Du har nå reversgir aktivert.<br><br><font face=/font/big_bold.font>Slipp parkeringsbremsen ved å bruke @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Begynn å bevege seg ved å bruke $input backward$.<br><br><font face=/font/big_bold.font>Rygge forbi den stiplede linjen. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Begynn å bevege seg ved å bruke gasspedalen: $input forward$.<br><br><font face=/font/big_bold.font>Rygge forbi den stiplede linjen. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Begynn å bevege seg ved å bruke gasspedalen: $input forward$.<br><br><font face=/font/big_bold.font>Rygge forbi den stiplede linjen. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Slipp kløtsjen sakte, mens du opprettholder motorens turtall ved å bruke gasspedalen. <br><br><font face=/font/big_bold.font>Rygge forbi den stiplede linjen. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Stopp lastebilen med driftsbremsen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Stopp lastebilen med driftsbremsen: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Stopp lastebilen med driftsbremsen: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Trykk kløtsjen helt ned og stopp deretter lastebilen ved å bruke driftsbremsene. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Aktivere parkeringsbremsen ved å bruke @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Med en forenklet automatgir er det ikke nødvendig å skifte gir som alt er gjort automatisk for deg, ulikt i virkeligheten.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_activate@@ for å bekrefte. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Skift til Nøytral ved å trykke på @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderne lastebiler vil automatisk skifte til nøytral når parkeringsbremsen er aktivert. Likevel er det en god vane å alltid gjøre det selv. I de følgende scenarioene vil vi ikke kreve dette trinnet."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Skift til Nøytral ved å trykke på @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@  Moderne lastebiler vil automatisk skifte til nøytral når parkeringsbremsen er aktivert. Likevel er det en god vane å alltid gjøre det selv. I de følgende scenarioene vil vi ikke kreve dette trinnet."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Skift girspaken til Nøytral, og slipp deretter kløtsjen.</font>@@aca_goal_tip@@  Moderne lastebiler vil automatisk skifte til nøytral når parkeringsbremsen er aktivert. Likevel er det en god vane å alltid gjøre det selv. I de følgende scenarioene vil vi ikke kreve dette trinnet."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Husk å alltid være oppmerksom på omgivelsene når du rygger, spesielt i travle områder med mye trafikk.<br><br><font face=/font/big_bold.font>Skru av motoren ved å trykke på $input engineelect$. </font>"
#@}

