#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Avansert opplæringsbane"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Det siste scenarioet i dette kapittelet er en kjøretur på et avansert opplæringsbane. Vi setter ferdighetene du har lært med en trekkvogn på en prøve!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slålåm"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slålåm"

	key[]: "aca_goal_book1_2_06_check1"
