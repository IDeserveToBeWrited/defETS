	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Rygge inn i dette stedet."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Stopp i det angitte området."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Sikre lastebilen og skru av motoren."
#@}




