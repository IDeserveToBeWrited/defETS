#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Denne treningsbanen vil gi deg en liten smakebit på ekte kjøring i trygge omgivelser på treningsområdet vårt. Test noen av dine nye ferdigheter, og husk å være oppmerksom på omgivelsene dine og å bruke all den tilgjengelige plassen. <br><br>Det lønner seg også å tenke fremover!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Fortsett videre og finn veien inn i banen."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Det er en nedoverbakke foran, du kan bruke denne til å få en følelse av kombinasjonen av doble hengere i fart."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Forberede til å bremse for svingen foran deg."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Kryss midtlinjen ved å svinge til høyre og deretter umiddelbart til venstre."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Kryss gjennom midtlinjen igjen."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Det finnes tider der du ikke har noe annet valg enn å jack-knife hele kombinasjonen. <br><br>Gjør det du må for å komme deg gjennom denne ekstremt skarpe svingen."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Fortsett å kjøre gjennom denne banen."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Kjør forsiktig gjennom slalåmen, og sørg ikke bare for at hengerne dine kommer forbi hver barriere, men også at du er klar til å kjøre rundt den neste."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Fortsett til venstre og kjør rett gjennom kryssene."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Følg asfalten til høyre."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Den siste svingen er misvisende; det er god plass, men vær forberedt på å parkere inntil den fjerne fortauskanten."

#!{
	key[]: "aca_msg_book3_train_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_train_end"
