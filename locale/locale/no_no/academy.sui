	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
