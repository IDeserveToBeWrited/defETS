#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "I dette scenarioet vil du møte en rekke forskjellige svinger for å hjelpe deg med å bli vant til å kjøre med en henger. Hold deg fokusert, justere hastigheten din til hver situasjon, og utnytte plassen som er tilgjengelig på treningsbanen fullt ut."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Den første svingen er en skarp sving - to svinger i en. Du må sette opp for en venstresving, men overgang til en høyresving midt i manøveren."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Denne neste svingen krysser deg over til den andre siden av medianen. Det er ikke spesielt vanskelig, men du må passe på at du gir nok plass til din henger."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Neste må du kjøre en tett slalåm gjennom betongbarrierene. Gå sakte og bruk speilene dine, og sørg for at du svinger bredt nok slik at din henger kan klare barrierene."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "På dette tidspunktet går du inn i en ny slalåm komplimentert av ekstra kjegler på toppen av hver kurve <br>Pass på at du ikke treffer noen av dem!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Neste er et par enkle hjørner på vei til rundkjøringen."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Bruk den rette delen for å forberede deg på å kjøre inn i rundkjøringen. Hold deg til utsiden før du går inn i den."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Kjør inn i rundkjøringen og se plasseringen av din henger. Den vil spore annerledes når du er inne i rundkjøringen sammenlignet med hvordan du kom inn."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Kjør ut av rundkjøringen og kjør videre til neste sett med svinger."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "FJERN DETTE FILMSEKVENSET"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Svingen her er ekstremt skarp. Ta det sakte og bruk plassen rundt deg smart. Vær også oppmerksom på hengerens halesving."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Når du kjører gjennom de neste svingene, husk å prøve å sette deg opp for neste sving når du kommer ut av den forrige."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Ikke forhast det siste hjørnet. Det ser enkelt ut, men det er mindre rom å manøvrere enn det ser ut til å være."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Stopp på det angitte området, sikre lastebilen og skru av motoren."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Akselerer mot den første svingen. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Den første svingen er en enkel skarp sving.<br><br><font face=/font/big_bold.font>Gjør svingen. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "FJERN DENNE SJEKKEN"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Foran fortsetter banen til venstre for medianen.<br><br><font face=/font/big_bold.font>Gjør din vei gjennom krysset. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manøvrere gjennom barrierene og husk å se din henger.<br><br><font face=/font/big_bold.font>Kjør gjennom slalåmen. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Denne slalåmen er mer grei, men trafikkkjeglene gjør den betydelig strammere.<br><br><font face=/font/big_bold.font>Kjør gjennom slalåmen og unngå å treffe noen kjegler. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Foran er et par enkle svinger, du må fortsatt sette opp riktig for å holde din henger unna de innvendige barrierene.<br><br><font face=/font/big_bold.font>Gjør svingene. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Du nærmer deg en rundkjøring. Husk å gi nok plass til din henger, ikke bare når du kommer inn og ut, men også når du kjører gjennom den.<br><br><font face=/font/big_bold.font>Kjør gjennom rundkjøringen. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Det er et kort rett parti foran deg, du kan øke farten hvis du vil.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Svingen her er ekstremt skarp. Gå sakte, bruk all plassen som er tilgjengelig for deg, og husk din hengerens halesving. <br><br><font face=/font/big_bold.font>Kjør gjennom den skarpe svingen. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "De siste svingene er rett frem. Husk å ha din henger i bakhodet.<br><br><font face=/font/big_bold.font>Fortsett videre. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Fortsett mot den endelige parkeringsplassen. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

