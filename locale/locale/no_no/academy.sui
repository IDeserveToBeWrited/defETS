	key[]: "aca_scenario_book3_parallel_title"
	val[]: "Parallell parkering"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "I dette scenarioet parallellparkerer vi et sett med doble hengere på en vei."

#### parallel goal

	key[]: "aca_goal_book3_parallel_check1"
	val[]: "Rygging"

