	key[]: "aca_msg_book3_night_slalom_double_stop"
	val[]: "Stopp i det angitte området."

	key[]: "aca_msg_book3_night_slalom_double_end"
	val[]: "Sikre kjøretøyet og skru av motoren."



#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Parkering i en sving"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "I dette scenarioet må du navigere deg gjennom en travel parkeringsplass full av upraktisk parkerte lastebiler for å parkere rundt en sving."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Det er ikke uvanlig å ankomme til en parkeringsplass som nesten er helt full av lastebiler slik at du har svært få muligheter til å parkere selv."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "I dette tilfellet er det bare ett sted igjen hvor du kan få plass til din dobbeltkombinasjon. <br><br>Kjør gjennom parkeringsplassen og parkere i svingen nær avkjørselen."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Fortsett gjennom parkeringsplassen og parkere langs svingen. <br><br>Fortsett når du er klar."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Du kommer ikke til å klare svingen her, du er nødt til å rygge og finne en annen vei gjennom."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Parkere i svingen foran."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Stopp i det angitte området."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Sikre lastebilen og skru av motoren."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Avsluttende eksamen"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "I dette scenarioet vil du sette dine nye ferdigheter på prøve i en bane som er utformet for å teste din presisjon og forståelse av kjøring med doble hengere."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Rygging"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Kommer inn på banen"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Komme i fart"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Forberede deg på å bremse"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Ikke nok fart"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Parkering"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Velkommen til den avsluttende eksamenen. Vi har skissert noen realistiske situasjoner du kan støte på på veien for å se hvordan du klarer å håndtere dem. Som alltid, ta deg god tid og vær presis. <br><br>Lykke til!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Veien videre er blokkert, snu deg på den angitte plassen."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Fortsett å kjøre på banen."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Oppnå en fart på minst 60 km/t (37 mph) mens du fortsetter nedover bakken."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Forberede deg på å bremse."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Du klarte ikke å oppnå en fart på 60 km/t (37 mph)."

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Fortsett å kjøre gjennom denne banen."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Det er en parkeringsplass til deg i rekken med lastebiler til høyre. Rygg inn og parkere."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Fortsett framover når du er klar."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

