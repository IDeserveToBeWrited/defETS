#### double_90 common

	key[]: "aca_scenario_book3_double_90_title"
	val[]: "90 graders svinger"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "I dette scenarioet får du i oppgave å kjøre gjennom en bane med 90-graders svinger med varierende vanskelighetsgrad."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Sette av gårde"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Kjør framover"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Bruk dine speil"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Det er gratis eiendom"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Sett det opp"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Planlegg framover"

