#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Velkommen til @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Følgende scenarioer representerer det første steget på din reise til profesjonell lastebilkjøring."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Her vil du lære alt fra de grunnleggende systemene og kontrollene til lastebilen..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...til komplekse manøvrer både med og uten en henger."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Vi vil hjelpe med å innføre vaner som vil hjelpe deg å navigere trygt i en rekke situasjoner,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "og lære deg å bruke plassen som er tilgjengelig for å effektivt manøvrere din lastebil."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Ved å fullføre alle scenarioene og bestå de avsluttende eksamenene,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "du vil være klar til å kjøre på veiene i Europa og finne nye utfordringer å møte."

#@}

