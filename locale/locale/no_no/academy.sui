#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Bakkingssandkasse"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "I dette scenarioet blir du satt inn på en tom parkeringsplass for å øve på å rygge med doble."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Komme i gang"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentering"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Fullfører"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Avslutning av scenarioet"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Rygging med doble hengere krever mye mer oppmerksomhet enn med en enkel henger. Du må planlegge på forhånd hvor du vil at den bakre hengeren skal, samtidig som du har kontroll på den fremre hengeren og førerhuset. <br><br>Tenk på det slik – du må bruke den fremre hengeren til å styre den bakre hengeren."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "I dette tilfellet ønsker vi å snu den bakre hengeren mot førersiden. For å styre den på denne måten, må vi skyve fronten av den bakre hengeren mot passasjersiden. <br><br>Merk at det i hovedsak betyr at du må snu den fremre hengeren motsatt vei av hva du vil styre den bakre hengeren."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Når den bakre hengeren begynner å svinge, er det viktig å rette opp traktoren med den fremre hengeren. Det er her hvor folk flest ofte gjør sin første feil."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Her ser vi at sjåføren ikke har fulgt ledende, og er i ferd med å jack-knife opp sine hengere."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Jack-knifing skjer når vinkelen mellom to kjøretøy i kombinasjonen blir rundt 90 grader. Når dette skjer, er det ikke mulig å redde det – du må kjøre fremover og gjøre et nytt forsøk. <br><br> Som med å rygge en henger, bør målet alltid sørge for at alle hjulene på hengerne beveger seg. Når ett hjul stopper og hengeren snur på plass, kan du ikke fortsette."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Du kan dra fremover til der du sist var riktig, eller rettere sagt, en posisjon der du kan fortsette å jobbe i revers uten å gjøre den samme feilen igjen. <br><br>I dette tilfellet vil vi dra fremover til en rett posisjon og prøve på nytt fra begynnelsen."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Når den bakre hengeren begynner å svinge igjen, plasser traktoren foran ledende og la den bakre hengeren svinge av seg selv et øyeblikk."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nå som den bakre hengeren svinger dit vi vil at den skal, er det på tide å styre ledende for å følge den. Du kan justere vinkelen mellom ledende og bakenden for å kontrollere svingen og gjøre den skarpere eller bredere."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Den siste delen av manøveren er å rette ut alt. Få ledende opp på linje med bakenden."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Du bør huske på hvor lang tid det vil ta å flytte den ledende hengeren. Hvis du venter for lenge, vil den bakre hengeren prøve å kjøre tilbake dit du nettopp kom fra!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Du kan gjerne bruke så mye tid her du vil, eksperimentere med forskjellige manøvre til du tror du har en viss idé om hvordan du skal manipulere hengerne i revers. <br><br>Men aller viktigst, husk å ha det gøy!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Forberede deg på å sette i gang."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Bruk denne parkeringsplassen for å få en følelse av hvordan man skal håndtere hengerne i revers. <br><br>@@aca_goal_tip@@ Er du nybegynner med å rygge hengere generelt? Vurdere å spille Grunnleggende lastebilkjøring."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Ta så lang tid du trenger til å øve. <br><br>Når du er fornøyd, kan du stoppe og sikre lastebilen for å avslutte dette scenarioet."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Skru av motoren for å avslutte dette scenarioet."
#@}


