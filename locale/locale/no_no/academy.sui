#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "For det siste scenarioet i dette kapittelet, kjører vi på testbanen med en kompleks konfigurasjon."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Det første hinderet er slalåm gjennom noen barrierer. Kjør gjennom den og husk å bruke speilene dine."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Neste er en hårnålssving. Hold svingen bred slik at det ikke bør by på noen problemer."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Det er en 90 graders venstresving her. Husk å kjøre dypt slik at baksiden av lastebilen klarer de innvendige bommene."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Rampehindret kan være litt vanskelig. Still deg opp så godt du kan før du kjører på den, og bruk front- og sidespeilene for å hjelpe deg med å orientere deg."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Neste seksjon må gjøres med rygging. Nærme deg barrierene framover med det i tankene."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Følg veimerkingen tilbake og til høyre for deg."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Rygge til bommene, deretter stopp og fortsett framover til venstre."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Fortsett gjennom pausen i medianen til neste seksjon."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Denne passasjen gjennom kjeglene er veldig smal. Kjør sakte og bruk speilene for å orientere deg i passasjen."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Husk å kjøre dypt i 90 graders svinger."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Du kommer inn på et fint åpent veistykke. Du kan få opp litt fart, men husk at du snart må bremse ned for kurven videre."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "I bunnen av bakken er det noen bommer over veien. Kjør opp til dem, og rygge deretter inn på parkeringsplassen til venstre."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Rygge til parkeringsplassen."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parkere, skru av motoren og sikre lastebilen."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Foran deg er en slalåm laget av barrierer.<br><br><font face=/font/big_bold.font>Kjør gjennom slalåmen.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Hold deg mot utsiden av svingen for å sikre at baksiden av traktoren ikke går over fortauskanten.<br><br><font face=/font/big_bold.font>Gjør svingen. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Du kommer opp til en 90 graders venstresving. Husk å bruke all plassen du har tilgjengelig.<br><br><font face=/font/big_bold.font>Gjør svingen. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Still deg inn etter rampen. Det er ikke mye plass til å gjøre korrigeringer når du først er på den.<br><br><font face=/font/big_bold.font>Kjør over rampen. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Følg banen til venstre. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Den følgende seksjonen må bli fullført med rygging. Stopp ved barrierene foran slik at du vil kunne rygge mot høyre etterpå.<br><br><font face=/font/big_bold.font>Stopp ved barrierene.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Rygge mot området bak deg og til høyre. Det er piler på veien for å hjelpe deg.<br><br><font face=/font/big_bold.font>Rygge mot neste seksjon. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Fortsett å rygge mot barrierene bak deg.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stopp og bytt til et framovergir, deretter fortsett til venstre. <br><br><font face=/font/big_bold.font>Kjør framover. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Det er et brudd i medianen til venstre. Kjør gjennom den.<br><br><font face=/font/big_bold.font>Fortsett videre. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Foran deg er en smal svingete sti gjennom noen kjegler. Kjør forsiktig og bruk speilene om nødvendig.<br><br><font face=/font/big_bold.font>Kjør gjennom kjeglene. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Fortsett gjennom banen.<br><br><font face=/font/big_bold.font>Sving til venstre. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Husk å holde til venstre før svingen for å gi deg selv så mye plass som mulig.<br><br><font face=/font/big_bold.font>Gjør svingen. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Du kan øke litt fart her, men det er en kurve som kommer opp framover.<br><br><font face=/font/big_bold.font>Fortsett langs banen. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Kurven blir skarpere etter hvert som du tar deg gjennom den.<br><br><font face=/font/big_bold.font>Justere hastigheten deretter og fortsett.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Nederst i bakken vil du se barrierer som blokkerer veien. <br><br><font face=/font/big_bold.font>Stopp i nærheten av barrierene. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Bak deg og til venstre er det en parkeringsplass.<br><br><font face=/font/big_bold.font>Rygge inn på parkeringsplassen. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Stopp på det merkede stedet. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Kjøring på håndteringsbane"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "I dette scenarioet tar vi en kjøretur på en bane designet for å teste din evne til å håndtere lastebilen gjennom forskjellige typer kurver og svinger."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Kommer inn på banen"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Gjør en gradvis venstresving"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Kjøring gjennom S-svinger"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Rett seksjon"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Enkle svinger"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Avslutter opplæringsbanen"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Nærmer seg parkeringsplassen"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "I dette scenarioet tar vi trekkvognen en kort kjøretur for å se hvordan du håndterer den med dine nyervervede ferdigheter."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Det finnes ulike typer og kombinasjoner av svinger på banen. Det er ikke et løp, og det er ikke på tid. Vær tålmodig og justere kjørehastigheten til svingene og hindringene du møter."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "I begynnelsen er banen skånsom og lett, men svingene blir mer komplekse etter hvert som du går."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Vær oppmerksom på hastigheten din; det er lett å komme for fort i gang og så feilvurdere en sving."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Avkjørselen fra banen er en veldig trang hårnålssving. Gå sakte og bruk all plassen som er tilgjengelig for deg."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parkere mellom barrierene og sikre lastebilen."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "For å fullføre dette scenarioet må du ikke krasje, kjøre av banen eller treffe noen trafikkkjegler.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Fortsett framover inn i den skarpe høyresvingen for å gå inn på banen. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Kjør gjennom svingen i en fin jevn hastighet. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Du nærmer deg en mer kompleks seksjon av svingete svinger.<br><br><font face=/font/big_bold.font>Justere hastigheten deretter og fortsett.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Fortsett mot neste sett med svinger.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Det kommer noen enkle, skånsomme svinger. Hold hastigheten jevn.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Svingen ut av banen er en skarp hårnålssving. Senk farten og hold deg på utsiden før svingen. Sørg for å bruke speilene dine!<br><br><font face=/font/big_bold.font>Sving ut av banen. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Foran deg er det en parkeringsplass mellom noen barrierer.<br><br><font face=/font/big_bold.font>Fortsett mot parkeringsplassen. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parallell parkering"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "I dette scenarioet skal vi ta en titt på parallellparkering mellom to andre lastebiler."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Stopper foran parkeringsplassen"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Sjekke bakspeilet"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Rygge til parkeringsplassen"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Justere lastebilen på innsiden av parkeringsplassen"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parallellparkering er en avgjørende ferdighet som alle lastebilsjåfører bør kjenne til.<br>Forberede deg på å sette i gang."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Kjør mot parkeringsplassen.<br>Vær oppmerksom på omgivelsene dine."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Still deg på linje med lastebilen foran din parkeringsplass. Ikke vær for nærme den, hold litt avstand fra den slik at du har plass til å jobbe."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Snu skarpt mot plassen og begynn å rygge."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Når du ser ut fra førersidespeilet, sikt deg mot fortauskanten rett foran lastebilen bak deg."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Når den fremre støtfangeren din klarerer lastebilen foran deg, kan du begynne å styre frontenden av lastebilen inn på stedet, og justere lastebilen med parkeringsplassen."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Rett ut hjulet og sentrer lastebilen innenfor parkeringsplassen.<br>Parkere og sikre lastebilen."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Foran deg er det noen parkerte lastebiler. Det er én åpen plass igjen for deg å parkere på. <br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Husk å være oppmerksom på omgivelsene dine. Gjør god bruk av speilene dine gjennom hele denne manøveren. <br><br><font face=/font/big_bold.font>Kjør framover. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Kjør forbi parkeringsplassen og inn i det merkede området. Derfra kan du begynne med din ryggemanøvrering.<br><br><font face=/font/big_bold.font>Stopp på det merkede stedet. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Sjekk omgivelsene dine for hindringer og for å sikre at du er klar til å rygge.<br><br><font face=/font/big_bold.font>Se gjennom passasjerens sidespeil. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Snu hjulene og rygge inn på parkeringsplassen.<br><br><font face=/font/big_bold.font>Begynn å rygge. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Begynn å rette opp lastebilen når det passer. Ikke kjør over fortauskanten!<br><br><font face=/font/big_bold.font>Sett lastebilen på linje med stedet. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

