	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>For å avslutte scenarioet, sikre lastebilen og skru av motoren.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Du er på rett sted, men vender i feil retning.<br><br><font face=/font/big_bold.font>Snu lastebilen rundt før du fullfører scenarioet.</font>"
