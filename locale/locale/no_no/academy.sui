#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Grunnleggende styring og kjøring"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Lær grunnleggende kjøretøykontroller, og hvordan du kjører lastebilen framover og i revers."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført Kapittel 1: @@aca_chapter_book1_1_title@@.<br><br>Du har lært hvordan du skal klargjøre lastebilen før du kjører,<br>kjøring framover og i revers, og hvordan du bruker lys og vindusviskere.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Grunnleggende manøvrering"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Lær å kjøre, manøvrere og parkere med en trekkvogn. Utforsk formålet med hver type speil og hvordan de skal brukes."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulerer!<br>Du har fullført Kapittel 2: @@aca_chapter_book1_2_title@@.<br><br>Du har lært hvordan du skal bruke hvert speil på lastebilen, sjekke plassen rundt lastebilen før du flytter og utføre begge grunnleggende og avanserte manøvreringer.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manøvrering med en henger"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Lær å koble til og manøvrere med en henger gjennom ulike situasjoner."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulerer!<br>Du har fullført Kapittel 3: @@aca_chapter_book1_3_title@@.<br><br>Du har lært å koble til og fra en henger,<br>kjenne etter vekten og dimensjonene til lastebilen med en henger<br>og kjøre på utfordrende baner med en henger.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Rygge med en henger"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Lær nye manøvrer for å effektivt rygge og parkere med en henger."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulerer!<br>Du har fullført Kapittel 4: @@aca_chapter_book1_4_title@@.<br><br>Du har lært å rygge med en henger<br>og ulike parkeringsteknikker.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Avsluttende eksamen"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Vis kunnskapen din og ferdighetene dine for å bevise at du er verdt som en lastebilsjåfør!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulerer!<br>Du har fullført Kapittel 5: @@aca_chapter_book1_5_title@@.<br><br>Du har bevist at du har alle nødvendige ferdigheter<br>for å kjøre, manøvrere og parkere en lastebil!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Oppvarming av motoren"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Du har fullført opplæringen: @@aca_chapter_book2_0_title@@.<br><br>Du har lært regler og funksjoner i kjøreferdigheter.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Tilbake i gir"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført kapittel 2: @@aca_chapter_book2_1_title@@.<br><br>Du har varmet opp motoren, testet girene, spunnet hjulene ordentlig og sjekket bremseeffektiviteten. De neste kapitlene kommer til å være mer utfordrende.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Hjul i bevegelse"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført kapittel 3: @@aca_chapter_book2_2_title@@.<br><br>Du har mestret vanskelige og varierte scenarioer. Du har vist ferdigheter og ytelse.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Hjemmestrekning"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført kapittel 4: @@aca_chapter_book2_3_title@@.<br><br>Du har håndtert mange vanskelige situasjoner med manøvrering, parkering og rygging med en henger. Du har bevist at du er en dyktig sjåfør som er i stand til å håndtere alle utfordrende lastebilkjøringssituasjoner.</font><br><br>"

	key[]: "aca_chapter_book3_1_title"
	val[]: "Fremover"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Lær alle de viktigste teknikkene for håndtering av doble hengere når du kjører fremover."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført kapittel 1: @@aca_chapter_book3_1_title@@.<br><br>Du har lært hvordan du skal kjøre og manøvrere med doble hengere effektivt.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Ryggekontroll"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Forstå de nødvendige trinnene for manøvrering av doble hengere ved rygging."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført kapittel 2: @@aca_chapter_book3_2_title@@.<br><br>Du har lært den formidable erfaringen med å rygge med doble hengere.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Forberedelse i den virkelige verden"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Bruk din nye kunnskap i mer avanserte scenarioer."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulerer!<br>Du har fullført kapittel 3: @@aca_chapter_book3_3_title@@.<br><br>Du har håndtert mange vanskelige situasjoner med manøvrering, parkering og rygging med doble hengere. Du har bevist deg selv her, nå er det på tide å trekke noen doble hengere på veiene i Euro Truck Simulator 2!</font><br><br>"


#@}

