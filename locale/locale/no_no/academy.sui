#+ Intro test scenario
#@{
#### Intro common
	key[]: "aca_scenario_book1_intro_title"
	val[]: "Grunnleggende lastebilkjøring"

	key[]: "aca_scenario_book1_intro_desc"
	val[]: "Vis introduksjonsfilmsekvensen igjen"
