#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Stopp i nærheten av en hindring"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "I dette scenarioet vil vi snakke om frontspeilet - dets plassering og hvordan du kan bruke det effektivt for å stoppe nær en hindring foran."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Sjekke frontspeilet"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Forstå dens funksjon"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Stopp i nærheten av hindringen"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Lastebiler har en stor blindsone i området foran traktoren. Det er lett å miste av syne en fotgjenger eller til og med en bil i dette området, så lastebiler er utstyrt med et frontspeil som kan sees gjennom frontruten."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Det fremre speilet er designet for å gi føreren utsikt inn i denne blindsonen.<br>Det er et viktig verktøy for å sikre at du ikke kolliderer med noen hindringer når du manøvrerer på trange steder."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Begynn å kjøre, fortsett mot barrieren foran deg, og sett ned farten når du nærmer deg den.<br>Hold øye med frontspeilet."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Stopp mellom linjen og hindringen."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "I dette scenarioet lærer vi å bruke frontspeilet vist i diagrammet.<br><br><font face=/font/big_bold.font>Se gjennom den øvre delen av frontruten for å se det.</font>@@aca_goal_tip@@ Du må være inne i kjøretøyet."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Det fremre speilet lar deg se inn i blindsonen foran lastebilen. Det kan hjelpe deg med å være sikker og presis i kjøringen.<br><br>Hvis du ikke er fornøyd med justeringen, åpne '@@adjust_link_t@@' (kan nås via pausemenyen) for å justere den etter din smak.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_activate@@ for å fortsette. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Rett foran lastebilen er det et merket sted. Du vil legge merke til at det er en hindring på den andre siden av stedet; når du er i nærheten av det, kjør veldig sakte og sjekk avstanden til hindringen i frontspeilet.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Lastebilen er fortsatt ikke klar til å bevege seg, kanskje du har glemt noe?<br><br>Er motoren på? Har du løsnet parkeringsbremsen?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Kjør mot parkeringsplassen. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Stopp fronten av lastebilen mellom hindringen og den malte veimarkeringen. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

