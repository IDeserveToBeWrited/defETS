#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkering ved siden av en hindring"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "I dette scenarioet lærer vi å parkere ved siden av en fortauskant ved hjelp av sidespeilet."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Sjekke sidespeilet"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Kjøring mot fortauskanten"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Sidespeilet er et annet verktøy som vil hjelpe deg å manøvrere lastebilen på en sikker måte. Den er plassert på den øvre rammen av passasjerdøren."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Kjør fremover og sving sakte til passasjersiden."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Disse treplankene representerer en fortauskant. Du må parkere ved siden av. <br>Snu mot fortauskanten for å få lastebilen i en god posisjon for å stille opp med parkeringsplassen."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Senk farten godt før fortauskanten og sving mot parkeringsplassen. Når du retter deg ut, kan du bruke sidespeilet til å bedømme avstanden din fra fortauskanten."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Stopp på parkeringsplassen og sikre lastebilen."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Se gjennom vinduet på passasjersiden. Du kan se sidespeilet der.</font>@@aca_goal_tip@@ Du må være inne i kjøretøyet."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Sidespeilet dekker området på passasjersiden der føreren ikke kan se. Det er en av de mest problematiske blindsonene på lastebilen. Hvis vinkelen på speilet ikke passer deg, kan du justere den i '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Lastebilen er fortsatt ikke klar til å bevege seg, kanskje du har glemt noe?<br><br>Er motoren på? Har du løsnet parkeringsbremsen?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Foran deg er det en linje med planker som representerer en fortauskant. I enden av fortauskanten er en parkeringsplass. Du må kjøre dit. <br><br><font face=/font/big_bold.font>Fortsett når du er klar. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Snu mot fortauskanten. Bruk front- og sidespeilene for å sjekke posisjonen din i forhold til fortauskanten, men pass også på å ikke kjøre over noen trafikkkjegler.<br><br><font face=/font/big_bold.font>Kjør mot fortauskanten og inn på parkeringsplassen.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Sikre lastebilen og skru av motoren.</font>@@aca_goal_tip@@ Du kan bruke forhåndsinnstillinger for interiørutseende for å gjøre det lettere å se på speil. Sjekk Alternativer-skjermen - '@@options_bindings_screen@@' - for å se og/eller endre tilsvarende kontroller."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Omvendt parkering ved siden av en hindring"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "I dette scenarioet rygger vi lastebilen til en parkeringsplass ved siden av en fortauskant."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instruksjoner"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Rygge mot fortauskanten"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parkering av lastebilen"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "I dette scenarioet vil vi utføre en ryggemanøver for å parkere ved siden av en fortauskant."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Rygge mot fortauskanten.<br>Du må være oppmerksom på omgivelsene dine når du rygger, så bruk speilene."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Når du kommer nærmere, kan du begynne å justere lastebilen med parkeringsplassen. Se begge sider av lastebilen mens du rygger."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Stopp på parkeringsplassen og sikre lastebilen."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Parkeringsplassen er bak deg mot passasjersiden. Bruk speilene dine til å navigere deg frem til stedet.<br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Husk å bruke speilene for å sjekke omgivelsene dine før du beveger lastebilen.<br><br><font face=/font/big_bold.font>Begynn å rygge mot fortauskanten. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Fortsett å overvåke omgivelsene dine mens du rygger inn på parkeringsplassen.<br><br><font face=/font/big_bold.font>Stopp på det angitte stedet. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
