#+ Viewpoint descriptions for Tourist Jobs photo album
#@{
	
	key[]: "at_cut_grossglockner_desc"
	val[]: "Grossglockner, Østerrikes høyeste fjelltopp på 3798 meter, rager over Alpene. Fjellet er kjent for den 48 kilometer lange høyfjellsveien med 36 hårnålssvinger, til og med Pasterze som er den lengste isbreen i Østerrike og de østlige Alpene.<br><br>Sand fra Sahara som blåses tusenvis av kilometer nordover, kan av og til farge snøen langs høyfjellsveien knallgul eller oransje."

	key[]: "at_cut_schonbrunn_desc"
	val[]: "Schönbrunn slott som er en tidligere sommerresidens for habsburgerne, står på UNESCOs verdensarvliste og er et av Europas fineste barokkanlegg.<br><br>Den tilhørende dyrehagen som ble grunnlagt i 1752, er verdens eldste dyrehage som har vært i kontinuerlig drift."

	key[]: "at_cut_worthersee_desc"
	val[]: "Wörthersee-sjøen er en turkis perle, formet under den siste istiden og kjent for sitt klare, mineralrike vann.<br><br>Ifølge sagnet sank en hel by med tilhørende kirke ned i innsjøen, og lokalbefolkningen hevder fremdeles å kunne høre kirkeklokkene ringe under vann."

	key[]: "de_cut_ettal_desc"
	val[]: "Ettal kloster er et benediktinerkloster i de bayerske alper som ble grunnlagt i 1330 av keiser Ludvig IV av Bayern.<br><br>Ifølge sagnet knelte hesten til Ludvig tre ganger på stedet, noe han tolket som et tegn på at han skulle bygge klosteret nettopp der."

	key[]: "de_cut_stuttgart_city_desc"
	val[]: "Staatstheater i Stuttgart, tegnet av arkitekten Max Littmann, åpnet i 1912 som det kongelige hoffteateret i kongeriket Württemberg.<br><br>Stuttgart ligger over Europas nest største forekomst av mineralvann, der enkelte kilder har et så høyt naturlig innhold av kullsyre at et bad i dem føles som å ligge i champagne."

	key[]: "de_cut_nurnberg_city_desc"
	val[]: "Nürnberg var en av de viktigste byene i Det tysk-romerske rike, og er fremdeles kjent for sine bemerkelsesverdig omfattende festningsverk fra middelalderen.<br><br>I 1561 ble skrekkslagne innbyggere i Nürnberg vitne til et omfattende «luftslag» ved daggry, der lysende kuler og kors viste seg på himmelen. Hendelsen ble foreviget i et tresnitt som i dag trekkes frem som en tidlig observasjon av uidentifiserte flyvende objekter (UFO-er)."

	key[]: "de_cut_frankfurt_city_desc"
	val[]: "Frankfurts finansdistrikt, kjent under kallenavnet \"Mainhattan\", huser hovedkontorene til mange viktige banker.<br><br>Frankfurt er hjemsted for en av verdens eldste handelsmesser, med røtter tilbake til 1100-tallet. I dag arrangeres verdens største bokmesse her hver høst."

	key[]: "de_cut_rostock_desc"
	val[]: "Plassen Neuer Markt i Rostock som er omgitt av kjøpmannshus med gavler i teglsteinsgotikk, har vært byens sentrale markedsplass siden 1200-tallet.<br><br>Rostock huser det eldste universitetet langs Østersjøkysten, grunnlagt i 1419 for mer enn 600 år siden."

	key[]: "de_cut_duisburg_desc"
	val[]: "Duisburgs rådhus, Rathaus, ble ferdigstilt i 1902 i tidlig renessansehistoristisk stil, og står på et sted der det en gang lå et middelaldersk kongelig palass.<br><br>Duisburg ligger der Rhinen og Ruhr møtes, noe som gjør innlandshavnen til den største elvehavnen i Tyskland."

	key[]: "de_cut_kassel_desc"
	val[]: "De første historiske omtalene av Kassel stammer fra år 913 og beskriver et befestet sted ved en bro over elven.<br><br>Selve navnet er langt eldre og stammer fra den germanske stammen chatti."

	key[]: "de_cut_berlin_desc"
	val[]: "Seierssøylen i Berlin, som sto ferdig i 1873, minnes prøyssiske militærseire fra 1800-tallet og står i parken Tiergarten.<br><br>Søylen ble i 1938–39 flyttet 1,5 kilometer til sin nåværende plassering som ledd i en omfattende omforming av byen, og fikk samtidig en fjerde seksjon som gjorde den enda høyere."

	key[]: "de_cut_dresden_desc"
	val[]: "Dresdens barokke Frauenkirche som sto ferdig i 1743 på Neumarkt nær elven Elben, er et av de arkitektoniske landemerkene i en by som har fått kallenavnet \"Firenze ved Elben\" eller \"det tyske Firenze\".<br><br>I 2009 ble Dresden det første stedet i Europa som mistet sin status som UNESCO-verdensarv, en status som gikk tapt på grunn av byggingen av én enkelt bro."

	key[]: "ch_cut_geneve_desc"
	val[]: "Fontenen Jet d'Eau i Genève spruter vann fra innsjøen opptil 140 meter opp i luften, i nærheten av der Rhône renner ut av Genèvesjøen.<br><br>Siden 1818 har Genève markert vårens ankomst ved å følge med på et bestemt hestekastanjetre. En offentlig representant kunngjør at årstiden har begynt når det første bladet på treet folder seg ut – en tradisjon som holdes i hevd den dag i dag."

	key[]: "ch_cut_zurichw_desc"
	val[]: "Zurich vest er et tidligere industriområde som siden 1990-tallet har blitt forvandlet til et trendy strøk, med det glasskledde Prime Tower som et sentralt blikkfang.<br><br>Den mest dristige butikken i Zurich vest er bygget av 19 rustne containere, stablet i ni etasjers høyde på et tidligere industriområde."

	key[]: "ch_cut_furka_desc"
	val[]: "Furkapasset er en høyfjellspassovergang på 2429 meter som forbinder kantonene Uri og Valais i det sentrale Sveits.<br><br>De krappe svingene spilte en sentral rolle i biljakten i filmen Goldfinger fra 1964, og én av svingene har fått kallenavnet \"James Bond Strasse\"."

	key[]: "nl_cut_devlieter_desc"
	val[]: "De Vlieter utgjør en del av Afsluitdijk, den 32 kilometer lange demningen som stengte av Zuiderzee og skapte IJsselmeer.<br><br>Tidevannsrennen og de omkringliggende farvannene i Vadehavet ved De Vlieter har gjennom historien slukt anslagsvis 500 til 1000 skip."

	key[]: "nl_cut_eindhoven_desc"
	val[]: "Eindhoven er en nederlandsk by i Nord-Brabant, kjent som fødestedet og det mangeårige hovedkvarteret til elektronikkgiganten Philips.<br><br>Philips startet opp der i 1891 med produksjon av lyspærer, noe som ga Eindhoven kallenavnet \"Lysbyen\"."

	key[]: "nl_cut_groningen_desc"
	val[]: "Groningen er en livlig universitetsby nord i Nederland, dominert av det ruvende kirketårnet Martinitoren.<br><br>Lokalbefolkningen kaller kjærlig Martinitoren for \"d’Olle Grieze\", eller \"den gamle grå\"; det er det tredje tårnet på stedet, etter at to forgjengere gikk tapt som følge av lynnedslag."

	key[]: "be_cut_ardennes_desc"
	val[]: "La Roche-en-Ardenne er en liten belgisk by som domineres av ruinene av en middelalderborg, beliggende ovenfor en sving i elven Ourthe."

	key[]: "be_cut_antwerp_desc"
	val[]: "Antwerpen er Belgias nest største by og en historisk havneby, kjent som verdens sentrum for diamanthandel helt siden 1447.<br><br>Om lag 80 til 90 prosent av verdens rådiamanter passerer gjennom Antwerpen-diamantkvartalet hvert år."

	key[]: "fr_cut_brest_desc"
	val[]: "Marinaen i Brest ligger i den historiske havnen som kardinal Richelieu i 1631 gjorde om til en fransk marinebase.<br><br>Marinaene i Brest er et viktig knutepunkt for havseilas og her samles eliteutøvere før de legger ut på ferd over Atlanterhavet eller forsøker å sette noen av seilsportens tøffeste verdensrekorder."

	key[]: "fr_cut_marseille_desc"
	val[]: "Den gamle havnen i Marseille har fungert som byens naturlige havn helt siden greske nybyggere grunnla Massalia rundt år 600 f.Kr.<br><br>Det er en av de eldste havnene i Europa som har vært i kontinuerlig drift."

	key[]: "fr_cut_peyrat_desc"
	val[]: "Peyrat-le-Château er en liten landsby i departementet Haute-Vienne, anlagt ved et tjern på platået Plateau de Millevaches i Limousin.<br><br>Navnet Plateau de Millevaches er nokså uvanlig; det kan enten stamme fra \"tusen kuer\" som en gang beitet der, eller fra et gammelt ord for de mange naturlige kildene som finnes over hele platået, men ingen vet helt sikkert hvilket!"

	key[]: "fr_cut_rousse_desc"
	val[]: "L'Île-Rousse er en kystby i regionen Balagne nordvest på Korsika, grunnlagt i 1758 av Pasquale Paoli.<br><br>Paoli anla havnen slik at korsikanerne kunne drive handel uten å være avhengige av den rivaliserende, genovesisk-kontrollerte havnen i Calvi."

	key[]: "fr_cut_serre_desc"
	val[]: "Lac de Serre-Ponçon er et enormt reservoar i Hautes-Alpes, skapt mellom 1955 og 1960 ved oppdemming av elven Durance.<br><br>Lac de Serre-Ponçon er så stort, det dekker nesten 3000 hektar at det har fått kallenavnet \"havet i fjellene\", og et enslig kapell på en bitte liten øy stikker frem like over vannflaten i reservoaret."

	key[]: "fr_cut_usse_desc"
	val[]: "Château d'Ussé er et eventyraktig slott i Loiredalen, bygget mellom 1400- og 1600-tallet på tuftene av en tidligere vikingfestning.<br><br>Forfatteren Charles Perrault skal ha hentet inspirasjon fra slottets hvite tårn da han på 1600-tallet skrev eventyret om Tornerose."

	key[]: "it_cut_bari_desc"
	val[]: "Havnen i Bari ligger ved Italias adriaterhavskyst og har lenge fungert som en port mellom Europa og Balkan.<br><br>Mellom 847 og 871 e.Kr. var Bari hovedstad i sitt eget kortvarige islamske emirat – den eneste staten av sitt slag som ble etablert på det italienske fastlandet."

	key[]: "it_cut_etna_desc"
	val[]: "Etna, på østkysten av Sicilia, er Europas høyeste aktive vulkan og en av de mest aktive vulkanene på jorden.<br><br>Navnet føres vanligvis tilbake til det greske «Aitnē», fra ordet «aithō» som betyr \"jeg brenner\"."

	key[]: "it_cut_neapol_desc"
	val[]: "Napoli havn, som ble grunnlagt i den antikke greske bosetningen Neapolis, er en av Italias eldste og travleste havner.<br><br>Under utgravingen av en metrostasjon ved siden av dagens Napoli havn, avdekket arkeologer den antikke havnen til og med sju skipsvrak fra hellenistisk og romersk tid."

	key[]: "it_cut_sassari_desc"
	val[]: "Santa Maria di Betlem-kirken i Sassari på Sardinia er et fransiskansk kompleks med opprinnelse tilbake til 1100-tallet.<br><br>Hver august bærer Sassaris laug ruvende tre-\"lys\" som veier hundrevis av kilo til kirken under Candelieri-festivalen for å fornye et gammelt løfte knyttet til pesten."

	key[]: "it_cut_taranto_desc"
	val[]: "Taranto er en by i Sør-Italia beliggende ved Det joniske hav, ble grunnlagt rundt 706 f.Kr. av spartanske kolonister som den greske byen Taras.<br><br>I Tarantobukten, som er preget av industri, finnes en livskraftig delfinbestand – deriblant stripedelfiner med genetiske trekk som ikke finnes noe annet sted i Middelhavet."

	key[]: "it_cut_villa_san_giovanni_desc"
	val[]: "Villa San Giovanni er en by i Calabria på det italienske fastlandet, og fungerer som den viktigste fergeterminalen over Messinastredet til Sicilia.<br><br>Villa San Giovanni ble grunnlagt av silkeentreprenøren Rocco Antonio Caracciolo, som forente fem rivaliserende småsteder. Kong Ferdinand IV av Napoli ga den nye byen sitt navn i 1791."

	key[]: "balt_cut_castles_desc"
	val[]: "Hermannsborgen ble grunnlagt av danskene på 1200-tallet og senere gjenoppbygd av Den livlandske orden. Ivangorod-festningen ble grunnlagt av Ivan III i 1492 for å forsvare Moskvas vestgrense."

	key[]: "balt_cut_convent_desc"
	val[]: "Grunnlagt i 1447 nord for Pskov av den hellige Eufrosynos, vokste det frem til å bli et anerkjent utdanningssenter."

	key[]: "balt_cut_daugavpils_desc"
	val[]: "Latvias nest største by vokste frem fra borgen Dinaburg, som ble grunnlagt ved elven Daugava i 1275 av Den livlandske orden.<br><br>Byen har hatt minst fire ulike navn deriblant Dinaburg, Borisoglebsk og Dvinsk før den i 1920 fikk navnet Daugavpils."

	key[]: "balt_cut_klaipeda_desc"
	val[]: "Klaipėda, Litauens eneste store havneby, ble grunnlagt i 1250-årene av Den livlandske orden, en gren av Den tyske orden.<br><br>I omtrent 500 år var byen aldri underlagt en litauisk stat, den ble først en del av Litauen etter et opprør i 1923."

	key[]: "balt_cut_riga_power_plant_desc"
	val[]: "Demningen ble bygget ved Daugava-elven mellom 1966 og 1975, og skapte et reservoar ved å oversvømme halve øya Doles sala.<br><br>Toppen av demningen fungerer også som offentlig vei, og en jernbane fra byggeperioden som en gang krysset den, ble senere demontert."

	key[]: "balt_cut_valmiera_desc"
	val[]: "Vidzeme olympiske senter i Valmiera er en multifunksjonell hall på nesten 2900 kvadratmeter som brukes til basketball og innebandy.<br><br>Den Valmiera-fødte kappløperen Jānis Daliņš vant uavhengige Latvias første sommer-OL-medalje, et sølv på 50 kilometer i Los Angeles-lekene i 1932, og byens stadion bærer nå hans navn."

	key[]: "blke_cut_cerna_voda_desc"
	val[]: "Anghel Saligny-broen ved Cernavodă som sto ferdig i 1895, var med sine over fire kilometer en gang Europas lengste bro.<br><br>Da rumenske styrker trakk seg tilbake i 1916, påførte de skader på Donau-broen og ødela den delen som krysset Borcea-armen. Begge deler ble gjenoppbygd, og i 1987 ble de erstattet av en ny broforbindelse."

	key[]: "blke_cut_edirne_desc"
	val[]: "Edirne fungerte som hovedstad i Det osmanske riket i nesten et århundre før Konstantinopel ble erobret i 1453.<br><br>Festivalen Kırkpınar i Edirne der det konkurreres i oljebryting, har blitt arrangert siden 1300-tallet. Bryterne dekkes av nesten to tonn olivenolje, og arrangementet innehar Guinness-rekorden som verdens eldste sportskonkurranse."

	key[]: "blke_cut_orsova_desc"
	val[]: "Orșova er en by ved elven Donau sørvest i Romania, beliggende like ovenfor kløften Jernporten, nær stedet der elven Cerna møter Donau.<br><br>Utbyggingen av demningen Jernporten I førte til at vannstanden i Donau steg med omtrent 30 meter, noe som førte til at det gamle Orșova ble lagt under vann i 1970. Innbyggerne ble flyttet til en helt ny by, som ble oppført på et høyereliggende område mellom 1966 og 1971."

	key[]: "blke_cut_pernik_desc"
	val[]: "Pernik som er en kullgruveby i nærheten av Sofia, har siden 1953 huset et stort stålverk.<br><br>Verket fremstiller størstedelen av stålet sitt av gjenvunnet skrap, noe som gjør det til en av bedriftene i regionen som i størst grad baserer seg på sirkulærøkonomi."

	key[]: "blke_cut_poiana_viaduct_desc"
	val[]: "Poiana Teiului-viadukten er en 634 meter lang veibro som krysser halen av Bicaz-sjøen i Romanias Neamț-fylke."

	key[]: "blke_cut_r73_desc"
	val[]: "Piatra Craiului er en 25 kilometer lang kalksteinsrygg i de rumenske Karpatene som har vært vernet som nasjonalpark siden 1990.<br><br>Navnet betyr \"Kongens klippe\", og parken huser flere endemiske arter av virvelløse dyr."

	key[]: "ibe_cut_barcelona_desc"
	val[]: "Barcelona begynte som den romerske bosetningen Barcino, hvis eldgamle ruiner fremdeles ligger under den moderne byens gater.<br><br>Syv av Barcelonas ni steder på UNESCOs verdensarvliste er enkeltverk av arkitekten Antoni Gaudí, deriblant den ufullendte Sagrada Família."

	key[]: "ibe_cut_ejido_desc"
	val[]: "El Ejido, i Campo de Dalías i Almería, huser en av verdens største konsentrasjoner av drivhus for landbruk.<br><br>Drivhusene i Almería som er det såkalte \"plastikkhavet\" strekker seg over 370 kvadratkilometer og reflekterer så mye sollys at astronauter kan se dem fra verdensrommet."

	key[]: "ibe_cut_guadiana_desc"
	val[]: "Den internasjonale Guadiana-broen er en skråkabelbro som forbinder Ayamonte i Spania med Castro Marim i Portugal, ved grensens sørligste overgang.<br><br>Når man krysser broen, krysser man også en tidssonegrense slik at reisende fra Spania til Portugal kan derfor oppleve to separate nedtellinger til det nye året."

	key[]: "ibe_cut_lisboa_desc"
	val[]: "25. april-broen spenner over elven Tejo og forbinder Lisboa med Almada, og den er en av Europas lengste hengebroer."

	key[]: "ibe_cut_olhao_desc"
	val[]: "Olhão er en hvitkalket fiskerby på Portugals Algarve-kyst, som vender direkte ut mot lagunen Ria Formosa.<br><br>Ifølge sagnet seilte sytten fiskere fra Olhão i 1808 i en åpen båt helt til Brasil, bare for å fortelle Portugals landflyktige konge at landet hans var fritt."

	key[]: "ibe_cut_reservoir_desc"
	val[]: "Barrios de Luna-reservoaret i León-provinsen ble opprettet i 1956 da en demning blokkerte Luna-elven i en smal fjellkløft.<br><br>Fyllingen av reservoaret senket seksten landsbyer og bosetninger under vann som nå strekker seg omtrent 40 kilometer gjennom dalen."

	key[]: "ibe_cut_santander_desc"
	val[]: "Havnen i Santander ligger i gangavstand fra sentrum.<br><br>Santanders skjermede havn ble grunnlagt av romerne etter de kantabriske krigene i år 19 f.Kr. Den begynte som et knutepunkt for eksport av mineraler og vokste i takt med byen den var med på å skape."

	key[]: "ibe_cut_zaragoza_desc"
	val[]: "Et av de største shopping- og fritidskompleksene i Europa, som dekker over 200 000 kvadratmeter.<br><br>Komplekset er bygget rundt en kunstig innsjø, og kombinerer et kjøpesenter med restauranter, kinoer, sportsfasiliteter og rekreasjonsområder."

	key[]: "sc_cut_mabodalen_desc"
	val[]: "Måbødalen er en bratt, breformet dal nær Eidfjord i Vestland, der fossen Vøringsfossen ligger.<br><br>Med et spektakulært fritt fall på 145 meter ned i dypet av Måbødalen, er Vøringsfossen Norges mest ikoniske foss et sted som tiltrekker seg besøkende som ønsker å oppleve dens dundrende krefter."

	key[]: "sc_cut_stockholm_desc"
	val[]: "Stockholms kystlinje åpner seg mot en skjærgård med rundt 30 000 øyer, holmer og skjær som strekker seg ut i Østersjøen.<br><br>Stockholms umalte T-banevogner av typen \"Silverpilen\" som ble satt i drift i 1965, ga opphav til en vandrehistorie om et spøkelsestog som dukker opp ved midnatt og får alle passasjerer som går om bord, til å forsvinne."

	key[]: "sc_cut_kalmar_desc"
	val[]: "Kalmar er en historisk havneby i det sørøstlige Sverige, som er omtalt første gang på 1000-tallet og huser et renessanseslott.<br><br>Kalmar slott har gjennom historien stått imot 22 beleiringer, uten noen gang å ha blitt inntatt med storm."

	key[]: "sc_cut_copenhagen_desc"
	val[]: "København er Danmarks hovedstad, bygget rundt en historisk havn omkranset av kanaler, spir og gågater.<br><br>Københavns Tivoli er hjemsted for Europas eldste berg-og-dal-bane i drift, Rutschebanen, som har begeistret syklistene siden 1914."

	key[]: "blkw_cut_durdevica_desc"
	val[]: "Nasjonalparken Durmitor i Montenegro som er et verdensarvsted på UNESCOs liste, kjent for sine forrevne fjell, bresjøer og elvekløften ved elven Tara huser denne betongbroen med fem buer. Broen sto ferdig i 1940 og rager mer enn 150 meter over elven.<br><br>I dag er dette et av de mest populære stedene for ziplining på Balkan."

	key[]: "blkw_cut_durres_desc"
	val[]: "Durrës som ble grunnlagt som den greske kolonien Epidamnus i 627 f.Kr., er Albanias eldste og travleste havneby.<br><br>Romerne gjorde byen til det vestlige endepunktet for Via Egnatia, deres store vei som strakte seg helt til Thessaloniki."

	key[]: "blkw_cut_pristina_desc"
	val[]: "Pristina, hovedstaden i Kosovo, ligger i nærheten av ruinene av det antikke Ulpiana og har vært bebodd siden yngre steinalder.<br><br>På 1200-tallet var Pristina et viktig kongelig og kommersielt sentrum i den serbiske middelalderstaten, før osmansk styre gradvis vant innpass etter 1389."

	key[]: "blkw_cut_split_desc"
	val[]: "Havnefronten i Split domineres av Diokletians palass og klokketårnet til St. Domnius-katedralen. Hele gamlebyen vokste frem innenfor palassets murer.<br><br>Den romerske keiseren Diokletian trakk seg tilbake til Split og begynte å dyrke kål, og med et slikt alvor avslo han oppfordringer om å vende tilbake til tronen med begrunnelsen at grønnsakene hans var viktigere."

	key[]: "blkw_cut_bihac_desc"
	val[]: "I det historiske sentrum av Bihać finner man det bevarte klokketårnet til St. Antonius-kirken, Kapteinstårnet og mausoleet Turbe, som er bygget i stein. Kapteinstårnet fungerte senere som et østerriksk-ungarsk fengsel. Kirken ble i stor grad ødelagt under allierte bombeangrep i 1944.<br><br>Alle tre står bare noen få meter fra hverandre, og gjenspeiler Bihaćs kristne, osmanske og østerriksk-ungarske fortid."

	key[]: "blkw_cut_sarajevo_desc"
	val[]: "Dette er den eldste og historisk sett viktigste delen av Sarajevo. I hjertet av området ligger Baščaršija som er Sarajevos basarkvartal fra den osmanske tiden, grunnlagt i 1462 av guvernør Isa-beg Isaković.<br><br>Sarajevos rådhus, kjent som Vijećnica, er en markant bygning fra den østerriksk-ungarske tiden, tegnet i nymaurisk stil av den tsjekkiske arkitekten Karel Pařík."

	key[]: "blkw_cut_ljubljana_desc"
	val[]: "Ljubljana, Slovenias hovedstad, vokste frem langs elven Ljubljanica, på stedet der den tidligere romerske bosetningen Emona lå.<br><br>Ifølge sagnet drepte Jason og argonautene en drage på nøyaktig det stedet der Ljubljana ligger i dag, og uhyret troner fremdeles i byens våpenskjold."

	key[]: "blkw_cut_tirana_desc"
	val[]: "Tirana ble grunnlagt i 1614 av den osmanske adelsmannen Sulejman Bargjini. Byen ble Albanias midlertidige hovedstad i 1920, og dens permanente hovedstad i 1925.<br><br>Kthesa e Kamzës, en av Tiranas viktigste transportinnfallsporter i vest, knytter hovedstaden sammen med Kamëz og ruter som går mot nord og vest."

	key[]: "blkw_cut_prokuplje_desc"
	val[]: "Prokuplje, administrasjonssenteret i distriktet Toplica i den sørlige delen av Serbia, har sine røtter i den romerske bosetningen Hammeum.<br><br>Byen har gitt navn til Prokupac, en drue for rødvin som har blitt dyrket lokalt helt siden middelalderen."

	key[]: "gr_cut_piraeus_desc"
	val[]: "Pireus er hovedhavnen i Athen og en av de største passasjerhavnene i Middelhavet.<br><br>Silo-bygningen ble opprinnelig oppført for lagring av korn. I dag bygges den om til Museum for undervannsantikviteter som skal stille ut arkeologiske funn hentet opp fra greske farvann."

	key[]: "gr_cut_kavala_desc"
	val[]: "Kavala er en historisk havneby i den nordlige delen av Hellas, grunnlagt sent på 600-tallet f.Kr. under navnet Neapolis.<br><br>Høyden har vært befestet siden minst 400-tallet f.Kr. Den nåværende festningen i Kavala er hovedsakelig osmansk som ble gjenoppbygd i 1425 på toppen av tidligere bysantinske forsvarsverk."

	key[]: "gr_cut_kalabaka_desc"
	val[]: "Meteora er et klosterområde på UNESCOs verdensarvliste, der klostre ligger plassert på toppen av sandsteinsformasjoner nær Kalabaka.<br><br>I århundrer ble besøkende heist opp langs 400 meter høye fjellsider i et svingende tau-nett, en anordning som ifølge munkene selv bare ble byttet ut når den røk."

	key[]: "gr_cut_beach_desc"
	val[]: "Faliraki er et feriested på Rhodos nordøstkyst, omtrent 14 kilometer sør for Rhodos by, kjent for sin lange sandstrand.<br><br>Faliraki er et av de mest populære feriestedene på Rhodos for vannsport som er alt fra vannscooterkjøring til paraseiling høyt over bukten."

	key[]: "gr_cut_lixouri_desc"
	val[]: "Lixouri er Kefalonias nest største by, anlagt på Paliki-halvøya i nærheten av stedet der den antikke byen Pale lå."

	key[]: "gr_cut_corinth_desc"
	val[]: "Korintkanalen skjærer gjennom Korinteidet og forbinder Egeerhavet med Korintbukta via en 6,4 kilometer lang kanal.<br><br>Den romerske keiseren Nero satte personlig i gang arbeidet med kanalen i år 67 e.Kr. nesten 1800 år før den endelig sto ferdig i 1893."

	key[]: "gr_cut_souda_desc"
	val[]: "Souda-bukten nær Chania på Kreta er en av de største og dypeste naturlige havnene i Middelhavet.<br><br>Ved innløpet til bukten befestet venetianerne den lille øya Souda på 1500-tallet; festningen der holdt stand mot osmanske styrker og forble venetiansk helt frem til 1715 flere tiår etter at resten av Kreta falt i 1669."

	key[]: "gr_cut_polyfytos_desc"
	val[]: "Polyfytos-broen spenner over den kunstige innsjøen Polyfytos i elven Aliakmon som er Hellas lengste elv i nærheten av Kozani.<br><br>Broen som ble ferdigstilt i 1975 og er 1372 meter lang, ble tegnet av den anerkjente italienske ingeniøren Riccardo Morandi."

	key[]: "poc_cut_alesund_desc"
	val[]: "Ålesund er en viktig norsk cruisehavn.<br><br>Den tyske keiser Wilhelm II som tidligere hadde besøkt byen, sendte marinefartøyer med byggematerialer for å hjelpe til med gjenoppbyggingen etter at en ødeleggende brann la nesten hele trehusbyen i aske i 1904."

	key[]: "poc_cut_bodo_desc"
	val[]: "Bodø er en kystby like nord for polarsirkelen som ble utnevnt til europeisk kulturhovedstad i 2024."

	key[]: "poc_cut_nordkapp_desc"
	val[]: "Nordkapp er et 307 meter høyt klippeplatå på øya Magerøya, som ofte markedsføres som det europeiske fastlandets nordligste punkt.<br><br>Nordkapp er egentlig ikke Europas nordligste punkt – det nærliggende neset Knivskjellodden strekker seg omtrent 1450 meter lenger nord."

	key[]: "poc_cut_santa_desc"
	val[]: "Julenissebyen ligger nøyaktig på polarsirkelen, omtrent åtte kilometer nord for Rovaniemi, og holder åpent året rundt.<br><br>Besøkende kan stå på en malt linje som markerer polarsirkelen, og få et offisielt diplom som bevis på at de har krysset den."

	key[]: "poc_cut_muotkatakka_desc"
	val[]: "Muotkatakka, omtrent 12 kilometer sør for Kilpisjärvi, er med sine 565,8 meter det høyeste punktet i hele det finske offentlige veinettet.<br><br>Veien over dette passet forbinder Finland med Norge, og det er vanlig å se rein vandre like ved veikanten nær toppen."

	key[]: "poc_cut_farm_desc"
	val[]: "Tohmajärvi er en liten kommune med skogkledde åser og innsjøer i Nord-Karelen, nær Finlands østgrense mot Russland.<br><br>Kommunevåpenet viser en ambolt og en flamme, som minner om den tidligere så viktige jernindustrien i regionen."

	key[]: "poc_cut_viitasaari_desc"
	val[]: "Viitasaari er en by med mange innsjøer i det sentrale Finland, og kommunen inneholder rundt 230 innsjøer.<br><br>Viitasaari sin sommermusikkfestival starter hvert år med en parade av traktorer som ruller gjennom byen før konsertene."

	key[]: "poc_cut_lalby_desc"
	val[]: "Lålby er en liten grend i Kristinestad, i regionen Österbotten på Finlands vestkyst."

	key[]: "poc_cut_kiruna_desc"
	val[]: "Kiruna er Sveriges nordligste by, bygget rundt Kirunavaara som er verdens største underjordiske jernmalmgruve.<br><br>Jernmalmforekomsten trengte opp fra to kilometers dyp for omtrent 1,6 milliarder år siden, og i dag står gruven for rundt 80 prosent av EUs jernmalm."

	key[]: "poc_cut_gavle_desc"
	val[]: "Gävle er en havneby på Sveriges østkyst, ved elven Gavleåns utløp i Gästrikland.<br><br>Hver advent siden 1966 har byen satt opp en gigantisk julebukk av halm, som brannstiftere har brent ned over 30 ganger."

	key[]: "poc_cut_lulea_desc"
	val[]: "Luleå, hovedstaden i Norrbottens län, ligger ved Bottenviken og omfatter en skjærgård med over 1300 øyer.<br><br>Et stort teknologiselskap bygde et gigantisk datasenter i Luleå, nettopp fordi den nådeløse arktiske kulden fungerer som gratis, naturlig aircondition for serverne deres."

	key[]: "poc_cut_heia_desc"
	val[]: "Naturskjønn rasteplass langs E6 i Balsfjord i Troms, med utsikt mot fjell og en beliggenhet på omtrent 240 meters høyde."

	key[]: "poc_cut_svolvaer_desc"
	val[]: "Svolvær, på øya Austvågøya, er den største byen og den uoffisielle hovedstaden i øygruppen Lofoten i Norge."

	key[]: "poc_cut_bjornfjell_desc"
	val[]: "Bjørnfjell er en fjellstasjon på Ofotbanen, som ligger rett ved grensen mellom Norge og Sverige, i nærheten av Narvik.<br><br>Ettersom den ligger så høyt til fjells, er Bjørnfjell stasjon ofte dekket av snø store deler av året, og jernbanestrekningen her regnes som en av de vakreste togreisene i Nord-Europa."

	key[]: "poc_cut_trondheim_desc"
	val[]: "Trondheim, grunnlagt rundt 997 som Kaupangr og senere kjent som Nidaros, fungerte som Norges hovedstad i vikingtiden.<br><br>Nidarosdomen, som er bygget over graven til Olav den hellige, er verdens nordligste gotiske katedral fra middelalderen."

	key[]: "is_cut_thingvellir_desc"
	val[]: "Nasjonalparken Þingvellir ligger i en riftdal mellom de nordamerikanske og eurasiske tektoniske platene. I 2004 ble området oppført på UNESCOs verdensarvliste.<br><br>Islands nasjonalforsamling, Alltinget (Alþingi), møttes her for første gang under åpen himmel i år 930, noe som gjør den til en av verdens eldste nasjonalforsamlinger."

	key[]: "is_cut_barthastran_desc"
	val[]: "Barðastrandarvegur (vei 62) følger kysten av Barðaströnd sør på Vestfjordene, langs nordsiden av den brede fjorden Breiðafjörður.<br><br>Vikingen Hrafna-Flóki Vilgerðarson tilbrakte en vinter på denne kysten, og etter å ha sett en fjord full av drivis fra et nærliggende fjell, ga han hele landet navnet Island."

	key[]: "is_cut_lagoon_desc"
	val[]: "Dette geotermiske lagunespaet ligger i et lavafelt på Reykjanes-halvøya, der badende kan slappe av i melkeblått vann med en gjennomsnittstemperatur på 37–39 °C.<br><br>Lagunen er menneskeskapt; spaet ble etablert for å utnytte varmt overskuddsvann fra det nærliggende geotermiske kraftverket, som åpnet i 1976."

	key[]: "is_cut_selfoss_desc"
	val[]: "Selfoss er den største byen på den sørlige delen av Island. Den ble anlagt ved bredden av elven Ölfusá som fikk sin første hengebro i 1891.<br><br>Siden 2011 har Selfoss vært et av stedene der konkurransen Islands sterkeste mann arrangerer en begivenhet der kraftkarer løfter store steiner og trekker tunge lastebiler."

	key[]: "is_cut_seljaland_desc"
	val[]: "Seljalandsfoss er en 60 meter høy foss på Sør-Island, som får vann fra en elv som har sitt utspring ved isbrevulkanen Eyjafjallajökull.<br><br>En sti fører rett bak vannmassene og inn i en liten grotte, slik at besøkende kan se fossen fra innsiden."

	key[]: "is_cut_geyser_desc"
	val[]: "Strokkur som ligger i det geotermiske området Haukadalur, er Islands mest aktive geysir og har utbrudd med noen minutters mellomrom.<br><br>Dens nabo, den store Geysir, har gitt navn til alle geysirer i verden; navnet stammer fra det islandske verbet «geysa», som betyr «å fare raskt frem»."

	key[]: "is_cut_gullfoss_desc"
	val[]: "Gullfoss, også kjent som \"det gylne fossefallet\", ligger i elven Hvítá. Vannet stuper ned i en 32 meter dyp kløft i to trinn, på henholdsvis 11 og 21 meter.<br><br>Da utenlandske investorer ønsket å utnytte fossen til kraftproduksjon, kjempet Sigríður Tómasdóttir – datter av en lokal bonde – for å verne den. Ovenfor fossen står det et minnesmerke i stein til ære for henne."

	key[]: "is_cut_joekul_desc"
	val[]: "Jökulsárlón er en bresjø ved enden av Breiðamerkurjökull, en utløperbre fra den enorme isbreen Vatnajökull.<br><br>Sjøen begynte først å dannes i 1930-årene i takt med at isbreen trakk seg tilbake, og med et dyp på over 280 meter er den i dag Islands dypeste innsjø."

	key[]: "is_cut_gothafoss_desc"
	val[]: "Goðafoss er en 12 meter høy og 30 meter bred foss i elven Skjálfandafljót på den nordlige delen av Island.<br><br>Navnet oversettes vanligvis som \"gudenes foss\", men det kan stamme fra to steiner ved fossen som ligner på hedenske avgudsbilder."

	key[]: "is_cut_canyon_desc"
	val[]: "Stuðlagil er en kløft i dalen Jökuldalur på den østlige delen av Island som er preget av høye, sekskantede basaltsøyler langs elven Jökla.<br><br>Kløften lå skjult under vann frem til Kárahnjúkar-demningen som sto ferdig i 2009, førte til at vannstanden i elven sank og den ble først kjent etter at en fotograf delte bilder derfra i 2016."
#@}

