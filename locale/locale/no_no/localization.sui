	key[]: "acc_axis_dz"
	val[]: "Dødsone for akselerasjonsakse"

	key[]: "acc_axis_mode"
	val[]: "Modus for akselerasjonsakse"

	key[]: "brake_axis"
	val[]: "Bremseakse"

	key[]: "brake_axis_dz"
	val[]: "Dødsone for bremseakse"

	key[]: "brake_axis_mode"
	val[]: "Modus for bremseakse"

	key[]: "clutch_axis"
	val[]: "Kløtsjakse"

	key[]: "clutch_axis_dz"
	val[]: "Dødsone for kløtsjakse"

