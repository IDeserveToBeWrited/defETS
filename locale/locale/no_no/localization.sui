#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "OPPSETT AV KONTROLLAKSER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualisering av akser"

	key[]: "wiz_setup_axes_desc"
	val[]: "Du kan teste alle aksenes funksjoner visuelt. Bruk kontrolleren og følg søylenes bevegelse. Det vil fortelle deg de begrensingene, sentrering, retning og generell virkemåte for hver brukte akse."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Akseoppsett"

	key[]: "wiz_setup_axes_desc2"
	val[]: "For å velge en akse, klikk på knappen ved siden av aksenavnet. Dette vil bytte deg til inndatamodus. Deretter bruker du kontrolleren til å binde den valgte aksen ved å flytte spaken, hjulet eller pedalen til din valgte aksen."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Dødssoner"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Dødsonen refererer til et akseområde med hensikt utformet for å ikke gi noe input. For å justere dødsonen til en valgt akse, flytt den tilsvarende glidebryteren. Økning av glidebryteren til høyre vil forstørre dødsonen. Denne funksjonen er spesielt gunstig for eldre kontrollere, ettersom å definere en større dødsone kan redusere problemer som unøyaktighet eller falske inndata forårsaket av maskinvareslitasje."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Aksemoduser"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Aksemodus avgjør hvordan aksen oppfører seg i spillet. Snudd akse snur om på aksens retning kan resultere til å snu rattet til venstre istedenfor høyre for eksempel. En sentrert akse har nullpunktet sitt på midten, som et styrespak. Denne modusen er hjelpsom for å rette opp en akse som har blitt oppdaget feil på."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Snudd" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Sentrert" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Snudd og sentrert" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATISK GIRKASSEOPPSETT" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Med en automatisk girkasse trenger du bare å gi mellom Kjør, Nøytral og Revers. Dette gjør du med følgende taster eller kontrollerknapper. For å endre innstillingene, trykk på en knapp og trykk på tasten eller kontrollerknappen du ønsker å bruke for handlingen."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Hvis du har H-Skifter-maskinvare koblet til, kan du bruke den til simulering av den ekte automatiske girskifteren. Aktivere denne innstillingen, og du kan tildele H-Skifterposisjoner til framover- og reversmoduser. Eventuelle andre H-Skifterposisjoner regnes som nøytral. Denne innstillingen er laget spesielt for H-Skifter-kontrolleren, så den vil ikke fungere verken med vanlige taster eller kontrollerknapper. For å endre tildelingen, trykk på en knapp og flytt så girbryteren til ønsket posisjon og deretter tilbake til nøytral posisjon."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEKVENSIELL GIRKASSEOPPSETT" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvensielle girkassen skifter mellom alle framovergir, Nøytral og Revers. Her er tastene og kontrollerknappene som brukes til å skifte opp og ned i nevnte rekkefølge. For å endre tildelingen, trykk på en knapp og trykk på tasten, eller kontrollerknappen du ønsker å bruke for handlingen."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-SKIFTER GIRKASSEOPPSETT" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Her kan du stille inn oppsettet på H-skifter og teste funksjonene. På illustrasjonen til høyre ser du spakens gjeldende posisjon, og hvilket gir det tilsvarer. Ettersom girkassen i lastebiler har flere gir enn spaken kan håndtere alene, må du bruke knapper til å veksle mellom de ulike girsettene."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Nåværende valgte girskifterposisjon og aktive brytere er også indikert nedenfor, ved siden av tilhørende kontroll. For å endre en tildelt kontroll, trykk på den aktuelle knappen og flytt så girbryteren til ønsket posisjon og deretter tilbake til Nøytral."
#@}

