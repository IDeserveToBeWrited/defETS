	val[]: "Gjeldende eksterne oppdraget krever følgende DLC-er:<br><br>" #+ messages shown when resuming online job that requires some unmounted DLCs, it is followed by new line separated names of DLCs

	key[]: "error_unknown_trailer"
	val[]: "Kan ikke forhåndsvise oppdragsdetaljer. Du kan se detaljer når du gjenopptar ditt nåværende oppdrag." #+ Message is shown if an error occured during server synchronization.

	key[]: "error_no_own_trailer_attached"
	val[]: "Oppdraget krever en eid henger. Imidlertid har du for øyeblikket ingen slike hengere tildelt." #+ Message shown when player tries to continue external market job however they have no compatible trailer attached.

	key[]: "error_no_compatible_trailer_owned"
	val[]: "Du eier ikke noen henger som er kompatibel med dette oppdraget." #+ Message shown if player does not own any trailer that would be compatible with the job but there is at least one available in trailer dealer.

	key[]: "required_trailer_external_header"
	val[]: "Nødvendige hengerparametere:" #+ Header of the section describing what trailer is needed to finish the job.

	key[]: "error_no_compatible_trailer_available"
	val[]: "Det er ingen kompatibel henger tilgjengelig i spillet; det er mulig at dette har skjedd på grunn av fjerning av en modifikasjon eller DLC. Installer innholdspakken på nytt, eller forlat oppdraget." #+ Message shown if player does not own any trailer that would be compatible with the job and there is no compatible trailer available in game, probably due to removal od MOD or DLC.

	key[]: "error_incompatible_trailer_in_use"
	val[]: "Den tilkoblede hengeren er ikke kompatibel med oppdraget." #+ Message shown if player tries to resume external market job however currently attached trailer is not compatible with the job.

	key[]: "error_you_own_compatible_trailers"
