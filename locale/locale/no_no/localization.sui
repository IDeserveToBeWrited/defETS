#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Fortsett ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Velkommen til Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Endelig har du muligheten til å prøve drømmejobben - å kjøre lastebil!"

	key[]: "intro_3"
	val[]: "Du har nå startet ditt eget transportselskap, men dessverre mangler du penger til å kjøpe din egen lastebil. Enn så lenge må du jobbe for andre selskaper."

	key[]: "intro_4"
	val[]: "Din oppgave er å levere en henger med $JOB_CARGO$ trygt til $JOB_TARGET_COMPANY$ i $JOB_TARGET_CITY$. Din arbeidsgiver har stilt en kjøretøy til disposisjon, og vil dekke alle utgifter. Ikke skuff noen og lever i tide."


	key[]: "intro_garage_1"
	val[]: "Dette er ditt hovedkvarter."

	key[]: "intro_garage_2"
	val[]: "Det er en ganske enkel garasje. Det er kanskje ikke så mye, men det er en start."

	key[]: "intro_garage_3"
	val[]: "Du har dessverre ingenting å parkere der enda, så det er ingen lastebiler i sikte."

	key[]: "intro_garage_4"
	val[]: "Så snart du har tjent nok penger og kjøpt din egen lastebil, så kan du kjøre fritt rundt på kartet og drive ditt eget selskap herfra."

	key[]: "intro_garage_5"
	val[]: "Lykke til!"


	key[]: "desktop_tut_t"
	val[]: "FUNKSJON LÅST OPP"

	key[]: "desktop_tut_job"
	val[]: "Velg ditt neste oppdrag"

	key[]: "desktop_tut_cargo_market"
	val[]: "Bruk din splitter nye henger for å få tilgang til Lastemarkedet for å levere et bredt utvalg av last til deres destinasjoner." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Her kan du se fremdriften."

	key[]: "desktop_tut_company"
	val[]: "Hold orden på garasjene dine, ansett nye sjåfører og ellers administrere ditt selskap fra her."

	key[]: "desktop_tut_trailers"
	val[]: "Fra nå av kan du kjøpe egne hengere og oppgradere eller lakkere dem for å matche din lastebil.<br><br>Dine hengere kan lagres i din valgte garasje(r); de kan brukes av dine sjåfører for å øke fortjenesten. For å administrere hengere bruker du Hengeroversikt."

	key[]: "desktop_tut_visit_directive"
	val[]: "Besøk $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "VELKOMMEN"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Velkommen til den nye startskjermen<br>Herfra kan du bruke all funksjonalitet i spillet."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Nedenfor gir hovedmenyen direkte tilgang til alle kjernespillfunksjonene du er kjent med."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "På toppen gir den nye statuslinjen konstant synlighet til nyttig spillerprofilstatistikk og lokale reiseregler."

	key[]: "desktop_tut_tour_home"
	val[]: "Hjem-knappen er alltid der for å returnere deg til startskjermen."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "En permanent hurtigmeny gir praktisk snarveitilgang til alle spillfunksjoner fra hvilken som helst skjerm."

	key[]: "desktop_tut_tour_drive"
	val[]: "Den oppdaterte Drive-knappen forblir din forbindelse til kjøreverdenen, klar til å sette deg tilbake på veien."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "VEILEDNING FULLFØRT"

	key[]: "desktop_tut_tour_finish"
	val[]: "Takk for at du gjennomgikk vår oppdatering av startskjermen."
#@}


	key[]: "show_help"
	val[]: "Skru på / av hjelpetips"

	key[]: "weblinks_t"
	val[]: "FELLESKAP"

	key[]: "weblinks_but"
	val[]: "Felleskap"

	key[]: "weblink_game"
	val[]: "Nettsiden til Euro Truck Simulator 2"

	key[]: "weblink_scs"
	val[]: "Hjemmesiden til SCS Software"

	key[]: "weblink_blog"
	val[]: "Bloggen til SCS Software"

	key[]: "weblink_facebook"
	val[]: "Euro Truck Simulator 2 på Facebook"

	key[]: "weblink_wotr"
	val[]: "Nettsiden til World of Trucks"

	key[]: "weblink_forum"
	val[]: "SCS Software fora"

	key[]: "weblink_instagram"
	val[]: "SCS Software på Instagram"

	key[]: "weblink_twitter"
	val[]: "SCS Software på X"

	key[]: "weblink_tiktok"
