#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Det har oppstått en feil ved innlesing av innhold fra Steam.<br><br>$ERROR$<br><br>Velg fortsett for å beholde innholdet aktivert. Spillet vil søke etter innholdet med jevne mellomrom.<br><br>Du kan midlertidig deaktivere innholdet for å fjerne feilmeldinger som denne. Spillet vil reaktivere innholdet automatisk neste gang du kjører det." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Kunne ikke laste ned Steam-innhold." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM-INNHOLD" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Laster inn Steam-innhold..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NYTT INNHOLD" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Det er blitt registrert nytt Steam-innhold." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Kjøretøystilbehør" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Førerhustilbehør" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Skrivebordsbakgrunn" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Lakk" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Deaktiver innhold" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Prøv igjen senere" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
