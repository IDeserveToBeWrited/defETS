	val[]: "Valg av hodesporingsmoduser:<br>- I \"Direkte\"-modus tilsvarer hoderotasjonen din direkte en kamerarotasjon i spillet. Det anbefales i vanlige cockpit-/førerhussituasjoner.<br>- I \"Dynamisk\"-modus vil blikket ditt bare påvirke kameraet ditt i spillet når du faktisk snur hodet. Det anbefales når det er viktig for synet ditt å være absolutt sentrert."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Hvis den er aktivert, vil kameraet i spillet kontinuerlig sakte resentreres når du endrer hodets naturlige posisjon under spilling."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Hvis den er aktivert, ditt hodets posisjon påvirker kameraposisjonen i spillet."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Hvis den er aktivert, vil kameraet i spillet vippe tilsvarende når du vipper hodet til hver side."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multipliserer den kombinerte hode- og blikkrotasjonen i horisontal retning (i kabinen)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multipliserer den kombinerte hode- og blikkrotasjonen i vertikal retning (i kabinen)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multipliserer den kombinerte hode- og blikkrotasjonen i horisontal retning (i gåmodus)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multipliserer den kombinerte hode- og blikkrotasjonen i vertikal retning (i gåmodus)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Justerer hvor raskt kameraet i spillet vil reagere på dine blikkbevegelser."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Justerer hvor gradvis hastigheten ramper opp."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Justerer avstanden fra midten av skjermen der akselerasjonen vil begynne å jevne seg ut."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Justerer hvor langt fra midten av skjermen du må se før kameraet i spillet begynner å bevege seg."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Justerer hvor langt fra midten av skjermen du må se for å oppnå maksimal kamerahastighet."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Bestemmer hvor langt kameraet kan vri seg når du ser til kantene av skjermen."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Justerer hvor raskt kameraet i spillet vil reagere på dine hodebevegelser."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Justerer hvor mye kameraet i spillet vil svinge til venstre eller høyre sammenlignet med hvor mye du snur hodet (i førerhuset)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Justerer hvor mye kameraet i spillet vil svinge opp eller ned sammenlignet med hvor mye du snur hodet (i førerhuset)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Justerer hvor mye kameraet i spillet vil svinge til venstre eller høyre sammenlignet med hvor mye du snur hodet (i gåmodus)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Justerer hvor mye kameraet i spillet vil svinge opp eller ned sammenlignet med hvor mye du snur hodet (i gåmodus)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Justerer hvor gradvis hastigheten ramper opp."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Justerer hvor mye du må rotere hodet før akselerasjonen begynner å jevne seg ut."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Justerer hvor mye du må rotere hodet fra midtstillingen før kameraet i spillet begynner å bevege seg."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Justerer hvor mye du må rotere hodet fra midtstillingen for å oppnå maksimal kamerarotasjon."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Valg av autopause-moduser."

