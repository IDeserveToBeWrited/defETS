#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Utvalg av temaer som vises i bakgrunnen når du blar gjennom menyen."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverer tilfeldig valg av bakgrunnstemaet hver gang du starter spillet."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Setter på en forsinkelse som hvilke elementer på skrivebordet forsvinner ut etter."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil du oppleve effekten av tretthet over tid.<br><br>Unngå hvile vil resultere i trafikkforseelser."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, må du følge trafikkreglene eller risikere å få trafikkforseelser. Risikoen er økt nær politibiler, radar og trafikkkameraer."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Justerer gjennomsnittlig lengde på oppdrag som tilbys."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Velg hvilken fartsgrense som skal vises på navigasjonswidget."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Gjeldende fart på navigasjonen endres til rødt når fartsgrensen overskrides."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Når du kommer til din destinasjon, vil en widget bli vist som lar deg å hoppe over parkering."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Beholder widgetene skjult."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Beholder begge HUD-speilene skjult."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Beholder alle varsler skjult til og med når de mottas."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Viser et vindu som viser egenskapene til spillerens nåværende lastebil før det skal godta et oppdrag med tung last."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Velg hvordan verdenskartet er justert."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Velg hvordan verdenskartet utforskes:<br>- «Nærhetsutforskning» markerer et større område som utforsket.<br>- «Presisjonsutforskning» avslører bare områdene rett rundt spilleren."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Velg hvordan navigasjonen skal bli vist."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer hvordan navigasjonen rutes.<br>- \"Best\" navigasjonsmodus velger det mest effektive forholdet mellom lengde og tid på ruten, prøver å unngå veikryss med trafikklys osv.<br>- \"Kortest\" navigasjonsmodus velger alltid kortest mulig rute.<br>- \"Små veier\" navigasjonsmodus velger å unngå motorveier der det er mulig."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer vanskelighetsgraden til parkering.<br>- \"Velg alltid\" lar deg velge når du når destinasjonen.<br>- «Sikker parkering» krever ikke ryggemanøvrer.<br>- «Avansert parkering» vil vanligvis kreve en mer utfordrende ryggemanøvre."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Justerer sannsynligheten for å støte på veifarer i nærheten, inkludert ulykker, funksjonshemmede kjøretøy, veiavfall osv."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Justerer sannsynligheten for å møte en rute som endrer omkjøring mens det kjøres på et oppdrag."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Justerer sannsynligheten for dårlig vær."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Velg om tidssoneinformasjon skal vises i tillegg til gjeldende tid."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverer filmsekvenser i spillet som vanligvis vises etter kjøp av kjøretøy eller garasjeoppgraderinger eller under passasjerlasting."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Velg om halvgjennomskinnelige blokkeringer skal vises på veier som ikke er tilgjengelige."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverterer musens Y-akse når du kontrollerer kameraet i spillet."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Velger girkassetype:<br>-\"Enkel automatgir\" lar bruk av gasspedalen og bremsen for å kontrollere framover- og reversbevegelser.<br>- \"Ekte automatgir\" krever en inndata for å bytte mellom framover og i revers.<br>- \"Sekvensiell\" krever manuell veksling av alle gir med gir opp / ned-inndata.<br>- \"H-Skifter\" krever bruk av en kontroller med girporter for å velge gir manuelt."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktivering av denne funksjonen vil tillate \"hopp over giring\" - hopper over gir når det er nødvendig eller praktisk for å unngå å bytte i hvert gir i girkassen."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Bringer rattet tilbake til midten når et tastatur eller en kontroller brukes.<br><br>Deaktivering av denne funksjonen betyr at du må styre tilbake til midten manuelt etter en sving."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Justerer rekkevidden til rattanimasjonen. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer intensiteten til bremsene."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer stabiliteten til kjøretøyet ved å senke tyngdepunktet."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer stabiliteten til hengeren ved å senke tyngdepunktet."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer intensiteten til dreiemomentet som genereres fra drivlinjen.<br><br>Økning av denne innstillingen vil øke følelsen av at kjøretøyet \"vrir seg\" mot høyre."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer stivheten til karosseriopphenget."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer stivheten til førerhus/sleeperfjæringen."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Justerer intensiteten til prosedyregenererte overflatehumper for å gi veier og andre terreng en ufullkommen følelse.<br><br>Avhengig av andre fjærings- og kamerainnstillinger kan den oppfattede effekten være mer eller mindre fremtredende."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer avansert kobling som krever større presisjon for å justere lastebilens femte hjul med hengerens kongenål.<br><br>Når den er deaktivert, blir det mye lettere å koble til en henger siden det ikke er noen kollisjon mellom kongenål og den femte hjulet."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Velger om, og hvilken hengerkabler som er animerte.<br><br><color value=@@clr_txt_d@@>Aktivering av kabler på flere kjøretøy kan påvirke ytelsen på eldre systemer."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverer lastebilens elektroniske hastighetsbegrensning på 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>World of Trucks-oppdrag har denne funksjonen permanent skrudd på."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert og vindusviskerne er satt til første posisjon, vil viskerne automatisk slå seg på og justere hastigheten i henhold til forholdene."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer automatisk innkobling av retarder ved bremsing."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, hjelper kjøretøyet med start i en helling ved å holde bremsene nede, noe som sikrer en myk start."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer automatisk innkobling av motorbremsen ved bremsing."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, vil motoren starte så snart gassen trykkes inn."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, aktiveres kjøretøyets parkeringsbrems som standard (etter bruk av ferge, tauing til serviceverksted, hurtigreising osv.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Utløser automatisk løfteaksler når det er nødvendig avhengig av kjøretøyets vekt."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, vil kjøretøyet holde lav gass som standard. Etter at du har trykket raskt på gassknappen to ganger, vil kjøretøyet holde full gass til gassknappen slippes.<br><br>Påvirker kun tastaturinndata."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulerer virkelighetens lufttap fra overdreven bremsing.<br><br>Når den er aktivert, må du styre lufttrykket når det skal kjøres ned bakker eller gjør sakte manøvrer med flere bremseanvendelser."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er deaktivert, påvirkes ikke drivstofforbruket av kjørestil eller veiforhold.<br><br>Når den er aktivert, påvirkes drivstofforbruket av flere faktorer inkludert kjørestil, lastevekt, rullemotstand og terrengprofiler. Den påvirkes ikke lenger av @@skill_mechanical_title@@-ferdigheten."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, vil ABS forhindre hjullåsing for å opprettholde kontrollen og forbedre bremseevnen."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, vil kjøretøyet bremse per hjul for å forhindre hjulspinn, understyring eller overstyring for å opprettholde kontrollen."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, vil kjøretøyet låse differensialen hvis hjulene begynner å skli for å forbedre trekkraften."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer hastigheten som cruisekontrollen øker eller reduserer med når den aktuelle knappen trykkes."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer cruisekontrolltoleransen for å opprettholde målhastigheten."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, cruisekontrollen vil automatisk justere hastigheten for å opprettholde en sikker følgeavstand til kjøretøyet foran."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer nødbremsing hvis systemet registrerer en forestående kollisjon.<br>Velg om systemet bare skal reagere på kjøretøy eller alle hindringer."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Valg av kjørefeltassistentsmoduser.<br>- \"Kjørefeltskiftevarsel\" varsler deg hørbart når du er i ferd med å forlate kjørefeltet.<br>- I tillegg til hørbar advarsel, styrer \"Kjørefeltstøtte\" også automatisk ditt kjøretøy for å forhindre at den forlater kjørefeltet.<br><br>Begge modusene er kun aktive ved hastigheter over 55 km/t (~35 mph).<br>Kjørefeltassistenten vurderer også din bruk av blinklysene før den kobles inn."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer blindsonesensorfunksjonene hvis ditt kjøretøy er utstyrt med det."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert og frontlysene er satt til første posisjon, vil frontlysene automatisk slå seg på i situasjoner med lite lys."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert og frontlyktene er skrudd på med fjernlysene aktivert, vil kjøretøyet automatisk dimme fjernlyset når det oppdager et møtende kjøretøy eller et kjøretøy like foran."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil blinklysene automatisk avbrytes etter en sving når rattet dreies tilbake til midten."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, reagerer noen interiørtilbehør på den fysiske bevegelsen til kjøretøyet (hengende dekorasjoner, boblehoder osv.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer giring på interiørkameraet basert på styringsinndata."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer hvor reaktivt funksjonen \"styrekamerarotasjon\" er på styringsinndata."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer oppførselen til funksjonen \"styrekamerarotasjon\" ved rygging."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, interiørkameraet ser til venstre eller høyre basert på blinklysbruk."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktivert, reagerer interiørkameraet på kjøretøyets bevegelser."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer hvor reaktivt interiørkameraet er til kjøretøyets bevegelser."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Endrer hvor mye interiørkameraet er tillatt til å rulle basert på kjøretøyets bevegelse."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Setter inn forsinkelsen før kameraet automatisk resentreres.<br><br>Kjøretøyet må bevege seg i en ikke ubetydelig hastighet for at dette skal aktiveres. Gjelder kun for interiør- og jagekamera mens du kjører framover og til lene ut-kameraet mens du kjører i revers."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Stiller inn hastigheten for kamerabevegelse. Brukes ved automatisk kamerasentrering og veksling mellom forhåndsinnstillinger for interiørkamera."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Bestemmer hvordan zoom for interiør fungerer: hold inne knappen for å zoome midlertidig, eller trykk én gang for å slå den av og på." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Velger språket som skal vises gjennom hele spillet."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Endrer forhåndsinnstillinger for gjeldende og enheter basert på den valgte regionen."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil byer og land bli vist på det valgte språket."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil byer og land vises på både det valgte språket og morsmålet for den regionen på kartet."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken valuta du vil bruke."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Velg mellom 12-timers eller 24-timers klokke."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken avstandsenheter som skal vises."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken masseenheter som skal vises."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken temperaturenheter som skal vises."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken trykkenheter som skal vises."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken volumenheter som skal vises."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Velg hvilken forbruksenheter som skal vises."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil bruken av \"Aktivere\"-tasten (@@imv_nrm_activate@@) åpne chatten under konvoisesjoner."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil chatinndatalinjen forbli aktiv etter at en melding er blitt sendt."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil chattemeldinger forsvinne ut flere sekunder etter hver melding."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Endrer hvor lenge chattemeldinger skal vises før de forsvinner ut."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Når den er aktivert, vil spillernavn bli vist over kjøretøyene deres i konvoisesjoner."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Åpner en avansert meny for å konfigurere hurtigsvar for chatting i konvoisesjoner."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Sjekk statusen til World of Trucks-tilkoblede innhold."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Aktiverer nedlasting av nettnyheter for visning på tittelsiden."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Aktiverer nedlasting av fellesskapsskjermbilder valgt fra World of Trucks-nettsiden som er vist som lasteskjermer."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Aktiverer nedlasting av ekte annonser for visning på utvalgte reklametavler i spillet."
#@}

