#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS TILKOBLET INNHOLD" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Koble til" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Bla gjennom" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "GENERELLE INNSTILLINGER" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "KOBLER TIL INNHOLD" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Koble til" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks har oppdaget nytt spillinnhold. Koble til World of Trucks-tjenesten for å få tilgang til det nye innholdet." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Nett" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Nettinnstillinger. Justere alle World of Trucks relaterte innstillinger." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Er du sikker på at du vil utsette registreringen?<br><br>Du kan få tilgang til Online Connect Content-dialogen senere via Nettinnstillinger som du kan finne på skrivebordet." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "KOBLER INNHOLD" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Kobler til innhold.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Kunne ikke kjøre tilkoblingsoperasjonen for:$CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam-kontoen du brukte for å registrere denne DLC-en, skiller seg fra den som ble brukt til å opprette din World of Trucks-konto eller for å registrere spillet. Vennligst bytt din Steam-konto og prøv igjen." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Denne Steam-kontoen som du bruker til å registrere denne DLC-en er allerede tilknyttet en annen World of Trucks-konto. For å registrere denne DLC til den nåværende konto, så skal du bruke en Steam-konto som er ikke tilknyttet til en World of Trucks-konto." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam-gyldighet er utløpt. Vennligst prøv igjen senere." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Produktnøkkelen som du bruker for å aktivere denne DLC er ikke gyldig. Vennligst kontakt støtte for hjelp: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Det har oppstått en intern feil under registrering av spillet. Vennligst prøv igjen senere." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUKSESS" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "NETT" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "INNHOLDSOVERSIKT" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Gratulerer! Valgte DLC-er ble nå koblet til din World of Trucks-konto." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Kan ikke koble til innholdet fordi den nåværende Steam-kontoen er tilknyttet en annen World of Trucks-konto." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Noen DLC-er klarte ikke å koble til.<br>Hold musen over utropstegn for hver DLC for å se flere detaljer." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrerer $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Den nåværende profil er ikke tilkoblet til World of Trucks eller spillet kjører i frakoblet modus. Redigere profilen for å koble til." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Trykk for å avvise"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$<color value=@@clr_txt@@>/ $TOTAL_CONTENT$ kompatible DLC-er er for øyeblikket tilkoblet. Hvis noen av DLC-er ikke er tilkoblet til World of Trucks, så kan du gå glipp av noen av disse funksjonene." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Gratulerer! <color value=@@clr_txt@@>Alt ditt innhold er tilkoblet til World of Trucks! Du kan nå bruke alle funksjoner." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Ikke mulig å koble nytt innhold til World of Trucks, da Steam-kontoen som er i bruk ikke stemmer overens med Steam-kontoen brukt til World of Trucks-profilen." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Tilkoblet" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Ikke tilkoblet" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Kan ikke hente informasjon om innhold du eier." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Kan ikke hente opplysninger om tilkoblet innhold." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Kan ikke hente opplysninger om den nåværende brukte kontoen." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Senere" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Kan ikke registrere denne DLC-en. Ingen permanent lisens er funnet, trolig på grunn av Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Ingen permanent eierskap" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Spesialtransportoppdrag fullført!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "OPPDRAG MISLYKKES!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Avbryt"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Last inn sjekkpunkt"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Du har skadet følgebilen!<br>Du kan laste inn et tidligere sjekkpunkt, eller avbryte leveransen med et straffegebyr på $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Følgebilen har blitt krasjet på grunn av en annen bilist i trafikken.<br>Du kan laste inn et sjekkpunkt eller avbryte leveransen med et straffegebyr på $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Du var pålagt til å følge den forhåndsgodkjente ruten.<br>Du kan fortsette ved tidligere sjekkpunkt, eller avbryte leveransen med et straffegebyr på $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Du var pålagt å være ifølge med følgebilene.<br>Du kan laste inn et tidligere sjekkpunkt, eller avbryte leveransen med et straffegebyr på $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
