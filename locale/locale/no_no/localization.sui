	val[]: "Tildeler en knapp for akselerasjon."

	key[]: "o_im_back_reverse_op_tooltip"
	val[]: "Tildeler en knapp for bremsing.<br><br>Hvis \"Enkel automatisk\" girtype er valgt, vil den samme knappen også brukes for rygging."

	key[]: "o_im_left_op_tooltip"
	val[]: "Tildeler en knapp for å styre venstre."

	key[]: "o_im_right_op_tooltip"
	val[]: "Tildeler en knapp for å styre høyre."

	key[]: "o_im_gear_up_op_tooltip"
	val[]: "Tildeler en knapp for å gire opp."

	key[]: "o_im_gear_down_op_tooltip"
	val[]: "Tildeler en knapp for å gire ned."

	key[]: "o_im_gear_neutral_op_tooltip"
	val[]: "Tildeler en knapp for å gire til Nøytral."

	key[]: "o_im_gear_drive_op_tooltip"
	val[]: "Tildeler en knapp for å gire til Kjør."

	key[]: "o_im_gear_reverse_op_tooltip"
	val[]: "Tildeler en knapp for å gire til Revers."

	key[]: "o_im_gear_up_hint_op_tooltip"
	val[]: "Tildeler en knapp som antyder at automatgirkasssen skal gire opp før det gjør det på egen hånd."

	key[]: "o_im_gear_down_hint_op_tooltip"
	val[]: "Tildeler en knapp som antyder at automatgirkassen skal gire ned før det gjør det på egen hånd."

	key[]: "o_im_trans_semi_switch_op_tooltip"
	val[]: "Tildeler en knapp for å skifte mellom \"Ekte automatisk\" og \"Sekvensiell\" girkassetype."

	key[]: "o_im_auto_transmission_mode_op_tooltip"
	val[]: "Tildeler en knapp for å endre modusene for den adaptive automatgirkassen."

	key[]: "o_im_engine_op_tooltip"
	val[]: "Tildeler en knapp for å starte eller stoppe motoren."

	key[]: "o_im_engine_electricity_op_tooltip"
	val[]: "Tildeler en knapp for å skru på/av strømmen.<br><br>Hvis den er tilordnet, må du skru på strømmen før du starter motoren. Motoren må da stoppes ved å skru av strømmen, i stedet for å bruke standard Start/Stopp motor-knappen."

	key[]: "o_im_parkingbrake_op_tooltip"
	val[]: "Tildeler en knapp for parkingsbremsen."

	key[]: "o_im_motorbrake_op_tooltip"
	val[]: "Tildeler en knapp for motorbremsen.<br><br>Motorbremsen vil være aktiv så lenge du holder knappen inne."

	key[]: "o_im_engine_brake_tgl_op_tooltip"
	val[]: "Tildeler en knapp for å skru på / av motorbremsen.<br><br>Etter å ha trykket på knappen vil motorbremsen være aktiv frem til du trykker på knappen igjen."

	key[]: "o_im_engine_brake_up_op_tooltip"
	val[]: "Tildeler en knapp for å øke motorbremsen."

	key[]: "o_im_engine_brake_down_op_tooltip"
	val[]: "Tildeler en knapp for å senke motorbremsen."

	key[]: "o_im_auto_engine_brake_op_tooltip"
	val[]: "Tildeler en knapp for å skru på / av den automatiske motorbremsen."

	key[]: "o_im_trailer_brake_op_tooltip"
	val[]: "Tildeler en knapp for hengerbremsen."

	key[]: "o_im_retarder_up_op_tooltip"
	val[]: "Tildeler en knapp for å øke retarderen."

	key[]: "o_im_retarder_down_op_tooltip"
	val[]: "Tildeler en knapp for å senke retarderen."

	key[]: "o_im_auto_retarder_op_tooltip"
	val[]: "Tildeler en knapp for å skru på / av den automatiske retarderen."

	key[]: "o_im_lift_axle_op_tooltip"
	val[]: "Tildeler en knapp for å løfte / slippe akselen hvis ditt kjøretøy har løftbar aksel."

	key[]: "o_im_lift_axle_trailer_op_tooltip"
	val[]: "Tildeler en knapp for å løfte / slippe akselen hvis din henger har løftbar aksel."

	key[]: "o_im_slide_axle_manual_op_tooltip"
	val[]: "Tildeler en knapp for å veksle mellom manuell aksel/tandemjusteringsmodus, hvis din hengeren har glidende aksel/tandem. Manuell justeringsmodus bremser hengerhjulene og kobler akselen/tandemet fra karosseriet, slik at aksel/tandemposisjonen kan justeres ved å flytte lastebilen.<br><br>Når den ikke er tildelt, flyttes akslene automatisk for å passe den aktuelle situasjonen."

	key[]: "o_im_diff_lock_op_tooltip"
