#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Bank" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Hvis du trenger penger, kan du alltid søke om lån i banken." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "LÅNETILBUD" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "for $MONEY$ per dag" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Antall aktive lån: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Du kan låne: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "OVERSIKT OVER AKTIVE LÅN"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Lån" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Gjenstående lån" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Varighet (i dager)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Rente (p.a.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Avdrag" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Tilbakebetal" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Totalt:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Saldo: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NYTT LÅN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Du ber om et lån på $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Nedbetalingsperiode:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Rente (p.a.):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Daglige avdrag:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Vil du bekrefte lånesøknaden din?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "NEDBETAL LÅN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Vil du virkelig bruke $MONEY$ på å tilbakebetale lånet?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


	key[]: "bank_msg_payment"
