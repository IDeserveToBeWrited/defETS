#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Nettverkslag utilgjengelig. Kontroller at klientinnstillingene er korrekte."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Kan ikke etablere en tilkobling til nettjenesten. Vennligst kontroller at internettilkoblingen fungerer som den skal."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Feil under kommunikasjon med nettjenesten. Vennligst prøv igjen senere."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Feil data mottatt fra nettjenesten. Dersom HTTP-proxy er i bruk, sjekk innstillingene. Hvis ikke, vennligst prøv igjen senere."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Feil data mottatt fra internettjenesten. Vennligst prøv igjen senere."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Tjenesten er ikke kompatibel med den nåværende versjonen av spillet. Vennligst sjekk om en oppdatert versjon er tilgjengelig."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Tjenesten er for tiden ikke tilgjengelig. Vennligst prøv igjen senere."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Tjenesten er dessverre nede for vedlikehold eller er overbelastet. Vennligst prøv igjen senere."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Innloggingsinformasjonen er ugyldig. Vennligst prøv å logge inn igjen."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Nettkontoen er for øyeblikket stengt pga. for mange mislykkede innloggingsforsøk. Vennligst prøv igjen om en halvtime."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Nettkontoen er for øyeblikket låst ned pga. mistenksomme tilkoblinger. Vennligst prøv igjen om 24 timer."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Dette spillet er ikke registrert på denne nettkontoen."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Kontoen har ikke blitt aktivert ennå. Vennligst sjekk din innboks for kontoaktiveringse-post."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Denne kontoen er suspendert. Vennligst kontakt teknisk støtte."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Denne kontoen er utestengt. Vennligst kontakt teknisk støtte."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy-godkjenning er ikke støttet av spillet. Vennligst bruk en annen proxy eller direkte tilkobling."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Det du ber om er ikke tilgjengelig akkurat nå. Vennligst prøv igjen litt senere."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL-feil. Kan ikke opprette en sikker forbindelse."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Spillet ble suspendert under nettkommunikasjonen. Vennligst prøv igjen senere."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Intern feil. Det kan være mer informasjon i net.log-filen."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 har et problem og kan ikke vise noe bilde på skjermen din (ingen grafikkort funnet).\nForeslåtte løsninger:\n\n1. Sjekk om at datamaskinen og skjermkortet ditt møter minimumskravene til Euro Truck Simulator 2.\n2. Last ned og oppdater til den nyeste versjonen av Microsoft DirectX.\n3. Last ned og installer den nyeste driver til grafikkortet ditt fra produsentens hjemmeside - driveren til grafikkortet er mest sannsynlig for gammel.\n4. Prøv å endre renderingsmetode fra OpenGL til DirectX eller motsatt.\n5. Slett filen 'config.cfg' i mappen 'Mine Dokumenter' - 'Euro Truck Simulator 2'. Den kan være korrupt.\nDenne filen vil automatisk bli opprettet igjen med riktige standardverdier neste gang du starter spillet."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 har et problem, og er ikke i stand å tegne grafikk på datamaskinen din (ingen gyldig grafikkenhet ble funnet)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "INNDATAVEIVISER" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Neste"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Avslutt veiviser"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Hopp over veiviser"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Inndataveiviser"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Er du sikker på at du vil avbryte inndataveiviseren?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "VELG KONTROLLMETODE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Kontrollere"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Veiviseren vil bruke anbefalte innstillinger basert på de tilkoblede enhetene.<br><color value=@@clr_sel@@>Hvis du bruker en Steam-kompatibel kontroller, bør du vurdere å aktivere konfigurasjonsstøtte i <br><color value=@@clr_txt_d@@> \"Steam > Innstillinger > Kontroller > Generelle kontrollinnstillinger\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Styr bilen med tastaturet og se rundt deg med musen. Den enkleste, men minst presise kontrollmetoden, tilgjengelig for alle."

	key[]: "wiz_control_mouse"
	val[]: "Bruk musen for mer sensitiv styring. Andre handlinger blir fremdeles styrt med tastatur. Du kan fremdeles bruke musen til å se rundt deg ved å holde inne en knapp som tillater dette."

	key[]: "wiz_control_controller"
	val[]: "Bruk et styreratt og pedaler, en spillkontroller eller et styrespak for en mest mulig realistisk spillopplevelse. Du vil fremdeles kunne bruke tastaturet til mange funksjoner, og du kan se rundt deg med musen (kikk med musen)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Ingen spillkontroller ble funnet. Du må koble til en for å velge dette!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Søker etter tilgjengelige kontrollere ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "VELG KONTROLLERAPI" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam-inngang - Kartleggingsmodus i spillet (anbefalt)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam-inngang - Kartleggingsmodus for Steam-klienten"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klassisk kontroller"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Kontrollere som @@controller_ps5@@, @@controller_xbox_one@@ eller @@controller_steam_deck@@ har valgt Steam-inngangsgrensesnittet og bruker enkel oppsett.<br><br>Støtter full nøkkelbindingskonfigurasjoner i spillet."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Kontrollere har valgt Steam-inngangsgrensesnittet og bruker frittstående oppsett konfigurert gjennom Steam-klienten.<br><br>Begrenset støtte for tips om knapper i spillet og ingen bindingskonfigurasjoner i spillet."

	key[]: "wiz_api_classical"
	val[]: "Kontroller, drivhjul eller styrespak som bruker DirectInput, XInput eller lignende grensesnitt."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "VELG KONTROLLERTYPE"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Styreratt"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Kontroller eller styrespak"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Kontrolleren er et styreratt, eller kan brukes på samme måte som et ratt. Kontrollerens posisjon gjenspeiler rattets posisjon i spillet direkte."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Kontrolleren er en spillkontroller eller et styrespak. Kontrollerens stilling bestemmer hvor fort styrerattet snur i spillet."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "VELG GIRKASSETYPE" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Trykk FORWARD for å kjøre framover, og trykk TILBAKE for å bremse eller rygge. Girkassen håndterer automatisk alt annet, håndterer overganger mellom kjøring, bremsing og rygging, til og med å velge riktig gir."

	key[]: "wiz_gb_automatic"
	val[]: "Bruk knappene til å veksle mellom å kjøre framover, nøytral eller å rygge. Trykk deretter på gasspedalen og la automatgiret håndtere girskiftene."

	key[]: "wiz_gb_sequential"
	val[]: "Manuelt skift gir opp og ned for å velge hvert enkelt gir i girkassen. Denne konfigurasjonen gir full kontroll over kjøretøyets girkasse."

	key[]: "wiz_gb_hshifter"
	val[]: "Velg ønsket gir direkte. Dette gir den mest realistiske konfigurasjonen. En fysisk H-mønstergirspak er anbefalt og krever kløtsjinngang."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Denne funksjonen krever et styreratt, en spillkontroller eller et styrespak."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Kan ikke finne H-Skifter HW-kontroller. Denne funksjonen kan være ubrukelig."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "VELG H-SKIFTEROPPSETT"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Rekkevidde-girkassen er den enkleste valget. Første sett går fra 1. til 6. gir, andre sett går fra 7. til 12. gir. Du bruker en knapp til å veksle mellom første og andre sett, og girspaken til å velge gir innen settet."

	key[]: "wiz_hs_splitter"
	val[]: "Splitt-girkassen er et enkelt alternativ. Den har også to sett med gir. Det første settet inneholder tannhjul med oddetall (1, 3, 5 ...) og det andre settet inneholder tannhjul med partall (2, 4, 6 ...). En vippeknapp bytter mellom disse to settene mens giret velger et spesifikt gir fra settet."

	key[]: "wiz_hs_range_splitter"
	val[]: "Rekkevidde-splitt-girkassen er basert på oppsettet til de ekte manuelle range-splitterne. Girene er gruppert med fire for hver H-Skifterposisjon og bruker to veksler. Derfor anbefales dette kun for erfarne sjåfører."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
