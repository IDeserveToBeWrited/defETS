#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIKK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafikk" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Justere grafikkinnstillingene ved å bruke finjusterte forhåndsinnstillinger for å skreddersy spillets visuelle ytelse til din smak."

	key[]: "apply"
	val[]: "Bruk" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Skrivebordstema" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "SKJERM" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "BILDEKVALITET" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEKSTURER" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKSJONER" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SKYGGER" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "LYSNING" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-PROSESSERING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "MILJØ" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Fullskjermsmodus" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Lysstyrke / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Oppsett" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Skjermoppløsning" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Oppdateringshastighet" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS-begrensning" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS-begrensning i bakgrunnen" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Standard" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikal synkronisering" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Økonomisk (Sparer strøm på bærbar PC)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ENKLE GRAFIKKINNSTILLINGER" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "OPPRINNELIGE INNSTILLINGER AKTIVERT" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "AVANSERTE GRAFIKKINNSTILLINGER" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Enkle/avanserte grafiske innstillinger" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Skjul avanserte innstillinger" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Vis avanserte innstillinger" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skalering" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Kantutjevnelse" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma-skarphet" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA tuning" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptiv klarhet" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Alltid mykt" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Alltid skarp" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Omgivende okklusjon i skjermområdet (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Utvidet dynamisk område (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Dybdeskarphet (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Solstråler" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Fargekorrigering" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Refleksjonskalering" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Refleksjonsdetaljer" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Vegetasjonsdetaljer" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Gresstetthet" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Skyggekvalitet"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Skyggestørrelse" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Fjerne skygger" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Interiørskygger" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Væreffekter"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Speilkvalitet" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Speiloppløsning" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Speilrekkevidde" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Teksturkvalitet" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anisotropisk filtrering" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normalkartlegging" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Refleksjon AI-lys" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Refleksjon for parkeringslys / markeringslys" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Lysrekkevidde" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Fotgjengere" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Skjerminstillinger har blitt endret.<br>Vil du beholde disse endringene?"

	key[]: "reverting_in"
	val[]: "Tilbakestiller om" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekunder" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Når den er aktivert, vil spillet bli vist i fullskjerm."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Justere den generelle lysstyrken i spillet slik at den passer til skjermen din. På HDR-kompatible skjermer vil HDR-kalibreringsalternativet også være tilgjengelig i denne innstillingen."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Endrer oppløsningen til spillet."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Endrer målets oppdateringsfrekvens for spillet."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Tilpasser bildefrekvensen til skjermens oppdateringsfrekvens for å forhindre skjermriving. Økonomisk innstilling halverer også bildefrekvensen, noe som resulterer i lavere strømforbruk."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Angir maksimal tillatt bildefrekvens for spillet.<br><br>Hvis du setter verdien til 0 vil deaktivere denne funksjonen."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Angir maksimal tillatt bildefrekvens for spillet når den er minimert i bakgrunnen.<br><br>Hvis du setter verdien til 0 vil deaktivere denne funksjonen."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Skifter mellom enkle grafiske innstillinger (forhåndsinnstillinger) eller avanserte grafiske innstillinger (mulighet for å endre individuelle parametere)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Forbedrer grafisk nøyaktighet ved å gjengi spillet med høyere oppløsning internt, noe som reduserer taggete kanter og forbedrer detaljene.<br>Hvis du for eksempel velger et høyere skaleringsalternativ, får du et klarere bilde med mindre uskarphet, noe som gjør at spillet ser bedre ut totalt sett på bekostning av ytelsen.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har ofte stor innvirkning på ytelsen."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Utvalg av høyhastighets antialiasing-metoder som jevner ut utseendet til taggete kanter i spillet:<br>- SMAA sampler hver piksel flere ganger (avhengig av den valgte kvaliteten) på forskjellige steder innenfor rammen og tar et gjennomsnitt av prøvene for å produsere det endelige bildet.<br>- TAA prøver hver piksel bare én gang per bilde, men den prøver dem på forskjellige steder og forskjellige rammer.<br>- For det beste resultatet kan du også velge en kombinasjon av begge på bekostning av ytelsen.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Legger til myke skygger i sprekker og objekter som er i nærheten av hverandre, noe som forbedrer den oppfattede grafiske gjengivelsen i hele spillverdenen.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Valg av TAA-forhåndsinnstillinger:<br>- «Alltid mykt» vil resultere i mindre flimmer/mer uskarphet – det passer for PC-brukere som aktiverer supersampling eller har en høy DPI-skjerm, men også 1080p TV-brukere som sitter lenger unna skjermen.<br>- \"Alltid skarp\" resulterer i mer flimmer/mindre uskarphet - det er sannsynligvis det beste alternativet for bruk under 1080p, for eksempel bærbare PC-er eller Steam Deck.<br>- \"Adaptiv klarhet\" dynamisk deaktiverer TAA-jitter når kameraet er statisk.<br><br><color value=@@clr_txt_d@@>Denne innstillingen kan bare brukes når TAA er valgt som en antialiasing-løsning."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer styrken på TAAs luma-skarphet.<br><br><color value=@@clr_txt_d@@>Denne innstillingen kan bare brukes når TAA er valgt som en antialiasing-løsning."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Når den er aktivert, kan det fjerne områder på kartet være kunstig uskarpe for å skape et realistisk fokusfall i bakgrunnen."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Når den er aktivert, kan lysstråler være synlige når det skal se på solen, eller ser på solen gjennom gjenstander som trær, bygninger eller kjøretøy."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Når den er aktivert, blir fargene i spillet dynamisk justert av estetiske årsaker. Scener vil bedre samsvare med tiden på dagen og værforholdene, farger på kjøretøy og andre objekter kan være mer levende osv."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Forbedrer refleksjoner ved å gjengi dem med høyere kvalitet internt, til og med bruke bedre antialiasing.<br><br><color value=@@clr_txt_d@@>Endringer i denne innstillingen trer først i kraft etter en manuell omstart av spillet."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer detaljene i refleksjoner som sees på kjøretøyoverflater, vinduer og andre reflekterende overflater som sølepytter, våte veier og åpne vannmasser.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen.<br><br>Endringer i denne innstillingen trer først i kraft etter en manuell omstart av spillet."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer detaljene og kompleksiteten til planter og trær.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer tettheten av gress som sees langs sidene av veien.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer kvaliteten på skygger kastet av solen eller månen.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer skygger for å bli gjengitt til og med fra objekter som er veldig langt unna.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer dynamiske skygger om natten i kjøretøyets interiør.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer kvaliteten på væreffekter, som refleksjoner."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer kvaliteten på refleksjoner som sees i kjøretøyets speil (uavhengig av refleksjonsinnstillinger).<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer oppløsningen til bildet som vises på kjøretøyspeilene."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer avstanden der objekter begynner å gjengis i speilet.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har ofte stor innvirkning på ytelsen."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer kvaliteten på noen teksturer som brukes på objekter og overflater i spillet."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Forbedrer skarpheten i teksturer, spesielt de som sees på avstand eller i skrå vinkel.<br><br><color value=@@clr_txt_d@@>Endringer i denne innstillingen trer først i kraft etter en manuell omstart av spillet."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Legger til geometriske detaljer på fortau, veier og andre objekter for å forbedre utseendet deres.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen.<br><br>Endringer i denne innstillingen trer først i kraft etter en manuell omstart av spillet."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer belysning fra frontlykter på andre kjøretøy i trafikken."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer belysning fra sekundærlys på andre kjøretøy i trafikken som blinklys, bremser osv."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer avstanden kunstige lyskilder kan sees fra.<br><br><color value=@@clr_txt_d@@>Denne innstillingen har vanligvis en moderat innvirkning på ytelsen."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer fotgjengere i spillverdenen."
