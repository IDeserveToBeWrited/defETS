	val[]: "Du leverer for øyeblikket til et selskap som er inaktivt i denne sesjonen.<br>Hvis du ønsker å koble til, lever ditt oppdrag først, ellers blir den suspendert og utilgjengelig mens du er i denne sesjonen.<br><br>Er du sikker på at du vil fortsette?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Du leverer for øyeblikket til et selskap som er inaktivt i denne sesjonen.<br>Hvis du ønsker å koble til, lever ditt oppdrag først, ellers blir den kansellert.<br><br>Er du sikker på at du vil fortsette?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Et selskap i nærheten av din lastebil eller henger må aktiveres for at du skal kunne delta i denne sesjonen.<br>For å unngå problemer, vennligst flytt din lastebil og henger lenger bort fra selskapet, ellers vil din nåværende oppdrag bli suspendert og utilgjengelig i denne sesjonen og du vil bli sendt til den nærmeste serviceverkstedet.<br><br>Er du sikker på at du vil fortsette?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Et selskap i nærheten av din lastebil eller henger må aktiveres for at du skal kunne delta i denne sesjonen.<br>For å unngå problemer, vennligst flytt din lastebil og henger lenger bort fra selskapet, ellers vil din nåværende oppdrag bli kansellert og du vil bli sendt til den nærmeste serviceverkstedet.<br><br>Er du sikker på at du vil fortsette?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Et selskap i nærheten hvor du satte av din lastebil eller henger før å ha akseptert din hurtigoppdrag må aktiveres for at du skal kunne delta i denne sesjonen.<br>For å unngå problemer når du returnerer til din lastebil, din nåværende hurtigoppdrag må bli kansellert og du vil bli sendt til den nærmeste serviceverkstedet.<br><br>Er du sikker på at du vil fortsette?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Din valgte oppdrag leverer fra eller til et selskap som er inaktivt i denne sesjonen og vil ikke være tilgjengelig når du kobler til.<br><br>Er du sikker at du vil fortsette?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Din last er plassert i et selskap som er inaktivt i denne sesjonen.<br>Hvis du ønsker å koble til, levere ditt last først, ellers blir din nåværende oppdrag suspendert og utilgjengelig i denne sesjonen.<br><br>Er du sikker på at du vil fortsette?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Din oppdrag var kansellert mens det leverer til et selskap som er inaktivt i denne sesjonen."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Ditt oppdrag ble kansellert fordi romlige oppdrag ikke støttes i konvoi."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Din valgte oppdrag er ikke lenger tilgjengelig siden det var fra et selskap som er inaktivt i denne sesjonen."

	key[]: "mp_warning_load_teleport"
	val[]: "Din lastebil ble sendt til den nærmeste serviceverkstedet siden den lagrede plasseringen var for nærme til et selskap som var aktivert til å matche denne sesjonen."

	key[]: "mp_warning_load_cancel_teleport"
	val[]: "Ditt oppdrag ble kansellert siden den leverte til et selskap som er inaktivt i denne sesjonen.<br>I tillegg ble din lastebil sendt til den nærmeste verkstedet fordi den lagrede plasseringen var for nær et selskap som ble aktivert til å matche denne sesjonen."

	key[]: "mp_warning_load_unavailable_teleport"
	val[]: "Ditt valgte oppdrag er ikke lenger tilgjengelig siden det var fra et selskap som er inaktivt i denne sesjonen.<br>I tillegg ble din lastebil sendt til den nærmeste serviceverkstedet fordi den lagrede plasseringen var for nær et selskap som ble aktivert til å matche denne sesjonen."

