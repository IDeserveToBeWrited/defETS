#+ DLC manager
#+
#+ Messages for situations occurring due to management of DLCs.
#@{
	key[]: "dlc_acquire_timeout" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Det tar lengre tid enn forventet å skaffe DLC-er. Det vil nå fortsette i bakgrunnen."

	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Det tar lengre tid enn forventet å skaffe DLC-er. Vil du fortsette å vente?<br><br>Hvis du fortsetter, vil det fortsette i bakgrunnen."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Tilgang til noen DLC-er er skaffet. Vil du gå til tittelskjermen nå for å få tilgang til det nye innholdet?<br><br>Din fremdrift vil bli lagret automatisk."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "Tilgang til noen DLC-er er mistet. Du går nå til tittelskjermen for å gjenspeile endringene i innholdet.<br><br> Din fremdrift vil bli lagret automatisk."
#@}

