#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Bildefilen er for stort. Vennligst prøv å redusere skjermoppløsningen." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Bildefilen er korrupt eller ikke støttet." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Oppløsningen på dette bildet er for stort. Vennligst prøv å redusere skjermoppløsningen." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Programmet avviste dette bildet." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Denne kontoen har ikke tillatelse til å laste opp bilder." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "En annen bruker lastet opp et bilde på denne filplasseringen." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Opplasting er deaktivert for øyeblikket. Vennligst prøv igjen senere." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Ukjent feil under opplasting. Vennligst prøv igjen senere." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Bildefilen er større enn maks tillatt størrelse på $LIMIT$. Størrelsen er blitt endret." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Bildefilen er større enn maks tillatt størrelse på $LIMIT$KB. Størrelsen er blitt endret." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

