	key[]: "wiz_auto_cfg_done"
	val[]: "Spillet er nå konfigurert med standardoppsettet beskrevet nedenfor. Du kan justere den ved å bruke de avanserte innstillingene, eller du kan fortsette direkte inn i spillet."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Avanserte innstillinger"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Spillet er nå konfigurert, og du kan fortsette. Du kan endre konfigurasjonen senere i Innstillinger."

	key[]: "wiz_cfg_steam"
	val[]: "Du kan sjekke og konfigurere knapp- og aksekartlegging for denne kontrolleren ved hjelp av Steam-klienten. Steam-spillkontrollinnstillinger for dette spillet er tilgjengelig i Steam > Bibliotek > Euro Truck Simulator 2 > Kontrollerkonfigurasjon."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Åpne kontrollerinnstillinger"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Bruk @@imm_wiz_dsteerleft@@ og @@imm_wiz_dsteerright@@ for å styre."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Beveg musen til venstre eller høyre for å snu rattet i den valgte retningen."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Bruk @@ima_wiz_j_steer@@ for å styre."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Bruk @@imm_wiz_dforward@@ for å kjøre framover og @@imm_wiz_dbackward@@ for å rygge."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Beveg @@ima_wiz_j_throttle@@ framover for å kjøre framover, og bakover for å rygge."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Bruk @@ima_wiz_j_throttle@@ for å kjøre framover og @@ima_wiz_j_brake@@ for å rygge."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Bruk @@imm_wiz_dforward@@ for å akselerere og @@imm_wiz_dbackward@@ for å bremse."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Beveg @@ima_wiz_j_throttle@@ framover for å akselerere, og bakover for å bremse."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Bruk @@ima_wiz_j_throttle@@ for å akselerere og @@ima_wiz_j_brake@@ for å bremse."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Bruk @@imv_wiz_gearup@@ for å gire framover og @@imv_wiz_geardown@@ for å gire i revers."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Bruk @@imv_wiz_gearup@@ for å gire framover og @@imv_wiz_geardown@@ for å gire i revers om du bruker tastatur eller spillkontroller. Bruk @@imv_wiz_drive@@ og @@imv_wiz_reverse@@ for å velge kjøreretningen hvis du bruker H-Skifter."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Bruk @@imv_wiz_gearup@@ og @@imv_wiz_geardown@@ til å skifte gir."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Bruk din H-Skifter i kombinasjon med @@ima_wiz_j_clutch@@ for å velge ønsket gir."
