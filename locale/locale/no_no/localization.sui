#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Den påkrevde DLC-en (offisiell utvidelsespakke) $DEPENDENCY_NAME$ mangler. For at det lagrede spillet skal fungere, må denne DLC-en være installert og aktivert på denne datamaskinen. Du må fikse problemet før du kan laste dette lagrede spillet." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "DLC (offisiell utvidelsespakke) $DEPENDENCY_NAME$ mangler. Om du ikke forventet dette, vennligst sjekk statusen på DLC-en.<br><br>Du kan laste inn det lagrede spillet likevel, men du kan miste noen av funksjonene gitt av den manglende DLC-en." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modifikasjonen $DEPENDENCY_NAME$ mangler eller er deaktivert. Om du ikke forventet dette, vennligst kontroller statusen på modifikasjonen. Du kan prøve å laste inn spillet likevel, men dette kan mislykkes, eller andre problemer kan oppstå, avhengig av hvilken modifikasjon dette er." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modifikasjon $DEPENDENCY_NAME$ er inkompatibel med din spillversjon. Dette betyr at produsenten av denne modifikasjonen merket denne kompatibel med noen bestemte spillversjoner, og din nåværende spillversjon er ikke blant disse.<br><br>Løsninger:<br>- Prøv å finne en oppdatert versjon av modifikasjonen, som er designet for å kunne fungere med den nåværende spillversjonen.<br>- Oppdatere eller nedgradere spillet til en versjon som er kompatibel med modifikasjonen.<br><br>Du kan prøve å laste inn det lagrede spillet likevel, men modifikasjonen vil ikke bli lastet inn. Det kan hende at det lagrede spillet ikke kan lastes inn, eller det kan oppstå andre problemer, avhengig av hva modifikasjonen gjorde." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "MANGLENDE FILER" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETALJER" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Åpne Workshop-side"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Dette lagrede spillet er avhengig av DLC-er eller modifikasjoner som mangler. De er listet opp nedenfor. Ved å velge et punkt på listen kan du få mer informasjon om hver spesifikk ting." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Det lagrede spillet er avhengig av minst en påkrevd DLC eller modifikasjon. Du må fikse problemet før du kan laste dette lagrede spillet." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Avbryt innlasting" #+ Abort loading button.

	key[]: "type"
	val[]: "Type" #+ Type column.

	key[]: "dependency_name"
	val[]: "Avhengighetsnavn" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokal modifikasjon" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop modifikasjon" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Valgfri DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Påkrevd DLC" #+ DLC that is required to load save that is depending on it.
#@}

