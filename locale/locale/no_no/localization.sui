	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler posisjonen til girskifteren."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler posisjonen til girskifteren."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler inndataen som brukes til å veksle mellom områder basert på skifteroppsettet."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler en knapp for å veksle mellom girskifter-splitt basert på giroppsettet."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
