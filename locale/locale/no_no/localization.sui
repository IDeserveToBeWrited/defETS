#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Velger kontrollerundertypen for spillet til å håndtere inndatasområder på riktig måte."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Velger girkassetype:<br>-\"Enkel automatgir\" lar bruk av gasspedalen og bremsen for å kontrollere framover- og reversbevegelser.<br>- \"Ekte automatgir\" krever en inndata for å bytte mellom framover og i revers.<br>- \"Sekvensiell\" krever manuell veksling av alle gir med gir opp / ned-inndata.<br>- \"H-Skifter\" krever bruk av en kontroller med girporter for å velge gir manuelt."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Endrer automatgirets girskiftelogikk.<br>- \"Eco-modus\" foretrekker lavere turtall forspent mot maksimalt dreiemoment.<br>- \"Høy effekttilstand\" vil dreie mot topp hestekrefter for bedre kjøreegenskaper med tung last eller fjellterreng på bekostning av drivstofføkonomi."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Justerer forholdet mellom enhetens rotasjonsgrad og kjøretøyets faktiske grad av styrerotasjon."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Justerer lineariteten mellom inngang og kjøretøystyring.<br><br>Justering av denne verdien høyere betyr at styringen vil reagere mindre når hjulet er i midten, og vil øke i følsomhet når hjulet dreies mot maksimal låsing. Dette kan være nyttig for å jevne ut styreinngangene når du kjører rett."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Aktiverer krafttilbakemelding i kontrollere som støtter det."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Justerer den totale forsterkningen for alle krafttilbakemeldingsinnstillinger mellom 0N og 10N.<br><br><color value=@@clr_txt_d@@>Vær oppmerksom på at å justere denne til en høyere innstilling i kraftige hjulbaser kan forårsake skade på fingre eller hender."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Justere sentreringskraften når du kjører i høy hastighet, som topper ved 90 km/t (56 mph) og over.<br><br>Minimumsinnstillingen vil resultere i ingen hjulsentreringskraft."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Justere sentreringskraften ved kjøring i lav hastighet.<br><br>Minimumsinnstillingen vil resultere i ingen hjulsentreringskraft."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styrken til kunstig indre friksjon forårsaket av mekaniske styrekomponenter."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styrken til kunstig motorresonans gjennom rattstammen.<br><br><color value=@@clr_txt_d@@>Vær oppmerksom på at innstillingen av denne verdien over 15 % kan føre til overdreven risting og vibrasjoner i enkelte hjul."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styrken på veidekkeeffektene gjennom rattstammen.<br><br><color value=@@clr_txt_d@@>Vær oppmerksom på at innstillingen av denne verdien over 20 % kan føre til overdreven risting og vibrasjoner i enkelte hjul når du kjører i ujevnt terreng i fart."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styrken på veihumpeffekter gjennom rattstammen."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styrken på kollisjonseffekter gjennom rattstammen."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Justerer intensiteten til girkassens slipeeffekter."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Justerer intensiteten til understyringens slipeffekter."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Justerer intensiteten på assistert styring (ved bruk av kjørefeltassistentsfunksjonen osv.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Justerer intensiteten til terrengoverflatevibrasjoner, hvis kontrolleren støtter vibrasjonstilbakemelding."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Justerer intensiteten til humpevibrasjoner hvis kontrolleren støtter vibrasjonstilbakemelding."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Justerer intensiteten på kollisjonsvibrasjoner hvis kontrolleren støtter vibrasjonstilbakemelding."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaksen som skal brukes til styring."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styreaksens dødsone; mengden rotasjon fra midten der inndata ignoreres.<br><br>Dette kan redusere problemer fra eldre kontrollere, for eksempel unøyaktighet eller falske inndata forårsaket av slitasje."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer styreaksen:<br>- Sentrert er ideell for ratt eller styrespak.<br>- Invertert brukes til å korrigere en akse som har blitt detektert feil."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaksen som skal brukes til å akselerere kjøretøyet."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerer akselerasjonsaksens dødsone; mengden inngangsreiser der ingen inngang er registrert.<br><br>Dette kan redusere problemer fra eldre kontrollere, for eksempel unøyaktighet eller falske inndata forårsaket av slitasje."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer kontrollerinndata:<br>- Sentrert er ideell for styrespak.<br>- Normal er ideell for triggere eller pedaler.<br>- Invertert kan kompensere for innganger som ble oppdaget feil."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaksen som skal brukes til bremsing."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerer bremseaksens dødsone; mengden inngangsreiser der ingen inngang er registrert.<br><br>Dette kan redusere problemer fra eldre kontrollere, for eksempel unøyaktighet eller falske inndata forårsaket av slitasje."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer kontrollerinndata:<br>- Sentrert er ideell for styrespak.<br>- Normal er ideell for triggere eller pedaler.<br>- Invertert kan kompensere for innganger som ble oppdaget feil."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaksen som skal brukes til å koble inn kløtsjen."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerer kløtsjaksens dødsone; mengden inngangsreiser der ingen inngang er registrert.<br><br>Dette kan redusere problemer fra eldre kontrollere, for eksempel unøyaktighet eller falske inndata forårsaket av slitasje."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer kontrollerinndata:<br>- Sentrert er ideell for styrespak.<br>- Normal er ideell for triggere eller pedaler.<br>- Invertert kan kompensere for innganger som ble oppdaget feil."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Justerer rekkevidden til kløtsjen.<br><br>Jo lenger til høyre du angir rekkevidden, jo lenger må du trykke ned pedalen for å koble inn kløtsjen."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaksen som skal brukes til å vippe kameraet opp og ned."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerer dødsonen for se opp-ned-aksen; mengden inngangsreiser der ingen inngang er registrert.<br><br>Dette kan redusere problemer fra eldre kontrollere, for eksempel unøyaktighet eller falske inndata forårsaket av slitasje."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer akseinngangen:<br>- Sentrert er ideell for styrespak.<br>- Invertert brukes til å korrigere en akse som har blitt detektert feil."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaksen som skal brukes til å panorere kameraet til venstre og høyre."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerer dødsonen for se venstre-høyre akse; mengden inngangsreiser der ingen inngang er registrert.<br><br>Dette kan redusere problemer fra eldre kontrollere, for eksempel unøyaktighet eller falske inndata forårsaket av slitasje."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer akseinngangen:<br>- Sentrert er ideell for styrespak.<br>- Invertert brukes til å korrigere en akse som har blitt detektert feil."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Velger giroppsettet som skal brukes med H-Skifter."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Endrer oppførselen til girskifteren:<br>- Med \"Enkel\"-alternativet vil du aldri slipe gir når du girer.<br>- Alternativet \"Enkel + advarselslyd\" vil tillate deg å skifte enkelt også, men med girslipelyder når du gir feil.<br>- Alternativet \"Avansert\" vil ikke tillate deg å skifte gir hvis du gir feil, og du vil bare bli møtt med girslipelyder. Alternativet \"Avansert\" lar deg også bruke \"shifter rask splitt\"-innstillingen."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Velg hvordan spillet håndterer raske girdelinger:<br>- \"Aldri\" vil kreve at girspaken flyttes til nøytral mellom delingene.<br>- \"Kløtsjpress\" krever en kortvarig nedtrykking av clutchen uten at girspaken beveger seg.<br>- \"Gassutløsning\" krever at sjåføren kun slipper gassen for å dele girene uten girstangbevegelse, og \"kløtsj eller gass\" er en kombinasjon av de to sistnevnte."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler posisjonen til girskifteren."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler posisjonen til girskifteren."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
