	key[]: "browse_compatible_trailers"
	val[]: "Oversikt over kompatible hengere" #+ Button opening compatible trailers browser where user can select trailer to continue delivering external market job from his own trailers.

	key[]: "open_trailer_dealer"
	val[]: "Åpne Kjøp henger" #+ Button opening trailer dealer external market job.

