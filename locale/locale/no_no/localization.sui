	val[]: "Pass på!<br>Du kommer faretruende tett på den bakerste følgebilen!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Trykk den følgende tast for å vise spesialoppdragstilbudet:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Spesialoppdragstilbud:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Du skal til å kjøre med spesialtransportslast! Det er to følgebiler som vil vise deg vei. Vær forsiktig og følg deres ledelse og forslagsvarsler. Spesialtransport som dette stopper ikke ved et rødt signal og har forkjørsrett i de fleste situasjonene. Under leveransene blir det laget sjekkpunkter oftere for å lagre din nåværende fremgang."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Vær ekstra oppmerksom på følgende:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Unngå enhver mulig konflikt med følgebilene og hold lasten mellom dem."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ikke kjør utenfor den anslåtte ruten, heller ikke til bensinstasjoner, rasteplass osv."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Følg fartsbegrensningene som vil bli forsikret av den fremste følgebilen."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Se opp for forbikjøringstrafikken og andre bilister på veiene."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Feltskifte:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Hvis du ikke følger disse reglene, så kan spesialtransportoppdraget mislykkes!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Denne manøveren er startet av den <color value=@@clr_sel@@>bakre<color value=@@clr_txt@@> følgebilen ved å bytte og blokkere den utpekte kjørefeltet."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Den <color value=@@clr_sel@@>fremste<color value=@@clr_txt@@> følgebilen venter frem til den utpekte kjørefeltet er ledig og så bytter den også feltet."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Det er nå trygt for en <color value=@@clr_sel@@>spiller<color value=@@clr_txt@@> til å bytte til den utpekte kjørefeltet."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
