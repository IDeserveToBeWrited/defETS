#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "For å få tilgang til Kjapp oppdrag, må du fullføre den gjeldende opplæringsveiviseren."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "For å få tilgang til fraktemarkedet, må du kjøpe din første lastebil."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "For å få tilgang til Lastemarkedet må du først ha tildelt en henger."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "For å få tilgang til Eksterne oppdrag må du ha tidelt en lastebil og ha en World of Trucks-tilkoblet profil."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "For å få tilgang til Eksterne lastemarked må du ha tildelt en henger og ha en World of Trucks-tilkoblet profil."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Se verdenskartet, dets utforskede områder og dine nåværende navigasjonssjekkpunkter eller angi nye. "

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Rask reise mot betaling til en tidligere oppdaget by."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Bla gjennom, søk og filtrer nettbaserte konvoisesjoner for å bli med eller opprette din egen for andre."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Din innboks for meldinger fra forretningsverdenen, banker og nye selskapsansettelser."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "E-poster vil begynne å komme når du har kommet lenger i karrieren."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Finn og kjøp tilgjengelige garasjer på verdenskartet."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Bla gjennom og se gjennom tilgjengelige brukte lastebiler du kan kjøpe."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Du har ikke funnet noen lastebilforhandlere ennå."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Bla gjennom, se gjennom og rekonfigurere tilgjengelige hengere for kjøp."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Forbedre kjøreopplevelsen med litt musikk."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Radioen er ikke tilgjengelig."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Konfigurere grafikk, lyd, spilling, kontroller og nettinnstillinger."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Se gjennom din karrierefremgang, statistikk og nylig fullførte oppdrag."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "For å få tilgang til Aktiv konvoi, må du først gå inn i en konvoisesjon."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Helseadvarsel"

	key[]: "health_warning_description"
	val[]: "Et lite antall brukere kan være utsatt for epileptiske anfall eller tap av bevissthet når de utsettes for visse blinkende lys eller lysmønstre. Noen personer kan oppleve et anfall mens de ser på bestemte bilder eller spiller et videospill. Hvis du eller noen i din familie noen gang har hatt symptomer relatert til epilepsi (anfall eller tap av bevissthet) når de ble utsatt for blinkende lys, vennligst ta en kontakt med en lege og ta alle nødvendige forholdsregler før du spiller spillet.<br offset=20>Hvis du eller barnet ditt opplever noen av følgende symptomer mens det spilles et videospill: svimmelhet, endret syn, rykninger i øyne eller muskler, tap av bevissthet, desorientering, kramper, ufrivillige bevegelser, avbryt bruken av videospillet umiddelbart og kontakt en lege."

	key[]: "trademark"
	val[]: "Alle merkenavn, varemerker, registrerte merker, logoer og symboler på kjøretøy i spillet tilhører sine rettmessige eiere. Brukes med vennlig tillatelse. MAN®-varemerkene og designene er registrerte rettigheter tilhørende MAN Truck & Bus AG og brukes under lisens til SCS Software s.r.o. «Mercedes-Benz» og «Trespisset stjerne i en ring» er varemerker tilhørende Daimler AG og brukes under lisens av SCS Software s.r.o. RENAULT-varemerkene og designene er registrerte rettigheter tilhørende eller lisensiert til AB Volvo Group og brukes i henhold til en lisens. VOLVO-varemerkene og designene er registrerte rettigheter tilhørende eller lisensiert til AB Volvo Group og brukes i henhold til en lisens."
#@}

