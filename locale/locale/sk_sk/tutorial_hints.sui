
    key[]: "hint_engine_title"
	val[]: "Naštartuj motor"

    key[]: "hint_engine_text"
	val[]: "Pre zapnutie motora stlač $KEY_engine$."


    key[]: "hint_ignition_title"
	val[]: "Zapni zapaľovanie"

    key[]: "hint_ignition_text"
	val[]: "Stlač $KEY_engineelect|KEY_engine$ pre zapnutie napájania."


    key[]: "hint_driv_arc_title"
	val[]: "Jazda"

    key[]: "hint_driv_arc_text"
	val[]: "Použi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pre jazdu vpred alebo vzad.<br><offset vshift=8>Použi $SPECIAL_steering$ pre zatáčanie."


    key[]: "hint_driv_auto_title"
	val[]: "Jazda"

    key[]: "hint_driv_auto_text"
	val[]: "Použi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pre jazdu vpred alebo vzad.<br><offset vshift=8>Použi $SPECIAL_steering$ pre zatáčanie.<br><offset vshift=8>Použi $KEY_gearup$ a $KEY_geardown$ pre výber rýchlostných stupňov."


    key[]: "hint_driv_seq_title"
	val[]: "Jazda"

    key[]: "hint_driv_seq_text"
	val[]: "Použi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pre jazdu vpred alebo vzad.<br><offset vshift=8>Použi $SPECIAL_steering$ pre zatáčanie.<br><offset vshift=8>Použi $KEY_gearup$ a $KEY_geardown$ pre ovládanie spojky."


    key[]: "hint_driv_hshift_title"
	val[]: "Jazda"

    key[]: "hint_driv_hshift_text"
	val[]: "Použi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pre jazdu vpred alebo vzad.<br><offset vshift=8>Použi $SPECIAL_steering$ pre zatáčanie.<br><offset vshift=8>Rychlostný stupeň zmeníš pomocou <color value=@@clr_sel@@>riadiacej páky<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Priblíž sa k miestu určenia"

    key[]: "hint_depot_deliv_text"
    val[]: "Zastav na vyznačenom mieste pre výber obtiažnosti parkovania a získaj zodpovedajúce skúsenostné body."


    key[]: "hint_fin_deliv_title"
    val[]: "Dokonči zákazku"

    key[]: "hint_fin_deliv_text"
    val[]: "Zaparkuj na vyznačenom mieste. Stlačením $KEY_activate$ môžeš parkovanie preskočiť, akonáhle budeš blízko k miestu doručenia."


    key[]: "hint_fin_deliv2_title"
    val[]: "Dokonči zákazku"

    key[]: "hint_fin_deliv2_text"
    val[]: "Zaparkuj na vyznačenom parkovacom mieste.V @@desktop_menu_category_options@@ si môžeš zapnúť widget, ktorý ti umožní preskočiť parkovanie."


    key[]: "hint_lights_title"
    val[]: "Zasvieť svetlá"

    key[]: "hint_lights_text"
    val[]: "Použi $KEY_light$ pre rozsvietenie svetiel. Opakovaným stlačením prepínaj medzi rôznymi režiimami."


    key[]: "hint_high_beam_title"
    val[]: "Zasvieť diaľkové svetlá"

    key[]: "hint_high_beam_text"
    val[]: "Použi $KEY_hblight$ pre rozsvietenie diaľkových svetiel."


    key[]: "hint_wipers_title"
    val[]: "Zapni stierače"

    key[]: "hint_wipers_text"
    val[]: "Použi $KEY_wipers$ pre zapnutie stieračov a prepínaním rôznych nastavení rýchlosti."


    key[]: "hint_zoom_title"
    val[]: "Priblíženie"

    key[]: "hint_zoom_text"
    val[]: "Použi $KEY_camzoom$ pre priblíženie kamery v interiéri. Režim priblíženia si môžeš nastaviť na podržanie alebo prepínanie v @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Rozhliadnutie sa"

    key[]: "hint_cam_int_text"
    val[]: "Použi $KEY_cam1$ pre prepnutie na vnútornú kameru."


    key[]: "hint_cam_ext_title"
    val[]: "Rozhliadnutie sa"

    key[]: "hint_cam_ext_text"
    val[]: "Medzi rôznymi kamerami môžeš prepínať stlačením $KEY_camcycle$.<br><offset vshift=8>Použi $KEY_cam2$ pre prepnutie na vonkajšiu kameru."


    key[]: "hint_indicators_title"
    val[]: "Smerovky"

    key[]: "hint_indicators_text"
    val[]: "Použi $KEY_lblinker$ a $KEY_rblinker$ pre zapnutie smeroviek."


    key[]: "hint_tow_title"
    val[]: "Odťahová služba"

    key[]: "hint_tow_text"
    val[]: "Ak sa nedokážeš dostať z akejkoľvek náročnej situácie, využi odťahovú službu. Pre prístup k nej otvor menu @@quick_info_word@@ použitím $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Uzávierka diferenciálu"

    key[]: "hint_diff_lock_text"
    val[]: "Ak sa nemôžeš rozbehnúť, možno by ti pomohla uzávierka diferenciálu. Použi $KEY_diflock$ pre jej aktivovanie alebo zapni automatickú uzávierku diferenciálu v @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Uzávierka diferenciálu aktivovaná"

    key[]: "hint_diff_unlock_text"
    val[]: "Počas bežnej jazdy by si mal diferenciál odomknúť, inak hrozí jeho poškodenie. Použi $KEY_diflock$ pre jeho deaktiváciu alebo zapni automatickú uzávierku diferenciálu v @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Vypni stierače"

    key[]: "hint_wipers_off_text"
    val[]: "Použi $KEY_wipers$ pre deaktivovanie stieračov a prepínanie medzi rôznymi rýchlosťami."


    key[]: "hint_world_map_title"
    val[]: "Zobrazenie mapy"

    key[]: "hint_world_map_text"
    val[]: "Použi $KEY_navmap$ pre otvorenie mapy sveta."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Použi $KEY_advmouse$ pre otvorenie @@quick_info_word@@ - prehľad o tvojom stave a praktické skratky."


    key[]: "hint_pause_border_title"
    val[]: "Miestne predpisy"

    key[]: "hint_pause_border_text"
    val[]: "Použi $KEY_advmouse$ pre otvorenie @@quick_info_word@@ a pozri sa na aktuálne predpisy v oblasti, do ktorej si práve vstúpil."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Otvor @@quick_info_word@@ pomocou $KEY_advmouse$, aby si sa dostal do @@photo_mode_word@@ a mohol vyfotiť blízky @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ po blízku"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> je po blízku - nájdi ju a aktivuj pre zhliadnutie cutscény."


    key[]: "hint_resting_title"
    val[]: "Odpočívadlo po blízku"

    key[]: "hint_resting_text"
    val[]: "Odpočívadla <img src=/material/ui/map/parking_ico.mat width=20 height=20> ti umožňujú zmierniť únavu a bezpečne pokračovať v ceste."


    key[]: "hint_gas_title"
    val[]: "Čerpacia stanica po blízku"

    key[]: "hint_gas_text"
    val[]: "Čerpacie stanice <img src=/material/ui/map/gas_ico.mat width=20 height=20> môžeš používať k dotankovaniu paliva do svojho vozidla."
