#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Táto testovacia trať ti ponúkne malú ochutnávku skutočnej jazdy v bezpečí našich tréningových areálov. Vyskúšaj si niektoré zo svojich novo nadobudnutých zručností a nezabudni sledovať svoje okolie a využiť všetok dostupný priestor.<br><br>Oplatí sa tiež plánovať dopredu!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Pokračuj doprava nájdi cestu na trať."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Pred tebou je zjazd, ktorý môžeš využiť na vyskúšanie správania dvojitých návesov pri vyššej rýchlosti."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Priprav sa brzdiť kvôli nadchádzajúcej zákrute."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Prejdi cez deliaci pás zatočením doprava a hneď doľava."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Prejdi cez deliaci pás ešte raz."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Môžu nastať situácie, keď nebudeš mať inú možnosť než celú súpravu zalomiť.<br><br>Urob, čo je potrebné, aby si prešiel touto extrémne ostrou zákrutou."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Pokračuj v jazde po trati."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Slalomom jazdi opatrne a uisti sa, že návesy nielen prejdú popri každej bariére, ale že si zároveň pripravený aj na prejazd okolo tej nasledujúcej."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Pokračuj doľava a prejdi rovno cez križovatky."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Pokračuj po asfalte doprava."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Posledná zákruta je zradná. Síce ponúka veľa miesta, ale priprav sa na to, že budeš parkovať pri vzdialenejšom obrubníku."

#!{
	key[]: "aca_msg_book3_train_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_train_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

