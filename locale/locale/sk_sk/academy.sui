#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Kombinované jazdné manévre"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "V tejto situácii skombinujeme tvoje novo naučené zručnosti na zvládnutie krátkej, ale technickej trasy, ktorá bude zahŕňať cúvanie do zákruty a prejazd ostrou pravouhlou zákrutou."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Cúvanie na stranu vodiča"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Pravouhlá zákruta"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Dokončenie zákruty"
