#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Pred tebou je bariéra. Choď k nej a zastav."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Za ťahačom na strane vodiča je ďalšia prekážka. Cúvaj po zákrute k nej. Cestné značenie môžeš použiť ako pomôcku."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Rovno pred tebou je ostrá pravouhlá zákruta. Prejdi k nej."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Budeš si musieť do zákruty dostatočne nadbehnúť, aby zadné kolesá obišli dopravný kužeľ na vnútornej strane zákruty.<br>Používaj zrkadlá!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Vyrovnaj sa a prejdi k posledným prekážkam, potom zastav a zabezpeč ťahač."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Ťahač stále nie je pripravený na pohyb, možno si na niečo zabudol?<br><br>Je motor zapnutý? Uvoľnil si parkovaciu brzdu?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Rovno pred tebou je vyznačené miesto tesne pred prekážkou.<br><br><font face=/font/big_bold.font>Pokračuj vpred a zastav vo vyznačenom mieste. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Pozri sa za seba na strane vodiča. Uvidíš tam ďalšie vyznačené miesto. Budeš musieť cúvať a zároveň zatáčať.<br><br><font face=/font/big_bold.font>Cúvaj po zákrute a zastav na vyznačenom mieste. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Trať pokračuje pred tebou pravouhlou zákrutou.<br><br>Drž sa na vonkajšej strane zákruty, čo najviac si nadbehni a potom ostro zatoč doprava. Dbaj na to, aby si nezrazil vnútorný dopravný kužeľ.<br><br><font face=/font/big_bold.font>Pokračuj vpred a prejdi zákrutou. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Použi predné a bočné zrkadlá, aby si sa uistil, že do ničoho nenarazíš.<br><br><font face=/font/big_bold.font>Dokonči zákrutu a zastav v určenej oblasti. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Vypni motor a zabezpeč ťahač.</font>"
#@}

