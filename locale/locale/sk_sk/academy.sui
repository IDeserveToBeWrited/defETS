#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Vitaj v prvej časti záverečnej skúšky. Tu uvidíme, ako dobre si sa naučil riadiť ťahač počas tvojho času stráveného v autoškole."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Najprv pripojíš náves. Po pripojení prejdeš s ťahačom celou testovacou oblasťou."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Prvá časť trate vedie z malého parkoviska na východnú testovaciu trať."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Okruh zahŕňa náročné pasáže medzi prekážkami."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Významná časť trasy vedie cez východnú testovaciu trať."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Otestujeme tvoju schopnosť manévrovať s ťahačom v rôznych situáciách."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "S ťahačom budeš manévrovať cez ostré zákruty."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Prejdeš úsekom cesty spájajúcej trate."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Záverečná časť zahŕňa jazdu po malom okruhu."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Okruh má mnoho zložitých prechodov a ostrých zákrut."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Na dokončenie testu budeš musieť presne zaparkovať."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nebuď nervózny, už si sa naučil všetko, čo budeš potrebovať na úspešné zvládnutie testu.<br><br>Veľa šťastia!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Pred tebou je náves.<br><br><font face=/font/big_bold.font>Prejdi smerom k návesu. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Zarovnaj ťahač s návesom.<br><br><font face=/font/big_bold.font>Cúvaj a pripoj sa k pripájaciemu čapu. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zabezpeč ťahač. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Stlač @@imv_nrm_attach@@<font face=/font/big_bold.font> pre pripojenie návesu. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Náves je pripojený a ťahač je pripravený na jazdu..<br><br><font face=/font/big_bold.font>Uvoľni parkovaciu brzdu. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Pohni sa smerom k výjazdu z parkoviska.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Sleduj cestné značenie a dávaj pozor na prekážky.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Blíži sa náročnejšia sekcia.<br><br><font face=/font/big_bold.font>Opatrne manévruj medzi prekážkami. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Táto časť otestuje tvoje zručnosti pri manévrovaní s návesom v rôznych typoch zákrut.<br><br><font face=/font/big_bold.font>Odboč na trať. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Prejdi úsekom. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Choď rovno</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Opatrne prejdi zákrutou. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Vchádzaš do náročnejšej sekcie. Jazdi opatrne.<br><br><font face=/font/big_bold.font>Pokračuj v jazde dole kopcom. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Prejdi ostrou ľavou zákrutou. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Opusti trať. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Vchádzaš do jednoduchšej sekcie.<br><br><font face=/font/big_bold.font>Pokračuj v jazde dole kopcom. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jazde po ceste. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Pred tebou je odbočka na ďalšiu trať.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Zaboč doprava. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jazde po trati. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Pred tebou sú ďalšie ostré zákruty.<br><br><font face=/font/big_bold.font>Prispôsob tomu svoju rýchlosť. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Zaboč doľava. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Vojdi do zákruty a pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Na zvládnutie tejto zákruty možno budeš musieť ísť trochu mimo asfalt.<br><br><font face=/font/big_bold.font>Zatoč opatrne a použi toľko miesta, koľko potrebuješ. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Opusti trať a choď k parkovaciemu miestu. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Záverečná skúška (2. časť)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Posledná časť záverečnej skúšky ťa ešte len čaká. Budú v nej vyhodnotené tvoje parkovacie zručnosti, ktoré si sa naučil v predchádzajúcich scenároch. Parkuj opatrne a presne a budeš pripravený vyraziť na európske cesty ako skúsený kamionista!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manéver s posunom"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Diagonálne parkovanie"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Jazda cez parkovisko"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Pozdĺžne parkovanie"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Posledné parkovanie"
