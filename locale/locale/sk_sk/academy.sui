#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Ťahače majú veľký mŕtvy uhol v oblasti pred kabínou. Je jednoduché stratiť z dohľadu chodca alebo dokonca aj auto v tejto oblasti, preto sú ťahače vybavené predným zrkadlom, ktoré je viditeľné cez čelné sklo."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Predné zrkadlo je navrhnuté tak, aby vodičovi poskytlo výhľad do tohto mŕtveho uhla.<br>Je to nevyhnutný nástroj, ktorý zabezpečuje, že pri manévrovaní v stiesnených priestoroch nenarazíš do prekážok."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Rozíď sa a pokračuj smerom k prekážke pred sebou. Následne spomaľ, keď sa k nej budeš približovať.<br>Sleduj predné zrkadlo."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Zastav medzi čiarou a prekážkou."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "V tomto scenári sa naučíme používať predné zrkadlo zobrazené na diagrame.<br><br><font face=/font/big_bold.font>Nájdeš ho, ak sa pozrieš cez hornú časť čelného skla.</font>@@aca_goal_tip@@ Musíš byť vo vnútri vozidla."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Predné zrkadlo ti umožňuje vidieť do mŕtveho uhla pred ťahačom. Môže ti pomôcť k väčšej bezpečnosti a precíznosti pri jazde<br><br>Ak nie si spokojný s nastavením, otvor '@@adjust_link_t@@' (k nastaveniam môžeš pristúpiť cez úpravy vozidla pri pauznutí hry), aby si ho nastavil podľa svojich predstáv.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre pokračovanie. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Rovno pred ťahačom je vyznačené miesto, na ktorého druhej strane je prekážka. Keď sa k nej priblížiš, pokračuj veľmi pomaly a sleduj vzdialenosť k prekážke v prednom zrkadle.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Ťahač stále nie je pripravený na pohyb, možno si na niečo zabudol?<br><br>Je motor zapnutý? Uvoľnil si parkovaciu brzdu?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Prejdi smerom k parkovaciemu miestu. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Zastav prednú časť ťahača medzi prekážkou a vyznačeným cestným značením.</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

