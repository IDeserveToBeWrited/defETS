#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkovanie vedľa prekážky"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "V tomto scenári sa naučíme parkovať vedľa obrubníka pomocou bočného zrkadla."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Skontroluj bočné zrkadlo"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Jazda smerom k obrubníku"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Bočné zrkadlo je ďalším nástrojom, ktorý ti pomôže bezpečne manévrovať s ťahačom. Nachádza sa na hornom ráme dverí spolujazdca."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Pohni sa dopredu a pomaly zaboč na stranu spolujazdca."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Tieto drevené dosky predstavujú obrubník. Potrebuješ zaparkovať vedľa neho.<br>Zaboč smerom k obrubníku, aby si ťahač dostal do dobrej pozície k zarovnaniu sa s parkovacím miestom."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Spomaľ ešte pred obrubníkom a zatoč smerom k parkovaciemu miestu. Počas toho, ako sa budeš narovnávať, môžeš použiť bočné zrkadlo na odhadnutie vzdialenosti od obrubníka."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Zastav na parkovacom mieste a zabezpeč ťahač."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Pozri sa cez okno na strane spolujazdca. Uvidíš tam bočné zrkadlo.</font>@@aca_goal_tip@@ Musíš byť vo vnútri vozidla."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Bočné zrkadlo pokrýva oblasť na strane spolujazdca, ktorú vodič nevidí. Je to jeden z najproblematickejších mŕtvych uhlov na kamióne. Ak ti uhol zrkadla nevyhovuje, môžeš ho upraviť v '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Ťahač stále nie je pripravený na pohyb, možno si na niečo zabudol?<br><br>Je motor zapnutý? Uvoľnil si parkovaciu brzdu?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Pred tebou je rad dosiek predstavujúcich obrubník. Na konci obrubníka je parkovacie miesto. Budeš tam musieť zájsť.<br><br><font face=/font/big_bold.font>Pokračuj, keď budeš pripravený. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Zatoč smerom k obrubníku. Použi predné a bočné zrkadlá na kontrolu tvojej pozície vo vzťahu k obrubníku, ale zároveň si daj pozor, aby si neprešiel žiadne dopravné kužele.<br><br><font face=/font/big_bold.font>Prejdi smerom k obrubníku a do parkovacieho miesta.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Zaisti ťahač a vypni motor.</font>@@aca_goal_tip@@ Môžeš použiť prednastavené pohľady v interiéri, aby si si uľahčil pohľad na zrkadlá. Skontroluj obrazovku s nastaveniami - 'Klávesy a tlačidlá' - kde nájdeš a/alebo zmeníš príslušné ovládacie prvky."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parkovanie cúvaním vedľa prekážky"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "V tomto scenári zaparkujeme ťahač cúvaním do parkovacieho miesta vedľa obrubníka."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Inštrukcie"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Cúvanie smerom k obrubníku"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parkovanie ťahača"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "V tomto scenári vykonáme cúvací manéver, aby sme zaparkovali vedľa obrubníka."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Cúvanie smerom k obrubníku.<br>Musíš si byť vedomý svojho okolo počas cúvania, preto sleduj zrkadlá."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Keď sa priblížiš, môžeš začať zarovnávať ťahač s parkovacím miestom. Počas cúvania sleduj obe strany ťahača."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Zastav na parkovacom mieste a zabezpeč ťahač."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Parkovacie miesto je za tebou smerom na stranu pasažiera. Použi svoje zrkadlá na navigáciu k parkovaciemu miestu.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Nezabudni použiť zrkadlá na kontrolu svojho okolia predtým, ako pohneš ťahačom.<br><br><font face=/font/big_bold.font>Začni cúvať smerom k obrubníku. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Pokračuj v sledovaní svojho okolia, keď cúvaš do parkovacieho miesta.<br><br><font face=/font/big_bold.font>Zastav na vyznačenom mieste. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Pokročilá tréningová trať"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Posledný scenár v tejto kapitole je jazda na pokročilej výcvikovej trati. Otestujeme zručnosti, ktoré si sa naučil s ťahačom!"

#### 2_06 goal



