	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Vitaj v druhej časti záverečnej skúšky. Presunieme sa na neďaleké parkovisko a otestujeme tvoje schopnosti v cúvaní a manévrovaní na parkovacie miesta."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Na otestovanie tvojich schopností ťa čaká niekoľko po sebe nasledujúcich parkovacích výziev."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Priestor je tu obmedzený, takže buď opatrný a neponáhľaj sa."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Nezabudni, že je dôležité byť opatrný a neponáhľať sa. Je v poriadku, ak sa ti to nepodarí na prvý pokus, dôležité je nepoškodiť svoj ťahač alebo tie okolo teba. <font face=/font/big_bold.font><br><br>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Pohni sa dopredu k prvej časti skúšky.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tvojou prvou úlohou je predviesť manéver parkovania s posunom. Naľavo je miesto, kde musíš nacúvať s návesom.<br><br><font face=/font/big_bold.font>Vykonaj manéver parkovania s posunom.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Ďalšou úlohou je cúvanie k rade stojacich ťahačov. Dávaj pozor, aby si do iných ťahačov nenarazil!<br><br><font face=/font/big_bold.font>Vykonaj manéver diagonálneho parkovania.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Pokračuj cez parkovisko. Buď na pozore pred neočakávanými situáciami.<br><br><font face=/font/big_bold.font>Pokračuj v jazde.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Teraz si vyskúšajme pozdĺžne parkovanie medzi dvoma ťahačmi pri obrubníku pred tebou.<br><br><font face=/font/big_bold.font>Zaparkuj pozdĺžne.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Posledný parkovací manéver po ľavej strane! Môžeš k tomu pristúpiť, ako len chceš.<br><br><font face=/font/big_bold.font>Cúvaj do označenej oblasti.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Máš takmer hotovo. Opusti testovaciu oblasť a zaparkuj ťahač.<br><br><font face=/font/big_bold.font>Opusti testovaciu oblasť po ľavej strane.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Môžeš zaparkovať kamión vpravo s ostatnými.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Pozdĺžne parkovanie s návesom"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "V tomto scenári sa pozrieme na pozdĺžne parkovanie s pripojeným návesom."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Zastavenie v označenej oblasti"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Pozdĺžne parkovanie s návesom je dôležitá zručnosť pre každého vodiča kamiónu.<br>Či už ide o parkovanie na ulici vo veľkom meste, alebo zastavenie na odpočívadle na vidieku, každý vodič by to mal zvládnuť."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Keď budeš prechádzaš okolo parkovacieho miesta, pozorne sa rozhliadni a uisti sa, že je dostatok priestoru pre ťahač a náves. V tomto prípade sme zabezpečili, že máš dostatok miesta."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Zrovnaj sa s ťahačom nachádzajúcim sa pred parkovacím miestom. Príliš sa nepribližuj, nechaj si priestor na manévrovanie."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Zaťoč ostro smerom od parkovacieho miesta a začni cúvať. Cieľom je, aby sa náves hneď otočil na parkovacie miesto."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Keď je náves správne nasmerovaný na miesto, môžeš ho začať nasledovať dovnútra."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Začni otáčať náves od obrubníka skôr, než kolesá návesu na strane vodiča vojdú na miesto."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Vyrovnaj ťahač s návesom a zarovnaj sa v strede parkovacieho miesta.<br>Zaparkuj, vypni motor a zabezpeč ťahač."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Všimni si parkovacie miesto pred tebou, medzi ostatnými ťahačmi. Pri parkovaní si nezabudni kontrolovať zrkadlá a udržuj bezpečnú vzdialenosť medzi ťahačom a prekážkami okolo teba.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Prejdi cez parkovisko a nájdi svoje parkovacie miesto.<br><br><font face=/font/big_bold.font>Pokračuj vpred. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Prejdi okolo požadovaného parkovacieho miesta do vyznačeného miesta. Odtiaľ môžeš začať cúvací manéver.<br><br><font face=/font/big_bold.font>Zastav na vyznačenom mieste. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Zatoč s ťahačom smerom od miesta, aby si začal otáčať náves smerom k nemu. Nezatáčaj príliš ostro, inak narazíš na obrubník.<br><br><font face=/font/big_bold.font>Začni cúvať. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Zarovnaj náves s parkovacím miestom. Ak je to potrebné, pohybuj sa dopredu alebo dozadu a urob potrebné korekcie riadením, aby si upravil svoju pozíciu.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Gratulujeme, úspešne si dokončil skúšky v základoch jazdy s kamiónom a naučil si sa všetky zručnosti potrebné na správne manévrovanie s kamiónom."

	key[]: "aca_msg_book1_outro02"
	val[]: "Toto je prvý krok na ceste k splneniu tvojho sna stať sa profesionálnym vodičom kamióna."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Teraz si pripravený vyraziť na európske cesty a čeliť svojim prvým výzvam..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...ale dobrodružstvo sa iba začalo."
#@}


