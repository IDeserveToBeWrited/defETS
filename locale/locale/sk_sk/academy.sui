#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Trať pred tebou ti pomôže oboznámiť sa s prejazdom pravouhlými zákrutami s dvojitými návesmi pri rôznej úrovni obtiažnosti týchto zákrut."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Prvých niekoľko zákrut je pomerne širokých a ponúka dosť priestoru. Využi ho na to, aby si získal predstavu o zatáčaní návesov za sebou."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Od tohto momentu budú zákruty užšie a technickejšie. Vchádzaj do nich pomaly a uisti sa, že do zákrut si dostatočne nadbehneš, aby mali návesy dostatok priestoru na udržanie stopy."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Toto je jedna z najužších zákrut na trati. Možno sa oplatí využiť trochu miesta napravo, aby si s návesmi obišiel tie otravné vnútorné kužele."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Vždy by si mal myslieť na to, čo nasleduje – už pri výjazde z danej zákruty si pripravuj plán na prejazd ďalšej."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Vždy dávaj pozor na svoje návesy, kým nie sú úplne mimo dosahu akýchkoľvek prekážok."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Pokračuj vpred smerom k prvej zatáčke."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Sleduj spätné zrkadlá, aby si vnímal, ako sa návesy za tebou pohybujú."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Pred každou zákrutou si nadbehni zoširoka, čo je kľúčové, aby si mal dostatok priestoru na otočenie návesu v zákrute."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Príprava na nasledujúce zákruty je rozhodujúca, pretože za nimi nasleduje veľmi ostrá zákruta. Chyba na začiatku ti môže všetko skomplikovať aj neskôr.<br><br> Choď pomaly, rozvážne a dávaj pozor na svoje okolie."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Táto zákruta je extrémne úzka a vedie priamo do ďalšej úzkej zákruty. Musíš zvážiť nielen to, ako do zákruty vojdeš, ale aj ako z nej vyjdeš a ako sa pripravíš na ďalšiu."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Pokračuj v jazde cez posledné zákruty smerom k vyznačenej oblasti."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Prvé cúvanie"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "V tomto scenári si po prvýkrát zacúvame s dvojitými návesmi."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Kľud, neboj sa"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Cúvanie s dvojitými návesmi si vyžaduje úplne nový spôsob uvažovania o tom, čo robíš. Namiesto jednoduchého riadenia návesu teraz používaš predný náves na riadenie návesu za ním.<br><br>Využi tento scenár na získanie predstavy o tom, ako to celé funguje. Neexistuje žiadny konkrétny cieľ – jednoducho sa neponáhľaj a snaž sa pochopiť, o čo ide."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Z priamej polohy môžeš natočiť ťahač rovnakým smerom, akým chceš, aby išiel aj zadný náves.<br><br>Ale nepreháňaj to. Stačí, keď zadný náves nasmeruješ požadovaným smerom. Potom môžeš ťahač vyrovnať s predným návesom a nechať zadný náves ísť si svojou cestou."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Akonáhle sa zadný náves vydá požadovaným smerom, môžeš natočiť predný náves tak, aby tiež išiel tým istým smerom.<br><br>Keď predný náves nasleduje zadný, ťahačom upravuj uhol medzi oboma návesmi pre ostrejšiu alebo širšiu zákrutu."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Neexistuje žiadny presný recept, ako to urobiť správne. Stačí si všímať, čo sa okolo teba deje, poučiť sa zo svojich chýb a neustále cvičiť.<br><br>Keď budeš spokojný, môžeš sa presunúť na vyznačené miesto a zaistiť vozidlo.<br><br>Neváhaj tu stráviť experimentovaním toľko času, koľko budeš potrebovať."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Začni pomaly cúvať. Nezabudni začať drobnými pohybmi, aby si hneď nezlomil súpravu.<br><br>Skús cúvať rovno alebo pristaviť náves na stranu vodiča."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Neponáhľaj sa a nenechaj sa vystresovať.<br><br>Nikto učený z neba nespadol."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Prvé korekcie pri cúvaní"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "V tomto scenári budeme musieť nadviazať tam, kde niekto iný skončil."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Cúvanie"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Vyzerá to, že sa niekto pri cúvaní naštval a nechal svoju súpravu uprostred parkoviska."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Nevyhnutne nastanú chvíle, keď manéver úplne pokazíš. Neboj sa – jednoducho sa zo zalomenej pozície pohni dopredu, kým sa nedostaneš do stavu, z ktorého sa dá znovu pokračovať.<br><br>Ak si nebudeš istý, snaž sa všetko vyrovnať, aby si začal z východiskovej situácie."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Toto je slušná východisková pozícia. Zadný náves je stále nasmerovaný tým správny smerom. Preto môžeme rýchlo dostať ťahač pred prvý náves a následne začať riadiť celú súpravu na miesto určenia."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Pokračuj na vyznačené miesto a zaisti ťahač.<br><br>Tento scenár si môžeš precvičovať znovu, kým sa pri manévrovaní s návesmi nebudeš cítiť pohodlne."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Z tohto chaosu sa už nedostaneš. Pohni sa dopredu, aby si mal s čím pracovať."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Začni cúvať."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Priame cúvanie"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "V tomto scenári musíš zacúvať s dvojitými návesmi v priamom smere."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Cúvanie"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Cúvanie rovno sa môže na prvý pohľad zdať jednoduché, ale v skutočnosti je oveľa náročnejšie.<br><br>Namiesto obyčajného korigovania uhla medzi návesmi na jednej strane musíš teraz strážiť obe strany, aby súprava zostala rovná."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Začni s relatívne malými korekciami. Nevadí, ak sa budeš neustále prehupovať zo strany na stranu. Len pamätaj, že musíš udržať uhol medzi ťahačom a predným návesom o niečo dlhšie, aby si zmenil uhol medzi predným a zadným návesom."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Možno budeš musieť s ťahačom urobiť niekoľko pomerne veľkých manévrov, aby zadný náves smeroval požadovaným smerom. Snaž sa to ale nepreháňať a potom to možno ani nebude potrebné."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Môžeš sa niekoľkokrát pohnúť dopredu, aby si všetko skorigoval. Najdôležitejšie je bezpečne doraziť na parkovacie miesto, zvyšok je už len formalita."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Začni pomaly cúvať."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Narovnaj sa a zastav vo vyznačenej oblasti."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Zabezpeč vozidlo a vypni motor."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Korekcie pri cúvaní v rovine"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "V tomto scenári sa ujmeš riadenia po tom, čo sa niekto iný pokúsil o rovné cúvanie. Naprav jeho chybu a zaparkuj súpravu na vyznačenom mieste."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Narovnanie sa"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Cúvanie"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Niekto sa pokúsil cúvať s touto súpravou na parkovacie miesto a veľmi sa mu to nedarilo. Teraz je na tebe, aby si to napravil."

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Prvým krokom je pohnúť sa dopredu a všetko vyrovnať, aby si vedel ďalej so súpravou pracovať. Zásadné je, aby zadný príves smeroval tam, kam chceš."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "V tomto prípade sme sa rozhodli ísť viac smerom k strane vodiča. To nám poskytne lepší výhľad na to, čo robíme pri cúvaní, a umožní nám pracovať z jednej strany.<br><br>Nezabudni, že zadný náves ovládaš tým predným, takže sa nesústreď príliš na samotný ťahač."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Súprava je viac-menej tam, kde ju potrebujeme, ale ešte sa trochu pohneme dopredu, aby sme ju správne vycentrovali."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Odtiaľto veľmi opatrne zacúvame na miesto a uistíme sa, že zadný náves sleduje správnu stopu."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Teraz môžeme vyrovnať predný náves aj samotný ťahač."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Pohni sa dopredu a všetko vyrovnaj.<br><br>Keď budeš spokojný, nacúvaj do vyznačeného priestoru."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Cúvaj smerom k vyznačenej oblasti."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Zabezpeč vozidlo a vypni motor."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Cúvanie do pravého uhla"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "V tomto scenári použiješ pravouhlý cúvací manéver, aby si zaparkoval do radu medzi ostatné ťahače."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Otočka"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Príprava"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Cúvanie"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Cúvanie do strany je s dvojitými návesmi jednoduchšie, pretože z bočného okna máš lepší výhľad na všetko, čo sa deje."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Najprv choď dopredu a na konci radu sa otoč. To ti umožní nastaviť sa tak, že budeš mať lepší výhľad cez okno na strane vodiča."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Návesy si môžeš pripraviť tak, ako uznáš za vhodné, napríklad so zadným návesom už nasmerovaným k danému miestu. V tomto prípade začneme z rovnej polohy.<br><br>Hlavne si to nekomplikuj – zadný náves koriguj pomocou predného."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Zatoč predný náves mierne smerom od parkovacieho miesta a zadný náves sa k nemu začne stáčať. Potom uprav uhol medzi predným a zadným návesom tak, aby si do parkovacieho miesta vošiel pekným plynulým oblúkom."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Nezabudni, že ak sa zadný náves stáča príliš, musíš uhol súpravy trochu narovnať. Ak naopak smeruje príliš zoširoka, uhol musí byť ostrejší."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Korekcie, ktoré robíš ťahačom, majú na zadný náves približne polovičný vplyv v porovnaní s predným návesom, takže sa neboj s ťahačom poriadne manévrovať."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "V tomto momente musíš začať plánovať dopredu. Na cieľové miesto musíš dostať aj predný náves, takže si už teraz naplánuj, ako ho dostať priamo pred zadný."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Bolo by veľmi výnimočné, keby sa ti podarilo zacúvať s návesmi na prvý pokus. V tomto prípade sme s vyrovnaním predného návesu čakali príliš dlho a teraz nám ten zadný vychádza zo stopy.<br><br>Nevadí, pohni sa dopredu a skús to znova."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Poradne pracuj s volantom a dostaň návesy tam, kam potrebuješ. Môžeš sa pohnúť dopredu toľkokrát, koľkokrát to bude potrebné, kým nebudeš spokojný."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Vidíš ako jednoducho si úspešne zaparkoval s dvojitými návesmi."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Choď dopredu na koniec parkoviska a otoč sa."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Nezabudni si poriadne zoširoka nadbehnúť."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Pokračuj vpred, kým nebudeš mať dostatok priestoru na manévrovanie, a potom začni cúvať."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Zacúvaj na parkovacie miesto, až budeš mať pocit, že máš dostatok priestoru na manévrovanie."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


