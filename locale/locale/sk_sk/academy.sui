	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ nie je určená na nahradenie výcviku v kabíne.</font><br><br><color value=@@clr_txt@@>Dôrazne odporúčame vyhľadať inštrukcie od akreditovanej inštitúcie pre výcvik vodičov nákladných vozidiel pred pokusom o riadenie ťahača v reálnom živote.<br><br>Inštitúcie pre výcvik záujemcov, ktoré majú záujem použiť @@driving_academy@@ na doplnenie výcviku vodičov v kabíne nás môžu kontaktovať na academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Základy jazdy s kamiónom"

	key[]: "aca_book_book1_desc"
	val[]: "Nauč sa základy jazdy s kamiónom, od základných funkcií a ovládania k manévrovaniu s návesom."

	key[]: "aca_book_book2_title"
	val[]: "Zručnosti ovládania ťahača"

	key[]: "aca_book_book2_desc"
	val[]: "Zlepši svoje vodičské zručnosti s novými scenármi v náročnejších podmienkach."

	key[]: "aca_book_book3_title"
	val[]: "Jazda s dvojitým návesom"

	key[]: "aca_book_book3_desc"
	val[]: "Vyskúšaj si zaujímavé výzvy pri jazde a cúvaní s dvojitými návesmi."

