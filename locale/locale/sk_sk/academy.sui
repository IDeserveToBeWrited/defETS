#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Ovládanie kamery"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "V tomto scenári si povieme o rôznych typoch dostupných kamier a ako ti môžu pomôcť pri ovládaní a manévrovaní s ťahačom."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Pozícia sedenia"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Výhľad dozadu"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Kontrola zrkadiel"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Prepni pohľad na vonkajšiu kameru"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Porozhliadni sa okolo ťahača"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "V tomto scenári si prejdeme rôzne kamery<br>ktoré sú k dispozícii."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Môžeš si celkovo vybrať zo siedmych kamier, teraz si prejdeme<br>niekoľko z nich a vysvetlíme si ich zamýšľané funkcie."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Rôzne kamery a ich rôzne uhly ti môžu pomôcť pri manévrovaní v úzkych priestoroch."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Základom bezpečnej a profesionálnej jazdy je vidieť, kam ideš. Ak ti aktuálna poloha sedadla nevyhovuje, môžeš ju zmeniť v '@@adjust_link_t@@' (prístupné pri pauznutí hry).<br><br><font face=/font/big_bold.font>Potvrď, že si prepravený, pomocou @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Pri cúvaní zrkadlá nie vždy poskytujú úplný výhľad. Môže byť potrebné vykloniť sa z okna, aby si mal lepší výhľad za tebou.<br><br><font face=/font/big_bold.font>Otoč kameru úplne na stranu vodiča, aby si sa pozrel z okna smerom k zadnej časti návesu.</font>@@aca_goal_tip@@ Musíš byť vo vnútri vozidla."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Použi tento pohľad na kontrolu návesu počas cúvacích manévrov s návesom. Je vždy lepšie cúvať na stranu vodiča, aby si mohol lepšie využiť tento pohľad. Pri cúvaní na stranu spolujazdca máš oveľa obmedzenejší výhľad na to, čo sa deje za tebou.<br><br><font face=/font/big_bold.font>Pozri sa na stranu spolujazdca. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Toto je dôvod prečo sa zvyčajne neodporúča cúvať na stranu spolujazdca. Ako môžeš vidieť, výhľad je dosť obmedzený. Našťastie máš k dispozícii aj sedem vonkajších kamier. <br><br>Tlačidlo @@imv_nrm_camcycle@@ môžeš použiť na prepnutie na nasledujúcu kameru v poradí. Po preklikaní všetkých siedmich kamier sa vrátiš na začiatok cyklu. <br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_camcycle@@ pre zobrazenie nasledujúcej kamery </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Vonkajšia kamera poskytuje najlepšiu perspektívu na to, čo sa deje okolo ťahača.<br><br><font face=/font/big_bold.font>Rozhliadni sa okolo ťahača.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Stlačením @@imv_nrm_camcycle@@ znova, môžeš prepnúť na ďalšiu kameru. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Pohľad zhora poskytuje vynikajúci prehľad o situácii okolo ťahača, čo výrazne zjednodušuje parkovanie a jazdu v stiesnených priestoroch.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_camcycle@@ pre zobrazenie nasledujúcej kamery. </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Kamera na streche poskytuje jasný výhľad na cestu ďaleko pred ťahačom bez veľkého obmedzenia.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_camcycle@@ pre zobrazenie poslednej kamery, ktorú si teraz prezrieme.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Pohľad dozadu je skratka k výhľadu, ktorý si získal otočením interiérovej kamery. Ako sme už hovorili, je užitočný pri cúvaní alebo parkovaní.<br><br>V hre máme viacero kamier, ktoré môžeš vyskúšať opakovaným stlačením @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_cam1@@ pre návrat do interiéru.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Pre autentický zážitok z autoškoly odporúčame zostať pri pohľade z interiérovej kamery počas prechádzania jednotlivými scenármi.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre potvrdenie a ukončenie scenára.</font>@@aca_goal_tip@@ Môžeš použiť funkciu @@o_im_cam_zoom@@ pre lepší prehľad o svojom okolí. Táto funckia je obzvlášť užitočná pri pohľade do zrkadiel. Skontroluj obrazovku nastavení - „Klávesy a tlačidlá“ - aby si videl a/alebo zmenil príslušné ovládacie prvky."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Prvá jazda"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "V tomto scenári sa naučíme, ako pripraviť ťahač na jazdu, a potom sa po prvýkrát pohneme s ťahačom dopredu."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Zapnutie zapaľovania"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Naštartovanie motora"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Kontrola okolia"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Použitie prevádzkovej brzdy"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Radenie rýchlostí"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Povolenie parkovacej brzdy"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Jazda vpred"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Zastavenie"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Aplikovanie parkovacej brzdy"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Preradenie do neutrálu"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Vypnutie motora"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Počas tvojich prvých jázd budeme používať iba ťahač.<br>Kamión sa označuje ako ťahač, keď nemá vlastnú nákladnú nadstavbu a namiesto toho sa spolieha na použitie návesu na prepravu tovaru a materiálov."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Ťahače sú populárne, pretože umožňujú väčšiu všestrannosť: môžu zhodiť prázdny náves a pripojiť naložený bez toho, aby bolo potrebné čakať, alebo prejsť na úplne iný druh návesu."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Pri tvojej prvej jazde bude tvojou úlohou pohnúť sa dopredu a zastaviť za prerušovanou čiarou.<br>Naštartuj motor a podľa pokynov priprav ťahač na jazdu. Keď budeš pripravený, pohni sa rovno dopredu."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Prejdi za prerušovanú čiaru, zastav, vypni motor a zabezpeč ťahač."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Ako ďalší krok v tvojom výcviku sa prvýkrát pohneš s ťahačom.<br><br>Samozrejme, bez bežiaceho motora to nebude možné, takže najprv budeš musieť zapnúť zapaľovanie.<br><br><font face=/font/big_bold.font>Stlač $input engineelect$ pre zapnutie zapaľovania.</font>@@aca_goal_tip@@ Pri základných nastaveniach v režime kariéra sa motor spolu s elektrinou zapína automaticky. Toto správanie môžeš upraviť v nastaveniach - 'Hra' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Zapaľovanie aktivuje elektroniku kamióna. Možno si si všimol, že kontrolky na prístrojovej doske zablikali - to je normálne. Ak zostanú svietiť aj po naštartovaní motora, pravdepodobne to signalizuje problém s kamiónom. Výnimkou je kontrolka parkovacej brzdy, ktorá zhasne po uvoľnení parkovacích bŕzd.<br><br>Našťastie je tento kamión vo výbornom stave a sme pripravení vyraziť.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_engine@@ pre naštartovanie motora.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Teraz, keď je motor naštartovaný, je dôležité skontrolovať svoje okolie predtým, než sa pohneš.<br><br><font face=/font/big_bold.font>Rozhliadni sa okolo ťahača a pozri sa do vodičovho a spolujazdcovho zrkadla, aby si si overil, že okolie ťahača je čisté.</font>@@aca_goal_tip@@ Musíš byť vo vnútri vozidla."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Môže sa to zdať samozrejmé, ale pred začatím akéhokoľvek pohybu by si mal najprv vedieť ako zastaviť.<br><br><font face=/font/big_bold.font>Aktivuj prevádzkovú brzdu použitím $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Ďalej sa naučíš, ako zmeniť smer jazdy.<br><br>So zjednodušenou automatickou prevodovkou nie je potrebné radiť rýchlosti, všetko sa robí za teba automaticky.<font face=/font/big_bold.font><br><br>Použi $input forward$ na zaradenie rýchlosti vpred.</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Ďalej sa naučíš, ako zmeniť smer jazdy.<br><br>Realná automatická prevodovka ti umožňuje radiť medzi režimami Drive, Neutral a Reverse rovnako ako pri skutočných automatických prevodovkách.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_gearup@@ na zaradenie rýchlosti vpred. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Ďalej sa naučíš, ako zmeniť smer jazdy.<br><br>Sekvenčná prevodovka umožňuje postupné radenie rýchlostí, rovnako ako pri skutočných sekvenčných prevodovkách.<br><br>Rovnako ako pri zaradení rýchlosti vpred, pri zrýchľovaní budeš musieť radiť do vyšších rýchlostí.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_gearup@@ na zaradenie prvej rýchlosti.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Ďalej sa naučíš, ako zmeniť smer jazdy.<br><br>S radiacou pákou a spojkou zažiješ rovnaký pocit fyzického radenia prevodov, ako pri skutočnej manuálnej prevodovke.<br><br>Úplne stlač spojku a brzdový pedál.<font face=/font/big_bold.font>Použi radiacu páku na zaradenie prvej rýchlosti. <color value=@@clr_txt@@>Maj spojku a brzdový pedál stále úplne stlačené.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Aby si sa mohol pohnúť, musíš najprv uvoľniť parkovaciu brzdu.<br><br><font face=/font/big_bold.font>Použi @@imv_nrm_parkingbrake@@ na uvoľnenie parkovacej brzdy.</font> @@aca_goal_tip@@ V kariére je parkovacia brzda na začiatku vypnutá. Toto správanie môžeš upraviť v Nastaveniach - 'Hra' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Teraz je ťahač pripravený na pohyb vpred. Začni sa pohybovať a prejdi prerušovanú čiaru.<br><br><font face=/font/big_bold.font>Pohni sa použitím akcelerátora: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Teraz je ťahač pripravený na pohyb vpred. Začni sa pohybovať a prejdi prerušovanú čiaru.<br><br><font face=/font/big_bold.font>Pohni sa použitím akcelerátora: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Teraz je ťahač pripravený na pohyb vpred. Začni sa pohybovať a prejdi prerušovanú čiaru.<br><br><font face=/font/big_bold.font>Pohni sa použitím akcelerátora: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Teraz je ťahač pripravený na pohyb vpred. Začni sa pohybovať a prejdi prerušovanú čiaru.<br><br><font face=/font/big_bold.font>Uvoľni prevádzkovú brzdu, postupne púšťaj spojku a súčasne používaj akcelerátor, aby si udržal otáčky motora dostatočne vysoko a motor ťahača nezhasol. Keď je spojka úplne uvoľnená, môžeš zrýchľovať a radiť rýchlosti podľa potreby. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Použi prevádzkovú brzdu na zastavenie.<br><br><font face=/font/big_bold.font>Stlač $input backward$ pre zastavenie ťahača. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Použi prevádzkovú brzdu na zastavenie.<br><br><font face=/font/big_bold.font>Stlač $input backward$ pre zastavenie ťahača. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Použi prevádzkovú brzdu na zastavenie.<br><br><font face=/font/big_bold.font>Stlač $input backward$ pre zastavenie ťahača. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Keď je čas zastaviť, úplne stlač spojku <font face=/font/big_bold.font>a potom zastav ťahač pomocou brzdového pedálu.<color value=@@clr_txt@@> Pomocou radiacej páky zarad neutrál a potom môžeš uvoľniť spojku.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Teraz zabezpeč ťahač. Parkovacia brzda zabezpečí, že sa ťahač po zaparkovaní nebude neúmyselne pohybovať.<br><br><font face=/font/big_bold.font>Použi @@imv_nrm_parkingbrake@@ na aktiváciu parkovacej brzdy.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "So zjednodušenou automatickou prevodovkou nie je potrebné radiť rýchlosti, všetko sa robí automaticky za teba.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre potvrdenie. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Zaraď neutrál stlačením @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Zaraď neutrál stlačením @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Zaraď neutrál na radiacej páke, potom uvoľni spojku. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Teraz vieš, ako pohnúť ťahačom a ako ho bezpečne zastaviť.<br><br><font face=/font/big_bold.font>Stlač $input engineelect$ pre vypnutie motora. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Cúvanie"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "V tejto situácii sa pokúsime po prvýkrát o cúvanie. Taktiež si povieme, ako využiť zrkadlá na pohľad za seba, na čo si dávať pozor a ako sa pripraviť na cúvanie."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Naštartovanie motora"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Skontrolovanie spätného zrkadla na strane pasažiera"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Skontrolovanie spätného zrkadla na strane vodiča"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Radenie rýchlostí"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Povolenie parkovacej brzdy"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Preradenie do neutrálu"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Vypnutie motora"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Počas tejto jazdy budeme cúvať priamo. Budeš musieť cúvať za prerušovanú čiaru a tam zastaviť."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Pri cúvaní s ťahačom je nevyhnutné neustále sledovať okolie, kontrolovať všetky zrkadlá a uistiť sa, že priestor okolo a za tebou je voľný."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Naštartuj motor, zaraď spiatočku a pohni sa."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Cúvaj za prerušovanú čiaru, zastav, vypni motor a zabezpeč ťahač."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Priprav ťahač na jazdu tak, ako si sa naučil v predchádzajúcom scenári.<br><br><font face=/font/big_bold.font>Keď budeš pripravený, naštartuj motor. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Skontroluj zrkadlá, aby si sa uistil, že oblasť okolo teba je voľná. Ak nie si spokojný s ich polohou, môžeš ich nastaviť v '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Pozri sa do zrkadla na strane spolujazdca.</font>@@aca_goal_tip@@ Musíš byť vo vozidle."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Pôjdeš za prerušovanú čiaru. Pruh je teraz voľný, ale počas bežnej jazdy je nevyhnutné neustále sledovať svoje okolie tým, že sa budeš obzerať okolo seba a používať zrkadlá.<br><br><font face=/font/big_bold.font>Skontroluj zrkadlo na strane vodiča.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Použi $input backward$ pre zaradenie spiatočky. </font>@@aca_goal_tip@@ Pri cúvaní sa na väčšine ťahačov automaticky aktivuje cúvací alarm. Môžeš ho vypnúť v Nastaveniach - „Zvuk“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Stlač @@imv_nrm_geardown@@ pre zaradenie spiatočky.</font>@@aca_goal_tip@@ Pri cúvaní sa na väčšine ťahačov automaticky aktivuje cúvací alarm. Môžeš ho vypnúť v Nastaveniach - „Zvuk“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Stlač @@imv_nrm_geardown@@ pre zaradenie spiatočky.</font>@@aca_goal_tip@@ Pri cúvaní sa na väčšine ťahačov automaticky aktivuje cúvací alarm. Môžeš ho vypnúť v Nastaveniach - „Zvuk“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Stlač úplne spojku a zaraď spiatočku pomocou radiacej páky. </font>@@aca_goal_tip@@ Pri cúvaní sa na väčšine ťahačov automaticky aktivuje cúvací alarm. Môžeš ho vypnúť v Nastaveniach - „Zvuk“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Teraz máš zaradenú spiatočku.<br><br><font face=/font/big_bold.font>Uvoľni parkovaciu brzdu použitím @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Začni sa pohybovať použitím $input dozadu$.<br><br><font face=/font/big_bold.font>Cúvaj za prerušovanú čiaru.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Začni sa pohybovať použitím plynového pedála: $input forward$.<br><br><font face=/font/big_bold.font>Cúvaj za prerušovanú čiaru. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Začni sa pohybovať použitím plynového pedála: $input forward$.<br><br><font face=/font/big_bold.font>Cúvaj za prerušovanú čiaru. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Uvoľňuj spojku pomaly, pričom udržuj otáčky motora použitím plynového pedála.<br><br><font face=/font/big_bold.font>Cúvaj za prerušovanú čiaru. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Zastav ťahač pomocou prevádzkovej brzdy: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Zastav ťahač pomocou prevádzkovej brzdy: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Zastav ťahač pomocou prevádzkovej brzdy: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Stlač úplne spojku a potom zastav ťahač pomocou prevádzkovej brzdy.</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Aktivuj parkovaciu brzdu pomocou @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "So zjednodušenou automatickou prevodovkou nie je potrebné vôbec radiť rýchlosti, pretože všetko sa robí automaticky za teba, na rozdiel od skutočnosti.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre potrvrdenie. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Zaraď do neutrálu stlačením @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderné ťahače automaticky zaradia do neutrálu, keď sa aktivuje parkovacia brzda. Avšak je dobrým zvykom vždy to urobiť sám. V nasledujúcich situáciách nebudeme tento krok vyžadovať."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Zaraď do neutrálu stlačením @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@  Moderné ťahače automaticky zaradia do neutrálu, keď sa aktivuje parkovacia brzda. Avšak je dobrým zvykom vždy to urobiť sám. V nasledujúcich situáciách nebudeme tento krok vyžadovať."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Zaraď do neutrálu pomocou radiacej páky, potom uvoľni spojku.</font>@@aca_goal_tip@@  Moderné ťahače automaticky zaradia do neutrálu, keď sa aktivuje parkovacia brzda. Avšak je dobrým zvykom vždy to urobiť sám. V nasledujúcich situáciách nebudeme tento krok vyžadovať."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Nezabudni, že počas cúvania musíš byť vždy obozretný so svojím okolím, najmä v oblastiach s rušnou premávkou.<br><br><font face=/font/big_bold.font>Vypni motor stlačením $input engineelect$. </font>"
#@}

