#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Základy ovládania a pohybu"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Nauč sa základy ovládania vozidla a ako sa pohnúť s ťahačom dopredu alebo dozadu."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br>Dokončil si 1. kapitolu: @@aca_chapter_book1_1_title@@.<br><br>Naučil si sa, ako pripraviť ťahač pred jazdou,<br>jazdu dopredu alebo dozadu a ako používať svetlá a stierače.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Základné manévre"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Nauč sa riadiť, manévrovať a parkovať s ťahačom. Zisti účel každého typu zrkadla a ako ho správne používať."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil si 2. kapitolu: @@aca_chapter_book1_2_title@@.<br><br>Naučil si sa, ako využívať každé zrkadlo na ťahači, kontrolovať priestor okolo vozidla pred pohybom a vykonávať základné aj pokročilé manévre.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manévrovanie s návesom"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Nauč sa pripojiť príves a manévrovať s ním v rôznych situáciách."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil si 3. kapitolu: @@aca_chapter_book1_3_title@@.<br><br>Naučil si sa pripojiť a odpojiť náves,<br>vnímať hmotnosť a rozmery ťahača s návesom<br>a jazdiť na náročných tratiach s návesom.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Cúvanie s návesom"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Nauč sa nové manévre na efektívne cúvanie a parkovanie s návesom."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil si 4. kapitolu: @@aca_chapter_book1_4_title@@.<br><br>Naučil si sa cúvať s návesom<br>a rôzne techniky parkovania.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Záverečná skúška"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Preukáž svoje vedomosti a zručnosti, aby si dokázal, že si hodný byť vodičom kamióna!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil si 5. kapitolu: @@aca_chapter_book1_5_title@@.<br><br>Preukázal si, že máš všetky potrebné zručnosti<br>na riadenie, manévrovanie a parkovanie ťahača!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Zahriatie motora"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Úspešne si dokončil výcvik: @@aca_chapter_book2_0_title@@.<br><br>Naučil si sa pravidlá a funkcie Zručnosti ovládania kamióna.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Zase v prevode"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Blahoželám!<br>Dokončil si kapitolu 2: @@aca_chapter_book2_1_title@@.<br><br>Naštartoval si motor, otestoval prevodovky, správne roztáčal kolesá a skontroloval účinnosť bŕzd. Nasledujúce kapitoly budú náročnejšie.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Kolesá v pohybe"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Blahoželám!<br>Dokončil si kapitolu 3: @@aca_chapter_book2_2_title@@.<br><br>Ovládol si náročné a rôznorodé scenáre. Preukázal si zručnosť a výkon.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Cieľová rovinka"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Blahoželám!<br>Dokončil si kapitolu 4: @@aca_chapter_book2_3_title@@.<br><br>Zvládol si mnoho náročných situácií pri manévrovaní, parkovaní a cúvaní s návesom. Dokázal si, že si zručný vodič, schopný zvládnuť všetky náročné situácie pri riadení kamiónu."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Jazda vpred"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Nauč sa všetky základné techniky pre manévrovanie s dvojitými návesy pri jazde vpred."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br>Dokončil si prvú kapitolu: @@aca_chapter_book3_1_title@@.<br><br>Vyskúšal si si, ako efektívne jazdiť a manévrovať s dvojitými návesmi.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Riadenie pri cúvaní"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Osvoj si potrebné kroky pre manévrovanie s dvojitými návesmi pri cúvaní."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br>Dokončil si druhú kapitolu: @@aca_chapter_book3_2_title@@.<br><br>Naučil si sa veľmi potrebnú zručnosť cúvania s dvojitými návesmi.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Príprava na reálnu jazdu"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Využi svoje nové znalosti v pokročilejších scenároch."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font><font face=/font/big.font>Gratulujeme!<br>Dokončil si tretiu kapitolu: @aca_chapter_book3_3_title@@.<br><br>Zvládol si mnoho obtiažnych situácií pri manévrování, parkovaní a cúvaní s dvojitými návesmi. Tu si sa už osvedčil dostatočne a teraz môžeš vyraziť s dvojitými návesmi na cesty v Euro Truck Simulator 2!</font><br><br>"


#@}

