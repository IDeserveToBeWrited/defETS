#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Zastavenie v blízkosti prekážky"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "V tomto scenári sa budeme rozprávať o prednom zrkadle – kde sa nachádza a ako ho efektívne využiť, aby si bezpečne zastavil blízko prekážky pred sebou."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Skontroluj predné zrkadlo"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Pohopenie jeho funkcie"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Zastavenie v blízkosti prekážky"
