#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Jazda okolo prekážok"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Pred tebou sú rôzne zložité zákruty a prekážky.<br>Vezmi do úvahy všetko, čo si sa doteraz naučil, a zvládnuť to by nemalo byť pre teba príliš zložité."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Cestné značenie ti môže pomôcť získať predstavu o tom, ako postupovať cez každú sadu prekážok."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Drž ťahač na vonkajšej strane zákruty.<br>Budeš musieť vybrať zákrutu naširoko, pretože náves pri prejazde opisuje kratšiu vzdialenosť."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Nasleduje ľahká pravouhlá zákruta.<br>Opäť drž ťahač na vonkajšej strane zákruty a využi všetok dostupný priestor."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Neponáhľaj sa. Trať sa otvára, ale stále budeš musieť byť precízny."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Poriadne si nadbehni pri prejazde okolo bariér."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Buď opatrný pri vstupe do tohoto úzkeho úseku. <br>Pred vstup choď s ťahačom naširoko, aby si pripravil náves na vjazd."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Posledná pravouhlá zákruta je oveľa ostrejšia ako prvá. Mal by si ale mať dostatok miesta, ak ho rozumne využiješ."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Zastav na určenom mieste, potom zabezpeč ťahač a vypni motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Pamätaj, že cestné značenie ti môže pomôcť pri navigácii na trati.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Použitie zrkadiel ti tiež pomôže pri bezpečnej navigácii traťou. Musíš si byť vždy vedomý toho, ako sa náves pohybuje za tebou.<br><br><font face=/font/big_bold.font>Prejdi prvou zákrutou.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Pozoruj náves, keď vychádzaš zo zákruty, a priprav sa na vjazd do ďalšej.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Postupuj cez ďalšiu zákrutu. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Nezabudni pozorovať svoj náves, aby si sa uistil, že si pred zatočením s ťahačom mimo prekážok okolo teba.<br><br><font face=/font/big_bold.font>Pokračuj okolo prekážok pred tebou. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Keď je tvoj náves mimo prekážok, prudko zatoč na stranu spolujazdca, aby si sa zarovnal pre úzky prejazd. <br><br><font face=/font/big_bold.font>Postupuj smerom k úzkemu prejazdu.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Táto časť bude vyžadovať veľmi presnú jazdu. Daj si načas a používaj zrkadlá.<br><br><font face=/font/big_bold.font>Drž sa na vonkajšej strane každej zákruty. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Táto zákruta je veľmi ostrá, no môžeš využiť všetok priestor pred sebou, aby si ju ľahko zvládol.<br><br><font face=/font/big_bold.font>Prejdi poslednou zákrutou. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Pokročilá tréningová trať - náves"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "V záverečnom scenári 3. kapitoly nás čaká dlhšia tréningová trať s rôznymi zákrutami, na ktorej uvidíme, ako dobre si sa naučil manévrovať s návesom."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "„Dogleg“ zákruta"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "ODSTRÁNIŤ TENTO CIEĽ"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Prejazd oddeľovaním pásom"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Prvý slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Druhý slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Jednoduché zákruty"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Kruhový objazd"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Rovinka"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Úzka zákruta"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Posledné zákruty"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Jazda na parkovacie miesto"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "V tomto scenári sa stretneš s rôznymi typmi zákrut, aby si si zvykol na jazdu s návesom. Zostaň sústredený, prispôsob rýchlosť každej situácii a naplno využívaj priestor na tréningovej trati."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Prvá zákruta je typu „Dogleg“ - dve zákruty v jednej. Budeš sa musieť pripraviť na ľavú zákrutu, ale v strede manévru prejsť na pravú zákrutu."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Táto ďalšia zákruta ťa prevedie na druhú stranu stredového pásu. Nie je obzvlášť náročná, ale budeš musieť dávať pozor, aby si nechal dostatok miesta pre svoj náves."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Ďalej budeš musieť prejsť úzkym slalomom cez betónové prekážky. Jazdi pomaly a používaj zrkadlá. Taktiež sa uisti, že sa vyhneš prekážkam dostatočne naširoko, aby aj náves obišiel prekážky."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "V tomto bode vstúpiš do ďalšieho slalomu doplneného o ďalšie kužele na vrchole každej zákruty.<br>Dbaj na to, aby si ani jeden nezasiahol!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Nasleduje niekoľko ľahkých zákrut na tvojej ceste ku kruhovému objazdu."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Použi rovný úsek ako prípravu na vjazd do kruhového objazdu. Pred vjazdom sa drž vonkajšej strany."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Vojdi do kruhového objazdu a sleduj polohu tvojho návesu. V kruhovom objazde sa náves bude pohybovať inak, ako keď si doň vchádzal."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Vyjdi z kruhového objazdu a pokračuj k ďalšej sérii zákrut."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "ODSTRÁNIŤ TÚTO CUTSCÉNU"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Táto zákruta je mimoriadne ostrá. Jazdi pomaly a rozumne využívaj priestor okolo seba. Dávaj pozor aj na vybočenie zadnej časti návesu."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Ako budeš prechádzať ďalšími zákrutami, nezabudni sa pokúsiť pripraviť sa na nasledujúcu zákrutu tak, že správne vyjdeš z tej predošlej."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Neponáhľaj sa v poslednej zákrute. Vyzerá ľahko, ale na manévrovanie je menej miesta, než sa zdá."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Zastav na určenom mieste, potom zabezpeč ťahač a vypni motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Zrýchli smerom k prvej zákrute. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Ako prvá nás čaká jednoduchá zákruta typu „Dogleg“.<br><br><font face=/font/big_bold.font>Prejdi zákrutou. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "ODSTRÁNIŤ TÚTO KONTROLU"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Pokračuj dopredu naľavo od oddeľovacieho pásu.<br><br><font face=/font/big_bold.font>Prejdi cez prejazd. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manévruj cez prekážky a nezabudni sledovať svoj náves.<br><br><font face=/font/big_bold.font>Prejdi cez slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Tento slalom je jednoduchší, ale dopravné kužele ho robia výrazne užším.<br><br><font face=/font/big_bold.font>Prejdi cez slalom a vyhni sa zrazeniu akéhokoľvek kužeľa. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Pred tebou sú dve ľahké zákruty, stále však budeš musieť správne pripraviť náves, aby sa nedostal k vnútorným prekážkam.<br><br><font face=/font/big_bold.font>Prejdi zákrutami. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Blížiš sa ku kruhovému objazdu. Pamätaj, že musíš nechať dosť miesta pre tvoj náves nielen pri vjazde a výjazde, ale aj pri samotnom prejazde.<br><br><font face=/font/big_bold.font>Prejdi cez kruhový objazd. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Pred tebou je krátky rovný úsek, ak chceš môžeš trochu zrýchliť.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Táto zákruta je mimoriadne ostrá. Jazdi pomaly, využívaj všetok dostupný priestor a maj na pamäti vybočenie zadnej časti návesu. <br><br><font face=/font/big_bold.font>Prejdi cez ostrú zákrutu. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Posledné zákruty sú jednoduché. Pamätaj na prítomnosť tvojho náves.<br><br><font face=/font/big_bold.font>Pokračuj. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Pokračuj smerom ku koncovému parkovaciemu miestu. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

