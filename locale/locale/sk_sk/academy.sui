	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "V tomto scenári budeš musieť zacúvať na parkovacie miesto, ktoré je za tebou na strane vodiča."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Existuje niekoľko tipov, ktoré si treba zapamätať a ktoré ti veľmi pomôžu pri cúvaní s návesmi.<br>Prvý je, že náves bude vždy chcieť zatočiť do opačného smeru, ako zatáčaš s ťahačom."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Druhý je, že sledovaním náprav ťahača a návesu môžeš získať dobrú predstavu kam tvoj náves smeruje."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Tretí, už malé pohyby volantom ti pomôžu dostať sa kam potrebuješ, netreba to preháňať."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Začni jemne zatáčať s ťahačom smerom od parkovacieho miesta a náves začne smerovať k nemu."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Nasleduj náves a upravuj smer počas jazdy, aby si náves udržiaval správnu dráhu."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Sleduj kolesá návesu a zadné koleso ťahača. Ukážu ti, kam je náves nasmerovaný a kam ho tlačí ťahač."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Štvrtý tip je, že vždy je jednoduchšie otočiť náves ostrejšie, než sa snažiť ho narovnať pri zalomení. Mier na vonkajšiu stranu miesta, kým nie si bližšie k nemu. Potom môžeš zatočiť o trochu ostrejšie, aby si zarovnal náves."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Keď náves vojde na parkovacie miesto, dostaň ťahač pred náves. Snaž sa vyhnúť prílišným korekciám vo vnútri miesta."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Cúvaj medzi bariéry, kontroluj obe strany počas jazdy."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Zabezpeč ťahač a vypni motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Pamätaj na tieto tipy pri cúvaní do zákruty s návesom:<br><br>— Náves sa otáča opačne, ako zatáčaš s ťahačom<br><br>— Sleduj kolesá návesu, aby si videl, kam smeruje<br><br>— Sleduj zadné koleso ťahača, aby si videl, kam smeruje náves<br><br>— Nechaj náves pracovať, nepretáčaj ho<br><br>— Vždy je ľahšie otočiť náves ostrejšie, než ho narovnávať<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Pozri sa za seba, aby si zistil, kam potrebuješ ísť. Vždy skontroluj svoje okolie, než začneš cúvať.<br><br><font face=/font/big_bold.font>Začni cúvať smerom k parkovaciemu miestu. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Začni otáčať náves smerom k parkovaciemu miestu a nasleduj ho.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zastav v určenej oblasti. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Parkovanie cúvaním na tesné miesto"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "V tomto scenári budeš mať za úlohu cúvať s návesom na parkovacie miesto na rušnom parkovisku."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Otáčanie návesu"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Toto je typické parkovisko pre ťahače. Kamionisti sa s takouto parkovacou situáciou stretnú takmer denne vo svojej kariére.<br>Parkovanie tu vyžaduje manéver „parkovania v uličke“."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Tento manéver je podobný predchádzajúcemu scenáru, ale budeš mať menej priestoru na manévrovanie. Preto budeš musieť podľa toho naplánovať svoje kroky a dávať pozor, aby si nič nezasiahol."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Keďže je tu menej miesta, tvoje načasovanie bude dôležité. Otoč náves v správny čas a sleduj kolesá ťahača a návesu, aby si videl, kam pôjde. Pamätaj na vybočenie zadnej časti a dávaj si pozor, aby nedošlo k jeho zalomeniu - pokračuj v smerovaní návesu."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Snaž sa držať blízko ťahača na strane vodiča, to ti poskytne priestor na vybočenie návesu a môžeš sa menej obávať ťahača na strane spolujazdca."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Keď tvoj náves bude na mieste, dostaň ťahač pred neho. Je lepšie to urobiť o trochu skôr, než by ti tvoj inštinkt spočiatku naznačoval. Vždy môžeš urobiť korekcie pri cúvaní do konečnej pozície."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Zarovnaj ťahač s návesom a zastav vo vyznačenej oblasti."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Zabezpeč ťahač a vypni motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Teraz si vyskúšame otáčanie návesu v oveľa menšom priestore s manévrom „cúvania v uličke“. <br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Skontroluj svoje okolie a nájdi parkovacie miesto za sebou. <br><br><font face=/font/big_bold.font>Začni cúvať smerom k parkovaciemu miestu. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Zatoč náves do parkovacieho miesta. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Záverečná skúška (1. časť)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Čaká ťa záverečná skúška, kde sa otestujú všetky zručnosti, ktoré si sa naučil v predchádzajúcich scenároch. Jazdiť budeme po celom tréningovom centre, aby sme zistili, ako dobre si sa naučil situácie, s ktorými si sa doteraz stretol.<br><br>Po dokončení všetkých sekcií a manévrov budeš o krok bližšie k tomu, aby si sa mohol nazývať skúseným kamionistom!"

