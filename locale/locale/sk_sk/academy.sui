#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Brzdenie s návesom"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "V tomto scenári získaš cit pre jazdu a brzdenie s pripojeným návesom."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Vyrážame"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Jazda dole kopcom"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Dosiahnutie rýchlosti 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Aplikovanie bŕzd"
