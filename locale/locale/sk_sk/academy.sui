#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Diagonálne parkovanie"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "V tomto scenári budeš parkovať na diagonálnom parkovacom mieste na rušnom parkovisku. <br><br>Nie je tu veľa priestoru na manévrovanie, takže budeš musieť byť veľmi presný a rozvážny pri svojej jazde."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Priblíženie sa k parkovaciemu miestu"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Diagonálne parkovacie miesta, ako je toto, sú veľmi bežné, obzvlášť na mnohých odpočívadlách pozdĺž európskych diaľnic.<br>Opäť budeme musieť zaparkovať čelom na parkovacie miesto pred tebou."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Prejdi k určenému parkovaciemu miestu na konci radu."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Drž sa v strede jazdného pruhu alebo mierne na strane vodiča. Nejazdi príliš blízko k prekážkam, pretože zadná časť návesu môže do nich počas zákruty naraziť."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Prejdi o kúsok ďalej za parkovacie miesto a potom rýchlo a prudko zaboč smerom k miestu. Budeš musieť sledovať obe bočné zrkadlá: Zrkadlo na strane vodiča, aby si sa uistil, že predná časť tvojho návesu nenarazí do návesu vedľa teba, a zrkadlo na strane spolujazdca, aby si videl, že tvoj náves bezpečne vchádza na parkovacie miesto."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Zastav na určenom mieste, potom zabezpeč ťahač a vypni motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Pri diagonálnom parkovaní je dôležité presne odhadnúť svoju polohu. Keď si už v polovici zákruty, je ťažké cúvať a bezpečne zaujať novú pozíciu. Preto je ideálne uistiť sa, že máš dostatok miesta na prvý pokus.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Pohni sa smerom k parkovaciemu miestu. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Prejdi okolo parkovacieho miesta, aby mal tvoj náves dostatok miesta na otočenie po vnútornej strane okolo ťahača.<br><br><font face=/font/big_bold.font>Zaboč na parkovacie miesto. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Cúvanie na stranu s obmedzeným výhľadom"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "V tomto scenári sa pozrieme na cúvanie s ťahačom na parkovacie miesto na strane s obmedzeným výhľadom. Bez možnosti pozrieť sa z okna, aby si videl na cestu, sa budeš musieť spoliehať len na svoje zrkadlá pri navigácii na miesto, kam potrebuješ ísť."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "V tomto scenári sa naučíš manéver cúvania na stranu s obmedzeným výhľadom. Tomuto manévru by si sam mal vo všeobecnosti vyhýbať, pokiaľ neexistuje žiadna iná alternatíva, pretože tvoja viditeľnosť je pri ňom výrazne obmedzená. Daj si načas a radšej sa prikloň k extrémnej opatrnosti."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Prejdi ďaleko za parkovacie miesto, aby si mal dostatok miesta na manipuláciu, keď začneš cúvať."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Zastav, skontroluj svoje okolie a potom začni cúvať."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Zaboč s ťahačom preč od miesta. Týmto otočíš prednú časť návesu a jeho zadná časť sa nasmeruje k parkovaciemu miestu, na ktoré chceš ísť. Dávaj pozor nech to nepreženieš, inak riskuješ „zalomenie“ súpravy."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Pri vchádzaní návesu na parkovacie miesto začni vyrovnávať ťahač."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Zastav na určenom mieste a zabezpeč ťahač."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Cúvanie na stranu s obmedzeným výhľadom si vyžaduje rovnaké postupy ako cúvanie na opačnú stranu, ale budeš znevýhodnený nedostatkom viditeľnosti. Použi svoje zrkadlá a svoj najlepší úsudok, aby si zaparkoval ťahač.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Pred tebou je parkovacie miesto na strane spolujazdca. Budeš musieť zájsť ďaleko za neho, aby si mal dostatok priestoru na manévrovanie pri cúvaní.<br><br><font face=/font/big_bold.font>Pokračuj vpred. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Pamätaj, že otočením ťahača preč od miesta otočíš náves smerom k nemu. Použi zrkadlá podľa tvojich najlepších schopností, aby si sa dostal na parkovacie miesto.<br><br><font face=/font/big_bold.font>Začni cúvať. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Jazda po kruhovom objazde"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "V tomto scenári sa pozrieme na to, ako zvládnuť prejazd kruhovým objazdom.<br><br>Budeš musieť venovať osobitnú pozornosť tvojmu návesu, pretože sa bude pohybovať inak pri vchádzaní, prechádzaní a opúšťaní kruhového objazdu."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Vjazd na kruhový objazd"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Jazda po kruhovom objazde"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Jazda po kruhovom objazde"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Výjazd z kruhového objazdu"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Jazda do určenej oblasti"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Kruhové objazdy sú na európskych cestách veľmi bežné, preto je dôležité vedieť, ako ich zvládnuť."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Ako sa budeš približovať ku kruhovému objazdu, drž sa na vonkajšej strane svojho jazdného pruhu. To pomôže tvojmu návesu vyhnúť sa vnútru počiatočnej zákruty."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Prejdi smerom k stredu kruhového objazdu, keď do neho vchádzaš. Až budeš vo vnútri, budeš musieť smerovať k vonkajšej strane. Je to potrebné preto, aby tvoj náves nebol príliš blízko stredu kruhového objazdu."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Sleduj svoje zrkadlo a uisti sa, že náves nie je príliš blízko vnútorných prekážok."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Opustenie kruhového objazdu je pomerne jednoduché, pretože tvoj náves je už umiestnený ďalej od vnútornej strany výjazdu. Širokým zatočením pri výjazde by mal náves ťahač pekne nasledovať."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Zaparkuj na určenom mieste a zabezpeč ťahač."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Pred tebou je kruhový objazd, pripravený na prejazd. <br><br><font face=/font/big_bold.font>Pomaly sa priblíž ku kruhovému objazdu. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Pri vjazde na kruhový objazd si naširoko nadbehni, aby tvoj náves vošiel bez problémov za tebou. <br><br><font face=/font/big_bold.font>Vojdi do kruhového objazdu. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Prejdi ku vonkajšej strane kruhového objazdu. Budeš musieť držať ťahač čo najďalej od stredu kruhového objazdu, aby si udržal náves ďalej od vnútorných prekážok. <br><br><font face=/font/big_bold.font>Pokračuj cez kruhový objazd.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Ostaň blízko vonkajším kužeľom. <br><br><font face=/font/big_bold.font>Pokračuj v jazde.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Opusti kruhový objazd.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovacie miesto pred tebou.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Zastav v určenej oblasti.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Zabezpeč ťahač a vypni motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manévrovanie v tesnom priestore"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Pre záverečný scenár bude tvojou úlohou otočiť ťahač v stiesnenom priestore. Bude to vyžadovať cúvanie na stranu s obmedzeným výhľadom a navyše v oblasti s nedostatkom priestoru na manévrovanie, čo si vyžiada sústredenie na tvoje okolie a rozumné využitie priestoru."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Vjazd na trať"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Príprava zvládnutia strany s obmedzeným výhľadom"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Cúvanie na miesto"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Dokončenie parkovania zo strany s obmedzeným výhľadom"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Opustenie trate"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "V tomto scenári si prejdeme, ako sa otočiť v stiesnenom priestore pomocou cúvacieho manévra na stranu s obmedzeným výhľadom. Táto zručnosť ti príde vhod, keď sa nemôžeš otočiť alebo cúvať na stranu vodiča."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Cestné značenie ti pomôže sa navigovať cez tréningovú trať."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Nadbehni si zoširoka, aby si zabezpečil, že tvoj náves obíde zaparkované ťahače."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Pri opúštaní zákruty zváž, ako nastavíš ťahač na cúvací manéver."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Bude užitočné, ak budeš mať ťahač nasmerovaný pod uhlom k prázdnemu parkovaciemu miestu na strane spolujazdca, kam budeš cúvať."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Cúvaniu na stranu s obmedzeným výhľadom by si mal vyhnúť kvôli zlej viditeľnosti, ak je to možné. Bohužiaľ, niekedy nebudeš mať na výber a budeš ho musieť použiť."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Otoč volant ešte pred cúvaním. To pomôže okamžite nasmerovať náves kam potrebuješ, čo je užitočné vo veľmi stiesnených situáciách."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Až bude náves správne umiestnený, dostaň ťahač pred náves a vyrovnaj ho."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Zastav, keď budeš vyrovnaný s dostatkom miesta na opätovný pohyb dopredu. Začni smerovať späť rovnakou cestou, akou si prišiel."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Sleduj cestné značenie von z tréningovej trate."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Prejdi cez nadchádzajúcu zákrutu a pokračuj do vyznačenej oblasti."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Zastavenie."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Zabezpeč ťahač a vypni motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Pred tebou je tréningová trať reprezentujúca priestory prepravnej spoločnosti. Tvojou úlohou je vojsť dnu a otočiť ťahač, aby si mohol následne vyjsť von. Nezabudni dobre využiť priestor okolo seba.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Pokračuj smerom ku tréningovej trati. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Prejdi zákrutou a pokračuj po trati. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Sleduj cestné značenie k prekážke na konci trate. Zaparkuj pod miernym uhlom, aby tvoj náves smeroval k prázdnemu parkovaciemu miestu na strane spolujazdca.<br><br><font face=/font/big_bold.font>Pokračuj dopredu. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Keď cúvaš na stranu s obmedzeným výhľadom, máš oveľa horší výhľad na to, čo sa deje okolo teba. Jazdi pomaly, používaj zrkadlá a dbaj na zvýšenú opatrnosť.<br><br><font face=/font/big_bold.font>Začni cúvať a zatoč náves do prázdneho parkovacieho miesta. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "To je dostatočne ďaleko. Teraz môžeš pokračovať dopredu a opustiť tréningový priestor rovnakým smerom, z ktorého si prišiel.<br><br><font face=/font/big_bold.font>Začni smerovať k východu. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Opusti tréningovú trať.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Sleduj cestné značenie k poslednému parkovaciemu miestu.<br><br><font face=/font/big_bold.font>Pokračuj do vyznačenej oblasti. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manéver cúvania s posunom"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "V tomto scenári budeš mať za úlohu zacúvať na parkovacie miesto, ktoré nie je priamo za tebou. Možnosti pre manévrovanie sú obmedzené, takže budeš musieť rozumne využívať dostupný priestor."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "V tomto scenári bude tvojou úlohou zaparkovať na mieste vedľa teba. Nie je tu veľa priestoru na manévrovanie, takže budeš musieť urobiť trochu viac práce, aby si dostal náves kam potrebuješ."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Prejdi rovno dopredu k prekážke."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Zastav pred prekážkou."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Pred pohybom prudko otoč volant na stranu vodiča. Týmto spôsobom začneš otáčať náves smerom k parkovaciemu miestu, hneď ako začneš cúvať, čím ušetríš cenný priestor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Až budeš mať náves nasmerovaný kam potrebuješ, dostaň ťahač pred náves a začni ho taktiež smerovať na parkovacie miesto."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Od tohoto bodu to už nebude príliš odlišné od bežného parkovacieho manévru."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Pokračuj v cúvaní a sleduj obe strany. Drž ťahač a náves zarovnaný s parkovacím miestom."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zastav na určenom mieste, zabezpeč ťahač a vypni motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Si na parkovacom mieste, ale musíš sa presunúť na druhé parkovacie miesto vpravo.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Pred tebou je vyznačená oblasť.<br><br><font face=/font/big_bold.font>Pohni sa dopredu. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Pamätaj, že musíš začať okamžite zatáčať, pretože nemáš veľa miesta.<br><br><font face=/font/big_bold.font>Cúvaj na označené miesto za tebou. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Jazda cez jednoduché zákruty"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "V tomto scenári sa vydáš na krátku jazdu cez tréningovú trať, ktorá ti pomôže naučiť sa manévrovať s návesom okolo jednoduchých pravouhlých zákrut."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Prejazd prvou zákrutou"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Druhá zákruta"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Posledná zákruta"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Pred tebou je zopár ostrých zákrut s malým priestorom na manévrovanie. Pomôžu ti naučiť sa efektívne manévrovať s návesom."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Sleduj cestné značenie smerom k bariére na strane vodiča, aby si sa pripravil na prvú zákrutu."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Drž sa blízko vonkajšej bariéry cez zákrutu a náves by ťa mal pekne nasledovať."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Sleduj cestné značenie, aby si sa pripravil na druhú zákrutu – úzku pravouhlú."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Budeš si musieť nadbehnúť hlboko do rohu, aby si zabezpečil, že tvoj náves obíde vnútorné bariéry. Použi svoje predné zrkadlo ako pomocníka, aby si vedel ako ďaleko môžeš zájsť bez toho, aby si do niečoho narazil."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Pokračuj pozdĺž vonkajšej bariéry."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Znova budeš musieť pri ďalšej úzkej pravouhlej zákrute vhodne využiť všetok dostupný priestor."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Zastav na určenom mieste a zabezpeč ťahač."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Pamätaj si, že musíš využiť celý dostupný priestor, aby si ti podarilo prejsť každou zákrutou.<br><br><font face=/font/big_bold.font>Vyraz a sleduj cestné značenie k vonkajšej strane. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Nasleduj vonkajšiu bariéru, ale maj pri tom v zrkadle na očiach svoj náves.<br><br><font face=/font/big_bold.font>Prejdi prvou zákrutou. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Sleduj cestné značenie a priprav sa na pravouhlú zákrutu pred tebou.<br><br><font face=/font/big_bold.font>Prejdi pravouhlou zákrutou. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Po zákrute drž ťahač naširoko, pretože pred tebou je ďalšia ešte užšia pravouhla zákruta.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovacie miesto pred tebou. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Diagonálne parkovanie pri cúvaní"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "V tomto scenári preskúmame parkovanie diagonálne pri cúvaní. K tomu môže prísť na parkoviskách, odpočívadlách a dokonca aj u prepravcov. Často je tam málo miesta, pretože parkoviská sú preplnené nákladnými vozidlami, takže parkovanie je o to náročnejšie kvôli nedostatku priestoru."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Otáčanie návesu"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonálne parkovanie vyzerá na prvý pohľad jednoduchšie, ale často môže byť náročnejšie ako typické „cúvanie v uličke“."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Cúvaj smerom k parkovaciemu miestu. Zatiaľ drž ťahač a náves rovno."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Keď sa priblížiš, nechaj náves priblížiť sa k zaparkovaným ťahačom. To ti pomôže otočiť ho na miesto, keď k nemu dorazíš."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Začni otáčať náves na parkovacie miesto. Drž náves blízko ťahača na strane vodiča, pretože budeš potrebovať priestor na druhej strane."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Až bude náves dobre umiestnený na parkovacom mieste, začni zatáčať s ťahačom, aby nasledoval náves."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Zaparkuj na určenom mieste, zabezpeč ťahač a vypni motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Zaparkuj ťahač do priestoru za tebou. Používaj obe zrkadlá na navigáciu pri cúvaní.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Skontroluj svoje okolie a potom sa nasmeruj k parkovaciemu miestu.<br><br><font face=/font/big_bold.font>Začni s cúvaním.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Začni presúvať náves smerom k ťahačom vedľa teba. Keď budeš pripravený, zatoč náves na parkovacie miesto. Pamätaj na vybočenie zadnej časti návesu.<br><br><font face=/font/big_bold.font>Zatoč na parkovacie miesto. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Cúvanie do zákruty"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "V tomto scenári budeme prvýkrát cúvať s návesom do zákruty. Preskúmame základné princípy cúvania a na čo si treba dávať pozor pri cúvaní do zákrut."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Otáčanie návesu"
