	key[]: "skip_wizard"
	val[]: "Preskočiť sprievodcu"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Sprievodca ovládaním"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Chceš zrušiť sprievodcu ovládaním?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "VYBER SPÔSOB OVLADANIA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Ovládače"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Tento sprievodca aplikuje doporučené nastavenia na základe práve pripojených zariadení.<br><color value=@@clr_sel@@>Ak používaš ovládač kompatibilný so službou Steam, doporučujeme zapnúť podporu konfigurácie v <br><color value=@@clr_txt_d@@> \"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Jazdenie pomocou klávesnice a rozhliadanie sa okolo s myškou. Najjednoduchší, no najmenej presný spôsob ovládania dostupný všetkým."

	key[]: "wiz_control_mouse"
	val[]: "Použi myš pre citlivejšie ovládanie ťahača. Ostatné akcie sa stále ovládajú klávesnicou. Myšou sa môžeš rozhliadať len keď podržíš špeciálnu klávesu alebo tlačidlo."

	key[]: "wiz_control_controller"
	val[]: "Použi volant, gamepad alebo joystick pre najrealistickejší herný zážitok. Klávesové skratky môžu byť stále použité pre niektoré akcie, rozhliadať sa okolo môžeš myškou."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nebol nájdený žiadny herný ovládač. Aby si umožnil túto možnosť tak nejaký pripoj."

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Detekcia dostupných ovládačov..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "VYBER API OVLÁDAČA" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Herný mapovací mód Steam Input (odporúčané)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Steam Client mapovací mód"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klasický ovládač"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Ovládače ako @@controller_ps5@@, @@controller_xbox_one@@ alebo @@controller_steam_deck@@ začali podporovať rozhranie Steam Input a používajú jednoduché rozloženie.<br><br>Podporujú úplnú konfiguráciu priradenia klávesov v hre."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Ovladáče, ktoré podporujú rozhranie Steam Input a používané vlastné rozloženie nakonfigurované cez Steam Client.<br><br>Obmedzená podpora nápovedy tlačidiel v hre a žiadne konfigurácie priradenia klávesov v hre."

	key[]: "wiz_api_classical"
	val[]: "Gamepad, volant alebo joystick využívajú DirectInput, XInput alebo podobné rozhranie."
#@}

#@}

#+ Controller type selection page
#@{

