	key[]: "package_name"
	val[]: "Názov balíka " #+ Label of field used to show the name of the mod package (i.e. the name of the zip file of folder containing the mod)

	key[]: "view_workshop_page"
	val[]: "Pozrieť modifikáciu na Steam Workshop" #+ Button that allows user to open webbrowser with Steam workshop items page.

