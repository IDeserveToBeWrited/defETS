#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "VYBER TYP PREVODOVKY" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Táto možnosť vyžaduje volant, gamepad alebo joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nebol nájdený žiadny hardware riadiacej páky; táto funkcia nemusí fungovať."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "VYBER ROZLOŽENIE RADIACEJ PÁKY"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Prevodovky s rozsahom sú najľahšou voľbou. Majú dve sady stupňov. Prvá sada obsahuje rýchlosti od 1 do 6 a druhá sada rýchlosti od 7 do 12. Prepínacie tlačidlo prepína medzi týmito dvoma sadami, zatiaľ čo radiaca páka vyberá rýchlosť z danej sady."

	key[]: "wiz_hs_splitter"
	val[]: "Delená prevodovka je jednoduchou alternatívou. Má dve zostavy rýchlostí. Prvá zostava obsahuje stupne s nepárnymi číslami (1, 3, 5...) a druhá zostava stupne s párnymi číslami (2, 4, 6...). Prepínacie tlačidlo prepína medzi týmito dvoma zostavami, zatiaľ čo riadiaca páka vyberá rýchlosť z danej sady."

	key[]: "wiz_hs_range_splitter"
	val[]: "Prevodovka s deleným rozsahom je založená na rozložení skutočného radenie ťahačov do H.Prevodové stupne sú rozdelené do skupín po štyroch pre každú pozíciu radenia do H s použitím dvoch prepínačov.Preto sa táto možnosť doporučuje len skúsenejším vodičom."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Hra je nakonfigurovaná základným nastavením opísaním nižšie. Môžeš to zmeniť použitím pokročilých nastavení alebo pokračovať priamo do hry."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Pokročilé nastavenia"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "The game is now configured and you can continue. You can change the configuration later in Options."

	key[]: "wiz_cfg_steam"
	val[]: "Pre tento ovládač môžeš skontrolovať a nakonfigurovať mapovanie tlačidiel a osí pomocou klienta služby Steam. Nastavenie ovládača pre hru cez službu Steam je k dispozícii v Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Otvoriť nastavenia ovládača"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Použi klávesy @@imm_wiz_dsteerleft@@ a @@imm_wiz_dsteerright@@ pre zatáčanie."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Pohybom myši doľava či doprava otáčaš volantom v odpovedajúcom smere."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Použi @@ima_wiz_j_steer@@ pre zatáčanie."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Pomocou @@imm_wiz_dforward@@ ideš vpred a pomocou @@imm_wiz_dbackward@@ cúvaš."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Pohni ovládač @@ima_wiz_j_throttle@@ dopredu pre jazdu dopredu a dozadu pre cúvanie."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Pomocou @@ima_wiz_j_throttle@@ ideš vpred a pomocou @@ima_wiz_j_brake@@ cúvaš."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Použi @@imm_wiz_dforward@@ pre akceleráciu a použi @@imm_wiz_dbackward@@ pre zabrzdenie."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Pohni @@ima_wiz_j_throttle@@ dopredu pre akceleráciu a dozadu pre zabrzdenie."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Použi @@ima_wiz_j_throttle@@ pre akceleráciu a použi @@ima_wiz_j_brake@@ pre zabrzdenie."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Použite @@imv_wiz_gearup@@ na zaradenie vyššej rýchlosti a @@imv_wiz_geardown@@ na zaradenie nižšej rýchlosti."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Použite @@imv_wiz_gearup@@ na zaradenie vyššej rýchlosti a @@imv_wiz_geardown@@ na zaradenie nižšej rýchlosti, ak používate klávesnicu alebo tlačidlá ovládača. Použite @@imv_wiz_drive@@ a @@imv_wiz_reverse@@ na vybranie smeru jazdy, ak ty používaš H-radenie."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Použi @@imv_wiz_gearup@@ a @@imv_wiz_geardown@@ pre výber prevodového stupňa."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Použi svoju riadiacu páku spolu s @@ima_wiz_j_clutch@@ pre výber prevodového stupňa."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "NASTAVENIE OSI OVLÁDAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Vizualizácia osi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Môžeš skúsiť funkciu všetkých zvolených ôs vizuálne. Použi ovládač a sleduj pohybujúce sa ukazatele. Ukážu ti limity, centrovania, orientáciu a celkové chovanie každej použitej osi."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Nastavenie osi"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Pre zvolenie osi, klikni na tlačidlo vedľa názvu osi. Tým sa prepneš do režimu ovládania. Potom použitím svojho ovládača priraď vybranú os pohybom páčky, volantu alebo pedalu."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Mŕtve zóny"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Mŕtva zóna je oblasť na osi zámerne navrhnutá tak, aby neposkytovala žiadny vstup. Pre upravenie mŕtvej zóny vybranej osi posuň odpovedajúci posuvník. Posunutím doprava sa mŕtva zóna zväčší. Táto funkcia je obzvlášť užitočná pre staršie ovládače, pretože nastavenie väčšej mŕtvej zóny môže zmierniť nepresnosti alebo chybné vstupy spôsobené opotrebovaním hardvéru."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Režim osi"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Režim osi určuje, ako sa s danou osou pracuje v hre. Prehodená osa obrátí svoj vykazovaný smer, napr. pri zatočení doprava sa zatočí doľava. Centrovaná os má svoju východziu pozíciu v strede svojho rozsahu (napr. joystick). Toto nastavenie by sa malo použiť len vtedy, keď se daná os zle detekuje."

	key[]: "normal"
	val[]: "Normálne" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Obrátené" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Vycentrovaný" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Obrátené a vycentrované" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "NASTAVENIE AUTOMATICKEJ PREVODOVKY" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "S automatickou prevodovkou budeš radiť iba medzi jazdou dopredu, neutrálom a cúvaním. Môžeš to robiť používaním priradených kláves resp. tlačidlo ovládača. Pre zmenu nastavení, klikni na tlačidlo a stlač klávesu alebo tlačidlo ovládača, ktoré chceš k tejto akcii priradiť."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ak máš pripojenú hardvérovú radiacu páku, môžeš s ňou simulovať skutočné automatické radenie. Povoľ túto možnosť a môžeš nastaviť pozície páky pre jazdu vpred a cúvanie. Všetky ostatné pozície radiacej páky sú považované za neutrál. Toto nastavenie je vytvorené špeciálne pre radiacu páku, takže nebude fungovať s bežnými klávesmi ani tlačidlami na ovládači. Ak chceš čokoľvek z tohto zmeniť, klikni na tlačidlo a potom pohni pákou na požadovanú pozíciu a potom späť do pozície neutrálu."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "NASTAVENIE SEKVENČNEJ PREVODOVKY" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvenčná prevodovka preraďuje medzi všetkými rýchlostnými stupňami, neutrálom a aj spiatočkou. Tu sú klávesy a tlačidlo na ovládanie prevodu hore a dole. Pre zmenu priradenia klávesy alebo tlačidlo klikni na ikonku a stlač klávesu alebo tlačidlo ktoré chceš k tejto akcii priradiť."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "NASTAVENIE RIADIACICH PÁK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Tu si môžeš vybrať hlavné rozloženie radenie riadiacej páky a vyskúšať jej funkcie. Na obrázku môžeš vidieť aktuálnu polohu páky a tiež akú máš práve zaradenú rýchlosť. Vzhľadom k tomu, že prevodovka obsahuje viac rýchlostných stupňov, než má riadiaca páka, musíš použiť prepínacie tlačidlo pre prepínanie medzi rôznymi zostavami rýchlostných stupňov."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Pozícia radiacej páky aj aktívne prepínače sú vidieť dole pri názve príslušnej funkcie. Ak chceš zmeniť priradenie niektorej z funkcií, klikni na príslušné tlačidlo, potom presuň radiacu páku do požadovanej pozície a potom späť na neutrál."
#@}

