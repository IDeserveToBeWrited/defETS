#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Výber motívov, ktoré sú zobrazené na pozadí pri prechádzaní menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Povolí náhodný výber motívu pozadia pri každom spustení hry."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Nastaví oneskorenie, na základe ktorého dôjde k utlmeniu elementov na ploche."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení budeš pocitovať efekt únavy po určitom čase.<br><br>Vyhýbanie sa pauze na oddych vyustí v dopravný priestupok."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení, musíš dodržiavať pravidlá cestnej premávky inak riskuješ dopravný priestupok. Riziko je zvýšené pri policajných vozidlách, radaroch a dopravných kamerách."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje priemernú dĺžku zákaziek, ktoré sú ponúkané."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Vyber rýchlostný limitu, ktorý sa ma zobraziť vo widgete navigácie."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktuálna rýchlosť zobrazená v navigácii sa zafarbí na červeno pri prekročení rýchlostného limitu."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Po príjazde do destinácie sa zobrazí widget umožnujúci preskočiť parkovanie."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Skryť všetky widgety."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Obidve zrkadlá na obrazovke zostanú skryté."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Všetky notifikácie zostanú skryté aj pri ich prijatí."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Zobrazí okno so schopnosťami aktuálneho ťahača pred akceptovaním zákazky s ťažkých nákladom."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Vyber, ako bude svetová mapa zarovnaná."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Choose how the World Map is explored:<br>- \"Proximity exploration\" marks a larger area as explored.<br>- \"Precision exploration\" reveals only the areas immediately around the player."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Vyber ako bude zobrazená navigácia"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Mení spôsob, akým je navigácia usmernená.<br>- Režim navigácie \"Najlepšia\" vyberá najefektívnejší pomer medzi dĺžkou a časom trasy, snaží sa vyhnúť svetelným križovatkám a podobne.<br>- Režim navigácie \"Najkratšia\" vždy vyberá najkratšiu možnú trasu.<br>- Režim navigácie \"Okresné cesty\" sa snaží vyhnúť diaľniciam, kde je to možné."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmení obtiažnosť parkovania:<br>- „Vždy vybrať“ umožňuje vybrať obtiažnosť vždy, keď dorazíš do cieľa.<br>- „Bezpečné parkovanie“ nevyžaduje cúvanie.<br>- „Skúsené parkovanie“ väčšinou vyžaduje náročnejšie manévrovanie."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje pravdepodobnosť výskytu nebezpečenstva na ceste v tvojom okolí, zahrňuje nehody, pokazené vozidlá, trosky atď."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje pravdepodobnosť výskytu dočasnej obchádzky počas prepravy."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje pravdepodobnosť výskytu nepriaznivého počasia."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber či sú informácie o časovej zóne zobrazené v rámci aktuálneho času."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Povolí herné cutscény zobrazované po kúpe ťahača, vylepšení garáže alebo počas nástupu cestujúcich."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber, či sa na cestách, na ktoré nie je možné vstúpiť, zobrazujú polopriesvitné blokátory."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Invertuje Y-ovu osu myši pri kontrole kamery v hre."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Zvolí typ prevodovky:<br>- „Jednoduchá automatika“ umožňuje použitie plynu a brzdy pre pohyb dopredu alebo dozadu.<br>- „Reálna automatická“ vyžaduje vstup na zmenu medzi pohybom dopredu alebo dozadu.<br>- „Sekvenčná“ vyžaduje manuálne radenie všetkých rýchlostí so vstupom na preradenie/podradenie.<br>- „Radiaca páka“ vyžaduje vstup ovládača s radením v tvare H na manuálne zvolenie rýchlosti."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Povolenie tejto funkcie dovolí \"preskočenie preradenia“ - prevodový stupeň bude preskočený, ak to bude nevyhnutné alebo praktické, aby sa predišlo radeniu cez každý jeden stupeň prevodovky."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Vráti volant do stredovej polohy pri použití klávesnice alebo kontroléra.<br><br>Pri vypnutí tejto funkcie budeš musieť manuálne otáčať volant naspäť do stredové pozície po odbočení."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje rozsah animácie otáčania kolies pri vybočení. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje intenzitu brzdenia."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje stabilitu návesu znížením jeho ťažiska."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje tuhosť odpruženia karosérie."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje tuhosť odpruženia kabíny/spiacej časti."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje intenzitu procedurálne generovaných nerovností povrchu, ktoré dodávajú cestám a iným povrchom pocit nedokonalosti.<br><br>V závislosti od nastavení odpruženia a kamery vnímaný efekt môže byť viac alebo menej výrazný."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Povolí pokročilé pripájanie návesu, ktoré vyžaduje väčšiu presnosť pri zarovnaní točnice ťahača s pripájacím čapom návesu.<br><br>Pri vypnutí bude pripojenie návesu o dosť jednoduchšie, keďže bude vypnutá kolízia medzi čapom a točnicou."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje či vôbec alebo ktoré káble návesu majú zahrňovať animácie.<br><br><color value=@@clr_txt_d@@>Zapnutie animácii na viacerých vozidlách môže ovplyvniť výkon na starších systémoch."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Povolí elektronický obmedzovač rýchlosti ťahača na 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>World of Trucks zákazky majú túto funkciu zapnutú vždy."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení a so stieračmi nastavenými v prvej polohe, stierače sa automaticky zapnú a prispôsobia svoju rýchlosť podľa podmienok."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Povolí automatické zapojenie retardéra pri brzdení."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení, vozidlo pomáha s rozjazdom do kopca tým, že podrží brzdy, čím zabezpečí plynulý štart."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Povolí automatické zapojenie motorovej brzdy pri brzdení."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení motor naštartuje automaticky pri stlačení plynového pedála."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Automaticky spustí zdvíhateľné nápravy, ak je to potrebné v závislosti od hmotnosti vozidla."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení, vozidlo v predvolenom stave udržiava nižší plyn. Po rýchlom dvojitom stlačení tlačidla plynu bude vozidlo držať plný plyn, kým tlačidlo plynu neuvoľníš.<br><br>Ovplyvňuje iba ovládanie klávesnicou."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simuluje skutočnú stratu vzduchu pri nadmernom používaní brzdy.<br><br>Pri povolení budeš musieť riadiť tlak vzduchu pri zostupoch z kopcov alebo pri pomalých manévroch s opakovaným použitím brzdy."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Keď je táto možnosť vypnutá, spotreba paliva nie je ovplyvnená štýlom jazdy ani podmienkami na ceste.<br><br>Pri povolení, spotrebu paliva ovplyvňuje niekoľko faktorov vrátane štýlu jazdy, hmotnosti nákladu, valivého odporu a profilu terénu. Spotreba už nie je ovplyvnená schopnosťou @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení ABS zabráni zablokovaniu kolies, aby sa udržala kontrola a zlepšila brzdná schopnosť."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje o koľko sa zmení rýchlosť tempomatu, ak je stlačený príslušný kláves na jej zvýšenie alebo zníženie."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje toleranciu tempomatu pri udržiavaní nastavenej rýchlosti."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení bude tempomat automaticky prispôsobovať rýchlosť, aby udržiaval bezpečnú vzdialenosť od vozidla vpredu."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktivuje núdzové brzdenie, ak systém zaznamená blížiacu sa kolíziu.<br>Vyber, či systém bude reagovať len na vozidlá alebo na všetky prekážky."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Povolí funkcie senzora mŕtveho uhla, ak je ním tvoje vozidlo vybavené."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení a so svetlami nastavenými v prvej polohe, svetlá sa automaticky zapnú v slabom svetle."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení a so zapnutými diaľkovými svetlami, vozidlo automaticky stlmí intenzitu diaľkových svetiel, keď zaznamená prichádzajúce vozidlo alebo vozidlo tesne pred ním."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení smerovky sa automaticky vypnú po zabočení a otočení volantu naspäť do stredovej polohy."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení niektoré interiérové doplnky reagujú na fyzický pohyb vozidla (visiace ozdoby, poskakovanie hláv a pod.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Povolí vychýlenie interiérovej kamery na základe posledných vstupov riadenia."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje, ako bude funkcia „otáčania kamery pri zátačaní“ citlivá na vstup riadenia."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Mení správanie funkcie \"otáčania kamery pri zátačaní\" počas cúvania."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení sa interiérová kamera bude otáčať doľava alebo doprava na základe použitej smerovky."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Pri povolení interiérová kamera reaguje na pohyb vozidla."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje, ako je interiérová kamera citlivá na pohyb vozidla."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje do akej miery sa bude interiérová kamera otáčať na základe pohybu vozidla."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastaví oneskorenie pred automatickým centrovaním kamery.<br><br>Vozidlo musí byť v pohybe pri nezanedbateľnej rýchlosti, aby sa táto funkcia aktivovala. Platí iba pre vnútornú a vonkajšiu kameru pri jazde dopredu a pre kameru s výhľadom z kabíny pri cúvaní."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastaví rýchlosť pohybu kamery. Používa sa pri automatickom centrovaní kamery a pri prepínaní medzi predvolenými možnosťami interiérovej kamery."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Určuje spôsob priblíženia: podrž tlačidlo pre dočasné priblíženie alebo ho stlač raz pre prepnutie." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Vyberie jazyk, v ktorom bude hra zobrazená."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje predvolenú menu a jednotky na základe zvoleného regiónu."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení mestá a krajiny budu lokalizované v tvojom jazyku."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení mestá a krajiny budu lokalizované v tvojom jazyku, ako aj v jazyku natívnom pre daný región na mape."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber, ktorá mena má byť používaná."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber medzi 12 alebo 24 hodinovým formátom času."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber aké jednotky vzdialenosti budú zobrazené."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber aké jednotky hmotnosti budú zobrazené."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber aké jednotky teploty budú zobrazené."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber aké jednotky tlaku budú zobrazené."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber aké jednotky objemu budú zobrazené."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber aké jednotky spotreby budú zobrazené."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení použitie klávesy \"Aktivovať\" (@@imv_nrm_activate@@) otvorí chat počas konvojových relácií."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení lišta pre vstup do chatu po odoslaní správy zostane aktívna."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení správy v chate vyblednú po niekoľkých sekundách."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje, ako dlho budú správy v chate zobrazené predtým, ako pozvoľna zmiznú."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Pri povolení mená hráčov budú zobrazené nad ich vozidlami počas konvojovej relácie."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Otvorí pokročilé menu pre konfiguráciu rýchlych odpovedí pre chatovanie v konvojových reláciách."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Skontroluj stav svojho prepojeného obsahu s World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Povolí sťahovanie online noviniek, ktoré sa zobrazia na štartovnom paneli."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Povolí sťahovanie komunitných snímok vybraných zo stránky World of Trucks, ktoré sú zobrazené počas načítania hry."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Povolí sťahovanie reálnych reklám, ktoré sú zobrazené na vybraných bilbordoch v hre."
