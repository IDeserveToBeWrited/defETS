	key[]: "no_drive_t"
	val[]: "NO VEHICLE" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "Nie je možné, aby ste sa voľne vybrali do sveta, pretože nemáte žiadne vozidlo na riadenie! Môžete si ho kúpiť alebo vybrať niektorý z Vášho vozového parku.<br><br>Chcete nejakú rýchlu prácu?"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "NAČÍTAŤ HRU"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Načítať hru" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Načítať predošlú uloženú hru. Súčasný pokrok bude stratený!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Si si istý, že chceš načítať túto hru?<br><br>Ak si si aktuálny postup neuložil, prídeš oň."

	key[]: "load_progress_lost_mp"
	val[]: "Naozaj chceš načítať inú uloženú hru?<br>Ak tak učiníš počas hry pre viacej hráčov, môže to znamenať zrušenie zákazky, presunutie k najbližšiemu servisu alebo nedostupnosť vybranej zákazky.<br><br>Tvoj aktuálny postup bude stratený, ak nebol uložený predtým."

	key[]: "load_game_mp_suspended_job"
	val[]: "Uložená pozícia bola úspešne načítaná, ale tvoja zákazka pre World of Trucks bola pozastavená a počas tejto relácie nie je dostupná."

	key[]: "autosave"
	val[]: "-Automatické uloženie-" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Rýchle uloženie -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Ukázať automatické uloženia " #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Nenašli sa manuálne uložené pozície." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Načítať" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Nekompatibilná uložená pozícia!<br><color value=@@clr_txt@@>Skúste aktualizovať hru na najnovšiu dostupnú verziu." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nepodarilo sa načítať a zobraziť všetky uložené pozície pre tento profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "UPOZORNENIE" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problém s načítaním uloženej pozície.<color value=@@clr_txt@@><br><br>Nepodarilo sa načítať uloženú pozíciu. Pomocou informácií nižšie môžete skúsiť problém zistiť a prípadne opraviť. Rovnako tak môžete načítať inú uloženú pozíciu.<br><br>Nasledujúce dôvody môžu byť často príčinou problému:<br><br>1. Uložená pozícia je nekompatibilná s niektorými z nainštalovaných modifikácií.<br><br>2. Uložená pozícia obsahuje informácie z modifikácií, ktoré sú zakázané alebo chýbajú.<br><br>3. Uložená pozícia bola poškodená použitím zle vytvorenej modifikácie.<br><br>4. Poškodenie uloženej pozície môže tiež spôsobiť zlyhanie počítača počas alebo krátko po procese ukladania."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Bol zistený chýbajúci MÓD.<color value=@@clr_txt@@><br><br>Posledné uloženie obsahuje situáciu, pre ktorú chýba alebo je vypnutý nejaký MÓD alebo MÓDY.<br><br>Ak ste toto nečakali, prosím skontrolujte stav vašich MÓDOV.<br><br>Ale tiež sa môžete pokúsiť načítať uloženú hru aj tak. Ale vtedy, podľa toho ktorý MÓD to spôsobuje, je možné že nebude možné to načítať alebo sa objavia iné problémy.<br><br>Poprípade môžete skúsiť načítať inú uloženú hru, v ktorej nebude problém s chýbajúcimi MÓDmi."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Zistené chýbajúce DLC.<color value=@@clr_txt@@><br><br>Posledná uložená pozícia obsahuje chýbajúce DLC (oficiálne rozšírenie hry).<br><br>Pokiaľ sa jedná o nečakanú udalosť, prosím skontrolujte stav jednotlivých DLC.<br><br>V opačnom prípade môžeš uloženú pozíciu nechať načítať, ale niektoré funkcie obsiahnuté v DLC budú stratené.<br><br>Prípadne skúste načítať inú uloženú pozíciu, ktorá neobsahuje chýbajúce DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Bolo zistené chýbajúce DLC.<color value=@@clr_txt@@><br><br>Posledná uložená hra vyžaduje DLC (oficiálne rozšírenie hry).<br><br>Ak chcete aby táto uložená hra fungovala tak ako má, DLC musí byť aktivované na tomto počítači.<br><br>Poprípade môžte načítať inú uloženú hru, ktorá DLC nevyžaduje."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MÓD závisí od DLC obsahu.<color value=@@clr_txt@@><br><br>Aspoň jeden MÓD je závislý na DLC (oficiálna rozšírenie hry), ktorý nie je v súčasnej dobe nainštalovaný.<br><br>Musíte vypnúť MOD(y) alebo nainštalovať DLC(čka), ktoré sú na ňom/nich závislé."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Zistený pád hry.<color value=@@clr_txt@@><br><br>Zdá sa, že počas predchádzajúceho načítania spadla hra.<br><br>Pomocou informácií nižšie môžeš skúsiť problém zistiť a prípadne opraviť. Rovnako tak môžeš načítať inú uloženú pozíciu.<br><br>Nasledujúce dôvody môžu byť často príčinou problému:<br><br>1. Jedna alebo viac nainštalovaných modifikácií sú poškodené, alebo nekompatibilné s aktuálnou verziou hry.<br><br>2. Uložená pozícia obsahuje informácie z modifikácií, ktoré sú zakázané alebo chýbajú.<br><br>3. Uložená pozícia bola poškodená použitím zle vytvorenej modifikácie.<br><br>4. V niektorých prípadoch môže pád hry spôsobiť tiež hardware alebo zlyhanie ovládačov."

	key[]: "mods_detected_warning"
	val[]: "Zistená prítomnosť módov. Upozorňujeme, že rozbité, zastarané alebo nekompatibilné módy môžu spôsobovať nestabilitu hry. Skontrolujte svoje aktívne módy v Správcovi modifikácii." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

#+ Game save window
