	key[]: "save_game_reset"
	val[]: "Hra spozorovala zmenu! Na zabránenie problémom s kompatibilitou kvôli zmenám v hernom svete boli nedokončené prepravy zrušené bez peňažného trestu." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Hra spozorovala zmenu!<br><br>Na zabránenie problémom s kompatibilitou kvôli zmenám v hernom svete boli nedokončené prepravy zrušené bez peňažného trestu. Vyžaduje sa preparkovanie ťahača na bezpečné miesto.<br><br>Pre pokračovanie, prosím, zvoľte si destináciu rýchleho cestovania." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Ukladám..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Stlač $KEY$ pre preskočenie cutscény." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
