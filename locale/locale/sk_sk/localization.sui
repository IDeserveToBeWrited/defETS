#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Sieť nie je dostupná. Skontrolujte prosím nastavenia klienta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Nepodarilo sa pripojiť k sieťovej službe. Prosím, skontrolujte, či vám funguje internetové pripojenie."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Chyba v komunikácii so sieťovou službou. Skúste neskôr, prosím."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Sieťová služba vrátila chybné dáta. Ak používaš HTTP proxy, skontroluj jeho nastavenie. V opačnom prípade skús neskôr."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Sieťová služba vrátila chybné dáta. Skúste neskôr, prosím."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Služba nie je zhodná s vašou verziou hry. Skontrolujte prosím, či nebola vydaná nová úprava hry."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Služba je momentálne nedostupná. Skúste neskôr, prosím."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Služba je momentálne zastavená kvôli údržbe alebo je preťažená. Skúste neskôr, prosím."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Autentifikácia bola neplatná. Skúste sa prihlásiť opäť, prosím."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Online účet je zamknutý z dôvodu: veľa chybných pokusov o prihlásenie sa. Prosím, skúste to znova o pol hodinu."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Online účet je zamknutý kvôli podozrivému prístupu. Skúste to prosím o 24 hodín."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Táto hra nie je registrovaná na online účet."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Tento účet zatiaľ nebol aktivovaný. Prosím, pozrite si svoju schránku či tam nemáte aktivačný e-mail."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Účet je pozastavený. Prosím, kontaktujte technickú poradňu."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Účet je zakázaný. Prosím, kontaktujte technickú poradňu. "

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Autentifikácia cez toto proxy nie je podporovaná. Prosím, použite iné proxy alebo priame spojenie."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Požadovaný objekt práve nie je dostupný. Prosím, skúste to znovu o pár minút."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Chyba SSL. Nepodarilo sa nadviazať zabezpečené pripojenie."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Hra bola počas online komunikácie pozastavená. Prosím, skús to opäť neskôr."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Vnútorná chyba. Viac informácií v súbore net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 má problém a nedokáže vykresliť grafiku na tvojom počítači (nebola nájdená žiadna platná grafická karta).\nNavrhované kroky:\n\n1. Skontroluj či tvoj počítač a grafická karta spĺňa minimálne systémové požiadavky hry.\n2. Aktualizuj na svojom počítači DirectX na najnovšiu verziu.\n3. Stiahni a nainštaluj si najnovšie ovládače na svoju grafickú kartu.\n4. Skús zmeniť renderovaciu metódu z OpenGL na DirectX alebo naopak.\n5. Vymaž súbor hernej konfigurácie 'config.cfg' v tvojej zložke 'Dokumenty/Euro Truck Simulator 2'. Možno je tento súbor porušený.\nTento súbor bude automaticky vygenerovaný nový pri nasledujúcom spustení hry."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 má problém a nie je schopný vykresliť grafiku na vašom počítači (nebolo nájdené žiadne platné grafické zariadenie)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "SPRIEVODCA OVLÁDANÍM" #+ Title of the screen. Please keep in upper case where possible.

