	val[]: "Použi režim fotenia alebo stlač tlačidlo @@imv_nrm_screenshot@@ pre vytvorenie snímky obrazovky. Tieto snímky obrazovky môžeš následne nahrať na portál World of Trucks. <br> Vyber obrázok, následne zvoľ slot a stlač tlačidlo <color value=@@clr_sel@@> Nahrať do vybraného slotu <color value=@@clr_txt@@>." #+ description

	key[]: "screenshotman_slot"
	val[]: "Sloty pre snímky v galérii na World of Trucks." #+ Slots title

	key[]: "screenshotman_empty"
	val[]: "Urob screenshot aby si ho tu videl." #+ Empty screenshot position

	key[]: "screenshotman_offline"
	val[]: "PROFIL NIEJE PRIPOJENÝ!<br><br>Pre nahratie obrázku musíš mať svoj profil prepojený s online účtom.<br><br>Želáš si svoj profil upraviť teraz?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Prázdny slot" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Chyba" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Uploadnúť na zvolený slot" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Použiť ako môj profilový ťahač" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Do you want to permanently delete the following screenshot?"

	key[]: "upload_screenshot"
	val[]: "Praješ si uploadudnúť screenshot do vybraného slotu?<br><br>Predchádzajúci obsah tohto slotu bude prepísaný!"

	key[]: "upload_profile_screenshot"
	val[]: "Chcete nahrať obrázok na slot svojho Word of Trucks profilového ťahača? <br><br> Predchádzajúci obrázok na profile bude nahradený!"

	key[]: "wotr_upload_title"
	val[]: "UPOZORNENIE PRED NAHRATÍM"

	key[]: "new_screenshot"
	val[]: "Nové snímky čakajú k nahraniu!" #+ New screenshot notification

	key[]: "uploading_screenshot"
	val[]: "Nahrávam snímky. Chvíľku strpenia." # + Message show while screenshot upload is in progress.

#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Súbor obrázku je príliš veľký. Skús prosím znížiť zobrazované rozlíšenie." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Súbor obrázku je poškodený, alebo nie je podporovaný." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Rozlíšenie obrazovky je príliš veľké. Prosím, skúste znížiť rozlíšenie obrazovky." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Služba znemožnila nahranie snímku obrazovky." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Na tento účet nemôžu byť nahrané snímky obrazovky." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Došlo k súčasnému nahraniu do rovnakého slotu." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Nahrávanie je momentálne zakázané. Skús to prosím neskôr." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "V priebehu nahrávania došlo k neznámej chybe. Skús to prosím neskôr." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Obrázok je väčší ako maximálna povolená veľkosť $LIMIT$ a bol zmenšený." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Súbor obrázku je väčší než maximálna povolená veľkosť $LIMIT$KB a bol zmenšený." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "Aktívne modifikácie  " #+ Mod selection title

	key[]: "missing_deps"
