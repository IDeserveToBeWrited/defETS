	key[]: "mod_multi_move_right_confirm"
	val[]: "Chcete skutočne zapnúť všetky modifikácie?<br><br>Všetky modifikácie, ktoré nie sú zapnuté sa pridajú na začiatok aktívnych modifikácii.<br><br><br>(Nekompatibilné modifikácie nebudú zapnuté)" #+ Confirmation message shown when user selects button to activate all mods.

	key[]: "no_mods_active"
	val[]: "Žiadne aktívne modifikácie na zobrazenie.<br><br>K zapnutiu modifikácii vyber z ľavého okna a klikni na tlačidlo šípky." #+ Text shown inside the active mods panel when no mod is currently active

	key[]: "mod_activated"
	val[]: "Aktívne " #+ State value indicating that the mod is selected as active one

