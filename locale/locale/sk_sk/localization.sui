	key[]: "trailerman_confirm_take"
	val[]: "Naozaj chceš použiť náves $TRAILER$?<br><br>Objaví sa v tvojej garáž v meste $CITY$."

	key[]: "trailerman_confirm_take_from_garage"
	val[]: "Naozaj chceš zobrať náves $TRAILER$?"
#@}

#+ Message box shown to confirm store of selected trailer.
#@{
	key[]: "trailerman_confirm_store"
	val[]: "Naozaj chceš umiestniť tento náves do garáže?" #+ Confirmation alert shown when user wants to store currently attached trailer to the garage.
#@}

#+ Message box shown to confirm swap of selected trailer with the currently attached owned trailer.
#@{
	key[]: "trailerman_confirm_swap"
	val[]: "Naozaj chceš vymeniť aktuálne pripojený náves s návesom $TRAILER$?"
#@}

#+ Message box shown when user requests to use a broken source trailer in copy configuration.
#@{
	key[]: "trailerman_copy_configuration_t"
	val[]: "SKOPÍROVAŤ KONFIGURÁCIU" #+ Message box title. Please keep in upper case where possible.

	key[]: "trailerman_msg_nouse"
	val[]: "Tento náves nie je možné použiť ako zdrojový náves pre skopírovanie konfigurácie kvôli chýbajúcim dátam, čo pravdepodobne spôsobilo odstránenie modifikácie alebo rozšírenia DLC.<br><br>Nainštalujte príslušné modifikácie/rozšírenia znova."
#@}

#+ Message box shown when user requests to use total restoration of trailer in trailer manager.
#@{
	key[]: "trailerman_total_restoration_t"
	val[]: "KOMPLETNÁ RENOVÁCIA"  #+ Message box title. Please keep in upper case where possible.

	key[]: "trailerman_total_restoration_service"
	val[]: "Zájdite prosím do servisu, kde si môžete renovovať náves, ktorý práve používate." #+ Message shown when player tries to restore trailer that he is using.

	key[]: "trailerman_total_restoration_no_need"
	val[]: "Vybraný náves je v perfektnom stave." #+ Message shown when player tries to restore trailer in perfect condition.

	key[]: "trailerman_total_restoration"
	val[]: "Cena kompletnej renovácie:<br><br><color value=@@clr_sel@@><font face=/font/big.font>$PRICE$</font><br><br><color value=@@clr_txt@@>Vyžiadaním kompletnej demontáže a renovácie všetkých opotrebovaných častí vrátiš svoje vozidlo do bezchybného stavu. Kompletná renovácia je náročnejšia ako konštrukcia úplne nového vozidla." #+ Content of the screen, explaining total restoration.
#@}

