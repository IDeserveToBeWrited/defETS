#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Pokračovať ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Vitajte v hre Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Konečne máš šancu robiť prácu svojich snov - byť vodič kamiónu!"

	key[]: "intro_3"
	val[]: "Tvoja dopravná spoločnosť je pripravená, no bohužiaľ nemáš dostatok peňazí na kúpenie vlastného ťahača. Zatiaľ budeš musieť jazdiť ako vodič pre iné spoločnosti."

	key[]: "intro_4"
	val[]: "Tvojou prvou úlohou je bezpečne doručiť $JOB_CARGO$ do firmy $JOB_TARGET_COMPANY$ v meste $JOB_TARGET_CITY$. Tvoj zamestnávateľ ti poskytol kamión a pokryl všetky náklady. Nesklam ho a príď do cieľa s nákladom včas."


	key[]: "intro_garage_1"
	val[]: "Toto je vaše sídlo."

	key[]: "intro_garage_2"
	val[]: "Je to veľmi jednoduchá garáž. Nie je to najlepšie, no na začiatok to stačí."

	key[]: "intro_garage_3"
	val[]: "Bohužiaľ ešte nemáš žiadny ťahač, ktorý by si sem mohol zaparkovať.\n"

	key[]: "intro_garage_4"
	val[]: "Keď budeš mať dostatok peňazí a kúpiš si vlastný ťahač, budeš sa môcť po svete voľne pohybovať a rozbehnúť tu svoju vlastnú spoločnosť."

	key[]: "intro_garage_5"
	val[]: "Veľa šťastia!"


	key[]: "desktop_tut_t"
	val[]: "FUNKCIA ODOMKNUTÁ"

	key[]: "desktop_tut_job"
	val[]: "Vyber si svoju ďalšiu zákazku"

	key[]: "desktop_tut_cargo_market"
	val[]: "Použi svoj nový značkový náves pre prístup na trh nákladov, prostredníctvom ktorého môžeš doručovať širokú škálu nákladov do ich destinácii." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Tu môžeš vidieť svoje informácie a pokrok."

	key[]: "desktop_tut_company"
	val[]: "Odtiaľto môžete spravovať svoje garáže, najímať nových vodičov a inak spravovať vašu firmu."

	key[]: "desktop_tut_trailers"
	val[]: "Odteraz môžeš nakupovať vlastné návesy, vylepšovať ich a nalakovať tak, aby ladili s tvojím ťahačom.<br><br>Svoje návesy môžeš umiestniť do svojich garáži, kde môžu byť používané tvojimi vodičmi pre navýšenie zisku. Pre spravovanie svojich návesov použi správcu návesov."

	key[]: "desktop_tut_visit_directive"
	val[]: "Navštív $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "VÍTAJ!"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Vítaj na novej domovskej stránke<br>Odtiaľto môžeš interagovať so všetkými funkciami v hre."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Nižšie uvedená hlavná ponuka poskytuje priamy prístup k všetkým základným herným funkciám, ktoré dobre poznáte."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Nový stavový riadok v hornej časti poskytuje neustály prehľad o užitočných štatistikách profilu hráča a miestnych dopravných predpisoch."

	key[]: "desktop_tut_tour_home"
	val[]: "Tlačidlo Domov je vždy dostupné pre návrat na tvoju domovskú stránku."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Stále dostupné Rýchle menu ponúka praktickú skratku k všetkým funkciám hry z ktorejkoľvek obrazovky."

	key[]: "desktop_tut_tour_drive"
	val[]: "Aktualizované tlačidlo Jazda zostáva tvojím spojením so svetom, pripravené vrátiť ťa späť na cestu."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL DOKONČENÝ"

	key[]: "desktop_tut_tour_finish"
	val[]: "Ďakujeme za prehliadku našej aktualizovanej domovskej stránky."
#@}


