#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banka" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Ak potrebuješ peniaze, skús si vypýtať pôžičku od banky." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "Ponuky pôžičiek" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "za $MONEY$ denne" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Počet aktívnych pôžičiek: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Môžeš si požičať: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "PREHĽAD AKTÍVNYCH PÔŽIČIEK"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Pôžička" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Zostáva splatiť" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Trvanie (v dňoch)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Úroková sadza (ročná)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Splátka" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Splatiť" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Celkovo:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Stav účtu: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NOVÁ PÔŽIČKA" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Žiadaš o pôžičku v sume $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Doba splácania:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Úroková sadza (ročná):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Denná splátka:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Praješ si potvrdiť svoju žiadosť?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "SPLATIŤ PÔŽIČKU" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Naozaj chceš použiť $MONEY$ na splatenie pôžičky?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


