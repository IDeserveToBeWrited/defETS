#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Vyberie podtyp ovládača, aby hra správne stanovila rozsahy vstupov."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Zvolí typ prevodovky:<br>- „Jednoduchá automatika“ umožňuje použitie plynu a brzdy pre pohyb dopredu alebo dozadu.<br>- „Reálna automatická“ vyžaduje vstup na zmenu medzi pohybom dopredu alebo dozadu.<br>- „Sekvenčná“ vyžaduje manuálne radenie všetkých rýchlostí so vstupom na preradenie/podradenie.<br>- „Radiaca páka“ vyžaduje vstup ovládača s radením v tvare H na manuálne zvolenie rýchlosti."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje logiku zmeny prevodových stupňov automatickej prevodovky:<br>- „Ekonomický“ mód preferuje nižšie otáčky na dosiahnutie maximálneho krútiaceho momentu.<br>- „Výkonný“ mód sa bude prikláňať k dosiahnutiu maximálneho výkonu pri preprave ťažkého nákladu alebo v kopcovitom teréne za cenu zvýšenej spotreby paliva."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje pomer medzi stupňom rotácie zariadenia a skutočným stupňom rotácie vozidla pri zatáčaní."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje lineárnosť medzi vstupom a riadením vozidla.<br><br>Nastavenie vyšších hodnôt bude znamenať, že riadenie bude menej citlivé, ak bude volant v stredovej pozícii a citlivosť sa bude zvyšovať smerom k okrajovým pozíciám volantu. Toto nastavenie môže byť užitočné pre uhladenie vstupu riadenia pri jazde rovno."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Povolí spätnú väzbu pri ovládačoch, ktoré ju podporujú."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje celkovú intenzitu spätnej väzby medzi 0 N a 10 N.<br><br><color value=@@clr_txt_d@@>Zober na vedomie, že pri nastavení vyšších hodnôt v prípade výkonných volantov môže dôjsť k zraneniu prstov alebo rúk."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu centrovania volantu pri jazde vo vysokej rýchlosti, najvýraznejšie pri a nad 90 km/h (56 mph).<br><br>Minimálne nastavenie bude znamenať, že k centrovaniu nebude vôbec dochádzať."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu centrovania volantu pri jazde v nízkej rýchlosti.<br><br>Minimálne nastavenie bude znamenať, že k centrovaniu nebude vôbec dochádzať."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu prenosu chvenia sústavou riadenia spôsobenou vnútorným trením mechanických komponentov riadenia."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu prenosu chvenia motora sústavou riadenia.<br><br><color value=@@clr_txt_d@@>Zober na vedomie, že nastavenie hodnoty viac ako 15 % môže spôsobiť nadmerné chvenie a vibrácie v prípade niektorých volantov."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektu prenosu nárazu od nerovností na ceste sústavou riadenia.<br><br><color value=@@clr_txt_d@@>Zober na vedomie, že nastavenie hodnoty viac ako 20 % môže spôsobiť nadmerné chvenie a vibrácie v prípade niektorých volantov pri jazde na nerovnom teréne vo väčšej rýchlosti."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektu prenosu nárazu od výtlkov na ceste sústavou riadenia."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektu prenosu nárazu sústavou riadenia."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektu škrípania prevodovky."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektu nedotáčavosti."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu asistovaného riadenia (napríklad pri použití režimu pre udržiavanie v jazdnom pruhu)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu vibrácií nerovností povrchu, ak ovládač podporuje vibračnú odozvu."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu vibrácií nárazov do zavesenia kolies, ak ovládač podporuje vibračnú odozvu."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu vibrácií kolízií, ak ovládač podporuje vibračnú odozvu."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os zariadenia použitá na riadenie."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje mŕtvu zónu osi riadenia; rozsah pohybu od stredu, pre ktorý je input ignorovaný.<br><br>Toto nastavenie môže odstrániť problémy pri starších ovládačoch, ako sú nepresnosť alebo falošné vstupy spôsobené opotrebovaním."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určí, ako hra spracováva vstup z osi riadenia:<br>- Vycentrovaný je ideálny pre volanty alebo joysticky.<br>- Obrátený sa používa na korekciu osi, ktorá bola zle detekovaná."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os zariadenia použitá na akceleráciu vozidla."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje mŕtvu zónu osi plynu; rozsah pohybu od stredu, pre ktorý je input ignorovaný.<br><br>Toto nastavenie môže odstrániť problémy pri starších ovládačoch, ako sú nepresnosť alebo falošné vstupy spôsobené opotrebovaním."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určí, ako hra spracováva vstup z ovládača:<br>- Vycentrovaný je ideálny pre joysticky.<br>- Normálny je ideálny pre spínače a pedály.<br>- Obrátený môže kompenzovať vstupy, ktoré boli zle detekované."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os zariadenia použitá na brzdenie."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje mŕtvu zónu osi brzdenia; rozsah pohybu od stredu, pre ktorý je input ignorovaný.<br><br>Toto nastavenie môže odstrániť problémy pri starších ovládačoch, ako sú nepresnosť alebo falošné vstupy spôsobené opotrebovaním."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určí, ako hra spracováva vstup z ovládača:<br>- Vycentrovaný je ideálny pre joysticky.<br>- Normálny je ideálny pre spínače a pedály.<br>- Obrátený môže kompenzovať vstupy, ktoré boli zle detekované."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os zariadenia použitá pre spojku."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje mŕtvu zónu osi spojky; rozsah pohybu od stredu, pre ktorý je input ignorovaný.<br><br>Toto nastavenie môže odstrániť problémy pri starších ovládačoch, ako sú nepresnosť alebo falošné vstupy spôsobené opotrebovaním."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určí, ako hra spracováva vstup z ovládača:<br>- Vycentrovaný je ideálny pre joysticky.<br>- Normálny je ideálny pre spínače a pedály.<br>- Obrátený môže kompenzovať vstupy, ktoré boli zle detekované."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje rozsah spojky.<br><br>Čím viac vpravo nastavíš rozsah, tým viac budeš musieť stlačiť pedál spojky, aby sa uvoľnila."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os zariadenia použitá na pohyb kamery nahor alebo nadol."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje mŕtvu zónu osi pohľadu nahor/nadol; rozsah pohybu od stredu, pre ktorý je input ignorovaný.<br><br>Toto nastavenie môže odstrániť problémy pri starších ovládačoch, ako sú nepresnosť alebo falošné vstupy spôsobené opotrebovaním."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určí, ako hra spracováva vstup z osi:<br>- Vycentrovaný je ideálny pre joysticky.<br>- Obrátený sa používa na korekciu osi, ktorá bola zle detekovaná."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os zariadenia použitá na pohyb kamery doľava alebo doprava."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje mŕtvu zónu osi pohľadu doľava/doprava; rozsah pohybu od stredu, pre ktorý je input ignorovaný.<br><br>Toto nastavenie môže odstrániť problémy pri starších ovládačoch, ako sú nepresnosť alebo falošné vstupy spôsobené opotrebovaním."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určí, ako hra spracováva vstup z osi:<br>- Vycentrovaný je ideálny pre joysticky.<br>- Obrátený sa používa na korekciu osi, ktorá bola zle detekovaná."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Zvolí rozloženie prevodových stupňov, ktoré sa má použiť s riadiacou pákou."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje správanie radiacej páky:<br>- \"Jednoduché“ nikdy nebudeš škrípať prevody pri radení.<br>- \"Jednoduché + varovné zvuky“ ti umožní radiť taktiaž jednoducho, ale so zvukom škrípania prevodovky pri nesprávnom radení.<br>- \"Pokročilé“ ti nedovolí preradiť pri nesprávnom radení a stretneš sa len so zvukmi škrípania prevodovky. Možnosť \"Pokročilé“ ti tiež umožňuje využiť nastavenie \"Rýchle delenie riadiacej páky“."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Zvoľ si, ako hra zvládne rýchle delenie riadiacej páky:<br>- „Nikdy“ bude vyžadovať, aby bola radiaca páka presunutá do neutrálu medzi jednotlivými deleniami.<br>- „Zošľapnutie spojky“ si vyžaduje chvíľkové zošľapnutie spojky bez pohybu páky.<br>- „Uvoľnenie plynu“ vyžaduje, aby vodič uvoľnil plyn iba na rozdelenie prevodových stupňov bez pohybu radiacej páky a „Spojka alebo plyn“ je kombináciou posledných dvoch."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Priradí pozíciu riadiacej páky."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Priradí vstup na prepínanie medzi rozsahmi na základe rozloženia radiacej páky."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Priradí tlačidlo na prepínanie rozdeľovača radenia na základe rozloženia radenia."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Povoliť pri použití prepínačov namiesto tlačidiel pre vstupy rozsahu alebo rozdeľovača."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Priradí tlačídlo pre prepínanie do režimu D (jazdy) automatickej prevodovky."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Priradí tlačídlo pre prepínanie do režimu R (cúvania) automatickej prevodovky."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Povolí dynamický RGB spätnú väzbu na kompatibilných zariadeniach."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Povolí a nakonfiguruje funkciu sledovania očí pre kompatibilné zariadenia."
#@}

#@}

#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "SLEDOVANIE OČÍ" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Rozšírený pohľad" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Predvoľba rozšíreného pohľadu" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Zadajte názov predvoľby" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Ste si istý, že chcete vymazať vybranú predvoľbu?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Existujúca predvoľba s rovnakým názvom bude prepísaná. Chcete pokračovať?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Nastavenia snímania pohľadu" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Nastavenia snímania hlavy" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Ovládanie pomocou klávesnice" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Povoliť rozšírený pohľad" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Povoliť automatické centrovanie" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Režim snímania hlavy" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Priamy" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dynamický" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Citlivosť zobrazenia na pohľad" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Citlivosť zobrazenia na pohyb hlavy" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Povoliť otáčanie" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Povoliť pozíciu" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Činiteľ otáčania (v kabíne)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Činiteľ naklonenia (v kabíne)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Činiteľ otáčania (v režime chôdze)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Činiteľ naklonenia (v režime chôdze)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Maximálny uhol pohľadu" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Rýchlosť snímania pohľadu"

	key[]: "eye_gaze_exponent"
	val[]: "Mocniteľ snímania pohľadu"

	key[]: "eye_gaze_inflection_point"
	val[]: "Inflexný bod snímania pohľadu"

	key[]: "eye_gaze_start_point"
	val[]: "Počiatočný bod snímania pohľadu"

	key[]: "eye_gaze_end_point"
	val[]: "Koncový bod snímania pohľadu"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Citlivosť snímania otáčania hlavy (v kabíne)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Citlivosť snímania naklonenia hlavy (v kabíne)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Citlivosť snímania otáčania hlavy (v režime chôdze)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Citlivosť snímania naklonenia hlavy (v režime chôdze)"

	key[]: "eye_head_exponent"
	val[]: "Mocniteľ snímania hlavy"

	key[]: "eye_head_inflection_point"
	val[]: "Inflexný bod snímania hlavy"

	key[]: "eye_head_start_point"
	val[]: "Počiatočný bod snímania hlavy"

	key[]: "eye_head_end_point"
	val[]: "Koncový bod snímania hlavy"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Povolí rozšírený pohľad, ktorý zvyšuje uhol pohľadu pomocou pohybu hlavy a/alebo očí pre ovládanie hernej kamery."

	key[]: "eye_preset_op_tooltip"
	val[]: "Výber predvolieb rozšíreného pohľadu."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Výber režimov snímania hlavy:<br>- V „Priamom“ rotácia tvojej hlavy priamo zodpovedajú rotácii kamery v hre. Odporúča sa pri bežných situáciach v kabíne.<br>- V „Dynamickom“ režime tvoj pohľad bude ovplyvňovať kameru v hre iba vtedy, keď naozaj otočíš hlavu. Odporúča sa pre použitie v situáciach, keď je dôležite, aby bol tvoj pohľad úplne vycentrovaný."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Pri povolení sa kamera v hre pomaly a plynulo vycentruje, keď počas hry zmeníš prirodzenú polohu hlavy."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Pri povolení má poloha tvojej hlavy vplyv na polohu kamery v hre."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Pri povolení herná kamera sa nakloní zodpovedajúcim smerom pri naklonení hlavy na ktorúkoľvek stranu."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Násobí kombinovanú rotáciu hlavy a pohľadu v horizontálnom smere (v kabíne)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Násobí kombinovanú rotáciu hlavy a pohľadu vo vertikálnom smere (v kabíne)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Násobí kombinovanú rotáciu hlavy a pohľadu v horizontálnom smere (v režime chôdze)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Násobí kombinovanú rotáciu hlavy a pohľadu vo vertikálnom smere (v režime chôdze)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Upravuje, ako rýchlo kamera v hre zareaguje na váš pohyb očí."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Upravuje akým tempom sa rýchlosť zvyšuje."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Upravuje vzdialenosť od stredu obrazovky, kde sa zrýchlenie začne vyrovnávať."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Upravuje, ako ďaleko od stredu obrazovky sa musíte pozrieť, kým sa kamera v hre začne pohybovať."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Upravuje, ako ďaleko od stredu obrazovky sa musíte pozrieť, aby ste dosiahli maximálnu rýchlosť kamery."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Určuje, ako ďaleko sa môže kamera v hre otočiť, keď sa pozriete na okraje obrazovky."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Upravuje, ako rýchlo kamera v hre zareaguje na pohyb vašej hlavy."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Upravuje o koľko sa kamera v hre otočí vľavo alebo vpravo v porovnaní s tým, o koľko otočíte hlavou (v kabíne)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Upravuje o koľko sa kamera v hre otočí hore alebo dole v porovnaní s tým, o koľko otočíte hlavou (v kabíne)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Upravuje o koľko sa kamera v hre otočí vľavo alebo vpravo v porovnaní s tým, o koľko otočíte hlavou (v režime chôdze)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Upravuje o koľko sa kamera v hre otočí hore alebo dole v porovnaní s tým, o koľko otočíte hlavou (v režime chôdze)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Upravuje akým tempom sa rýchlosť zvyšuje."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Upravuje, ako veľmi je potrebné otočiť hlavou, než sa zrýchlenie začne vyrovnávať."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Upravuje o koľko musíte otočiť hlavou od stredovej pozície, kým sa kamera v hre začne pohybovať."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Upravuje koľko musíte otočiť hlavou zo stredovej polohy, aby ste dosiahli maximálnu rotáciu kamery."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Výber režimov automatického pozastavenia."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Upravuje čas v milisekundách, po ktorom sa hra automaticky pozastaví, ak nedokáže detegovať váš pohľad."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Priradí tlačidlo pre nastavenie vašej aktuálnej polohy hlavy ako novej predvolenej polohy a podľa toho znovu vycentruje kameru v hre."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Priradí tlačidlo, ktoré zapína/vypína všetky funkcie súvisiace rozšíreným pohľadom pre Tobii."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Priradí tlačidlo, ktoré otvára nastavenie sledovania očí."

