#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafika" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Uprav grafické nastavenia pomocou predvolieb pre prispôsobenie hernej vizualizácie podľa svojich predstáv."

	key[]: "apply"
	val[]: "Použiť" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Motív pracovnej plochy" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "DISPLEJ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "KVALITA OBRAZU" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTÚRY" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "ODRAZY" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "TIENE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "OSVETLENIE" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POSTPROCESING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "PROSTREDIE" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Mód celej obrazovky" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Jas / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Nastavenie" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Rozlíšenie" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Obnovovacia frekvencia" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limit FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limit FPS na pozadí" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Štandardné obnovenie" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikálna synchronizácia" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomické (Šetrí batériu v notebookoch)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "JEDNODUCHÉ GRAFICKÉ NASTAVENIA" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "APLIKOVANÉ VLASTNÉ NASTAVENIA" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "POKROČILÉ GRAFICKÉ NASTAVENIA" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Jednoduché/pokročilé nastavenia grafiky" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Skryť pokročilé nastavenia" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Zobraziť pokročilé nastavenia" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Zmena veľkosti" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Vyhladzovanie" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma zaostrenie" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA ladenie" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptívne" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Vždy jemné" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Vždy ostré" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Ambientná oklúzia generovaná v obraze (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Vysoký dynamický rozsah (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Hĺbka ostrosti (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Slnečné lúče" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Korekcia farieb" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Zmena veľkosti odleskov" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Úroveň odleskov" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detaily vegetácie" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Hustota rastlín" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Kvalita tieňov"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Veľkosť tieňovej textúry" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Vzdialené tiene" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Interiérové tiene" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Kvalita počasia"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Kvalita zrkadiel" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Rozlíšenie zrkadla" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Vzdialenosť v zrkadlách" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Kvalita textúr" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropná filtrácia" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normálové mapovanie" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Svetlomety" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Sekundárne svetlá na vozidle" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Vykresľovaná vzdialenosť svetiel" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Chodci" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Nastavenia displeja boli zmenené.<br>Chcete ponechať tieto nastavenia?"

	key[]: "reverting_in"
	val[]: "Návrat za" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekundy" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Pri povolení sa hra zobrazí na celú obrazovku."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Nastav si celkový jas hry podľa svojho displeja. Na displejoch kompatibilných s HDR je v tomto nastavení k dispozícii taktiež možnosť kalibrácie HDR."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Upravuje rozlíšenie hry."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje cieľovú obnovovaciu frekvenciu hry."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Zosynchronizuje počet snímkov s obnovovacou frekvenciou monitora, aby sa predišlo trhaniu obrazu. Ekonomické nastavenie zároveň znižuje počet snímkov na polovicu, čo má za následok nižšiu spotrebu energie."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Nastaví maximálny povolený počet snímkov v hre.<br><br>Pri nastavení 0 bude táto funkcia vypnutá."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Nastaví maximálny povolený počet snímkov ak je hra minimalizovaná na pozadí.<br><br>Pri nastavení 0 bude táto funkcia vypnutá."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Prepína medzi jednoduchými grafickými nastaveniami (predvolenými) a pokročilými grafickými nastaveniami (možnosťou zmeny jednotlivých parametrov)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Zlepšuje vizuálnu vernosť interným vykreslením hry vo vyššom rozlíšení, čo znižuje zúbkované okraje a zvýrazňuje detaily.<br>Napríklad výberom väčšej zmeny veľkosti má za následok jasnejší obraz s menším rozmazaním, vďaka čomu hra celkovo vyzerá lepšie na úkor výkonu.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má často značný vplyv na výkon."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Výber vysokorýchlostných metód antialiasingu, ktoré vyhladzujú zubaté hrany v hre:<br>- SMAA vzorkuje každý pixel niekoľkokrát (v závislosti na zvolenej kvalite) na rôznych miestach v rámci snímky a spriemeruje vzorky pre vytvorenie finálneho obrazu.<br>- TAA vzorkuje každý pixel iba raz za snímku, ale vzorkuje ich na rôznych miestach a rôznych snímkach.<br>- Pre najlepší výsledok môžeš zvoliť kombináciu oboch na úkor výkonu.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Pridáva jemné tiene do štrbín a predmetov, ktoré sú vo vzájomnej tesnej blízkosti, čím zlepšuje vnímanú vizuálnu vernosť celého herného sveta.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Výber TAA možností:<br>- „Vždy jemné“ spôsobí menej blikania/viac rozmazania - táto možnosť je vhodná pre PC používateľov, ktorí používajú supersampling alebo majú monitor s vysokým DPI, ako aj pre 1080p TV používateľov, ktorí sedia vo väčšej vzdialenosti od obrazovky.<br>- „Vždy ostré“ spôsobí viac blikania/menej rozmazania - je to pravdepodobne najlepšia možnosť pre používateľov s nižším rozlíšením ako je 1080p, napr. na laptopoch alebo pri použití Steam Deck.<br>- „Adaptívne“ sa bude TAA efekt dynamicky vypínať, ak je kamera statická.<br><br><color value=@@clr_txt_d@@>Toto nastavenie je možné použiť len vtedy, keď je ako metóda vyhladzovania zvolená TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje intenzitu TAA luma zaostrenia.<br><br><color value=@@clr_txt_d@@>Toto nastavenie je možné použiť len vtedy, keď je ako metóda vyhladzovania zvolená TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Pri povolení vzdialené oblasti na mape môžu byť umelo rozmazané, aby sa vytvoril realistický efekt rozmazania v pozadí."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Pri povolení lúče svetla môžu byť viditeľné pri pohľade na slnko alebo pri pohľade na slnko cez objekty ako stromy, budovy alebo vozidlá."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Pri povolení farby hry sa dynamicky prispôsobujú z estetických dôvodov. Scény budú lepšie zodpovedať dennému obdobiu a poveternostným podmienkam, farby vozidiel a ďalších objektov môžu byť živšie, atď."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Vylepší odrazy ich vykresľovaním interne vo vyššej kvalite, ako aj použitím lepšieho vyhladzovania.<br><br><color value=@@clr_txt_d@@>Zmeny tohto nastavenia sa prejavia až po manuálnom reštarte hry."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje detailnosť odrazov viditeľných na povrchu vozidiel, oknách a iných odrazových plochách ako sú kaluže, mokrá vozovka alebo vodné plochy.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon.<br><br>Zmeny tohto nastavenia sa prejavia až po manuálnom reštarte hry."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje detailnosť a komplexnosť rastlín a stromov.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje hustotu trávy rastúcej popri cestách.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu tieňov zo svetla od slnka alebo mesiaca.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Povolí vykresľovanie tieňov aj pre veľmi vzdialené objekty.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Povolí nočné dynamické tiene v interiéri vozidla.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu efektov počasia, ako sú odrazy."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu odrazov videných v zrkadlách vozidiel (nezávisle na nastaveniach odrazov).<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje rozlíšenie obrazu zobrazeného v zrkadlách vašeho vozidla."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje vzdialenosť, pri ktorej sa objekty začnú vykresľovať v zrkadlách.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má často značný vplyv na výkon."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu nektorých textúr aplikovaných pre objekty a povrchy v hre."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Zlepší ostrosť textúr, najmä tých, ktoré sú pozorované z diaľky alebo pod šikmým uhlom.<br><br><color value=@@clr_txt_d@@>Zmeny tohto nastavenia sa prejavia až po manuálnom reštarte hry."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Pridáva geometrický detail k chodníkom, cestám a iným objektom, aby sa zlepšil ich vzhľad.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon.<br><br>Zmeny tohto nastavenia sa prejavia až po manuálnom reštarte hry."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Povolí osvetlenie zo svetiel iných vozidiel v premávke."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Povolí osvetlenie zo sekundárnych svetiel iných vozidiel v premávke, ako sú smerovky, brzdové svetlá atď."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje vzdialenosť, z ktorej sú umelé zdroje svetla viditeľné.<br><br><color value=@@clr_txt_d@@>Toto nastavenie má zvyčajne mierny vplyv na výkon."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Povolí chodcov v hernom svete."
#@}

