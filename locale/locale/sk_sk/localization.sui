#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "OBSAH PREPOJENÝ S WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Pripojiť " #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Prehľadávať " #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "HLAVNÉ NASTAVENIA " #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "PRIPOJIŤ OBSAH" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Pripojiť " #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks zistil nový herný obsah. Prepojte ho s World of Trucks, aby ste získali výhody." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online nastavenie. Prispôsobte si všetky nastavenia World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Skutočne chcete registráciu odložiť?<br><br>Dialóg s pripojením online obsahu môžeš zobraziť neskôr z online nastavenia, ktoré nájdeš na ploche." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "PRIPÁJANIE OBSAHU" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Pripájam obsah..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Nepodarilo pridať do fronty operáciu pre pripojenie k: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam účet použitý pri registrácii tohto DLC je odlišný ako ten, ktorý bol použitý pri vytvorení tvojho World of Trucks účtu alebo pri registrácii hry. Zmeň svoj účet prosím a skús to znovu." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam účet, ktorý si použil pri registrácii tohto DLC je už prepojený s iným World of Truck účtom. Pre zaregistrovanie DLC do aktuálneho účtu musíš použiť Steam účet, ktorý nie je prepojený so žiadnym World of Truck účtom." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Platnosť Steam tokenu uplynula. Skús to prosím neskôr." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Licenčný kód použitý na aktiváciu DLC je neplatný. Pre pomoc kontaktujte prosím podporu: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Počas registrácie hry došlo k chybe. Skúste to prosím neskôr." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "ÚSPECH" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "PREHLIADAČ OBSAHU" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Gratulujeme! Vybrané DLC boli úspešne prepojené s tvojím účtom World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nepodarilo sa ti prepojiť obsah, pretože aktuálny Steam účet je prepojeným s iným World of Truck účtom." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Niektoré DLC sa nepodarilo pripojiť.<br>Pre zobrazenie viac informácii prejdite s myškou cez výkričník pri jednotlivých DLC." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrujem $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Aktuálny profil nie je pripojený k World of Trucks alebo hra beží v režime offline. Pre pripojenie uprav profil." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Kliknutím zavrieš"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ aktuálne pripojené kompatibilné DLC. Ak nie sú prepojené niektoré DLC s World of Trucks, môžu ti chýbať niektoré ich funkcie." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Gratulujeme! <color value=@@clr_txt@@>Všetok tvoj obsah je teraz prepojený s World of Trucks! Teraz môžeš využívať ich všetky funkcie." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Nepodarilo sa pripojiť nový obsah z World of Trucks pretože aktuálne používaní Steam účet nie je zhodný so Steam účtom použitom na profile World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Pripojený " #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nepripojený " #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Nepodarilo sa načítať údaje o vlastnenom obsahu." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Nepodarilo sa načítať údaje o pripojenom obsahu." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Nepodarilo sa načítať informácie o aktuálne používanom účte." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Neskôr" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Nepodarilo sa zaregistrovať toto DLC. Nebola nájdená licencia, pravdepodobne kvôli zdieľaniu knižnice v službe Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Žiadne trvalé vlastníctvo " #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Špeciálna prepravná misia dokončená!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISIA NEÚSPEŠNÁ!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Zrušiť"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Načítať kontrolný bod"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Poškodil si sprievodné vozidlo!<br>Môžete načítať od kontrolného bodu alebo zrušiť prepravu s poplatkom vo výške $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Sprievodné vozidlo bolo poškodené okolitou premávkou v dôsledku neopatrnej jazdy.<br>Môžete načítať od kontrolného bodu alebo zrušiť prepravu s poplatkom vo výške $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Mal by si sledovať trasu.<br>Môžete načítať od kontrolného bodu alebo zrušiť prepravu s poplatkom vo výške $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Mali by ste zostať so sprievodnými vozidlami<br>Môžete načítať od kontrolného bodu alebo zrušiť prepravu s poplatkom vo výške $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Opúšťaš sprievodné vozidlá! "

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Zničil si sprievodné vozidlo! "

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Sprievodné vozidlo zničené! "

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Opustil si vopred stanovenú trasu!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Rozmery "

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Špeciálna preprava"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Držte sa medzi sprievodnými vozidlami."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Špeciálne prepravy "

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Rozmery "

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Špeciálna preprava"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Spomaľ, prosím, aby si zabránil nárazu do sprievodného vozidla..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Čakajte na sprievodné vozidlo....."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Teraz prosím opatrne, prichádza úzka časť trasy... "

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Blíži sa zmena jazdného pruhu. Prispôsob svoju rýchlosť aby si predišiel zrážke..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Predné sprievodné vozidlo bude varovať ďalších šoférov...<br>Prispôsob svoju jazdu, aby si zabránil nehode..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Sprievodné vozidlá ťa čakajú na neďalekej križovatke. Prosím, nasleduj trasu."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Pozor!<br>Približuješ sa k zadnému sprievodnému vozidlu! "

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Pozor!<br>Nebezpečne sa približuješ k sprievodnému vozidlu za tebou! "

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Stlač nasledujúci kláves pre zobrazenie ponuky špeciálnej prepravy:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Ponuka špeciálnej prepravy:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Chystáš sa na prevoz špeciálneho tovaru! Sprevádzať ťa budú dve sprievodné vozidlá. Buď opatrný a riaď sa ich pokynmi, ktoré môžeš sledovať v rámci odporúčaných oznámení. Pri špeciálnych prepravách ako je táto, nemusíš zastavovať na červenú a máš prednosť v jazde skoro všade. Počas týchto prepráv, sa častejšie ukladajú kontrolné body aby sa zachoval tvoj aktuálny postup."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Pár dôležitých informácii: "

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Vyhni sa akémukoľvek konfliktu so sprievodnými vozidlami a drž sa medzi nimi. "

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Neopúšťajte určenú trasu, ani na čerpaciu stanicu, odpočívadlá atď."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Dodržuj rýchlostné limity, na ktoré bude dohliadať sprievodné vozidlo pred tebou."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Pozor na ostatné vozidlá na ceste, ktoré ťa môžu predchádzať."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manéver na zmenu pruhu:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Pokiaľ nebudeš dodržovať tieto pravidlá, tvoja špeciálna preprava môže byť zrušená! "

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manéver začína <color value=@@clr_sel@@>zadným<color value=@@clr_txt@@> sprievodným vozidlom zmenou a zablokovaním určitého pruhu."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@> predné <color value=@@clr_txt@@>sprevodné vozidlo čaká pokiaľ nie je určený pruh voľný a potom sa do neho tiež zaradí."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Potom je to bezpečné pre <color value=@@clr_sel@@>hráča<color value=@@clr_txt@@> aby sa preradil do určeného pruhu."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Palivo bolo doplnené a povolený čas pre šoférovanie bol obnovený. "

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Nemôžeš zavolať asistenciu počas misie Špeciálnej prepravy."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Počas špeciálnej prepravy nemôžeš použiť trajekt."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Odpočívaš...<br>Palivové nádrže ťahača sa plnia..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Blíži sa povinná prestávka.<br>Nasleduj sprievodné vozidlo na parkovacie miesto a oddýchni si!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Povinná prestávka"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Pre odpočinok a natankovanie stlač nasledujúci kláves:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Pri načítaní obsahu zo Steamu prišlo k chybe.<br><br>$ERROR$<br><br>Ak chcete nechať obsah zapnutý stlačte pokračovať a hra ho bude priebežne hľadať.<br><br>Môžete tiež obsah dočasne vypnúť, aby sa už znovu nezobrazovali varovné správy. Hra automaticky aktivuje obsah pri ďalšom spustení hry." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Nepodarilo sa stiahnuť predmety zo Steam inventára." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTÁR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Načítavam predmety zo Steam inventára..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOVÉ PREDMETY Z INVENTÁRA" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Boli nájdene nové predmety zo Steam inventára." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Príslušenstvo na vozidlo " #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Príslušenstvo do kabíny " #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Pozadie plochy " #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Lak" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Zakázať inventár " #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Skúsiť to znovu neskôr" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM INVENTÁR" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Niektoré predmety boli odstránené z tvojho Steam inventára. Už si ich nebudeš môcť kúpiť v obchode s doplnkami.<br><br>Toto neovplyvňuje tvoje aktuálne nainštalované predmety." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


#+ Localized versions of the Steam operation results.
#@{
	key[]: "steam_result_genericerror"
	val[]: "Vnútorná chyba Steamu " #+ The generic error message used when no specific message is defined for some result.

	key[]: "steam_result_ok"
	val[]: "Úspech " #+ Success result message.

	key[]: "steam_result_serviceunavailable"
	val[]: "Nepodarilo sa pripojiť k Steamu. Prosím, skontrolujte či vám funguje internetové pripojenie, ak je všetko v poriadku, skúste to znovu neskôr." #+ The message showed when game fails to connect to Steam servers.

	key[]: "steam_result_timeout"
