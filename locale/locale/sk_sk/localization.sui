#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Vyžadované DLC (oficiálne rozšírenie hry) $DEPENDENCY_NAME$ chýba. Pre správne fungovanie tejto uloženej pozície je potrebné mať DLC aktivované a nainštalované na tomto počitači. Ty musíš vyriešiť tento problém ešte pred tým ako načítaš uloženú pozíciu." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Voliteľné DLC (oficiálne rozšírenie hry) $DEPENDENCY_NAME$ chýba. Ak si ale myslíš, že všetko by malo byť v poriadku, tak si skontroluj stav DLC.<br><br>Môžeš načítať uloženú pozíciu, ale niektoré funkcie z DLC môžu byť stratené." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modifikácia $DEPENDENCY_NAME$ je chýbajúca alebo vypnutá. Ak si myslíš, že je všetko v poriadku, skontroluj stav modifikácií. Môžeš vyskúšať načítať uloženú pozíciu aj tak. Avšak, v závislosti čo daná modifikácia mení, môže spôsobiť problémy s načítaním alebo ďalšie problémy." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modifikácia $DEPENDENCY_NAME$ je nekompatibilná s verziou hry. Tým je myslené, že autor tejto modifikácia ju označil ako kompatibilnú s istými verziami hry a aktuálna sa v nej nenachádza.<br><br>Riešenie:<br>Skús nájsť aktualizovanú verziu modifikáciu, ktorá je urobená tak aby fungovala na tvoju verziu hry.<br>Aktualizuj alebo urob downgrade verzie hry, ktorá je kompatibilná s touto modifikáciou.<br><br>Môžeš načítať uloženú pozíciu. Avšak modifikácia nebude načítaná, v závislosti čo modifikácia mení, môže toto načítanie spôsobiť aj ďalšie problémy." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "CHÝBAJÚCE ZÁVISLOSTI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETAILY" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Otvoriť workshop stránku "  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Táto uložená pozícia je závislá na DLC alebo modifikáciách. Tie, ktoré chýbajú sú uvedené nižšie. Vybraním položky na zozname sa môžeš dozvedieť viac informácii o danej položke." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Táto uložená pozícia je závislá aspoň na jednom DLC alebo modifikácií. Musíš vyriešiť tento problém predtým ako načítaš túto uloženú pozíciu." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Prerušiť načítanie" #+ Abort loading button.

	key[]: "type"
	val[]: "Typ" #+ Type column.

	key[]: "dependency_name"
	val[]: "Názov závislosti" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokálna modifikácia" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop modifikácia" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Voliteľné DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Požadované DLC" #+ DLC that is required to load save that is depending on it.
#@}

