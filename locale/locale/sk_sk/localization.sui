	key[]: "select_controller_type"
	val[]: "VYBER TYP OVLÁDAČA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volant"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad alebo joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Ovládač je vlastne volant, alebo sa tak aspoň správa. Pozícia ovládača priamo určuje polohu volantu v hre."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Ovládač je gamepad alebo joystick. Poloha ovládača určuje rýchlosť otáčania volantu v hre."
