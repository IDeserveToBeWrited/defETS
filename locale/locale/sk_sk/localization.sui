	key[]: "dependencies"
	val[]: "Závislosti" #+ Title of the section in mod details window displaying list of the dependencies the mod has.

	key[]: "missing_mod_dependencies_detected"
	val[]: "Niektoré DLC vyžadované touto modifikáciou chýba. Skontrolujte, či máte všetky nainštalované a aktivované." #+ The message showed when user has one of MOD dependencies missing.
#@}

#+ Version change detected message box.
#@{
	key[]: "version_change_detected_t"
	val[]: "ZISTENÁ ZMENA VERZIE " #+ Title of the infomational message box when version change has been detected.

	key[]: "version_upgrade_detected"
	val[]: "Hra bola aktualizovaná na novšiu verziu." #+ The message showed when upgrade of the game to the newer version has been detected.

	key[]: "version_downgrade_detected"
	val[]: "Hra bola aktualizovaná na staršiu verziu." #+ The message showed when downgrade of the game to the older version has been detected.

	key[]: "version_change_detected_common"
	val[]: "<br><br>Zmena verzie hry môže poškodiť modifikácie, čo môže spôsobiť pády alebo nestabilitu hry; za udržovanie kompatibility modifikácii sú zodpovední autori modifikácii. Uistite sa, že modifikácie, ktoré používate, sú kompatibilné.<br><br>Tip pre riešenie problému: pokiaľ je aktuálne vydanie modifikácie nekompatibilné, skús ju deaktivovať v správcovi modifikácii.<br><br>Verzia hry: $GAME_VERSION$" #+ Common message (showed for both downgrade and upgrade) in the version change dialog.
#@}

