	val[]: "Načítavanie zo servera..."

	key[]: "mp_warning_on_job"
	val[]: "Momentálne už máš aktívnu zákazku. Pred výberom novej ju budeš musieť najprv zrušiť."

	key[]: "mp_warning_trailer"
	val[]: "Tvoj aktuálny náves nie je kompatibilný s týmto nákladom. Zmeň náves alebo využi poskytnuté vybavenie."

	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "Aktuálne doručuješ náklad do spoločnosti, ktorá v tejto relácii nie je aktívna.<br>Ak sa chceš pripojiť, najprv dokonči svoju zákazku, inak bude pozastavená a nedostupná počas tejto relácie.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Aktuálne doručuješ náklad do spoločnosti, ktorá v tejto relácii nie je aktívna.<br>Ak sa chceš pripojiť, najprv dokonči svoju zákazku, inak bude zrušená.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Pre pripojenie k tejto relácii bude nutné aktivovať spoločnosť blízko tvojho ťahača alebo návesu.<br>Aby si sa vyhol akýmkoľvek problémom, presuň svoj ťahač a náves ďalej od firmy, inak bude tvoja aktuálna zákazka pozastavená a nedostupná počas tejto relácie, zároveň budeš presunutý do najbližšieho servisu.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Pre pripojenie k tejto relácii bude nutné aktivovať spoločnosť blízko tvojho ťahača alebo návesu.<br>Aby si sa vyhol akýmkoľvek problémom, presuň svoj ťahač a náves ďalej od firmy, inak bude tvoja aktuálna zákazka zrušená a zároveň budeš presunutý do najbližšieho servisu.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Pre pripojenie k tejto relácii bude nutné aktivovať spoločnosť blízko miesta, kde si nechal svoj ťahač alebo náves.<br>Aby si sa vyhol akýmkoľvek problémom po návrate ku svojmu ťahaču, tvoje rýchla zákazka musí byt zrušená a zároveň budeš presunutý do najbližšieho servisu.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Tvoja vybraná zákazka záčina alebo končí v spoločnosti, ktorá v tejto relácii nie je aktívna a po pripojení nebude k dispozícii.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Tvoj náklad sa nachádza v spoločnosti, ktorá v tejto relácii nie je aktívna.<br>Ak sa chceš pripojiť, najprv nalož náklad, inak bude tvoja aktuálna zákazka pozastavená a nedostupná počas tejto relácie.<br><br>Chceš pokračovať?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Tvoja zákazka bola zrušená, pretože jej cieľ bol v spoločnosti, ktorá nie je aktívna v tejto relácii."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Your job was canceled as spacial jobs are not supported in convoy."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Tebou vybraná zákazka už nie je dostupná, pretože bola zo spoločnosti, ktorá nie je aktívna v tejto relácii."

	key[]: "mp_warning_load_teleport"
