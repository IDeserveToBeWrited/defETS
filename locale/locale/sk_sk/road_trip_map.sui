#+ Viewpoint descriptions for Tourist Jobs photo album
#@{
	
	key[]: "at_cut_grossglockner_desc"
	val[]: "Grossglockner, najvyšší vrchol Rakúska s výškou 3 798 metrov, sa týči nad Alpami. Je známy svojou 48 km dlhou vysokohorskou cestou s 36 serpentínami a ľadovcom Pasterze, najdlhším ľadovcom v Rakúsku a vo Východných Alpách.<br><br>Saharský piesok, ktorý vietor zanesie tisíce kilometrov na sever, niekedy zafarbí sneh na tejto vysokohorskej ceste do jasne žltej alebo oranžovej farby."

	key[]: "at_cut_schonbrunn_desc"
	val[]: "Zámok Schönbrunn, bývalá letná rezidencia Habsburgovcov, je zapísaný na zozname svetového dedičstva UNESCO a patrí medzi najkrajšie barokové komplexy v Európe.<br><br>Jeho zoologická záhrada, založená v roku 1752, je najstaršou nepretržite fungujúcou zoologickou záhradou na svete."

	key[]: "at_cut_worthersee_desc"
	val[]: "Jazero Wörthersee je tyrkysový klenot, ktorý vznikol počas poslednej doby ľadovej a je známy svojou čistou vodou bohatou na minerály.<br><br>Podľa legendy sa pod hladinou jazera potopilo celé mesto aj s kostolom a miestni obyvatelia dodnes tvrdia, že pod vodou počujú zvoniť jeho zvony."

	key[]: "de_cut_ettal_desc"
	val[]: "Opatstvo Ettal je benediktínsky kláštor v Bavorských Alpách, ktorý v roku 1330 založil bavorský cisár Ľudovít IV.<br><br>Podľa legendy sa Ľudovítov kôň na tom mieste trikrát pokľakol, čo on považoval za znamenie, aby tam postavil kláštor."

	key[]: "de_cut_stuttgart_city_desc"
	val[]: "Štátne divadlo v Štutgarte, ktoré navrhol architekt Max Littmann, bolo otvorené v roku 1912 ako kráľovské dvorné divadlo Württemberského kráľovstva.<br><br>Štutgart leží nad druhým najväčším ložiskom minerálnej vody v Európe, pričom niektoré pramene sú prirodzene tak nasýtené oxidom uhličitým, že kúpanie v nich pripomína kúpanie v šampanskom."

	key[]: "de_cut_nurnberg_city_desc"
	val[]: "Norimberg bol jedným z najdôležitejších miest Svätej ríše rímskej a dodnes je známy svojím mimoriadne rozsiahlym stredovekým opevnením.<br><br>V roku 1561 boli vydesení obyvatelia Norimbergu svedkami hromadnej „vzdušnej bitky“ žiariacich gúľ a krížov, ktorá sa odohrala za úsvitu a bola zaznamenaná na drevorezbe, ktorá sa dnes uvádza ako jedno z prvých pozorovaní UFO."

	key[]: "de_cut_frankfurt_city_desc"
	val[]: "Vo Frankfurtskej finančnej štvrti Bankenviertel, prezývanej „Mainhattan“, sídlia centrály mnohých významných bánk.<br><br>Frankfurt je domovom jedného z najstarších veľtrhov na svete, ktorého história siaha až do 12. storočia. Dnes sa tu každú jeseň koná najväčší knižný veľtrh na svete."

	key[]: "de_cut_rostock_desc"
	val[]: "Námestie Neuer Markt v Rostocku, obklopené obchodnými domami v štýle tehlovej gotiky so štítovými strechami, je už od 13. storočia hlavným trhoviskom mesta.<br><br>V Rostocku sa nachádza najstaršia univerzita na pobreží Baltského mora, ktorá bola založená v roku 1419, teda pred viac ako 600 rokmi."

	key[]: "de_cut_duisburg_desc"
	val[]: "Duisburská radnica (Rathaus), dokončená v roku 1902 v historizujúcom štýle rannej renesancie, stojí na mieste, kde kedysi stál stredoveký kráľovský palác.<br><br>Duisburg leží na sútoku riek Rýn a Ruhr, vďaka čomu je jeho vnútrozemský prístav najväčším riečnym prístavom na svete."

	key[]: "de_cut_kassel_desc"
	val[]: "Prvé historické zmienky o Kasseli pochádzajú z roku 913 a opisujú opevnené miesto pri moste cez rieku.<br><br>Samotný názov je oveľa starší a pochádza od germánskeho kmeňa Chatti."

	key[]: "de_cut_berlin_desc"
	val[]: "Berlínsky Víťazný stĺp, dokončený v roku 1873, pripomína pruské vojenské víťazstvá z 19. storočia a stojí v parku Tiergarten.<br><br>V rokoch 1938–1939 bol stĺp v rámci rozsiahlej prestavby mesta premiestnený o 1,5 kilometra na súčasné miesto, pričom bol doplnený o štvrtú časť, vďaka čomu sa ešte viac zvýšil."

	key[]: "de_cut_dresden_desc"
	val[]: "Drážďanský barokový kostol Frauenkirche, dokončený v roku 1743 na námestí Neumarkt neďaleko rieky Labe, je jednou z architektonických dominánt mesta, ktoré sa prezýva „Florencia na Labe“ alebo „nemecká Florencia“.<br><br>V roku 2009 sa Drážďany stali prvým miestom v Európe, ktorému bol odobratý status svetového dedičstva UNESCO, a to kvôli výstavbe jediného mosta."

	key[]: "ch_cut_geneve_desc"
	val[]: "Ženevská fontána Jet d’Eau vystreľuje vodu z jazera do výšky až 140 metrov v blízkosti miesta, kde rieka Rhône vyteká z Ženevského jazera.<br><br>Od roku 1818 Ženeva oslavuje príchod jari sledovaním oficiálneho gaštana. Vládny úradník ohlási príchod jari v okamihu, keď sa otvorí jeho prvý list – táto tradícia sa dodržiava dodnes."

	key[]: "ch_cut_zurichw_desc"
	val[]: "Zurich West je bývalá priemyselná štvrť, ktorá sa od 90. rokov premenila na trendy štvrť, ktorej dominantou je sklenená budova Prime Tower.<br><br>Najnekonvenčnejší obchod v Zurich West je postavený z 19 hrdzavých prepravných kontajnerov, ktoré sú naskladané do výšky deviatich poschodí na bývalom priemyselnom smetisku."

	key[]: "ch_cut_furka_desc"
	val[]: "Priechod Furka je vysokohorský priechod vo výške 2 429 metrov, ktorý spája kantóny Uri a Valais v strednom Švajčiarsku.<br><br>Jeho ostré zákruty sa objavili vo filmovej naháňačke vo filme Goldfinger z roku 1964 a jedna z nich má prezývku „James Bond Strasse“."

	key[]: "nl_cut_devlieter_desc"
	val[]: "De Vlieter je úsek hrádze Afsluitdijk, 32-kilometrovej hrádze, ktorá oddelila Zuiderzee a vytvorila jazero IJsselmeer.<br><br>Prílivový kanál a okolité vody Waddenového mora v blízkosti De Vlieteru pohltili v priebehu dejín odhadom 500 až 1 000 lodí."

	key[]: "nl_cut_eindhoven_desc"
	val[]: "Eindhoven je holandské mesto v Severnom Brabante, známe ako miesto zrodu a dlhoročné sídlo elektronického gigantu Philips.<br><br>Spoločnosť Philips tu v roku 1891 začala vyrábať žiarovky, vďaka čomu si Eindhoven vyslúžil prezývku „Mesto svetla“."

	key[]: "nl_cut_groningen_desc"
	val[]: "Groningen je živé univerzitné mesto na severe Holandska, ktorému dominuje vysoká veža kostola Martinitoren.<br><br>Miestni obyvatelia Martinitoren láskyplne nazývajú „d’Olle Grieze“, čiže „Stará sivá“; ide o tretiu vežu na tomto mieste, keďže jej dve predchádzajúce verzie boli zničené po zásahoch bleskom."

	key[]: "be_cut_ardennes_desc"
	val[]: "La Roche-en-Ardenne je malé belgické mestečko, nad ktorým sa v zákrute rieky Ourthe týčia ruiny stredovekého hradu."

	key[]: "be_cut_antwerp_desc"
	val[]: "Antverpy sú druhé najväčšie mesto Belgicka a historický prístav, ktorý je od roku 1447 známy ako svetové centrum obchodu s diamantmi.<br><br>Každý rok prejde antverpskou diamantovou štvrťou približne 80 až 90 percent svetovej produkcie surových diamantov."

	key[]: "fr_cut_brest_desc"
	val[]: "Prístav v Breste sa nachádza v historickom prístave, ktorý kardinál Richelieu v roku 1631 premenil na francúzsku námornú základňu.<br><br>Prístavy v Breste sú dôležitým centrom oceánskych pretekov, kde sa schádzajú špičkoví jachtári predtým, ako sa vydajú cez Atlantik alebo sa pokúsia o niektoré z najnáročnejších svetových rekordov v jachtingu."

	key[]: "fr_cut_marseille_desc"
	val[]: "Starý prístav v Marseille slúži ako prirodzený prístav mesta už od čias, keď grécki osadníci okolo roku 600 pred n. l. založili Massaliu.<br><br>Je to jeden z najstarších nepretržite fungujúcich prístavov v Európe."

	key[]: "fr_cut_peyrat_desc"
	val[]: "Peyrat-le-Château je malá dedinka v departemente Haute-Vienne, ktorá leží pri rybníku na náhornej plošine Plateau de Millevaches v regióne Limousin.<br><br>Náhornej plošine Plateau de Millevaches vďačí za svoj nezvyčajný názov buď „tisícom kráv“, ktoré sa tu kedysi pasli, alebo starému slovu označujúcemu množstvo prírodných prameňov, ktoré túto plošinu pokrývajú – nikto si však nie je celkom istý, ktorá z týchto verzií je správna!"

	key[]: "fr_cut_rousse_desc"
	val[]: "L'Île-Rousse je pobrežné mesto v regióne Balagne na severozápade Korziky, ktoré v roku 1758 založil Pasquale Paoli.<br><br>Paoli vybudoval tento prístav, aby Korzičania mohli obchodovať bez toho, aby boli závislí od konkurenčného prístavu v Calvi, ktorý kontrolovali Janovčania."

	key[]: "fr_cut_serre_desc"
	val[]: "Jazero Serre-Ponçon je rozsiahla vodná nádrž v departemente Hautes-Alpes, ktorá vznikla v rokoch 1955 až 1960 prehradením rieky Durance. <br><br>Jazero Serre-Ponçon je tak veľké, že sa rozprestiera na ploche takmer 3 000 hektárov, a preto sa mu hovorí „more v horách“. Nad hladinou vodnej nádrže sa stále týči jediná osamelá kaplnka na malom ostrovčeku."

	key[]: "fr_cut_usse_desc"
	val[]: "Château d'Ussé je rozprávkový zámok v údolí Loiry, postavený v období medzi 15. a 17. storočím na mieste bývalej vikingskej pevnosti.<br><br>Pisateľ Charles Perrault sa údajne pri písaní rozprávky „Šípková Ruženka“ v 17. storočí inšpiroval práve jeho bielymi vežami s vežičkami."

	key[]: "it_cut_bari_desc"
	val[]: "Prístav Bari leží na talianskom pobreží Jadranského mora a už dlho slúži ako brána medzi Európou a Balkánom.<br><br>V rokoch 847 až 871 n. l. bolo Bari hlavným mestom vlastného krátkodobého islamského emirátu, jediného tohto druhu na talianskom pevninskom území."

	key[]: "it_cut_etna_desc"
	val[]: "Sopka Etna, nachádzajúca sa na východnom pobreží Sicílie, je najvyššou aktívnou sopkou v Európe a jednou z najaktívnejších sopiek na Zemi.<br><br>Jej názov sa zvyčajne odvodzuje od gréckeho slova „Aitnē“, ktoré pochádza zo slova „aithō“ a znamená „horím“."

	key[]: "it_cut_neapol_desc"
	val[]: "Prístav v Neapole, založený v areáli starovekej gréckej osady Neapolis, patrí medzi najstaršie a najrušnejšie prístavy v Taliansku.<br><br>Pri výkopových prácach na stanici metra v blízkosti dnešného neapolského prístavu archeológovia odkryli staroveký prístav a sedem vrakov lodí z helenistického a rímskeho obdobia."

	key[]: "it_cut_sassari_desc"
	val[]: "Kostol Santa Maria di Betlem v meste Sassari na Sardínii je františkánsky komplex, ktorého počiatky siahajú do 12. storočia.<br><br>Každý august počas slávnosti Candelieri cechy z Sassari prinášajú do kostola obrovské drevené „sviečky“ vážiace stovky kilogramov, čím obnovujú starobylý sľub spojený s morovou epidémiou."

	key[]: "it_cut_taranto_desc"
	val[]: "Taranto je mesto na juhu Talianska pri Iónskom mori, ktoré okolo roku 706 pred n. l. založili spartskí kolonisti ako grécke mesto Taras.<br><br>V priemyselnom zálive v Tarante žije početná populácia delfínov – vrátane delfínov pruhovaných, ktorých genetické znaky sa nikde inde v Stredozemnom mori nevyskytujú."

	key[]: "it_cut_villa_san_giovanni_desc"
	val[]: "Villa San Giovanni je kalábrijské mesto na pevnine Talianska a hlavný trajektový terminál spájajúci Sicíliu cez Messinský prieliv.<br><br>Villa San Giovanni založil podnikateľ v oblasti výroby hodvábu Rocco Antonio Caracciolo, ktorý zjednotil päť konkurenčných osád. Kráľ Ferdinand IV. z Neapola novému mestu v roku 1791 oficiálne udelil meno."

	key[]: "balt_cut_castles_desc"
	val[]: "Hrad Hermann založili Dáni v 13. storočí a neskôr ho prestaval Livonský rád. Pevnosť Ivangorod založil Ivan III. v roku 1492 na obranu západnej hranice Moskovského kniežatstva."

	key[]: "balt_cut_convent_desc"
	val[]: "Toto mesto, ktoré v roku 1447 založil svätý Eufrosynus severne od Pskova, sa postupne vyvinulo na významné vzdelávacie centrum."

	key[]: "balt_cut_daugavpils_desc"
	val[]: "Druhé najväčšie mesto Lotyšska vzniklo z hradu Dinaburg, ktorý v roku 1275 založil Livonský rád na brehu rieky Daugava.<br><br>Mesto malo najmenej štyri rôzne názvy, medzi nimi Dinaburg, Borisoglebsk a Dvinsk, než sa v roku 1920 premenovalo na Daugavpils."

	key[]: "balt_cut_klaipeda_desc"
	val[]: "Klaipėda, jediný veľký litovský prístav, bola založená v 50. rokoch 13. storočia Livonským rádom, ktorý bol odnožou Teutónskeho rádu.<br><br>Približne 500 rokov nebolo mesto nikdy pod správou litovského štátu a súčasťou Litvy sa stalo až po povstaní v roku 1923."

	key[]: "balt_cut_riga_power_plant_desc"
	val[]: "Hrádza, postavená na rieke Daugava v rokoch 1966 až 1975, vytvorila vodnú nádrž zatopením polovice ostrova Doles sala.<br><br>Horná časť hrádze slúži zároveň ako verejná cesta, pričom železničná trať z čias výstavby, ktorá ju kedysi križovala, bola neskôr demontovaná."

	key[]: "balt_cut_valmiera_desc"
	val[]: "Olympijské centrum Vidzeme vo Valmiere je multifunkčná hala s rozlohou takmer 2 900 metrov štvorcových, ktorá slúži na basketbal a florbal.<br><br>Rodák z Valmiere, chodec Jānis Daliņš, získal prvú letnú olympijskú medailu nezávislého Lotyšska – striebro v chôdzi na 50 kilometrov na olympijských hrách v Los Angeles v roku 1932 – a mestský štadión dnes nesie jeho meno."

	key[]: "blke_cut_cerna_voda_desc"
	val[]: "Most Anghela Salignyho v Cernavode, dokončený v roku 1895, bol kedysi s dĺžkou vyše štyroch kilometrov najdlhším mostom v Európe.<br><br>V roku 1916 ustupujúce rumunské jednotky poškodili most cez Dunaj a zničili jeho úsek v Borcei. Oba úseky boli obnovené a v roku 1987 ich nahradil nový most."

	key[]: "blke_cut_edirne_desc"
	val[]: "Edirne bolo hlavným mestom Osmanskej ríše takmer celé storočie, kým v roku 1453 nebol dobytý Konštantínopol.<br><br>Na festivale olejového zápasu Kirkpinar v Edirne, ktorý sa koná už od 14. storočia, sa zápasníci polievajú takmer dvoma tonami olivového oleja a tento festival drží Guinnessov rekord ako najstaršia športová súťaž."

	key[]: "blke_cut_orsova_desc"
	val[]: "Oršova je mesto na Dunaji v juhozápadnom Rumunsku, ktoré leží tesne nad roklinou Železné vráta, neďaleko miesta, kde sa rieka Cerna vlieva do Dunaja.<br><br>V dôsledku výstavby priehrady Železné vráta I sa hladina Dunaja zvýšila približne o 30 metrov, čo v roku 1970 zaplavilo starú Oršovu. Jej obyvatelia boli presídlení do úplne nového mesta, ktoré bolo vybudované na vyššom teréne v rokoch 1966 až 1971."

	key[]: "blke_cut_pernik_desc"
	val[]: "V meste Pernik, uhoľnom meste neďaleko Sofie, sa od roku 1953 nachádza veľký oceliarsky závod.<br><br>Závod vyrába väčšinu ocele z recyklovaného šrotu, čím patrí medzi závody v regióne, ktoré najviac prispievajú k cirkulárnej ekonomike."

	key[]: "blke_cut_poiana_viaduct_desc"
	val[]: "Viadukt Poiana Teiului je 634 metrov dlhý cestný most, ktorý preklenuje zadnú časť jazera Bicaz v Rumunskej župe Neamț."

	key[]: "blke_cut_r73_desc"
	val[]: "Piatra Craiului je 25-kilometrový vápencový hrebeň v rumunských Karpatoch, ktorý je od roku 1990 chránený ako národný park.<br><br>Jeho názov znamená „Kráľova skala“ a v parku žije niekoľko endemických druhov bezstavovcov."

	key[]: "ibe_cut_barcelona_desc"
	val[]: "Barcelona vznikla ako rímska osada Barcino, ktorej staroveké ruiny sa dodnes nachádzajú pod ulicami moderného mesta.<br><br>Sedem z deviatich barcelonských pamiatok zapísaných na zozname svetového dedičstva UNESCO tvoria diela architekta Antonia Gaudího, vrátane nedokončenej katedrály Sagrada Família."

	key[]: "ibe_cut_ejido_desc"
	val[]: "V meste El Ejido, ktoré leží v oblasti Campo de Dalías v provincii Almería, sa nachádza jedna z najväčších koncentrácií poľnohospodárskych skleníkov na svete.<br><br>Skleníky v almeríjskej oblasti známej ako „Plastové more“ sa rozprestierajú na ploche 370 štvorcových kilometrov a odrážajú toľko slnečného svetla, že ich astronauti dokážu rozoznať aj z obežnej dráhy."

	key[]: "ibe_cut_guadiana_desc"
	val[]: "Medzinárodný most cez rieku Guadiana je visutý most spájajúci mesto Ayamonte v Španielsku a mesto Castro Marim v Portugalsku na najjužnejšom hraničnom priechode.<br><br>Pri prechode cez most prekročíte aj hranicu časového pásma, takže cestujúci zo Španielska do Portugalska môžu zažiť dva odlišné silvestrovské odpočty."

	key[]: "ibe_cut_lisboa_desc"
	val[]: "Most 25. apríla(Ponte 25 de Abril)  preklenuje rieku Tejo a spája Lisabon s Almadou; patrí medzi najdlhšie visuté mosty v Európe."

	key[]: "ibe_cut_olhao_desc"
	val[]: "Olhão je na bielo vymaľované rybárske mestečko na portugalskom pobreží Algarve, ktoré priamo susedí s lagúnou Ria Formosa.<br><br>Legenda hovorí, že v roku 1808 sedemnásť rybárov z Olhãa doplávalo na otvorenej loďke až do Brazílie len preto, aby exilovanému portugalskému kráľovi oznámili, že ich krajina je slobodná."

	key[]: "ibe_cut_reservoir_desc"
	val[]: "Vodná nádrž Barrios de Luna v provincii León vznikla v roku 1956, keď priehrada zatarasila rieku Luna v úzkej horskej rokline.<br><br>Naplnením nádrže bolo zatopených šestnásť dedín a osád, ktoré sa teraz nachádzajú pod vodou, ktorá sa tiahne údolím v dĺžke približne 40 kilometrov."

	key[]: "ibe_cut_santander_desc"
	val[]: "Prístav v Santanderi sa nachádza v pešej vzdialenosti od centra mesta.<br><br>Tento chránený prístav v Santanderi, ktorý založili Rimania po kantabrijských vojnách v roku 19 pred n. l., slúžil spočiatku ako centrum vývozu nerastných surovín a rozvíjal sa spolu s mestom, na ktorého vzniku sa podieľal."

	key[]: "ibe_cut_zaragoza_desc"
	val[]: "Jeden z najväčších nákupných a zábavných komplexov v Európe s rozlohou vyše 200 000 metrov štvorcových.<br><br>Tento komplex, vybudovaný okolo umelého jazera, spája nákupné centrum s reštauráciami, kinami, športovými zariadeniami a rekreačnými zónami."

	key[]: "sc_cut_mabodalen_desc"
	val[]: "Måbødalen je strmé údolie vytvorené ľadovcom neďaleko mesta Eidfjord v západnom Nórsku, kde sa nachádza vodopád Vøringsfossen.<br><br>S úchvatným voľným pádom z výšky 145 metrov do hlbín Måbødalenu je Vøringsfossen najznámejším nórskym vodopádom, ktorý láka návštevníkov, aby boli svedkami jeho ohromujúcej sily."

	key[]: "sc_cut_stockholm_desc"
	val[]: "Pobrežie Štokholmu ústi do súostrovia pozostávajúceho z približne 30 000 ostrovov, ostrovčekov a útesov, ktoré sa tiahne do Baltského mora.<br><br>Nemaľované vozne metra Silverpilen v Štokholme, ktoré boli uvedené do prevádzky v roku 1965, inšpirovali mestskú legendu o vlaku duchov, ktorý sa objavuje o polnoci a spôsobuje, že každý cestujúci, ktorý do neho nastúpi, zmizne."

	key[]: "sc_cut_kalmar_desc"
	val[]: "Kalmar je historické prístavné mesto v juhovýchodnom Švédsku, ktoré sa prvýkrát spomína v 11. storočí a nachádza sa v ňom renesančný hrad.<br><br>Kalmarský hrad počas svojej histórie odolal 22 obliehaniam, pričom ho nikdy nedobyli útokom."

	key[]: "sc_cut_copenhagen_desc"
	val[]: "Kodaň je hlavné mesto Dánska, rozprestierajúce sa okolo historického prístavu lemovaného kanálmi, vežami a pešími ulicami.<br><br>V kodaňských Tivoli Gardens sa nachádza najstaršia fungujúca horská dráha v Európe, Rutschebanen, ktorá poskytuje návštevníkom vzrušujúce zážitky už od roku 1914."

	key[]: "blkw_cut_durdevica_desc"
	val[]: "V Národnom parku Durmitor v Čiernej Hore, ktorý je zapísaný na zozname svetového dedičstva UNESCO a je známy svojimi drsnými horami, ľadovcovými jazerami a kaňonom rieky Tara, sa nachádza tento betónový most s piatimi oblúkmi, dokončený v roku 1940, ktorý sa týči viac ako 150 metrov nad riekou.<br><br>Dnes je to jedno z najobľúbenejších miest na zjazdy na lanovej dráhe na Balkáne."

	key[]: "blkw_cut_durres_desc"
	val[]: "Durrës, založený v roku 627 pred n. l. ako grécka kolónia Epidamnus, je najstarším a najrušnejším prístavom v Albánsku.<br><br>Rimania z neho urobili západný koniec Via Egnatia, svojej veľkej cesty vedúcej až do Solúna."

	key[]: "blkw_cut_pristina_desc"
	val[]: "Priština, hlavné mesto Kosova, leží v blízkosti zrúcanín starovekej Ulpiany a je osídlená už od neolitu.<br><br>V 13. storočí bola Priština dôležitým kráľovským a obchodným centrom v rámci stredovekého srbského štátu, než sa po roku 1389 postupne presadila osmanská nadvláda."

	key[]: "blkw_cut_split_desc"
	val[]: "Nábřeží v Splite dominuje Diokleciánov palác a zvonica katedrály sv. Domnia. Celé staré mesto vyrástlo vnútri palácových múrov.<br><br>Rímsky cisár Dioklecián sa uchýlil do Splitu a pestovaniu kapusty sa venoval tak intenzívne, že odmietol prosby o návrat na trón s tým, že jeho zelenina je pre neho dôležitejšia."

	key[]: "blkw_cut_bihac_desc"
	val[]: "V historickom centre mesta Bihać sa nachádza zachovaná zvonica kostola sv. Antona, Kapitánska veža a kamenné mauzóleum Turbe. Kapitánska veža neskôr slúžila ako rakúsko-uhorská väznica. Kostol bol v roku 1944 z veľkej časti zničený bombardovaním spojeneckých síl.<br><br>Všetky tri pamiatky stoja len pár metrov od seba a odzrkadľujú kresťanskú, osmanskú a rakúsko-uhorskú minulosť mesta Bihać."

	key[]: "blkw_cut_sarajevo_desc"
	val[]: "Je to najstaršia a historicky najvýznamnejšia časť Sarajeva. Jej srdcom je Baščaršija, sarajevská bazárová štvrť z obdobia Osmanskej ríše, ktorú v roku 1462 založil guvernér Isa-beg Isaković.<br><br>Sarajevská radnica, známa ako Vijećnica, je významná budova z obdobia Rakúsko-Uhorska, ktorú v neomaurskom štýle navrhol český architekt Karel Pařík."

	key[]: "blkw_cut_ljubljana_desc"
	val[]: "Ľubľana, hlavné mesto Slovinska, vznikla na brehoch rieky Ľubľanice na mieste bývalého rímskeho osídlenia Emona.<br><br>Podľa legendy Jason a Argonauti zabili draka presne na mieste, kde dnes stojí Ľubľana, a táto príšera dodnes kraľuje na mestskom erbe."

	key[]: "blkw_cut_tirana_desc"
	val[]: "Tirana bola založená v roku 1614 osmanským vládcom Sulejmanom Bargjinim. V roku 1920 sa stala dočasným hlavným mestom Albánska a v roku 1925 jej trvalým hlavným mestom.<br><br>Kthesa e Kamzës, jedna z hlavných západných dopravných križovatiek Tirany, spája hlavné mesto s Kamëzom a trasami smerujúcimi na sever a západ."

	key[]: "blkw_cut_prokuplje_desc"
	val[]: "Prokuplje, sídlo okresu Toplica v južnom Srbsku, má svoje korene v osade Hammeum z rímskej doby.<br><br>Mesto dalo meno odrode Prokupac, červenej vínnej odrode, ktorá sa v tejto oblasti pestuje už od stredoveku."

	key[]: "gr_cut_piraeus_desc"
	val[]: "Pireus je hlavný aténsky prístav a jeden z najväčších osobných prístavov v Stredozemnom mori.<br><br>Budova Silo bola pôvodne postavená na skladovanie obilia. Dnes sa premenila na Múzeum podmorských pamiatok, v ktorom budú vystavené archeologické nálezy získané z gréckych morí."

	key[]: "gr_cut_kavala_desc"
	val[]: "Kavala je historické prístavné mesto na severe Grécka, založené na konci 7. storočia pred n. l. pod názvom Neapolis.<br><br>Tento kopec bol opevnený už najmenej od 5. storočia pred n. l. Súčasná pevnosť v Kavale je prevažne osmanského pôvodu a bola prestavaná v roku 1425 na mieste pôvodných byzantských opevnení."

	key[]: "gr_cut_kalabaka_desc"
	val[]: "Meteora je súbor kláštorov zapísaných na zozname svetového dedičstva UNESCO, ktoré sa týčia na vrcholkoch pieskovcových skalných stĺpov neďaleko Kalabaky.<br><br>Po celé stáročia mnísi vyťahovali návštevníkov na 400-metrové útesy v hojdajúcej sa lanovej sieti a žartovali, že ju vymenili len vtedy, keď sa roztrhla."

	key[]: "gr_cut_beach_desc"
	val[]: "Faliraki je prímorské letovisko na severovýchodnom pobreží ostrova Rhodos, približne 14 kilometrov južne od mesta Rhodos, známe svojou dlhou pieskovou plážou.<br><br>Faliraki patrí medzi najobľúbenejšie letoviská na ostrove Rhodos, pokiaľ ide o vodné športy, od jazdy na vodných skútroch až po parasailing vysoko nad zátokou."

	key[]: "gr_cut_lixouri_desc"
	val[]: "Lixouri je druhé najväčšie mesto na ostrove Kefalónia, vybudované na polostrove Paliki v blízkosti miesta, kde kedysi stálo staroveké mesto Pale."

	key[]: "gr_cut_corinth_desc"
	val[]: "Korintský prieplav prechádza cez Korintskú šiju a spája Egejské more s Korintským zálivom prostredníctvom 6,4 kilometra dlhého kanála.<br><br>Rímsky cisár Nero osobne zahájil výstavbu prieplavu v roku 67 n. l., takmer 1 800 rokov predtým, než bol v roku 1893 konečne dokončený."

	key[]: "gr_cut_souda_desc"
	val[]: "Zátoka Souda neďaleko mesta Chania na Kréte patrí medzi najväčšie a najhlbšie prírodné prístavy v Stredozemnom mori.<br><br>Pri vchode do zátoky Benátčania v 16. storočí opevnili malý ostrovček Souda; jeho pevnosť odolala osmanským vojskám a zostala v benátskom držaní až do roku 1715, teda ešte desaťročia po tom, ako v roku 1669 padol zvyšok Kréty ."

	key[]: "gr_cut_polyfytos_desc"
	val[]: "Most Polyfytos preklenuje umelé jazero Polyfytos na rieke Aliakmon, najdlhšej rieke Grécka, neďaleko mesta Kozani.<br><br>Tento most s dĺžkou 1 372 metrov, dokončený v roku 1975, navrhol renomovaný taliansky inžinier Riccardo Morandi."

	key[]: "poc_cut_alesund_desc"
	val[]: "Ålesund je dôležitým nórskym prístavným mestom pre výletné lode.<br><br>Nemecký cisár Viliam II., ktorý toto mesto už predtým navštívil, poslal vojenské lode so stavebnými materiálmi, aby pomohol pri jeho obnove po ničivom požiari, ktorý v roku 1904 zničil takmer celé drevené mesto."

	key[]: "poc_cut_bodo_desc"
	val[]: "Bodø je pobrežné mesto severne od polárneho kruhu, ktoré bolo v roku 2024 vyhlásené za Európske hlavné mesto kultúry."

	key[]: "poc_cut_nordkapp_desc"
	val[]: "Severný mys je 307-metrová skalnatá plošina na ostrove Magerøya, ktorá sa vo verejnosti prezentuje ako najsevernejší bod kontinentálnej Európy.<br><br>Severný mys však v skutočnosti nie je najsevernejším bodom Európy – neďaleký výbežok Knivskjellodden sa tiahne asi o 1 450 metrov ďalej na sever."

	key[]: "poc_cut_santa_desc"
	val[]: "Santova dedina leží presne na polárnom kruhu, približne osem kilometrov severne od Rovaniemi, a je otvorená celoročne.<br><br>Návštevníci môžu stáť na namaľovanej čiare označujúcej polárny kruh a získať oficiálny certifikát potvrdzujúci, že ho prekročili."

	key[]: "poc_cut_muotkatakka_desc"
	val[]: "Muotkatakka, nachádzajúca sa približne 12 kilometrov južne od Kilpisjärvi, je s nadmorskou výškou 565,8 metra najvyšším bodom celej fínskej verejnej cestnej siete.<br><br>Cesta cez tento horský priechod spája Fínsko s Nórskom a v blízkosti vrcholu je bežné vidieť sobov, ako sa potulujú popri ceste."

	key[]: "poc_cut_farm_desc"
	val[]: "Tohmajärvi je malá obec s zalesnenými kopcami a jazerami v severnej Karélii, neďaleko východnej hranice Fínska s Ruskom.<br><br>V jej erbe sú vyobrazené kovadlina a plameň, ktoré pripomínajú kedysi významný železiarsky priemysel v tomto regióne."

	key[]: "poc_cut_viitasaari_desc"
	val[]: "Viitasaari je mesto v strednom Fínsku, ktoré je posiate jazerami; na území obce sa nachádza približne 230 jazier.<br><br>Letný hudobný festival vo Viitasaari sa každoročne začína sprievodom traktorov, ktoré prechádzajú mestom ešte pred koncertmi."

	key[]: "poc_cut_lalby_desc"
	val[]: "Lålby je malá osada v rámci obce Kristinestad v regióne Ostrobothnia na západnom pobreží Fínska."

	key[]: "poc_cut_kiruna_desc"
	val[]: "Kiruna je najsevernejšie mesto Švédska, vybudované okolo Kirunavaary, najväčšej podzemnej bane na železnú rudu na svete.<br><br>Ložisko železnej rudy sa vynorilo z hĺbky dvoch kilometrov približne pred 1,6 miliardami rokov a dnes táto baňa dodáva približne 80 percent železnej rudy do EÚ."

	key[]: "poc_cut_gavle_desc"
	val[]: "Gävle je prístavné mesto na východnom pobreží Švédska pri ústí rieky Gavleån v regióne Gästrikland.<br><br>Každý advent od roku 1966 mesto stavia obrovskú vianočnú kozu zo slamy, ktorú podpaľači už viac ako 30-krát podpálili."

	key[]: "poc_cut_lulea_desc"
	val[]: "Mesto Luleå, hlavné mesto kraja Norrbotten, leží pri Botnickom zálive a zahŕňa súostrovie s viac ako 1 300 ostrovmi.<br><br>Veľká technologická spoločnosť vybudovala v Luleå obrovské dátové centrum práve preto, že krutá arktická zima slúži ako bezplatná, prírodná klimatizácia pre jej servery."

	key[]: "poc_cut_heia_desc"
	val[]: "Malebné odpočívadlo na diaľnici E6 v Balsfjorde v kraji Troms, z ktorého sa v nadmorskej výške približne 240 metrov naskytuje výhľad na hory."

	key[]: "poc_cut_svolvaer_desc"
	val[]: "Svolvær, ležiace na ostrove Austvågøya, je najväčším mestom a neoficiálnym hlavným mestom nórskeho súostrovia Lofoty."

	key[]: "poc_cut_bjornfjell_desc"
	val[]: "Bjørnfjell je horská stanica na železničnej trati Ofoten, ktorá sa nachádza priamo na nórsko-švédskej hranici neďaleko Narviku.<br><br>Vzhľadom na to, že leží tak vysoko v horách, je stanica Bjørnfjell počas väčšiny roka často pokrytá snehom a táto železničná trať je považovaná za jednu z najmalebnejších železničných tratí v severnej Európe."

	key[]: "poc_cut_trondheim_desc"
	val[]: "Mesto Trondheim, založené okolo roku 997 pod názvom Kaupangr a neskôr známe ako Nidaros, bolo počas vikingskej éry hlavným mestom Nórska.<br><br>Katedrála v Nidarose, postavená nad hrobom svätého Olava, je najsevernejšou stredovekou gotickou katedrálou na svete."

	key[]: "is_cut_thingvellir_desc"
	val[]: "Národný park Þingvellir leží v riftovej doline medzi severoamerickou a eurázijskou tektonickou platňou. V roku 2004 bol zaradený na zoznam svetového dedičstva UNESCO.<br><br>Islandský parlament, Alþingi, sa tu po prvýkrát zišiel pod holým nebom v roku 930, čím sa stal jedným z najstarších parlamentov na svete."

	key[]: "is_cut_barthastran_desc"
	val[]: "Cesta Barðastrandarvegur (č. 62) vedie pozdĺž pobrežia Barðaströnd v južnej časti západných fjordov, po severnom brehu širokého zálivu Breiðafjörður.<br><br>Viking Hrafna-Flóki Vilgerðarson strávil na tomto pobreží zimu a keď z neďalekej hory uvidel fjord plný ľadových krýh, dal celej krajine meno: Ľadová krajina (Ísland)."

	key[]: "is_cut_lagoon_desc"
	val[]: "Toto kúpeľné stredisko s geotermálnou lagúnou sa nachádza v lávovom poli na polostrove Reykjanes, kde sa návštevníci oddávajú relaxácii v mliečno-modrej vode s priemernou teplotou 37–39 °C.<br><br>Lagúna je umelo vytvorená: kúpeľné stredisko bolo založené s cieľom využiť teplú odpadovú vodu z neďalekej geotermálnej elektrárne, ktorá bola otvorená v roku 1976."

	key[]: "is_cut_selfoss_desc"
	val[]: "Selfoss je najväčšie mesto na juhu Islandu. Vzniklo na brehoch rieky Ölfusá, nad ktorou bol v roku 1891 postavený prvý visutý most.<br><br>Od roku 2011 patrí Selfoss medzi miesta, kde sa koná súťaž „Najsilnejší muž Islandu“, v rámci ktorej siláci zdvíhajú balvany a ťahajú ťažké nákladné autá."

	key[]: "is_cut_seljaland_desc"
	val[]: "Seljalandsfoss je 60-metrový vodopád na juhu Islandu, ktorý napája rieka prameniaca z ľadovcovej sopky Eyjafjallajökull.<br><br>Chodník vedie priamo za padajúcu vodu do malej jaskyne, takže návštevníci môžu vodopád pozorovať zvnútra."

	key[]: "is_cut_geyser_desc"
	val[]: "Strokkur, nachádzajúci sa v geotermálnej oblasti Haukadalur, je najaktívnejší gejzír na Islande, ktorý vybuchuje každých pár minút.<br><br>Jeho sused, Veľký gejzír(Stóri Geysir), dal meno všetkým gejzírom na svete; názov pochádza z islandského slovesa „geysa“, čo znamená „rýchlo sa pohybovať dopredu“."

	key[]: "is_cut_gullfoss_desc"
	val[]: "Gullfoss, známy aj ako „Zlatý vodopád“, je vodopád na rieke Hvítá, ktorý sa zosúva v dvoch stupňoch s výškou 11 a 21 metrov do 32 metrov hlbokej priepasti.<br><br>Keď zahraniční investori chceli vodopád využiť na výrobu elektriny, dcéra miestneho farmára Sigríður Tómasdóttir sa zasadila za jeho ochranu. Nad vodopádom stojí kamenný pamätník na jej počesť."

	key[]: "is_cut_joekul_desc"
	val[]: "Jökulsárlón je ľadovcová lagúna na úpätí ľadovca Breiðamerkurjökull, ktorý je výtokovým ľadovcom rozsiahlej ľadovej čiapky Vatnajökull.<br><br>Lagúna sa začala formovať až v 30. rokoch 20. storočia v dôsledku ustupovania ľadovca a so svojou hĺbkou vyše 280 metrov je dnes najhlbším jazerom na Islande."

	key[]: "is_cut_gothafoss_desc"
	val[]: "Goðafoss je 12 metrov vysoký a 30 metrov široký vodopád na rieke Skjálfandafljót na severe Islandu.<br><br>Jeho názov sa zvyčajne prekladá ako „vodopád bohov“, hoci môže pochádzať aj od dvoch skál pri vodopáde, ktoré pripomínajú pohanské modly."

	key[]: "is_cut_canyon_desc"
	val[]: "Stuðlagil je kaňon v údolí Jökuldalur na východe Islandu, ktorého steny pozdĺž rieky Jökla tvoria vysoké šesťhranné bazaltové stĺpy.<br><br>Kaňon bol skrytý pod vodou, kým priehrada Kárahnjúkar, dokončená v roku 2009, neznížila hladinu rieky, a preslávil sa až v roku 2016, keď ho na verejnosti zverejnil fotograf."
#@}

