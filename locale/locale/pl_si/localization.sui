	key[]: "mp_warning_on_job"
	val[]: "Masz już zlecenie. Najpierw musisz je anulować, aby wziąć nowe."

	key[]: "mp_warning_trailer"
	val[]: "Twoja obecna naczepa nie jest kompatybilna z tym ładunkiem. Zmień naczepę lub użyj dostarczonego wyposażenia."

	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "Obecnie dostarczasz zlecenie do firmy, która jest nieaktywna w tej sesji.<br>Jeśli chcesz się połączyć, najpierw dostarcz swoje zlecenie, w przeciwnym razie zostanie ono zawieszone i będzie niedostępne na czas tej sesji.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Obecnie realizujesz zlecenie dla firmy, która jest nieaktywna w tej sesji.<br>Jeśli chcesz nawiązać połączenie, najpierw dostarcz swoje zlecenie, w przeciwnym razie zostanie ono anulowane.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Aby móc dołączyć do tej sesji, musisz aktywować firmę znajdującą się w pobliżu Twojej ciężarówki lub naczepy.<br>Aby uniknąć problemów, przemieść ciężarówkę i naczepę dalej od firmy. W przeciwnym razie Twoje bieżące zlecenie zostanie zawieszone i będzie niedostępne w tej sesji, a Ty zostaniesz przeniesiony do najbliższego serwisu.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Aby móc dołączyć do tej sesji, musisz aktywować firmę znajdującą się w pobliżu Twojej ciężarówki lub naczepy.<br>Aby uniknąć problemów, przesuń ciężarówkę i naczepę dalej od firmy. W przeciwnym razie Twoje bieżące zlecenie zostanie anulowane, a Ty zostaniesz przeniesiony do najbliższego serwisu.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Aby móc dołączyć do tej sesji, musisz aktywować firmę znajdującą się w pobliżu miejsca, w którym zostawiłeś ciężarówkę lub naczepę przed zaakceptowaniem szybkiego zlecenia.<br>Aby uniknąć jakichkolwiek problemów po powrocie do ciężarówki, szybkie zlecenie musi zostać anulowane, a Ty zostaniesz przeniesiony do najbliższego serwisu.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Wybrane przez Ciebie zlecenie jest dostarczane do lub z firmy, która jest nieaktywna w tej sesji i nie będzie dostępna po nawiązaniu połączenia.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Twój ładunek znajduje się w firmie, która jest nieaktywna w tej sesji.<br>Jeśli chcesz się połączyć, załaduj swój ładunek, w przeciwnym razie Twoje bieżące zlecenie zostanie zawieszone i będzie niedostępne w tej sesji.<br><br>Czy chcesz kontynuować?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Twoje zlecenie zostało anulowane, ponieważ było dostarczane do firmy, która jest nieaktywna w tej sesji."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Your job was canceled as spacial jobs are not supported in convoy."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Wybrane przez Ciebie zlecenie nie jest już dostępne, ponieważ pochodziło od firmy, która jest nieaktywna w tej sesji."

	key[]: "mp_warning_load_teleport"
	val[]: "Twoja ciężarówka została teleportowana do najbliższego serwisu, ponieważ zapisana lokalizacja znajdowała się zbyt blisko firmy, którą aktywowano w ramach tej sesji."

	key[]: "mp_warning_load_cancel_teleport"
	val[]: "Twoje zlecenie zostało anulowane, ponieważ dostarczano je do firmy, która jest nieaktywna w tej sesji.<br>Ponadto Twoja ciężarówka została teleportowana do najbliższego serwisu, ponieważ zapisana lokalizacja znajdowała się zbyt blisko firmy, która została aktywowana tak, aby pasowała do tej sesji."

	key[]: "mp_warning_load_unavailable_teleport"
	val[]: "Wybrane przez Ciebie zlecenie nie jest już dostępne, ponieważ pochodziło od firmy, która jest nieaktywna w tej sesji.<br>Ponadto Twoja ciężarówka została przeniesiona do najbliższego serwisu, ponieważ zapisana lokalizacja znajdowała się zbyt blisko firmy, która została aktywowana tak, aby pasowała do tej sesji."

