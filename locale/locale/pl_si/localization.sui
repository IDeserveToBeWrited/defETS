#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Zbiōr je za srogi. Sprōbuj zmiynić rozdzielczojś." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Zbiōr je felerny abo niypodpiyrany." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Rozdzielczojś spamiyntaniŏ je za srogŏ. Sprōbuj jã zmiynić." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Serwis niy przijōn zbioru." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "To kōnto niy moge wysyłać spamiyntań ekranu." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Coś inkszego bōło wysyłane do tego samego slotu." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Wysyłaniy je terŏz zastŏwiōne. Sprōbuj niyskorzij." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Niyznōmy feler przi wysyłaniu. Sprōbuj niyskorzij." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Spamiyntaniy ekranu je srogsze aniżeli maksymalne $LIMIT$ i bōło zmyńszōne." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Spamiyntaniy ekranu je srogsze aniżeli maksymalne $LIMIT$KB i bōło zmyńszōne." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

