#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "LADUJ SZPIL"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Laduj szpil" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Ladowanie przōdzij spamiyntanygo szpilu. Stracisz cołki progres!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Na isto chcesz zaladować inkszy szpil?<br><br>Stracisz swōj aktualny progres jeźli niy spmiyntŏsz go zawczasu."

	key[]: "load_progress_lost_mp"
	val[]: "Czy na pewno chcesz wczytać inny zapis gry?\\?<br>]W przypadku wczytania innego zapisu gry w trybie wieloosobowym może to skutkować anulowaniem lub zawieszeniem zlecenia, teleportacją do najbliższego serwisu lub niedostępnością wybranego zlecenia.<br><br>Twoje bieżące postępy zostaną utracone, chyba że zostały wcześniej zapisane."

	key[]: "load_game_mp_suspended_job"
	val[]: "Zapisano pomyślnie, ale aktywne zlecenie z World of Trucks zostało zawieszone i jest niedostępne podczas tej sesji."

	key[]: "autosave"
	val[]: "- Autospamiyntanie -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Wartke spamiyntanie -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Pokŏż autospamiyntania" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Nie znaleziono ręcznych zapisów." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Laduj" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Niekompatybilny zapis gry!<br><color value=@@clr_txt@@>Spróbuj zaktualizować grę do najnowszej dostępnej wersji." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nie udało się wczytać i wyświetlić wszystkich plików zapisu dla tego profilu." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "POZŌR" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problym z ladowaniym spamiyntaniŏ.<color value=@@clr_txt@@><br><br>Niy szło zaladować spamiyntaniŏ. Mogesz sprōbować zidyntyfikować i sprŏwić niyprzileżytość przi użyciu informacyjōw niżyj. Mogesz tyż sprōbować zaladować inksze spamiyntaniy.<br><br>Skuli tych prziczyn mōg sie pokŏzać problym:<br><br>1. Spamiyntaniy niyma kōmpatybilne z niykerymi modami.<br><br>2. W spamiyntaniu sōm informacyje z modōw, kere sōm zastawiōne abo niy mŏsz ich zainstalowanych.<br><br>3. Spamiyntaniy je felerne skuli użyciŏ źle złōnaczōnygo moda.<br><br>4. Hyngniyńciy kōmputra podczŏs abo zarŏz po zapisie mogły zepsuć spamiyntaniy."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Chybiŏ moda<color value=@@clr_txt@@><br><br>We ôstatnim spamiyntaniu sōm zależności z moda, kerego niy ma w systymie abo je zastawiōny.<br><br>Jeźli żeś tego niy ôczekiwoł, to sprŏwdź stan swojich modōw.<br><br>Mogesz tyż sprōbować zaladować spamiyntaniy. Zależnie ôd tego, co mod zmiyniył, je możebne, iże ladowaniy sie niy podarzi abo bydōm inksze niyprzileżytości.<br><br>Mogesz tyż sprōbować zaladować inksze spamiyntaniy, kere niy bydzie zależne ôd modōw, kerych chybiŏ."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Chybiŏ opcjōnalnygo DLC.<color value=@@clr_txt@@><br><br>Ôstatnie spamiyntaniy zawiyrŏ zależności ze chybiajōncygo DLC (ôficjalnygo rozszyrzyniŏ gry).<br><br>Jeźli tego niy ôczekujesz, wejzdrzij na stan ôd DLC.<br><br>Mogesz tyż zaladować spamiyntaniy zuwizu, ale niykere funkcyje (te ôd DLC) bydōm stracōne.<br><br>Mogesz tyż zaladować inksze spamiyntaniy, kere niy zależy ôd chybiajōncygo DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Chybiŏ przidŏwki.<color value=@@clr_txt@@><br><br>We ôstatnim spamiyntaniu sōm zależności z pzidŏwki (oficjalnŏ przidŏwka gry).<br><br>Coby spamiyntaniy fungowało, przidŏwka musi być aktywnŏ w systymie.<br><br>Mogesz tyż sprōbować zaladować inksze spamiyntaniy, kere niy bydzie zależne ôd przidŏwki, keryj chybiŏ."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Mod zależy ôd przidŏwki.<color value=@@clr_txt@@><br><br>Nŏjmynij jedyn mod zależy ôd przidŏwki (oficjalnyj przidŏwki do gry), kerŏ niyma zainstalowanŏ.<br><br>Musisz zastawić mod(y) abo zainstalować przidŏwkã(i), ôd keryj zależy."

	key[]: "load_msg_crash"
	val[]: "+<color value=@@clr_red@@>Wykryty feler<color value=@@clr_txt@@><br><br>Zdŏwŏ sie, co gra hyngła sie przi ôstatnim ladowaniu.<br><br>Mogesz sprōbować zidyntyfikować i sprawić niyprzileżytość przi użyciu informacyjōw niżyj. Mogesz tyż sprōbować zaladować inksze spamiyntaniy.<br><br>Problymy nŏjczyńścij sōm skuli tych prziczyn:<br><br>1. Jedyn abo wiyncyj modōw je felernych abo niykōmpatybilnych z aktualnōm wersyjōm gry.<br><br>2. We grze sōm informacyje z modōw, kerych niy idzie znŏjś abo sōm zastawiōne.<br><br>3. Spamiyntaniy je sepsute skuli felernygo moda.<br><br>4. Rŏz za kedy feler masziny abo sterownikōw mōg dokludzić do problymu w grze."

	key[]: "mods_detected_warning"
	val[]: "Wykryte były mody gry. Pamiyntej, że zepsute, stare abo niykōmpatybilne mody gry mogōm być zdrzōdłym niystabilności. Wejdrzij na swoje aktywne mody we mynedżerze modōw." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

