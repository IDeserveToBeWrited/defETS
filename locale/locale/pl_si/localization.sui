#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Brakuje wymŏganego DLC (ôficjalne rozszerzynie gry) $DEPENDENCY_NAME$. Coby fōnkcyjŏ spamiyntowaniŏ fōngowała do porzōndku, to DLC musi być na tym kōmputrze i musi być aktywne. Musisz sprawić tyn problym zanim bydzie szło zaladować tyn stōn gry." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Brakuje ôpcjōnalnego DLC (ôficjalnego rozszerzyniŏ gry) $DEPENDENCY_NAME$. Jeźli tego niy ôczekujesz, wejzdrzij na sztand DLC.<br><br>Możesz tyż zuwizu zaladować sztand gry, ale czyńść fōnkcjōnalności, co jã dŏwŏ DLC, sie straci." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Brakuje moda $DEPENDENCY_NAME$ abo je zastawiōny. Jak tego niy ôczekujesz, wejzdrzij na stōn moda. Możesz sprōbować zaladować stōn tak czy tak, ale zależnie ôd tego, co tyn mod robiōł, je możliwe, że sie zepsuje abo prziniesie inksze problymy." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "MOD $DEPENDENCY_NAME$ je niykōmpatybilny ze Twojōm wersyjōm gry. To znaczy, że Autōr tego moda ôznaczōł go jako kōmpatybilny ino ze ôgraniczōnōm grupōm wersyji i terŏźnŏ wersyjŏ gry niyma postrzōd nich.<br><br>Rozwiōnzania:<br>- Sprōbuj znojś aktualnõ wersyjõ tego moda, co je napisanŏ do fōngowaniŏ ze terŏźnōm wersyjōm gry.<br>- Zaktualizuj abo prziwrōć starszõ wersyjõ gry do wersyje kōmpatybilnyj ze modym.<br><br>Możesz sprōbować zaladować stōn gry tak czy tak, ale mod niy bydzie zaladowany i, zależnie ôd tego, co ôn robi, ladowanie może sie niy podarzić abo prziniyść inksze problymy." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "BRAKUJŌM ZALEŻNOŚCI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "SZCZEGŌŁY" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Ôtwōrz strōnã Workshopu"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Tyn stōn gry zależy ôd DLC abo modōw, co sōm terŏz niydostympne. Ône sōm pokŏzane na spodku. Bez wybranie pozycyje na liście, możesz sie dowiedzieć wiyncyj ô danym elymyncie." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Tyn stōn zależy ôd nojmynij jednego DLC abo moda. Musisz sprawić problym zaczym zaladujesz tyn stōn." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

