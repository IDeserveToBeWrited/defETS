	key[]: "force_feedback_vibration_bumps"
	val[]: "Wibracja wybojów" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Wibracje kolizji" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

