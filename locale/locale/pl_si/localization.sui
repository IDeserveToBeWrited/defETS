#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Wybór motywów wyświetlanych w tle podczas przeglądania menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Umożliwia losowy wybór motywu tła przy każdym uruchomieniu gry."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Ustawia opóźnienie, po którym elementy pulpitu zanikają."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej opcji z czasem zaczniesz odczuwać skutki zmęczenia.<br><br>Unikanie odpoczynku będzie skutkować wykroczeniami drogowymi."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu musisz przestrzegać przepisów ruchu drogowego lub ryzykujesz popełnieniem wykroczeń drogowych. Ryzyko jest większe w pobliżu pojazdów policyjnych, radarów i kamer drogowych."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Dostosowuje średnią długość oferowanych zleceń."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Wybierz ograniczenie prędkości, które ma być wyświetlane na widżecie nawigacji."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Wartość aktualnej prędkości na nawigacji zmienia kolor na czerwony po przekroczeniu ograniczenia prędkości."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Po dotarciu do celu wyświetli się widget umożliwiający pominięcie parkowania."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Ukrywa wszystkie widżety."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Ukrywa oba lustra HUD."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Ukrywa wszystkie powiadomienia, nawet gdy zostaną odebrane."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Wyświetla okno pokazujące możliwości aktualnej ciężarówki gracza przed przyjęciem zlecenia przewozu ciężkiego ładunku."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Wybierz sposób ułożenia mapy świata."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Wybierz sposób odkrywania Mapy Świata:<br>- „Eksploracja zbliżeniowa” oznacza większy obszar jako odkryty.<br>- „Eksploracja precyzyjna” ujawnia jedynie obszary bezpośrednio wokół gracza."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Wybiera sposób wyświetlania nawigacji"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia sposób wyznaczania tras nawigacji. Tryb nawigacjji:<br>- „Najlepsza” wybiera najbardziej efektywny stosunek długości trasy do czasu jej pokonania, stara się unikać skrzyżowań z sygnalizacją świetlną itp.<br>- „Najkrótsza trasa” zawsze wybiera najkrótszą możliwą trasę.<br>- „Drogi drugorzędne” unika autostrad, gdziekolwiek to możliwe."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia poziom trudności parkowania:<br>- „Zawsze wybieraj” pozwala wybrać, kiedy dotrzesz do celu.<br>- „Bezpieczne parkowanie” nie wymaga manewrów cofania.<br>- „Skomplikowane parkowanie” zazwyczaj wymaga trudniejszego manewru cofania."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Dostosowuje prawdopodobieństwo napotkania zdarzeń drogowych w pobliżu, w tym wypadków, unieruchomionych pojazdów, gruzu drogowego itp."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Dostosowuje prawdopodobieństwo napotkania objazdu zmieniającego trasę podczas wykonywania zlecenia."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Dostosowuje prawdopodobieństwo wystąpienia złej pogody."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Wybierz, czy oprócz aktualnej godziny mają być wyświetlane informacje o strefie czasowej."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Enables in-game cutscenes typically displayed after truck purchases or garage upgrades or during passenger loading."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Wybierz, czy na drogach, do których nie można dojechać, mają być wyświetlane blokady półprzezroczyste."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Odwraca oś Y myszy podczas sterowania kamerą w grze."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Wybiera typ skrzyni biegów:<br>- „Prosty automat” umożliwia użycie pedału gazu i hamulca do sterowania ruchem do przodu i do tyłu. <br>- „Prawdziwy automat” wymaga sygnału wejściowego do przełączania między biegami do przodu i do tyłu.<br>- „Sekwencyjna” wymaga ręcznej zmiany wszystkich biegów za pomocą sygnałów wejściowych biegu w górę/w dół.<br>- „H-Shifter” wymaga użycia kontrolera z stopniami zmiany biegów do ręcznego wybierania biegów."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Włączenie tej funkcji umożliwi „pomijanie zmian biegów” – pomijanie biegów, gdy jest to konieczne lub praktyczne, aby uniknąć zmiany wszystkich biegów w skrzyni biegów."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Przywraca kierownicę do położenia środkowego podczas korzystania z klawiatury lub kontrolera.<br><br>Wyłączenie tej funkcji oznacza, że po wykonaniu skrętu będziesz musiał ręcznie ustawić kierownicę z powrotem na środku."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Reguluje zakres animacji kierownicy."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia intensywność hamowania."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia stabilność naczepy poprzez obniżenie jej środka ciężkości."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia sztywność zawieszenia podwozia."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia sztywność zawieszenia kabiny/miejsca sypialnego."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Dostosowuje intensywność proceduralnie generowanych nierówności powierzchni, aby nadać drogom i innym terenom wrażenie niedoskonałości.<br><br>W zależności od innych ustawień zawieszenia i kamery postrzegany efekt może być mniej lub bardziej widoczny."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Umożliwia zaawansowane sprzęganie, które wymaga większej precyzji, aby wyrównać siodło ciężarówki ze sworzniem królewskim naczepy.<br><br>Po wyłączeniu tej funkcji sprzęganie naczepy staje się znacznie łatwiejsze, ponieważ nie dochodzi do kolizji między sworzniem królewskim a siodłem."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera, czy i które kable naczepy mają być animowane.<br><br><color value=@@clr_txt_d@@>Włączenie okablowania w większej liczbie pojazdów może mieć wpływ na wydajność starszych systemów."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Włącza elektroniczny ogranicznik prędkości ciężarówki do 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>W przypadku zleceń World of Trucks ta funkcja jest włączona na stałe."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej funkcji i ustawieniu wycieraczek przedniej szyby w pierwszym położeniu, wycieraczki włączą się automatycznie i dostosują prędkość do panujących warunków."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Umożliwia automatyczne włączenie retardera podczas hamowania."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu tej opcji pojazd wspomaga ruszanie na wzniesieniu poprzez przytrzymanie hamulców, zapewniając płynny start."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Umożliwia automatyczne włączenie hamulca silnikowego podczas hamowania."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu tej opcji silnik uruchomi się natychmiast po naciśnięciu pedału gazu."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Automatycznie obniża podniesione osie, gdy jest to konieczne w zależności od wagi pojazdu."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu tej opcji pojazd będzie domyślnie utrzymywał mniejszy gaz. Po dwukrotnym szybkim naciśnięciu przycisku gazu pojazd będzie utrzymywał pełny gaz do momentu zwolnienia przycisku.<br><br>Dotyczy tylko sterowania klawiaturą."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Symuluje rzeczywistą utratę powietrza na skutek nadmiernego użycia hamulców.<br><br>Po włączeniu tej funkcji będzie konieczność zarządzania ciśnieniem powietrza podczas zjeżdżania ze wzniesień lub wykonywania powolnych manewrów z wielokrotnym użyciem hamulców."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Po wyłączeniu tej opcji zużycie paliwa nie jest zależne od stylu jazdy ani warunków drogowych.<br><br>Po włączeniu tej opcji zużycie paliwa jest zależne od kilku czynników, m.in. stylu jazdy, ciężaru ładunku, oporów toczenia i profilu terenu. Umiejętność @@skill_mechanical_title@@ już na to nie wpływa."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu ABS zapobiegnie blokowaniu kół, aby zachować kontrolę i poprawić skuteczność hamowania."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia przyrost prędkości, z jaką tempomat będzie zwiększać lub zmniejszać po naciśnięciu odpowiedniego przycisku."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia tolerancję tempomatu w celu utrzymania prędkości docelowej."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu tempomat automatycznie dostosuje prędkość, aby utrzymać bezpieczną odległość od poprzedzającego pojazdu."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Włącza awaryjne hamowanie, jeśli system wykryje nieuchronne ryzyko kolizji.<br>Wybierz, czy system ma reagować tylko na pojazdy, czy na wszystkie przeszkody."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej funkcji i ustawieniu manetki świateł w pierwszym położeniu światła włączają się automatycznie przy słabym oświetleniu."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej opcji i włączeniu świateł przy włączonych światłach drogowych pojazd automatycznie przełączy światła drogowe, gdy wykryje nadjeżdżający z naprzeciwka lub znajdujący tuż przed pojazdem."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej funkcji kierunkowskazy będą automatycznie wyłączane po wykonaniu skrętu, gdy kierownica zostanie obrócona z powrotem do położenia środkowego."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu niektóre akcesoria wewnętrzne reagują na fizyczny ruch pojazdu (wiszące dekoracje, figurki itp.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Umożliwia odchylenie kamery wewnętrznej w oparciu o sygnał sterujący."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia stopień reakcji funkcji „korekcja kamery w kierunku jazdy” na ruchy kierownicą."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia zachowanie funkcji „korekcja kamery w kierunku jazdy” podczas cofania."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu kamera wewnętrzna spogląda w lewo lub prawo, zależnie od użycia kierunkowskazu."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Po włączeniu kamera wewnętrzna reaguje na ruch pojazdu."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia stopień reakcji kamery wewnętrznej na ruch pojazdu."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Zmienia zakres, w jakim kamera wewnętrzna może się obracać w zależności od ruchu pojazdu."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Ustawia opóźnienie przed automatycznym ponownym ustawieniem kamery.<br><br>Aby ta funkcja została aktywowana, pojazd musi poruszać się z niewielką prędkością. Dotyczy tylko kamery wewnętrznej i kamery śledzącej podczas jazdy do przodu oraz kamery zza okna podczas jazdy do tyłu."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Ustawia prędkość ruchu kamery. Używane przez automatyczne centrowanie kamery i przełączanie między wewnętrznymi ustawieniami kamery."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Decyduje o tym, w jaki sposób działa zbliżenie we wnętrzu: przytrzymaj przycisk, aby chwilowo przybliżyć, lub kliknij, by włączyć zbliżenie." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera język wyświetlany w trakcie gry."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Zmienia ustawienia walut i jednostek w oparciu o wybrany region."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu nazwy miast i krajów będą wyświetlane w wybranym języku."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu nazwy miast i krajów będą wyświetlane na mapie zarówno w wybranym języku, jak i w języku ojczystym tego regionu."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera walutę, która będzie wyświetlana w trakcie gry."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera pomiędzy 12-godzinną lub 24-godzinną notacją czasu zegara."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera, które jednostki odległości mają być wyświetlane w trakcie gry."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera, które jednostki masy mają być wyświetlane w trakcie gry."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera, które jednostki temperatury mają być wyświetlane w trakcie gry."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wybierz, które jednostki ciśnienia mają być wyświetlane."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wybiera, które jednostki objętości mają być wyświetlane w trakcie gry."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wybierz, które jednostki zużycia mają być wyświetlane."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej opcji użycie klawisza „Aktywuj” (@@imv_nrm_activate@@) spowoduje otwarcie czatu podczas sesji konwoju."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej opcji pasek wprowadzania czatu pozostanie aktywny po wysłaniu wiadomości."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu tej funkcji wiadomości czatu będą wygaszane kilka sekund po każdej wiadomości."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Zmienia czas wyświetlania komunikatów czatu przed ich wygaszeniem."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Po włączeniu nazwy graczy będą wyświetlane nad ich pojazdami w sesjach konwoju."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Otwiera zaawansowane menu umożliwiające skonfigurowanie szybkich odpowiedzi na czacie w sesjach konwoju."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Sprawdź status swojej połączonej zawartości z platformą World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Umożliwia pobieranie wiadomości online w celu wyświetlenia ich na ekranie tytułowym."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Umożliwia pobieranie zrzutów ekranu społeczności wybranych ze strony internetowej World of Trucks, które są wyświetlane jako ekrany wczytywania."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Umożliwia pobieranie prawdziwych reklam do wyświetlania na wybranych billboardach w grze."
