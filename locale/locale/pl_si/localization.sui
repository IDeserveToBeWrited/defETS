#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "Aby uzyskać dostęp do szybkich zleceń, musisz ukończyć bieżący samouczek."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Aby uzyskać dostęp do rynku przesyłek, musisz kupić pierwszą ciężarówkę."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Aby uzyskać dostęp do rynku ładunków, musisz kupić pierwszą naczepę."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Aby uzyskać dostęp do zleceń zewnętrznych, musisz kupić pierwszą ciężarówkę i mieć profil połączony z World of Trucks."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Aby uzyskać dostęp do rynku zewnętrznego, musisz kupić pierwszą naczepę i mieć profil połączony z World of Trucks."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Przeglądaj mapę świata, eksplorowane obszary oraz aktualne punkty kontrolne nawigacji lub wyznaczaj nowe. "

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Szybka podróż do wcześniej odkrytego miasta, za opłatą."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Przeglądaj, wyszukuj i filtruj sesje konwojów online, aby do nich dołączyć lub tworzyć i hostować własne dla innych."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Twoja skrzynka odbiorcza na wiadomości ze świata biznesu, banków i nowych pracowników w firmach."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "E-maile zaczną przychodzić, gdy osiągniesz dalsze postępy w swojej karierze."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Zlokalizuj i kupuj dostępne garaże na mapie świata."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Przeglądaj i oceniają dostępne do zakupu używane ciężarówki."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Nie odkryłeś jeszcze żadnych dealerów samochodów ciężarowych."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Przeglądaj, oceniaj i rekonfiguruj dostępne naczepy do zakupu."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Podrasuj swoje doświadczenie z jazdy puszczając muzykę."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Radio jest niedostępne."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Skonfiguruj grafikę, dźwięk, rozgrywkę, sterowanie i opcje online."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Przeglądaj swoje postępy w karierze, statystyki i ostatnio ukończone zlecenia."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Aby uzyskać dostęp do aktywnego konwoju, musisz najpierw wejść w sesję konwoju."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Ostrzeżenie zdrowotne"

	key[]: "health_warning_description"
	val[]: "Niewielka liczba użytkowników może być podatna na napady padaczkowe lub utratę przytomności po narażeniu na określone migające światła lub wzory świetlne. Takie osoby mogą doświadczyć napadu podczas oglądania określonych obrazów lub grania w grę wideo. Jeśli Ty lub ktokolwiek z Twojej rodziny kiedykolwiek miał objawy związane z padaczką (napady lub utratę przytomności) po narażeniu na migające światła, skonsultuj się z lekarzem i podejmij wszelkie niezbędne środki ostrożności przed rozpoczęciem gry.<br offset=20>Jeśli u Ciebie lub Twojego dziecka wystąpi którykolwiek z następujących objawów: zawroty głowy, zaburzenia widzenia, drgania oczu lub mięśni, utrata przytomności, dezorientacja, drgawki, jakiekolwiek mimowolne ruchy, natychmiast przerwij korzystanie z gry wideo i skonsultuj się z lekarzem."

	key[]: "trademark"
	val[]: "Wszystkie nazwy marek, znaki towarowe, zastrzeżone znaki towarowe, logotypy i symbole znajdujące się na pojazdach w grze są własnością ich prawowitych właścicieli i zostały użyte za ich uprzejmą zgodą. Znaki towarowe i wzory MAN® są zarejestrowanymi prawami należącymi do MAN Truck & Bus AG i są wykorzystywane przez SCS Software s.r.o. na podstawie udzielonej licencji. „Mercedes-Benz” oraz „trójramienna gwiazda w okręgu” są znakami towarowymi Daimler AG i są wykorzystywane przez SCS Software s.r.o. na podstawie licencji. Znaki towarowe i wzory RENAULT są zarejestrowanymi prawami należącymi do lub licencjonowanymi przez AB Volvo Group i są wykorzystywane zgodnie z warunkami licencji. Znaki towarowe i wzory VOLVO są zarejestrowanymi prawami należącymi do lub licencjonowanymi przez AB Volvo Group i są wykorzystywane zgodnie z warunkami licencji."
#@}

