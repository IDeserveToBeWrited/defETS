#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Kōntynuuj ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Witej w Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Yntlich mŏsz przileżytość prŏcować przi robocie ze twojich śnikōw - kludzić lastauto!"

	key[]: "intro_3"
	val[]: "Twōj włŏsny gyszeft już działŏ, ale niy mŏsz piyniyndzy, coby kupić lastauto. Na razie bydziesz musioł robić dlŏ inkszych fyrmōw za kerowcy."

	key[]: "intro_4"
	val[]: "Twoja robota to bezpiyczniy zawiyźć ladunek $JOB_CARGO$ do doku $JOB_TARGET_COMPANY$ we $JOB_TARGET_CITY$. Twōj szef dŏ ci autŏk i bydzie calować za wszyjsko. Niych żŏdyn sie na ciebie niy ôszydzi. Przijedź na czas."


	key[]: "intro_garage_1"
	val[]: "To je twoja cyntrala."

	key[]: "intro_garage_2"
	val[]: "Je to cołkym mały garaż. Może niyma to dużo, ale to ino poczōntek."

	key[]: "intro_garage_3"
	val[]: "Niystety niy mŏsz sam co zaparkować, także niy widać żŏdnych lastautōw."

	key[]: "intro_garage_4"
	val[]: "Jak bydziesz mieć tela piyniyndzy, coby kupić lastauto, bydziesz mōg swobodniy jeździć po świycie i kludzić swōj włŏsny biznys stōnd."

	key[]: "intro_garage_5"
	val[]: "Niych sie darzi!"


	key[]: "desktop_tut_t"
	val[]: "FUNKCJA ODBLOKOWANA"

	key[]: "desktop_tut_job"
	val[]: "Ôbier swojã nŏstympnõ robotã"

	key[]: "desktop_tut_cargo_market"
	val[]: "Użyj nowej naczepy, aby uzyskać dostęp do rynku ładunków, aby dostarczać szeroki asortyment ładunków do ich miejsc docelowych." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Sam mogesz wejrzeć na swōj progres."

	key[]: "desktop_tut_company"
	val[]: "Wachuj przi swojich garażach, bier do roboty nowych kerowcōw, a poza tym kludź swōj gyszeft stōnd."

	key[]: "desktop_tut_trailers"
	val[]: "Od teraz możesz kupować własne naczepy i ulepszać je lub malować, aby pasowały do Twojej ciężarówki.<br><br>Twoje naczepy mogą być przechowywane w wybranych garażach; mogą być wykorzystywane przez Twoich kierowców do zwiększania zysków. Aby zarządzać swoimi naczepami, skorzystaj z Menedżera naczep."

	key[]: "desktop_tut_visit_directive"
	val[]: "Odwiedź $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "WITAJ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Witamy w nowym ekranie głównym!<br>Stąd możesz uzyskać dostęp do wszystkich funkcji gry."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Poniższe menu główne zapewnia bezpośredni dostęp do wszystkich podstawowych funkcji gry, które znasz."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Nowy pasek stanu u góry zapewnia stały wgląd w przydatne statystyki profilu gracza i lokalne przepisy dotyczące podróży."

	key[]: "desktop_tut_tour_home"
	val[]: "Przycisk pulpitu jest zawsze dostępny i umożliwia powrót do ekranu głównego."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Stałe szybkie menu zapewnia wygodny dostęp do wszystkich funkcji gry z dowolnego ekranu."

	key[]: "desktop_tut_tour_drive"
	val[]: "Zaktualizowany przycisk „Jedź” pozostaje Twoim połączeniem ze światem jazdy – gotowym, aby zabrać Cię z powrotem na drogę."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "ZAKOŃCZONO SAMOUCZEK"

	key[]: "desktop_tut_tour_finish"
	val[]: "Dziękujemy za zapoznanie się z naszą aktualizacją ekranu głównego."
