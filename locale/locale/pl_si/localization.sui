	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Wciś @@ima_wiz_j_throttle@@, coby jechać do przodku i puść, coby cofać."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Wciś @@ima_wiz_j_throttle@@, coby jechać do przodku i @@ima_wiz_j_brake@@ do zadku."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Wciś @@imm_wiz_dforward@@, coby jechać do przodku i @@imm_wiz_dbackward@@, coby brymzować."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Wciś @@ima_wiz_j_throttle@@, coby jechać do przodku i puść, coby brymzować."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Wciś @@ima_wiz_j_throttle@@, coby jechać do przodku i @@ima_wiz_j_brake@@, coby brymzować."


	key[]: "wiz_cfg_gb_arcade"
