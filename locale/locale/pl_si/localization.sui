#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "PRZEGLĄD STANU CIĘŻARÓWKI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "Stan" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Pojazd ma poważne problemy mechaniczne wpływające na wydajność i niezawodność. Być może trzeba będzie rozważyć całkowitą renowację lub wymianę wielu części." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "W pojeździe występują problemy mechaniczne, które mogą pogorszyć jego działanie lub niezawodność. Wymagany jest serwis." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Pojazd jest sprawny, ale może powodować pewne problemy. Zalecany jest serwis." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Pojazd jest w dobrym stanie, posiada jedynie niewielkie ślady użytkowania." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Pojazd jest w doskonałym stanie, nosi minimalne ślady użytkowania." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Konserwacja" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "Oznacza starzenie się układu i zużycie całego pojazdu. Naprawiane poprzez całkowitą renowację." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Zużycie części" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "Przebieg i wypadki prowadzą do zużycia poszczególnych części. Monitoruj ich stan i wymień w razie potrzeby." #+ Explanation unfixable wear.
#@}

