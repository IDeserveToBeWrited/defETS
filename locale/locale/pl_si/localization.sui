#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Necowŏ warstwa niyma dostympnŏ. Proszã, kuknij eli kōnfiguracyjŏ ôd klijynta je dobrŏ."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Kuplowaniy ze serwisym onlajn sie niy podarziło. Proszã, ôbezdrzij eli twoje internetowe skuplowaniy łazi."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Błōnd przi kōmunikacyji ze serwisym onlajn. Sprōbuj niyskorzij."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Serwer onlajn przisłŏł nazŏd błyndne daty. Jeźli używŏsz HTTP proxy, to wejrzij do kōnfiguracyje ôd niygo. We inkszym przipŏdku sprōbuj zaś niyskorzij."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Serwer onlajn przisłoł nazŏd błyndne daty. Sprōbuj zaś niyskorzij."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Serwis niyma zgodny z aktualnōm wersyjōm gry. Ôbezdrzij, proszã, eli niy ma jakich uaktualniyń."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Serwis terŏzki niyma dostympny. Proszã, sprōbuj niyskorzij."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Serwis je terŏzki oflajn skuli bajstlowaniŏ abo przeciōnżyniŏ. Sprōbuj, proszã, niyskorzij."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Idyntyfikacyjŏ niyma prawŏ. Proszã, sprōbuj jeszcze rŏz."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Kōnto onlajn je terŏzki zastawiōne skuli mocki niyudanych prōb zalogōwaniŏ sie. Proszymy, sprōbuj jeszcze rŏz za pōł godziny."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Kōnto onlajn je terŏzki zastawiōne skuli podezdrzanych przistympōw. Sprōbuj jeszcze rŏz za 24 godziny."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Ta gra niyma zarejestrōwanŏ do tygo kōnta onlajn."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Kōnto jeszcze niy bōło aktywōwane. Proszymy, wejrzij, jeźli mŏsz wiadōmość aktywacyjnõ na swojim mailu."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Kōnto je zastawiōne. Proszymy, skōntaktuj sie ze technicznōm pōmocōm."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Kōnto je zbanōwane. Proszymy, skōntaktuj sie ze technicznōm pōmocōm."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Ta gra niy poradzi ôbsużyć idyntyfikacyje proxy. Proszã, użyj inkszego proxy abo bezpostrzedniygo skuplowaniŏ."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Obiekt niyma terŏzki dostympny. Sprōbuj, proszã, za pŏrã minut."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Błąd SSL. Nie można nawiązać bezpiecznego połączenia."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Gra została przerwana podczas łączenia z internetem. Spróbuj ponownie później."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Wnōntrzny błōnd. Mogesz znŏłyź wiyncyj informacyjōw we zbiorze net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 trefiył na niyprzileżytość i niy poradzi narysować grafik na twojim kōmputrze (niy mŏsz płatnyj graficznyj szkarty).nSugerowane kroki:nn1. Ôbezdrzij eli kōmputer i graficznŏ szkarta spōłniajōm minimalne wymŏgania hardwerowe.n2. Zaktualizuj wersyjõ Microsoft DirectX.n3. Symnij i zainsztalyruj nojnowsze drajwery do twojij graficznyj szkarty ze neczajty ôd producynta - twoje drajwery mogōm być niypłatne.n4. Sprōbuj zmiynić metodã rynderowaniŏ z OpenGL na DirextX abo na ôdwyrtkã.n5. Wyciep zbiōr kōnfiguracyje 'config.cfg' we katalogu 'Dokumynty' - 'Euro Truck Simulator 2'. Może być uszkodzōny.n Tyn zbiōr bydzie autōmatycznie nazŏd stworzōny z wychodnymi nasztalowaniami jak zaś włōnczysz grã."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 trefiył na niyprzileżytość i niy poradzi narysować grafik na twojim kōmputrze (niy mŏsz płatnyj graficznyj karty)."
#@}

