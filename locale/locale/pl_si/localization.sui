#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Wybiera podtyp kontrolera dla gry, aby poprawnie obsługiwać zakresy wejściowe."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Wybiera typ skrzyni biegów:<br>- „Prosty automat” umożliwia użycie pedału gazu i hamulca do sterowania ruchem do przodu i do tyłu. <br>- „Prawdziwy automat” wymaga sygnału wejściowego do przełączania między biegami do przodu i do tyłu.<br>- „Sekwencyjna” wymaga ręcznej zmiany wszystkich biegów za pomocą sygnałów wejściowych biegu w górę/w dół.<br>- „H-Shifter” wymaga użycia kontrolera z stopniami zmiany biegów do ręcznego wybierania biegów."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Zmienia logikę zmiany biegów automatycznej skrzyni biegów:<br>- „Tryb ekonomiczny” preferuje niższe obroty z nastawieniem na maksymalny moment obrotowy.<br>- „Tryb wysokiej mocy” będzie nastawiony na maksymalną moc, zapewniając lepsze właściwości jezdne przy dużych obciążeniach lub w górzystym terenie kosztem oszczędności paliwa."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje stosunek stopnia obrotu urządzenia do rzeczywistego stopnia obrotu kierownicy pojazdu."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje liniowość pomiędzy sygnałem wejściowym a sterowaniem pojazdem.<br><br>Zwiększenie tej wartości oznacza, że sterowanie będzie mniej czułe, gdy koło będzie ustawione pośrodku, a czułość wzrośnie, gdy koło zostanie obrócone w stronę maksymalnego zablokowania. Może to być pomocne w celu wygładzenia sygnałów sterujących podczas jazdy na wprost."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Włącza funkcję Force Feedback w kontrolerach, które ją obsługują."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje ogólne wzmocnienie dla wszystkich ustawień sprzężenia zwrotnego siły w zakresie od 0N do 10N.<br><br><color value=@@clr_txt_d@@>Należy pamiętać, że ustawienie wyższego ustawienia w przypadku mocnych rozstawów osi może spowodować obrażenia palców lub dłoni."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje siłę centrowania podczas jazdy z dużą prędkością, która osiąga maksymalną prędkość 90 km/h (56 mil/h) i wyższą.<br><br>Ustawienie minimalne spowoduje brak siły centrowania koła kierowniczego."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje centrowanie podczas jazdy z małą prędkością.<br><br>Ustawienie minimalne spowoduje brak siły centrowania koła kierowniczego."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje siłę sztucznego tarcia wewnętrznego wytwarzanego przez mechaniczne elementy układu kierowniczego."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje siłę sztucznego rezonansu silnika poprzez kolumnę kierownicy.<br><br><color value=@@clr_txt_d@@>Należy pamiętać, że ustawienie tej wartości powyżej 15% może spowodować nadmierne drgania i wibracje w niektórych kierownicach."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje siłę efektu nawierzchni drogi za pośrednictwem kolumny kierownicy.<br><br><color value=@@clr_txt_d@@>Należy pamiętać, że ustawienie tej wartości powyżej 20% może spowodować nadmierne drgania i wibracje niektórych kierownic podczas jazdy z dużą prędkością po nierównym terenie."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje siłę efektów nierówności na drodze przechodzących przez kolumnę kierownicy."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje siłę efektów kolizji przez kolumnę kierownicy."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje intensywność efektów zgrzytania skrzyni biegów."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje intensywność efektów poślizgu podsterowności."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje intensywność wspomagania kierownicy (podczas korzystania z funkcji asystenta pasa ruchu itp.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje intensywność wibracji powierzchni terenu, jeśli urządzenie obsługuje sprzężenie zwrotne wibracji."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje intensywność wibracji wybojów, jeśli urządzenie obsługuje sprzężenie zwrotne wibracji."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje intensywność wibracji kolizji, jeśli urządzenie obsługuje sprzężenie zwrotne wibracji."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Oś urządzenia, która będzie wykorzystywana do sterowania."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje martwą strefę osi kierowanej; wielkość obrotu od środka, przy której dane wejściowe są ignorowane.<br><br>Może to złagodzić problemy związane ze starszymi kontrolerami, takie jak niedokładność lub fałszywe dane wejściowe spowodowane zużyciem."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Określa sposób, w jaki gra obsługuje dane wejściowe osi sterującej:<br>- wyśrodkowany jest idealny do kierownic lub joysticków.<br>- Odwrócona służy do korygowania osi, która została błędnie wykryta."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Oś urządzenia, która ma służyć do przyspieszania pojazdu."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje martwą strefę osi przyspieszenia, czyli ilość przesunięcia sygnału wejściowego, przy której nie jest rejestrowany żaden sygnał wejściowy.<br><br>Może to łagodzić problemy ze starszymi kontrolerami, takie jak niedokładność lub błędne dane wejściowe spowodowane zużyciem."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Określa sposób, w jaki gra obsługuje dane wejściowe kontrolera:<br>- Ustawienie wyśrodkowane jest idealne dla joysticków.<br>- Ustawienie normalne jest idealne dla padów i pedałów.<br>- Ustawienie odwrócone może kompensować dane wejściowe, które zostały nieprawidłowo wykryte."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Oś urządzenia, która ma być wykorzystywana do hamowania."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje martwą strefę osi hamulca, czyli zakres ruchu wejściowego, przy którym nie jest rejestrowany żaden sygnał wejściowy.<br><br>Może to łagodzić problemy ze starszymi sterownikami, takie jak niedokładność lub błędne dane wejściowe spowodowane zużyciem."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Określa sposób, w jaki gra obsługuje dane wejściowe kontrolera:<br>- Ustawienie wyśrodkowane jest idealne dla joysticków.<br>- Ustawienie normalne jest idealne dla padów i pedałów.<br>- Ustawienie odwrócone może kompensować dane wejściowe, które zostały nieprawidłowo wykryte."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Oś urządzenia, która ma służyć do włączania sprzęgła."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje martwą strefę osi sprzęgła, czyli zakres ruchu wejściowego, przy którym nie jest rejestrowany żaden sygnał wejściowy.<br><br>Może to łagodzić problemy ze starszymi kontrolerami, takie jak niedokładność lub błędne dane wejściowe spowodowane zużyciem."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Określa sposób, w jaki gra obsługuje dane wejściowe kontrolera:<br>- Ustawienie wyśrodkowane jest idealne dla joysticków.<br>- Ustawienie normalne jest idealne dla padów i pedałów.<br>- Ustawienie odwrócone może kompensować dane wejściowe, które zostały nieprawidłowo wykryte."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje zakres sprzęgła.<br><br>Im bardziej w prawo ustawisz zakres, tym głębiej będziesz musiał wcisnąć pedał, aby włączyć sprzęgło."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Oś urządzenia, która ma służyć do pochylania kamery w górę i w dół."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje martwą strefę osi góra-dół, czyli zakres ruchu sygnału wejściowego, przy którym nie jest rejestrowany żaden sygnał wejściowy.<br><br>Może to łagodzić problemy ze starszymi kontrolerami, takie jak niedokładność lub błędne dane wejściowe spowodowane zużyciem."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Określa sposób, w jaki gra obsługuje wprowadzanie danych na osiach:<br>- Opcja wyśrodkowana jest idealna dla joysticków.<br>- Opcja odwrócona służy do korygowania osi, która została błędnie wykryta."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Oś urządzenia, która będzie używana do przesuwania kamery w lewo i w prawo."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Dostosowuje martwą strefę osi lewo-prawo, czyli zakres ruchu sygnału wejściowego, przy którym nie jest rejestrowany żaden sygnał wejściowy.<br><br>Może to łagodzić problemy ze starszymi kontrolerami, takie jak niedokładność lub błędne dane wejściowe spowodowane zużyciem."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Określa sposób, w jaki gra obsługuje wprowadzanie danych na osiach:<br>- Opcja wyśrodkowana jest idealna dla joysticków.<br>- Opcja odwrócona służy do korygowania osi, która została błędnie wykryta."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Wybiera układ przełożeń, który ma być używany z dźwignią H-Shifter."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Zmienia zachowanie dźwigni zmiany biegów:<br>- Opcja „Prosty” nigdy nie będzie zgrzytania biegów podczas zmiany biegów.<br>- Opcja „Prosty + dźwięk ostrzegawczy” umożliwia również prostą zmianę biegów, ale przy nieprawidłowej zmianie biegów słychać dźwięki zgrzytania biegów.<br>- Opcja „Zaawansowane” nie pozwoli Ci na zmianę biegów, jeśli zmienisz bieg nieprawidłowo i usłyszysz tylko dźwięki zgrzytania biegów. Opcja „Zaawansowana” pozwala również na wykorzystanie ustawienia „szybkiego podziału zmiany biegów”."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Wybierz, w jaki sposób gra obsługuje szybkie zmiany biegów:<br>- „Nigdy” wymaga przesunięcia drążka zmiany biegów do położenia neutralnego między zmianami biegów.<br>- „Naciśnięcie sprzęgła” wymaga chwilowego wciśnięcia sprzęgła bez poruszania drążkiem zmiany biegów.<br>- „Zwolnienie przepustnicy” wymaga, aby kierowca zwalniał przepustnicę tylko w celu zmiany biegów bez poruszania drążkiem zmiany biegów, a „Sprzęgło lub przepustnica” to połączenie tych dwóch ostatnich opcji."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje dane wejściowe służące do przełączania pomiędzy zakresami w oparciu o układ dźwigni zmiany biegów."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje przycisk do przełączania rozdzielacza zmiany biegów w oparciu o układ dźwigni."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Włącz, jeśli używasz przełączników zamiast przycisków dla wejść zakresu lub rozdzielacza."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje przycisk umożliwiający przejście do trybu jazdy z automatyczną skrzynią biegów."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje przycisk umożliwiający przejście do trybu biegu wstecznego automatycznej skrzyni biegów."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Umożliwia dynamiczne sprzężenie zwrotne RGB na kompatybilnych urządzeniach."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Włącza i konfiguruje funkcje śledzenia wzroku dla kompatybilnych urządzeń."
