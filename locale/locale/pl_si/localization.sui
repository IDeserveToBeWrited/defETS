	key[]: "display_texture_t"
	val[]: "TEKSTURY" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKSJE" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "CIENIE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "OŚWIETLENIE" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-PROCESSING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ŚRODOWISKO" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Tryb pōłnygo ekranu" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Jasność / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Dostosuj jasność" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Rozdzielczość" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Czynstość fryszowaniŏ" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limit FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limit FPS w tle" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Wychodne fryszowaniy" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Piōnowŏ synchrōnizacyjŏ" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonōmiczny (szpŏruje energijõ na laptopach)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "PROSTE NASZTALOWANIA GRAFICZNE" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "WŁŎSNE NASZTALOWANIA" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "ROZSZYRZOWANE NASZTALOWANIA GRAFIKI" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Proste/zaawansowane ustawienia graficzne" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Ukryj ustawienia zaawansowane" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Pokaż ustawienia zaawansowane" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skalowaniy" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Wygładzanie krawędzi" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA — wyostrzanie wartości jasności (luma)" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Dostosowanie TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptacyjna przejrzystość" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Zawsze miękki" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Zawsze ostry" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Okluzja otoczenia przestrzeni ekranu (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Rynderowaniy HDR" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Głymboczyzna pola" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Przebicia światła" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Nasztalōwania farbōw" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Skalowanie odbicia" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Akuratność ôdbić" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Akuratność natury" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Gynstość trŏwy" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Jakośc ciyni"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Srogość tekstur ciyni" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Odległe cienie" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Cienie wnętrza" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Jakość pogody"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Jakość we zdrzadłach" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Rozdzielczoś zdrzadła" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Głymboczyzna we zdrzadłach" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Jakość tekstur" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtrowaniy anizotopiczne" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normalne mapy" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Reflektory lastauta" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Ekstra światła" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Głymboczyzna widzialności świateł" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Piysi" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Zmyniōł żeś nasztalowania ôbrazu.<br>Chcesz je spamiyntać?"

	key[]: "reverting_in"
	val[]: "Wyciepowaniy za" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekund" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Po włączeniu gra będzie wyświetlana na pełnym ekranie."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Dostosowuje ogólną jasność gry do Twojego wyświetlacza. Na wyświetlaczach obsługujących HDR opcja kalibracji HDR będzie również dostępna w tym ustawieniu."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Zmienia rozdzielczości gry."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Zmienia docelową częstotliwośći odświeżania gry."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Dopasowuje liczbę klatek na sekundę do częstotliwości odświeżania monitora, aby zapobiec rwania obrazu. Ustawienie ekonomiczne również zmniejsza liczbę klatek na sekundę o połowę, co skutkuje niższym zużyciem energii."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Ustawia maksymalną dozwoloną liczbę klatek na sekundę dla gry.<br><br>Ustawienie wartości na 0 wyłączy tę funkcję."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Ustawia maksymalną dozwoloną liczbę klatek na sekundę dla gry, gdy jest ona zminimalizowana w tle.<br><br>Ustawienie wartości na 0 wyłączy tę funkcję."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Możliwość zmiany pomiędzy prostymi ustawieniami graficznymi (presetami) lub zaawansowanymi ustawieniami graficznymi (możliwość zmiany poszczególnych parametrów)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Poprawia jakość grafiki poprzez renderowanie gry wewnętrznie w wyższej rozdzielczości, co zmniejsza poszarpane krawędzie i poprawia szczegóły.<br>Na przykład wybranie wyższej opcji skalowania skutkuje wyraźniejszym obrazem z mniejszym rozmyciem, dzięki czemu gra wygląda ogólnie lepiej, ale dzieje się to kosztem wydajności.<br><br><color value=@@clr_txt_d@@>To ustawienie często ma duży wpływ na wydajność."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Wybór szybkich metod wygładzania krawędzi, które wygładzają postrzępione krawędzie w grze:<br>- SMAA próbkuje każdy piksel wielokrotnie (w zależności od wybranej jakości) w różnych miejscach klatki i uśrednia próbki w celu uzyskania ostatecznego obrazu.<br>- TAA próbkuje każdy piksel tylko raz na klatkę, ale próbkuje je w różnych miejscach i różnych klatkach.<br>- Aby uzyskać najlepszy wynik, możesz również wybrać kombinację obu metod kosztem wydajności.<br><br><color value=@@clr_txt_d@@>To ustawienie zwykle ma umiarkowany wpływ na wydajność."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje miękkie cienie do szczelin i obiektów znajdujących się blisko siebie, poprawiając postrzeganą wierność graficzną całego świata gry.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Wybór ustawień wstępnych TAA:<br>- „Zawsze miękki” spowoduje mniejsze migotanie/większe rozmycie — opcja ta jest odpowiednia dla użytkowników komputerów PC, którzy włączają supersampling lub mają monitory o wysokiej rozdzielczości, a także dla użytkowników telewizorów 1080p, którzy siedzą dalej od ekranu.<br>- „Zawsze ostry” spowoduje większe migotanie/mniejsze rozmycie — prawdopodobnie jest to najlepsza opcja do zastosowań poniżej 1080p, takich jak laptopy lub Steam Deck.<br>- „Adaptacyjna ostrość” dynamicznie wyłącza drgania TAA, gdy kamera jest statyczna.<br><br><color value=@@clr_txt_d@@>To ustawienie można stosować tylko wtedy, gdy TAA jest wybrane jako rozwiązanie antyaliasingowe."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje intensywność wyostrzania luminancji TAA.<br><br><color value=@@clr_txt_d@@>To ustawienie można stosować tylko wtedy, gdy TAA jest wybrane jako rozwiązanie antyaliasingowe."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Po włączeniu odległe obszary mapy mogą być sztucznie rozmyte, aby uzyskać realistyczny spadek ostrości w tle."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Po włączeniu promienie światła mogą być widoczne podczas patrzenia na słońce lub patrzenia na słońce przez obiekty takie jak drzewa, budynki lub pojazdy."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Po włączeniu kolory gry są dynamicznie dostosowywane ze względów estetycznych. Sceny będą lepiej dopasowane do pory dnia i warunków pogodowych, kolory pojazdów i innych obiektów mogą być żywsze itp."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Poprawia odbicia poprzez ich wewnętrzne renderowanie w wyższej jakości, a także poprzez użycie lepszego wygładzania krawędzi.<br><br><color value=@@clr_txt_d@@>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje szczegółowość odbić widocznych na powierzchniach pojazdów, szybach i innych powierzchniach odbijających, takich jak kałuże, mokre drogi i otwarte zbiorniki wodne.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zazwyczaj umiarkowany wpływ na wydajność.<br><br>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje poziom szczegółowości i złożoności roślin i drzew.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje gęstość trawy widocznej na poboczach drogi.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość cieni rzucanych przez słońce lub księżyc.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Umożliwia renderowanie cieni nawet z bardzo odległych obiektów.<br><br><color value=@@clr_txt_d@@>To ustawienie zwykle ma umiarkowany wpływ na wydajność."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość efektów pogodowych, takich jak odbicia."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość odbić widocznych w lusterkach pojazdu (niezależnie od ustawień odbicia).<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje rozdzielczość obrazu wyświetlanego na lusterkach pojazdu."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje odległość, w której obiekty zaczynają być renderowane w lustrze.<br><br><color value=@@clr_txt_d@@>To ustawienie często ma duży wpływ na wydajność."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość niektórych tekstur stosowanych do obiektów i powierzchni w grze."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Poprawia ostrość tekstur, zwłaszcza tych oglądanych z daleka lub pod kątem.<br><br><color value=@@clr_txt_d@@>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje wygląd geometrycznych szczegółów do nawierzchni, dróg i innych obiektów, aby poprawić ich wygląd.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność.<br><br>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Umożliwia oświetlenie światłami innych pojazdów w ruchu drogowym."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Umożliwia oświetlenie dodatkowymi światłami innych pojazdów w ruchu, kierunkowskazów, hamulców itp."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje odległość, z której widoczne są źródła sztucznego światła.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje pieszych poruszających się po świecie gry."
#@}

