#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "ŚLEDZENIE WZROKU" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Widok rozszerzony" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Rozszerzone ustawienia wstępne widoku" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Wprowadź nazwę ustawienia wstępnego" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Czy na pewno chcesz usunąć wybrane ustawienie wstępne?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Istniejące ustawienia wstępne o tej samej nazwie zostaną zastąpione. Czy chcesz kontynuować?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Ustawienia śledzenia spojrzenia" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Ustawienia śledzenia głowy" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Sterowanie za pomocą klawiatury" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Włącz widok rozszerzony" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Włącz automatyczne centrowanie" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Tryb śledzenia ruchu głowy" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Bezpośredni" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dynamiczny" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Czułość reakcji na ruch oczu" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Czułość reakcji na ruch głowy" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Włącz śledzenie pochylenia" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Włącz śledzenie pozycji głowy" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Mnożnik odchylenia (w kabinie)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Mnożnik podziałki (w kabinie)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Mnożnik odchylenia (w trybie chodzenia)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Mnożnik podziałki (w trybie chodzenia)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Maks. kąt obr. kamery ruchem oczu" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Szybkość reakcji na ruch oczu"

	key[]: "eye_gaze_exponent"
	val[]: "Nieliniowość śledzenia oczu"

	key[]: "eye_gaze_inflection_point"
	val[]: "Punkt przegięcia nieliniowości śl. wzroku"

	key[]: "eye_gaze_start_point"
	val[]: "Punkt początkowy śledzenia oczu"

	key[]: "eye_gaze_end_point"
	val[]: "Punkt końcowy śledzenia oczu"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Czułość śledzenia odchylenia głowy (w kabinie)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Czułość śledzenia nachylenia głowy (w kabinie)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Czułość śledzenia odchylenia głowy (w trybie chodzenia)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Czułość śledzenia nachylenia głowy (w trybie chodzenia)"

