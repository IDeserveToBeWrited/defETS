#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "KONFIGURACJA OSI KONTROLERA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Wizualizacja osi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Możesz wizualnie wypróbować działanie wszystkich wybranych osi. Użyj kontrolera i obserwuj poruszające się paski. Poinformuje Cię o ograniczeniach, wyśrodkowaniu, orientacji i ogólnym zachowaniu każdej używanej osi."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Ustawienie osi"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Aby wybrać oś, kliknij przycisk obok nazwy osi. Zostaniesz przeniesiony do trybu wprowadzania ustawień. Następnie użyj kontrolera, aby powiązać wybraną oś, przesuwając drążek, kierownicę lub pedał do wybranej osi."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Martwe strefy"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Martwa strefa odnosi się do obszaru osi celowo zaprojektowanego tak, aby nie zapewniał żadnych danych wejściowych. Aby dostosować martwą strefę wybranej osi, przesuń odpowiedni suwak. Przesunięcie suwaka w prawo spowoduje powiększenie martwej strefy. Ta funkcja jest szczególnie korzystna w przypadku starszych kontrolerów, ponieważ zdefiniowanie większej martwej strefy może złagodzić problemy, takie jak niedokładność lub fałszywe dane wejściowe spowodowane zużyciem sprzętu."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Tryby osi"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Ustawienie osi obrotu określa w jaki sposób oś będzie się zachowywała w grze. Odwrócona oś obrotu działa przeciwnie tj. skręcenie w prawo powoduje skręcenie w lewo. Wyśrodkowana oś obrotu jest domyślnie ułożona na środku skali (np. joysticka). Z tego ustawienia warto skorzystać gdy oś obrotu zostanie nieprawidłowo wykryta."

	key[]: "normal"
	val[]: "Normalny" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Ôpaczne" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Wystrzodkowanŏ" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Ôpaczne i wystrzodkowane" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "KONFIGURACJA AUTOMATYCZNEJ SKRZYNI BIEGÓW" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Przi autōmatycznyj krzince biegōw musisz przeciepować ino miyndzy jazdōm do przodku, luzym i do zadku. Mogesz to robić jak bydziesz wciskać te knefle na klawiaturze abo na kōntrolerze. Coby zmiynić nasztalowania, kliknij we knefel i wciś co potrzebujesz na klawiaturze abo na kōntrolerze."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Jeźli mŏsz H-shifter podkuplowany, mogesz go używać choćby prawygo autōmatycznygo szaltera we lastaucie. Włōncz tã funkcyjõ i mogesz nasztalować pozycyje H-shiftera, coby jechać do przodku i do zadku. Wszyjske inksze pozycyje robiōm za luz. To nasztalowaniy je szpecjalne dlŏ H-shiftera i niy bydzie łazić z żŏdnymi standardowymi kneflami ôd klawiatury i kōntrolera. Jeźli chcesz kereś zmiynić, to kliknij na knefel i przeciep szalter na pozycyjõ, kerõ potrzebujesz, a niyskorzij przeciep nazŏd na luz."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "KONFIGURACJA SEKWENCYJNEJ SKRZYNI BIEGÓW" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekwyncyjnŏ krzinka biegōw przeciepuje miyndzy wszyjskimi biegami do przodku, luzym i do zadku. Sam widzisz knefle klawiatury abo kōntrolera używane do przeciepowaniŏ do gōry i do spodku we takim porzōndku. Mogesz nasztalować włŏsne, jak klikniesz we knefel i wciśniesz co potrzebujesz na klawiaturze abo na kōntrolerze."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "KONFIGURACJA SKRZYNI BIEGÓW H-SHIFTER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Sam mogesz ôbrać przodni ukłŏd H-shiftera i prōbować funkcyje ôd niygo. Na ôbrŏzku widzisz aktualnõ pozycyjõ szaltra i to, kery bieg terŏzkiś ôbroł. Skuli tego, że krzinka biegōw mŏ wiyncyj biegōw aniżeli je pozycyjōw szaltra, musisz używać ekstra knefli, coby przeciepować miyndzy ôbiyma skupinami biegōw."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Aktualniy ôbranŏ pozycyjŏ szaltra i aktywne nasztalowaniy sōm tyż pokŏzane niżyj kole przipisanyj akcyje. Coby zmiynić przipisanõ akcyjõ, kliknij we knefel i rusz szaltrym do sztelungu, kery potrzebujesz, a niyskorzi nazŏd na luz."
#@}

