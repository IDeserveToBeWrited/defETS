	key[]: "load_save"
	val[]: "Spamiyntej i zaladuj" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Wykryto zmianę w grze! Aby uniknąć problemów ze zgodnością zapisów stanu gry spowodowanych zmianami w świecie gry, wszelkie niedokończone dostawy zostały anulowane bez kary dla Ciebie." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Wykryto zmianę w grze!<br><br>Aby zapobiec problemom ze zgodnością zapisów gry, wszystkie niedokończone dostawy zostały anulowane bez kary dla Ciebie. Wymagane jest bezpieczne ponowne zaparkowanie ciężarówki.<br><br>Wybierz cel szybkiej podróży, aby kontynuować." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Spamiyntowanie..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Wciś knefel $KEY$, coby pōminōńć binã." #+ Shown when any key was pressed during viewpoint cutscene.

