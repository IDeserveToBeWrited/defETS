	key[]: "steam_info_fetch_failed"
	val[]: "Niet in staat om accountinformatie op te halen." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Later" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Niet in staat om de DLC te registreren. Er kon geen permanente licentie worden gevonden. (Steam Family Sharing)" #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Niet permanent eigenaar" #+ The state of the content that cannot be connected due to invalid license.
