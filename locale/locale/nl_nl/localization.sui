#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "De screenshot is te groot. Probeer de resolutie te wijzigen." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "De screenshot is beschadigd of wordt niet ondersteund." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "De resolutie van de screenshot is te hoog. Probeer aub de resolutie te verkleinen" #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "De service heeft de screenshot geweigerd!" #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Het is niet toegestaan om screenshots te uploaden met dit account." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Er was een gelijktijdige upload naar hetzelfde slot." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Uploaden is tijdelijk uitgeschakeld. Probeer het a.u.b. later opnieuw." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Er is een onbekende fout opgetreden tijdens het uploaden. Probeer het a.u.b. later." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "De screenshot is groter dan de maximale grote van $LIMIT$ en is verkleind." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "De screenshot is groter dan de maximale grote van $LIMIT$KB en is verkleind." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

