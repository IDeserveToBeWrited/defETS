#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFISCH" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafisch" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Adjust graphics settings using finely-tuned presets to tailor your game's visual performance to your liking."

	key[]: "apply"
	val[]: "Toepassen" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Bureaublad thema" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "SCHERM" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "BEELDKWALITEIT" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTUREN" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLECTIES" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SCHADUWEN" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "BELICHTING" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "NABEWERKING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "OMGEVING" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Volledig scherm modus" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Helderheid / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Configuratie" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Resolutie" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Verversingssnelheid" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS-limiet" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS-limiet op de achtergrond" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Standaardververssinginstellingen" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Verticale synchronisatie" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Economisch (bespaart energie op notebooks)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "SIMPELE GRAFISCHE INSTELLINGEN" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "AANGEPASTE INSTELLINGEN TOEGEPAST" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "GEAVANCEERDE GRAFISCHE INTELLINGEN" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Simple/advanced graphical settings" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Verberg geavanceerde instellingen" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Laat geavanceerde instellingen zien" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Schaling" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma verscherping" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA-instellingen" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptieve beeldkwaliteit" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Altijd zacht" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Altijd scherp" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Screen Space Ambient Occlusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "High dynamic range (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
