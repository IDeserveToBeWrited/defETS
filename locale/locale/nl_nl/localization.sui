#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Netwerklaag is niet beschikbaar. Controleer alsjeblieft op de client-configuratie correct is."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Kan geen verbinding maken met de online dienst. Controleer alstjeblieft op je internet verbinding werkt."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Fout opgetreden tijdens de communicatie met de online service. Probeer het later opnieuw."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Foute gegevens kwamen terug van de online service. Als je een HTTP proxy gebruikt, controleer dan de configuratie. Probeer het anders later opnieuw."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Foute gegevens kwamen terug van de online service. Probeer het later opnieuw."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "De service is niet beschikbaar voor de huidige versie van dit spel. Controleer of een nieuwe update beschikbaar is voor het spel."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "De service is op dit moment niet beschikbaar. Probeer het later opnieuw."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "De service is tijdelijk niet beschikbaar door werkzaamheden of overbelasting. Probeer het later opnieuw."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "De inloggegevens zijn niet correct. Probeer nogmaals in te loggen."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Dit online account is momenteel vergrendeld omdat er te veel mislukte aanmeldt porgingen zijn gedaan. Probeer het over een half uur opnieuw."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Dit online account is momenteel vergrendeld vanwege verdachte toegangen. Probeer het opnieuw over 24 uur."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Dit spel is niet geregistreerd bij dit online account."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Dit account is nog niet geactiveerd. Controleer je inbox voor een activatie mail."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Dit account is geschorst. Neem contact op met de technische dienst."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Dit account is verboden. Neem contact op met de technische dienst."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxyverificatie wordt niet ondersteund door dit spel. Gebruik een andere proxy of een directe verbinding."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Gewenst object is momenteel niet beschikbaar. Probeer het over een paar minuten opnieuw."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL error. Unable to establish a secure connection."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Interne fout. Het net.log-bestand kan meer informatie bevatten."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 ondervindt problemen en is niet in staat de visualisaties op jouw computer te tonen (er is geen geldig grafisch apparaat gevonden).\nSuggesties: \n\n1. Controleer of jouw computer en videokaart voldoen aan de minimale systeemvereisten.\n2. Voorzie jouw computer van de laatste versie van Microsoft's DirectX.\n3. Download en installeer de laatste stuurprogramma's voor jouw grafische kaart vanaf de website van de fabrikant - mogelijk zijn de sturingsprogramma's verouderd.\n4. Probeer de renderingsmethode om te schakelen van OpenGL naar DirectX of andersom.\n5. Verwijder het configuratiebestand 'config.cfg' in de 'Documenten' - 'Euro Truck Simulator 2'-map. Mogelijk is het bestand beschadigd geraakt.\nDit bestand wordt bij een volgende start van het spel automatisch opnieuw aangemaakt met werkende standaardwaarden."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 heeft een probleem en is niet in staat om afbeeldingen op uw computer weer te geven (er is geen geldige grafische kaart gevonden)."
#@}

