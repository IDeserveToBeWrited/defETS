#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Selectie van thema's die op de achtergrond worden weergegeven wanneer je door het menu bladert."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Zorgt voor een willekeurige bureaubladachtergrond wanneer je het spel start."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Stelt in wanneer de bureaubladelementen uitfaden."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "When enabled, you will begin to experience the effects of fatigue over time.<br><br>Avoiding rest will result in traffic offences."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer ingeschakeld moet je je aan de verkeersregels houden of je loopt het risico op bekeuringen. Het risico is groter in de buurt van politievoertuigen, radar en verkeerscamera's."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Past de gemiddelde afstand van de aangeboden vrachten aan."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Select which speed limit to display on the navigation widget."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "The current speed on the navigation changes to red when the speed limit is exceeded."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "When you reach your destination, a widget will be displayed allowing you to skip parking."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all widgets hidden."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps both HUD mirrors hidden."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all notifications hidden even when they are received."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Toont een waarschuwingsscherm met de specificaties van de huidige vrachtwagen van de speler wanneer een zwaartransportopdracht gestart wordt."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Kies hoe de wereldkaart is uitgelijnd."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Kies hoe je de kaart wil ontdekken:<br>\"Globale verkenning\" markeert een groter gebied als verkend.<br>\"Nauwkeurige verkenning\" onthult alleen het gebied in de onmiddelijke omgeving van de speler."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecteer hoe de navigatie getoond moet worden."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes how the navigation is routed:<br>- \"Best\" navigation mode chooses the most efficient ratio between length and time of the route, tries to avoid junctions with traffic lights, etc.<br>- \"Shortest\" navigation mode chooses always the shortest possible route.<br>- \"Small roads\" navigation mode chooses to avoid highways wherever possible."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes your parking difficulty:<br>- \"Always select\" allows you to choose when you reach your destination.<br>- \"Safe parking\" does not require reversing maneuvers.<br>- \"Skilled parking\" will usually require a more challenging reversing maneuver."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Past de waarschijnlijkheid aan gevaren op de weg zoals ongelukken, voertuigen met pech, straatvuil, etc. tegen te komen."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Pas de kans op omleidingen aan."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Pas de kans op slecht weer aan."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Toont extra tijdzone-informatie naast de actuele tijd."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Schakel de in-game cutscenes in. Deze worden meestal getoond na het kopen van een truck, wanneer je je garage uitbreidt of het laden van passagiers."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Kies of je half doorschijnende blokkades wilt zien op wegen waar je niet in kan rijden."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverteert de Y-as van de muis bij het bedienen van de in-game-camera."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Selects the transmission type:<br>- \"Simple automatic\" allows the use of the accelerator and brake to control forward and reverse motions.<br>- \"Real automatic\" requires an input to switch between forward and reverse gears.<br>- \"Sequential\" requires manual shifting of all gears with gear up/down inputs.<br>- \"H-Shifter\" requires the use of a controller with shift gates to select gears manually."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Het inschakelen van deze functie maakt het mogelijk schakelen naar iedere versnelling over te slaan als dat nodig of praktisch is."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Draait het stuurwiel terug naar de neutrale stand wanneer een toetsenbord of gamecontroller gebruikt wordt. Het uitschakelen van deze optie betekent dat je handmatig het stuurwiel moet terug draaien naar de rechtuit stand na het nemen van een bocht."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Past het bereik van de stuurwielanimatie aan."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Past de gevoeligheid van de remmen aan."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Verandert de stabiliteit van de trailer door het zwaartepunt te laten zakken."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Verandert de stijfheid van de chassisophanging."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Verandert de stijfheid van de cabineophanging."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Adjusts the intensity of procedurally generated surface bumps to give roads and other terrains an imperfect feel.<br><br>Depending on other suspension and camera settings the perceived effect may be more or less prominent."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables advanced coupling which requires greater precision to align the truck's fifth wheel with the trailer's king pin.<br><br>When disabled, coupling a trailer becomes much easier as there is no collision between the king pin and fifth wheel."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Selects if, and which trailer cables are animated.<br><br><color value=@@clr_txt_d@@>Enabling cables on more vehicles may affect performance on older systems."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Enables the truck's electronic speed limiter of 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>World of Trucks jobs have this feature permanently turned on."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer dit is ingeschakeld en de ruitenwissers in de eerste stand staan, worden de ruitenwissers automatisch ingeschakeld en wordt de snelheid aangepast aan de omstandigheden."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Automatische inschakeling van de retarder bij afremmen."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle assists take-off on an incline by holding the brakes, ensuring a smooth start."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Automatische inschakeling van de motorrem bij afremmen."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Wanneer ingeschakeld wordt de motor meteen gestart als je gas geeft."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Hefbare assen zullen automatisch zakken afhankelijk van het voertuiggewicht."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the throttle button is released.<br><br>Affects keyboard input only."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulates real life air loss from excessive brake applications.<br><br>When enabled, you will have to manage your air pressures when descending hills or making slow manoeuvres with multiple brake applications."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Wanneer deze functie is uitgeschakeld, wordt het brandstofverbruik niet beïnvloed door de rijstijl of de wegomstandigheden.<br><br>\n\nWanneer deze functie is ingeschakeld, wordt het brandstofverbruik beïnvloed door verschillende factoren, waaronder de rijstijl, het gewicht van de lading, de rolweerstand en het terreinprofiel. Het wordt niet langer beïnvloed door de @@skill_mechanical_title@@vaardigheid."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Wanneer ABS is ingeschakeld zorgt het ervoor dat de wielen niet blokkeren tijdens een stevige remingreep. Dit bevordert de stabiliteit, het remvermogen en de bestuurbaarheid van het voertuig."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Verandert de stappen waarmee de cruisecontrolsnelheid aangepast kan worden wanneer de desbetreffende toets wordt ingedrukt."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Past de cruisecontrolgevoeligheid aan voor het aanhouden van de ingestelde snelheid."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Wannneer ingeschakeld zal de cruise control een veilige afstand houden tot je voorganger."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activates emergency braking if the system senses an imminent collision.<br>Choose if the system will only react to vehicles or all obstacles."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer deze optie geactiveerd is en de lichtschakelaar staat op de eerste positie, worden de koplampen automatisch ingeschakeld in situaties met weinig licht."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer ingeschakeld en het grootlicht is aan, dan wordt het grootlicht automatisch uitgeschakeld als er een tegemoet komend, of ander dichtbijzijnd voertuig wordt gedetecteerd."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer deze optie geactiveerd is, worden de richtingaanwijzers automatisch uitgeschakeld als het stuurwiel weer in de neutrale stand wordt teruggedraaid."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer deze optie geactiveerd is, zullen sommige interieuraccessoires reageren op de bewegingen van het voertuig (hangende decoraties, wiebelhoofdjes, etc.)"

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Activeert het draaien van de interieurcamera gebaseerd op de stuurinput."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Verandert hoe de “stuurcamerarotatie”-functie reageert op stuurinput."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Verander het gedrag van de 'stuurcamera rotatie' bij het achteruitrijden."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Wannneer ingeschakeld zal de interieur camera naar links of rechts kijken gebaseerd op de indicator."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Wanneer ingeschakeld zal de interieurcamera reageren op bewegingen van het voertuig."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Veranderd hoeveel de interieurcamera reageert op de beweginen van het voertuig."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Stelt in hoe ver de interieurcamera kan meerollen met de voertuigbewegingen."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Sets the delay before the camera automatically recentres.<br><br>The vehicle must be moving at a non-negligible speed for this to activate. Applies only to interior and chasing camera while moving forward and to lean out camera while moving in reverse."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Stelt de snelheid van de camerabeweging in. Dit wordt gebruikt door de automatische centrering van de camera en het schakelen tussen de cameravoorinstellingen van het interieur."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determines how the interior zoom works: hold the button to zoom temporarily, or press once to toggle it." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Selecteer de taal die in het spel getoond wordt."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Verander de instelling van munteenheid en eenheden op basis van de geselecteerde regio."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer geactiveerd, worden de namen van steden en landen getoond in de geselecteerde taal."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer geactiveerd, worden de namen van steden en landen getoon in zowel de geselecteerde taal als in de lokale naam."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de te gebruiken munteenheid."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Schakel tussen 12-uursnotatie of 24-uursnotatie."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de te gebruiken afstandseenheden."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de te gebruiken massa-eenheden."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de te gebruiken temperatuureenheden."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de drukeenheden."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de te gebruiken volume-eenheden."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Kies de verbruikeenheden."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer aangezet, gebruik van de \"Activatieknop\" (@@imv_nrm_activate@@) zal de chat openen tijdens Konvooisessies."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer aangezet, zal de chat invoerbalk actief blijven nadat een bericht is verstuurd."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer aangezet, zullen chat berichten na een paar seconden verdwijnen."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Veranderd hoe lang chat berichten blijven staan voordat ze verwijden."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Wanneer aangezet, zal je spelers namen kunnen zien boven hun vrachtwagens in Konvooisessies."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Opent een geavanceerd menu om de snelreacties voor chat berichten in Konvooisessies aan te passen."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Controleer de status van jouw World of Trucks verbonden inhoud."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Schakelt het downloaden van online nieuws op het titelscherm in."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Enables downloading of community screenshots selected from the World of Trucks website that are displayed as loading screens."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Schakelt het downloaden van echte advertenties in, die getoond worden op geselecteerde in-game billboards."
