#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Plaats je liedjes in <color value=@@clr_sel@@>Euro Truck Simulator 2/music <color value=@@clr_txt@@>map in <color value=@@clr_sel@@>Mijn Documenten <color value=@@clr_txt@@>en je zult ze hier zien."

