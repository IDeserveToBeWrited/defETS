	key[]: "browse_connected_content"
	val[]: "Zoeken" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "Algemene instellingen" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "VERBIND CONTENT" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Verbinden" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "Er is nieuwe spelinhoud gevonden door World of Trucks. Verbind met Word of Trucks om toegang te krijgen tot de nieuwe inhoud." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online instellingen. Hier kan je alles aanpassen dat te maken heeft met World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Weet je zeker dat je het registreren wilt uitstellen?<br><br>Je kan het Online Connect Content dialoog later nog openen." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "VERBINDEN VAN CONTENT" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Verbinden van content..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Het verbinden van content is mislukt voor: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Het steam-account dat je hebt gebruikt om de DLC's te registreren is niet gelijk aan het steam-account dat gebruikt werd om een World of Trucks-account aan te maken. Probeer het opnieuw met een ander steam-account." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Het Steam-account dat je gebruikt om de DLC's te registreren is al gekoppeld aan een ander World of Trucks-account. Om verder te gaan heb je een Steam-account nodig dat nog niet verbonden is met World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token is verlopen. Probeer het later opnieuw" #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "De productcode is niet meer geldig. Om het probleem te verhelpen moet je contact opnemen met: support@scssoft.com (Engels)" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Er is iets misgegaan tijdens de registratie. Probeer het later opnieuw." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCCES" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "CONTENT (inhoud) BROWSER" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Gefeliciteerd! Jouw DLC's zijn succesvol verbonden met World of Trucks!" #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Kan geen content verbinden aan World of Trucks; het huidige Steam-account is al gekoppeld aan een ander World of Trucks account." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Sommige DLCs konden niet worden verbonden. <br> Houd de muis over het uitroepteken voor meer details." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registreren $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Current profile is not connected to World of Trucks or the game is running in offline mode. Edit profile to connect." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Click to Dismiss"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLCs verbonden. Als DLCs niet verbonden zijn met World of Trucks kan je de features ervan niet gebruiken." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Gefeliciteerd! <color value=@@clr_txt@@>Alle DLCs zijn verbonden met World of Trucks! Je kan nu alle features gebruiken." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Kan geen nieuwe content verbinden aan World of Trucks; het huidige Steam-account komt niet overeen met het Steam-account dat is gekoppeld aan World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Verbonden" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Niet verbonden" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Niet in staat om gegevens op te halen" #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
