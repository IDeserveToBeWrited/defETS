#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SELECTEER BESTURINGSMETHODE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Besturing"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>De wizard past de aanbevolen instellingen toe aan de hand van de aangesloten apparaten.<br><color value=@@clr_sel@@>Als je een Steam-compatibele gamepad gebruikt, overweeg dan om de configuratie-ondersteuning toe te passen via <br><color value=@@clr_txt_d@@>\"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Rij met behulp van het toestenbord en kijk de wereld rond met de muis. De eenvoudigste maar de minst nauwkeurige vorm van besturing die voor iedereen beschikbaar is."

	key[]: "wiz_control_mouse"
	val[]: "Gebruik de muis voor een meer gevoelige besturing. Andere acties worden nog steeds uitgevoerd op het toetsenbord. Je kunt de muis gebruiken om rond te kijken maar alleen als je tegelijkertijd in bezit bent van een speciale camerabesturingsknop of -toets."

	key[]: "wiz_control_controller"
	val[]: "Gebruik een wiel, gamepad of joystick voor de meest realistische game-ervaring. Toetsenbordsneltoetsen kunnen nog steeds gebruikt worden voor veel acties en je kunt vrij kijken met de muis."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Er is geen spelbesturing gevonden. Je moet er nu eentje aansluiten om deze optie te kunnen kiezen!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Beschikbare controllers zoeken ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECTEER CONTROLLER-API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - In-game Mapping Mode (recommended)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Steam Client Mapping Mode"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klassieke Controller"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepads like @@controller_ps5@@, @@controller_xbox_one@@ or @@controller_steam_deck@@ opted into the Steam Input interface and using simple layout.<br><br>Supports full in-game key binding configurations."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepads opted into the Steam Input interface and using standalone layouts configured through the Steam Client.<br><br>Limited support for in-game button hints and no in-game binding configurations."

	key[]: "wiz_api_classical"
	val[]: "Controller, stuurwiel, of joystick gebruikmakend van DirectInput, Xinput of soortgelijke interface."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELECTEER CONTROLLERSOORT"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Stuurwiel"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad of joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "De besturing is een stuur of gedraagt zich zo. De positie van de besturing bepaalt de directe positie van het stuurwiel in het spel."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "De besturing is een gamepad of joystick. De positie van de besturing bepaalt de rotatiesnelheid van het stuur in het spel."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECTEER VERSNELLINGSBAKSOORT" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Deze eigenschap heeft een stuur, gamepad of joystick nodig."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Geen H-shifter HW besturing gevonden; deze functie is mogelijk onbruikbaar."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECTEER HANDMATIGE VERSNELLINGSBAKINDELING"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Range transmissie is de simpelste keuze. Het heeft twee sets van versnellingen. De eerste set bevat versnelling 1 tot 6 en de tweede set bevat versnelling 7 tot 12. Een wisselknop schakelt tussen deze twee sets terwijl de versnellingspook een specifieke versnelling kiest van deze set."

	key[]: "wiz_hs_splitter"
	val[]: "Splittertransmissie is een simpel alternatief. Het heeft ook twee sets van versnellingen. De eerste set bevat de oneven versnelling (1, 3, 5 ...) en de tweede set bevat de even versnelling (2, 4, 6 ...). Een wisselknop schakelt tussen deze twee sets. Terwijl de versnellingspook een specifieke versnelling kiest van die set."

	key[]: "wiz_hs_range_splitter"
	val[]: "Range-splitter versnellingsbakken zijn gebaseerd op echte range-splitter layouts. De versnelling zitten in een groep van 4 en gebruiken twee splitterknoppen. We raden je aan deze versnellingsbak alleen te gebruiken als je een ervaren trucker bent."
#@}

#@}

