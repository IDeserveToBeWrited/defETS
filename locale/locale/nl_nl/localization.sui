#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Ga verder ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Welkom bij Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Eindelijk heb je de kans om je droombaan te ervaren - het besturen van een vrachtwagen!"

	key[]: "intro_3"
	val[]: "Je eigen transportbedrijf is nu geopend, maar helaas heb je niet genoeg geld om een vrachtwagen te kopen. Op dit moment zal je als ingehuurde chauffeur moeten werken voor andere bedrijven."

	key[]: "intro_4"
	val[]: "Je taak is om veilig een lading van $JOB_CARGO$ naar het dok van $JOB_TARGET_COMPANY$ in $JOB_TARGET_CITY$ te brengen. Je werkgever heeft je een voertuig gegeven en zal alle uitgaven dekken. Laat niemand zakken en kom op tijd aan."


	key[]: "intro_garage_1"
	val[]: "Dit is je hoofdkwartier."

	key[]: "intro_garage_2"
	val[]: "Het is een leuke basisgarage. Het is niet veel, maar het is een begin."

	key[]: "intro_garage_3"
	val[]: "Helaas heb je niets om hier te parkeren, dus er staan geen vrachtwagens in het zicht."

	key[]: "intro_garage_4"
	val[]: "Als je genoeg geld hebt verdiend en een vrachtwagen gekocht, kun je vrij door de wereld rijden en vanaf hier je eigen bedrijf runnen."

	key[]: "intro_garage_5"
	val[]: "Veel succes!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE ONTGRENDELD"

	key[]: "desktop_tut_job"
	val[]: "Kies je volgende opdracht"

	key[]: "desktop_tut_cargo_market"
	val[]: "Gebruik je nieuwe trailer om een groot aantal ladingen te leveren naar hun bestemmingen via de Ladingmarkt." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Hier kun je je voortgang zien."

	key[]: "desktop_tut_company"
	val[]: "Volg je garages, huur nieuwe chauffeurs in en beheer je bedrijf op andere manieren hiervan uit."

	key[]: "desktop_tut_trailers"
	val[]: "Vanaf nu kan je je eigen trailers kopen, aanpassen en spuiten om te matchen met je vrachtwagen.<br><br>Je trailers worden opgeslagen in de gekozen garage(s); ze kunnen gebruikt worden om de winst van je chauffeurs te vergroten. Om je trailers te beheren, gebruik de Trailerbeheerder."

	key[]: "desktop_tut_visit_directive"
	val[]: "Bezoek $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "WELKOM"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Welkom bij het nieuwe Bureaublad.<br>Van hieruit kun je navigeren naar alle functies in het spel."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Hieronder geeft het hoofdmenu direct toegang tot alle hoofd spelfuncties waar je mee bekend bent."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Bovenin is de nieuwe Statusbalk die constant zichtbaar is voor de speler en handige informatie toont, zoals profielstatistieken en lokale regelgeving."

	key[]: "desktop_tut_tour_home"
	val[]: "De Bureaubladknop is altijd hier om je terug te brengen naar je Bureaublad."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Een permanent Snelmenu biedt handige snelkoppelingen naar alle gamefuncties vanaf elk scherm."

	key[]: "desktop_tut_tour_drive"
	val[]: "De vernieuwde Driveknop blijft je verbinding met de wereld van het rijden, klaar om je weer op weg te helpen."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL AFGEROND"

	key[]: "desktop_tut_tour_finish"
	val[]: "Dankjewel voor het bekijken van onze Bureaubladupdate."
