	key[]: "press_or_hold_key_to_assign"
	val[]: "DRUK op of HOUD de toets ingedrukt die je wilt toewijzen aan deze functie." #+ Key/button assignment hint.

	key[]: "press_button_to_assign"
	val[]: "Druk op de toets die je wilt toewijzen aan deze functie."#+ Key/button/axis assignment hint.

	key[]: "select_input_to_unassign"
	val[]: "Selecteer input waarvoor je de toewijzing wilt annuleren" #+ Hint shown when "unassign" button pressed.

	key[]: "lost_function_binding"
