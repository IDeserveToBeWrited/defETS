	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the range of the clutch.<br><br>The further to the right you set the range, the further you'll need to depress the pedal to engage the clutch."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used to tilt the camera up and down."

