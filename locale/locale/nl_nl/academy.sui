#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Camerabediening"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "In dit scenario maken we kennis met de verschillende soorten camera's die beschikbaar zijn en hoe deze je kunnen helpen bij het besturen en manoeuvreren van de vrachtwagen."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Stoelpositie"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Zicht naar achteren"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Spiegelcontrole"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Wissel naar de Externe Camera"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Kijk rond de vrachtwagen"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "In dit scenario zullen we de verschillende camera's doornemen<br>die beschikbaar zijn voor gebruik."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Er zijn in totaal zeven camera's waaruit je kunt kiezen.<br>We zullen er nu een paar doornemen en de functies ervan uitleggen."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "De verschillende camera's en hun verschillende hoeken kunnen je helpen bij het manoeuvreren in krappe ruimtes."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Kijken waar je naartoe rijdt is de basis voor veilig en professioneel rijden. Als de huidige zitpositie niet bij je past, kun je deze aanpassen via '@@adjust_link_t@@' (via het pauzemenu).<br><br><font face=/font/big_bold.font>Bevestig wanneer je er klaar bent met @@imv_nrm_activate@@.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Tijdens het achteruitrijden zullen je spiegels je niet altijd goed zicht geven. Het kan zijn dat je uit het raam moet kijken om een beter zicht achter je te krijgen.<br><br><font face=/font/big_bold.font>Draai je camera volledig richting het raam aan de bestuurderskant om uit het raam richting de trailer te kijken.</font>@@aca_goal_tip@@ Je moet in het voertuig zitten om dit te kunnen doen."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Gebruik dit zicht om de aanhanger in de gaten te houden tijdens het achteruitrijden met een aanhanger. Het is altijd beter om achteruit te rijden naar de bestuurderskant, zodat je dit zicht kunt gebruiken. Wanneer je achteruitrijdt naar de passagierskant, heb je een veel beperkter zicht op wat er achter je gebeurt.<br><br><font face=/font/big_bold.font>Kijk naar de passagierskant.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Dit is de reden waarom het doorgaans niet wordt aanbevolen om achteruit te rijden richting de passagierszijde; je ziet dat het zicht vrij beperkt is. Gelukkig zijn er ook zeven camera's aan de buitenkant beschikbaar. <br><br>Met de knop @@imv_nrm_camcycle@@ kun je naar de volgende camera in de reeks schakelen. Nadat je alle zeven camera's hebt doorlopen, keer je terug naar het begin van de cyclus. <br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_camcycle@@ om naar de volgende camera te schakelen.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "De externe camera biedt het beste perspectief op wat er rondom de vrachtwagen gebeurt.<br><br><font face=/font/big_bold.font>Kijk om je heen.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Door nogmaals op @@imv_nrm_camcycle@@ te drukken, kunt je naar de volgende camera schakelen. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Het bovenaanzicht biedt een uitstekend overzicht van de situatie rondom de vrachtwagen, waardoor parkeren en rijden in krappe ruimtes aanzienlijk wordt vereenvoudigd.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_camcycle@@ om naar de volgende camera te schakelen.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "De dakcamera biedt een duidelijk zicht op de weg ver voor de vrachtwagen zonder al te veel obstakels.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_camcycle@@ om over te schakelen naar de laatste camera die we zullen bekijken.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "De achteruitkijkcamera is een kortere weg naar het zicht dat je eerder kreeg door uit de vrachtwagen te leunen. Zoals we al zeiden, is dit handig bij het achteruitrijden of parkeren.<br><br>In de game hebben we meer camera's die je kunt uitproberen door herhaaldelijk op @@imv_nrm_camcycle@@ te drukken.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_cam1@@ om terug te keren naar de interieurcamera.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Eerste Rit"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "In dit scenario leren we hoe we de vrachtwagen voorbereiden, en hoe we vervolgens voor het eerst vooruit rijden."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Start de motorontsteking"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "De motor aanzetten"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Controleer de omgeving"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "De rem gebruiken"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Naar de goede versnelling schakelen"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "De handrem loslaten"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Vooruit rijden"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Stoppen"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "De handrem inschakelen"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Naar neutraal schakelen"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "De motor uitzetten"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Tijdens de eerste paar ritten maken we alleen gebruik van de trekker.<br>Een vrachtwagen wordt een trekker genoemd als deze geen eigen laadbak heeft, maar in plaats daarvan een oplegger gebruikt om goederen en materialen te vervoeren."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Trekkers worden veel gebruikt omdat ze veelzijdiger zijn: ze kunnen een lege oplegger neerzetten en een geladen oplegger ophalen zonder te hoeven wachten, of overschakelen naar een compleet ander type oplegger."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Voor je eerste rit is het je taak om vooruit te rijden en te stoppen na de stippellijn.<br>Start de motor en volg de instructies om de trekker klaar te maken voor vertrek. Rijd rechtdoor zodra je klaar bent."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Rijd voorbij de stippellijn, stop, zet de motor af en zet de vrachtwagen vast."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "De volgende stap van je training is het besturen van de vrachtwagen.<br><br>Dit gaat natuurlijk niet zonder draaiende motor, dus schakel eerst het contact in.<br><br><font face=/font/big_bold.font>Druk op $input engineelect$ om het contact in te schakelen.</font>@@aca_goal_tip@@ De standaardinstelling is dat de motor tegelijkertijd start met het inschakelen van het contact. In de carrieremodus kun je dit aanpassen via Opties - 'Gameplay' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Het contact activeert de elektronica van de truck. Het is u misschien opgevallen dat waarschuwingslampjes op het dashboard knipperen - dat is normaal. Als ze blijven branden nadat de motor is gestart, wijst dat waarschijnlijk op een probleem met de truck. Een uitzondering hierop is het lampje van de parkeerrem, dat uitgaat wanneer we de parkeerrem loslaten.<br><br>Gelukkig is deze truck in goede staat en kunnen we verder.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_engine@@ om de motor te starten.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Nu dat de motor aanstaat, is het cruciaal om je omgeving te controleren voordat je gaat rijden.<br><br><font face=/font/big_bold.font>Kijk rond de vrachtwagen en in je spiegels aan beide kanten om te controleren dat het gebied rondom de vrachtwagen vrij is van obstakels.</font>@@aca_goal_tip@@ Je moet in het voertuig zitten om dit te kunnen doen."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Het lijkt misschien voor de hand liggend, maar je moet weten hoe je moet stoppen voordat je gaat bewegen.<br><br><font face=/font/big_bold.font>Activeer de bedrijfsrem met $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Vervolgens leer je hoe je van rijrichting kunt veranderen.<br><br>Met een vereenvoudigde automatische transmissie hoeft je niet te schakelen, alles gebeurt automatisch.<font face=/font/big_bold.font><br><br>Gebruik $input forward$ om een vooruitversnelling te activeren.</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Vervolgens leer je hoe je van rijrichting kunt veranderen.<br><br>Met de realistische automatische transmissie moet je net als in een echte automatische transmissie schakelen tussen vooruit, neutraal en achteruit.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_gearup@@ om een vooruitversnelling te activeren. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Vervolgens leer je hoe je van rijrichting kunt veranderen.<br><br>De sequentiële transmissie maakt stapsgewijs schakelen mogelijk, net als een echte sequentiële transmissie.<br><br>Op dezelfde manier als bij het inschakelen van een vooruitversnelling, moet u tijdens het accelereren naar een hogere versnelling schakelen.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_gearup@@ om de eerste versnelling in te schakelen.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Vervolgens leer je hoe je van rijrichting kunt veranderen.<br><br>Met de versnellingspook en de koppeling ervaar je hetzelfde gevoel van fysiek schakelen als bij een echte handgeschakelde versnellingsbak.<br><br>Druk de koppeling en de bedrijfsrem volledig in. <font face=/font/big_bold.font>Gebruik de versnellingspook om de eerste versnelling in te schakelen. <color value=@@clr_txt@@>Houd de koppeling en de bedrijfsrem volledig ingedrukt.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Voordat je begint met rijden, moet je de handrem eraf halen.<br><br><font face=/font/big_bold.font>Gebruik @@imv_nrm_parkingbrake@@ om de handrem uit te schakelen.</font>@@aca_goal_tip@@ In de carrière start de handrem uitgeschakeld. Je kan dit aanpassen in het optiesmenu - 'Gameplay' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Nu is de vrachtwagen klaar om vooruit te rijden. Begin met rijden en passeer de stippellijn.<br><br><font face=/font/big_bold.font>Begin met rijden door het gaspedaal in de drukken: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Nu is de vrachtwagen klaar om vooruit te rijden. Begin met rijden en passeer de stippellijn.<br><br><font face=/font/big_bold.font>Begin met rijden door het gaspedaal in de drukken: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Nu is de vrachtwagen klaar om vooruit te rijden. Begin met rijden en passeer de stippellijn.<br><br><font face=/font/big_bold.font>Begin met rijden door het gaspedaal in de drukken: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Nu is de vrachtwagen klaar om vooruit te rijden. Begin met rijden en passeer de stippellijn. <br><br><font face=/font/big_bold.font>Laat de bedrijfsrem los en laat de koppeling geleidelijk opkomen om deze in te schakelen. Gebruik tegelijkertijd het gaspedaal om het toerental hoog te houden, zodat de truck niet afslaat. Zodra de koppeling volledig is losgelaten, kunt u accelereren en indien nodig schakelen. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Gebruik de bedrijfsrem om te stoppen.<br><br><font face=/font/big_bold.font>Gebruik $input backward$ om de vrachtwagen te stoppen.</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Gebruik de bedrijfsrem om te stoppen.<br><br><font face=/font/big_bold.font>Gebruik $input backward$ om de vrachtwagen te stoppen.</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Gebruik de bedrijfsrem om te stoppen.<br><br><font face=/font/big_bold.font>Gebruik $input backward$ om de vrachtwagen te stoppen.</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Als het tijd is om te stoppen, trapt u de koppeling volledig in <font face=/font/big_bold.font> en brengt u de vrachtwagen vervolgens tot stilstand met behulp van de bedrijfsrem.<color value=@@clr_txt@@> Schakel met de versnellingspook naar neutraal en laat vervolgens de koppeling los.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Zet de vrachtwagen nu vast. De parkeerrem zorgt ervoor dat de vrachtwagen niet onbedoeld in beweging komt nadat u geparkeerd hebt.<br><br><font face=/font/big_bold.font>Gebruik @@imv_nrm_parkingbrake@@ om de parkeerrem te activeren.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Met een vereenvoudigde automatische transmissie hoeft u niet te schakelen, alles gebeurt automatisch.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_activate@@ om te bevestigen.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Schakel naar z'n vrij door te drukken op @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font> Schakel naar z'n vrij door te drukken op @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Zet de versnellingspook in neutraal en laat vervolgens de koppeling los. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Je weet nu hoe je de truck in beweging moet krijgen en veilig moet laten stoppen. <font face=/font/big_bold.font><font face=/font/big_bold.font> Druk op $input engineelect$ om de motor uit te zetten. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Achteruit rijden"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "In dit scenario proberen we voor het eerst achteruit te rijden. We bespreken ook hoe je je spiegels kunt gebruiken om achter je te kijken, waar je op moet letten en hoe je je kunt voorbereiden op achteruitrijden."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "De motor aanzetten"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "De passagierskant spiegel controleren"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "De bestuurderskant spiegel controleren"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Naar de goede versnelling schakelen"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "De handrem loslaten"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Naar neutraal schakelen"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "De motor uitzetten"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Voor deze rit rijden we in een rechte lijn achteruit. Je moet voorbij de stippellijn achteruitrijden en daar stoppen."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Bij het achteruitrijden is het essentieel om constant om je heen te kijken, alle spiegels in de gaten te houden en ervoor te zorgen dat de ruimte om je heen en achter je vrij is."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Start de motor, schakel naar achteruit en begin met rijden."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Rijd achteruit voorbij de stippellijn, stop, zet de motor af en zet de truck vast."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Maak de vrachtwagen klaar om te rijden zoals je hebt geleerd in het vorige scenario.<br><br><font face=/font/big_bold.font>Wanneer je er klaar voor bent, start je de motor.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Controleer je spiegels om er zeker van te zijn dat de omgeving rond je truck veilig is. Als je niet tevreden bent met de posities van de spiegels, kun je ze altijd aanpassen in '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Kijk in de passagiersspiegel.</font>@@aca_goal_tip@@ Je moet in het voertuig zitten."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Je passeert de onderbroken streep. De rijstrook is nu vrij, maar tijdens normaal rijden is het essentieel om constant je omgeving in de gaten te houden door om je heen te kijken en in de spiegels te kijken.<br><br><font face=/font/big_bold.font>Kijk in je bestuurdersspiegel.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Gebruik $input backward$ om naar de achteruitversnelling te wisselen. </font>@@aca_goal_tip@@ Tijdens het achteruitrijden, het achteruitrijalarm activeert automatisch op meeste vrachtwagens. Je kan dit uitzetten in het optiesmenu - 'Geluid' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Druk op @@imv_nrm_geardown@@ om naar de achteruitversnelling te wisselen. </font>@@aca_goal_tip@@ Tijdens het achteruit rijden, zal de vrachtwagen automatisch het achteruitrijalarm activeren. Je kan dit uitzetten in het optiesmenu - 'Geluid' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Druk op @@imv_nrm_geardown@@ om naar de achteruitversnelling te wisselen. </font>@@aca_goal_tip@@ Tijdens het achteruit rijden, zal de vrachtwagen automatisch het achteruitrijalarm activeren. Je kan dit uitzetten in het optiesmenu - 'Geluid' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Druk de koppel volledig in en wissel naar de achteruitversnelling. </font>@@aca_goal_tip@@ Tijdens het achteruit rijden, zal de vrachtwagen automatisch het achteruitrijalarm activeren. Je kan dit uitzetten in het optiesmenu - 'Geluid' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "De achteruitversnelling is nu ingeschakeld.<br><br><font face=/font/big_bold.font>Laat de parkeerrem los met @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Begin met bewegen door $input backward$ te gebruiken.<br><br><font face=/font/big_bold.font>Ga achteruit voorbij de stippellijn.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Begin met bewegen door het gaspedaal te gebruiken: $input forward$.<br><br><font face=/font/big_bold.font>Rijd achteruit voorbij de stippellijn.</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Begin met bewegen door het gaspedaal te gebruiken: $input forward$.<br><br><font face=/font/big_bold.font>Rijd achteruit voorbij de stippellijn.</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Laat de koppeling langzaam los, terwijl u het toerental van de motor op peil houdt door het gaspedaal in te drukken. <br><br><font face=/font/big_bold.font>Rijd achteruit voorbij de stippellijn. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Stop de vrachtwagen met uw bedrijfsrem: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Stop de vrachtwagen met uw bedrijfsrem: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Stop de vrachtwagen met uw bedrijfsrem: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Druk de koppeling volledig in en breng de vrachtwagen vervolgens tot stilstand met behulp van de bedrijfsremmen.</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Activeer de parkeerrem met @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Met een vereenvoudigde automatische transmissie hoeft u niet te schakelen, want alles wordt automatisch voor u gedaan, in tegenstelling tot in werkelijkheid.<br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_activate@@ om te bevestigen.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Schakel naar neutraal door op @@imv_nrm_gearup@@ te drukken.</font>@@aca_goal_tip@@ Moderne vrachtwagens zullen automatisch naar neutraal schakelen wanneer de parkeerrem is geactiveerd. Let wel op, het is nog steeds een goede gewoonte om dit zelf te doen. In de volgende scenario's zullen we deze stap niet van je verwachten."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Schakel naar neutraal door op @@imv_nrm_gearup@@ te drukken.</font>@@aca_goal_tip@@ Moderne vrachtwagens zullen automatisch naar neutraal schakelen wanneer de parkeerrem is geactiveerd. Let wel op, het is nog steeds een goede gewoonte om dit zelf te doen. In de volgende scenario's zullen we deze stap niet van je verwachten."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Schakel naar neutraal en laat de koppeling los.</font>@@aca_goal_tip@@ Moderne vrachtwagens zullen automatisch naar neutraal schakelen wanneer de parkeerrem is geactiveerd. Let wel op, het is nog steeds een goede gewoonte om dit zelf te doen. In de volgende scenario's zullen we deze stap niet van je verwachten."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Let altijd op je omgeving als je achteruit rijdt, zeker in drukke gebieden met veel verkeer. <font face=/font/big_bold.font>Schakel de motor uit door te drukken op $input engineelect$. </font>"
#@}

