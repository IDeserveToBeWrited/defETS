#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Welkom bij het eerste deel van het afsluitende examen. Hier kijken we hoe goed je hebt leren vrachtwagenrijden na je tijd op de Academie."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Eerst koppel je de aanhanger aan. Daarna rijd je met de vrachtwagen over het hele testterrein."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Het eerste deel van het traject loopt van de kleine parkeerplaats naar het oostelijke testparcours."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Het parcours bevat uitdagende passages tussen barrières."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Een belangrijk deel van de route loopt via het oostelijke testtraject."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "We testen uw vermogen om de vrachtwagen door verschillende situaties te manoeuvreren."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Je manoeuvreert met de truck door een aantal scherpe bochten."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "U rijdt over het weggedeelte dat de parcoursen met elkaar verbindt."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Het laatste onderdeel betreft het rijden over een klein circuit."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Het circuit heeft veel ingewikkelde passages en scherpe bochten."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Voor het voltooien van de toets moet je correct geparkeerd staan."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "U hoeft zich geen zorgen te maken. Alles wat u nodig heeft om te slagen, hebt u al geleerd.<br><br>Veel succes!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Voor u staat de aanhanger.<br><br><font face=/font/big_bold.font>Rijd richting de aanhanger.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Lijn de tractor uit met de aanhanger.<br><br><font face=/font/big_bold.font>Rijd achteruit en sluit de aanhanger aan op de fuseepen.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zet de vrachtwagen vast. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Druk op @@imv_nrm_attach@@<font face=/font/big_bold.font> om de trailer te verbinden. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "De oplegger is aangekoppeld en de vrachtwagen is klaar om te rijden.<br><br><font face=/font/big_bold.font>Zet de parkeerrem los. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Rijd richting de uitgang van de parkeerplaats.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Volg de wegmarkeringen en let op de vangrails.<br><br><font face=/font/big_bold.font>Rijd door.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Er komt een uitdagender gedeelte aan.<br><br><font face=/font/big_bold.font>Navigeer voorzichtig tussen de barrières. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Blijf rijden.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "In dit onderdeel worden je vaardigheden op de proef gesteld bij het manoeuvreren van een aanhanger door verschillende bochten.<br><br><font face=/font/big_bold.font>Sla de baan op. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Rijd door de passage.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Rijd rechtdoor.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Neem de bocht voorzichtig. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Je komt op een complexer traject. Rijd voorzichtig.<br><br><font face=/font/big_bold.font>Blijf bergafwaarts rijden.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Maak een scherpe bocht naar links.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Verlaat het circuit.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "U komt nu op een gemakkelijker gedeelte.<br><br><font face=/font/big_bold.font>Rijd verder de heuvel af.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Blijf op de weg rijden.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Verderop is de afslag naar de volgende route.<br><br><font face=/font/big_bold.font>Rijd door. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Ga rechtsaf.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Blijf op het parcours rijden.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Er komen meer scherpe bochten aan.<br><br><font face=/font/big_bold.font>Pas uw snelheid dienovereenkomstig aan.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Maak een bocht naar links.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Rijd gewoon door.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Blijf rijden.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Om de bocht te maken, moet u mogelijk iets van het asfalt af.<br><br><font face=/font/big_bold.font>Draai voorzichtig en gebruik zoveel ruimte als u nodig hebt.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Verlaat het circuit en rijd naar de parkeerplaats.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Praktijkexamen (Deel 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Het laatste deel van het eindexamen wacht op je, waar de parkeervaardigheden die je in eerdere scenario's hebt geleerd, worden beoordeeld. Parkeer zorgvuldig en nauwkeurig en je bent klaar om als bekwame vrachtwagenchauffeur de Europese wegen op te gaan!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Verschuivende manoeuvre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Diagonaal parkeren"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Door het parkeerterrein rijden"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parallel parkeren"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Laatste keer parkeren"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Welkom bij het tweede deel van het eindexamen. We gaan naar een nabijgelegen parkeerplaats en testen je vaardigheden in achteruitrijden en manoeuvreren in parkeervakken."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Verschillende opeenvolgende parkeeruitdagingen wachten op u om uw vaardigheden op de proef te stellen."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "De ruimte is beperkt, dus wees voorzichtig en neem de tijd."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Wees voorzichtig en haast je niet. Het is oké als het je niet meteen lukt, het belangrijkste is dat je de truck of de mensen om je heen niet beschadigt. <font face=/font/big_bold.font><br><br>Bereid je voor op vertrek. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Rijd vooruit naar het eerste deel van het examen.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Je eerste taak is om de manoeuvre voor het verschoven parkeren te demonstreren. De plek waar je achteruit moet rijden met de aanhanger is aan je linkerhand.<br><br><font face=/font/big_bold.font>Voer een manoeuvre voor het verschoven parkeren uit.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "De volgende taak is om achteruit te rijden tussen een rij stilstaande vrachtwagens. Pas op dat je de andere vrachtwagens niet raakt!<br><br><font face=/font/big_bold.font>Maak een diagonale parkeermanoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Rijd door over de parkeerplaats. Wees alert op onverwachte situaties.<br><br><font face=/font/big_bold.font>Rijd door.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Laten we nu proberen parallel te parkeren tussen de twee vrachtwagens aan de stoeprand voor u.<br><br><font face=/font/big_bold.font>Voer een parallelle parkeermanoeuvre uit.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Nog een laatste parkeermanoeuvre aan uw linkerhand! U kunt deze manoeuvre op uw eigen manier uitvoeren.<br><br><font face=/font/big_bold.font>Rijd achteruit de aangewezen zone in.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Bijna klaar. Verlaat het testterrein en parkeer de vrachtwagen.<br><br><font face=/font/big_bold.font>Verlaat het testterrein aan uw linkerhand.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Je kan de truck rechts bij de andere trucks parkeren. <br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parallel parkeren met een aanhangwagen"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "In this scenario, we'll take a look at parallel parking with the trailer connected."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Stoppen in het gemarkeerde gebied"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parallel parkeren met een aanhanger is een relevante vaardigheid voor alle vrachtwagenchauffeurs.<br>Of het nu gaat om parkeren op straat in een grote stad of stoppen bij een parkeerplaats op het platteland, het is iets wat iedere vrachtwagenchauffeur zou moeten kunnen."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Kijk bij het passeren van de parkeerplaats goed of er voldoende ruimte is voor de trekker en aanhanger. Hier hebben we ervoor gezorgd dat u voldoende ruimte heeft."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Positioneer je ten opzichte van de vrachtwagen voor de parkeerplaats. Ga er niet te dicht bij staan, maar houd er voldoende afstand van zodat je voldoende ruimte hebt om te werken."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Draai scherp weg van de parkeerplaats en begin achteruit te rijden. Het is de bedoeling dat de aanhanger direct de parkeerplaats opdraait."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Zodra de aanhanger goed op de plek staat, kunt u hem gaan volgen."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Begin met het wegsturen van de aanhanger van de stoeprand voordat de wielen van de aanhanger aan de bestuurderskant de stoeprand hebben bereikt."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Zet de trekker met oplegger recht en centreer uzelf in het parkeervak.<br> Parkeer de vrachtwagen, zet de motor af en zet hem vast."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Je kunt de parkeerplaats voor je zien, tussen de andere vrachtwagens. Kijk tijdens het parkeren goed in je spiegels en houd een veilige afstand tussen de vrachtwagen en de obstakels om je heen.<br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Rijd over het parkeerterrein om uw parkeerplaats te vinden.<br><br><font face=/font/big_bold.font>Rijd vooruit. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Rij voorbij het gewenste parkeervak in het gemarkeerde gebied. Hier kan je beginnen met de achteruitrijmanoeuvre.<br><br><font face=/font/big_bold.font>Stop op de aangegeven locatie. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Draai de tractor weg van de plek om de aanhanger erin te draaien. Maak geen te scherpe bocht, anders rijdt u tegen de stoeprand aan. <br><br><font face=/font/big_bold.font>Begin met achteruitrijden. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Lijn de trailer op met de plek. Indien nodig, beweeg voor,- of achterwaarts terwijl je de benodigde stuurcorrecties toepast om je positie aan te passen.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Gefeliciteerd, u hebt de examens voor de basisopleiding vrachtwagenchauffeur met succes afgerond en u hebt alle vaardigheden geleerd die u nodig hebt om uw vrachtwagen goed te besturen."

	key[]: "aca_msg_book1_outro02"
	val[]: "Dit is de eerste stap op weg naar het verwezenlijken van uw droom om professioneel vrachtwagenchauffeur te worden."

	key[]:	"aca_msg_book1_outro03"
	val[]: "U bent nu klaar om de wegen van Europa op te gaan en uw eerste uitdagingen aan te gaan..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...maar het avontuur is nog maar net begonnen."
#@}


