	key[]: "aca_book_inaccessible_t"
	val[]: "BINNENKORT"

	key[]: "aca_book_inaccessible_u"
	val[]: "Binnenkort!"

	key[]: "aca_book_disclaimer_t"
	val[]: "Vrijwaring"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Dit is geen gecertificeerd trainingsprogramma."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ is niet bedoeld ter vervanging van een rijopleiding.</font><br><br> <color value=@@clr_txt@@> Wij raden met klem aan om een opleiding te volgen van een gecertificeerd trainingsinstituut voordat je probeert een truck in het echte leven te besturen.<br><br>Traininingsinstituten die geïntresseerd zijn om onze rijschool als aanvulling te gebruiken op hun rijopleiding kunnen contact met ons opnemen via academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Truck Basis Rijvaardigheid"

	key[]: "aca_book_book1_desc"
	val[]: "Leer de basisbeginselen van het besturen van een vrachtwagen, van basisfuncties en bedieningselementen tot het manoeuvreren met een aanhanger."

	key[]: "aca_book_book2_title"
	val[]: "Rijvaardigheid in een Vrachtwagen"

	key[]: "aca_book_book2_desc"
	val[]: "Verbeter jouw rijvaardigheid met de nieuwe scenario's in steeds uitdagendere omstandigheden."

	key[]: "aca_book_book3_title"
	val[]: "Double Trailer Handling"

	key[]: "aca_book_book3_desc"
	val[]: "Take on the curious challenges of driving and reversing with a set of doubles."

#@}

