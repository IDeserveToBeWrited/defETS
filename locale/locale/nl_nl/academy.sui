#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Achteruitrijden met een aanhanger"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "In dit scenario probeer je voor het eerst achteruit te rijden met een aanhanger. Het is een vrij eenvoudige manoeuvre, maar je moet wel goed sturen om de aanhanger in de juiste positie te krijgen."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Achteruitrijden richting de trailer"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Trailer koppelen"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "De handrem loslaten"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Achteruit rijden met de trailer"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Doorrijden richting de parkeerplek"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Laten we eens proberen achteruit te rijden met een aanhanger. Het is makkelijker dan het lijkt; je moet alleen geduld hebben."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Begin met achteruitrijden en zorg dat de tractor op één lijn staat met de oplegger."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Zorg ervoor dat je goed uitgelijnd bent, anders kun je de verbinding niet maken. Als het niet goed is, kun je altijd naar voren trekken en het opnieuw proberen."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Het 5e wiel van de tractor wordt vastgezet op de fuseepen van de oplegger."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Trek de handrem aan en koppel de trailer aan. In echt, moet je uitstappen om de luchtslang en de elektriciteit aan te sluiten en het landingsgestel omhoog te doen. Hier doen wij dat voor je."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>De aanhanger draait altijd <color value=@@clr_sel@@>tegenover <color value=@@clr_txt@@>ten opzichte van de trekker."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Om de aanhanger te draaien, moet je de tractor in de <color value=@@clr_sel@@> tegenovergestelde <color value=@@clr_txt@@> richting sturen waarin je de aanhanger wilt laten rijden."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Om de aanhanger weer recht te zetten, draai je de trekker <br><color value=@@clr_sel@@>richting<color value=@@clr_txt@@> de aanhanger."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Probeer op één lijn te blijven met de aanhanger. Je zult voortdurend kleine aanpassingen moeten doen om de aanhanger in de richting van het gemarkeerde gebied te houden."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corrigeer afwijkingen van je koers met kleine stuurbewegingen zodra ze zich voordoen. Als je te ver doorstuurt, kun je ver van je gewenste koers af raken."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Stop op de aangegeven plek. Beveilig de vrachtwagen en zet de motor af."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Achter je en aan de bijrijderszijde zie je een oplegger. Je eerste opdracht is om er achteruit naartoe te rijden.<br><br><font face=/font/big_bold.font>Zet de truck in z'n achteruit.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Begin met achteruitrijden richting de aanhanger. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Richt jezelf zo uit dat je recht op de aanhanger staat. De koppelschotel moet de fuseepen opvangen. Trek naar voren om de fusee indien nodig bij te stellen.<br><br><font face=/font/big_bold.font>Rijd achteruit tot je een verbinding voelt.</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Het vijfde wiel is gekoppeld aan de kingpin en u bent klaar om de koppeling aan de aanhanger af te ronden.<br><br><font face=/font/big_bold.font>Trek de parkeerrem aan. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Druk op @@imv_nrm_attach@@ om de aanhanger aan te sluiten. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Nu is de oplegger stevig aan de trekker vastgemaakt, zijn de lucht- en elektrische leidingen aangesloten en is het steungestel omhoog gezet.<br><br><font face=/font/big_bold.font>Zet de parkeerrem los. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "U moet achteruit de parkeerplaats direct achter u inrijden. Houd er rekening mee dat de aanhanger in de tegenovergestelde richting draait van hoe u de tractor bestuurt. Een kleine draai aan het stuur kan al leiden tot een aanzienlijke beweging van de aanhanger.<br><br><font face=/font/big_bold.font>Begin met het achteruitrijden van de aanhanger.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Stuur niet te veel, probeer de aanhanger gewoon op één lijn met de parkeerplaats te houden. <br><br><font face=/font/big_bold.font>Rijd richting de parkeerplaats. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkeren op een smalle plek"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "In dit scenario parkeren we op een smalle plek.<br><br>Je moet de aanhanger zo manoeuvreren dat hij recht op een afwijkende parkeerplek staat."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manoeuvreren naar de juiste plaats"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkeren terwijl u vooruit rijdt, of 'met de neus naar voren', is vrij eenvoudig als het om parkeermanoeuvres gaat. <br>U moet wel rekening houden met de afwijking van de sporing van de aanhanger."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Je zult voorbij het punt moeten rijden waar je normaal gesproken de trekker zelf zou draaien. Zo kun je de aanhanger beter uitlijnen."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Als je de parkeerplaats nadert, draai dan om en plaats de trekker voor de oplegger. Ga in de rij staan en rijd de parkeerplaats op. <br>Stop, parkeer, zet de vrachtwagen vast en zet de motor af."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Voor u is een parkeerplaats. Rijd er naartoe en parkeer uw auto.<br><br><font face=/font/big_bold.font>Maak u klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Begin met rijden en draai richting de parkeerplaats.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Rijd voorbij de parkeerplaats en zet uw aanhanger op één lijn met het gemarkeerde gebied. Rijd vervolgens met de tractor naar de parkeerplaats en rijd recht.<br><br><font face=/font/big_bold.font>Parkeer op de aangegeven plaats. </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Stop in het aangegeven gebied.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Zet de vrachtwagen vast en zet de motor af.</font>"
#@}

