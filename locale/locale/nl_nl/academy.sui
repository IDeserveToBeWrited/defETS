#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "In dit scenario maken we een korte rit met de vrachtwagen. Je kunt alvast wat remgevoel opdoen met een aanhanger terwijl we de heuvel afdalen. Maak de vrachtwagen klaar en vertrek."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Bereik een snelheid van minstens 60 km/u (37 mph). Wees voorbereid op de remzone voor je."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Begin met remmen tot stilstand. Wacht niet te lang, anders kun je de vangrails voor je raken!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parkeer op de aangegeven plek, zet de vrachtwagen vast en zet de motor uit."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Tijdens deze rit krijg je gevoel voor het gebruik van de bedrijfsremmen tijdens het afdalen. Het doel van deze oefening is om je bewust te worden van het gewicht achter je en hoe dit de remweg van het voertuig beïnvloedt.<br><br><font face=/font/big_bold.font>Bereid je voor op vertrek.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Begin nu met rijden en houd er rekening mee dat u een snelheid van 60 km/u (37 mph) moet bereiken.<br><br><font face=/font/big_bold.font>Rijd door de bocht.</font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Blijf versnellen terwijl je de heuvel afrijdt. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Bereik een snelheid van minimaal 60 km/u (37 mph).</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Je hebt de vereiste snelheid bereikt. <br><br><font face=/font/big_bold.font>Stop bij de slagbomen voor je. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

