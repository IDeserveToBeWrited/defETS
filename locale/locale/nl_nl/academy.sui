#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Door de barrières rijden"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Hier voor je liggen een aantal complexe bochten en obstakels.<br>Houd rekening met alles wat je tot nu toe hebt geleerd, dan zou het niet al te moeilijk moeten zijn."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "De wegmarkeringen geven u inzicht in hoe u de verschillende obstakels moet overwinnen."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Houd de tractor aan de buitenkant van de hoek. <br>Je moet ruim uitzwaaien, omdat de aanhanger een kortere route volgt."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "De volgende bocht is een makkelijke 90 graden bocht. <br> Zoals altijd, hou de truck aan de buitenkant van de bocht en gebruik alle beschikbare ruimte."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Neem hier de tijd voor. De baan opent zich, maar je moet nog steeds nauwkeurig zijn."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Blijf met grote afstand rond de hindernissen."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Wees voorzichtig als u dit smalle gedeelte inrijdt. <br>Draai de tractor ruim voordat u het terrein oprijdt, zodat uw aanhanger klaarstaat om binnen te rijden."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "De laatste 90 graden bocht is veel scherper dan de eerste, maar er is genoeg ruimte als je deze maar verstandig gebruikt."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Stop op het aangegeven gebied, zet de vrachtwagen vast en zet de motor af."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Vergeet niet de wegmarkeringen te gebruiken om u te helpen navigeren op het parcours.<br><br><font face=/font/big_bold.font>Bereid u voor op vertrek.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Het gebruik van je spiegels helpt je ook om veilig door het parcours te navigeren. Je moet altijd goed opletten hoe de aanhanger achter je rijdt.<br><br><font face=/font/big_bold.font>Rijd door de eerste bocht.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observeer de trailer terwijl je de bocht uitkomt en bereid je voor op de volgende.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Ga door de volgende bocht. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Houd uw oplegger in de gaten om er zeker van te zijn dat u vrij bent van obstakels om u heen voordat u de vrachtwagen draait.<br><br><font face=/font/big_bold.font>Rijd om de obstakels voor u heen.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Zodra uw aanhanger de vangrail heeft gepasseerd, draait u snel naar de passagierskant om in lijn te komen met de smalle doorgang. <br><br><font face=/font/big_bold.font>Rijd richting de smalle doorgang.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Dit gedeelte vereist zeer nauwkeurig rijden. Neem de tijd en gebruik je spiegels.<br><br><font face=/font/big_bold.font>Blijf aan de buitenkant van elke bocht.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Deze bocht is erg scherp, maar je kunt alle ruimte voor je benutten om hem gemakkelijk te nemen.<br><br><font face=/font/big_bold.font>Maak de laatste bocht. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Geavanceerde trainingscursus - Trailer"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "In het laatste scenario van Hoofdstuk 3 maken we een rit op een langere trainingscursus met een verscheidenheid aan verschillende bochten om te zien hoe goed je hebt geleerd om met een aanhanger te manoeuvreren."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Haakse bocht"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "VERWIJDER DIT DOEL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Mediane kruising"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Eerste slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Tweede slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Makkelijke bochten"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rotonde"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Recht stuk"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Krappe bocht"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Laatste bochten"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Rijden naar de parkeerplek"
