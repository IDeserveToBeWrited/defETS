	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Voor je liggen een paar krappe bochten met weinig ruimte. Deze helpen je om de aanhanger effectief te leren manoeuvreren."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Volg de wegmarkeringen richting de slagboom aan de bestuurderskant om u voor te bereiden op de eerste bocht."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Blijf in de bocht dicht bij de buitenste barrière, dan volgt de aanhanger u netjes het parcours op."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Ga door met het volgen van de wegmarkering om je op te lijnen voor de tweede bocht, een krappe 90 graden bocht."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Je moet diep de bocht in rijden om ervoor te zorgen dat je aanhanger de binnenbarrières passeert. Gebruik je vooruitkijkspiegel om zo ver mogelijk de bocht in te rijden zonder ergens tegenaan te rijden."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Ga verder langs de buitenste barrière."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Er volgt nogmaals een krappe 90 graden bocht die alle beschikbare ruimte benodigd."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Stop op het aangegeven gebied en zet de vrachtwagen vast."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Vergeet niet om alle beschikbare ruimte te gebruiken om elke bocht te nemen.<br><br><font face=/font/big_bold.font>Ga op pad en volg de wegmarkeringen naar buiten. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Volg de buitenste barrière, maar houd uw aanhanger in de spiegel in de gaten.<br><br><font face=/font/big_bold.font>Maak de eerste bocht. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Volg de wegmarkering om je op te lijnen voor de 90 graden bocht verderop.<br><br><font face=/font/big_bold.font>Neem de bocht. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Hou de truck wijd na de bocht, want hierna komt een nog krappere 90 graden bocht.<br><br><font face=/font/big_bold.font>Ga door met rijden. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Ga naar de parkeerplaats verderop. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Diagonaal parkeren achteruit"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "In dit scenario bekijken we diagonaal parkeren tijdens het achteruitrijden. Dit kan gebeuren bij parkeerplaatsen, truckstops en zelfs bij transportbedrijven. Vaak is er weinig ruimte omdat de parkeerplaatsen vol staan met vrachtwagens, waardoor parkeren extra lastig is door het gebrek aan ruimte."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "De trailer draaien"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonaal parkeren lijkt op het eerste gezicht makkelijker, maar kan vaak een grotere uitdaging zijn dan de gebruikelijke manoeuvres waarbij u achteruit in een steegje parkeert."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Rijd achteruit naar de parkeerplaats. Houd de trekker en aanhanger voorlopig recht."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Als je dichterbij komt, laat je aanhanger dan dichter naar de geparkeerde vrachtwagens lopen. Dit helpt je om de juiste plek te vinden wanneer je er bent."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Begin met het draaien van de aanhanger naar de parkeerplaats. Houd je aanhanger dicht bij de vrachtwagen aan de bestuurderskant, want je hebt de ruimte aan de andere kant nodig."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Zodra de oplegger goed op de parkeerplaats staat, begint u de trekker te draaien om de oplegger te volgen."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parkeer op de aangegeven plek, zet de vrachtwagen vast en zet de motor uit."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parkeer de vrachtwagen in de parkeerruimte achter je. Gebruik beide spiegels om te navigeren terwijl je achteruitrijdt.<br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Kijk goed om je heen en rijd dan richting de parkeerplaats.<br><br><font face=/font/big_bold.font>Begin met achteruitrijden.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Begin met het rijden van de aanhanger richting de vrachtwagens naast je. Zodra je klaar bent, draai je de aanhanger naar de parkeerplaats. Houd rekening met de uitzwaai van de aanhanger.<br><br><font face=/font/big_bold.font>Draai naar de parkeerplaats.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Achteruitrijden in een bocht"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "In dit scenario rijden we voor het eerst achteruit met een aanhanger in een bocht. We bespreken de basisprincipes van achteruitrijden en waar je op moet letten bij het achteruitrijden."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "De trailer draaien"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "In dit scenario moet u achteruitrijden naar de parkeerplaats achter u, aan de bestuurderskant."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Er zijn een paar tips om te onthouden die u erg zullen helpen bij het achteruitrijden met een aanhanger. <br>De eerste is dat de aanhanger altijd in de tegenovergestelde richting wil draaien van hoe u de trekker bestuurt."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Ten tweede kun je een goed beeld krijgen van de richting waarin de oplegger rijdt door naar de assen van de vrachtwagen en de oplegger te kijken."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Ten derde: met kleine inbreng kom je waar je moet zijn. Je hoeft het niet overmatig te doen."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Draai de tractor iets weg van de parkeerplaats, zodat de aanhanger er naartoe begint te wijzen."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Volg de trailer en breng onderweg wijzigingen aan om op het juiste pad te blijven."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Let op de wielen van uw aanhanger en het achterwiel van de tractor. Deze geven aan waar de aanhanger naartoe wijst en waar de tractor hem heen duwt."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Een vierde tip is dat het altijd makkelijker is om de aanhanger scherper te draaien dan om hem recht te proberen te trekken vanuit een schaar. Richt op de buitenkant van de plek totdat je er dichterbij bent, dan kun je iets scherper draaien om je aanhanger recht te zetten."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "As the trailer enters the parking spot, get the tractor in front of the trailer. Try to avoid too many adjustments inside the spot."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Rijd achteruit tussen de hindernissen door en controleer daarbij beide kanten."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Zet de vrachtwagen vast en schakel de motor uit."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Onthoud deze tips wanneer u met een aanhanger achteruit een bocht inrijdt:<br><br>— De aanhanger draait in de tegenovergestelde richting van de trekker.<br><br>— Let op de wielen van de aanhanger om te zien waar hij naartoe wijst.<br><br>— Let op het achterwiel van de trekker om te zien waar het de aanhanger naartoe duwt.<br><br>— Laat de aanhanger het werk doen, overstuur hem niet.<br><br>— Het is altijd makkelijker om de aanhanger scherper te sturen dan hem recht te maken.<br><br><font face=/font/big_bold.font>Bereid je voor om te vertrekken.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Kijk achter je om te zien waar je naartoe moet. Controleer altijd je omgeving voordat je begint met achteruitrijden.<br><br><font face=/font/big_bold.font>Begin met het achteruitrijden naar je parkeervak. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Begin met het draaien van de aanhanger richting de parkeerplaats en volg deze.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Stop op de aangegeven plek.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Achteruit parkeren op een krappe parkeerplaats"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "In dit scenario krijgt u de taak om de aanhanger achteruit te parkeren op een drukke parkeerplaats."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "De trailer draaien"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Dit is een typische parkeerplaats voor vrachtwagens. Vrachtwagenchauffeurs komen dit soort parkeersituaties bijna dagelijks tegen.<br>Parkeren hier vereist een 'steegparkeermanoeuvre'."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Deze manoeuvre lijkt op het vorige scenario, maar je hebt minder ruimte om te werken. Je moet je bewegingen dus goed plannen en oppassen dat je niets raakt."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Omdat er minder ruimte is, is timing belangrijker. Draai de aanhanger op het juiste moment en kijk naar de wielen van de trekker en de aanhanger om te zien waar hij heen gaat. Houd rekening met de uitzwaai van de achterkant en zorg ervoor dat je niet schaart - blijf de aanhanger duwen."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Probeer zo dicht mogelijk bij de vrachtwagen aan de bestuurderskant te blijven. Zo heeft uw aanhanger meer ruimte om te zwenken en hoeft u zich minder zorgen te maken over de vrachtwagen aan de passagierskant."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Zodra je aanhanger op de juiste plek staat, rijd je met de trekker ervoor. Het is beter om dit iets eerder te doen dan je instinct je in eerste instantie doet geloven. Je kunt het altijd corrigeren door achteruit te rijden naar je eindpositie."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Zet de tractor en aanhanger recht en stop op het aangegeven terrein."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Zet de vrachtwagen vast en schakel de motor uit."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Nu gaan we proberen een aanhanger te draaien in een veel kleiner gebied, met een 'steeg-achteruitrij'-manoeuvre. <br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Kijk om je heen en zoek de parkeerplaats achter je. <br><br><font face=/font/big_bold.font>Rijd achteruit richting de parkeerplaats. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Rijd de aanhanger naar de parkeerplaats.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
