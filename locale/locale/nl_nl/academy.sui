#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Voor het laatste scenario van dit hoofdstuk rijden we op de testbaan met een complexe configuratie."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "De eerste hindernis is een slalom door een aantal hindernissen. Rijd erdoorheen en vergeet niet je spiegels te gebruiken."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "De volgende is een haarspeldbocht. Houd je bocht ruim en het zou geen problemen moeten opleveren."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Hier is een bocht van 90 graden naar links. Vergeet niet diep in te rijden, zodat de achterkant van de vrachtwagen de binnenste vangrails passeert."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "De helling kan een lastig obstakel zijn. Zorg dat je zo goed mogelijk in lijn staat voordat je erop rijdt en gebruik je voor- en zijspiegels om je te oriënteren."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Het volgende deel moet in omgekeerde volgorde worden afgelegd. Houd dit in gedachten bij het naderen van de obstakels voor je."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Volg de wegmarkeringen rechts van u."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Rijd achteruit tot aan de slagbomen, stop dan en rijd verder naar links."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Ga via de onderbreking in de middenberm naar het volgende gedeelte."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Deze doorgang door de kegels is erg smal. Rijd langzaam en gebruik je spiegels om je in de doorgang te oriënteren."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Vergeet niet om bij bochten van 90 graden ver door te rijden."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Je komt op een mooi open stuk weg. Je kunt wat snelheid maken, maar houd er rekening mee dat je binnenkort moet afremmen voor de bocht die voor je ligt."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Onderaan de heuvel staan een paar hekken dwars over de weg. Rijd erheen en parkeer dan achteruit op de parkeerplaats aan de linkerkant."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Rijd achteruit naar de parkeerplaats."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parkeer de vrachtwagen, zet de motor af en beveilig hem."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Voor je zie je een slalom van hindernissen.<br><br><font face=/font/big_bold.font>Rijd door de slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Blijf aan de buitenkant van de bocht rijden om ervoor te zorgen dat de achterkant van de tractor niet over de stoeprand heen rijdt.<br><br><font face=/font/big_bold.font>Maak de bocht. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Je komt aan bij een bocht van 90 graden naar links. Vergeet niet om alle beschikbare ruimte te benutten.<br><br><font face=/font/big_bold.font>Maak de bocht.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Richt je op de helling. Er is weinig ruimte om te corrigeren als je er eenmaal op staat.<br><br><font face=/font/big_bold.font>Rijd over de helling.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Volg de route naar links. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Het volgende gedeelte moet in omgekeerde volgorde worden afgelegd. Stop bij de slagbomen voor u, zodat u daarna rechtsaf kunt rijden.<br><br><font face=/font/big_bold.font>Stop bij de slagbomen.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Rijd achteruit naar het gebied achter je en naar rechts. Er staan pijlen op de weg om je te helpen.<br><br><font face=/font/big_bold.font>Rijd achteruit naar het volgende gedeelte.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Blijf achteruit rijden richting de vangrails achter u.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stop, schakel naar een vooruitversnelling en rijd vervolgens naar links. <br><br><font face=/font/big_bold.font>Rijd vooruit. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Er is een onderbreking in de middenberm aan de linkerkant. Rijd erdoorheen.<br><br><font face=/font/big_bold.font>Rijd door.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Voor u ligt een smal, kronkelend pad tussen enkele kegels. Rijd voorzichtig en gebruik indien nodig uw spiegels.<br><br><font face=/font/big_bold.font>Rijd door de kegels.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Blijf de route volgen. <br><br><font face=/font/big_bold.font>Ga linksaf. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Vergeet niet om links aan te houden vóór de bocht, zodat u zoveel mogelijk ruimte heeft.<br><br><font face=/font/big_bold.font>Maak de bocht. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Rijd gewoon door.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Hier kunt u wat snelheid maken, maar er komt een bocht aan.<br><br><font face=/font/big_bold.font>Blijf de route volgen.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "De bocht wordt steeds scherper naarmate je erdoorheen komt. <br><br><font face=/font/big_bold.font>Pas je snelheid aan en rijd door.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Onderaan de heuvel ziet u obstakels die de weg blokkeren. <br><br><font face=/font/big_bold.font>Stop bij de obstakels. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Links achter u is een parkeerplaats.<br><br><font face=/font/big_bold.font>Rijd achteruit de parkeerplaats op.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Stop op de gemarkeerde plek.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Rijden op een testbaan"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In dit scenario gaan we een rit maken op een parcours dat is ontworpen om je vermogen te testen om de truck door verschillende soorten bochten en hoeken te sturen."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Betreden van het cursusterrein"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Een geleidelijke bocht naar links maken"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Rijden door S-bochten"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Recht stuk"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Makkelijke bochten"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Verlaten van het cursusterrein"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Naderen van de parkeerplek"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In dit scenario maken we een korte rit met de trekker om te kijken hoe jij ermee overweg kunt, rekening houdend met je nieuw verworven vaardigheden."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Er zijn verschillende soorten en combinaties van bochten op de baan. Het is geen race en het gaat niet om de tijd. Wees geduldig en pas je rijsnelheid aan op de bochten en obstakels die je tegenkomt."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "In het begin is het parcours makkelijk en gemakkelijk, maar naarmate je vordert, worden de bochten steeds complexer."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Let op uw snelheid. Het kan gebeuren dat u te snel optrekt en een bocht verkeerd inschat."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "De uitgang van de baan is een zeer krappe haarspeldbocht. Rijd langzaam en gebruik alle beschikbare ruimte."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parkeer uw vrachtwagen tussen de slagbomen en zet hem vast."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Om dit scenario succesvol af te ronden, mag u niet crashen, van de baan rijden of tegen verkeerskegels botsen.<br><br><font face=/font/big_bold.font>Maak u klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Ga rechtdoor in de scherpe bocht naar rechts om het parcours op te gaan. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Rijd met een prettige, constante snelheid door de bocht.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Je nadert een complexer gedeelte met bochten.<br><br><font face=/font/big_bold.font>Pas je snelheid aan en ga verder.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Ga door naar de volgende bocht.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Er komen een paar makkelijke, flauwe bochten aan. Houd uw snelheid constant.<br><br><font face=/font/big_bold.font>Blijf rijden.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "De afslag van het parcours is een scherpe haarspeldbocht. Rijd langzamer en blijf aan de buitenkant van het parcours voor de bocht. Gebruik zeker je spiegels!<br><br><font face=/font/big_bold.font>Verlaat het parcours. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Voor u is er een parkeerplaats tussen enkele slagbomen.<br><br><font face=/font/big_bold.font>Ga richting de parkeerplaats. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parallel parkeren"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "In dit scenario bekijken we een situatie waarbij twee vrachtwagens parallel aan elkaar parkeren."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Stoppen voor de parkeerplek"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Controleren van de achteruitkijkspiegel"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Achteruit de parkeerplek inrijden"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "De vrachtwagen rechttrekken in de parkeerplek"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parallel parkeren is een essentiële vaardigheid die iedere vrachtwagenchauffeur moet kennen.<br>Bereid je voor om te vertrekken."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Rijd richting de parkeerplaats.<br>Let op uw omgeving."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Plaats jezelf op één lijn met de vrachtwagen voor je parkeerplaats. Ga er niet te dicht bij staan, maar houd er voldoende afstand van zodat je voldoende ruimte hebt om te werken."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Draai scherp richting de parkeerplaats en begin achteruit te rijden."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Wanneer u in de spiegel aan de bestuurderszijde kijkt, richt u dan op de stoeprand vlak voor de vrachtwagen achter u."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Zodra uw voorbumper voorbij de vrachtwagen voor u is, kunt u de voorkant van de vrachtwagen naar de parkeerplek sturen en de vrachtwagen uitlijnen met de parkeerplek."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Richt het wiel recht en zorg dat de vrachtwagen in het midden van de parkeerplek staat.<br>Parkeer en beveilig de vrachtwagen."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Voor je staan een paar vrachtwagens geparkeerd. Er is nog één vrije plek om te parkeren. <br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Wees je bewust van je omgeving. Maak tijdens deze manoeuvre goed gebruik van je spiegels. <br><br><font face=/font/big_bold.font>Rijd vooruit. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Rijd voorbij de parkeerplaats en het gemarkeerde gebied in. Vanaf daar kunt u uw achteruitrijmanoeuvre starten.<br><br><font face=/font/big_bold.font>Stop op de gemarkeerde plek.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Controleer de omgeving op obstakels en zorg ervoor dat u vrij bent om achteruit te rijden.<br><br><font face=/font/big_bold.font>Kijk door de spiegel aan de passagierszijde.</font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Draai je wielen en rijd achteruit de parkeerplaats op.<br><br><font face=/font/big_bold.font>Begin met achteruitrijden.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Begin met het rechtzetten van de vrachtwagen wanneer dat nodig is. Rijd niet over de stoeprand!<br><br><font face=/font/big_bold.font>Lijn de vrachtwagen uit met de plek.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
