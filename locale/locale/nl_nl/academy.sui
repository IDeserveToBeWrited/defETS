#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Diagonaal parkeren"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "In dit scenario parkeert u op een schuine parkeerplaats op een drukke parkeerplaats. <br><br>Er is niet veel ruimte om te manoeuvreren, dus u moet zeer nauwkeurig en bedachtzaam rijden."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Naderen van de parkeerplek"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Schuine parkeerplaatsen zoals deze komen veel voor. Vooral op de vele parkeerplaatsen langs de Europese snelwegen. <br>Ook nu moeten we met onze neus naar de parkeerplaats voor ons toe bewegen."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Rijd richting de aangewezen parkeerplaats aan het einde van de rij."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Blijf in het midden van de rijstrook, of iets aan de bestuurderskant. Rijd niet te dicht langs de vangrails, anders kan de achterkant van de aanhanger er tegenaan botsen tijdens het insturen."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Stop op het aangegeven gebied, zet de vrachtwagen vast en zet de motor uit."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Stop op het aangegeven gebied, zet de vrachtwagen vast en zet de motor uit."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Bij het diagonaal parkeren is het belangrijk om je positie goed in te schatten. Als je halverwege de bocht bent, is het moeilijk om achteruit te rijden en je positie veilig te veranderen. Zorg er daarom voor dat je bij de eerste poging voldoende ruimte hebt.<br><br><font face=/font/big_bold.font>Bereid je voor om te vertrekken.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Rijd richting de parkeerplaats.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Rijd voorbij de parkeerplaats zodat uw aanhanger ruimte heeft om rond de vrachtwagen aan de binnenkant te draaien.<br><br><font face=/font/big_bold.font>Rijd de parkeerplaats op. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Blinde kant Achteruitrijden"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "In dit scenario bekijken we de 'blinde kant' van het achteruitrijden met de vrachtwagen in een parkeervak. Zonder de mogelijkheid om uit het raam te kijken om te zien waar je heen gaat, zul je alleen op je spiegels moeten vertrouwen om je te brengen waar je heen moet."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "In dit scenario leert u de 'blinde kant'-achteruitrijmanoeuvre. Blind rijden moet over het algemeen worden vermeden, tenzij er geen andere optie is, aangezien uw zicht ernstig beperkt is. Neem de tijd en kies voor extreme voorzichtigheid."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Rijd een stuk verder dan de parkeerplaats, zodat u ruimte hebt om te werken als u achteruit wilt rijden."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Stop, kijk om je heen en rijd vervolgens achteruit."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Draai de trekker weg van de parkeerplaats. Dit duwt de voorkant van de aanhanger om en richt de achterkant van de aanhanger op de gewenste parkeerplaats. Pas op dat u dit niet overdrijft, anders loopt u het risico dat de combinatie 'schaart'."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Zodra de oplegger de parkeerplaats oprijdt, begint u met het rechtzetten van de vrachtwagen."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Stop op het aangegeven gebied en zet de vrachtwagen vast."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Achteruitrijden aan de dode kant vereist dezelfde procedures als achteruitrijden aan de zichtzijde, maar u zult gehinderd worden door het beperkte zicht aan die kant. Gebruik uw spiegels en uw gezond verstand om de vrachtwagen te parkeren.<br><br><font face=/font/big_bold.font>Bereid u voor op vertrek.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Er is een parkeerplaats voor je, aan de passagierskant. Je moet er ver voorbij rijden, zodat je ruimte hebt om te manoeuvreren bij het achteruitrijden.<br><br><font face=/font/big_bold.font>Rijd vooruit.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Onthoud dat als u de vrachtwagen van de parkeerplaats afdraait, de aanhanger er ook naartoe draait. Gebruik uw spiegels zo goed mogelijk om u te helpen bij het inparkeren.<br><br><font face=/font/big_bold.font>Begin met achteruitrijden.</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Rijden op een rotonde"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "In dit scenario bekijken we hoe je een rotonde neemt.<br><br>Je moet goed opletten op je aanhanger, want deze beweegt anders achter je aan als je de rotonde oprijdt, eroverheen rijdt en er weer afrijdt."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "De rotonde oprijden"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Op de rotonde rijden"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Op de rotonde rijden"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "De rotonde verlaten"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Richting het toegewezen gebied rijden"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Rotondes zijn heel gebruikelijk in de straten van Europa. Het is daarom belangrijk dat u weet hoe u ze moet nemen."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Blijf aan de buitenkant van uw rijstrook als u de rotonde nadert. Dit helpt uw aanhanger om de binnenkant van de eerste bocht vrij te houden."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Rijd richting het midden van de rotonde als u binnenkomt. Eenmaal binnen moet u naar buiten rijden. Dit is om uw aanhanger uit het midden van de rotonde te houden."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Houd uw spiegel in de gaten om er zeker van te zijn dat de aanhanger niet te dicht bij de binnenhekken komt."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Het verlaten van de rotonde is vrij eenvoudig, omdat uw aanhanger al aan de binnenkant van de afrit staat. Draai ruim bij het verlaten van de rotonde en de aanhanger zou netjes moeten volgen."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parkeer de vrachtwagen op de daarvoor bestemde plek en zet hem vast."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Voor u is een rotonde ingericht waar u op kunt rijden. <br><br><font face=/font/big_bold.font>Rijd langzaam de rotonde op. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Maak een ruime bocht bij het oprijden van de rotonde, zodat uw aanhanger zonder problemen achter u kan komen. <br><br><font face=/font/big_bold.font>Rijd de rotonde op. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Rijd richting de buitenkant van de rotonde. Houd de vrachtwagen zo ver mogelijk van het midden van de rotonde vandaan om uw aanhanger of aanhanger uit de buurt van de vangrails te houden. <br><br><font face=/font/big_bold.font>Rijd rechtdoor over de rotonde.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Blijf dicht bij de buitenste kegels. <br><br><font face=/font/big_bold.font>Blijf rijden.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Verlaat de rotonde.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Ga naar de parkeerplaats verderop.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Stop in het aangegeven gebied.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Zet de vrachtwagen vast en zet de motor af.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manoeuvreren in een krappe ruimte"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "In het laatste scenario moet je de vrachtwagen in een krappe ruimte keren. Je moet achteruitrijden naar de blinde kant in een gebied met beperkte manoeuvreerruimte, wat aandacht voor je omgeving en slim ruimtegebruik vereist."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Het cursusgebied betreden"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Klaarmaken voor een blinde kant parkeermanoeuvre"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Achteruit inparkeren"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Voltooien van de blinde kant parkeermanoeuvre"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Het cursusgebied verlaten"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In dit scenario leggen we uit hoe je kunt keren in een krappe ruimte met een dodehoekmanoeuvre. Deze vaardigheid komt goed van pas wanneer je geen U-bocht kunt maken of niet aan de bestuurderskant kunt achteruitrijden."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "De wegmarkeringen helpen u bij het navigeren door het trainingsparcours."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Maak een ruime bocht om ervoor te zorgen dat uw aanhanger voorbij de geparkeerde vrachtwagens komt."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Denk bij het uitkomen van de bocht na over hoe u de vrachtwagen gaat voorbereiden op uw achteruitrijmanoeuvre."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Het is handig om de vrachtwagen schuin naar de lege parkeerplaats aan de passagierskant te laten wijzen, waar u straks achteruit parkeert."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Achteruitrijden aan de dode kant moet zoveel mogelijk worden vermeden, omdat het zicht dan aanzienlijk minder is. Helaas zijn er momenten waarop je geen andere keuze hebt dan het te doen."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Draai aan het stuur voordat u achteruitrijdt. Dit helpt om uw aanhanger direct in de gewenste richting te krijgen, wat handig is in zeer krappe situaties."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Zodra de oplegger goed op zijn plek staat, zet u de tractor ervoor en zet u de oplegger recht."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Stop zodra je weer recht bent en genoeg ruimte hebt om vooruit te komen. Ga dan terug via dezelfde weg als je bent gekomen."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Volg de wegmarkeringen buiten het trainingsparcours."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Rijd door de bocht en ga naar het aangegeven gebied."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Stoppen."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Zet de vrachtwagen vast en schakel de motor uit."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "In het gebied voor je is een trainingsparcours dat het terrein van een scheepvaartmaatschappij voorstelt. Je taak is om daarheen te gaan en de vrachtwagen te keren om er weer uit te komen. Zorg ervoor dat je de ruimte om je heen goed benut.<br><br><font face=/font/big_bold.font>Bereid je voor op vertrek</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Ga door naar de training baan.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Ga de hoek om en vervolg je route.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Volg de wegmarkeringen tot aan de slagboom aan het einde van het parcours. Parkeer een beetje schuin, zodat uw aanhanger naar de lege parkeerplaats aan uw passagierszijde wijst.<br><br><font face=/font/big_bold.font>Rijd rechtdoor.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Je hebt een veel beperkter zicht op wat er om je heen gebeurt als je dode hoek hebt. Rijd langzaam, gebruik je spiegels en neem het zekere voor het onzekere.<br><br><font face=/font/big_bold.font>Begin met achteruitrijden en draai de aanhanger de lege parkeerplaats op.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Dat is ver genoeg. Je kunt nu verder en het trainingsveld verlaten vanuit dezelfde richting als waar je vandaan kwam.<br><br><font face=/font/big_bold.font>Begin met de route naar de uitgang.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Verlaat de training baan.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Volg de wegmarkeringen tot aan de uiteindelijke parkeerplaats.<br><br><font face=/font/big_bold.font>Ga naar het aangegeven gebied.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Offset-omkeermanoeuvre"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "In dit scenario moet je achteruit inparkeren op een parkeerplek die niet direct achter je ligt. De manoeuvreerruimte is beperkt, dus je moet je ruimte verstandig benutten."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "In dit scenario is het jouw taak om te parkeren op de plek naast je. Er is weinig manoeuvreerruimte, dus je zult wat extra werk moeten verzetten om de aanhanger op de gewenste plek te krijgen."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Rijd rechtdoor tot aan de barrière."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Stop voor de barrière."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Turn the steering wheel sharply to the driver's side before moving. This way, you'll start turning the trailer toward the parking spot as soon as you begin reversing, saving valuable space."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Zodra u de oplegger in de gewenste positie heeft, rijdt u met de tractor voor de oplegger en begint u deze richting de parkeerplaats te sturen."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Vanaf dit punt verschilt het niet zoveel van een gewone parkeermanoeuvre."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Blijf achteruit rijden en kijk naar beide kanten. Houd de tractor en aanhanger op één lijn met de parkeerplaats."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Stop op het aangegeven gebied, zet de vrachtwagen vast en zet de motor uit."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "U staat op een parkeerplaats, maar er is een tweede parkeerplaats aan uw rechterkant waar u naartoe moet uitwijken.<br><br><font face=/font/big_bold.font>Maak u klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Er is een gemarkeerd gebied voor je.<br><br><font face=/font/big_bold.font>Rijd vooruit.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Vergeet niet om meteen te beginnen met sturen, want er is niet veel ruimte.<br><br><font face=/font/big_bold.font>Rijd achteruit naar de gemarkeerde plek achter u.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Rijden door eenvoudige bochten"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "In dit scenario ga je een stukje rijden op het oefenterrein om het manoeuvreren van trailers door krappe 90 graden bochten onder de knie te krijgen."

