#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "Vrachtwagenrijvaardigheid Info" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Voltooiingsvereisten"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Scenario's worden voltooid door aan alle slaagvoorwaarden te voldoen."

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Sterren verdien je door bonusvoorwaarden te voltooien."

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Condities"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maximaal aantal wisselingen tussen vooruit en achteruit rijden"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maximale toegestane tijd om een scenario te voltooien voor een bepaalde voorwaarde."

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Exclusief gebruik van interieurcamera - externe camera's mogen alleen gebruikt worden terwijl u stilstaat."

	key[]: "aca_book_book2_completed_t"
	val[]: "Vrachtwagenrijvaardigheid Geslaagd"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gefeliciteerd!<br><br>Je hebt voldaan aan alle slaagvoorwaarden in de module 'Vrachtwagenrijvaardigheid' en beloningen verdiend voor je carrièreprofiel. Je kunt jezelf nog steeds uitdagen om meer beloningen te verdienen door alle bonusvoorwaarden te voltooien.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "Vrachtwagenrijvaardigheid Voltooid"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gefeliciteerd!<br><br>Je hebt voldaan aan alle slaag- en bonusvoorwaarden in de module 'Vrachtwagenrijvaardigheid' en beloningen verdiend voor je carrièreprofiel.</font><br><br>"
