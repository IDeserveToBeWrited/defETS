	val[]: "Entering the Roundabout"

	key[]: "aca_goal_book3_3_11_check2"
	val[]: "Exiting the Roundabout"

#!{
	key[]: "aca_goal_book3_3_11_check3"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_3_11_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"

