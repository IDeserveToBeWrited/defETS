#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Gecombineerde rijmanoeuvres"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "In dit scenario combineren we je nieuw geleerde vaardigheden om een kort maar technisch traject af te leggen. Het omvat achteruit een bocht om en een krappe haakse bocht."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Achteruitrijden richting de bestuurderskant"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Haakse bocht"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Voltooien van de bocht"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Recht voor je is een barrier. Rij er naar toe en stop."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Achter de vrachtwagen, aan de bestuurderskant, bevindt zich nog een vangrail. Rijd achteruit de bocht in. De wegmarkeringen kunnen als leidraad dienen."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Recht vooruit, is een haakse bocht. Rij daarheen."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "We moeten diep de bocht inrijden, zodat de achterwielen de verkeerskegel aan de binnenkant van de bocht kunnen passeren.<br>Gebruik je spiegels!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Rijd rechtdoor, rijd naar de laatste hindernissen en stop dan om de vrachtwagen vast te zetten."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Maak je klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "De vrachtwagen is nog steeds niet klaar om te rijden, misschien bent u iets vergeten?<br><br>Is de motor aan? Heeft u de parkeerrem losgezet?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Recht voor u is een gemarkeerde plek vlak voor de slagboom.<br><br><font face=/font/big_bold.font>Rijd vooruit en stop op de gemarkeerde plek.</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Kijk achter je aan de bestuurderskant; daar zie je nog een gemarkeerde plek. Je moet achteruitrijden combineren met afslaan.<br><br><font face=/font/big_bold.font>Rijd achteruit de bocht in en stop op de gemarkeerde plek.</font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "De route gaat verder voor je in een bocht van 90 graden.<br><br>Blijf voor de bocht aan de bestuurderskant, rijd diep de bocht in en draai snel en scherp. Pas op dat je de verkeerskegel aan de binnenkant niet raakt.<br><br><font face=/font/big_bold.font>Rijd vooruit en maak de bocht.</font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Gebruik uw voor- en zijspiegels om ervoor te zorgen dat u niets raakt.<br><br><font face=/font/big_bold.font>Maak de bocht af en stop in het aangegeven gebied.</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Zet de motor af en beveilig de vrachtwagen.</font>"
#@}

