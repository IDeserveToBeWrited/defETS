#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Stoppen dichtbij een obstakel"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "In dit scenario gaan we het hebben over de vooruitkijkspiegel: de locatie ervan en hoe je hem effectief kunt gebruiken om vlak voor een obstakel te stoppen."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Controleer de voorspiegel"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Begrijpen van de functie"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Stop in de buurt van het obstakel"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Vrachtwagens hebben een grote dode hoek vóór de trekker. Het is gemakkelijk om een voetganger of zelfs een auto in deze zone uit het oog te verliezen. Daarom zijn vrachtwagens uitgerust met een vooruitkijkspiegel die door de voorruit zichtbaar is."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "De vooruitkijkspiegel is ontworpen om de bestuurder zicht te geven op de dode hoek.<br>Het is een essentieel hulpmiddel om ervoor te zorgen dat u bij het manoeuvreren in krappe ruimtes niet tegen obstakels botst."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Begin met rijden, rijd richting de vangrail voor u en rem af als u de vangrail nadert.<br>Houd de vooruitkijkspiegel in de gaten."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Stop tussen de lijn en het obstakel."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "In dit scenario zal je leren hoe je de voorspiegel moet gebruiken die in het diagram wordt aangegeven.<br><br><font face=/font/big_bold.font>Kijk naar de bovenkant van de voorruit om de voorspiegel te kunnen zien.</font>@@aca_goal_tip@@ Je moet in het voertuig zitten om dit te kunnen doen."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "De frontspiegel maakt het mogelijk om in je dode hoek aan de voorzijde te kijken. Dit kan je helpen om veilig en nauwkeurig te rijden.<br><br>Als je niet tevreden bent met de uitlijning van de spiegel, open dan '@@adjust_link_t@@' (kan je openen via het pauzemenu) om je spiegels af te stellen. <br><br><font face=/font/big_bold.font>Druk op @@imv_nrm_activate@@ om door te gaan.</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Recht voor de vrachtwagen is een gemarkeerde plek. Je zult merken dat er zich aan de andere kant van de plek een obstakel bevindt; als je er dichtbij bent, rijd dan heel langzaam en controleer de afstand tot het obstakel in je achteruitkijkspiegel.<br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "De vrachtwagen is nog steeds niet klaar om te rijden, misschien bent u iets vergeten?<br><br>Is de motor aan? Heeft u de parkeerrem losgezet?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Rij richting de parkeerplek. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Laat de voorkant van de vrachtwagen stoppen tussen het obstakel en de geverfde wegmarkering. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
#!}

#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkeren naast een obstakel"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "In dit scenario leren we hoe we naast een stoeprand moeten parkeren met behulp van de zijspiegel."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Controleer de zijspiegel"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Rij richting de stoeprand"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "De zijspiegel is een ander hulpmiddel om de vrachtwagen veilig te manoeuvreren. Hij bevindt zich op het bovenframe van het passagiersportier."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Rijd vooruit en draai langzaam naar de passagierskant."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Deze houten planken stellen een stoeprand voor. Je moet ernaast parkeren. <br>Draai richting de stoeprand om de vrachtwagen in een goede positie te krijgen, zodat deze op één lijn staat met de parkeerplek."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Rem ruim voor de stoeprand af en draai richting de parkeerplek. Terwijl u rechtdoor rijdt, kunt u de zijspiegel gebruiken om uw afstand tot de stoeprand in te schatten."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Stop op de parkeerplaats en zet de vrachtwagen vast."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Kijk door het raam aan de passagierskant, als het goed is kun je nu de zijspiegel zien.</font>@@aca_goal_tip@@ Je moet in het voertuig zitten om dit te kunnen doen."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "De trottoirspiegel geeft beeld van het gebied aan de bijrijderszijde van de vrachtwagen waar de chauffeur geen zicht op heeft. Deze zijde is een van de problematische dodehoeken van een truck. Als de hoek van de spiegel niet naar wens is, kun je deze altijd aanpassen in '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "De vrachtwagen is nog steeds niet klaar om te rijden, misschien bent u iets vergeten?<br><br>Is de motor aan? Heeft u de parkeerrem losgezet?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Voor je ligt een rij planken die een stoeprand voorstellen. Aan het einde van de stoeprand is een parkeerplaats. Je moet erheen rijden. <br><br><font face=/font/big_bold.font>Ga verder wanneer je er klaar voor bent. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Draai richting de rand. Gebruik de spiegels aan de voor- en zijkant om je positie te bepalen. Zorg er tevens voor dat je geen kegels raakt.<br><br><font face=/font/big_bold.font>Rij naar het parkeervak toe.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Secure the truck and shut down the engine.</font>@@aca_goal_tip@@ You can use Interior Look presets to make looking at mirrors easier. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Achteruit parkeren naast een obstakel"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "In dit scenario parkeren we de vrachtwagen achteruit op een parkeerplek langs de stoeprand."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instructies"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Achteruit rijden richten de stoeprand"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parkeren van de vrachtwagen"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "In dit scenario voeren we een omgekeerde manoeuvre uit om naast een stoeprand te parkeren."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Rijd achteruit richting de stoeprand.<br>Houd bij het achteruitrijden rekening met uw omgeving. Gebruik daarom uw spiegels."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Als je dichterbij komt, kun je de vrachtwagen uitlijnen met de parkeerplek. Let op beide kanten van de vrachtwagen terwijl je achteruitrijdt."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Stop op de parkeerplaats en zet de vrachtwagen vast."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "De parkeerplaats bevindt zich achter je, aan de passagierszijde. Gebruik je spiegels om naar de parkeerplaats te navigeren.<br><br><font face=/font/big_bold.font>Maak je klaar om te vertrekken.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Vergeet niet om uw spiegels te gebruiken om uw omgeving te controleren voordat u de vrachtwagen verplaatst.<br><br><font face=/font/big_bold.font>Rijd achteruit richting de stoeprand. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Blijf de omgeving in de gaten houden terwijl u achteruit de parkeerplaats oprijdt.<br><br><font face=/font/big_bold.font>Stop op de aangegeven plek.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Geavanceerde trainingscursus"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Het laatste scenario in dit hoofdstuk is een rit op een geavanceerde trainingscursus. We zetten de vaardigheden die je met een trekker hebt geleerd in de praktijk!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_check1"
