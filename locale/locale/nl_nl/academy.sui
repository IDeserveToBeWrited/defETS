#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Vrachtwagenrijvaardigheid"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Welkom terug bij de @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Deze scenario's zijn de volgende stap op weg naar professioneel vrachtwagenchauffeur."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "We begeleiden je deze keer niet door elke taak, dus het is aan jou om je vaardigheid en ervaring in te zetten."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Je komt misschien bekende manoeuvres tegen, maar deze keer in nieuwe omgevingen die meer lijken op realistische scenario's."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Nieuw in de @@driving_academy@@ is de toevoeging van \"Slaag\"- en \"Bonus\"voorwaarden."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Net als voorheen moet je elk scenario nog steeds voltooien zonder iets te raken, door succesvol te parkeren en de vrachtwagen vast te zetten..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...maar nu moet je dit ook doen binnen de toegewezen tijd en met een beperkt aantal wisselingen tussen vooruit en achteruit rijden."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bonusvoorwaarden kun je halen door elk scenario met nóg uitdagendere omstandigheden te voltooien..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...zoals strengere tijdslimieten, minder wisselingen van rijrichting, en exclusief gebruik van de interieurcamera."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Door alle scenario's te voltooien, kun je jezelf een bekwame vrachtwagenchauffeur noemen en ben je klaar voor de volgende uitdaging op de weg.<br><br>Om jezelf nog meer uit te dagen, voltooi je alle bonusvoorwaarden van elk scenario; dan ben je echt een ster achter het stuur!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "In dit tutorials-scenario helpen we je vertrouwd te raken met de nieuwe functies van Vrachtwagenrijvaardigheid."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Aan het begin van elk scenario zie je een <color value=@@clr_sel@@>\"Scenario Briefing\"<color value=@@clr_txt@@>-venster. Hierin staat informatie over de nieuwe Slaag- en Bonusvoorwaarden voor het scenario. <br><br>Slaagvoorwaarden moeten worden behaald om het scenario succesvol te voltooien, terwijl Bonusvoorwaarden een optionele extra uitdaging zijn voor ervaren en vaardige spelers. <br><br><font face=/font/big_bold.font>Om door te gaan, zet het contact aan.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Een van de bonusvoorwaarden vereist dat je het scenario voltooit met de <color value=@@clr_sel@@>Interieurcamera<color value=@@clr_txt@@>. Je mag de exterieurcamera's nog steeds gebruiken om je omgeving te controleren, maar alleen wanneer de vrachtwagen stilstaat.<br><br>Je kunt nu rondkijken om je te oriënteren en daarna weer terugschakelen naar de interieurcamera.<br><br><font face=/font/big_bold.font>Schakel over naar volgcamerra om de omgeving te controleren</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Oriënteer je, schakel dan weer terug naar de interieurcamera.<br><br><font face=/font/big_bold.font>Kijk rond de vrachtwagen</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Schakel terug naar interieurcamera</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Tijd<color value=@@clr_txt@@> speelt ook een rol bij Vrachtwagenrijvaardigheid. Alle scenario's hebben een individuele tijdslimiet waarbinnen het scenario moet worden voltooid als een Slaagvoorwaarde, en veel hebben ook een extra, strengere limiet als Bonusvoorwaarde.<br><br>De timer start pas nadat de vrachtwagen beweegt.<br><br><font face=/font/big_bold.font>Zet de motor aan en laat de parkeerrem los om door te gaan.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Nog een nieuwe toevoeging voor Vrachtwagenrijvaardigheid zijn de waypoints. Alle waypoints moeten bereikt worden voordat een scenario voltooid kan worden. <br><br>Daarnaast zijn waypoints gevoelig voor de richting waarin de vrachtwagen kijkt wanneer het waypoint bereikt wordt, dus let op eventuele markeringen op de grond bij het waypoint om jezelf correct te oriënteren.<br><br><font face=/font/big_bold.font>Rijd vooruit naar het waypoint voor je.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Je hebt het waypoint bereikt en kunt nu doorgaan naar de volgende stap. <br><br>Er is nog een waypoint achter je waar je achteruit naartoe moet rijden. Let op de pijl op de grond die aangeeft welke kant de vrachtwagen op moet staan wanneer je het waypoint bereikt. <br><br>Een andere Slaag- en Bonusvoorwaarde waarmee rekening moet worden gehouden, is <color value=@@clr_sel@@>Richtingveranderingen<color value=@@clr_txt@@>. We tellen hoe vaak je van rijrichting verandert tussen vooruit- en achteruitrijden. Blijf onder de limiet om aan de voorwaarde te voldoen.<br><br><font face=/font/big_bold.font>Rijd achteruit naar het waypoint en stop.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Als het goed is, heb je nu één richtingverandering gemaakt. <br><br>Koppel de trailer achter je aan om verder te gaan met de volgende stap. <br><br><font face=/font/big_bold.font>Rijd achteruit onder de trailer om hem te koppelen.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "De uiteindelijke parkeerplaats bevindt zich aan je rechterkant. Sommige scenario's hebben slechts één parkeerplek, terwijl andere meerdere opties bieden. Correct parkeren op een van de plekken stelt je in staat om het scenario te voltooien. <br><br><font face=/font/big_bold.font> Druk op @@imv_nrm_attach@@ om de trailer te koppelen. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "De parkeerplaatsen geven ook aan in welke richting de vrachtwagen geparkeerd moet worden. Parkeer je verkeerd, dan kun je het scenario pas voltooien nadat je jezelf gecorrigeerd hebt, wat je tijd en richtingveranderingen kost.<br><br><font face=/font/big_bold.font>Rijd naar een van de parkeerplaatsen en parkeer correct.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Vrachtwagenrijvaardigheid"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Je bent nu bekend met de nieuwe parameters voor Slaagvoorwaarden en Bonusdoelen, en klaar om de nieuwe scenario's in Vrachtwagenrijvaardigheid aan te pakken!<br><br><font face=/font/big_bold.font>Zet de vrachtwagen vast door de parkeerrem aan te trekken en de motor uit te zetten om het scenario te voltooien.</font>"



#@}



