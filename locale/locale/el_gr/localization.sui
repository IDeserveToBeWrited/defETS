	key[]: "quick_chat_op_tooltip"
	val[]: "Αναθέτει κουμπί για την εμφάνιση του μενού των γρήγορων απαντήσεων κατά την διάρκεια συνεδρία ς κονβόι."

	key[]: "push_to_talk_op_tooltip"
