	val[]: "Παρακαλώ περίμενε για το πίσω συνοδευτικό όχημα..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Προσοχή, έπεται πολύ στενό τμήμα της διαδρομής..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Πλησιάζεις σε αλλαγή λωρίδας. Προσάρμοσε την ταχύτητα σου για να αποφύγεις πιθανή σύγκρουση..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Το μπροστινό όχημα συνοδείας θα προειδοποιήσει τους άλλους οδηγούς... <br> Προσάρμοσε την ταχύτητα σου για να αποφύγεις πιθανή σύγκρουση..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Τα συνοδευτικά οχήματα σε περιμένουν σε κοντινή διαστάυρωση. Παρακαλώ ακολούθησε τη διαδρομή."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Πρόσεχε!<br>Κατευθύνεσαι προς το πίσω συνοδευτικό όχημα!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Πρόσεχε!<br>Κατευθύνεσαι επικίνδυνα κοντά στο πίσω συνοδευτικό όχημα!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Παρακαλώ πάτησε το ακόλουθο κουμπί για να δεις την προσφορά ειδικής εργασίας:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Προσφορά Ειδικής Εργασίας:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Πρόκειται να μεταφέρεις φορτίο ειδικής μεταφοράς! Υπάρχουν δύο οχήματα συνοδείας που θα σε οδηγούν. Να είσαι προσεκτικός και να ακολουθείς τις ειδοποιήσεων οδηγιών και προτάσεων. Οι ειδικές μεταφορές, όπως αυτή δεν σταματούν σε κόκκινο φανάρι και έχουν προτεραιότητα στις περισσότερες περιπτώσεις. Κατά τη διάρκεια αυτών των παραδόσεων τα σημεία ελέγχου γίνονται πιο συχνά για την αποθήκευση της τρέχουσας προόδου σου."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Πρόσεχε ιδιαίτερα τα ακόλουθα:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Απόφυγε οποιαδήποτε σύγκρουση με τα συνοδευτικά οχήματα και κράτησε το φορτίο ανάμεσα τους."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Μην οδηγήσεις εκτός της προγραμματισμένης διαδρομής, ούτε σε βενζινάδικα, χώρους ανάπαυσης, κλπ."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Να τηρείς τα όρια ταχύτητας που θα τηρούνται από το μπροστινό όχημα συνοδείας."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Πρόσεξε τους οδηγούς που σε προσπερνούν και γενικότερα όλους τους χρήστες του δρόμου. "

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Ελιγμός αλλαγής λωρίδας:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Αν δεν ακολουθήσεις αυτούς τους κανόνες, η Ειδική Μεταφορά σου μπορεί να αποτύχει!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Ο ελιγμός ξεκινάει από την <color value=@@clr_sel@@>πίσω<color value=@@clr_txt@@> συνοδεία η οποία αλλάζει και σταματά την κυκλοφορία στη καθορισμένη λωρίδα."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Η <color value=@@clr_sel@@>μπροστινή<color value=@@clr_txt@@> συνοδεία περιμένει μέχρι η καθορισμένη λωρίδα να είναι ελεύθερη και τότε αλλάζει κι αυτή στην λωρίδα."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Έπειτα είναι ασφαλές για τον <color value=@@clr_sel@@>παίκτη<color value=@@clr_txt@@> να αλλάξει στην καθορισμένη λωρίδα."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Επαναπληρώθηκαν οι δεξαμενές καυσίμου του φορτηγού και οι ώρες οδήγησης αποκαταστάθηκαν."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Δεν μπορείς να καλέσεις για βοήθεια κατά τη διάρκεια μίας Ειδικής Μεταφοράς."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Δεν μπορείς να χρησιμοποιήσεις πλοίο κατά τη διάρκεια Ειδικών Μεταφορών."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Ξεκουράζεσαι...<br>Γεμίζονται οι δεξαμενές καυσίμου..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Πλησιάζεις την υποχρεωτική στάση.<br>Ακολούθησε το όχημα συνοδείας μέχρι την θέση στάθμευσης για να ξεκουραστείς!"

	#+ Adviser title for mandatory stop activation point
