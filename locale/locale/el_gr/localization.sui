	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση του υποβοηθούμενου στριψίματος (όταν είναι ενεργοποιημένη η λειτουργία υποβοήθησης λωρίδας.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση των κραδασμών λόγω του εδάφους, εφόσον το χειριστήριο υποστηρίζει ανάδραση με δόνηση."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση των ανωμαλιών του οδοστρώματος, εφόσον το χειριστήριο υποστηρίζει ανάδραση με δόνηση."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση της δόνησης λόγω συγκρούσεων, εφόσον το χειριστήριο υποστηρίζει ανάδραση με δόνηση."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Ο άξονας της συσκευής που χρησιμοποιείται για το στρίψιμο."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την νεκρή ζώνη του άξονα του τιμονιού. Την περιστροφή από το κέντρο όπου η είσοδος αγνοείται.<br><br>Αυτό μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς παλιών χειριστηρίων."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Καθορίζει τον τρόπο που διαχειρίζεται το παιχνίδι τον άξονα στριψίματος.<br>- Το Κεντραρισμένο είναι κατάλληλο για τιμονιέρες ή τζόυστικ.<br>- Το Αντεστραμμένο χρησιμοποιείται για την διόρθωση αξόνων που έχει εντοπιστεί λανθασμένα."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Ο άξονας της συσκευής που χρησιμοποιείται για την επιτάχυνση."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την νεκρή ζώνη του άξονα του γκαζιού. Το ποσό πατήματος όπου η είσοδος αγνοείται.<br><br>Αυτό μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς παλιών χειριστηρίων."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Καθορίζει τον τρόπο που διαχειρίζεται το παιχνίδι την είσοδο χειριστηρίων.<br>- Το Κεντραρισμένο είναι κατάλληλο για τιμονιέρες ή τζόυστικ.<br>- Το Κανονικό είναι κατάλληλο για τις σκανδάλες ή τα πεντάλ.<br>- Το Αντεστραμμένο χρησιμοποιείται για την διόρθωση εισόδων που έχουν εντοπιστεί λανθασμένα."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Ο άξονας της συσκευής που χρησιμοποιείται για φρενάρισμα."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την νεκρή ζώνη του άξονα του φρένου. Το ποσό πατήματος όπου η είσοδος αγνοείται.<br><br>Αυτό μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς παλιών χειριστηρίων."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Καθορίζει τον τρόπο που διαχειρίζεται το παιχνίδι την είσοδο χειριστηρίων.<br>- Το Κεντραρισμένο είναι κατάλληλο για τιμονιέρες ή τζόυστικ.<br>- Το Κανονικό είναι κατάλληλο για τις σκανδάλες ή τα πεντάλ.<br>- Το Αντεστραμμένο χρησιμοποιείται για την διόρθωση εισόδων που έχουν εντοπιστεί λανθασμένα."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Ο άξονας της συσκευής που χρησιμοποιείται για τον συμπλέκτη."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την νεκρή ζώνη του άξονα του συμπλέκτη. Το ποσό πατήματος όπου η είσοδος αγνοείται.<br><br>Αυτό μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς παλιών χειριστηρίων."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Καθορίζει τον τρόπο που διαχειρίζεται το παιχνίδι την είσοδο χειριστηρίων.<br>- Το Κεντραρισμένο είναι κατάλληλο για τιμονιέρες ή τζόυστικ.<br>- Το Κανονικό είναι κατάλληλο για τις σκανδάλες ή τα πεντάλ.<br>- Το Αντεστραμμένο χρησιμοποιείται για την διόρθωση εισόδων που έχουν εντοπιστεί λανθασμένα."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει το εύρος του συμπλέκτη.<br><br>Όσο δεξιότερα το ρυθμίσεις, τόσο περισσότερο θα χρειάζεται να πατήσεις το πεντάλ του συμπλέκτη για να εμπλακεί."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Ο άξονας της συσκευής που χρησιμοποιείται για την κίνηση της κάμερας πάνω και κάτω."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την νεκρή ζώνη του άξονα του κοιτάγματος πάνω-κάτω. Το ποσό πατήματος όπου η είσοδος αγνοείται.<br><br>Αυτό μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς παλιών χειριστηρίων."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Καθορίζει τον τρόπο που διαχειρίζεται το παιχνίδι την είσοδο άξονα:<br>- Το Κεντραρισμένο είναι κατάλληλο για τζόυστικ.<br>- Το Αντεστραμμένο χρησιμοποιείται για την διόρθωση αξόνων που έχουν εντοπιστεί λανθασμένα."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Ο άξονας της συσκευής που χρησιμοποιείται για την κίνηση της κάμερας αριστερά και δεξιά."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την νεκρή ζώνη του άξονα του κοιτάγματος δεξιά-αριστερά. Το ποσό πατήματος όπου η είσοδος αγνοείται.<br><br>Αυτό μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς παλιών χειριστηρίων."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Καθορίζει τον τρόπο που διαχειρίζεται το παιχνίδι την είσοδο άξονα:<br>- Το Κεντραρισμένο είναι κατάλληλο για τζόυστικ.<br>- Το Αντεστραμμένο χρησιμοποιείται για την διόρθωση αξόνων που έχουν εντοπιστεί λανθασμένα."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Επιλέγει την διάταξη που χρησιμοποιείται με το Κιβώτιο Ταχυτήτων Τύπου H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Αλλάζει την συμπεριφορά του λεβιέ αλλαγής ταχυτήτων:<br>- Με το «Απλό» ποτέ δεν θα υπάρχουν τριβές στο κιβωτίου ταχυτήτων.<br>- Το «Απλό + ήχος προειδοποίησης» σε αφήνει να αλλάζεις με απλό τρόπο τις ταχύτητες, αλλά με ήχο τριβών του κιβωτίου όταν γίνεται λανθασμένη αλλαγή.<br>- Η επιλογή «Προηγμένες» δεν θα σε αφήνει να αλλάζεις ταχύτητες με λανθασμένο τρόπο, και θα ακούς μόνο τον ήχο τριβών του κιβωτίου ταχυτήτων. Με την επιλογή «Προηγμένες» θα μπορείς να χρησιμοποιείς και την ρύθμιση «Γρήγορες μισές λεβιέ»."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Επίλεξε πως το παιχνίδι ανταποκρίνεται στις γρήγορες αλλαγές ταχυτήτων:<br>- Με το «Ποτέ» απαιτείται ο λεβιές να μετακινείται στην νεκρά μεταξύ των αλλαγών.<br>- Με το «Πάτημα συμπλέκτη» απαιτείται στιγμιαίο πάτημα του συμπλέκτη χωρίς μετακίνηση του λεβιέ.<br>- Με το «Απελευθέρωση γκαζιού» απαιτείται από τον οδηγό άφημα του γκαζιού για τις μισές ταχύτητες χωρίς μετακίνηση του λεβιέ, και το «Συμπλέκτης ή γκάζι» είναι ο συνδυασμός των δύο τελευταίων."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Αναθέτει την θέση στον λεβιέ."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Αναθέτει την θέση στον λεβιέ."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Αναθέτει την θέση στον λεβιέ."

