	key[]: "missing_deps_cont"
	val[]: "Θέλετε οπωσδήποτε να συνεχίσετε;<br>Ίσως προκληθεί πρόβλημα στο παιχνίδι!" #+ missing mods warning

	key[]: "missing_deps_rdlc_cont"
