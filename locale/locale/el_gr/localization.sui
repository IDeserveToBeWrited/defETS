#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Επιλέγει τον υπο-τύπο χειριστηρίου ώστε το παιχνίδι να διαχειρίζεται σωστά τα εύρη των εισόδων."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Επιλογή του τύπου του κιβωτίου ταχυτήτων:<br>- Το «Απλό Αυτόματο» επιτρέπει την χρήση γκαζιού και φρένου για τον έλεγχο της κίνησης μπρος τα εμπρός και όπισθεν.<br>- Το «Αληθινό Αυτόματο» απαιτεί την αλλαγή μεταξύ ταχυτήτων έμπροσθεν και όπισθεν.<br>- Το «Σειριακό» απαιτεί την χειροκίνητη αλλαγή των ταχυτήτων με πλήκτρα ανεβάσματος/κατεβάσματος.<br>- Το «Κιβώτιο Ταχυτήτων Τύπου H» απαιτεί χρήση χειριστηρίου με λεβιέ ταχυτήτων για την χειροκίνητη αλλαγή τους."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Αλλάζει την λειτουργία αλλαγής ταχυτήτων του αυτόματου κιβωτίου.<br>- Η «Οικονομική λειτουργία» προτιμά χαμηλότερες σ. α. λ. στις οποίες αποδίδεται η μέγιστη ροπή.<br>-Η «Λειτουργία υψηλής απόδοσης» τείνει στην μέγιστη ιπποδύναμη για καλύτερη απόδοση στις δουλειές με βαριά φορτία ή ορεινές διαδρομές εις βάρος όμως την κατανάλωσης καυσίμου."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την αναλογία μεταξύ των μοιρών περιστροφής της συσκευής και των πραγματικών μοιρών περιστροφής του τιμονιού των οχημάτων."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την γραμμικότητα μεταξύ της εισόδου και του τιμονιού των οχημάτων.<br><br>Η αύξηση αυτής της τιμής σημαίνει ότι το τιμόνι θα αποκρίνεται λιγότερο όταν βρίσκεται στο κέντρο και η ευαισθησία του θα αυξάνεται καθώς φτάνει στο τέρμα. Μπορεί να είναι χρήσιμο για να εξομαλύνει τις εισόδους του τιμονιού κατά την οδήγηση σε ευθεία."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Ενεργοποιεί την δυναμική ανάδραση στα χειριστήρια που την υποστηρίζουν."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την γενική ισχύ όλων των ρυθμίσεων δυναμικής ανάδρασης μεταξύ 0N και 10N.<br><br><color value=@@clr_txt_d@@>Να γνωρίζετε ότι η ρύθμιση σε υψηλότερο επίπεδο, κάποιες ισχυρότερες βάσεις τιμονιών μπορεί να προκαλέσουν τραυματισμούς σε δάχτυλα ή χέρια."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την δύναμη κεντραρίσματος κατά την οδήγηση με υψηλή ταχύτητα, που μεγιστοποιείται στα 90 χλμ/ω (56 μαω) και άνω.<br><br>Η ρύθμιση σε χαμηλά επίπεδα μπορεί να έχει ως αποτέλεσμα καθόλου κεντράρισμα."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την δύναμη κεντραρίσματος κατά την οδήγηση με χαμηλή ταχύτητα.<br><br>Η ρύθμιση σε χαμηλά επίπεδα μπορεί να έχει ως αποτέλεσμα καθόλου κεντράρισμα."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση της επίδρασης των εσωτερικών τριβών του συστήματος διεύθυνσης στο τιμόνι."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση της επίδρασης των δονήσεων του κινητήρα στο τιμόνι.<br><br><color value=@@clr_txt_d@@>Να γνωρίζετε ότι η ρύθμιση της τιμής αυτής πάνω από το 15% μπορεί να προκαλέσει πολλούς κραδασμούς και δονήσεις."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση της επίδρασης της επιφάνειας του δρόμου στο τιμόνι.<br><br><color value=@@clr_txt_d@@>Να γνωρίζετε ότι η ρύθμιση της τιμής αυτής πάνω από το 20% μπορεί να προκαλέσει πολλούς κραδασμούς και δονήσεις σε κάποιες τιμονιέρες κατά την οδήγηση σε ανώμαλο έδαφος με μεγάλη ταχύτητα."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ρυθμίζει την ένταση της επίδρασης των ανωμαλιών του οδοστρώματος στο τιμόνι."

