#@}

#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Συνέχισε ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Καλωσόρισες στο Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Τουλάχιστον έχεις την ευκαιρία να κάνεις την δουλειά των ονείρων σου - να οδηγείς ένα φορτηγό!"

	key[]: "intro_3"
	val[]: "Η δική σου μεταφορική εταιρία είναι πλέον ανοιχτή, αλλά δυστυχώς σου λείπουν τα χρήματα για να αγοράσεις ένα φορτηγό. Προς το παρόν θα πρέπει να δουλέψεις για άλλες εταιρίες σαν μισθωμένος οδηγός."

	key[]: "intro_4"
	val[]: "Η δουλειά σου είναι να μεταφέρεις με ασφάλεια ένα φορτίο $JOB_CARGO$ στην εταιρία $JOB_TARGET_COMPANY$ στην πόλη $JOB_TARGET_CITY$. Ο εργοδότης σου, σου παρέχει ένα φορτηγό και σου καλύπτει όλα τα έξοδα. Μην απογοητεύσεις κανέναν και φτάσε στην ώρα σου."


	key[]: "intro_garage_1"
	val[]: "Αυτά είναι τα κεντρικά σου."

	key[]: "intro_garage_2"
	val[]: "Είναι ένα βασικό γκαράζ. Μπορεί να μην είναι πολύ, αλλά είναι μια αρχή."

	key[]: "intro_garage_3"
	val[]: "Δυστυχώς, δεν έχεις ακόμη τίποτα για να παρκάρεις εδώ, οπότε δεν φαίνονται καθόλου φορτηγά."

	key[]: "intro_garage_4"
	val[]: "Μόλις μαζέψεις αρκετά χρήματα και αγοράσεις ένα φορτηγό, θα μπορείς να κινείσαι ελεύθερα στον κόσμο και να λειτουργείς την επιχείρηση σου από εδώ."

	key[]: "intro_garage_5"
	val[]: "Καλή τύχη!"


	key[]: "desktop_tut_t"
	val[]: "ΞΕΚΛΕΙΔΩΗΚΕ Η ΛΕΙΤΟΥΡΓΙΑ"

	key[]: "desktop_tut_job"
	val[]: "Διάλεξε την επόμενη δουλειά σου"

	key[]: "desktop_tut_cargo_market"
	val[]: "Χρησιμοποίησε το ολοκαίνουργιό σου τρέιλερ για να μπεις στην Αγορά Εμπορευμάτων και να μεταφέρεις μία τεράστια ποικιλία εμπορευμάτων στους προορισμούς τους." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Εδώ μπορείς να δεις την πρόοδο σου."

	key[]: "desktop_tut_company"
	val[]: "Παρακολούθησε τα γκαράζ σου, πρόσλαβε καινούριους οδηγούς, και άλλου είδους διαχείρισης της εταιρίας από εδώ."

	key[]: "desktop_tut_trailers"
	val[]: "Από εδώ και στο εξής θα μπορείς να αγοράζεις τα δικά σου τρέιλερ και να τα αναβαθμίζεις ή να τα βάφεις έτσι ώστε να ταιριάζουν με το φορτηγό σου.<br><br>Τα τρέιλέρ σου αποθηκεύονται στο/στα επιλεγμένα γκαράζ. μπορούν να χρησιμοποιηθούν από τους οδηγούς σου προς αύξηση των κερδών. Για να τα διαχειριστείς, χρησιμοποίησε τη Διαχείριση Τρέιλερ."

	key[]: "desktop_tut_visit_directive"
	val[]: "Μετάβαση σε $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "ΚΑΛΩΣΟΡΙΣΕΣ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Καλωσόρισες στην νέα Αρχικά Οθόνη.<br>Από εδώ μπορείς να διαχειριστείς κάθε λειτουργία του παιχνιδιού."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Παρακάτω, το Κεντρικό Μενού παρέχει άμεση πρόσβαση σε όλες τις κύριες λειτουργίες του παιχνιδιού."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Στην κορυφή, η νέα Γραμμή Κατάστασης παρέχει μόνιμα χρηστικά στατιστικά του προφίλ του παίκτη καθώς και τοπικούς κανονισμούς οδήγησης."

	key[]: "desktop_tut_tour_home"
	val[]: "Το κουμπί Αρχική είναι πάντα εκεί για να επιστέφεις στην Αρχική Σελίδα σου."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Το μόνιμο Γρήγορο Μενού παρέχει εύχρηστες συντομεύσεις για την πρόσβαση σε όλες τις λειτουργίες του παιχνιδιού από κάθε οθόνη."

	key[]: "desktop_tut_tour_drive"
	val[]: "Το ανανεωμένο κουμπί Οδήγηση παραμένει η σύνδεσή μου με τον κόσμο της οδήγησης, πάντα έτοιμο για βγεις και πάλι στους δρόμους."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "ΤΟ ΕΙΣΑΓΩΓΙΚΟ ΟΛΟΚΛΗΡΩΘΗΚΕ"

	key[]: "desktop_tut_tour_finish"
	val[]: "Ευχαριστούμε για την επισκόπηση της ανανεωμένης Αρχικής Οθόνης."
#@}


