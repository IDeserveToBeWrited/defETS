	key[]: "online_job_unable_to_resume_in_mp"
	val[]: "Η δουλειά σου από το World of Trucks που είχε αναβληθεί δεν είναι διαθέσιμη σε αυτήν την συνεδρία.<br><br>Η δουλειά αναβλήθηκε κοντά σε εταιρεία που βρίσκεται σε διαφορετική κατάσταση, το φορτίο βρίσκεται σε ανενεργή εταιρεία ή η εταιρεία του προορισμού είναι ανενεργή κατά την διάρκεια αυτής της συνεδρείας."

	key[]: "job_detail_t"
	val[]: "ΤΡΕΧΟΥΣΑ ΔΟΥΛΕΙΑ" #+ name of job detail screen

	key[]: "no_online_jobs_message"
	val[]: "Δεν βρέθηκαν συμβόλαια γύρω από την τρέχουσα θέση σου.<br><br>Πήγαινε ποιο κοντά σε πόλη ή εταιρία και προσπάθησε ξανά." #+ message shown when there are no online jobs around player's position

	key[]: "no_company_online_jobs_message"
	val[]: "Δεν βρέθηκαν συμβόλαια σε αυτή την εταιρία." #+ message shown when there are no online jobs at company activation point

