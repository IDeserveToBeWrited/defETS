#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "ΕΠΙΣΚΟΠΗΣΗ ΚΑΤΑΣΤΑΣΗΣ ΦΟΡΤΗΓΟΥ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "Κατάσταση" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Το όχημα έχει σημαντικά μηχανικά προβλήματα που επηρεάζουν την απόδοση και την αξιοπιστία. Θα πρέπει να σκεφτείς την πλήρη ανακατασκευή ή την αντικατάσταση πολλών εξαρτημάτων." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "Το όχημα παρουσιάζει μηχανικά προβλήματα τα οποία θα μπορούσαν να μειώσουν την απόδοση ή την αξιοπιστία του. Απαιτείται σέρβις." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Το όχημα είναι κατάλληλο για κυκλοφορία αλλά μπορεί να έχει κάποια θεματάκια. Προτείνεται σέρβις." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Το όχημα είναι σε καλή κατάσταση με μικρές φθορές." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Το όχημα είναι σε εξαιρετική κατάσταση με ελάχιστη φθορά." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Συντήρηση" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "Αντιπροσωπεύει την γενική γήρανση και συνεχή φθορά ολόκληρου του οχήματος. Επισκευάζεται με πλήρη ανακατασκευή." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Φθορά Εξαρτημάτων" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "Τα διανυθέντα χιλιόμετρα και τα ατυχήματα οδηγούν σε φθορές και βλάβες. Θα πρέπει να γίνεται παρακολούθηση της κατάστασης και αντικατάσταση εξαρτημάτων εφόσον απαιτείται." #+ Explanation unfixable wear.
#@}

