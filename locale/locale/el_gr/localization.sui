#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Η πιο απλή μέθοδος οδήγησης σχεδιάστηκε ειδικά (αλλά όχι μόνο) για τα πλήκτρα του πληκτρολογίου. Πάτησε το ΜΠΡΟΣΤΑ για να οδηγήσεις προς τα εμπρός και πάτησε το ΠΙΣΩ για να φρενάρεις ή να κάνεις όπισεθν. Το κιβώτιο ταχυτήτων θα τα χειριστεί όλα τα άλλα για σένα: εναλλαγή μεταξύ οδήγησης προς τα εμπρός, φρεναρίσματος, ή όπισθεν, αλλαγή ταχυτήτων στις σωστές ταχύτητες κ.ο.κ."

	key[]: "wiz_gb_automatic"
	val[]: "Ιδανικό για τιμονιέρα με πετάλια. Χρησιμοποίησε τα κουμπιά για να αλλάζεις μεταξύ οδήγησης προς τα εμπρός, νεκράς (κενής), ή όπισθεν. Μετά πάτησε το γκάζι και άφησε το αυτόματο κιβώτιο να αλλάζει τις ταχύτητες."

	key[]: "wiz_gb_sequential"
	val[]: "Άλλαξε ταχύτητες χειροκίνητα και επίλεξε μεταξύ ταχύτητες κίνησης, νεκρά και όπισθεν. Είναι λίγο δύσκολο για να το τελειοποιήσεις, αλλά μπορείς να καταφέρεις καλύτερη οδηγική απόδοση και να έχεις πλήρη έλεγχο του οχήματος σε διάφορες καταστάσεις."

	key[]: "wiz_gb_hshifter"
	val[]: "Επίλεξε άμεσα την επιθυμητή ταχύτητα. Παρόμοιο σε δυσκολία με το σειριακό κιβώτιο, αλλά πιο ρεαλιστικό. Ο πραγματικός επιλογέας τύπου H όπως του G27 ή του G25 συστήνεται. Απαιτεί συμπλέκτη. "
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Αυτή η λειτουργία απαιτεί ένα τιμόνι ή τηλεχειριστήριο."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Δεν ανιχνεύθηκε χειριστήριο επιλογέα τύπου H. Αυτή η λειτουργία μπορεί να μην είναι διαθέσιμη."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "ΕΠΙΛΟΓΗ ΔΙΑΤΑΞΗΣ ΤΥΠΟΥ Η"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Η μετάδοση αργού-γρήγορου είναι η απλούστερη επιλογή. Έχει δύο ομάδες ταχυτήτων. Η πρώτη ομάδα (αργές) περιέχει τις ταχύτητες από 1 ως 6 και η δεύτερη ομάδα (γρήγορες) τις ταχύτητες από 7 ως 12. Ένας επιλογέας εναλλάσσει  αυτές τις δύο ομάδες καθώς ο λεβιές επιλέγει μια συγκεκριμένη ταχύτητα από τις ομάδες."

	key[]: "wiz_hs_splitter"
	val[]: "Η μετάδοση τύπου splitter είναι μία απλή εναλλακτική λύση. Επίσης έχει 2 σετ ταχυτήτων. Το πρώτο σετ ταχυτήτων περιέχει μονό αριθμό ταχυτήτων (1, 3, 5 ...) και το δεύτερο σετ περιέχει ζυγό αριθμό ταχυτήτων (2, 4, 6 ...). Ένα κουμπί εναλλαγής αλλάζει ανάμεσα σε αυτά τα 2 σετ ενώ ο λεβιές ταχυτήτων επιλέγει μία συγκεκριμένη ταχύτητα από το σετ."

	key[]: "wiz_hs_range_splitter"
	val[]: "Το κιβώτιο ταχυτήτων με υποδιαίρεση βασίζεται στη διάταξη του αληθινού χειροκίνητου κιβωτίου ταχυτήτων με υποδιαίρεση. Οι ταχύτητες ομαδοποιούνται ανά τέσσερις σε κάθε θέση του κιβωτίου τύπου H και χρησιμοποιούν δύο διακόπτες. Συνεπώς συνίσταται για έμπειρους οδηγούς μόνο."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Το παιχνίδι είναι τώρα ρυθμισμένο χρησιμοποιώντας τις προεπιλεγμένες ρυθμίσεις που περιγράφονται παρακάτω. Μπορείς να τις τροποποιήσεις χρησιμοποιώντας τις προηγμένες ρυθμίσεις ή μπορείς να μεταβείς απευθείας στο παιχνίδι."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Προηγμένες ρυθμίσεις"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Το παιχνίδι είναι τώρα ρυθμισμένο και μπορείς να συνεχίσεις. Μπορείς να αλλάξεις τις ρυθμίσεις αργότερα στην οθόνη χειριστήρια στις ρυθμίσεις."

	key[]: "wiz_cfg_steam"
	val[]: "Μπορείς να ελέγξεις και να διαμορφώσεις την αντιστοίχιση κουμπιών και αξόνων για αυτό το χειριστήριο μέσω του Steam. Οι ρυθμίσεις του χειριστηρίου Steam για το παιχνιδι είναι διαθέσιμες στο Steam > Συλλογή > Euro Truck Simulator 2 > Διαμόρφωση Χειριστηρίου."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Άνοιγμα ρυθμίσεων χειριστηρίου"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Χρησιμοποίησε το κουμπί @@imm_wiz_dsteerleft@@ και @@imm_wiz_dsteerright@@ για να στρίψεις.\n"

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Μετακίνησε το ποντίκι αριστερά ή δεξιά για να περιστρέψεις το τιμόνι προς την αντίστοιχη κατεύθυνση."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Χρησιμοποίησε το @@ima_wiz_j_steer@@ για να στρίψεις.\n"


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Χρησιμοποίησε το @@imm_wiz_dforward@@ για να οδηγήσεις προς τα εμπρός και χρησιμοποίησε το @@imm_wiz_dbackward@@ για να οδηγήσεις προς τα πίσω."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Μετακίνησε το @@ima_wiz_j_throttle@@ μπροστά για να οδηγήσεις μπροστά και πίσω για να κάνεις όπισθεν."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Χρησιμοποίησε το @@ima_wiz_j_throttle@@ για να οδηγήσεις προς τα εμπρός και χρησιμοποίησε το @@ima_wiz_j_brake@@ για να οδηγήσεις προς τα πίσω."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Χρησιμοποίησε το @@imm_wiz_dforward@@ για να επιταχύνεις και χρησιμοποίησε το @@imm_wiz_dbackward@@ για να φρενάρεις."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Μετακίνησε το @@ima_wiz_j_throttle@@ μπροστά για να επιταχύνεις και πίσω για να φρενάρεις."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Χρησιμοποίησε το @@ima_wiz_j_throttle@@ για να επιταχύνεις και χρησιμοποίησε το @@ima_wiz_j_brake@@ για να φρενάρεις."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Χρησιμοποίησε το @@imv_wiz_gearup@@ για να βάλεις έμπροσθεν ταχύτητα και το @@imv_wiz_geardown@@ για όπισθεν ταχύτητα."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Χρησιμοποίησε το @@imv_wiz_gearup@@ για να βάλεις έμπροσθεν ταχύτητα και το @@imv_wiz_geardown@@ για όπισθεν ταχύτητα αν χρησιμοποιείς πληκτρολόγιο ή πλήκτρα χειριστηρίου. Χρησιμοποίησε το @@imv_wiz_drive@@ και το @@imv_wiz_reverse@@ για να επιλέξεις την κατεύθυνση κίνησης αν χρησιμοποιείς λεβιέ ταχυτήτων."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Χρησιμοποίησε το @@imv_wiz_gearup@@ και @@imv_wiz_geardown@@ για να επιλέξεις την επιθυμητή ταχύτητα.\n"

	key[]: "wiz_cfg_gb_direct"
	val[]: "Χρησιμοποίησε το H-shifter μαζί με το @@ima_wiz_j_clutch@@ για να επιλέξεις την επιθυμητή ταχύτητα."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "ΡΥΘΜΙΣΗ ΑΞΟΝΩΝ ΧΕΙΡΙΣΤΗΡΙΟΥ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Απεικόνιση Αξόνων"

	key[]: "wiz_setup_axes_desc"
	val[]: "Μπορείς να δοκιμάσεις όλες τις λειτουργίες των επιλεγμένων αξόνων οπτικά. Χρησιμοποίησε το χειριστήριο και παρακολούθησε όλες τις μπάρες που κινούνται. Αυτές δείχνουν τα όρια, κεντράρισμα, προσανατολισμό και ολόκληρη την συμπεριφορά του κάθε άξονα που χρησιμοποιείται."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Ρύθμιση Άξονα"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Για την επιλογή άξονα, κάνε κλικ στο κουμπί δίπλα από το όνομα του άξονα. Αυτό ενεργοποιεί τη λειτουργία εισαγωγής. Έπειτα, με τη χρήση του χειριστηρίου, εκχώρησε τον επιλεγμένο άξονα κινώντας τους αναλογικούς μοχλούς, το τιμόνι ή τα πεντάλ."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Νεκρή Ζώνη"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Η νεκρή ζώνη αναφέρεται σε περιοχή του άξονα που είναι σχεδιασμένη επίτηδες ώστε να μην παρέχει είσοδο δεδομένων. Για την ρύθμισή της, μετακίνησε το αντίστοιχο ρυθμιστικό. Με την αύξηση, προς τα δεξιά, μεγαλώνει η νεκρή ζώνη. Αυτή η λειτουργία είναι αρκετά χρήσιμη για παλαιότερα χειριστήρια, καθώς ο ορισμός μεγαλύτερης νεκρής ζώνης μπορεί να μειώσει ζητήματα ανακρίβειας ή λανθασμένων εισόδων λόγω της φθοράς του υλικού."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Λειτουργίες Αξόνων"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Η λειτουργία του άξονα καθορίζει πως χρησιμοποιείται εντός του παιχνιδιού. Ο ανεστραμένος άξονας αναστρέφει την σχετική θέση του, οπότε στρίβοντας το τιμόνι δεξιά αυτό στρίβει αριστερά εντός του παιχνιδιού. Ο κεντραρισμένος άξονας έχει την μηδενική του θέση στο μέσο του εύρους του, όπως ένας αναλογικός μοχλός. Αυτή η λειτουργία είναι χρήσιμη για την διόρθωση ενός άξονα που έχει ανιχνευθεί λανθασμένα."

	key[]: "normal"
	val[]: "Κανονικό" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Αντεστραμμένο" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Κεντραρισμένο" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Αντεστραμμένο και Κεντραρισμένο" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "ΡΥΘΜΙΣΗ ΑΥΤΟΜΑΤΟΥ ΚΙΒΩΤΙΟΥ ΤΑΧΥΤΗΤΩΝ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Με το αυτόματο κιβώτιο ταχυτήτων θα χρειάζεται να αλλάζεις μόνο κατευθύνσεις μεταξύ μπροστά, νεκρά και να όπισθεν. Θα το πετύχεις αυτό χρησιμοποιώντας τα ακόλουθα κουμπιά και τα πλήκτρα του χειριστηρίου. Για να αλλάξεις τις ρυθμίσεις, κάνε κλικ σε ένα κουμπί και πάτησε το κουμπί ή το πλήκτρο του χειριστηρίου το οποίο θέλεις να χρησιμοποιείς για αυτήν την ενέργεια."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Εάν έχεις μοχλό ταχυτήτων τύπου H συνδεδεμένο, μπορείς να το χρησιμοποιήσεις για εξομοίωση ενός αληθινού αυτόματου κιβωτίου ταχυτήτων. Ενεργοποίησε αυτήν την επιλογή και θα μπορείς να αντιστοιχείς τις θέσεις του μοχλού ταχυτήτων τύπου H σε λειτουργία οδήγησης προς τα εμπρός και προς τα πίσω. Άλλες θέσεις του μοχλού ταχυτήτων τύπου H μετρούνται ως νεκρές. Αυτές οι ρυθμίσεις δημιουργήθηκαν ειδικά για τον μοχλό ταχυτήτων τύπου H και δεν θα λειτουργήσουν σε κανονικά πλήκτρα ούτε στα πλήκτρα του χειριστηρίου. Για να αλλάξεις την αντιστοιχία, πάτα στο κουμπί και μετά μετακίνησε τον μοχλό ταχυτήτων στην επιθυμητή θέση και μετά πίσω στην νεκρά."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "ΡΥΘΜΙΣΗ ΣΕΙΡΙΑΚΟΥ ΚΙΒΩΤΙΟΥ ΤΑΧΥΤΗΤΩΝ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Το σειριακό κιβώτιο ταχυτήτων αλλάζει όλες τις ταχύτητες κίνησης προς τα μπροστά, νεκράς και όπισθεν. Εδώ είναι όλα τα πλήκτρα και τα κουμπιά του χειριστηρίου που χρησιμοποιούνται για ανέβασμα και κατέβασμα ταχυτήτων. Για να αλλάξετε την αντιστοιχία, κάντε κλικ στο κουμπί και πατήστε ένα πλήκτρο ή το πλήκτρο του χειριστηρίου που θέλετε να χρησιμοποιήσετε για αυτήν την ενέργεια."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "ΡΥΘΜΙΣΗ ΧΕΙΡΟΚΙΝΗΤΟΥ ΚΙΒΩΤΙΟΥ ΤΑΧΥΤΗΤΩΝ ΤΥΠΟΥ Η" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Εδώ μπορείς να διαλέξεις την βασική διάταξη του μοχλού ταχυτήτων τύπου H και να δοκιμάσεις τις λειτουργίες του. Στην εικόνα μπορείς να δεις την τρέχουσα θέση του λεβιέ ταχυτήτων καθώς και ποια ταχύτητα είναι επιλεγμένη. Δεδομένου του ότι το κιβώτιο περιέχει περισσότερες ταχύτητες από όσες υπάρχουν στον επιλογέα, χρειάζεται να χρησιμοποιήσεις κουμπιά εναλλαγής για να πηγαίνεις στο άλλο σετ ταχυτήτων."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Η παρούσα επιλεγμένη σχέση και οι ενεργοί διακόπτες επίσης εμφανίζονται παρακάτω, δίπλα στο επιλεγμένο χειριστήριο. Για να αλλάξεις ένα επιλεγμένο χειριστήριο, πάτησε στο σωστό κουμπί και μετά μετακίνησε τον επιλογέα στην επιθυμητή θέση και μετά πίσω στην νεκρά."
#@}

