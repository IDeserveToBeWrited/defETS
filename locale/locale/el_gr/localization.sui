	key[]: "screenshotman_offline"
	val[]: "ΤΟ ΠΡΟΦΙΛ ΔΕΝ ΕΙΝΑΙ ΣΥΝΔΕΔΕΜΕΝΟ!<br><br>Για να ανεβάσεις φωτογραφία το προφίλ σου πρέπει να είναι συνδεδεμένο στον διαδικτυακό λογαριασμό.<br><br>Θέλεις να επεξεργαστείς το προφίλ σου τώρα;" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Άδεια θέση" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Σφάλμα" #+ Shown in screenshot slot when there is error while retrieving its content.

