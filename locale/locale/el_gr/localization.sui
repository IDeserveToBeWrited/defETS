	key[]: "trip_time"
	val[]: "Χρόνος ταξιδιού" #+ Shown in the route info box in the line indicating expected duration of the route when driving in a reasonable way. For example "Trip time&nbsp;&nbsp;&nbsp;3 h 30 min"

	key[]: "trip_ferry_len"
	val[]: "Διαδρομή πλοίου" #+ Shown in the route info box in the line indicating length of the ferry route. For example "Ferry distance&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100 km"

	key[]: "trip_ferry_price"
	val[]: "Τιμή πλοίου" #+ Shown in the route info box in the line indicating price of the ferry route. For example "Ferry price&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;€100.-"

	key[]: "trip_land_len"
	val[]: "Απόσταση διαδρομής ξηράς" #+ Shown in the route info box in the line indicating length of the land route. For example "Land distance&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100 km"

	key[]: "no_route"
	val[]: "Επίλεξε φορτίο για να δεις λεπτομέρειες διαδρομής" #+ Text shown centred in the route info box when no job is selected.

	key[]: "incomplete_route"
