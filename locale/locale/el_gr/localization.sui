	key[]: "force_feedback_reset"
	val[]: "Επαναφορά στις αρχικές ρυθμίσεις" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Συνολική ισχύς" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "Κεντράρισμα σε υψηλή ταχύτητα" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "Κεντράρισμα σε χαμηλή ταχύτητα" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "Εσωτερική τριβή" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "Αντήχηση κινητήρα" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "Επιφάνεια εδάφους" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "Ανωμαλίες" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "Συγκρούσεις" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "Τριβή κιβωτίου" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "Ολίσθηση υποστροφής" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "Υποβοηθούμενο σύστημα διεύθυνσης" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "Δόνηση επιφάνειας εδάφους" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "Δόνηση ανωμαλιών" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Δόνηση συγκρούσεων" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

	key[]: "ffb_lut_usage_hint"
	val[]: "Το παιχνίδι χρησιμοποιεί ειδικούς LUT για την δυναμική ανάδραση της τιμονιέρας, και δεν υπάρχει υποστήριξή. Σε περίπτωση προβλημάτων με την δυναμική ανάδραση αφαιρέστε το αρχείο από το φάκελο του προφίλ χρήστη σας!" #+ Hint telling player that the game is using custom force feedback LUT loaded from profile folder and to remove it in case of problems.
