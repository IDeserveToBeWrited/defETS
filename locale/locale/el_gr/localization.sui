	val[]: "Αναθέτει την είσοδο που χρησιμοποιείται για αλλαγή μεταξύ ευρών στο κιβώτιο ταχυτήτων."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Αναθέτει την είσοδο που χρησιμοποιείται για αλλαγή μεταξύ αργού και γρήγορου στο κιβώτιο ταχυτήτων."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Ενεργοποιεί την χρήση διακοπτών αντί κουμπιών για τις αλλαγές ευρών ή μισών ταχυτήτων."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Αναθέτει το κουμπί για την αλλαγή σε Έμπροσθεν στο αυτόματο κιβώτιο ταχυτήτων."

