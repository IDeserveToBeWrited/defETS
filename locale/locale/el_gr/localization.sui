#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Το αρχείο του στιγμιότυπου είναι πολύ μεγάλο. Παρακαλώ προσπαθήστε να μειώσετε την ανάλυση παρουσίασης." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Το αρχείο στιγμιότυπου είναι ζημιωμένο ή δεν υποστηρίζεται." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Η ανάλυση του στιγμιότυπου είναι πολύ μεγάλη. Παρακαλώ μειώστε την ανάλυση εικόνας." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Η υπηρεσία απέρριψε το στιγμιότυπο." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Ο λογαριασμός δεν επιτρέπεται να ανεβάσει στιγμιότυπα." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Υπήρχε ταυτόχρονη φόρτωση στην ίδια θέση." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Η φόρτωση είναι επί του παρόντος απενεργοποιημένη. Παρακαλώ προσπαθήστε αργότερα." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Άγνωστο σφάλμα διαπιστώθηκε κατά τη διάρκεια της φόρτωσης. Παρακαλώ προσπαθήστε αργότερα." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Το στιγμιότυπο είναι μεγαλύτερο από το μέγιστο μέγεθος του $LIMIT$ και διαμορφώθηκε. " # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Το αρχείο στιγμιότυπου είναι μεγαλύτερο από το μέγιστο επιτρεπόμενο μέγεθος των $LIMIT$KBKB και ρυθμίστηκε το μέγεθος του." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
