#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "ΤΡΑΠΕΖΑ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Τράπεζα" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Αν χρειάζεσαι χρήματα, μπορείς πάντα να ζητήσεις ένα δάνειο από την τράπεζα." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "ΠΡΟΣΦΟΡΕΣ ΔΑΝΕΙΩΝ" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "για $MONEY$ την ημέρα" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Αριθμός ενεργών δανείων: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Μπορείς να δανειστείς: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "ΣΥΝΟΨΗ ΕΝΕΡΓΩΝ ΔΑΝΕΙΩΝ"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Δάνειο" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Υπόλοιπο πληρωμών:" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Διάρκεια (σε ημέρες)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Επιτόκιο (ετήσιο)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Δόση" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Εξόφληση" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Σύνολο:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Υπόλοιπο λογαριασμού: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "ΝΕΟ ΔΑΝΕΙΟ" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Ζητάς ένα δάνειο $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Περίοδος επαναπληρωμής:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Επιτόκιο (κατ' έτος):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Ημερήσια δόση:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Θέλεις να επιβεβαιώσεις την αίτηση σου;"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "ΕΞΟΦΛΗΣΗ ΔΑΝΕΙΟΥ" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Θέλεις πραγματικά να ξοδέψεις $MONEY$ για την αποπληρωμή του δανείου;" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


