	key[]: "db_visit_service_man"
	val[]: "ΕΠΙΣΚΕΨΗ ΣΥΝΕΡΓΕΙΟΥ"

	key[]: "db_actros_info0"
	val[]: "ΤΡΕΧΟΥΣΑ ΩΡΑ"

	key[]: "db_actros_info1"
	val[]: "ΤΡΕΧΟΥΣΑ ΤΑΧΥΤΗΤΑ"

