	key[]: "load_save_t"
	val[]: "ΑΠΟΘΗΚΕΥΣΗ Ή ΦΟΡΤΩΣΗ ΠΑΙΧΝΙΔΙΟΥ" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "Αποθήκ. & Φόρτωση" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Ανιχνεύθηκε αλλαγή στο παιχνίδι! Για αποφυγή προβλημάτων συμβατότητας των αποθηκεύσεων λόγω αλλαγών στον κόσμο του παιχνιδιού, όλες οι εκκρεμείς παραδόσεις ακυρώθηκαν χωρίς ποινή." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Ανιχνεύθηκε αλλαγή στο παιχνίδι!<br><br>Για αποφυγή προβλημάτων συμβατότητας των αποθηκεύσεων λόγω αλλαγών στον κόσμο του παιχνιδιού, όλες οι εκκρεμείς παραδόσεις ακυρώθηκαν χωρίς ποινή. Απαιτείται επανατοποθέτηση του φορτηγού σε ασφαλές σημείο.<br><br>Επιλέξτε προορισμό γρήγορου ταξιδιού για συνέχεια." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Αποθήκευση ... " #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Πάτησε $KEY$ για παράλειψη κομμένων σκηνών." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
#@{

	key[]: "no_drive_t"
	val[]: "ΔΕΝ ΥΠΑΡΧΕΙ ΦΟΡΤΗΓΟ" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "Δεν μπορείς να μετακινηθείς ελεύθερα στον κόσμο επειδή δεν έχεις ένα φορτηγό για να οδηγήσεις! Θα μπορούσες να αγοράσεις ένα ή να πάρεις κάποιο από τον στόλο σου.<br><br>Θα ήθελες να κάνεις μία γρήγορη δουλειά τώρα;"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "ΦΟΡΤΩΣΗ ΠΑΙΧΝΙΔΙΟΥ"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Φόρτωση Παιχνιδιού" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Φόρτωση ενός προηγουμένου αποθηκευμένου παιχνιδιού. Η τρέχουσα πρόοδος θα χαθεί!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Θέλεις σίγουρα να φορτώσεις ένα άλλο παιχνίδι;<br><br>Η τρέχουσα πρόοδος σου θα χαθεί εκτός κι αν αποθηκευτεί πριν."

	key[]: "load_progress_lost_mp"
	val[]: "Είσαι σίγουρος ότι θέλεις να φορτώσεις άλλο παιχνίδι;<br>Μια τέτοια ενέργεια εντός παινχιδιού πολλών παικτών μπορεί να προκαλέσει ακύρωση ή αναβολή της δουλειάς, τηλεμεταφορά στο κοντινότερο συνεργείο ή μη διαθεσιμότητα της επιλεγμένης δουλειάς.<br><br>Η τρέχουσα πρόοδος θα χαθεί εκτός κι αν υπάρχει προηγούμενη αποθήκευση."

	key[]: "load_game_mp_suspended_job"
	val[]: "Η αποθήκευση ήταν επιτυχής, αλλά η ενεργή σου δουλειά από το World of Trucks αναβλήθηκε και δεν είναι διαθέσιμη εντός αυτής της συνεδρίας."

	key[]: "autosave"
	val[]: "- Αυτόματη Αποθήκευση - " #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Γρήγορη αποθήκευση -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Προβολή αποθηκεύσεων" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Δεν βρέθηκαν μη αυτόματες αποθηκεύσεις." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Φόρτωση" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Ασύμβατη αποθήκευση!<br><color value=@@clr_txt@@>Προσπαθήστε να ενημερώσετε το παιχνίδι στην τελευταία διαθέσιμη έκδοση." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Αποτυχία φόρτωσης και εμφάνισης των αποθηκεύσεων για αυτό το προφίλ." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "ΠΡΟΣΟΧΗ" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Πρόβλημα φόρτωσης της αποθήκευσης.<color value=@@clr_txt@@><br><br>Η αποθήκευση απέτυχε να φορτωθεί. Προσπάθησε να εντοπίσεις και πιθανόν να φτιάξεις το πρόβλημα χρησιμοποιώντας τις πληροφορίες παρακάτω. Εναλλακτικά,  προσπάθησε να φορτώσεις άλλη αποθήκευση.<br><br>Οι ακόλουθοι λόγοι συχνά προκαλούν αυτό το πρόβλημα:<br><br>1. Η αποθήκευση δεν είναι συμβατή με εγκατεστημένες τροποποιήσεις.<br><br>2. Η αποθήκευση περιέχει πληροφορίες από τροποποιήσεις οι οποίες λείπουν ή είναι απενεργοποιημένες.<br><br>3. Η αποθήκευση έχει καταστραφεί από την χρήση μιας τροποποίησης που δεν δημιουργήθηκε σωστά.<br><br>4. Πρόβλημα του υπολογιστή κατά την διάρκεια ή μετά την διαδικασία αποθήκευσης θα μπορούσε να αλλοιώσει την αποθήκευση."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Εντοπίστηκε απουσία MOD.<color value=@@clr_txt@@><br><br>Η τελευταία αποθήκευση περιέχει MOD που δεν υπάρχουν ή είναι απενεργοποιημένα.<br><br>Παρακαλώ ελέγξτε την κατάσταση των MOD.<br><br>Αλλιώς προσπαθήστε να φορτώσετε την αποθήκευσή σας ούτως ή άλλως. Ωστόσο, ανάλογα με ποιο/-α MOD το προκάλεσε/-αν αυτό, είναι πιθανό να αποτύχει η φόρτωση ή να προκληθούν άλλα προβλήματα.<br><br>Εναλλακτικά, προσπαθήστε να φορτώσετε άλλη αποθήκευση, η οποία δεν εξαρτάται από MOD."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Εντοπίστηκε απουσία προαιρετικού DLC.<color value=@@clr_txt@@><br><br>Η τελευταία αποθήκευση βασίζεται σε DLC (επίσημη επέκταση παιχνιδιού) το οποίο απουσιάζει.<br><br>Αν δεν αναμένατε κάτι τέτοιο, ελέγξτε την κατάσταση του/των DLC.<br><br>Μπορείτε να φορτώσετε την αποθήκευση, όμως κάποιες λειτουργίες που παρέχονται από το/τα DLC μπορεί να χαθούν.<br><br>Εναλλακτικά, δοκιμάστε να φορτώσετε κάποια άλλη αποθήκευση που δεν βασίζεται στο/στα DLC που απουσιάζει/-ουν."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Εντοπίστηκε απουσία DLC.<color value=@@clr_txt@@><br><br>Η τελευταία αποθήκευση εξαρτάται σε DLC (επίσημη επέκταση παιχνιδιού) το οποίο απουσιάζει.<br><br>Για να λειτουργήσει σωστά αυτή η αποθήκευση, αυτό το DLC πρέπει να υπάρχει και να είναι ενεργοποιημένο σε αυτόν τον υπολογιστή.<br><br>Εναλλακτικά, προσπαθήστε να φορτώσετε άλλη αποθήκευση, η οποία δεν εξαρτάται από το DLC που απουσιάζει."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>To MOD εξαρτάται σε περιεχόμενο DLC.<color value=@@clr_txt@@><br><br>Τουλάχιστον ένα MOD εξαρτάται σε περιεχόμενο DLC (επίσημη επέκταση παιχνιδιού) η οποία δεν είναι εγκατεστημένη προς το παρόν.<br><br>Πρέπει να απενεργοποιήσετε το/τα MOD ή να εγκαταστήσετε το/τα DLC σε κάθε περίπτωση όπου MOD βασίζονται σε αυτό/-ά."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Εντοπίστηκε πρόβλημα<color value=@@clr_txt@@><br><br>Φαίνεται ότι το παιχνίδι έχει πρόβλημα και δεν μπορεί να φορτώσει την προηγούμενη φόρτωση.<br><br>Προσπαθήστε να εντοπίσετε και να φτιάξετε το πρόβλημα χρησιμοποιώντας τις πληροφορίες παρακάτω. Διαφορετικά, προσπαθήστε να φορτώσετε άλλη αποθήκευση.<br><br>Οι ακόλουθοι λόγοι συνήθως προκαλούν τα προβλήματα:<br><br>1. Μία ή περισσότερες από τις εγκατεστημένες τροποποιήσεις είναι κατεστραμμένες ή ασύμβατες με την τρέχουσα έκδοση του παιχνιδιού.<br><br>2. Η αποθήκευση περιέχει πληροφορίες από τροποποιήσεις οι οποίες λείπουν ή είναι απενεργοποιημένες.<br><br>3. Η αποθήκευση καταστράφηκε από την χρήση μιας κακοφτιαγμένης τροποποίησης.<br><br>4. Σε ορισμένες περιπτώσεις το πρόβλημα θα μπορούσε να προκληθεί από την δυσλειτουργία των drivers ή του υλικού."

	key[]: "mods_detected_warning"
	val[]: "Εντοπίστηκε παρουσία MOD. Πρέπει να γνωρίζεις πως παρωχημένα ή ασύμβατα MOD μπορεί να προκαλούν αστάθεια στο παιχνίδι. Παρακαλώ έλεγξε τα ενεργά MOD στη Διαχείριση Mod." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
