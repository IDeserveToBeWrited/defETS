#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή θεμάτων που προβάλλονται στην επιφάνεια εργασίας του παιχνιδιού κατά την περιήγηση των μενού."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Ενεργοποίση τυχαίας επιλογής του θέματος επιφάνειας εργασίας κάθε φορά που ανοίγεις το παιχνίδι."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Ρύθμιση του χρόνου μετά από τον οποίο τα στοιχεία της επιφάνειας εργασίας σβήνουν."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, θα βιώνεις τα αποτελέσματα της κούρασης με τον καιρό.<br><br>Η αποφυγή ανάπαυσης θα έχει ως αποτέλεσμα πρόστιμα."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "When enabled, you must obey traffic rules or risk getting traffic offences. The risk is increased near police vehicles, radar and traffic cameras."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Ρύθμιση του μέσου μήκους δουλειών που εμφανίζονται."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Επιλογή τύπου ορίου ταχύτητας προς εμφάνιση στο γραφικό στοιχείο πλοήγησης."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Η τρέχουσα ταχύτητα στην πλοήγηση αλλάζει σε κόκκινο όταν παραβαίνεις το όριο ταχύτητας."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Με την άφιξη στον προορισμό σου, θα εμφανίζεται ένα γραφικό στοιχείο για την επιλογή παράλειψης της στάθμευσης."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all widgets hidden."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Δεν εμφανίζονται και οι δύο καθρέπτες γραφικώνν στοιχείων."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all notifications hidden even when they are received."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Εμφάνιση παραθύρου με τις ικανότητες του τρέχοντος φορτηγού του παίκτη πριν την επιβεβαίωση δουλειάς βαρέος φορτίου."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Επίλεξε τον τρόπο ευθυγράμμισης του χάρτη."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Επιλογή του τρόπου εμφάνισης της πλοήγησης."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλάζει τον τρόπο υπολογισμού των διαδρομών της πλοήγησης:<br>- Η λειτουργία «Καλύτερη» πλοήγηση επιλέγει την πιο αποδοτική αναλογία μεταξύ μήκους και χρόνου της διαδρομής, προσπαθεί να αποφύγει σημοτοδοτούμενους κόμβους, κλπ.<br>- Η λειτουργία «Συντομότερη» επιλέγει πάντα την μικρότερη δυνατή διαδρομή.<br>- Η λειτουργία «Μικροί δρόμοι» αποφεύγει τους αυτοκινητοδρόμους όπου είναι δυνατό."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλάζει την δυσκολίας στάθμευσης:<br>- Το «Επιλογή πάντα» σου δίνει την δυνατότητα επιλογής κάθε φορά που φτάνεις στον προορισμό σου.<br>- Το «Ασφαλές παρκάρισμα» δεν απαιτεί όπισθεν.<br>- Με το «Παρκάρισμα για έμπειρους» συνήθως χρειάζεται πιο απαιτητικού χειρισμού οπισθοπορείας."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Ρύθμιση της πιθανότητας ύπαρξης κινδύνων επί της οδού γύρω σου, όπως ατυχήματα, ακινητοποιημένα οχήματα, θραύσματα στο οδόστρωμα, κλπ."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Ρυθμίζει την πιθανότητα αλλαγής της πλοήγησης λόγω παράκαμψης κατά την οδήγηση για δουλειά."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Ρυθμίζει την πιθανότητα αντίξοων καιρικών συνθηκών."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή εμφάνισης ή όχι πληροφοριών ζώνης ώρας επιπρόσθετα με την τρέχουσα ώρα."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Ενεργοποιεί τις κομμένες σκηνές του παιχνιδιού που συνήθως εμφανίζονται υστέρα από μεγάλες αγορές ή αναβαθμίσεις."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή εμφάνισης ή όχι των ημιδιάφανων εμποδίων στους δρόμους στους οποίους δεν υπάρχει πρόσβαση."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Αντιστροφή του κάθετου άξονα του ποντικιού κατά τον έλεγχο της κάμερας του παιχνιδιού."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Επιλογή του τύπου του κιβωτίου ταχυτήτων:<br>- Το «Απλό Αυτόματο» επιτρέπει την χρήση γκαζιού και φρένου για τον έλεγχο της κίνησης μπρος τα εμπρός και όπισθεν.<br>- Το «Αληθινό Αυτόματο» απαιτεί την αλλαγή μεταξύ ταχυτήτων έμπροσθεν και όπισθεν.<br>- Το «Σειριακό» απαιτεί την χειροκίνητη αλλαγή των ταχυτήτων με πλήκτρα ανεβάσματος/κατεβάσματος.<br>- Το «Κιβώτιο Ταχυτήτων Τύπου H» απαιτεί χρήση χειριστηρίου με λεβιέ ταχυτήτων για την χειροκίνητη αλλαγή τους."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Η ενεργοποίηση αυτής της ρύθμισης επιτρέπει την παράλειψη σχέσεων του κιβωτίου όταν κρίνεται απαραίτητο ή βολικό για την αποφυγή αλλαγής κάθε μιας ταχύτητας του κιβωτίου."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Brings the steering wheel back to the centre when a keyboard or controller is used.<br><br>Disabling this feature means you will have to manually steer back to centre after a turn."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Ρύθμιση του εύρους της απεικόνισης του τιμονιού. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της έντασης, πόσο απότομα είναι τα φρένα."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της σταθερότητας του φορτηγού χαμηλώνοντας το κέντρο βάρους του."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της σταθερότητας του τρέιλερ χαμηλώνοντας το κέντρο βάρους του."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της ένταση της ροπής που παράγεται από το σύστημα κίνησης.<br><br>Η αύξηση αυτής της ρύθμισης θα αυξήσει στην αίσθηση «στριψίματος» του φορτηγού προς τα δεξιά."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της σκληρότητας της ανάρτησης του σασί."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της σκληρότητας της ανάρτησης της καμπίνας."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ρυθμίζει την ένταση των ανωμαλιών του οδοστρώματος που υπάρχουν για να δίνουν στην άσφαλτο και τα άλλα υλικά ατελή αίσθηση.<br><br>Ανάλογα με τις άλλες ρυθμίσεις της ανάρτησης και της κάμερας, το παραγόμενο αποτέλεσμα θα είναι λιγότερο ή περισσότερο εμφανές."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιεί την προηγμένη σύνδεση τρέιλερ η οποία απαιτεί μεγαλύτερη ακρίβεια στην ευθυγράμμιση του πέταλου του φορτηγού με τον πίρο του τρέιλερ.<br><br>Όταν είναι απενεργοποιημένο, η σύνδεση με το τρέιλερ γίνεται πολύ πιο εύκολη καθώς δεν υπάρχουν συγκρούσεις μεταξύ του πέταλου και του πίρου."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλέγει εάν, και ποια, καλώδια τρέιλερ εμφανίζονται.<br><br><color value=@@clr_txt_d@@>Η ενεργοποίση τους σε περισσότερα οχήματα ίσως μειώσει την απόδοση σε παλαιότερα συστήματα."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Ενεργοποιεί τον ηλεκτρονικό περιοριστή ταχύτητας του φορτηγού στα 90 χλμ/ω (56 μαω).<br><br><color value=@@clr_txt_d@@>Οι δουλειές μέσω του World of Trucks έχουν αυτήν την λειτουργία μόνιμα ενεργοποιημένη."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο και οι υαλοκαθαριστήρες είναι στην πρώτη σκάλα, οι υαλοκαθαριστήρες θα ενεργοποιούνται αυτόματα και θα αλλάζει η ταχύτητά τους ανάλογα με τις συνθήκες."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιεί την αυτόματη εμπλοκή του επιβραδυντή κατά την πέδηση."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, το όχημα βοηθάει την εκκίνηση σε ανηφόρα κρατώντας το φρένο."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιεί την αυτόματη εμπλοκή του μηχανόφρενου κατά την πέδηση."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, ο κινητήρας παίρνει μπροστά με το που πατηθεί το γκάζι."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, το χειρόφρενο του φορτηγού εμπλέκεται αυτόματα (μετά από την χρήση πλοίου, την ρυμούλκηση σε συνεργείο, το γρήγορο ταξίδι, κλπ.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιείται αυτόματα η κάθοδος των αναρτώμενων αξόνων όταν απαιτείται, αναλόγως με το βάρος του οχήματος."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, το όχημα θα κρατάει πατημένο το μισό γκάζι. Μετά από διπλό πάτημα του κουμπιού του γκαζιού, το όχημα θα κρατήσει πατημένο πλήρως το γκάζι μέχρι να αφεθεί το κουμπί.<br><br>Αφορά μόνο την χρήση πληκτρολογίου."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Προσομοιώνει την πραγματική απώλεια αέρα από τις επαναλαμβανόμενες χρήσεις του φρένου.<br><br>Όταν είναι ενεργοποιημένο, θα πρέπει να διαχειρίζεσαι την πίεση του αέρα κατά την κάθοδο λόφων ή την πραγματοποίηση ελιγμών."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι απενεργοποιημένο, η κατανάλωση καυσίμου δεν επηρεάζεται από τον τρόπο οδήγησης ή την κατάσταση του οδοστρώματος.<br><br>Όταν είναι ενεργοποιημένο, η κατανάλωση καυσίμου επηρεάζεται από πλειάδα παραγόντων, όπως ο τρόπος οδήγησης, το βάρος του φορτίου, η αντίσταση κύλισης και το είδος του εδάφους. Δεν επηρεάζεται πλέον από την ικανότητα @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, το ABS θα αποτρέπει το μπλοκάρισμα των τροχών με αποτέλεσμα καλύτερο έλεγχο κατά την πέδηση."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, ρο φορτηγό θα εφαρμόζει πέδηση ανά τροχό για την αποφυγή σπινιαρίσματος, υποστροφής ή υπερσοτρφής και την διατήρηση του ελέγχου."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, το διαφορικό του φορτηγού θα κλειδώνει αν οι τροχοί αρχίσουν να σπινιάρουν για καλύτερη πρόσφυση."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes the increment of speed at which cruise control will increase or decrease when the appropriate button is pressed."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλάζει την ανοχή του αυτόματου πιλότου για την διατήρηση της ταχύτητας."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένος, ο αυτόματος πιλότος θα ρυθμίζει αυτόματα την ταχύτητα ώστε να υπάρχει ασφαλής απόσταση με το προπορευόμενο όχημα."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιεί την πέδηση εκτάκτου ανάγκης εάν το σύστημα αντιληφθεί κίνδυνο σύγκρουσης.<br>Επιλέξτε αν το σύστημα θα αντιδρά μόνο σε οχήματα ή σε όλα τα εμπόδια."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Επιλογή των λειτουργιών υποβοήθησης λωρίδας:<br>- Η λειτουργία «Προειδοποίηση απόκλισης από την λωρίδα» ειδοποιεί ηχητικά όταν πρόκειται να βγεις από την λωρίδα.<br>- Επιπρόσθετα, η λειτουργία «Υποστήριξη διατήρησης λωρίδας» στρίβει αυτόματα το φορτηγό για να το αποτρέψει να βγει από την λωρίδα.<br><br>Και οι δύο λειτουργίες ισχύουν για ταχύτητες άνω των 55 χλμ/ω (~35 μαω).<br>Η Υποβοήθηση Διατήρησης Λωρίδας λαμβάνει υπόψη την χρήση των δεικτών αλλαγής πορείας."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιεί τις λειτουργίες του Αισθητήρα νεκρού σημείου, εφόσον το φορτηγό σου έχει αυτόν τον εξοπλισμό."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο και τα φώτα είναι στην θέση φώτων στάθμευσης, τα φώτα διασταύρωσης θα ενεργοποιούνται αυτόματα σε καταστάσεις χαμηλού φωτισμού."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο και τα φώτα είναι στην θέση φώτων πορείας, το όχημα αυτόματα θα χαμηλώνει την σκάλα στα φώτα διασταύρωσης όταν εντοπίζει όχημα στην αντίθετη κατεύθυνση ή όχημα πολύ κοντά μπροστά."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, τα φλας θα επαναφέρονται αυτόματα μετά από στροφή όταν το τιμόνι επιστρέφει στο κέντρο."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, κάποια αξεσουάρ του εσωτερικού ανταποκρίνονται στην κίνηση του οχήματος (κρεμαστά, κουνιστά, κλπ)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ενεργοποιεί την περιστροφή στον κατακόρυφο άξονα της εσωτερικής κάμερας ανάλογα με το στρίψιμο."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλάζει την ευαισθησία της λειτουργίας «Περιστροφή κάμερας με στρίψιμο» σε σχέση με το στρίψιμο."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλάζει την συμπεριφορά της «Περιστροφή κάμερας με στρίψιμο» κατά την όπισθεν."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, η εσωτερική κάμερα κοιτάει προς τα αριστερά ή δεξιά βάσει της χρήσης δείκτη αλλαγής πορείας."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Όταν είναι ενεργοποιημένο, η κάμερα του εσωτερικού αντιδρά στις κινήσεις του οχήματος."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλαγή της ευαισθησίας της κάμερας του εσωτερικού στην κίνηση του οχήματος."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Αλλάζει πόσο περιστρέφεται η κάμερα του εσωτερικού ανάλογα με τις κινήσεις του οχήματος."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Ορίζει την καθυστέρηση για το αυτόματο κεντράρισμα της κάμερας.<br><br>Το όχημα θα πρέπει να κινείται με μη αμελητέα ταχύτητα για να ενεργοποιηθεί. Εφαρμόζεται μόνο στην κάμερα εσωτερικού ή καταδίωξης ότι κινείσαι προς τα μπροστά και την κάμερα παραθύρου κατά την όπισθεν."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Ορίζει την ταχύτητα κίνησης της κάμερας. Χρησιμοποιείται για το αυτόματο κεντράρισμα και των προεπιλογών της εσωτερικής κάμερας."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Καθορίζει πως λειτουγεί η μεγέθυνση στην κάμερα του εσωτερικού: κρατώντας πατημένο το κουμπί για προσωρινή μεγέθυνση ή πάτημα μία φορά για αλλαγή μεταξύ μεγέθυνσης ή όχι." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή της γλώσσας στην οποία θα εμφανίζεται όλο το παιχνίδι."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Αλλάζει τις επιλογές νομίσματος και μονάδων ανάλογα με την επιλογή περιοχής."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, τα ονόματα των πόλεων και των χωρών θα εμφανίζονται στην επιλεγμένη γλώσσα."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, τα ονόματα των πόλεων και των χωρών θα εμφανίζονται στον χάρτη στην επιλεγμένη γλώσσα αλλά ταυτόχρονα και στην γλώσσα της περιοχής."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογής νομίσματος."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μεταξύ εμφάνισης 12-ωρου ή 24-ωρου."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μονάδων αποστάσεων."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μονάδων μάζας."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μονάδων θερμοκρασίας."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μονάδων πίεσης."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μονάδων όγκου."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Επιλογή μονάδων κατανάλωσης."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, το πλήκτρο «Ενεργοποίησης» (@@imv_nrm_activate@@) θα ανοίγει την συνομιλία κατά τις συνεδρίες Κονβόι."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, η γραμμής εισαγωγής της συνομιλίας θα παραμένει ενεργή μετά την αποστολή μηνύματος."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, τα μηνύματα στην συνομιλία θα σβήνουν δευτερόλεπτα μετά από κάθε μήνυμα."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Αλλαγή της χρονικής διάρκειας της εμφάνισης των μηνυμάτων στην συνομιλία πρις σβήνουν."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Όταν είναι ενεργοποιημένο, τα ονόματα των παικτών θα εμφανίζονται πάνω από τα οχήματά τους στις συνεδρίες Κονβόι."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Ανοίγει επιμέρους μενού για την διαμόρφωση των γρήγορων απαντήσεων που χρησιμοποιούνται στις συνεδρίες Κονβόι."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Έλεγξε την κατάσταση του περιεχομένου συνδεδεμένου με το προφίλ σου στο World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Ενεργοποιεί την δυνατότητα λήψης διαδικτυακών ειδήσεων που θα εμφανίζονται στην Οθόνη Έναρξης."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Ενεργοποιεί την λήψη στιγμιοτύπων από την κοινότητα μέσω της ιστοσελίδας του World of Trucks τα οποίαν εμφανίζονται στις οθόνες φόρτωσης."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Ενεργοποιεί την λήψη πραγματικών διαφημίσεων που εμφανίζονται σε επιλεγμένες διαφημιστικές πινακίδες εντός του παιχνιδιού."
