
    key[]: "hint_engine_title"
	val[]: "Βάλε μπροστά τον κινητήρα"

    key[]: "hint_engine_text"
	val[]: "Πίεσε το $KEY_engine$ για να βάλεις μπροστά τον κινητήρα."


    key[]: "hint_ignition_title"
	val[]: "Ενεργοποίησε το σύστημα ηλεκτρικών"

    key[]: "hint_ignition_text"
	val[]: "Πάτησε το $KEY_engineelect|KEY_engine$ για να ενεργοποιήσεις την ανάφλεξη."


    key[]: "hint_driv_arc_title"
	val[]: "Οδήγηση"

    key[]: "hint_driv_arc_text"
	val[]: "Χρησιμοποίησε το $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ και το $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ για να μετακινηθείς προς τα μπροστά ή πίσω.<br><offset vshift=8>Χρησιμοποίησε το $SPECIAL_steering$για να στρίψεις."


    key[]: "hint_driv_auto_title"
	val[]: "Οδήγηση"

    key[]: "hint_driv_auto_text"
	val[]: "Χρησιμοποίησε το $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ και το $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ για να μετακινηθείς προς τα μπροστά ή πίσω.<br><offset vshift=8>Χρησιμοποίησε το $SPECIAL_steering$ για να στρίψεις.<br><offset vshift=8>Πάτησε το $KEY_gearup$ και το $KEY_geardown$ για την επιλογή σχέσεων του κιβωτίου ταχυτήτων."


    key[]: "hint_driv_seq_title"
	val[]: "Οδήγηση"

    key[]: "hint_driv_seq_text"
	val[]: "Χρησιμοποίησε το $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ και το $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ για να μετακινηθείς προς τα μπροστά ή πίσω.<br><offset vshift=8>Χρησιμοποίησε το $SPECIAL_steering$ για να στρίψεις.<br><offset vshift=8>Πάτησε το $KEY_gearup$ και το $KEY_geardown$ για τον έλεγχο του συμπλέκτη."


    key[]: "hint_driv_hshift_title"
	val[]: "Οδήγηση"

    key[]: "hint_driv_hshift_text"
	val[]: "Χρησιμοποίησε το $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ και το$KEY_abackward+ALIAS_j_brake+KEY_dbackward$ για να μετακινηθείς προς τα μπροστά ή πίσω.<br><offset vshift=8>Χρησιμοποίησε το $SPECIAL_steering$ για να στρίψεις.<br><offset vshift=8>Άλλαξε ταχύτητες με τον <color value=@@clr_sel@@>επιλογέα<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Προχώρησε προς τον προορισμό"

    key[]: "hint_depot_deliv_text"
    val[]: "Σταμάτα στην επισημασμένη περιοχή και επίλεξη την δυσκολία της τελικής θέσης στάθμευσης και κέρδισε τους αντίστοιχους πόντους εμπειρίας."


    key[]: "hint_fin_deliv_title"
    val[]: "Ολοκλήρωσε την παράδοση"

    key[]: "hint_fin_deliv_text"
    val[]: "Στάμθευσε στην επιλεγμένη θέση. Μπορείς να πατήσεις το $KEY_activate$ για παράλειψη όταν είσαι κοντά στο σημείο παράδοσης."


    key[]: "hint_fin_deliv2_title"
    val[]: "Ολοκλήρωσε την παράδοση"

    key[]: "hint_fin_deliv2_text"
    val[]: "Στάμθευσε στην επιλεγμένη θέση. Μπορείς να ενεργοποιήσεις ένα γραφικό στοιχείο στο @@desktop_menu_category_options@@ για την δυνατότητα παράλειψης της στάθμευσης."


    key[]: "hint_lights_title"
    val[]: "Άναψε τα φώτα"

    key[]: "hint_lights_text"
    val[]: "Χρησιμοποίησε το $KEY_light$ για να ανάψεις τα φώτα. Άλλαξε μεταξύ των διαφορετικών λειτουργιών ξαναπατώντας το."


    key[]: "hint_high_beam_title"
    val[]: "Ενεργοποίησε τα φώτα πορείας"

    key[]: "hint_high_beam_text"
    val[]: "Πάτησε το $KEY_hblight$ για να ανάψεις τα φώτα πορείας."


    key[]: "hint_wipers_title"
    val[]: "Ενεργοποίησε τους υαλοκαθαριστήρες"

    key[]: "hint_wipers_text"
    val[]: "Χρησιμοποίησε το $KEY_wipers$ για να ενεργοποιήσεις τους υαλοκαθαριστήρες και να αλλάξεις την ταχύτητά τους."


    key[]: "hint_zoom_title"
    val[]: "Κοιτώντας πιο κοντά"

    key[]: "hint_zoom_text"
    val[]: "Χρησιμοποίησε το $KEY_camzoom$ για να κάνεις ζουμ ενώ είσαι στο εσωτερικού του οχήματος. Μπορείς να ρυθμίσεις την λειτουργία στις @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Κοίταγμα τριγύρω"

    key[]: "hint_cam_int_text"
    val[]: "Χρησιμοποίησε το $KEY_cam1$ για να αλλάξεις την κάμερα σε αυτήν του εσωτερικού."


    key[]: "hint_cam_ext_title"
    val[]: "Κοίταγμα τριγύρω"

    key[]: "hint_cam_ext_text"
    val[]: "Μπορείς να αλλάξεις μεταξύ των διαφορετικών καμερών πατώντας το $KEY_camcycle$.<br><offset vshift=8>Χρησιμοποίησε το $KEY_cam2$ για την αλλαγή στην εξωτερική κάμερα."


    key[]: "hint_indicators_title"
    val[]: "Φλας"

    key[]: "hint_indicators_text"
    val[]: "Χρησιμοποίησε τα $KEY_lblinker$ και $KEY_rblinker$ για να ανάψεις τα φλας."


    key[]: "hint_tow_title"
    val[]: "Ρυμούλκηση"

    key[]: "hint_tow_text"
    val[]: "Αν δεν μπορείς να ξεκολλήσεις από μια δύσκολη κατάσταση, μπορείς να χρησιμοποιήσειςν την ρυμούλκηση από την οδική βοήθεια. Άνοιξε το @@quick_info_word@@ χρησιμοποιώντας το $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Κλείδωμα διαφορικού"

    key[]: "hint_diff_lock_text"
    val[]: "Αν δεν μπορείς να ξεξινήσεις, μπορεί το κλείδωμα του διαφορικού να σε βοηθήσει. Χρησιμοποίησε το $KEY_diflock$ ή ενεργοποίησε το αυτόματο κλείδωμα διαφορικού στις @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Το διαφορικό έχει κλειδώσει"

    key[]: "hint_diff_unlock_text"
    val[]: "Θα πρέπει να ξεκλειδώσεις το διαφορικό κατά την διάρκεια της κανονικής οδήγησης, διαφορετικά θα προκληθεί ζημιά. Χρησιμοποίησε το $KEY_diflock$ για το ξεκλειδώσεις ή μπορείς να ενεργοποιήσεις την αυτόματη λειτουργία στις @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Απενεργοποίησε τους υαλοκαθαριστήρες"

    key[]: "hint_wipers_off_text"
    val[]: "Χρησιμοποίησε το $KEY_wipers$ για να απενεργοποιήσεις τους υαλοκαθαριστήρες και να αλλάξεις την ταχύτητά τους."


    key[]: "hint_world_map_title"
    val[]: "Προβολή χάρτη"

    key[]: "hint_world_map_text"
    val[]: "Χρησιμοποίησε το $KEY_navmap$ για να ανοίξεις τον χάρτη."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Χρησιμοποίησε το $KEY_advmouse$ για να ανοίξεις τις @@quick_info_word@@ - μια σύνοψη της κατάστασής σου και χρήσιμων συντομεύσεων."


    key[]: "hint_pause_border_title"
    val[]: "Τοπικοί κανονισμοί"

    key[]: "hint_pause_border_text"
    val[]: "Χρησιμοποίησε το $KEY_advmouse$ για να ανοίξεις τις @@quick_info_word@@ και να δεις τους ισχύοντες κανονισμούς για την περιοχή που βρίσκεσαι."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Άνοιξε το @@quick_info_word@@ χρησιμοποιώντας το $KEY_advmouse$ για να ανοίξεις την @@photo_mode_word@@ και να απαθανατίσεις το @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>"


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ κοντά σου"

    key[]: "hint_viewpoint_text"
    val[]: "Ένα @@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> είναι κοντά σου - βρες το και ενεργοποίησέ το για να δεις τα πλάνα."


    key[]: "hint_resting_title"
    val[]: "Χώρος ανάπαυσης κοντά"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Πρατήριο καυσίμων κοντά"

    key[]: "hint_gas_text"
    val[]: "Τα πρατήρια καυσίμων <img src=/material/ui/map/gas_ico.mat width=20 height=20> χρησιμοποιούνται για τον ανεφοδιασμό του οχήματός σου."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Μπορείς να ενεργοποιήσεις τον έξυπνος έλεγχο γκαζιού στις @@desktop_menu_category_options@@. Ενεργοποιώντας τον, το όχημα θα κρατάει το γκάζι πατημένο λίγο. Με το διπλό πάτημα του κουμπιού του γκαζιού, το γκάζι παραμένει πατημένο τέρμα μέχρι να αφήσεις το κουμπί."
