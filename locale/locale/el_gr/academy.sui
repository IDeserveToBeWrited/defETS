#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Συνδυασμένοι Οδηγικοί Ελιγμοί"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "In this scenario, we'll combine your newly learned skills to negotiate a short but technical course that will involve reversing into a turn and managing a tight 90 degree corner."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Οπισθοπορείας προς την Πλευρά του Οδηγού"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Στροφή 90 Μοιρών"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Ολοκλήρωση της στροφής"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Μπροστά σου υπάρχει ένα εμπόδιο. Οδήγησε μέχρι εκεί και σταμάτησε."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Πίσω από το φορτηγό από την πλευρά του οδηγού, υπάρχει ακόμη ένα εμπόδιο. Κάνε όπισθεν με στροφή για να το φτάσεις. Οι διαγραμμίσεις στο οδόστρωμα θα σε βοηθήσουν."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Directly ahead, there is a sharp 90 degree turn. Drive towards it."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Θα προχωρήσουμε βαθύερα στην στροφή έτσι ώστε οι πίσω τροχοί να περάσουν τον κώνο στο εσωτερικό της στροφής.<br>Χρησιμοποίησε τους καθρέπτες σου!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Ίσιωσε, προχώρησε προς τα τελευταία εμπόδια, σταμάτησε και ασφάλισε το φορτηγό."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Ετοιμάσου να ξεκινήσεις. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Το φορτηγό δεν είναι ακόμη έτοιμο να κινηθεί, μήπως ξέχασες κάτι;<br><br>Έχεις βάλει μπρος; Έχεις λύσει το χειρόφρενο;"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Ακριβώς μπροστά σου είναι ένα επισημασμένο σημείο πριν το εμπόδιο.<br><br><font face=/font/big_bold.font>Οδήγησε προς τα εμπρός και σταμάτρησε στο σημείο αυτό. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Δες πίσω σου από την πλευρά του οδηγού. Θα δεις άλλο ένα επισημασμένο σημείο. Θα πρέπει να συνδυάσεις ταυτόχρονα όπισθεν και στρίψιμο.<br><br><font face=/font/big_bold.font>Κάνε όπισθεν και σταμάτησε στο σημείο. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Η διαδρομή συνεχίζεις μπροστά σου μέσα από μια στροφή 90 μοιρών.<br><br>Μείνε στην πλευρά του οδηγού πριν από την στροφή, μπες αρκετά μέσα στην στροφή και στρίψε απότομα και γρήγορα. Προσπάθησε να μην χτυπήσεις τον κώνο στην εσωτερική. <br><br><font face=/font/big_bold.font> Οδήγησε προς τα εμπρός και στρίψε. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Χρησιμοποίησε τον μπροστινό και πλαϊνό καθρέπτη ώστε να μην χτυπήσεις κάτι.<br><br><font face=/font/big_bold.font>Ολοκλήρωσε την στροφή και σταμάτησε το επισημασμένο σημείο. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Σβήσε τον κινητήρα και ασφάλισε το φορτηγό.</font>"
#@}

