 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "In this scenario, we'll take the truck for a short drive. You'll be able to get a feel for braking with a trailer as we descend the hill ahead. Prepare the truck and set off."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Reach a speed of at least 60 km/h (37 mph). Be ready for the braking zone ahead."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Begin braking to a stop. Make sure you don't wait too long, or you could hit the barriers in front of you!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Park in the designated area, then secure the truck and shut down the engine."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "During this drive, you'll get a feel for using the service brakes while descending a downhill grade. The purpose of this drill is to become aware of the weight behind you and how it affects the braking distance of the vehicle.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Start driving now, and keep in mind you will need to reach a speed of 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Drive through the turn. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Continue to accelerate down the hill. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Reach a speed of at least 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "You've reached the required speed.<br><br><font face=/font/big_bold.font>Stop at the barriers ahead. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

