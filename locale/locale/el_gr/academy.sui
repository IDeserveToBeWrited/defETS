#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Χειριστήρια Κάμερας"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Σε αυτό το σενάριο, θα μάθουμε για τους διάφορους τύπους καμερών που είναι διαθέσιμες και πως μπορούν να σε βοηθήσουν στους χειρισμούς και ελιγμούς του φορτηγού."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Θέση Καθίσματος"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Άποψη προς τα Πίσω"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Έλεγχος Καθρεπτών"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Αλλαγή στην Εξωτερική Κάμερα"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Κοιτώντας Γύρω από το Φορτηγό"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Σε αυτό το σενάριο, θα δούμε τις διαφορετικές κάμερες<br>που είναι διαθέσιμες."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Υπάρχουν συνολικά επτά κάμερες για να διαλέξεις, θα δούμε<br> μερικές από αυτές και θα εξηγήσουμε τις χρήσεις τους."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Οι διάφορες κάμερες και οι διαφορετικές τους γωνίες μπορούν να σε βοηθήσουν με τους ελιγμούς σε δύσκολα σημεία."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Το να κοιτάς που πρέπει να πας είναι ο κύριος πυλώνας της ασφαλούς επαγγελματικής οδήγησης. Αν η τρέχουσα θέση οδήγησης δεν σε βολεύει μπορείς να την αλλάξεις στο «@@adjust_link_t@@» (Διαθέσιμο από το μενού παύσης)<br><br><font face=/font/big_bold.font>Επιβεβαίβωσε ότι είσαι έτοιμος με το @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Όταν κάνεις όπισεν, οι καθρέπτες δεν παρέχουν πάντα καθαρή εικόνα. Μπορεί να είναι απαραίτητο να δεις έξω από το παράθυρο προς τα πίσω.<br><br><font face=/font/big_bold.font>Γύρισε την κάμερά σου τέρμα προς την πλευρά του οδηγού για να δεις έξω από το παράθυρο προς το τρέιλέρ σου. </font>@@aca_goal_tip@@ Πρέπει να είσαι μέσα στο όχημα."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Χρησιμοποίησε αυτήν την οπτική γωνία για να βλέπεις το τρέιλερ όταν κάνεις όπισθεν με τρέιλερ. Είναι πάντα καλύτερο να κάνεις όπισθεν προς την πλευρά του οδηγού ώστε να μπορείς να αξιοποιείς και αυτήν την οπτική γωνία. Όταν κάνεις όπισθεν προς την πλευρά του συνοδηγού έχεις πολύ πιο περιορισμένη οπτική του τι γίνεται πίσω σου.<br><br><font face=/font/big_bold.font>Δες προς την πλευρά του συνοδηγού. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Για αυτό τις περισσότερες φορές δεν συνιστούμε την όπισθεν προς την πλευρά του συνοδηγού. Φαίνεται πως η ορατότητα είναι αρκετά περιορισμένη. Ευτυχώς, υπάρχουν διαθέσιμες επτά εξωτερικές κάμερες. <br><br> Το κουμπί @@imv_nrm_camcycle@@ αλλάζει στην επόμενη κάμερα. Αφού γίνει ο κύκλος και των επτά καμερών θα επιστρέψεις στην αρχή. <br><br><font face=/font/big_bold.font>Πάτησε @@imv_nrm_camcycle@@ για να αλλάξεις στην επόμενη κάμερα. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Η εξωτερική κάμερα παρέχει την καλύτερη οπτική του τι γίνεται γύρω από το φορτηγό σου.<br><br><font face=/font/big_bold.font> Κοίταξε γύρω από το φορτηγό.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Πατώντας το @@imv_nrm_camcycle@@ ξανά, μπορείς να αλλάξεις στην επόμενη κάμερα. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Η κάμερα από πάνω προς τα κάτω παρέχει εξαιρετική εικόνα την κατάστασης γύρω από το φορτηγό, απλοποιώντας σημαντικά την στάθμευση και την οδήγηση σε στενούς χώρους.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_camcycle@@ για αλλαγή στην επόμενη κάμερα. </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Η κάμερα οροφής παρέχει καθαρή εικόνα του δρόμου μπροστά, μακριά από το φορτηγό χωρίς εμπόδιο.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_camcycle@@ για αλλαγή στην τελευταία κάμερα που θα δούμε προς στιγμήν. </font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Η κάμερα προς τα πίσω είναι συντόμευση προς την οπτική που είχες προηγουμένως γυρνώντας την κάμερα του εσωτερικού. Όπως συζητήσαμε, είναι βοηθητική κατά την όπισθεν ή την στάθμευση.<br><br>Στο παιχνίδι, έχουμε περισσότερες κάμερες που μπορείς να δοκιμάσεις πατώντας επαναλαμβανόμενα το @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_cam1@@ για να επιστρέψεις στο εσωτερικό</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Πρώτη Οδήγηση"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Σε αυτό το σενάριο, θα μάθουμε πως να προετοιμάζουμε το φορτηγό πριν την οδήγηση, και μετά να το οδηγήσεις προς τα μπροστά για πρώτη φορά."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Ενεργοποίηση των Ηλεκτρικών"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Εκκίνηση του Κινητήρα"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Έλεγχος Περιβάλλοντος"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Εμπλοκή Πέδης"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Αλλαγή σε Ταχύτητα"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Απεμπλοκή του Χειρόφρενου"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Οδήγηση Μπροστά"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Πέδηση"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Εμπλοκή του Χειρόφρενου"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Αλλαγή σε Νεκρά"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Απενεργοποίηση του Κινητήρα"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Για την πρώτες φορές που θα οδηγήσεις θα χρησιμοποιούμε μόνο τον τράκτορα.<br>Τράκτορας είναι το φορτηγό το οποίο δεν μεταφέρονται φορτία στο ίδιο, αλλά συνδέεται με τρέιλερ για την μεταφορά αγαθών και υλικών."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Οι τράκτορες είναι αρκετά συνηθισμένοι γιατί προσφέρουν καλύτερη ευελιξία: μπορούν να αφήσουν ένα άδειο τρέιλερ και να πάρουν ένα φορτωμένο χωρίς να χρειάζεται αναμονή ή και να αλλάξουν εντελώς τύπο τρέιλερ."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Για την πρώτη σου φορά που θα οδηγήσεις, ο σκοπός σου θα είναι να οδηγήσεις προς τα μπροστά και να σταματήσεις μετά την διακεκομμένη γραμμή.<br>Ξεκίνησε τον κινητήρα, ακολούθησε τις οδηγίες για να ετοιμάσεις το φορτηγό. Αφού προετοιμαστείς, οδήγηση ευθεία μπροστά."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Πέρνα την διακεκομμένη γραμμή, σταμάτησε, σβήσε τον κινητήρα και ασφάλισε το φορτηγό."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Για το επόμενο βήμα της εκπαίδευσής σου, θα μετακινήσεις το φορτηγό για πρώτη φορά.<br><br>Φυσικά, χωρίς να έχει πάρει μπροστά ο κινητήρας κάτι τέτοιο δεν γίνεται, οπότε πρώτα θα πρέπει να ενεργοποιήσεις την ανάφλεξη.<br><br><font face=/font/big_bold.font>Πάτησε $input engineelect$ για να ενεργοποιήσεις την ανάφλεξη.</font>@@aca_goal_tip@@ Στην Καριέρα, ως προεπιλεγμένη ρύθμιση, ο κινητήρας ενεργοποιείται αυτόματα μαζί με την ανάφλεξη. Για την καριέρα μπορείς να ρυθμίσεις αυτήν την συμπεριφορά στις Ρυθμίσεις - «Παιχνίδι» - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Η ανάφλεξη ενεργοποιεί το ηλεκτρικό σύστημα του φορτηγού. Μπορεί να είδες κάποιες ενδεικτικές λυχνίες να ανάβουν στιγμιαία στο ταμπλό - είναι το κανονικό. Αν παραμείνουν αναμμένες αφού εκκινήσεις τον κινητήρα, τότε σημαίνει ότι υπάρχει κάποιο πρόβλημα το φορτηγό. Η εξαίρεση είναι η λυχνία για το χειρόφρενο, η οποία θα σβήσει όταν λύσουμε το χειρόφρενο.<br><br>Αυτό το φορτηγό είναι σε καλή κατάσταση και είμαι έτοιμοι να συνεχίσουμε.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_engine@@ για την εκκίνηση του κινητήρα. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Τώρα που βάλαμε μπρος, είναι απολύτως απαραίτητο να ελέγξεις γύρω σου πριν από οποιαδήποτε κίνηση.<br><br><font face=/font/big_bold.font>Δες γύρω από το φορτηγό και τους καθρέπτες σου για να επιβεβαιώσεις ότι η γύρω περιοχή είναι ελεύθερη.</font>@@aca_goal_tip@@ Πρέπει να είσαι εντός του οχήματος."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Μπορεί να μοιάζει προφανές, αλλά θα πρέπει να γνωρίζεις να σταματάς πριν από οποιαδήποτε κίνηση.<br><br><font face=/font/big_bold.font>Ενεργοποίησε το φρένο πέδησης χρησιμοποιώντας το $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Στην συνέχεια, θα μάθουμε πως να αλλάζουν την κατεύθυνση κίνησης.<br><br>Με την λειτουργία απλού αυτόματου, δεν υπάρχει ανάγκη να αλλάζεις ταχύτητες, όλα γίνονται αυτόματα.<font face=/font/big_bold.font><br><br>Χρησιμοποίησε το $input forward$ για να ενεργοποιήσεις την ταχύτητα προς τα μπροστά. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Στην συνέχεια, θα μάθουμε πως να αλλάζουν την κατεύθυνση κίνησης.<br><br>Με το ρεαλιστικό αυτόματο μπορείς να αλλάζεις μεταξύ νεκράς, όπισθεν και κίνησης προς τα εμπρός, όπως στα πραγματικά αυτόματα κιβώτια ταχυτήτων.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_gearup@@ για να ενεργοποιήσεις την ταχύτητα προς τα εμπρός. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Στην συνέχεια, θα μάθουμε πως να αλλάζουν την κατεύθυνση κίνησης.<br><br>Το σειριακό αυτόματο σου δίνει την δυνατότητα να αλλάζεις μία-μία τις ταχύτητες, όπως στα πραγματικά σειριακά κιβώτια ταχυτήτων.<br><br>Με τον ίδιο τρόπο που επιλέγεις την κίνηση προς τα εμπρός, όταν επιταχύνεις θα πρέπει να ανεβάζεις ταχύτητες.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_gearup@@ για να επιλέξεις την πρώτη.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Στην συνέχεια, θα μάθουμε πως να αλλάζουν την κατεύθυνση κίνησης.<br><br>Χρησιμοποιώντας λεβιέ ταχυτήτων και συμπλέκτη, θα έχεις την ίδια εμπειρία χειροκίνητης αλλαγής ταχυτήων όπως σε πραγματικό χειροκίνητο κιβώτιο ταχυτήτων.<br><br>Πάτησε πλήρως τον συμπλέκτη και το φρένο. <font face=/font/big_bold.font>Χρησιμοποίησε τον λεβιέ και επίλεξε την πρώτη. <color value=@@clr_txt@@>Κράτα τον συμπλέκτη και το φρένο πατημένα.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Για να ξεκινήσεις, πρέπει να λύσεις το χειρόφρενο.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το @@imv_nrm_parkingbrake@@ για να λύσεις το χειρόφρενο.</font> @@aca_goal_tip@@ Στην Καρίερα, το χειρόφρενο είναι αρχικά απενεργοποιημένο. Μπορείς να ρυθμίσεις αυτήν την συμπεριφορά στις Ρυθμίσεις - «Παιχνίδι» - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Τώρα το φορτηγό είναι έτοιμο για να ξεκινήσουμε. Ξεκίνα και πέρασε την διακεκομμένη γραμμή.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το γκάζι: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Τώρα το φορτηγό είναι έτοιμο για να ξεκινήσουμε. Ξεκίνα και πέρασε την διακεκομμένη γραμμή.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το γκάζι: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Τώρα το φορτηγό είναι έτοιμο για να ξεκινήσουμε. Ξεκίνα και πέρασε την διακεκομμένη γραμμή.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το γκάζι: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Τώρα το φορτηγό είναι έτοιμο για να ξεκινήσουμε. Ξεκίνα και πέρασε την διακεκομμένη γραμμή.<br><br><font face=/font/big_bold.font>Άφησε το φρένο, άφησε σταδιακά τον συμπλέκτη για να γίνει η εμπλοκή του κινητήρα ενώ ταυτόχρονα πάτα το γκάζι ώστε να μην πέσουν οι σ.α.λ. και σβήσει το φορτηγό. Εφόσον έχεις αφήσει τον συμπλέκτη επιταχύνεις και αλλάζεις ταχύτητα όποτε κρίνεται απαραίτητο. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Χρησιμοποίησε το φρένο για να σταματήσεις.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το $input backward$ για να σταματήσεις το φορτηγό. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Χρησιμοποίησε το φρένο για να σταματήσεις.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το $input backward$ για να σταματήσεις το φορτηγό. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Χρησιμοποίησε το φρένο για να σταματήσεις.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το $input backward$ για να σταματήσεις το φορτηγό. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Όταν έρθει η στιγμή να σταματήσεις, πάτησε πλήρως τον συμπλέκτη <font face=/font/big_bold.font>και σταμάτησε το φορτηγό χρησιμοποιώντας το φρένο.<color value=@@clr_txt@@> Βάλε νεκρά με τον λεβιέ, και έπειτα άσε τον συμπλέκτη. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Τώρα ασφάλισε το φορτηγό. Το χειρόφρενο εξασφαλίζει ότι το φορτηγό δεν θα μετακινηθεί ακούσια αφού σταθμεύσεις.<br><br><font face=/font/big_bold.font>Χρησιμοποίησε το @@imv_nrm_parkingbrake@@ για να εμπλέξεις το χειρόφρενο.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Με το απλό αυτόματο κιβώτιο ταχυτήτων δεν αλλάζεις ταχύτητες, όλα γίνονται αυτόματα.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_activate@@ για επιβεβαίωση. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Shift into neutral by pressing @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Shift into neutral by pressing @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Βάλε νεκρά με τον λεβιέ και στην συνέχεια άσε τον συμπλέκτη. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Τώρα ξέρεις πως να ξεκινήσεις το φορτηγό και πως να το σταματάς με ασφάλεια.<br><br><font face=/font/big_bold.font>Πάτησε το $input engineelect$ για να σβήσεις τον κινητήρα. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Όπισθεν"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Σε αυτό το σενάρι θα προσπαθήσουμε την όπισθεν για πρώτη φορά. Επίσης θα μιλήσουμε για την βέλτιση χρήση των καθρεπτών για να βλέπεις γύρω σου, τι να προσέξεις και πως θα προετοιμαστείς για την όπισθεν κίνηση."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Εκκίνηση του Κινητήρα"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Έλεγχος Καθρέπτη Συνοδηγού"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Έλεγχος Καθρέπτη Οδηγού"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Αλλαγή σε Ταχύτητα"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Απεμπλοκή του Χειρόφρενου"

