#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Πριν Οδηγήσεις"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Για το πρώτο σενάριο, θα δούμε τα βασικά στην καμπίνα του οδηγού. Είναι σημαντικό να ρυθμίσεις σωστά το κάθισμα, το τιμόνι και τους καθρέπτες, καθώς η σωστή ορατότητα είναι σημαντική για την διαχείρηση δύσκολων και επισφαλών καταστάσεων.<br><br>Θα δούμε όλους τους χειρισμούς ρυθμίζοντας αυτά τα στοιχεία ένα ένα."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Ρύθμιση Θέσης και Καθρεπτών"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Έλεγχος Καθρεπτών και Ορατότητας"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Καλώς όρισες στο πρώτο μάθημα!<br>Ας ξεκινήσουμε μαθαίνοντας πως να προετοιμάσεις το φορτηγό πριν βγεις στον δρόμο."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Είναι καίριας σημασίας να διασφαλίσεις ότι η οδηγησή σου είναι πάντα ασφαλής, επαγγελματική και υπό έλεγχο.<br>Η λανθεσμένη ρύθμιση του καθίσματος, του τιμονιού και των καθρεπτών θα σε βοηθήσουν να τα καταφέρεις."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Σε κάθε πλευτά του φορτηγού υπάρχουν κάποια οχήματα.<br>Θα σε βοηθήσουν να ρυθμίσεις τους καθρέπτες σωστά."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Μην βιαστείς και ρύθμισε τα πάντα βάσει της αρεσκείας σου, καθώς αυτές οι ρυθμίσεις<br>θα έχουν σημαντική επίδραση στην δυνατότητά σου να ελέγχεις το φορτηγό."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Ρύθμιση Καθίσματος και Τιμονιού"

	key[]: "adj_tut_title_1"
	val[]: "Ρύθμιση Κύριων Καθρεπτών"

	key[]: "adj_tut_title_2"
	val[]: "Ρύθμιση Κυρτών Καθρεπτών"

	key[]: "adj_tut_title_3"
	val[]: "Έλεγχος Ορατότητας και Τελικος Έλεγχος Καθρεπτών"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "πάτησε @@imv_nrm_adjuster@@ ή βρες το στις ρυθμίσεις οχήματος από το μενού παύσης"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "βρες το στις ρυθμίσεις οχήματος από το μενού παύσης"

	key[]: "adj_tut_open_adj"
	val[]: "Για την προβολή του «@@adjust_link_t@@» κατά το παιχνίδι, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Αρχικά ας ρυθμίσουμε το κάθισμα του οδηγού και το τιμόνι.<br><br><font face=/font/big_bold.font>Άνοιξε το «@@adj_seats@@» για να συνεχίσεις.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Άνοιξε το @@adj_mirrors@@ για να ρυθμίσεις τους καθρέπτες.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Όταν μπαίνεις στο φορτηγό πρώτη φορά, είναι σημαντικό να ρυθμίσεις πρώτα το κάθισμα, το τιμόνι και τους καθρέπτες βάσει της αρεσκείας σου.<br><br>Η σωστή θέση πίσω από το τιμόνι είναι κρίσιμη για την σωστή ορατότητα. Όλα τα χειριστήρια πρέπει να είναι εύκολα προσβάσιμα και ο οδηγός πρέπει να έχει καθαρή εικόνα προς τα μπροστά, στο πλάι και στους καθρέπτες.<br><br><font face=/font/big_bold.font>Για εμφάνιση του μενού ρυθμίσεων, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Ρύθμισε το κάθισμα έτσι ώστε να έχεις καθαρή εικόνα του περιβάλλοντός σου όπως και τους καθρέπτες, και έτσι ώστε να έχεις εύκολα προσβάσιμα όλα τα χειριστήρια.<br><br>Ρύθμισε το τιμόνι έτσι ώστε να είναι σε άνετη θέση και να μην εμποδίζει τα όργανα.<br><br><font face=/font/big_bold.font>Όταν είσαι ικανοποιημένος με τις ρυθμίσεις, πάτησε το @@imv_nrm_back@@ για να επιστρέψεις στο μενού ρυθμίσεων. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Τα φορτηγά έχουν πολύ μεγάλα τυφλά σημεία, οπότε είναι εξοπλισμένα με πολλαπλούς εξωτερικούς καθρέπτες για να βοηθούν τους οδηγούς να βλέπουν όσο το δυνατόν περισσότερο.<br><br>Η σωστή ρύμθιση των καθρεπτών σου δίνει την καλύτερη δυνατή ορατότηα του περιβάλλοντός σου.<br><br><font face=/font/big_bold.font>Άνοιξε το \n«@@adj_mirrors@@» για να συνεχίσεις. </font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Οι κύριοι καθρέπτες καλύπτουν τον χώρο στο πλάι του φορτηγού και του τρέιλερ.<br><br>Για την ρύμθιση τους στην σωστή θέση, χρησιμοποίησε ως σημεία αναφορά τα αυτοκίνητα στις πλευρές του οχήματός σου.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_selectfcs@@ για συνέχεια.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Οι κύριοι καθρέπτες είναι το κύριο εργαλείο σου για να βλέπεις τι γίνεται στο πλάι σου και πίσω σου. Θα πρέπει να έχεις καλή ορατότητα του αυτοκινήτου δίπλα σου, αλλά θα πρέπει να φαίνεται και λίγο από το τρέιλερ στο καθρέπτη για να σε βοηθήσει να κρίνεις την θέση των εμποδίων γύρω σου."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Όταν είναι ικανοποιημένος με την ρύμθιση, άλλαξε στην ρύθμιση του κυρίου καθρέπτη του συνοδηγού."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Και πάλι θα πρέπει να έχεις καλή ορατότητα του αυτοκινήτου δίπλα σου, αλλά θα πρέπει να φαίνεται και λίγο από το τρέιλερ στο καθρέπτη."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Όταν είναι ικανοποιημένος με την ρύμθιση, άλλαξε στην ρύθμιση του κυρτού καθρέπτη του οδηγού."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Οι κυρτοί καθρέπτες παρέχουν πιο ευρύ οπτικό πεδίο, που σου δίνει την δυνατότητα να βλέπεις περισσότερα δίπλα σου.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_selectfcs@@ για να συνεχίσεις. </font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Ιδανικά θα πρέπει να βλέπεις και το αυτοκίνητο και το φορτηγό που είναι σταθμευμένα δίπλα σου, έχοντας ορατό στον καθρέπτη ένα πολύ μικρό ποσοστό του δικού σου φορτηγού."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Όταν είναι ικανοποιημένος με την ρύμθιση, άλλαξε στην ρύθμιση του κυρτού καθρέπτη του συνοδηγού."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Κι εδώ, θα πρέπει να βλέπεις και το αυτοκίνητο και το φορτηγό που είναι σταθμευμένα δίπλα σου, έχοντας ορατό στον καθρέπτη ένα πολύ μικρό ποσοστό του δικού σου φορτηγού."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Όταν είναι ικανοποιημένος με την ρύμθιση του καθρέπτη, πάτησε @@imv_nrm_back@@ για να κλείσεις τις ρυθμίσεις των καθρεπτών."

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Πάτησε το @@imv_nrm_back@@ για επιστροφή στο μενού ρυθμίσεων. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Εξαιρετικά αφού ρυθμίστηκαν το κάθισμα και οι καθρέπτες, τώρα είσαι ένα βήμα πιο κοντά στο να βγεις στον δρόμο!<br><br><font face=/font/big_bold.font>Κλείσε το μενού ρυθμίσεων χρησιμοποιώντας το @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Ρίξε ακόμα μία καλή ματιά ότι είσαι ικανοποιημένος με την ορατότητα από την καμπίνα και από τους καθρέπτες.<br><br>Αν κάτι δεν σε βολεύει, μπορείς να ξαναρυθμίσεις τους καθρέπτες στο μενού «@@adjust_link_t@@».<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_activate@@ για να ολοκληρώσεις το πρώτο σενάριο.</font> @@aca_goal_tip@@ Για προβολή ή απόκρυψη των καθρεπτών επί της οθόνης, πήγαινε στο «@@adjust_link_t@@ — «@@adj_ui_mirrors@@» από το μενού παύσης. Οι καθρέπτες επί της οθόνης σε βοηθούν να βλέπεις καλύτερα την πλευρά του συνοδηγού."
#@}

