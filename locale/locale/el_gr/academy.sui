#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Βασικοί Έλεγχοι και Κινήσεις"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Μάθε τους βασικούς χειρισμούς και πως να κινείς το φορτηγό μπροστά και πίσω."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το Κεφάλαιο 1: @@aca_chapter_book1_1_title@@.<br><br>Έχεις μάθει πως να προετοιμάζεις το φορτηγό πριν την οδήγηση,<br>κίνηση προς τα εμπρός και πίσω και την χρήση των φώτων και των υαλοκαθαριστήρων.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Βασικοί Ελιγμοί"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Μάθε για την οδήγηση, τους ελιγμούς και την στάθμευση με τράκτορα. Εξερεύνησε τον σκοπό κάθε τύπου καθρέπτη και πως χρησιμοποιείται."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το Κεφάλαιο 2: @@aca_chapter_book1_2_title@@.<br><br>Έχεις μάθει πως να χρησιμοποιείς κάθε καθρέπτη του φορτηγού, να ελέγχεις τον χώρο γύρω από το φορτηγό πριν ξεκινήσεις και γνωρίζεις βασικούς και σύνθετους ελιγμούς.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Ελιγμοί με Τρέιλερ"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Μάθε για την σύνδεση κα τους ελιγμούς με τρέιλερ σε διάφορες καταστάσεις."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το Κεφάλαιο 3:@@aca_chapter_book1_3_title@@.<br><br>Έχεις μάθει πως γίνεται η σύνδεση και αποσύνδεση του τρέιλερ,<br>την αίσθηση του βάρους και των διαστάσεων του φορτηγού μαζί με το τρέιλερ<br>και την οδήγηση σε απαιτητικές διαδρομές με τρέιλερ.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Όπισθεν με Τρέιλερ"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Μάθε νέους ελιγμούς για την αποτελεσματική οπισθοπορία και στάθμευση με τρέιλερ."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το Κεφάλαιο 4: @@aca_chapter_book1_4_title@@.<br><br>Έχεις μάθει τους χειρισμούς οπισθοπορείας με τρέιλερ<br>και διάφορες τεχνικές στάθμευσης.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Τελική Εξέταση"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Δείξε τις γνώσεις και τις ικανότητές σου και απόδειξε την αξία σου ως οδηγός φορτηγού!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το Κεφάλαιο 5: @@aca_chapter_book1_5_title@@.<br><br>Έχεις αποδείξει ότι έχεις όλες τις απαραίτητες ικανότητες<br>οδήγησης, ελιγμών και στάθμευσης φορτηγού!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Ζεσταίνοντας την Μηχανή"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Ολοκλήρωσες την εκπαίδευση: @@aca_chapter_book2_0_title@@.<br><br>Έμαθες του κανόνες και τις λειτουργίες των Επαγγελαμτικών Γνώσεων Οδήγησης.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Επιστροφή στη Δράση"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το 2ο Κεφάλαιο: @@aca_chapter_book2_1_title@@.<br><br>Ζέστανες τον κινητήρα, δοκίμασες τις ταχύτητες, γύρισες τους τροχούς και έλεγξες την πέδηση. Το επόμενο κεφάλαιο θα είναι πιο απαιτητικό.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Εν Κινήσει"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το 3ο Κεφάλαιο: @@aca_chapter_book2_2_title@@.<br><br>Έχεις καταλάβει δύσκολα και περίπλοκα σενάρια. Έδειξες τις ικανότητες και τις επιδόσεις σου.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Η Τελική Ευθεία"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Συγχαρητήρια!<br>Ολοκλήρωσες το 4ο Κεφάλαιο:@@aca_chapter_book2_3_title@@.<br><br>Αντιμετώπισες πολλές δύσκολες καταστάσεις με ελιγμούς, στάθμευση και όπισθεν με τρέιλερ. Απέδειξες ότι είναι ένας ικανότατος οδηγός, που αντεπεξέρχεσαι σε όλες τις απαιτητικές καταστάσεις."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Πάμε Μπροστά"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Learn all the essential techniques for handling double trailers when driving forward."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 1: @@aca_chapter_book3_1_title@@.<br><br>You have experienced how to drive and manoeuvre with double trailers effectively.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Έλεγχος Όπισθεν"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Understand the necessary steps for manoeuvring double trailers when reversing."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book3_2_title@@.<br><br>You have have learned the formidable skill of reversing with double trailers.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Προεοτιμασία για τον Πραγματικό Κόσμο"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Apply your new knowledge in more advanced scenarios."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book3_3_title@@.<br><br>You have handled many difficult situations in manoeuvring, parking, and reversing with double trailers. You've proven yourself here, now it's time to pull some doubles on the roads of Euro Truck Simulator 2!</font><br><br>"


#@}

