#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Για αυτήν την βόλτα, θα κάνουμε όπισθεν σε ευθεία γραμμή. Θα πρέπει να περάσεις την διακεκομμένη γραμμή και να σταματήσεις εκεί."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Όταν κάνεις όπισθεν με το φορτηγό είναι απαραίτητο να κοιτάς γύρω σου συνεχώς, να παρατηρείς τους καθρέπτες ώστε να είσαι σίγουρος ότι ο χώρος γύρω και πίσω σου είναι καθαρός."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Εκκίνησε τον κινητήρα, βάλε όπισθεν και ξεκίνησε να κινείσαι."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Πέρνα με την όπισθεν την διακεκομμένη γραμμή, σταμάτησε, σβήσε τον κινητήρα και ασφάλισε το φορτηγό."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Προετοίμασε το φορτηγό όπωες έμαθες στο προηγούμενο σενάριο.<br><br><font face=/font/big_bold.font>Όταν είσαι έτοιμος, βάλε μπρος τον κινητήρα. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Δες τους καθρέπτες ώστε να ελέγξεις ότι η περιοχή γύρω σου είναι ελεύθερη. Αν δεν είναι ικανοποιημένος με την θέση τους, μπορείς να τους ρυθμίσεις στο «@@adjust_link_t@@».<br><br><font face=/font/big_bold.font>Δες τον καθρέπτη στην πλευρά του συνοδηγού.</font>@@aca_goal_tip@@ Πρέπει να είσαι εντός του οχήματος."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Θα περάσεις την διακεκομμένη γραμμή. Η λωρίδα είναι ελεύθερη αυτήν την στιγμή, αλλά κατά την κανονική οδήγηση είναι απαραίτητο για ελέγχεις το περιβάλλον σου κοιτώντας γύρω σου και στους καθρέπτες.<br><br><font face=/font/big_bold.font>Έλεγξε τον καθρέπτη του οδηγού.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Χρησιμοποίησε το $input backward$ για να βάλεις την όπισθεν. </font>@@aca_goal_tip@@ Όταν κάνεις όπισθεν ο αυτόματος βομβητής ενεργοποιείται στα περισσότερα φορτηγά. Μπορείς να τον απενεργοποιήσεις στις Ρυθμίσεις - «Ήχος» - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Χρησιμοποίησε @@imv_nrm_geardown@@ για να βάλεις την όπισθεν. </font>@@aca_goal_tip@@ Όταν κάνεις όπισθεν ο αυτόματος βομβητής ενεργοποιείται στα περισσότερα φορτηγά. Μπορείς να τον απενεργοποιήσεις στις Ρυθμίσεις - «Ήχος» - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Χρησιμοποίησε @@imv_nrm_geardown@@ για να βάλεις την όπισθεν. </font>@@aca_goal_tip@@ Όταν κάνεις όπισθεν ο αυτόματος βομβητής ενεργοποιείται στα περισσότερα φορτηγά. Μπορείς να τον απενεργοποιήσεις στις Ρυθμίσεις - «Ήχος» - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Πάτησε τον συμπλέκτη και βάλε τον λεβιέ στην όπισθεν. </font>@@aca_goal_tip@@ Όταν κάνεις όπισθεν ο αυτόματος βομβητής ενεργοποιείται στα περισσότερα φορτηγά. Μπορείς να τον απενεργοποιήσεις στις Ρυθμίσεις - «Ήχος» - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Έχεις επιλέξει την όπισθεν.<br><br><font face=/font/big_bold.font>Λύσε το χειρόφρενο πατώντας το @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Ξεκίνησε να κινείσαι χρησιμοποιώντας το $input backward$.<br><br><font face=/font/big_bold.font>Πέρνα με την όπισθεν την διακεκομμένη γραμμή. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Ξεκίνησε να κινείσαι χρησιμοποιώντας το γκάζι: $input forward$.<br><br><font face=/font/big_bold.font>Πέρνα με την όπισθεν την διακεκομμένη γραμμή. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Ξεκίνησε να κινείσαι χρησιμοποιώντας το γκάζι: $input forward$.<br><br><font face=/font/big_bold.font>Πέρνα με την όπισθεν την διακεκομμένη γραμμή. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Άφησε απαλά τον συμπλέκτη κρατώντας σταθερές τις σ.α.λ. του κινητήρα με το γκάζι. <br><br><font face=/font/big_bold.font>Πέρνα με την όπισθεν την διακεκομμένη γραμμή. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Σταμάτα το φορτηγό χρησιμοποιώντας το φρένο: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Σταμάτα το φορτηγό χρησιμοποιώντας το φρένο: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Σταμάτα το φορτηγό χρησιμοποιώντας το φρένο: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Πάτησε πλήρως τον συμπλέκτη και σταμάτα το φορτηγό με το φρένο. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Ενεργοποίησε το χειρόφρενο πατώντας @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Με το απλό αυτόματο κιβώτιο ταχυτήτων δεν αλλάζεις ταχύτητες, όλα γίνονται αυτόματα, σε αντίθεση με την πραγματοκότητα.<br><br><font face=/font/big_bold.font>Πάτησε το @@imv_nrm_activate@@ για επιβεβαίωση. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Βάλε νεκρά πατώντας @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Τα σύγχρονα φορτηγά επιλέγουν αυτόματα την νεκτά όταν ενεργοποιείται το χειρόφρενο. Ωστόσο είναι καλό συνήθειο να το κάνεις πάντοτε. Στα επόμενα σενάρια αυτό το βήμα δεν θα είναι απαραίτητο."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Βάλε νεκρά πατώντας @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Τα σύγχρονα φορτηγά επιλέγουν αυτόματα την νεκτά όταν ενεργοποιείται το χειρόφρενο. Ωστόσο είναι καλό συνήθειο να το κάνεις πάντοτε. Στα επόμενα σενάρια αυτό το βήμα δεν θα είναι απαραίτητο."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Βάλε νεκρά με τον λεβιέ και άσε τον συμπλέκτη.</font>@@aca_goal_tip@@ Τα σύγχρονα φορτηγά επιλέγουν αυτόματα την νεκτά όταν ενεργοποιείται το χειρόφρενο. Ωστόσο είναι καλό συνήθειο να το κάνεις πάντοτε. Στα επόμενα σενάρια αυτό το βήμα δεν θα είναι απαραίτητο."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Να θυμάσαι πάντα να έχεις υπόψην σου το περιβάλλον σου όταν κάνεις όπισθεν, ειδικά σε πολυσύχναστες περιοχές με πολλή κίνηση.<br><br><font face=/font/big_bold.font>Σβήσε τον κινητήρα πατώντας $input engineelect$. </font>"
#@}

