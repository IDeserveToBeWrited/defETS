#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Πέδηση Κοντά σε Εμπόδιο"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Σε αυτό το σενάριο, θα μιλήσουμε για τον μπροστινό καθράπτη, την θέση του και πως να τον χρησιμοποιείς ώστε να σταματήσεις κοντά σε ένα εμπόδιο μπροστά σου."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Έλεγχος του Μπροστινού Καθρέπτη"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Κατανοώντας την λειτουργία"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Πέδηση Κοντά στο Εμπόδιο"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Τα φορτηγά έχουν μεγάλο τυφλό σημεία στην περιοχή μπροστά από τον τράκτορα. Είναι εύκολο να χάσεις την οπτική επαφή με κάποιον πεζό ή ακόμη και αυτοκίνητο στο σημείο αυτό, οπότε τα φορτηγά είναι εφοδιασμένα με μπροστινό καθρέπτη τον οποίο κοιτάς από το παρμπρίζ."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Ο μπροστινός καθρέπτης έχει σχεδιαστεί για να έχει ο οδηγός ορατότητα σε αυτό το νεκτρί σημείο.<br>Είναι ένα απαραίτητο εργαλείο για να αποφεύφονται οι συγκρούσεις με εμπόδια κατά την διάρκεια ελιγμών σε στενά σημεία."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Ξεκίνησε να οδηγάς, προχώρησε προς το εμπόδιο εμπρος σου και επιδράδυνε καθώς το προσεγγίζεις.<br>Έλεγχε τον μπροστινό καθρέπτη."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Σταμάτησε μεταξύ της γραμμής και του εμποδίου."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Σε αυτό το σενάριο θα μάθουμε για την χρήση του μπροστινού καθρέπτη όπως δείχνει το διάγραμμα.<br><br><font face=/font/big_bold.font>Δες προς το πάνω μέρος του παρμπρίζ για να τον δεις.</font>@@aca_goal_tip@@ Πρέπει να είσαι μέσα στο όχημα."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Ο μπροστινός καθρέπτης σου δίνει ορατότητα στο τυφλό σημείο εμπρός από το φορτηγό. Βοηθάει στην οδήγηση με ασφάλεια και ακρίβεια.<br><br>Αν δεν είναι ικανοποιημένος με την ρύθμισή τους, άνοιξε το «@@adjust_link_t@@» (Διαθέσιμο από το μενού παύσης) για να τον ρυθμίσεις όπως σε βολεύει.<br><br><font face=/font/big_bold.font>Πάτησε @@imv_nrm_activate@@ για να συνεχίσεις. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Μπροστά από το φορτηγό υπάρχει ένα επισημασμένο σημείο. Θα παρατηρήσεις ότι υπάρχει εμπόδιο στην άλλη πλευρά. Όταν φτάσεις κοντά του, πήγαινει πολύ αργά, έλεγχε την απόσταση από το εμπόδιο με τον μπροστινό καθρέπτη.<br><br><font face=/font/big_bold.font>Προετοιμάσου για εκκίνηση. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Το φορτηγό δεν είναι ακόμη έτοιμο να κινηθεί, μήπως ξέχασες κάτι;<br><br>Έχεις βάλει μπρος; Έχεις λύσει το χειρόφρενο;"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Οδήγησε προς την θέση στάθμευσης. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Στάμάτησε το φορτηγό ανάμεσα στο εμπόδιο και την γραμμή στο οδόστρωμα. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
#!}

#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Στάθμευση Δίπλα σε ένα Εμπόδιο"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Σε αυτό το σενάριο, θα μάθουμε να σταθμεύουμε δίπλα σε ένα κράσπεδο χρησιμοποιώντας τον πλαϊνό καθρέπτη."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Έλεγχος του Πλαϊνού Καθρέπτη"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Οδήγηση Προς το Κράσπεδο"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Ο πλευρικός καθρέπτης είναι ακόμη ένα εργαλείο που θα σε βοηθήσει στους ασφαλείς του φορτηγού. Είναι τοποθετημένος στο άνω μέρος της πόρτας του συνοδηγού."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Οδήγησε προς τα μπροστά και στρίψε σιγά σιγά προς την πλευρά του συνοδηγού."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Αυτές οι ξύλινες σανίδες αντιπροσωπεύηνυον το κράσπεδο. Θα πρέπει να σταματήσεις δίπλα του.<br>Στρίψε προς το κράσπεδο για να τοποθετήσεις το φορτηγό σε καλή θέση προς την θέση στάθμευσης."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Επιβράδυνε αρκετά πριν το κράσπεδο και στρίψε προς την θέση στάθμευσης. Καθώς ισιώνεις, μπορείς να χρησιμοποιήσεις τον πλαϊνό σου καθρέπτη για να κρίνεις την απόσταση από το πεζοδρόμιο."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Σταμάτησε στην θέση στάθμευσης και ασφάλισε το φορτηγό."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Δες στο παράθυρο του συνοδηγού. Μπορείς να δεις τον πλαϊνό καθρέπτη.</font>@@aca_goal_tip@@ Πρέπει να είσαι μέσα στο όχημα."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Ο πλευρικός καθρέπτης καλύπτει την περιοχή της πλευράς του συνοδηγού που ο οδηγός δεν μπορεί να δει. Είναι από τα πιο δύσκολα τυφλά σημεία ενός φορτηγού. Αν η γωνία του καθρέπτη δεν σε βολεύει, μπορείς να την ρυθμίσεις στο «@@adjust_link_t@@».<br><br><font face=/font/big_bold.font>Προετοιμάσου για εκκίνηση. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Το φορτηγό δεν είναι ακόμη έτοιμο να κινηθεί, μήπως ξέχασες κάτι;<br><br>Έχεις βάλει μπρος; Έχεις λύσει το χειρόφρενο;"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Μπροστά σου υπάρχει μια σειρά με σανίδες που αντιπροσωπεύουν ένα κράσπεδο. Στο τέλος του υπάρχει μια θέση στάθμευσης. Οδήγησε προς τα εκεί <br><br><font face=/font/big_bold.font>Συνέχισε όταν είσαι έτοιμος. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Στρίψε προς το κράσπεδο. Χρησιμοποίησε τον μπροστινό και πλαϊνό καθρέπτη για να ελέγξεις την θέση του σε σχέση με αυτό, αλλά και για να μην πατήσεις τους κώνους.<br><br><font face=/font/big_bold.font>Οδήγησε προς το κράσπεδο και στην θέση στάθμευσης. </font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Secure the truck and shut down the engine.</font>@@aca_goal_tip@@ You can use Interior Look presets to make looking at mirrors easier. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Στάθμευση με Όπισθεν Δίπλα σε ένα Εμπόδιο"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Σε αυτό το σενάριο, θα κάνουμε όπισθεν το φορτηγό σε θέση στάθμευσης δίπλα σε κράσπεδο."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Οδηγίες"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Όπισθεν Προς το Κράσπεδο"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Στάθμευση του Φορτηγού"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Σε αυτό το σενάριο, θα εκτελέσουμε έναν ελιγμό οπισθοπορείας για να σταθμεύσουμε δίπλα σε κράσπεδο."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Κάνε όπισθεν προς το κράσπεδο.<br>Θα πρέπει να έχεις υπόψην σου το περιβάλλον σου όταν κάνεις όπισθεν, οπότε χρησιμοποίησε τους καθρέπτες σου."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Καθώς πλησιάζεις μπορείς να ξεκινήσεις να ευθυγραμμίζεις το φορτηγό με την θέση στάθμευσης. Έλεγχε και τις δύο πλευρές του φορτηγού καθώς κάνεις όπισθεν."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Σταμάτησε στην θέση στάθμευσης και ασφάλισε το φορτηγό."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Η θέση στάθμευσης είναι πίσω σου και στην πλευρά του συνοδηγού. Χρησιμοποίησε τους καθρέπτες σου για να φτάσεις στην θέση.<br><br><font face=/font/big_bold.font>Προετοιμάσου για εκκίνηση. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Θυμίσου να χρησιμοποιείς του καθρέπτες σου για να ελέγχεις το περιβάλλον σου πριν κινήσεις το φορτηγό.<br><br><font face=/font/big_bold.font>Ξεκίνησε την οπισθοπορεία προς το κράσπεδο. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Συνέχισε να παρακολουθείς τον περιβάλλοντα χώρο με τους καθρέπτες σου για όσο διάστημα κάνεις όπισθεν.<br><br><font face=/font/big_bold.font>Σταμάτησε στην κατάλληλη θέση. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Πίστα Εκπαίδευσης Προχωρημένων"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Το τελευταίο σενάριο αυτού του κεφαλαίου είναι μια σύντομη βόλτα στην ειδική πίστα εκπαίδευσης. Θα δοκιμάσουμε τις ικανότητες που έμαθες με τον τράκτορα!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Σλάλομ"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Σλάλομ"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Φουρκέτα"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "Στροφή 90 Μοιρών"

	key[]: "aca_goal_book1_2_06_check3"
