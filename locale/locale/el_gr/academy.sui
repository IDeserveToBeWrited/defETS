	key[]: "aca_msg_book3_parallel_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_parallel_forward"
	val[]: "Drive forward, find your parking spot, and set your vehicle up to reverse in."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Reverse into the spot."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Stop in the designated area."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Secure the truck and shut down the engine."
#@}




