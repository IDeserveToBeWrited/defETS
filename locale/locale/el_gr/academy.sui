#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "For the final scenario of this chapter, we'll drive on the test track with a complex configuration."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "The first obstacle is a slalom through some barriers. Drive through it and remember to use your mirrors."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Next is a hairpin turn. Keep your turn wide and it shouldn't pose you any problems."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "There is a 90 degree left turn here. Remember to drive in deep so that the rear of the truck clears the inside barriers."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "The ramp obstacle can be a bit tricky. Line yourself up as best as you can before you drive onto it and use your front and side mirrors to help orient yourself."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "The next section must be done in reverse. Approach the barriers ahead with that in mind."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Follow the road markings back and to the right of you."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Reverse to the barriers, then stop and proceed forwards to the left."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Proceed through the break in the median to the next section."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Remember to drive in deep on 90 degree turns."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "You are entering a nice open section of road. You can pick up some speed, but keep in mind you'll need to slow down soon for the curve up ahead."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "At the bottom of the hill there are some barriers across the road. Drive up to them, then reverse into the parking spot on the left."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Όπισθεν στην Θέση Στάθμευσης."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Στάθμευσε, σβήσε τον κινητήρα και ασφάλισε το φορτηγό."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "In front of you is a slalom made of barriers.<br><br><font face=/font/big_bold.font>Drive through the slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Keep towards the outside of the turn to ensure the rear of the tractor doesn't go over the kerb.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "You are coming up to a 90 degree left turn. Remember to use all the space you have available.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Align yourself with the ramp. There isn't much room to make corrections once you are on it.<br><br><font face=/font/big_bold.font>Drive over the ramp. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Follow the course to the left. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Το ακόλουθο τμήμα πρέπει να ολοκληρωθεί με την όπισθεν. Σταμάτησε στα εμόδια μπροστά έτσι ώστε να μπορείς να κάνεις όπισθεν προς τα δεξιά μετά.<br><br><font face=/font/big_bold.font>Σταμάτησε στα εμόδια. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Reverse towards the area behind you and to the right. There are arrows on the road to help assist you.<br><br><font face=/font/big_bold.font>Reverse towards the next section. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Keep reversing towards the barriers behind you.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stop and change into a forward gear, then continue to the left. <br><br><font face=/font/big_bold.font>Drive forwards. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "There is a break in the median to the left. Drive through it.<br><br><font face=/font/big_bold.font>Continue onwards. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continue through the course.<br><br><font face=/font/big_bold.font>Turn left. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Remember to keep left before the turn to give yourself as much room as possible.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "You can pick some speed up here, but there is a curve coming up ahead.<br><br><font face=/font/big_bold.font>Continue along the course. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "The curve gets sharper as you make your way through it.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly and carry on.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "At the bottom of the hill you will see barriers blocking the road. <br><br><font face=/font/big_bold.font>Stop near the barriers. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Πίσω σου και αριστερά υπάρχει μία θέση στάθμευσης.<br><br><font face=/font/big_bold.font>Κάνε όπισθεν στην θέση στάθμευσης. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Stop in the marked spot. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Driving on a Handling Track"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In this scenario, we'll take a drive on a track designed to test your ability to handle the truck through different kind of curves and corners."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Είσοδος στην Διαδρομή"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Πραγματοποίηση Σταδιακής Αριστερής Στροφής"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Οδήγηση μέσα από Στροφές"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Ίσιο Τμήμα"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Εύκολες Στροφές"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Έξοδος από την Πίστα Εκπαίδευσης"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Προσέγγιση Θέσης Στάθμευσης"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Σε αυτό το σενάριο, θα πάμε μια σύντομη βόλτα με τον τράκτορα για να δούμε πως τον χειρίζεσαι με τις νέες σου γνώσεις."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Υπάρχει πληθώρα ειδών και συνδυασμών στροφών στην πίστα. Δεν είναι αγώνας και δεν υπάρχει χρονομέτρηση. Οδήγηση με υπομονή και την κατάλληλη ταχύτητα για τις στροφές και τα εμπόδια που θα συναντήσεις."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Στην αρχή η διαδρομή είναι απλή και εύκολη, αλλά οι στροφές θα γίνουν πιο περίπλικες καθώς προχωράς."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Πρόσεχε την ταχύτητά σου. Είναι εύκολο να επιταχύνεις και να κρίνεις λάθος μια επόμενη στροφή."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Η έξοδος από την πίστα είναι μία πολύ κλειστή φουρκέτα. Πήγαινε σιγά και χρησιμοποίησε όλο τον διαθέσιμο χώρο."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Στάθμευσε μεταξύ των εμποδίων και ασφάλισε το φορτηγό."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Για την επιτυχή ολοκλήρωση αυτού του σεναρίου θα πρέπει να μην τρακάρεις, βγεις εκτός πίστας και χτυπήσεις κώνους.<br><br><font face=/font/big_bold.font>Προετοιμάσου για εκκίνηση. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Προχώρησε εμπρός σε απότομη δεξιά στροφή για να μπεις στην πίστα. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Πέρασε την στροφή με σταθερή ταχύτητα. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Προσεγγίζεις ένα πιο περίπλοκο τμήμα ελικοειδών στροφών.<br><br><font face=/font/big_bold.font>Ρύθμισε την ταχύτητά σου αναλόγως και συνέχισε. </font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Συνέχισε προς τις επόμενες στροφές.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Οι επόμενες στροφές είναι εύκολες. Κράτησε σταθερή την ταχύτητά σου.<br><br><font face=/font/big_bold.font>Συνέχισε. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Η στροφή βγαίνοντας από την πίστα είναι μία κλειστή φουρκέτα. Επιβράδυνε και μείνε στην εξωτερική πριν την στροφή. Χρησιμοποίησε τους καθρέπτες σου!<br><br><font face=/font/big_bold.font>Βγες από την πίστα. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Μπροστά σου υπάρχει μια θέση στάθμευσης μεταξύ εμποδίων.<br><br><font face=/font/big_bold.font>Συνέχισε προς την θέση στάθμευσης. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Παράλληλη Στάθμευση"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Σε αυτό το σενάριο, θα δούμε την παράλληλη στάθμευση μεταξύ δύο άλλων φορτηγών."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Ακινητοποίηση Μπροστά από την Θέση Στάθμευσης"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Έλεγχος Καθρέπτη"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Όπισθεν στην Θέση Στάθμευσης"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Ευθυγράμμιση του Φορτηγό εντός της Θέσης Στάθμευσης"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Η παράλληλη στάθμευση είναι γνώση καίριας σημασίας για κάθε οδηγό φορτηγού.<br>Προετοιμάσου για εκκίνηση."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Οδήγησε προς την θέση στάθμευσης<br>Πρόσεχε τον χώρο γύρω σου."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Ευθυγραμμίσου με το φορτηγό μπροστά από την θέση. Μην πας πολύ κοντά του, άφησε κάποια απόσταση ώστε να έχουμε χώρο."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Στρίψε προς την θέση και κάνε όπισθεν."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Όταν κοιτάς στον πλευρικό καθρέπτη του οδηγού, βάλε στόχο το κράσπεδο ακριβώς μπροστά από το πίσω φορτηγό."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Μόλις ο μπροστινός σου προφυλακτήρας περάσει από το μπροστινό φορτηγό, μπορείς να στρίψεις για να βάλεις το εμρός μέρος του φορτηγού σου στην θεση, ευθυγραμμίζοντας το φορτηγό με την θέση στάθμευσης."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ίσιωσε το τιμόνι και κέντραρε το φορτηγό εντός της θέση.<br>Στάθμευσε και ασφάλισε το φορτηγό."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Μπροστά σου βρίσκονται κάποια σταθμευμένα φορτηγά. Υπάρχει μία κενή θέση στα αριστερά για να σταθμεύσεις εσύ. <br><br><font face=/font/big_bold.font>Ετοιμάσου να ξεκινήσεις. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Θυμίσου πάντα να πρόσεχεις τον χώρο γύρω σου. Χρησιμοποίησε τους καθρέπτες σου καθόλη την διάρκεια του ελιγμού. <br><br><font face=/font/big_bold.font>Οδήγησε μπροστά. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Πέρνα την θέση στάθμευσης και μπες στην επισημασμένη περιοχή. Από εκεί ξεκίνησε την οπισθοπορεία.<br><br><font face=/font/big_bold.font>Σταμάτησε στο επισημασμένο σημείο. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Έλεγξε το περιβάλλον για εμπόδια και να να είσαι σίγουρος ότι είσαι ελεύθερος να κάνεις όπισθεν.<br><br><font face=/font/big_bold.font>Δες στον καθρέπτη του συνοδηγού. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Στρίψε και κάνε όπισθεν προς την θέση στάθμευσης.<br><br><font face=/font/big_bold.font>Ξεκίνησε την όπισθεν. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Ξεκίνησε να ισιώνεις το φορτηγό όταν χρειαστεί. Μην ανέβεις στο κράσπεδο!<br><br><font face=/font/big_bold.font>Ευθυγράμμισε το φορτηγό με την θέση. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Σύνδεση του Τρέιλερ"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "Σε αυτό το σενάριο, θα εξηγήσουμε τα βασικά για την σύνδεση και αποσύνδεση του τράκτορα με ένα τρέιλερ."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Όπισθεν προς το Τρέιλερ"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Σύνδεση του Τρέιλερ"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Απεμπλοκή του Χειρόφρενου"





	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Αποσύνδεση του Τρέιλερ"


	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Αποσύνδεση του Τρέιλερ"



	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Αποσύνδεση του Τρέιλερ"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Σταμάτησε στην Προκαθορισμένη Περιοχή"
