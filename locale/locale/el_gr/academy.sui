#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Οδήγηση Διαμέσου Περίπλοκων Στροφών"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In this scenario, we'll explore manoeuvring the trailer through a short obstacle course with more complex turns."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Πρώτες Στροφές"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Οδήγηση Μέσα από Στενό Πέρασμα"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Στενή Στροφή 90 Μοιρών"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Οδήγηση Γύρω από Εμπόδια"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Ahead are a variety of complex corners and obstacles.<br>Take everything you've learned so far into account and it shouldn't be too difficult."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "The road markings can help give you an idea of how to proceed through each set of obstacles."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Keep the tractor to the outside of the corner. <br>You'll need to swing wide as the trailer follows a shorter path."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "The next corner is an easy 90 degree turn. <br> Once again, keep the truck to the outside of the turn and utilize all the space available to you."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Take your time here. The course opens up, but you will still need to be precise."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Keep a wide berth around the barriers."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Take care as you enter this narrow section. <br>Swing the tractor wide well before you enter to set your trailer up for entry."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "The final 90 degree turn is much sharper than the first, but there is plenty of room if you use your space wisely."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Stop in the designated area, then secure the truck and switch off the engine."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Remember to utilize the road markings to help you navigate the course.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Using your mirrors will also help you to navigate the course safely. You must always be aware of how the trailer is tracking behind you.<br><br><font face=/font/big_bold.font>Proceed through the first corner. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observe the trailer as you exit the turn and prepare to enter the next one.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Proceed through the next turn. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Remember to observe your trailer to ensure you are clear of the obstacles around you before turning the truck.<br><br><font face=/font/big_bold.font>Continue around the barrier obstacle ahead. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "When your trailer is clear of the barrier, turn hard to the passenger's side to line yourself up for the narrow passage. <br><br><font face=/font/big_bold.font>Proceed towards the narrow passage.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "This section will require very precise driving. Take your time and use your mirrors.<br><br><font face=/font/big_bold.font>Stay towards the outside of each corner. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "This turn is very sharp, but you can utilize all the space in front of you to clear it easily.<br><br><font face=/font/big_bold.font>Make the final turn. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Διαδρομή Εκπαίδευσης Προχωρημένων - Με Τρέιλερ"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "In the final scenario of Chapter 3, we'll take a drive on a longer training course with a variety of different turns to see how well you've learned to manoeuvre with a trailer."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Dogleg Turn"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVE THIS GOAL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Διαστάυρωση με Νησίδα"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Πρώτο Σλάλομ"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Δεύτερο Σλάλομ"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Εύκολες Στροφές"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Κυκλικός Κόμβος"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Ίσιο Τμήμα"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Στενή Στροφή"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Τελικές Στροφές"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Οδήγηση προς τη θέση στάθμευσης"
