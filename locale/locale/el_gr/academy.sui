#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Welcome to the first part of the final exam. Here, we'll see how well you've learned to drive a truck after your time at the Academy."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "First, you'll attach the trailer. Once coupled, you'll drive the truck around the entire test area."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "The first section of the track leads from the small parking lot to the eastern test course."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "The circuit includes challenging passages between barriers."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "A significant part of the route goes through the eastern test course."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "We'll test your ability to manoeuvre the truck through different situations."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "You'll manoeuvre with the truck through some sharp turns."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "You'll drive through the road section connecting the courses."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "The final part involves driving through the small circuit."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "The circuit has many intricate passages and sharp turns."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "To complete the test, you'll need to park accurately."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "There's no need to be nervous, you've already learned everything that will required to pass.<br><br>Good luck!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Ahead of you is the trailer.<br><br><font face=/font/big_bold.font>Drive towards the trailer. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Align the tractor with the trailer.<br><br><font face=/font/big_bold.font>Reverse, and connect to the kingpin. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Secure the truck. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Press @@imv_nrm_attach@@<font face=/font/big_bold.font> to connect the trailer. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "The trailer is connected, and the truck is ready to drive.<br><br><font face=/font/big_bold.font>Release the parking brake. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Start driving towards the exit of the parking lot. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Follow the road markings and watch out for barriers.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "A more challenging section is coming up.<br><br><font face=/font/big_bold.font>Carefully navigate between the barriers. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "This part will test your skills at manoeuvring a trailer around different kinds of corners.<br><br><font face=/font/big_bold.font>Turn onto the course. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Drive through the passage. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Drive straight. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Carefully navigate the turn. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "You're entering a more complex section. Drive carefully.<br><br><font face=/font/big_bold.font>Continue driving downhill. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Make the sharp left turn. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Exit the circuit. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "You're entering an easier section.<br><br><font face=/font/big_bold.font>Continue driving down the hill. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Keep driving on the road. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Ahead is the turn onto the next course.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Turn right. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Continue driving on the course. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Ahead are more sharp turns.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Make a left turn. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Enter the turn, continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "To make the turn, you may need to go off the asphalt slightly.<br><br><font face=/font/big_bold.font>Turn carefully, use as much space as you need. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Exit the circuit and drive into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Τελική Εξέταση (Μέρος 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "The last part of the final exam awaits you, where the parking skills you've learned in previous scenarios will be evaluated. Park carefully and accurately and you'll be ready to hit the roads of Europe as a skilled trucker!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Ελιγμός Παραπλεύρως"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Διαγώνια Στάθμευση"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Οδήγηση Μέσα από τον Χώρο Στάθμευσης"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Παράλληλη Στάθμευση"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Τελική Στάθμευση"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Welcome to the second part of the final exam. We'll move to a nearby parking lot and test your skills in reversing and manoeuvring into parking spots."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Several consecutive parking challenges await you to assess your abilities."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Space is limited here, so be careful and take your time."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Remember to be careful and not to rush. It's okay if you can't get it in on the first try, the important thing is not to damage the truck or those around you. <font face=/font/big_bold.font><br><br>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Drive forwards to the first part of the exam.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Your first task is to demonstrate the offset parking manoeuvre. The spot where you need to back up with the trailer is on your left.<br><br><font face=/font/big_bold.font>Perform an offset parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "The next task is to back into a row of stationary trucks. Be careful not to hit the other trucks!<br><br><font face=/font/big_bold.font>Perform a diagonal parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Continue through the parking lot. Watch out for unexpected situations.<br><br><font face=/font/big_bold.font>Continue driving.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Now let's try parallel parking between the two trucks by the kerb ahead of you.<br><br><font face=/font/big_bold.font>Perform a parallel parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "One final parking manoeuvre to your left! You can choose to approach this however you wish.<br><br><font face=/font/big_bold.font>Reverse into the designated area.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Almost done. Leave the testing area and park the truck.<br><br><font face=/font/big_bold.font>Exit the test area to your left.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Στάθμευσε το φορτηγό στα δεξιά, μαζί με τα άλλα.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Παράλληλη Στάθμευση με Τρέιλερ"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "In this scenario, we'll take a look at parallel parking with the trailer connected."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Ακινητοποίηση στην Επισημασμένη Περιοχή"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parallel parking with a trailer is a relevant skill for all truckers.<br>Whether street parking in a big city, or stopping at a rest area in the country side, it is something every trucker should know how to do."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "As you pass the parking spot, look carefully to ensure there's enough room for the tractor and trailer to fit. Here, we've ensured that you have plenty of room."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Align yourself with the truck in front of the parking spot. Don't be too close to it, keep some distance from it so you have room to work."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Turn sharply away from the parking spot and start reversing. The idea is to get the trailer turning into the parking spot right away."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Once the trailer is pointed well into the spot, you can start to follow it in."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Start steering the trailer away from the kerb before the driver's side trailer wheels have entered the spot."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Straighten out the tractor with the trailer and then centre yourself within the parking space.<br> Park, shut down the engine, and secure the truck."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "You can see the parking space in front of you, between the other trucks. While parking, be sure to check your mirrors and maintain a safe distance between the truck and the obstacles around you.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Move through the lot to find your parking space.<br><br><font face=/font/big_bold.font>Drive forwards. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Drive past your desired parking space into the marked area. From here, you can begin your reversing manoeuvre.<br><br><font face=/font/big_bold.font>Stop in the marked spot. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Turn the tractor away from the spot to begin turning the trailer into it. Don't turn too sharply, or you'll head for the kerb. <br><br><font face=/font/big_bold.font>Start reversing. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Ευθυγράμμισε το τρέιλερ με την θέση. Αν είναι απαραίτητο, μετακινήσου προς τα εμπρός ή πίσω με τις κατάλληλες κινήσεις στο τιμόνι για να έρθεις στην κατάλληλη θέση.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Congratulations, you've successfully completed the exams for Truck Driving Basics, and learned all the skills necessary to properly manoeuvre your truck."

	key[]: "aca_msg_book1_outro02"
	val[]: "This is the first step in your journey towards realizing your dream of becoming a professional truck driver."

	key[]:	"aca_msg_book1_outro03"
	val[]: "You're now ready to head out on to the roads of Europe and face your first challenges..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...but the adventure has just begun."
#@}


