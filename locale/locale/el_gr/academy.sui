#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "Σε αυτό το σενάριο, θα προσπαθήσουμε να συνδέσουμε και απόσυνδέσουμε το τρέιλερ για πρώτη φορά. Προετοίμασε το φορτηγό και κάνε όπισθεν στο τρέιλερ πίσω σου."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Σύνδεσε το τρέιλερ και μετά κάνε λίγο μπροστά."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Σταμάτησε στην προκαθορισμένη περιοχή."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Αποσύνδεσε το τρέιλερ και κάνε λίγο μπροστά."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Στάθμευσε στην θέση στάθμευσης και ασφάλισε το φορτηγό."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "Σε αυτό το σενάριο θα συζητήσουμε τις διαδικασίες για την σύνδεση και αποσύνδεση του τράκτορα και του τρέιλερ. Πρόκειται για μία απλοποιημένη διαδικασία σε σχέση με το τι αντιμετωπίζει ένας οδηγός φορτηγού στην πραγματικότητα. <br><br><font face=/font/big_bold.font>Προετοιμάσου για εκκίνηση. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Υπάρχει ένα τρέιλερ πίσω από τον τράκτορα. Κάνε αργά όπισθεν προς το τρέιλερ μέχρι με χτυπήσει το πέταλο τον πίρο. Αυτήν την στιγμή το φορτηγό είναι σωστό ευθυγραμμισμένο οπότε δεν χρειάζεται να στρίψεις. Κάνε όπισθεν σε ευθεία.<br><br><font face=/font/big_bold.font>Κάνε αργά όπισθεν μέχρι να γίνει η σύνδεση. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Το πέταλο συνδέθηκε με τον πίρο.<br><br><font face=/font/big_bold.font>Ασφάλισε το φορτηγό με το χειρόφρενο. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Στην πραγματικότητα το πέταλο κλειδώνει αυτόματα τον πίρο, και έπειτα ο οδηγός θα πρέπει να κατέβει από το φορτηγό και να σηκώσει τα ποδαρικά και να συνδέσει τις συνδέσεις του ρεύματος και του αέρα. <br><br><font face=/font/big_bold.font>Για εμάς, απλά πατώντας το @@imv_nrm_attach@@ θα γίνει η σύνδεση του τρέιλερ. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Τώρα που ο τράκτορας συνδέθηκε με το τρέιλερ, είσαι έτοιμος να προχωρήσεις μπροστά. Λάβε υπόψιν σου ότι τώρα το όχημά του είναι αρκετά μακρύτερο και βαρύτερο και άρα απαιτούνται επιπλέον γνώσεις για τον σωστό χειρισμό. <br><br><font face=/font/big_bold.font>Λύσε το χειρόφρενο και ετοιμάσου να ξεκινήσεις. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Οδήγησε προς τα εμπρός.<br><br><font face=/font/big_bold.font>Σταμάτησε στην επισημασμένη περιοχή. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Βάλε το χειρόφρενο. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Βάλε το χειρόφρενο. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Ξάνα κι εδώ, στην πραγματική ζωή, ο οδηγός θα πρέπει να βγει από το όχημα, να κατεβάσει τα ποδαρικά, να αποσυνδέσεις τις συνδέσεις του αέρα και του ρεύματος, και να απελευθερώσει τον μηχανισμό κλειδώματος του πετάλου. <br><br><font face=/font/big_bold.font>Έχουμε απλοποιήσει την διαδικασία, οπότε πατώντας το @@imv_nrm_attach@@ το τρέιλερ θα αποσυνδεθεί. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Λύσε το χειρόφρενο. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Βγάλε τον τράκτορα από το τρέιλερ και προχώρησε ευθεία.<br><br><font face=/font/big_bold.font>Σταμάτησε στην επισημασμένη περιοχή. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Stop in the marked area. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
