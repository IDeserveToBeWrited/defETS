#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Όπισθεν με Τρέιλερ"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "In this scenario, you'll try your hand at reversing with a trailer for the first time. It is a fairly simple manoeuvre, but you'll still need to steer correctly to put the trailer into the correct position."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Όπισθεν προς το Τρέιλερ"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Σύνδεση του Τρέιλερ"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Απεμπλοκή του Χειρόφρενου"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Όπισθεν με το Τρέιλερ"

	key[]: "aca_goal_book1_3_05_check1"
