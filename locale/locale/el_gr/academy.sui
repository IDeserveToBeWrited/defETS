#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Καλωσήρθατε στην Ακαδημία Οδήγησης."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Τα ακόλουθα σενάρια εκπροσωπούν το πρώτο βήμα στο ταξίδι σου προς την επαγγελματική οδήγηση φορτηγού."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Εδώ, θα μάθεις τα πάντα από τα βασικά συστήματα και χειρισμούς του φορτηγού..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "... στους περίπλοκους χειρισμούς και και χωρίς τρέιλερ."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Θα σου ενσταλλάξουμε τις συνήθειες που θα σε βοηθήσουν να αντιμετωπίσεις ασφαλώς ποικιλία καταστάσεων,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "και θα μάθεις να κάνεις σοφή χρήση του διαθέσιμου χώρου για να είναι οι ελιγμοί σου όσο το δυνατόν πιο αποτελεσματικοί."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Ολοκληρώνοντας όλα τα σενάρια και περνώντας τις τελικές εξετάσεις,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "θα είσαι έτοιμος να βγεις στους δρόμους της Ευρώπης και να βρεθείς αντιμέτωπος με νέες προσκλήσεις."

#@}

