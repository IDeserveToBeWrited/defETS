#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANCO" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banco" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Se precisas cartos, sempre podes pedir un préstamo no banco." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "OFERTAS DE PRÉSTAMOS" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "por $MONEY$ ó dia" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Número de préstamos activos: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Podes pedir prestado: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "RESUMO DE PRÉSTAMOS ACTIVOS"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Préstamo" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Resto a pagar" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Duración (en días)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Taxa de interese (anual)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Prazo" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Repagar" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Total:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Saldo da conta: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

	key[]: "bank_loan_unlock_requirement"
	val[]: "Avanza na túa carreira no modo Camión para desbloquear os préstamos."

	key[]: "bank_loan_locked_wrong_mode"
	val[]: "Avanza na túa carreira no $MODE$ para desbloquear os préstamos."

    key[]: "bank_loan_in_debt"
	val[]: "Tes demasiadas débedas para obter este préstamo."

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NOVO PRÉSTAMO" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Estás solicitando un préstamo de $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Período de reembolso:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Taxa de interese (p.a.):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Prazo diario:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Queres confirmar a túa solicitude?"
#@}

