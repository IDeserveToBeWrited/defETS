#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "CONTIDO CONECTADO A WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Conectar" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Navigar" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "AXUSTES XENERAIS" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONECTAR CONTIDO" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Conectar" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks detectou novo contido do xogo. Conéctate ó servizo de World of Trucks para acceder ó novo contido." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "En liña" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Preferencias en liña. Axusta tódalas configuracións relacionadas con World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Realmente queres pospoñer o rexistro?<br><br>Podes acceder máis tarde á pantalla do contido conectado dende as opcións en liña, no menú principal." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "CONECTANDO CONTIDO" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Conectando contido..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Non se puido poñer en cola a operación de conexión para: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "A conta de Steam que usaches para rexistrar este DLC é distinta á que se usou para crear a túa conta de World of Trucks ou para rexistrar o xogo. Por favor, cambia a túa conta de Steam e téntao de novo." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "A conta de Steam que usas para rexistrar este DLC xa está asociada cunha conta de World of Trucks distinta. Para rexistrar o DLC á conta actual, tes que usar unha conta de Steam que non estea conectada a ningunha conta de World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "O identificador de Steam expirou. Por favor, tenta de novo máis tarde." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "A clave de serie usada para activar o DLC non é válida. Por favor, contacta co soporte técnico para obter axuda en: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Ocorreu un erro interno durante o rexistro do xogo. Por favor, téntao de novo máis tarde." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "FEITO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMACIÓN" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "EN LIÑA" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "EXPLORADOR DE CONTIDO" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Parabéns! Os DLCs seleccionados foron conectados satisfactoriamente coa túa conta de World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Non se puido conectar o contido porque a conta de Steam actual está asociada a unha conta de World of Trucks distinta." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Algúns DLCs non se poideron conectar.<br>Coloca o cursor sobre os signos de exclamación de cada DLC para ver máis detalles." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Rexistrando $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "O perfil actual non está conectado a World of Trucks ou o xogo está en modo fóra de liña. Edita o perfil para conectalo." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Fai clic para pechar"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLCs compatibles actualmente conectados. Se algúns dos DLCs non están conectados a World of Trucks podes perder algunhas das súas características." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Parabéns! <color value=@@clr_txt@@>Todo o teu contido está conectado a World of Trucks! Xa podes usar todas as súas funcións." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Non se puido conectar o novo contido a World of Trucks porque a conta de Steam usada actualmente non coincide coa usada polo perfil de World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Conectado" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Non conectado" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Non se puido obter información acerca do contido en propiedade." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Non se puido obter información acerca do contido conectado." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Non se puido obter información acerca da conta usada actualmente." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Máis tarde" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Non se puido rexistrar este DLC. Non se atopou unha licenza permanente probablemente a causa de Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Sen licenza permanente" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
