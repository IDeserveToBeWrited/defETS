#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Modo de rede non dispoñible. Por favor comproba que a configuración do cliente é correcta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Non se puido establecer unha conexión co servizo online. Por favor, revisa que estea funcionando a túa conexión de internet."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Error durante a comunicación co servizo online. Por favor inténtao de novo máis tarde."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Información errónea devolta polo servizo online. Se estás usando un proxy HTTP, comproba a súa configuración. Senón proba de novo máis tarde."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Datos incorrectos recibidos dende o servizo online. Por favor téntao de novo máis tarde."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "O servizo non é compatible con esta versión do xogo. Por favor comproba se hai dispoñible un novo parche."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "O servizo non está dispoñible actualmente. Por favor, téntao de novo máis tarde."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "O servizo está inactivo por mantemento ou sobrecarga. Por favor, téntao de novo máis tarde."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "A información de autenticación non é válida. Por favor proba a identificarte de novo."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "A conta online está actualmente bloqueada por mor de moitos intentos fallidos de identificación. Por favor téntao de novo en media hora."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "A conta online está actualmente bloqueada por accesos sospeitosos. Por favor téntao de novo en 24 horas."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Este xogo non está rexistrado nesta conta online."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "A conta aínda non foi activada. Por favor comproba na túa bandexa o email de activación de conta."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Esta conta está suspendida. Por favor contacta ó soporte técnico."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Esta conta está bloqueada. Por favor contacta ó soporte técnico."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Autenticación con proxy non está soportado por este xogo. Por favor usa un proxy diferente ou unha conexión directa."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "O obxecto requirido non está dispoñible. Por favor téntao de novo nuns minutos."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Erro de SSL. Non se puido establecer unha conexión segura."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Suspendeuse o xogo durante a comunicación en liña. Por favor, tenta de novo máis tarde."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Erro interno. O ficheiro net.log pode conter máis información."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "O Euro Truck Simulator 2 está a ter un problema e non é capaz de amosar gráficos no teu ordenador (non se atopou un dispositivo de gráficos válido).\nPasos recomendados:\n\n1. Comproba que o teu ordenador e tarxeta gráfica cumpren os requisitos mínimos de hardware.\n2. Actualiza o teu ordenador á última versión de Microsoft DirectX.\n3. Baixa e instala os últimos drivers gráficos para a túa tarxeta gráfica dende a web do fabricante - os teus drivers gráficos seica estean obsoletos.\n4. Proba mudando o método de renderizado do OpenGL a DirectX ou viceversa.\n5. Elimina o ficheiro de configuración do xogo 'config.cfg' na túa carpeta 'Documentos' - 'Euro Truck Simulator 2'. Podería estar corrupto.\n    Este ficheiro volverase crear de xeito automático con valores por defecto válidos na seguinte carga do xogo."

	key[]: "sys_no_graphics_simple"
	val[]: "O Euro Truck Simulator 2 está a ter un problema e non é capaz de amosar gráficos no teu ordenador (non se atopou tarxeta gráfica válida)."
#@}

