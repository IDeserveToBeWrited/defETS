#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Selección da imaxe que se amosa de fondo cando navegas polos menús."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Activa a selección aleatoria da imaxe de fondo cada vez que inicias o xogo."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Establece o tempo de retardo ata que os elementos da interface desaparecen."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, experimentarás os efectos da fatiga ao conducir durante moito tempo.<br><br>Non descansar resultará en infraccións de tráfico."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Ao activalo, tes que obedecer as normas de tráfico ou arriscaraste a recibir sancións. O risco aumenta preto de vehículos policiais, radares ou cámaras de tráfico."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Axusta a distancia media dos traballos que se ofertan."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona o límite de velocidade que se amosa no widget de navegación."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "O indicador da velocidade actual no widget vólvese vermello ao superar o límite de velocidade."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando chegas ao teu destino, amósase un widget que che permite omitir o aparcamento."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantén ocultos todos os widgets."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantén ocultos ámbolos espellos virtuais."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantén ocultas todas as notificacións, mesmo cando se reciben."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Amosa unha ventá indicando as capacidades do camión actual do xogador antes de aceptar un traballo de carga pesada."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona como se aliña o mapa do mundo."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Escolle como se explora o mapa do mundo:<br>- \"Exploración de proximidade\" marca como explorada unha área máis grande.<br>- \"Exploración precisa\" descubre só as áreas que están inmediatamente arredor do xogador."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona como debe amosarse a navegación."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia como se calcula a navegación:<br>- O modo \"mellor\" escolle a mellor relación entre a lonxitude e o tempo da ruta, tenta evitar cruzamentos con semáforos, etc.<br>- O modo \"máis curto\" escolle sempre a ruta máis curta posible.<br>- O modo \"estradas pequenas\" evita as autoestradas sempre que sexa posible."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a dificultade de aparcamento:<br>- \"Seleccionar sempre\" permite escoller ao chegar ao teu destino.<br>- \"Aparcamento fácil\" non require de manobras marcha atrás.<br>- \"Aparcamento difícil\" normalmente requirirá de manobras marcha atrás máis desafiantes."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Axusta a probabilidade de atopar perigos nas estradas, incluíndo accidentes, vehículos avariados, obxectos na calzada, etc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Axusta a probabilidade de atopar desvíos na túa ruta mentres conduces nun traballo."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Axusta a probabilidade de inclemencias meteorolóxicas."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Escolle se se amosa información da zona horaria ademais da hora actual."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Activa as escenas que se amosan despois da compra dun camión, ao mellorar un garaxe ou durante o embarque de pasaxeiros."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Escolle se se amosan bloqueadores semitranslúcidos nas estradas non accesibles."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverte o eixe Y do rato ao controlar a cámara durante o xogo."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona o tipo de transmisión:<br>- \"Automática simple\" permite o uso de acelerador e freo para controlar os movementos de avance ou retroceso.<br>- \"Automática real\" require premer un botón para cambiar entre as marchas de avance e retroceso.<br>- \"Secuencial\" require o cambio manual de todas as marchas, premendo os botóns correspondientes para subilas ou baixalas.<br>- O \"cambio en H\" require o uso dun controlador con panca de cambios en H para seleccionar as marchas manualmente."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Activar esta función permite saltar marchas cando sexa necesario ou práctico, para evitar pasar por todas as marchas da transmisión."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Retorna o volante ao centro cando se usa un teclado ou mando.<br><br>Se desactivas esta función terás que devolvelo manualmente ao centro despois de cada xiro."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Axusta o rango da animación do xiro do volante."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a intensidade dos freos."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a estabilidade do vehículo baixando o seu centro de gravidade."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a estabilidade do remolque baixando o seu centro de gravidade."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a intensidade do torque xerado pola transmisión.<br><br>Ao incrementar este valor aumentará a sensación de que o vehículo se retorce cara á dereita."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a dureza da suspensión do chasis."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a dureza da suspensión do cabina."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Axusta a intensidade das irregularidades superficiais xeradas proceduralmente para darlle ás estradas e outros terreos unha sensación de imperfección.<br><br>Dependendo doutros axustes de suspensión e cámara o efecto pode ser máis ou menos notable."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa o enganche avanzado, que require máis precisión para aliñar a quinta roda do camión co bulón rei do remolque.<br><br>Cando está desactivado, enganchar un remolque é moito máis sinxelo, xa que non hai colisión entre o bulón rei e a quinta roda."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona se os cabos do remolque reaccionan ao movemento e cales.<br><br><color value=@@clr_txt_d@@>Activar a animación en máis vehículos pode afectar ao rendemento en sistemas máis antigos."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Activa o limitador electrónico da velocidade do vehículo dependendo do modelo.<br><br><color value=@@clr_txt_d@@>Os traballos de World of Trucks sempre teñen esta función activada."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Ao activalo e co selector dos limpaparabrisas na primeira posición, estes activaranse automaticamente e axustarán a súa velocidade segundo as condicións meteorolóxicas."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa o funcionamento automático do retarder ao frear."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o vehículo asiste o arranque en pendente aplicando os freos, asegurando un arranque suave."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa o funcionamento automático do freo motor ao frear."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o motor arrancará nada máis usar o acelerador."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o freo de estacionamento do vehículo actívase por defecto (despois de usar un transbordador, ser remolcado a un taller, facer unha viaxe rápida, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Baixa automaticamente os eixes elevabeis cando sexa necesario dependendo do peso do vehículo."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o vehículo aplicará un nivel de acelerador reducido por defecto. Despois de premer rapidamente o botón do acelerador dúas veces, o vehículo aplicará o acelerador a fondo ata que deixes de premer o botón.<br><br>Afecta só ao uso con teclado."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simula a perda de aire causada polo uso excesivo dos freos.<br><br>Cando está activado, terás que controlar as presións do aire ao descender pendentes ou ao realizar manobras con múltiples aplicacións dos freos."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está desactivado, o consumo de combustible non se ve afectado polo estilo de condución ou as condicións da estrada.<br><br>Cando está activado, o consumo vese afectado por diversos factores, incluíndo o estilo de condución, o peso da carga, a resistencia á rodadura e o perfil do terreo. Xa non se ve afectado pola habilidade de @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o ABS evitará o bloqueo das rodas ao frear, para manter o control e mellorar a capacidade de freado."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o vehículo aplicará unha freada independente en cada roda para evitar a patinaxe, a subviraxe ou a sobreviraxe, co fin de manter o control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o vehículo bloqueará o diferencial automaticamente se as rodas comezan a patinar, para mellorar a tracción."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a diferenza de velocidade ao que o control de cruceiro aumentará ou diminuirá cando se preme o botón correspondente."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia a tolerancia do control de cruceiro para manter a velocidade seleccionada."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Cando está activado, o control de cruceiro controlará automaticamente a velocidade para manter unha distancia de seguridade co vehículo que circula diante."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa o freado de emerxencia se o sistema detecta unha colisión inminente.<br>Escolle se o sistema reacciona só a vehículos ou a todo tipo de obstáculos."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selección dos modos do asistente de carril:<br>- O modo \"aviso de saída de carril\" avísate acusticamente cando estás a piques de saír do carril.<br>- Ademais do aviso acústico, o modo \"asistencia de mantemento de carril\" tamén controla a dirección do teu vehículo para evitar que saia do carril.<br><br>Ámbolos modos só poden ser activados a velocidades superiores a 55 km/h (~35 mph).<br>O asistente de carril tamén ten en conta o teu uso dos intermitentes antes de activarse."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa as funcións do sensor de ángulo morto, sempre que o teu vehículo o equipe."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado e co selector das luces na primeira posición, os faros prenderanse automaticamente en situacións de pouca luz."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, e coas luces de longo alcance prendidas, o vehículo cambiará automaticamente ás luces de cruzamento cando detecte outro vehículo que se achega en sentido contrario ou que circula por diante de ti."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Ao activalo, os intermitentes apáganse automaticamente despois dun xiro cando o volante volve á súa posición central."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, algúns accesorios do interior (decoracións colgantes, figuras etc.) reaccionan ao movemento do vehículo."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa o xiro da cámara interior segundo o xiro da dirección."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia como de reactiva é a función de xiro da cámara coa dirección respecto ao xiro do volante."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia o comportamento da función de xiro da cámara coa dirección ao ir marcha atrás."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ao activalo, a cámara interior mira cara á esquerda ou á dereita segundo o uso dos intermitentes."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Ao activalo, a cámara interior reacciona aos movementos do vehículo."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia como de reactiva é a cámara interior respecto aos movementos do vehículo."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia canto se pode inclinar a cámara interior segundo os movementos do vehículo."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica canto cambia o campo de visión da cámara interior segundo a velocidade do vehículo."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece o retardo antes de que a cámara volve ao centro automaticamente.<br><br>O vehículo ten que moverse a unha velocidade apreciable para que se active esta función. Só aplica á cámara interior ou á persecutoria mentres te moves cara adiante, e á cámara para mirar por fóra da fiestra mentres te moves marcha atrás."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece a velocidade do movemento da cámara. Úsase para o centrado automático da cámara e cando cambias entre distintas cámaras internas."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determina o funcionamento do zoom da cámara interior: mantén premido o botón para facer zoom temporalmente, ou prémeo unha vez para activalo ou desactivalo." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona o idioma que se amosa no xogo."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Cambia os preaxustes de moeda e unidades segundo a rexión seleccionada."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, as cidades e os países amosaranse no teu idioma."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, as cidades e os países amosaranse tanto no teu idioma como no idioma nativo da rexión do mapa."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Escolle a moeda a usar."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona entre a notación horaria de 12 ou 24 horas."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona as unidades de distancia a amosar."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona as unidades de peso a amosar."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona as unidades de temperatura a amosar."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona as unidades de presión a amosar."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona as unidades de volume a amosar."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona as unidades de consumo a amosar."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Se está habilitado, abrirá o chat durante as sesións de convoi ao usar a tecla \"Activar\" (@@imv_nrm_activate@@)."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Se está habilitado, a barra do chat permanecerá activa despois de enviar unha mensaxe."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, as mensaxes do chat desaparecerán aos poucos segundos."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Cambia o tempo polo que se amosan as mensaxes do chat antes de desaparecer."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Cando está activado, amosaranse os nomes dos xogadores enriba dos seus vehículos nas sesións de convoi."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Abre un menú avanzado para configurar as respostas rápidas que podes usar nas sesións de convoi."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
