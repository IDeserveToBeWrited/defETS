	val[]: "Activa a iluminación dos faros principais dos outros vehículos do tráfico."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Activa a iluminación de luces secundarias dos outros vehículos do tráfico, como intermitentes, freo, etc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a distancia dende a cal poden verse as fontes de luz artificial.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Activa a presenza de peóns."
