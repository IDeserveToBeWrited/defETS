	key[]: "cancel_wizard"
	val[]: "Queres cancelar o asistente de entrada?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SELECCIONA O MÉTODO DE CONTROL" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Controladores"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>O asistente aplicará a configuración recomendada segundo os dispositivos conectados.<br><color value=@@clr_sel@@>Se estás usando un controlador compatible con Steam, considera activar o soporte para a súa configuración en <br><color value=@@clr_txt_d@@> \"Steam > Axustes > Controlador > Axustes xerales do controlador\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Conduce empregando o teclado e mira ó redor do mundo co rato. O máis sinxelo pero o control menos preciso."

	key[]: "wiz_control_mouse"
	val[]: "Usa o rato para ter maior precisión de xiro. Outras accións poden seguir executándose dende o teclado. Podes usar o rato para mirar ó redor só se premes simultáneamente unha tecla ou botón especial de cámara."

	key[]: "wiz_control_controller"
	val[]: "Utiliza un volante, mando ou joystick para a experiencia de xogo máis real. As teclas de acceso rápido do teclado poden ser usadas para moitas accións, e podes mirar libremente co rato (mirada co rato)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Non se atopou controlador de xogos. Tes que conectar un para activar esta opción!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Detectando controladores dispoñibles ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECT CONTROLLER API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - In-game Mapping Mode (recommended)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Steam Client Mapping Mode"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Controlador clásico"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepads like @@controller_ps5@@, @@controller_xbox_one@@ or @@controller_steam_deck@@ opted into the Steam Input interface and using simple layout.<br><br>Supports full in-game key binding configurations."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepads opted into the Steam Input interface and using standalone layouts configured through the Steam Client.<br><br>Limited support for in-game button hints and no in-game binding configurations."

	key[]: "wiz_api_classical"
	val[]: "Controller, driving wheel or joystick using DirectInput, XInput or similar interface."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELECT CONTROLLER TYPE"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volante de dirección"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Mando ou joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "O controlador é un volante ou actúa como tal. A posición do controlador especifica directamente a posición do volante no xogo."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "O controlador é un mando ou un joystick. A posición do controlador especifica a velocidade de rotación do volante no xogo."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECCIONAR O TIPO DE CAIXA DE CAMBIOS" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Preme AVANZAR para moverte cara adiante e preme ATRÁS para frear ou retroceder. A caixa de cambios controla todo o demais automaticamente, xestionando as transicións entre conducir, frear e marcha atrás, así como seleccionando as marchas adecuadas en cada momento."

	key[]: "wiz_gb_automatic"
	val[]: "Usa os botóns para cambiar entre a condución cara adiante, punto morto ou a marcha atrás. Despois preme o acelerador e deixa que a caixa de cambios cambie automaticamente as marchas."

	key[]: "wiz_gb_sequential"
	val[]: "Sube ou baixa as marchas manualmente para seleccionar unha marcha concreta da transmisión. Esta configuración proporciona un control total da caixa de cambios do vehículo."

	key[]: "wiz_gb_hshifter"
	val[]: "Selecciona a marcha desexada directamente, o que ofrece a configuración máis realista. Recoméndase unha panca de cambios en H e require o uso do embrague."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Esta función precisa dun volante, mando ou joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Non se detectou ningún controlador de panca de cambios en H; esta característica podería non ser funcional."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECCIONAR ESQUEMA DA PANCA DE CAMBIOS"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Transmisión de rango é a elección máis simple. Ten dous grupos de marchas. O primeiro grupo contén as marchas 1 á 6 e o segundo grupo ten as marchas 7 á 12. Un botón de cambio establece o grupo que se usará mentres o shifter selecciona unha marcha específica do grupo."

	key[]: "wiz_hs_splitter"
	val[]: "Transmisión de divisor é unha elección alternativa. Tamén ten dous grupos de marchas. O primeiro grupo ten as marchas impares (1, 3, 5 ...) e o segundo grupo contén as marchas pares (2, 4, 6 ...). Un interrumptor intercambia entre os dous grupos para que o shifter seleccione cada marcha específica do grupo."

	key[]: "wiz_hs_range_splitter"
	val[]: "A transmisión por rango e divisor baséase na configuración das transmisións reais. As marchas agrúpanse en catro por cada posición da panca de cambios en H e empregan dous conmutadores. Esta opción só se recomenda a condutores avanzados."
#@}

#@}

