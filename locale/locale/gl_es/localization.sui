#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Selecciona o subtipo de controlador para que o xogo controle correctamente os rangos das entradas."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Selecciona o tipo de transmisión:<br>- \"Automática simple\" permite o uso de acelerador e freo para controlar os movementos de avance ou retroceso.<br>- \"Automática real\" require premer un botón para cambiar entre as marchas de avance e retroceso.<br>- \"Secuencial\" require o cambio manual de todas as marchas, premendo os botóns correspondientes para subilas ou baixalas.<br>- O \"cambio en H\" require o uso dun controlador con panca de cambios en H para seleccionar as marchas manualmente."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Cambia a lóxica do cambio de marchas da transmisión automática:<br>- O modo \"Economía\" prefire revolucións baixas e traballar próximo ao par máximo.<br>- O modo \"Potencia\" prefire revolucións altas e manterse preto da potencia máxima para un mellor rendemento con cargas pesadas ou en terreo montañoso, a expensas dun maior gasto de combustible."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a relación entre os graos de xiro do dispositivo e os graos de xiro da dirección do vehículo."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a linearidade entre o xiro do dispositivo de entrada e a dirección do vehículo.<br><br>Axustar un valor maior resulta nunha dirección menos sensible cando o volante está centrado, e volverase máis sensible cando se xira o volante cara ao tope. Isto pode axudar para suavizar as ordes de xiro ao conducir en liña recta."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Activa a forza de resposta (force feedback) nos controladores que a admiten."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a ganancia xeral para todas as configuracións da forza de resposta entre 0 N y 10 N.<br><br><color value=@@clr_txt_d@@>Ten en conta que axustar isto a un valor alto en bases de volante potentes pode causar lesións en dedos ou mans."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a forza de centrado ao conducir a alta velocidade, acadando o punto máximo a partir de 90 km/h (56 mph).<br><br>Axustalo ao mínimo fará que non haxa forza de centrado do volante."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a forza de centrado ao conducir a baixa velocidade.<br><br>Axustalo ao mínimo fará que non haxa forza de centrado do volante."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade da fricción interna artificial causada polos compoñentes mecánicos da dirección."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade da resonancia artificial do motor a través da columna da dirección.<br><br><color value=@@clr_txt_d@@>Ten en conta que axustar este valor por riba de 15% pode causar sacudidas e vibracións excesivas nalgúns volantes."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade dos efectos da superficie da estrada a través da columna da dirección.<br><br><color value=@@clr_txt_d@@>Ten en conta que axustar este valor por riba de 20% pode causar sacudidas e vibracións excesivas nalgúns volantes ao circular rápido sobre terreos irregulares."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade dos efectos das fochancas a través da columna da dirección."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade dos efectos das colisións a través da columna da dirección."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade dos efectos do rascado da caixa de cambios."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade dos efectos do subviraxe."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade da asistencia á dirección (cando se usa a función de asistencia de carril)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade das vibracións provocadas pola superficie do terreo, se o controlador admite a vibración."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade das vibracións provocadas polas fochancas, se o controlador admite a vibración."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a intensidade das vibracións provocadas polas colisións, se o controlador admite a vibración."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo usado para a dirección."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a zona morta do eixo da dirección; a cantidade de rotación dende o centro ata a cal se ignora a orde.<br><br>Isto pode mitigar problemas en controladores máis antigos, como imprecisións ou falsas entradas causadas polo desgaste."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como xestiona o xogo a entrada do eixo da dirección:<br>- Centrado: ideal \npara volantes ou joysticks.<br>- Invertido: utilizase para corrixir un eixo que se detectou de forma errónea."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo usado para acelerar."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a zona morta do eixo do acelerador; a cantidade de percorrido inicial na cal se ignora a orde.<br><br>Isto pode mitigar problemas en controladores máis antigos, como imprecisións ou falsas entradas causadas polo desgaste."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como xestiona o xogo a entrada do controlador:<br>- Centrado é ideal \npara joysticks.<br>- Normal é ideal para gatillos ou pedais.<br>- Invertido pode corrixir entradas que se detectaron de forma errónea."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo usado para frear."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a zona morta do eixo do freo; a cantidade de percorrido inicial na cal se ignora a orde.<br><br>Isto pode mitigar problemas en controladores máis antigos, como imprecisións ou falsas entradas causadas polo desgaste."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como xestiona o xogo a entrada do controlador:<br>- Centrado é ideal \npara joysticks.<br>- Normal é ideal para gatillos ou pedais.<br>- Invertido pode corrixir entradas que se detectaron de forma errónea."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo usado para accionar o embrague."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a zona morta do eixo do embrague; a cantidade de percorrido inicial na cal se ignora a orde.<br><br>Isto pode mitigar problemas en controladores máis antigos, como imprecisións ou falsas entradas causadas polo desgaste."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como xestiona o xogo a entrada do controlador:<br>- Centrado é ideal \npara joysticks.<br>- Normal é ideal para gatillos ou pedais.<br>- Invertido pode corrixir entradas que se detectaron de forma errónea."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Axusta o rango do embrague.<br><br>Canto máis á dereita movas a barra, máis terás que pisar o pedal para acoplar o embrague."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo usado para inclinar a cámara cara arriba e abaixo."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a zona morta do eixo de mirar cara arriba e abaixo; a cantidade de percorrido inicial na cal se ignora a orde.<br><br>Isto pode mitigar problemas en controladores máis antigos, como imprecisións ou falsas entradas causadas polo desgaste."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como xestiona o xogo a entrada do eixo:<br>- Centrado: ideal \npara joysticks.<br>- Invertido: utilizase para corrixir un eixo que se detectou de forma errónea."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo usado para xirar a cámara á esquerda e á dereita."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Axusta a zona morta do eixo de mirar á esquerda e dereita; a cantidade de percorrido inicial na cal se ignora a orde.<br><br>Isto pode mitigar problemas en controladores máis antigos, como imprecisións ou falsas entradas causadas polo desgaste."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como xestiona o xogo a entrada do eixo:<br>- Centrado: ideal \npara joysticks.<br>- Invertido: utilizase para corrixir un eixo que se detectou de forma errónea."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Selecciona a disposición das marchas a usar coa panca de cambios en H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Cambia o comportamento da panca de cambios:<br>- Coa opción 'Simple' nunca farás rascar as marchas ao cambiar.<br>- A opción 'Simple + sons de advertencia' tamén che permite cambiar, pero con ruídos se non cambias ben.<br>- A opción 'Avanzado' non che permitirá cambiar de marcha se cambias de forma incorrecta, e só obterás ruídos do rascado dos engrenaxes. Esta opción tamén permite usar a configuración 'divisor rápido do cambio'."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Escolle como xestiona o xogo o divisor rápido do cambio:<br>- \"Nunca\" require mover a panca a punto morto entre divisións.<br>- \"Presión do embrague\" require pisar momentaneamente o embrague sen mover a panca de cambios.<br>- \"Soltar o acelerador\" require só soltar o acelerador para facer a división sen mover a panca.<br>-\"Embrague ou acelerador\" é unha combinación das dúas últimas."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a posición da panca de cambios."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Asigna a entrada usada para alternar entre os rangos segundo o esquema da panca de cambios."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Asigna un botón para alternar o divisor do cambio segundo o esquema da panca de cambios."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Activar cando uses interruptores en vez de botóns para as entradas de rango ou divisor."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Asigna un botón para cambiar ao modo de avance da transmisión automática."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
