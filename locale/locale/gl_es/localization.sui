#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuar ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Benvido/a a Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Por fin tes a oportunidade de experimentar o teu traballo soñado, conducir un camión!"

	key[]: "intro_3"
	val[]: "A túa compañía de transportes xa está aberta como negocio, pero non tes cartos para mercar un camión. Por agora terás que traballar para outras compañías como condutor contratado."

	key[]: "intro_4"
	val[]: "A túa tarefa é a de entregar con seguridade unha carga de $JOB_CARGO$ ó almacén de $JOB_TARGET_COMPANY$ en $JOB_TARGET_CITY$. O teu encargado proporcionouche un camión e pagará tódolos gastos. Non decepciones a ninguén e chega a tempo."


	key[]: "intro_garage_1"
	val[]: "Esta é a túa sede."

	key[]: "intro_garage_2"
	val[]: "É un garaxe moi básico. Pode parecer pouca cousa, pero é un comezo."

	key[]: "intro_garage_3"
	val[]: "Desafortunadamente, non tes nada que aparcar aquí de momento, polo que non hai camións á vista."

	key[]: "intro_garage_4"
	val[]: "Unha vez que gañes diñeiro suficiente e compres un camión, poderás moverte polo mundo libremente e xestionar o teu propio negocio dende aquí."

	key[]: "intro_garage_5"
	val[]: "Boa sorte!"


	key[]: "desktop_tut_t"
	val[]: "FUNCIÓN DESBLOQUEADA"

	key[]: "desktop_tut_job"
	val[]: "Selecciona a seguinte tarefa"

	key[]: "desktop_tut_cargo_market"
	val[]: "Usa o teu novo remolque para accederes ó Mercado de Cargas e entregar unha grande variedade de cargas até os seus destinos." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Aquí podes ver o teu progreso."

	key[]: "desktop_tut_company"
	val[]: "Controla os teus garaxes, contrata novos condutores e xestiona a túa compañía dende aquí."

	key[]: "desktop_tut_trailers"
	val[]: "A partir de agora, podes mercar os teus propios remolques e melloralos ou pintalos para que vaian a xogo co teu camión.<br><br>Os teus remolques pódense gardar no garaxe que escollas; pódenos empregar os teus condutores para aumentar os beneficios. Para xestionar os teus remolques, usa o Xestor de Remolques."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visita $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Use the Mode button to switch between different desktop modes and different vehicle types."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BENVIDO/A"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Dámoste a benvida á nova pantalla de inicio.<br>Dende aquí podes interactuar con todas as novas funcionalidades do xogo."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Abaixo, o menú principal proporciona acceso directo a todas as funcións básicas do xogo coas que xa estás familiarizado."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Na parte superior, a nova barra de estado ofrece unha visibilidade constante das estadísticas do teu perfil e as normativas locais de circulación."

	key[]: "desktop_tut_tour_home"
	val[]: "O botón de inicio sempre estará aí para levarte de novo á pantalla de inicio."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Un menú rápido permanente proporciona un acceso cómodo a todas as funcións do xogo dende calquera pantalla."

	key[]: "desktop_tut_tour_drive"
	val[]: "O renovado botón de conducir segue sendo a túa conexión co mundo da condución, sempre listo para devolverte á estrada."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TITORIAL FINALIZADO"

	key[]: "desktop_tut_tour_finish"
	val[]: "Grazas por botar unha ollada á nosa actualización da pantalla de inicio."


	key[]: "desktop_vehicle_mode_reenable_hints_t"
    val[]: "ACTIVAR SUXESTIÓNS"

    key[]: "desktop_vehicle_mode_reenable_hints"
    val[]: "Estás a entrar nun modo de xogo novo e as suxestións contextuais, que che poden axudar a aprender a xogar, están desactivadas. Queres volver a activalas?"
#@}


