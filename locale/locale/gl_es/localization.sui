#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "SEGUIMENTO DA MIRADA" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Vista ampliada" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Predefinidos da vista ampliada" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Inserir nome do predefinido" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Seguro que queres eliminar o predefinido escollido?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "O predefinido existente co mesmo nome será substituído. Desexas continuar?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Axustes do seguimento da mirada" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Axustes do seguimento da cabeza" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Controis do teclado" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Activar vista ampliada" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Activar autocentrado" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Modo do seguimento da cabeza" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Directo" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinámico" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Resposta do seguimento da mirada" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Resposta do seguimento da cabeza" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Enable roll" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Activar posición" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Multiplicador de xiro (na cabina)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Multiplicador de inclinación (na cabina)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Multiplicador de xiro (no modo camiñar)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Multiplicador de inclinación (no modo camiñar)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Ángulo máximo da mirada" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Velocidade do seguimento da mirada"

	key[]: "eye_gaze_exponent"
	val[]: "Expoñente do seguimento da mirada"

	key[]: "eye_gaze_inflection_point"
	val[]: "Punto de inflexión do seguimento da mirada"

	key[]: "eye_gaze_start_point"
	val[]: "Punto inicial do seguimento da mirada"

	key[]: "eye_gaze_end_point"
	val[]: "Punto final do seguimento da mirada"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Head tracking yaw sensitivity (in cabin)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Head tracking pitch sensitivity (in cabin)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Head tracking yaw sensitivity (in walk mode)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Head tracking pitch sensitivity (in walk mode)"

	key[]: "eye_head_exponent"
	val[]: "Expoñente do seguimento da cabeza"

	key[]: "eye_head_inflection_point"
	val[]: "Punto de inflexión do seguimento da cabeza"

	key[]: "eye_head_start_point"
	val[]: "Punto inicial do seguimento da cabeza"

	key[]: "eye_head_end_point"
	val[]: "Punto final do seguimento da cabeza"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Enables the Extended View which increases your view angle by using head and/or eye movement to control the in-game camera."

	key[]: "eye_preset_op_tooltip"
	val[]: "Selection of the Extended View presets."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Selection of head tracking modes:<br>- In the \"Direct\" mode your head rotation directly corresponds to a camera rotation in-game. It is recommended in normal cockpit/cabin situations.<br>- In the \"Dynamic\" mode your gaze will only affect your in-game camera when you actually turn your head. It is recommended when it's important for your view to be absolutely centred."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "When enabled, the in-game camera will continuously slowly recentre as you change your head’s natural position during play."

	key[]: "eye_head_position_op_tooltip"
	val[]: "When enabled, your head’s position affects the in-game camera position."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "When enabled, the in-game camera will tilt accordingly when you tilt your head to either side."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multiplies the combined head and gaze rotation in the horizontal direction (in cabin)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multiplies the combined head and gaze rotation in the vertical direction (in cabin)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multiplies the combined head and gaze rotation in the horizontal direction (in walk mode)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multiplies the combined head and gaze rotation in the vertical direction (in walk mode)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Adjusts how quickly the in-game camera will respond to your gaze movements."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Adjusts how gradually the speed ramps up."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Adjusts the distance from the centre of the screen where the acceleration will start to level out."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Adjusts how far from the centre of the screen you’ll have to look before the in-game camera starts to move."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Adjusts how far from the centre of the screen you’ll have to look in order to reach maximum camera speed."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Determines how far the camera can turn when you look to the edges of the screen."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Adjusts how quickly the in-game camera will respond to your head movements."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Adjusts how much the in-game camera will turn left or right compared to how much you turn your head (in cabin)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Adjusts how much the in-game camera will turn up or down compared to how much you turn your head (in cabin)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Adjusts how much the in-game camera will turn left or right compared to how much you turn your head (in walk mode)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Adjusts how much the in-game camera will turn up or down compared to how much you turn your head (in walk mode)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Adjusts how gradually the speed ramps up."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Adjusts how much you have to rotate your head before the acceleration starts to level out."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Adjusts how much you have to rotate your head from the centre position before the in-game camera starts to move."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Adjusts how much you have to rotate your head from the centre position in order to reach maximum camera rotation."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Selection of the autopause modes."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Adjusts the amount of time in milliseconds before the game will automatically pause when it can’t detect your gaze."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Asigna un botón para establecer a posición actual da túa cabeza como a nova posición predeterminada, volvendo a centrar a cámara do xogo en consecuencia."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Asigna un botón para activar ou desactivar as funcións de vista ampliada de Tobii."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Asigna un botón para abrir os axustes de seguimento da mirada."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Asigna un botón para activar o seguimento da cabeza."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Asigna un botón para aplicar o predefinido da vista ampliada correspondente."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Asigna un botón para aplicar o predefinido da vista ampliada correspondente."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Asigna un botón para aplicar o predefinido da vista ampliada correspondente."
