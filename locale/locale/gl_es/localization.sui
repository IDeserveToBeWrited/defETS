	key[]: "adjust_link_t"
	val[]: "Axustes do vehículo" #+ Icon opening the adjuster. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "lights"
	val[]: "Axustar luces" #+ Opens the light adjuster.

	key[]: "truck_light_help"
	val[]: "Configura as luces instaladas no teu camión." #+ Help message associated with light adjuster icon.

	key[]: "mirrors"
	val[]: "Axustar espellos" #+ Opens the mirror adjuster.

	key[]: "truck_mirror_help"
	val[]: "Axusta os espellos para controlar mellor os teus arredores." #+ Help message associated with mirror adjuster icon.

	key[]: "seat"
	val[]: "Axustar asento"  #+ Opens the seat adjuster.

	key[]: "truck_seat_help"
	val[]: "Axusta o asento do condutor e o volante para o máximo confort." #+ Help message associated with seat adjuster icon.

	# trailer adjuster name string is in assistance section (it could be open from both screens)

	key[]: "trailer_adjust_help"
	val[]: "Axusta a lonxitude ou outras características do teu remolque para adaptalo mellor á mercadoría que queres levar. Isto afecta ás ofertas do mercado de cargas." #+ Help message associated with trailer adjuster icon.
#@}

