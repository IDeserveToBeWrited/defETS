	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "You are currently delivering to a company that is inactive in this session.<br>If you wish to connect, deliver your job first or it will be suspended and unavailable while in this session.<br><br>Do you wish to continue?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "You are currently delivering to a company that is inactive in this session.<br>If you wish to connect, deliver your job first or it will be canceled.<br><br>Do you wish to continue?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "A company near your truck or trailer will need to be activated in order for you to join this session.<br>To avoid any problems, please move your truck and trailer further away from the company or your current job will be suspended and unavailable in this session and you will be teleported to the nearest service.<br><br>Do you wish to continue?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "A company near your truck or trailer will need to be activated in order for you to join this session.<br>To avoid any problems, please move your truck and trailer further away from the company or your current job will be canceled and you will be teleported to the nearest service.<br><br>Do you wish to continue?"

	key[]: "mp_warning_vehicle_close_cancel_teleport"
	val[]: "A company near where you left your vehicle or trailer will need to be activated in order for you to join this session.<br>To avoid any problems once you return to your vehicle you will be teleported to the nearest service.<br><br>Do you wish to continue?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Your selected job is delivering from or to a company that is inactive in this session and will not be available once you connect.<br><br>Do you wish to continue?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Your cargo is located in a company that is inactive in this session.<br>If you wish to connect, load your cargo or your current job will be suspended and unavailable in this session.<br><br>Do you wish to continue?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Your job was canceled as it was delivering to a company that is inactive in this session."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Your job was canceled as spacial jobs are not supported in convoy."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Your selected job is no longer available as it was from a company that is inactive in this session."

	key[]: "mp_warning_load_teleport"
	val[]: "Your truck was teleported to the nearest service as the saved location was too close to a company that was activated to match this session."

	key[]: "mp_warning_load_cancel_teleport"
