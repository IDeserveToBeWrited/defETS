#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRÁFICOS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Gráficos" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Adjust graphics settings using finely-tuned presets to tailor your game's visual performance to your liking."

	key[]: "apply"
	val[]: "Aplicar" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Tema de Escritorio" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "IMAXE" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "CALIDADE DA IMAXE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURAS" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEXOS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SOMBRAS" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ILUMINACIÓN" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POSPROCESAMENTO" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "AMBIENTE" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Pantalla completa" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Brillo / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Configurar" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Resolución" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Taxa de refresco" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Límite de fps" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Límite de fps en segundo plano" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Refresco por defecto" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Sincronización vertical" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Económico (Aforra enerxía en portátiles)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "AXUSTES GRÁFICOS SIMPLES" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "APLICADAS OPCIÓNS PERSONAIS" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "OPCIÓNS GRÁFICAS AVANZADAS" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Axustes gráficos simples / avanzados" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Agochar axustes avanzados" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Amosar axustes avanzados" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Escalado" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Antialiasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Nitidez de luminancia do TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Axuste do TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Claridade adaptativa" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Sempre suave" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Sempre nítido" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Oclusión ambiental do espazo da pantalla (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Rango Dinámico Alto (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Profundidade de campo (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Raios solares" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Correción da cor" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Calidade dos reflexos" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detalle dos reflexos" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detalle da vexetación" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densidade de herba" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Calidade das sombras"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Tamaño da textura de sombra" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Sombras distantes" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Sombras interiores" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Calidade da meteoroloxía"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Calidade dos espellos" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Resolución dos espellos" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Distancia dos espellos" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Calidade das texturas" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtrado anisotrópico" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Mapeado normal" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Alumbrado do tráfico" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Luces secundarias do vehículo" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Rangos de visibilidade de luces" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Peóns" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "A configuración gráfica cambiou.<br>Queres manter esta configuración?"

	key[]: "reverting_in"
	val[]: "Revertendo en" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "segundos" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Cando está activado, o xogo amosarase a pantalla completa."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Axusta o brillo xeral do xogo para adaptarse á túa pantalla. En dispositivos compatibles con HDR, a opción de calibración do HDR estará dispoñible neste axuste."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Modifica a resolución do xogo."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Modifica a taxa de refresco da imaxe do xogo."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Sincroniza a velocidade de fotogramas coa taxa de refresco do monitor para evitar rachos na imaxe. O modo económico reduce á metade a taxa de fotogramas, o que reduce o consumo de enerxía."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Establece a velocidade de fotogramas máxima permitida no xogo.<br><br>Ao establecer este valor como 0 desactívase a función."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Establece a velocidade de fotogramas máxima permitida no xogo cando está minimizado en segundo plano.<br><br>Ao establecer este valor como 0 desactívase a función."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Cambia entre os axustes gráficos simples (predefinidos) ou avanzados (coa posibilidade de cambiar os parámetros individualmente)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Mellora a fidelidade gráfica ao renderizar o xogo a unha resolución maior internamente, o que reduce os bordos irregulares e aumenta o detalle.<br>Por exemplo, seleccionar unha opción de escalado maior produce unha imaxe máis nítida e menos borrosa, mellorando o aspecto do xogo pero a costa do rendemento.<br><br><color value=@@clr_txt_d@@>A miúdo, esta función ten un impacto alto no rendemento."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Selección de métodos de antialiasing de alta velocidade que suavizan a aparición de bordos irregulares no xogo.<br>- SMAA toma mostras de cada píxel varias veces (dependendo da calidade seleccionada), en distintas localizacións do fotograma e promedia as mostras para producir a imaxe final.<br>- TAA toma mostras de cada píxel só unha vez por fotograma, pero tómaas en diferentes localizacións e fotogramas.<br>- Para o mellor resultado tamén podes seleccionar unha combinación dos dous métodos, en detrimento do rendemento.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Engade sombras suaves a fendeduras e obxectos que se atopan moi preto uns dos outros, mellorando a fidelidade gráfica percibida en todo o mundo do xogo.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Selecciona a preconfiguración de TAA:<br>- \"Sempre suave\" produce menos pestanexo/máis desenfoque - é apropiado para usuarios de PC que activan o supersampling ou que teñen un monitor cun DPI alto, pero tamén para usuarios de TV a 1080p que se sentan máis lonxe da súa pantalla.<br>- \"Sempre nítido\" produce máis pestanexo/menos desenfoque - probablemente sexa a mellor opción para un uso por debaixo de 1080p, como en portátiles ou en Steam Deck.<br>- \"Claridade adaptativa\" desactiva dinamicamente o TAA se a cámara está estática.<br><br><color value=@@clr_txt_d@@>Este axuste só pode usarse cando se selecciona TAA como modo de antialiasing."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a intensidade da nitidez de luminancia do TAA.<br><br><color value=@@clr_txt_d@@>Este axuste só pode usarse cando se selecciona TAA como método de antialiasing."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Cando está activado as áreas distantes vólvense borrosas artificialmente para crear un efecto realista de perda de enfoque."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Cando está activado, pódense ver raios de luz ao mirar cara ao sol directamente, ou a través de obxectos como árbores, edificios ou vehículos."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Cando está activado as cores no xogo axústanse dinamicamente por razóns estéticas. As escenas corresponderanse mellor coa hora do día e as condicións meteorolóxicas, as cores dos vehículos e outros obxectos poderán ser máis vibrantes, etc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Mellora os reflexos ao renderizalos internamente a unha calidade maior, así como usando un mellor antialiasing.<br><br><color value=@@clr_txt_d@@>Os cambios deste axuste só se aplicarán despois de reiniciar manualmente o xogo."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta o detalle dos reflexos que se ven sobre as superficies e os cristais dos vehículos, e outras superficies como charcos, estradas molladas ou masas de auga.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento.<br><br>Os cambios deste axuste só se aplicarán despois de reiniciar manualmente o xogo."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta o detalle e complexidade de plantas e árbores.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a densidade da herba aos lados das estradas.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a calidade das sombras proxectadas polo sol e a lúa.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Activa o renderizado de sombras mesmo de obxectos moi distantes.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Activa as sombras dinámicas nocturnas no interior do vehículo.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a calidade dos efectos meteorolóxicos, como os reflexos."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a calidade dos reflexos que se ven nos espellos do vehículo (independentemente dos axustes dos reflexos).<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a resolución da imaxe que se proxecta nos espellos do vehículo."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a distancia á que os obxectos comezan a renderizarse nos espellos.<br><br><color value=@@clr_txt_d@@>A miúdo, esta función ten un impacto alto no rendemento."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Axusta a calidade dalgunhas texturas que se aplican a obxectos e superficies do xogo."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Mellora a nitidez das texturas, especialmente as que se ven a distancia ou en ángulo oblicuo.<br><br><color value=@@clr_txt_d@@>Os cambios deste axuste só se aplicarán despois de reiniciar manualmente o xogo."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Engade a aparencia de detalles xeométricos a pavimentos, estradas e outros obxectos para mellorar o seu aspecto.<br><br><color value=@@clr_txt_d@@>Normalmente, este axuste ten un impacto moderado no rendemento.<br><br>Os cambios deste axuste só se aplicarán despois de reiniciar manualmente o xogo."

