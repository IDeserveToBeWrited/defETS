	key[]: "wiz_auto_cfg_done"
	val[]: "O xogo está configurado agora usando os valores por defecto descritos debaixo. Podes axustalos usando a configuración avanzada ou continuar directamente ó xogo."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Configuración avanzada"
#@}

#+ Configuration complete page
