	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "O vehículo piloto <color value=@@clr_sel@@>dianteiro<color value=@@clr_txt@@> agarda a que o carril designado estea libre e entón cambia de carril tamén."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Entón é seguro para o <color value=@@clr_sel@@>xogador<color value=@@clr_txt@@> moverse ó carril designado."

