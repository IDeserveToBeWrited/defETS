	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Usa @@imm_wiz_dsteerleft@@ e @@imm_wiz_dsteerright@@ para xirar."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Move o rato a esquerda e dereita para xirar o volante hacia a dirección desexada."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Usa @@ima_wiz_j_steer@@ para xirar."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Usa @@imm_wiz_dforward@@ para avanzar e usa @@imm_wiz_dbackward@@ para retroceder."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Move @@ima_wiz_j_throttle@@ cara adiante para avanzar e móveo cara atrás para retroceder."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Usa @@ima_wiz_j_throttle@@ para avanzar e usa @@ima_wiz_j_brake@@ para retroceder."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Usa @@imm_wiz_dforward@@ para acelerar e usa @@imm_wiz_dbackward@@ para frear."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Move @@ima_wiz_j_throttle@@ cara adiante para acelerar e móveo cara atrás para frear."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Usa @@ima_wiz_j_throttle@@ para acelerar e usa @@ima_wiz_j_brake@@ para frear."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Usa @@imv_wiz_gearup@@ para avanzar e @@imv_wiz_geardown@@ para retroceder."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Usa @@imv_wiz_gearup@@ para moverte cara adiante e @@imv_wiz_geardown@@ para moverte cara atrás se usas o teclado ou botóns dun controlador. Usa @@imv_wiz_drive@@ e @@imv_wiz_reverse@@ para escoller a dirección da marcha se usas unha panca de cambios en H."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Usa @@imv_wiz_gearup@@ e @@imv_wiz_geardown@@ para escoller a marcha desexada."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Usa a túa panca de cambios en H con @@ima_wiz_j_clutch@@ para seleccionar a marcha desexada."
