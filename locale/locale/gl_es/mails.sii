SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "Sistema" #+ Message sender
		subject: "Mensaxe de proba" #+ Message subject
		body: "Ola!<br><br>Esta é unha mensaxe de proba do teu compañeiro administrador ;-)<br><br>Saúdos" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "Banco" #+ Message sender
		subject: "Necesitas cartos? Podemos axudarte!" #+ Message subject
		body: "Estimado/a señor/a,<br><br>Pensamos que che podería gustar coñecer as nosas ofertas en préstamos a novos empresarios. Precisas de financiación para lanzar o teu negocio? Estamos aquí para axudar! Por favor $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>visita o teu banco local</link> para máis información.<br><br>Atentamente,<br>Representante de vendas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "Banco" #+ Message sender
		subject: "Podémosche axudar a medrar" #+ Message subject
		body: "Estimado/a Señor/Señora,<br><br>Non puidemos evitar fixarnos nas súas ganancias estables e gustaríanos axudarlle a desenvolver o seu potencial aínda máis. Aumentouse o límite do seu crédito a $MONEY$. Non teña problema en obter a cantidade dispoñible en calquera momento no seu $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>banco local</link>.<br><br>Saúdos cordiais,<br>Director de vendas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "Banco" #+ Message sender
		subject: "A túa conta ten un descuberto" #+ Message subject
		body: "Estimado cliente,<br><br>Retiraches máis cartos da túa conta dos que había dispoñibles. Proporcionámosche un crédito a curto prazo para os próximos días, sen intereses, para que poidas resolver a situación. Por favor, fai o pago do teu crédito o antes posible.<br><br>Saúdos cordiais,<br>O teu Administrador de Contas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "Banco" #+ Message sender
		subject: "O teu balance é negativo!" #+ Message subject
		body: "Estimado cliente,<br><br>O teu balance bancario é negativo! Por favor, fai o pago da túa débeda nos próximos $DAYS$ ou verémonos na obriga de confiscar a túa propiedade.<br><br>Atentamente,<br>Administrador de Contas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "Banco" #+ Message sender
		subject: "Última advertencia!" #+ Message subject
		body: "Estimado cliente,<br><br>Este é o último aviso. A súa conta do banco ten un descuberto. Por favor, faiga o pago antes de mañá ou teremos que confiscar as súas propiedades para cubrir a débeda.<br><br>Atentamente,<br>O Administrador de Contas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "Banco" #+ Message sender
		subject: "Descuberto superado" #+ Message subject
		body: "Estimado cliente,<br><br>O descuberto da súa conta foi resolto. Estamos contentos de axudarlle se no futuro necesitase os nosos servizos.<br><br>Que teña un bo día,<br>O Administrador de Contas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "Banco" #+ Message sender
		subject: "O teu camión persoal foi vendido" #+ Message subject
		body: "Estimado Cliente,<br><br>Lamentamos informarche de que tivemos que vender o teu camión persoal - $TRUCK_NAME$ - por $MONEY$. Desafortunadamente, tiñas unha débeda de longo prazo connosco e non tiñamos outro xeito de cubrila. Tristemente, non houbo ningunha maneira de evitar esas medidas extremas. Suxerísmosche que conduzas en traballos rápidos até que a túa situación financeira mellore.<br><br>Saúdos,<br>O administrador de contas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "Banco" #+ Message sender
		subject: "O teu remolque persoal foi vendido" #+ Message subject
		body: "Estimado Cliente,<br><br>Lamentamos informarlle de que tivemos que vender o seu remolque persoal - $TRAILER_NAME$ - por $MONEY$. Desafortunadamente, tiña unha débeda de longo prazo connosco e non tíñamos outro xeito de cubrila. Tristemente, non houbo ningunha maneira de evitar estas medidas extremas. Suxerísmoslle que conduza en traballos rápidos até que a súa situación financeira mellore.<br><br>Saúdos,<br>O administrador de contas<br>Banco" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "Banco" #+ Message sender
		subject: "A túa propiedade foi vendida" #+ Message subject
		body: "Estimado cliente,<br><br>Por mor dunha débeda de longo prazo na túa conta tivemos que embargar e vender a túa propiedade. Os fondos recuperados na suma total de <br>$MONEY$ foron usados para satisfacer as túas obrigas. En particular, estes obxectos foron confiscados:<br><br>$ITEM_LIST$<br>Lamentamos que a situación chegase tan lonxe, e esperamos que as consecuencias non danen os teus esforzos futuros en exceso.<br><br>Cos mellores desexos,<br>O teu administrador de contas<br>Banco" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "Vendedor de camións - $CITY$" #+ Message sender
		subject: "Novos camións $BRAND$ en venda!" #+ Message subject
		body: "Estimado/a Sr./Sra.,<br><br>Somos vendedores recoñecidos de camións $BRAND$. Ofrecemos unha ampla selección de configuracións distintas e tamén realizamos personalizacións para satisfacer calquera desexo especial. Por favor, $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>visita o noso concesionario en $CITY$</link>. O camión que sempre soñaches podería estar agardándote detrás da porta.<br><br>Saúdos cordiais,<br>O teu vendedor de $BRAND$" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "Concesionario de camións usados" #+ Message sender
		subject: "Camións usados á venda!" #+ Message subject
		body: "Estimado/a Sr./Sra.,<br><br>Alégranos anunciar a apertura do noso concesionario de camións usados, o teu novo destino de referencia para atopar camións de segunda man de gran calidade! Tanto se estás a procurar unha potente máquina ou simplemente un vehículo de traballo fiábel, temos o camión perfecto para ti.<br><br>Por favor, explora as nosas $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>ofertas de camións usados</link>. Confiamos en que atoparás o camión perfecto que se axusta ás túas necesidades.<br><br>Atentamente,<br><br>O equipo do concesionario de camións usados<br><br>P.D.: Non te esquezas de visitarnos regularmente para descubrir as últimas novidades! O noso inventario muda continuamente, polo que non sabes que ofertas podes atopar." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "Condutores requiridos co seu propio equipamento" #+ Message subject
		body: "A quen lle poida interesar,<br><br>Estamos a procurar condutores con experiencia que teñan camión propio para facer un grande número de entregas. Ofrecemos boas recompensas de até $MONEY$ por tarefa. Por favor, se tes camión propio, achégate directamente ó noso negocio en $CITY$.<br><br>$COMPANY$,<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "Condutor $NAME$" #+ Message sender
		subject: "Preciso dun camión pra traballar" #+ Message subject
		body: "Ola xefe,<br><br>Non sei se te deras conta, pero levo en $CITY$ $DAYS$ sen tarefas. Estou amolado, porque necesito cartos para pagar as miñas facturas e non podo facer nada se estou perdendo aquí o tempo e sen traballos á vista. Por favor, dame un camión nos próximos $DAYS2$ para que poida comezar as entregas ou non terei máis remedio que marchar.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "Condutora $NAME$" #+ Message sender - written by female
		subject: "Preciso dun camión para traballar" #+ Message subject - written by female
		body: "Ola xefe,<br><br>Non sei se te deras conta, pero levo en $CITY$ $DAYS$ sen tarefas. Estou amolada, porque necesito cartos para pagar as miñas facturas e non podo facer nada se estou perdendo aquí o tempo e sen traballos á vista. Por favor, dame un camión nos próximos $DAYS2$ para que poida comezar as entregas ou non terei máis remedio que marchar.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "Condutor $NAME$" #+ Message sender
		subject: "Adeus" #+ Message subject
		body: "Ola,<br><br>Non podo seguir malgastando o meu tempo. Non podo traballar sen camión e non quero esperar máis. Estou desaproveitando boas oportunidades, polo que deixo a túa compañía para tentar sorte noutro lugar. Atoparás todo o meu equipamento no garaxe de $CITY$.<br><br>Adeus,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "Condutora $NAME$" #+ Message sender - written by female
		subject: "Adeus" #+ Message subject - written by female
		body: "Ola,<br><br>Non podo seguir malgastando o meu tempo. Non podo traballar sen camión e non quero esperar máis. Estou desaproveitando boas oportunidades, polo que deixo a túa compañía para tentar sorte noutro lugar. Atoparás todo o meu equipamento no garaxe de $CITY$.<br><br>Adeus,<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "Condutor $NAME$" #+ Message sender
		subject: "O meu camión necesita unha restauración completa" #+ Message subject
		body: "Ola xefe,<br><br>Sei que andas atarefado, pero o meu equipo precisa unha restauración total. É demasiado vello e co desgaste que ten xa non é seguro conducilo. Xa levo $DAYS$ días sen traballo, e francamente, estou bastante frustrado porque teño que pagar as facturas e sen un vehículo en condicións non podo facelo. Por favor, pódesme conseguir un camión novo ou restaurarme este para que poida volver ao traballo? Se non non terei outra opción que marchar.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "Condutora $NAME$" #+ Message sender - written by female
		subject: "O meu camión necesita unha restauración completa" #+ Message subject - written by female
		body: "Ola xefe,<br><br>Sei que andas atarefado, pero o meu equipo precisa unha restauración total. É demasiado vello e co desgaste que ten xa non é seguro conducilo. Xa levo $DAYS$ días sen traballo, e francamente, estou bastante frustrada porque teño que pagar as facturas e sen un vehículo en condicións non podo facelo. Por favor, pódesme conseguir un camión novo ou restaurarme este para que poida volver ao traballo? Se non non terei outra opción que marchar.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "Condutor $NAME$" #+ Message sender
		subject: "Adeus" #+ Message subject
		body: "Ola,<br><br>Sinto dicilo pero o meu vehículo estase caendo a cachos e non vou perder máis o tempo con isto. Non teño ningunha tarefa e estánseme a acumular as facturas, así que teño que marchar da empresa. Recoméndoche que lle fagas unha restauración completa ao camión antes de que chegue o próximo condutor. Podes atopar todo o que me prestaches no garaxe de $CITY$.<br><br>Ata outra.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "Condutora $NAME$" #+ Message sender - written by female
		subject: "Adeus" #+ Message subject - written by female
		body: "Ola,<br><br>Sinto dicilo pero o meu vehículo estase caendo a cachos e non vou perder máis o tempo con isto. Non teño ningunha tarefa e estánseme a acumular as facturas, así que teño que marchar da empresa. Recoméndoche que lle fagas unha restauración completa ao camión antes de que chegue o próximo condutor. Podes atopar todo o que me prestaches no garaxe de $CITY$.<br><br>Ata outra.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "Condutor $NAME$" #+ Message sender
		subject: "Saíndo" #+ Message subject
		body: "Ola xefe,<br><br>O garaxe de $CITY$, onde me atopaba, está sendo pechado. Algunha xente do banco veu e dixo que tiña que marchar. Parece que a compañía non o está a facer moi ben últimamente. Polo tanto, decidín marchar. Non podería facer nada bo aquí de todas formas - sen camión sobre todo. Probarei noutro sitio calquera.<br><br>Adeus e sen resentimentos,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "Condutora $NAME$" #+ Message sender - written by female
		subject: "Voume" #+ Message subject - written by female
		body: "Ola xefe,<br><br>O garaxe de $CITY$, onde me atopaba, está sendo pechado. Algunha xente do banco veu e dixo que tiña que marchar. Parece que a compañía non o está a facer moi ben últimamente. Polo tanto, decidín marchar. Non podería facer nada bo aquí de todas formas - sen camión sobre todo. Probarei noutro sitio calquera.<br><br>Adeus e sen resentimentos,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "Expedidor" #+ Message sender
		subject: "Transportes Especiais" #+ Message subject
		body: "Ola xefe.<br><br>Teño algo especial para ti. Grazas ás nosas conexións, agora podemos aceptar un verdadeiro desafío. Necesítase un auténtico profesional para transportar unhas cargas especiais, extragrandes e de gran peso. Non será fácil e requirirá destreza, paciencia, cooperación cos vehículos piloto e un coidado extra, pero supoño que tes todo iso, verdade? Tamén, un risco maior resulta nun beneficio maior.<br><br>Se estás interesado, podes visitar estas cidades:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "Expedidor" #+ Message sender
		subject: "Novos Transportes Especiais" #+ Message subject
		body: "Ola xefe.<br><br>A máis compañías lles gustaría contratar as túas habilidades profesionais tralo volante para unhas entregas especiais. Igual ca última vez - non será fácil e requirirá destreza, paciencia, cooperación cos vehículos piloto e un coidado extra, pero supoño que aínda tes todo iso, verdade? E non te esquezas - aínda hai un beneficio maior por estas cargas.<br><br>Así que ademais dos traballos de Transportes Especiais dispoñibles actualmente en:<br><br>$OLD_CITIES$ <br><br>Agora tamén poderás facer <color value=@@clr_sel@@>outros novos<color value=@@clr_txt@@> en:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "Axencia Inmobiliaria" #+ Message sender
		subject: "Pensa vostede expandir a súa empresa?" #+ Message subject
		body: "Estimado/a Sr./Sra.:<br><br>Gustaríanos felicitarlle polo progreso da súa empresa. Estamos impresionados polos logros do seu negocio e gustaríanos ofrecerlle unha nova forma de axudar á súa empresa a expandirse aínda máis. A partir de agora podes usar os nosos servizos para adquirir novas propiedades case ó instante! Para máis información, por favor, $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>visite a páxina de compra de garaxes</link>.<br><br>Atentamente,<br>Xerente de Relacións Públicas<br>Axencia Inmobiliaria" #+ Message body
	}
	
#@}
}