	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Imos probar a dar marcha atrás cun remolque. É máis doado do que semella, só tes que ser paciente."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Comeza a ir marcha atrás e aliña a cabeza tractora co remolque."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Asegúrate de aliñarte ben ou non poderás acoplar o remolque. Se non está ben aliñado, sempre poderás ir cara adiante e tentar de novo."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "A quinta roda da tractora acoplarase co bulón rei do remolque."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Pon o freo de estacionamento e conecta o remolque. Na realidade terías que saír do camión para conectar as liñas pneumáticas e eléctricas e subir as patas do remolque, pero aquí farémolo por ti."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>O remolque sempre vai xirar no sentido <color value=@@clr_sel@@>oposto <color value=@@clr_txt@@>á cabeza tractora."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Para xirar o remolque, terás que xirar a tractora na dirección <color value=@@clr_sel@@>oposta <color value=@@clr_txt@@>á que queres que xire o remolque."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Para volver a endereitar o remolque, xira a tractora <br><color value=@@clr_sel@@>cara ao<color value=@@clr_txt@@> remolque."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Intenta manter o remolque aliñado. Terás que facer pequenas correccións constantemente para manter o remolque orientado cara á zona marcada."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corrixe as desviacións tan pronto como sucedan con pequenos xiros do volante. Se xiras demasiado, podes terminar desviándote moito da traxectoria desexada."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Detente na zona designada. Inmobiliza o camión e apaga o motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Detrás de ti e polo lado do pasaxeiro verás un remolque. A túa primeira tarefa será dar marcha atrás ata el.<br><br><font face=/font/big_bold.font>Prepara o camión para ir marcha atrás.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Comeza a dar marcha atrás cara ao remolque. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Sitúa o camión de maneira que quede aliñado co remolque. A quinta roda ten que engancharse ao bulón rei. Vai cara adiante para axustar a túa posición se é necesario.<br><br><font face=/font/big_bold.font>Sigue marcha atrás ata que sintas a conexión.</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "A quinta roda acoplouse co bulón rei e agora podes finalizar a conexión do remolque.<br><br><font face=/font/big_bold.font>Pon o freo de estacionamento.</font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Preme @@imv_nrm_attach@@ para conectar o remolque. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Agora o remolque está conectado de maneira segura coa tractora, conectáronse as liñas eléctricas e pneumáticas e levantáronse as patas do remolque.<br><br><font face=/font/big_bold.font>Quita o freo de estacionamento.</font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Tes que dar marcha atrás ata a praza de aparcamento que hai detrás de ti. Lembra que o remolque xirará na dirección oposta a como xires a cabeza tractora. Un xiro pequeno do volante pode resultar nun movemento considerable do remolque.<br><br><font face=/font/big_bold.font>Comeza a dar marcha atrás co remolque.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Non xires demasiado, simplemente intenta manter o remolque aliñado co aparcamento.<br><br><font face=/font/big_bold.font>Continúa cara á praza de aparcamento. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Aparcar nun espazo estreito"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "Neste escenario aparcaremos nun espazo estreito.<br><br>Terás que manobrar o teu remolque para aliñalo cunha praza de aparcamento."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manobrar cara á praza"
#!{
	key[]: "aca_goal_book1_3_06_stop"
