	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Neste escenario imos aprender a manobrar marcha atrás cara ao lado cego, o do pasaxeiro. Este tipo de manobra debe evitarse a non ser que non haxa outra alternativa, xa que a túa visibilidade está moi limitada. Tomate o teu tempo e extrema a precaución."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Conduce ata pasar a praza de aparcamento para darte espazo para manobrar unha vez comeces a retroceder."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Detente, comproba os teus arredores e comeza a retroceder."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Xira a cabeza tractora cara ao lado contrario de onde se atopa a praza de aparcamento. Isto empuxará a parte frontal do remolque, e á vez dirixirá a parte traseira do remolque cara á praza de aparcamento na que queres entrar. Ten coidado de non xirar demasiado para non facer a tesoira."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "A medida que o remolque entra na praza de aparcamento, comeza a endereitar o camión."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Detente na área designada e inmobiliza o camión."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Manobrar marcha atrás cara ao lado cego require os mesmos métodos que cara ao lado do condutor, pero terás a dificultade engadida da falta de visibilidade nese lado. Usa os espellos e o teu mellor criterio para aparcar o camión.<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Hai unha praza de aparcamento máis adiante do lado do pasaxeiro. Terás que pasala considerablemente para ter suficiente espazo para manobrar ao retroceder.<br><br><font face=/font/big_bold.font>Conduce cara adiante.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Lembra, xirar a cabeza tractora cara ao lado contrario á praza fará que o remolque xire cara a ela. Usa os espellos para axudarte a meterte na praza de aparcamento.<br><br><font face=/font/big_bold.font>Comeza a retroceder.</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Circular por unha rotonda"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Neste escenario veremos como afrontar unha rotonda.<br><br>Terás que prestar especial atención ao teu remolque, xa que seguirá unha traxectoria diferente ao entrar, conducir pola rotonda e ao saír dela."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entrar na rotonda"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Circular pola rotonda"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Circular pola rotonda"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Saír da rotonda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Conducir cara á zona designada"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "As rotondas son moi habituais nas rúas e estradas europeas, así que é importante saber como afrontalas."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Mantente polo exterior do teu carril ao achegarte á rotonda. Isto axudará a que o teu remolque libre o interior do xiro á entrada da rotonda."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Conduce cara ao centro da rotonda ao entrar. Unha vez esteas dentro, terás que abrirte cara ao exterior. Isto é para manter o teu remolque afastado do centro da rotonda."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Mantén un ollo no espello para asegurarte de que o remolque non se acerca demasiado ás barreiras do interior."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Saír da rotonda é relativamente sinxelo porque o remolque xa está afastado do interior da saída. Fai un xiro amplo á saída e o remolque debería seguirte facilmente."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Aparca na área designada e inmobiliza o camión."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Á túa fronte hai unha rotonda pola que tes que circular.<br><br><font face=/font/big_bold.font>Vaite achegando á rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Fai un xiro amplo ao entrar na rotonda, de maneira que o teu remolque entre detrás de ti sen problema. <br><br><font face=/font/big_bold.font>Entra na rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Conduce cara ao exterior da rotonda. Terás que manter o camión afastado o máximo posible do centro da rotonda para evitar tocar co remolque as barreiras do centro. <br><br><font face=/font/big_bold.font>Continúa pola rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Mantente preto dos conos do exterior. <br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Sae da rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Diríxete cara á praza de aparcamento. </font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Detente na área designada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión e apaga o motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manobrar en espazos estreitos"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Para o escenario final, terás que dar a volta co camión nun espazo reducido. Isto requirirá dar marcha atrás cara ao lado cego nunha zona con pouco espazo para manobrar, para o que necesitarás poñer atención ao teu arredor e un uso intelixente do espazo dispoñible."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Conducir pola pista"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Prepararse para un lado cego"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Dar marcha atrás cara á praza de aparcamento"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Completar a manobra do lado cego"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Saír da pista"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Neste escenario vamos ver como dar a volta nun espazo reducido cunha manobra marcha atrás polo lado do pasaxeiro. Esta habilidade será de utilidade cando non podas xirar ou dar marcha atrás cara ao lado do condutor."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "As marcas na estrada axudaranche a percorrer a pista de formación."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Fai un xiro amplo para que o teu remolque libre os camións que están aparcados."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Unha vez finalices o xiro considera como situar o camión para facer a manobra marcha atrás."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Axudarache orientar o camión cara á praza de aparcamento que hai libre do lado do pasaxeiro, cara á cal terás que retroceder."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Deberías evitar manobrar marcha atrás cara ao lado do pasaxeiro (o lado cego), xa que a visibilidade é bastante máis reducida. Desafortunadamente, hai veces nas que non che queda outra opción."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Xira o volante antes de dar marcha atrás. Isto é de axuda para que o remolque apunte cara a onde queres inmediatamente, o que che axudará en espazos estreitos."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Unha vez o remolque estea ben situado, endereita a cabeza tractora e alíñaa co remolque."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Detente unha vez haxas endereitado e teñas suficiente espazo para ir cara adiante de novo. Comeza a saír de novo por onde entraches."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Sigue as marcas na estrada para saír da pista de probas."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Conduce a través da curva e sigue ata a zona designada."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Detente na zona designada."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Inmobiliza o camión e apaga o motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Á túa fronte hai unha pista de formación que representa o aparcamento dunha empresa de transportes. A túa tarefa consiste en entrar alí e dar a volta para volver a saír. Asegúrate de usar ben todo o espazo ao teu arredor.<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Conduce cara á pista de formación.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Fai a curva e continúa polo percorrido.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Sigue as marcas na estrada ata a barreira que hai ao final do percorrido. Aparca lixeiramente en diagonal para orientar o teu remolque cara á praza de aparcamento que hai libre do lado do pasaxeiro.<br><br><font face=/font/big_bold.font>Sigue cara adiante.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Cando manobras cara ao lado do pasaxeiro tes unha visión moito máis limitada do que acontece ao teu arredor. Vai amodo, usa os espellos e extrema a precaución.<br><br><font face=/font/big_bold.font>Comeza a dar marcha atrás e xira o remolque cara á praza de aparcamento libre.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Xa é suficiente. Agora podes seguir cara adiante e saír da pista de formación por onde viñeches.<br><br><font face=/font/big_bold.font>Comeza a ir cara á saída.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Sae da pista de formación.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Sigue as marcas na estrada ata a última praza de aparcamento.<br><br><font face=/font/big_bold.font>Sigue ata a zona designada.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Aparcamento marcha atrás desprazado"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Neste escenario terás que dar marcha atrás cara a unha praza de aparcamento que non está directamente detrás de ti. O espazo dispoñible é limitado, polo que terás que usalo sabiamente."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
