#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Aparcar xunto a un obstáculo"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Neste escenario aprenderemos a aparcar xunto a un bordo usando o espello lateral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Comprobar o espello lateral"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Conducir cara ao bordo"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "O espello lateral e outra ferramenta que che axudará a manobrar o camión con seguridade. Localízase na parte superior da porta do pasaxeiro."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Conduce cara adiante e xira lentamente cara ao lado do pasaxeiro."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Estas táboas representan un bordo. Terás que aparcar xunto a el.<br>Xira cara ao bordo para poñer o camión nunha boa posición para aliñalo coa praza de aparcamento."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Diminúe a velocidade antes de chegar ao bordo e xira cara á praza de aparcamento. Ao endereitar, podes usar o espello lateral para xulgar a túa distancia respecto ao bordo."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Para na praza de aparcamento e inmobiliza o camión."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Mira a través da fiestra do lado do pasaxeiro. Aí podes ver o espello lateral.</font>@@aca_goal_tip@@ Tes que estar no interior do vehículo."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "O espello lateral cobre a área no lado do pasaxeiro que o condutor non pode ver. É un dos ángulos mortos máis problemáticos dun camión. Se o ángulo do espello non te vai ben, pódelo axustar en '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "O camión aínda non esta listo para moverse, ¿pode ser que esqueceras algo?<br><br>Está arrancado o motor? Quitaches o freo de estacionamento?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Diante de ti hai unha liña de pranchas que representan un bordo, e ao final do bordo hai unha praza de aparcamento. Tes que conducir ata alí.<br><br><font face=/font/big_bold.font>Avanza cando teñas todo listo.</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Xira cara ao bordo. Usa os espellos frontal e lateral para comprobares a túa posición respecto a el, pero asegúrate tamén de non golpear ningún cono.<br><br><font face=/font/big_bold.font>Conduce cara ao bordo e entra na praza de aparcamento.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión e apaga o motor.</font>@@aca_goal_tip@Podes usar os preaxustes das vistas interiores para que che sexa máis doado mirar aos espellos. Consulta a pantalla de Opcións — Teclas e botóns — para mirar ou cambiar os comandos asignados."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Aparcar marcha atrás xunto a un obstáculo"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Neste escenario aparcaremos marcha atrás nunha praza situada xunto a un bordo."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instrucións"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Conducir marcha atrás cara ao bordo"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Aparcar o camión"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Neste escenario imos manobrar marcha atrás para aparcar xunto a un bordo."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Vai marcha atrás cara ao bordo.<br>Tes que estar pendente dos teus arredores cando vas marcha atrás, así que usa os espellos."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "A medida que te acercas podes empezar a aliñar o camión coa praza de aparcamento. Mira a ámbolos lados do camión mentres continúas marcha atrás."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Para na praza de aparcamento e inmobiliza o camión."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "A praza de aparcamento está detrás de ti no lado do pasaxeiro. Usa os espellos para moverte ata alí.<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Recorda usar os espellos para comprobares os teus arredores antes de mover o camión.<br><br><font face=/font/big_bold.font>Comeza a dar marcha atrás cara ao bordo. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continúa vixiando a túa contorna a medida que te desprazas marcha atrás cara á praza de aparcamento.<br><br><font face=/font/big_bold.font>Para na zona designada. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Pista de formación avanzada"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "O derradeiro escenario deste capítulo consiste en conducir a través dunha pista de formación avanzada. Poñeremos a proba as habilidades que aprendiches coa cabeza tractora!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slálom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slálom"

	key[]: "aca_goal_book1_2_06_check1"
