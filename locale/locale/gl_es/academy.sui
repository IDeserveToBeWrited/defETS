#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Controis básicos e movemento"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Aprende os controis básicos do vehículo e como mover o camión cara adiante e cara atrás."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Completaches o Capítulo 1: @@aca_chapter_book1_1_title@@.<br><br>Aprendiches a preparar o camión antes de conducir,<br>a avanzar cara adiante e cara atrás e a usar as luces e os limpaparabrisas.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Manobras básicas"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Aprende a conducir, manobrar e aparcar cunha cabeza tractora. Explora o propósito de cada tipo de espello e como usalo."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Completaches o Capítulo 2: @@aca_chapter_book1_2_title@@.<br><br>Aprendiches a utilizar os espellos do camión, comprobar o espazo ao redor do camión antes de moverte e a realizar manobras básicas e avanzadas.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manobrar cun remolque"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Aprende a conectarte e a manobrar cun remolque en diferentes situacións."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Completaches o Capítulo 3: @@aca_chapter_book1_3_title@@.<br><br>Aprendiches a acoplar e desacoplar un remolque, <br>a familiarizarte co peso e as dimensións do camión con remolque<br>e a conducir en desafiantes pistas cun remolque.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Dar marcha atrás cun remolque"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Aprende novas manobras para conducir marcha atrás e aparcar cun remolque."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Completaches o Capítulo 4: @@aca_chapter_book1_4_title@@.<br><br>Aprendiches a dar marcha atrás cun remolque<br>e diversas técnicas de aparcamento.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Exame final"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Demostra os teus coñecementos e habilidades para probar a túa valía conducindo un camión!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Completaches o capítulo 5: @@aca_chapter_book1_5_title@@.<br><br>Probaches que tes todas as habilidades necesarias<br>para conducir, manobrar e aparcar un camión!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Quentando motores"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Completaches a práctica: @@aca_chapter_book2_0_title@@.<br><br>Aprendiches as regras e as características do Dominio da condución.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "De novo en marcha"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Completaches o capítulo 2: @@aca_chapter_book2_1_title@@.<br><br>Quentaches o motor, probaches as marchas, fixeches xirar as rodas como é debido e comprobaches a eficacia dos freos. Os próximos capítulos serán máis esixentes.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Rodando"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Completaches o capítulo 3: @@aca_chapter_book2_2_title@@.<br><br>Dominaches difíciles e variados escenarios, e demostraches habilidade e bo rendemento.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "A recta final"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Completaches o capítulo 4: @@aca_chapter_book2_3_title@@.<br><br>Controlaches moitas situacións complicadas manobrando, aparcando e dando marcha atrás cun remolque. Probaches a túa habilidade na condución, sendo capaz de xestionar todos os desafíos e situacións da condución dun camión."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Going Forward"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Learn all the essential techniques for handling double trailers when driving forward."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 1: @@aca_chapter_book3_1_title@@.<br><br>You have experienced how to drive and manoeuvre with double trailers effectively.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Reverse Control"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Understand the necessary steps for manoeuvring double trailers when reversing."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book3_2_title@@.<br><br>You have have learned the formidable skill of reversing with double trailers.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Real World Preparation"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Apply your new knowledge in more advanced, scenarios."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book3_3_title@@.<br><br>You have handled many difficult situations in manoeuvring, parking, and reversing with double trailers. You've proven yourself here, now it's time to pull some doubles on the roads of Euro Truck Simulator 2!</font><br><br>"


#@}

