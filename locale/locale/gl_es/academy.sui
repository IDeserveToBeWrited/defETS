#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Para o escenario final deste capítulo conduciremos na pista de probas coa configuración complexa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "O primeiro obstáculo é un slálom a través dunhas barreiras. Atravésao e lembra usar os espellos."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Despois ven unha curva en U. Fai o xiro aberto e non debería supoñerte ningún problema."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Aquí hai unha curva á esquerda de 90 graos. Lembra abrirte na curva e xirar tarde para que a parte traseira do camión non bata nas barreiras do interior."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "A rampla pode ser algo complicada. Alíñate o mellor que podas antes de acceder a ela e usa os espellos frontal e lateral para axudar a orientarte."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "A sección seguinte tes que facela marcha atrás. Aproxímate ás barreiras tendo isto en conta."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Sigue as marcas da estrada cara atrás e á túa dereita."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Sigue marcha atrás ata as barreiras, detente e sigue de fronte cara á esquerda."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Sigue atravesando a mediana cara á seguinte sección."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Este paso a través dos conos é moi estreito. Conduce amodo e usa os espellos para guiarte polo paso."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Non esquezas abrirte e xirar tarde nas curvas de 90 graos."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Agora entras nun treito máis aberto. Podes acelerar un pouco aquí, pero ten en conta que terás que reducir a velocidade decontado, para pasar pola seguinte curva."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Ao final da baixada hai unhas barreiras no medio da estrada. Conduce ata elas e despois dá marcha atrás ata a praza de aparcamento da esquerda."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Dá marcha atrás cara áo aparcamento."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Aparca, apaga o motor e inmobiliza o camión."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "En fronte hai un slálom feito con barreiras.<br><br><font face=/font/big_bold.font>Conduce a través do slálom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Mantente polo exterior da curva para asegurarte de que a parte traseira do camión non suba ao bordo.<br><br><font face=/font/big_bold.font>Fai a curva. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Estáste achegando a un xiro de 90 graos á esquerda. Lembra usar todo o espazo dispoñible.<br><br><font face=/font/big_bold.font>Fai o xiro. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Alíñate coa rampla. Non hai moito espazo para facer correccións unha vez esteas nela.<br><br><font face=/font/big_bold.font>Conduce sobre a rampla. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Sigue o percorrido cara á esquerda. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "A seguinte sección tes que completala marcha atrás. Detente na barreira de xeito que podas dar marcha atrás cara á dereita despois.<br><br><font face=/font/big_bold.font>Detente nas barreiras.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Vai marcha atrás cara á zona detrás de ti e á dereita. Hai frechas na estrada que te axudarán.<br><br><font face=/font/big_bold.font>Dá marcha atrás cara á seguinte sección. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Sigue marcha atrás ata as barreiras que hai detrás de ti.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Detente e cambia a unha marcha de avance, despois continúa pola esquerda. <br><br><font face=/font/big_bold.font>Conduce cara adiante. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Á esquerda hai un paso a través da mediana. Conduce por el.<br><br><font face=/font/big_bold.font>Continúa adiante. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "En fronte hai un treito estreito e sinuoso a través duns conos. Conduce con coidado e usa os teus espellos se o consideras necesario.<br><br><font face=/font/big_bold.font>Conduce entre os conos. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Sigue o percorrido.<br><br><font face=/font/big_bold.font>Xira á esquerda. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Lembra manterte á esquerda antes do xiro para darte o maior espazo posible.<br><br><font face=/font/big_bold.font>Fai a curva. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Sigue conducindo. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Aquí podes coller algo de velocidade, pero hai unha curva máis adiante.<br><br><font face=/font/big_bold.font>Continúa o percorrido. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "A curva cérrase a medida que vas avanzando.<br><br><font face=/font/big_bold.font>Apapta a túa velocidade en consecuencia e continúa.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Ao final da baixada verás as barreiras bloqueando a estrada. <br><br><font face=/font/big_bold.font>Detente preto das barreiras. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Detrás de ti á esquerda hai un sitio para aparcar.<br><br><font face=/font/big_bold.font>Vai marcha atrás ata esa zona de aparcamento. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Para na zona marcada. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Circular por unha pista de condución"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Neste escenario imos conducir nun circuíto deseñado para poñer a proba a túa habilidade para manobrar o camión a través de distintos tipos de curvas."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entrar á pista"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Facer unha curva gradual á esquerda"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Conducir a través das curvas enlazadas"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Sección recta"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Xiros doados"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Saír da pista de formación"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Achegarse á praza de aparcamento"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Neste escenario imos dar unha pequena volta coa cabeza tractora para comprobar como conduces coas habilidades que aprendiches recentemente."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Hai diversos tipos e combinacións de xiros no circuíto. Non é unha carreira e o tempo que tardes non importa, así que sé paciente e axusta a túa velocidade ás curvas e obstáculos que atopes."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Ao principio o percorrido é sinxelo, pero os xiros faranse máis complicados a medida que avances."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Ten coidado coa túa velocidade; é doado ir demasiado rápido e calcular mal unha curva."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "A saída do circuíto faise a través dun xiro en U moi pechado. Vai amodo e usa todo o espazo do que dispós."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Aparca entre as barreiras e inmobiliza o camión."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Para completar con éxito este escenario, non poderás chocar, saír do circuíto ou golpear ningún cono.<br><br><font face=/font/big_bold.font>Prepárate para saír. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Avanza cara á curva á dereita para acceder á pista. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Conduce a través da curva a unha velocidade estable. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Estáste acercando a unha sección máis complexa con curvas sinuosas.<br><br><font face=/font/big_bold.font>Adapta a túa velocidade e continúa.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continúa cara ao seguinte conxunto de curvas.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Veñen unhas curvas leves e doadas. Mantén estable a túa velocidade.<br><br><font face=/font/big_bold.font>Continúa conducindo. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "A curva para saír do circuíto é moi pechada. Vai amodo e mantente no exterior da curva antes de xirar. Asegúrate de usar os espellos!<br><br><font face=/font/big_bold.font>Xira para saír do circuíto. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Diante de ti hai un espazo para aparcar entre unhas barreiras.<br><br><font face=/font/big_bold.font>Sigue ata a praza de aparcamento. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Aparcar en paralelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Neste escenario aprenderemos a aparcar en paralelo entre outros dous camións."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Parar adiante da praza de aparcamento"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Comprobar o espello"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Dar marcha atrás cara áo aparcamento"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Aliñar o camión na praza de aparcamento"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Aparcar en paralelo é unha habilidade crucial que todo camioneiro debe coñecer.<br>Prepárate para saír."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Conduce cara á praza de aparcamento.<br>Presta atención ao teu arredor."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Alíñate co camión que se atopa diante da túa praza de aparcamento. Non te arrimes moito a el, mantén algo de distancia para ter suficiente espazo para manobrar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Xira cara ao aparcamento e comeza a dar marcha atrás."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Ao mirar polo espello do lado do condutor, apunta cara ao bordo xusto en fronte ao camión estacionado atrás."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "En canto o teu parachoques dianteiro libre o camión de adiante, podes empezar a xirar a parte dianteira do camión cara á praza de aparcamento, aliñando o camión co bordo."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Endereita o volante e centra o camión na praza.<br>Aparca e inmobiliza o camión."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Diante de ti hai uns camións aparcados, e entre eles tes un espazo libre para aparcar.<br><br><font face=/font/big_bold.font>Prepárate para saír. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Lembra prestar atención ao teu arredor. Usa os espellos durante esta manobra.<br><br><font face=/font/big_bold.font>Conduce cara adiante. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Conduce máis aló da praza de aparcamento ata a zona marcada. Dende alí podes comezar a dar marcha atrás.<br><br><font face=/font/big_bold.font>Para na área marcada. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Comproba que non haxa obstáculos e que podes dar marcha atrás sen problema.<br><br><font face=/font/big_bold.font>Mira a través do espello do pasaxeiro. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Xira o volante e vai marcha atrás cara á praza de aparcamento.<br><br><font face=/font/big_bold.font>Comeza a dar marcha atrás. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Comeza a endereitar o camión cando o consideres oportuno. Non te subas ao bordo!<br><br><font face=/font/big_bold.font>Aliña o camión na praza. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

