	key[]: "aca_goal_book3_correcting_90_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_90 msg - intro text

	key[]: "aca_msg_book3_correcting_90_cutscene1"
	val[]: "Well, once again someone has become frustrated and left their rig in the middle of the lot."

	key[]: "aca_msg_book3_correcting_90_cutscene2"
	val[]: "Now that you've backed up a few trailers, you should have a good idea of how to proceed from here."

	key[]: "aca_msg_book3_correcting_90_cutscene3"
	val[]: "Start by pulling forward until you have something to work with."

	key[]: "aca_msg_book3_correcting_90_cutscene4"
	val[]: "From here, you can now steer the rear trailer into the spot using the lead. Try to keep a nice arch through the combination so that everything keeps moving."

	key[]: "aca_msg_book3_correcting_90_cutscene5"
	val[]: "Takes as much time and as many corrections as you need."

	key[]: "aca_msg_book3_correcting_90_cutscene6"
	val[]: "Straighten everything up, stop in the designated area, and secure the vehicle."

#### correcting_90 Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_90_forward"
	val[]: "Drive forward out of this mess so that you can better work the trailers into the spot."

	key[]: "aca_msg_book3_correcting_90_check1"
	val[]: "Reverse into the parking spot."

#!{
	key[]: "aca_msg_book3_correcting_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_correcting_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


