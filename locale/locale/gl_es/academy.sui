#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Manobras combinadas"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "Neste escenario imos combinar as habilidades que aprendiches para superar un circuíto curto pero técnico, no que terás que dar marcha atrás facendo unha curva e afrontar un xiro fechado de 90 graos."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Dar marcha atrás cara ao lado do condutor"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Xiro de 90 graos"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Completar o xiro"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "En fronte hai unha barreira. Conduce ata ela e detente."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Detrás do camión, do lado do condutor, hai outra barreira. Vai marcha atrás ata ela facendo a curva. Podes usar as marcas do chan para guiarte."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "De fronte hai un xiro pechado de 90 graos. Conduce cara a el."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Terás que comezar a xirar tarde para que as rodas traseiras non toquen o cono do interior da curva. Usa os teus espellos!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Endereita, conduce cara ás barreiras do final, detente e inmobiliza o camión."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Prepárate para saír. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "O camión aínda non esta listo para moverse, ¿pode ser que esqueceras algo?<br><br>Está arrancado o motor? Quitaches o freo de estacionamento?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Diante de ti hai unha zona sinalizada xusto antes da barreira.<br><br><font face=/font/big_bold.font>Conduce cara adiante e para na zona sinalizada. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Mira detrás de ti no lado do condutor e verás outra zona sinalizada. Terás que dar marcha atrás e xirar ao mesmo tempo.<br><br><font face=/font/big_bold.font>Dá marcha atrás a través da curva e para na área sinalizada. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "O percorrido continúa diante de ti a través dun xiro de 90 graos.<br><br>Mantente do lado do condutor antes do xiro, entra ata o fondo da curva e fai un xiro rápido e acusado. Asegúrate de que non golpeas ningún cono no interior da curva.<br><br><font face=/font/big_bold.font>Conduce cara adiante e fai a curva. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Usa o espello frontal e o lateral para asegurarte de que non chocas con nada.<br><br><font face=/font/big_bold.font>Completa o xiro e para na área designada. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Apaga o motor e inmobiliza o camión.</font>"
#@}

