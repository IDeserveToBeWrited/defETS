	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Controis da cámara"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Neste escenario veremos os distintos tipos de cámaras que tes dispoñibles e como poden axudarte a controlar e manobrar o camión."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Posición do asento"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Mirar cara atrás"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Revisar os espellos"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Cambiar á cámara exterior"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Mirar arredor do camión"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Neste escenario imos repasar as distintas cámaras<br>que tes á túa disposición."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Hai sete cámaras entre as que elixir, imos ver algunha delas agora<br> e explicaremos a súa funcionalidade."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "As distintas cámaras e os ángulos que ofrecen poden axudarte cando manobras en lugares estreitos."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Ver cara a onde vas é fundamental para unha condución segura e profesional. Se a posición actual do asento non te convence, podes cambiala en '@@adjust_link_t@@' (accede a través do menú de pausa).<br><br><font face=/font/big_bold.font>Confirma que estás listo con @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Os espellos non ofrecen sempre unha visión clara cando vas marcha atrás. Pode que necesites asomarte por fóra da fiestra para ter unha vista mellor.<br><br><font face=/font/big_bold.font>Xira a cámara completamente cara ao lado do condutor para mirares por fóra da fiestra ata a traseira do remolque.</font>@@aca_goal_tip@@ Tes que estar no interior do vehículo."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Usa esta vista para controlar o remolque durante as manobras marcha atrás. Sempre é mellor dar marcha atrás para o lado do condutor, de maneira que podas usar esta vista. Cando dás marcha atrás cara ao lado do pasaxeiro tes unha visión moito máis limitada do que acontece detrás de ti.<br><br><font face=/font/big_bold.font>Mira cara ao lado do pasaxeiro. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Por isto non é recomendable dar marcha atrás cara ao lado do pasaxeiro; como podes ver a visibilidade é bastante limitada. Afortunadamente, tamén hai sete cámaras exteriores dispoñibles para ti. <br><br>Podes usar o botón @@imv_nrm_camcycle@@ para ir cambiando dunha cámara a outra en secuencia. Despois de pasar polas sete cámaras, volverás á primeira. <br><br><font face=/font/big_bold.font>Preme @@imv_nrm_camcycle@@ para pasar á seguinte cámara. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "A cámara externa proporciona a mellor perspectiva do que acontece arredor do camión.<br><br><font face=/font/big_bold.font>Mira arredor do camión. </font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Premendo @@imv_nrm_camcycle@@ outra vez, podes cambiar á seguinte cámara. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "A cámara dende arriba proporciona unha vista excelente da situación arredor do camión, simplificando o aparcamento e as manobras en espazos estreitos.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_camcycle@@ para cambiar á cámara seguinte.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "A cámara do teito proporciona unha visión clara da estrada sen moita obstrución.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_camcycle@@ para cambiar á última cámara que veremos por agora.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "A vista cara atrás é un atallo á vista que lograches antes ao asomarte pola fiestra. Como xa comentamos, é útil ao ir marcha atrás ou ao aparcar.<br><br>No xogo, temos máis cámaras que podes probar premendo repetidamente @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_cam1@@ para volver ao interior. </font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Para unha experiencia auténtica da escola de condución, recomendamos manterse na cámara interior mentres fas cada un dos escenarios.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_activate@@ para confirmar e para rematar o escenario.</font>@@aca_goal_tip@@ Podes usar a función de @@o_im_cam_zoom@@ para unha mellor vista dos teus arredores. É especialmente útil para mirar polos espellos. Consulta a pantalla de Opcións — Teclas e botóns — para mirar ou cambiar os comandos asignados."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Primeira condución"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Neste escenario aprenderemos a preparar o camión para conducilo, e despois avanzaremos cara adiante por primeira vez."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Dar o contacto"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Arrancar o motor"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Comprobar os arredores"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Usar o freo de servizo"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Engrenar a marcha"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Quitar o freo de man"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Conducir cara adiante"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Deterse"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Poñer o freo de man"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Poñer punto morto"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Parar o motor"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Para as primeiras prácticas usarás só a cabeza tractora.<br>Referímonos a un camión como tractora cando non ten un corpo de carga propio, senón que depende do uso dun remolque para transportar bens e materiais."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "É común usar cabezas tractoras porque permiten unha versatilidade maior: poden entregar un remolque baleiro e coller outro cargado sen ter que esperar, ou cambiar a outro tipo de remolque completamente diferente."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Para a túa primeira condución, terás que conducir cara adiante e pararte trala liña descontinua.<br>Arranca o motor e sigue as instrucións para preparar o camión. Unha vez estea listo, avanza en liña recta."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Conduce ata pasar a liña descontinua, detente, apaga o motor e inmobiliza o camión."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Para a seguinte fase do teu adestramento, moverás o camión por primeira vez.<br><br>Por suposto, sen o motor en marcha non funcionará, así que primeiro terás que dar o contacto.<br><br><font face=/font/big_bold.font>Preme $input engineelect$ para dar o contacto.</font>@@aca_goal_tip@@ No modo carreira, por defecto, o motor préndese ao mesmo tempo que a electricidade de forma automática. Para o modo carreira, podes axustar este comportamento na pantalla de Opcións - Xogo - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "O contacto activa a electrónica do camión. Igual notaches que se acenderon uns indicadores luminosos no cadro de mandos. Iso é normal. Se seguen acendidos co motor arrancado, é probable que o camión teña algún problema. A excepción é a luz do freo de man, que se apagará no momento no que o quites.<br><br>Por sorte, este camión está en boas condicións e estamos listos para continuar.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_engine@@ para arrancar o motor. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Agora que o motor está arrancado, é fundamental comprobar os teus arredores antes de comezar calquera movemento.<br><br><font face=/font/big_bold.font>Mira ao redor do camión e aos espellos de ambos os lados para confirmares que a área está libre de obstáculos.</font>@@aca_goal_tip@@ Tes que estar no interior do vehículo."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Pode semellar obvio, pero debes saber como parar antes de comezar calquera movemento.<br><br><font face=/font/big_bold.font>Activa o freo de servizo usando $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Agora aprenderás a cambiar o sentido da túa marcha.<br><br>Cunha transmisión automática simplificada non fai falta cambiar de marcha, todo se fai automaticamente.<font face=/font/big_bold.font><br><br>Usa $input forward$ para activar a marcha de avance. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Agora aprenderás a cambiar o sentido da túa marcha.<br><br>A transmisión automática realista permíteche cambiar entre avance, punto morto e marcha atrás, igual que unha transmisión automática real.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_gearup@@ para activar a marcha de avance. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Agora aprenderás a cambiar o sentido da túa marcha.<br><br>A transmisión secuencial permite cambios sucesivos de marcha, igual que as transmisións secuenciais reais.<br><br>Da mesma forma en que engrenas unha marcha de avance, a medida que aceleras terás que cambiar a unha marcha máis alta.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_gearup@@ para engrenar a primeira marcha. </font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Agora aprenderás a cambiar o sentido da túa marcha.<br><br>Coa panca de cambios e o embrague vas experimentar a mesma sensación ao cambiar as marchas que cunha transmisión manual real.<br><br>Pisa a fondo o embrague e o freo de servizo.<font face=/font/big_bold.font>Usa a panca para engrenar a primeira marcha.<color value=@@clr_txt@@>Mantén o embrague e o freo pisados a fondo.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Para comezar a moverte, primeiro tes que quitar o freo de estacionamento.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ para quitar o freo de estacionamento.</font>@@aca_goal_tip@@ No modo carreira, o freo de estacionamento está desactivado ao principio. Podes axustar este comportamento na pantalla de Opcións - Xogo - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Agora o camión está listo para avanzar. Comeza a moverte e cruza a liña descontinua.<br><br><font face=/font/big_bold.font>Inicia o movemento usando o acelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Agora o camión está listo para avanzar. Comeza a moverte e cruza a liña descontinua.<br><br><font face=/font/big_bold.font>Inicia o movemento usando o acelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Agora o camión está listo para avanzar. Comeza a moverte e cruza a liña descontinua.<br><br><font face=/font/big_bold.font>Inicia o movemento usando o acelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Agora o camión está listo para avanzar. Comeza a moverte e cruza a liña descontinua.<br><br><font face=/font/big_bold.font>Solta o freo de servizo e libera gradualmente o embrague mentres usas simultaneamente o acelerador para manter as revolucións do motor altas, evitando que se cale. Unha vez soltas de todo o embrague podes acelerar e cambiar de marcha conforme sexa necesario. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Usa o freo de servizo para parar.<br><br><font face=/font/big_bold.font>Usa $input backward$ para deter o camión. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Usa o freo de servizo para parar.<br><br><font face=/font/big_bold.font>Usa $input backward$ para deter o camión. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Usa o freo de servizo para parar.<br><br><font face=/font/big_bold.font>Usa $input backward$ para deter o camión. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Cando sexa hora de parar, pisa a fondo o embrague <font face=/font/big_bold.font>e despois detén o camión usando o freo de servizo.<color value=@@clr_txt@@>Pon punto morto usando a panca de cambio e despois podes liberar o embrague. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Agora inmobiliza o camión. O freo de man asegura que o camión non se mova accidentalmente despois de aparcalo.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ para activar o freo de estacionamento.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Cunha transmisión automática simplificada non é necesario cambiar de marcha, faise todo de forma automática.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_activate@@ para confirmar. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Pon punto morto premendo @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Pon punto morto premendo @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Pon a panca do cambio en punto morto e solta o embrague. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Agora xa sabes como poñer o camión en movemento e como detelo con seguridade.<br><br><font face=/font/big_bold.font>Preme $input engineelect$ para parar o motor. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Dar marcha atrás"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Neste escenario imos probar a dar marcha atrás por primeira vez. Tamén veremos como utilizar os espellos para ver detrás de ti, a que debes prestar atención e como prepararse para a manobra."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Arrancar o motor"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Comprobar o espello do lado do pasaxeiro"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Comprobar o espello do lado do condutor"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Engrenar a marcha"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Quitar o freo de man"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Poñer punto morto"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Parar o motor"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Nesta proba imos dar marcha atrás en liña recta. Terás que ir cara atrás ata pasar a liña descontinua e parar aí."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Ao dar marcha atrás co camión é esencial mirar ao redor constantemente, observar todos os espellos e asegurarse de que o espazo ao redor e detrás de ti estea libre."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Arranca o motor, pon marcha atrás e comeza a moverte."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Conduce marcha atrás ata pasar a liña descontinua, detente, apaga o motor e inmobiliza o camión."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Prepara o camión para conducilo, tal e como aprendiches no anterior escenario.<br><br><font face=/font/big_bold.font>Cando estea listo, arranca o motor. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Comproba polos espellos que a área ao teu arredor está libre. Se non estás conforme coa súa posición, podes axustalos en '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Mira o espello do lado do pasaxeiro.</font>@@aca_goal_tip@@ Tes que estar no interior do vehículo."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Vaste mover ata pasar a liña descontinua. Agora o carril está libre, pero durante a condución habitual é esencial vixiar os arredores, usando tamén os espellos.<br><br><font face=/font/big_bold.font>Consulta o espello do lado do condutor.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Usa $input backward$ para engrenar a marcha atrás. </font>@@aca_goal_tip@@ A maioría de camións conta cun son de aviso que se activa automaticamente ao engrenar a marcha atrás. Podes desactivalo na pantalla de Opcións — Son — @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Preme @@imv_nrm_geardown@@ para engrenar a marcha atrás. </font>@@aca_goal_tip@@ A maioría de camións conta cun son de aviso que se activa automaticamente ao engrenar a marcha atrás. Podes desactivalo na pantalla de Opcións — Son — @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Preme @@imv_nrm_geardown@@ para engrenar a marcha atrás. </font>@@aca_goal_tip@@ A maioría de camións conta cun son de aviso que se activa automaticamente ao engrenar a marcha atrás. Podes desactivalo na pantalla de Opcións — Son — @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Pisa a fondo o pedal do embrague e pon a panca do cambio na posición de marcha atrás. </font>@@aca_goal_tip@@ A maioría de camións conta cun son de aviso que se activa automaticamente ao engrenar a marcha atrás. Podes desactivalo na pantalla de Opcións — Son — @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Agora tes engrenada a marcha atrás.<br><br><font face=/font/big_bold.font>Quita o freo de estacionamento usando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Comeza a moverte usando $input backward$.<br><br><font face=/font/big_bold.font>Dá marcha atrás ata pasar a liña descontinua. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Comeza a moverte usando o acelerador: $input forward$.<br><br><font face=/font/big_bold.font>Dá marcha atrás ata pasar a liña descontinua. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Comeza a moverte usando o acelerador: $input forward$.<br><br><font face=/font/big_bold.font>Dá marcha atrás ata pasar a liña descontinua. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Levanta o embrague lentamente mentres mantés as revolucións do motor usando o acelerador.<br><br><font face=/font/big_bold.font>Dá marcha atrás ata pasar a liña descontinua.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Detén o camión usando o freo de servizo: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Detén o camión usando o freo de servizo: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Detén o camión usando o freo de servizo: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Pisa o embrague a fondo e despois detén o camión usando o freo de servizo. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Pon o freo de estacionamento usando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Cunha transmisión automática simplificada non é necesario cambiar de marcha. Faise todo de forma automática, a diferenza da realidade.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_activate@@ para confirmar. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Pon punto morto premendo @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Os camións modernos cambian automaticamente a punto morto cando se pon o freo de estacionamento. Non obstante, é un bo hábito facelo ti mesmo. Nos seguintes escenarios non imos requirir este paso."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Pon punto morto premendo @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Os camións modernos cambian automaticamente a punto morto cando se pon o freo de estacionamento. Non obstante, é un bo hábito facelo ti mesmo. Nos seguintes escenarios non imos requirir este paso."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Pon a panca do cambio en punto morto e solta o pedal do embrague.</font>@@aca_goal_tip@@ Os camións modernos cambian automaticamente a punto morto cando se pon o freo de estacionamento. Non obstante, é un bo hábito facelo ti mesmo. Nos seguintes escenarios non imos requirir este paso."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Lembra sempre poñer atención ao teu arredor mentres conduzas marcha atrás, especialmente en zonas con moito tráfico.<br><br><font face=/font/big_bold.font>Apaga o motor premendo $input engineelect$. </font>"
#@}

