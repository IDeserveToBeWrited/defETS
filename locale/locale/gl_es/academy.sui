	key[]: "aca_msg_book1_1_05_hazard_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights_blink.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"
#!}

#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "Luces e limpaparabrisas"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "Neste escenario imos explorar algún dos controis básicos do camión que axudan a manter unha visión clara dos arredores, e a facer a túa condución predicible para os outros usuarios da estrada.<br><br>Aprenderás a usar os limpaparabrisas para manter unha boa visibilidade con mal tempo, así como os controis para luces e intermitentes."

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "Arrancar o motor"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "Luces de posición"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "Luces de cruzamento"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "Luces de longo alcance"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "Intermitente esquerdo"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Intermitente dereito"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Luces de emerxencia"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Limpaparabrisas"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Parar o motor"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "Neste escenario imos repasar algunha das funcións do camión que che van garantir poder ver máis ser visto ao mesmo tempo."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Imos activar os distintos sistemas de iluminación e aprenderemos cando é necesario usar cada un deles."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Accionaremos os intermitentes esquerdo e dereito."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "Finalmente, veremos como axustar os limpaparabrisas para que funcionen de forma efectiva con distintas intensidades de precipitación."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Repasemos como usar os distintos tipos de luces, e tamén como controlar os limpaparabrisas.<br><br>As luces de curto e longo alcance aseguran unha boa visión da estrada. Os intermitentes e as luces de emerxencia úsanse para que outros usuarios da estrada podan anticiparse ás túas manobras.<br><br>Os limpaparabrisas úsanse para manter o parabrisas libre de auga e outros residuos.<font face=/font/big_bold.font><br><br>Arranca o motor, pero non quites o freo de estacionamento.</font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Ata agora só usaches as luces de circulación diúrna. Actívanse automaticamente ao poñer o contacto e úsanse para unha mellor visibilidade do vehículo en condicións normais. Así a todo, agora que as condicións empeoraron, terás que usar todo o sistema de iluminación.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_light@@ para acender as luces de posición.</font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>As luces de posición sinalizan a posición do camión pola parte frontal, lateral e traseira. Úsanse ao estacionar en condicións de mala visibilidade, de maneira que o vehículo poda ser visto por outros condutores. <font face=/font/big_bold.font><br><br>Preme @@imv_nrm_light@@ para cambiar ás luces de cruzamento.</font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>As luces de cruzamento aluman a estrada diante de ti e tamén melloran a visibilidade do teu vehículo en condicións de pouca luz.<font face=/font/big_bold.font><br><br>Usa @@imv_nrm_hblight@@ para poñer as luces de longo alcance.</font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>As luces de longo alcance permítente ver máis lonxe en condicións de pouca luminosidade.<br><br>Ten coidado ao usalas porque poden cegar a outros condutores, especialmente aos que veñen no sentido oposto. Asegúrate de apagar as luces de longo alcance cando te aproximes a outros condutores.<font face=/font/big_bold.font><br><br>Usa @@imv_nrm_hblight@@ para quitar as luces de longo alcance.</font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Vexamos agora os intermitentes. A función dos intermitentes é proporcionar a outros usuarios da estrada un sinal visual sobre un cambio de carril ou dirección.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_lblinker@@ para activar o intermitente esquerdo.</font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Notarás no panel de instrumentos que o indicador de intermitente esquerdo está pestanexando. Ao mesmo tempo os intermitentes do lado esquerdo do camión tamén están pestanexando.<font face=/font/big_bold.font><br><br>Agora preme @@imv_nrm_lblinker@@ para apagar os intermitentes esquerdos.</font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Debes sinalizar os cambios de dirección con suficiente antelación, para que os outros usuarios da vía teñan tempo de anticiparse á túa manobra e adaptar a súa condución.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_rblinker@@ para activar o intermitente dereito.</font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>No panel de instrumentos o indicador de intermitente dereito está pestanexando. Ao mesmo tempo os intermitentes do lado dereito do camión tamén están pestanexando.<font face=/font/big_bold.font><br><br>Agora preme @@imv_nrm_rblinker@@ para apagar os intermitentes dereitos.</font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>O botón das luces de emerxencia está sinalado cun triángulo vermello. Estas luces son unha parte importante da seguridade na estrada e só deben usarse cando sexan necesarias. Esta función activa os intermitentes de ámbolos lados simultaneamente.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_flasher4way@@ para poñer as luces de emerxencia.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Agora pestanexan os indicadores dos dous lados, indicando que as luces de emerxencia están activadas. Ao mesmo tempo, os intermitentes de ámbolos lados do camión están pestanexando.<br><br>As luces de emerxencia úsanse cando o camión está detido nun sitio no que non debería estar normalmente, por exemplo ao bordo da estrada por un problema técnico ou mecánico. Tamén poden usarse para advertir a outros condutores de que hai tráfico detido máis adiante.<font face=/font/big_bold.font><br><br>Agora, preme @@imv_nrm_flasher4way@@ para apagar as luces de emerxencia.</font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Pasemos agora aos limpaparabrisas. Estes elementos úsanse para eliminar a chuvia e outros residuos do parabrisas. A súa principal función é a de manter o parabrisas limpo. Os limpaparabrisas poden axustarse a distintas velocidades.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_wipers@@ para activalos na posición de varrido intermitente.</font>@@aca_goal_tip@@ No modo carreira podes usar o sensor de chuvia para que se activen automaticamente cando chova. Podes atopar os axustes de @@rain_sensor@@ na pantalla de Opcións - Xogo."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Este modo permite que os limpaparabrisas se activen de maneira periódica. Isto é útil cando a precipitación é lixeira.<br><br>Como podes ver, a chuvia é demasiado forte agora, e os limpaparabrisas non dan abasto para limpar a chuvia do parabrisas.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_wipers@@ outra vez para cambiar á posición de velocidade baixa.</font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Agora os limpaparabrisas traballan a unha velocidade constante para limpar o cristal.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_wipers@@ unha vez máis para poñelos no modo de velocidade alta.</font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "Podes ver que agora traballan a unha velocidade moito maior para ofrecer a mellor visibilidade. <font face=/font/big_bold.font><br><br>Preme @@imv_nrm_wipers@@ para desactivar os limpaparabrisas.</font>@@aca_goal_tip@@ Tamén podes usar a función @@o_im_wipers_back@@ para repetir o ciclo das distintas velocidades en sentido contrario. Vai á pantalla de Opcións - 'Teclas e botóns' para ver ou cambiar os controis correspondentes."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Podes ver que agora traballan a unha velocidade moito maior para ofrecer a mellor visibilidade.<font face=/font/big_bold.font><br><br>Preme @@imv_nrm_wipersback@@ varias veces ata que se desactiven os limpaparabrisas.</font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Apaga as luces e o motor.</font>"
#@}

#+ Book 1 Scenario 2_01
#@{

#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Slálom entre conos"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "Neste escenario imos aprender a manobrar o camión ao redor duns conos de tráfico coa axuda dos espellos."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Seguir as instrucións"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Comprobar os espellos"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Iniciar a marcha"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "Virar o camión"



	key[]: "aca_goal_book1_2_01_check1"
	val[]: "Entrar ao slálom"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "Evitar os conos de tráfico"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "Zigzaguear entre os conos de tráfico"
#!{
	key[]: "aca_goal_book1_2_01_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_01_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
	key[]: "aca_goal_book1_2_01_end"
	val[]: "Inmobilizar o vehículo"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "Neste escenario levaremos a cabeza tractora nun percorrido curto a través dun slálom feito con conos de tráfico."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Conduce con coidado é presta atención aos teus arredores. Mantén un ollo en ámbolos lados do camión, e asegúrate de usar os espellos para axudarte a percorrer o circuíto."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "O percorrido estreita cara ao final, polo que a precisión é clave."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Aparca na área designada e inmobiliza o camión."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "Para completar este escenario tes que manexar ao redor de todos os conos sen golpear ningún.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_activate@@ para confirmar.</font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Usa os teus espellos para axudarte a manter a visibilidade a ámbolos lados do camión.<br><br>Para o lado do pasaxeiro, os espellos frontal e lateral poden ser de grande axuda para orientarte.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_activate@@ para confirmar.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Axusta os espellos se é necesario, en '@@adjust_link_t@@' (accede a través do menú de pausa).<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "O camión aínda non esta listo para moverse, ¿pode ser que esqueceras algo?<br><br>Está arrancado o motor? Quitaches o freo de estacionamento?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Avanza lentamente e conduce a través do slálom.</font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Continúa a redor dos conos. Presta especial atención ao lado do pasaxeiro.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Continúa zigzagueando a través do slálom sen colidir con ningún cono.</font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Detente na área designada.</font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión e apaga o motor.</font>"
#@}

