#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Conducir por xiros complexos"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Neste escenario veremos como manobrar o remolque a través dun curto percorrido de obstáculos con xiros máis complicados."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primeiros xiros"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Conducir a través dun paso estreito"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Xiro de 90 graos estreito"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Sortear as barreiras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Adiante hai unha serie de curvas complexas e obstáculos.<br>Toma en consideración todo o que aprendiches ata agora e non debería resultar demasiado complicado."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "As marcas na estrada poden darte unha idea de como pasar por cada un dos obstáculos."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Mantén a cabeza tractora polo exterior da curva. <br>Vas ter que facer un xiro amplo, xa que o remolque segue unha traxectoria máis curta."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "A seguinte curva é un sinxelo xiro de 90 graos.<br>Unha vez máis, mantén o camión polo exterior da curva e usa todo o espazo que tes dispoñible."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Tómate o teu tempo. O traxecto abre aquí, pero aínda así terás que circular con precisión."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Mantén un espazo respecto ás barreiras."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Vai con coidado segundo entras nesta sección estreita.<br>Ábrete coa cabeza tractora antes de entrar para preparar a entrada do remolque."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "O derradeiro xiro de 90 graos é moito máis pechado que o primeiro, pero hai espazo dabondo se usas o espazo sabiamente."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Detente na zona designada, inmobiliza o camión e apaga o motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Lembra usar as marcas viarias para axudarte a percorrer a pista.<br><br><font face=/font/big_bold.font>Prepárate para saír. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Usar os espellos tamén che axudará a facer o percorrido de xeito seguro. Sempre terás que prestar atención á forma en que o remolque segue a túa traxectoria. <br><br><font face=/font/big_bold.font>Continúa a través da primeira curva. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observa o remolque segundo saes da curva prepárate para entrar na seguinte.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Procede a través do seguinte xiro. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Lembra observar o teu remolque para asegurarte de que libras os obstáculos ao teu arredor antes de xirar o camión.<br><br><font face=/font/big_bold.font>Continúa arredor da barreira que tes en fronte. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Cando o teu remolque libre a barreira, xira rapidamente cara ao lado do pasaxeiro para aliñarte co seguinte paso estreito.<br><br><font face=/font/big_bold.font>Sigue cara ao paso estreito.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Este treito require dunha condución moi precisa. Tómate o teu tempo e usa os espellos.<br><br><font face=/font/big_bold.font>Mantente polo exterior de cada xiro. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Este xiro é bastante pechado, pero podes usar todo o espazo que tes en fronte para superalo facilmente.<br><br><font face=/font/big_bold.font>Fai o derradeiro xiro. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Pista de formación avanzada - Remolque"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "No escenario final do capítulo 3 conduciremos nunha pista de formación máis longa, cunha variedade de diversos xiros, para comprobar como de ben aprendiches a manobrar cun remolque."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Xiro dobre"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVE THIS GOAL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Atravesar a mediana"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Primeiro slálom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Segundo slálom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Xiros doados"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rotonda"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Sección recta"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Xiro cerrado"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Últimos xiros"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Conducir ata a praza de aparcamento"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Neste escenario enfrontaraste a unha serie de distintas curvas que che axudarán a acostumarte a conducir cun remolque. Concéntrate, axusta a túa velocidade a cada situación e usa todo o espazo dispoñible na pista de formación."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "A primeira curva é en realidade dúas curvas nunha. Teraste que preparar para un xiro á esquerda, e despois xirar á dereita no medio da manobra."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "O seguinte xiro levarate ao outro lado da mediana. Non é particularmente difícil pero terás que asegurarte de deixar suficiente espazo para o teu remolque."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Despois terás que atravesar un slálom bastante estreito entre as barreiras de formigón. Vai amodo e usa os espellos. Asegúrate de abrirte o suficiente para que o teu remolque libre as barreiras."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Neste punto entrarás noutro slálom cuns conos extra no vértice de cada curva.<br>Asegúrate de non golpear ningún deles!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "O seguinte son un par de curvas sinxelas de camiño a unha rotonda."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Usa a treito recto para preparar a entrada á rotonda. Mantente polo exterior antes de entrar nela."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Accede á rotonda e vixía a posición do teu remolque. A súa traxectoria respecto da cabeza tractora será distinta unha vez esteas na rotonda comparado a cando entres."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Sae da rotonda e conduce cara ao seguinte conxunto de curvas."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "REMOVE THIS CUTSCENE"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Este xiro é extremadamente pechado. Tómao amodo e usa o espazo ao teu arredor sabiamente. Presta atención tamén ao desprazamento da parte posterior do teu remolque."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Mentres conduces a través destas curvas, lembra prepararte para o seguinte xiro ao saír do anterior."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Non teñas présa no último xiro. Parece sinxelo, pero hai menos espazo do que semella."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Detente na zona designada, inmobiliza o camión e apaga o motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Acelera cara ao primeiro xiro. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "A primeira curva é un sinxelo xiro dobre.<br><br><font face=/font/big_bold.font>Fai a curva. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "REMOVE THIS CHECK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Máis adiante a pista continúa pola esquerda da mediana.<br><br><font face=/font/big_bold.font>Atravesa a mediana polo paso habilitado. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manobra entre as barreiras e lembra vixiar o remolque.<br><br><font face=/font/big_bold.font>Conduce polo slálom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Este slálom é máis sinxelo, pero os conos de tráfico fano considerablemente máis estreito.<br><br><font face=/font/big_bold.font>Conduce polo slálom e evita golpear os conos. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Adiante tes un par de curvas doadas. Aínda así terás que prepararte para evitar golpear as barreiras interiores co remolque.<br><br><font face=/font/big_bold.font>Fai as curvas. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Estáste achegando a unha rotonda. Lembra deixar suficiente espazo para o teu remolque, non só na entrada e na saída, senón que tamén ao conducir por ela.<br><br><font face=/font/big_bold.font>Conduce pola rotonda. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Agora hai un treito recto, podes aumentar un pouco a velocidade se queres.<br><br><font face=/font/big_bold.font>Sigue conducindo. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Este xiro é moi pechado. Vai amodo, usa todo o espazo do que dispós e ten en conta o movemento da parte posterior do teu remolque. <br><br><font face=/font/big_bold.font>Conduce a través do xiro pechado. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "As últimas curvas son sinxelas, pero lembra ter en conta o remolque.<br><br><font face=/font/big_bold.font>Continúa. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Continúa cara á praza de aparcamento final. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

