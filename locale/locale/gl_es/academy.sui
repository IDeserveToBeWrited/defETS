#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Dámoste a benvida á primeira parte do exame final. Aquí veremos que tal aprendiches a conducir un camión despois do teu paso pola academia."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Primeiro, engancharás o remolque. Unha vez acoplado, conducirás o camión por toda a área de probas."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "O primeiro tramo da proba lévate dende o pequeno aparcamento ata a pista de probas do leste."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "O percorrido inclúe pasos desafiantes entre barreiras."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Unha boa parte da ruta pasa a través da pista de probas do leste."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Poñeremos a proba a túa habilidade para manobrar o camión a través de distintas situacións."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Farás manobras co camión a través dalgúns xiros pechados."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Conducirás a través do tramo de estrada que conecta as pistas."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "A parte final consiste en conducir a través dun pequeno circuíto."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "O circuíto ten moitos pasos intricados e xiros pechados."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Para rematar a proba terás que estacionar correctamente."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Non tes de que preocuparte, xa coñeces todo o que vas necesitar para aprobar.<br><br>Boa sorte!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Diante de ti atópase o remolque.<br><br><font face=/font/big_bold.font>Conduce cara ao remolque.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Aliña a cabeza tractora co remolque.<br><br><font face=/font/big_bold.font>Dá marcha atrás e conecta co bulón rei.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Preme @@imv_nrm_attach@@<font face=/font/big_bold.font> para conectar o remolque. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "O remolque está conectado e o camión está listo para conducir.<br><br><font face=/font/big_bold.font>Quita o freo de estacionamento.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Comeza a conducir cara á saída do aparcamento.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Sigue as marcas na estrada e ten coidado coas barreiras.<br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Estáste achegando a un tramo máis complexo.<br><br><font face=/font/big_bold.font>Pasa con coidado entre as barreiras.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Sigue conducindo. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Esta parte poñerá a proba as túas habilidades ao manobrar o remolque por distintos tipos de curvas.<br><br><font face=/font/big_bold.font>Xira cara á pista.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Conduce a través da pasaxe.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Conduce recto. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Toma a curva con coidado.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Estás entrando nun tramo máis complexo. Conduce con coidado.<br><br><font face=/font/big_bold.font>Sigue conducindo costa abaixo.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Fai o xiro pechado á esquerda. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Sae do circuito. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Estás entrando nun tramo máis sinxelo.<br><br><font face=/font/big_bold.font>Sigue conducindo costa abaixo.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Sigue conducindo pola estrada.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Máis adiante tes o xiro cara á seguinte pista.<br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Xira á dereita. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Sigue conducindo pola pista.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Adiante tes máis curvas pechadas.<br><br><font face=/font/big_bold.font>Adapta a túa velocidade debidamente.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Fai un xiro á esquerda. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Sigue conducindo. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Entra na curva e sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Pode que teñas que saír un pouco do asfalto para facer o xiro.<br><br><font face=/font/big_bold.font>Xira con coidado, usando tanto espazo como necesites.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Sae do circuíto e conduce ata a praza de aparcamento.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Exame final (parte 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Agárdate a derradeira parte do exame final, onde se avaliarán as habilidades para aparcar que aprendiches nos escenarios previos. Aparca con coidado e precisión e estarás a punto para saír ás estradas de Europa coma un camioneiro cualificado!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manobra desprazada"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Aparcar en diagonal"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Conducir a través do aparcamento"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Aparcar en paralelo"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Aparcar por derradeira vez"
