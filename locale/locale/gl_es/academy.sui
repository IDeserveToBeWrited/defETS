	val[]: "Begin reversing slowly."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Straighten up and stop in the designated area."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Secure the vehicle and shut off the engine."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Straight Backing Correction"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "In this scenario, you will take the wheel after someone else has already attempted a straight reverse. Correct their mistake and park the truck in the designated spot."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Straightening Up"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Reversing"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

