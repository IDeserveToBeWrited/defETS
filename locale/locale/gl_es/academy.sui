	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Aparcar cara adiante é unha das manobras de aparcamento máis sinxelas que podes atopar.<br>Aínda así, terás que compensar o desprazamento do remolque ao xirar."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Terás que conducir máis alá do punto no que normalmente comezarías a xirar coa cabeza tractora. Isto permitirate aliñar o remolque con máis eficacia."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "A medida que te achegas á praza de aparcamento, xira para meter a cabeza tractora por diante do remolque. Alíñate coa praza e prosigue cara a ela.<br>Aparca, inmobiliza o camión e apaga o motor."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Diante de ti hai unha praza de aparcamento na que deberás estacionar.<br><br><font face=/font/big_bold.font>Prepárate para saír. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Comeza a conducir e xira cara ao lugar de aparcamento.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Conduce ata superar a praza de aparcamento para aliñar o teu remolque coa zona marcada, despois leva a cabeza tractora á praza e endereita.<br><br><font face=/font/big_bold.font>Aparca na zona designada. </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Detente na área designada.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión e apaga o motor.</font>"
#@}

