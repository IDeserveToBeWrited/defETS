#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Steam Inventory sisu laadimine nurjus.<br><br>$ERROR$<br><br>Sisu edasikasutamiseks vajuta Jätka. Mäng hakkab seda aeg-ajalt otsima.<br><br>Sa võid ajutiselt selle sisu ära keelata, et veateated nagu see siin ära kaoksid. Mäng taaskäivitab sisu järgmine kord, kui sa mängu taaskäivitad. " #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Steam Inventory sisu allalaadimine ebaõnnestus." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM'I INVENTAR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Laadin Steami esemeid..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "UUED ESEMED" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Tuvastati uued Steami inventari esemed." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Sõiduki aksessuaarid" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Kabiini aksessuaar" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Töölaua taust" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Värvilahendused" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Keela inventar" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Proovi hiljem uuesti" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAMI ESEMED" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Mõned esemed on sinu Steam Inventory-st eemaldatud. Sa ei saa neid rohkem hooldusest osta.<br><br>See ei mõjuta sinu praegusi installeeritud esemeid." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


