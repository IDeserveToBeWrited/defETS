#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS ÜHENDATUD SISU" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Ühenda" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Sirvi" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "ÜLDSÄTTED" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "ÜHENDA SISU" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Ühenda" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks leidis uut mängusisu. Uuele sisule ligipääsuks ühenda end World of Trucks teenustega." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Võrk" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Võrgusätted. Pane paika World of Trucksiga seotud sätted." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Oled kindel, et tahad registreerimist edasi lükata?<br><br>Sa saad Online Connect sisule hiljem ligi võrgusätetest, mis asuvad pealehel." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "SISU ÜHENDAMINE" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Sisu ühendamine..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Ühendamise tegevuse järjekorda panemine ebaõnnestus: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steami kasutaja, millega registreerisid selle DLC, erineb sellest kasutajast, millega tegid World of Trucks kasutaja või millega registreerisid mängu. Palun vaheta Steami kasutajat ja proovi uuesti." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "DLC registreerimiseks kasutatav Steami kasutaja on juba ühe teise World of Trucks kasutajaga seotud. DLC registreerimiseks sellel kasutajal on sul vaja kasutada Steami kasutajat, mis pole ühegi World of Trucks kasutajaga seotud." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steami token on aegunud. Palun proovige hiljem uuesti." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "DLC aktiveerimiseks sisestatud kood ei kehti. Palun kontakteeruge meie klienditoega: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Mängu registreerimisel tekkis viga. Proovige hiljem uuesti." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "ÕNNESTUNUD!" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "TEAVE" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "VÕRK" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "SISUSIRVIJA" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Palju õnne! Valitud DLC-d on nüüd sinu World of Trucks kasutajaga ühendatud." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Pole võimalik ühendada kuna sinu praegune Steam kasutaja on ühendatud teise World of Trucks kasutajaga." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Mõned DLC-d ei ole kättesaadavad.<br>Üksikdetailideks hõlju hiirega üle DLC-de peal olevate hüüumärkide." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registreerin $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Current profile is not connected to World of Trucks or the game is running in offline mode. Edit profile to connect." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Click to Dismiss"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/$TOTAL_CONTENT$ hetkel ühilduvat DLC-d ühendatud. Kui mõned DLC-d pole ühendatud World of Trucksiga, siis osad funktsioonid ei pruugi töötada." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Palju õnne! <color value=@@clr_txt@@>Sisu on nüüd ühendatud World of Trucks-iga! Kõik sisuga seotud funktsioonid on nüüd saadaval." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Uute lisade ühendamine World of Trucks'i kontoga ebaõnnestus, sest Steam'i sisse logitud konto ei klapi World of Trucks'iga ühendatud kontoga." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Ühendatud" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Pole ühendatud" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Ostetud lisade info pärimine ebaõnnestus." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Ühendatud sisu kohta ei suudetud infot saada." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Hetkel kasutatava kasutaja kohta ei saadud infot kätte." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Hiljem" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "DLC registreerimine ebaõnnestus. Litsentsi ei leitud, ilmselt Steam Family Sharing'u tõttu." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Puudub omandiõigus" #+ The state of the content that cannot be connected due to invalid license.
#@}


