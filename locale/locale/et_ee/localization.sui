	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Vehicle is roadworthy but may have some issues. Service is recommended." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Vehicle is in solid condition with only minor wear and tear." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Vehicle is in excellent condition with minimal wear." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
