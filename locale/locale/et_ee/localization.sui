	key[]: "apply"
	val[]: "Rakenda" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Töölaua teema" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "GRAAFIKA" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
