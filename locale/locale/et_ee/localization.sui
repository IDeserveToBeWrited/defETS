	key[]: "wanna_assistance_online"
	val[]: "Veokakiirabi viib teie veoauto linna $CITY$. Sellele kulub $MONEY$ ning aega läheb $TIME$. <br offset=30>Sinu praegune tarne katkestatakse.<br offset=30>Kas tahad jätkata?"

	key[]: "wanna_recover"
