	val[]: "TOOTEKOODI KINNITUS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "verifying"
	val[]: "Käib tootekoodi kinnitamine. Palun oodake." #+ Shown in message box while the verification operation is in progress.

	key[]: "verification_required"
	val[]: "Mäng üritab nüüd kontrollida teie tootekoodi ja selleks on vaja võrguühendust.<br><br>Kui teie arvuti pole ühendatud internetti, siis võite kasutada võrguvälist, ehk offline, kinnitamist, mida näeb siit: <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK>."

	key[]: "unable_to_verify"
	val[]: "Mäng ei suutnud tootekoodi kinnitada kuid te võite selleks korraks jätkata.<br><br>Kinnituse kontroll läheb uuesti käima järgmine kord, kui mäng tööle läheb. Kui probleem püsib, siis kontrollige, kas olete Internetti ühendatud või kas kasutate võrguvälist, ehk offline, aktiveerimist, mille leiab siit: <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK>"

	key[]: "unable_to_verify_version"
	val[]: "Mäng ei suutnud tootekoodi kinnitada, sest mäng vajab uuendust. Praeguseks võite jätkata mängimist.<br><br>Kinnituse kontroll läheb uuesti käima järgmine kord, kui mäng tööle läheb. Kui probleem püsib, siis kontrollige, kas olete Internetti ühendatud või kas kasutate võrguvälist, ehk offline, aktiveerimist, mille leiab siit: <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK>"

