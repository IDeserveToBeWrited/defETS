#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "PANK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Pank" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Kui sa vajad raha, siis saad sa alati pangast laenu võtta." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "LAENUPAKKUMISED" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "$MONEY$ eest päevas" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Aktiivsete laenude arv: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Sa saad laenata: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "AKTIIVSETE LAENUDE ÜLEVAADE"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Laen" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Maksta jäänud" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Kestus (päevades)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Intressimäär (aastas)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Osamakse" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Maksa tagasi" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Kokku:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Konto seis: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "UUS LAEN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Sa oled küsimas laenu summas $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Tagasimakse periood:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Intressimäär (aastas):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Igapäevane osamakse:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Kas sa soovid kinnitada oma avalduse?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "MAKSA LAEN TAGASI" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Kas sa tahad kulutada $MONEY$ laenu tagasimakseks?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


