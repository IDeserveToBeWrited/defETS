#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECT GEARBOX TYPE" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Lihtsaim sõitmisviis, mõeldud klaviatuuriga mängijatele. Vajuta NOOL ÜLES nuppu liikumaks edasi ja NOOL ALLA nuppu liikumaks tagasi. Automaatkäigukast teeb ülejäänud töö ise ära: vahetab edasi- ja tagurpidi käigu vahel, õigetele käikudele ja nii edasi."

	key[]: "wiz_gb_automatic"
	val[]: "Ideaalne rooliga, millel on kaasas pedaalid. Kasuta nuppe, et valida edasi sõitmise, seismise(Neutraalne) või tagurdamise vahel. Peale seda, vajuta gaasipedaali ning lase automaatsel käigukastil käike vahetada."

	key[]: "wiz_gb_sequential"
	val[]: "Manuaalselt vaheta käike üles ja alla ja vali edaspidi, neutraalse ja tagurpidi käikude vahel. Seda on raskem selgeks saada, aga nii on sul parem kontroll veoki üle."

	key[]: "wiz_gb_hshifter"
	val[]: "Vali sobiv käik. Sarnane järjestikuse käigukastiga, aga reaalsem. Soovituslik on füüsiline H-vahetaja nagu G27 ja G25. Vajab sidurit."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "See tunnusjoon vajab rooli, juhtpulti või juhtkangi."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Ühtegi H-vahetajaga kontrollerit ei leitud, seda funktsiooni ei saa kasutada."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECT H-SHIFTER LAYOUT"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Valikuga käigukast on kõige lihtsam. Sel on kaks komplekti käike. Esimene komplekt sisaldab käike 1-6 ja teine komplekt 7-12. Nupp vahetab komplekte ja käigukangiga saab valida selle käigu komplektist mida soovid."

	key[]: "wiz_hs_splitter"
	val[]: "Poolitajaga käigukast on kõige lihtsam. Samuti on kaks komplekti käike. Esimene komplekt sisaldab paaritu numbriga käike (1, 3, 5 ...) ja teine komplekt sisaldab paaris numbritega käike (2, 4, 6 ...) Ümberlülitamine toimub nupuga ja käigukangiga saab valida komplektist sobiva käigu. "

	key[]: "wiz_hs_range_splitter"
	val[]: "Poolitajaga käigukast põhineb reaalsel poolitajaga manuaalkäigukasti ülesehitusel. Igale H-vahetaja positsioonile vastab neli käiku ning vaheti kasutab kahte lülitit. See valik on soovitatav vaid kogenenud juhtidele."
#@}

#@}

