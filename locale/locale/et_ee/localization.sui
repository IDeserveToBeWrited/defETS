#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "LAADI MÄNG"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Laadi mäng" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Lae eelnevalt salvestatud mäng. Praegused saavutused kaovad." #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Oled sa kindel, et tahad laadida teist mängu?<br><br>Sinu praegune progress kaob, kui ei ole varem salvestatud."

	key[]: "load_progress_lost_mp"
	val[]: "Are you sure you want to load another game?<br>Doing so in multiplayer may result in job cancellation or suspension, teleportation to the nearest service, or unavailability of the selected job.<br><br>Your current progress will be lost unless saved earlier."

	key[]: "load_game_mp_suspended_job"
	val[]: "Save was successfully loaded, but your active World of Trucks job was suspended and is unavailable while in this session."

	key[]: "autosave"
	val[]: "- Automaatne salvestus -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Kiirsalvestus -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Näita automaatsalvestusi" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "No manual saves found." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Laadi" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Incompatible save!<br><color value=@@clr_txt@@>Try to upgrade the game to the latest available version." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Failed to load and display all save files for this profile." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "TÄHELEPANU" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Salvestuse laadimisel tekkis probleem.<color value=@@clr_txt@@><br><br>Salvestust ei õnnestunud laadida. Sa võid proovida otsida lahendust probleemile kasutades allpool olevat infot. Teisel juhul, võid laadida mõne teise salvestuse.<br><br>Tavaliselt tekitavad probleeme järgnevad asted:<br><br>1. Salvestus ei sobi hetkel installeeritud modifikatsioonidega.<br><br>2.  Salvestuses on infot modifikatsioonidest, mis on keelatud või üldse puudu.<br><br>3. Salvestus on riknenud halvasti ehitatud modifikatsiooni tõttu.<br><br>4. Arvuti kokkujooksmine on rikkunud salvestuse."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Avastati puuduv modifikatsioon.<color value=@@clr_txt@@><br><br> Uusim salvestus sisaldab endas tükke, mis tulenevad kadunud või keelatud modifikatsioonidelt.<br><br>Kui sa seda sõnumit ei ootanud, siis palun kontrollige modifikatsiooni seisu.<br><br>Muidu kui arvad, et midagi viga ei tohiks olla, siis jätka laadimisega, kuigi mängu laadimine võib ebaõnnestuda või tekitada muid probleeme.<br><br>Võid proovida laadida ka mõnd muud salvestust, mis ei sõltu nendest puuduolevatest modifikatsioonidest."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Puudub valikuline DLC.<color value=@@clr_txt@@><br><br>Viimatisem salvestus sisaldab endas DLC-st sõltuvaid juppe.<br><br>Kui arvate, et seda sõnumit olla ei tohiks, siis kontrollige oma DLC-de olekut.<br><br>Teine viis oleks, et laete selle salvestuse, aga DLC-de pakutavad lisad võivad olla puudu.<br><br>Veel üks võimalus oleks laadida salvestus, mis ei sõltu ühestki DLC-st."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Mängust on kadunud DLC.<color value=@@clr_txt@@><br><br>Kõige hilisem salvestus sisaldab endas DLC-d(ametlik mängu lisa), mida sul pole.<br><br>Kui tahad, et see salvestus töötakas, siis peab mängul laetud ja aktiveeritud olema DLC.<br><br>Teisel juhul võid sa laadida mõne muu salvestuse, mis ei sisalda endas kadunud DLC-d."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Mod sõltub DLC-st<color value=@@clr_txt@@><br><br>Vähemalt üks modifikatsioon on ehitatud mängu lisa(DLC) peale, mida pole aga hetkel installeeritud.<br><br>Palun keelake modfikatsioon(id) või installeerige vajalikud DLC-d."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Mäng jooksis kokku<color value=@@clr_txt@@><br><br>Näib, et sinu mäng jooksis kokku eelmise laadimise ajal.<br><br>Sa võid üritada ja võib-olla isegi parandada seda probleemi kasutades allpool olevat infot. Muidu võid laadida ka mõne muu salvestuse.<br><br>Üks järgmistest võib olla kokkujooksmise põhjuseks:<br><br>1. Üks või mitu modifikatsiooni ei sobi selle mängu versiooniga või on lihtsalt katki.<br><br>2. Salvestus, mida kasutad, võib sisaldada asju modifikatsioonidest, mis on puudu või keelatud.<br><br>3. Salvestus on rikutud valesti loodud modifikatsiooni tõttu.<br><br>4. Riistvara on aegunud, riknenud või draiverid on valed."

	key[]: "mods_detected_warning"
	val[]: "Mäng tuvastas modifikatsioone. Ole tähelepanelik, sest katkine, vana või mitteühilduv modifikatsioon võib mängu muuta ebastabiilseks. Vaata oma modifikatsioonid üle Modifikatsioonihalduris." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

