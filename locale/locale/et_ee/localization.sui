	val[]: "Tulemas on sõidurea vahetus. Õnnetuste vältimiseks hoia õiget kiirust.."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Eesmine saateauto läheb teisi hoiatama... <br> Kohanda oma kiirust nii, et sa suudaks vajadusel avariid vältida..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Eskortmasinad ootavad sind lähedaloleval ristmikul. Palun järgi teekonda."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Vaata ette!<br>Oled tagumisele saateautole lähenemas!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Ettevaatust!<br>Sa oled liiga lähedal tagumisele saateautole!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Eriülesandest ülevaate saamiseks vajuta:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Eritöö pakkumine:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "You're about to haul a Special Transport cargo! There are two escort vehicles which will lead you. Please be careful and follow their lead and suggestion notifications. Special transports like this don't stop on a red signal and have the right of way in most situations. During these deliveries, checkpoints are made more often to save your current progress."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Olete tähelepanelik järgneva suhtes:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Väldi igasugust konflikti saateautodega ning hoia end nende vahel."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ära mitte mingil juhul kaldu kõrvale antud marsruudist - isegi mitte tanklatesse, puhkepunktidesse, jne."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Järgi kiiruspiiranguid. Piirangud seab eesmine saateauto."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Ole ettevaatlik kaasliiklejate suhtes ning eriti nende, kes möödasõitu sooritavad."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Reavahetusmanööver:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Kui sa neid reegleid ei järgi, siis võib sinu eritranspordi ülesanne katkeda!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manöövrit alustab <color value=@@clr_sel@@>tagumine<color value=@@clr_txt@@> saateauto, mis vahetab ning sulgeb vajaliku sõidurea."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Eesmine<color value=@@clr_txt@@> saateauto ootab senikaua, kuni valitud sõidurida tühjeneb ning siis vahetab samuti rida."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Siis on ohutu <color value=@@clr_sel@@>mängijale<color value=@@clr_txt@@> edasi manööverdada etteantud sõidureale."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Kütusepaagid tangiti täis ning sõidutunnid nulliti."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Sa ei saa eritranspordi ajal abi kutsuda."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Sa ei saa eritranspordil praamiga sõita."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "You are getting some rest...<br>Truck's tanks are being refilled..."

