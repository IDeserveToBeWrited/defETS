#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Kohustuslik DLC (mängu ametlik lisa) $DEPENDENCY_NAME$ on puudu. Selle salvestuse korrektseks töötamiseks peab nimetatud DLC olema installeeritud ja aktiveeritud. Salvestuse laadimiseks pead selle probleemi parandama." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Valikuline DLC (mängu ametlik lisa) $DEPENDENCY_NAME$ on puudu. Kui sul on see olemas, siis palun kontrolli DLC paigaldatust.<br><br>Sa võid mängu siiski laadida, kuid mõned DLC poolt pakutavad funktsionaalsed ei pruugi töötada." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modifikatsioon $DEPENDENCY_NAME$ on puudu või väljalülitatud. Kui see tundub vale, palun kontrollige modifikatsiooni olekut. Sa võid siiski proovida salvestust laadida, kuid olenevalt modifikatsiooni olemusest võib laadimine ebaõnnestuda või põhjustada muid probleeme." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modifikatsioon $DEPENDENCY_NAME$ ei ühildu sinu mängu versiooniga. See tähendab, et modifikatsiooni autor on märkinud selle ühilduvaks vaid piiratud arvu mänguversioonidega ja praegune versioon ei ole nende hulgas.<br><br>Lahendused:<br>- Leia värskem versioon modifikatsioonist, mis töötab praeguse versiooniga mängust.<br>- Lae alla värskem või vanem versioon mängust, mis oleks modifikatsiooniga ühilduv.<br><br>Sa võid proovida siiski salvestust laadida, kuid seda modifikatsiooni ei laeta ning olenevalt modifikatsioonist võib laadimine ebaõnnestuda või tekitada muid tõrkeid." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "PUUDUVAD SÕLTUVUSED" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETAILID" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Ava workshop"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "See salvestus sõltub DLC-dest või modifikatsioonidest, mida enam ei eksisteeri. Need on välja toodud allpool. Rohkema info saamiseks puuduvate esemete kohta valige nimekirjast vastav sissekanne." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "See salvestus sõltub vähemalt ühest DLC-st või MOD-ist. Salvestuse laadimiseks pead selle vea parandama." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Katkesta laadimine" #+ Abort loading button.

	key[]: "type"
	val[]: "Tüüp" #+ Type column.

	key[]: "dependency_name"
	val[]: "Sõltuvuse nimi" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Kohalik MOD" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop'i MOD" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Valikuline DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Nõutud DLC" #+ DLC that is required to load save that is depending on it.
#@}

