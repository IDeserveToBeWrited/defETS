#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Pildifaili suurus on liiga suur. Palun tehke pildi resolutsiooni väiksemaks." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Pildifaili ei toetata või on rikutud." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Pildi resolutsioon on liiga suur. Proovige vähendada pildi resolutsiooni." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Teenus ei võtnud pilti vastu." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Sellel kasutajal on keelatud piltide üleslaadimine." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Avastati üheaegne üleslaadimine samasse asukohta." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Üleslaadimine on hetkel keelatud. Palun proovige hiljem uuesti." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Tundmatu viga üleslaadimisel! Proovi hiljem uuesti." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
