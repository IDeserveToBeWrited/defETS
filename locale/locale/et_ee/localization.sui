	val[]: "Tere tulemast Euro Truck Simulator 2-te!"

	key[]: "intro_2"
	val[]: "Lõpuks ometi on sul võimalus teha oma unistuste tööd - olla veokijuht!"

	key[]: "intro_3"
	val[]: "Sinu transpordifirma on nüüd avatud kuid kahjuks ei ole sul piisavalt raha, et osta oma veok ning seetõttu pead sa praegu töötama teistes firmades palgatöölisena."

	key[]: "intro_4"
	val[]: "Sinu ülesandeks on viia $JOB_CARGO$ ohutult $JOB_TARGET_COMPANY$ terminali linnas $JOB_TARGET_CITY$. Sulle on tööandja poolt antud auto ning nad maksavad sinu eest kõik kulud kinni. Ära vea kedagi alt ning jõua õigeks ajaks kohale!"


	key[]: "intro_garage_1"
	val[]: "See siin on sinu peakorter."

	key[]: "intro_garage_2"
	val[]: "See on üks väga algne garaaž. See pole palju, kuid hea algus seegi!"

	key[]: "intro_garage_3"
	val[]: "Kuna sul ei ole veel ühtegi veokit, siis hetkel on vaade veoautodest tühi."

	key[]: "intro_garage_4"
	val[]: "Peale seda, kui sa oled saanud piisavalt raha, et endale oma veok osta, oled sa valmis edasi liikuma vabasse maailma ja saad ka teha oma firma."

	key[]: "intro_garage_5"
	val[]: "Õnne!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE UNLOCKED"

	key[]: "desktop_tut_job"
	val[]: "Vali oma järgmine tööots"

	key[]: "desktop_tut_cargo_market"
	val[]: "Kasuta oma tuliuut haagist, et veoturu kaudu vedada laia valikut veoseid ettenähtud sihtkohtadesse." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Siit näed sa oma edusamme."

	key[]: "desktop_tut_company"
	val[]: "Siin saad hoida silma peal oma garaažidel, võtta tööle uusi töötajaid ja juhtida enda firmat."

	key[]: "desktop_tut_trailers"
	val[]: "Nüüdsest peale saad sa osta oma haagise ja seda ka vastavalt oma maitsele tuunida.<br><br>Sinu haagised paigutatakse sinu valitud garaažidesse; neid saavad kasutada kasumi suurendamiseks ka sinu alluvad. Haagiste haldamiseks kasuta haagiste Haldust."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visit $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "TERE TULEMAST"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Welcome to the new Desktop.<br>From here you can interface with all functionality within the game."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Below, the Main Menu provides direct access to all of the core game functions that you are familiar with."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "At the top, the new Status Bar provides constant visibility to helpful player profile statistics and local travel regulations."

	key[]: "desktop_tut_tour_home"
	val[]: "The Desktop button is always there to return you to your Desktop."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "A permanent Quick Menu provides handy shortcut access to all game functions from any screen."

	key[]: "desktop_tut_tour_drive"
	val[]: "The updated Drive button remains your connection to the driving world, ready to place you back on the road."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL FINISHED"

	key[]: "desktop_tut_tour_finish"
	val[]: "Thanks for reviewing our Desktop update."
#@}


