	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Liiguta hiirt vasakule või paremale, et keerata rooli vastavas suunas."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Kasuta @@ima_wiz_j_steer@@ juhtimiseks"


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Kasuta  @@imm_wiz_dforward@@ et sõita edasi ja kasuta @@imm_wiz_dbackward@@ et tagurdada."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Liiguta @@ima_wiz_j_throttle@@ edasi, et sõita edasi ja tagurdamiseks tõmba tagasi."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Kasuta @@ima_wiz_j_throttle@@ et sõita edasi ja kasuta @@ima_wiz_j_brake@@ tagurdamiseks."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Kiirendamiseks kasuta @@imm_wiz_dforward@@ ja pidurdamiseks @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Lükka @@ima_wiz_j_throttle@@ edasi, et anda gaasi ja pidurdamiseks tõmba tagasi."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Kasuta  @@ima_wiz_j_throttle@@ et kiirendada ja kasuta  @@ima_wiz_j_brake@@ pidurdamiseks."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Kasuta @@imv_wiz_gearup@@, et vahetada ederpidi käiku ja @@imv_wiz_geardown@@ tagurdamiseks."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Kui kasutad klaviatuuri või juhtpulti, siis edaspidi käiguks kasuta @@imv_wiz_gearup@@ ja tagurdamiseks @@imv_wiz_geardown@@. Kui kasutad H-vahetajat, siis kasuta käikude muutmiseks @@imv_wiz_drive@@ ja @@imv_wiz_reverse@@."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Kasuta @@imv_wiz_gearup@@ ja @@imv_wiz_geardown@@ et valida sobiv käik."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Kasuta H-vahetajat koos @@ima_wiz_j_clutch@@ , et valida sobiv käik."
