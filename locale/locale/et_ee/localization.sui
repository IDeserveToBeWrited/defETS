#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Võrgukiht pole saadaval. Kontrolli kliendi seadistust!"

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Võrguteenusega pole võimalik ühendust saada. Palun kontrolli kas su internetiühendus töötab."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Võrguühenduse loomisel tekkis viga. Palun proovige hiljem uuesti."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Vigased andmed võrguteenusest. Kui HTTP proksi on kasutuses, kontrolli selle seadeid. Vastasel korral proovi hiljem uuesti."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Võrguteenus saatis vigaseid andmeid. Proovige hiljem uuesti."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Teenus ei ole ühildu selle mänguversiooniga. Palun kontrolli kas uus täiendus mängule on saadaval."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Teenus pole hetkel saadaval. Proovi hiljem uuesti."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Teenus on hetkel maas, kuna toimub hooldus või serverid on ülekoormatud. Proovi hiljem uuesti."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Identifitseerimise andmed olid valed. Palun üritage uuesti sisse logida."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Võrgukasutaja on ajutiselt suletud liialt paljude ebaõnnestunud sisselogimiste tõttu. Proovige uuesti poole tunni pärast."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Võrgukasutaja on hetkel suletud, kuna sellele tehti kahtlaseid ligipääsupäringuid. Proovige uuesti 24 tunni pärast."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Mäng pole sellele võrgukasutajale registreeritud."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Kasutaja pole aktiveeritud. Kontrollige oma e-maili sisendkasuta, kuhu peaks tulema aktiveerimise meil."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Kasutaja on suletud. Palun võtke ühendust tehnilise toega."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Kasutaja on suletud. Palun võtke ühendust tehnilise toega."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxyga sisselogimine pole selles mängus lubatud. Palun kasutage teist proxyt või otsest ühendust."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "See pole hetkel saadaval/on rivist väljas. Palun proovige uuesti mõne minuti pärast."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL error. Unable to establish a secure connection."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Sisemine tõrge. Rohkem infot võib leiduda net.log failis."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Mängul tekkis probleem ning ei suuda tekitada graafilist pilti teie arvutil (ei leitud vastavat graafikaseadet).\nSoovitavavad tegevused:\n\n1. Kontrolli, et arvuti ja videokaart vastavad mängu miinimumnõuetele.\n2. Uuenda oma arvutis Microsofti DirectX-i.\n3. Lae alla ja installi uusimad graafikadraiverid teie graafikakaardi looja veebilehelt - sinu kasutatavad draiverid võivad olla aegunud.\n4. Muuda pildi kuvamise režiim OpenGL-ilt DirectX-ile või vastupidi.\n5. Kustuta mängu konfiguratsioon, ehk 'config.cfg' mis asub 'Minu Dokumendid/Euro Truck Simulator 2' kaustas. See võib olla vigane. Kui olete ära kustutanud faili, siis ta tekib uuesti mängu käima pannes, aga algseadetega."

	key[]: "sys_no_graphics_simple"
	val[]: "Mängul on probleeme sinu arvutis graafilise pildi loomisega (ühtegi graafikaseadet ei leitud)."
#@}

