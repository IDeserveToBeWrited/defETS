#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "SETUP CONTROLLER AXES" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualization of Axes"

	key[]: "wiz_setup_axes_desc"
	val[]: "You can try the function of all selected axes visually. Use the controller and watch the moving bars. It will tell you the limits, centring, orientation and overall behavior of each used axis."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Axis Setup"

	key[]: "wiz_setup_axes_desc2"
	val[]: "To choose an axis, click on the button next to the axis name. This will switch you into input mode. Then, use your controller to bind the selected axis by moving the stick, wheel, or pedal to your chosen axis."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Deadzones"

	key[]: "wiz_setup_axes_desc3"
	val[]: "The deadzone refers to an axis area intentionally designed to provide no input. To adjust the deadzone of a chosen axis, move the corresponding slider. Increasing the slider to the right will enlarge the deadzone. This feature is particularly beneficial for older controllers, as defining a larger deadzone can mitigate issues such as inaccuracy or false input caused by hardware wear."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Axis Modes"

	key[]: "wiz_setup_axes_desc4"
	val[]: "The axis mode determines how it is handled in the game. Inverted axis flips its reported direction, resulting in steering left instead of right, for example. A centred axis has its default position in the middle of its range, such as in a joystick. This mode is useful for correcting an axis that has been detected incorrectly."

	key[]: "normal"
	val[]: "Standardne" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Pööratud" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Keskel" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Pööratud ja keskendatud" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATIC GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Automaatse käigukastiga pead sa valima ainult edasimineku, neutraalse ja tagurpidi käikude seast. Seda saad sa teha järgnevate klahvide ja juhtpuldi nuppudega. Selle sätte muutmiseks vajuta mingile nupule ning vajuta klahvi, või juhtpuldi nuppu, mida sa soovid selleks funktsiooniks kasutada."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Kui teil on H-Shifter riistvara ühendatud, saate kasutada seda nagu päris elus. Võimaldades selle valiku saate valida käigukangi koha edasi ja tagurpidi käikudeks. Kõik teised vabad käigukangi positsioonid toimivad vabakäiguna. See seadistus on tehtud just  H-shifter kontrollerite jaoks, nii et see ei tööta klaviatuuriga ja teiste nuppudega. Et vahetada käigukangi käikude positsioone kliki nupul ja liiguta käigukang soovitud positsioonile ja seejärel tagasi neutraalsele asendile."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEQUENTIAL GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Järjestikune käigukast vahetab kõikide ederpidi, neutraalsete ja tagurpidi käikude vahel. Siin on nupud ja kontrollerinupud, mida kasutatakse käigu üles ja alla vahetamiseks. Et muuta paigutust, klõpsa nupule ja vajuta klahvi või kontrolleri nuppu, mida sa soovid selleks kasutada."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-SHIFTER GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Siin saad sa valida peamise H-shifteri paigutuse ja proovida selle funktsioone. Pildilt näed sa praegust käigukangi positsiooni ja samuti ka valitud käiku. Kuna käigukast sisaldab rohkem käike, kui on kontrolleri käigukangil positsioone, siis pead sa kasutama poolitaja nuppu, et vahetada erinevate käikude komplektide vahel."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Valitud käigukangi positsioon ja aktiveeritud komplekt on näidatud allpool. Et muuta määratud käigukangi asetust kliki nupul ja liiguta käigukang vastavale positsioonile ja seejärel tagasi neutraalsesse asendisse."
#@}

