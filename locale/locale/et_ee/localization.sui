	key[]: "o_im_throttle_op_tooltip"
	val[]: "Assigns button for accelerating."

	key[]: "o_im_back_reverse_op_tooltip"
	val[]: "Assigns button for braking.<br><br>If \"Simple automatic\" transmission type is selected, the same button will also be used for reversing."

	key[]: "o_im_left_op_tooltip"
	val[]: "Assigns button for steering left."

	key[]: "o_im_right_op_tooltip"
	val[]: "Assigns button for steering right."

	key[]: "o_im_gear_up_op_tooltip"
	val[]: "Assigns button for shifting up."

	key[]: "o_im_gear_down_op_tooltip"
	val[]: "Assigns button for shifting down."

	key[]: "o_im_gear_neutral_op_tooltip"
	val[]: "Assigns button for shifting to neutral."

	key[]: "o_im_gear_drive_op_tooltip"
	val[]: "Assigns button for shifting to drive."

	key[]: "o_im_gear_reverse_op_tooltip"
	val[]: "Assigns button for shifting to reverse."

	key[]: "o_im_gear_up_hint_op_tooltip"
	val[]: "Assigns button that hints the automatic transmission to shift up before it does so on its own."

	key[]: "o_im_gear_down_hint_op_tooltip"
	val[]: "Assigns button that hints the automatic transmission to shift down before it does so on its own."

	key[]: "o_im_trans_semi_switch_op_tooltip"
	val[]: "Assigns button for changing between \"Real automatic\" and \"Sequential\" transmission types."

	key[]: "o_im_auto_transmission_mode_op_tooltip"
	val[]: "Assigns button for changing modes of the adaptive automatic transmission."

	key[]: "o_im_engine_op_tooltip"
	val[]: "Assigns button for starting or stopping the engine."

	key[]: "o_im_engine_electricity_op_tooltip"
	val[]: "Assigns button for turning on/off the electricity.<br><br>If assigned, you will have to turn on the electricity before starting the engine. The engine then must be stopped by turning off the electricity, instead of using the standard Start/Stop Engine button."

	key[]: "o_im_parkingbrake_op_tooltip"
	val[]: "Assigns button for the parking brake."

	key[]: "o_im_motorbrake_op_tooltip"
	val[]: "Assigns button for the engine brake.<br><br>The engine brake will be active as long as you hold the button."

	key[]: "o_im_engine_brake_tgl_op_tooltip"
	val[]: "Assigns button for toggling the engine brake.<br><br>After pressing the button, the engine brake will be active until you press the button again."

	key[]: "o_im_engine_brake_up_op_tooltip"
	val[]: "Assigns button for increasing the engine brake."

	key[]: "o_im_engine_brake_down_op_tooltip"
	val[]: "Assigns button for decreasing the engine brake."

	key[]: "o_im_auto_engine_brake_op_tooltip"
	val[]: "Assigns button for turning on/off the automatic engine brake."

	key[]: "o_im_trailer_brake_op_tooltip"
	val[]: "Assigns button for the trailer brake."

	key[]: "o_im_retarder_up_op_tooltip"
	val[]: "Assigns button for increasing the retarder."

	key[]: "o_im_retarder_down_op_tooltip"
	val[]: "Assigns button for decreasing the retarder."

	key[]: "o_im_auto_retarder_op_tooltip"
	val[]: "Assigns button for turning on/off the automatic retarder."

	key[]: "o_im_lift_axle_op_tooltip"
	val[]: "Assigns button for lifting/dropping the axle, if your truck has liftable axle."

	key[]: "o_im_lift_axle_trailer_op_tooltip"
	val[]: "Assigns button for lifting/dropping the axle, if your trailer has liftable axle."

	key[]: "o_im_slide_axle_manual_op_tooltip"
	val[]: "Assigns button to toggle manual axle/tandem adjustment mode, if your trailer has sliding axle/tandem. Manual adjustment mode brakes the trailer wheels and uncouples the axle/tandem from the chassis, so the axle/tandem position can be adjusted by moving the truck.<br><br>When unassigned, axles are moved automatically to fit the current situation."

	key[]: "o_im_diff_lock_op_tooltip"
	val[]: "Assigns button for locking/unlocking the differential."

