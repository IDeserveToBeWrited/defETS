#+ Headers of individual sections
#@{

	key[]: "truck_controls"
	val[]: "CAMIÓN"

	key[]: "assistant_controls"
	val[]: "ASISTENCIAS"

	key[]: "transmission_controls"
	val[]: "TRANSMISIÓN"

