#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "SEGUIMIENTO DE LA MIRADA" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Vista ampliada" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Preajustes de vista ampliada" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Nombre del preajuste" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "¿Quieres eliminar el preajuste seleccionado?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Se sobrescribirá el preajuste existente con el mismo nombre. ¿Quieres continuar?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Ajustes del seguimiento de la mirada" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Ajustes del seguimiento de la cabeza" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Controles de teclado" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Activar vista ampliada" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Activar autocentrado" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Modo del seguimiento de la cabeza" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Directo" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinámico" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Respuesta del seguimiento de la mirada" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Respuesta del seguimiento de la cabeza" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Activar alabeo" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Activar posición" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Multiplicador de guiñada en la cabina" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Multiplicador de cabeceo en la cabina" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Multiplicador de guiñada en el modo paseo" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Multiplicador de cabeceo en el modo paseo" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Ángulo máximo de la mirada" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Velocidad del seguimiento de la mirada"

	key[]: "eye_gaze_exponent"
	val[]: "Exponente del seguimiento de la mirada"

	key[]: "eye_gaze_inflection_point"
	val[]: "Punto de inflexión del seguimiento de la mirada"

	key[]: "eye_gaze_start_point"
	val[]: "Punto inicial del seguimiento de la mirada"

	key[]: "eye_gaze_end_point"
	val[]: "Punto final del seguimiento de la mirada"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Sensibilidad de guiñada del seguimiento de la cabeza en cabina"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Sensibilidad de cabeceo del seguimiento de la cabeza en cabina"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Sensibilidad de guiñada del seguimiento de la cabeza en paseo"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Sensibilidad de guiñada del seguimiento de la cabeza en paseo"

	key[]: "eye_head_exponent"
	val[]: "Exponente del seguimiento de la cabeza"

	key[]: "eye_head_inflection_point"
	val[]: "Punto de inflexión del seguimiento de la cabeza"

	key[]: "eye_head_start_point"
	val[]: "Punto inicial del seguimiento de la cabeza"

	key[]: "eye_head_end_point"
	val[]: "Punto final del seguimiento de la cabeza"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Aumenta el ángulo de visión al usar el movimiento de la cabeza y la mirada para controlar la cámara."

	key[]: "eye_preset_op_tooltip"
	val[]: "Establece el tipo de preajuste de vista extendida a usar."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Cambia el modo de seguimiento de la cabeza.<br><br>- Directo: iguala la posición de la cabeza a la de la cámara, que se recomienda con la cámara interior.<br>- Dinámico: la mirada solo afecta a la cámara al girar la cabeza, y se recomienda cuando sea importante que la vista esté completamente centrada."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Permite que la cámara se vuelva a centrar lentamente a medida que la posición natural de la cabeza cambia durante la partida."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Permite que la posición de la cabeza afecte a la posición de la cámara."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Permite que la cámara se incline igualmente si se inclina la cabeza hacia los lados."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multiplica la rotación combinada de la cabeza y la mirada en dirección horizontal en la cámara interior."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multiplica la rotación combinada de la cabeza y la mirada en dirección vertical en la cámara interior."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multiplica la rotación combinada de la cabeza y la mirada en dirección horizontal en el modo paseo."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multiplica la rotación combinada de la cabeza y la mirada en dirección vertical en el modo paseo."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Ajusta la rapidez con la que la cámara responde a los movimientos de la mirada."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Ajusta la gradualidad con la que aumenta la velocidad de la cámara."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Ajusta la distancia desde el centro de la pantalla en la que la aceleración comienza a estabilizarse."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Ajusta la distancia desde el centro de la pantalla a la que se tiene que mirar antes de que la cámara empiece a moverse."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Ajusta la distancia desde el centro de la pantalla a la que se tiene que mirar para alcanzar la velocidad máxima de la cámara."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Determina hasta dónde puede girar la cámara cuando se mira hacia los bordes de la pantalla."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Ajusta la rapidez con la que la cámara responde a los movimientos de la mirada."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Ajusta cuánto gira la cámara a la izquierda o a la derecha en comparación con cuánto gira la cabeza en la cámara interior."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Ajusta cuánto gira la cámara hacia arriba o hacia abajo en comparación con cuánto gira la cabeza en la cámara interior."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Ajusta cuánto gira la cámara a la izquierda o a la derecha en comparación con cuánto gira la cabeza en el modo paseo."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Ajusta cuánto gira la cámara hacia arriba o hacia abajo en comparación con cuánto gira la cabeza en el modo paseo."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Ajusta la gradualidad con la que aumenta la velocidad de la cámara."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Ajusta cuánto se tiene que girar la cabeza antes de que la aceleración comience a estabilizarse."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Ajusta cuánto tiene que moverse la cabeza desde la posición central antes de que la cámara empiece a moverse."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Ajusta cuánto tiene que moverse la cabeza desde la posición central para alcanzar la rotación máxima de la cámara."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Establece el modo para pausar la partida automáticamente a usar."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Ajusta la cantidad de tiempo en milisegundos antes de que la partida se pause automáticamente cuando no pueda detectar la mirada."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Asigna un comando para establecer la posición actual de la cabeza como la nueva posición predeterminada, volviendo a centrar la cámara en consecuencia."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Asigna un comando para alternar las características de vista avanzada de Tobii."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Asigna un comando para acceder al panel de ajustes del seguimiento de la mirada."

	key[]: "o_im_headtrack_enable_op_tooltip"
