	key[]: "press_or_hold_key_to_assign"
	val[]: "Pulsa o mantén la tecla que quieras asignar a esta función." #+ Key/button assignment hint.

	key[]: "press_button_to_assign"
	val[]: "Pulsa el comando que quieras asignar a esta función."#+ Key/button/axis assignment hint.

	key[]: "select_input_to_unassign"
	val[]: "Selecciona la entrada cuya asignación quieras cancelar." #+ Hint shown when "unassign" button pressed.

