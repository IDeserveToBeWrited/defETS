#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRÁFICOS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Gráficos" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Ajusta la configuración gráfica mediante preajustes para adaptar el rendimiento visual según las capacidades del equipo."

	key[]: "apply"
	val[]: "Aplicar" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Tema de fondo" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "Pantalla" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "CALIDAD" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURAS" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEJOS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SOMBRAS" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ILUMINACIÓN" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POSPROCESAMIENTO" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ENTORNO" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Modo de pantalla completa" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Brillo y HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Ajustar" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Resolución" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Frecuencia de actualización" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Límite de fps" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Límite de fps en segundo plano" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Predeterminado" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Sincronización vertical" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Económico" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "GRÁFICOS BÁSICOS" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "AJUSTES PERSONALIZADOS APLICADOS" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "GRÁFICOS AVANZADOS" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Modos de ajustes gráficos" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Ocultar ajustes avanzados" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Mostrar ajustes avanzados" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Escalado" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Suavizado de bordes" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Nitidez de luminancia del TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Optimización del TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptativo" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Siempre suave" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Siempre fuerte" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Oclusión ambiental" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Alto rango dinámico" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Profundidad de campo" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Rayos Solares" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Corrección de color" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Calidad de los reflejos" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detalle de los reflejos" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detalle de la vegetación" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densidad de la hierba" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Calidad de las sombras"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Tamaño de la textura de las sombras" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Sombras distantes" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Sombras interiores" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Calidad de clima"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Calidad de los retrovisores y espejos" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Resolución de los retrovisores y espejos" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Distancia del espejo" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Calidad de texturas" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtro anisotrópico" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Mapeado normal" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Alumbrado principal del tráfico" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Alumbrado auxiliar del tráfico" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Rango de visibilidad del alumbrado" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Peatones" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "La configuración gráfica ha cambiado.<br>¿Quieres mantener los nuevos ajustes?"

	key[]: "reverting_in"
	val[]: "Revirtiendo en" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "segundos" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Ejecuta el juego a pantalla completa."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Ajusta el brillo general del juego para adaptarlo a tu pantalla. Aquellas que sean compatibles con HDR dispondrán de una opción de calibración."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Cambia la resolución de la imagen."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Cambia la tasa de refresco de la imagen."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la tasa de fotogramas con la frecuencia de actualización del monitor para evitar desgarros en la imagen. El modo económico reduce a la mitad la tasa de fotogramas para mitigar el consumo de energía en equipos portátiles."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Establece la velocidad de fotogramas máxima permitida.<br><br>Ajustar en valor en 0 deshabilita esta función."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Establece la velocidad de fotogramas máxima permitida cuando el juego se encuentra minimizado.<br><br>Ajustar en valor en 0 deshabilita esta función."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Cambia entre ajustes gráficos simples en forma de preajustes o ajustes avanzados para cambiar los parámetros de forma independiente."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Mejora la fidelidad gráfica renderizando internamente la imagen a mayor resolución, reduciendo los bordes dentados y aumentando el nivel de detalle.<br><br>Seleccionar una opción de escalado mayor ofrece una imagen es más nítida y menos borrosa, lo que mejora el aspecto general.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto considerable en el rendimiento."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Determina el modo de suavizado de bordes de alta velocidad, reduciendo la aparición de bordes dentados en la imagen.<br><br>- SMAA: muestrea cada píxel varias veces, según la calidad establecida, en distintas ubicaciones del fotograma y promedia las muestras para generar la imagen final.<br>- TAA: muestrea cada píxel solo una vez por fotograma, pero en diferentes ubicaciones y fotogramas.<br><br>Es posible obtener un mejor resultado a expensas del rendimiento seleccionando una combinación de ambos.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Añade sombras suaves a fisuras y objetos que están muy cerca entre sí, mejorando la fidelidad gráfica percibida en la imagen.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Determina el preajuste del suavizado de bordes temporal.<br><br>- Siempre suave: produce menos parpadeo y más desenfoque, y es apropiada para aquellos que activan el supermuestreo, monitores con muchos puntos por pulgada, o usuarios que juegan desde lejos en pantallas 1080p.<br>- Siempre fuerte: produce más parpadeo y menos desenfoque, siendo la mejor opción para equipos o consolas portátiles.<br>- Adaptativo: desactiva dinámicamente el suavizado de bordes temporal cuando la cámara permanece estática.<br><br><color value=@@clr_txt_d@@>Este ajuste solo está disponible si se selecciona el modo TAA cómo elección de suavizado de bordes."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la intensidad de la nitidez de la luminancia del suavizado de bordes temporal.<br><br><color value=@@clr_txt_d@@>Este ajuste solo está disponible si se selecciona el modo TAA cómo elección de suavizado de bordes."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Desenfoca la imagen distante para crear un efecto realista de pérdida de nitidez."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Muestra rayos de luz al mirar al sol directamente, o a través de vegetación, estructuras o vehículos."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta dinámicamente los colores por razones estéticas. La imagen representará mejor la hora del día y las condiciones meteorológicas, mientras que los tonos de vehículos y otros objetos pueden parecer más vibrantes."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Mejora los reflejos renderizándolos internamente con mayor calidad, y aplicando una técnica de suavizado de bordes mejorada.<br><br><color value=@@clr_txt_d@@>Es necesario reiniciar el juego para que los cambios se lleven a cabo con éxito."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta el detalle de los reflejos sobre superficies metálicas y cristalinas, y en elementos como charcos y masas de agua.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento.<br><br>Es necesario reiniciar el juego para que los cambios se lleven a cabo con éxito."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta el detalle y la complejidad de los árboles y las plantas.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la densidad de la hierba a los lados de la carretera.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la calidad de las sombras proyectadas por el sol y la luna.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Habilita el renderizado de sombras en objetos muy distantes.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Añade sombras dinámicas nocturnas al interior del camión.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la calidad de los efectos meteorológicos, como reflejos en condiciones de lluvia o niebla."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la calidad de los reflejos en espejos y retrovisores, independientemente del ajuste en los reflejos.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la resolución de la imagen proyectada sobre espejos y retrovisores."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la distancia a la que los objetos comienzan a renderizarse en los retrovisores.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto considerable en el rendimiento."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la calidad de ciertas texturas aplicadas a diferentes objetos y superficies."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Mejora la nitidez de las texturas, especialmente aquellas que se ven a distancia o en ángulo oblicuo.<br><br><color value=@@clr_txt_d@@>Es necesario reiniciar el juego para que los cambios se lleven a cabo con éxito."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Aplica detalles geométricos a superficies como aceras, carreteras y otros objetos para mejorar su aspecto.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento.<br><br>Es necesario reiniciar el juego para que los cambios se lleven a cabo con éxito."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Habilita la iluminación de los faros de otros vehículos en circulación."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Activa la iluminación dinámica de otros vehículos en circulación, como intermitentes o frenos."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la distancia desde la cual se pueden ver las fuentes de luz artificial.<br><br><color value=@@clr_txt_d@@>Este ajuste ejerce un impacto moderado en el rendimiento."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Habilita la presencia de peatones por calles y recintos."
#@}

