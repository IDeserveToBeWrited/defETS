	key[]: "steer_cam_rotation_reverse"
	val[]: "Rotación de la cámara al girar marcha atrás" #+ Droplist for steering based camera rotation modes when reversing.

	key[]: "blinker_cam_rotation"
	val[]: "Rotación de la cámara por intermitentes" #+ Checkbox enabling camera rotation based on blinker activation.

	key[]: "phys_cam_move"
	val[]: "Movimiento de la cámara por físicas" #+ Checkbox enabling camera movement based on driver physics.

	key[]: "phys_cam_move_factor"
	val[]: "Factor de movimiento de la cámara por físicas" #+ Slider for physics based camera movement multiplier.

	key[]: "toy_phys_move"
	val[]: "Físicas de los accesorios en cabina" #+ Checkbox enabling cabin toys movement.

	key[]: "cam_horizon_lock_factor"
	val[]: "Factor de bloqueo del horizonte en la cámara interior" #+ Slider for interior camera horizon locking.

	key[]: "cam_auto_center_delay"
	val[]: "Retardo del centrado de la cámara" #+ Dropdown for camera auto centering delay.

	key[]: "cam_auto_move_speed"
	val[]: "Velocidad de movimiento de la cámara" #+ Dropdown for automatic camera movement speed.

	key[]: "cam_interior_zoom_mode"
	val[]: "Modo de zoom en cámara interior" #+ Choose how the interior camera zoom behaves.

#+ Parking difficulty droplist
#@{
	key[]: "trailer_parking_difficulty"
	val[]: "Dificultad del estacionamiento" #+ Droplist for parking difficulty selection

	key[]: "trailer_parking_diff_dialog"
	val[]: "Elegir siempre" #+ Manual selection option

	key[]: "trailer_parking_diff_easy"
	val[]: "Estacionamiento seguro" #+ Low difficulty parking option

	key[]: "trailer_parking_diff_hard"
	val[]: "Estacionamiento experto" #+ High difficulty parking option

	key[]: "trailer_parking_diff_random"
	val[]: "Estacionamiento aleatorio" #+ Random difficulty parking options
