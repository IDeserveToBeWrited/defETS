	key[]: "item_paint_job"
	val[]: "Pintura" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Desactivar inventario Steam" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Intentar más tarde" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
