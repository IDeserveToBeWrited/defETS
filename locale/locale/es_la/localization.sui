#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Establece el subtipo de controlador para que el juego maneje correctamente los rangos de entrada."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Determina el tipo de transmisión.<br>- Automática sencilla: permite usar el acelerador y el freno para avanzar e ir marcha atrás.<br>- Automática real: requiere una entrada para alternar entre marchas.<br>- Secuencial: precisa que se realicen cambios de marchas de manera manual con entradas para subirlas y bajarlas.<br>- Palanca de cambios en H: requiere un controlador con posiciones de cambio para seleccionar las marchas manualmente."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Cambia la lógica de cambio de marchas de la transmisión automática.<br><br>- Rendimiento económico: antepone revoluciones más bajas y se inclina hacia el par máximo.<br>- Rendimiento estándar: opta por una opción más equilibrada.<br>- Rendimiento alto: se inclina hacia la potencia máxima para mejorar la conducción con mercancías pesadas o en terrenos montañosos a expensas de ahorrar combustible."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la relación entre el grado de giro del dispositivo y el grado de giro de la dirección del vehículo."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la linealidad entre la entrada y la dirección del vehículo.<br><br>Ajustarlo más alto establece una dirección menos sensible cuando el volante se encuentra en posición central, y aumenta cuando se lleva hacia el máximo de giro. Esto puede ser útil para suavizar las entradas de dirección cuando se conduce recto."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Activa la retroalimentación de fuerza en los controladores que la admiten."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la ganancia general para todas las configuraciones de la retroalimentación de fuerza entre 0N y 10N.<br><br><color value=@@clr_txt_d@@>Ten en cuenta que ajustar esto a un valor más alto en volantes potentes puede causar lesiones en los dedos o las manos."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la fuerza de centrado al conducir a alta velocidad, alcanzando su punto máximo a partir de 90 km/h o 56 mph.<br><br>Ajustarlo al mínimo hace que el volante no tenga fuerza de centrado."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la fuerza de centrado al conducir a baja velocidad.<br><br>Ajustarlo al mínimo hace que el volante no tenga fuerza de centrado."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la fuerza de la fricción interna causada por los componentes mecánicos de la dirección."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la fuerza de la resonancia del motor a través de la barra de dirección.<br><br><color value=@@clr_txt_d@@>Ajustarlo por encima del 15% puede provocar sacudidas y vibraciones excesivas en algunos volantes."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la fuerza de los efectos superficiales de la carretera a través de la barra de dirección.<br><br><color value=@@clr_txt_d@@>Ajustarlo por encima del 20% puede provocar sacudidas y vibraciones excesivas en algunos volantes al circular rápido por terrenos irregulares."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de los efectos de los baches de la carretera a través de la barra de dirección."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de los efectos de las colisiones a través de la barra de dirección."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de los efectos de patinaje de la caja de cambios."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de los efectos de deslizamiento del subviraje."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de la dirección asistida, por ejemplo, cuando se utiliza la asistencia de carril."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de las vibraciones de los efectos superficiales de la carretera si el controlador admite retroalimentación de vibración."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de las vibraciones de los baches de la carretera si el controlador admite retroalimentación de vibración."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensidad de las vibraciones de las colisiones si el controlador admite retroalimentación de vibración."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Determina el eje del dispositivo que se usa para la dirección."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona muerta del eje de la dirección; es decir, la cantidad de rotación desde el centro por la que se ignora la entrada.<br><br>Esto puede mitigar problemas en controladores más antiguos, como imprecisiones o entradas falsas causadas por el desgaste."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cómo el juego maneja la entrada del eje de la dirección.<br><br>- Centrado: ideal \npara volantes o joysticks.<br>- Invertido: se utiliza para corregir un eje que ha sido detectado de forma errónea."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Determina el eje del dispositivo que se usa para acelerar."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona muerta del eje del acelerador; es decir, la cantidad de recorrido de entrada por la que no se registra ninguna entrada.<br><br>Esto puede mitigar problemas en controladores más antiguos, como imprecisiones o entradas falsas causadas por el desgaste."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cómo el juego maneja la entrada del controlador.<br><br>- Centrado: ideal \npara volantes o joysticks.<br>- Normal: ideal para gatillos y pedales.<br>- Invertido: se utiliza para corregir un eje que ha sido detectado de forma errónea."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Determina el eje del dispositivo que se usa para frenar."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona muerta del eje del freno; es decir, la cantidad de recorrido de entrada por la que no se registra ninguna entrada.<br><br>Esto puede mitigar problemas en controladores más antiguos, como imprecisiones o entradas falsas causadas por el desgaste."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cómo el juego maneja la entrada del controlador.<br><br>- Centrado: ideal \npara volantes o joysticks.<br>- Normal: ideal para gatillos y pedales.<br>- Invertido: se utiliza para corregir un eje que ha sido detectado de forma errónea."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Determina el eje del dispositivo que se usa para embragar."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona muerta del eje del embrague; es decir, la cantidad de recorrido de entrada por la que no se registra ninguna entrada.<br><br>Esto puede mitigar problemas en controladores más antiguos, como imprecisiones o entradas falsas causadas por el desgaste."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cómo el juego maneja la entrada del controlador.<br><br>- Centrado: ideal \npara volantes o joysticks.<br>- Normal: ideal para gatillos y pedales.<br>- Invertido: se utiliza para corregir un eje que ha sido detectado de forma errónea."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta el alcance del embrague.<br><br>Cuanto más a la derecha, mayor presión se tiene que ejercer sobre el pedal para embragar."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Determina el eje del dispositivo que se usa para inclinar la cámara hacia arriba y hacia abajo."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona muerta del eje de mirar hacia arriba y hacia abajo; es decir, la cantidad de recorrido de entrada por la que no se registra ninguna entrada.<br><br>Esto puede mitigar problemas en controladores más antiguos, como imprecisiones o entradas falsas causadas por el desgaste."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cómo el juego maneja la entrada del eje.<br><br>- Centrado: ideal \npara volantes o joysticks.<br>- Invertido: se utiliza para corregir un eje que ha sido detectado de forma errónea."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Determina el eje del dispositivo que se usa para desplazar la cámara a la izquierda y a la derecha."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona muerta del eje de mirar a la izquierda y a la derecha; es decir, la cantidad de recorrido de entrada por la que no se registra ninguna entrada.<br><br>Esto puede mitigar problemas en controladores más antiguos, como imprecisiones o entradas falsas causadas por el desgaste."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cómo el juego maneja la entrada del eje.<br><br>- Centrado: ideal \npara volantes o joysticks.<br>- Invertido: se utiliza para corregir un eje que ha sido detectado de forma errónea."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Establece la disposición de las marchas a utilizar con la palanca de cambios en H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Determina el comportamiento de la palanca de cambios.<br><br>-Sencillo: evita el rechinido al cambiar.<br>- Sencillo con ruidos: permite también cambiar de marcha de forma simple, pero emitiendo sonidos al cambiar de marcha de forma incorrecta.<br>- Avanzado: emite ruidos de engranajes y no permite cambiar de marcha si se hace incorrectamente. Esta última opción también permite usar el ajuste de cambio rápido de marchas."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Determina la gestión de los cambios de marcha rápidos.<br><br>- Nunca: requiere tener que poner la palanca en punto muerto al cambiar de marcha.<br>- Pisar el embrague: requiere presionarlo momentáneamente sin mover la palanca.<br>- Soltar el acelerador: requiere liberarlo para cambiar de marcha sin mover la palanca. La opción que abarca embrague o acelerador es una combinación de las dos últimas."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la posición de la marcha."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Asigna la entrada utilizada para alternar entre rangos según la disposición de la palanca de cambios."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Asigna un comando para alternar el divisor según la disposición de la palanca de cambios."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina cuando se utilizan conmutaciones en lugar de botones para las entradas de rango o divisor."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Asigna un comando para cambiar al modo conducción en la transmisión automática."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Asigna un comando para cambiar al modo marcha atrás en la transmisión automática."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Habilita efectos dinámicos de retroalimentación RGB en dispositivos compatibles."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Habilita y configura las funciones de seguimiento de la mirada en dispositivos compatibles. La opción permanecerá deshabilitada si el juego detecta que no dispones de hardware compatible conectado."
#@}

