#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Conectar" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Explorar" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "FUNCIONES" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONTECTAR CONTENIDO" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Conectar" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks ha detectado nuevo contenido añadido. Conéctate a los servicios en línea de World of Trucks para poder acceder a él." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Servicios en línea" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Las preferencias en línea. Configura todas las opciones relacionadas con World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "¿Quieres posponer el registro?<br><br>Puedes conectar el contenido en línea más tarde desde el apartado En línea de la sección Opciones." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "CONEXIÓN DE CONTENIDO" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Conectando el contenido..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Se ha producido un error al poner en cola la operación del siguiente contenido: $CONTENT_NAME$." #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "La cuenta Steam usada para registrar el DLC es distinta a la proporcionada para crear la cuenta World of Trucks o registrar el juego. Cambia tu cuenta Steam y prueba a intentarlo de nuevo." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "La cuenta Steam usada para registrar el DLC ya está asociada con otra cuenta World of Trucks. Para registrar el DLC con la cuenta actual, necesitas usar una cuenta Steam que no esté conectada a una cuenta World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "El identificador de Steam ha expirado. Prueba a intentarlo de nuevo más tarde." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "El número de serie usado para activar el DLC no es válido. Contacta con el soporte técnico en support@scssoft.com para obtener ayuda." #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Se ha producido un error interno al registrar el contenido. Prueba a intentarlo de nuevo más tarde." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "OPERACIÓN COMPLETADA" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "DETALLES" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "SERVICIOS EN LÍNEA" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "EXPLORADOR DE CONTENIDO" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "¡Enhorabuena! Los DLCs seleccionados han sido conectados con éxito a la cuenta World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "No se ha podido conectar el contenido porque la cuenta Steam actual está asociada a una cuenta World of Trucks diferente." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "La conexión de algunos DLCs ha fallado.<br>Pasa el ratón por encima de cada DLC marcado con una exclamación para obtener más detalles." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrando el siguiente contenido: $CURRENT_CONTENT_NAME$..." #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "El perfil actual no está conectado a World of Trucks o el juego se está ejecutando sin conexión. Debes editarlo para poder conectarte." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Descartar"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$<color value=@@clr_txt@@>/$TOTAL_CONTENT$ DLCs conectados actualmente. Si un DLC no está conectado a World of Trucks, podrías perder algunas de sus características." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>¡Enhorabuena!<color value=@@clr_txt@@> ¡Todo el contenido está conectado con World of Trucks! Ahora puedes usar todas sus características." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "No se ha podido conectar el nuevo contenido con World of Trucks porque la cuenta Steam actual no coincide con la usada en el perfil World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Conectado" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "No conectado" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "No ha sido posible obtener información acerca del contenido adquirido." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "No ha sido posible obtener información acerca del contenido conectado." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "No ha sido posible obtener información acerca de la cuenta actual." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Más tarde" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "No se ha podido registrar el DLC. No se ha encontrado una licencia permanente, probablemente debido a la función de préstamo familiar de Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Contenido sin licencia permanente" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "¡Misión de transporte especial completada!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "¡MISIÓN FRACASADA!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Abandonar"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Cargar punto de control"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "¡Has ocasionado daños al vehículo piloto!<br>Puedes cargar un punto de control guardado o cancelar la entrega con una penalización de $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Has hecho que vehículo piloto haya colisionado contra el tráfico por conducir de forma incorrecta.<br>Puedes cargar un punto de control guardado o cancelar la entrega con una penalización de $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Has abandonado la ruta fijada que se supone que debes seguir.<br>Puedes cargar un punto de control guardado o cancelar la entrega con una penalización de $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "No te has mantenido junto a los vehículos piloto tal y como se supone que debes hacer.<br>Puedes cargar un punto de control guardado o cancelar la entrega con una penalización de $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "¡Te has alejado demasiado de los vehículos piloto!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "¡Has dañado uno de los vehículos piloto!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "¡Uno de los vehículos piloto ha sufrido un accidente!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "¡Has abandonado la ruta fijada!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimensiones"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Transporte especial"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Mantén la mercancía entre los vehículos piloto."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Entregas especiales"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimensiones"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Transporte especial"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Reduce la velocidad para evitar colisionar con el vehículo piloto."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Espera al vehículo piloto trasero."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Presta atención y extrema la precaución.<br>Te acercas a un estrechamiento de la calzada."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Se acerca una maniobra de cambio de carril. Adapta la velocidad para evitar una posible colisión de tráfico."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "El vehículo piloto delantero va a advertir al resto de conductores.<br>Adapta la velocidad para evitar una posible colisión de tráfico."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Los vehículos piloto aguardan en la próxima intersección. Sigue la ruta estimada."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "¡Cuidado!<br>¡Te estás acercando demasiado al vehículo piloto trasero!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "¡Cuidado!<br>¡Estás muy cerca del vehículo piloto trasero!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Presiona el siguiente comando para ver la oferta de trabajo especial:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Oferta de trabajo especial:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Estás a punto de llevar una mercancía de transporte especial. Contarás con dos vehículos piloto que te guiarán. Por favor, extrema la precaución y sigue sus indicaciones y sugerencias. Los transportes especiales como este no se detienen en semáforos en rojo y tienen preferencia en la mayoría de situaciones. Durante estas entregas, se guardan más puntos de control en tu progreso actual."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Presta especial atención a lo siguiente:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Evita cualquier posible conflicto con los vehículos piloto y mantén la mercancía entre ellos."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "No abandones la ruta estimada, ni te adentres en estaciones de servicio o áreas de descanso."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Respeta los límites de velocidad que serán establecidos por el vehículo piloto delantero."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Presta atención al tráfico que realiza adelantamientos y otras maniobras en carretera."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Maniobra de cambio de carril:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "¡Sigue las normas o el trabajo de transporte especial podría fracasar!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "La maniobra es iniciada por el vehículo piloto <color value=@@clr_sel@@>trasero<color value=@@clr_txt@@> al cambiar al carril designado y bloquearlo."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "El vehículo piloto <color value=@@clr_sel@@>delantero<color value=@@clr_txt@@> espera hasta que el carril designado esté libre para, posteriormente, cambiar también de carril."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Solo entonces será seguro para <color value=@@clr_sel@@>ti<color value=@@clr_txt@@> desplazarte al carril designado."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Se han rellenado los depósitos del camión y el tiempo conducido se ha restablecido."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "No puedes llamar al servicio de asistencia durante un trabajo de transporte especial."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "No puedes usar un ferri durante un trabajo de transporte especial.\n"

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Tomándote un descanso y repostando..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Te aproximas a una parada obligatoria<br>Sigue al vehículo piloto hasta el aparcamiento para descansar."

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Parada obligatoria"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Pulsa el siguiente comando para descansar y repostar:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Se ha producido un error al cargar el contenido del inventario Steam. <br><br>$ERROR$<br><br>Pulsa el botón Continuar para mantener dicho contenido activo y el juego se encargará de buscarlo periódicamente.<br><br>Puedes optar por desactivarlo temporalmente para que dejen de aparecer mensajes como este. El juego volverá a activar el contenido automáticamente la próxima vez que lo inicies." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "No ha sido posible descargar los elementos del inventario Steam." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

