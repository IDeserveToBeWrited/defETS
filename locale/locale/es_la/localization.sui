	key[]: "hshift_auto_drive"
	val[]: "Caja de cambios automática: Manejar" #+ Label of line containing button whose pressed state indicates "Drive" position.

	key[]: "hshift_auto_reverse"
	val[]: "Caja de cambios automática: Retroceso" #+ Label of line containing button whose pressed state indicates "Reverse" position.
#@}

#+ Misc configuration of periperies.
