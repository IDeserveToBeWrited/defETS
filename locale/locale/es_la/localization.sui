#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "CARGAR PARTIDA"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Cargar Juego" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Carga una partida guardada previamente. Ten en cuenta que cualquier progreso no guardado se perderá." #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "¿Quieres cargar la partida guardada?<br><br>Ten en cuenta que cualquier progreso no guardado se perderá."

	key[]: "load_progress_lost_mp"
	val[]: "¿Quieres cargar otra partida?<br>Realizar esta acción durante el modo multijugador puede provocar la suspensión o cancelación de la entrega, el teletransporte al taller más cercano, o la pérdida del trabajo seleccionado.<br><br>Ten en cuenta que cualquier progreso no guardado se perderá.\n\n<br><br>El progreso se perderá si no guardas la partida."

	key[]: "load_game_mp_suspended_job"
	val[]: "La partida se ha cargado correctamente, pero la entrega World of Trucks ha sido suspendida y no está disponible en esta sesión."

	key[]: "autosave"
	val[]: "- Autoguardado -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Guardado rápido -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Mostrar autoguardados" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "No se ha encontrado ningún guardado manual." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Cargar" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>La partida guardada no es compatible.<br><color value=@@clr_txt@@>Prueba a actualizar el juego a la última versión." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Se ha producido un error al cargar y mostrar las partidas guardadas de este perfil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "ATENCIÓN" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Se ha producido un error con la partida guardada.<color value=@@clr_txt@@><br><br>No se ha podido cargar la partida.<br><br>Puedes tratar de identificar el problema e intentar solucionarlo usando la siguiente información. Como alternativa, puedes probar a cargar otra partida guardada.<br><br>Este problema puede ser común por los siguientes motivos:<br><br>1. La partida no es compatible con alguno de los mods instalados.<br><br>2. La partida contiene datos de mods ausentes o desactivados.<br><br>3. La partida se ha corrompido tras usar un mod defectuoso.<br><br>4.  La partida se ha corrompido al apagar el equipo durante el proceso de guardado."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Se ha detectado que hay mods ausentes.<color value=@@clr_txt@@><br><br>La partida guardada depende de al menos un mod no disponible o desactivado.<br><br>Si no esperabas esta situación, verifica el estado actual de los mods instalados.<br><br>Puedes cargar la partida igualmente, aunque se perderán las funcionalidades proporcionadas por los mods ausentes. También podrían presentarse errores durante la carga o inestabilidades en el juego.<br><br>Como alternativa, puedes cargar otra partida guardada que no dependa de dichos mods.\n"

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Se ha detectado que hay DLCs opcionales ausentes.<color value=@@clr_txt@@><br><br>La partida guardada depende de al menos un DLC no disponible o desactivado.<br><br>Si no esperabas esta situación, verifica el estado actual de los DLCs instalados.<br><br>Puedes cargar la partida igualmente, aunque se perderán las funcionalidades proporcionadas por los DLCs ausentes.<br><br>Como alternativa, puedes cargar otra partida guardada que no dependa de dichos DLCs."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_sel@@>Se ha detectado que hay DLCs necesarios ausentes.<color value=@@clr_txt@@><br><br>La partida guardada depende de al menos un DLC no disponible o desactivado.<br><br>Para que la partida funcione correctamente, los DLCs deben estar instalados y activos.<br><br>Como alternativa, puedes cargar otra partida guardada que no dependa de dichos DLCs."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Se ha detectado que hay DLCs ausentes que son necesarios para un mod.<color value=@@clr_txt@@><br><br>Al menos un mod depende de DLCs no disponibles o desactivados.<br><br>Es necesario desactivar el mod afectado o instalar los DLCs necesarios."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Se ha producido un cierre inesperado.<color value=@@clr_txt@@><br><br>Parece que el juego ha tenido un problema al cargar la partida.<br><br>Puedes tratar de identificar el problema e intentar solucionarlo usando la siguiente información. Como alternativa, puedes probar a cargar otra partida guardada.<br><br>Este problema puede ser común por los siguientes motivos:<br><br>1. Alguno de los mods activos no es compatible con la versión actual del juego.<br><br>2. Se ha desactivado o eliminado alguno de los mods que se usaban en la partida guardada.<br><br>3. El uso de un mod defectuoso ha dañado la partida guardada.<br><br>4. Un fallo en los controladores o el hardware podría ser el causante del problema."

	key[]: "mods_detected_warning"
	val[]: "Se ha detectado que hay mods activados. Ten en cuenta que los mods obsoletos, incompletos o incompatibles pueden provocar inestabilidades. Revisa aquellos que estén activos desde el Gestor de mods." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

