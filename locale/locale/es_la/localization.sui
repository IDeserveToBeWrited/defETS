	key[]: "imgup_disabled"
	val[]: "Las subidas están actualmente desactivadas. Prueba a intentarlo de nuevo más tarde." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Se ha producido un error desconocido durante la subida. Prueba a intentarlo de nuevo más tarde." #+ Error message shown when no more specific message applies.
#@}

