#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "El archivo de la fotografía es demasiado grande. Prueba a reducir la resolución de pantalla." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "El archivo de la fotografía está dañado o no es soportado." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "El archivo de la fotografía es demasiado grande. Prueba a reducir la resolución de pantalla." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "El servicio en línea ha rechazado la fotografía." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Esta cuenta no tiene permisos para subir fotografías." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
