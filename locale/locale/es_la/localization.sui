#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuar ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Bienvenido a Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Al fin tienes la oportunidad de experimentar el trabajo de tus sueños: ¡conducir un camión!"

	key[]: "intro_3"
	val[]: "Tu nueva empresa de transporte ya está abierta al público, pero, por desgracia, no tienes dinero suficiente para comprar un camión. De momento, tendrás que trabajar como conductor para otras empresas."

	key[]: "intro_4"
	val[]: "Tu tarea es entregar de forma segura un cargamento de $JOB_CARGO$ a la dársena de $JOB_TARGET_COMPANY$ en $JOB_TARGET_CITY$. Tu jefe te ha proporcionado un vehículo y asumirá todos los gastos. No decepciones a nadie y entrega la carga tiempo."


	key[]: "intro_garage_1"
	val[]: "Esta es su sede."

	key[]: "intro_garage_2"
	val[]: "Es un garaje bastante simple y puede no parecer gran cosa, pero por algo se empieza."

	key[]: "intro_garage_3"
	val[]: "Por desgracia, todavía no tienes nada que estacionar en él, así que no hay nada que hacer aquí de momento."

	key[]: "intro_garage_4"
	val[]: "Una vez hayas ganado suficiente dinero y tengas un camión en propiedad, podrás moverte por el mundo libremente y llevar tu propio negocio en adelante."

	key[]: "intro_garage_5"
	val[]: "¡Buena suerte!"


	key[]: "desktop_tut_t"
	val[]: "FUNCIÓN DESBLOQUEADA"

	key[]: "desktop_tut_job"
	val[]: "Elije tu próximo trabajo"

	key[]: "desktop_tut_cargo_market"
	val[]: "Usa tu nuevo remolque para acceder al mercado de mercancías con el fin de llevar hasta sus destinatarios una gran variedad de artículos." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Aquí puedes ver tu progreso."

	key[]: "desktop_tut_company"
	val[]: "Echa un vistazo a tus garajes, contrata conductores y gestiona tu empresa desde aquí."

	key[]: "desktop_tut_trailers"
	val[]: "Ahora puedes comprar tus propios remolques y mejorarlos o pintarlos para que vayan a juego con tu camión.<br><br>Podrás guardarlos en el garaje que elijas, y permitir que tus conductores los usen para aumentar los beneficios de la empresa. Para gestionarlos, usa el Gestor de remolques."

	key[]: "desktop_tut_visit_directive"
	val[]: "Ir a $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "NUEVA PANTALLA DE INICIO"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Te damos la bienvenida a la nueva pantalla de inicio.<br>Desde aquí podrás interactuar con todas las características del juego."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "El panel inferior te proporciona acceso a todas las funciones principales que ya conoces."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "La barra superior te ofrece información relevante acerca de las estadísticas de tu perfil y las normativas vigentes durante los desplazamientos."

	key[]: "desktop_tut_tour_home"
	val[]: "El botón inicio te devolverá siempre a esta pantalla."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "El menú acceso te permite desplegar y acceder rápidamente a las funciones del juego desde cualquier sección."

	key[]: "desktop_tut_tour_drive"
	val[]: "El botón conducir sigue siendo tu conexión directa para devolverte al mundo de la conducción."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "GRACIAS POR TU TIEMPO"

	key[]: "desktop_tut_tour_finish"
	val[]: "Te damos las gracias por echar un vistazo a nuestra actualización de la pantalla de inicio."
#@}


	key[]: "show_help"
	val[]: "Alterna los consejos de la ayuda."

	key[]: "weblinks_t"
