#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Permite seleccionar la imagen de fondo que se muestra al desplazarse por los menús."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Establece de forma aleatoria el tema de fondo cada vez que se inicia el juego."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Establece el tiempo de retardo tras el cual los elementos del fondo se desvanecen."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Permite sufrir los efectos de la fatiga al conducir durante tiempos prolongados.<br><br>No descansar adecuadamente conlleva a recibir infracciones de tráfico."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Habilita las infracciones de tráfico por no respetar las normas de circulación. El riesgo aumenta cerca de vehículos policiales, radares y cámaras."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta la distancia promedio de los trabajos que se ofertan."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece el límite de velocidad que se muestra en el widget."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia el velocímetro del widget a rojo al superar el límite de velocidad."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Muestra un widget que permite omitir el estacionado del remolque al llegar al destino."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite mantener todos los widgets ocultos."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite mantener los retrovisores de la interfaz ocultos."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite mantener todas las notificaciones ocultas incluso al recibirlas."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Muestra una ventana resumen de las capacidades del camión actual antes de aceptar un trabajo de mercancías pesadas."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece cómo se alinea el mapa del mundo."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece cómo debe mostrarse la navegación en Route Advisor."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia el modo de navegación.<br><br>- El mejor: equilibra de forma eficaz la distancia y el tiempo, algo que consigue evitando, por ejemplo, vías con semáforos.<br>- El más corto: busca siempre la ruta más corta posible.<br>- Carreteras secundarias: evita el uso de vías rápidas siempre que sea posible."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Determina la dificultad del estacionamiento.<br><br>- Elegir siempre: permite seleccionar cómo hacerlo nada más llegar al destino.<br>- Estacionamiento seguro: no requiere realizar maniobras marcha atrás.<br>- Estacionamiento experto: normalmente requiere maniobras más complejas marcha atrás."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta la probabilidad de encontrar imprevistos en carretera, como accidentes, vehículos en el arcén o escombros en el asfalto."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: ""

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta la probabilidad de las inclemencias meteorológicas."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra información de la zona horaria además de la hora actual."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra las escenas típicas que se reproducen al realizar compras o mejoras."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra las señales flotantes que aparecen en aquellas intersecciones por las que no se puede acceder. Haz esto con conocimiento y precaución, ya que podrías llegar a colisionar repentinamente con bloqueos invisibles mientras conduces."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Invierte el eje vertical del ratón al controlar la cámara durante la partida."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Determina el tipo de transmisión.<br>- Automática sencilla: permite usar el acelerador y el freno para avanzar e ir marcha atrás.<br>- Automática real: requiere una entrada para alternar entre marchas.<br>- Secuencial: precisa que se realicen cambios de marchas de manera manual con entradas para subirlas y bajarlas.<br>- Palanca de cambios en H: requiere un controlador con posiciones de cambio para seleccionar las marchas manualmente."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite usar la función de omisión de cambios; es decir, saltar marchas cuando sea necesario o práctico para evitar cambiar cada una de las marchas de la transmisión."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Retorna el volante a la posición central al usar un teclado o controlador.<br><br>Mantenerlo deshabilitado requiere hacerlo manualmente tras realizar el giro."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta el rango del desplazamiento del volante."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la intensidad de los frenos."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la estabilidad del camión bajando su centro de gravedad."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la estabilidad del remolque bajando su centro de gravedad."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la intensidad del par generado por la transmisión.<br><br>Aumentar este ajuste produce una mayor sensación de que el camión gira hacia la derecha."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la rigidez de la suspensión del chasis."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la rigidez de la suspensión de la cabina."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta la intensidad de los baches generados proceduralmente para dar a las carreteras y otros terrenos una sensación de imperfección.<br><br>El efecto percibido puede ser más o menos prominente dependiendo de los ajustes en la suspensión y la cámara."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite un acoplamiento más real al requerir una mayor precisión para alinear la quinta rueda del camión con el perno rey del remolque.<br><br>Mantenerla deshabilitada permite que ello sea mucho más sencillo, ya que no hay colisión entre ambos elementos."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Determina si los cables del remolque reaccionan al movimiento y cuáles.<br><br><color value=@@clr_txt_d@@>Permitir la animación de los cables en otros vehículos puede afectar al rendimiento en equipos más antiguos."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Alterna el limitador de velocidad electrónico del camión de 90 km/h o 56 mph.<br><br><color value=@@clr_txt_d@@>Las entregas World of Trucks tienen esta función activada permanentemente."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Permite que los limpiaparabrisas se activen y ajusten su velocidad de acuerdo a las condiciones meteorológicas si se establecen en su primera posición."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa la intervención automática del retarder al frenar."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite que los frenos sigan activos en una pendiente para facilitar al vehículo un arranque suave."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa la intervención automática del freno motor al frenar."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Arranca el motor nada más usar el acelerador."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Habilita el uso del freno de estacionamiento de forma predeterminada en diversas situaciones, como al usar un ferry, ser remolcado hasta un taller o usar desplazamientos rápidos."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Despliega automáticamente los ejes elevables cuando es necesario debido al peso del vehículo."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite mantener un nivel de aceleración reducido por defecto. Tras pulsar rápidamente el comando de aceleración dos veces, el vehículo mantendrá el acelerador al máximo hasta que se suelte dicho comando.<br><br>Solo afecta al uso con teclado."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simula la pérdida de aire real debido al uso excesivo de los frenos.<br><br>Se debe gestionar la presión de aire al descender por pendientes o realizar maniobras lentas que requieren del uso continuado de los frenos."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite que el sistema ABS bloquee las ruedas para mantener el control y optimizar la capacidad de frenado."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite que el camión frene en cada rueda para evitar el derrape, el subviraje o el sobreviraje, y mantener así el control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite al camión mejorar la tracción si las ruedas comienzan a patinar."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia el incremento de velocidad al que aumentará o disminuirá el control de crucero cuando se pulse el comando correspondiente."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la tolerancia del control de crucero para mantener la velocidad deseada."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite que el control de crucero ajuste automáticamente la velocidad para mantener una distancia de seguridad con el vehículo que circula delante."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa el frenado de emergencia si el sistema detecta una colisión inminente.<br><br>Permite decidir si solo reacciona ante vehículos o ante cualquier obstáculo."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Determina el modo de asistencia en carril.<br><br>- Advertencia de salida de carril: avisa cuando se abandona el carril.<br>- Apoyo de permanencia en carril: además de avisar, el asistente corrige la trayectoria del camión de forma automática para evitar que se salga.<br><br>Ambos modos solo están activos a velocidades superiores a 55 km/h o unos 35 mph.<br>El sistema también tiene en cuenta el uso de los intermitentes antes de activarlo."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Habilita las funciones del sensor de ángulos muertos que contenga el camión."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Enciende los faros de forma automática en condiciones de poca luz si estos se encuentran en la primera posición."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Atenúa de forma automática el alumbrado de carretera cuando un vehículo se aproxima en sentido contrario o al acercarse al de delante."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Apaga los intermitentes de forma automática tras girar y retornar el volante a su posición central."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Permite que los accesorios decorativos de la cabina reaccionen a los movimientos del vehículo."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Habilita la guiñada de la cámara interior según la dirección."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la reacción de la función de rotación de la cámara al girar según la dirección."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia el comportamiento de la función de rotación de la cámara al girar al ir marcha atrás."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Desplaza la cámara interior hacia la izquierda o hacia la derecha según el intermitente usado."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite que la cámara interior reaccione según el movimiento del vehículo."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la reacción de la cámara interior de acuerdo al movimiento del vehículo."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite que la cámara interior gire de acuerdo a la dirección del vehículo."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece el tiempo que tarda la cámara en centrarse de forma automática.<br><br>El vehículo debe moverse a cierta velocidad para que ello se lleve a cabo. Solo funciona sobre las cámaras interior y dinámica al desplazarse hacia delante, y sobre la cámara asomada al circular marcha atrás."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Establece la velocidad de movimiento de la cámara durante el autocentrado de la misma y al alternar entre los preajustes de la cámara interior."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determina cómo funciona el zoom en la cámara interior.<br><br>Mantener: acerca temporalmente la cámara mientras se mantiene pulsado el comando.<br>- Alternar: activa o desactiva el zoom con cada pulsación." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Establece el idioma del juego."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Cambia los preajustes actuales y las unidades en función de la región seleccionada."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra los nombres de países y ciudades en el idioma seleccionado."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra los nombres de países y ciudades tanto en el idioma nativo como en el seleccionado."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Establece la moneda a usar."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Establece la notación horaria en 12 o 24 horas."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Establece las unidades de longitud a mostrar."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Establece las unidades de peso a mostrar."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Establece las unidades de temperatura a mostrar."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Establece las unidades de presión a mostrar."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Establece las unidades de volumen a mostrar."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Establece las unidades de consumo a mostrar."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra el chat durante las sesiones de convoy al pulsar la tecla o botón que se ha asignado a la acción Activar."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Mantiene la barra de entrada del chat activa tras enviar un mensaje."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Desvanece los mensajes del chat a los pocos segundos de enviar cada uno."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Cambia la duración de los mensajes del chat antes de que desaparezcan."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Muestra los nombres de los jugadores sobre sus correspondientes vehículos durante las sesiones de convoy."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Abre un menú avanzado que permite configurar las respuestas rápidas durante las sesiones de convoy."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Comprueba el estado del contenido que está conectado a World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Descarga noticias recientes acerca del juego en el menú principal."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Descarga capturas de pantalla seleccionadas entre la comunidad de World of Trucks para que aparezcan como pantallas de carga."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Descarga anuncios reales para mostrarlos en las diversas vallas publicitarias del juego."
#@}

