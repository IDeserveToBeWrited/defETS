#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Conexión de red no disponible. Por favor, compruebe que la configuración del cliente es correcta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Imposible establecer una conexión al servicio en línea. Por favor verifica la correcta funcionalidad de tu conexión a internet."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Error durante la comunicación con el servicio online. Por favor, inténtelo de nuevo más tarde."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Datos incorrectos devuelto por el servicio online. Si el proxy HTTP está en uso, verifica su configuración. Si no, vuelve a intentarlo más tarde."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Datos incorrectos devuelto por el servicio online. Por favor, inténtelo de nuevo más tarde."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "El servicio no es compatible con la versión actual del juego. Favor de verificar si un nuevo parche para el juego esté disponible."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "El servicio no está disponible actualmente. Por favor, inténtelo de nuevo más tarde."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "El servicio está actualmente fuera de servicio por mantenimiento o sobrecargado. Por favor, inténtelo de nuevo más tarde."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "La información de autenticidad no es válida. Por favor, intenta iniciar sesión de nuevo."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "La cuenta en línea está actualmente bloqueada tras detectar demasiados intentos de acceso fallidos. Prueba a intentarlo de nuevo en media hora."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "La cuenta en línea está actualmente bloqueada tras detectar intentos de acceso sospechosos. Prueba a intentarlo de nuevo en veinticuatro horas."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "El juego no está registrado en esta cuenta en línea."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "La cuenta en línea aún no ha sido activada. Comprueba si has recibido el mensaje de activación en la bandeja de entrada de tu correo electrónico."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "La cuenta en línea ha sido suspendida. Contacta con el soporte técnico en support@scssoft.com para obtener ayuda."

# The account was banned.
	key[]: "generic_banned"
	val[]: "La cuenta en línea ha sido bloqueada. Contacta con el soporte técnico en support@scssoft.com para obtener ayuda."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "La autenticación del proxy no es soportada por este juego. Por favor, use un proxy distinto o conexión directa."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "El elemento requerido no está disponible en este momento. Prueba a intentarlo de nuevo más tarde."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Error de SSL. No se ha podido establecer una conexión segura."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "El juego se ha suspendido durante la comunicación en línea. Prueba a intentarlo de nuevo más tarde."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Error interno. El archivo net.log podría contener más información."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 is having a problem and is unable to draw graphics on your computer (no valid graphics device was found).\nSuggested steps:\n\n1. Check that your computer and video card meet the minimum hardware requirements.\n2. Update your computer to the latest version of Microsoft's DirectX.\n3. Download and install the latest graphics drivers for your video card from your vendors' website - your graphics drivers are likely out of date.\n4. Try changing the rendering method from OpenGL to DirectX or vice versa.\n5. Delete the game configuration file 'config.cfg' in your 'Documents' - 'Euro Truck Simulator 2' folder. It may have become corrupted.\n    This file will be automatically re-created with valid default values on next game launch."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 tiene un problema y no es capaz de dibujar gráficos en tu computadora (ningún dispositivo gráfico válido fue encontrado)."
#@}

