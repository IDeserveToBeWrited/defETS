	key[]: "misc_category_controller"
	val[]: "OTROS" #+ Header of the 'Other' settings section. Please keep in upper case where possible.

	key[]: "color_feedback"
	val[]: "Color de la retroiluminación" #+ Checkbox enabling Color feedback effects for supported devices like Razer Chroma etc.
#@}

#+ Eye tracking configuration
#@{
	key[]: "eye_tracking"
	val[]: "SEGUIMIENTO DE LA MIRADA" #+ Header of the section. Please keep in upper case where possible.

	key[]: "eye_tracking_enable"
	val[]: "Seguimiento de la mirada" #+ Eye tracking enable checkbox

	key[]: "eye_tracking_enable_no_hw"
	val[]: "Seguimiento de la mirada" #+ Eye tracking enable checkbox if no eye compatible eye tracking HW is detected

	key[]: "eye_configure"
