	key[]: "o_im_throttle_op_tooltip"
	val[]: "Asigna un comando para acelerar."

	key[]: "o_im_back_reverse_op_tooltip"
	val[]: "Asigna un comando para frenar.<br><br>Se usará también para circular marcha atrás al seleccionar la transmisión automática sencilla."

	key[]: "o_im_left_op_tooltip"
	val[]: "Asigna un comando para dirigirse hacia la izquierda."

	key[]: "o_im_right_op_tooltip"
	val[]: "Asigna un comando para dirigirse hacia la derecha."

	key[]: "o_im_gear_up_op_tooltip"
	val[]: "Asigna un comando para cambiar de marcha hacia arriba."

	key[]: "o_im_gear_down_op_tooltip"
	val[]: "Asigna un comando para cambiar de marcha hacia abajo."

	key[]: "o_im_gear_neutral_op_tooltip"
	val[]: "Asigna un comando para poner punto muerto."

	key[]: "o_im_gear_drive_op_tooltip"
	val[]: "Asigna un comando para desplazarse hacia delante."

	key[]: "o_im_gear_reverse_op_tooltip"
	val[]: "Asigna un comando para desplazarse hacia atrás."

	key[]: "o_im_gear_up_hint_op_tooltip"
	val[]: "Asigna un comando para indicar a la transmisión automática que cambie a una marcha superior antes de que lo haga por sí misma."

	key[]: "o_im_gear_down_hint_op_tooltip"
	val[]: "Asigna un comando para indicar a la transmisión automática que cambie a una marcha inferior antes de que lo haga por sí misma."

	key[]: "o_im_trans_semi_switch_op_tooltip"
	val[]: "Asigna un comando para alternar entre la transmisión automática real y la trasmisión secuencial."

	key[]: "o_im_auto_transmission_mode_op_tooltip"
	val[]: "Asigna un comando para cambiar entre los diferentes modos de la transmisión automática adaptativa."

	key[]: "o_im_engine_op_tooltip"
	val[]: "Asigna un comando para alternar el motor."

	key[]: "o_im_engine_electricity_op_tooltip"
	val[]: "Asigna un comando para encender y apagar el sistema eléctrico.<br><br>Al hacerlo, deberás activarlo antes de arrancar el motor, y detenerlo desconectando dicho sistema en lugar de usar el comando clásico para arrancar y detener el motor."

	key[]: "o_im_parkingbrake_op_tooltip"
	val[]: "Asigna un comando para alternar el freno de estacionamiento."

	key[]: "o_im_motorbrake_op_tooltip"
	val[]: "Asigna un comando para usar el freno motor.<br><br>Este permanecerá activo el tiempo que se mantenga pulsado."

	key[]: "o_im_engine_brake_tgl_op_tooltip"
	val[]: "Asigna un comando para alternar el freno motor.<br><br>Este permanecerá activo hasta que se pulse de nuevo."

	key[]: "o_im_engine_brake_up_op_tooltip"
	val[]: "Asigna un comando para aumentar el freno motor."

	key[]: "o_im_engine_brake_down_op_tooltip"
	val[]: "Asigna un comando para reducir el freno motor."

	key[]: "o_im_auto_engine_brake_op_tooltip"
	val[]: "Asigna un comando para alternar el freno motor automático."

	key[]: "o_im_trailer_brake_op_tooltip"
	val[]: "Asigna un comando para usar el freno del remolque."

	key[]: "o_im_retarder_up_op_tooltip"
	val[]: "Asigna un comando para aumentar el retarder."

	key[]: "o_im_retarder_down_op_tooltip"
	val[]: "Asigna un comando para reducir el retarder."

	key[]: "o_im_auto_retarder_op_tooltip"
	val[]: "Asigna un comando para alternar el retarder automático."

	key[]: "o_im_lift_axle_op_tooltip"
	val[]: "Asigna un comando para alternar la posición de los ejes, siempre y cuando el camión disponga de ejes elevables."

	key[]: "o_im_lift_axle_trailer_op_tooltip"
	val[]: "Asigna un comando para alternar la posición de los ejes, siempre y cuando el remolque disponga de ejes elevables."

	key[]: "o_im_slide_axle_manual_op_tooltip"
	val[]: "Asigna un comando para alternar el modo de ajuste manual del eje, siempre y cuando el remolque tenga uno deslizante. El modo de ajuste manual frena las ruedas del remolque y desacopla el eje del chasis, por lo que su posición puede ajustarse moviendo el camión.<br><br>Una vez desacoplado, los ejes se mueven de forma automática para adaptarse a la situación actual."

	key[]: "o_im_diff_lock_op_tooltip"
	val[]: "Asigna un comando para alternar el diferencial."

	key[]: "o_im_front_susp_up_op_tooltip"
	val[]: "Asigna un comando para ajustar la altura de la suspensión delantera del camión hacia arriba."

	key[]: "o_im_front_susp_down_op_tooltip"
	val[]: "Asigna un comando para ajustar la altura de la suspensión delantera del camión hacia abajo."

	key[]: "o_im_rear_susp_up_op_tooltip"
	val[]: "Asigna un comando para ajustar la altura de la suspensión trasera del camión hacia arriba."

	key[]: "o_im_rear_susp_down_op_tooltip"
	val[]: "Asigna un comando para ajustar la altura de la suspensión trasera del camión hacia abajo."

	key[]: "o_im_trailer_susp_up_op_tooltip"
	val[]: "Asigna un comando para ajustar la altura de la suspensión del remolque hacia arriba."

	key[]: "o_im_trailer_susp_down_op_tooltip"
	val[]: "Asigna un comando para ajustar la altura de la suspensión del remolque hacia abajo."

	key[]: "o_im_susp_reset_op_tooltip"
	val[]: "Asigna un comando para restablecer la altura de la suspensión."

	key[]: "o_im_lblinker_op_tooltip"
	val[]: "Asigna un comando para alternar el intermitente izquierdo."

	key[]: "o_im_rblinker_op_tooltip"
	val[]: "Asigna un comando para alternar el intermitente derecho."

	key[]: "o_im_4wflasher_op_tooltip"
	val[]: "Asigna un comando para alternar ambos intermitentes como señal de emergencia."

	key[]: "o_im_lights_op_tooltip"
	val[]: "Asigna un comando para alternar el alumbrado. Dependiendo de las veces que se pulse se activará el de posición, el de cruce o nada."

	key[]: "o_im_hb_light_op_tooltip"
	val[]: "Asigna un comando para alternar el alumbrado de carretera."

	key[]: "o_im_beacon_op_tooltip"
	val[]: "Asigna un comando para alternar la iluminación de baliza que contenga el camión y el remolque."

	key[]: "o_im_horn_op_tooltip"
	val[]: "Asigna un comando para usar la bocina electrónica."

	key[]: "o_im_air_horn_op_tooltip"
	val[]: "Asigna un comando para usar la bocina de aire, siempre y cuando el camión disponga de una."

	key[]: "o_im_light_horn_op_tooltip"
	val[]: "Asigna un comando para usar el alumbrado de carretera para dar ráfagas."

	key[]: "o_im_wipers_op_tooltip"
	val[]: "Asigna un comando para aumentar la velocidad de los limpiaparabrisas."

	key[]: "o_im_wipers_back_op_tooltip"
	val[]: "Asigna un comando para reducir la velocidad de los limpiaparabrisas.<br><br>Esto quiere decir que cada pulsación ciclará cada posición en orden opuesto."

	key[]: "o_im_cruise_ctrl_op_tooltip"
	val[]: "Asigna un comando para alternar el control de crucero."

	key[]: "o_im_cruise_ctrl_inc_op_tooltip"
	val[]: "Asigna un comando para aumentar la velocidad deseada en el control de crucero."

	key[]: "o_im_cruise_ctrl_dec_op_tooltip"
	val[]: "Asigna un comando para reducir la velocidad deseada en el control de crucero."

	key[]: "o_im_cruise_ctrl_resume_op_tooltip"
	val[]: "Asigna un comando para reanudar la última velocidad deseada asignada en el control de crucero tras haberlo desactivado, por ejemplo, al frenar."

	key[]: "o_im_acc_mode_op_tooltip"
	val[]: "Asigna un comando para cambiar entre los diferentes modos del control de crucero adaptativo."

	key[]: "o_im_emergency_brake_op_tooltip"
	val[]: "Asigna un comando para alternar la característica de frenado de emergencia."

	key[]: "o_im_lane_keeping_assist_op_tooltip"
	val[]: "Asigna un comando para alternar la característica de asistencia activa de permanencia en carril."

