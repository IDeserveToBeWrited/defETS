	key[]: "aca_msg_book1_2_03_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror_possition_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror_possition_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_mirror_msg_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_mirror_msg_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_check1_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/where_to_park.mat width=336 height=248 color=FFFFFFFF></align><offset vshift=248>"
