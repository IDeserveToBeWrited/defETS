#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Conducción por giros complejos"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "En esta práctica veremos cómo maniobrar el remolque por un trayecto de obstáculos corto con giros más complicados."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Hacer los giros"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Atravesar el tramo estrecho"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Hacer el giro complejo de 90 grados"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Sortear las barreras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Al frente te encontrarás una serie de obstáculos y cruces desafiantes.<br>Pon en práctica todo lo que has aprendido hasta ahora y no te será complicado avanzar."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Las marcas viales te ayudarán a hacerte una idea de cómo superar cada uno de los obstáculos."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Pegarás la cabeza tractora al exterior del cruce, ya que tendrás que hacer un giro amplio porque el remolque seguirá un trazado más corto."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "El siguiente cruce será un giro sencillo de 90 grados.<br>De nuevo, pegarás el camión por el exterior y usarás todo el espacio del que dispones."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Llegados a este punto, deberás tomarte tu tiempo. A pesar de que el recorrido se abre, no está de más circular con precisión."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Evitarás acercarte demasiado a las barreras."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Mucho cuidado con este tramo.<br>Tendrás que abrirte con la cabeza tractora antes de acceder para guiar posteriormente el remolque por el mismo."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "El último giro de 90 grados es mucho más cerrado que el primero, pero dispondrás de espacio de sobra si lo usas con cabeza."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Estacionarás en la zona designada, inmovilizarás el camión y apagarás el motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Ten presente que las marcas viales te indican el recorrido.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Usar los retrovisores también te ayudará a desplazarte de forma segura. Deberás prestar atención en todo momento al movimiento del remolque.<br><br><font face=/font/big_bold.font>Continúa hasta el primer cruce.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observa el remolque al salir del giro y prepárate para el siguiente.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Procede hasta el siguiente giro.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Recuerda no quitarle el ojo al remolque para asegurarte de que no hay ningún obstáculo a tu alrededor antes de girar.<br><br><font face=/font/big_bold.font>Continúa rodeando las barreras que tienes delante.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Una vez superadas las barreras, realiza un giro cerrado hacia el lado del acompañante para alinearte con el siguiente tramo, el cual se estrecha bastante.<br><br><font face=/font/big_bold.font>Continúa a través del pasadizo.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "El siguiente tramo se debe atravesar con minuciosa precisión. Tómate tu tiempo y usa los retrovisores.<br><br><font face=/font/big_bold.font>Pégate al exterior de cada giro.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Este giro es bastante cerrado, pero puedes usar todo el espacio disponible al frente para superarlo con facilidad.<br><br><font face=/font/big_bold.font>Haz el último giro.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Conducción por ruta compleja con remolque"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "En esta última práctica del capítulo 3 conduciremos por un recorrido largo que incluye una considerable variedad de giros, y así veremos qué tal te las apañas maniobrando con un remolque."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Superar el giro y contragiro"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "ELIMINAR OBJETIVO"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Atravesar la mediana"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Atravesar el primer eslalon"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Atravesar el último eslalon"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Hacer los primeros giros"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Tomar la rotonda"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Continuar recto"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Realizar el giro cerrado"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Hacer los últimos giros"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Desplazarse hasta la plaza de aparcamiento"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Es hora de que te acostumbres a conducir un remolque por diferentes tipos de giros. Concéntrate, ajusta la velocidad de acuerdo a la situación y aprovecha al máximo el espacio del que dispondrás en este recorrido de práctica."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Para empezar, te encontrarás con un giro y contragiro, es decir, dos giros consecutivos en dos sentidos. Tendrás que girar hacia la izquierda y luego hacia la derecha en medio de la maniobra."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "El siguiente giro te llevará al otro lado de la mediana. No es particularmente difícil, pero tendrás que asegurarte de dejar espacio suficiente para el remolque."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "A continuación, atravesarás un eslalon bastante estrecho hecho con barreras. Circula despacio y usa los retrovisores. Asegúrate de abrirte lo suficiente para que el remolque pueda pasar sin problemas."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Seguidamente, entrarás en otro eslalon que además cuenta con unos conos de tráfico situados en el vértice de cada giro.<br>Procura no golpear ninguno."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Lo siguiente serán unos giros fáciles de camino a la rotonda."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Usarás el tramo recto para preparar el acceso a la rotonda. Pégate al exterior antes de entrar en ella."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Accederás a la rotonda vigilando el remolque, ya que una vez esté dentro se desplazará de forma diferente a como entró."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Abandonarás la rotonda y conducirás hasta el siguiente tramo."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "ELIMINAR CINEMÁTICA"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Este giro es extremadamente cerrado, así que tómatelo con calma y usa el espacio sabiamente. Tendrás que vigilar cómo se desplaza la parte posterior del remolque."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Al atravesar los siguientes giros, recuerda prepararte nada más salir para el que atravesarás a continuación."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "No te precipites en el último giro. Parece fácil, pero tendrás menos margen de maniobra del que parece."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Estacionarás en la zona designada, inmovilizarás el camión y apagarás el motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Acelera y acércate al primer giro.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "El giro que viene cuenta también con un contragiro.<br><br><font face=/font/big_bold.font>Haz el giro.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "ELIMINAR MARCA"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Más adelante, el recorrido continúa por la izquierda de la mediana.<br><br><font face=/font/big_bold.font>Ábrete paso a través del cruce.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Maniobra entre las barreras y procura no perder de vista el remolque.<br><br><font face=/font/big_bold.font>Conduce a través del eslalon.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "El siguiente eslalon es más sencillo, pero los conos de tráfico hacen que se estreche.<br><br><font face=/font/big_bold.font>Circula por el eslalon sin golpear los conos de tráfico.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Por delante tienes un par de giros fáciles, aunque tendrás que estar pendiente de mantener el remolque alejado de las barreras del interior.<br><br><font face=/font/big_bold.font>Realiza los giros.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Te aproximas a una rotonda. Procura no solo dejar espacio para el remolque al entrar y salir, sino también al circular por ella.<br><br><font face=/font/big_bold.font>Transita por la rotonda.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Más adelante tienes una recta, por lo que puedes acelerar un poco si quieres.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Este giro es extremadamente cerrado. Ve despacio, aprovecha todo el espacio del que dispones y vigila cómo se desplaza la parte posterior del remolque.<br><br><font face=/font/big_bold.font>Realiza el giro.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Los últimos giros son más sencillos; no obstante, ten en cuenta el remolque.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Dirígete hacia la plaza de aparcamiento.</font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

