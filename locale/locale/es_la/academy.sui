#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Frenada junto a obstáculos"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "En esta práctica hablaremos del espejo frontal; el por qué de su ubicación y cómo usarlo para detenernos junto a un obstáculo al frente."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Revisar el espejo frontal"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Comprender su función"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Detener la marcha junto a obstáculos"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Los camiones tienen un punto ciego considerable justo delante de la cabeza tractora, por lo que es fácil perder de vista un peatón o un coche. Por ello, están equipados con un espejo frontal que puede verse a través del parabrisas."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Este espejo mitiga ese punto ciego para el conductor.<br>Considéralo una herramienta esencial para no chocar contra un obstáculo al maniobrar en espacios reducidos."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Deberás iniciar la marcha, acercarte a la barrera que tendrás al frente y reducir la velocidad a medida que te acerques a ella manteniendo un ojo en el espejo frontal."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Deberás detenerte entre la línea y el obstáculo."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Empecemos dando uso al espejo frontal.<br><br><font face=/font/big_bold.font>Gira la cámara hacia la parte superior del parabrisas.</font>@@aca_goal_tip@@ Debes permanecer en el interior del vehículo."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "El espejo elimina el punto ciego que tiene el frontal del camión, por lo que te ayudará a moverte de manera segura y precisa.<br><br>Puedes regular su posición en «@@adjust_link_t@@» desde el menú de pausa si la actual no te convence.<br><br><font face=/font/big_bold.font>Pulsa @@imv_nrm_activate@@ para continuar.</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Justo delante del camión verás un punto señalizado y un obstáculo al otro lado del mismo. Cuando te acerques, aminora la marcha y revisa la distancia que lo separa del camión mediante el espejo frontal.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Si el camión no se mueve, comprueba que no te has olvidado de nada, como arrancar el motor o quitar el freno de estacionamiento."

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Dirígete hacia la plaza de aparcamiento.</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Detén el camión entre el obstáculo y la línea marcada.</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

