	key[]: "aca_scenario_book3_double_90_title"
	val[]: "Giros de 90 grados"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "En esta práctica tendrás que conducir por un recorrido con giros de 90 grados de diversa dificultad."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Iniciar la marcha"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Seguir hacia adelante"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Usar los retrovisores"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Aprovechar el espacio disponible"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Prepararse"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Planificar con antelación"

