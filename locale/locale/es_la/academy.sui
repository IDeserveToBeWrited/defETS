	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Alinea el conjunto y detente en la zona designada."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Inmoviliza el camión y detén el motor."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Corrección de marcha atrás en línea recta"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "En esta práctica te pondrás al volante tras el intento de otro conductor de dar marcha atrás en línea recta. Corregirás su error y aparcarás el camión en el lugar indicado."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Enderezar"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Conducir marcha atrás"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Parece que alguien ha intentado dar marcha atrás con este conjunto para aparcar y ha tenido un pequeño contratiempo. Es tu turno de coger el volante y solucionarlo."

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "El primer paso será avanzar y alinear el conjunto hasta obtener una posición manejable. Es crucial que el remolque trasero quede orientado hacia la dirección deseada."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "En este caso optaremos por llevar la maniobra hacia el lado del conductor. Así, veremos mejor lo que hacemos y podremos maniobrar desde un solo lado.<br><br>Ten en cuenta que controlarás el remolque trasero mediante el delantero, así que no centres tu atención en la cabeza tractora."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Una vez el conjunto esté más o menos en posición, avanzaremos de nuevo para alinearlo correctamente."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Desde aquí retrocederemos con mucho cuidado hasta colocarnos en la plaza de aparcamiento, asegurándonos de que el remolque trasero no se desvíe de su trayectoria."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Entonces, podremos alinear el remolque delantero y la cabeza tractora."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Avanza y endereza el conjunto.<br><br>Cuando lo creas oportuno, da marcha atrás hasta la zona indicada."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Ve marcha atrás hasta la zona designada."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Para el motor e inmoviliza el camión."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "90 grados marcha atrás"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "En esta práctica realizarás una maniobra de marcha atrás a 90 grados para aparcar junto a otros camiones en hilera."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Girar por completo"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Continuar la marcha"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Conducir marcha atrás"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Es más fácil retroceder con dobles hacia un lado, ya que verás mejor la maniobra desde la ventanilla."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Primero avanzarás y harás un cambio de sentido al final de la hilera. De este modo, podrás posicionarte por el lado que te ofrecerá una mejor visión de la maniobra a través de la ventanilla del conductor."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Podrás colocar los remolques como mejor te convenga, quizá con el trasero ya apuntando al la plaza de aparcamiento. En este caso empezaremos desde una posición recta.<br><br>Recuerda no complicarte y usar el remolque delantero para guiar al remolque trasero."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Girarás ligeramente el remolque delantero, alejándolo de la plaza de aparcamiento, y verás cómo el remolque trasero empezará a orientarse hacia ella. A partir de ahí, ajustarás el ángulo entre ambos remolques para mantener una trayectoria controlada hacia la plaza de aparcamiento."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Ten presente que, si el remolque trasero entra muy cerrado, tendrás que reducir el ángulo del conjunto. Si, por el contrario, va muy abierto, deberás aumentarlo para corregirlo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Los ajustes que hagas con la cabeza tractora tienen solo la mitad de efecto en el remolque trasero que en el delantero, así que no tengas miedo y muévela con decisión."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "A estas alturas deberías anticiparte a lo que viene. Además de colocar el remolque trasero, tendrás que introducir el delantero en la plaza de aparcamiento, así que empezarás a preparar la maniobra para alinearlo justo delante del trasero."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "No es habitual acertar a la primera. En este caso nos hemos demorado en enderezar el delantero y ahora el trasero se está desviando de la trayectoria.<br><br>No pasa nada; bastará con avanzar un poco y probar de nuevo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Tendrás que mover el volante con firmeza para colocar los remolques en la posición deseada. Podrás avanzar las veces que haga falta hasta que la maniobra te convenza."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Y con eso, habrás conseguido estacionar el conjunto doble sin problemas."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Avanza hasta el final del aparcamiento y da la vuelta."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "No olvides abrirte bien en el giro."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Sigue avanzando hasta que tengas espacio suficiente para maniobrar y, después, comienza a dar marcha atrás."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Da marcha atrás hasta la plaza de aparcamiento si crees que tienes espacio suficiente para maniobrar."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


