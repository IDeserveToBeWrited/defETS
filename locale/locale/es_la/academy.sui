#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
#!}

#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Estacionamiento junto a obstáculos"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "En esta práctica aprenderemos a aparcar cerca del bordillo usando el espejo lateral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Revisar el espejo lateral"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Desplazarse hacia el bordillo"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "El espejo lateral es otra herramienta que te ayudará a maniobrar con seguridad el camión. Se encuentra situado en la parte superior de la puerta del acompañante."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Avanzarás y girarás lentamente hacia el lado del acompañante."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Hemos colocado unos tablones a modo de bordillo junto a los que tendrás que estacionar.<br>Deberás girar en su dirección para ubicar el camión en buena posición y alinearlo con la plaza de aparcamiento."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Reducirás la velocidad antes de acercarte al bordillo y girarás hacia la plaza de aparcamiento. Al enderezarte, usarás el espejo lateral para calcular la distancia que te separa de los tablones."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Te detendrás en la plaza de aparcamiento e inmovilizarás el camión."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Gira la cámara hacia la puerta del acompañante para echar un vistazo al espejo lateral.</font>@@aca_goal_tip@@ Debes permanecer en el interior del vehículo."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "El espejo lateral proporciona la visibilidad que necesita el conductor para controlar ese lado. Se trata de uno de los puntos ciegos más problemáticos de un camión. Si la posición actual no te convence, puedes regularla en «@@adjust_link_t@@».<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Si el camión no se mueve, comprueba que no te has olvidado de nada, como arrancar el motor o quitar el freno de estacionamiento."

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Más adelante tienes un bordillo improvisado junto a una plaza de aparcamiento. El objetivo es avanzar hasta allí.<br><br><font face=/font/big_bold.font>Procede cuando consideres oportuno.</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Gira hacia el bordillo. Usa los espejos frontal y laterales para comprobar tu posición respecto al mismo y procura no golpear ningún cono de tráfico.<br><br><font face=/font/big_bold.font>Conduce hacia el bordillo y accede a la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Secure the truck and shut down the engine.</font>@@aca_goal_tip@@ You can use Interior Look presets to make looking at mirrors easier. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Estacionamiento marcha atrás junto a obstáculos"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "En esta práctica nos moveremos marcha atrás para aparcar junto a un bordillo."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Seguir las instrucciones"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Desplazarse hacia el bordillo"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Estacionar el vehículo"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Vamos a realizar una maniobra marcha atrás para aparcar junto a un bordillo."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Deberás desplazarte siendo consciente de lo que te rodea.<br>No olvides valerte de los retrovisores."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "A medida que te acerques, tendrás que empezar a alinear el camión con la plaza de aparcamiento. Deberás ir controlando ambos lados mientras te mueves marcha atrás."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Te detendrás en la plaza de aparcamiento e inmovilizarás el camión."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "La plaza de aparcamiento se encuentra detrás de ti por el lado del acompañante. Usa los retrovisores para orientarte hasta allí.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Recuerda comprobar los alrededores antes de mover el camión.<br><br><font face=/font/big_bold.font>Desplázate marcha atrás hacia el bordillo.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Sigue echando un ojo en torno al camión mientras accedes a la plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Detente en la zona designada.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Conducción por ruta compleja"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "La última parte de este capítulo consiste en conducir un recorrido de práctica avanzado, con el que pondremos a prueba lo que has aprendido con la cabeza tractora."

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Atravesar el eslalon"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Hacer el giro cerrado"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Cruzar la horquilla"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "Hacer el giro de 90 grados"

	key[]: "aca_goal_book1_2_06_check3"
	val[]: "Atravesar la pasarela"

	key[]: "aca_goal_book1_2_06_check4"
	val[]: "Atravesar el cruce de 90 grados"

	key[]: "aca_goal_book1_2_06_check5"
	val[]: "Detenerse junto a las barreras"

	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Cambiar de dirección"




	key[]: "aca_goal_book1_2_06_check8"
	val[]: "Realizar la maniobra"

	key[]: "aca_goal_book1_2_06_check9"
	val[]: "Cruzar el tramo en zigzag"

	key[]: "aca_goal_book1_2_06_check10"
	val[]: "Hacer el giro sencillo de 90 grados"

	key[]: "aca_goal_book1_2_06_check11"
