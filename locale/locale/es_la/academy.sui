#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Te damos la bienvenida a la primera parte del examen final. Ha llegado el momento de demostrar cómo te desenvuelves gracias a los conocimientos que has adquirido en la Driving Academy."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Lo primero será acoplar el remolque para circular con él por una ruta de práctica."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "El primer tramo consiste en conducir desde el aparcamiento hasta el recorrido de práctica."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Te encontrarás desafiantes pasadizos entre las barreras."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Una buena parte del recorrido discurre por la zona de prácticas oriental."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Pondremos a prueba tu habilidad para maniobrar el camión en diferentes entornos."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Realizarás unos cuantos giros cerrados."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Conducirás por el tramo de carretera que conecta los tramos."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "La parte final consiste en recorrer un pequeño circuito."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Te encontrarás con intrincados pasadizos y giros cerrados."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Para completar la prueba, deberás estacionar de manera precisa."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "No te preocupes, ya sabes todo lo que hay que saber para pasar la prueba.<br><br>¡Mucha suerte!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "El remolque se encuentra delante de ti.<br><br><font face=/font/big_bold.font>Conduce hasta el remolque.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Orienta la cabeza tractora hacia el remolque.<br><br><font face=/font/big_bold.font>Procede marcha atrás y conecta el perno rey.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Inmoviliza el camión.</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Pulsa @@imv_nrm_attach@@ para acoplar el remolque.</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Ya puedes ponerte en marcha.<br><br><font face=/font/big_bold.font>Quita el freno de estacionamiento.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Conduce hasta la salida del aparcamiento.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Sigue las marcas viales y ten cuidado con las barreras.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Te acercas a un tramo algo más complicado.<br><br><font face=/font/big_bold.font>Avanza con cuidado entre las barreras.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Esta parte pondrá a prueba tu habilidad para maniobrar un remolque por diferentes tipos de cruces.<br><br><font face=/font/big_bold.font>Gira hacia el recorrido.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Continúa a través del pasadizo.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Sigue avanzando.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Toma la curva con cuidado.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Te adentras en un tramo algo más complejo. Conduce con precaución.<br><br><font face=/font/big_bold.font>Sigue conduciendo cuesta abajo.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Realiza el giro cerrado a la izquierda.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Sal del trayecto.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Ahora entrarás en un tramo algo más sencillo.<br><br><font face=/font/big_bold.font>Sigue conduciendo cuesta abajo.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Sigue el trayecto.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Más adelante tienes el desvío hacia el siguiente recorrido.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Gira a la derecha.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Sigue conduciendo por el recorrido.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Te acercas a unos giros cerrados.<br><br><font face=/font/big_bold.font>Ajusta la velocidad en consecuencia.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Gira a la izquierda.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Haz la curva y sigue avanzando.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Puede que tengas que salirte del asfalto para poder realizar el giro.<br><br><font face=/font/big_bold.font>Gira con cuidado usando todo el espacio que necesites.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Sal del circuito y conduce hasta la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Última parte del examen final"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "En la última parte del examen se evaluarán los conocimientos de estacionamiento que has obtenido en las prácticas anteriores. Si lo haces con precisión y cautela, podrás lanzarte cuanto antes a las carreteras europeas como conductor acreditado."

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Maniobrar desde la posición"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Estacionar en diagonal"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Acceder a la plaza de aparcamiento"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Estacionar en paralelo"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Aparcar por última vez"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Es hora de terminar el examen final. Nos moveremos hasta un aparcamiento cercano y pondremos a prueba tus habilidades para dar marcha atrás y maniobrar para aparcar."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Evaluaremos tus aptitudes con varias maniobras de estacionamiento consecutivas."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "El espacio será limitado, así que ve con cuidado y tómatelo con calma."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Procura ir con cuidado y sin precipitarte. No pasa nada si no consigues aparcar a la primera; lo importante es que no dañes el vehículo ni los que te rodean.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Avanza hasta la primera parte del examen.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tu primera tarea consiste en demostrar que eres capaz de aparcar desde una posición no alineada. A tu izquierda verás la ubicación a la que tienes que desplazarte con el remolque.<br><br><font face=/font/big_bold.font>Aparca maniobrando desde la ubicación en la que te encuentras.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Lo siguiente es dar marcha atrás hacia una hilera de camiones estacionados. Ten cuidado de no chocar con ellos.<br><br><font face=/font/big_bold.font>Aparca en diagonal.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Procede a través del aparcamiento y vigila de no encontrarte con nada inesperado.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Ahora vamos a aparcar en paralelo entre dos camiones junto al bordillo que hay delante.<br><br><font face=/font/big_bold.font>Realiza la maniobra para estacionar.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "La última maniobra de estacionamiento te espera a tu izquierda. Aproxímate a la ubicación como consideres apropiado.<br><br><font face=/font/big_bold.font>Da marcha atrás hasta la zona designada.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Hemos acabado. Sal de la zona de prácticas y aparca el camión.<br><br><font face=/font/big_bold.font>Abandona el lugar por la izquierda.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Puedes estacionar el camión a la derecha de los demás.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Estacionamiento en paralelo con remolque"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "En esta práctica veremos cómo aparcar en paralelo con un remolque acoplado."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Detenerse en la zona marcada"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Aparcar con un remolque en paralelo es todo un reto de habilidad para cualquier camionero.<br>Ya sea para estacionar en una calle urbana o parar en un área de descanso, es una maniobra que hay que saber poner en práctica."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Antes de acceder a una plaza de aparcamiento, debes asegurarte de que tanto la cabeza tractora como el remolque caben en ella. Para esta ocasión nos hemos asegurado de que cuentes con espacio de sobra."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Te alinearás con el camión que se encuentra estacionado delante. Procura no acercarte demasiado para tener espacio en el que maniobrar."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Harás un giro cerrado, distanciándote de la plaza de aparcamiento, y comenzarás a dar marcha atrás. La idea es que el remolque se oriente hacia ella cuanto antes."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Una vez que el remolque apunte correctamente, podrás continuar la maniobra."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Empezarás a girar el remolque, alejándolo del bordillo, antes de que las ruedas del lado del conductor entren en la ubicación."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Enderezarás la cabeza tractora con el remolque y te alinearás con la plaza de aparcamiento.<br>Finalizarás apagando el motor e inmovilizando el camión."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "La plaza de aparcamiento se encuentra entre los otros camiones que tienes delante de ti. Asegúrate de revisar los retrovisores y mantener una distancia de seguridad con los obstáculos que te rodean mientras realizas la maniobra.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Muévete por la zona para encontrar la plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Sigue avanzando.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Conduce más allá de la plaza de aparcamiento hasta la zona marcada. Desde ahí podrás iniciar la maniobra marcha atrás.<br><br><font face=/font/big_bold.font>Detente en la ubicación marcada.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Gira la cabeza tractora, alejándote de la plaza de aparcamiento, para comenzar a mover el remolque hacia ella. Procura no hacerlo muy cerrado o acabarás llevándolo hacia el bordillo.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Alinea el remolque con la plaza de aparcamiento. Si es necesario, desplázate hacia delante o hacia atrás mientras realizas las maniobras necesarias para ajustar tu posición.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Enhorabuena. Has completado los exámenes de Nociones básicas con éxito y has demostrado que cuentas con las habilidades necesarias para llevar un camión."

	key[]: "aca_msg_book1_outro02"
	val[]: "Este es el primer paso en tu viaje para cumplir tu sueño y dedicarte a la conducción profesional de camiones."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Ya puedes salir a las carreteras europeas y enfrentarte a tus primeros desafíos."

	key[]: "aca_msg_book1_outro04"
	val[]: "Tu verdadera aventura empieza ahora."
#@}


