#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Vamos a darnos una vuelta con la cabeza tractora para poner en práctica tus recién aprendidas aptitudes al volante."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Te encontrarás diferentes tipos de giros a lo largo del recorrido. Ten en cuenta que esto no es una carrera y no hay límite de tiempo. Conduce con precaución y adapta la velocidad para sortear los obstáculos y giros que te encuentres."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "El comienzo es bastante sencillo, pero los giros se irán haciendo más complicados a medida que avances."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Presta atención a la velocidad; es fácil ir demasiado rápido y calcular mal en un giro."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "La salida del trayecto contiene una horquilla estrecha. Deberás ir despacio y usar todo el espacio disponible."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Estacionarás entre las barreras e inmovilizarás el camión."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Para completar esta práctica con éxito, tendrás que evitar chocarte, salirte del trayecto o golpear los conos de tráfico.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Avanza por la derecha para acceder al recorrido.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Atraviesa la curva manteniendo la velocidad.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Te acercas a una sección más compleja con curvas sinuosas.<br><br><font face=/font/big_bold.font>Adapta la velocidad en consecuencia y continúa.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Avanza hasta los siguientes giros.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Los siguientes giros son más fáciles de tomar. Mantén una velocidad constante.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Para salir del recorrido, has de atravesar una horquilla cerrada. Aminora la marcha y pégate al exterior antes de girar. No dudes en ayudarte con los retrovisores.<br><br><font face=/font/big_bold.font>Gira para abandonar el recorrido.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Al frente tienes un lugar para estacionar entre unas barreras.<br><br><font face=/font/big_bold.font>Procede hasta la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Estacionamiento en paralelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "En esta práctica veremos como aparcar en paralelo entre otros dos camiones."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Detenerse por delante de la plaza"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Comprobar los alrededores"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Acceder marcha atrás a la plaza"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Alinear el camión en el interior"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Aparcar en paralelo es algo esencial que todo camionero debe conocer.<br>Primero iniciarás la marcha."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Avanzarás hacia la plaza de aparcamiento prestando atención a tu alrededor."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Te alinearás con el camión que se encuentra estacionado delante. Procura no acercarte demasiado para tener espacio en el que maniobrar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Harás un giro cerrado hacia la plaza de aparcamiento y darás marcha atrás."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Recuerda mirar por el retrovisor del conductor y orientar el camión hacia la parte del bordillo que justo hay delante del camión estacionado detrás."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Una vez el parachoques delantero supere el camión estacionado delante, avanzarás mientras enderezas el volante para alinear el camión con la plaza de aparcamiento."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Con el camión debidamente enderezado y aparcado en la plaza, lo inmovilizarás."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Más adelante verás unos camiones estacionados. Entre ellos tienes un espacio disponible para aparcar.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Recuerda prestar atención a lo que te rodea. Haz un buen uso de los retrovisores durante la maniobra.<br><br><font face=/font/big_bold.font>Conduce hacia delante.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Conduce más allá de la plaza de aparcamiento, hasta la zona marcada. Desde ahí, podrás iniciar la maniobra marcha atrás.<br><br><font face=/font/big_bold.font>Detente en la ubicación marcada.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Revisa que no tengas obstáculos a tu alrededor para no chocar al dar marcha atrás.<br><br><font face=/font/big_bold.font>Mira por el retrovisor del acompañante.</font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Gira las ruedas y da marcha atrás hasta la plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Empieza a enderezar el camión cuando consideres oportuno. Procura no subirte al bordillo.<br><br><font face=/font/big_bold.font>Alinea el camión con la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Acoplamiento de remolque"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "En esta práctica explicaremos los fundamentos para acoplar y desacoplar el remolque a la cabeza tractora."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Dar marcha atrás hacia el remolque"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Acoplar el remolque"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Quitar el freno de estacionamiento"





	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Desacoplar el remolque"


	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Desacoplar el remolque"



	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Desacoplar el remolque"

	key[]: "aca_goal_book1_3_01_stop"
