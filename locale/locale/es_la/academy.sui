#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Finalizaremos este capítulo conduciendo por un trayecto de práctica con un diseño algo más complicado."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "El primer tramo consiste en atravesar un eslalon hecho con barreras. Recuerda que puedes ayudarte con los retrovisores."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Seguidamente te encontrarás con una horquilla. Realizarás un giro abierto para no tener problemas en superarla."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Te encontrarás un giro de 90 grados hacia la izquierda. Recuerda que deberás entrar hasta el fondo para que la parte posterior pase las barreras del interior."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "La pasarela puede ser algo complicada. Tendrás que alinearte lo mejor que puedas antes de acceder y usar los espejos frontal y laterales para orientarte."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "El siguiente tramo debe hacerse marcha atrás. Acércate a las barreras de delante teniendo eso en cuenta."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Seguirás las marcas viales hacia atrás y a la derecha."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Continuarás hasta llegar a las barreras y te detendrás. Seguidamente, avanzarás hacia la izquierda."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Procederás por la sección cortada de la mediana hasta el siguiente tramo."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "El espacio a través de los conos de tráfico es muy estrecho. Deberás conducir con cuidado y usar los retrovisores para guiarte."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "No olvides entrar hasta el fondo en los giros de 90 grados."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "El siguiente tramo es más cómodo. Podrás acelerar un poco si quieres, pero ten en cuenta que más adelante te encontrarás una curva y deberás aminorar la marcha."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Al final de la cuesta te toparás con unas barreras. Te acercarás y darás marcha atrás hasta la plaza de aparcamiento a la izquierda."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Seguirás marcha atrás hasta acceder a esta."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Una vez hayas estacionado, detendrás el motor e inmovilizarás el camión."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Al frente tienes un eslalon hecho con barreras.<br><br><font face=/font/big_bold.font>Conduce a través del eslalon.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Pégate al exterior del giro para asegurarte de que la parte posterior de la cabeza tractora no sobrepasa el bordillo.<br><br><font face=/font/big_bold.font>Realiza el giro.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Te acercas a un giro de 90 grados hacia la izquierda. Recuerda usar todo el espacio disponible.<br><br><font face=/font/big_bold.font>Haz el giro.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Alinéate con la pasarela. Ten en cuenta que no dispones de mucho espacio para hacer correcciones.<br><br><font face=/font/big_bold.font>Avanza por la pasarela.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Sigue el recorrido hacia la izquierda.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "El siguiente tramo debe hacerse marcha atrás. Detente cerca de las barreras al frente para poder moverte hacia atrás y a la derecha.<br><br><font face=/font/big_bold.font>Detente junto a las barreras.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Da marcha atrás hasta la zona que tienes a la derecha. Las flechas marcadas te guiarán.<br><br><font face=/font/big_bold.font>Conduce marcha atrás hasta el siguiente tramo.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continúa marcha atrás hasta las barreras que hay detrás de ti.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Detente y luego cambia el sentido de la marcha para continuar hacia la izquierda.<br><br><font face=/font/big_bold.font>Conduce hacia delante.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Atraviesa la sección cortada en la mediana a la izquierda.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Delante tienes un camino estrecho y serpenteante hecho con conos de tráfico. Conduce con cuidado y usa los retrovisores si fuera necesario.<br><br><font face=/font/big_bold.font>Conduce a través de los conos de tráfico.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continúa por el recorrido.<br><br><font face=/font/big_bold.font>Gira a la izquierda.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Recuerda pegarte a la izquierda antes de girar para disponer del mayor espacio posible.<br><br><font face=/font/big_bold.font>Haz el giro.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Puedes acelerar un poco por aquí, pero ten en cuenta que se avecina una curva.<br><br><font face=/font/big_bold.font>Avanza por el recorrido.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "La curva se vuelve más pronunciada a medida que te abres paso por ella.<br><br><font face=/font/big_bold.font>Ajusta la velocidad en consecuencia y continúa.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Al final de la cuesta verás unas barreras bloqueando la ruta.<br><br><font face=/font/big_bold.font>Detente junto a las barreras.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Detrás de ti, a la izquierda, tienes una plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Circula marcha atrás para estacionar.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Detente en la zona designada.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Conducción por ruta de maniobras"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "En esta práctica conduciremos por un trayecto diseñado para poner a prueba tu habilidad para maniobrar el camión por diferentes tipos de curvas y cruces."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Acceder al recorrido"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Girar gradualmente a la izquierda"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Tomar las curvas en zigzag"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Continuar recto"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Hacer los giros"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Abandonar el recorrido de práctica"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Aproximarse a la plaza de aparcamiento"
#!{
	key[]: "aca_goal_book1_2_08_stop"
