#+ Book 3 Scenario train
#@{

#### train common
	key[]: "aca_scenario_book3_train_title"
	val[]: "训练路段"

	key[]: "aca_scenario_book3_train_desc"
	val[]: "在这个场景中，我们将驾车驶入一条模拟真实弯道与车辆操控的训练路段。"

#### train goal

#!{
	key[]: "aca_goal_book3_train_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_train_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_train_check1"
	val[]: "提速"

	key[]: "aca_goal_book3_train_check2"
	val[]: "准备刹车"

	key[]: "aca_goal_book3_train_check3"
	val[]: "之字路"

	key[]: "aca_goal_book3_train_check4"
