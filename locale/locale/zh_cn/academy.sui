	val[]: "跟随路径点并注意它们的朝向。"

	key[]: "aca_msg_scenario_reverse_in_forward_out"
	val[]: "倒车进入标记点后，向前驶出。"

	key[]: "aca_msg_scenario_forward_in_reverse_out"
	val[]: "开进标记点后，倒车驶出。"

	key[]: "aca_msg_scenario_reverse_continue"
	val[]: "继续倒车。"

	key[]: "aca_msg_scenario_reverse_start"
	val[]: "开始倒车。"

	key[]: "aca_msg_scenario_reverse_barriers"
	val[]: "在路障间倒车。"

	key[]: "aca_msg_scenario_park_forward"
	val[]: "在指定地点停放卡车。"

	key[]: "aca_msg_scenario_park_reverse"
	val[]: "倒车停入指定地点。"

	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "路径点已到达"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "继续该场景。"

	key[]: "aca_msg_scenario_end_title"
	val[]: "停车入位"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>要结束该场景，请进行驻车制动并关闭发动机。</font>"

