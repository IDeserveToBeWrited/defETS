#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "组合驾驶操作"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "在这个场景中，我们将结合你新学到的技能来通过一个短促但具技术性的路段，这将涉及倒车过弯与应对直角急弯。"

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "朝驾驶员一侧倒车"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "直角弯"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "完成转弯"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "你的前方有一个路障。开到它那里再停下。"

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "驾驶员一侧的后方有另一道路障。请沿着弯道倒车来到达那里。道路标线可以用作指引。"

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "正前方有一个直角急弯。驶向那里。"

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "我们需要贴到弯道的边缘以便后轮有足够空间绕开弯道内侧的交通锥筒。<br>记得看后视镜！"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "调正车身，驶向最后的路障，停下，然后进行驻车制动。"

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>准备出发。 </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "卡车仍未准备好行驶，也许你忘记了什么？<br><br>发动机是否已启动？驻车制动是否已解除？"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "在你正前方的路障前有一个标记区域。<br><br><font face=/font/big_bold.font>向前行驶并在标记区域处停下。</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "在驾驶员一侧回头张望，你会看到那里有另一个标记区域。你需要同时进行倒车和转向。<br><br><font face=/font/big_bold.font>沿着弯道倒车并在标记区域停下。</font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "然后你将经过一个直角弯。<br><br>过弯前靠驾驶员一侧行驶，在深入弯道后迅速转弯，确保不要碰到内侧的锥筒。<br><br><font face=/font/big_bold.font>向前行驶并转弯。</font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "使用你的反光镜以确保不会碰到任何物体。<br><br><font face=/font/big_bold.font>在指定区域内转弯并停下。</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>关闭发动机并进行驻车制动。</font>"
#@}

