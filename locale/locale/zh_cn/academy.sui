#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "欢迎来到最终考核的第一部分。在这里，我们将考察你在学院学习后的卡车驾驶水平。"

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "首先，你要连上挂车。连好后，你将会驾驶通过整个测试区域。"

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "第一部分是从这个通道离开小型停车场，前往东部的测试路段。"

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "该路段设有很多障碍，具有挑战性。"

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "这段路线的很大一部分经过东部测试路段。"

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "我们将会测试你在不同情况下对卡车的操作。"

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "你将驾驶卡车通过几个急转弯。"

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "你将驾车穿过连接各个场地的路段。"

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "最后一部分是驾车通过这个小型路段。"

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "此路段具有很多复杂道路与急转弯。"

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "要完成测试，你需要精准停车。"

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "不要过于紧张。你已经学习过通过此测试所需的所有内容。<br><br>祝你好运！"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "前面是你的挂车。<br><br><font face=/font/big_bold.font>驶向挂车。</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "让牵引车对准挂车。<br><br><font face=/font/big_bold.font>倒车，然后连接上主销。</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>进行驻车制动。</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "按下 @@imv_nrm_attach@@ <font face=/font/big_bold.font>以连接挂车。</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "挂车已连接，卡车已准备好上路了。<br><br><font face=/font/big_bold.font>解除驻车制动。</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>驶向停车场出口。</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "跟随道路标线并留意路障。<br><br><font face=/font/big_bold.font>继续驾驶。</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "更富有挑战的部分即将到来。<br><br><font face=/font/big_bold.font>小心地在路障之间行驶。</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>继续行驶。</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "这一部分将测试你带挂车通过不同转弯的能力。<br><br><font face=/font/big_bold.font>转向驶入路段。</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>驶过通道。</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>笔直行驶。</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>小心地驶过弯道。</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "你即将进入更复杂的路段。小心驾驶。<br><br><font face=/font/big_bold.font>继续下坡行驶。</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>向左急转弯。</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>驶出路段。</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "你即将驶入较容易的部分。<br><br><font face=/font/big_bold.font>继续下坡行驶。</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>保持沿道路行驶。</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "前方转弯进入下一路段。<br><br><font face=/font/big_bold.font>继续驾驶。</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>右转。</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>继续在路段上驾驶。</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "前方将出现更多急弯。<br><br><font face=/font/big_bold.font>请酌情调整你的车速。</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>向左转弯。</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>继续行驶。</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>进入弯道，继续行驶。</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "要完成转弯，你可能需要稍微驶离道路一点。<br><br><font face=/font/big_bold.font>小心地转弯，尽可能多地使用必需的空间。</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>驶离路段并驶入停车位。</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "最终考核（第二部分）"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "最终考核的最后一部分在等着你。你在之前的场景中学到的停车技巧将在这里得到评判。小心并准确地停好车后 ，你就可以作为一名熟练的卡车司机在欧洲的道路上驰骋了！"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "横移操作"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "斜列式停车"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "穿过停车场"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "纵列式停车"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "最终停车"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "欢迎来到最终考核的第二部分。我们将来到附近的停车场，测试你倒车和停车入位的技巧。"

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "有几个连续的停车挑战在等待你来自我评估能力。"

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "这里空间有限，所以要小心，慢慢来吧。"


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "切记小心谨慎，不要操之过急。就算初次尝试不成功也没有关系，重要的是别伤及自己的卡车或周围的事物。<font face=/font/big_bold.font><br><br>准备出发。</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>驶向考核的第一部分。</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "你的第一项任务是展示错位停车操作。你需要带挂车倒车进入的车位在你的左侧。<br><br><font face=/font/big_bold.font>执行错位停车操作。</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "下一个任务是倒车进入一排停着的卡车当中。注意不要碰到其他卡车！<br><br><font face=/font/big_bold.font>执行斜列式停车操作。</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "继续通过停车场。留心意外情况。<br><br><font face=/font/big_bold.font>继续行驶。</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "现在让我们尝试在前方路缘旁的两辆卡车之间进行纵列式停车。<br><br><font face=/font/big_bold.font>执行纵列式停车操作。</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "在你的左侧完成最后一次停车操作！你可以选择用任何你想要的方式来完成。<br><br><font face=/font/big_bold.font>倒车进入指定区域。</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "只差一步。离开测试区域并停放车辆。<br><br><font face=/font/big_bold.font>从左侧退出测试区域。</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "你可以把卡车停放在右侧，与其他车辆一起。<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "带挂车的纵列式停车"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "在这个场景中，我们将着眼于怎样带着挂车去完成纵列式停车。"

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "停在标记区域。"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "带挂车的侧方停车是每个卡车司机的必备技能。<br>无论是大城市的路边停车，还是在乡村的休息区停车，这是每个卡车司机都知道应该如何去做的事情。"

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "当你经过车位时，仔细观察是否有足够空间可容下你的牵引车与挂车。在这里，我们确保了你有足够的空间。"

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "将自己与车位前的卡车对齐。但不要靠太近，与它保持一定距离，这样你就有空间操作。"

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "向停车位的反方向打轮并开始倒车。这样挂车就能快速进入停车位。"

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "一旦挂车指向的位置正确，你就可以跟随它继续倒车。"

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "在驾驶员侧的挂车车轮进入车位前，转动方向盘使挂车不再靠近路缘。"

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "将牵引车与挂车拉正并停入车位中间。<br>确保安全停车后关闭发动机。"

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "你能看见前方的停车位，就在其他卡车之间。在倒车时，务必观察各类视镜，保持卡车与周围障碍物间有足够的安全距离。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "在停车场找到车位。<br><br><font face=/font/big_bold.font>向前行驶。</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>驶过想你要的车位，进入标记区域。你可以从这里开始倒车操作。<br><br><font face=/font/big_bold.font>在标记区域停下。</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "让牵引车向远离车位的方向倒，这样挂车就能进入车位了。但是转得不要太急，否则可能会碰上路缘。<br><br><font face=/font/big_bold.font>开始倒车。</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "将挂车与车位对齐。如有必要，可以前后移动，同时进行必要的转向调整。<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "恭喜，你已经成功完成了《卡车驾驶基础》的最终考核，并学会了正确操纵卡车所需的所有技能。"

	key[]: "aca_msg_book1_outro02"
	val[]: "这是你迈向职业卡车司机梦想前的第一步。"

	key[]:	"aca_msg_book1_outro03"
	val[]: "现在，你已经准备好踏上欧洲的旅程，迎接你的第一个挑战……"

	key[]: "aca_msg_book1_outro04"
	val[]: "……但冒险才刚刚开始。"
#@}


