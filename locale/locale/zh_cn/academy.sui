#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "带挂车倒车"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "在此场景中，你将首次尝试带挂车倒车。这是一个比较简单的操作，但是仍需正确操控才能将挂车停到指定位置。"

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "倒车至挂车处"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "连接挂车"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "解除驻车制动"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "带着挂车倒车"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "继续倒向停车位"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "让我们尝试带着挂车倒车吧。它比看起来容易，你只需要些耐心。"

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "开始倒车，让挂车与牵引车对正。"

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "确保你已对正，否则将无法连接。如果没对正，你可以向前行驶一段距离后再次尝试。"

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "卡车牵引座将与挂车主销锁定。"

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "启用驻车制动并连接挂车。现实中你需要下车去连接气管和电缆，并抬起挂车支腿，但现在我们会为你去做这些。"

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>挂车总是会向牵引车的<color value=@@clr_sel@@>反<color value=@@clr_txt@@>方向转。"

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>要让挂车转向，你需要让牵引车向挂车要去的方向的<color value=@@clr_sel@@>反<color value=@@clr_txt@@>方向倒车。"

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>要想再次拉直挂车，让牵引车<br><color value=@@clr_sel@@>向<color value=@@clr_txt@@>挂车的方向倒车。"

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "尽量与挂车方向对齐——你必须不断进行微调以保证挂车指向标记区域。"

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "挂车行进路线与期望路线出现偏差时，立刻微调方向盘即可修正。过度修正往往会导致挂车大幅偏离你所期望的路线。"

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "将车停在指定区域，确保安全停车后关闭发动机。"

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "从你的后侧或副驾驶一侧探头，便能看到一辆挂车。你的任务就是带着它倒车。<br><br><font face=/font/big_bold.font>准备开始倒车。</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>开始向挂车方向倒车。</font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "将卡车与挂车对齐。让牵引座卡住主销，必要时可向前调整方向。<br><br><font face=/font/big_bold.font>继续倒车，直至感到挂车已连接。</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "牵引座已卡住主销，你已准备好完成与挂车的连接。<br><br><font face=/font/big_bold.font>启用驻车制动。</font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_attach@@ 以连接挂车。</font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "现在挂车已安全连接至牵引车，气管和电缆已连接，支腿已抬起。<br><br><font face=/font/big_bold.font>解除驻车制动。</font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "你需要倒车至后面的停车位。请记住挂车去的方向与你牵引车方向盘转动的方向相反。稍微转动方向盘就会导致挂车大幅度转动。<br><br><font face=/font/big_bold.font>开始带着挂车倒车。</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "不要过度转向，只需保证挂车与标志点位置对正。<br><br><font face=/font/big_bold.font>继续向停车位倒车。</font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "在狭窄空间内停车"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "在此场景中，我们将会把车停入一个狭窄空间。<br><br>你要熟练操作挂车，让其与偏置的停车位对正。"

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "调整到位"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "就停车操作而言，向前驾驶停车或者说“探索式”停车是相当容易的。<br>你仍然需要根据挂车的偏移去调整。"

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "你要在超过正常情况下牵引车转弯的位置后再转弯，以使挂车更有效地对正。"

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "当你接近停车位时，让牵引车转向，令其位于挂车前方。二者对正后继续前进以进入停车位。<br>停下，确保安全停车后关闭发动机。"

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "前方有个停车位，你需要停进去。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>开始驾驶并转向该停车位。</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "开过该停车位，将挂车与标记区域对正，然后让牵引车进入停车位并对正。<br><br><font face=/font/big_bold.font>在指定区域停放车辆。</font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>在指定区域停下。</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>进行驻车制动并关闭发动机。</font>"
#@}

