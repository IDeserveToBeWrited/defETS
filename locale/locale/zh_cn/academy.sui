#+ Book 1 Scenario 3_07
#@{

#### 3_07 common
	key[]: "aca_scenario_book1_3_07_title"
	val[]: "Reversing to the Driver's Side"

	key[]: "aca_scenario_book1_3_07_desc"
	val[]: "In this scenario, we'll reverse through a long bend to better understand how to control the trailer."

#### 3_07 goal

	key[]: "aca_goal_book1_3_07_inst1"
	val[]: "Reversing with a trailer"

	key[]: "aca_goal_book1_3_07_inst2"
	val[]: "How to rotate a trailer"

	key[]: "aca_goal_book1_3_07_inst3"
	val[]: "How to align a trailer"

	key[]: "aca_goal_book1_3_07_instruction"
	val[]: "Read the instructions"

	key[]: "aca_goal_book1_3_07_start"
	val[]: "Get your vehicle ready to drive"

	key[]: "aca_goal_book1_3_07_backward"
	val[]: "Set the vehicle in reverse"

	key[]: "aca_goal_book1_3_07_check1"
	val[]: "Bend the trailer"

	key[]: "aca_goal_book1_3_07_msg1"
	val[]: "Keep reversing"

	key[]: "aca_goal_book1_3_07_check2"
	val[]: "Complete the turn"

	key[]: "aca_goal_book1_3_07_stop"
	val[]: "Park in a marked spot"

	key[]: "aca_goal_book1_3_07_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#### 3_07 msg - intro text

	key[]: "aca_msg_book1_3_07_cutscene1"
	val[]: "In this scenario, we'll reverse into a turn on the driver's side. This side is easier because you have a better view and you're not fully dependent on mirrors. If you remember the basic principles, you should be able to easily master this after some practise."

	key[]: "aca_msg_book1_3_07_cutscene1b"
	val[]: "@@aca_msg_book1_3_07_cutscene1b_img@@<br>Remember, the trailer always turns <color value=@@clr_sel@@>opposite<color value=@@clr_txt@@> to how you initially steer the tractor."

	key[]: "aca_msg_book1_3_07_cutscene1c"
	val[]: "@@aca_msg_book1_3_07_cutscene1c_img@@<br>To get your trailer turning, steer the tractor<color value=@@clr_sel@@> opposite of the direction of the curve.<color value=@@clr_txt@@> <br>The trailer will turn<color value=@@clr_sel@@> into the direction of the curve.<color value=@@clr_txt@@>"

	key[]: "aca_msg_book1_3_07_cutscene1d"
	val[]: "@@aca_msg_book1_3_07_cutscene1d_img@@<br>To hold the angle between the tractor and trailer, turn the tractor<br><color value=@@clr_sel@@>towards the trailer.<color value=@@clr_txt@@>"

	key[]: "aca_msg_book1_3_07_cutscene2"
	val[]: "Check your surroundings, then begin reversing when you're ready."

	key[]: "aca_msg_book1_3_07_cutscene3"
	val[]: "Just before the beginning of the curve, steer the tractor slightly in the opposite direction of the curve to rotate the trailer in the direction of the turn."

	key[]:	"aca_msg_book1_3_07_cutscene4"
	val[]: "The trailer is angled in the direction of the curve. Steer the tractor towards the trailer to follow it into the curve."

	key[]: "aca_msg_book1_3_07_cutscene5"
	val[]: "Continue to hold the angle between the tractor and the trailer, make adjustments as necessary to keep the trailer going where you want it to."

	key[]: "aca_msg_book1_3_07_cutscene6"
	val[]: "Try not to make big steering inputs - small movements of the wheel can make a big difference in where the trailer will go."

	key[]: "aca_msg_book1_3_07_cutscene7"
	val[]: "Try to maintain the same angle for most of the turn so that you don't have to constantly work the trailer."

	key[]: "aca_msg_book1_3_07_cutscene8"
	val[]: "As you exit the curve, get the tractor in front of the trailer to begin pushing the trailer straight towards the parking spot."

	key[]: "aca_msg_book1_3_07_cutscene9"
	val[]: "Align the trailer with the space.<br>Stop in the designated area."

	key[]: "aca_msg_book1_3_07_cutscene10"
	val[]: "Secure the truck and shut down the engine."

#### 3_07 Driving Instructions

	key[]: "aca_msg_book1_3_07_start"
	val[]: "When reversing into a turn, it is necessary to be able to steer the trailer to the correct angle and maintain this angle throughout the entire turn, corrections should be made smoothly and gently.<br><br>To steer the trailer, turn the tractor against the direction of the curve.<br><br><font face=/font/big_bold.font>Prepare the vehicle for reversing. </font>"

	key[]: "aca_msg_book1_3_07_backward"
	val[]: "Behind you, there is a curve angled to the driver's side.<br><br><font face=/font/big_bold.font>Start reversing and proceed to the turn. </font>"

	key[]: "aca_msg_book1_3_07_check1"
	val[]: "Steer very slightly in the opposite direction of the curve to get the trailer turned where you want it to go. Just a small input will get the trailer pointed where you want it.<br><br><font face=/font/big_bold.font>Proceed to the turn. </font>"

	key[]: "aca_msg_book1_3_07_check2"
	val[]: "Continue into the turn, follow the trailer and try to keep a consistent angle between the tractor and trailer.<br><br><font face=/font/big_bold.font>Keep reversing to the marked place. </font>"

	key[]: "aca_msg_book1_3_07_stop"
	val[]: "Complete the turn and align the  tractor with the trailer. You can pull forwards to correct yourself if necessary.<br><br>@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_07_end"
	val[]: "Nice driving!<br><br>@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_08
#@{
#!{

#### 3_08 common
	key[]: "aca_scenario_book1_3_08_title"
	val[]: "Reversing to the Blind Side"

	key[]: "aca_scenario_book1_3_08_desc"
	val[]: "In this scenario, we'll reverse through a long bend on the blind side. This is significantly more difficult because you can't see where you're going out of the window, and must rely on your mirrors."

#### 3_08 goal

	key[]: "aca_goal_book1_3_08_msg0"
	val[]: "Turning to the Blind Side"

	key[]: "aca_goal_book1_3_08_start"
	val[]: "Getting your vehicle ready to drive"

	key[]: "aca_goal_book1_3_08_backward"
	val[]: "Preparing the vehicle for reversing"

	key[]: "aca_goal_book1_3_08_msg1"
	val[]: "Angling the trailer"

	key[]: "aca_goal_book1_3_08_msg2"
	val[]: "Aligning the truck into the turn"

	key[]: "aca_goal_book1_3_08_check1"
	val[]: "Passing the turn by reversing"

	key[]: "aca_goal_book1_3_08_stop"
	val[]: "Parking in the marked place"

	key[]: "aca_goal_book1_3_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#### 3_08 msg - intro text

	key[]: "aca_msg_book1_3_08_cutscene1"
	val[]: "In this scenario, we'll reverse into a turn on the blind side. This side is more challenging as the view from the driver's seat is impaired and mirrors must be used.<br><br>The principles for turning with the vehicle on the blind side are the same as for Turning on the driver's side."

	key[]: "aca_msg_book1_3_08_cutscene2"
	val[]: "Reverse the truck towards the curve."

	key[]: "aca_msg_book1_3_08_cutscene3"
	val[]: "Just before the beginning of the curve, steer the tractor slightly in the opposite direction of the curve to rotate the trailer in the direction of the turn."

	key[]: "aca_msg_book1_3_08_cutscene4"
	val[]: "The trailer is angled in the direction of the curve. Steer the tractor towards the trailer to follow it into the curve."

	key[]: "aca_msg_book1_3_08_cutscene5"
	val[]: "Try to maintain the same angle throughout the curve."

	key[]: "aca_msg_book1_3_08_cutscene6"
	val[]: "Get the tractor in front of the trailer and straighten out.<br>Park in the marked spot."

	key[]: "aca_msg_book1_3_08_cutscene7"
	val[]: "Secure the truck and shut down the engine."

#### 3_08 Driving Instructions

		key[]: "aca_msg_book1_3_08_start"
	val[]: "When reversing into a turn, it is necessary to be able to steer the trailer to the correct angle and maintain this angle throughout the entire turn, corrections should be made smoothly and gently.<br><br>To steer the trailer, turn the tractor against the direction of the curve.<br><br><font face=/font/big_bold.font>Prepare the vehicle for reversing. </font>"

	key[]: "aca_msg_book1_3_08_backward"
	val[]: "<font face=/font/big_bold.font>Start reversing.<br><br><color value=@@clr_txt@@>Keep moving slowly straight back. </font>"

	key[]: "aca_msg_book1_3_08_msg1"
	val[]: "Steer very slightly towards the opposite direction of the curve. This will rotate the trailer into the curve, and then you can follow it around.<br><br><font face=/font/big_bold.font>Continue into the curve. </font>"

	key[]: "aca_msg_book1_3_08_msg2"
	val[]: "<font face=/font/big_bold.font>Follow the trailer through the curve.<br><br><color value=@@clr_txt@@>Maintain the angle between the tractor and trailer. </font>"

	key[]: "aca_msg_book1_3_08_check1"
	val[]: "<font face=/font/big_bold.font>Make small steering inputs to maintain the angle.<color value=@@clr_txt@@><br><br>Continue towards the end of the curve. </font>"

	key[]: "aca_msg_book1_3_08_stop"
	val[]: "<font face=/font/big_bold.font>As you approach your parking spot, get the tractor in front of the trailer and straighten out.<color value=@@clr_txt@@><br><br>Proceed to the designated area. </font>"

	key[]: "aca_msg_book1_3_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

# Scenario 3_09 formatting
#!{
	key[]: "aca_msg_book1_3_09_start_img"
	val[]: "<align vstyle=top hstyle=left><img src=/material/ui/academy/book/book1/illustration/diagonal.mat bottom=p204 right=p204 color=FFFFFFFF></align><offset vshift=204>"

	key[]: "aca_msg_book1_3_09_start_img_uk"
	val[]: "<align vstyle=top hstyle=left><img src=/material/ui/academy/book/book1/illustration/diagonal_gb.mat bottom=p204 right=p204 color=FFFFFFFF></align><offset vshift=204>"
#!}

#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "斜列式停车"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "在此场景中，你将在一处狭小的场地进行斜列式停车。<br><br>没有太多空间可供操作，因此你需要小心谨慎且精准地驾驶。"

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "接近停车位"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "像这样的斜列式停车位非常普遍。在欧洲高速公路沿线的众多休息区中尤为常见。<br>我们需要再次借用一下前方的停车位。"

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "驶向位于此排尽头的指定停车位。"

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "保持在车道中央，或略偏向至驾驶员一侧。不要过于靠近路障，否则挂车尾部可能会在转弯时撞到它们。"

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "开过该停车位一段距离，然后朝停车位快速急转向。你需要注意每侧的后视镜：驾驶员侧的后视镜用于确保你的挂车前部不会撞到旁边的挂车，而副驾驶侧的后视镜用于确认你的挂车可以安全进入停车位。"

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "将车停在指定区域，确保安全停车后关闭发动机。"


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "进行斜列式停车时，精准判断你的位置至关重要。一旦你开始转入停车位，安全地倒车调整将变得十分困难。因此在理想状态下，你应确保在首次尝试时就留出足够的空间。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>驶向停车位。</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "驶过该停车位以便你的挂车有足够空间绕过位于内侧的卡车。<br><br><font face=/font/big_bold.font>转向进入停车位。</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "盲区倒车"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "在此场景中，我们将着眼于卡车盲区倒车入库。由于无法透过车窗看到自己会去往哪里，你将只能依靠后视镜来到达目的地。"

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "在此场景中，你将学习盲区倒车操作。除非别无选择，不然一般情况下应该避免盲区倒车，因为在此操作下你的视野会严重受限。慢慢来，并务必极度谨慎。"

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "开始倒车前，先把卡车远远开过停车位，以便给自己留出足够的空间进行操作。"

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "停下来，检查周围环境，然后开始倒车。"

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "将牵引车转离车位。这样会驱使挂车前部转向，将后部指向你想进入的停车位。小心不要转得太猛，以免牵引车和挂车被“折”到一起。"

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "当挂车进入停车位时，请开始调正卡车车体。"

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "将卡车安全停在指定区域。"

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "盲区侧倒车与驾驶员侧倒车的流程相同，但那一侧的视野会受阻。使用各类视镜并依靠你最好的判断来停放卡车。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "前方副驾驶侧有一个停车位。你需要将车开得离它远一些，以便在倒车时有操作空间。<br><br><font face=/font/big_bold.font>向前行驶。</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "记住，将卡车转离车位会使挂车转向车位。尽量利用后视镜来帮助你顺利进入停车位。<br><br><font face=/font/big_bold.font>开始倒车。</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "通过环岛"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "在此场景中，我们将着眼于怎样通过环岛。<br><br>你必须特别留意你的挂车，因为在进入、穿过以及离开环岛时，挂车都会以不同方式跟随牵引车。"

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "驶入环岛"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "驶于环岛"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "驶于环岛"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "驶出环岛"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "驶往指定区域"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "环岛在欧洲的街道中十分常见，因此了解如何安全通过环岛十分重要。"

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "在接近环岛时保持在车道外侧。这会帮助你的挂车在进入时绕开环岛内侧。"

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "进入环岛时，朝中心行驶。一旦驶入，你必须改为朝外侧行驶。这样可以避免挂车靠近环岛中心。"

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "留意你的后视镜，确保挂车没有太靠近内侧的路障。"

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "离开环岛相对简单，因为你的挂车已经位于出口的外侧。在出口处大幅转向，挂车应该会很好地跟随卡车。"

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "将卡车停放在指定区域并完成驻车制动。"



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "前方有一个供你驶入的环岛。<br><br><font face=/font/big_bold.font>慢慢接近环岛。</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "进入环岛时请大幅转向，这样你的挂车就能顺利地跟在后面进入环岛。<br><br><font face=/font/big_bold.font>进入环岛。</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "朝环岛外侧行驶。你需要尽量让卡车远离环岛中心，以便让挂车远离环岛中心的路障。<br><br><font face=/font/big_bold.font>继续驶过环岛。</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "靠近外侧锥筒。<br><br><font face=/font/big_bold.font>继续行驶。</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>驶出环岛。</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>继续驶往前方停车位。</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>在指定区域停下。</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>进行驻车制动并关闭发动机。</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "狭小空间内的操控"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "在最后这个场景，你的任务是在狭小空间内掉头。你需要在有限的空间内倒车至盲区侧，这需要你合理利用空间并注意周围环境。"

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "驶入训练路段"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "准备向盲区侧倒车"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "倒入车位"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "完成盲区侧倒车"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "离开训练路段"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "在此场景，我们将介绍如何在狭窄空间内通过盲区侧倒车的方式来掉头。当你无法在驾驶员侧倒车或掉头时，这项技能就会派上用场。"

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "道路标线将为你在训练路段提供指引。"

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "进行大半径转向，以确保你的挂车能避开停放的卡车。"

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "驶出弯道时，请考虑你将如何操控卡车以便为倒车做准备。"

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "将卡车的副驾驶侧以一定角度对准你即将倒入的空停车位会很有帮助。"

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "应尽可能避免盲区侧倒车，因为视野会大幅受限。不幸的是，有时你别无选择，只能这样做。"

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "在开始倒车前先打方向。这将会帮助你立刻将挂车指向你需要的方向，在狭小空间下很有帮助。"

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "在挂车已经深入车位后，将牵引车摆正回到挂车前方。"

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "摆正后且前方有足够空间以便再次向前拖拽时停止。像刚才进来那样返回。"

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "跟随道路标线驶出训练路段。"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "驶过前方的弯道并前往指定区域。"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "停下。"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "进行驻车制动并关闭发动机。"

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "你面前的训练路段还原了一个运输公司的场地。你的任务是进入，接着将卡车调转方向，然后驶出。请确保你充分利用了周围的可用空间。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>前往训练路段。</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>驶过转角并继续完成路段。</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "跟随道路标线前往位于路段尽头的路障。以一定角度停车以便将你的挂车指向副驾驶侧的空的停车位。<br><br><font face=/font/big_bold.font>继续前进。</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "当你从盲区侧观察周围环境时，你的视野会十分有限。放慢速度，使用后视镜，然后小心驾驶。<br><br><font face=/font/big_bold.font>开始倒车并将挂车倒进空停车位。</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "距离足够了。现在你可以向前行驶并从你进入的方向驶出训练路段。<br><br><font face=/font/big_bold.font>开始驶向出口。</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>驶出训练路段。</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "跟随道路标线前往最终停车位。<br><br><font face=/font/big_bold.font>前往指定区域。</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "横移倒车操作"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "在此场景中，你需要倒入一个并不直接位于后方的停车位。操作空间有限，因此你必须明智利用可用空间。"

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "在此场景中，你的任务是将车停入旁边的空位。没有太多空间供你操控，因此你需要稍微花点功夫才能让挂车到达你想要的位置。"

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "径直驶向路障。"

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "在路障前停车。"

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "倒车前，将方向盘转向迅速向驾驶员侧。这样，当你刚开始倒车时挂车就会转向车位，从而节省宝贵的空间。"

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "在挂车指向你想要它朝向的方向后，将牵引车摆正回到挂车前方并开始向停车位打方向。"

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "此刻往后，就跟常规倒车操作没什么区别了。"

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "继续倒车并留意两侧。将挂车和牵引车与停车位保持对正。"

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "将车停在指定区域，确保安全停车后关闭发动机。"


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "你已经停在车位中了，但是你需要移至位于右侧的另一个停车位。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "在你面前有一处标记区域。<br><br><font face=/font/big_bold.font>向前行驶。</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "空间并不充裕，记得立刻开始转向。<br><br><font face=/font/big_bold.font>倒车进入后方的标记车位。</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "驾驶经过简单弯道"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "在此场景，你将在一小段训练路段上行驶，学习如何带着挂车经过简单的直角弯。"

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "驶过第一个弯道"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "第二个弯道"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "最后一个弯道"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "在你前方有几处空间十分狭小的急弯。这些将帮助你学会如何有效地操控挂车。"

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "跟随道路标线靠近驾驶员侧的路障并准备驶过第一个弯道。"

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "在转弯途中保持紧贴外侧路障，挂车应当顺滑地跟随你进入路段。"

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "继续沿着道路标线前进，为第二次转弯做好准备。这是一个直角急转弯。"

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "你需要贴到弯道边缘，以确保你的挂车能够避开弯道内侧的路障。使用补盲镜，以便在不撞到任何东西的情况下尽可能贴靠弯道边缘。"

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "继续沿着外侧路障行驶。"

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "同样的，另一个狭窄的直角弯也需要你利用上所有可用空间。"

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "将卡车安全停在指定区域。"

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "记得使用全部可用空间以便帮助你处理每个弯道。<br><br><font face=/font/big_bold.font>开始上路并跟随道路标线靠向外侧。</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "沿着外侧路障过弯，但同时也要通过后视镜留意挂车。<br><br><font face=/font/big_bold.font>完成第一个转弯。</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "按到道路标线准备好进入前方的直角弯。<br><br><font face=/font/big_bold.font>转过直角弯。</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "转弯之后给卡车留足空间，以便应对前方更急的直角弯。<br><br><font face=/font/big_bold.font>继续驾驶。</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>继续驶往前方停车位。</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "斜列式倒车停车"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "在此场景中，我们将会探索如何在倒车的情况下进行斜列式停车。你可能会在休息区、卡车停靠站亦或发货区遇到这种情况。通常这些地方会挤满卡车，因而没有太多空间，所以这种停车方式会因空间不足而全方位变难。"

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "将挂车转向"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "斜列式停车似乎看起来更简单，但是一般会比常规的“窄路倒车”操作更富有挑战性。"

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "倒向停车位。暂时保持挂车和牵引车笔直。"

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "当你逐渐接近时，让挂车逐渐接近停放的卡车。这会帮助你在到达车位时将挂车转入车位。"

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "开始将挂车转入停车位。保持挂车紧贴驾驶员侧的卡车，因为你在另一侧会需要更多空间。"

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "在挂车已经深入停车位后，将牵引车转向并跟随挂车进入。"

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "在指定区域停放卡车，确保安全停车后关闭发动机。"

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "将卡车停入后方的空位。使用两侧的后视镜帮助你在倒车时导向。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "检查周围环境，然后倒车驶向停车位。<br><br><font face=/font/big_bold.font>开始倒车。</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "开始将挂车移向旁边的卡车。准备就绪后，将挂车转向进入停车位。记得考虑留出给挂车甩尾的空间。<br><br><font face=/font/big_bold.font>转向进入停车位。</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "倒车入弯"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "在此场景中，我们将要首次带挂车倒入一处转弯。我们将会探索倒车的基本原则并了解在倒车转向时应当注意什么。"

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "将挂车转向"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "在此场景中，你需要倒车停入位于驾驶员一侧后方的停车位。"

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "在带挂车倒车时有几个需要记住的要点，可以极大地帮助你完成操作。<br>首先便是挂车总会转向你在牵引车中打方向时所对的反方向。"

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "其二则是你可以通过观察卡车和挂车车轴来方便地了解挂车将要行进的方向。"

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "其三，小幅度操作即可让你到达想去的位置，无需过度操作。"

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "开始将牵引车略微转离停车位，而挂车将会开始指向它。"

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "跟随挂车，边倒车边调整以将其保持在正确路径上。"

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "留意你的挂车以及牵引车后部的车轮。它们将会告诉你挂车的指向，以及牵引车推行的方向。"

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "第四点则是，将挂车急转弯总是比尝试将其从极限角度拉直更容易。直到你距离车位足够近之前都要瞄准车位外侧，然后你可以略微急转以便对正挂车。"

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "当挂车进入停车位时，让牵引车回正至挂车前方。尽可能避免在车位内进行多次调整。"

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "在路障之间倒车，请一边倒车一边检查两侧。"

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "进行驻车制动并关闭发动机。"

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "记住这些带挂车倒车时的要点：<br><br>— 挂车转向牵引车打方向的反方向<br><br>— 查看挂车车轮即可确认其对准的方向<br><br>— 查看牵引车后轮即可确认其推行挂车的方向<br><br>— 不要将挂车过度转向<br><br>— 将挂车急转弯总比将其拉直更容易<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "向后看，找好你要去的地方。开始倒车前务必观察周围环境。<br><br><font face=/font/big_bold.font>开始向停车位倒车。</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>开始将挂车转向停车位并跟随它倒车进入。</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>在指定区域停下。</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "狭小空间倒车"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "在此场景中，你将要带挂车倒入繁忙停车场中的一处停车位。"

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "将挂车转向"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "对于卡车来说，这是一种典型的停车位。卡车司机几乎每天都会在工作中遇到。<br>在此处停车需要进行“窄路停车”操作。"

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "这种操作与上一场景相似，但是可供你使用的空间更少，因此你需要适当规划你的行动并小心避免撞到任何东西。"

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "精准把握时机在空间狭小时更加重要。在合适时机将挂车转向并观察牵引车和挂车车轮来了解行进方向。记得考虑甩尾空间并避免卡入极限角度。继续推行挂车。"

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "尽可能靠近驾驶员侧的卡车，这样能保证你的挂车有足够空间进行甩尾，你也不必过多担心副驾驶侧的卡车。"

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "在挂车进入车位后，就将牵引车摆正至其前方。最好在你感觉已经到位前去做这件事。这样你在倒向最后位置前还有机会修正。"

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "将牵引车和挂车摆正，并在指定区域停下。"

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "进行驻车制动并关闭发动机。"


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "现在我们将尝试带挂车在更狭小的空间内进行“窄路倒车”操作。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "检查周围并寻找位于后方的停车位。<br><br><font face=/font/big_bold.font>开始倒向停车位。</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>将挂车转入停车位。</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "最终考核（第一部分）"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "最终考核在等着你，你在前面的场景中学到的所有技能都将在这里接受考验。我们将在整个培训中心里兜一圈，看看你对目前遇到的情况掌握得如何。<br><br>一旦你完成了所有环节和操作，你就离成为一名熟练的卡车司机又近了一步！"

#### 3_19 goal


	key[]: "aca_goal_book1_3_19_coupling"
	val[]: "耦合挂车"

	key[]: "aca_goal_book1_3_19_park_br_on"
	val[]: "使用驻车制动"

	key[]: "aca_goal_book1_3_19_connect"
	val[]: "连接挂车"

	key[]: "aca_goal_book1_3_19_park_br_off"
	val[]: "解除驻车制动"

	key[]: "aca_goal_book1_3_19_b_trailer"
	val[]: "开出停车场"

	key[]: "aca_goal_book1_3_19_check01"
	val[]: "在路上行驶"

	key[]: "aca_goal_book1_3_19_check02"
	val[]: "狭窄通道"

	key[]: "aca_goal_book1_3_19_check02b"
	val[]: "在路上行驶"

	key[]: "aca_goal_book1_3_19_check03"
	val[]: "进入训练路段"

	key[]: "aca_goal_book1_3_19_check04"
	val[]: "复杂操作"

	key[]: "aca_goal_book1_3_19_check05"
	val[]: "直线路段"

	key[]: "aca_goal_book1_3_19_check06"
	val[]: "大弯"

	key[]: "aca_goal_book1_3_19_check07"
	val[]: "复杂弯道部分"

	key[]: "aca_goal_book1_3_19_check08"
	val[]: "急弯"

	key[]: "aca_goal_book1_3_19_check09"
	val[]: "离开训练路段"

	key[]: "aca_goal_book1_3_19_check10"
	val[]: "下坡"

	key[]: "aca_goal_book1_3_19_check11"
	val[]: "进入小型训练路段"

	key[]: "aca_goal_book1_3_19_check12"
	val[]: "准备转弯"

	key[]: "aca_goal_book1_3_19_check13"
	val[]: "转向训练路段"

	key[]: "aca_goal_book1_3_19_check14"
	val[]: "进入训练路段"

	key[]: "aca_goal_book1_3_19_check15"
	val[]: "复杂通道"

	key[]: "aca_goal_book1_3_19_check16"
	val[]: "小心通过路口"

	key[]: "aca_goal_book1_3_19_check17"
	val[]: "简单弯道"

	key[]: "aca_goal_book1_3_19_check18"
	val[]: "大弯"

