#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "在本章的最后一个场景中，我们将在具有复杂配置的测试跑道上行驶。"

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "第一个障碍是穿过由一些路障构成的蛇形弯。驾车通过这里，并记得使用你的后视镜。"

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "接下来是一道发夹弯。保持较大转弯幅度，应该不会有什么问题。"

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "这里是一个向左转的直角弯。记住入弯深一些再转，以避免卡车后部碰上内侧的路障。"

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "坡道障碍可能略为棘手。驶上坡道之前，请尽可能地调整好自己的位置，并使用前反光镜和侧反光镜来帮助自己定位。"

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "接下来的路段必须通过倒车完成。牢记这一点，然后靠近前方的路障。"

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "跟随你后方以及右侧的道路标线。"

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "倒车至路障处，然后停下，继续向左行驶。"

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "穿过中央隔离带的开口，进入下一路段。"

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "这条穿过锥筒的通道非常狭窄。慢速行驶，并使用后视镜来帮助你在通道中定位。"

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "过直角弯时要记得开得深一些。"

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "你正在驶入一个不错的开阔路段。你可以加速，但请记住，你很快就要用减速来应对前面的弯道。"

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "在坡底，有一些路障挡住了道路。驶向它们，然后倒入左侧的停车位。"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "倒至停车位。"

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "停车，关闭发动机，然后安全停放卡车。"

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "在你面前有一个由路障组成的蛇形弯。<br><br><font face=/font/big_bold.font>通过蛇形弯。</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "向弯道的外侧靠拢，确保牵引车尾部不会压到路缘。<br><br><font face=/font/big_bold.font>过弯吧。</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "你即将来到一个直角左转弯。切记利用所有可用空间。<br><br><font face=/font/big_bold.font>过弯吧。 </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "对准坡道。一旦驶上坡道，调整的余地就不多了。<br><br><font face=/font/big_bold.font>驶过坡道。</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>沿着路段向左行驶。</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "接下来的路段必须通过倒车完成。在前方路障处停下，以便之后向右倒车。<br><br><font face=/font/big_bold.font>在路障处停下。</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "朝你的右后方倒车。路面有箭头给你指引方向。<br><br><font face=/font/big_bold.font>向下一个路段倒车。</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>继续朝着你后方路障的方向倒车。</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "停下并挂入前进挡，然后继续向左行驶。 <br><br><font face=/font/big_bold.font>向前行驶。 </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "左侧有一个中央隔离带的开口。驾车穿过它。<br><br><font face=/font/big_bold.font>继续前行。</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "前方道路狭窄多弯，周围有一些锥筒。请小心驾驶，必要时使用后视镜。<br><br><font face=/font/big_bold.font>穿过锥筒区。</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "继续通过该路段。<br><br><font face=/font/big_bold.font>左转。</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "切记在过弯前左转，来给自己留出尽可能多的空间。<br><br><font face=/font/big_bold.font>过弯吧。</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>继续行驶。</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "你可以在这里稍稍加速，但前方有一个弯道。<br><br><font face=/font/big_bold.font>继续沿着路段行驶。</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "该弯道会越走越急。<br><br><font face=/font/big_bold.font>酌情调整你的车速，并继续行驶。</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "在坡底，你会看到路障挡住了道路。<br><br><font face=/font/big_bold.font>在路障附近停下。</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "在你的左后方有一个停车位。<br><br><font face=/font/big_bold.font>倒车进入停车位。 </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>停在标记区域。</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "在操控测试路段上行驶"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "在此场景中，我们将在一条专用跑道上行驶，以测试你操控卡车通过各类弯道和转角的能力。"

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "进入训练路段"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "驶过左缓弯"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "驶过蛇形弯"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "直线路段"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "简单弯道"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "离开训练路段"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "接近停车位"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "在这个场景中，我们将驾驶牵引车进行一次短途行驶，考察你运用新学技能驾驭车辆的能力。"

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "该跑道包含各种类型和组合的弯道。这里既不竞速，也不计时。请你耐心驾驶，并根据遇到的弯道和障碍物调整行驶速度。"

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "路段的开头平缓简单，但逐渐深入后，弯道会变得越来越复杂。"

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "注意车速。车速过快很容易导致转弯误判。"

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "跑道出口是一个非常急的发夹弯。请慢速行驶，并利用一切可以利用的空间。"

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "将卡车停放在路障之间，并完成驻车制动。"


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "你必须避免撞车、偏离跑道或撞到任何交通锥筒，方能成功完成这一场景。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>向前驶入急右转弯以进入路段。</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>以平稳的速度驶过弯道。</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "你正在接近更复杂的弯道路段。<br><br><font face=/font/big_bold.font>依照路况适当调整车速并继续。</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>继续驶向后续弯道。</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "一开始都是些简单轻松的弯道。保持匀速行驶。<br><br><font face=/font/big_bold.font>继续行驶。</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "路段末尾的弯道是一个急发夹弯。过弯前减速并靠弯道外侧行驶。记得使用你的后视镜！<br><br><font face=/font/big_bold.font>过弯并驶出路段。</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "前方的路障间有一个停车位。<br><br><font face=/font/big_bold.font>向停车位行进。</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
