#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "倒车沙盒"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "在这个场景中，你将被安排到一个空停车场练习双挂倒车。"

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "准备开始"

	key[]: "aca_goal_book3_urf_move"
	val[]: "尝试"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "收尾"

	key[]: "aca_goal_book3_urf_end"
	val[]: "结束场景"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "双挂倒车比单挂更需要集中注意力。你必须提前规划后挂车的行驶路线，同时还要控制好前挂车和牵引车的走向。<br><br>这么说吧——你必须用前挂车来引导后挂车。"

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "在此情况下，我们需要将后挂车转向驾驶员一侧。要实现这种转向，必须将后挂车的前部推向副驾驶一侧。<br><br>请注意，这实际上意味着你必须让前挂车转向你目标方向的反方向，才能使后挂车转向你的目标方向。"

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "一旦后挂车开始转向，务必将牵引车与前挂车对齐。这常常是大多数人初次操作失误的地方。"

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "我们可以看到，该驾驶员未能及时调整前挂车的走向，即将发生挂车折头事故。"

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "车组中任意两个车辆之间的夹角达到约90度时，就会产生折头现象。一旦出现这种情况，便无法挽救——你必须向前行驶，重新尝试倒车。<br><br>与单挂倒车操作的要领一致，倒车时始终要确保挂车的所有车轮都处于转动状态。一旦某个车轮停止转动，挂车便会原地打转，你就无法继续操作了。"

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "你可以向前开回到上一次操作正确的位置，更准确地说，是一个能让你继续倒车且不会再出现相同失误的位置。<br><br>在这种情况下，我们得向前移动，直至车身笔直，并从头开始重新尝试。"

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "再次提醒，一旦后挂车开始转向，请将牵引车移至前挂车前方，让后挂车自行转向片刻。"

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "既然后挂车正在转向目标方向，现在该引导前挂车跟随转向了。你可以调整前挂车与后挂车之间的夹角来控制转弯幅度，使其更急或更缓。"

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "操作的最后一步是摆正所有车辆。确保前挂车和后挂车对齐。"

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "请务必留意移动前挂车所花费的时间，若拖延过久，后挂车就会试图回到你刚才出发的位置！"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "尽管在这里花些时间练习，尝试各种操作方式，直到你大致掌握挂车倒车的技巧为止。<br><br>但最重要的是，记得享受其中的乐趣！"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "准备出发。"

	key[]: "aca_msg_book3_urf_move"
	val[]: "用这个停车场来熟悉挂车倒车操作。<br><br>@@aca_goal_tip@@ 若你是挂车倒车新手，建议先体验《卡车驾驶基础》课程。"

	key[]: "aca_msg_book3_urf_stop"
	val[]: "练习时间不限。<br><br>当你感到满意时，即可停止操作并完成驻车制动以结束该场景。"

	key[]: "aca_msg_book3_urf_end"
	val[]: "关闭发动机以结束场景。"
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "在狭窄空间内停车"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "在这个场景中，你需要将双挂车停入一个狭窄空间。"

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "准备开始"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "出发"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "继续行驶"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "停下"

	key[]: "aca_goal_book3_sup_end"
	val[]: "进行驻车制动"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "驾车牵引双挂车看似令人望而生畏，但其实与牵引单挂车并无太大区别——只需同时考虑后挂车的行驶轨迹即可！"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "眼前有一个狭窄的停车位。你没有足够空间在驶入前将车身完全拉直，因此需要仔细考虑如何才能牵引两辆挂车驶入此处。"

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "立刻转向车位的远端方向，驶过常规的转向位置再继续往前开。"

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "当后挂车往正确方向移动时，你就可以径直驶向车位了。切记要再次朝车位远端方向开，这样有助于引导前挂车顺利转向。"

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "继续驶入该车位，两辆挂车都会跟随你，并会在前进过程中自行拉直。"

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "将卡车停放在指定区域并完成驻车制动。"

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "准备出发。"

	key[]: "aca_msg_book3_sup_forward"
	val[]: "向前行驶，进入狭窄空间。"

	key[]: "aca_msg_book3_sup_check1"
	val[]: "继续行驶。"

	key[]: "aca_msg_book3_sup_stop"
	val[]: "在指定区域停下。"

	key[]: "aca_msg_book3_sup_end"
	val[]: "进行驻车制动并关闭发动机。"
#@}


