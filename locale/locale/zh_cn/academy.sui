	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "摆正车体，在指定区域停下。"

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "进行驻车制动并关闭发动机。"

#@}


