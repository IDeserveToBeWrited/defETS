#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "《卡车驾驶进阶》信息" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "完成条件"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "满足所有通过条件即可完成场景"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "完成奖励条件即可获得星星"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "条件"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "前进与倒车间切换的最大次数"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "完成场景所给定的最长时间"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "仅使用车内视角 - 静止状态下仍可使用外部视角"

	key[]: "aca_book_book2_completed_t"
	val[]: "《卡车驾驶进阶》通过"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br><br>你已完成《卡车驾驶进阶》模块的所有通过条件，并获得了该存档下生涯模式的奖励。你也可以挑战自己，完成所有奖励条件以获得更多奖励。</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "《卡车驾驶进阶》完成"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br><br>你已完成《卡车驾驶进阶》模块的所有通过条件与奖励条件，并获得了该存档下生涯模式的奖励</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "《卡车驾驶进阶》"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "欢迎回到@@driving_academy@@！"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "以下场景是你成为专业卡车司机前需完成的下一步。"

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "这次我们不会指导你完成每一项任务，因此你需要根据自己的所掌握的技能与经验自行完成它们。"

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "你可能会遇到一些熟悉的操作，但这次是在更接近真实场景的新环境中进行。"

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "@@driving_academy@@新增了“通过”与“奖励”条件。"

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "还和之前一样，你在通过每个场景时不能碰到任何东西，成功停车入位并安全停放卡车……"

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "……但现在你还必须要在指定时间内完成，并且在前进与倒车之间转变的次数也会有所限制。"

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "要想获得奖励，你就需要在更具挑战性的条件下完成每个场景……"

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "……比如更严格的时间限制，更少的车辆转向机会，以及仅使用车内视角。"

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "完成所有场景后，你就可以确信自己的驾驶技术已臻成熟，并已准备好迎接下一个挑战了。<br><br>若想进一步挑战自己，就去完成每个场景下的所有奖励条件吧。这样你将成为一名真正的卡车驾驶之星！"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "教学"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "在这个教学场景中，我们将帮助你熟悉《卡车驾驶进阶》中的新功能。"

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "在每个场景开始时，你会看到<color value=@@clr_sel@@>“场景小结”<color value=@@clr_txt@@>窗口。这里会为你列出该场景的通过条件与奖励条件。<br><br>必须满足通过条件才可完成场景，奖励条件则是为那些经验丰富且技术娴熟的玩家设定的额外可选挑战。<br><br><font face=/font/big_bold.font>启动点火系统以继续。</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "其中一个奖励条件是须使用<color value=@@clr_sel@@>车内视角<color value=@@clr_txt@@>完成场景。你仍然可以使用外部视角来观察周边环境，但只限在车辆停驻时使用。<br><br>现在你可以环顾四周来确定自己的方位，然后切换回车内视角。<br><br><font face=/font/big_bold.font>切换到追踪视角以观察周围环境。</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "观察完毕后切换回车内视角。<br><br><font face=/font/big_bold.font>环顾卡车周围</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>切换回车内视角</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>时间<color value=@@clr_txt@@>也是《卡车驾驶进阶》模块的一个重要考量因素。所有场景都有一个独立的时间限制，必须在此时间内完成场景才能满足通过条件，而且许多场景还会有一个额外的、更严格的时间限制作为奖励条件。<br><br>卡车移动后才会开始计时。<br><br><font face=/font/big_bold.font>启动发动机并解除驻车制动以继续。</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "《卡车驾驶进阶》模块的另一个新增内容是路径点。必须达到所有路径点才能完成场景。<br><br>值得注意的是，路径点的通过判定对卡车的朝向也有所要求，因此需要注意路径点附近的道路标识以保证其能正确触发。<br><br><font face=/font/big_bold.font>向前行驶到你前面的路径点。</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "你已到达路径点，可以进行下一步了。<br><br>你身后还有个必须倒车前往的路径点。注意地面的箭头，它指示了卡车到达路径点时应该朝向哪边。<br><br>另一个通过条件与奖励条件就是<color value=@@clr_sel@@>行进方向转变<color value=@@clr_txt@@>。我们会记录你在前进与后退间转变方向的次数，保证其不超出限制才能达成该条件。<br><br><font face=/font/big_bold.font>倒车至路径点后停下。</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "所以到目前为止，你应该有1次的行进方向转变。<br><br>连接后方的挂车开始下一步。<br><br><font face=/font/big_bold.font>倒至挂车处以进行连接。</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "最终停车区域位于你的右侧，有些场景可能只有一个停车位，有些则有多个可供选择。在任一地点正确停好都可以完成场景。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_attach@@ 来连接挂车。</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "停车位也有停车方向的指示。停错方向会导致场景无法完成，除非你自行纠正。而这样就会浪费时间与行进方向改变的次数。<br><br><font face=/font/big_bold.font>将车开到其中一个停车位并正确停放。</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "现在你应该已经熟悉通过条件与奖励目标这两个新参数了，准备好应对《卡车驾驶进阶》模块下的场景吧！<br><br><font face=/font/big_bold.font>启用驻车制动并关闭发动机以安全停放卡车来完成此场景。</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "捷径"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "在这个场景中，你将尝试利用一条捷径，但不幸的是，这条捷径的尽头无法通行。然后你必须原路返回。"

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "驾车到达山顶的路径点，然后原路返回山下。<br><br>回到大路上后，驶至最终停车区域。"



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "早起的鸟儿"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "在此场景中，你必须设法穿过一处拥挤不堪的停车场。空间极其有限，所以尽量提前规划好你的行车路线。"

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "有时，由于车位非常有限，其他司机会整晚见缝插针地停车。这样一来，早上要绕开他们就相当困难了。<br><br>请尽力穿过停车场，到达最终停车位。"



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "蜿蜒曲折"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "在这个场景中，你的任务是驾车通过一个非常复杂的训练路段。在路上，你必须找到并连接一辆挂车，然后将其带到终点。"

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "这个场景将测试你的空间感知力和情境感知力。前方路段包含重重障碍，而你并不总能轻易发现。"

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "通过路段，找到挂车。然后连接挂车并将其带到最终停车位。"



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "头晕目眩"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "在此场景中，我们将测试你的操控技能。驾车绕圈行驶，直到抵达终点！"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "是时候测试一下你的卡车操控技能了。设计这条跑道就是为了看看你对你的卡车有多了解！"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "中心部分是一条长长的螺旋路线，它将测试你驾驶卡车通过长弯道的能力。"

#@}




