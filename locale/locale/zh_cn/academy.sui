	key[]: "aca_book_disclaimer_topbar"
	val[]: "本课程并非真正的培训项目。"

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font> @@driving_academy@@无意取代实车培训。</font><br><br><color value=@@clr_txt@@>我们强烈建议，尝试实操卡车之前，应先向经过认证的卡车驾驶培训机构寻求指导。<br><br>有意使用@@driving_academy@@补充驾驶员实车培训的机构，请洽 academy@scssoft.com。"

	key[]: "aca_book_book1_title"
	val[]: "《卡车驾驶基础》"

	key[]: "aca_book_book1_desc"
	val[]: "学习驾驶卡车的基础知识，从基本功能与控制到操纵挂车。"

	key[]: "aca_book_book2_title"
	val[]: "《卡车驾驶进阶》"

	key[]: "aca_book_book2_desc"
	val[]: "在更具挑战性的条件下，通过新的场景磨炼你的卡车驾驶技能。"

	key[]: "aca_book_book3_title"
	val[]: "《双挂操控》"

	key[]: "aca_book_book3_desc"
	val[]: "使用双挂车组迎接驾驶和倒车时的独特挑战。"

