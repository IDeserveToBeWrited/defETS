#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "基础操控与移动"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "学习基础的车辆操控，以及怎样前进和倒车。"

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第一章：@@aca_chapter_book1_1_title@@。<br><br>你已经学会如何在驾驶前设置卡车，<br>向前行驶和倒车，以及使用车灯和雨刮器。</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "基础车辆操控"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "学习驾驶，操纵和停放牵引车。了解每种反光镜的类型及其用途。"

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>你已完成第二章：@@aca_chapter_book1_2_title@@。<br><br>你已经学会如何利用卡车上的每一面后视镜，在移动前检查卡车周围的空间，以及执行基础和高级操控技术。</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "挂车的熟练操作"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "学习如何连接挂车以及在各种场景下的操作。"

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>你已完成第三章： @@aca_chapter_book1_3_title@@。<br><br>你已学会如何连接和分离挂车，<br>感受到了卡车带着挂车时的重量感与空间感，<br>并完成了富有挑战性的带挂车驾驶课程。</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "带挂车倒车"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "学习新的操控方法，以便有效地带挂车倒车并停泊。"

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>你已完成第四章：@@aca_chapter_book1_4_title@@。<br><br>你已经学会了带着挂车倒车<br>以及各种车辆停放技巧。</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "最终考核"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "实地测验你的知识技能，并证明你是出色的卡车司机！"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>你已完成第五章： @@aca_chapter_book1_5_title@@。<br><br>你已经证明了你拥有驾驶、操控和停放卡车<br>所必须的一切技能！</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "发动机预热"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>你已完成训练：@@aca_chapter_book2_0_title@@。<br><br>你已了解驾驶进阶模块的规则与特点。</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "挡位磨合"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第二章：@@aca_chapter_book2_1_title@@。<br><br>你已预热发动机、换挡、成功开动并检查了制动性能。下一章会有更多挑战。</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "车轮转转转"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第三章：@@aca_chapter_book2_2_title@@。<br><br>你已精通了各种困难场景的应对技巧，展现出了能力与风采。</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "最后冲刺"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第四章： @@aca_chapter_book2_3_title@@。<br><br>你已经处理了许多关于挂车操控、停放以及倒车的复杂情况。事实证明，你是一名技术娴熟的卡车司机，有能力应对所有具有挑战性的卡车驾驶场景。"

	key[]: "aca_chapter_book3_1_title"
	val[]: "向前行驶"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "学习向前行驶时操控双挂车所需的所有基本技巧。"

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第一章：@@aca_chapter_book3_1_title@@。<br><br>你已经掌握了有效驾驶和操控双挂车的方法。</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "倒车控制"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "了解倒车时操控双挂车的必要步骤。"

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第二章：@@aca_chapter_book3_2_title@@。<br><br>你已经学会了双挂倒车的非凡技巧。</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "真实世界的准备"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "将你新学到的知识应用于更高级的场景中。"

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>你已完成第三章： @@aca_chapter_book3_3_title@@。<br><br>你在操控、停放和倒车时，成功应对了诸多专属于双挂车的棘手局面。你业已在此证明了自己的实力，现在是时候在《欧洲卡车模拟2》的道路上牵引双挂车并大显身手了！</font><br><br>"


