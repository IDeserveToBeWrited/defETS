#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "在接近障碍物时停下"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "在这个场景中，我们将讨论前反光镜的位置，以及如何有效地利用前反光镜在接近前方障碍物时停车。"

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "检查前反光镜"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "了解功能"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "在障碍物附近停下"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "卡车前方有很大的盲区。在这片区域很容易观察不到行人甚至小车，因此卡车配备了前反光镜，可以让你透过挡风玻璃看到那里。"

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "设计补盲镜就是为了让驾驶员能够看到这片盲区。<br>它是确保你在狭小空间操作卡车时不会与任何障碍物发生碰撞的必要工具。"

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "开始驾驶，向前方路障前进，然后在接近路障时减速。<br>密切留意前反光镜。"

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "在标线和障碍物之间停下。"

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "在此场景中，我们将学习使用如图所示的补盲镜。<br><br><font face=/font/big_bold.font>你可以透过挡风玻璃的上半部分来观察它。</font>@@aca_goal_tip@@ 你必须以车内视角完成本目标。"

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "补盲镜可以让你看见卡车前方的盲区。它可以帮助你安全且准确地驾驶。<br><br>如果你对当前设置不满意，可打开“@@adjust_link_t@@”（通过暂停菜单进入）进行调整，使其符合你的要求。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_activate@@ 以继续。</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "卡车正前方有一个标记区域。你会注意到该区域的另一侧有一个障碍物。当你靠近障碍物时，应极其缓慢地行驶，并通过补盲镜检查卡车与障碍物的距离。<br><br><font face=/font/big_bold.font>准备出发。</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "卡车仍未准备好行驶，也许你忘记了什么？<br><br>发动机是否已启动？驻车制动是否已解除？"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>驶向停车位。</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>让卡车前部在障碍物与着色道路标线之间停下。</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
