	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "带双挂车斜列式停车"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "在此场景中，你要在繁忙的停车场中带双挂车组停入斜列式停车位。"

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "像这样的斜列式停车位非常普遍。在欧洲高速公路沿线的众多休息区中尤为常见。"

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "驶向靠近排尾的指定停车位。"

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "请靠车道外侧行驶，但不要紧贴路障，因为转弯时挂车尾部可能与之碰撞。"

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "先开过停车位，腾出空间让两辆挂车都能跟着你驶入。然后驶向车位远端，将第一辆挂车移至指定位置。"

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "拉直车身，在指定区域停下，然后完成驻车制动。"

