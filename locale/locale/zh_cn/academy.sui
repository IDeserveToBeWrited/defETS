#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "驾驶之前"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "在第一个场景中，我们将介绍驾驶室的基本情况。正确调整座椅、方向盘和后视镜非常重要，因为适当的视野对于应对紧张或危险情况至关重要。<br><br>我们将逐一介绍调节这些部件的操作。"

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "座椅与后视镜调整"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "后视镜与视野检查"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "欢迎来到你的第一堂课！<br>让我们开始学习如何为卡车做上路前的准备工作。"

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "无论何时，确保驾驶安全、专业并始终受掌控都至关重要。<br>适当调整座椅、方向盘和后视镜将有助于实现这一目标。"

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "卡车两侧各有一些车辆。<br>它们会帮助引导你正确调整后视镜。"

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "请花些时间调整每一项设置，直到你满意为止，<br>因为这些设置对你操控卡车的能力有显著影响。"

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "座椅和方向盘调整"

	key[]: "adj_tut_title_1"
	val[]: "调整主后视镜"

	key[]: "adj_tut_title_2"
	val[]: "调整广角镜"

	key[]: "adj_tut_title_3"
	val[]: "视野检查与最后的后视镜调整"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "按 @@imv_nrm_adjuster@@，或使用暂停菜单中的车辆调整功能"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "使用暂停菜单中的车辆调整功能"

	key[]: "adj_tut_open_adj"
	val[]: "要在游戏中显示“@@adjust_link_t@@”，$OPEN_ADJUSTER$。"

	key[]: "adj_tut_open_seat"
	val[]: "首先，让我们调整驾驶座和方向盘。<br><br><font face=/font/big_bold.font>打开“@@adj_seats@@”以继续。</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>打开“@@adj_mirrors@@”以调整后视镜设置。</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "首次进入卡车时要优先处理的重要事项，就是依照你的偏好调整座椅、方向盘，以及后视镜。<br><br>正确的座椅位置对于保持良好的视野至关重要。要确保所有操作均可轻松触及并完成，并且前方、两侧和后视镜均无物体遮挡驾驶员视线。<br><br><font face=/font/big_bold.font>要显示配置菜单，$OPEN_ADJUSTER$。</font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>调整座椅，使你能清楚地看到周围环境与后视镜，并能触及所有控制部件。<br><br>调整方向盘，使其处于合适位置，且不遮挡仪表显示。<br><br><font face=/font/big_bold.font>当你对你的调整感到满意之后，按 @@imv_nrm_back@@ 返回至配置界面。</font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>鉴于存在许多大型盲区，卡车配备了多个车外后视镜，以尽可能地扩充驾驶员视野。<br><br>适当调整这些后视镜，以便尽可能清楚地观察周围环境。<br><br><font face=/font/big_bold.font>打开“@@adj_mirrors@@”以继续。</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>主后视镜的视野范围覆盖了卡车和挂车的侧面空间。<br><br>请以两侧的轿车为参考，将主后视镜调整到正确位置。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_selectfcs@@ 以继续。</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "主后视镜是你观察周围与后方情况的主要工具。你应当能清楚地观察到旁边的轿车，但同时也要确保自己能在后视镜中看到挂车的一部分，以帮助自己准确判断周围障碍物的位置。"

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "当你对调整感到满意，就切换到副驾驶侧的主后视镜。"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "同理，你应当可以从后视镜中清楚地观察到旁边的轿车且同时看见挂车的一部分。"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "当你对调整感到满意，就切换到驾驶员侧的广角镜。"

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>广角镜能提供更宽广的视野范围，让你看见更多正在旁边发生的情况。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_selectfcs@@ 以继续。</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "理想状况下，你应该看到停在一旁的轿车和卡车，同时可以看见自己卡车的很小的一部分。"

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "当你对调整感到满意，就切换到副驾驶侧的广角镜。"

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "同理，你应该看到停在一旁的轿车和卡车，但同时仍可看见自己卡车的一小部分。"

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "对后视镜的调整感到满意后，按 @@imv_nrm_back@@ 关闭后视镜设置菜单。"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_back@@ 返回至配置菜单。</font>"

	key[]: "adj_tut_close_adj"
	val[]: "棒极了，依照喜好调整完座椅和后视镜之后，你现在距离开车上路又近了一步！<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_back@@ 关闭配置菜单。</font>"

	key[]: "adj_tut_open_con"
	val[]: "再次环顾四周，确保你对驾驶室内的视野感到满意，并确保后视镜能让自己清楚地看到卡车周围的情况。<br><br>如果你对当前设置不满意，可在“@@adjust_link_t@@”配置菜单再次调整后视镜。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_activate@@ 结束第一个场景。</font>@@aca_goal_tip@@ 要显示或隐藏屏幕后视镜，可调整暂停菜单中的“@@adjust_link_t@@” - “@@adj_ui_mirrors@@”。屏幕后视镜可让你更轻松地查看副驾驶一侧的外部情况。"
#@}

# Book 1 Scenario 1_02 - strings not needing translation
#!{
	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "视角控制"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "在此场景中，我们将了解可供你使用的各类视角，以及它们怎样协助你控制与操作卡车。"

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "坐姿"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "探头后望"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "检查后视镜"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "切换至外部视角"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "查看卡车周围"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "在此场景中，<br>我们将浏览可用的几个视角。"

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "一共有七种视角可供选择，我们现在就来<br>介绍其中的几种，并解释它们的预期功能。"

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "多种视角及其不同角度可以帮助你在狭小空间内进行操作。"


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "了解自己的行进方向是保障驾驶行为安全专业的核心基础。如果你当前坐姿不适合你，可在“@@adjust_link_t@@”（通过暂停菜单进入）中进行调整。<br><br><font face=/font/big_bold.font>准备完成后使用 @@imv_nrm_activate@@ 进行确认。</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "倒车时，你的后视镜不总能提供清晰的视野。你可能需要探头到车窗外以获得更好的视野。<br><br><font face=/font/big_bold.font>将你的视角完全转到驾驶员侧以便探头看向挂车后部。</font>@@aca_goal_tip@@ 你必须以车内视角完成本目标。"

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "使用这一视角，以便在带挂车操作时检查挂车。从驾驶员侧倒车总是更好的选择，因为你可以利用这一视角。当你从副驾驶侧倒车时，你对后向的视野将极大受限。<br><br><font face=/font/big_bold.font>看向副驾驶侧。</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "这就是一般不推荐从副驾驶侧倒车的原因：你可以看出你的视野较为受限。万幸的是，你还拥有7个外部视角可供使用。<br><br>按键 @@imv_nrm_camcycle@@ 可用于切换至序列循环中的下一个视角。查看完成所有7个视角后，你将会回到初始循环位置。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_camcycle@@ 切换至下一视角。</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "外部视角提供了解卡车周围事物的最佳视野。<br><br><font face=/font/big_bold.font>环顾卡车四周。</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>再次按下 @@imv_nrm_camcycle@@ 即可切换至下一视角。</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "俯视视角能提供绝佳的卡车周围视野，极大便利了停车和在狭小空间内驾驶的操作。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_camcycle@@ 切换至下一视角。</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "车顶视角尽可能多地排除了遮蔽物，提供了前方道路的优良视野。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_camcycle@@ 切换至我们现在将要查看的最后一个视角。</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "探头后望是你之前通过转动车内视角获得视野的捷径。正如我们先前讨论过的，它在倒车或停车时非常有用。<br><br>游戏中，我们还有更多视角可供你通过按下 @@imv_nrm_camcycle@@ 逐一尝试。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_cam1@@ 返回驾驶室内部。</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "为实现沉浸式驾驶学校体验，我们推荐在你完成每个场景时保持使用“舱内视角”。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_activate@@ 以确认结束场景。</font>@@aca_goal_tip@@ 你可以使用 @@o_im_cam_zoom@@ 功能以便更好地观察周围。在查看反光镜时有显著帮助。访问选项的“@@options_bindings_screen@@”部分，即可查看并/或更改相应的键位分配。"

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "首次驾驶"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "在这个场景中，我们将学习如何设置卡车，然后首次驾车前进。"

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "启动点火系统"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "启动发动机"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "检查车辆周围"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "踩下行车制动踏板"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "挂入挡位"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "解除驻车制动"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "向前行驶"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "停下"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "启用驻车制动"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "挂入空挡"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "关闭发动机"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "在你最初几次驾驶中，我们将仅使用牵引车。<br>卡车在其不带有自身载货车体时被称为牵引车，因此需要使用挂车以便运输货物和材料。"

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "牵引车因其广泛用途而较为常见：卸下空挂车然后挂起另一个满载挂车而无需等待，亦或切换使用完全不同种类的挂车。"

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "在首次驾驶中，你的任务是向前行驶并在虚线后停下。<br>启动发动机，跟随指令让卡车做好行驶准备。准备就绪后，向前笔直行驶。"

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "驶过虚线标记，停下，关闭发动机，然后安全停放卡车。"

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "在下一阶段训练中，你会首次开动卡车。<br><br>不过，不启动发动机的话肯定行不通，因此你需要先启动点火系统。<br><br><font face=/font/big_bold.font>按 $input engineelect$ 以启动点火系统。</font>@@aca_goal_tip@@ 在生涯模式的默认设置下，发动机会随电源一同启动。对于生涯模式，你可以在选项界面的“游戏设置”中 @@auto_engine_start@@ 进行调整。"

	key[]: "aca_msg_book1_1_03_start"
	val[]: "点火系统启动卡车的电力系统。你可能已经注意到仪表盘上的警告灯开始闪烁——这是正常情况。如果这些警告灯在启动发动机后仍在闪烁，那就有可能表明卡车出现了问题。但驻车制动灯是个例外，当我们解除驻车制动时，它就会熄灭。<br><br>幸运的是，这辆卡车状况良好，我们可以继续前进。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_engine@@ 启动发动机。</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "现在发动机已经启动。在开始移动前，务必检查周围环境，这一步至关重要。<br><br><font face=/font/big_bold.font>环顾卡车四周，检查两侧后视镜，确认卡车周围区域安全通畅。</font>@@aca_goal_tip@@ 你必须以车内视角完成本目标。"

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "这可能显而易见，但是你应当在开始任何动作前知晓如何停止。<br><br><font face=/font/big_bold.font>通过 $input backward$ 启用行车制动踏板。</font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "接下来，你将学习如何改变行驶方向。<br><br>使用简易自动挡变速器时，不需要更换任何挡位，一切均会自动为你处理。<font face=/font/big_bold.font><br><br>使用 $input forward$ 启动前进挡。</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "接下来，你将学习如何改变行驶方向。<br><br>真实自动挡变速器允许你像真实的自动挡变速器那样在前进挡、空挡和倒挡之间切换。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_gearup@@ 启动前进挡。</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "接下来，你将学习如何改变行驶方向。<br><br>序列式变速器同真实序列式变速器一样允许按序阶梯变速。<br><br>正如使用同样方式挂入前进挡那样，在加速时需要挂入更高挡位。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_gearup@@ 挂入一挡。</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "接下来，你将学习如何改变行驶方向。<br><br>通过挡把和离合器，你将获得与真正的手动变速器一样的换挡体验。<br><br>完全踩下离合器踏板和行车制动踏板。<font face=/font/big_bold.font>使用挡把挂入一挡。<color value=@@clr_txt@@>保持完全踩下离合器踏板和行车制动踏板的状态。</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "在开始移动前，你必须解除驻车制动。<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 以解除驻车制动。</font>@@aca_goal_tip@@ 在生涯模式的默认设置下，自动驻车制动是禁用的。你可以在选项 - “游戏设置” - @@auto_park_brake@@ 中进行调整。"

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "现在卡车准备好前进了。开始前进并驶过虚线。<br><br><font face=/font/big_bold.font>使用油门踏板：$input forward$ 以开始移动。</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "现在卡车准备好前进了。开始前进并驶过虚线。<br><br><font face=/font/big_bold.font>使用油门踏板：$input forward$ 以开始移动。</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "现在卡车准备好前进了。开始前进并驶过虚线。<br><br><font face=/font/big_bold.font>使用油门踏板：$input forward$ 以开始移动。</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "现在卡车准备好前进了。开始前进并驶过虚线。<br><br><font face=/font/big_bold.font>松开行车制动踏板，缓缓松开离合器踏板令其接合，同时踩油门踏板保持发动机转速，以免卡车熄火。待离合器踏板完全松开后，你便可按需加速和换挡。</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "使用行车制动踏板来停下。<br><br><font face=/font/big_bold.font>使用 $input backward$ 停下卡车。</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "使用行车制动踏板来停下。<br><br><font face=/font/big_bold.font>使用 $input backward$ 停下卡车。</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "使用行车制动踏板来停下。<br><br><font face=/font/big_bold.font>使用 $input backward$ 停下卡车。</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "需要停下时，完全踩下离合器踏板<font face=/font/big_bold.font>并使用行车制动踏板停下卡车。<color value=@@clr_txt@@>将挡把移至空挡后，即可松开离合器踏板。</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "现在，进行驻车制动。这将确保卡车不会在停泊后意外移动。<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 以启用驻车制动。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "使用简易自动挡变速器时，你不需要更换挡位，一切均会自动为你处理。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_activate@@ 以确认。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_geardown@@ 挂入空挡。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_geardown@@ 挂入空挡。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>将挡把移至空挡，然后松开离合器踏板。</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "你现在知道怎样让卡车移动与安全停下了。<br><br><font face=/font/big_bold.font>按 $input engineelect$ 关闭发动机。</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "倒车"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "在此场景中，我们将首次尝试倒车。我们还将讨论如何利用后视镜观察车后情况，需要留意的事物，以及怎样为倒车做好准备。"

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "启动发动机"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "检查副驾驶一侧的后视镜"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "检查驾驶员一侧的后视镜"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "挂入挡位"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "解除驻车制动"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "挂入空挡"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "关闭发动机"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "在这次驾驶中，我们将直线倒车。你必须倒过虚线，然后停在那里。"

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "倒车时，必须不断环顾四周，观察所有的后视镜，并确保你周围和后方的空间通畅。"

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "启动发动机，挂入倒挡，并开始移动。"

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "驶过虚线标记，停下，关闭发动机，然后安全停放卡车。"

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "按照上一个场景中学到的方法，设置好要驾驶的卡车。<br><br><font face=/font/big_bold.font>准备就绪时，启动发动机。 </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "检查你的后视镜，确保周围区域畅通。如果你不满意后视镜的位置，可以在“@@adjust_link_t@@”中进行调整。<br><br><font face=/font/big_bold.font>查看副驾驶一侧的后视镜。</font>@@aca_goal_tip@@ 你必须以车内视角完成本目标。"

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "你即将驶过虚线。现在车道已经畅通，但在正常驾驶的过程中，必须通过环顾四周和查看后视镜来持续掌握周围环境的情况。<br><br><font face=/font/big_bold.font>检查驾驶员一侧的后视镜。</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>使用 $input backward$ 挂入倒挡。 </font>@@aca_goal_tip@@ 倒车时，大多数卡车上的倒车警报会自动启动。你可以在选项界面的“音频”中取消勾选 @@sound_of_reverse@@ 来将其关闭。"

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_geardown@@ 挂入倒挡。 </font>@@aca_goal_tip@@ 倒车时，大多数卡车上的倒车警报会自动启动。你可以在选项界面的“音频”中取消勾选 @@sound_of_reverse@@ 来将其关闭。"

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_geardown@@ 挂入倒挡。 </font>@@aca_goal_tip@@ 倒车时，大多数卡车上的倒车警报会自动启动。你可以在选项界面的“音频”中取消勾选 @@sound_of_reverse@@ 来将其关闭。"

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>完全踩下离合器踏板并将挡把移至倒挡。 </font>@@aca_goal_tip@@ 倒车时，大多数卡车上的倒车警报会自动启动。你可以在选项界面的“音频”中取消勾选 @@sound_of_reverse@@ 来将其关闭。"

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "你已经挂入倒挡。<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 解除驻车制动。</font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "使用 $input backward$ 开始移动。<br><br><font face=/font/big_bold.font>倒过虚线标记。</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "使用 $input forward$ 开始移动。<br><br><font face=/font/big_bold.font>倒过虚线标记。</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "使用 $input forward$ 开始移动。<br><br><font face=/font/big_bold.font>倒过虚线标记。</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "缓缓松开离合踏板，同时踩油门踏板保持发动机转速。<br><br><font face=/font/big_bold.font>倒过虚线标记。</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>使用行车制动踏板停下卡车：$input forward$</font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>使用行车制动踏板停下卡车：$input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>使用行车制动踏板停下卡车：$input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>完全踩下离合器踏板，并使用行车制动踏板停下卡车。</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 启用驻车制动。</font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "使用简易自动挡变速器时，与现实不同的是，你不需要更换挡位，一切均会自动为你处理。<br><br><font face=/font/big_bold.font>按 @@imv_nrm_activate@@ 以确认。</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_gearup@@ 切换至空挡。</font>@@aca_goal_tip@@ 激活驻车制动时，现代卡车会自动切换至空挡。但自己手动切换是个好习惯。在以下场景中，我们不需要进行这一步。"

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>按 @@imv_nrm_gearup@@ 切换至空挡。</font>@@aca_goal_tip@@ 激活驻车制动时，现代卡车会自动切换至空挡。但自己手动切换是个好习惯。在以下场景中，我们不需要进行这一步。"

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>将挡把移至空挡，然后松开离合。</font>@@aca_goal_tip@@ 激活驻车制动时，现代卡车会自动切换至空挡。但自己手动切换是个好习惯。在以下场景中，我们不需要进行这一步。"

	key[]: "aca_msg_book1_1_04_end"
	val[]: "记得在倒车时时刻留意周围环境，在交通繁忙之处更要如此。<br><br><font face=/font/big_bold.font>按 $input engineelect$ 关闭发动机。</font>"
#@}

