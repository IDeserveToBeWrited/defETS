
    key[]: "hint_engine_title"
	val[]: "启动发动机"

    key[]: "hint_engine_text"
	val[]: "用 $KEY_engine$ 启动发动机。"


    key[]: "hint_ignition_title"
	val[]: "启动点火系统"

    key[]: "hint_ignition_text"
	val[]: "用 $KEY_engineelect|KEY_engine$ 启动点火系统。"


    key[]: "hint_driv_arc_title"
	val[]: "驾驶"

    key[]: "hint_driv_arc_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前进，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒车。<br><offset vshift=8>用 $SPECIAL_steering$ 转向。"


    key[]: "hint_driv_auto_title"
	val[]: "驾驶"

    key[]: "hint_driv_auto_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前进，用$KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒车。<br><offset vshift=8>用 $SPECIAL_steering$ 转向。<br><offset vshift=8>按 $KEY_gearup$ 与 $KEY_geardown$ 升降挡位。"


    key[]: "hint_driv_seq_title"
	val[]: "驾驶"

    key[]: "hint_driv_seq_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前进，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒车。<br><offset vshift=8>用 $SPECIAL_steering$ 转向。<br><offset vshift=8>按 $KEY_gearup$ 与 $KEY_geardown$ 控制离合器。"


    key[]: "hint_driv_hshift_title"
	val[]: "驾驶"

    key[]: "hint_driv_hshift_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前进，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒车。<br><offset vshift=8>用 $SPECIAL_steering$ 转向。<br><offset vshift=8>用<color value=@@clr_sel@@>换挡杆<color value=@@clr_txt@@>换挡。"


    key[]: "hint_depot_deliv_title"
    val[]: "接近目的地"

    key[]: "hint_depot_deliv_text"
    val[]: "在标记区域内停下，选择停车位最终难度并获得相应经验值。"


    key[]: "hint_fin_deliv_title"
    val[]: "完成运输任务"

    key[]: "hint_fin_deliv_text"
    val[]: "将车辆停放在选定的车位。当你靠近配送点时，可按下 $KEY_activate$ 跳过此步骤。"


    key[]: "hint_fin_deliv2_title"
    val[]: "完成运输任务"

    key[]: "hint_fin_deliv2_text"
    val[]: "将车辆停放在选定的车位。可以在@@desktop_menu_category_options@@中启用小工具来跳过车辆停放。"


    key[]: "hint_lights_title"
    val[]: "打开车灯"

    key[]: "hint_lights_text"
    val[]: "用 $KEY_light$ 开启车灯。反复按下该键可在不同模式间循环切换。"


    key[]: "hint_high_beam_title"
    val[]: "开启远光灯"

    key[]: "hint_high_beam_text"
    val[]: "用 $KEY_hblight$ 打开远光灯。"


    key[]: "hint_wipers_title"
    val[]: "开启雨刮器"

    key[]: "hint_wipers_text"
    val[]: "用 $KEY_wipers$ 开启雨刮器并循环切换不同的速度设置。"


    key[]: "hint_zoom_title"
    val[]: "仔细看"

    key[]: "hint_zoom_text"
    val[]: "在驾驶舱内可用 $KEY_camzoom$ 缩放视角。可以在 @@desktop_menu_category_options@@ 中将缩放模式设置为按住保持或单击切换。"


    key[]: "hint_cam_int_title"
    val[]: "环顾四周"

    key[]: "hint_cam_int_text"
    val[]: "用 $KEY_cam1$ 切换至内部视角。"


    key[]: "hint_cam_ext_title"
    val[]: "环顾四周"

    key[]: "hint_cam_ext_text"
    val[]: "可用 $KEY_camcycle$ 在不同视角间切换。<br><offset vshift=8>用 $KEY_cam2$ 切换至外部视角。"


    key[]: "hint_indicators_title"
    val[]: "转向灯"

    key[]: "hint_indicators_text"
    val[]: "用 $KEY_lblinker$ 和 $KEY_rblinker$ 分别开启左右转向灯。"


    key[]: "hint_tow_title"
    val[]: "拖吊服务"

    key[]: "hint_tow_text"
    val[]: "如果你无法脱离困境，可以使用拖吊服务。用 $KEY_advmouse$ 打开@@quick_info_word@@菜单即可。"


    key[]: "hint_diff_lock_title"
    val[]: "差速锁"

    key[]: "hint_diff_lock_text"
    val[]: "如果你无法移动，也许差速锁可以帮到你。用 $KEY_diflock$ 开启差速锁，或在@@desktop_menu_category_options@@中启用自动差速锁。"


    key[]: "hint_diff_unlock_title"
    val[]: "差速锁已接合"

    key[]: "hint_diff_unlock_text"
    val[]: "正常驾驶时应当解除差速锁，否则会有损坏差速锁的风险。用 $KEY_diflock$ 可手动解除差速锁，或在@@desktop_menu_category_options@@中启用自动差速锁。"


