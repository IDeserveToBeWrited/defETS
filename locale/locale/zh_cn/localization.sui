	key[]: "simple_gfx_hint"
	val[]: "使用微调预设来调整图像设置，根据你的喜好来定制游戏的视觉表现。"

	key[]: "apply"
	val[]: "应用" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "桌面主题" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "显示" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "图像质量" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "纹理" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "反射" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "阴影" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "灯光" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "后期处理" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "环境" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "全屏模式" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "亮度 / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "设置" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "分辨率" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "刷新率" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "帧率限制" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "限制背景帧率" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "默认刷新率" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "垂直同步" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "节能（节省笔记本电脑能耗）" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "快速图像设置" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "已应用自定义设置" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "高级图形设置" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "简易/高级图像设置" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "隐藏高级设置" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "显示高级设置" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "缩放" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "抗锯齿" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA 亮度锐化" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "时间性抗锯齿 (TAA) 调整" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "自适应清晰度" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "始终柔和" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "始终锐利" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "屏幕空间环境光遮蔽 (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "高动态范围（HDR）" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "景深（DOF）" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "动态光影" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "色彩校正" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "反射比例" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "反射细节" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "植被细节" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "草密度" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "阴影质量"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "阴影纹理大小" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "远处阴影" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "内部阴影" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "天气效果质量"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "后视镜图像质量" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "后视镜分辨率" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "后视镜视距" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "纹理质量" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "各向异性过滤" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "法线贴图" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "AI 车辆前灯" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "车辆辅助灯光" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "灯光可见范围" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "行人" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "显示设置已更改。<br>你要保留这些设置吗？"

	key[]: "reverting_in"
	val[]: "还原倒计时" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "秒" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "启用后，游戏将会以全屏显示。"

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "调整游戏整体亮度以适配你的显示设备。在支持HDR的显示设备上，本设置还会提供HDR校准选项。"

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "更改游戏的分辨率。"

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "更改游戏的目标刷新率。"

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "将帧速率与显示器速率匹配。经济设置还能将帧速率减半，从而降低能耗。"

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "设置游戏的最大帧速率。<br><br>将值设置为 0 则会禁用此功能。"

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "设置游戏在后台最小化时的最大帧速率。<br><br>将值设置为 0 则会禁用此功能。"

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "在简单图形设置（预设的）或高级图形设置（可以修改各个参数）间切换。"

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "通过在内部以更高分辨率渲染游戏的方式来提高图形保真度，从而减少锯齿边缘并增强细节。<br>例如，选择更高的缩放选项会使画面更清晰，模糊度更低，从而在牺牲性能的情况下使游戏整体观感更佳。<br><br><color value=@@clr_txt_d@@>该设置往往对性能有很大影响。"

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "选择高速抗锯齿方法，以平滑游戏中锯齿状边缘的外观：<br>- SMAA 在帧内的不同位置对每个像素进行多次采样（取决于所选质量），并取样本平均值以生成最终图像。<br>- TAA 每帧只对每个像素进行一次采样，但是它在不同位置和不同帧进行采样。<br>- 为了获得最佳结果，你还可以选择两者的组合，但这可能会牺牲性能。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "为缝隙和相互靠近的物体添加软阴影，从而提高整个游戏世界的图形保真度。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "选择 TAA 预设：<br>-“始终柔和”将导致更少的闪烁与更多的模糊 - 这适用于启用超级采样或拥有高 DPI 显示器的 PC 用户，也适用于距离屏幕较远的 1080p 电视用户。<br>-“始终锐利”会导致更多的闪烁与更少的模糊 - 这可能是用于低于 1080p 设备的最佳选项，例如笔记本电脑或 Steam Deck。<br>-“自适应清晰度”被设置后，如果视角处于静止，TAA 抖动将被动态禁用。<br><br><color value=@@clr_txt_d@@>该设置只能在选择 TAA 作为抗锯齿解决方案时使用。"

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "调整 TAA 亮度的锐化强度。<br><br><color value=@@clr_txt_d@@>该设置只能在选择 TAA 作为抗锯齿解决方案时使用。"

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "启用后，地图中的远处区域可能会被人为地模糊，以便在背景中创造逼真的焦点衰减效果。"

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "启用后，直视太阳时，或透过树木、建筑物或车辆等物体直视太阳时，可能会看到光线。"

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "启用后，游戏的颜色会因美观目的而动态调整。如场景将更好地匹配时间与天气条件，车辆和其他物体的颜色可能会更加鲜艳等。"

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "在内部以更高的质量渲染反射，并使用更好的抗锯齿技术，从而改善反射效果。<br><br><color value=@@clr_txt_d@@>对该设置的更改只有在手动重启游戏后才会生效。"

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "调整车辆表面、车窗和其他可反射表面（例如水坑、湿滑路面与开放水域）的反射细节。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。<br><br>对该设置的更改只有在手动重启游戏后才会生效。"

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "调整植被和树木的细节与复杂度。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "调整道路两旁的草株密度。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "调整太阳或月亮所投射阴影的质量。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "启用极远处物体的阴影渲染。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "启用车辆内部夜间动态阴影。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "调整天气效果的质量，例如反射。"

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "调整车辆后视镜中的反射细节（与反射设置无关）。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "调整车辆后视镜所渲染图像的分辨率。"

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "调整物体开始在后视镜中渲染的距离。<br><br><color value=@@clr_txt_d@@>该设置往往对性能有很大影响。"

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "调整游戏中应用于物体和表面的某些纹理的质量。"

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "提高纹理的清晰度，尤其在从远处或倾斜视角观看时。<br><br><color value=@@clr_txt_d@@>对该设置的更改只有在手动重启游戏后才会生效。"

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "为人行道、车道与其他物体增加几何细节来改善它们的外观。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。<br><br>对该设置的更改只有在手动重启游戏后才会生效。"

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "启用 AI 车辆的车灯照明。"

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "启用来自其他 AI 车辆的辅助灯光照明，如指示灯、刹车灯等。"

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "调整人造光源的可见距离。<br><br><color value=@@clr_txt_d@@>该设置通常对性能有中等影响。"

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "启用游戏世界中的行人。"
