	val[]: "使用 @@imv_wiz_gearup@@ 前进并使用 @@imv_wiz_geardown@@后退。"

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "键盘或游戏手柄请使用 @@imv_wiz_gearup@@ 前进并使用 @@imv_wiz_geardown@@后退。H档请使用 @@imv_wiz_drive@@ 和 @@imv_wiz_reverse@@ 控制行进方向。"

	key[]: "wiz_cfg_gb_manual"
	val[]: "使用 @@imv_wiz_gearup@@ 和 @@imv_wiz_geardown@@ 选择想要的档位。"

	key[]: "wiz_cfg_gb_direct"
	val[]: "配合 @@ima_wiz_j_clutch@@ 使用你的 H 档选择档位。"
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "配置控制器轴线" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "可视化的轴"

	key[]: "wiz_setup_axes_desc"
	val[]: "你可以直观地看到你操作游戏控制器时所对应的控制轴效果。请操作你游戏控制器上的控制轴并观看设置中正在移动的提示条，它将告诉你该控制轴的定位、限制、中置位和其他的所有信息。"

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "轴的配置"

	key[]: "wiz_setup_axes_desc2"
	val[]: "要选定一个轴，请单击控制轴旁的按钮。 这将切换到输入模式。 然后通过移动摇杆、 方向盘 或 踏板来绑定所选择的轴。"

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "死区"

	key[]: "wiz_setup_axes_desc3"
	val[]: "死区是指故意设计出来不给提供输入的轴的区域。 若要调整所选定的轴的死区，请移动相应的滑块。 向右增加滑块将扩大死区，这一特性对于较旧的控制器特别有用，因为设置更大的死区可以缓解由于硬件磨损引起的不准确或错误输入问题。"

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "轴的模式"

	key[]: "wiz_setup_axes_desc4"
	val[]: "轴的模式决定了它在游戏内的处理方式。 反转轴所反馈的方向，可导致向左移动此轴时也能实现右转向。 例如，居中轴的默认位置位于其范围中间，就像摇杆一样。 此模式用于校正被错误检测了的轴。"

	key[]: "normal"
	val[]: "正常" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "反转" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "居中" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "反转并居中" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "自动挡变速箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "自动档模式下，你只需要挂前进档、空档或者倒档。你可以点击一个按钮或按键为你所需的功能进行更改。"

	key[]: "automatic_gb_setup_desc2"
	val[]: "如果你已经连接 H 档设备，你便可以使用它模拟真实自动变速排档器。启用此选项，你可以将 H 档的档位分配给前进和倒车模式，其它档位都算作空档。该设置专门为 H 档控制器设立，因此它不会对键盘按键或手柄按钮起作用。要想改变档位分配，点击一个按钮，并将档杆移动到想要的位置，然后回到空档。"
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "序列式变速箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "序列式变速箱包含前进档、空档和倒车档。这些是按上述顺序，用来升档和降档的按键和控制器按钮. 如果要改变按键分配，请点击一个按钮，并按下你想要使用的按键或控制器按钮。"
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H 挡变速箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "你可以在这里选择 H 档的基本布局，并尝试其功能。在画面中，你可以看到档杆现在的位置，以及所选的变速齿轮。由于变速箱包含的变速齿轮多于档位，你需要使用切换按钮在不同齿轮组中切换。"

	key[]: "hshifter_gb_setup_desc2"
	val[]: "当前所选的档位、档位开关也在下面（相关控制项旁边）指示出来。要想更改相关控制项，请点击合适的按钮，并将档位器移动到期望的位置，然后回到空档。"
#@}

