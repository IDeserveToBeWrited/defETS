	key[]: "bank_rl_confirm_title"
	val[]: "偿还贷款" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "你确定要花费 $MONEY$ 来偿还贷款吗？" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


