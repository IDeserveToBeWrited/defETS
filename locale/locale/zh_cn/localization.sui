#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "选择变速箱类型" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "按“前进键”前进，按“后退键”制动和倒车。变速箱会为你打理剩下的一切：在前进、制动与倒车间切换，挂到合适的挡位等。"

	key[]: "wiz_gb_automatic"
	val[]: "使用按钮在前进挡，空挡或倒挡之间切换。然后踩下油门，让自动变速箱负责换挡。"

	key[]: "wiz_gb_sequential"
	val[]: "手动上下换挡来选择变速箱内的各个具体挡位。此配置可让你完全掌控车辆的变速箱。"

	key[]: "wiz_gb_hshifter"
	val[]: "直接选择所需档位。此配置拟真度最高。建议使用实体H型变速箱，并且需要配合离合器操作。"
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "该功能需要方向盘，游戏手柄或者摇杆。"

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "未检测到H档控制器，该功能可能无法使用。"

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "选择 H 挡布局"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "无级式变速是最简单的选择。它有两组变速齿轮，第一组包括1至6档，第二组包括7至12档。一个开关按钮用于两组齿轮的切换，再利用档杆选择其中某一特定档位。"

	key[]: "wiz_hs_splitter"
	val[]: "有级式变速是另一种简单的变速方式。它也有两组变速齿轮，第一组包括奇数档（1，3，5…），第二组包括偶数档（2，4，6…）。一个开关按钮用于两组齿轮的切换，再利用档杆选择其中某一特定档位。"

	key[]: "wiz_hs_range_splitter"
	val[]: "无级式变速器基于真实手动综合式变速器的布局。四个变速齿轮为一组，与每个H档档位相对应，并带有两个切换开关。因此这种方式只适用于高级驾驶员。"
#@}

