#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "继续［$KEY$］" #+ Message box button.


	key[]: "intro_1"
	val[]: "欢迎来到《欧洲卡车模拟2》！"

	key[]: "intro_2"
	val[]: "现在，你终于有机会体验你梦想中的工作了——驾驶卡车！"

	key[]: "intro_3"
	val[]: "你自己的运输公司现在开张了，但遗憾的是，你缺少资金来购买卡车。 因此，现在你必须作为一名受雇驾驶员为其他公司工作。"

	key[]: "intro_4"
	val[]: "你的任务是将$JOB_CARGO$安全运送到位于$JOB_TARGET_CITY$的 $JOB_TARGET_COMPANY$ 公司的停泊处。你的雇主已经为你提供了一辆卡车，并会支付一切费用。不要让任何人失望，按时抵达。"


	key[]: "intro_garage_1"
	val[]: "这是你公司的总部。"

	key[]: "intro_garage_2"
	val[]: "这个车库非常基础。虽然不怎么样，但这只是个开始。"

	key[]: "intro_garage_3"
	val[]: "不幸的是，你还没有任何可以停放在这里的卡车，所以这里空空如也。"

	key[]: "intro_garage_4"
	val[]: "当你赚到足够的钱并且购买了一辆卡车，你将可以在游戏世界内自由穿行并且从这里开展你自己的事业。"

	key[]: "intro_garage_5"
	val[]: "祝你好运！"


	key[]: "desktop_tut_t"
	val[]: "解锁功能"

	key[]: "desktop_tut_job"
	val[]: "选择你的下一份工作"

	key[]: "desktop_tut_cargo_market"
	val[]: "使用你的全新挂车访问货物市场，以运输各种各样的货物到目的地。" #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "在这里你可以看到你的进度。"

	key[]: "desktop_tut_company"
	val[]: "在这里实时跟踪你的车库，雇佣新驾驶员，并管理你的公司。"

	key[]: "desktop_tut_trailers"
	val[]: "从现在开始，你可以购买属于自己的挂车了，你还可以给它们升级或喷漆以搭配你的卡车。<br><br>你的挂车可以存放到所选的车库中；你的驾驶员可以用它们增加收益。你可以使用“挂车管理”来管理挂车。"

	key[]: "desktop_tut_visit_directive"
	val[]: "访问 $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "欢迎"

	key[]: "desktop_tut_tour_welcome"
	val[]: "欢迎来到新的主界面<br>在这里你可以和游戏的所有功能进行交互。"

	key[]: "desktop_tut_tour_main_menu"
	val[]: "界面下方的主菜单可直达所有你熟悉的游戏核心功能。"

	key[]: "desktop_tut_tour_top_bar"
	val[]: "界面顶部的全新状态栏可实时呈现实用的玩家档案统计信息及当地交通法规，确保信息随时可见。"

	key[]: "desktop_tut_tour_home"
	val[]: "“主页”按钮始终可用，让你能够一键返回游戏桌面。"

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "常驻快捷菜单随时待命，可从任意界面一键直达所有游戏功能。"

	key[]: "desktop_tut_tour_drive"
	val[]: "更新后的“驾驶”按钮仍是你前往游戏世界的入口，准备好即可重新上路。"

	key[]: "desktop_tut_tour_finish_t"
	val[]: "教程完成"

	key[]: "desktop_tut_tour_finish"
	val[]: "感谢您查看我们新更新的主页。"
#@}


	key[]: "show_help"
	val[]: "帮助提示开关"

