	key[]: "missing_deps_cont"
	val[]: "你要继续吗？<br>游戏文件可能已经损坏！" #+ missing mods warning

	key[]: "missing_deps_rdlc_cont"
	val[]: "你要继续吗？<br>某些功能可能会丢失！" #+ missing dlc warning if the save depends only on functionality from removable DLCs (e.g. paintjob)

	key[]: "add_all"
	val[]: "全部启用" #+ Button used to add all mods to active mod list

	key[]: "remove_all"
	val[]: "全部禁用" #+ Button used to remove all mods from active mod list

