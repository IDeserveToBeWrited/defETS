	key[]: "new_inventory_items_t"
	val[]: "新库存物品" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "检测到新的 Steam 库存物品。" #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
