#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "截图文件尺寸太大，请尝试调低屏幕分辨率。" #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "截图文件已损坏或不支持。" #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "截图分辨率太大，请尝试调低屏幕分辨率。" #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "服务器拒绝了此截图。" #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "该账号不允许上传截图。" #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "此展位已有截图正在上传中。" #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "上传功能当前已被禁用，请稍后重试。" #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "在上传时遇到未知错误，请稍后重试。" #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "截图尺寸超过了上限 $LIMIT$ 并已被缩小。" # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "截图文件大小超过了上限 $LIMIT$ KB 并已被压缩。" # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "使用中的模组" #+ Mod selection title

	key[]: "missing_deps"
