	key[]: "force_feedback_assisted_steering"
	val[]: "辅助转向" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "地形表面震动" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "颠簸震动" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "碰撞震动" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

