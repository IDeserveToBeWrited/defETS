#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "银行" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "银行" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "如果你需要钱，你随时都可以向银行贷款。" #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "贷款讯息" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "每天还款 $MONEY$" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "当前贷款数目：$NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "你可以贷款：$MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "当前贷款概览"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "贷款" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "剩余偿还金额" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "为期（天）" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "年利率" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "分期付款" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "偿还" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "总计：" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "账户余额：$MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "新贷款" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "你正在申请一笔 $MONEY$ 的贷款" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "还款期限：" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "年利率：" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "每日还款额：" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "你是否确定你的申请？"
#@}

