	key[]: "desktop_background"
	val[]: "桌面背景" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "涂装" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "禁用库存" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "请稍后再试" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
