#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "加载游戏"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "加载游戏" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "载入以前的游戏存档，当前进度将会丢失！" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "你确定要加载另一个存档？<br><br>当前未保存进度将会丢失。"

	key[]: "load_progress_lost_mp"
	val[]: "你确定要加载另一个游戏吗？<br>在多人游戏中这样做可能会导致任务取消、任务暂停、被传送到最近的服务站或所选任务不可用。<br><br>除非提前保存，否则你当前的进度将会丢失。"

	key[]: "load_game_mp_suspended_job"
	val[]: "存档已成功加载，但你当前的卡车世界任务已被暂停，并在此环节中不可用。"

	key[]: "autosave"
	val[]: "- 自动存档 -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- 快速存档 -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "显示自动存档" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "未找到手动存档。" #+ Shown when no saves are found.

	key[]: "load"
	val[]: "加载" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>档案不兼容！<br><color value=@@clr_txt@@> 请尝试将游戏升级到最新版本。" #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "无法加载并显示该档案下的所有存档文件。" #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "注意" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>加载存档时出现问题。<color value=@@clr_txt@@><br><br>存档加载失败，你可以利用下面的信息尝试查找并解决这个问题，或者尝试加载另一个存档。<br><br>以下原因通常会造成该问题：<br><br>1. 该存档与某些已安装的模组不兼容；<br><br>2. 存档中包含有某些模组的信息已丢失或者被禁用；<br><br>3. 该存档被有缺陷的模组损坏；<br><br>4. 保存过程中或之后不久，电脑出现故障，导致存档损坏。"

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@> 检测到模组缺失。<color value=@@clr_txt@@><br><br>最近一次的存档所依赖的某些模组缺失或已被禁用。<br><br>如果这是意外情况，请检查模组状态。<br><br>你也可以尝试继续读取这个存档，但取决于这个模组的功能，存档加载可能失败，并导致其它问题。<br><br>或者，你可以加载其它不依赖这些缺失模组的存档。"

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@> 检测到可选 DLC 缺失。 <color value=@@clr_txt@@><br><br>最近一次的存档所依赖的某些 DLC（官方游戏扩展）缺失。<br><br>如果这是意外情况，请检查 DLC 状态。<br><br>你也可以尝试继续读取这个存档，但是这个 DLC 所提供的某些功能可能会丢失。<br><br>或者，你可以加载其它不依赖这些缺失 DLC 的存档。"

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>检测到 DLC 缺失。<color value=@@clr_txt@@><br><br>最近一次的存档所依赖的 DLC（官方游戏扩展）缺失。<br><br>缺失 DLC 必须在这台电脑上安装并激活，这个存档才能正常工作。<br><br>或者，你可以加载其它不依赖这些缺失 DLC 的存档。"

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>模组需要 DLC 内容支持。<color value=@@clr_txt@@><br><br>至少一个模组依赖于当前未安装的 DLC（官方游戏扩展）。<br><br>你需要禁用这些模组或者安装所需 DLC。"

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>检测到崩溃<color value=@@clr_txt@@><br><br>游戏可能在前一次加载过程中崩溃。<br><br>你可以利用下面的信息尝试发现并解决这个问题，或者也可以加载另一个存档。<br><br>以下原因通常会造成该问题：<br><br>1.一个或多个已安装的模组已损坏，或与游戏当前版本不兼容；<br><br>2.存档中包含有某些模组的信息已丢失或者被禁用；<br><br>3.该存档被有缺陷的模组损坏；<br><br>4.在某些情况下，硬件或驱动程序的故障可能会导致游戏崩溃。"

	key[]: "mods_detected_warning"
	val[]: "检测到游戏模组。请注意：损坏，过时或不兼容的模组可能导致游戏不稳定，请在模组管理器里查看你启用的模组。" #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

#+ Game save window
#+
#+ Provides ability to manually save the game.
#@{

	key[]: "save_game_t"
