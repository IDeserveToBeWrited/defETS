	key[]: "api_classical_controller"
	val[]: "典型游戏控制器"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "像 @@controller_ps5@@、@@controller_xbox_one@ 或 @@controller_steam_deck@ 这样的游戏手柄，可选择进入 Steam 输入接口并使用简单布局。<br><br>支持完整的游戏内按键绑定配置。"

	key[]: "wiz_api_steam_input_advanced"
	val[]: "游戏手柄选择了 Steam 输入接口，并通过 Steam 客户端配置了独立布局。<br><br>对游戏内按钮提示的支持有限，且不支持游戏内绑定配置。"

	key[]: "wiz_api_classical"
	val[]: "使用 DirectInput、XInput 或类似接口的控制器、方向盘或摇杆。"
#@}

