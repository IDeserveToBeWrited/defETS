SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "系统" #+ Message sender
		subject: "测试消息" #+ Message subject
		body: "嗨！<br><br>这是一条来自你的管理员伙伴的测试消息 ;-)<br><br>干杯" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "银行" #+ Message sender
		subject: "需要资金吗？我们可以提供帮助！" #+ Message subject
		body: "尊敬的先生/女士：<br><br>我们认为您可能想知道，我们为新企业提供优惠贷款支持。您的企业现在需要周转资金吗？我们可以提供帮助！请$SHORTCUT1$<link url=screen.bank color=@@clr_link@@>访问您当地的银行业务中心</link>来了解更多信息。<br><br>此致敬礼，<br>销售经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "银行" #+ Message sender
		subject: "我们可以助您发展壮大" #+ Message subject
		body: "尊敬的先生/女士：<br><br>我们不禁注意到您的收入正在稳步增长，并且希望能协助您进一步挖掘您的潜力。您的信用额度已经增加至 $MONEY$。您随时可向$SHORTCUT1$<link url=screen.bank color=@@clr_link@@>当地的银行业务中心</link>就可用金额进行借贷。<br><br>此致敬礼，<br>销售经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "银行" #+ Message sender
		subject: "您的账户已透支" #+ Message subject
		body: "尊敬的客户：<br><br>您的账户已透支。在接下来的几天内，我们会为您提供免息的短期贷款，希望可以解决燃眉之急。请尽快偿还您的欠款。<br><br>此致敬礼，<br>您的账户经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "银行" #+ Message sender
		subject: "您有一笔未还清的欠款！" #+ Message subject
		body: "尊敬的客户：<br><br>您的银行账户已透支！请在接下来的 $DAYS$ 天内偿还您的贷款，否则我们将强制扣押您的财产。<br><br>此致敬礼，<br>您的账户经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "银行" #+ Message sender
		subject: "最后的警告！" #+ Message subject
		body: "尊敬的客户：<br><br>这是对您发出的最后警告。您的银行账户已透支，请务必在明天之前还清款项，否则我们将没收您的财产以偿还贷款。<br><br>此致敬礼，<br>您的账户经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "银行" #+ Message sender
		subject: "透支已结清" #+ Message subject
		body: "尊敬的客户：<br><br>您的账户透支问题已解决，很高兴再次为您服务。<br><br>祝您生活愉快！<br>您的账户经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "银行" #+ Message sender
		subject: "您的自用卡车已被出售" #+ Message subject
		body: "尊敬的客户：<br><br>我们很遗憾地通知您，我们必须以 $MONEY$ 的价格卖掉您的卡车 - $TRUCK_NAME$。您已拖欠我们的债务很久并且没有其它偿还途径。不幸的是，除此之外我们别无选择。我们建议您完成快速任务，直到您的经济状况改善。<br><br>此致敬礼，<br>您的账户经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "银行" #+ Message sender
		subject: "您的自用挂车已被出售" #+ Message subject
		body: "尊敬的客户：<br><br>我们很遗憾地通知您，我们必须以 $MONEY$ 的价格卖掉您的挂车 - $TRAILER_NAME$。您已拖欠我们的债务很久并且没有其它偿还途径。不幸的是，除此之外我们别无选择。我们建议您完成快速任务，直到您的经济状况改善。<br><br>此致敬礼，<br>您的账户经理<br>银行" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "银行" #+ Message sender
		subject: "您的资产已被出售" #+ Message subject
		body: "尊敬的客户：<br><br>由于您的账户长期负债，我们必须没收并出售您的财产，出售所得的<br>$MONEY$ 将被用来偿还您的债务。这些财产包括：<br><br>$ITEM_LIST$<br>我们对事态发展至此深感遗憾，并希望这个结果不会对您未来的发展造成过重影响。<br><br>此致敬礼，<br>您的账户经理<br>银行" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "卡车经销商 - $CITY$" #+ Message sender
		subject: "全新 $BRAND$ 卡车正在热销！" #+ Message subject
		body: "尊敬的先生/女士：<br><br>我们是 $BRAND$ 卡车的授权经销商。我们提供多种不同配置供您选择，并且我们还可以定制卡车以满足各种特殊需求。请$SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>参观我们位于$CITY$的展厅</link>。您梦寐以求的卡车也许就在眼前。<br><br>此致敬礼，<br>$BRAND$ 经销商" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "二手卡车经销商" #+ Message sender
		subject: "正在出售二手卡车！" #+ Message subject
		body: "尊敬的先生/女士，<br><br>我们很高兴宣布，我们的二手卡车经销商开业，这是您购买高品质二手卡车的最新目的地。无论您是在寻找性能强劲的拉风机器，还是只需要一个可靠耐用的工作伙伴，我们都能为您提供最合适的卡车。<br><br>请浏览我们的$SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>二手卡车优惠</link>页面。我们相信您能在这里找到适合您需求的完美卡车。<br><br>此致，<br><br>二手卡车经销商团队<br><br>附注：别忘了经常回来查看新到的卡车！我们的库存在不断变化，所以您永远不知道会在这里发现什么样的好东西。" #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$，$CITY$" #+ Message sender
		subject: "需要自带卡车的驾驶员" #+ Message subject
		body: "敬启者：<br><br>我们正在寻找技术娴熟且自有卡车的驾驶员，以满足大量的运输任务需求。我们能提供很有竞争力的报酬，每个任务最高 $MONEY$。如果您有自己的卡车且愿意参与，请直接到我们在$CITY$的货场接受任务。<br><br>$COMPANY$，<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "驾驶员 $NAME$" #+ Message sender
		subject: "我需要一辆卡车来工作" #+ Message subject
		body: "嗨，老板：<br><br>我不知道您是否已经发觉，但我在$CITY$已经有$DAYS$没有工作了。我感到很懊恼，因为我需要钱来支付我的账单，如果我待在这里没事干就赚不到一分钱。请您在接下来的$DAYS2$内分配给我一辆卡车，好让我开始工作，否则除了离开您，我将别无选择。<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "驾驶员 $NAME$" #+ Message sender - written by female
		subject: "我需要一辆卡车来工作" #+ Message subject - written by female
		body: "嗨，老板：<br><br>我不知道您是否已经发觉，但我在$CITY$已经有$DAYS$没有工作了。我感到很懊恼，因为我需要钱来支付我的账单，如果我待在这里没事干就赚不到一分钱。请您在接下来的$DAYS2$ 内给我分配一辆卡车，好让我开始工作，否则除了离开您，我将别无选择。<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "驾驶员 $NAME$" #+ Message sender
		subject: "再见" #+ Message subject
		body: "嗨，<br><br>我不能再浪费时间了。没有卡车我就无法工作，而我不想再等了。我错过了很多好机会，所以我要离开你的公司到别处碰碰运气。你可以在位于$CITY$的车库找到先前配发给我的所有设备。<br><br>再见，<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "驾驶员 $NAME$" #+ Message sender - written by female
		subject: "再见" #+ Message subject - written by female
		body: "嗨，<br><br>我不能再浪费时间了。没有卡车我就无法工作，而我不想再等了。我错过了很多好机会，所以我要离开你的公司到别处碰碰运气。你可以在位于$CITY$的车库找到先前配发给我的所有设备。<br><br>再见，<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "驾驶员 $NAME$" #+ Message sender
		subject: "我的卡车需要一次全面修复" #+ Message subject
		body: "嗨老板，<br><br>我知道您很忙，但我的卡车需要完全修复，它已经老化到无法继续安全驾驶了。我都$DAYS$没工作了。坦白来说，我现在有些沮丧，因为我无法支付账单，而且也没有适合上路拉货的车辆。请问您能否给我换一辆新卡车，或者给这辆卡车来一次全面维修，好让我能继续工作。否则，除了离开你，我将别无选择。<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "驾驶员 $NAME$" #+ Message sender - written by female
		subject: "我的卡车需要一次全面修复" #+ Message subject - written by female
		body: "嗨老板，<br><br>我知道您很忙，但我的卡车需要完全修复，它已经老化到无法继续安全驾驶了。我都$DAYS$没工作了。坦白来说，我现在有些沮丧，因为我无法支付账单，而且也没有适合上路拉货的车辆。请问您能否给我换一辆新卡车，或者给这辆卡车来一次全面维修，好让我能继续工作。否则，除了离开你，我将别无选择。<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "驾驶员 $NAME$" #+ Message sender
		subject: "再见" #+ Message subject
		body: "嗨，<br><br>很抱歉说这些，但我的卡车因长期磨损已经快散架了，而我也撑不下去了。我现在接不到活，开销却不断增加，所以只能选择离开。我建议在下位司机接手前，对这辆卡车进行一次全面修复。你可以在$CITY$的车库找到先前配发给我的所有设备。<br><br>再会。<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "驾驶员 $NAME$" #+ Message sender - written by female
		subject: "再见" #+ Message subject - written by female
		body: "嗨，<br><br>很抱歉说这些，但我的卡车因长期磨损已经快散架了，而我也撑不下去了。我现在接不到活，开销却不断增加，所以只能选择离开。我建议在下位司机接手前，对这辆卡车进行一次全面修复。你可以在$CITY$的车库找到先前配发给我的所有设备。<br><br>再会。<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "驾驶员 $NAME$" #+ Message sender
		subject: "我要离开了" #+ Message subject
		body: "老板，您好，<br><br>位于$CITY$的车库倒闭了，那是我曾经工作过的地方。银行的一群人过来说我必须搬出去。看起来最近公司的状况不是很好。所以，我不得不选择辞职。反正我待在这里也没什么好处，没有卡车也就没有一切。我会去别的地方碰碰运气。<br><br>再见，别往心里去。<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "驾驶员 $NAME$" #+ Message sender - written by female
		subject: "我要离开了" #+ Message subject - written by female
		body: "老板，您好，<br><br>位于$CITY$的车库倒闭了，那是我曾经工作过的地方。银行的一群人过来说我必须搬出去。看起来最近公司的状况不是很好。所以，我不得不选择辞职。反正我待在这里也没什么好处，没有卡车也就没有一切。我会去别的地方碰碰运气。<br><br>再见，别往心里去。<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "调度员" #+ Message sender
		subject: "特种运输" #+ Message subject
		body: "老板，您好：<br><br>我有一些特别的消息给您。多亏了我们之间的联系，我们现在有机会迎接真正的挑战了。有些特殊的超大及重型货物需要真正的专业人士来运送。这绝非易事，需要一定的技巧，耐心，与护送车辆之间的配合，以及格外的小心，但我想您都具备这些品质，对吧？况且，风险越大，收益越高。<br><br>如果您感兴趣的话，可以访问这些城市：<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "调度员" #+ Message sender
		subject: "全新特种运输" #+ Message subject
		body: "老板，您好：<br><br>越来越多的公司希望利用您的专业驾驶技能来完成一些特种运输任务。就像上次一样，这绝非易事，需要一定的技巧，耐心，与护送车辆之间的配合，以及格外的小心，但我想您仍具备这些品质，对吧？别忘了，这些货物的报酬更为丰厚。<br><br>所以，除了目前在<br><br>$OLD_CITIES$ <br><br>的特种运输任务外，您还可以承接<color value=@@clr_sel@@>新的任务<color value=@@clr_txt@@>，就在：<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "房地产中介" #+ Message sender
		subject: "您想扩张您的公司吗？" #+ Message subject
		body: "尊敬的先生/女士，<br><br>我们谨向贵公司所取得的进步表示祝贺。贵公司的成功给我们留下了深刻的印象，我们希望能为贵公司提供一种新的方式，来帮助贵公司进一步扩张。从现在起，您可以使用我们的服务，近乎即时地购得更多房产！如需详情，请$SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>访问我们的“车库购买”界面</link>。<br><br>此致，<br>关系经理<br>房地产中介" #+ Message body
	}
	
#@}
}