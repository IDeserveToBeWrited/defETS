#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Рух заднім ходом із причепом"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Зараз ви вперше спробуєте рухатися заднім ходом із причепом. Це доволі простий маневр, але доведеться кермувати достатньо точно, щоб причіп зайняв правильне положення."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Рух заднім ходом до причепа"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Приєднання причепа"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Зняття ручного гальма"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Рух заднім ходом із причепом"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Рух до паркувального місця"
