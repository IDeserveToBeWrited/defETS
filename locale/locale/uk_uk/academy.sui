	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Проїжджайте до кінця ряду та знайдіть своє паркомісце."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Проїдьте повз паркувальне місце, щоб задній причіп мав простір для заїзду, а тоді різко поверніть, слідкуючи, щоб передня частина першого причепа не зачепила вантажівку поруч."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Продовжуйте повільно, при цьому вирівнюючи автопоїзд, тоді зупиніться у позначеній зоні."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
