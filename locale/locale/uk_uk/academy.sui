#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Діагональне паркування"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "У даній ситуації вам потрібно припаркуватися діагонально на стоянці, повній автомобілів. <br><br>Місця для маневрування обмаль, тому потрібно заїжджати особливо точно та обережно."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Наближення до паркувального місця"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Такі діагональні паркувальні місця дуже поширені: особливо на стоянках для вантажного транспорту, розташованих вздовж європейських магістралей. <br>Знову заїжджатимемо тягачем уперед."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Рухайтеся до паркувального місця близько до кінця ряду."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Тримайтеся середини смуги або трохи в бік водія. Не наближайтеся до огороджень, щоб не зачепити їх хвостом причепа при повороті."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Проїдьте трохи поза паркувальне місце, а потім різко поверніть у його напрямку. Потрібно контролювати ситуацію в обох дзеркалах: із боку водія – щоб ваш причіп не зачепив сусідній, з боку пасажира – щоб причіп безперешкодно увійшов на паркувальне місце."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Зупиніться в позначеній зоні, застосуйте ручне гальмо і вимкніть двигун."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Паркуючись діагонально, потрібно точно оцінити своє положення. Коли ви вже почали заїжджати, вмикати задній хід та намагатися виправити ситуацію доволі складно, тому постарайтеся оцінити, скільки вам потрібно місця, із першої спроби.<br><br><font face=/font/big_bold.font>Приготуйтеся до початку руху.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Рухайтеся до паркувального місця. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Проїдьте поза паркувальне місце, залишаючи достатньо місця для об'їзду причепом вантажівки із внутрішнього боку.<br><br><font face=/font/big_bold.font>Поверніть на паркувальне місце. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Задній хід через дзеркало"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "У даній ситуації вам потрібно заїхати на паркувальне місце стороною з обмеженим оглядом. Без можливості дивитися через вікно, заїжджаючи, вам доведеться покладатися лише на зображення в дзеркалах."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Ви навчитеся виконувати рух заднім ходом через сторону з обмеженим оглядом. За можливості такого маневрування слід уникати, оскільки оглядовість суттєво обмежена. Не спішіть та рухайтеся повільно і максимально обережно."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Проїдьте повз паркувальне місце, щоб залишити достатньо місця для маневрування при русі заднім ходом."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Зупиніться, огляньте простір довкола, тоді починайте рух заднім ходом."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Поверніть тягач у бік, протилежний від паркувального місця, щоб розвернути передню частину причепа – і таким чином спрямувати хвіст причепа в бажаному напрямку. Старайтеся не перестаратися – уникайте надмірних кутів між причепом та тягачем."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Під час того, як причіп заходить на місце, починайте вирівнювати вантажівку."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Зупиніться у позначеній зоні та застосуйте ручне гальмо."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Рух заднім ходом у бік з обмеженим оглядом вимагає застосування тих самих принципів, що й рух стороною водія – але тут брак оглядовості може створити суттєві проблеми. Використовуйте дзеркала та здоровий глузд, паркуючись.<br><br><font face=/font/big_bold.font>Приготуйтеся до початку руху. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Попереду – з пасажирського боку – знаходиться паркувальне місце. Вам потрібно зупинитися, проїхавши саме місце, щоб було достатньо простору для маневру.<br><br><font face=/font/big_bold.font>Рухайтеся вперед.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Пам'ятайте: щоб повернути причіп у сторону паркувального місця, потрібно кермувати тягачем у протилежний бік. Максимально використовуйте дзеркала, коли заїжджаєте.<br><br><font face=/font/big_bold.font>Починайте рух заднім ходом. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Перехрестя з рухом по колу"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Розглянемо, як потрібно проїжджати перехрестя з рухом по колу.<br><br>Вам потрібно постійно слідкувати за положенням причепа, оскільки траєкторія відрізнятиметься під час в'їзду на перехрестя, під час руху по ньому та при з'їзді."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Заїзд на круговий рух"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Круговий рух"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Круговий рух"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "З'їзд із кругового руху"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Рух до визначеної зони"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Перехрестя з рухом по колу дуже поширені в Європі, тому потрібно вміти рухатися ними."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Тримайтеся ближче зовнішнього боку своєї смуги, наближаючись до кругового руху. Це допоможе причепу безперешкодно ввійти на перехрестя."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Заїжджаючи, скеровуйте вантажівки до середини перехрестя. Заїхавши, тримайтеся зовнішнього боку, щоб причіп не наближався до центру кола."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Слідкуйте за причепом у дзеркалі, щоб той не занадто наближався до огороджень усередині."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Виїзд із кругового руху – це доволі просто, оскільки причіп уже розташований у бік, протилежний від самого з'їзду. Рухайтеся широкою траєкторією – і причіп безперешкодно виїде слідом."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Зупиніться у позначеній зоні та застосуйте ручне гальмо."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Попереду знаходиться перехрестя з рухом по колу.<br><br><font face=/font/big_bold.font>Повільно під'їжджайте до перехрестя. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Заїжджайте широко, щоб причіп увійшов безперешкодно.<br><br><font face=/font/big_bold.font>Заїжджайте на круговий рух. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Тримайтеся зовнішнього боку перехрестя. Вам потрібно відвести вантажівку чимдалі від середини перехрестя, щоб причіп не зачепив огородження по центру. <br><br><font face=/font/big_bold.font>Продовжуйте рух перехрестям.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Тримайтеся ближче до конусів ззовні. <br><br><font face=/font/big_bold.font>Продовжуйте рух.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>З'їжджайте з кругового руху. </font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Проїжджайте до паркувального місця попереду.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Зупиніться у позначеній зоні. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Застосуйте ручне гальмо і вимкніть двигун.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Маневрування в обмеженому просторі"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "У цій останній ситуації вам доведеться розвернути вантажівку в обмеженому просторі. Вам доведеться рухатися заднім ходом у бік обмеженого огляду. Потрібно постійно слідкувати за оточенням та ефективно використовувати місце, якого тут вкрай обмаль."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "В'їзд на майданчик"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Розташування для маневру"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Заїзд заднім ходом"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Зупинка в обмеженому огляді"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Виїзд із майданчика"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
