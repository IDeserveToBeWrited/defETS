	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Спробуймо проїхати заднім ходом із причепом. Це не так уже й складно: головне – терпіння."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Почніть рух заднім ходом та вирівняйте тягач щодо причепа."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Переконайтеся, що ви точно по центру, інакше приєднати причіп не вдасться. Якщо щось не так, ви завжди можете проїхати вперед, щоб спробувати знову."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Сідло тягача зімкнеться із пальцем причепа."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Застосуйте ручне гальмо і приєднайте причіп. У реальності вам довелося б вийти з вантажівки, щоб приєднати повітряні та електричні лінії та підняти опори, але тут ми зробимо це за вас."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Причіп повертає <color value=@@clr_sel@@>у протилежний бік<color value=@@clr_txt@@> від тягача."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Щоб повернути причіп, потрібно кермувати тягачем у бік,<color value=@@clr_sel@@> протилежний <color value=@@clr_txt@@> від бажаного напрямку руху причепа."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Щоб знову вирівняти причіп, поверніть тягач <br><color value=@@clr_sel@@>у напрямку до<color value=@@clr_txt@@> причепа."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Старайтеся залишатися на одній лінії з причепом – вам доведеться постійно робити незначні коригування, щоб причіп рухався до позначеної зони."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Виправляйте відхилення від курсу незначними рухами керма, щойно ви помітите таке відхилення. Якщо ви перестараєтеся, причіп може занадто відхилитися в інший бік."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Зупиніться в позначеній зоні. Застосуйте ручне гальмо і вимкніть двигун."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Позаду – зі сторони пасажира – знаходиться причіп. Ваше перше завдання – під'їхати до нього.<br><br><font face=/font/big_bold.font>Приготуйтеся до руху заднім ходом.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Починайте рухатися назад до причепа. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Вирівняйте тягач щодо причепа, оскільки сідло має замкнутися на пальці причепа. Якщо потрібно, можете проїхати вперед.<br><br><font face=/font/big_bold.font>Продовжуйте рух заднім ходом, поки не відчуєте приєднання. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Сідло замкнулося на пальці причепа, тепер можна завершувати приєднання.<br><br><font face=/font/big_bold.font>Застосуйте ручне гальмо. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Натисніть @@imv_nrm_attach@@, щоб приєднати причіп.</font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Тепер причіп належним чином приєднано до тягача, з'єднано кабелі повітря та електрики, піднято опори.<br><br><font face=/font/big_bold.font>Відпустіть ручне гальмо. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Вам потрібно заїхати на місце прямо позаду вас. Пам'ятайте, що причіп буде повертати у протилежний від тягача бік, а навіть незначний поворот керма може призвести до відчутної зміни траєкторії причепа.<br><br><font face=/font/big_bold.font>Розпочніть рух заднім ходом. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Не повертайте кермо надміру – лише щоб тримати причіп рівно. <br><br><font face=/font/big_bold.font>Рухайтеся до паркувального місця. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

