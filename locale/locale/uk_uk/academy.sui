#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Основні елементи керування та рух"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Вивчіть основні елементи керування вантажівкою і навчіться руху вперед та заднім ходом."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 1: @@aca_chapter_book1_1_title@@.<br><br>Ви дізналися, як підготувати вантажівку перед початком руху,<br>як рухатися вперед та заднім ходом та як користуватися фарами та склоочисниками.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Базові маневри"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Навчіться їзди, маневрування та паркування тягачем. Вивчіть призначення кожного типу дзеркал і як ними користуватися."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 2: @@aca_chapter_book1_2_title@@.<br><br>Ви навчилися користуватися кожним дзеркалом вантажівки, перевіряти простір довкола перед початком руху, а також виконувати як базові, так і складніші маневри.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Маневрування з причепом"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Навчіться приєднувати причіп та маневрувати з ним у різних ситуаціях."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 3: @@aca_chapter_book1_3_title@@.<br><br>Ви навчилися приєднувати та від’єднувати причіп,<br>відчувати вагу та габарити вантажівки з причепом,<br>а також проходити складні маршрути з причепом.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Рух заднім ходом із причепом"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Вивчіть нові маневри для ефективного руху заднім ходом та паркування з причепом."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 4: @@aca_chapter_book1_4_title@@.<br><br>Ви навчилися рухатися заднім ходом<br>та засвоїли різні техніки паркування.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Підсумковий іспит"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Покажіть свої знання та вміння та доведіть, що ви професійний водій вантажівки!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 5: @@aca_chapter_book1_5_title@@.<br><br>Ви довели, що володієте всіма необхідними вміннями<br>водіння, маневрування та паркування вантажівки!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Розігрів двигуна"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Ви завершили розділ:@@aca_chapter_book2_0_title@@.<br><br>Ви отримали розуміння правил та особливостей курсу поглиблення навичок.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Знову за кермом"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 2: @@aca_chapter_book2_1_title@@.<br><br>Дали двигунові прогрітися, перевірили коробку передач, прокрутили колеса та перевірили роботу гальм. Далі буде складніше та цікавіше.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Колеса крутяться"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 3: @@aca_chapter_book2_2_title@@.<br><br>Ви успішно подолали виклики різноманітних та складних завдань і продемонстрували справжні вміння.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Фінішна пряма"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 4: @@aca_chapter_book2_3_title@@.<br><br>Ви показали себе в різних непростих ситуаціях, які вимагали маневрування, паркування та руху заднім ходом із причепом. Ви довели, що належите до обмеженого числа вправних водїів, здатних зорієнтуватися в найрізномантіших умовах."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Рухаємося вперед"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Пізнайте всі незамінні техніки для водіння з подвійними причепами при русі вперед."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 1: @@aca_chapter_book3_1_title@@.<br><br>Ви навчилися кермування та маневрування з подвійними причепами.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Кермування назад"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Отримайте уявлення про покроковий підхід до руху заднім ходом із подвійним причепом."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 2: @@aca_chapter_book3_2_title@@.<br><br>Ви навчилися такої непростої науки як рух заднім ходом із подвійними причепами.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Готуємося до реальності"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Застосуйте нові знання в практичних ситуаціях."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br>Ви завершили розділ 3: @@aca_chapter_book3_3_title@@.<br><br>Ви показали себе в різних непростих ситуаціях, які вимагали маневрування, паркування та руху заднім ходом із подвійним причепом. Ви продемонстрували свій професіоналізм, тож гайда тягати подвійні причепи в Euro Truck Simulator 2!</font><br><br>"


#@}

