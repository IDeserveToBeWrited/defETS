#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Підсумковий іспит (частина 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "В останній частині іспиту перевірятимуться раніше набуті вміння паркування. Маневруйте з обережністю та точністю: дороги Європи вже чекають на вас!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Паркування зі зміщенням"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Діагональне паркування"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Рух майданчиком"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Паралельне паркування"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Останнє паркування"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Вітаємо на другій частині підсумкового іспиту. Ми перемістимося до стоянки поблизу та перевіримо ваші вміння: рух заднім ходом та заїзд на паркувальні місця."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "На вас чекають декілька паркувальних маневрів підряд – щоб перевірити ваші вміння."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Місця тут обмаль, тому будьте обережні та не спішіть."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Пам'ятайте бути обережними та не спішити. Нічого страшного, якщо вам не вдасться з першого разу. Головне – не пошкодити вантажівку та об'єкти довкола.<font face=/font/big_bold.font><br><br>Приготуйтеся до руху.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Рухайтеся вперед до першої частини іспиту.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Перше завдання – паркування зі зміщенням. Місце, куди потрібно заїхати з причепом, знаходиться ліворуч від вас.<br><br><font face=/font/big_bold.font>Здійсніть маневр паркування зі зміщенням.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "На наступному етапі потрібно заїхати заднім ходом у ряд припаркованих вантажівок. Не зачепіть інші автомобілі!<br><br><font face=/font/big_bold.font>Здійсніть діагональне паркування.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Продовжуйте рух майданчиком. Зважайте на можливі неочікувані ситуації.<br><br><font face=/font/big_bold.font>Продовжуйте рух.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Тепер спробуємо паралельне паркування між двома вантажівками попереду.<br><br><font face=/font/big_bold.font>Здійсніть паралельне паркування.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Ліворуч – останній паркувальний маневр! Можете здійснити його будь-яким зручним для вас способом.<br><br><font face=/font/big_bold.font>Заїдьте заднім ходом у позначену зону.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Майже все. Покиньте територію та припаркуйтеся.<br><br><font face=/font/big_bold.font>Виїзд – ліворуч від вас.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Можете припаркуватися поруч з іншими вантажівками праворуч.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Паралельне паркування з причепом"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "У даній ситуації ми розглянемо паралельне паркування із причепом."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Зупинка у позначеній зоні"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Паралельне паркування із причепом – обов'язкове вміння всіх водіїв вантажівок.<br>Чи то щоб припаркуватися на міській вулиці, чи щоб зупинитися на нічліг на майданчику, без цієї навички не обійтися."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Проїжджаючи повз місце для паркування, переконайтеся, що наявно достатньо місця для тягача і причепа. В даній ситуації ми подбали про те, щоб місця було вдосталь."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Порівняйтеся із вантажівкою перед паркувальним місцем. При цьому не під'їжджайте занадто близько: залишайте достатньо місця для маневрування."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Різко поверніть у бік, протилежний від паркувального місця, та почніть рух заднім ходом. Мета – відразу змусити причіп рухатися до паркувального місця."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Коли причіп скеровано на місце, можете починати слідувати за ним."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Починайте скеровувати причіп від бордюру, перш ніж колеса причепа з боку водія увійдуть на паркувальне місце."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Вирівняйте тягач щодо причепа в центрі паркувального місця.<br> Завершіть паркування, вимкніть двигун, застосуйте ручне гальмо."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Паркувальне місце знаходиться попереду – між іншими вантажівками. Паркуючись, обов'язково перевіряйте дзеркала та тримайтеся на безпечній відстані до перешкод довкола.<br><br><font face=/font/big_bold.font>Приготуйтеся починати рух.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Проїдьте майданчиком, щоб знайти паркувальне місце.<br><br><font face=/font/big_bold.font>Рухайтеся вперед.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Проїжджайте мимо обраного паркувального місця до позначеної зони. Звідси можете починати рух заднім ходом.<br><br><font face=/font/big_bold.font>Зупиніться у визначеному місці.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Щоб причіп повернув до місця, потрібно повернути тягача у протилежний бік. Не повертайте надто різко, інакше ви в'їдете в бордюр.<br><br><font face=/font/big_bold.font>Починайте рух заднім ходом.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Вирівняйте причіп щодо місця. Якщо потрібно, здійсніть рух вперед або назад, корегуючи положення вантажівки кермом.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Вітаємо з успішним проходженням базового курсу основ керування вантажівкою: ви склали всі іспити та засвоїли уміння, необхідні для правильного маневрування вантажівкою."

	key[]: "aca_msg_book1_outro02"
	val[]: "Це перший крок на шляху до кар'єри професійного водія вантажівки."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Тепер ви готові вирушати на європейські дороги й самостійно долати свої перші виклики..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...але пригоди лише починаються."
#@}


