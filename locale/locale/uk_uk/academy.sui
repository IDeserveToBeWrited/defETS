#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "На останньому занятті даного розділу ми проїдемо тестовим маршрутом зі складною конфігурацією."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Перша перешкода – слалом повз огородження. Проїжджайте та не забувайте користуватися дзеркалами."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Далі – поворот-шпилька. Заїжджайте широкою траєкторією – і проблем не виникне."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Тут у нас поворот на 90 градусів. Пам'ятайте, що потрібно проїхати вглиб, аби задня частина вантажівки безперешкодно минула внутрішні огородження."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Перешкода у вигляді рампи може виявитися непростою. Розташуйтеся якомога рівніше перед заїздом та використовуйте дзеркала із боків та спереду, щоб орієнтуватися."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Наступну ділянку слід проїхати заднім ходом. Враховуйте це, під'їжджаючи до огороджень."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Слідуйте за розміткою назад і праворуч."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Під'їдьте заднім ходом до огороджень, зупиніться, а потім рухайтеся прямо та ліворуч."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Проїдьте крізь розрив у розділювальній смузі до наступної ділянки."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Проїзд між конусами – дуже вузький. Рухайтеся повільно та використовуйте дзеркала, щоб орієнтуватися."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Не забувайте проїжджати вглиб, повертаючи на 90 градусів."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Зараз ви в'їжджайте на відкриту ділянку дороги. Можете набрати трохи швидкості, але враховуйте, що далі доведеться пригальмувати перед поворотом."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Укінці схилу через дорогу знаходяться огородження. Під'їдьте до них, а тоді заїдьте заднім ходом на паркувальне місце ліворуч."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Заїдьте заднім ходом на паркувальне місце."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Зупиніться, тоді вимкніть двигун та застосуйте ручне гальмо."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Попереду – слалом, утворений огородженнями.<br><br><font face=/font/big_bold.font>Проїдьте через слалом.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Тримайтеся зовнішньої частини повороту, щоб не заїжджати на бордюр.<br><br><font face=/font/big_bold.font>Проїдьте поворот. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Ви наближаєтеся до повороту на 90 градусів ліворуч. Пам'ятайте ефективно використовувати наявний простір.<br><br><font face=/font/big_bold.font>Пройдіть поворот.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Вирівняйтеся щодо рампи. Щойно ви заїдете, місця для коректування траєкторії буде обмаль.<br><br><font face=/font/big_bold.font>Переїдьте рампу. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Рухайтеся маршрутом ліворуч. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Наступну ділянку слід подолати заднім ходом. Зупиніться перед огородженнями попереду, щоб ви змогли розпочати рух заднім ходом у напрямку праворуч.<br><br><font face=/font/big_bold.font>Зупиніться перед огородженнями.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Рухайтеся назад до ділянки праворуч від вас. Розмітка у вигляді стрілок підкаже вам правильний напрям руху.<br><br><font face=/font/big_bold.font>Рухайтеся заднім ходом до наступної частини маршруту. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух заднім ходом до огороджень.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Зупиніться, увімкніть передачу для руху вперед та їдьте ліворуч.<br><br><font face=/font/big_bold.font>Рухайтеся вперед.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Ліворуч від вас знаходиться розрив у розділювальній смузі. Проїдьте через нього.<br><br><font face=/font/big_bold.font>Продовжуйте рух. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Попереду – вузький та звивистий проїзд поміж конусами. Рухайтеся обережно та за необхідності використовуйте дзеркала.<br><br><font face=/font/big_bold.font>Проїдьте між конусами. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Продовжуйте рух маршрутом.<br><br><font face=/font/big_bold.font>Поверніть ліворуч. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Пам'ятайте триматися ліворуч перед поворотом, щоб вам вистачило місця.<br><br><font face=/font/big_bold.font>Пройдіть поворот. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Можете трохи набрати швидкості, але зважайте, що попереду дорога повертає.<br><br><font face=/font/big_bold.font>Продовжуйте рух маршрутом.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Чим далі ви проїжджаєте у поворот, тим крутішим він стає.<br><br><font face=/font/big_bold.font>Слідкуйте за швидкістю відповідно до умов.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Укінці схилу посеред дороги знаходяться огородження. <br><br><font face=/font/big_bold.font>Зупиніться біля огороджень. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Позаду вас ліворуч знаходиться паркувальне місце.<br><br><font face=/font/big_bold.font>Заїдьте на паркувальне місце заднім ходом.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Зупиніться у позначеному місці. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

