	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Це дуже типова – практично щоденна – ситуація у роботі водія вантажівки.<br>Паркування тут потребує маневру на кшталт заїзду в провулок."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Цей маневр подібний до попереднього завдання, але місця буде менше: тому потрібно буде ретельно планувати свої дії та постійно слідкувати за перешкодами в просторі."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Оскільки маневрування відбувається в обмеженому просторі, важливу роль відіграє правильний момент: вчасно поверніть причепа та відстежуйте траєкторію руху тягача і причепа. Враховуйте винос причепа та слідкуйте за кутом зламу – продовжуйте штовхати причіп."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Намагайтеся триматися ближче до вантажівки з боку водія – так у причепа буде більше місця для розвороту, а у вас менше підстав хвилюватися через вантажівку з іншої сторони."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Щойно ваш причіп опиниться на місці, вирівняйте тягач. Краще почати вирівнювання трохи раніше, ніж підказує інстинкт. Завжди можна буде виправити положення під час подальшого руху назад."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Вирівняйте тягач та причіп і зупиніться у визначеній зоні."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Застосуйте ручне гальмо і вимкніть двигун."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Тепер спробуємо розвернути причіп у набагато меншому просторі за допомогою паркування в провулку.<br><br><font face=/font/big_bold.font>Готуйтеся розпочати рух.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Озирніться та знайдіть паркувальне місце позаду. <br><br><font face=/font/big_bold.font>Починайте рух заднім ходом до місця.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Поверніть причіп на паркувальне місце. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Підсумковий іспит (частина 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Попереду – підсумковий іспит, на якому відбудеться перевірка всіх умінь, які ви засвоїли, виконуючи попередні завдання. Ми проїдемо всіма маршрутами, щоб ви мали змогу продемонструвати, чому навчилися раніше.<br><br>Подолавши всі ділянки та здійснивши всі маневри, ви опинитеся на крок ближче до того, щоб називатися водієм-професіоналом!"

