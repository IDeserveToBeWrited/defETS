#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Простір для заднього ходу"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Дане завдання – потренуватися в русі заднім ходом із подвійними причепами на майданчику."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Підготовка до руху"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Експерименти"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Завершення"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Закінчення завдання"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Рух заднім ходом із подвійним причепом вимагає куди більше уваги, ніж зі звичайним. Потрібно передбачити, куди вам потрібно спрямувати задній причіп, слідкуючи при цьому за першим причепом та кабіною. <br><br>Розраховуйте манверування таким чином, що вам потрібно керувати другим причепом за допомогою першого."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Зараз нам потрібно повернути задній причіп до водійського боку. Для цього нам потрібно штовхнути передню частину заднього причепа в пасажирський бік. <br><br>Тож це по суті означає, що вам потрібно повертати перший причіп у бік, протилежний від бажаного напрямку заднього причепа."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Коли задній причіп почне повертати, необхідно вирівняти тягач та перший причіп. Саме на цьому етапі зазвичай стаються помилки."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Даний водій не вирівнявся щодо першого причепа та ось-ось складе причепи."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Автопоїзд складається, коли кут залому двох елементів досягає приблизно 90 градусів. Коли це стається – нічим не зарадиш, потрібно проїхати вперед та спробувати знову.<br><br> Так само як і з одним причепом, необхідно, щоб колеса причепів перебували в русі. Якщо вони зупиняються та причіп обертається на місці, вже занадто пізно."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Можете проїхати вперед до точки, де востаннє все було гаразд, або – що краще – зайняти нову позицію, з якої ви зможете заїхати, не повторивши помилки. <br><br>Зараз ми просто вирівняємося та спробуємо спочатку."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Пам'ятайте, що коли задній причіп почав поворот, потрібно вирівняти тягач щодо першого причепа та дозволити задньому причепу повертати самостійно."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Тепер, коли задній причіп став на бажану траєкторію, час відправити перший причіп услід за ним. Ви можете регулювати кут між першим та другим причепом, щоб змінювати крутість дуги заїзду."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Остання частина маневру – вирівняти все. Вирівняйте перший причіп щодо другого."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Враховуйте, що на переміщення першого причепа потрібен час, тож, якщо ловити ґав, задній причіп спробує поїхати по колу!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Залишайтеся тут, скільки завгодно, експериментуйте з підходами до маневрування, щоб здобути загальне уявлення про те, як рухатися з причепами заднім ходом.<br><br>Але пам'ятайте, що головне – це щоб вам було весело та цікаво!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Приготуйтеся до початку руху."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Скористайтеся цим майданчиком, щоб отримати уявлення про рух заднім ходом. <br><br>@@aca_goal_tip@@ Можливо, ви ще взагалі не їздили заднім ходом із причепом? Спробуйте модуль Основ керування вантажівкою."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Можете вправлятися, скільки завгодно. <br><br>Коли вам буде достатньо, зупиніться та застосуйте ручне гальмо, щоб закінчити."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Вимкніть двигун, щоб завершити."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Паркування у вузькому просторі"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "На даному занятті нам потрібно буде припаркувати ваш набір із двох причепів у вузькому місці."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Підготовка до руху"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Початок руху"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Продовжуйте рух"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Зупинка"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Знерухомлення вантажівки"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Рух із подвійним причепом може здатися ще тією задачею, але насправді тут не так багато відмінностей з водінням із одним причепом – потрібно лише враховувати траєкторію заднього причепа!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Попереду – вузьке паркомісце. Місця, щоб вирівнятися перед заїздом, не достатньо, тож вам доведеться поміркувати, як краще в'їхати з двома причепами."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Різко поверніть до дальньої сторони паркомісця та проїжджайте далі точки, де б ви зазвичай повернули всередину."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Ваш задній причіп вийшов на траєкторію, тож можете рухатися до місця; не забудьте знову проїхати до дальньої сторони, щоб виправити положення першого причепа."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Заїжджайте на місце: обидва причепи зайдуть за вами та вирівняються."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Зупиніться у позначеній зоні та застосуйте ручне гальмо."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Приготуйтеся до початку руху."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Проїжджайте вперед до вузької ділянки."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Продовжуйте рух."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Зупиніться у позначеній зоні."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Застосуйте ручне гальмо і вимкніть двигун."
#@}


