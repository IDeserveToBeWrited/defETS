#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Паркування поруч із перешкодою"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "У даній ситуації вам потрібно припаркуватися біля бордюру, використовуючи бічне дзеркало."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Перевірте бічне дзеркало"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Рух до бордюру"
