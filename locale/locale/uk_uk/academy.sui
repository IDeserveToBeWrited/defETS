	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Випробовувальна траса"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Зараз ми проїдемося трасою, розробленою для перевірки вмінь керування вантажівкою у поворотах та вигинах різного типу."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "В'їзд на маршрут"

	key[]: "aca_goal_book1_2_08_check1"
