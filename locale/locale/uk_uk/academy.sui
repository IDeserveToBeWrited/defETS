#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Попереду знаходиться огородження. Під'їдьте до нього та зупиніться."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Позаду вантажівки зі сторони водія знаходиться ще одне огородження. Рухайтеся до нього заднім ходом уздовж дуги. Розмітка на дорозі підкаже траєкторію руху."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Прямо попереду знаходиться крутий поворот на 90 градусів. Рухайтеся до нього."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Нам потрібно проїхати вглиб повороту, щоб задні колеса не зачепили конус із внутрішнього боку.<br>Дивіться у дзеркала!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Вирівняйтеся, під'їдьте до останніх огороджень, зупиніться та застосуйте ручне гальмо."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Приготуйтеся до початку руху. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Вантажівка ще не готова до руху: можливо, ви щось забули?<br><br>Двигун працює? Ви відпустили ручне гальмо?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Попереду – перед огородженням – розташоване позначене місце.<br><br><font face=/font/big_bold.font>Їдьте вперед і зупиніться в позначеному місці.</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Подивіться назад зі сторони водія: ви побачите ще одне позначене місце. Вам доведеться рухатися заднім ходом у повороті.<br><br><font face=/font/big_bold.font>Рухайтеся заднім ходом уздовж дуги та зупиніться у позначеному місці. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Далі на маршруті – поворот на 90 градусів.<br><br>Тримайтеся водійського боку перед поворотом, проїдьте вглиб, а тоді швидко та круто зробіть рух кермом. Слідкуйте, щоб не зачепити конус.<br><br><font face=/font/big_bold.font>Рухайтеся вперед та в поворот.</font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Дивіться у дзеркала спереду та з боків, щоб точно нічого не зачепити.<br><br><font face=/font/big_bold.font>Поверніть та зупиніться у позначеній зоні.</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Вимкніть двигун та застосуйте ручне гальмо.</font>"
#@}

