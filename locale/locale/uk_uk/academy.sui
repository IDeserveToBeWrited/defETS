#+ Books general.
#@{
	key[]: "aca_modded_book"
	val[]: "Модифікація"

	key[]: "aca_book_inaccessible"
	val[]: "Невдовзі з’явиться новий вміст. Слідкуйте за новинами."

	key[]: "aca_book_inaccessible_t"
	val[]: "НЕЗАБАРОМ"

	key[]: "aca_book_inaccessible_u"
	val[]: "Незабаром!"

	key[]: "aca_book_disclaimer_t"
	val[]: "ЗАСТЕРЕЖЕННЯ"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Це не сертифікована навчальна програма."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ не створена як альтернатива курсу водіння в автошколі.</font><br><br><color value=@@clr_txt@@>Ми наполегливо рекомендуємо звернутися до акредитованого закладу з підготовки водіїв, перш ніж намагатися керувати вантажівкою у реальних умовах.<br><br>Заклади, зацікавлені у використанні модуля @@driving_academy@@ як доповнення до курсів підготовки водіїв, можуть звернутися до нас за адресою academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Основи керування вантажівкою"

	key[]: "aca_book_book1_desc"
	val[]: "Навчіться основ керування вантажівкою: від основних функцій та приладів до маневрування з причепом."

	key[]: "aca_book_book2_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_book_book2_desc"
	val[]: "Розвивайте свої навички кермування, виконуючи нові завдання, що ставлять нові виклики."

	key[]: "aca_book_book3_title"
	val[]: "Подвійні причепи"

	key[]: "aca_book_book3_desc"
	val[]: "Нові виклики та завдання – із подвійним причепом!"

#@}

