#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "ПРО КУРС ПОГЛИБЛЕНИХ НАВИЧОК КЕРУВАННЯ" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Вимоги для завершення"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Для завершення завдання потрібно виконати всі вимоги"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Зірки здобуваються шляхом виконання додаткових вимог"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Вимоги"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Максимальна кількість перемикань між рухом вперед і назад"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Максимально допустимий час на виконання вимог"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Виключно вид зсередини – вид ззовні можна використовувати зупинившись"

	key[]: "aca_book_book2_completed_t"
	val[]: "КУРС ПОГЛИБЛЕНИХ НАВИЧОК КЕРУВАННЯ ПРОЙДЕНО"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br><br>Ви виконали всі вимоги для завершення курсу Поглиблених навичок керування та отримаєте нагороди для свого профілю в режимі кар'єри. Якщо бажаєте випробувати себе – та здобути нові нагороди – запрошуємо спробувати виконати бонусні вимоги.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "КУРС ПОГЛИБЛЕНИХ НАВИЧОК КЕРУВАННЯ ЗАВЕРШЕНО"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Вітаємо!<br><br>Ви виконали всі вимоги – як основні, так і бонусні – для завершення курсу Поглиблених навичок керування та отримаєте нагороди для свого профілю в режимі кар'єри.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Поглиблені навички керування"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "@@driving_academy@@ вітає з поверненням!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Ці завдання та вправи — наступний етап на шляху до водіння вантажівки на професійному рівні."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Цього разу ми не будемо супроводжувати вас на виконанні кожної задачі, тож вам потрібно самостійно скерувати свої навички та досвід."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Вас чекають уже відомі маневри, однак в умовах, що більше нагадують реальні ситуації."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "@@driving_academy@@ отримала оновлення: тепер існують як умови для \"зарахування\", так і \"бонусні\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Як і раніше, потрібно завершити кожне завдання без зіткнень, припаркувавшись та знерухомивши вантажівку..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...однак тепер вам також потрібно вкластися в обмеження щодо часу та кількості дозволених змін напрямку руху вперед та назад."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Бонусні умови полягають у виконанні кожного завдання, дотримуючись вимог щодо поглибленої складності..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...як то суворіших обмежень часу та кількості змін напрямку руху або використання лише виду зсередини."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Виконавши всі завдання, ви цілком можете вважати себе професійним водієм, готовим до будь-яких викликів на дорозі.<br><br>А щоб було цікавіше, виконайте також усі бонусні умови; тоді ви будете справжньою зіркою перевезень!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Інструктаж"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "На даному ознайомчому завданні ви зможете дізнатися про особливості курсу Поглиблення навичок керування."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "На початку кожного завдання ви побачите вікно <color value=@@clr_sel@@>\"Огляду завдання\"<color value=@@clr_txt@@> з інформацією про умови для зарахування, а також бонусні умови.<br><br>Для успішного завершення, потрібно виконати всі умови для зарахування, тоді як бонусні умови – для тих, хто не боїться викликів і має для достатні уміння та досвід.<br><br><font face=/font/big_bold.font>Щоб продовжити, увімкніть запалювання.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Одна з бонусних умов – виконати завдання, використовуючи <color value=@@clr_sel@@>вид зсередини<color value=@@clr_txt@@>. Ви можете використовувати камери огляду ззовні, щоб оглянути оточення, але лише коли вантажівка нерухома.<br><br>Зараз можете оцінити ситуацію, а тоді ввімкніть вид зсередини.<br><br><font face=/font/big_bold.font>Увімкніть вид ззаду, щоб розглянутися довкола</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Оцініть ситуацію, а тоді перемикайтеся на вид зсередини.<br><br><font face=/font/big_bold.font>Огляньте територію довкола вантажівки</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Знову ввімкніть вид зсередини</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Час<color value=@@clr_txt@@> – важливий елемент у модулі Поглиблених навичок. Для кожного завдання встановлено окреме обмеження часу для його проходження, багато завдань також матимуть суворіше обмеження як бонусну умову.<br><br>Обрахунок часу починається лише після початку руху.<br><br><font face=/font/big_bold.font>Запустіть двигун та відпустіть ручне гальмо, щоб продовжити.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Ще одне нововведення для модуля Поглиблених навичок – це точки на маршруті. Щоб завершити завдання, потрібно досягнути всіх точок.<br><br>Окрім цього, для кожної точки має значення, в якому напрямку скерована вантажівка, тож зважайте на розмітку, щоб під'їхати з правильного боку.<br><br><font face=/font/big_bold.font>Рухайтеся вперед у напрямку точки попереду.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Ви доїхали до точки, тож можете переходити до наступного етапу.<br><br>Позаду вас ще одна точка: туди потрібно заїхати заднім ходом. Зверніть увагу на стрілку на дорозі, яка вказує, в якому напрямку повинна бути скерована вантажівка під час заїзду.<br><br>Ще одна умова, що може бути основною та бонусною, це <color value=@@clr_sel@@>зміна напрямку<color value=@@clr_txt@@>. Рахується кількість змін напрямку між рухом вперед і назад. Дотримуйтеся обмеженя, щоб задовольнити умову завершення завдання.<br><br><font face=/font/big_bold.font>Рухайтеся заднім ходом до точки та зупиніться.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Таким чином зараз вам повинно бути нараховано одну зміну напрямку.<br><br>Приєднайте причіп позаду, щоб перейти до наступного етапу.<br><br><font face=/font/big_bold.font>Під'їдьте під причіп заднім ходом, щоб приєднати.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Зона для фінального паркування знаходиться праворуч від вас. На деяких завданнях буде лише одне паркувальне місце, тоді як на інших у вас буде можливість обрати між кількома. Правильне паркування на одному з місць дозволить успішно завершити завдання.<br><br><font face=/font/big_bold.font>Щоб приєднати причіп, натисніть @@imv_nrm_attach@@.</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Для паркувальних місць також важливий напрямок скерування вантажівки. Припаркувавшись неправильним боком, вам доведеться витрачати час та дозволені зміни напрямку руху, щоб виправити ситуацію і таки завершити завдання.<br><br><font face=/font/big_bold.font>Проїжджайте до одного з паркувальних місць та припаркуйтеся правильним боком.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Поглиблені навички керування"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Тепер коли ви ознайомилися із новою системою основних та бонусних умов, можна сміливо переходити до завдань модуля Поглиблених навичок керування! <br><br><font face=/font/big_bold.font>Щоб завершити поточне завдання, застосуйте ручне гальмо та вимкніть двигун.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Коротший шлях"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "На даному завданні спробуємо скористатися коротшою дорогою, але ж – от халепа – проїзд заблоковано. Доведеться повернутися на первинний маршрут заднім ходом."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Під'їдьте до точки на вершині пагорба, а тоді заднім ходом поверніться донизу.<br><br>Повернувшись на дорогу, проїдьте до зони для фінального паркування."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Рання птаха"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "На даному завданні вам потрібно знайти шлях крізь переповнену стоянку. Місця вкрай обмаль, тож плануйте кожен маневр заздалегідь."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Інколи на стоянці бракує місць для всіх охочих зупинитися на ночівлю, тож водії паркуються на кожному вільному клаптику. Однак це може суттєво ускладнити життя тим, кому потрібно виїжджати рано-вранці.<br><br>Постарайтеся безпечно проїхати майданчиком до фінального місця паркування."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Викрутаси"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "На даному завданні вас чекає багатоскладовий тренувальний маршрут. По дорозі вам потрібно буде знайти та приєднати причіп і довезти його до кінця."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Завдання стане випробуванням вашої здатності орієнтуватися просторово та ситуаційно. На маршруті багато перешкод, подекуди майже непомітних."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Рухайтеся маршрутом до причепа. Знайшовши причіп, приєднайте його та відвезіть до фінального паркувального місця."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Запаморочення"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "На даному завданні випробуємо ваше вміння тримати траєкторію. Рухайтеся по колу та ще по колу, доки не досягнете кінця!"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "Час перевірити ваші навички кермування: маршрут продемонструє, як добре ви знаєте свою вантажівку!"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "Центральний елемент – довга спіраль, яка стане перевіркою вашого вміння скеровувати вантажівку в затяжних поворотах."

#@}




#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Заднім ходом за ріг"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "На даному завданні потрібно заднім ходом припаркувати за поворотом зі сторони пасажира."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Точки розвантаження не завжди розташовані в зручному місці. У цьому випадку вона взагалі схована за сусідньою будівлею."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Рухайтеся заднім ходом за будівлю та на паркувальне місце."

#@}



#+ Book 2 depot_options
#@{
#### common
	key[]: "aca_scenario_book2_depot_options_title"
	val[]: "Складське паркування"

	key[]: "aca_scenario_book2_depot_options_desc"
	val[]: "На даному завданні вам потрібно припаркуватися на одному з трьох різних паркувальних місць – кожне вимагає іншого типу маневрування."

#### intro text

	key[]: "aca_scenario_book2_depot_options_cutscene1"
	val[]: "Вам доступні на вибір три різних паркувальних місця. Оберіть одне з них та заїжджайте заднім ходом – складність заїзду може варіюватися."


#@}

#+ Book 2 night_parallel
#@{
#### common
	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Нічне паралельне паркування"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "Потрібно припаркуватися біля бордюру. На дворі ніч, тож видимість обмежена."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Пора доби та погода не завжди цілком сприятливі, коли настає час ставати на відпочинок, тож слідкуйте уважно за тим, що вас оточує.<br><br>Не забудьте увімкнути ліхтарі!"

#@}

#+ Book 2 slalom_nt
#@{
#### common
	key[]: "aca_scenario_book2_reverse_slalom_nt_title"
	val[]: "Слалом заднім ходом"

	key[]: "aca_scenario_book2_reverse_slalom_nt_desc"
	val[]: "На даному завданні вам потрібно подолати декілька з'єднаних слаломів, рухаючись заднім ходом."

#### intro text

	key[]: "aca_scenario_book2_reverse_slalom_nt_cutscene1"
	val[]: "Позаду вас – маршрут, що складається із кількох секцій слалому."

	key[]: "aca_scenario_book2_reverse_slalom_nt_cutscene2"
	val[]: "Проїдьте крізь кожну секцію заднім ходом – до паркувальної зони в кінці."

#@}


#+ Book 2 reverse_slalom_nt
#@{
#### 3_21 common
	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Подвійний слалом"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "На даному завданні вас чекає короткий маршрут, що складається із двох поєднаних слаломів."

#### slalom_nt intro text

	key[]: "aca_scenario_book2_slalom_nt_cutscene1"
	val[]: "Маршрут на завданні – це два з'єднаних слаломи. Проїдьте крізь перший, не зачіпаючи конусів, та розверніться в кінці."

	key[]: "aca_scenario_book2_slalom_nt_cutscene2"
	val[]: "Звідси продовжуйте рух другим слаломом та до зони для паркування.<br><br>Засікаємо час, тож рухайтеся цілеспрямовано – однак обережно!"

#@}


#+ Book 2 backing_options
#@{
