	key[]: "aca_scenario_book3_finex_title"
	val[]: "Підсумковий іспит"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "На даному завданні перевіримо ваші нові вміння – чи засвоїли ви, як потрібно рухатися з подвійним причепом."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Рух заднім ходом"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "В'їзд на маршрут"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Розгін"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Готуємося гальмувати"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Недостатня швидкість"

