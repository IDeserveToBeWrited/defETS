#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Дане завдання – це перевірка ваших новонабутих умінь керування тягачем на короткому маршруті."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "На маршруті знаходяться різного роду повороти та вигини. Це не перегони, тож спішити не потрібно. Проходьте маршрут терпеливо та обирайте швидкість, зважаючи на повороти та перешкоди."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "На початку маршрут – низької складності, але вона зростатиме з кожним новим поворотом."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Зважайте на швидкість: якщо рухатися надто швидко, можна неправильно оцінити характер повороту."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Виїзд із маршруту – це дуже вузька шпилька. Не спішіть та ефективно використовуйте наявний простір."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Зупиніться між огородженнями та застосуйте ручне гальмо."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Щоб успішно виконати дане завдання, вам потрібно пройти маршрут без зіткнень, з'їздів з дороги та контактів із дорожніми конусами.<br><br><font face=/font/big_bold.font>Приготуйтесь до початку руху. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Рухайтеся вперед крізь крутий поворот праворуч, щоб розпочати маршрут.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Рухайтеся через поворот на стабільній швидкості. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Ви наближаєтеся до ділянки зі складнішими звивистими поворотами.<br><br><font face=/font/big_bold.font>Слідкуйте за швидкістю та продовжуйте рух.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух до наступних поворотів.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Попереду кілька простих поворотів. Рухайтеся зі стабільною швидкістю.<br><br><font face=/font/big_bold.font>Продовжуйте рух.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Виїзд із маршруту – це крутий поворот-шпилька. Пригальмуйте та тримайтеся зовнішньої сторони перед поворотом. Обов'язково дивіться у дзеркала!<br><br><font face=/font/big_bold.font>Виїжджайте з маршруту. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Попереду – паркувальне місце між огородженнями.<br><br><font face=/font/big_bold.font>Рухайтеся до паркувального місця. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Паралельне паркування"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "У даній ситуації ми розглянемо паралельне паркування між двома іншими вантажівками."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Зупинка перед паркувальним місцем"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Перевірка дзеркала заднього огляду"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Задній хід на паркувальне місце"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Вирівнювання вантажівки на місці"
