	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "На даному занятті ми навчимося розвертатися в обмеженому просторі за допомогою маневрування через сторону обмеженого огляду. Це вміння знадобиться у ситуаціях, коли неможливо просто розвернутися або рухатися назад водійським боком."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Розмітка допоможе орієнтуватися на майданчику."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Зробіть широкий поворот, щоб причіп пройшов повз припарковані вантажівки."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Виїжджаючи з повороту, враховуйте положення вантажівки для наступного маневру заднім ходом."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Буде простіше, якщо вантажівка відразу буде скерована в напрямку порожнього паркувального місця з пасажирського боку, на яке ви заїжджатимете заднім ходом."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Заїзду заднім ходом стороною з обмеженим оглядом слід уникати, оскільки оглядовість суттєво обмежена. На жаль, інколи немає іншого виходу."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Відразу повертайте кермо, щоб причіп якнайшвидше розвернувся в необхідному напрямку – це може бути єдиний вихід в обмеженому просторі."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Коли причіп увійшов на місце, розташуйте тягач перед ним та вирівняйтеся."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Зупиніться, вирівнявшись та за умови, що попереду достатньо місця. Починайте рухатися в напрямку, з якого ви приїхали."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Слідуйте за розміткою для виїзду з тренувального майданчика."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Слідуйте за дугою повороту та проїжджайте до позначеної зони."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Зупинка."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Застосуйте ручне гальмо і вимкніть двигун."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Попереду вас знаходиться тренувальний майданчик, що імітує територію компанії-перевізника. Вам потрібно заїхати та розвернутися для виїзду. Старайтеся ефективно використовувати доступний вам простір.<br><br><font face=/font/big_bold.font>Приготуйтеся розпочати рух. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Рухайтеся до виїзду. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Пройдіть поворот та продовжуйте рух маршрутом.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Слідуйте за розміткою до огородження на кінці маршруту. Зупиніться дещо під кутом, щоб причіп було скеровано в сторону порожнього паркувального місця з пасажирського боку.<br><br><font face=/font/big_bold.font>Рухайтеся вперед. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Рухаючись у бік обмеженого огляду, значно важче орієнтуватися в просторі. Маневруйте повільно та максимально обережно, слідкуйте за тим, що відбувається в дзеркалах.<br><br><font face=/font/big_bold.font>Починайте рух заднім ходом та поворот причепа. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Цього достатньо. Тепер можете рухатися вперед та виїжджати з тренувального комплексу так, як і заїжджали.<br><br><font face=/font/big_bold.font>Рухайтеся до виїзду. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Виїжджайте з маршруту. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Слідуйте за розміткою до місця для паркування.<br><br><font face=/font/big_bold.font>Рухайтеся до визначеної зони. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Рух заднім ходом зі зміщенням"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "У даній ситуації вам потрібно заїхати заднім ходом на місце, що знаходиться не прямо позаду вас, а дещо збоку. Зважайте, що простір для маневрів – обмежений."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
