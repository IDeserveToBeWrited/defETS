	val[]: "@@aca_goal_book1_2_01_start@@"



 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Зараз ми трохи проїдемося вантажівкою. Мета – відчути, як відбувається гальмування з причепом на пологому спуску. Розпочинайте рух, коли будете готові."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Досягніть швидкості в щонайменше 60 км/год (37 миль/год). Будьте готові гальмувати в зоні попереду."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Починайте гальмування до повної зупинки. Не баріться, інакше ризикуєте влетіти в огородження попереду!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Зупиніться в позначеній зоні, тоді застосуйте ручне гальмо і вимкніть двигун."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Під час поїздки ви отримаєте враження про принципи використання гальм на пологому спуску. Наше завдання – інтуїтивно зрозуміти, як наявність значної маси за вашою спиною впливає на гальмування транспортного засобу. <br><br><font face=/font/big_bold.font>Готуйтеся починати рух.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Починайте рух і пам'ятайте, що вам потрібно буде досягти швидкості 60 км/год (37 миль/год).<br><br><font face=/font/big_bold.font>Пройдіть поворот. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Продовжуйте набирати швидкість на схилі. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Досягніть швидкості у 60 км/год (37 миль/год) щонайменше.</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Необхідної швидкості досягнуто.<br><br><font face=/font/big_bold.font>Зупиніться перед огородженнями попереду.</font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

