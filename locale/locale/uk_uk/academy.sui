#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Вітаємо на першій частині підсумкового іспиту. Тут ми перевіримо, наскільки добре ви навчилися керувати вантажівкою на заняттях в академії."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Спершу приєднаємо причіп, а потім ви проїдете усім іспитовим майданчиком."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Перша ділянка траси веде від малої стоянки до східного іспитового маршруту."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Траса включає складні проїзди поміж огородженнями."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Значна частина маршруту – це східний іспитовий маршрут."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Ми перевіримо ваше вміння маневрувати вантажівкою у різних ситуаціях."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Вам доведеться проїхати крутими поворотами."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Ви проїдете ділянкою дороги, яка з'єднує навчальні маршрути."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Остання частина включає рух невеликою трасою."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Траса складається з багатьох складних проїздів та різких поворотів."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Щоб завершити тестування, потрібно припаркуватися з достатньою точністю."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Причин для хвилювання немає жодних: ви вже навчилися всього, що вам знадобиться на іспиті.<br><br>Удачі!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Причіп знаходиться попереду.<br><br><font face=/font/big_bold.font>Під'їдьте до причепа.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Вирівняйте тягач щодо причепа.<br><br><font face=/font/big_bold.font>Рухайтеся заднім ходом до замкнення зчіпного механізму. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Застосуйте ручне гальмо. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Натисніть @@imv_nrm_attach@@<font face=/font/big_bold.font>, щоб приєднати причіп. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Причіп приєднано – ви готові вирушати.<br><br><font face=/font/big_bold.font>Відпустіть ручне гальмо. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Рухайтеся до виїзду з майданчика. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Слідуйте розміченому маршрутові та зважайте на огородження.<br><br><font face=/font/big_bold.font>Продовжуйте рух. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Попереду – дещо складніша ділянка.<br><br><font face=/font/big_bold.font>Обережно проїдьте поміж огородженнями. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "У цій частині будуть перевірені ваші навички проїзду різних поворотів із причепом.<br><br><font face=/font/big_bold.font>Поверніть на маршрут. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Рухайтеся через проїзд. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Рухайтеся прямо. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Обережно проїдьте поворот. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Ви в'їжджаєте на складнішу ділянку. Рухайтеся з обережністю.<br><br><font face=/font/big_bold.font>Продовжуйте рух схилом. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Поверніть круто ліворуч. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Виїжджайте з траси. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Ви в'їжджаєте на менш складну ділянку.<br><br><font face=/font/big_bold.font>Продовжуйте рух схилом. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух дорогою. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Попереду – поворот на наступний маршрут.<br><br><font face=/font/big_bold.font>Продовжуйте рух. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Поверніть праворуч. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух маршрутом. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Далі за маршрутом нові круті повороти.<br><br><font face=/font/big_bold.font>Слідкуйте за швидкістю. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Поверніть ліворуч. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Продовжуйте рух. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Поверніть та продовжуйте рух. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Щоб повернути безперешкодно, вам доведеться трохи з'їхати з асфальту.<br><br><font face=/font/big_bold.font>Обережно поверніть, використовуючи простір довкола. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Виїжджайте з траси та рухайтеся до паркувального місця. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

