	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Завдання полягає в тому, щоб заїхати заднім ходом на паркувальне місце позаду зі сторони водія."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Є кілька основних порад, які варто пам'ятати, щоб вдало кермувати причепом при русі назад. <br>По-перше, причіп завжди повертатиме в бік, протилежний від напрямку руху тягача."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "По-друге, щоб зрозуміти, куди рухатиметься причіп, потрібно слідкувати за осями тягача та причепа."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "По-третє, кермо достатньо повертати лише трохи, поступово та не надміру."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Почніть злегка повертати тягач у напрямку від паркувального місця – і причіп розвертатиметься до нього."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Слідуйте за причепом. Робіть коригування, щоб він рухався, куди потрібно."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Слідкуйте за колесами причепа та задніми колесами тягача. Так ви побачите, куди скеровано причіп та куди тягач його штовхатиме далі."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Четверта порада полягає в тому, що завжди простіше різко повернути причіп, аніж намагатися вирівняти його при надмірному заломі. Цільтеся трохи далі місця, поки не під'їдете ближче, а тоді можете повертати більш різко, щоб вирівняти причіп."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Під час того, як причіп заїжджає на паркувальне місце, вирівняйте тягач попереду причепа. Уникайте надмірних корегувань усередині самого місця."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Проїдьте заднім ходом поміж огородженнями: слідкуйте за перешкодами з обох сторін."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Застосуйте ручне гальмо і вимкніть двигун."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Ось що вам потрібно пам'ятати про рух заднім ходом із причепом:<br><br>— Причіп повертає в протилежний бік від тягача<br><br>— Колеса причепа вказують, куди він рухається<br><br>— Колеса тягача вказують напрям, у якому він штовхає причіп<br><br>— Дозвольте причепу повертати поступово, не повертайте кермо надміру<br><br>— Завжди простіше різко повернути пізніше, ніж вирівнювати причіп<br><br><font face=/font/big_bold.font>Приготуйтеся до початку руху.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Подивіться назад, щоб з'ясувати, куди вам потрібно заїхати. Завжди аналізуйте простір та звертайте увагу на об'єкти, які вас оточують.<br><br><font face=/font/big_bold.font>Починайте заїжджати на паркувальне місце.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Почніть повертати причіп на паркувальне місце та слідуйте за ним тягачем.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Зупиніться у позначеному місці. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Паркування заднім ходом у тісноті"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "У даній ситуації вам потрібно буде заїхати заднім ходом на паркувальне місце на стоянці, повній автомобілів."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Поворот причепом"
