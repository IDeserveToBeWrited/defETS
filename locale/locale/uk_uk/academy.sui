#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Задній хід на 90 градусів"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "У даній ситуації застосуємо маневр руху заднім ходом на 90 градусів, щоб припаркуватися серед інших вантажівок."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Розворот"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Розташування"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Рух заднім ходом"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Задній хід із двома причепами вбік – це простіше, оскільки з вікна видно всю ситуацію."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Спершу проїдьте вперед та розверніться на кінці ряду. Це дозволить вам розташуватися для заїзду зі сторони водія."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Можете розташувати причепи в спосіб, який вам підходить, наприклад, із заднім причепом уже скерованим на паркомісце. А зараз почнемо з вирівняного положення. <br><br>Не ускладнюйте завдання – потрібно лише керувати другим причепом за допомогою першого."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Скеруйте перший причіп дещо в протилежний бік від паркомісця, тоді задній причіп почне повертати в потрібному напрямку. Після цього продовжуйте регулювати кут між причепами, щоб досягти плавної траєкторії заїзду на паркомісце."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Пам'ятайте: якщо причіп починає зрізати, кут слід відрегулювати ближче до прямого, а якщо заходить занадто широко – навпаки зробити гострішим."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Регулювання, які ви робите тягачем щодо першого причепа, впливають на другий причіп лише наполовину, тож не бійтеся активніше кермувати тягачем."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "На цьому етапі вже слід планувати наступний крок. Перший причіп також потрібно завести на паркомісце, тож поміркуйте, як вирівняти його щодо заднього причепа."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Заїхати з першого разу рідко кому-небудь вдається. В даній ситуації ми занадто довго чекали, перш ніж почати вирівнювати перший причіп, тож другий у нас зійшов із траєкторії. <br><br>Проїдьмо вперед і спробуємо знову."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Не соромтеся активно кермувати, щоб скерувати причепи, куди потрібно. Можете вирівнюватися рухом вперед скільки завгодно разів."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Ну, ось – успішно припаркували подвійний причіп."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Проїдьте вперед до кінця майданчика та розверніться."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Не забувайте, що потрібно повертати широкою дугою."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Продовжуйте рух вперед, доки, на вашу думку, не матимете вдосталь місця, тоді почніть рух назад."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Якщо вам здається, що місця вистачить, заїжджайте на паркомісце заднім ходом."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


