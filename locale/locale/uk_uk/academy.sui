	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "У даній ситуації вам потрібно припаркуватися на місці, розташованому поруч із вами. Простір для маневрування обмежений, тож вам знадобиться трохи постаратися, щоб поставити причіп, куди потрібно."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Їдьте прямо до огородження."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Зупиніться перед огородженням."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Круто поверніть кермо в напрямку водія, перш ніж розпочинати рух. Таким чином в умовах обмеженого простору причіп почне обертання до паркувального місця, щойно ви почнете рух."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Щойно ваш причіп повернуто в бажаному напрямку, розташуйте тягач перед причепом та почніть скеровувати його на паркувальне місце."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Далі маневрування не особливо відрізняється від звичайного паркування."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Продовжуйте рух заднім ходом: слідкуйте за простором з обох сторін та тримайте тягача і причепа рівними щодо паркувального місця."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Зупиніться в позначеній зоні, застосуйте ручне гальмо і вимкніть двигун."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Ви знаходитеся на паркувальному місці, але вам потрібно переїхати на вільне місце праворуч від вас.<br><br><font face=/font/big_bold.font>Приготуйтеся до початку руху.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Попереду – позначена зона.<br><br><font face=/font/big_bold.font>Рухайтеся вперед. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Пам'ятайте, що потрібно негайно повертати кермо, оскільки місця обмаль.<br><br><font face=/font/big_bold.font>Рухайтеся заднім ходом на позначене місце позаду. </font>"


#@}

#+ Book 1 Scenario 3_15
