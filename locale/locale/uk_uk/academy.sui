	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Діагональне паркування може здатися простішим, однак часто такі заїзди викликають більше труднощів, аніж типовий заїзд у провулок."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Рухайтеся заднім ходом до паркувального місця. Поки що тримайте тягач та причіп рівно."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Наближаючись, скеровуйте причіп ближче до припаркованих вантажівок. Це дозволить повернути його на місце, коли ви його досягнете."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Починайте повертати причіп до паркувального місця. Тримайте причіп ближче до вантажівки з вашого – водійського – боку, оскільки вам знадобиться простір з іншої сторони."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Коли причіп увійшов на місце, починайте повертати тягач так, щоб він увійшов за причепом."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Зупиніться в позначеній зоні, застосуйте ручне гальмо і вимкніть двигун."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Припаркуйте вантажівку у просторі позаду вас. Рухаючись заднім ходом, користуйтеся дзеркалами з обох боків.<br><br><font face=/font/big_bold.font>Приготуйтеся до початку руху. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Озирніться та розпочинайте рух до паркувального місця. <br><br><font face=/font/big_bold.font>Починайте рух заднім ходом.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Починайте скеровувати причіп до вантажівок збоку. У відповідний момент поверніть причіп на паркувальне місце. Пам'ятайте про винос хвоста причепа.<br><br><font face=/font/big_bold.font>Поверніть на паркувальне місце. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

