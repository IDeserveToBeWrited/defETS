#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Перед виїздом"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "На першому занятті оглянемо кабіну водія. Важливо, щоб сидіння, кермо та дзеркала були правильно налаштовані, оскільки оглядовість з місця водія – це запорука безпечного водіння, особливо в непередбачуваних ситуаціях.<br><br>Оглянемо процес налаштування кожного з цих елементів по черзі."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Регулювання сидіння та дзеркал"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Перевірка дзеркал і оглядовості"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Вітаємо на вашому першому занятті!<br>Почнемо з підготовки вантажівки до виїзду."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Незамінні принципи водіння – безпека, професіоналізм та постійний контроль.<br>Правильне налаштування положень сидіння, керма та дзеркал допоможуть у їх втіленні."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "З обох сторін вантажівки знаходяться декілька транспортних засобів.<br>Вони допоможуть вам правильно налаштувати дзеркала."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Проведіть налаштування без жодного поспіху та зважаючи на зручність, оскільки вони<br>можуть мати вирішальний вплив на вашу здатність керувати вантажівкою."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Регулювання сидіння та керма"

	key[]: "adj_tut_title_1"
	val[]: "Налаштування основних дзеркал"

	key[]: "adj_tut_title_2"
	val[]: "Налаштування сферичних дзеркал"

	key[]: "adj_tut_title_3"
	val[]: "Оглядовість та налаштування дзеркал"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "натисніть @@imv_nrm_adjuster@@ або відкрийте налаштування автомобіля в меню паузи"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "відкрийте налаштування автомобіля в меню паузи"

	key[]: "adj_tut_open_adj"
	val[]: "Щоб показати '@@adjust_link_t@@' під час гри, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Спершу налаштуймо сидіння водія та кермо.<br><br><font face=/font/big_bold.font>Відкрийте '@@adj_seats@@', щоб продовжити.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Відкрийте @@adj_mirrors@@, щоб налаштувати дзеркала.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Сідаючи за кермо вантажівки вперше, потрібно спершу налаштувати положення сидіння, керма та дзеркал.<br><br>Правильна позиція за кермом – це обов'язковий елемент належної оглядовості. Всі прилади повинні бути в межах доступності, а водій має мати змогу візуально контролювати ситуацію попереду, з боків та у дзеркалах. <br><br><font face=/font/big_bold.font>Щоб перейти до налаштувань, $OPEN_ADJUSTER$.</font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Налаштуйте сидіння таким чином, щоб вам було видно простір довкола та дзеркала і щоб прилади були в зоні досяжності.<br><br>Налаштуйте кермо в зручне положення, в якому воно не закриває огляд панелі приладів.<br><br><font face=/font/big_bold.font>Закінчивши налаштування, натисніть @@imv_nrm_back@@, щоб повернутися в попереднє меню. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>У вантажівок є суттєві сліпі зони, тому на них встановлено декілька дзеркал огляду, щоб це компенсувати.<br><br>Правильно налаштовані дзеркала дозволять точно та ефективно оцінювати простір довкола під час руху.<br><br><font face=/font/big_bold.font>Відкрийте '@@adj_mirrors@@', щоб продовжити.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Головні дзеркала захоплюють простір вздовж вантажівки та причепа.<br><br>Щоб налаштувати їх у правильне положення, зверніть увагу на автомобілі з обох сторін вашої вантажівки.<br><br><font face=/font/big_bold.font>Натисніть @@imv_nrm_selectfcs@@, щоб продовжити.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Головні дзеркала – це основний засіб огляду простору зі сторін та позаду. Для безпечного маневрування та оцінки положення вантажівки, важливо, щоб ви бачили як автомобіль поруч, так і незначну частину причепа."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Налаштувавши, переходьте до основного дзеркала зі сторони пасажира."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Знову-таки: важливо, що ви бачили як автомобіль поруч, так і частину причепа."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Коли ви знайдете положення, яке вас влаштовує, переходьте до налаштування сферичного дзеркала з боку водія."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Сферичні дзеркала створюють широке поле огляду, дозволяючи слідкувати за простором довкола.<br><br><font face=/font/big_bold.font>Натисніть @@imv_nrm_selectfcs@@, щоб продовжити.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "В ідеалі ви маєте бачити як обидва транспортні засоби поруч, так і незначну частину вашої вантажівки."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Коли ви знайдете положення, яке вас влаштовує, переходьте до налаштування сферичного дзеркала з боку пасажира."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Знову-таки: важливо, щоб ви бачили як обидва транспортні засоби поруч, так і незначну частину власної вантажівки."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Закінчивши налаштування, натисніть @@imv_nrm_back@@, щоб закрити меню."

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Натисніть @@imv_nrm_back@@, щоб повернутися до меню налаштувань.</font>"

	key[]: "adj_tut_close_adj"
	val[]: "Чудово! З налаштованими сидінням та дзеркалами ви вже майже готові виїжджати на дорогу.<br><br><font face=/font/big_bold.font>Закрийте меню налаштувань, натиснувши @@imv_nrm_back@@.</font>"

	key[]: "adj_tut_open_con"
	val[]: "Роззирніться ще раз, щоб переконатися в тому, що вас влаштовує оглядовість із кабіни. Перевірте, чи положення дзеркал забезпечує вам огляд простору довкола вантажівки.<br><br>Якщо вам щось не подобається, ви можете відрегулювати дзеркала в меню налаштувань '@@adjust_link_t@@'. <br><br><font face=/font/big_bold.font>Натисніть @@imv_nrm_activate@@, щоб закічнити перше заняття.</font> @@aca_goal_tip@@ Щоб показати чи сховати віртуальні дзеркала на екрані, ви можете перейти до налаштувань у меню паузи: '@@adjust_link_t@@' — '@@adj_ui_mirrors@@'. Віртуальні дзеркала особливо спрощують огляд зі сторони пасажира."
#@}

