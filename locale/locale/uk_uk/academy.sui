#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Гальмування з причепом"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "Зараз у вас буде можливість відчути як це – кермувати та гальмувати вантажівкою з приєднаним причепом."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Початок руху"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Рух спуском"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Досягнення швидкості 60 км/год (37 миль/год)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Застосування гальм"
