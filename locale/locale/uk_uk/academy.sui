	val[]: "Рух складними поворотами"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Розглянемо маневрування з причепом на короткому маршруті з перешкодами, який містить складніші повороти."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Перші повороти"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Рух вузьким проїздом"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Вузький поворот на 90 градусів"
