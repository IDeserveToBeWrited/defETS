#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Рух поміж огороджень"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Попереду – різноманітні складні повороти та перешкоди.<br>Якщо ви добре засвоїли раніше вивчене, проблем виникнути не повинно."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Розмітка на дорозі слугує підказкою щодо траєкторії об'їзду перешкод."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Тримайте тягач ближче до зовнішньої частини повороту.<br>Вам потрібно рухатися широко, адже причіп зрізає у поворотах."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Наступний поворот – це простий поворот на 90 градусів. <br>Знову ж: тримайте вантажівку ближче до зовнішньої частини повороту та використовуйте все доступне місце."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Не спішіть. Далі місця стає більше, але все одно потрібно проходити з точністю."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Дотримуйтеся широкої траєкторії руху, об'їжджаючи огородження."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Під'їжджайте до вузької ділянки з обережністю. <br>Зробіть широку дугу тягачем, щоб причіп увійшов безперешкодно."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Останній поворот на 90 градусів – крутіший, ніж перший, але місця цілком достатньо: за умови, що ви використаєте простір ефективно."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Зупиніться в позначеній зоні, тоді застосуйте ручне гальмо і вимкніть двигун."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Пам'ятайте, що розмітка на дорозі допоможе вам орієнтуватися в маршруті.<br><br><font face=/font/big_bold.font>Приготуйтеся до початку руху. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Дзеркала вам допоможуть безперешкодно подолати маршрут. Завжди зважайте на те, яким чином причіп проходить за вами.<br><br><font face=/font/big_bold.font>Проїдьте через перший поворот. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Слідкуйте за причепом, виходячи із повороту, та готуйтеся повертати далі.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Рухайтеся наступним поворотом. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Пам'ятайте перед поворотами перевіряти простір зі сторін причепа, щоб нічого не зачепити.<br><br><font face=/font/big_bold.font>Рухайтеся повз огородження попереду. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Коли причіп промине огородження, круто поверніть у пасажирський бік, щоб вирівнятися для вузького проїзду. <br><br><font face=/font/big_bold.font>Рухайтеся до вузького проїзду.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Ця ділянка вимагає максимально точного водіння. Не спішіть та користуйтеся дзеркалами.<br><br><font face=/font/big_bold.font>Тримайтеся зовнішньої сторони кожного з поворотів. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Цей поворот дуже крутий, але ви маєте змогу використати увесь простір попереду, щоб пройти його з легкістю.<br><br><font face=/font/big_bold.font>Проїдьте останнім поворотом. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Поглиблений маршрут – причіп"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "Останнє завдання третього розділу – це поїздка довшим тренувальним маршрутом із різноманітними поворотами, сконструйованими для перевірки ваших умінь маневрування із причепом."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Поворот із заломом"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "ВИДАЛИТИ ЦІЛЬ"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Переїзд центром"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Перший слалом"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Другий слалом"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Прості повороти"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Круговий рух"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Пряма ділянка"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Вузький поворот"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Останні повороти"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Рух до паркування"
