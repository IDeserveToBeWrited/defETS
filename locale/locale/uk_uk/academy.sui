#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Зупинка перед перешкодою"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "На даному занятті ми розглянемо призначення переднього дзеркала та як ефективно використовувати його, під'їжджаючи до перешкоди спереду."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Подивіться в переднє дзеркало"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Призначення дзеркала"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Зупинка перед перешкодою"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
