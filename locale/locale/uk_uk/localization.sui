	key[]: "cancel_wizard"
	val[]: "Вийти із меню керування пристроями?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "ВИБІР СПОСОБУ КЕРУВАННЯ" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Контролери"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Програма застосує рекомендовані налаштування для підключених пристроїв.<br><color value=@@clr_sel@@>Якщо ви використовуєте геймпад, сумісний зі Steam, ввімкнути підтримку конфігурації можна в меню <br><color value=@@clr_txt_d@@>\"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Найпростіша схема: керування клавіатурою, огляд мишкою. Просто, доступно кожному, але цей спосіб значно програє іншим за точністю."

	key[]: "wiz_control_mouse"
	val[]: "Керування мишею - це краща чутливість і точність. Інші дії контролюються за допомогою клавіатури. Щоб здійснювати огляд мишкою, потрібно одночасно затиснути назначену на керування камерою кнопку чи клавішу."

	key[]: "wiz_control_controller"
	val[]: "Для найреалістичніших відчуттів від гри використовуйте руль, геймпад або джойстик. Клавіатура тим часом може служити для доступу до багатьох функцій гри через назначені 'гарячі' клавіші, а миша - для огляду."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Не знайдено жодного додаткового пристрою."

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Пошук доступних контроллерів..."

#@}

