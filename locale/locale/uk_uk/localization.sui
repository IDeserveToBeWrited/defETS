#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "КЕРУВАННЯ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "BINDINGS" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "ADVANCED SETUP" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "Керування" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "ТИП ВВЕДЕННЯ" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "КОНТРОЛЕР" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "ВІДГУК КОНТРОЛЕРА" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "ВІСІ КОНТРОЛЕРА" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Тільки клавіатура" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Клавіатура" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Керування мишею" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Керування мишею + педалі" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Жоден" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "Швидке налаштування контролера або ігрового керма"

#+ Selection of the controller subtype
#@{

