	val[]: "ЗАГАЛЬНІ НАЛАШТУВАННЯ " #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "ПІДКЛЮЧЕННЯ КОНТЕНТУ " #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "З'єднати " #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks виявив новий контент. З'єднайтеся із World of Trucks, щоб отримати доступ. " #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Онлайн " #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Налаштування функцій, пов'язаних із World of Trucks. " #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Ви справді хочете відкласти реєстрацію?<br><br>Ви зможете отримати доступ до цього меню із робочого столу. " #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "ПІДКЛЮЧЕННЯ КОНТЕНТУ " #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Підключення контенту... " #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Не вдалося підключити: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Профіль Steam, що використовується для реєстрації доповнення, інший, ніж той, з якого реєструвався профіль World of Trucks або сама гра. Змініть профіль Steam. " #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Профіль Steam, який ви використовуєте, щоб зареєструвати доповнення, уже приєднано до іншого профілю World of Trucks. Щоб зареєструвати доповнення, скористайтеся іншим профілем Steam. " #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Токен Steam вичерпано. Спробуйте пізніше. " #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Серійний код активації доповнення недійсний. З'єднайтеся із службою підтримки: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Внутрішня помилка виникла під час реєстрації гри. Спробуйте пізніше, будь ласка. " #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "УСПІХ " #+ Title of the success message box.

	key[]: "info_t"
	val[]: "ІНФОРМАЦІЯ " #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ОНЛАЙН" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "ОГЛЯД КОНТЕНТУ" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Вітаємо! Обрані доповнення успішно приєднано до профілю World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Неможливо приєднати новий вміст, оскільки профіль Steam приєднано до іншого профілю World of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Деякі DLC не з'єднано.<br>Наведіть мишу на знак оклику для деталей.  " #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Реєструється $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Даний профіль не з'єднано із World of Trucks або гра перебуває в режимі офлайн. Відредагуйте профіль, щоб приєднатися." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Натисніть, щоб відхилити"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ доповнень приєднано. Якщо DLC не з'єднано із World of Trucks, вони можуть бути недоступні. " #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Вітаємо!<color value=@@clr_txt@@>Усі об'єкти приєднано до World of Trucks! " #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Неможливо приєднати новий вміст до World of Trucks, тому що WoT використовується інший профіль Steam. " #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "З'єднано" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Не з'єднано" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Неможливо зібрати інформацію про куплений контент. " #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Неможливо зібрати інформацію про приєднаний контент. " #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Неможливо зібрати інформацію про профіль, що використовується. " #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Пізніше " #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Не вдалося зареєструвати DLC. Відсутня постійна ліцензія, можливо, через Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Відсутнє право власності " #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
