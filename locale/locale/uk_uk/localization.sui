	key[]: "custom_settings_applied_t"
	val[]: "ЗАСТОСОВАНО АЛЬТЕРНАТИВНІ НАЛАШТУВАННЯ" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "РОЗШИРЕНІ НАЛАШТУВАННЯ ГРАФІКИ" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Прості/розширені налаштування графіки" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Сховати розширені налаштування" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Показати розширені налаштування" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Масштабування" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Згладжування" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Чіткість освітлення TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Налаштування TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Адаптивна чіткість" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Завжди м'яке" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Завжди різке" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Затінення навколишнього світла (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Високий динамічний діапазон (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Глибина різкості (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Сонячні промені" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Корекція кольору" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Масштаб відображення" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Деталізація відображення" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Деталізація рослинності" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Густота рослинності" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Якість тіней"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Розмір текстур тіні" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Тіні вдалині" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Тіні інтер'єру" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Погодні ефекти"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Якість у дзеркалі" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Розширення у дзеркалі" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Видимість у дзеркалах" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Якість текстур" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Анізотропна фільтрація" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Рельєфне текстурування" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Фари трафіку" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Допоміжні ліхтарі" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Дальність видимості світла" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Пішоходи" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Налаштування екрану змінено.<br>Зберегти зміни?"

	key[]: "reverting_in"
	val[]: "Відміна через" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "секунд" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Увімкнення повноекранного режиму гри."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Налаштування загальної яскравості гри та – для дисплеїв із підтримкою HDR – калібрування HDR."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Налаштування роздільної здатності."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування частоти оновлення екрану."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Синхронізація частоти кадрів із частотою оновлення монітора задля уникнення розривів екрану. В режимі економії частота кадрів зменшується вдвічі, що дозволяє економити енергію."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування максимально дозволеної частоти кадрів.<br><br>Налаштування в 0 означає вимкнення функції обмеження."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування максимально дозволеної частоти кадрів у згорнутому режимі.<br><br>Налаштування в 0 означає вимкнення функції обмеження."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Перемикання між простим режимом налаштування і розширеним, у якому можна налаштувати окремі параметри."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Покращення якості зображення завдяки внутрішній обробці на вищій роздільній здатності, що дозволяє згладити краї та підвищити деталізацію.<br>Наприклад, застосування вищих значень дозволяє знизити розмитість, однак коштом загальної продуктивності системи.<br><br><color value=@@clr_txt_d@@>Використання даної функції має значний вплив на продуктивність."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Вибір методів швидкісного згладжування нерівних країв у грі:<br>-SMAA збирає кожен піксель декілька разів із різних точок (залежно від обраної якості) в кадрі та видає середній результат для остаточного зображення.<br>- TAA бере зразок кожного пікселя один раз, але у різних точках та в різних кадрах.<br>- Для найкращого результату можна обрати комбінацію з обох методів, однак це вплине на загальну продуктивність.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Створення тіней у щілинах та проміжках між близько розташованими об'єктами.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Вибір налаштування згладжування ТАА: <br>-\"Завжди м'яке\" згладжування означає менше мерехтіння та більше розмивання: цей варіант підходить для користувачів комп'ютерів, що використовують високий масштаб або монітор із високим DPI, а також тих, хто грає на телевізорі й сидить далі від екрана.<br>- Варіант \"завжди різке\" підходить для менших екранів (до 1080p), наприклад ноутбуків та пристроїв Steam Deck.<br>- \"Адпативна чіткість\" дозволяє вимикати тремтіння через TAA за статичної камери.<br><br><color value=@@clr_txt_d@@>Дане налаштування можна використовувати лише якщо методом згладжування обрано TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування освітлення TAA (luma sharpening).<br><br><color value=@@clr_txt_d@@>Дане налаштування можна використовувати лише якщо методом згладжування обрано TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення розмиття дальніх елементів на карті для створення ефекту розфокусування."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення ефекту видимих променів світла від сонця, у тому числі крізь об'єкти: дерева, будівлі чи автомобілі."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення динамічного естетичного підлаштування кольорів у грі. Ефект матиме різні наслідки, залежно від пори та погоди, сприятиме насиченості кольорів автомобілів та інших об'єктів і т. п."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Покращення якості відображень шляхом їх внутрішнього рендеринґу на вищій якості та застосування кращого згладжування.<br><br><color value=@@clr_txt_d@@>Зміни в даному налаштуванні буде застосовано лише після ручного перезапуску гри."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування деталізації відображень на поверхнях автомобілів, вікнах та інших поверхнях на кшталт калюж, мокрих доріг та водойм.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність.<br><br>Зміни в даному налаштуванні буде застосовано лише після ручного перезапуску гри."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування деталізації та структури рослин і дерев.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування густоти трави на узбіччі.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування якості тіней від сонця або місяця.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення тіней навіть для об'єктів, що знаходять на великій відстані.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування якості погодних ефектів, наприклад, відображень."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування якості відображення у дзеркалах автомобіля (окремо від інших налаштувань відображень).<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування роздільної здатності зображення у дзеркалах автомобіля."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування відстані видимості об'єктів у дзеркалах.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має помітний вплив на продуктивність."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування якості окремих текстур на об'єктах та поверхнях у грі."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Покращення чіткості текстур, особливо тих, що знаходяться на відстані або спостерігаються під кутом.<br><br><color value=@@clr_txt_d@@>Зміни в даному налаштуванні буде застосовано лише після ручного перезапуску гри."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення геометричної деталізації для тротуарів, доріг та інших об'єктів з метою покращення їхнього вигляду.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність.<br><br>Зміни в даному налаштуванні буде застосовано лише після ручного перезапуску гри."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення освітлення від ліхтарів інших автомобілів трафіку."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення освітлення від додаткових ліхтарів автомобілів трафіку: покажчиків повороту, гальм і т. п."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Налаштування відстані видимості штучних джерел освітлення.<br><br><color value=@@clr_txt_d@@>Дане налаштування зазвичай має незначний вплив на продуктивність."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Увімкнення пішоходів у грі."
