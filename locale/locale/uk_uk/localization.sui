	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Всі віджети залишаються прихованими."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Обидва віртуальні дзеркала будуть приховані."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Всі сповіщення залишаються прихованими, навіть коли вони надходять."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "З'являється вікно з характеристиками поточної вантажівки перед погодженням перевезення важкого вантажу."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування орієнтації карти."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Choose how the World Map is explored:<br>- \"Proximity exploration\" marks a larger area as explored.<br>- \"Precision exploration\" reveals only the areas immediately around the player."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Вибір режиму зображення навігації."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування роботи навігації:<br>- Режим \"Найзручніший\" враховує співвідношення довжини та часу, наявність світлофорів і т. п.<br>- \"Найкоротший\" передбачає найменший за довжиною маршрут.<br>- У режимі \"Місцеві дороги\" система уникає автомагістралей."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Вибір складності паркування:<br>- Ви можете щоразу налаштовувати складність \"вручну\".<br>- Уникнути необхідності рухатися заднім ходом у безпечному режимі.<br>- Або встановити більш вимогливий режим складного паркування."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування ймовірності виникнення на дорозі небезпек, пов'язаних з аварійними ситуаціями, засміченням та ін."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування ймовірності виникнення потреби об'їзду перешкоди іншим маршрутом."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування ймовірності несприятливої погоди."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Вибір включення інформації про часовий пояс до даних годинника."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Enables in-game cutscenes typically displayed after truck purchases or garage upgrades or during passenger loading."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Увімкнення або вимкнення напівпрозорих загороджень на недоступних дорогах."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Інверсія руху миші на осі Y під час керування камерою."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Вибір типу трансмісії:<br>- У спрощеному варіанті перемикання між рухом вперед та назад відбувається за допомогою гальма та акселератора.<br>- Зі стандартною автоматичною трансмісією це перемикання відбувається вручну.<br>- Секвентальна трансмісія дозволяє перемикати передачі у послідовності.<br>- Доступний також режим ручного перемикання за допомогою окремого контролера."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Дана функція дозволяє за необхідності \"перестрибувати\" передачі при перемиканні."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Вмикає автоматичне повертання керма до центрального положення при використанні клавіатури або контролера.<br><br>Без неї вам доведеться вручну центрувати кермо після повороту."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування діапазону анімації керма."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Регулювання інтенсивності гальмування."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування стабільності причепа за допомогою зниження центру тяжіння."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування жорсткості підвіски шасі."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування жорсткості підвіски кабіни."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування інтенсивності процедурного створення нерівностей на дорозі, які імітують недосконалість поверхні.<br><br>Відчутність ефекту також залежить від інших налаштувань підвіски та камери."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Дана функція імітує реалістичне приєднання причепа, яке вимагає більш точного вирівнювання сідла вантажівки щодо зчіпного пристрою причепа.<br><br>При вимкненні також унеможливлюється зіткнення сідла з елементами причепа."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Увімкнення та вибір зображення кабелів причепа.<br><br><color value=@@clr_txt_d@@>Має вплив на продуктивність на старіших системах."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Увімкнення електронного обмеження швидкості у 90 км/год (56 миль/год).<br><br><color value=@@clr_txt_d@@>Завжди вмикається автоматично для замовлень World of Trucks."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Дана функція дозволяє склоочисникам автоматично вмикатися та регулювати швидкість роботи, коли перемикач знаходиться у першому положенні."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Дана функція дозволяє автоматичне використання ретардера під час гальмування."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Автомобіль автоматично утримуватиме гальма на підйомі, полегшуючи рушання."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Дана функція дозволяє автоматичне використання гальма двигуна під час гальмування."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Увімкнення автоматичного запуску двигуна натисканням на педаль газу."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Автоматичне опускання осей залежно від маси транспортного засобу."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Коли увімкнено, автомобіль за замовчуванням застосовуватиме газ помірно. Після подвійного натискання кнопки газу, повний газ буде ввімкнено, допоки натиснута кнопка.<br><br>Дійсно лише для клавіатури."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Симуляція реалістичної витрати повітря при використанні гальм.<br><br>Вам доведеться слідкувати за тиском у гальмівній системі під час подолання спусків чи маневрування із частим застосуванням гальм."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Увімкнена ABS сприяє уникненню блокування коліс під час гальмування."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування ступеня збільшення або зменшення швидкості, яка утримується системою круїз-контролю."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування можливого відступу системи круїз-контролю від заданої швидкості."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "При ввімкненій функції система круїз-контролю здійснюватиме регулювання швидкості для підтримки безпечної дистанції до автомобіля попереду."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Активація системи екстреного гальмування при виявленні перешкоди.<br>Налаштовується реагування як тільки на автомобілі, так і на всі перешкоди."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Дана функція дозволяє ліхтарям автоматично вмикатися в умовах недостатнього освітлення, коли перемикач знаходиться у першому положенні."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Дана функція дозволяє автомобілю автоматично вимикати ліхтарі дальнього світла, коли попереду знаходяться інші учасники руху."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Автоматичне вимикання покажчиків повороту після центрування керма."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Увімкнення анімації руху декоративних об'єктів у кабіні вантажівки."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Увімкнення відхилення камери виду з кабіни при кермуванні."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування залежності повороту камери від обертання керма."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування повороту камери під час руху заднім ходом."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Увімкнення повороту камери виду з кабіни за напрямком увімкненого покажчика повороту."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Увімкнення впливу руху автомобіля на положення камери виду з кабіни."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування залежності переміщення камери від руху автомобіля."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування залежності переміщення камери виду з кабіни від руху автомобіля."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування затримки перед автоматичним поверненням камери в центральне положення.<br><br>Функція застосовується, якщо автомобіль рухається із певною швидкістю: для камер зсередини та ззовні при русі вперед та виду з вікна при русі заднім ходом."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Налаштування швидкості руху камери під час автоматичного центрування та зміни ракурсу вигляду зсередини."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Налаштування способу зближення: шляхом затискання або перемикання кнопкою." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування мови, яка використовується в грі."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування валюти та одиниць виміру, залежно від регіону."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Увімкнення показування назв міст та країн обраною мовою."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Увімкнення показування назв міст та країн як обраною мовою, так і місцевою мовою відповідного регіону."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування валюти."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Вибір між 12-годинним та 24-годинним форматом годинника."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування одиниць відстані."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування одиниць маси."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування одиниць температури."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування одиниць тиску."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування одиниць об'єму."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування одиниць споживання."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Натискання клавіші активації (@@imv_nrm_activate@@) відкриє чат під час сесії Конвою."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Вікно чату залишається активним після надсилання повідомлення."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Повідомлення з чату зникатимуть через кілька секунд."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Налаштування тривалості часу для показування повідомлень із чату."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Імена гравців показуватимуться над їхніми автомобілями у сесії Конвою."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Відкривається розширене меню для налаштування швидких відповідей чату у Конвої."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Перевірка статусу контенту, під'єднаного до World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Дана функція дозволяє показувати новини з Інтернету в головному меню."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Обрані скриншоти від спільноти, опубліковані на ресурсі World of Trucks, будуть використовуватися на екранах завантаження."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Увімкнення справжньої реклами, завантажуваної для показу на ігрових білбордах."
