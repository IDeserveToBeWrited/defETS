#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Продовжити ($KEY$) " #+ Message box button.


	key[]: "intro_1"
	val[]: "Вітаємо у Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Ось вона - мрія. Ви за кермом вантажівки!"

	key[]: "intro_3"
	val[]: "Хоч ви тепер гордий власник транспортного підприємства, на жаль, із фінансами у вас скрутно і купити вантажівку ніяк не вийде. Тож поки що пошукайте роботи в інших компаній."

	key[]: "intro_4"
	val[]: "Вам лише потрібно довезти $JOB_CARGO$ для $JOB_TARGET_COMPANY$ у місто $JOB_TARGET_CITY$. Роботодавець забезпечить вас транспортом і покриє усі витрати з власної кишені. І не забудьте слідкувати за часом."


	key[]: "intro_garage_1"
	val[]: "Це ваш штаб."

	key[]: "intro_garage_2"
	val[]: "Зовсім непримітний гараж, але для початку - те, що треба."

	key[]: "intro_garage_3"
	val[]: "На жаль, поки що у вас немає що паркувати у гаражі. Та скоро ваш бізнес піде вгору і ви, напевно, лише згадуватиме ці скрутні часи!"

	key[]: "intro_garage_4"
	val[]: "Щойно ви зберете достатньо грошей на власну вантажівку, зможете їздити куди завгодно і вести свої справи. "

	key[]: "intro_garage_5"
	val[]: "Удачі!"


	key[]: "desktop_tut_t"
	val[]: "ФУНКЦІЮ РОЗБЛОКОВАНО"

	key[]: "desktop_tut_job"
	val[]: "Оберіть наступне завдання"

	key[]: "desktop_tut_cargo_market"
	val[]: "Використовуйте свій новий причіп на ринку вантажів для перевезень широкого асортименту вантажу." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Тут ви можете побачити свої досягнення."

	key[]: "desktop_tut_company"
	val[]: "Тут ви можете слідкувати за ходом справ у гаражах, наймати водіїв й керувати компанією загалом."

	key[]: "desktop_tut_trailers"
	val[]: "Відтепер ви можете купувати причепи, встановлювати на них аксесуари та фарбувати їх.<br><br>Ваші причепи можуть зберігатися в обраному вами гаражі та можуть використовуватися вашими водіями для роботи і збільшення ваших прибутків. Щоб керувати своїми причепами, використовуйте меню управління причепами."

	key[]: "desktop_tut_visit_directive"
	val[]: "Відкрийте $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "ВІТАННЯ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Вітаємо на новому домашньому екрані<br>Звідси ви можете керувати всіма функціями гри."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Головне меню знизу надає доступ до всіх звичних основних функцій гри."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Згори знаходиться нова панель статусу, яка містить правила дорожнього руху країни перебування та статистичні дані."

	key[]: "desktop_tut_tour_home"
	val[]: "Кнопка 'Додому' поверне вас на домашній екран."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Швидке меню забезпечує доступ до всіх функцій гри з будь-якого іншого меню."

	key[]: "desktop_tut_tour_drive"
	val[]: "Оновлена кнопка 'За кермо' так само переносить вас у кабіну вантажівки."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "ОЗНАЙОМЛЕННЯ ЗАВЕРШЕНО"

	key[]: "desktop_tut_tour_finish"
	val[]: "Дякуємо, що ознайомилися з оновленням домашнього екрана."
