	key[]: "ax_mode_inv"
	val[]: "Інверсія" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "ax_mode_cent"
	val[]: "Центрування" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "ax_mode_inv_cent"
	val[]: "Інверсія + центрування" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}


