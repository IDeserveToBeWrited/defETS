#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Мережа недоступна. Будь ласка, переконайтеся, що клієнт налаштований правильно."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Не вдалося підключитися до онлайн-сервісу. Перевірте підключення до інтернету."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Помилка з'єднання з сервером. Будь ласка, спробуйте пізніше."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Онлайн-сервер повернув невірні дані. Якщо Ви використовуєте з'єднання через HTTP проксі - перевірте конфігурацію проксі-сервера. Або спробуйте з'єднатися пізніше."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Онлайн-сервер повернув невірні дані. Спробуйте з'єднатися пізніше."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Сервіс не сумісний з поточною версією гри. Будь ласка, перевірте доступність нових патчів для гри."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Даний сервіс недоступний. Будь ласка, спробуйте з'єднатися пізніше."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Сервіс вимкнено для обслуговування або через перевантаження. Спробуйте з'єднатися пізніше."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Помилка у інформації для аутентифікації. Спробуйте ввійти знову."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Онлайн-профіль тимчасово заблоковано через велику кількість невдалих спроб авторизації. Спробуйте знову через півгодини."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Роботу онлайн-профілю припинено через підозрілу активність. Спробуйте ввійти через 24 години."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Гру не зареєстровано на даний онлайн-профіль."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Профіль не активовано. Перевірте вашу поштову скриньку."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Роботу онлайн-профілю припинено. З'єднайтеся із технічною підтримкою."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Профіль забанено. З'єднайтеся із технічною підтримкою."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Аутентифікація проксі не підтримується грою. Будь ласка, спробуйте використати інший проксі (або пряме з'єднання)."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Об'єкт наразі недоступний. Спробуйте через кілька хвилин."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Помилка SSL. Неможливо встановити безпечне з'єднання."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Гру було зупинено під час онлайн-обміну даних. Будь ласка, спробуйте пізніше."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Внутрішня помилка. Більш детальна інформація може міститися у файлі net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "У Euro Truck Simulator 2 проблеми із графічними пристроями на вашому комп'ютері (не знайдено пристроїв).\nПропонуємо:\n\n1. Перевірити відповідність вашого комп'ютера та відеокарти зокрема мінімальним системним вимогам.\n2. Оновити DirectX.\n3. Встановити найновіші драйвери для вашої відеокарти із веб-сайту її виробника.\n4. Змінити метод рендерингу із OpenGL на DirectX чи навпаки.\n5. Видалити файл конфігурації 'config.cfg' із папки 'Euro Truck Simulator 2' у ваших Документах. Його буде автоматично створено заново."

	key[]: "sys_no_graphics_simple"
	val[]: "У Euro Truck Simulator 2 проблеми із графічними пристроями на вашому комп'ютері (не знайдено пристроїв). "
#@}

