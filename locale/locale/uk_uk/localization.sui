	key[]: "eye_autocenter"
	val[]: "Увімкнути автоматичне центрування" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Режим відстеження голови" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Безпосередньо" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Динамічно" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Чуйність відстеження погляду" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Чуйність відстеження голови" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Відстежувати нахил" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Відстежувати позицію" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Множник повороту (у кабіні)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Множник нахилу (в кабіні)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Множник повороту (в режимі ходьби)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Множник нахилу (в режимі ходьби)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Максимальний кут погляду" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Швидкість відстеження погляду"

	key[]: "eye_gaze_exponent"
	val[]: "Експонента відстеження погляду"

