#+ Screenshot manager
#@{
	key[]: "screenshot_man"
	val[]: "МЕНЕДЖЕР СКРІНШОТІВ" #+ window title

	key[]: "screenshot_preview"
	val[]: "ПРЕВ'Ю" #+ window title

	key[]: "screenshot_man_link"
	val[]: "Скріншоти" #+ link button title

	key[]: "screenshotman_help"
	val[]: "Дозволяє завантажувати скріншоти на портал World of Trucks."

	key[]: "screenshotman_desc"
	val[]: "Щоб зробити знімок, перейдіть в режим фотозйомки, або натисніть кнопку @@ imv_nrm_screenshot @@ під час гри. Ви можете завантажити зображення на портал World of Trucks.<br>Для цього виберіть знімок і місце в онлайн-галереї, потім натисніть кнопку '<color value = @@ clr_sel @@>Завантажити знімок<color value = @@ clr_txt @@> '." #+ description

	key[]: "screenshotman_slot"
	val[]: "Слоти галереї знімків World of Trucks." #+ Slots title

	key[]: "screenshotman_empty"
	val[]: "Тут будуть відображені зроблені вами скріншоти." #+ Empty screenshot position

	key[]: "screenshotman_offline"
	val[]: "ПРОФІЛЬ НЕ ПІДКЛЮЧЕНИЙ!<br><br>Щоб завантажити зображення, потрібно, щоб профіль був з'єднаний з онлайн-профілем.<br><br>Перейти до редагування профілю?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Вільний слот" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Помилка" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Завантажити" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Використовувати як вантажівку профілю" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Do you want to permanently delete the following screenshot?"

	key[]: "upload_screenshot"
	val[]: "Ви бажаєте завантажити світлину у вибраний слот?<br><br>Його попередній вміст буде видалено!"

	key[]: "upload_profile_screenshot"
	val[]: "Ви бажаєте встановити світлину як вашу вантажівку профілю у World of Trucks?<br><br>Попереднє зображення буде видалено!"

	key[]: "wotr_upload_title"
	val[]: "ПОВІДОМЛЕННЯ ЩОДО ЗАВАНТАЖЕННЯ"

	key[]: "new_screenshot"
	val[]: "Доступні світлини для завантаження!" #+ New screenshot notification

	key[]: "uploading_screenshot"
