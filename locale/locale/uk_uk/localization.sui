	key[]: "vsync"
	val[]: "Вертикальна синхронізація" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Економічність (знижене споживання електроенергії)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
