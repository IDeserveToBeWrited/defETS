	key[]: "api_classical_controller"
	val[]: "Звичайний контролер"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Геймпади на кшталт @@controller_ps5@@, @@controller_xbox_one@@ або @@controller_steam_deck@@, які використовують інтерфейс Steam Input та прості налаштування введення.<br><br>Повна підтримка конфігурування назначених клавіш у грі."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Геймпади, які використовують інтерфейс Steam Input та налаштовані через клієнт Steam.<br><br>Обмежена підтримка підказок та неможливість конфігурування назначених клавіш у грі."

	key[]: "wiz_api_classical"
	val[]: "Контролер, руль або джойстик, підключений через DirectInput, XInput або схожий інтерфейс."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "ВИБІР ТИПУ КОНТРОЛЕРА"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Рульове колесо"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Геймпад або джойстик"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Ваш контролер - рульове колесо або ж нагадує його за суттю. Позиція контроллера відповідає позиції рульового колеса в грі."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Ваш контроллер - це геймпад або джойстик. Зміна позиції контроллера змінює швидкість обертання керма у грі."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "ВИБІР ТИПУ КОРОБКИ ПЕРЕДАЧ" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ця функція потребує підключеного рульового колеса, геймпаду або джойстику."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Пристроїв, потрібних для використання цієї функції не знайдено. Функцію може бути обмежено або відключено."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "НАШАТУВАННЯ H-SHIFTER"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Коробка передач із одним дільником, який ділить передачі в два ряди. Перший - передачі з 1 до 6, другий - із 7 до 12. За допомогою дільника відбувається перехід із одного ряду в інший, а важелем вмикається конкретна передача."

	key[]: "wiz_hs_splitter"
	val[]: "Коробка передач із демультиплікатором - альтернатива варіанту із дільником. Вона також має два ряди передач. Перший містить непарні передачі (1, 3, 5 ...), другий парні (2, 4, 6 ...). Перемикач дільника дозволяє обрати ряд, а важіль - передачу."

	key[]: "wiz_hs_range_splitter"
	val[]: "Коробка передач із дільником - це симуляція реальної коробки передач. На кожне положення важеля припадає чотири передачі, для перемикання застосовуються два перемикача. (Рекомендовано лише досвідченим водіям). "
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Гру налаштовано із використанням стандартних налаштувань, відображених знизу. Ви можете змінити їх, перейшовши в меню розширених налаштувань або ж одразу перейти до гри."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Розширені налаштування"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "The game is now configured and you can continue. You can change the configuration later in Options."

	key[]: "wiz_cfg_steam"
	val[]: "Перевірити та налаштувати кнопки й осі цього контролера можна за допомогою клієнта Steam. Налаштування контролера знаходяться у меню Steam > Бібліотека > Euro Truck Simulator 2 > Налаштування контролера."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Відкрити налаштування контролера"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Для керування вантажівкою використовуйте @@imm_wiz_dsteerleft@@ та @@imm_wiz_dsteerright@@."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Зробіть рух мишкою вліво або вправо, залежно від того, в яку сторону хочете повернути кермо."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Використовуйте @@ima_wiz_j_steer@@ для керування."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Щоб прискоритися, використовуйте @@imm_wiz_dforward@@, а @@imm_wiz_dbackward@@, щоб їхати назад."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Перемістіть важіль @@ima_wiz_j_throttle@@ уперед, щоб рухатися вперед, і назад - щоб увімкнути задню передачу."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Використовуйте @@ima_wiz_j_throttle@@, щоб рухатися вперед, і @@ima_wiz_j_brake@@, щоб рухатися назад."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Щоб прискоритися, використовуйте @@imm_wiz_dforward@@, а @@imm_wiz_dbackward@@, щоб гальмувати."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Перемістіть важіль @@ima_wiz_j_throttle@@ уперед, щоб прискоритися, і назад - щоб гальмувати."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Використовуйте @@ima_wiz_j_throttle@@, щоб прискоритися, і @@ima_wiz_j_brake@@, щоб гальмувати. "


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Використовуйте @@imv_wiz_gearup@@, щоб перемикатися вгору, і @@imv_wiz_geardown@@ - вниз."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Використовуйте @@imv_wiz_gearup@@, аби перемикати передачу вгору, і @@imv_wiz_geardown@@ - вниз, якщо користуєтеся клавіатурою чи контролером. Використовуйте @@imv_wiz_drive@@ і @@imv_wiz_reverse@@, якщо користуєтеся H-shifter."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Здійснюйте перемикання передач за допомогою @@imv_wiz_gearup@@ і @@imv_wiz_geardown@@."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Використовуйте ваш H-shifter разом із @@ima_wiz_j_clutch@@, щоб змінити передачу."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "НАЛАШТУВАННЯ ОСЕЙ КОНТРОЛЕРА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Візуалізація осей"

	key[]: "wiz_setup_axes_desc"
	val[]: "Ви можете візуально оцінити функціональність обраних осей керування. Використовуючи контролер, слідкуйте за рухом шкали. Ви можете оцінити межі та напрями руху, центр осі та загальну поведінку кожної із запрограмованих осей."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Налаштування осі"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Щоб обрати вісь та перейти в режим введення, натисніть кнопку поруч з її назвою. Після цього прив'яжіть обрану вісь, здійснюючи рух важелем, кермом або педаллю."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Мертві зони"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Мертва зона осі - це проміжок, спеціально налаштований не сприймати введення. Налаштувати мертву зону можна за допомогою відповідного повзунка. Щоб збільшити мертву зону, зсуньте повзунок вправо. Ця опція стане в пригоді, якщо через зношеність вашого контролера його положення зчитується з помилками."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Режими осей"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Режим осі визначає її поведінку в грі. Інверсія змінює напрям осі: наприклад, поворот руля-джойстика вліво означатиме, що кермо в грі повернеться вправо. В осі, до якої застосовано центрування, нульова точка знаходиться посередині: наприклад, у джойстику. Спробуйте застосувати дані налаштування, коли вісь пристрою визначається неправильно чи із помилками."

	key[]: "normal"
	val[]: "Нормально" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Інверсія" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Центрування" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Інверсія і центрування" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "НАЛАШТУВАННЯ АВТОМАТИЧНОЇ КОРОБКИ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Використовуючи автоматичну коробку передач, ви повинні лише обрати один із трьох режимів: вперед, назад або нейтральну передачу. Знизу подані клавіші та кнопки, на які назначені дані функції. Щоб змінити налаштування, виберіть функцію і натисніть клавішу чи кнопку контроллера."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Якщо у вас є пристрій типу H-shifter, приєднаний до комп'ютера, ви можете використовувати його як важіль автоматичної коробки передач. Ввімкнувши цю опцію, ви можете назначити позиції важеля як режими D і R. Будь-яке інше положення важеля буде вважатися нейтральним, що відповідає положенню N на важелі автоматичної коробки передач. Ці налаштування не будуть діяти для будь-яких інших клавіш на клавіатурі чи кнопок на контроллері. Щоб переназначити функцію переведіть важіль у обране положення, а потім назад у нейтральне."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "НАЛАШТУВАННЯ СЕКВЕНТАЛЬНОЇ КОРОБКИ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Секвантальна коробка передач забезпечує послідовне перемкнення усіх передач. Подані клавіші та кнопки використовуються для зміни передач за згаданою схемою. Щоб змінити налаштування, натисніть на відповідну кнопку і назначте функцію на іншу клавішу.  "
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "НАЛАШТУВАННЯ КОРОБКИ З H-SHIFTER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Тут ви можете обрати схему переключення передач і випробувати її. На зображенні ви побачите поточне положення важеля й обрану вами передачу. Якщо у коробці більше передач, ніж положень важеля, вам доведеться скористатися перемикачами дільника чи демультиплікатора. "

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Застосовані позиції важеля коробки передач та активні дільники відображені знизу. Щоб змінити назначені налаштування, натисніть на відповідну кнопку й перемістіть важіль спочатку у положення, котре ви хочете застосувати для даної функції, а потім назад у нейтральне."
#@}

