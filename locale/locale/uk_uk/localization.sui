	val[]: "Зберегти поточний прогрес у грі."  #+ Help message associated with save game icon.

	key[]: "new_save_game"
	val[]: "- Нова збережена гра -" #+ Name of save slot which create a new save file.

	key[]: "noname_save_game"
	val[]: "Без назви" #+ Name used instead as the name of the save file if no name was provided by player. For example "Unamed save 1"

	key[]: "overwrite_save"
	val[]: "Ви впевнені, що хочете перезаписати старе збереження?"

	key[]: "save_delete"
