	key[]: "fps_limit"
	val[]: "Обмеження FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Обмеження FPS у фоновому режимі" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
