	key[]: "display_environment_t"
	val[]: "ОТОЧЕННЯ" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Повноекранний режим" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Яскравість / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Налаштування" #+ Text on the brightness button itself.

	key[]: "resolution"
