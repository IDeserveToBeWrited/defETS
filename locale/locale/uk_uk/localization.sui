	key[]: "eye_head_end_point"
	val[]: "Точка кінця відстеження голови"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Увімкнення розширеного вигляду, що розширює поле зору через використання відстежування рухів голови або очей для керування камерою."

	key[]: "eye_preset_op_tooltip"
	val[]: "Вибір пресетів (попередніх налаштувань) розширеного вигляду."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Вибір режимів відстежування рухів голови: <br>-У режимі \"Безпосередньо\" обертання вашої голови відповідає обертанню камери в грі. Даний режим рекомендується за звичайного використання виду зсередини.<br>- У режимі \"Динамічно\" ваш погляд буде впливати на рух камери лише за умови, що повертається голова. Даний режим рекомендується, коли важливо, щоб погляд був точно відцентрований."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Коли увімкнено, камера в грі постійно відцентровуватиметься після зміни природного положення голови під час гри."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Коли увімкнено, положення камери в грі залежить від положення голови."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Коли увімкнено, нахил ігрової камери відповідатиме нахилу вашої голови."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Збільшує поєднане обертання голови та погляду у горизонтальному напрямі (кабіна)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Збільшує поєднане обертання голови та погляду у вертикальному напрямі (кабіна)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Збільшує поєднане обертання голови та погляду у горизонтальному напрямі (пішки)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Збільшує поєднане обертання голови та погляду у вертикальному напрямі (пішки)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Налаштування швидкості реагування ігрової камери на рухи ваших очей."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Налаштування плавності збільшення швидкості."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Налаштування відстані від центру екрану, на якій прискорення почне вирівнюватися."

	key[]: "eye_gaze_start_point_op_tooltip"
