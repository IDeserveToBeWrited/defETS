#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Скріншот занадто великий. Спробуйте зменшити роздільну здатність монітору." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Файл скріншоту пошкоджено чи формат не підтримується." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Розширення скріншоту занадто велике. Зменшіть роздільну здатність монітору." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Відмовлено у завантаженні скріншоту." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Із цього профілю неможливо завантажити скріншот." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Відбувалося одночасне завантаження на одне місце." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Завантаженя наразі відімкнено. Будь ласка, спробуйте пізніше." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "При завантаженні сталася невідома помилка. Будь ласка, спробуйте пізніше." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Розмір скріншота перевищував максимально можливий розмір - $LIMIT$ - і був зменшений." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Розмір скріншота перевищував максимально можливий - $LIMIT$KB - і був зменшений." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "АКТИВНІ МОДИФІКАЦІЇ" #+ Mod selection title

	key[]: "missing_deps"
	val[]: "Збережена гра, яку ви намагаєтеся завантажити використовує додатки, які наразі недоступні. Відсутні такі пакети контенту:"

	key[]: "missing_deps_cont"
	val[]: "Ви справді хочете продовжити?<br>Гра може перестати нормально працювати." #+ missing mods warning

	key[]: "missing_deps_rdlc_cont"
	val[]: "Все одно продовжити?<br>Деякі можливості можуть стати недоступними." #+ missing dlc warning if the save depends only on functionality from removable DLCs (e.g. paintjob)

	key[]: "add_all"
	val[]: "Увімкнути всі" #+ Button used to add all mods to active mod list

	key[]: "remove_all"
	val[]: "Відключити всі" #+ Button used to remove all mods from active mod list

