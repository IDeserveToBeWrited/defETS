	val[]: "For every <color value=@@clr_sel@@>$DRIVE_TIME$</color> hours of driving, you must take a mandatory break for at least <color value=@@clr_sel@@>$BREAK_TIME$</color> hours to avoid getting fined."
	

	key[]: "time_skip_tooltip_job_on_time"
	val[]: "After the rest and the estimated drive time to the destination, you will have <color value=@@clr_sel@@>$LEFT_TIME$</color> remaining on the job."
	
	key[]: "time_skip_tooltip_job_late"
	val[]: "After the rest and the estimated drive time to the destination, the delivery will be late by <color value=@@clr_red@@>$LEFT_TIME$</color>."

	key[]: "time_skip_max_sleep_reached"
	val[]: "<color value=@@clr_red@@>You will be fully rested</color>"

# shown in job detail widget and pause screen	
	key[]: "job_eta"
	val[]: "Estimated Arrival"

	key[]: "job_delay"
	val[]: "Delay"

# mandatory break needed window shown when changing vehicle mode
	key[]: "time_skip_mandatory_break_t"
	val[]: "MANDATORY REST NEEDED"

	key[]: "time_skip_mandatory_break_needed"
