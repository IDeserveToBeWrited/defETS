#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "ВИБІР РЕЖИМУ РОБОТИ STEAM INPUT" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "До вашої уваги новий <color value=@@clr_sel@@>режим введення<color value=@@clr_txt@@>, який пропонує повну підтримку комбінацій назначених клавіш та кращі підказки. Рекомендуємо використовувати саме цей режим.<br><br>Використовуйте <color value=@@clr_sel@@>введення клієнта Steam<color value=@@clr_txt@@>, якщо ви налаштували свій геймпад через клієнт Steam.<br><br>Ви завжди можете змінити режим у налаштуваннях пристроїв." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Залишити введення Steam" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Відкрити керування пристроями" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Режим введення Steam Input" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Налаштування введення в грі" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Налаштування клієнта Steam" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Вибір режиму роботи геймпадів на кшталт @@controller_ps5@@, @@controller_xbox_one@@ або @@controller_steam_deck@@, які використовують інтерфейс Steam Input: <br>- \"Налаштування клієнта Steam\" – використання налаштувань введення, призначених через клієнт Steam. Обмежене використання підказок та відсутність можливості конфігурування назначення клавіш.<br>- \"Налаштування введення в грі\" – використання універсального налаштування. Підтримка конфігурування назначених клавіш та краще підказки. Рекомендуємо використовувати саме цей режим та перейти до керування пристроями для налаштування."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Steam Контролер"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Steam Input Контролер"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Синхронізація з Steam Сloud:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Ви використовуєте не найновішу версію гри.<br>Steam проведе оновлення автоматично, якщо дану функцію не було відключено."
#@}

	key[]: "steam_demo"
	val[]: "Якщо Вам сподобалася демонстраційна версія Euro Truck Simulator 2, будь ласка, придбайте повну гру на <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 втратив доступ до клієнта Steam. Спробуйте:\n\n1. Перевірити, чи клієнт Steam запущено.\n2. Перевірити, чи клієнт Steam оновлено до останньої версії.\n3. Перевірити, чи увімкнено автоматичне оновлення та чи оновлено гру до найновішої версії."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Частина встановленого додаткового контенту не сумісна із даною версією гри, а тому буде відключена. Перевірте цілісність ігрового кешу Steam.<br><br>Не доступні такі елементи:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Неможливо створити профіль Steam з таким ім'ям, оскільки профіль Steam з даним ім'ям вже існує." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Неможливо перенести профіль, профіль із такою назвою вже існує." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Не вдалося перенести профіль." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Синхронізація з Steam-хмарою" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "У вашому Steam Cloud достатньо місця для збережених ігор." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Закінчується вільне місце в Steam Cloud!<color value=@@clr_txt@@><br><br>Будь ласка, видаліть частину файлів збережених ігор, щоб продовжити. Інформація до ознайомлення:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Нестача місця: <color value=@@clr_red@@>$BYTES$ МБ<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Перевищено ліміт файлів на <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Використано місця в Steam Cloud: <color value=@@clr_sel@@>$BYTES$ МБ<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Файлів у Steam Cloud: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "Обрана збережна гра <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> становить <color value=@@clr_sel@@>$BYTES$ МБ<color value=@@clr_txt@@> у <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> файлах." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Ви вичерпали місце на Steam Cloud. Будь ласка, видаліть частину файлів, щоб продовжити.<br><br>Запрошуємо ознайомитися з деталями на панелі праворуч." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Після зміни типу профілю на локальний, профіль буде доступний тільки на цьому комп'ютері незалежно від акаунта Steam. " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Не вдалося здійснити перенесення профілю. Дані не було переміщено, а оригінальний профіль залишено незміненим. Будь ласка, спробуйте ще раз." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

