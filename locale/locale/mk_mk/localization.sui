#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Мрежниот слој не е достапен.Ве молиме проверете дали Конфигурацијата на клиентот е добра."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Не е можно да се воспостави врска со интернет.Ве молиме проверете дали вашата интернет конекција работи."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Грешка за време на комуникацијата со онлајн сервисот..Пробај повторно подоцна."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Вратени се неточни податоци од online сервисот. Ако користите HTTP proxy,проверете ја нејзината конфигурација.Во спротивно пробајте подоцна."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Неточни повратни податоци од online сервисот..Ве молиме пробајте подоцна."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Сервисот не е компатибилен со сегашната верзија од играта.Ве молиме проверете дали некој patch за играта е достапен."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Сервисот во моментов е недостапен.Вратете се подоцна."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Сервисот моментално затворен поради одржување или е преоптоварен.Дојдете подоцна."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Информација за Аутентификација не е исправна.Ве молиме повторно да пробате да се пријавите."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Мрежниот налог е моментално заклучен поради многу неуспешни пробувања за пристап.Ве молиме пробајте повторно за половина час."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Мрежниот налог е моментално заклучен поради сомнителни пристапи.Ве молиме пробајте повторно во наредните 24 часа."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Оваа игра не е регистрирана на овој мрежен налог."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Овој налог не е активиран.Ве молиме проверете ја вашата пошта за информациите за активација."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Овој налог е суспендиран.Ве молиме контактирајте ја техничката подршка."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Овој мрежен налог е избришан.Ве молиме контактирајте ја техничката подршка."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy аутентификацијата не е подржана од оваа игра.Ве молиме користете друг вид на proxy или дирекна конекција."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Потребниот објект е недостапен.Ве молиме пробајте повторно за неколку минути."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL error. Unable to establish a secure connection."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Внатрешна грешка. net.log датотека може да содржи повеќе информации."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 има проблеми да ја нацрта графиката на вашиот компјутер (не е пронајден графички уред).\nПредложени чекори:\n\n1. Провери дали твојот компјутер ги поседува минималните хардвески побарувања.\n2.Ажурирај го твојот компјутер до последната верзија на Microsoft's DirectX.\n3. Преземи и инсталирај го последниот драјвер за твојата видео картичка од произведувачки Веб сајт.Пробај да го смените методот од OpenGL во DirectX или обратно.Избришете ја датотеката 'config.cfg' во твоите 'Documents' - 'Euro Truck Simulator 2' датотека.Можеби е оштетен.Оваа датотека ке биде автоматски создадена со ипсравни почетни вредности при следното стартување на играта."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 има проблем да ја подготви графиката на твојот компјутер (пронајден е невалиден уред)"
#@}

#+ Input wizard
