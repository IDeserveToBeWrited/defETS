#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "КОНТРОЛИ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "BINDINGS" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "ADVANCED SETUP" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "Контроли" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "INPUT TYPE" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "CONTROLLER" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "CONTROLLER FEEDBACK" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "CONTROLLER AXES" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Само тастатура" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Тастатура" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Управување со маусот" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Управување со маус вклучувајќи и педали" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Нема" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "Quick setup of the gamepad or steering wheel"

#+ Selection of the controller subtype
#@{

	key[]: "controller_subtype"
	val[]: "подтип на контролерот" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "Тркало" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
	val[]: "Гејмпад,Џојстик" #+ Gamepad like device. Value of the input controls speed of turning of the vehicle wheels.
#@}


	key[]: "steer_sens"
	val[]: "Осетливост при вртење"

	key[]: "steer_nonlin"
	val[]: "Нелинеарно вртење"

#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "'Force feedback'" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "Reset to defaults" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Overall gain" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
