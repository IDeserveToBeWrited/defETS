#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "SETUP CONTROLLER AXES" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualization of Axes"

	key[]: "wiz_setup_axes_desc"
	val[]: "You can try the function of all selected axes visually. Use the controller and watch the moving bars. It will tell you the limits, centring, orientation and overall behavior of each used axis."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Axis Setup"

	key[]: "wiz_setup_axes_desc2"
	val[]: "To choose an axis, click on the button next to the axis name. This will switch you into input mode. Then, use your controller to bind the selected axis by moving the stick, wheel, or pedal to your chosen axis."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Deadzones"

	key[]: "wiz_setup_axes_desc3"
	val[]: "The deadzone refers to an axis area intentionally designed to provide no input. To adjust the deadzone of a chosen axis, move the corresponding slider. Increasing the slider to the right will enlarge the deadzone. This feature is particularly beneficial for older controllers, as defining a larger deadzone can mitigate issues such as inaccuracy or false input caused by hardware wear."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Axis Modes"

	key[]: "wiz_setup_axes_desc4"
	val[]: "The axis mode determines how it is handled in the game. Inverted axis flips its reported direction, resulting in steering left instead of right, for example. A centred axis has its default position in the middle of its range, such as in a joystick. This mode is useful for correcting an axis that has been detected incorrectly."

	key[]: "normal"
	val[]: "Нормално" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Превртен" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Центрирано" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Превртен и Центриран" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATIC GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Со автоматскиот менувач ти треба да бирате само меѓу напред назад и лер.Тоа ќе го постигнете со користење на следните копчиња и дугмиња.За да ги смените опциите,кликнете на дугмето или притиснете  го копчето,или притиснете дугме од контролерот.кое го сакате за акција."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ако имаш конектирано Х-менувачот,ти можеш да го користиш за да симулирате вистински автоматски менувач на брзини.Овозможи ја оваа опција и доделете ја позицијата на H-менувачот за возење нанапред и наназад.Сите други позиции на H-менувачот се сметаат како лер.Овие опции се создадени за H-менувачот,така што нема да работи со обочните копчиња ниту со дугмињата на контролерите.Да ја смените оваа функција,кликни на копчето и потоа помести го менувачот во посакуваната позиција и потоа вратете во позицина лер."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEQUENTIAL GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Секвенцијалниот менувач на брзини помеѓу сите преди брзини,лер и наназад.Тука се копчињата и дугмињата на контролерот потребни за промена на брзината нагоре и надоле по споменат ред.Да го промениш распоредот притисни го копчето или дугмето на контролерот,кој го сакате."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-SHIFTER GEARBOX SETUP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Тука ти можеш да го одбереш распоредот на H-менувачот и да ја испробаш функцијата. На сликата можеш да ја видиш моменталната позиција наменувачот во зависност која брзина е селектирана. Бидејќи менувачот има повеќе позиции отколку што се прикажани,мора да користите копче за префрлување на различен вид на брзина."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Моментално избран позиција на менувачот и активните менувања се прикажани подоле,до доделените контроли.За да ја смениш доделената контрола,кликни на соодветното копче а после тоа стави го менувачот во посакуваната положба а потоа повторно назад во неутрално."
#@}

