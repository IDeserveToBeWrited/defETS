	key[]: "load_save_t"
	val[]: "ЗАЧУВАЈ ИЛИ ВЧИТАЈ ИГРА" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "Зачувај & Вчитај" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Забележани се промени во играта! За да избегнете проблеми со компитабилноста на зачувување на играта за време промените во околината на играта, сите недовршени испораки без откажани без пенали за вас." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Забележани се промени во играта!<br><br>За да превенирате проблеми со компитабилноста на зачувување на играта, сите недовршени испораки без откажани без пенали за вас. Потребно е пре-паркирање на камионот на безбедно место.<br><br>Ве молиме изберете брзо патување до дестинацијата за да продолжите." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Зачувување..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Притиснете $KEY$ за да прескокнете приказна сцена." #+ Shown when any key was pressed during viewpoint cutscene.

