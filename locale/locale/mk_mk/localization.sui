	key[]: "td_msg_bought_assigned"
	val[]: "Ви благодариме за купувањето.Ужувајте во вашиот нов камион!<br><br>Ние ке го земеме вашиот стар камион во твојата гаража во  $CITY$."

	key[]: "td_msg_bought_sent"
	val[]: "Ти Благодариме за набавката.Ние ке го доставиме твојот ново купен камион во твојата гаража во $CITY$ веднаш."

	key[]: "td_msg_bought_assigned2"
