#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Сликата е преголема.Ве молиме пробајте да ја намалите резолуцијата." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Сликата е оштетена или неподржана." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Резолуцијата на сликата е премногу голема.Ве молиме пробајте да ја намалите резолуцијата на сликата." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Сервисот ја отфрли сликата." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "На акаунтот не му е дозволено да прикачува слики." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Имаше симултани прикачувања на иститиот слот." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Прикачувањето е оневозможено.Ве молиме пробајте подоцна." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Непозната грешка се појави за време на прикачувањето. Ве молиме пробајте подоцна." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Сликата е поголема од максималната дозволена големина од $LIMIT$ и е смалена." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Сликата е поголема од максимална дозволена големина од $LIMIT$KB и беше смалена." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

