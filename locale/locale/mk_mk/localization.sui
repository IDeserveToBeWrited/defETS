#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "Графика" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Графика" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Adjust graphics settings using finely-tuned presets to tailor your game's visual performance to your liking."

	key[]: "apply"
	val[]: "Примени" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Desktop Theme" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ПРИКАЗ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "IMAGE QUALITY" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURES" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLECTIONS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SHADOWS" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "LIGHTING" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-PROCESSING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ENVIRONMENT" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Преку цел екран" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Brightness / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Setup" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Резолуција" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Фрекфенција на освежување" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS limit" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS limit in background" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Фабричка вредност" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Вертикална Синхронизација" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Економично(заштедува енергија на тетратките)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ЕДНОСТАВНИ ГРАФИЧКИ ПОДЕСУВАЊА" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ЛИЧНИ ПОДЕСУВАЊА СЕ ПРИМЕНЕТИ" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "НАПРЕДНИ ГРАФИЧКИ ПОДЕСУВАЊА" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Simple/advanced graphical settings" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Hide advanced settings" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Show advanced settings" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Размер" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma sharpening" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA tuning" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptive clarity" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Always soft" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Always sharp" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Screen space ambient occlusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Изразени контраст и боја (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "'Depth of field' (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Сончеви зраци" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Корекција на боја" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Reflection scaling" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Детал на одблесокот" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Детал на вегетацијата" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Густина на тревата" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Квалитет на сенката"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Големина на текстурата за сенката" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Far shadows" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Interior shadows" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Квалитет на Временските услови"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Квалитет на огледалата" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Mirror resolution" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Опсег на огледалата" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Квалитет на текстурите" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Антизотропско филтрирање" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Обично мапирање" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Светла за другите учесници во сообраќајот" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Помошни светла на возилото" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Опсег на светлата" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Пешаци" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Подесување на приказот се сменети.<br>Дали сакате да останат вакви?"

	key[]: "reverting_in"
	val[]: "Враќање во" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "секунди" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "When enabled, the game will be displayed in full screen."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Adjust the overall brightness of the game to suit your display. On HDR-compatible displays, the HDR calibration option will also be available in this setting."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Changes the resolution of the game."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Changes the target refresh rate of the game."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Matches the framerate with the monitor's refresh rate to prevent screen tearing. Economic setting also halves the framerate, resulting in a lower power consumption."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Sets the maximum allowed frame rate for the game.<br><br>Setting the value to 0 will disable the function."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Sets the maximum allowed frame rate for the game when it is minimized in the background.<br><br>Setting the value to 0 will disable the function."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Changes between simple graphical settings (presets) or advanced graphical settings (possibility to change individual parameters)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Improves graphical fidelity by rendering the game at a higher resolution internally, which reduces jagged edges and enhances detail.<br>For example, selecting a higher scaling option results in a clearer picture with less blurriness, making the game look better overall at the expense of performance.<br><br><color value=@@clr_txt_d@@>This setting often has a large impact on performance."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Selection of high-speed antialiasing methods that smooth the appearance of jagged edges in the game:<br>- SMAA samples each pixel multiple times (depending on the selected quality) at different locations within the frame and averages the samples to produce the final picture.<br>- TAA samples each pixel only once per frame, but it samples them at different locations and different frames.<br>- For the best result you can also select a combination of both at the expense of performance.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Adds soft shadows to crevices and objects that are in close proximity to one other, improving perceived graphical fidelity of the whole in-game world.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Selection of TAA presets:<br>- \"Always soft\" will result in less flicker/more blur - it is appropriate for PC users who enable supersampling or have a high DPI monitor, but also 1080p TV users who sit further away from their screen.<br>- \"Always sharp\" results in more flicker/less blur - it is probably the best option for sub-1080p use, such as laptops or Steam Deck.<br>- \"Adaptive clarity\" dynamically disables the TAA jitter when the camera is static.<br><br><color value=@@clr_txt_d@@>This setting can only be used when TAA is selected as an anti-aliasing solution."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the strength of TAA's luma sharpening.<br><br><color value=@@clr_txt_d@@>This setting can only be used when TAA is selected as an anti-aliasing solution."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "When enabled, distant areas in the map may be artificially blurred to create a realistic focus drop-off in the background."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "When enabled, rays of light may be visible when looking at the sun, or looking at the sun through objects like trees, buildings or vehicles."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "When enabled, colours of the game are dynamically adjusted for aesthetic reasons. Scenes will better match the time-of-day and weather conditions, colours of vehicles and other objects may be more vibrant, etc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Improves reflections by rendering them at a higher quality internally, as well as using better antialiasing.<br><br><color value=@@clr_txt_d@@>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the detail of reflections seen on vehicle surfaces, windows and other reflective surfaces such as puddles, wet roads and open bodies of water.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance.<br><br>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the detail and complexity of plants and trees.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the density of grass seen on the sides of the road.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of shadows cast by the sun or moon.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables shadows to be rendered even from very far objects.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of weather effects, such as reflections."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of reflections seen in vehicle mirrors (independent of reflection settings).<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the resolution of the image rendered on your vehicle mirrors."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the distance at which objects start to render in the mirror.<br><br><color value=@@clr_txt_d@@>This setting often has a large impact on performance."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of some textures applied to objects and surfaces in the game."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Improves the sharpness of textures, especially those viewed at a distance or at oblique angle.<br><br><color value=@@clr_txt_d@@>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Adds the appearance of geometric detail to pavements, roads and other objects to improve their appearance.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance.<br><br>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Enables illumination from headlights of other vehicles in traffic."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Enables illumination from secondary lights of other vehicles in traffic such as indicators, brakes, etc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the distance from which artificial light sources can be seen.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Enables pedestrians in the game world."
