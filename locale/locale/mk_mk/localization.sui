#+ Message boxes
#@{

	key[]: "td_msg_first_bought"
	val[]: "Ви Благодариме што го купивте првиот камион од нас! Дојдете повторно!"

	key[]: "td_msg_first_and_busy"
	val[]: "Ти Благодариме што го купи првиот камион од нас!<br><br> Ние ке ти го доставиме камионот каде што живееш и каде што ке можеш да го земеш откако ке ја завршиш доставата."

	key[]: "td_first_truck_switch_mode_city"
