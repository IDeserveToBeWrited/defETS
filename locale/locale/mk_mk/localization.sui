	val[]: "Продолжи ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Добредојде во Euro Truck Simulator 2"

	key[]: "intro_2"
	val[]: "После толку време ти имаш шанса да ја работиш работата од твојте соништа-да возиш камион!"

	key[]: "intro_3"
	val[]: "Твојата Транспортна компанија е сега отворена за бизнис,но за жал ви недостасувуаат пари за да купите камион.За сега ти треба да работиш за други компании како возач за изнајмување."

	key[]: "intro_4"
	val[]: "Твојата задача е безбедно да доставиш товар од $JOB_CARGO$ до $JOB_TARGET_COMPANY$ складиште во $JOB_TARGET_CITY$. Твојот работодавач ти обезбеди возило и исто така тој ке ги покрие сите трошоци.Пристигни на време."


	key[]: "intro_garage_1"
	val[]: "Ова се вашите канцеларии."

	key[]: "intro_garage_2"
	val[]: "Ова е убава гаража.Можеби не е многу, но добра е за почеток."

	key[]: "intro_garage_3"
	val[]: "За жал,немате ништо што би го паркирале тука,па нема ни камиони на видикот."

	key[]: "intro_garage_4"
	val[]: "Кога веќе ке заработиш пари и ке купиш камион,ти можеш да го прошеташ светот и да го раководиш твојот бизнис од тука."

	key[]: "intro_garage_5"
	val[]: "Со среќа!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE UNLOCKED"

	key[]: "desktop_tut_job"
	val[]: "Избери ја твојата следна работа"

	key[]: "desktop_tut_cargo_market"
	val[]: "Use your brand new trailer to access Cargo Market to deliver a wide assortment of cargo to their destinations." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Тука можеш да го видиш твојот напредок."

	key[]: "desktop_tut_company"
	val[]: "Следете ги вашите гаражи, вработувајте нови возачи или управувајте ја вашата компанија оттука."

	key[]: "desktop_tut_trailers"
	val[]: "From now on, you can purchase your own trailers, and upgrade or paint them to match your truck.<br><br>Your trailers can be stored in your chosen garage(s); they can be used by your drivers to increase profits. To manage your trailers, use the Trailer Manager."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visit $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Use the Mode button to switch between different desktop modes and different vehicle types."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "WELCOME"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Welcome to the new Desktop.<br>From here you can interface with all functionality within the game."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Below, the Main Menu provides direct access to all of the core game functions that you are familiar with."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "At the top, the new Status Bar provides constant visibility to helpful player profile statistics and local travel regulations."

	key[]: "desktop_tut_tour_home"
	val[]: "The Desktop button is always there to return you to your Desktop."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "A permanent Quick Menu provides handy shortcut access to all game functions from any screen."

	key[]: "desktop_tut_tour_drive"
	val[]: "The updated Drive button remains your connection to the driving world, ready to place you back on the road."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL FINISHED"

	key[]: "desktop_tut_tour_finish"
	val[]: "Thanks for reviewing our Desktop update."


