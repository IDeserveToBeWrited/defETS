#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "БАНКА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Банка" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Ако ти требаат пари,ти треба секогаш да ја прашуваш банката за Заем" #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "ПОНУДИ ЗА ЗАЕМ" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "за $MONEY$ на ден" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Број на активни Заеми: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Ти можеш да позајмиш: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "ПРЕГЛЕД НА АКТИВНИ ПОЗАЈМУВАЊА"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Заем" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Останато за отплата" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Duration (in days)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Interest rate (p.a.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Рата" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Oтплати" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Вкупно:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Состојба на акаунтот: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

	key[]: "bank_loan_unlock_requirement"
	val[]: "Advance your career to unlock the loan."

	key[]: "bank_loan_locked_wrong_mode"
	val[]: "Advance your career in $MODE$ to unlock the loan."

    key[]: "bank_loan_in_debt"
	val[]: "You have too much debt to take this loan."

