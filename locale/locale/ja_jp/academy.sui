#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "トレーラー牽引時の後退"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "このシナリオでは, 初めてトレーラーを牽引しての後退を試みます. これはかなり簡単な操縦ですが, トレーラーを正しい位置に置くには正しいステアリング操作が必要となります."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "トレーラーへの後退"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "トレーラーの接続"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "パーキングブレーキの解除"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "トレーラー牽引時の後退"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "駐車スポットに向かって進む"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "トレーラーを牽引して後退してみましょう. 見た目より簡単です; ただ, 忍耐が必要です."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "後退を開始し, トラクターをトレーラーとまっすぐにします."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "正しく並んでいることを確認します. 正しく並んでいないと接続できません. 正しく並んでいない場合は, いつでも前に出てやり直すことができます."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "トラクターの第五輪がトレーラーのキングピンにロックされます."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "パーキングブレーキをかけ, トレーラーを接続します. 現実世界では, エアと電気のラインを接続し, ランディングギアを上げるためにトラックから降りる必要がありますが, ここでは私たちが代わりに行います."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>トレーラーは常にトラクターとは<color value=@@clr_sel@@>反対方向<color value=@@clr_txt@@>に曲がります."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>トレーラーの向きを変えるには, トレーラーを進めたい方向とは<color value=@@clr_sel@@>反対の方向<color value=@@clr_txt@@>にトラクターを操縦する必要があります."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>トレーラーを再びまっすぐにするには,<br>トラクターを<color value=@@clr_sel@@>トレーラーの方向<color value=@@clr_txt@@>に向けます."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "トレーラーとまっすぐ並ぶようにします - トレーラーがマークされたエリアを向くようにするには, 常に小さな修正を行う必要があるでしょう."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "進路からの逸脱が発生したら, すぐにステアリングホイールを少し回して修正します. ステアリングを切りすぎると, 希望する進路から大きく外れてしまう可能性があります."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "指定のエリアで停止します. トラックを固定してエンジンを切ります."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "あなたの背後, 助手席側にトレーラーが見えます. 最初の作業はトレーラーに向かって後退することです.<br><br><font face=/font/big_bold.font>トラックを後退させる準備をする. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>トレーラーに向かって後退を開始する. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "トレーラーとまっすぐになるように位置を調整します. 第五輪がキングピンを捉える必要があります. 必要なら前方に出てやり直しましょう.<br><br><font face=/font/big_bold.font>接続を感じるまで後退し続ける. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "第五輪がキングピンに連結され, トレーラーとの接続作業を完了させる準備が整いました.<br><br><font face=/font/big_bold.font>パーキングブレーキをかける. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> @@imv_nrm_attach@@ を押してトレーラーを接続する. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "これでトレーラーはトラクターにしっかりと接続され, エアと電気のラインも接続され, ランディングギアが上げられました.<br><br><font face=/font/big_bold.font>パーキングブレーキを解除する. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "すぐ後ろの駐車スポットに後退で入らなければなりません. トレーラーはトラクターのステアリング操作とは反対方向に曲がることを忘れないように. ステアリングホイールを少し回すだけでも, トレーラーが大きく動くことがあります.<br><br><font face=/font/big_bold.font>トレーラーの後退を開始する. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "オーバーステアに注意し, トレーラーが駐車スポットとまっすぐになるようにします. <br><br><font face=/font/big_bold.font>駐車スポットに向かって進み続ける. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "狭いスペースに駐車する"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "このシナリオでは, 狭いスペースに駐車します.<br><br>トレーラーをオフセット駐車スポットにまっすぐ並べるように操縦する必要があります."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "所定の位置へ移動する"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "前進しながらの駐車 \"ノーズイン\" は駐車操作に関して言えばかなり簡単です. <br>トレーラーの内輪差を考慮する必要があります."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "通常ならトラクターを単独で方向転換させる地点を通過しなければなりません. これにより, トレーラーをより効率的に並べることができます."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "駐車スポットに近づいたら, トラクターをトレーラーの前に出すように曲がります. まっすぐに並びつつ, 駐車スポットを進みます. <br>停止, そして駐車できたら, トラックを固定してエンジンを切ります."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "目の前に駐車スポットがありますので, そこまで進んで駐車します.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>運転を開始し, 駐車スポットに向かって曲がる.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "駐車スポットを通り過ぎて, トレーラーをマークされたエリアに並べ, トラクターをそのスペースに入れてまっすぐにします.<br><br><font face=/font/big_bold.font>指定のエリアに駐車する. </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>指定のエリアで停止する.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>トラックを固定し, エンジンを切ります.</font>"
#@}

