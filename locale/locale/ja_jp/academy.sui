	key[]: "aca_msg_book3_intro_cutscene08"
	val[]: "狭い場所を曲がります."

	key[]: "aca_msg_book3_intro_cutscene09"
	val[]: "そして最後には, ちょっと楽しんだりすることも.<br><br>頑張ってください!"
#@}


#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "サンドボックスでの後退"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "このシナリオでは, 空いている駐車場でダブルストレーラーの後退駐車の練習を行います."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "始めに"

	key[]: "aca_goal_book3_urf_move"
	val[]: "試行錯誤"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "仕上げ"

	key[]: "aca_goal_book3_urf_end"
	val[]: "シナリオの終了"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "ダブルストレーラーでの後退は, シングルトレーラーの場合よりもはるかに注意を要します. 前部トレーラーと運転席の操作を確実にコントロールしつつ, 後部トレーラーをどこへ誘導するかを事前に計画しておく必要があります.<br><br>このように考えてみてください - 前部トレーラーを使って, 後部トレーラーを操舵しなければならない."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "この場合, 後部トレーラーを運転席側に曲げたいとします. このように曲げるには, 後部トレーラーの前部を助手席側に押す必要があります.<br><br>つまり, 後部トレーラーを曲げたい方向とは逆の方向に, 前部トレーラーを曲げなければならないことに注意してください."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "後部トレーラーが旋回し始めたら, 前部トレーラーを牽引するトラクターをまっすぐにすることが不可欠です. 多くの人がここで最初のミスを犯しがちです."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "ここでは, ドライバーが前部トレーラーに従うことができず, トレーラーがジャックナイフ現象を起こそうとしているのがわかります."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "ジャックナイフ現象は, 連結車両の2台間の角度が約90度になったときに発生します. 一度こうなってしまうと, どうにもなりません. 前進してもう一度やり直す必要があります.<br><br>1台のトレーラーをバックさせる場合と同様に, 常にトレーラーのすべての車輪が回転していることを確認する必要があります. 1つの車輪が停止してトレーラーがその場で回転している場合は, 作業を続けることはできません."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "前回正しく処理できた箇所, あるいは同じエラーを再び起こさずに逆方向へ処理を続けられる位置まで戻ることができます.<br><br>この場合, まっすぐな位置まで前進して最初からやり直します."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "再び, 後部トレーラーが旋回し始めたら, トラクターを前部トレーラーの前に出し, 後部トレーラーがしばらく自力で旋回するのを待ちます."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "後部トレーラーが目的の方向に旋回したら, 今度は前部トレーラーを操舵してそれに追従させます. 前部と後部のトレーラーの角度を調整することで, 旋回角度を狭めたり広げたりして, 曲がり方をコントロールできます."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "操縦の最終段階は, すべてをまっすぐにすることです. 前部と後部のトレーラーを一直線に並べましょう."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "前部トレーラーを移動させるのにかかる時間を考慮に入れてください. あまり長く待ちすぎると, 後部トレーラーが来た方向に戻ろうとしてしまう可能性があります!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "どうぞご自由に時間をかけて, トレーラーを後退させる方法を大まかに理解できるまで, さまざまな操作を試してみてください.<br><br>でも, 何よりも大切なのは楽しむことです!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "発進の準備をします."

	key[]: "aca_msg_book3_urf_move"
	val[]: "この駐車場を使って, トレーラーを後退させる感覚をつかんでください.<br><br>@@aca_goal_tip@@ トレーラーの後退操作は初めてですか? それなら \"トラック運転の基本\" をプレイしてみてください."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "練習したいだけ時間をかけてください.<br><br>満足したら, 停止してトラックを固定し, シナリオを終了してください."

	key[]: "aca_msg_book3_urf_end"
	val[]: "シナリオを終了するには, エンジンを切ってください."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "狭いスペースでの駐車"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "このシナリオでは, 狭いスペースにダブルストレーラーを駐車するという課題が与えられます."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "始めに"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "出発する"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "運転を続けます"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "停止する"

	key[]: "aca_goal_book3_sup_end"
	val[]: "車両を固定する"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "ダブルストレーラーの運転は難しそうに思えるかもしれませんが, シングルトレーラーの運転とそれほど変わりません. ただ, 後部トレーラーの進路も考慮する必要があるだけです!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "目の前には狭い駐車スポットがあります. 完全にまっすぐ進入するだけのスペースはないので, 2台のトレーラーをどうやって駐車するかを慎重に検討する必要があります."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "すぐに駐車スポットの奥の方へ向きを変え, 普段なら曲がる地点をはるかに通り過ぎるように進みます."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "後部トレーラーが軌道に乗ったので, 目的地に向かって進んでください; ただし, 前部トレーラーを回転させるために, 反対側へもう一度向かうようにしてください."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "そのまま目的地へ進むと, 両方のトレーラーもあなたについてきて, 進むにつれてまっすぐな状態になります."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "指定のエリアに駐車し, トラックを固定します."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "発進の準備をします."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "そのまま進んで, 狭い場所に入ってください."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "運転を続けます."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "指定のエリアで停止します."

	key[]: "aca_msg_book3_sup_end"
	val[]: "トラックを固定し, エンジンを切ります."
#@}


