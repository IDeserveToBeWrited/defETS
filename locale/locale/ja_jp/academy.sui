	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "斜め駐車は一見簡単そうに見えますが, 通常の \"直角バック\" 駐車よりも難しいことがよくあります."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "駐車スポットに向かって後退します. 今の段階では, トラクターとトレーラーはまっすぐにしておきます."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "近づくにつれて, トレーラーを駐車中のトラックに寄せていきます. こうすることで, 駐車スポットに到達したときに曲がりやすくなります."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "トレーラーを駐車スポットに向け始めます. 反対側のスペースが必要になるので, トレーラーを運転席側のトラックに近づけておきます."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "トレーラーが駐車スポットに十分に入ったら, トレーラーに追従するようにトラクターの向きを変え始めます."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "指定のエリアに駐車し, トラックを固定してエンジンを切ります."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "トラックを後ろのスペースに駐車します. 後退するときは両方のミラーを確認しましょう.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "周囲を確認し, 駐車スポットに向かいます.<br><br><font face=/font/big_bold.font>後退を開始します.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "トレーラーを隣のトラックに向かって動かし始めます. 準備ができたら, トレーラーを駐車スポットに向けます. トレーラー後部の振り出しにも注意しましょう.<br><br><font face=/font/big_bold.font>駐車スポットに向かって曲がります. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "ターンへの後退"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "このシナリオでは, 初めてトレーラーを後退させながらカーブを曲がります. 後退の基本原理と, 後退時に注意すべき点について学びます."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "トレーラーの旋回"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "このシナリオでは, 運転席側の後ろにある駐車スポットまで後退する必要があります."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "トレーラーの後退には, 覚えておくと役に立つコツがいくつかあります. <br>1 つ目は, トレーラーは常にトラクターのステアリングを切った方向とは反対の方向に曲がろうとする, ということです."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "2 つ目は, トラックとトレーラーの車軸を見ることで, トレーラーの進行方向を正確に把握できるということです."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "3 つ目は, 少しの操作で目的の場所にたどり着けるので, 大げさな操作は必要ないということです."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "トラクターを駐車スポットから遠ざけるように少しずつ動かすと, トレーラーは駐車スポットの方を向き始めます."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "トレーラーの動きに合わせ, 正しい軌道を保つように微調整しながら進みます."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "トレーラーの車輪とトラクターの後輪に注目してください. これらを見ることで, トレーラーの向いている方向とトラクターが押している方向がわかります."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "4 つ目のコツは, ジャックナイフ状態からまっすぐにしようとするよりも, トレーラーを鋭く旋回させる方がはるかに簡単だということです. スポットに近づくまではその外側を狙い, そこから少しきつめに旋回してトレーラーの位置を合わせましょう."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "トレーラーが駐車スポットに入ったら, トラクターをトレーラーの前に合わせます. 駐車スポット内での過度な調整は避けましょう."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "バリケードの間を後退し, 両サイドを確認しながら進みます."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "トラックを固定し, エンジンを切ります."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "トレーラー牽引時に後退して曲がるときには, 次のコツを覚えておいてください:<br><br>— トレーラーはトラクターの操作とは逆に曲がる<br><br>— トレーラーの車輪を見て, どこを向いているのかを確認する<br><br>— トラクターの後輪を見て, トレーラーをどの方向に押しているのかを確認する<br><br>— トレーラーに動きを任せて, ステアリングを切りすぎないようにする<br><br>— トレーラーをまっすぐにするよりも, 鋭角に曲げる方が簡単<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "後方を見て, 向かうべき場所を確認します. 後退を開始する前に, 必ず周囲を確認しましょう.<br><br><font face=/font/big_bold.font>駐車スポットに向かって後退を開始します. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>トレーラーを駐車スポットに向かって曲げ始め, それに追従します.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>指定のスポットで停止します. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "狭い駐車場での後退駐車"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "このシナリオでは, 混雑した駐車場でトレーラーを後退させ, 駐車スポットに入れる課題に取り組みます."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "トレーラーの旋回"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "これはトラック用の一般的な駐車場です. トラック運転手の仕事では, ほぼ毎日このような駐車状況に直面します.<br>ここで駐車するには, \"直角バック\" のテクニックが必要です."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "前のシナリオと似た操縦になりますが, 今回は動けるスペースが狭いため, それに応じて動きを計算し, 障害物にぶつからないように注意する必要があります."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "スペースが狭いため, タイミングがさらに重要になります. 適切なタイミングでトレーラーの向きを変え, トラクターとトレーラーの車輪を見て進行方向を確認します. トレーラー後部の振り出しにも注意し, ジャックナイフにならないように気をつけながらトレーラーを押し続けます."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "運転席側のトラックに近づくようにします. こうすることで, トレーラーの旋回スペースが確保され, 助手席側のトラックについてはあまり心配せずにすみます."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "トレーラーがスポットに入ったら, トラクターをトレーラーの正面に合わせます. 自分の直感よりも少し早めのタイミングで行うのがコツです. 最終的な位置まで後退しながら, いつでも軌道修正できます."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "トラクターとトレーラーをまっすぐにして, 指定のエリアで停止します."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "トラックを固定し, エンジンを切ります."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "それでは, \"直角バック\" の操作で, より狭いエリアでトレーラーを曲げる練習をしましょう.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "周囲を確認し, 後ろにある駐車スポットを探します. <br><br><font face=/font/big_bold.font>駐車スポットに向けて後退を開始します. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>トレーラーを駐車スポットに入れます. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "最終試験 (その 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "最終試験では, これまでのシナリオで学んだすべてのスキルが試されます. トレーニングセンター全体を運転して周り, これまでに遭遇した状況をどの程度習得できているかを確認します.<br><br>すべての区間と運転操作を完了すれば, 熟練のトラック運転手に一歩近づくことになります!"

