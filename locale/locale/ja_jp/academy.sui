	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "斜め駐車は一見簡単そうに見えますが, 一般的な \"路地裏駐車\" 操縦よりも難しい場合が多いです."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "駐車スポットに向かって後退します. 現時点では, トラクターとトレーラーはまっすぐにしておきます."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "近づくにつれて, トレーラーを駐車中のトラックに近づけます. こうすることで, 駐車スポットに到達したときにトレーラーをその場所に向けやすくなります."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "トレーラーを駐車スポットに向け始めます. 反対側のスペースが必要になるので, トレーラーを運転席側のトラックに近づけておきます."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "トレーラーが駐車スポットに十分に入ったら, トレーラーに追従するようにトラクターの向きを変え始めます."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "指定のエリアに駐車し, トラックを固定してエンジンを切ります."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "トラックを後ろのスペースに駐車します. 後退するときは両方のミラーを活用して進みましょう.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "周囲を確認し, 駐車スポットに向かいます.<br><br><font face=/font/big_bold.font>後退を開始する.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "トレーラーを隣のトラックに向かって動かし始めます. 準備ができたら, トレーラーを駐車スポットに向けます. トレーラーのテールスイングを考慮することを忘れないように.<br><br><font face=/font/big_bold.font>駐車スポットに向かって曲がる. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "ターンへの後退"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "このシナリオでは, 初めてトレーラーを牽引しながら後退してカーブを曲がります. 後退の基本原理と, 後退時に注意すべき点について探っていきます."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "トレーラーの旋回"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "このシナリオでは, 運転席側の後ろにある駐車スポットまで後退する必要があります."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "トレーラーの後退には, 覚えておくと役に立つコツがいくつかあります. <br>一つ目は, トレーラーは常にトラクターの操作方向とは反対の方向に曲がろうとする, ということです."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "二つ目は, トラックとトレーラーの車輪を観察することで, トレーラーがどこに向かっているのかをよく把握できることです."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "三つ目に, 小さな操作で目的とする場所に到達できるので, 大げさな操作は必要ないということです."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "トラクターを駐車スポットから少し遠ざけるように旋回させると, トレーラーは駐車スポットの方向を向き始めます."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "トレーラーが正しい方向に進むように調整しながら, トレーラーに追従します."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "トレーラーの車輪とトラクターの後輪に注目してください. これらによって, トレーラーの向いている方向とトラクターが押している方向がわかります."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "四つ目のコツは, ジャックナイフ状態からまっすぐにしようとするよりも, トレーラーを鋭く旋回させる方が常に簡単だということです. スポットに近づくまでスポットの外側を狙い, その後, 少し鋭く旋回してトレーラーの位置を合わせます."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "トレーラーが駐車スポットに入ったら, トラクターをトレーラーの前に置きます. 駐車スポット内での調整はしすぎないようにします."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "バリアの間を後退し, 両サイドを確認しながら進みます."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "トラックを固定し, エンジンを切ります."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "トレーラーを牽引時に後退して曲がるときには, 次のコツを覚えておいてください:<br><br>— トレーラーはトラクターの操作とは逆に曲がる<br><br>— トレーラーの車輪を見て, どこを向いているのかを確認する<br><br>— トラクターの後輪を見て, トレーラーをどの方向に押しているのかを確認する<br><br>— トレーラーに動きを任せて, オーバーステアを出さない<br><br>— トレーラーをまっすぐにするよりも, 鋭角に曲げる方が簡単<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "自分の後方を見て, 行くべき場所を探します. 後退を開始する前に, 常に周囲を確認しましょう.<br><br><font face=/font/big_bold.font>駐車スポットに向かって後退を開始する. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>トレーラーを駐車スポットに向かって曲げ始め, それに追従する.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>指定のスポットで停止する. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "狭い駐車場での後退駐車"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "このシナリオでは, 混雑した駐車場の駐車スポットにトレーラーを後退させるという課題を行ってみましょう."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "トレーラーの旋回"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "これは典型的なトラックの駐車場です. トラック運転手はそのキャリアの中で, このような駐車状況にほぼ毎日のように遭遇することでしょう.<br>ここで駐車するには, \"路地駐車\" 操縦が必要です."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "これは前のシナリオと似た操縦になりますが, 作業スペースが少なくなるので, それに応じて動きを計画し, 何かにぶつからないように注意する必要があります."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "スペースが狭いため, タイミングがより重要になります. 適切なタイミングでトレーラーの向きを変え, トラクターとトレーラーの車輪を見てどこに行こうとしているかを確認します. テールスイングを念頭に置き, ジャックナイフにならないように注意してトレーラーを押し続けます."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "運転席側のトラックに近づくようにします. こうすることで, トレーラーの旋回スペースが確保され, 助手席側のトラックについてはあまり心配する必要がなくなります."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "トレーラーが所定の位置に来たら, トラクターをトレーラーの前に出します. これは直感でそう思うよりも少し早めに行った方がよいでしょう. 最終位置に後退しながらいつでも修正できます."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "トラクターとトレーラーをまっすぐにして, 指定のエリアで停止します."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "トラックを固定し, エンジンを切ります."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "今回は \"路地裏駐車\" 操縦で, はるかに狭いエリアでトレーラーを方向転換させてみましょう.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "周囲を確認し, 後ろにある駐車スポットを探します. <br><br><font face=/font/big_bold.font>駐車スポットに向けて後退を開始する. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>トレーラーを駐車スポットに入れる. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "最終試験 (その 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "最終試験では, これまでのシナリオで学んだすべてのスキルが試されます. トレーニングセンター全体をドライブし、これまでに遭遇した状況をどの程度習得できているかを確認します.<br><br>すべての区間と操縦を完了すれば, 熟練トラック運転手と呼ばれることに一歩近づくでしょう!"

