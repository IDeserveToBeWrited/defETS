#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "複雑なターンの走行"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "このシナリオでは, より複雑なターンを含む短い障害物コースでトレーラーを操縦する方法を学びます."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "最初のターン"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "狭い通路を通過する"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "きつい90度ターン"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "バリアを避けて走行する"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "前方にはさまざまな複雑なコーナーや障害物があります.<br>これまで学んだことをすべて考慮すれば, それほど難しくはないはずです."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "ロードマーキングは, それぞれの障害物を通過する方法を知るのに役立ちます."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "トラクターをコーナーの外側に寄せます. <br>トレーラーは短い経路をたどるので, 大きく旋回する必要があります."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "次のコーナーは簡単な90度ターンです. <br> もう一度言いますが, トラックをターンの外側に寄せて, 利用可能なスペースをすべて活用しましょう."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "ここでは時間をかけてください. コースは開けていますが, それでも正確さが求められます."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "バリアーの周囲は広く空けておきます."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "この狭い区間に入るときは気を付けましょう. <br>進入する前にトラクターを大きく振り, トレーラーを進入可能な状態にします."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "最後の90度ターンは最初のターンよりずっと鋭いですが, スペースを賢く使えば十分な余裕があります."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "指定のエリアで停止し, トラックを固定してエンジンを切ります."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "コースを進む際には, ロードマーキングを必ず活用しましょう.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "ミラーを使うこともコースを安全に進むのに役立ちます. トレーラーがあなたの後ろをどのように追従しているかを常に意識する必要があります.<br><br><font face=/font/big_bold.font>最初のコーナーを通過する. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "ターンを抜けて, 次のターンに入る準備をしながらトレーラーを観察します.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>次のターンに進む. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "トラックを旋回させる前に, 必ずトレーラーを観察して, 周囲に障害物がないことを確認しましょう.<br><br><font face=/font/big_bold.font>前方のバリア障害物を迂回して進む. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "トレーラーがバリアを通過したら, 助手席側へ大きく旋回して狭い通路に並ぶようにします. <br><br><font face=/font/big_bold.font>狭い通路に向かって進む.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "この区間では非常に正確な運転が求められます. 時間をかけてミラーを活用しましょう.<br><br><font face=/font/big_bold.font>各コーナーの外側に寄せる. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "このターンは非常に鋭いですが, 目の前のスペースをすべて活用すれば簡単にクリアできます.<br><br><font face=/font/big_bold.font>最後のターンを曲がる. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "上級トレーニングコース - トレーラー"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "チャプター3の最後のシナリオでは, さまざまなターンがあるより長いトレーニングコースを運転して, トレーラーの操縦をどれだけ習得できたかを確認します."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "ドッグレッグターン"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVE THIS GOAL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "中央分離帯を渡る"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "最初のスラローム"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "二つ目のスラローム"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "簡単なターン"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "ラウンドアバウト"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "ストレート区間"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "きついターン"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "最後のターン"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "駐車スポットへ進む"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "このシナリオでは, トレーラーを牽引した状態での運転に慣れるために, さまざまなターンに直面します. 集中力を保ち, それぞれの状況に合わせて速度を調整し, トレーニングコースのスペースを最大限に活用しましょう."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "最初のターンはドッグレッグターンです - 二つのターンが組み合わさっています. 左ターンの準備を整える必要がありますが, 操縦の途中で右ターンに移行する必要があります."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "次のターンでは, 中央分離帯の反対側に渡ります. 特に難しいわけではありませんが, トレーラーのための十分なスペースを確保するように注意する必要があります."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "次にコンクリートのバリアを通り抜けるタイトなスラロームを走行する必要があります. ゆっくりと, そしてミラーを活用し, トレーラーがバリアを通過できる程度に大きく旋回しましょう."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "この地点では, 各カーブの頂点に追加のロードコーンが配置された別のスラロームに入ります.<br>くれぐれもぶつからないように注意しましょう!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "次は, ラウンドアバウトに向かう途中に, いくつかの簡単なコーナーがあります."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "ストレート区間を利用してラウンドアバウトに入る準備をします. ラウンドアバウトに入る前に外側に寄っておきましょう."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "ラウンドアバウトに入り, トレーラーの位置を確認します. ラウンドアバウト内に入ると, トレーラーは進入した時とは異なる軌跡を描きます."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "ラウンドアバウトを出て, 次のターンまで進みます."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "REMOVE THIS CUTSCENE"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "ここのターンは非常に鋭いです. ゆっくりと曲がり, 周囲のスペースを賢く活用しましょう. トレーラーのテールスイングにも注意するように."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "次のいくつかのターンを走行する際は, 前のターンを抜けるときに次のターンに向けて準備を整えることを忘れないでください."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "最終コーナーは急がないように. 簡単そうに見えますが, 見た目よりも操縦の余地はありません."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "指定のエリアで停止し, トラックを固定してエンジンを切ります."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>最初のターンに向けて加速する. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "最初のターンは簡単なドッグレッグターンです.<br><br><font face=/font/big_bold.font>曲がる. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "REMOVE THIS CHECK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "この先, コースは中央分離帯の左側に沿って続きます.<br><br><font face=/font/big_bold.font>中央分離帯を通過する. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "バリアを通過する際は, トレーラーに注意しましょう.<br><br><font face=/font/big_bold.font>スラロームを通過する. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "このスラロームはより単純ですが, ロードコーンによってかなり狭くなっています.<br><br><font face=/font/big_bold.font>ロードコーンにぶつからないようにスラロームを通過する. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "この先には簡単なコーナーがいくつかありますが, トレーラーを内側のバリアから遠ざけるために適切にセットアップする必要があります.<br><br><font face=/font/big_bold.font>曲がる. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "ラウンドアバウトに近づいています. 進入時と脱出時だけではなく, ラウンドアバウトを通過するときにもトレーラーに十分なスペースを残すようにしましょう.<br><br><font face=/font/big_bold.font>ラウンドアバウトを通過する. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "前方には短いストレート区間があるので, お望みなら少しスピードを上げることもできます.<br><br><font face=/font/big_bold.font>運転を続ける. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "ここのターンは非常に鋭いです. ゆっくり進み, 利用できるスペースをすべて活用し, トレーラーのテールスイングに注意しましょう. <br><br><font face=/font/big_bold.font>鋭いターンを通過する. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "最後の数ターンはまっすぐ進みます. トレーラーを念頭に置くことを忘れずに.<br><br><font face=/font/big_bold.font>続行する. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>最後の駐車スポットに向けて前進する. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

