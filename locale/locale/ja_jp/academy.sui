#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "障害物の隣に駐車する"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "このシナリオでは, サイドミラーを使用して縁石の横に駐車する方法を学びます."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "サイドミラーの確認"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "縁石に向かって運転する"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "サイドミラーもまた, トラックを安全に操縦するためのツールです. 助手席側ドアのフレーム上部にあります."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "前進し, ゆっくりと助手席側へ向きを変えます."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "これらの木の板は縁石を表しています. その隣に駐車する必要があります.<br>縁石に向かって向きを変えて, トラックを駐車スポットに並ぶ適切な位置に配置します."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "縁石の手前で十分に減速し, 駐車スポットの方へ曲がります. まっすぐ進むと, サイドミラーを使用して縁石からの距離を判断できます."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "駐車スポットで停止し, トラックを固定します."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>助手席側の窓から外を見てください. そこにサイドミラーが見えるはずです.</font>@@aca_goal_tip@@ インテリア視点である必要があります."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "サイドミラーは, 運転手から見えない助手席側の領域をカバーします. これはトラックで最も問題となる死角のひとつです. ミラーの角度が合わない場合は, \"@@adjust_link_t@@\" で調整できます.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "トラックはまだ動く準備ができていません. 何か忘れていないでしょうか?<br><br>エンジンは始動していますか? パーキングブレーキは解除しましたか?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "前方に縁石を模した板の列があり, 縁石の端に駐車スポットがあります. そこまで進む必要があります. <br><br><font face=/font/big_bold.font>準備ができたら進む. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "縁石に向かって曲がります. フロントミラーとサイドミラーを使用して, 縁石に対する自分の位置を確認しますが, ロードコーンを乗り越えないように注意しましょう.<br><br><font face=/font/big_bold.font>縁石に向かって進み, 駐車スポットに入る.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>トラックを固定し, エンジンを切る.</font>@@aca_goal_tip@@ インテリアルック プリセットを使用すると, ミラーを見やすくなります. オプション画面 - \"キー & ボタン\" で対応するコントロールの確認や変更ができます."
#@}

#+ Book 1 Scenario 2_05
