#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "最終試験の第一部へようこそ. ここでは, アカデミーでの学習を経て, トラックの運転技術をどの程度習得できたかを確認します."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "まず, トレーラーを接続します. 連結したら, テストエリア全体をトラックで走ります."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "コースの最初の区間は, 小さな駐車場から東側のテストコースへ続いています."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "サーキットにはバリケードの間を走行する難しい通路が含まれます."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "ルートの大部分は東のテストコースを通過します."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "さまざまな状況でトラックを操縦する能力をテストします."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "トラックを操縦して鋭いターンを曲がることになります."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "コース間を繋ぐ道路区間を走行します."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "最後のパートでは, 小さいサーキットを走行します."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "サーキットには複雑な通路や鋭いターンがたくさんあります."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "テストを完了するには, 正確に駐車する必要があります."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "緊張する必要はありません. 合格するために必要なことは既にすべて学んでいます.<br><br>頑張ってください!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "目の前にトレーラーがあります.<br><br><font face=/font/big_bold.font>トレーラーに向かって進みます. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "トラクターをトレーラーに合わせます.<br><br><font face=/font/big_bold.font>後退し, キングピンに接続します. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>トラックを固定します. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_attach@@ を押してトレーラーを接続します. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "トレーラーが接続され, トラックは走行可能な状態にあります.<br><br><font face=/font/big_bold.font>パーキングブレーキを解除します. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>駐車場の出口に向かって運転を開始します. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "路面の表示に従い, バリケードに注意しましょう.<br><br><font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "さらに難しい区間が控えています.<br><br><font face=/font/big_bold.font>バリケードの間を慎重に進みます. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "このパートでは, さまざまな種類のコーナーでトレーラーを操縦するスキルが試されます.<br><br><font face=/font/big_bold.font>コースに入ります. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>通路を通過します. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>まっすぐ進みます. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>慎重にターンを通過します. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "より複雑な区間に入ります. 慎重に運転しましょう.<br><br><font face=/font/big_bold.font>下り坂を走り続けます. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>左へ鋭く曲がります. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>サーキットを出ます. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "簡単な区間に入ります.<br><br><font face=/font/big_bold.font>坂を下り続けます. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>道路を走り続けます. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "前方に次のコースへのターンがあります.<br><br><font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>右へ曲がります. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>コースを走り続けます. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "前方にさらに鋭いターンがあります.<br><br><font face=/font/big_bold.font>必要に応じて速度を調整します. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>左へ曲がります. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>ターンに入り, 運転を続けます. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "曲がるには, アスファルトから少し離れる必要があるかもしれません.<br><br><font face=/font/big_bold.font>必要なスペースを最大限に活用し, 慎重に曲がります. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>サーキットを出て, 駐車スポットに向かいます. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "最終試験 (その 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "最終試験の後半では, これまでのシナリオで学んだ駐車スキルが評価されます. 慎重かつ正確に駐車すれば, 熟練したトラック運転手としてヨーロッパの道路を走る準備が整います!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "オフセット操作"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "斜め駐車"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "駐車場を通過する"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "縦列駐車"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "最後の駐車"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "最終試験の第二部へようこそ. 近くの駐車場に移動し, 後退と駐車スポットへの操縦スキルをテストします."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "あなたの実力を見極めるために, 複数の駐車チャレンジが連続で待ち受けています."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "ここはスペースが限られているので, 慎重に時間をかけて行いましょう."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "慎重に行動し, 急がないようにしましょう. 一発で駐車が完了しなくても大丈夫です. 重要なのは, トラックや周囲の物や人を傷つけないことです. <font face=/font/big_bold.font><br><br>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>試験の最初のパートに進みます.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "最初の課題は, オフセット駐車操作を実演することです. トレーラーを後退させる場所は左側にあります.<br><br><font face=/font/big_bold.font>オフセット駐車操作を行います.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "次の課題は, 止まっているトラックの列に後退で進入することです. 他のトラックにぶつからないように注意しましょう!<br><br><font face=/font/big_bold.font>斜め駐車操作を行います.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "駐車場を通過します. 不測の事態に気を付けましょう.<br><br><font face=/font/big_bold.font>運転を続けます.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "今度は, 前方の縁石のそばにある 2 台のトラックの間に縦列駐車してみましょう.<br><br><font face=/font/big_bold.font>縦列駐車操作を行います.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "左手に最後の駐車操作が待っています! どうアプローチするかは, あなたのやり方にお任せします.<br><br><font face=/font/big_bold.font>指定のエリアに後退します.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "もうすぐ終わりです. テストエリアを出てトラックを駐車します.<br><br><font face=/font/big_bold.font>左からテストエリアを出ます.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "右側に停まっている他のトラックと並んで駐車します.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "トレーラー牽引時の縦列駐車"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "このシナリオでは, トレーラーを接続した状態で縦列駐車する方法を学びます."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "マークされたエリアで停止する"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "トレーラーを牽引して縦列駐車することは, トラック運転手には欠かせないスキルです.<br>大都市での路上駐車であれ, 田舎のレストエリアでの停車であれ, トラック運転手なら必ず身につけておくべき技術です."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "駐車スポットを通り過ぎる際, トラクターとトレーラーが駐車できる十分なスペースがあるかどうかを注意深く確認します. ここでは, 十分なスペースを確保してあります."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "駐車スポットの前方にあるトラックに自分の位置を合わせます. トラックに近づきすぎず, ある程度の距離を保って, 操作用のスペースを確保します."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "駐車スポットから遠ざかるように鋭く向きを変え, 後退を開始します. トレーラーをすばやく駐車スポットに向けるためです."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "トレーラーが駐車スポットにしっかりと向けられたら, それに追従して進入し始めます."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "運転席側のトレーラーの車輪が駐車スポットに入る前に, トレーラーを縁石から遠ざけるようにステアリングを切り始めます."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "トラクターとトレーラーをまっすぐにしてから, 駐車スペースの中央に車体を収めます.<br>停車し, トラックを固定してエンジンを切ります."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "前方に, 他のトラックに挟まれた駐車スペースが見えます. 駐車するときは必ずミラーを確認し, トラックと周囲の障害物の間に安全な距離を保ちます.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "駐車場内を移動して駐車スペースを見つけます.<br><br><font face=/font/big_bold.font>前進します. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>目的の駐車スポットを通り過ぎてから, マークされたエリアに入ります. そこから後退操作を開始できます.<br><br><font face=/font/big_bold.font>マークされた場所で停止します. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "トラクターを駐車スポットから遠ざけ, トレーラーをスペースに向け始めます. あまり急旋回すると縁石にぶつかるので注意しましょう. <br><br><font face=/font/big_bold.font>後退を開始します. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "トレーラーを駐車スポットに合わせます. 必要に応じてステアリングを切りながら前進または後退し, 位置を調整します.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "おめでとうございます. \"トラック運転の基本\" の試験に無事合格し, トラックを適切に操縦するために必要なすべてのスキルを習得しました."

	key[]: "aca_msg_book1_outro02"
	val[]: "これはプロのトラック運転手になるという夢に向けた旅の第一歩です."

	key[]:	"aca_msg_book1_outro03"
	val[]: "これでヨーロッパの道路へと旅立ち, 最初の難関に立ち向かう準備が整いました..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...しかし, 冒険はまだ始まったばかりです."
#@}


