#!}
#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "このチャプターの最後のシナリオでは, 複雑な構成のテストコースを走行します."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "最初の障害は, いくつかのバリケードを通過するスラロームです. 通過する際は, ミラーの活用を忘れずに."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "次はヘアピンターンです. 大回りでスペースを広くとって走れば問題ないでしょう."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "ここには 90 度の左ターンがあります. トラックの後部が内側のバリケードにぶつからないように, しっかりと奥まで進入しましょう."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "ランプの障害物は少し厄介です. 乗り上げる前に, できるだけ車体の向きを合わせ, フロントミラーとサイドミラーで方向を確認しましょう."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "次の区間は逆のことをしなければなりません. そのことを念頭に置いて, 前方のバリケードにアプローチします."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "路面の表示に沿って右後方へ進みます."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "バリケードまで後退し, 停止して左方向に進みます."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "中央分離帯の切れ目を通って次の区間に進みます."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "ロードコーンを通るこの通路は非常に狭いです. ゆっくり走行し, ミラーを活用して通路内での自分の位置を確認しましょう."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "90 度のターンでは, しっかりと深く進入しましょう."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "開けた道路区間に差しかかっています. スピードを上げても良いですが, この先のカーブではすぐに減速する必要があることに留意しましょう."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "坂の下には道路を横断するバリケードがあります. そこまで進み, 左側の駐車スポットに後退で進入します."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "駐車スポットに後退します."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "駐車し, エンジンを切ってトラックを固定します."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "目の前にはバリケードでできたスラロームがあります.<br><br><font face=/font/big_bold.font>スラロームを通過する.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "トラクターの後部が縁石を乗り越えないように, コーナーの外側を走行します.<br><br><font face=/font/big_bold.font>曲がる. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "90 度の左ターンが近づいています. 利用可能なスペースを最大限活用するようにしましょう.<br><br><font face=/font/big_bold.font>曲がります. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "ランプに向きを合わせます. ランプに乗った後では, 修正する余地はほとんどありません.<br><br><font face=/font/big_bold.font>ランプを乗り越えます. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>コースに沿って左へ進みます. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "次の区間は後退で完了しなければなりません. 前方のバリケードで停止し, その後右方向に後退できるようにします.<br><br><font face=/font/big_bold.font>バリケードで停止します.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "後方右側のエリアに向かって後退します. 道路上には目印となる矢印があります.<br><br><font face=/font/big_bold.font>次の区間に向かって後退します. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>後ろのバリケードに向かって後退を続けます.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "停止して前進ギアに入れ替えたら, 左に進みます. <br><br><font face=/font/big_bold.font>前進します. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "左側の中央分離帯に切れ目があります. そこを通り抜けます.<br><br><font face=/font/big_bold.font>先へ進みます. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "前方に, ロードコーンが置かれた狭く曲がりくねった通路があります. 慎重に走行し, 必要に応じてミラーを活用しましょう.<br><br><font face=/font/big_bold.font>ロードコーンを通過します. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "引き続き, コースを進みます.<br><br><font face=/font/big_bold.font>左へ曲がります. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "曲がる前に必ず左側に寄り, できるだけ広いスペースを確保しましょう.<br><br><font face=/font/big_bold.font>曲がります. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "ここでスピードを上げることもできますが, この先にはカーブがあります.<br><br><font face=/font/big_bold.font>コースに沿って進みます. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "カーブは進むにつれて鋭くなっていきます.<br><br><font face=/font/big_bold.font>必要に応じて速度を調整し, 先へ進みます.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "坂の下には道路を塞ぐバリケードがあります. <br><br><font face=/font/big_bold.font>バリケードの近くで停止します. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "後方左側に駐車スポットがあります.<br><br><font face=/font/big_bold.font>駐車スポットへ向けて後退します. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>マークされた場所で停止します. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "ハンドリングコースでの走行"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "このシナリオでは, さまざまな種類のカーブやコーナーでトラックを操る能力をテストするため, 特別に設計されたコースをドライブします."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "コースに入る"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "緩やかな左ターン"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "S 字カーブの走行"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "ストレート区間"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "簡単なターン"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "トレーニングコースを出る"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "駐車スポットへのアプローチ"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "このシナリオでは, トラクターユニットを運転して短い距離を走行します. 身につけたばかりのスキルを駆使して, 車両をしっかり操作できるか確認しましょう."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "コースにはさまざまな種類と組み合わせのターンがあります. これはレースでもタイムアタックでもありません. 忍耐強く, そして遭遇するターンや障害物に合わせて速度を調整してください."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "コースの始めは緩やかで簡単ですが, 進むにつれてターンが複雑になっていきます."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "速度に注意しましょう. スピードを上げすぎて, ターンの判断を誤りやすくなります."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "コースの出口は非常にタイトなヘアピンターンです. ゆっくり走り, 利用できるスペースを最大限に活用してください."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "バリケードの間に駐車し, トラックを固定します."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "このシナリオを正常に完了するには, クラッシュしたり, コースアウトしたり, ロードコーンにぶつかったりしてはいけません.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>前方に進み, 鋭角に右へ曲がってコースに入ります. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>ほど良い一定の速度でターンを通過します. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "より複雑な曲がりくねった区間に近づいています.<br><br><font face=/font/big_bold.font>必要に応じて速度を調整し, 先へ進みます.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>そのまま, 一連のターン区間に向かって進みます.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "簡単で穏やかなターンがいくつかあります. 一定の速度を保ちます.<br><br><font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "コースの出口は鋭いヘアピンターンです. 速度を落として, 曲がる前に外側に寄ります. 必ずミラーを活用しましょう!<br><br><font face=/font/big_bold.font>コースから出ます. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "前方にはバリケードの間に駐車スポットがあります.<br><br><font face=/font/big_bold.font>駐車スポットに向かって進みます. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "縦列駐車"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "このシナリオでは, 2 台のトラックの間に縦列駐車する方法を見てみましょう."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "駐車スポットの前で停止する"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "バックミラーの確認"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "駐車スポットに後退する"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "駐車スポット内でのトラックの位置合わせ"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "縦列駐車はすべてのトラック運転手が知っておくべき重要なスキルです.<br>発進の準備をします."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "駐車スポットに向かって走行します.<br>周囲に注意を払いましょう."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "駐車スポットの前にあるトラックに自分の位置を合わせます. トラックに近づきすぎず, ある程度の距離を保って動くスペースを確保します."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "スペースに向かって鋭く旋回し, 後退を開始します."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "運転席側のミラーを見るときは, 後ろのトラックのすぐ前の縁石を狙います."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "フロントバンパーが前方のトラックをクリアしたら, トラックの前端を駐車スポットに合わせ, ステアリングを切り始めることができます."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "車輪をまっすぐにし, トラックを駐車スポットの中央に配置します.<br>トラックを駐車して固定します."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "前方にトラックが数台駐車しています. 駐車できる空きスペースが残っています.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "周囲の状況にしっかりと気を配りましょう. この操作の間は, ミラーを十分に活用しましょう.<br><br><font face=/font/big_bold.font>前進します.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>駐車スポットを通り過ぎてから, マークされたエリアに入ります. そこから後退操作を開始できます.<br><br><font face=/font/big_bold.font>マークされたスポットで停止します. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "周囲に障害物がないか確認し, 後退できるかどうかを確認しましょう.<br><br><font face=/font/big_bold.font>助手席側のミラーを見ます. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "ステアリングを切って, 駐車スポットに後退します.<br><br><font face=/font/big_bold.font>後退を開始します. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "適切なタイミングでトラックをまっすぐにします. 縁石に乗り上げないように注意してください.<br><br><font face=/font/big_bold.font>トラックを駐車スポットに合わせます. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "トレーラーの接続"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "このシナリオでは, トラクターユニットをトレーラーに接続したり切り離したりする際の基本について説明します."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "トレーラーへの後退"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "トレーラーの接続"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "パーキングブレーキの解除"





	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "トレーラーの切り離し"


	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "トレーラーの切り離し"



	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "トレーラーの切り離し"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "指定のエリアで停止する"
#!{

	key[]: "aca_goal_book1_3_01_check_discon"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_01_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_disc6"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_stop5"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_01_park_br_off3"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_parking_brake5"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"
 #!}


#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "このシナリオでは, 初めてのトレーラー接続と切り離しを試みます. トラックの発進準備ができたら, 後ろのトレーラーの下へ潜り込ませるように後退します."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "トレーラーを接続して, 前方に引っ張ります."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "マークされたエリアで停止します."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "トレーラーを切り離して, 前方に引っ張ります."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "駐車スポットで停止し, トラックを固定します."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "このシナリオでは, トラクターとトレーラーの接続と切り離しの手順について学びます. これはトラック運転手が実際に行う手順と比べると簡略化されています. <br><br><font face=/font/big_bold.font>発進の準備をします.</font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "トラクターユニットの後ろにはトレーラーがあります. トレーラーの下へとゆっくりと後退し, 第五輪がキングピンに当たるまで進みます. 現在, トラックは正しく位置合わせされているため, ステアリング操作は不要です. ただまっすぐ後退するだけで構いません.<br><br><font face=/font/big_bold.font>接続の手応えがあるまで, ゆっくりと後退します. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "第五輪がキングピンに連結されました.<br><br><font face=/font/big_bold.font>パーキングブレーキをかけてトラックを固定します. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "現実世界では, 第五輪が自動的にキングピンをロックした後, トラック運転手は車両から降りてランディングギアを格納し, エアと電気のラインを接続する必要があります. <br><br><font face=/font/big_bold.font>ここでは, @@imv_nrm_attach@@ を押せばトレーラーが接続されます. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "トラクターとトレーラーがしっかりと接続されたので, 発進の準備ができました. 車両が大幅に長く, 重くなっているため, これまでとは異なる運転技術が求められる点に注意しましょう. <br><br><font face=/font/big_bold.font>パーキングブレーキを解除し, 発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "前進します.<br><br><font face=/font/big_bold.font>前方のマークされたエリアで停止します. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>パーキングブレーキをかけます. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>パーキングブレーキをかけます. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "繰り返しになりますが, 現実世界では, トラック運転手は車両から降りてランディングギアを降ろし, エアと電気のラインを外して, 第五輪のロック機構を解除する必要があります. <br><br><font face=/font/big_bold.font>ゲームではこのプロセスは簡略化されているため, @@imv_nrm_attach@@ を押すだけでトレーラーが切り離されます. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>パーキングブレーキを解除します. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "トラクターをトレーラーの下から引き出して前進します.<br><br><font face=/font/big_bold.font>マークされたエリアで停止します. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>マークされたエリアで停止します. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "トレーラー牽引時のブレーキング"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "このシナリオでは, トレーラーを接続した状態での運転とブレーキの感覚をつかむことができます."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "出発する"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "坂を下る"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "速度 60 km/h (37 mph) に到達する"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "ブレーキをかける"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"



 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "このシナリオでは, トラックを少し運転します. この先の坂を下りながら, トレーラー牽引時のブレーキングの感覚を学んでいきます. トラックを準備して出発しましょう."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "最低でも 60 km/h (37 mph) を出してください. 前方のブレーキングゾーンに備えましょう."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "ブレーキングを開始して停止します. あまり長く待ちすぎると, 前方のバリケードにぶつかる可能性があるので注意しましょう!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "指定のエリアに駐車し, トラックを固定してエンジンを切ります."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "この走行では, 下り坂を下るときにフットブレーキを使用する感覚をつかみます. この訓練の目的は, 背後の貨物の重さを意識し, それが車両の制動距離にどう影響するかを認識することです.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "運転を始めます. 速度 60 km/h (37 mph) に達する必要があることに注意しましょう.<br><br><font face=/font/big_bold.font>ターンを通過します. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>坂を下りながら加速を続けます. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>最低でも 60 km/h (37 mph) に到達します. </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "必要な速度に達しました.<br><br><font face=/font/big_bold.font>前方のバリアで停止します. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

# Scenario formatting
#!{
	key[]: "aca_msg_book1_3_03_cutscene03_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/1st_turn.mat width=235 height=184 color=FFFFFFFF></align><offset vshift=184>"

