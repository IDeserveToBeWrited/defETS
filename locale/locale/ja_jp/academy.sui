#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "最終試験"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "このシナリオでは, ダブルストレーラーの運転の正確さと理解度を試すために設計されたコースで, 新たに身につけたスキルを実践で試すことになります."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "後退する"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "コースに入る"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "速度を上げる"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "ブレーキの準備"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "速度が不足しています"

