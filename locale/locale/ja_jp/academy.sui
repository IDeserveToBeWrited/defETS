	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "このシナリオでは, トレーラーを牽引した状態での運転に慣れるために, さまざまなターンに挑戦します. 集中力を保ち, 状況に合わせて速度を調整し, トレーニングコースのスペースを最大限に活用しましょう."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "最初のターンはドッグレッグターンと呼ばれる, 2 つのターンがセットになったものです. 左折の体勢から入りますが, 曲がっている途中で右折へと切り返す必要があります."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "次のターンでは, 中央分離帯を越えて反対側に渡ります. 特に難しくはありませんが, トレーラーのためのスペースを十分に確保するよう注意する必要があります."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "次は, コンクリートのバリケードの間を抜ける, 狭いスラローム走行です. 速度を落とし, ミラーを活用しましょう. トレーラーがバリケードを通過できるよう, 十分に大回りしてください."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "ここからは, カーブの内側にコーンが置かれた, 新たなスラロームに入ります.<br>くれぐれもぶつからないように注意しましょう!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "ここからは緩やかなコーナーを抜けて, ラウンドアバウトに向かいます."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "ストレート区間を利用してラウンドアバウトに入る準備をします. ラウンドアバウトに入る前に外側に寄っておきましょう."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "ラウンドアバウトに入り, トレーラーの位置を確認します. ラウンドアバウト内に入ると, トレーラーは進入した時とは異なる軌跡を描きます."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "ラウンドアバウトを出て, 次のターンまで進みます."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "REMOVE THIS CUTSCENE"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "ここのターンは非常に鋭いです. ゆっくりと曲がり, 周囲のスペースを賢く活用しましょう. トレーラー後部の振り出しにも注意してください."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "ここから続くターンを走行する際は, 前のターンを抜けるときに次のターンに向けて準備を整えることを忘れないでください."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "最終コーナーは焦らずに進みましょう. 一見簡単そうでも, 見た目ほどスペースに余裕はありません."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "指定のエリアで停止し, トラックを固定してエンジンを切ります."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>最初のターンに向けて加速します. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "最初のターンは簡単なドッグレッグターンです.<br><br><font face=/font/big_bold.font>曲がります. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "REMOVE THIS CHECK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "この先, コースは中央分離帯の左側に沿って続きます.<br><br><font face=/font/big_bold.font>中央分離帯を通過します. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "バリケードを通過する際は, トレーラーに注意しましょう.<br><br><font face=/font/big_bold.font>スラロームを通過します. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "このスラロームは先ほどよりカーブが緩やかですが, ロードコーンによってかなり狭くなっています.<br><br><font face=/font/big_bold.font>ロードコーンにぶつからないようにスラロームを通過します. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "この先には簡単なコーナーがいくつかありますが, トレーラーが内側のバリケードにぶつからないよう, 適切な位置取りをする必要があります.<br><br><font face=/font/big_bold.font>曲がります. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "ラウンドアバウトに近づいています. 進入時と脱出時だけではなく, ラウンドアバウトを通過するときにもトレーラーに十分なスペースを残すようにしましょう.<br><br><font face=/font/big_bold.font>ラウンドアバウトを通過します. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "前方には短いストレート区間があるので, 少しスピードを上げることもできます.<br><br><font face=/font/big_bold.font>運転を続けます. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "ここのターンは非常に鋭いです. 速度を落とし, 道幅をいっぱいに使いましょう. トレーラー後部の振り出しにも注意しましょう. <br><br><font face=/font/big_bold.font>鋭いターンを通過します. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "最後の数ターンはまっすぐ進みます. トレーラーをしっかり意識しましょう.<br><br><font face=/font/big_bold.font>先へ進みます. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>最後の駐車スポットに向けて前進します. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

