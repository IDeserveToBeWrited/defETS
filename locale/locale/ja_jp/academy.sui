#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "障害物の近くで停止する"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "このシナリオでは, フロントミラーの位置と, 前方にある障害物の近くで停止するための効果的な活用方法についてお話しします."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "フロントミラーの確認"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "機能を理解する"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "障害物の近くで停止する"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "トラックはトラクターの前方に大きな死角があります. この部分では歩行者や車を見失いやすいため, フロントガラス越しに確認できるフロントミラーが装備されています."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "フロントミラーは, この死角をドライバーに見渡せるように設計されています.<br>狭い場所での操縦時に障害物にぶつからないようにするための必須ツールです."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "運転を開始し, 前方のバリアに向かって進み, バリアに近づいたら減速します.<br>フロントミラーから目を離さないように."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "ラインと障害物の間で停止します."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "このシナリオでは, 図に示されているフロントミラーの使用方法を学びます.<br><br><font face=/font/big_bold.font>フロントガラスの上部を見通してみてください.</font>@@aca_goal_tip@@ インテリア視点である必要があります."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "フロントミラーにより, トラックの前方の死角を見ることができます. これにより, 安全かつ正確な運転が可能になります.<br><br>ミラーの調整具合に満足できない場合は, \"@@adjust_link_t@@\" (一時停止メニューからアクセス) で好みに調整できます.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押して続行. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "トラックの真正面にマークされた場所があります. その場所の反対側に障害物があることにお気づきでしょう; その近くに来たら, 非常にゆっくりと進みながらフロントミラーで障害物までの距離を確認します.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "トラックはまだ動く準備ができていません. 何か忘れていないでしょうか?<br><br>エンジンは始動していますか? パーキングブレーキは解除しましたか?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>駐車スポットまで前進する. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>トラックの前部を障害物と塗装されたロードマーキングの間で停止させる. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
