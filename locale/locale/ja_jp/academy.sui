#+ Book 3 Scenario correcting_90
#@{

#### correcting_90 common
	key[]: "aca_scenario_book3_correcting_90_title"
	val[]: "90度の後退の修正"

	key[]: "aca_scenario_book3_correcting_90_desc"
	val[]: "このシナリオでは, 他の誰かが諦めてしまった90度の後退操縦を完了させる課題が与えられます."

#### correcting_90 goal

#!{
	key[]: "aca_goal_book3_correcting_90_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_correcting_90_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_correcting_90_check1"
	val[]: "後退する"

#!{
	key[]: "aca_goal_book3_correcting_90_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_90 msg - intro text

	key[]: "aca_msg_book3_correcting_90_cutscene1"
	val[]: "えっと, またしても誰かがイライラして, 駐車場の真ん中に車両を放置していったようです."

	key[]: "aca_msg_book3_correcting_90_cutscene2"
	val[]: "これまでにトレーラーを何台か後退させた事があるので, ここからどう進めれば良いのか, おおよその見当はつくと思います."

	key[]: "aca_msg_book3_correcting_90_cutscene3"
	val[]: "まずは, 作業できる状態になるまで手前に引き出してください."

	key[]: "aca_msg_book3_correcting_90_cutscene4"
	val[]: "ここからは,. 前部トレーラーを使って後部トレーラーを所定の位置に誘導できます. 連結車両全体がきれいな弧を描くように操作し, すべてがスムーズに動くようにしてください."

	key[]: "aca_msg_book3_correcting_90_cutscene5"
	val[]: "必要なだけ時間をかけて, 何度でも修正してください."

	key[]: "aca_msg_book3_correcting_90_cutscene6"
	val[]: "車体全体をまっすぐに整えてから, 指定のエリアで停止し, 車両を固定します."

#### correcting_90 Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_90_forward"
	val[]: "この混乱状態から抜け出して前進し, トレーラーを所定の場所にうまく収められるようにしてください."

	key[]: "aca_msg_book3_correcting_90_check1"
	val[]: "駐車スポットに後退します."

#!{
	key[]: "aca_msg_book3_correcting_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_correcting_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario parallel
#@{

#### parallel common
	key[]: "aca_scenario_book3_parallel_title"
	val[]: "縦列駐車"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "このシナリオでは, 道路上にダブルストレーラーを縦列駐車します."

#### parallel goal

	key[]: "aca_goal_book3_parallel_check1"
	val[]: "後退する"

#!{
	key[]: "aca_goal_book3_parallel_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_parallel_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_parallel_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_parallel_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### parallel msg - intro text

	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "コーナーを曲がって道路に出てください. そこに空いている駐車スペースがあります."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "駐車スポットに車両を入れ, そのまま通り抜けてください. そうすることで, トレーラーを目的地に近づけやすくなります."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "駐車スポットから出て, 操縦できる十分なスペースが確保できるまで前進してください."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "前部トレーラーを操舵しながら, 後部トレーラーを所定の位置に押し込みます. 各トレーラーが意図した場所に確実に収まるように, 事前にしっかりと計画を立てる必要があります."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "すべてを思い通りの位置に配置するには, 前後に何度か動かす必要があるかもしれません."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "道路の端と車両がきちんと並んでいることを確認したら, 駐車スポットの中央に位置を合わせ, 車両を固定してください."

#### parallel Driving Instructions

#!{
	key[]: "aca_msg_book3_parallel_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_parallel_forward"
	val[]: "前進して駐車スポットを見つけ, 後退で駐車できるように準備します."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "駐車スポットへ後退する."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "指定のエリアで停止する."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "トラックを固定し, エンジンを切ります."
#@}




