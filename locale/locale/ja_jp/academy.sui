#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "斜め駐車"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "このシナリオでは, 混雑した駐車場の斜めの駐車スポットに車両を止めます. <br><br>操縦できる余地はあまりないので, 非常に正確かつ慎重に運転する必要があります."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "駐車スポットへのアプローチ"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "このような斜めの駐車スポットは非常に一般的です. 特にヨーロッパの高速道路沿いにある多くのレストエリアではよく見られます. <br>今回も前方の駐車スポットに \"ノーズイン\" で進入する必要があります."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "列の最後尾近くにある指定の駐車スポットに向かって走行します."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "車線の中央またはやや運転席側に寄せて走行します. バリアに近づきすぎないようにしましょう. そうしないと, ターンイン時にトレーラーの後部がバリアにぶつかる可能性があります."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "駐車スポットを十分に通り過ぎてから, 急旋回で向きを変えて駐車スポットに進入します. 両方のサイドミラーに注意する必要があります. 運転席側のミラーでトレーラーの前部が隣のトレーラーにぶつからないようにし, 助手席側のミラーでトレーラーが安全に駐車スポットに入っているかを確認します."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "指定のエリアで停止し, トラックを固定してエンジンを切ります."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "斜めに駐車するときは, 自分の位置を正確に判断することが重要です. 一度曲がり始めてしまうと, 後退して安全に位置を変えることが難しくなるため, 最初に十分なスペースがあることを確認するのが理想的です.<br><br><font face=/font/big_bold.font>出発の準備をする.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>駐車スポットに向かって運転を開始する. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "トレーラーがトラックの内側を軸に回転できるスペースを確保できるように, 駐車スポットを通り過ぎます.<br><br><font face=/font/big_bold.font>駐車スポットに向けて曲がる. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "ブラインドサイドの後退"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "このシナリオでは, トラックを \"ブラインドサイド (助手席側)\" に後退させて駐車スポットに停止する方法を見ていきます. 窓の外を見てどこに向かっているのか確認することができないのであれば, 目的地にたどり着くにはミラーだけに頼らなければなりません."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "このシナリオでは, \"ブラインドサイド (助手席側)\" での後退操作を学びます. 助手席側は視界が著しく制限されるため, 他に選択肢がない限り通常は避けるべきです. 時間をかけて, 細心の注意を払って行いましょう."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "後退を開始したら, 作業スペースを確保するために駐車スポットを十分に通り過ぎます."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "一旦停止し, 周囲の状況を確認してから後退を始めます."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "トラクターを駐車スポットから遠ざけます. これにより, トレーラーの前部が押し出され, トレーラーの後部が駐車したい場所に向けられます. やりすぎると \"ジャックナイフ\" 現象を起こしてしまう危険性があるので注意しましょう."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "トレーラーが駐車スポットに入ったら, トラックをまっすぐにし始めます."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "指定のエリアで停止し, トラックを固定します."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "ブラインドサイド (助手席側) の後退は運転席側の後退と同じ手順が必要ですが, 視界が悪く, かなり不利な状況になります. ミラーを活用し, 最善の判断を行いトラックを駐車させましょう.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "前方の助手席側に駐車スポットがあります. 後退するときに操縦できるスペースを確保するために, 駐車スポットを十分に通り過ぎる必要があります.<br><br><font face=/font/big_bold.font>前進する. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "トラックを駐車スポットから遠ざけると, トレーラーは駐車スポットに向くということを覚えておきましょう. ミラーを最大限に活用して, 駐車スポットに駐車できるようにします.<br><br><font face=/font/big_bold.font>後退を開始する. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "ラウンドアバウトでの運転"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "このシナリオでは, ラウンドアバウトを通過する方法について見ていきましょう.<br><br>ラウンドアバウトに入るとき, ラウンドアバウトを通過するとき, およびラウンドアバウトから出るときには, トレーラーはトラクターとは異なる軌跡を描くため, 特別な注意を払う必要があります."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "ラウンドアバウトに入る"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "ラウンドアバウトを通行する"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "ラウンドアバウトを通行する"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "ラウンドアバウトから出る"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "指定のエリアへ進む"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "ヨーロッパの街ではラウンドアバウトが非常に一般的なので, どのように通過すべきかを知っておくことは重要です."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "ラウンドアバウトに近づくときは, 車両を車線の外側に寄せます. これにより, トレーラーが最初のターンインの内側を通り抜けやすくなります."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "ラウンドアバウトに入るときは, 中央に向かって進みます. 中に入ったら, 今度は外側に向かう必要があります. これはトレーラーをラウンドアバウトの中心から遠ざけるためです."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "トレーラーが内側のバリアに近づきすぎないように, ミラーに注意を払いましょう."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "トレーラーはすでに出口の内側から離れた位置にあるため, ラウンドアバウトを出るのはかなり簡単です. 出口で大きく旋回すれば, トレーラーはうまく追従するはずです."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "指定のエリアに駐車し, トラックを固定します."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "目の前には, 練習で通行するためのラウンドアバウトが設置されています. <br><br><font face=/font/big_bold.font>ゆっくりとラウンドアバウトに近づく. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "トレーラーが問題なく追従して通行できるように, ラウンドアバウトに入るときは大回りで進入します.<br><br><font face=/font/big_bold.font>ラウンドアバウトに進入する. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "ラウンドアバウトの外側に向かって走行します. トレーラーを中央のバリアに近づけないようにするには, トラックをラウンドアバウトの中心からできるだけ遠ざける必要があります. <br><br><font face=/font/big_bold.font>ラウンドアバウトを通行し続ける.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "外側のロードコーンの近くに留まります. <br><br><font face=/font/big_bold.font>走り続ける.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>ラウンドアバウトを出る.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>前方の駐車スポットに進む.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>指定のエリアで停止する.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>トラックを固定し, エンジンを切る.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "狭い場所での操縦"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "最後のシナリオでは, 狭い場所でトラックの向きを変えることが課題となります. 限られたスペースでブラインドサイドに後退する必要があるため, 周囲に注意を払い, スペースを賢く活用する必要があります."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "コースへの進入"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "ブラインドサイドの準備"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "駐車スポットへ後退する"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "ブラインドサイドを完了する"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "コースから出る"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "このシナリオでは, 狭い場所でのブラインドサイド (助手席側) に後退操作する方法について見ていきます. このスキルは, 運転席側でUターンや後退ができない場合に役立ちます."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "ロードマーキングはトレーニングコースを辿っていくのに役立ちます."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "トレーラーが駐車中のトラックを避けられるように, 大回りで曲がります."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "ターンを抜けるときに, 後退操作のためにトラックをどのようにセットアップするかを検討します."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "助手席側の空いている駐車スポットを利用して, トラックを斜めに向けてから後退を開始すると良いでしょう."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "助手席側への後退は視界が著しく悪くなるため, 可能な限り避けるべきですが, 残念ながらそうせざるを得ない場合もあるでしょう."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "後退する前にステアリングを操作します. これによりトレーラーをすぐに目的の方向へ向けることができ, 非常に狭い状況でも役立ちます."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "トレーラーが所定の位置に着いたら, トラクターをトレーラーの前に置いてまっすぐにします."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "まっすぐになり, 再び前進するのに十分なスペースができたら停止します. 来た時と同じ道を戻り始めます."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "トレーニングコースの外ではロードマーキングに従います."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "前方のカーブを抜けて指定エリアまで進みます."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "停止します."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "トラックを固定し, エンジンを切ります."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "目の前のエリアには, 倉庫会社の駐車場を模したトレーニングコースがあります. そこに向かい, トラックを方向転換して戻ってくるのが今回の課題です. 周囲のスペースを有効活用しましょう.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>トレーニングコースに向かって進む. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>コーナーを曲がってコースを進む. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "コースの終わりにあるバリアまでロードマーキングに従って進みます. トレーラーが助手席側の空いている駐車スポットに向くように, 少し斜めに駐車します.<br><br><font face=/font/big_bold.font>前進を続ける. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "助手席側の後退では, 周囲で何が起こっているか確認するための視界がはるかに限られます. ゆっくり進み, ミラーを活用して慎重に運転しましょう.<br><br><font face=/font/big_bold.font>後退を開始し, トレーラーを空いている駐車スポットに向ける. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "十分でしょう. これで前進して, 来た時と同じ方向からトレーニングコースを出ることができます.<br><br><font face=/font/big_bold.font>出口に向かって進み始める. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>トレーニングコースを出る. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "ロードマーキングに従って最終地点の駐車スポットまで進みます.<br><br><font face=/font/big_bold.font>指定のエリアへ進む. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "オフセット後退操作"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "このシナリオでは, 真後ろではない駐車スポットに後退で駐車する必要があります. 操縦できるスペースは限られているため, スペースを賢く活用する必要があります."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

