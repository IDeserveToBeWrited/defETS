	key[]: "aca_msg_book1_3_05_cutscene06_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/truckbend3.mat bottom=p128 right=p256 color=FFFFFFFF></align><offset vshift=128>"

	key[]: "aca_msg_book1_3_05_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/bend_more.mat bottom=p128 right=p256 color=FFFFFFFF></align><offset vshift=128>"

	key[]: "aca_msg_book1_3_05_cutscene08_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/straiten.mat bottom=p128 right=p256 color=FFFFFFFF></align><offset vshift=128>"
