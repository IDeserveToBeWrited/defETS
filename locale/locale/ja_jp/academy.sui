	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "カメラコントロール"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "このシナリオでは, 利用可能なさまざまなタイプのカメラと, それらがトラックのコントロールと操縦にどのように役立つかを学びます."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "シートポジション"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "後方の眺め"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "ミラーの確認"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "外部カメラへの切り替え"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "トラックの周りを見る"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "このシナリオでは, 利用可能なさまざまなカメラについて見ていきます.<br>"

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "選択できるカメラは全部で 7 台あります.<br>ここではそのうちのいくつかを取り上げ, それぞれの機能について説明します."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "さまざまなカメラとアングルを使い分けると, 狭い場所での操縦に役立ちます."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "進行方向をしっかりと確認することは, 安全でプロフェッショナルな運転の基本中の基本です. 現在のシートポジションが合わない場合は, \"@@adjust_link_t@@\" で変更できます (一時停止メニューからアクセス).<br><br><font face=/font/big_bold.font>準備ができたら @@imv_nrm_activate@@ を押して確認します.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "後退する時, ミラーだけでは視界を十分に確保できないことがあります. その場合は, 窓から顔を乗り出して後方を確認する必要があるでしょう.<br><br><font face=/font/big_bold.font>カメラを運転席側に向け, 窓の外からトレーラーの後方を見てみましょう.</font>@@aca_goal_tip@@ インテリア視点を使用する必要があります."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "この視点は, トレーラー牽引時の後退操作中にトレーラーを確認するために使用します. この視点を活用できるように, 運転席側に後退するようにすると良いでしょう. 助手席側へ後退すると, 後方の状況は極めて確認しづらくなります.<br><br><font face=/font/big_bold.font>助手席側を見ます.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "このため, 通常は助手席側への後退は推奨されません. ご覧の通り, 視界がかなり限られていることがわかります. 幸いなことに, 外部カメラが7台も用意されていて活用することができます.<br><br>@@imv_nrm_camcycle@@ を押して次のカメラに順番に切り替えることができます. 7 台のカメラをすべて循環させると, 最初のカメラに戻ります.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@ を押して次のカメラに切り替えます.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "外部カメラは, トラックの周囲の状況を確認するのに最適な視点です.<br><br><font face=/font/big_bold.font>トラックの周りを見回します.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_camcycle@@ をもう一度押し, 次のカメラに切り替えます.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "トップダウン視点はトラック周辺の状況を見渡しやすく, 狭い場所での駐車や運転が大幅に簡単になります.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@ を押して次のカメラに切り替えます.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "ルーフカメラは, 視界を遮るものが少なく, トラック前方の道路状況を遠くまで見渡せます.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@ を押し, ここで確認する最後のカメラに切り替えます.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "リアビューは, 先ほど車内カメラを動かして見えた景色へのショートカットです. すでに説明した通り, 後退や駐車の際に役立ちます.<br><br>ゲームでは @@imv_nrm_camcycle@@ を繰り返し押すことで, 他のカメラを試すこともできます.<br><br><font face=/font/big_bold.font>@@imv_nrm_cam1@@ を押してインテリア視点に戻ります.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "本格的なドライビングスクールの体験のために,「インテリア視点」を使って各シナリオを進めることを推奨します. <br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押してシナリオを確認し終了する.</font>@@aca_goal_tip@@ @@o_im_cam_zoom@@ 機能を使えば, 周囲を確認しやすくなります. ミラーを確認するときに特に有効です. オプション画面の \"@@options_bindings_screen@@\" で対応する操作の確認や変更ができます."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "初めての運転"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "このシナリオでは, トラックを運転できるように準備し, 初めて前進させる方法を学びます."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "イグニッションをオンにする"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "エンジンを始動する"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "周囲の状況確認"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "フットブレーキを踏む"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "ギアを入れる"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "パーキングブレーキの解除"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "前進する"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "停止する"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "パーキングブレーキをかける"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "ニュートラルに戻す"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "エンジンを切る"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "最初の数回はトラクターユニットのみを使用します.<br>トラック自体には貨物用のボディがなく, トレーラーを連結して初めて商品や資材を運べる車両のことを「トラクター」と呼びます."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "トラクターが普及しているのは汎用性が高いためです. 空のトレーラーを切り離して, 積み込みを待つことなく積載済みのトレーラーを接続したり, まったく別の種類のトレーラーに切り替えたりすることができます."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "初めての運転では, 前進して破線を超えた後で停止することが課題となります.<br>エンジンを始動し, 指示に従ってトラックを移動させる準備をします. 準備ができたらまっすぐに進みます."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "破線を越えて停止し, トラックを固定してエンジンを切ります."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "トレーニングの次のステップでは, 初めてトラックを動かします.<br><br>もちろん, エンジンがかかっていないと動きませんので, まずはイグニッションをオンにする必要があります.<br><br><font face=/font/big_bold.font>$input engineelect$ を押してイグニッションをオンにします.</font>@@aca_goal_tip@@ キャリアモードでは, デフォルトで電気と一緒にエンジンも自動的に始動します. この動作はオプション画面 - \"ゲームプレイ\" - @@auto_engine_start@@ で調節できます."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "イグニッションはトラックの電子機器を作動させます. ダッシュボードの警告ランプが点滅していることにお気づきかもしれませんが, これは正常な状態です. エンジンを始動しても点灯・点滅したままの場合は, トラックに問題がある可能性があります. 例外はパーキングブレーキランプで, パーキングブレーキを解除すると消灯します.<br><br>幸いなことに, このトラックのコンディションは良好で, 準備万端です.<br><br><font face=/font/big_bold.font>@@imv_nrm_engine@@ を押してエンジンを始動します.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "エンジンが始動したら, 動き出す前に周囲の状況を確認することが欠かせません.<br><br><font face=/font/big_bold.font>トラックの周囲を見渡し, 運転席側および助手席側のサイドミラーを見て, トラックの周囲に異常がないことを確認します.</font>@@aca_goal_tip@@ インテリア視点を使用する必要があります."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "当たり前のことのように思えるかもしれませんが, 動き出す前に停止する方法を知っておく必要があります.<br><br><font face=/font/big_bold.font>$input backward$ を使用してフットブレーキを作動させます. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>簡素化されたオートマチックトランスミッションにより, ギアを切り替える必要はなく, すべてが自動的に行われます.<font face=/font/big_bold.font><br><br>$input forward$ を使用して前進用ギアを作動させます. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>リアル・オートマチックトランスミッションは, 本物のオートマチックトランスミッションと同じように, ドライブ・ニュートラル・リバースの間でシフトチェンジができます.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@ を使用して前進用ギアを作動させます. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>シーケンシャルトランスミッションは, 本物のシーケンシャルトランスミッションと同様に段階的な変速を可能にします.<br><br>前進ギアを入れるのと同じように, 加速中はより高いギアに順次変速する必要があります.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@ を使用してギアを 1 速に入れます.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>ギアスティックとクラッチを使えば, 本物のマニュアルトランスミッションと同じように, 物理的にギアを変速する感覚を味わうことができます.<br><br>クラッチとフットブレーキを完全に踏み込みます.<font face=/font/big_bold.font>ギアスティックを動かして 1 速に入れます.<color value=@@clr_txt@@>クラッチとフットブレーキは完全に踏み込んだままです.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "動き出すには, まずパーキングブレーキを解除する必要があります.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ を押してパーキングブレーキを解除します.</font> @@aca_goal_tip@@ キャリアモードでは, パーキングブレーキは初期状態では無効になっています. この動作はオプション画面 - \"ゲームプレイ\" - @@auto_park_brake@@ で調節できます."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>アクセル: $input forward$ を使用して移動を開始します</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>アクセル: $input forward$ を使用して移動を開始します</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>アクセル: $input forward$ を使用して移動を開始します</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>フットブレーキを解除し, クラッチを徐々に離して繋ぎながら, トラックがエンストしないようにアクセルを使って回転数を維持します. クラッチが完全に切れたら, 必要に応じて加速およびシフトアップすることができます.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "フットブレーキを使って停止します.<br><br><font face=/font/big_bold.font>$input backward$ を使用してトラックを停止します. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "フットブレーキを使って停止します.<br><br><font face=/font/big_bold.font>$input backward$ を使用してトラックを停止します. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "フットブレーキを使って停止します.<br><br><font face=/font/big_bold.font>$input backward$ を使用してトラックを停止します. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "停止するときはクラッチを完全に踏み込みます. <font face=/font/big_bold.font>その後, フットブレーキを使用してトラックを停止させます.<color value=@@clr_txt@@> ギアスティックを動かしてニュートラルに変速し, クラッチを離します.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "次にトラックを固定します. パーキングブレーキは駐車後にトラックが不用意に動かないようにするものです.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ を押してパーキングブレーキを作動させます.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "簡素化されたオートマチックトランスミッションにより, ギアを切り替える必要がなくなり, すべてが自動的に行われます.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押して確認します.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをニュートラルに戻します. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをニュートラルに戻します. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>ギアスティックをニュートラルに戻し, クラッチを離します. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "これでトラックを動かす方法と安全に停止させる方法を学びました.<br><br><font face=/font/big_bold.font>$input engineelect$ を押してエンジンを切ります. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "後退する"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "このシナリオでは, 初めて後退に挑戦します. また, 後方を確認するためのミラーの活用法, 注意すべき点や, 後退動作の準備方法についても触れます."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "エンジンを始動する"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "助手席側サイドミラーの確認"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "運転席側サイドミラーの確認"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "ギアを入れる"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "パーキングブレーキの解除"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "ニュートラルに戻す"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "エンジンを切る"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "この運転では直線で後退します. 破線を通り過ぎたら, そこで止まります."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "トラックを後退させる時は常に周囲を見渡し, すべてのミラーを観察し, 周囲と後方のスペースに障害がないことを確認することが欠かせません."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "エンジンを始動し, ギアをリバースに入れて動き始めます."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "破線を越えて停止し, トラックを固定してエンジンを切ります."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "前のシナリオで学んだように, トラックを運転できるように準備します.<br><br><font face=/font/big_bold.font>準備ができたらエンジンを始動します. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "ミラーを確認して, 周囲が安全であることを確認します. ミラーの位置に満足できない場合は '@@adjust_link_t@@' で調整できます.<br><br><font face=/font/big_bold.font>助手席側のミラーを見ます.</font>@@aca_goal_tip@@ インテリア視点である必要があります."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "破線を超えて進みます. これで車線はクリアになりましたが, 通常の運転では周囲を見回したりミラーを使ったりして, 常に周囲を観察することが重要です.<br><br><font face=/font/big_bold.font>運転席側のミラーを確認します.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>$input backward$ を使用してギアをリバースに入れます. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. この挙動はオプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをリバースに入れます. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. この挙動はオプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをリバースに入れます. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. この挙動はオプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>クラッチを完全に踏み込み, ギアスティックをリバースに入れます. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. この挙動はオプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "これでリバースギアが作動しました.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ を押してパーキングブレーキを解除します. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "$input backward$ を使用して動き始めます.<br><br><font face=/font/big_bold.font>後退して破線を超えます. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "アクセル: $input forward$ を使用して動き始めます.<br><br><font face=/font/big_bold.font>後退して破線を超えます. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "アクセル: $input forward$ を使用して動き始めます.<br><br><font face=/font/big_bold.font>後退して破線を超えます. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "アクセルを使ってエンジンの回転数を維持しながら, クラッチをゆっくり離します.<br><br><font face=/font/big_bold.font>後退して破線を超えます. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>フットブレーキ: $input forward$ を使用してトラックを停止します. </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>フットブレーキ: $input backward$ を使用してトラックを停止します.</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>フットブレーキ: $input backward$ を使用してトラックを停止します.</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>クラッチを完全に踏み込み, フットブレーキを使用してトラックを停止します. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_parkingbrake@ を押してパーキングブレーキをかけます. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "簡素化されたオートマチックトランスミッションでは, 現実とは異なり, すべてが自動的に行われるため, ギアを変速する必要はありません.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押して確認します.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_gearup@@ を押してギアをニュートラルに戻します.</font>@@aca_goal_tip@@ 最近のトラックは, パーキングブレーキを作動させると自動的にニュートラルに戻ります. ただし, 常に自分自身で行うことをお勧めします. 次のシナリオでは, この手順は必要ありません."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_gearup@@ を押してギアをニュートラルに戻します.</font>@@aca_goal_tip@@ 最近のトラックは, パーキングブレーキを作動させると自動的にニュートラルに戻ります. ただし, 常に自分自身で行うことをお勧めします. 次のシナリオでは, この手順は必要ありません."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>ギアスティックをニュートラルに戻し, クラッチを離します.</font>@@aca_goal_tip@@ 最近のトラックは, パーキングブレーキを作動させると自動的にニュートラルに戻ります. ただし, 常に自分自身で行うことをお勧めします. 次のシナリオでは, この手順は必要ありません."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "特に交通量の多い混雑した場所では, 後退する際には常に周囲に注意を払いましょう.<br><br><font face=/font/big_bold.font>$input engineelect$ を押してエンジンを切ります. </font>"
#@}

# Scenario 1_05 formatting
