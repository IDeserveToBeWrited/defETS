#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "斜め駐車"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "このシナリオでは, 混雑した駐車場の駐車スポットに, 斜めに車両を止めます. <br><br>切り返す余裕はあまりないので, 非常に正確かつ慎重な運転が求められます."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "駐車スポットへのアプローチ"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "このような斜めの駐車スポットは非常に一般的です. 特にヨーロッパの高速道路沿いにあるレストエリアではよく見られます. <br>今回も前方の駐車スポットに頭から進入します (ノーズイン)."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "列の奥にある指定の駐車スポットに向かって走行します."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "車線の中央またはやや運転席側に寄せて走行します. バリケードに近づきすぎないようにしましょう. 曲がる際に, トレーラーの後部がバリケードにぶつかる可能性があります."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "駐車スポットを十分に通り過ぎてから, 素早くステアリングを切って駐車スポットに進入します. 両方のサイドミラーに注意する必要があります. 運転席側のミラーでトレーラーの前部が隣のトレーラーにぶつからないようにし, 助手席側のミラーでトレーラーが安全に駐車スポットに入っているかを確認しましょう."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "指定のエリアで停止し, トラックを固定してエンジンを切ります."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "斜めに駐車するときは, 自分の位置を正確に判断することが重要です. 一度曲がり始めてしまうと, 後退して安全に位置を変えることが難しくなるため, 最初に十分なスペースがあることを確認するのが理想的です.<br><br><font face=/font/big_bold.font>発進の準備をします.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>駐車スポットに向かって運転を開始します. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "駐車スポットを通過し, 内側にいるトラックにトレーラーがぶつからないよう, 十分な旋回スペースを確保します.<br><br><font face=/font/big_bold.font>駐車スポットに向けて曲がります. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "ブラインドサイドの後退"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "このシナリオでは, トラックを \"ブラインドサイド\" (助手席側) に後退させて駐車スポットに停止する方法を学びます. 窓から身を乗り出して進行方向を確認できないため, ミラーだけを頼りに操作することになります."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "このシナリオでは, \"ブラインドサイド (助手席側)\" での後退操作を学びます. 助手席側は視界が極端に悪いため, 他に選択肢がない限り通常は避けるべきです. 時間をかけて, 細心の注意を払って行いましょう."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "駐車スポットを大きく通り過ぎるまで進み, 後退時の切り返しスペースをしっかりと確保しましょう."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "一旦停止し, 周囲の状況を確認してから後退を始めます."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "トラクターを駐車スポットから遠ざけます. これにより, トレーラーの前部が押し出され, トレーラーの後部が駐車したい場所に向けられます. このとき, やりすぎると \"ジャックナイフ\" 現象を起こしてしまう危険性があるので注意しましょう."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "トレーラーが駐車スポットに入ったら, トラックをまっすぐにし始めます."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "指定のエリアで停止し, トラックを固定します."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "ブラインドサイド (助手席側) の後退手順は運転席側の後退と同じですが, 視界の悪さが大きな壁となります. ミラーを活用し, 感覚を研ぎ澄ませて駐車しましょう.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "前方の助手席側に駐車スポットがあります. スポットを十分に通り過ぎておき, 後退するときの余裕を十分に確保しましょう..<br><br><font face=/font/big_bold.font>前進します. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "トラックを駐車スポットから遠ざけると, トレーラーは駐車スポットに向くということを覚えておきましょう. ミラーを最大限に活用して, 駐車スポットに駐車できるようにします.<br><br><font face=/font/big_bold.font>後退を開始します. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "ラウンドアバウトでの運転"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "このシナリオでは, ラウンドアバウトを通過する方法について学びます.<br><br>ラウンドアバウトに入るとき, ラウンドアバウトを通過するとき, およびラウンドアバウトから出るときには, トレーラーはトラクターとは異なる軌跡を描くため, 特別な注意を払う必要があります."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "ラウンドアバウトに入る"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "ラウンドアバウトを通行する"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "ラウンドアバウトを通行する"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "ラウンドアバウトから出る"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "指定のエリアへ進む"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "ヨーロッパの道路ではラウンドアバウトが非常に一般的なので, その走り方を知っておくことが大切です."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "ラウンドアバウトに近づくときは, 車両を車線の外側に寄せます. これにより, 進入時のカーブでトレーラーが内側に接触するのを防げます."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "ラウンドアバウトに入るときは, 中央に向かって進みます. 中に入ったら, 今度は外側に向かう必要があります. これはトレーラーをラウンドアバウトの中心から遠ざけるためです."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "ミラーをよく見て, トレーラーが内側のバリケードに近づきすぎていないか確認しましょう."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "トレーラーはすでに出口の内側から離れた位置にあるため, ラウンドアバウトを出るのは比較的簡単です. 出口で大きく旋回すれば, トレーラーはうまくついてきます."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "指定のエリアに駐車し, トラックを固定します."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "前方に, 走行練習用のラウンドアバウトがあります. <br><br><font face=/font/big_bold.font>ゆっくりとラウンドアバウトに近づきます. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "ラウンドアバウトに入るときは大回りしてください. そうするとトレーラーが問題なくついてきます.<br><br><font face=/font/big_bold.font>ラウンドアバウトに進入します. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "ラウンドアバウトの外側に向かって走行します. トレーラーを中央のバリケードに近づかないよう, トラックをラウンドアバウトの中心からできるだけ遠ざける必要があります. <br><br><font face=/font/big_bold.font>そのままラウンドアバウトを走行します.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "外側のロードコーンの近くに留まります. <br><br><font face=/font/big_bold.font>走行を続けます.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>ラウンドアバウトを出ます.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>前方の駐車スポットに進みます.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>指定のエリアで停止します.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>トラックを固定し, エンジンを切ります.</font>"
#@}

#+ Book 1 Scenario 3_12
