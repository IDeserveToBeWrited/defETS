#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "このチャプターの最後のシナリオでは, 複雑な構成のテストコースを走行します."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "最初の障害は, いくつかのバリアを通過するスラロームです. 通過する際は, ミラーの活用を忘れずに."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "次はヘアピンターンです. 大回りでスペースを広くとって走れば問題ないでしょう."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "ここには90度の左ターンがあります. トラックの後部が内側のバリアをクリアできるように, 奥まで進入することを忘れずに."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "ランプの障害物は少し厄介です. 障害物に進入する前に, できるだけ自分の位置を確認し, フロントミラーとサイドミラーで方向を確認しましょう."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "次の区間は逆のことをしなければなりません. そのことを念頭に置いて, 前方のバリアにアプローチします."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "ロードマーキングに沿って奥へ進み, 右手へ進みます."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "バリアまで後退し, 停止して左方向に進みます."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "中央分離帯の切れ目を通って次の区間に進みます."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "ロードコーンを通るこの通路は非常に狭いです. ゆっくり走行し, ミラーを活用して通路内での自分の位置を確認しましょう."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "90度のターンでは, 深く進入することを忘れないように."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "開けた道路区間に差し掛かっています. スピードを上げても良いですが, この先のカーブではすぐに減速する必要があることに留意しましょう."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "坂の下には道路を横断するバリアがあります. そこまで進み, 左側の駐車スポットに後退で進入します."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "駐車スポットに後退します."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "駐車したら, エンジンを切ってトラックを固定します."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "目の前にはバリアでできたスラロームがあります.<br><br><font face=/font/big_bold.font>スラロームを通過する.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "トラクターの後部が縁石を乗り越えないように, コーナーの外側を走行します.<br><br><font face=/font/big_bold.font>曲がる. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "90度の左ターンが近づいています. 利用可能なスペースをすべて使用することを忘れないように.<br><br><font face=/font/big_bold.font>曲がる. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "ランプに向きを合わせます. ランプに乗った後では, 修正する余地はほとんどありません.<br><br><font face=/font/big_bold.font>ランプを乗り越える. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>コースに沿って左へ進む. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "次の区間は後退で完了しなければなりません. 前方のバリアで停止し, その後右方向に後退できるようにします.<br><br><font face=/font/big_bold.font>バリアで停止する.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "後方右側のエリアに向かって後退します. 道路上には目印となる矢印があります.<br><br><font face=/font/big_bold.font>次の区間に向かって後退する. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>後ろのバリアに向かって後退し続ける.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "停止して前進ギアに入れ替えたら、左に進みます. <br><br><font face=/font/big_bold.font>前進する. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "左側の中央分離帯に切れ目があります. そこを通り抜けます.<br><br><font face=/font/big_bold.font>続行する. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "目の前にはロードコーンがいくつかある狭く曲がりくねった通路があります. 慎重に走行し, 必要に応じてミラーを活用しましょう.<br><br><font face=/font/big_bold.font>ロードコーンを通過する. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "引き続き, コースを進みます.<br><br><font face=/font/big_bold.font>左へ曲がる. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "できるだけ広いスペースを確保するために, 曲がる前に必ず左側に寄りましょう.<br><br><font face=/font/big_bold.font>曲がる. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>運転を続ける. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "ここでスピードを上げることもできますが, この先にはカーブがあります.<br><br><font face=/font/big_bold.font>コースに沿って進む. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "カーブは進むにつれて鋭くなっていきます.<br><br><font face=/font/big_bold.font>必要に応じて速度を調整し, 続行する.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "坂の下には道路を塞ぐバリアがあります. <br><br><font face=/font/big_bold.font>バリアの近くで停止する. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "後方左側に駐車スポットがあります.<br><br><font face=/font/big_bold.font>駐車スポットへ向けて後退する. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>マークされた場所で停止する. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "ハンドリングコースでの走行"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "このシナリオでは, さまざまな種類のカーブやコーナーでトラックを操る能力をテストするために設計されたコースをドライブします."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "コースに入る"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "緩やかな左ターン"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "S字カーブの走行"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "ストレート区間"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "簡単なターン"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "トレーニングコースを出る"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "駐車スポットへのアプローチ"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "このシナリオでは, トラクターユニットを少し運転して, 新しく習得したスキルでどのように操作できるかを確認しましょう."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "コースにはさまざまな種類と組み合わせのターンがあります. これはレースではなく, タイムアタックでもありません. 忍耐強く, そして遭遇するターンや障害物に合わせて速度を調整してください."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "コースの始めは緩やかで簡単ですが, 進むにつれてターンが複雑になっていきます."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "速度に注意しましょう; スピードを上げすぎて, ターンの判断を誤る可能性が高くなります."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "コースの出口は非常にタイトなヘアピンターンです. ゆっくり走り, 利用できるスペースを最大限に活用してください."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "バリアの間に駐車し, トラックを固定します."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "このシナリオを正常に完了するには, クラッシュしたり, コースアウトしたり, ロードコーンにぶつかったりしてはいけません.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>前方に進み, 鋭角に右へ曲がってコースに入る. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>ほど良い一定の速度でターンを通過する. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "より複雑な曲がりくねった区間に近づいています.<br><br><font face=/font/big_bold.font>必要に応じて速度を調整し, 続行する.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>次の一連のターンに向かって進む.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "簡単で穏やかなターンがいくつかあります. 一定の速度を保ちます.<br><br><font face=/font/big_bold.font>運転を続ける. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "コースの出口は鋭いヘアピンターンです. 速度を落として, 曲がる前に外側に寄ります. ミラーを活用すること!<br><br><font face=/font/big_bold.font>コースから出る. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "前方にはバリアの間に駐車スポットがあります.<br><br><font face=/font/big_bold.font>駐車スポットに向かって進む. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "縦列駐車"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "このシナリオでは, 他の2台のトラックの間に縦列駐車する方法を見てみましょう."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "駐車スポットの前で停止する"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "バックミラーの確認"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "駐車スポットに後退する"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "駐車スポット内でのトラックの位置合わせ"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "縦列駐車はすべてのトラック運転手が知っておくべき重要なスキルです.<br>出発の準備をします."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "駐車スポットに向かって走行します.<br>周囲に注意を払いましょう."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "駐車スポットの前にあるトラックに自分の位置を合わせます. トラックに近づきすぎず, 作業スペースを確保するためにある程度の距離を保ちます."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "スペースに向かって鋭く旋回し, 後退を開始します."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "運転席側のミラーを見るときは, 後ろのトラックのすぐ前の縁石を狙います."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "フロントバンパーが前方のトラックをクリアしたら, トラックの前端を駐車スポットに合わせ, ステアリングを切り始めることができます."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "車輪を真っ直ぐにし, トラックを駐車スポットの中央に配置します.<br>トラックを駐車して固定します."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "前方にトラックが数台駐車しています. 駐車できる空きスペースが一つ残っています.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "周囲の状況に注意することを忘れないように. この操作の間中, ミラーを十分に活用しましょう.<br><br><font face=/font/big_bold.font>前進する. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>駐車スポットを通り過ぎてから, マークされたエリアに入ります. そこから後退操作を開始できます.<br><br><font face=/font/big_bold.font>マークされたスポットで停止する. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "周囲に障害物がないか確認し, 後退できるかどうかを確認しましょう.<br><br><font face=/font/big_bold.font>助手席側のミラーを見る. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "ステアリングを切って, 駐車スポットに後退します.<br><br><font face=/font/big_bold.font>後退を開始する. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "適切なタイミングでトラックをまっすぐにします. 縁石に乗り上げないように!<br><br><font face=/font/big_bold.font>トラックを駐車スポットに合わせる. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "トレーラーの接続"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "このシナリオでは, トラクターユニットをトレーラーに接続および切り離す際の基本について説明します."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "トレーラーへの後退"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "トレーラーの接続"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "パーキングブレーキの解除"





	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "トレーラーの切り離し"


	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "トレーラーの切り離し"



	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "トレーラーの切り離し"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "指定のエリアで停止する"
#!{

	key[]: "aca_goal_book1_3_01_check_discon"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_01_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_disc6"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_stop5"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_01_park_br_off3"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_parking_brake5"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"
 #!}


#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "このシナリオでは, 初めてのトレーラーの接続と切り離しを試みます. トラックの出発を準備し, 後ろのトレーラーの下へ潜り込ませるように後退します."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "トレーラーを接続して, 前方に引っ張ります."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "マークされたエリアで停止します."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "トレーラーを切り離して, 前方に引っ張ります."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "駐車スポットで停止し, トラックを固定します."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "このシナリオでは, トラクターとトレーラーの接続と切り離しの手順についてお話します. これはトラック運転手が現実世界で行うことに比べると簡略化された手順となります. <br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "トラクター ユニットの後ろにはトレーラーがあります. トレーラーの下をゆっくりと後退し, 第五輪がキングピンに当たるまで進みます. 現在, トラックは正しく位置合わせされているため, ステアリング操作は不要で, ただまっすぐ後退するだけです.<br><br><font face=/font/big_bold.font>接続を感じるまでゆっくりと後退する. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "第五輪がキングピンに連結されました.<br><br><font face=/font/big_bold.font>パーキングブレーキをかけてトラックを固定する. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "現実世界では, 第五輪が自動的にキングピンをロックし, その後, トラック運転手は車両から降りてランディングギアを格納し, エアと電気のラインを接続する必要があります. <br><br><font face=/font/big_bold.font>私たちの場合は, @@imv_nrm_attach@@ を押すだけでトレーラーが接続されます. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "トラクターがトレーラーに安全に接続されたので, 前進する準備が整いました. 車両がかなり長く重くなり, 操作に新しいスキルが必要になることに注意しましょう. <br><br><font face=/font/big_bold.font>パーキングブレーキを解除し, 前進する準備をする. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "前進します.<br><br><font face=/font/big_bold.font>前方のマークされたエリアで停止する. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>パーキングブレーキをかける. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>パーキングブレーキをかける. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "もう一度言いますが, 現実世界では, トラック運転手は車両から降りてランディングギアを降ろし, エアと電気のラインを外して, 第五輪のロック機構を解除する必要があります. <br><br><font face=/font/big_bold.font>ゲームではこのプロセスは簡略化されているため, @@imv_nrm_attach@@ を押すだけでトレーラーが切り離されます. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>パーキングブレーキを解除する. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "トラクターをトレーラーの下から引き出して前進します.<br><br><font face=/font/big_bold.font>マークされたエリアで停止する. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>マークされたエリアで停止する. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "トレーラー牽引時のブレーキング"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "このシナリオでは, トレーラーを接続した状態での運転とブレーキの感覚をつかむことができます."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "出発する"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "坂を下る"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "速度 60 Km/h (37 mph) に到達する"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "ブレーキをかける"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
