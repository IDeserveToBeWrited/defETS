	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "このシナリオでは, ブラインドサイド (助手席側) への後退操作を用いて, 狭い場所で方向転換する方法について学びます. このスキルは, 運転席側で U ターンや後退ができない場合に役立ちます."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "路面の表示に従ってトレーニングコースを進んでいきましょう."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "トレーラーが駐車中のトラックを避けられるように, 大回りで曲がります."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "ターンを終える際, 次の後退操作に向けてトラックをどう配置するかを考えてください."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "後退で進入する助手席側の空き駐車スポットに対して, トラックを斜めに向けておくと操作しやすくなります."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "助手席側への後退は視界が著しく悪くなるため, 可能な限り避けるべきですが, 残念ながらそうせざるを得ない場合もあるでしょう."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "後退する前にステアリングを操作します. そうすることでトレーラーをすぐに目的の方向へ向けることができるため, 非常に狭い場所で有効です."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "トレーラーが所定の位置に着いたら, トラクターをトレーラーの前に合わせ, 車体をまっすぐにします."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "車体がまっすぐになり, 再発進するための十分なスペースができたら停止します. 来た時と同じ道を戻り始めましょう."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "路面の表示に従ってトレーニングコースを出ます."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "前方のカーブを抜けて指定エリアまで進みます."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "停止します."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "トラックを固定し, エンジンを切ります."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "前方には, 会社の駐車場を模したトレーニングコースがあります. 今回の課題は, コースの中に入ってトラックを方向転換させ, 再び戻ってくることです. 周囲のスペースを最大限に活用するようにしましょう.<br><br><font face=/font/big_bold.font>発進の準備をします. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>トレーニングコースに向かって進みます. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>コーナーを曲がってコースを進みます. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "コースの終わりにあるバリケードまで路面の表示に従って進みます. トレーラーが助手席側の空いている駐車スポットに向くように, 少し斜めに駐車します.<br><br><font face=/font/big_bold.font>前進を続けます. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "助手席側の後退では, 周囲の状況が非常に見えにくくなります. ゆっくり進み, ミラーを活用して慎重すぎるくらいに運転しましょう.<br><br><font face=/font/big_bold.font>後退を開始し, トレーラーを空いている駐車スポットに入れます. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "十分でしょう. これで前進して, 来た時と同じ方向からトレーニングコースを出ることができます.<br><br><font face=/font/big_bold.font>出口に向かって進みます. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>トレーニングコースを出ます. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "路面の表示に従って最終地点の駐車スポットまで進みます.<br><br><font face=/font/big_bold.font>指定のエリアへ進みます. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "オフセット後退操作"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "このシナリオでは, 真後ろではなくずれた位置にある駐車スポットに後退で駐車します. スペースが限られているため, 空間を賢く活用する必要があります."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

