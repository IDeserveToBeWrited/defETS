	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "このシナリオでは, 隣のスペースに駐車することが課題となります. 操縦できるスペースはあまりないので, トレーラーを目的の場所に移動させるには少し追加の作業を行う必要があるでしょう."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "バリアまでまっすぐ進みます."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "バリアの前で停止します."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "動き出す前に, ステアリングを運転席側に大きく切ります. こうすることで, 後退を開始するとすぐにトレーラーを駐車スペースの方向に向けることができ, 貴重なスペースを節約できます."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "トレーラーを目的の場所に向けたら, トラクターをトレーラーの前に置き, 駐車スポットに向けてステアリングを切り始めます."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "ここからは, 通常の駐車操作とそれほど変わりません."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "後退を続けながら両側に注意します. トラクターとトレーラーを駐車スポットにまっすぐ並べます."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "指定のエリアで停止し, トラックを固定してエンジンを切ります."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "現在駐車場にいますが, 右側に別の駐車スポットがあるので, そこに移動する必要があります.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "目の前にマークされたエリアがあります.<br><br><font face=/font/big_bold.font>前進する. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "スペースがあまりないため, すぐにステアリングを切り始めることを忘れないように.<br><br><font face=/font/big_bold.font>後ろのマークされた場所まで後退する. </font>"


#@}

