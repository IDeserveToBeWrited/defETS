	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "カメラコントロール"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "このシナリオでは, 利用可能なさまざまなタイプのカメラと, それらがトラックのコントロールと操縦にどのように役立つかを学びます."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "シートポジション"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "後方の眺め"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "ミラーの確認"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "外部カメラへの切り替え"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "トラックの周りを見る"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "このシナリオでは, 利用可能なさまざまなカメラについて見ていきます.<br>"

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "選択できるカメラは全部で7台あります.<br>ここではそのうちのいくつかを取り上げ, それぞれの機能について説明します."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "さまざまなカメラとそれらの異なるアングルは, 狭い場所での操縦に役立ちます."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "自分がどこに向かっているのかを確認することは, 安全でプロフェッショナルな運転の核となる基盤です. 現在のシートポジションが合わない場合は \"@@adjust_link_t@@\" で変更できます (一時停止メニューからアクセス).<br><br><font face=/font/big_bold.font>準備ができたら @@imv_nrm_activate@@ を押して確認.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "後退する時, ミラーはいつもクリアな視界を提供してくれるとは限りません. より良い視界を得るために, 窓の外を振り返って見る必要があるかもしれません.<br><br><font face=/font/big_bold.font>カメラを運転席側に向け, 窓の外からトレーラーの後方を見てみましょう.</font>@@aca_goal_tip@@ インテリア視点である必要があります."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "この視点は, トレーラー牽引時の後退操作中にトレーラーを確認するために使用します. この視点を活用できるように, 常に運転席側に後退するのが良いでしょう. 助手席側へ後退する場合, 後ろで何が起こっているのか, 確認するための視界はずっと限られます.<br><br><font face=/font/big_bold.font>助手席側を見る.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "このため, 通常は助手席側への後退は推奨されません; ご覧の通り, 視界がかなり限られていることがわかります. 幸いなことに, 外部カメラが7台も用意されていて活用することができます.<br><br>@@imv_nrm_camcycle@@ を押して次のカメラに順番に切り替えることができます. 7台のカメラをすべて循環させると, サイクルの最初に戻ります.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@ を押して次のカメラに切り替え.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "外部カメラは, トラックの周囲で何が起こっているかを最もよく把握できます.<br><br><font face=/font/big_bold.font>トラックの周りを見回す.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_camcycle@@ をもう一度押し, 次のカメラに切り替え.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "トップダウン視点はトラック周辺の状況を見渡しやすく, 狭い場所での駐車や運転が大幅に簡単になります.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@ を押して次のカメラに切り替え.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "ルーフカメラは, トラックのはるか前方の道路を遮るものなく鮮明に映し出します.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@ を押し, ここで確認する最後のカメラに切り替え.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "リアビューは, 先ほど車内カメラを動かして見えた景色へのショートカットです. すでに説明した通り, 後退や駐車の際に役立ちます.<br><br>ゲームでは @@imv_nrm_camcycle@@ を繰り返し押すことで, 他のカメラを試すこともできます.<br><br><font face=/font/big_bold.font>@@imv_nrm_cam1@@ を押してインテリア視点に戻る.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "本格的なドライビングスクールを体験するには, 各シナリオを進める際に \"インテリア視点\" を使用されることをお勧めします.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押して確定し, シナリオを終了する.</font>@@aca_goal_tip@@ @@o_im_cam_zoom@@ 機能を使えば、周囲の状況をより良く見ることができます. 特にミラー越しに見るときに役立ちます. オプション画面 - \"キー & ボタン\" で, 対応するコントロールの確認や変更ができます."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "初めての運転"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "このシナリオでは, トラックを運転できるように準備し, 初めて前進させる方法を学びます."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "イグニッションをオンにする"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "エンジンを始動する"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "周囲の状況確認"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "フットブレーキを踏む"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "ギアを入れる"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "パーキングブレーキの解除"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "前進する"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "停止する"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "パーキングブレーキをかける"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "ニュートラルに戻す"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "エンジンを切る"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "最初の数回はトラクターユニットのみを使用します.<br>トラック自体に貨物用のボディがなく, 代わりにトレーラーを使用して商品や資材を輸送する場合, そのトラックはトラクターと呼ばれます."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "トラクターが普及しているのは汎用性が高いためです: 空のトレーラーを切り離して, 積み込みを待つことなく積載済みのトレーラーを接続したり, まったく別の種類のトレーラーに切り替えたりすることができます."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "初めての運転では, 前進して破線を超えた後で停止することが課題となります.<br>エンジンを始動し, 指示に従ってトラックを移動させる準備をします. 準備ができたらまっすぐに進みます."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "破線を越えて停止し, トラックを固定してエンジンを切ります."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "トレーニングの次のステップでは, 初めてトラックを動かします.<br><br>もちろん, エンジンが掛かっていないと動きませんので, まずはイグニッションをオンにする必要があります.<br><br><font face=/font/big_bold.font>$input engineelect$ を押してイグニッションをオンにする.</font>@@aca_goal_tip@@ キャリアモードでは, デフォルトで電気と一緒にエンジンも自動的に始動します. この動作の振る舞いはオプション画面 - \"ゲームプレイ\" - @@auto_engine_start@@ で調節できます."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "イグニッションはトラックの電子機器を作動させます. ダッシュボードの警告ランプが点滅していることにお気づきかもしれませんが, これは正常な状態です. エンジンを始動しても点灯・点滅したままの場合は, トラックに問題がある可能性があります. 例外はパーキングブレーキランプで, パーキングブレーキを解除すると消灯します.<br><br>幸いなことに, このトラックのコンディションは良好で, 次に進む準備はできています.<br><br><font face=/font/big_bold.font>@@imv_nrm_engine@@ を押してエンジンを始動する.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "エンジンが始動したら, 動き出す前に周囲の状況を確認することが重要です.<br><br><font face=/font/big_bold.font>トラックの周囲を見渡し, 運転席側および助手席側のサイドミラーを見て, トラックの周囲に異常がないことを確認する.</font>@@aca_goal_tip@@ インテリア視点である必要があります."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "当たり前のことのように思えるかもしれませんが, 動き出す前に停止する方法を知っておく必要があります.<br><br><font face=/font/big_bold.font>$input backward$ を使用してフットブレーキを作動させる. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>簡素化されたオートマチックトランスミッションにより, ギアを切り替える必要はなく, すべてが自動的に行われます.<font face=/font/big_bold.font><br><br>$input forward$ を使用して前進用ギアを作動させる. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>リアル・オートマチックトランスミッションは, 本物のオートマチックトランスミッションと同じように, ドライブ・ニュートラル・リバースの間でシフトチェンジができます.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@ を使用して前進用ギアを作動させる. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>シーケンシャルトランスミッションは, 本物のシーケンシャルトランスミッションと同様に段階的な変速を可能にします.<br><br>前進ギアを入れるのと同じように, 加速中はより高いギアに順次変速する必要があります.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@ を使用してギアを1速に入れる. </font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "次に, 進行方向の変え方を学びます.<br><br>ギアスティックとクラッチを使えば, 本物のマニュアルトランスミッションと同じように, 物理的にギアを変速する感覚を味わうことができます.<br><br>クラッチとフットブレーキを完全に踏み込みます.<font face=/font/big_bold.font>ギアスティックを動かして1速に入れる.<color value=@@clr_txt@@>クラッチとフットブレーキは完全に踏み込んだままです.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "動き出すには, まずパーキングブレーキを解除する必要があります.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ を押してパーキングブレーキを解除する.</font> @@aca_goal_tip@@ キャリアモードでは, パーキングブレーキは初期状態では無効になっています. この動作の振る舞いはオプション画面 - \"ゲームプレイ\" - @@auto_park_brake@@ で調節できます."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>アクセル: $input forward$ を使用して移動を開始する</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>アクセル: $input forward$ を使用して移動を開始する</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>アクセル: $input forward$ を使用して移動を開始する</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "これでトラックを前進させる準備ができました. 動き出して破線を越えます.<br><br><font face=/font/big_bold.font>フットブレーキを解除し, クラッチを徐々に離して繋ぎながら, トラックがエンストしないようにアクセルを使って回転数を維持します. クラッチが完全に切れたら, 必要に応じて加速およびシフトアップすることができます.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "フットブレーキを使って停止します.<br><br><font face=/font/big_bold.font>$input backward$ を使用してトラックを停止させる. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "フットブレーキを使って停止します.<br><br><font face=/font/big_bold.font>$input backward$ を使用してトラックを停止させる. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "フットブレーキを使って停止します.<br><br><font face=/font/big_bold.font>$input backward$ を使用してトラックを停止させる. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "停止するときはクラッチを完全に踏み込みます. <font face=/font/big_bold.font>その後, フットブレーキを使用してトラックを停止させます.<color value=@@clr_txt@@> ギアスティックを動かしてニュートラルに変速し, クラッチを離します.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "次にトラックを固定します. パーキングブレーキは駐車後にトラックが不用意に動かないようにするものです.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ を押してパーキングブレーキを作動させる.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "簡素化されたオートマチックトランスミッションにより, ギアを切り替える必要がなくなり, すべてが自動的に行われます.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押して確認.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをニュートラルに戻す. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをニュートラルに戻す. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>ギアスティックをニュートラルに戻し, クラッチを離す. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "これでトラックを動かす方法と安全に停止させる方法がわかりました.<br><br><font face=/font/big_bold.font>$input engineelect$ を押してエンジンを切る. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "後退する"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "このシナリオでは, 初めて後退に挑戦します. また, 後方を確認するためのミラーの活用法, 注意すべき点や, 後退動作の準備方法についてもお話しします."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "エンジンを始動する"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "助手席側サイドミラーの確認"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "運転席側サイドミラーの確認"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "ギアを入れる"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "パーキングブレーキの解除"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "ニュートラルに戻す"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "エンジンを切る"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "この運転では直線で後退します. 破線を通り過ぎたら, そこで止まります."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "トラックを後退させる時は常に周囲を見渡し, すべてのミラーを観察し, 周囲と後方のスペースに障害がないことを確認することが重要です."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "エンジンを始動し, ギアをリバースに入れて動き始めます."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "破線を越えて停止し, トラックを固定してエンジンを切ります."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "前のシナリオで学んだように, トラックを運転できるように準備します.<br><br><font face=/font/big_bold.font>準備ができたらエンジンを始動する. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "ミラーを確認して, 周囲が安全であることを確認します. ミラーの位置に満足できない場合は '@@adjust_link_t@@' で調整できます.<br><br><font face=/font/big_bold.font>助手席側のミラーを見る.</font>@@aca_goal_tip@@ インテリア視点である必要があります."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "破線を超えて進みます. これで車線はクリアになりましたが, 通常の運転では周囲を見回したりミラーを使ったりして, 常に周囲を観察することが重要です.<br><br><font face=/font/big_bold.font>運転席側のミラーを確認する.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>$input backward$ を使用してギアをリバースに入れる. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. オプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをリバースに入れる. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. オプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ を押してギアをリバースに入れる. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. オプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>クラッチを完全に踏み込み, ギアスティックをリバースに入れる. </font>@@aca_goal_tip@@ ほとんどのトラックでは, 後退時にバックアップアラームが自動的に作動します. オプション画面 - \"オーディオ\" - @@sound_of_reverse@@ でオフにできます."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "これでリバースギアが作動しました.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ を押してパーキングブレーキを解除する. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "$input backward$ を使用して動き始めます.<br><br><font face=/font/big_bold.font>後退して破線を超える. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "アクセル: $input forward$ を使用して動き始めます.<br><br><font face=/font/big_bold.font>後退して破線を超える. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "アクセル: $input forward$ を使用して動き始めます.<br><br><font face=/font/big_bold.font>後退して破線を超える. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "アクセルを使ってエンジンの回転数を維持しながら, クラッチをゆっくり離します.<br><br><font face=/font/big_bold.font>後退して破線を超える. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>フットブレーキ: $input forward$ を使用してトラックを停止させる. </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>フットブレーキ: $input backward$ を使用してトラックを停止させる.</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>フットブレーキ: $input backward$ を使用してトラックを停止させる.</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>クラッチを完全に踏み込み, フットブレーキを使用してトラックを停止させる. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_parkingbrake@ を押してパーキングブレーキをかける. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "簡素化されたオートマチックトランスミッションでは, 現実とは異なり, すべてが自動的に行われるため, ギアを変速する必要はありません.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@ を押して確認.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_gearup@@ を押してギアをニュートラルに戻す.</font>@@aca_goal_tip@@ 最近のトラックは, パーキングブレーキを作動させると自動的にニュートラルに戻ります. ただし, 常に自分自身で行うことをお勧めします. 次のシナリオでは, この手順は必要ありません."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_gearup@@ を押してギアをニュートラルに戻す.</font>@@aca_goal_tip@@ 最近のトラックは, パーキングブレーキを作動させると自動的にニュートラルに戻ります. ただし, 常に自分自身で行うことをお勧めします. 次のシナリオでは, この手順は必要ありません."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>ギアスティックをニュートラルに戻し, クラッチを離す.</font>@@aca_goal_tip@@ 最近のトラックは, パーキングブレーキを作動させると自動的にニュートラルに戻ります. ただし, 常に自分自身で行うことをお勧めします. 次のシナリオでは, この手順は必要ありません."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "特に交通量の多い混雑した場所では, 後退する際には常に周囲に注意を払いましょう.<br><br><font face=/font/big_bold.font>$input engineelect$ を押してエンジンを切る. </font>"
#@}

# Scenario 1_05 formatting
#!{
	key[]: "aca_msg_book1_1_05_low_beam_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/parking_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_high_beam_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/low_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_high_beam_off_img"
