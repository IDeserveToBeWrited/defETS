 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "このシナリオでは, トラックを少し運転します. この先の坂を下りながら, トレーラー牽引時のブレーキングの感覚をつかむことができるでしょう. トラックを準備して出発します."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "少なくとも速度 60 km/h (37 mph) に達します. 前方のブレーキングゾーンに備えましょう."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "ブレーキングを開始して停止します. あまり長く待ちすぎると, 前方のバリアにぶつかる可能性があるので注意しましょう!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "指定のエリアに駐車し, トラックを固定してエンジンを切ります."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "この運転では, 下り坂を下るときにフットブレーキを使用する感覚をつかみます. この訓練の目的は, 背後の重量とそれが車両の制動距離にどのような影響を与えるかを認識することです.<br><br><font face=/font/big_bold.font>出発の準備をする. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "運転を始めます. 速度 60 km/h (37 mph) に達する必要があることに注意しましょう.<br><br><font face=/font/big_bold.font>ターンを通過する. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>坂を下りながら加速を続ける. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>少なくとも速度 60 km/h (37 mph) に到達する. </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "必要な速度に達しました.<br><br><font face=/font/big_bold.font>前方のバリアで停止する. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

# Scenario formatting
#!{
	key[]: "aca_msg_book1_3_03_cutscene03_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/1st_turn.mat width=235 height=184 color=FFFFFFFF></align><offset vshift=184>"

	key[]: "aca_msg_book1_3_03_cutscene04_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/2nd_turn.mat width=235 height=200 color=FFFFFFFF></align><offset vshift=200>"

	key[]: "aca_msg_book1_3_03_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/3rd_turn.mat width=235 height=226 color=FFFFFFFF></align><offset vshift=226>"

	key[]: "aca_msg_book1_3_03_cutscene03_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/1st_turn_gb.mat width=235 height=184 color=FFFFFFFF></align><offset vshift=184>"

	key[]: "aca_msg_book1_3_03_cutscene04_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/2nd_turn_gb.mat width=235 height=200 color=FFFFFFFF></align><offset vshift=200>"

	key[]: "aca_msg_book1_3_03_cutscene07_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/3rd_turn_gb.mat width=235 height=226 color=FFFFFFFF></align><offset vshift=226>"
