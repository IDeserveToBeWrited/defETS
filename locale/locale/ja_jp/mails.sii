SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "システム" #+ Message sender
		subject: "テストメッセージ" #+ Message subject
		body: "こんにちは!<br><br>これは仲間の管理者からのテストメッセージです ;-)<br><br>ではまた!" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "銀行" #+ Message sender
		subject: "資金が必要ですか? お手伝いできます!" #+ Message subject
		body: "拝啓<br><br>当行では, 新規事業向けに好条件での融資をご案内しております. 事業運営のための資金にお困りでしたら, 当行がサポートいたします! 詳しくは $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>ローカルバンキングセンター</link>までお越しください.<br><br>敬具<br>セールスマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "銀行" #+ Message sender
		subject: "成長のお手伝い" #+ Message subject
		body: "拝啓<br><br>お客様の安定した業績を拝見し, さらなる事業発展のお力添えができればと考えております. つきましては, お客様への融資限度額を $MONEY$ に増額いたしました. 資金が必要な際は, どうぞお気軽に$SHORTCUT1$<link url=screen.bank color=@@clr_link@@>ローカルバンキングセンター<link url=screen.bank color=@@clr_link@@>をご利用ください.<br><br>敬具<br>セールスマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "銀行" #+ Message sender
		subject: "口座残高不足のお知らせ" #+ Message subject
		body: "拝啓<br><br>お客様の口座残高を超えるお引き出しが行われました. この状況に対応できるよう, 数日間は無利息にてご利用いただける一時的な融資をご用意いたしました. つきましては, できるだけ早く不足分をご入金いただけますようお願いいたします.<br><br>敬具<br>アカウントマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "銀行" #+ Message sender
		subject: "未返済の借り入れについて" #+ Message subject
		body: "拝啓<br><br>お客様の口座残高が不足しております! つきましては, $DAYS$ 以内にお支払いください. お支払いいただけない場合は, 資産の差し押さえ等の措置を取らせていただきます.<br><br>敬具<br>アカウントマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "銀行" #+ Message sender
		subject: "最終通告" #+ Message subject
		body: "拝啓<br><br>これは最終通告です. お客様の口座は超過引き出しとなっております. 明日までにご対応いただけない場合は, 負債を補填するため, お客様の財産を差し押さえいたします. ご対応のほどよろしくお願いいたします.<br><br>敬具<br>アカウントマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "銀行" #+ Message sender
		subject: "借り越しの解消について" #+ Message subject
		body: "お客様へ<br><br>お客様の口座の借り越しが解消されたことをお知らせいたします. 今後とも, 当行のサービスが必要な際はいつでもご相談ください.<br><br>よろしくお願いいたします.<br>アカウントマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "銀行" #+ Message sender
		subject: "所有トラックの売却について" #+ Message subject
		body: "拝啓<br><br>誠に遺憾ながら, お客様の所有トラック ($TRUCK_NAME$) を $MONEY$ にて売却いたしました. 長期にわたる債務不履行が続いており, 他に返済のめどがたたないことから, やむを得ずこのような措置を講じることとなりました. 当面はクイックジョブを利用し, 財務状況の立て直しを図られることをおすすめいたします.<br><br>敬具<br>アカウントマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "銀行" #+ Message sender
		subject: "所有トレーラーの売却について" #+ Message subject
		body: "拝啓<br><br>誠に遺憾ながら, お客様の所有トレーラー ($TRAILER_NAME$) を $MONEY$ にて売却いたしました. 長期にわたる債務不履行が続いており, 他に返済のめどがたたないことから, やむを得ずこのような措置を講じることとなりました. 当面はクイックジョブを利用し, 財務状況の立て直しを図られることをお勧めいたします.<br><br>敬具<br>アカウントマネージャー<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "銀行" #+ Message sender
		subject: "お客様の資産の売却について" #+ Message subject
		body: "拝啓<br><br>多額の負債が長期にわたって解消されなかったため, お客様の所有資産を売却いたしました. 回収された資金は総額 <br>$MONEY$ となり, 債務整理に充当されました. 差し押さえの対象となった資産の内訳は以下の通りです:<br><br>$ITEM_LIST$<br>このような深刻な状況になったことは大変遺憾です. この状況が今後の事業再建の妨げとならないよう切に願っております.<br><br>お客様の今後のご活躍を心よりお祈り申し上げます.<br>アカウントマネージャー<br>銀行" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "トラックディーラー - $CITY$" #+ Message sender
		subject: "$BRAND$ の新車を販売中です!" #+ Message subject
		body: "拝啓<br><br>当店は $BRAND$ トラックの正規販売店です. 多彩な仕様のラインナップを取りそろえているほか, 特別なご要望にお応えするカスタマイズもお引き受けいたしております. ぜひ, $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>$CITY$ のショールームへお越しください</link>. 夢にまで見たトラックがきっと見つかるはずです.<br><br>敬具<br>$BRAND$ トラックディーラー" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "中古トラック販売店" #+ Message sender
		subject: "中古トラックを販売中です!" #+ Message subject
		body: "拝啓<br><br>このたび, 中古トラック販売店をオープンいたしました! 高品質な中古車をお求めなら, ぜひご利用ください! パワフルなマシンから, 信頼できる実用的な作業車まで, お客様にぴったりのトラックをご用意しております.<br><br>どうぞこちらの $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>中古トラック販売ページ</link> をご覧ください. お客様のご希望にぴったりのトラックがきっと見つかるはずです.<br><br>敬具<br><br>中古トラック販売部門<br><br>末筆ながら, 新入荷商品のチェックをお忘れなく! 在庫は常に変動していますので, 思わぬお買い得品が見つかるかもしれません." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "機材をお探しのドライバーへ" #+ Message subject
		body: "関係各位<br><br>当社は多数の配送業務のために, ご自身でトラックを所有されている熟練ドライバーを探しております. 当社は $MONEY$ もの高額報酬のお仕事をご用意いたしております. もし, ご自身で車両をお持ちでしたら, ぜひ $CITY$ の荷積場まで直接お問い合わせくださいませ.<br><br>$COMPANY$<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "ドライバー $NAME$" #+ Message sender
		subject: "仕事のためにトラックが必要です" #+ Message subject
		body: "ボス<br><br>お気づきかもしれませんが, もう $DAYS$ も何もせず $CITY$ で待機し続けています. 正直, かなり困っているんです. 毎月の支払いでお金が必要なのに, 仕事もなくただ待機しているだけでは一銭にもなりません. どうか, $DAYS2$ 以内にトラックを用意して仕事を与えてくれませんか? でないと, この会社を辞めるしかなくなってしまいます<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "ドライバー $NAME$" #+ Message sender - written by female
		subject: "仕事のためにトラックが必要です" #+ Message subject - written by female
		body: "ボス<br><br>お気づきかもしれませんが, もう $DAYS$ も何もせず $CITY$ で待機し続けています. 正直, かなり困っているんです. 毎月の支払いでお金が必要なのに, 仕事もなくただ待機しているだけでは一銭にもなりません. どうか, $DAYS2$ 以内にトラックを用意して仕事を与えてくれませんか? でないと, この会社を辞めるしかなくなってしまいます<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "ドライバー $NAME$" #+ Message sender
		subject: "お世話になりました" #+ Message subject
		body: "こんにちは<br><br>もうこれ以上時間を無駄にするわけにはいきません. トラックがなければ仕事はできないし, もう待ってもいられません. 他のチャンスを逃したくないので, 退職してよそでやってみることにしました. 私が使っていた機材は在籍していた $CITY$ のガレージにまとめてあります.<br><br>それではお元気で<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "ドライバー $NAME$" #+ Message sender - written by female
		subject: "お世話になりました" #+ Message subject - written by female
		body: "こんにちは<br><br>もうこれ以上時間を無駄にするわけにはいきません. トラックがなければ仕事はできないし, もう待ってもいられません. 他のチャンスを逃したくないので, 退職してよそでやってみることにしました. 私が使っていた機材は在籍していた $CITY$ のガレージにまとめてあります.<br><br>それではお元気で<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "ドライバー $NAME$" #+ Message sender
		subject: "担当トラックの完全修復が必要です" #+ Message subject
		body: "ボス<br><br>お忙しいところ申し訳ありませんが, 私のトラックには完全修復が必要です. 安全に運行できないほど古いですし, 損耗も酷い状態です. もう $DAYS$ も仕事をしていません. 毎月の支払いもあるのに, 走行可能なトラックがなければ稼げないし, 正直かなり困っています. どうか, 新しいトラックを買うか, このトラックを修理して仕事に戻れるようにしてくれませんか? でないと, この会社を去るしかなくなってしまいます.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "ドライバー $NAME$" #+ Message sender - written by female
		subject: "担当トラックの完全修復が必要です" #+ Message subject - written by female
		body: "ボス<br><br>お忙しいところ申し訳ありませんが, 私のトラックには完全修復が必要です. 安全に運行できないほど古いですし, 損耗も酷い状態です. もう $DAYS$ も仕事をしていません. 毎月の支払いもあるのに, 走行可能なトラックがなければ稼げないし, 正直かなり困っています. どうか, 新しいトラックを買うか, このトラックを修理して仕事に戻れるようにしてくれませんか? でないと, この会社を去るしかなくなってしまいます.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "ドライバー $NAME$" #+ Message sender
		subject: "お世話になりました" #+ Message subject
		body: "こんにちは<br><br>申し訳ないですが, 私のトラックは損耗してボロボロだし, もう待っていられません. 仕事がないうえに, 出費もかさんでいるので, ここを離れて前に進むと決めました. 余計なお世話とは思いますが, このトラックを次のドライバーに割り当てる前に完全修復することをおすすめします. 私が使っていた機材は在籍していた $CITY$ のガレージにあります.<br><br>それではお元気で.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "ドライバー $NAME$" #+ Message sender - written by female
		subject: "お世話になりました" #+ Message subject - written by female
		body: "こんにちは<br><br>申し訳ないですが, 私のトラックは損耗してボロボロだし, もう待っていられません. 仕事がないうえに, 出費もかさんでいるので, ここを離れて前に進むと決めました. 余計なお世話とは思いますが, このトラックを次のドライバーに割り当てる前に完全修復することをおすすめします. 私が使っていた機材は在籍していた $CITY$ のガレージにあります.<br><br>それではお元気で.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "ドライバー $NAME$" #+ Message sender
		subject: "退職します" #+ Message subject
		body: "ボス<br><br>所属していた $CITY$ のガレージが閉鎖されることになりました. 銀行の人が来て, 立ち退くように言われたんです. 最近, 会社の経営が良くないようなので, 退職することにしました. そもそも, トラックも何もない状態では, ここにいても力になれないですしね. 別のところでやっていくことにします.<br><br>それでは. 悪く思わないでくださいね.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "ドライバー $NAME$" #+ Message sender - written by female
		subject: "退職します" #+ Message subject - written by female
		body: "ボス<br><br>所属していた $CITY$ のガレージが閉鎖されることになりました. 銀行の人が来て, 立ち退くように言われたんです. 最近, 会社の経営が良くないようなので, 退職することにしました. そもそも, トラックも何もない状態では, ここにいても力になれないですしね. 別のところでやっていくことにします.<br><br>それでは. 悪く思わないでくださいね.<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "運行管理者" #+ Message sender
		subject: "特殊配送" #+ Message subject
		body: "ボス<br><br>特別なお話です. とある関係先のお陰で, ついに本格的な大仕事に挑めるようになりました. 本物のプロにしか運べない, 特大・超重量級の貨物です. 決して楽な仕事ではなく, スキルや忍耐力, エスコート車両との連携や細心の注意が必要になりますが, ボスならそのすべてを兼ね備えていますよね? 当然, ハイリスクな分, 見返りも大きいですよ.<br><br>もしご興味がありましたら, 以下の都市へ向かってください:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "運行管理者" #+ Message sender
		subject: "新しい特殊配送" #+ Message subject
		body: "ボス<br><br>ボスのプロとしての運転スキルを特殊輸送に貸してほしいという会社が増えています. 前回お伝えした通り, 簡単な仕事ではありません. スキルや忍耐力, エスコート車両との連携や細心の注意が必要になります. ただ, ボスならそのすべてを兼ね備えているはずです. もちろん, こうした貨物の配送では, 高い利益が得られます.<br><br>以下の都市では, すでに特殊配送の受託が可能です:<br><br>$OLD_CITIES$<br><br>今回, 以下の都市で<color value=@@clr_sel@@>新しい仕事<color value=@@clr_txt@@>を請けることができるようになりました:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "不動産仲介会社" #+ Message sender
		subject: "会社の拡大を検討されていますか?" #+ Message subject
		body: "拝啓<br><br>貴社がますますの発展を遂げられていること, 心よりお喜び申し上げます. 目覚ましい事業拡大をさらに後押しすべく, 新たなサービスをご用意いたしました. 今後は, 当社サービスを利用することで, ほぼ瞬時に物件をご購入いただけます. 詳細につきましては $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>ガレージ購入画面</link> をご確認ください..<br><br>敬具<br>窓口担当<br>不動産仲介会社" #+ Message body
	}
	
#@}
}