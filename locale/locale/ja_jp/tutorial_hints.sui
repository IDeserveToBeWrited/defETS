
    key[]: "hint_engine_title"
	val[]: "エンジンの始動"

    key[]: "hint_engine_text"
	val[]: "$KEY_engine$ を押すとエンジンが始動します."


    key[]: "hint_ignition_title"
	val[]: "イグニッションの始動"

    key[]: "hint_ignition_text"
	val[]: "$KEY_engineelect|KEY_engine$ を押すとイグニッションが始動します."


    key[]: "hint_driv_arc_title"
	val[]: "ドライビング"

    key[]: "hint_driv_arc_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$ や $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ を押して前進や後退を行います.<br><offset vshift=8>$SPECIAL_steering$ でステアリングを操作します"


    key[]: "hint_driv_auto_title"
	val[]: "ドライビング"

    key[]: "hint_driv_auto_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$ や $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ を押して前進や後退を行います.<br><offset vshift=8>$SPECIAL_steering$ でステアリングを操作します.<br><offset vshift=8>$KEY_gearup$ や $KEY_geardown$ を押すとギアが変速します."


    key[]: "hint_driv_seq_title"
	val[]: "ドライビング"

    key[]: "hint_driv_seq_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$ や $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ を押すと前進や後退を行います.<br><offset vshift=8>$SPECIAL_steering$ で操舵を行います.<br><offset vshift=8>クラッチの操作には $KEY_gearup$ や $KEY_geardown$ を押します."


    key[]: "hint_driv_hshift_title"
	val[]: "ドライビング"

    key[]: "hint_driv_hshift_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$ や $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ を押すと前進や後退を行います.<br><offset vshift=8>$SPECIAL_steering$ でステアリングを操作します.<br><offset vshift=8><color value=@@clr_sel@@>シフター<color value=@@clr_txt@@>でギアを変速します."


    key[]: "hint_depot_deliv_title"
    val[]: "目的地へのアプローチ"

    key[]: "hint_depot_deliv_text"
    val[]: "マークされたエリアに停止して, 最終作業となる駐車スポットの難易度を選択し, 対応する経験値を獲得します."


    key[]: "hint_fin_deliv_title"
    val[]: "配送の完了"

    key[]: "hint_fin_deliv_text"
    val[]: "選択した駐車スポットに駐車します. 配送地点に近づいたら, $KEY_activate$ を押すとスキップできます."


    key[]: "hint_fin_deliv2_title"
    val[]: "配送の完了"

    key[]: "hint_fin_deliv2_text"
    val[]: "選択した駐車スポットに駐車します. @@desktop_menu_category_options@@ でウィジェットを有効にすると, 駐車をスキップできます."


    key[]: "hint_lights_title"
    val[]: "ライトの点灯"

    key[]: "hint_lights_text"
    val[]: "$KEY_light$ を押すとライトが点灯します. 繰り返し押すことでモードの切り替えができます."


    key[]: "hint_high_beam_title"
    val[]: "ハイビームの切り替え"

    key[]: "hint_high_beam_text"
    val[]: "$KEY_hblight$ を押すとハイビームに切り替わります."


    key[]: "hint_wipers_title"
    val[]: "ワイパーの作動"

    key[]: "hint_wipers_text"
    val[]: "$KEY_wipers$ を押すとワイパーが作動し, 繰り返し押すことで速度を変更できます."


    key[]: "hint_zoom_title"
    val[]: "ズーム"

    key[]: "hint_zoom_text"
    val[]: "車内視点中に $KEY_camzoom$ を押すとズームします. @@desktop_menu_category_options@@ で, ズームモードを保持モードまたはトグルモードに設定できます."


    key[]: "hint_cam_int_title"
    val[]: "周りを見回す"

    key[]: "hint_cam_int_text"
    val[]: "$KEY_cam1$ を押すとカメラが車内視点に変わります."


    key[]: "hint_cam_ext_title"
    val[]: "周りを見回す"

    key[]: "hint_cam_ext_text"
    val[]: "$KEY_camcycle$ を繰り返し押すことで異なるカメラアングルに切り替えられます.<br><offset vshift=8>$KEY_cam2$ を押して外部視点に切り替えます."


    key[]: "hint_indicators_title"
    val[]: "方向指示器"

    key[]: "hint_indicators_text"
    val[]: "$KEY_lblinker$ と $KEY_rblinker$ を押すと方向指示器が作動します."


    key[]: "hint_tow_title"
    val[]: "牽引サービス"

    key[]: "hint_tow_text"
    val[]: "困難な状況から抜け出せない場合は牽引サービスを利用しましょう. 利用するには $KEY_advmouse$ で @@quick_info_word@@ メニューを開きます."


    key[]: "hint_diff_lock_title"
    val[]: "デファレンシャルロック"

    key[]: "hint_diff_lock_text"
    val[]: "動き出せない場合は, デファレンシャルロックが役に立つかもしれません. $KEY_diflock$ を押して作動させるか, @@desktop_menu_category_options@@ で自動デファレンシャルロックを有効にします."


    key[]: "hint_diff_unlock_title"
    val[]: "デファレンシャルロックが作動中"

    key[]: "hint_diff_unlock_text"
    val[]: "通常の走行時はデファレンシャルロックを解除してください. でないと損傷する恐れがあります. $KEY_diflock$ を押して解除するか, @@desktop_menu_category_options@@ で自動デファレンシャルロックを有効にします."


    key[]: "hint_wipers_off_title"
    val[]: "ワイパーの停止"

    key[]: "hint_wipers_off_text"
    val[]: "$KEY_wipers$ を押すとワイパーを止めたり, 速度を変更したりできます."


    key[]: "hint_world_map_title"
    val[]: "マップの表示"

    key[]: "hint_world_map_text"
    val[]: "$KEY_navmap$ を押すとワールドマップが開きます."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "$KEY_advmouse$ を押すと @@quick_info_word@@ が開き, 自分のステータスと便利なショートカットを確認できます."


    key[]: "hint_pause_border_title"
    val[]: "現在地の交通規制"

    key[]: "hint_pause_border_text"
    val[]: "$KEY_advmouse$ を押すと @@quick_info_word@@ が開き, 現在の地域の規制等を確認することができます."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "$KEY_advmouse$ を押すと @@quick_info_word@@ が開き, @@photo_mode_word@@ が起動して付近の @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20> を取得できます."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ 付近"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> が近くにあります. 見つけて起動するとカットシーンを閲覧できます."


    key[]: "hint_resting_title"
    val[]: "休憩所 付近"

    key[]: "hint_resting_text"
    val[]: "休憩所 <img src=/material/ui/map/parking_ico.mat width=20 height=20> は疲れを癒し, 法定休憩を取って安全に旅を続けるのに役立ちます."


    key[]: "hint_gas_title"
    val[]: "ガソリンスタンド 付近"

    key[]: "hint_gas_text"
    val[]: "ガソリンスタンド <img src=/material/ui/map/gas_ico.mat width=20 height=20> を利用することで, 車両に燃料を補給できます."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "@@desktop_menu_category_options@@ でスマートスロットル制御を有効にできます。これを有効にすると、車両はデフォルトでスロットルを低めに維持します。スロットルボタンを素早く２回押すと、ボタンを離すまで車両はフルスロットルを維持します。"
