#@{
	key[]: "screenshot_man"
	val[]: "SCREENSHOT MANAGER" #+ window title

	key[]: "screenshot_preview"
	val[]: "SCREENSHOT PREVIEW" #+ window title

	key[]: "screenshot_man_link"
