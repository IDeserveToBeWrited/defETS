#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "EYE TRACKING" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "拡張ビュー" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "拡張ビュープリセット" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "プリセット名を入力" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "選択したプリセットを削除してもよろしいですか?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "同名の既存のプリセットは上書きされます. 続行しますか?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "視線トラッキング設定" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "ヘッドトラッキング設定" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "キーボード操作" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "拡張ビューを有効化" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "オートセンターを有効化" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "ヘッドトラッキングモード" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "ダイレクト" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "ダイナミック" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "視線移動の反応感度" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "頭部位置/向きの応答性" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "ロールを有効化" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "位置を有効化" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "ヨー乗数 (キャビン)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "ピッチ乗数 (キャビン)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "ヨー乗数 (歩行モード)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "ピッチ乗数 (歩行モード)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "最大注視角" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "視線追跡速度"

	key[]: "eye_gaze_exponent"
	val[]: "視線追跡指数"

	key[]: "eye_gaze_inflection_point"
	val[]: "視線追跡変曲点"

	key[]: "eye_gaze_start_point"
	val[]: "視線追跡開始点"

	key[]: "eye_gaze_end_point"
	val[]: "視線追跡終了点"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "ヘッドトラッキングのヨー感度 (車内)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "ヘッドトラッキングのピッチ感度 (車内)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "ヘッドトラッキングのヨー感度 (歩行モード)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "ヘッドトラッキングのピッチ感度 (歩行モード)"

	key[]: "eye_head_exponent"
	val[]: "頭部追跡指数"

	key[]: "eye_head_inflection_point"
	val[]: "頭部追跡変曲点"

	key[]: "eye_head_start_point"
	val[]: "頭部追跡開始点"

	key[]: "eye_head_end_point"
