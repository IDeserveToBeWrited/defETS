#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "入力範囲を正しく認識させるため, コントローラーのサブタイプを選択します."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "トランスミッションの種類を選択します:<br>- \"シンプルオートマチック\"はアクセルとブレーキで前進と後退を操作します.<br>- \"リアルオートマチック\"は前進と後退の切り替えに入力が必要です.<br>- \"シーケンシャル\"はシフトアップ / ダウンの時にすべてのギアを手動で変速させる必要があります.<br>- \"H シフター\"はシフトゲートを備えたコントローラーを使用して手動でギアを選択する必要があります."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "オートマチックトランスミッションの変速ロジックを変更します:<br>- \"エコノミーモード\"はピークトルクに偏った低回転域を重視します.<br>- \"ハイパワーモード\"は燃費を犠牲にする代わりに, 重量貨物や山岳路での走行性能を向上させるためにピーク馬力を重視します."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "車両の実際のステアリング回転度に対する入力デバイスの回転比率を調節します."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "入力と車両のステアリングの直線性を調節します.<br><br>この値を大きく設定すると, ハンドルが中央にあるときは反応が穏やかになり, 最大角度まで回すにつれて感度が高くなります. 直進時のステアリング入力を安定させたい場合に役立ちます."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "フォースフィードバックをサポートするコントローラーで, フォースフィードバックを有効にします."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "フォースフィードバック全体の強度を 0N～10N の間で調節します.<br><br><color value=@@clr_txt_d@@>高出力のホイールベースを使用している場合, この設定を高くしすぎると指や手を怪我する恐れがありますのでご注意ください."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "90km/h (56mph) 以上でピークとなる高速走行時のセンタリング力を調節します.<br><br>最小に設定するとホイールのセンタリング力はなくなります."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "低速走行時のセンタリング力を調節します.<br><br>最小に設定するとホイールのセンタリング力はなくなります."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "機械的なステアリングコンポーネントによって引き起こされる人工的な内部摩擦の強さを調節します."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "ステアリングコラムを通じて伝わる, 擬似的なエンジンの共振の強さを調節します.<br><br><color value=@@clr_txt_d@@>この値を 15% 以上に設定すると, ホイールによっては過大な揺れや振動が発生する場合がありますので注意してください."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "ステアリングコラムによる路面への影響の強さを調節します.<br><br><color value=@@clr_txt_d@@>この値を 20% 以上に設定すると, スピードを出して不整地を走行したときに, ホイールによっては過大な揺れや振動が発生する場合がありますので注意してください."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "ステアリングコラムから伝わる, 路面の凹凸による衝撃の強さを調節します."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "ステアリングコラムから伝わる, 衝突時の衝撃の強さを調節します."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "ギアボックスのギア鳴き効果の強さを調節します."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "アンダーステアのスリップ効果の強さを調節します."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "ステアリングアシストの強さを調節します (レーンアシスト機能使用時など)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "地形表面の振動の強さを調節します. ただし, コントローラーが振動フィードバックに対応している場合のみ有効です."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "バンプ振動の強さを調節します. ただし, コントローラーが振動フィードバックに対応している場合のみ有効です."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "衝突振動の強さを調節します. ただし, コントローラーが振動フィードバックに対応している場合のみ有効です."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "ステアリングに使用するデバイス軸です."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "ステアリング軸のデッドゾーン (入力が無視される中心からの回転量) を調節します.<br><br>これにより, 摩耗や損傷による不正確な入力や誤入力など, 古いコントローラーの問題を軽減することができます."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "ゲームがステアリング軸の入力をどのように処理するかを決定します:<br>- \"センター\"はホイールやジョイスティックに最適です.<br>- \"反転\"は誤って検出された軸を修正するために使用します."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "車両を加速させるためのデバイス軸です."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "アクセル軸のデッドゾーン (入力が無視される移動量) を調節します.<br><br>これにより, 摩耗や損傷による不正確な入力や誤入力など, 古いコントローラーの問題を軽減することができます."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "ゲームがコントローラーの入力をどのように処理するかを決定します:<br>- \"センター\"はジョイスティックに最適です.<br>- \"ノーマル\"はトリガーやペダルに最適です.<br>- \"反転\"は誤って検出された入力を補正します."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "ブレーキに使用するデバイス軸です."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "ブレーキ軸のデッドゾーン (入力が無視される移動量) を調節します.<br><br>これにより, 摩耗や損傷による不正確な入力や誤入力など, 古いコントローラーの問題を軽減することができます."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "ゲームがコントローラーの入力をどのように処理するかを決定します:<br>- \"センター\"はジョイスティックに最適です.<br>- \"ノーマル\"はトリガーやペダルに最適です.<br>- \"反転\"は誤って検出された入力を補正します."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "クラッチを繋ぐためのデバイス軸です."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "クラッチ軸のデッドゾーン (入力が無視される移動量) を調節します.<br><br>これにより, 摩耗や損傷による不正確な入力や誤入力など, 古いコントローラーの問題を軽減することができます."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "ゲームがコントローラーの入力をどのように処理するかを決定します:<br>- \"センター\"はジョイスティックに最適です.<br>- \"ノーマル\"はトリガーやペダルに最適です.<br>- \"反転\"は誤って検出された入力を補正します."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "クラッチの範囲を調節します.<br><br>範囲を右に設定するほど, クラッチを繋ぐためにペダルをより踏み込む必要があります."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "カメラを上下にチルトするためのデバイス軸です."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "視界上下軸のデッドゾーン (入力が無視される移動量) を調節します.<br><br>これにより, 摩耗や損傷による不正確な入力や誤入力など, 古いコントローラーの問題を軽減することができます."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "ゲームが軸入力をどのように処理するかを決定します:<br>- \"センター\"はジョイスティックに最適です.<br>- \"反転\"は間違って検出された軸を修正するために使用します."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "カメラを左右にパンするためのデバイス軸です."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "視界左右軸のデッドゾーン (入力が無視される移動量) を調節します.<br><br>これにより, 摩耗や損傷による不正確な入力や誤入力など, 古いコントローラーの問題を軽減することができます."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "ゲームが軸入力をどのように処理するかを決定します:<br>- \"センター\"はジョイスティックに最適です.<br>- \"反転\"は間違って検出された軸を修正するために使用します."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "H シフターで使用するギアレイアウトを選択します."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "シフターの動作を変更します:<br>- \"シンプル\"オプションでは, シフト時にギアが鳴くことはありません.<br>- \"シンプル + 警告音\"オプションでは, シンプルなシフトチェンジができますが, シフトチェンジを間違えたときにギアが鳴きます.<br>- \"アドバンス\"オプションでは, シフトチェンジを間違えたときにギアチェンジはできず, ギアが鳴くだけです. \"アドバンス\"オプションでは\"シフター高速スプリット\"設定を利用することもできます."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "シフター高速スプリットの処理方法を選択します:<br>- \"使用しない\"はスプリットの切り替え時, ギアスティックを一度ニュートラルにする必要があります.<br>- \"クラッチを踏む\"はギアスティックを動かさず, クラッチを一瞬踏む必要があります.<br>- \"アクセルを離す\"はギアスティックを動かさず, アクセルを戻すだけで切り替わります. \"クラッチまたはアクセル\"は後者 2 つの組み合わせとなります."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "シフターの位置を割り当てます."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "シフターのレイアウトに基づいて, レンジ間の切り替えに使用する入力を割り当てます."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "シフターのレイアウトに基づいて, シフタースプリッターを切り替えるためのボタンを割り当てます."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "レンジまたはスプリッターの操作に, ボタンではなくスイッチを使用する場合に有効にします."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "オートマチックトランスミッションのドライブモードに切り替えるためのボタンを割り当てます."

