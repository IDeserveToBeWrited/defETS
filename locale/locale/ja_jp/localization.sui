#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "銀行" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "お金が足りない時は, いつでも銀行で融資を受けられます." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "融資申込み" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "一日あたり $MONEY$ 返済" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "借り入れ中のローン: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "借入限度額: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "借入状況一覧"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "融資" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "返済額" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "期間 (日数)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "利息 (年利)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "分割支払額" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "返済する" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "合計:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "口座残高: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NEW LOAN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "$MONEY$ の融資を申し込みます" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "返済期日:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "利息 (年利):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "一日あたりの支払額:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "申し込みを確定しますか?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "REPAY LOAN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "ローンの返済に $MONEY$ を充ててもよろしいですか?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


