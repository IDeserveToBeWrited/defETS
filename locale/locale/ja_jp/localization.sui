	key[]: "screenshotman_offline"
	val[]: "プロフィールが接続されていません.<br><br>画像をアップロードするには, プロフィールをオンラインアカウントに接続する必要があります.<br><br>今すぐプロフィールを編集しますか?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "空のスロット" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "エラー" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "選択したスロットへアップロード" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "プロフィールトラックとして使用" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "以下のスクリーンショットを完全に削除してもよろしいですか?"

	key[]: "upload_screenshot"
	val[]: "選択したスロットにスクリーンショットをアップロードしますか?<br><br>スクリーンショットスロットの以前の内容は上書きされます!"

	key[]: "upload_profile_screenshot"
	val[]: "スクリーンショットを World of Trucks プロフィールトラックとしてアップロードしますか?<br><br>以前のプロフィールトラック画像は上書きされます!"

	key[]: "wotr_upload_title"
	val[]: "UPLOAD NOTICE"

	key[]: "new_screenshot"
