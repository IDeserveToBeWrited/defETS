	key[]: "load_save_t"
	val[]: "SAVE OR LOAD GAME" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "セーブ & ロード" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "ゲーム内容の変更を検出しました. ゲームワールド内の変更に伴うセーブデータの不具合を防ぐため, 配送中の仕事は中断されました. なお, これによるペナルティは発生しません." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "ゲーム内容の変更を検出しました.<br><br>セーブデータの互換性に関する問題を防ぐため, 配送中の仕事は中断されました. なお, これによるペナルティは発生しません. トラックを安全なところへ駐車する必要があります.<br><br>続けるには, クイックトラベルの目的地を選択してください." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "セーブ中..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "$KEY$ でカットシーンをスキップ" #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
#@{

	key[]: "no_drive_t"
	val[]: "NO VEHICLE" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "運転できる車両がないため, 自由に走り回ることができません! 車両を購入するか, 所有車両から選んでください.<br><br>それともクイックジョブをプレイしますか?"
