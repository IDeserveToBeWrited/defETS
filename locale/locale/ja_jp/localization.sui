#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Steam インベントリのコンテンツのロード中にエラーが発生しました.<br><br>$ERROR$<br><br>続行すると, コンテンツを有効なまま維持します. コンテンツは定期的に検索されます.<br><br>コンテンツを一時的に無効にすると, このようなエラーメッセージを再表示させないようにすることもできます. ゲームは次回の実行時にコンテンツを自動的に再び有効にします." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Steam インベントリのアイテムをダウンロードすることができません." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTORY" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Steamインベントリのアイテムをロード中..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NEW INVENTORY ITEMS" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "新しい Steam インベントリのアイテムを検出しました." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "車両アクセサリー" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "キャビンアクセサリー" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "デスクトップの背景" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "ペイントジョブ" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "インベントリを無効化" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "後で試す" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM INVENTORY" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "いくつかのアイテムが Steam インベントリから削除されました. アップグレードショップで対象アイテムを購入することはできなくなります.<br><br>これは現在インストール済みのアイテムには影響しません." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


