#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "スクリーンショットファイルが大きすぎます. ディスプレイ解像度を下げてみてください." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "スクリーンショットファイルが破損しているかサポートされていません." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "スクリーンショットの解像度が大きすぎます. ディスプレイ解像度を下げてみてください." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "サービスによりスクリーンショットが拒否されました." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "このアカウントはスクリーンショットをアップロードできません." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "同じスロットへの同時アップロードがありました." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "現在アップロードは無効です. 後ほどお試しください." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "アップロード中に原因不明のエラーが発生しました. 後ほどお試しください." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "スクリーンショットが最大許容サイズ ($LIMIT$) を超えているため, リサイズされました." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "スクリーンショットファイルが最大許容サイズ ($LIMIT$KB) を超えているため, リサイズされました." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "ACTIVE MODS" #+ Mod selection title

	key[]: "missing_deps"
