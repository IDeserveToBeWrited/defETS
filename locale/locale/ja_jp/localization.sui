#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "メニュー閲覧時に背景に表示されるテーマを選択します."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "ゲームを開始するたびに背景テーマがランダムに選択されるようにします."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "デスクトップ上の要素がフェードアウトするまでの遅延時間を設定します."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 時間の経過に応じて疲労の影響が発生します.<br><br>休憩を取らないと交通違反になります."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 交通ルールを守らなければ交通違反になる可能性があります. 警察車両・レーダー・速度違反自動取締装置の近くではリスクが高まります."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "提供される仕事の平均距離を調節します."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "ナビゲーションウィジェットに表示する制限速度を選択します."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "制限速度を超えると, ナビゲーションの現在速度が赤色に変わります."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "目的地に到着すると, ウィジェットに駐車をスキップするためのダイアログが表示されます."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "すべてのウィジェットを非表示にする"

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "両方の HUD ミラーを非表示のままにします."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "通知を受信しても, すべての通知を非表示のままにします."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "重量物配送を引き受ける前に, 現在使用しているトラックの性能を示すウィンドウを表示します."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "ワールドマップの配置方法を選択します."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "ワールドマップの探索方法を選択してください.<br>- \"周辺探索\" はより広い範囲を探索します.<br>- \"精密探索\" はプレーヤーのすぐ周囲のエリアのみを探索します."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "ナビゲーションの表示方法を選択します."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "ナビゲーションの経路の選定方法を変更します:<br>- \"最適ルート\"モードは距離と時間のバランスが最も効率的なルートを選択し, 信号機のある交差点などを避けて経路を設定します.<br>- \"最短ルート\"モードは常に最短経路を選択します.<br>- \"下道優先\"モードは可能な限り高速道路を避ける経路を選択します."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "駐車の難易度を変更します:<br>- \"毎回選択する\"は目的地に到着すると選択できます.<br>- \"簡易駐車\"は後退操作を必要としません.<br>- \"高度な駐車\"は通常, 難しい後退操作が必要になります."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "事故・故障車・道路のがれきなど, 道路上の危険に遭遇する確率を調節します."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "仕事で運転中にルート変更が必要な迂回イベントに遭遇する確率を調節します."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "悪天候に見舞われる確率を調節します."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "現在時刻に加えてタイムゾーン情報を表示するかどうかを選択します."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "トラック購入後やガレージのアップグレード後, 乗客の乗車中などに表示される, ゲーム内のカットシーンを有効にします."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "進入できない道路に半透明の道路ブロックを表示するかどうかを選択します."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "ゲーム内でカメラを操作する時に, マウスの Y 軸を反転させます."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "トランスミッションの種類を選択します:<br>- \"シンプルオートマチック\"はアクセルとブレーキで前進と後退を操作します.<br>- \"リアルオートマチック\"は前進と後退の切り替えに入力が必要です.<br>- \"シーケンシャル\"はシフトアップ / ダウンの時にすべてのギアを手動で変速させる必要があります.<br>- \"Hシフター\"はシフトゲートを備えたコントローラーを使用して手動でギアを選択する必要があります."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "この機能を選択すると\"スキップシフト\"が可能になります - トランスミッションのすべてのギアを一段ずつ上げ下げしていくのではなく, 必要に応じてまたは利便性の為にギアをスキップすること."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "キーボードまたはコントローラー使用時にステアリングホイールをセンターに戻します.<br><br>この機能を無効にすると, 旋回後に手動でステアリングをセンターに戻す必要があります."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "ステアリングホイールのアニメーションの範囲を調節します."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "ブレーキの効きの強さを調節します."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "重心を下げることで車両の安定性を変更します."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "重心を下げることでトレーラーの安定性を変更します."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "駆動系から発生するトルクの強さを変更します.<br><br>この設定を上げると, 車両が右に \"ねじれる\" 感覚が増加します."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "シャーシサスペンションの剛性を変更します."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "キャビン / スリーパーサスペンションの剛性を変更します."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "プロシージャル生成された路面の凹凸の強さを調整し, 道路や地形に自然な不均一さを与えます.<br><br>他のサスペンションやカメラの設定によって, 効果が強調されたり控えめに感じられたりする可能性があります."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "トラックの第五輪とトレーラーのキングピンの位置合わせに, より高い精度を必要とする高度な連結を有効にします.<br><br>無効にすると第五輪とキングピンの当たり判定がなくなるため, トレーラーの連結が非常に簡単になります."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "トレーラーケーブルのアニメーション表示を選択します.<br><br><color value=@@clr_txt_d@@>より多くの車両でケーブルを有効にすると, 古いシステムではパフォーマンスに影響する場合があります."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "トラックの電子制御スピードリミッター 90km/h (56mph) を有効にします.<br><br><color value=@@clr_txt_d@@>World of Trucks の仕事では, この機能は常に有効となります."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "この設定を有効にしてワイパーを一段目の位置に設定すると, 降雨時にワイパーが自動的にオンになり, 状況に応じて速度が調節されます."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "ブレーキ時にリターダーが自動的に作動するようにします."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, 坂道発進時に車両が自動でブレーキを保持し, スムーズな発進をサポートします."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "ブレーキ時にエンジンブレーキが自動的に作動するようにします."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, アクセルを踏み込むとすぐにエンジンが始動します."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, 車両のパーキングブレーキがデフォルトで作動します (フェリーの利用後, 修理工場への牽引後, クイックトラベル利用後など)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "車両重量に合わせて, 必要に応じて自動的にリフトアクスルを展開します."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, 車両はデフォルトで軽いアクセル状態を維持します. アクセルボタンを素早く 2 回押すと, アクセルボタンを離すまで全開状態を維持します.<br><br>キーボード入力にのみ影響します."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "過度のブレーキ操作による現実的な空気圧の低下をシミュレートします.<br><br>有効にすると, 坂道を下る際や, 何度もブレーキをかけながら低速で運転操作を行う場合, 空気圧を適切に管理する必要があります."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "無効時は, 燃料消費量は運転スタイルや道路状況の影響を受けません.<br><br>有効にすると, 燃料消費量は運転スタイル, 荷物の重量, 転がり抵抗, 地形の状況など, いくつかの要因に影響されます. @@skill_mechanical_title@@ スキルの影響は受けなくなりました"

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, ABS がタイヤのロックを防いでコントロールを維持し, 制動能力を向上させます."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, 車両はタイヤごとにブレーキをかけてホイールスピン, アンダーステアやオーバーステアを防ぎ, コントロールを維持しやすくします."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, 車輪が空転し始めた時にトラクションを向上させるため, 自動でデファレンシャルロックが作動します."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "適切なボタンが押されたときに, クルーズコントロー ルが増減する速度の増分を変更します."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "設定速度を維持するためのクルーズコントロールの許容範囲を変更します."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, クルーズコントロールは先行車との安全な車間距離を保つように自動的に速度を調整します."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "システムが差し迫った衝突を感知した場合に緊急ブレーキを作動させます.<br>システムが車両のみに反応するか, すべての障害物に反応するかを選択します."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "レーンアシストモードの選択:<br>- \"車線逸脱警告\" モードは車線から逸脱しそうになると警告音を発します.<br>- \"車線維持支援\" モードは警告音に加え, 車両が車線からはみ出さないように自動的にステアリングを操作します.<br><br>どちらのモードも 55km/h (35mph) 以上で作動します.<br>レーンアシストは作動前に方向指示器の使用状況も考慮します."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "車両にブラインドスポットセンサーが装備されている場合, その機能を有効にします."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "有効にしてヘッドライトを一段目の位置に設定すると, 低照度の状況下でヘッドライトが自動的に点灯します."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "有効にしてハイビームを作動させた状態でヘッドライトを点灯すると, 対向車や前方の車両を検知した時に自動的にハイビームを減光します."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 旋回後にステアリングホイールを中央に戻した時に, 方向指示器が自動的に解除されます."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 一部の車内アクセサリーが車両の物理的な動きに反応します. (吊り下げ式デコレーションやボブルヘッドなど)"

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "ステアリング入力に応じたインテリア視点カメラのヨーを有効にします."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "ステアリング入力に対する\"ステアリングカメラ ローテーション\"機能の反応度を変更します."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "後退時の\"ステアリングカメラ ローテーション\"機能の挙動を変更します."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, 車内カメラが方向指示器の使用状況に応じて左右を向くようになります."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "有効にすると, インテリア視点カメラが車両の動きに反応します."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "車両の動きに対するインテリア視点カメラの反応度を変更します."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "車両の動きに応じて車内カメラがロールする量を調節します."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "カメラが自動的に中央に戻るまでの遅延を設定します.<br><br>この機能はある程度の速度で走行している場合のみ作動します. 前進中はインテリア視点とチェイス視点に, 後退中はリーンアウト視点にのみ適用されます."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "カメラの移動速度を設定します. 自動カメラセンタリングや車内カメラプリセットの切り替えで使用します."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "インテリアズームの動作方法を決定します: ボタンを長押しして一時的にズームするか, ボタンを押すたびにオン/オフを切り替えたりできます." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "ゲーム内の表示言語を選択します."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "選択された地域に基づいて, 通貨や単位のプリセットを変更します."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 国名と都市名が選択された言語で表示されます."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 国名と都市名が選択された言語とその地域の言語の両方でマップ上に表示されます."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "使用する通貨を選択します."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "12 時間表記か 24 時間表記かを選択します."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "表示する距離の単位を選択します."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "表示する質量の単位を選択します."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "表示する温度の単位を選択します."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "表示する圧力の単位を選択します."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "表示する体積の単位を選択します."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "表示する消費量の単位を選択します."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, 設定したボタン (@@imv_nrm_activate@@) を押すとコンボイセッション中にチャットが開きます."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "無効にすると, メッセージ送信後もチャット入力バーが残ったままになります."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, チャットメッセージは表示されてから数秒後にフェードアウトします."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "チャットメッセージがフェードアウトするまでの表示時間を変更します."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "有効にすると, コンボイセッションでプレイヤー名が車両の上に表示されます."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "コンボイセッションのチャットで使用するクイックリプライを設定するための詳細メニューを開きます."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "World of Trucks に接続されたコンテンツのステータスを確認します."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "タイトル画面に表示するオンラインニュースのダウンロードを有効にする."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "ローディング画面として表示される, World of Trucks ウェブサイトから厳選されたコミュニティのスクリーンショットをダウンロードできるようにします."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "ゲーム内の特定の屋外広告看板に表示するリアル広告のダウンロードを有効にします."
