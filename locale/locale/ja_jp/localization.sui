#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "続ける ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Euro Truck Simulator 2 へようこそ!"

	key[]: "intro_2"
	val[]: "ついにあなたが夢見た仕事を体験できる日が来ました. トラックを運転しましょう!"

	key[]: "intro_3"
	val[]: "あなたの会社がついに開業しました. ですが残念なことに, トラックを買う資金がありません. まずは他の会社で雇われ運転手として働きましょう."

	key[]: "intro_4"
	val[]: "あなたの任務は $JOB_CARGO$ を $JOB_TARGET_CITY$ の $JOB_TARGET_COMPANY$ の荷積場へ無事に送り届けることです. 車両とすべての経費は雇い主が用意します. 期待を裏切らないよう, 時間厳守で到着しましょう."


	key[]: "intro_garage_1"
	val[]: "これがあなたの本拠地です."

	key[]: "intro_garage_2"
	val[]: "これはごく簡素なガレージです. 立派とは言えませんが, ここがすべての出発点です."

	key[]: "intro_garage_3"
	val[]: "残念なことに, まだ所有している車両がないため, ガレージは空っぽです."

	key[]: "intro_garage_4"
	val[]: "資金を稼いでトラックを購入すれば, 各地を自由に走り回り, ここを拠点に事業を展開できるようになります."

	key[]: "intro_garage_5"
	val[]: "頑張ってください!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE UNLOCKED"

	key[]: "desktop_tut_job"
	val[]: "次の仕事を選ぶ"

	key[]: "desktop_tut_cargo_market"
	val[]: "自分のトレーラーがあれば, カーゴマーケットを利用できます. さまざまな貨物を請け負い, 目的地へ送り届けましょう." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "ここであなたの進行状況を見ることができます."

	key[]: "desktop_tut_company"
	val[]: "ここからガレージを管理し, 新しいドライバーを雇うなど会社の経営を行います."

	key[]: "desktop_tut_trailers"
	val[]: "これからは, 自分のトレーラーを購入できます. また, トラックにマッチするようにアップグレードしたり, ペイントしたりすることも可能です.<br><br>トレーラーは選択したガレージに格納され, 従業員に使用させて利益を上げることができます. トレーラーを管理するにはトレーラーマネージャーを使用します."

	key[]: "desktop_tut_visit_directive"
	val[]: "$SCREEN_NAME$ を訪問" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
