#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "TRUCK STATE OVERVIEW" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "状態" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "性能と信頼性に影響する重大な機械的問題があります. 完全修復や複数の部品交換を検討する必要があるでしょう." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "性能または信頼性を損なう可能性のある機械的な問題があります. 整備が必要です." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "走行可能ですが若干の問題があるかもしれません. 整備をお勧めします." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "軽微な傷や損耗がある程度でしっかりした状態です." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "損耗も少なく素晴らしい状態です." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "メンテナンス" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "車両全体の経年劣化と, 使用することで蓄積される継続的な損耗具合を表しています. 完全修復によって修理可能です." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "パーツの損耗" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "走行距離や事故は各部品の損耗や劣化につながります. 状態を把握し必要に応じて整備する必要があります." #+ Explanation unfixable wear.
#@}

