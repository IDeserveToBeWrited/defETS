#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAPHICS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "グラフィック" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "調整済みのプリセットを使用してグラフィック設定を変更し, 画質と動作のバランスを好みに合わせて調整します."

	key[]: "apply"
	val[]: "適用" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "デスクトップテーマ" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ディスプレイ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "イメージクオリティ" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "テクスチャ" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "リフレクション" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "シャドウ" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ライティング" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "ポストプロセス" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "エンバイロメント" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "フルスクリーンモード" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "明るさ / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "セットアップ" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "解像度" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "リフレッシュレート" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS 制限" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS 制限 (非アクティブ時)" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "デフォルトリフレッシュレート" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "垂直同期" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "エコノミック (ノート PC でのバッテリー消費を抑えます)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "シンプルグラフィック設定" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "カスタム設定が適用されました" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "詳細グラフィック設定" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "簡易 / 詳細グラフィック設定" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "アドバンスセッティングを非表示" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "アドバンスセッティングを表示" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "レンダリングスケール" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "アンチエイリアシング" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA 輝度シャープネス" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA チューニング" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "鮮明度自動調整" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "常にソフト" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "常にシャープ" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "スクリーンスペース・アンビエント・オクルージョン (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "ハイダイナミックレンジ (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "被写界深度 (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "日差しの表現" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "色補正" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "リフレクションスケーリング" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "反射ディテール" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "草木のディテール" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "草の密度" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "影のクオリティ"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "影のテクスチャサイズ" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "遠景の影" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "インテリアシャドウ" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "ウェザークオリティ"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "ミラークオリティ" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "ミラーの解像度" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "ミラー描画距離" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "テクスチャクオリティ" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "異方性フィルタリング" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "ノーマルマップ" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "AI 走行車両のヘッドライト" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "補助灯の表現" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "光の照射有効範囲" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "歩行者の表示" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "ディスプレイの設定が変更されました.<br>これらの設定を維持しますか?"

	key[]: "reverting_in"
	val[]: "元の設定に戻るまで:" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "秒" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "有効にすると, ゲームはフルスクリーンで表示されます."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "お使いのディスプレイに合わせてゲーム全体の明るさを調整します. HDR 対応ディスプレイでは, この設定で HDR キャリブレーションオプションも利用可能です."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "ゲームの解像度を変更します."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "ゲームの目標リフレッシュレートを変更します."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "フレームレートをモニターのリフレッシュレートに合わせることで, ティアリングを防ぎます. エコノミー設定ではフレームレートが半分になり, 消費電力が低くなります."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "ゲームの最大許容フレームレートを設定します.<br><br>値を 0 に設定すると, この機能は無効になります."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "ゲームがバックグラウンドで最小化されているときの最大許容フレームレートを設定します.<br><br>値を 0 に設定すると, この機能は無効になります."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "シンプルなグラフィック設定 (プリセット), または高度なグラフィック設定 (個々のパラメータを変更可能) を切り替えます."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "内部的に高い解像度でゲームをレンダリングすることでグラフィックのリアルさを高め, エッジのギザギザを減らしてディテールを強調します.<br>スケーリングの値を高く設定するほど, ぼやけの少ない鮮明な映像になり, ゲーム全体の見た目が向上しますが, 動作は重くなります.<br><br><color value=@@clr_txt_d@@>この設定は, ゲームのパフォーマンスに大きな影響を与えます."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "ゲーム内のギザギザのエッジを滑らかにする高速アンチエイリアシング方法の選択:<br>- SMAA はフレーム内のさまざまな場所で各ピクセルを複数回 (選択した品質による) サンプリングし, サンプルを平均化して最終画像を生成します.<br>- TAA は各ピクセルをフレームごとに 1 回だけサンプリングしますが, さまざまな場所とさまざまなフレームでサンプリングします.<br>- 描画品質を最大にしたい場合は, 両方を組み合わせることもできますが, 動作は重くなります.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "互いに近接する隙間やオブジェクトにソフトシャドウを追加し, ゲーム内ワールド全体のグラフィックのリアルさを高めます.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "TAA プリセットの選択:<br>- \"常にソフト\"はちらつきが少なく, ぼやけが多くなります. この設定はスーパーサンプリングを有効にしている PC ユーザーや, 高 DPI モニターを使用しているユーザーに最適です. また, 画面から離れた場所に座っている 1080p テレビユーザーにも適しています.<br>- \"常にシャープ\"はちらつきが多くなり, ぼやけが少なくなります. ノート PC や Steam Deck など, 解像度が 1080p 未満の環境におすすめの設定です.<br>- \"鮮明度自動調整\"を選択すると, カメラが静止している場合は TAA ジッターが自動的に無効になります.<br><br><color value=@@clr_txt_d@@>この設定は, アンチエイリアシングソリューションとして TAA が選択されている場合にのみ使用できます."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "TAA の輝度シャープネスの強さを調節します.<br><br><color value=@@clr_txt_d@@>この設定は, アンチエイリアシング・ソリューションとして TAA が選択されている場合にのみ使用できます."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "有効にすると, マップ内の遠景がぼかされ, 背景にリアルなボケ味が演出されます."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "有効にすると, 太陽を見たり, 木・建物・車などの物体を通して太陽を見たりした時に, 光線が見えることがあります."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "有効にすると, 視覚効果を得るためにゲーム内の色彩が動的に調節されます. 時間帯や天候に合わせてシーンの色調が最適化されるほか, 乗り物などのオブジェクトの色がより鮮やかになります."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "内部レンダリング品質の向上と, より精度の高いアンチエイリアシングを適用することで, 反射の表現を改善します.<br><br><color value=@@clr_txt_d@@>この設定の変更を反映するには, ゲームを手動で再起動する必要があります."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "車の表面や窓, 水たまりや濡れた道路, 開けた水面などの反射面のディテールを調節します.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます.<br><br>この設定の変更を反映するには, ゲームを手動で再起動する必要があります."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "草木の細部や複雑さを調節します.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "道路脇に見える草の密度を調節します.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "太陽や月が落とす影の品質を調節します.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "非常に遠いオブジェクトの影も描写されるようになります.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "夜間の車両の車内に動的な影の描画を有効にします.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "反射などの天候エフェクトの品質を調節します."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "車両のミラーに映る反射の品質を調節します (反射の設定とは無関係).<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "車両のミラーに表示される画像の解像度を調節します."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "オブジェクトがミラーでレンダリングされ始める距離を調節します.<br><br><color value=@@clr_txt_d@@>この設定は, しばしばパフォーマンスに大きな影響を与えます."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "ゲーム内のオブジェクトや表面に適用される一部のテクスチャの品質を調節します."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "特に遠くから, または斜めから見た時のテクスチャの鮮明さを向上させます.<br><br><color value=@@clr_txt_d@@>この設定の変更を反映するには, ゲームを手動で再起動する必要があります."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "舗装や道路, その他のオブジェクトに幾何学的なディテールを加え, 見栄えを良くします.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます.<br><br>この設定の変更を反映するには, ゲームを手動で再起動する必要があります."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "周囲の走行車両のヘッドライトからの照射を有効にします."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "ウインカーやブレーキなど, 周囲の走行車両の二次灯火類の照射を有効にします."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "人工光源が見える距離を調節します.<br><br><color value=@@clr_txt_d@@>この設定は通常, パフォーマンスに中程度の影響を与えます."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "ゲームワールドで歩行者を有効にします."
