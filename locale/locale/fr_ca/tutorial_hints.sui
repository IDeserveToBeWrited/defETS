
    key[]: "hint_engine_title"
	val[]: "Démarrer le moteur"

    key[]: "hint_engine_text"
	val[]: "Utilisez $KEY_engine$ pour démarrer le moteur."


    key[]: "hint_ignition_title"
	val[]: "Mettre le contact"

    key[]: "hint_ignition_text"
	val[]: "Utilisez $KEY_engineelect|KEY_engine$ pour mettre le contact."


    key[]: "hint_driv_arc_title"
	val[]: "Conduire"

    key[]: "hint_driv_arc_text"
	val[]: "Utilisez $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pour avancer ou reculer.<br><offset vshift=8>Utilisez $SPECIAL_steering$ pour tourner."


    key[]: "hint_driv_auto_title"
	val[]: "Conduire"

    key[]: "hint_driv_auto_text"
	val[]: "Utilisez $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pour avancer ou reculer.<br><offset vshift=8>Utilisez $SPECIAL_steering$ pour tourner.<br><offset vshift=8>Appuyez $KEY_gearup$ and $KEY_geardown$ pour sélectionner une vitesse."


    key[]: "hint_driv_seq_title"
	val[]: "Conduire"

    key[]: "hint_driv_seq_text"
	val[]: "Utilisez $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pour avancer ou reculer.<br><offset vshift=8>Utilisez $SPECIAL_steering$ pour tourner.<br><offset vshift=8>Appuyez $KEY_gearup$ and $KEY_geardown$ pour l'embrayage."


    key[]: "hint_driv_hshift_title"
	val[]: "Conduire"

    key[]: "hint_driv_hshift_text"
	val[]: "Utilisez $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pour avancer ou reculer.<br><offset vshift=8>Utilisez $SPECIAL_steering$ pour tourner.<br><offset vshift=8>Changez de vitesse avec le <color value=@@clr_sel@@>levier de vitesse<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Approchez de la destination"

    key[]: "hint_depot_deliv_text"
    val[]: "Arrêtez dans la zone marquée pour sélectionner la difficulté de stationnement et obtenir l'expérience correspondante."


    key[]: "hint_fin_deliv_title"
    val[]: "Terminer la livraison"

    key[]: "hint_fin_deliv_text"
    val[]: "Stationnez-vous dans l'endroit de stationnement sélectionné. Vous pouvez appuyez $KEY_activate$ pour passer cette étape lorsque proche du point de livraison."


    key[]: "hint_fin_deliv2_title"
    val[]: "Terminer la livraison"

    key[]: "hint_fin_deliv2_text"
    val[]: "Stationnez-vous dans la place de stationnement sélectionnée. Vous pouvez activer un widget dans @@desktop_menu_category_options@@ pour vous permettre de ne pas avoir à vous stationner."


    key[]: "hint_lights_title"
    val[]: "Allumer les feux"

    key[]: "hint_lights_text"
    val[]: "Utilisez $KEY_light$ pour allumer vos feux. Appuyez plusieurs fois pour passer d'un mode à l'autre."


    key[]: "hint_high_beam_title"
    val[]: "Allumer les feux de route"

    key[]: "hint_high_beam_text"
    val[]: "Utilisez $KEY_hblight$ pour allumer les feux de route."


    key[]: "hint_wipers_title"
    val[]: "Activer les essuie-glaces"

    key[]: "hint_wipers_text"
    val[]: "Utilisez $KEY_wipers$ pour activer les essuie-glaces et passer d'un réglage de vitesse à l'autre."


    key[]: "hint_zoom_title"
    val[]: "Regarder de plus près"

    key[]: "hint_zoom_text"
    val[]: "Utilisez $KEY_camzoom$ pour zoomer à l'intérieur. Vous pouvez régler le mode de zoom sur \"maintenir\" ou \"permuter\" dans @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Regarder autour"

    key[]: "hint_cam_int_text"
    val[]: "Utilisez $KEY_cam1$ pour mettre la caméra en vue intérieure."


    key[]: "hint_cam_ext_title"
    val[]: "Regarder autour"

    key[]: "hint_cam_ext_text"
    val[]: "Vous pouvez passer d'un angle de caméra à l'autre en appuyant sur $KEY_camcycle$.<br><offset vshift=8>Utilisez $KEY_cam2$ pour passer à la vue extérieure."


    key[]: "hint_indicators_title"
    val[]: "Clignotants"

    key[]: "hint_indicators_text"
    val[]: "Utilisez $KEY_lblinker$ et $KEY_rblinker$ pour allumer les clignotants."


    key[]: "hint_tow_title"
    val[]: "Service de remorquage"

    key[]: "hint_tow_text"
    val[]: "Si vous ne parvenez pas à vous sortir d'une situation difficile, vous pouvez utiliser le service de remorquage. Pour y accéder, ouvrez le menu @@quick_info_word@@ en utilisant $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Blocage du différentiel"

    key[]: "hint_diff_lock_text"
    val[]: "Si vous ne parvenez pas à démarrer, le blocage du différentiel pourrait vous aider. Utilisez $KEY_diflock$ pour l'activer ou activez le blocage automatique du différentiel dans @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Blocage différentiel activé"

    key[]: "hint_diff_unlock_text"
    val[]: "Vous devez débloquer le différentiel pendant la conduite normale, sinon vous risquez de l'endommager. Utilisez $KEY_diflock$ pour le désactiver ou activez le verrouillage automatique du différentiel dans @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Désactiver les essuie-glaces"

    key[]: "hint_wipers_off_text"
    val[]: "Utilisez $KEY_wipers$ pour désactiver les essuie-glaces et passer d'un réglage de vitesse à l'autre."


    key[]: "hint_world_map_title"
    val[]: "Visualiser la carte"

    key[]: "hint_world_map_text"
    val[]: "Utiliser $KEY_navmap$ pour ouvrir la carte."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Utilisez $KEY_advmouse$ pour ouvrir les @@quick_info_word@@ : aperçu de votre statut avec des raccourcis pratiques."


    key[]: "hint_pause_border_title"
    val[]: "Règlementations locales"

    key[]: "hint_pause_border_text"
    val[]: "Utilisez $KEY_advmouse$ pour ouvrir les @@quick_info_word@@ et voir les règlementations locales pour la région dans laquelle vous êtes."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Ouvrez les @@quick_info_word@@ en utilisant $KEY_advmouse$ pour entrer dans le @@photo_mode_word@@ et capturer le @@landmark_word@@ à proximité <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ à proximité"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> est à proximité : trouvez-le et activez-le pour visionner la cinématique."


    key[]: "hint_resting_title"
    val[]: "Aire de repos à proximité"

    key[]: "hint_resting_text"
    val[]: "Les aires de repos <img src=/material/ui/map/parking_ico.mat width=20 height=20> vous permettent de vous ressourcer et de faire vos pauses obligatoires afin de poursuivre votre voyage en toute sécurité."


    key[]: "hint_gas_title"
    val[]: "Station-service à proximité"

    key[]: "hint_gas_text"
    val[]: "Les stations-service <img src=/material/ui/map/gas_ico.mat width=20 height=20> peuvent être utilisées pour faire le plein de votre véhicule."
