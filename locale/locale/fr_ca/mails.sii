SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "Système" #+ Message sender
		subject: "Message de test" #+ Message subject
		body: "Salut !<br><br>Ceci est un message de test de votre associé ;-)<br><br>Ciao !" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "Banque" #+ Message sender
		subject: "Besoin d’argent ? Nous pouvons vous aider !" #+ Message subject
		body: "Madame, Monsieur,<br><br>Nous souhaitons vous informer que nous offrons des prêts attractifs aux nouvelles entreprises. Avez-vous besoin d’un financement pour lancer votre société ? Nous sommes là pour vous aider ! Veuillez $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>visiter notre agence bancaire locale</link> pour plus d’informations.<br><br>Cordialement,<br>Le directeur commercial<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "Banque" #+ Message sender
		subject: "Nous pouvons vous aider à vous développer" #+ Message subject
		body: "Madame, Monsieur,<br><br>Nous avons remarqué la régularité de vos revenus et nous aimerions vous aider à développer votre potentiel. Votre plafond d’emprunt a été augmenté à $MONEY$. N’hésitez pas à retirer la somme disponible à tout moment dans votre $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>banque locale</link>.<br><br>Cordialement,<br>Le directeur commercial<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "Banque" #+ Message sender
		subject: "Votre compte est à découvert" #+ Message subject
		body: "Cher Client,<br><br>Vous avez retiré plus d'argent de votre compte que vous n'en possédiez. Nous vous avons donc mis en place un crédit à court terme pour les prochains jours, sans frais, pour que vous puissiez résoudre la situation. Veuillez avoir l'amabilité de régler votre solde créditeur dès que possible.<br><br>Cordialement,<br>Votre Directeur de Compte<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "Banque" #+ Message sender
		subject: "Vous avez un découvert non acquitté !" #+ Message subject
		body: "Cher client,<br><br>Votre compte bancaire est déficitaire ! Veuillez le renflouer dans les $DAYS$ qui viennent ou nous serons dans l'obligation de saisir vos biens.<br><br>Cordialement,<br>Votre Directeur de Compte<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "Banque" #+ Message sender
		subject: "Dernier avertissement !" #+ Message subject
		body: "Cher Client,<br><br>Ceci est notre dernier avertissement. Votre compte en banque est à découvert. Veuillez nous rembourser avant demain sinon nous serons dans l'obligation de confisquer vos biens pour couvrir vos dettes.<br><br>Cordialement,<br>Votre Directeur de Compte<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "Banque" #+ Message sender
		subject: "Découvert renfloué" #+ Message subject
		body: "Cher Client,<br><br>Votre découvert a été soldé. Nous serions heureux de vous aider si, à l'avenir, vous aviez besoin de nos services.<br><br>Passez une excellente journée,<br>Votre Directeur de Compte<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "Banque" #+ Message sender
		subject: "Votre camion personnel a été vendu" #+ Message subject
		body: "Cher Client,<br><br>Nous avons le regret de vous informer que nous avons dû vendre votre camion personnel - $TRUCK_NAME$ - pour $MONEY$. Malheureusement, vous avez des dettes de longue date envers nous et n'avez aucun autre moyen pour nous rembourser. Je suis au regret de vous informer qu'il n'y a rien d'autre à faire que de prendre ces mesures extrêmes. Nous vous suggérons d'effectuer des missions rapides jusqu'à ce que votre situation financière s'améliore.<br><br>Cordialement,<br>Votre directeur de compte<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "Banque" #+ Message sender
		subject: "Votre remorque personnelle a été vendue" #+ Message subject
		body: "Cher Client,<br><br>Nous avons le regret de vous informer que nous devons vendre votre remorque personnelle - $TRAILER_NAME$ - pour $MONEY$. Malheureusement, vous avez une dette de longue date envers nous et n'avez aucun autre moyen pour nous rembourser. Malheureusement, il n'y a rien d'autre à faire que de prendre ces mesures extrêmes. Nous vous suggérons de faire des missions rapides jusqu'à ce que votre situation financière aille mieux.<br><br>Sincèrement,<br>Votre directeur de compte<br>Banque" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "Banque" #+ Message sender
		subject: "Vos biens ont été vendus" #+ Message subject
		body: "Cher Client,<br><br>En raison d’un découvert de longue date sur votre compte, nous avons saisi et vendu vos biens. Les fonds récupérés pour une somme totale de <br>$MONEY$ ont été utilisés pour régler vos dettes. Plus particulièrement, ces biens ont été confisqués :<br><br>$ITEM_LIST$<br>Nous regrettons que la situation ait empiré à ce point, et nous espérons que les conséquences ne nuiront pas sévèrement à vos futurs projets.<br><br>Cordialement,<br>Votre conseiller bancaire<br>Banque" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "Concessionnaire - $CITY$" #+ Message sender
		subject: "Nouveaux modèles $BRAND$ à vendre !" #+ Message subject
		body: "Madame, Monsieur,<br><br>Nous sommes distributeurs agréés de la marque $BRAND$. Nous proposons un large choix de configurations différentes ainsi qu’une personnalisation selon vos envies. N’hésitez pas à $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>visiter notre concession à $CITY$</link>. Le camion dont vous avez toujours rêvé vous y attend peut-être.<br><br>Cordialement,<br>Votre concessionnaire $BRAND$" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "Vendeur de camions d’occasion" #+ Message sender
		subject: "Camions d’occasion à vendre !" #+ Message subject
		body: "Madame, Monsieur,<br><br>Nous sommes ravis d’annoncer l’ouverture de notre magasin de camions d’occasion, votre nouvelle destination pour des camions d’occasion de haute qualité ! Que vous soyez à la recherche d’une machine puissante ou d’une bête de course fiable, nous avons le camion idéal pour vous.<br><br>Consultez nos $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>offres de camions d’occasion</link>. Nous sommes convaincus que vous trouverez le camion idéal qui répondra à vos besoins.<br><br>Cordialement,<br><br>L’équipe du magasin de camions d’occasion<br><br>P.S. : n’oubliez pas de revenir régulièrement pour consulter les nouveaux arrivages ! Notre inventaire change constamment et vous pourriez faire l’affaire du siècle un jour." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "Besoin de conducteurs avec leur propre équipement" #+ Message subject
		body: "Avis aux personnes concernées, <br><br>Nous recherchons des conducteurs expérimentés possédant leur propre camion pour un grand nombre de livraisons. Nous offrons un salaire attrayant de $MONEY$ par contrat. Si vous possédez votre propre véhicule, n'hésitez pas à vous renseigner directement à notre dépôt de $CITY$.<br><br>$COMPANY$,<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "Conducteur $NAME$" #+ Message sender
		subject: "J’ai besoin d’un camion pour travailler" #+ Message subject
		body: "Bonjour patron, <br><br>Je ne sais pas si vous êtes au courant, mais je suis dans la ville de $CITY$ sans travailler depuis maintenant $DAYS$. Je suis très ennuyé, parce que j'ai besoin d'argent pour payer mes factures et je ne peux rien faire d'autre si je reste à flâner ici sans contrat en vue. Veuillez m'attribuer un camion avant les $DAYS2$ qui suivent pour que je puisse commencer à livrer, sinon je n'aurai d'autre choix que de démissionner.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "Conductrice $NAME$" #+ Message sender - written by female
		subject: "J’ai besoin d’un camion pour travailler" #+ Message subject - written by female
		body: "Bonjour patron, <br><br>Je ne sais pas si vous êtes au courant, mais je suis dans la ville de $CITY$ sans travailler depuis maintenant $DAYS$. Je suis très ennuyée, parce que j'ai besoin d'argent pour payer mes factures et je ne peux rien faire d'autre si je reste à flâner ici sans contrat en vue. Veuillez m'attribuez un camion avant les $DAYS2$ qui suivent pour que je puisse commencer à livrer sinon je n'aurais d'autre choix que de démissionner.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "Conducteur $NAME$" #+ Message sender
		subject: "Au revoir" #+ Message subject
		body: "Bonjour,<br><br>Je ne peux plus me permettre de perdre mon temps. Je ne peux pas travailler sans camion et je ne veux pas attendre davantage. Je manque de bonnes opportunités, je quitte donc votre entreprise pour tenter ma chance ailleurs. Vous trouverez tout le matériel fourni dans mon ancien garage à $CITY$.<br><br>Au revoir,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "Conductrice $NAME$" #+ Message sender - written by female
		subject: "Au revoir" #+ Message subject - written by female
		body: "Bonjour,<br><br>Je ne peux plus me permettre de perdre mon temps. Je ne peux pas travailler sans camion et je ne veux pas attendre davantage. Je manque de bonnes opportunités, je quitte donc votre entreprise pour tenter ma chance ailleurs. Vous trouverez tout le matériel fourni dans mon ancien garage à $CITY$.<br><br>Au revoir,<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "Chauffeur $NAME$" #+ Message sender
		subject: "Mon camion a besoin d’une restauration totale" #+ Message subject
		body: "Bonjour patron,<br><br>Je sais que votre emploi du temps est chargé, mais mon véhicule a besoin d’une restauration totale. Il est trop vieux et trop usé pour que je puisse le conduire en toute sécurité. Je suis sans travail depuis $DAYS$ maintenant, et franchement, ça me frustre parce que j’ai besoin de payer les factures et c’est impossible sans un véhicule en état de marche. Pouvez-vous, s’il vous plaît, me procurer un nouveau camion ou faire restaurer l’ancien pour que je puisse reprendre le travail, sinon je n’aurais d’autre choix que de démissionner.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "Conductrice $NAME$" #+ Message sender - written by female
		subject: "Mon camion a besoin d’une restauration totale" #+ Message subject - written by female
		body: "Bonjour patron,<br><br>Je sais que votre emploi du temps est chargé, mais mon véhicule a besoin d’une restauration totale. Il est trop vieux et trop usé pour que je puisse le conduire en toute sécurité. Je suis sans travail depuis $DAYS$ maintenant, et franchement, ça me frustre parce que j’ai besoin de payer les factures et c’est impossible sans un véhicule en état de marche. Pouvez-vous, s’il vous plaît, me procurer un nouveau camion ou faire restaurer l’ancien pour que je puisse reprendre le travail, sinon je n’aurais d’autre choix que de démissionner.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "Chauffeur $NAME$" #+ Message sender
		subject: "Au revoir" #+ Message subject
		body: "Bonjour,<br><br>Je suis navré, mais mon véhicule tombe en ruine à cause de l’usure et je ne peux plus attendre. Je n’ai pas de travail et mes dépenses s’accumulent : je dois donc passer à autre chose. Je recommande une restauration totale de cet engin pour le prochain conducteur. Vous trouverez tout le matériel fourni dans mon ancien garage à $CITY$.<br><br>Adieu.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "Conductrice $NAME$" #+ Message sender - written by female
		subject: "Au revoir" #+ Message subject - written by female
		body: "Bonjour,<br><br>Je suis navrée, mais mon véhicule tombe en ruine à cause de l’usure et je ne peux plus attendre. Je n’ai pas de travail et mes dépenses s’accumulent : je dois donc passer à autre chose. Je recommande une restauration totale de cet engin pour le prochain conducteur. Vous trouverez tout le matériel fourni dans mon ancien garage à $CITY$.<br><br>Adieu.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "Conducteur $NAME$" #+ Message sender
		subject: "Je pars" #+ Message subject
		body: "Bonjour patron,<br><br>Le garage à $CITY$ où je travaillais va fermer. Des personnes de la banque sont venues et m’ont ordonné de quitter les lieux. Il semble que l’entreprise ne va pas très bien ces temps-ci. J’ai donc décidé de démissionner. Je ne peux rien faire de plus ici de toute façon, sans camion… Je vais essayer d’aller voir ailleurs.<br><br>Au revoir et sans rancune,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "Conductrice $NAME$" #+ Message sender - written by female
		subject: "Je pars" #+ Message subject - written by female
		body: "Bonjour patron,<br><br>Le garage à $CITY$ où je travaillais va fermer. Des personnes de la banque sont venues et m’ont ordonné de quitter les lieux. Il semble que l’entreprise ne va pas très bien ces temps-ci. J’ai donc décidé de démissionner. Je ne peux rien faire de plus ici de toute façon, sans camion… Je vais essayer d’aller voir ailleurs.<br><br>Au revoir et sans rancune,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "Répartiteur" #+ Message sender
		subject: "Transport hors-normes" #+ Message subject
		body: "Bonjour.<br><br>J’ai quelque chose pour vous qui devrait vous intéresser. Grâce à nos relations, nous sommes désormais en mesure de relever un vrai défi. Quelques cargaisons spéciales gigantesques et lourdes ont besoin d’être transportées par un vrai professionnel. Ce ne sera pas simple et nécessitera de l’habileté, de la patience, de la coopération avec les véhicules pilotes ainsi qu’une attention particulière, mais je suppose que vous avez tout ce qu’il faut, n’est-ce pas ? Qui dit risque élevé dit bénéfice plus important.<br><br>Si ça vous intéresse, vous pouvez visiter ces villes :<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "Répartiteur" #+ Message sender
		subject: "Nouveaux transports hors-normes" #+ Message subject
		body: "Bonjour.<br><br>D’autres entreprises souhaitent faire appel à vos compétences professionnelles au volant pour effectuer des livraisons spéciales. Comme la dernière fois, ce ne sera pas simple et nécessitera de l’habileté, de la patience, de la coopération avec les véhicules pilotes ainsi qu’une attention particulière, mais je suppose que vous avez tout ce qu’il faut, n’est-ce pas ? Et n’oubliez pas que ces cargaisons peuvent vous rapporter encore plus.<br><br>Voici les missions de convois exceptionnels actuellement disponibles :<br><br>$OLD_CITIES$<br><br>Vous pouvez désormais en prendre <color value=@@clr_sel@@>de nouvelles<color value=@@clr_txt@@> dans ces villes :<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "Agence immobilière" #+ Message sender
		subject: "Cherchez-vous à agrandir votre entreprise ?" #+ Message subject
		body: "Madame, Monsieur,<br><br>Nous tenons à vous féliciter pour les résultats de votre entreprise. Nous sommes impressionnés par le succès de votre société et nous aimerions vous proposer une nouvelle façon de vous aider dans votre développement. Désormais, vous pouvez utiliser nos services pour acheter de nouvelles propriétés presque instantanément ! Pour plus d’informations, veuillez $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>visiter l’interface d’achat de garages</link>.<br><br>Cordialement,<br>Le directeur commercia<br>Agence immobilière" #+ Message body
	}
	
#@}
}