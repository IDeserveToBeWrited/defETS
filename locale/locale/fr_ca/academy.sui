	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "À première vue, reculer en ligne droite peut sembler facile, mais c’est tout le contraire.<br><br>Plutôt que d’augmenter ou de réduire l’angle entre les remorques d’un seul côté, vous devez désormais agir des deux côtés pour maintenir l’ensemble en ligne droite."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Commencez par des corrections relativement légères. Ce n’est pas grave si vous finissez par zigzaguer et osciller d’un côté à l’autre, mais gardez à l’esprit que vous devrez maintenir l’angle entre le camion et la remorque de tête un peu plus longtemps pour modifier l’angle entre les remorques de tête et arrière."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Vous devrez peut-être effectuer des manœuvres assez importantes avec le tracteur pour maintenir la remorque arrière dans la direction souhaitée, mais essayez simplement de ne pas en faire trop dès le début pour éviter ce cas de figure."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Vous pouvez avancer autant de fois que nécessaire pour vous corriger. Tant que vous vous garez en toute sécurité, le reste n’a pas d’importance."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Commencez à reculer doucement."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Redressez-vous et arrêtez-vous dans la zone indiquée."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Sécurisez le véhicule et coupez le moteur."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Corriger une marche arrière en ligne droite"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "Dans ce scénario, vous prendrez le volant après que quelqu’un d’autre a déjà tenté une marche arrière en ligne droite. Corrigez son erreur et garez le camion à l’endroit indiqué."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Redresser"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Reculer"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Quelqu’un a tenté de reculer cet ensemble dans la place de stationnement et a rencontré quelques difficultés. À vous maintenant de tout remettre en ordre !"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "La première étape consiste à avancer et à tout remettre en place. Il est essentiel que l’arrière de la remorque soit orienté dans la direction souhaitée."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "Dans ce cas, nous avons choisi de nous rapprocher davantage du côté conducteur. Cela nous permettra de mieux voir ce que nous faisons pendant la marche arrière et de travailler d’un seul côté.<br><br>N’oubliez pas que vous dirigez la remorque arrière avec la remorque de tête, alors ne vous concentrez pas trop sur le tracteur."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "L’ensemble est plus ou moins là où nous le voulons, mais avançons-le encore un peu pour le centrer correctement."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "À partir de maintenant, nous reculerons très délicatement dans la place, en veillant à ce que la remorque arrière reste parfaitement sur la voie."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Nous pouvons maintenant aligner la remorque de tête et le tracteur lui-même."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Avancez et redressez le tout.<br><br>Une fois que vous êtes satisfait, reculez dans la zone indiquée."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Reculez vers la zone indiquée."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
