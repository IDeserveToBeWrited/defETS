#+ night_slalom_double

#### night_slalom_double - common

	key[]: "aca_scenario_book3_night_slalom_double_title"
	val[]: "Slaloms de nuit"

	key[]: "aca_scenario_book3_night_slalom_double_desc"
	val[]: "Dans ce scénario, vous devrez affronter des slaloms irréguliers dans l’obscurité totale."

#### night_slalom_double goal

#!{
	key[]: "aca_goal_book3_night_slalom_double_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

