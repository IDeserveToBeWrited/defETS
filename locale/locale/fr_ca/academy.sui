	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Les scénarios suivants représentent la première étape de votre parcours pour devenir chauffeur routier."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Ici, vous apprendrez tout, des systèmes et commandes de base du camion…"

	key[]: "aca_msg_book1_intro_cutscene04"
