	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Reculer avec un ensemble à double remorque nécessite une toute nouvelle façon d’envisager ce que vous faites. Plutôt que de simplement diriger une remorque, vous utilisez désormais votre remorque de tête pour diriger celle qui se trouve derrière.<br><br>Utilisez ce scénario pour vous faire une idée de la façon dont cela fonctionne. Il n’y a pas d’objectif spécifique, prenez simplement votre temps et essayez de comprendre ce qui se passe."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "À partir d’une position droite, vous pouvez diriger votre camion dans la même direction que celle où vous souhaitez que la remorque arrière se dirige.<br><br>N’en faites pas trop. Il vous suffit d’orienter la remorque arrière dans la direction souhaitée, puis d’aligner votre tracteur avec la remorque de tête et de laisser la remorque arrière faire son travail."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Une fois que votre remorque arrière se dirige vers l’endroit souhaité, vous pouvez diriger la remorque de tête pour qu’elle suive la même direction.<br><br>Une fois que la remorque de tête suit la remorque arrière, utilisez le tracteur pour ajuster l’angle entre les deux remorques afin d’effectuer un virage plus serré ou un virage plus large."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Il n’y a pas de formule exacte pour y parvenir, vous devez simplement faire attention à ce qui se passe, tirer les leçons de vos erreurs et continuer à vous entraîner.<br><br>Quand vous le souhaitez, dirigez-vous vers la zone indiquée et sécurisez le véhicule.<br><br>N’hésitez pas à passer autant de temps que nécessaire à vous entraîner ici."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Commencez à reculer lentement. N’oubliez pas de commencer par de petites manœuvres, il n’est pas obligatoire de tout faire d’un seul coup.<br><br>Essayez de reculer en ligne droite ou d’amener la remorque vers le côté conducteur."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Prenez votre temps et ne vous découragez pas.<br><br>Tous les grands maîtres ont été débutants un jour."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Première correction en marche arrière"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "Dans ce scénario, nous devrons reprendre là où quelqu’un d’autre s’est arrêté."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Reculer"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Oh oh ! Quelqu’un d’autre s’est un peu énervé pendant sa marche arrière et a laissé son camion au beau milieu du parking."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Il y aura inévitablement des moments où vous vous retrouverez dans une situation impossible à résoudre. Pas d’inquiétude : avancez simplement pour sortir de la position en portefeuille jusqu’à retrouver une situation exploitable.<br><br>En cas de doute, essayez de tout redresser afin de repartir sur de bonnes bases."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "C’est une bonne position de départ. La remorque arrière est toujours orientée dans la direction souhaitée, et nous pouvons rapidement placer le tracteur devant la remorque de tête pour commencer à diriger l’ensemble dans la direction où nous voulons nous rendre."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Dirigez-vous vers la zone indiquée et sécurisez le camion.<br><br>Encore une fois, vous pouvez vous entraîner avec ce scénario jusqu’à ce que vous soyez à l’aise pour manœuvrer les remorques."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Il n’y a aucun moyen de sortir de ce pétrin. Avancez pour repartir sur de bonnes bases."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Commencez à reculer."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Marche arrière en ligne droite"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "Dans ce scénario, vous devez reculer un ensemble à double remorque en ligne droite."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Reculer"

#!{
