#### night_slalom_double into text

	key[]: "aca_msg_book3_night_slalom_cutscene01"
	val[]: "Le parcours comporte plusieurs slaloms dont la difficulté varie tout au long du parcours."

	key[]: "aca_msg_book3_night_slalom_cutscene02"
	val[]: "Prenez votre temps et n’oubliez pas d’anticiper votre trajectoire."

	key[]: "aca_msg_book3_night_slalom_cutscene03"
	val[]: "Il peut y avoir des endroits où vous devrez ralentir considérablement et faire preuve d’une grande précision.<br><br>Ne vous précipitez pas !"


#### night_slalom_double driving instructions

#!{
	key[]: "aca_msg_book3_night_slalom_double_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_msg_book3_night_slalom_double_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}
	key[]: "aca_msg_book3_night_slalom_double_forward"
	val[]: "Avancez lorsque vous êtes prêt(e).<br><br>N’oubliez pas d’allumer vos feux !"

	key[]: "aca_msg_book3_night_slalom_double_check0"
	val[]: "Conduisez à travers le slalom."

	key[]: "aca_msg_book3_night_slalom_double_stop"
	val[]: "Arrêtez-vous dans la zone indiquée."

	key[]: "aca_msg_book3_night_slalom_double_end"
	val[]: "Sécurisez le véhicule et coupez le moteur."



#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Se garer dans une courbe"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "Dans ce scénario, vous devez vous frayer un chemin à travers un parking bondé rempli de camions mal garés pour vous garer dans un virage."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Il n’est pas rare d’arriver sur un parking presque entièrement occupé par des camions, ce qui ne vous laisse que très peu d’options pour vous garer."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "Dans ce cas, il ne reste qu’un seul endroit où vous pouvez stationner avec votre ensemble à double remorque.<br><br>Traversez le parking et garez-vous dans le virage près de la sortie."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Traversez le parking et garez-vous le long de la courbe.<br><br>Continuez lorsque vous êtes prêt(e)."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Vous ne pourrez pas passer par ce virage : vous devrez faire demi-tour et trouver un autre chemin."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Garez-vous dans la courbe droit devant."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Arrêtez-vous dans la zone indiquée."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Sécurisez le camion et coupez le moteur."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Examen final"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "Dans ce scénario, vous mettrez vos nouvelles compétences à l’épreuve dans un parcours conçu pour tester votre précision et votre compréhension de la conduite d’un ensemble à double remorque."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Reculer"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Entrer sur le parcours"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Prendre de la vitesse"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Se préparer à freiner"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Vitesse insuffisante"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Se garer"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Bienvenue dans l’examen final. Nous avons mis en place quelques situations réalistes que vous pourriez rencontrer sur la route afin d’évaluer votre capacité à les gérer. Comme toujours, prenez votre temps et faites preuve de précision.<br><br>Bonne chance !"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "La route devant vous est bloquée : faites demi-tour dans l’espace prévu à cet effet."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Continuez sur le parcours."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Atteignez une vitesse d’au moins 60 km/h (37 mph) lorsque vous descendez la pente."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Se préparer à freiner."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Vous n’avez pas atteint une vitesse de 60 km/h (37 mph)."

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Continuez à rouler sur le parcours."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Il y a une place de stationnement pour vous dans la rangée de camions à droite. Reculez et garez-vous."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Continuez lorsque vous êtes prêt(e)."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

