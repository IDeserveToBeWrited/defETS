#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Contrôles et mouvements de base"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Apprenez les commandes de base du véhicule et comment déplacer le camion en marche avant et en marche arrière."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 1 : @@aca_chapter_book1_1_title@@.<br><br>Vous avez appris à préparer le camion avant de le conduire,<br>la marche avant, la marche arrière et l’utilisation des feux et des essuie-glaces.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Manœuvres de base"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Apprenez à conduire, à manœuvrer et à vous garer avec un tracteur. Découvrez l’utilité de chaque type de rétroviseur et comment l’utiliser."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 2 : @@aca_chapter_book1_2_title@@.<br><br>Vous avez appris à utiliser chaque rétroviseur du camion, à vérifier l’espace autour du camion avant de vous déplacer et à effectuer des manœuvres de base et avancées.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manœuvrer avec une remorque"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Apprenez à atteler et à manœuvrer avec une remorque dans différentes situations."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 3 : @@aca_chapter_book1_3_title@@.<br><br>Vous avez appris à atteler et à dételer une remorque,<br>à sentir le poids et les dimensions du camion avec une remorque<br>et à conduire sur des parcours difficiles avec une remorque.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Reculer avec une remorque"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Apprenez de nouvelles manœuvres pour reculer et vous garer efficacement avec une remorque."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 4 : @@aca_chapter_book1_4_title@@.<br><br>Vous avez appris à reculer avec une remorque<br>et diverses techniques de stationnement.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Examen final"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Démontrez vos connaissances et vos compétences pour prouver que vous méritez d’être routier !"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 5 : @@aca_chapter_book1_5_title@@.<br><br>Vous avez prouvé que vous avez toutes les compétences nécessaires<br>pour conduire, manœuvrer et garer un camion !</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Faire chauffer le moteur"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Vous avez terminé la formation : @@aca_chapter_book2_0_title@@.<br><br>Vous avez appris les règles et les caractéristiques de la maîtrise de la conduite.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Passer la seconde"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 2 : @@aca_chapter_book2_1_title@@.<br><br>Vous avez fait chauffer le moteur, passé la seconde, fait tourner les roues correctement et vérifié l’efficacité des freins. Les chapitres suivants seront plus difficiles.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Tout roule"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 3 : @@aca_chapter_book2_2_title@@.<br><br>Vous avez maîtrisé des scénarios difficiles et variés. Vous avez fait preuve de compétences et de performances.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Dernière ligne droite"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 4 : @@aca_chapter_book2_3_title@@.<br><br>Vous avez fait face à de nombreuses situations difficiles en matière de manœuvres, de stationnement et de marche arrière avec une remorque. Vous avez prouvé que vous faites preuve de compétences et êtes capable de gérer toutes les situations difficiles de la conduite d’un camion."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Avancer"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Maîtrisez toutes les techniques essentielles pour conduire un ensemble à double remorque en marche avant."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 1 : @@aca_chapter_book3_1_title@@.<br><br>Vous savez désormais conduire et manœuvrer efficacement un ensemble à double remorque.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Manœuvre en marche arrière"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Apprenez les étapes essentielles pour manœuvrer un ensemble à double remorque lors d’une marche arrière."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 2 : @@aca_chapter_book3_2_title@@.<br><br>Vous maîtrisez désormais l’art de la marche arrière avec un ensemble à double remorque.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Préparation au monde réel"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Appliquez vos nouvelles connaissances dans des scénarios plus avancés."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br>Vous avez terminé le chapitre 3 : @@aca_chapter_book3_3_title@@.<br><br>Vous avez surmonté de nombreuses situations difficiles en manœuvres, stationnement et marche arrière avec un ensemble à double remorque. Vous l’avez prouvé ici, il est maintenant temps de prendre la route avec plusieurs remorques sur les routes d’Euro Truck Simulator 2 !</font><br><br>"


#@}

