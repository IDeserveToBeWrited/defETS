	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Avancez jusqu’au bout de la rangée et trouvez votre place de stationnement."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Passez devant la place de stationnement pour vous assurer que votre remorque arrière s’aligne correctement dans la place, puis tournez tout en veillant à ce que l’avant de votre remorque de tête n’entre pas en contact avec le camion à côté de vous."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Continuez lentement tout en redressant l’ensemble, puis arrêtez-vous dans la zone indiquée."

