#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFOS SUR LA MAÎTRISE DE LA CONDUITE D’UN CAMION" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Conditions à remplir"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Pour terminer un scénario, il faut remplir toutes les conditions de réussite"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Les étoiles sont obtenues en remplissant les conditions boni"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Conditions"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Nombre maximal de changements entre la marche avant et la marche arrière"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Temps maximum alloué pour terminer un scénario pour une condition donnée"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Utilisation exclusive de la caméra intérieure (les caméras extérieures peuvent toujours être utilisées à l’arrêt)"

	key[]: "aca_book_book2_completed_t"
	val[]: "MAÎTRISE DE LA CONDUITE D’UN CAMION VALIDÉE"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br><br>Vous avez rempli toutes les conditions de réussite du module de la maîtrise de la conduite d’un camion et obtenu des récompenses pour votre profil de carrière. Vous pouvez encore vous mettre au défi d’obtenir davantage de récompenses en remplissant toutes les conditions bonus.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "MAÎTRISE DE LA CONDUITE D’UN CAMION TERMINÉE"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Félicitations !<br><br>Vous avez rempli toutes les conditions de réussite et bonus dans le module de maîtrise de la conduite d’un camion, et vous avez obtenu des récompenses pour votre profil de carrière.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Maîtrise de la conduite d’un camion"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Bon retour dans l’@@driving_academy@@ !"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Les scénarios suivants représentent la prochaine étape de votre parcours pour devenir chauffeur routier."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Cette fois-ci, nous ne vous guiderons pas dans chaque mission : c’est donc à vous de mettre en œuvre vos compétences et votre expérience."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Vous rencontrerez des manœuvres familières, mais cette fois dans de nouveaux environnements qui ressemblent davantage à des scénarios du monde réel."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "La nouveauté pour l’@@driving_academy@@ est l’ajout des conditions « Réussite » et « Bonus »."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Comme auparavant, vous devez toujours terminer chaque scénario sans rien heurter, en vous stationnant avec succès et en sécurisant le camion…"

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "… mais vous devez désormais le faire dans le temps imparti et en limitant le nombre de changements de direction entre la marche avant et la marche arrière."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Les conditions bonus peuvent être remplies en complétant chaque scénario avec des conditions encore plus difficiles…"

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "… comme des limites de temps plus strictes, moins de changements de direction et l’utilisation exclusive de la caméra intérieure."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "En terminant tous les scénarios, vous pouvez vous considérer comme un routier compétent et capable de relever le prochain défi sur la route.<br><br>Pour vous surpasser, remplissez toutes les conditions bonus de chaque scénario. Vous serez alors une véritable star de la conduite de camion !"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutoriel"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Dans ce scénario de tutoriel, nous vous aiderons à vous familiariser avec les nouvelles fonctionnalités de la maîtrise de la conduite d’un camion."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Au début de chaque scénario, vous verrez une fenêtre <color value=@@clr_sel@@>« Instructions du scénario »<color value=@@clr_txt@@>. Vous y trouverez des informations sur les nouvelles conditions de réussite et bonus du scénario.<br><br>Les conditions de réussite doivent être remplies pour terminer le scénario avec succès, tandis que les conditions bonus constituent un défi supplémentaire facultatif pour les joueurs expérimentés et habiles.<br><br><font face=/font/big_bold.font>Pour continuer, mettez le contact.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "L’une des conditions bonus exige que vous terminiez le scénario en utilisant la <color value=@@clr_sel@@>caméra intérieure<color value=@@clr_txt@@>. Vous pouvez toujours utiliser les caméras extérieures pour vérifier votre environnement, mais uniquement lorsque le camion est à l’arrêt.<br><br>Vous pouvez regarder autour de vous pour vous repérer, puis revenir à la caméra intérieure.<br><br><font face=/font/big_bold.font>Passez à la caméra poursuite pour contrôler les environs.</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Prenez vos repères, puis revenez à la caméra intérieure.<br><br><font face=/font/big_bold.font>Regardez autour du camion.</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Revenez à la caméra intérieure.</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "Le <color value=@@clr_sel@@>temps<color value=@@clr_txt@@> sera également un facteur dans la maîtrise de la conduite d’un camion. Tous les scénarios auront une limite de temps individuelle dans laquelle le scénario doit être terminé comme condition de réussite, et beaucoup auront également une limite supplémentaire, plus stricte, comme condition bonus.<br><br>Le chronomètre ne démarre qu’une fois le camion en mouvement.<br><br><font face=/font/big_bold.font>Démarrez le moteur et desserrez le frein à main pour continuer.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Les points de passage constituent une autre nouveauté de la maîtrise de la conduite d’un camion. Tous les points de passage doivent être atteints avant de pouvoir terminer un scénario.<br><br>En outre, les points de passage sont sensibles à la direction dans laquelle le camion est orienté au moment où le point de passage est atteint, donc faites attention à tout marquage au sol à proximité du point de passage pour vous orienter correctement.<br><br><font face=/font/big_bold.font>Avancez jusqu’au point de passage situé devant vous.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Vous avez atteint le point de passage et pouvez maintenant passer à l’étape suivante.<br><br>Il y a un autre point de passage derrière vous que vous devez atteindre en marche arrière. Observez la flèche au sol qui indique la direction dans laquelle le camion doit être orienté lorsque vous atteignez le point de passage.<br><br>Les <color value=@@clr_sel@@>changements de direction<color value=@@clr_txt@@> sont maintenant pris en compte dans les conditions de succès et bonus : nous comptons le nombre de fois où vous changez de direction entre la marche avant et la marche arrière. Restez en dessous de la limite pour remplir ces conditions.<br><br><font face=/font/big_bold.font>Reculez jusqu’au point de passage et arrêtez-vous.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "À ce stade, vous devriez avoir enregistré un changement de direction.<br><br>Attelez la remorque derrière vous pour passer à l’étape suivante.<br><br><font face=/font/big_bold.font>Reculez sous la remorque pour l’atteler.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Le dernier emplacement de stationnement se trouve sur votre droite. Certains scénarios ne comportent qu’un seul emplacement de parking, tandis que d’autres en proposent plusieurs. Si vous vous garez correctement sur l’une des places, vous pourrez terminer le scénario.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_attach@@ pour atteler la remorque.</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Les emplacements de stationnement indiquent également dans quel sens le camion doit être orienté sur l’emplacement. Si vous vous garez dans la mauvaise direction, vous ne pourrez pas terminer le scénario avant de corriger l’erreur, ce qui vous coûtera du temps et des changements de direction.<br><br><font face=/font/big_bold.font>Conduisez jusqu’à l’un des emplacements de parking et garez-vous correctement.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Maîtrise de la conduite d’un camion"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Vous devriez maintenant bien connaître les nouveaux paramètres de conditions de réussite et d’objectifs bonus. Vous devriez également être capable d’affronter les nouveaux scénarios de la maîtrise de la conduite d’un camion !<br><br><font face=/font/big_bold.font>Sécurisez le camion en serrant le frein de stationnement et en coupant le moteur pour terminer le scénario.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Raccourci"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "Dans ce scénario, vous tenterez d’utiliser un raccourci qui, malheureusement, est bloqué à sa sortie. Vous devrez alors refaire le trajet en marche arrière."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Conduisez jusqu’au point de passage situé en haut de la pente, puis faites une marche arrière en empruntant le même chemin.<br><br>Une fois de retour sur la route, conduisez jusqu’à l’aire de stationnement finale."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Lève-tôt"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "Dans ce scénario, vous devez vous frayer un chemin à travers un terrain surpeuplé. L’espace étant extrêmement limité, essayez d’anticiper vos déplacements."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Il y a des moments où le stationnement est tellement limité que les autres conducteurs se garent où ils peuvent pendant la nuit. Il peut alors être difficile de les contourner le matin.<br><br>Faites de votre mieux pour vous frayer un chemin jusqu’à la dernière place de stationnement."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Torsade"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "Dans ce scénario, vous devez conduire à travers un parcours d’entraînement très complexe. En cours de route, vous devez trouver une remorque et vous y atteler, puis l’emmener avec vous jusqu’à la fin."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Ce scénario mettra à l’épreuve votre perception spatiale et situationnelle. Le parcours est parsemé d’obstacles que vous ne pourrez pas toujours repérer facilement."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Traversez le parcours jusqu’à la remorque. Une fois que vous l’avez localisée, attelez-la et tractez-la jusqu’à l’emplacement final."



#@}

