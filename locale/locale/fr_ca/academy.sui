#!{
	key[]: "aca_msg_book3_shortcut_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_shortcut_check2"
	val[]: "En entrant dans le dépôt, vous trouverez plusieurs places de stationnement parmi lesquelles choisir. Choisissez-en une et garez-vous."

