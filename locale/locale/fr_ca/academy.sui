#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Se garer à proximité d’un obstacle"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Dans ce scénario, nous allons apprendre à nous garer à côté d’un trottoir en utilisant le rétroviseur latéral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Vérifier le rétroviseur d’accostage"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Conduire en direction du trottoir"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Le rétroviseur d’accostage est un autre outil qui vous aidera à manœuvrer le camion en toute sécurité. Il est situé sur le cadre supérieur de la porte du passager."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Avancez et tournez lentement en direction du côté passager."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Ces planches en bois représentent une bordure de trottoir. Vous devez vous garer à côté.<br>Tournez vers le bord du trottoir pour mettre le camion en bonne position et l'aligner sur la place de stationnement."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Ralentissez bien avant le bord du trottoir et tournez vers la place de stationnement. En redressant, vous pouvez utiliser le rétroviseur d’accostage pour évaluer la distance qui vous sépare du trottoir."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Arrêtez-vous sur la place de stationnement et sécurisez le camion."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Regardez par la fenêtre du côté passager. Vous pouvez y voir le rétroviseur d’accostage.</font>@@aca_goal_tip@@ Vous devez vous trouver à l’intérieur du véhicule."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Le rétroviseur d’accostage couvre la zone du côté passager où le conducteur ne peut pas voir. C’est l’un des angles morts les plus problématiques du camion. Si l’angle du rétroviseur ne vous convient pas, vous pouvez le régler dans « @@adjust_link_t@@ ».<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Le camion n’est toujours pas prêt à partir, peut-être avez-vous oublié quelque chose ?<br><br>Le moteur est-il en marche ? Avez-vous desserré le frein de stationnement ?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Devant vous, il y a une rangée de planches représentant une bordure. Au bout du trottoir se trouve une place de stationnement. Vous devez vous y rendre.<br><br><font face=/font/big_bold.font>Procédez quand vous êtes prêt(e).</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Tournez en direction du trottoir. Utilisez l’antéviseur et le rétroviseur d’accostage pour vérifier votre position par rapport au trottoir, mais veillez également à ne pas écraser les cônes de signalisation.<br><br><font face=/font/big_bold.font>Conduisez jusqu’au bord du trottoir et placez-vous sur la place de stationnement.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Sécurisez le camion et coupez le moteur.</font>@@aca_goal_tip@@ Vous pouvez utiliser les préréglages de vue intérieure pour faciliter l’observation des rétroviseurs. Consultez l'écran des options - \"@@options_bindings_screen@@\" pour voir et/ou modifier les commandes correspondantes."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Se garer en marche arrière à côté d’un obstacle"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Dans ce scénario, nous allons reculer pour garer le camion sur une place de parking le long d’un trottoir."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instructions"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Reculer vers le bord du trottoir"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Garer le camion"
