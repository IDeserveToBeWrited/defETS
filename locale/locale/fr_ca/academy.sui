#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Reculer avec une remorque"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Dans ce scénario, vous allez vous essayer pour la première fois à la marche arrière avec une remorque. Il s’agit d’une manœuvre assez simple, mais vous devrez tout de même diriger correctement la remorque pour la mettre dans la bonne position."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Reculer jusqu’à la remorque"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Atteler la remorque"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Relâcher le frein de stationnement"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Reculer avec la remorque"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Continuer jusqu’à la place de stationnement"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Essayons de reculer avec une remorque. C’est plus facile qu’il n’y paraît, il suffit de faire preuve de patience."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Commencez à reculer et alignez le tracteur avec la remorque."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Assurez-vous qu’il soit bien aligné, sinon vous ne pourrez pas l’atteler. Si vous n’y arrivez pas, vous pouvez toujours avancer et réessayer."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "La sellette du tracteur se verrouille sur le pivot d’attelage de la remorque."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Serrez le frein de stationnement et attelez la remorque. Dans le monde réel, vous devez sortir du camion pour brancher les conduites d’air et d’électricité et relever les béquilles, mais en jeu, nous le ferons pour vous."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>La remorque tournera toujours <color value=@@clr_sel@@>à l’opposé <color value=@@clr_txt@@>du tracteur."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Pour faire tourner la remorque, vous devez diriger le tracteur dans la direction <color value=@@clr_sel@@>opposée<color value=@@clr_txt@@> à celle vers laquelle vous voulez que la remorque se dirige."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Pour redresser la remorque, orientez le tracteur <br><color value=@@clr_sel@@>vers<color value=@@clr_txt@@> la remorque."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Essayez de maintenir le tracteur aligné avec la remorque : vous devrez constamment faire de petites corrections pour que la remorque reste orientée vers la zone indiquée."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corrigez les écarts de trajectoire en donnant de petits coups de volant dès qu’ils se produisent. Si vous donnez trop de coups de volant, vous risquez de vous éloigner de la trajectoire souhaitée."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Arrêtez-vous dans la zone indiquée. Sécurisez le camion et coupez le moteur."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Derrière vous côté passager, vous verrez une remorque. Votre première tâche sera de reculer jusqu’à elle.<br><br><font face=/font/big_bold.font>Préparez le camion à reculer.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Commencez à reculer en direction de la remorque.</font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Alignez-vous de manière à être dans l’axe de la remorque. La sellette doit s’accrocher au pivot d’attelage. Avancez pour ajuster votre trajectoire si nécessaire.<br><br><font face=/font/big_bold.font>Continuez à reculer jusqu’à ce que vous sentiez une connexion.</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "La sellette s’est accouplée au pivot d’attelage et vous pouvez terminer l’attelage à la remorque.<br><br><font face=/font/big_bold.font>Serrez le frein de stationnement.</font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font>Appuyez sur @@imv_nrm_attach@@ pour atteler la remorque.</font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "La remorque est désormais solidement attachée au tracteur, les flexibles d’air et d’électricité sont connectés et les béquilles sont relevées.<br><br><font face=/font/big_bold.font>Relâchez le frein de stationnement.</font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Vous devez reculer jusqu’à la place de stationnement située juste derrière vous. N’oubliez pas que la remorque tournera dans la direction opposée à celle dans laquelle vous dirigez le tracteur et qu’un petit tour de volant peut entraîner un mouvement important de la remorque.<br><br><font face=/font/big_bold.font>Commencez à reculer la remorque.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Ne survirez pas, essayez simplement de garder la remorque alignée avec l’emplacement.<br><br><font face=/font/big_bold.font>Continuez en direction de la place de stationnement.</font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

