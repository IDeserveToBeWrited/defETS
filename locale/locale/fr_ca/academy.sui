#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Conduire dans des virages complexes"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Dans ce scénario, nous allons explorer les possibilités de manœuvrer la remorque sur un court parcours d’obstacles avec des virages plus complexes."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Premiers virages"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Conduire dans un passage étroit"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Virage serré à 90 degrés"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Contourner les obstacles"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Devant vous se dressent des virages et des obstacles nombreux et complexes.<br>Prenez en compte tout ce que vous avez appris jusqu’à présent. Vous ne devriez pas rencontrer trop de difficultés."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Le marquage au sol peut vous donner une idée de la marche à suivre pour franchir chaque série d’obstacles."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Gardez le tracteur à l’extérieur du virage.<br>Vous devrez vous écarter au maximum, car la remorque suit un chemin plus court."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Le prochain virage est un virage facile à 90 degrés.<br>Une fois de plus, gardez le camion à l’extérieur du virage et utilisez tout l’espace disponible."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Prenez votre temps. Le parcours devient plus large, mais il faut toujours faire preuve de précision."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Restez à l’écart des barrières."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Faites preuve de prudence lorsque vous entrez dans cette section étroite.<br>Utilisez le plus d’espace possible avec le tracteur bien avant d’entrer pour préparer le passage de la remorque."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Le dernier virage à 90 degrés est beaucoup plus serré que le premier, mais il y a beaucoup de place si vous l’utilisez judicieusement."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Arrêtez-vous dans la zone indiquée, puis sécurisez le camion et coupez le moteur."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "N’oubliez pas d’utiliser les marquages au sol pour vous aider à naviguer sur le parcours.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "L’utilisation des rétroviseurs vous aidera également à naviguer en toute sécurité. Vous devez toujours avoir pleine conscience de la façon dont la remorque se déplace derrière vous.<br><br><font face=/font/big_bold.font>Franchissez le premier virage.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observez la remorque lorsque vous sortez du virage et vous préparez à entrer dans le suivant.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Continuez jusqu’au prochain virage.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "N’oubliez pas d’observer votre remorque pour vous assurer que vous n’avez pas d’obstacles autour de vous avant de tourner avec le camion.<br><br><font face=/font/big_bold.font>Continuez à contourner l’obstacle.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Lorsque votre remorque est dégagée de la barrière, tournez à bloc vers le côté passager pour vous aligner sur le passage étroit.<br><br><font face=/font/big_bold.font>Avancez vers le passage étroit.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Cette section nécessite une conduite très précise. Prenez votre temps et utilisez les rétroviseurs.<br><br><font face=/font/big_bold.font>Restez à l’extérieur de chaque virage.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ce virage est très serré, mais vous pouvez utiliser tout l’espace devant vous pour le passer facilement.<br><br><font face=/font/big_bold.font>Franchissez le dernier virage.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Cours de formation avancé (remorque)"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "Dans le dernier scénario du chapitre 3, nous emprunterons un parcours d’entraînement plus long avec plusieurs virages différents pour voir si vous avez bien appris à manœuvrer avec une remorque."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Chicane"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "RETIRER CET OBJECTIF"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Traversée du terre-plein"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Premier slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Second slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Virages faciles"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rond-point"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Section droite"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Virage serré"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Derniers virages"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Conduire jusqu’à l’emplacement de stationnement"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Dans ce scénario, vous devrez emprunter plusieurs virages qui vous aideront à vous habituer à la conduite avec une remorque. Concentrez-vous, adaptez votre vitesse à chaque situation et utilisez pleinement l’espace disponible sur le parcours de formation."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Le premier virage est une chicane : deux virages en un. Vous devrez vous préparer à un virage à gauche, mais passer à un virage à droite au milieu de la manœuvre."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Le virage suivant vous amène de l’autre côté du terre-plein central. Ce n’est pas particulièrement difficile, mais vous devrez veiller à laisser suffisamment d’espace pour votre remorque."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Ensuite, vous devrez négocier un slalom serré entre les barrières en béton. Avancez lentement, utilisez les rétroviseurs et veillez à vous écarter suffisamment pour que votre remorque puisse franchir les barrières."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "À ce stade, vous allez entrer dans un autre slalom accompagné de cônes supplémentaires à la pointe de chaque courbe.<br>Veillez à ne pas les heurter !"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Il y a ensuite quelques virages faciles à prendre avant d’arriver au rond-point."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Utilisez la section droite pour vous préparer à entrer dans le rond-point. Restez à l’extérieur avant de vous y engager."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Entrez dans le rond-point et observez le positionnement de votre remorque. Elle se déplacera différemment une fois que vous serez à l’intérieur du rond-point par rapport à la façon dont vous y êtes entré(e)."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Sortez du rond-point et continuez jusqu’à la prochaine série de virages."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "RETIRER CETTE CINÉMATIQUE"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Le virage est extrêmement serré. Allez-y doucement et utilisez l’espace autour de vous intelligemment. Faites également attention au déplacement de l’arrière de la remorque."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Lorsque vous passerez les prochains virages, n’oubliez pas d’essayer de vous préparer pour le virage à venir lorsque vous sortez du précédent."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Ne vous précipitez pas dans le dernier virage. Il semble facile, mais vous avez en réalité moins de marge de manœuvre."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Arrêtez-vous dans la zone indiquée, sécurisez le camion et coupez le moteur."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Accélérez en direction du premier virage.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Le premier virage est une chicane simple.<br><br><font face=/font/big_bold.font>Passez le virage.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "RETIRER CE CONTRÔLE"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Plus loin, le parcours continue sur la gauche du terre-plein central.<br><br><font face=/font/big_bold.font>Frayez-vous un chemin dans le croisement.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manœuvrez entre les barrières et n’oubliez pas de surveiller la remorque.<br><br><font face=/font/big_bold.font>Franchissez le slalom.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Ce slalom est plus simple, mais les cônes de signalisation le rendent nettement plus serré.<br><br><font face=/font/big_bold.font>Franchissez le slalom en évitant de heurter les cônes.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Il y a quelques virages faciles à prendre, mais vous devrez tout de même vous organiser correctement pour que votre remorque reste éloignée des barrières intérieures.<br><br><font face=/font/big_bold.font>Prenez les virages.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Vous vous approchez d’un rond-point. N’oubliez pas de laisser suffisamment d’espace pour votre remorque, non seulement à l’entrée et à la sortie du rond-point, mais aussi lorsque vous le franchissez.<br><br><font face=/font/big_bold.font>Franchissez le rond-point.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Il y a une courte ligne droite devant vous, vous pouvez prendre un peu de vitesse si vous le souhaitez.<br><br><font face=/font/big_bold.font>Poursuivez votre route.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Le virage est extrêmement serré. Allez-y lentement, utilisez tout l’espace dont vous disposez et gardez à l’esprit le mouvement de l’arrière de votre remorque.<br><br><font face=/font/big_bold.font>Passez le virage serré.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Les derniers virages sont directs. N’oubliez pas de garder votre remorque à l’esprit.<br><br><font face=/font/big_bold.font>Continuez.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Continuez jusqu’à la place de stationnement finale.</font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

