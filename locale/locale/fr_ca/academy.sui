	key[]: "aca_goal_book3_lucky_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_lucky_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_lucky_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### lucky msg - intro text

	key[]: "aca_msg_book3_lucky_cutscene1"
	val[]: "Les parkings bondés peuvent être le cauchemar de tout routier, mais, pour ceux qui conduisent des ensembles à double remorque, il est particulièrement difficile de s’y faufiler.<br><br>Il va falloir faire preuve de créativité pour vous sortir de cette situation."

#### lucky Driving Instructions

#!{
	key[]: "aca_msg_book3_lucky_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_lucky_forward"
	val[]: "Trouvez un moyen de sortir du parking et de rejoindre la route."

#!{
	key[]: "aca_msg_book3_lucky_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"

	key[]: "aca_msg_book3_lucky_stop"
