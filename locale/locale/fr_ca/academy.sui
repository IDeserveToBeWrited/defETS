#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Stationnement en épi"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Dans ce scénario, vous allez vous garer sur une place de stationnement en épi dans un parking très fréquenté.<br><br>Il n’y a pas beaucoup d’espace pour manœuvrer, vous devrez donc faire preuve de précision et de prudence dans votre conduite."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "S’approcher de la place de stationnement"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Les places de stationnement en épi comme celle-ci sont très courantes. Elles sont particulièrement fréquentes sur les nombreuses aires de repos qui bordent les autoroutes européennes.<br>Une fois de plus, nous devrons nous diriger vers la place de stationnement qui se trouve devant nous."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Dirigez-vous vers la place de stationnement indiquée à l’extrémité de la rangée."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Restez au milieu de la voie, ou légèrement du côté conducteur. Ne roulez pas trop près des barrières, car l’arrière de la remorque pourrait les heurter pendant le virage."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Passez devant la place de stationnement suffisamment loin, puis tournez à toute vitesse en direction de la place. Vous devrez surveiller les deux rétroviseurs latéraux : le rétroviseur côté conducteur pour vous assurer que l’avant de votre remorque ne heurte pas la remorque située à côté de vous, et le rétroviseur côté passager pour vous assurer que votre remorque entre en toute sécurité dans l’emplacement de stationnement."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Arrêtez-vous dans la zone indiquée, sécurisez le camion et coupez le moteur."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Lorsque vous vous garez en épi, il est important d’évaluer votre position avec précision. Une fois le virage amorcé, il est difficile de faire marche arrière et de se repositionner en toute sécurité. Il est donc préférable de s’assurer d’avoir suffisamment de place dès la première tentative.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Commencez à conduire vers la place de stationnement.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Dépassez la place de stationnement afin que votre remorque puisse contourner le camion qui se trouve à l’intérieur.<br><br><font face=/font/big_bold.font>Tournez dans la place de stationnement.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Reculer à contre-main"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Dans ce scénario, nous allons nous intéresser à la marche arrière « sans visibilité » pour garer le camion sur une place de stationnement. Sans la possibilité de regarder par la fenêtre pour voir où vous allez, vous devrez vous fier uniquement aux rétroviseurs pour vous rendre à votre destination."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Dans ce scénario, vous allez apprendre à manœuvrer en marche arrière « sans visibilité ». La marche arrière à contre-main doit généralement être évitée, sauf s’il n’y a pas d’autre solution, car votre visibilité est fortement réduite. Prenez votre temps et faites preuve d’une extrême prudence."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Dépassez largement la place de stationnement pour vous donner de la marge de manœuvre lorsque vous commencerez à reculer."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Arrêtez-vous, contrôlez votre environnement, puis commencez à reculer."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Dirigez le tracteur de façon à l’éloigner de l’emplacement. L’avant de la remorque sera ainsi repoussé et l’arrière de la remorque sera orienté vers la place de stationnement que vous souhaitez occuper. Veillez à ne pas exagérer la manœuvre, car vous risqueriez de mettre l’ensemble du camion en portefeuille."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Lorsque la remorque entre dans la place de stationnement, commencez à redresser le camion."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Arrêtez-vous dans la zone indiquée et sécurisez le camion."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "La marche arrière à contre-main nécessite les mêmes méthodes que la marche arrière à main, mais avec le handicap du manque de visibilité. Utilisez les rétroviseurs et votre savoir-faire pour garer le camion.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Il y a une place de stationnement devant et du côté passager. Vous devrez avancer bien au-delà de cette place afin d’avoir assez d’espace pour reculer.<br><br><font face=/font/big_bold.font>Avancez.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "N’oubliez pas que si vous éloignez le camion de la place, la remorque se dirigera vers elle. Utilisez les rétroviseurs au mieux pour vous aider à vous garer.<br><br><font face=/font/big_bold.font>Commencez à reculer.</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Conduire dans un rond-point"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Dans ce scénario, nous verrons comment négocier un rond-point.<br><br>Vous devrez prêter une attention particulière à votre remorque, car elle suivra votre trajectoire différemment selon que vous entrez dans le rond-point, que vous le franchissez ou que vous en sortez."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entrer dans le rond-point"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Conduire dans le rond-point"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Conduire dans le rond-point"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Sortir du rond-point"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Conduire vers la zone indiquée"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Les ronds-points sont très répandus en Europe, il est donc important de savoir les négocier."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Restez à l’extérieur de votre voie lorsque vous vous approchez du rond-point. Cela aidera votre remorque à passer à l’intérieur du premier virage."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Dirigez-vous vers le centre du rond-point en entrant. Une fois à l’intérieur, vous devrez vous diriger vers l’extérieur pour éloigner votre remorque du centre du rond-point."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Gardez un œil sur le rétroviseur pour vous assurer que la remorque ne s’approche pas trop des barrières intérieures."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "La sortie du rond-point est assez facile puisque votre remorque est déjà positionnée loin de l’intérieur de la sortie. En élargissant la trajectoire à la sortie, la remorque devrait bien suivre."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Garez-vous dans la zone indiquée et sécurisez le camion."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Devant vous, un rond-point est aménagé pour que vous puissiez y circuler.<br><br><font face=/font/big_bold.font>Approchez lentement du rond-point.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Prenez un virage large à l’entrée du rond-point afin que votre remorque puisse entrer derrière vous sans problème.<br><br><font face=/font/big_bold.font>Entrez dans le rond-point.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Conduisez vers l’extérieur du rond-point. Vous devrez maintenir le camion aussi loin que possible du centre du rond-point afin d’éloigner votre remorque des barrières centrales.<br><br><font face=/font/big_bold.font>Continuez dans le rond-point.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Restez près des cônes extérieurs.<br><br><font face=/font/big_bold.font>Poursuivez votre route.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Sortez du rond-point.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Conduisez jusqu’à la place de stationnement qui se trouve devant vous.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Arrêtez-vous dans la zone indiquée.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Sécurisez le camion et coupez le moteur.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manœuvrer dans un espace étroit"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Pour le dernier scénario, vous devrez faire demi-tour dans un espace étroit. Vous devrez reculer à contre-main dans une zone où l’espace de manœuvre est limité, ce qui nécessitera une attention particulière à votre environnement et une utilisation intelligente de l’espace."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Conduire sur le parcours"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Préparer la manœuvre à contre-main"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Reculer dans l’emplacement"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Terminer la manœuvre à contre-main"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Sortir du parcours"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Dans ce scénario, nous allons voir comment faire demi-tour dans un espace restreint à l’aide d’une marche arrière à contre-main. Cette compétence vous sera utile lorsque vous ne pouvez pas faire demi-tour ou reculer du côté conducteur."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Le marquage au sol vous aidera à vous orienter dans le parcours de formation."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Effectuez un virage large pour vous assurer que votre remorque ne heurte pas les camions stationnés."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "En sortant du virage, réfléchissez à la manière dont vous allez placer le camion pour votre manœuvre de recul."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Il est préférable que le camion soit orienté en direction de la place de stationnement vide du côté passager, dans laquelle vous allez reculer."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Les marches arrière à contre-main doivent être évitées dans la mesure du possible, car la visibilité y est nettement réduite. Malheureusement, il y a des moments où vous n’aurez pas d’autre choix."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Tournez le volant avant de reculer. Cela permettra à votre remorque de se diriger immédiatement là où vous le souhaitez, ce qui est utile dans les situations très serrées."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Une fois la remorque bien placée, positionnez le tracteur devant la remorque et redressez-le."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Arrêtez-vous une fois que vous avez redressé le camion et que vous avez suffisamment de place pour avancer de nouveau. Repartez dans la même direction de votre arrivée."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Suivez le marquage au sol pour sortir du parcours de formation."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Passez le virage et dirigez-vous vers la zone indiquée."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Arrêtez-vous."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Sécurisez le camion et coupez le moteur."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Dans la zone qui se trouve devant vous, il y a un parcours de formation qui représente le terrain d’une société de transport. Votre tâche consiste à vous y rendre et à faire demi-tour avec le camion pour ressortir. Veillez à bien utiliser l’espace qui vous entoure.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Avancez en direction du parcours de formation.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Tournez dans l’angle et continuez sur le parcours.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Suivez le marquage au sol jusqu’à la barrière située à la fin du parcours. Garez-vous un peu en biais de manière à ce que votre remorque soit orientée vers la place de stationnement vide côté passager.<br><br><font face=/font/big_bold.font>Poursuivez votre route.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Vous avez une vision beaucoup plus limitée de ce qu’il se passe autour de vous à contre-main. Allez-y lentement, utilisez les rétroviseurs et privilégiez la prudence.<br><br><font face=/font/big_bold.font>Commencez à reculer et orientez la remorque vers la place de stationnement vide.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Vous êtes suffisamment loin. Vous pouvez maintenant avancer et quitter le terrain d’entraînement par la même direction de votre arrivée.<br><br><font face=/font/big_bold.font>Commencez à vous diriger vers la sortie.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Sortez du parcours de formation.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Suivez le marquage au sol jusqu’à l’emplacement final.<br><br><font face=/font/big_bold.font>Rendez-vous dans la zone indiquée.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manœuvre de recul"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Dans ce scénario, vous devrez reculer pour vous garer sur une place de parking qui n’est pas directement derrière vous. L’espace de manœuvre est limité, vous devez donc l’utiliser à bon escient."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Dans ce scénario, votre tâche consistera à vous garer dans l’espace situé à côté de vous. Il n’y a pas beaucoup de place pour manœuvrer, vous devrez donc faire un peu plus d’efforts pour amener la remorque là où vous le souhaitez."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Conduisez tout droit jusqu’à la barrière."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Arrêtez-vous avant la barrière."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Tournez le volant énergiquement vers le côté conducteur avant de vous déplacer. De cette façon, vous commencerez à diriger la remorque vers la place de stationnement dès que vous commencerez à reculer, ce qui vous permettra d’économiser de l’espace."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Une fois la remorque orientée vers l’emplacement souhaité, alignez le tracteur avec la remorque et commencez à la diriger vers la place de stationnement."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "À partir de là, la manœuvre n’est pas très différente d’une manœuvre de stationnement normale."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continuez à reculer et surveillez les deux côtés. Gardez le tracteur et la remorque dans l’alignement de la place de stationnement."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Arrêtez-vous dans la zone indiquée, sécurisez le camion et coupez le moteur."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Vous êtes sur une place de parking, mais il y a une deuxième place de stationnement sur votre droite vers laquelle vous devez vous diriger.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Il y a une zone délimitée devant vous.<br><br><font face=/font/big_bold.font>Avancez.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "N’oubliez pas de commencer à braquer immédiatement, car il n’y a pas beaucoup de place.<br><br><font face=/font/big_bold.font>Reculez jusqu’à l’endroit indiqué derrière vous.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Conduire dans des virages simples"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Dans ce scénario, vous effectuerez un court trajet dans le cadre d’une formation qui vous aidera à apprendre à manœuvrer la remorque dans des virages simples à 90 degrés."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Prendre le premier virage"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Deuxième virage"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Dernier virage"
#!{
	key[]: "aca_goal_book1_3_15_check5"
