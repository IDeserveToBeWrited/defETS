#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Devant vous se trouvent des virages serrés avec peu d’espace libre. Ces virages vous apprendront à manœuvrer efficacement la remorque."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Suivez le marquage au sol en direction de la barrière côté conducteur pour vous préparer pour le premier virage."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Restez près de la barrière extérieure dans le virage et la remorque devrait vous suivre gentiment dans le parcours."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Continuez à suivre le marquage au sol pour vous préparer pour le deuxième virage, un virage serré à 90 degrés."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Vous devrez vous engager assez loin dans le virage pour que votre remorque puisse franchir les barrières intérieures. Utilisez votre antéviseur pour vous aider à aller le plus loin possible dans le virage sans heurter quoi que ce soit."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continuer le long de la barrière extérieure."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Une fois de plus, un autre virage serré à 90 degrés vous obligera à utiliser tout l’espace dont vous disposez."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Arrêtez-vous dans la zone indiquée et sécurisez le camion."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "N’oubliez pas d’utiliser toute la marge de manœuvre dont vous disposez pour vous aider à négocier chaque virage.<br><br><font face=/font/big_bold.font>Lancez-vous et suivez le marquage au sol à l’extérieur.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Suivez la barrière extérieure tout autour, mais gardez un œil sur votre remorque dans le rétroviseur.<br><br><font face=/font/big_bold.font>Effectuez le premier virage.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Suivez le marquage au sol pour vous préparer au virage à 90 degrés qui vous attend.<br><br><font face=/font/big_bold.font>Effectuez le virage à 90 degrés.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Gardez le camion au large après le virage, car un autre virage à 90 degrés encore plus serré vous attend.<br><br><font face=/font/big_bold.font>Poursuivez votre route.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Conduisez jusqu’à la place de stationnement qui se trouve devant vous.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Stationnement en épi en marche arrière"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Dans ce scénario, nous allons étudier la possibilité de se garer en épi tout en reculant. Cette situation peut se produire sur les aires de repos, les relais routiers et même dans les entreprises. Souvent, il y a peu de place, car les aires sont bondées de camions, et le stationnement est d’autant plus difficile que l’espace est réduit."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Faire tourner la remorque"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Le stationnement en épi semble plus facile à première vue, mais il est souvent plus difficile que les manœuvres typiques de marche arrière."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Reculez vers la place de stationnement. Pour l’instant, le tracteur et la remorque doivent rester alignés."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Au fur et à mesure que vous vous rapprochez, laissez votre remorque s’approcher des camions stationnés. Cela vous aidera à la faire tourner à l’endroit voulu."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Commencez à faire tourner la remorque vers la place de stationnement. Gardez votre remorque près du camion situé côté conducteur, car vous aurez besoin de l’espace de l’autre côté."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Une fois que la remorque est bien placée sur la place de stationnement, commencez à faire tourner le tracteur pour suivre la remorque."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Garez-vous dans la zone indiquée, sécurisez le camion et coupez le moteur."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Garez le camion dans l’espace derrière vous. Utilisez les deux rétroviseurs pour naviguer en marche arrière.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Vérifiez les alentours, puis dirigez-vous vers la place de stationnement.<br><br><font face=/font/big_bold.font>Commencez à reculer.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Commencez à déplacer la remorque vers les camions à côté de vous. Lorsque vous êtes prêt(e), orientez la remorque vers la place de stationnement. N’oubliez pas de tenir compte du déplacement de l’arrière de la remorque.<br><br><font face=/font/big_bold.font>Tournez dans la place de stationnement.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Reculer dans un virage"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Dans ce scénario, nous ferons pour la première fois une marche arrière avec une remorque dans un virage. Nous explorerons les principes de base de la marche arrière et les points à surveiller lors d’un virage en marche arrière."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Faire tourner la remorque"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Dans ce scénario, vous devrez reculer jusqu’à la place de stationnement qui se trouve derrière vous, côté conducteur."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Il y a quelques conseils à retenir qui vous aideront beaucoup lorsque vous reculez avec des remorques.<br>La remorque voudra toujours tourner dans la direction opposée à celle dans laquelle vous dirigez le tracteur."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Vous pouvez avoir une bonne idée de la direction que prend la remorque en observant les essieux du camion et de la remorque."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "De petites corrections vous permettront d’aller là où vous le souhaitez, pas besoin de trop tourner."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Commencez à éloigner légèrement le tracteur de la place de stationnement : la remorque commencera à se diriger vers celle-ci."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Suivez la remorque en effectuant des ajustements au fur et à mesure pour la maintenir sur la bonne voie."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Surveillez les roues de votre remorque et la roue arrière du tracteur. Elles vous indiqueront dans quelle direction la remorque est orientée et dans quelle direction le tracteur la pousse."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Il est toujours plus facile de tourner la remorque plus fermement que d’essayer de la redresser après une mise en portefeuille. Visez l’extérieur de l’emplacement jusqu’à ce que vous en soyez plus proche, puis vous pourrez tourner un peu plus énergiquement pour aligner votre remorque."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Lorsque la remorque entre dans la place de stationnement, placez le tracteur devant la remorque. Essayez d’éviter de trop nombreux ajustements à l’intérieur de la place."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Reculez entre les barrières, vérifiez les deux côtés au fur et à mesure."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Sécurisez le camion et coupez le moteur."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "N’oubliez pas ces conseils lorsque vous reculez dans un virage avec une remorque :<br><br>— La remorque tourne dans la direction opposée à celle dans laquelle vous dirigez le tracteur.<br><br>— Observez les roues de la remorque pour voir où elle se dirige.<br><br>— Observez la roue arrière du tracteur pour voir où celui-ci pousse la remorque.<br><br>— Laissez la remorque faire le travail, ne survirez pas.<br><br>— Il est toujours plus facile d’orienter la remorque plus fermement que de la redresser.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre la route.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Regardez derrière vous pour savoir où vous devez vous rendre. Vérifiez toujours votre environnement avant de commencer à reculer.<br><br><font face=/font/big_bold.font>Commencez à reculer vers la place de stationnement.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Commencez à diriger la remorque vers la place de stationnement et suivez-la à l’intérieur.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Arrêtez-vous dans l’emplacement indiqué.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Se garer en marche arrière dans un emplacement étroit"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Dans ce scénario, vous devrez faire reculer la remorque dans une place de stationnement sur un parking très fréquenté."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Faire tourner la remorque"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Il s’agit d’un parking typique pour camions. Les routiers rencontreront ces situations de stationnement presque quotidiennement au cours de leur carrière.<br>Se garer ici nécessite une manœuvre de stationnement en bataille."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Il s’agit d’une manœuvre similaire au scénario précédent, mais vous aurez moins de marge de manœuvre : vous devrez donc planifier vos mouvements en conséquence et faire attention à ne rien heurter."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Comme il y a moins de place, le timing est plus important. Orientez la remorque au bon moment et surveillez les roues du tracteur et de la remorque pour voir où celle-ci se dirige. Gardez à l’esprit le mouvement de l’arrière et évitez la mise en portefeuille. Continuez à pousser la remorque."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Essayez de rester près du camion du côté conducteur : cela donne à votre remorque de la place pour pivoter et vous pouvez moins vous soucier du camion du côté passager."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Une fois que votre remorque est dans l’emplacement, alignez le tracteur devant elle. Il est préférable de le faire plus tôt que ce que votre instinct vous dicte au début. Vous pouvez toujours corriger la direction lorsque vous reculez jusqu’à la position finale."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Redressez le tracteur et la remorque, et arrêtez-vous dans la zone indiquée."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Sécurisez le camion et coupez le moteur."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Nous allons maintenant essayer de faire tourner une remorque dans un espace beaucoup plus restreint en effectuant une manœuvre de stationnement en bataille.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Vérifiez votre environnement et cherchez la place de stationnement derrière vous.<br><br><font face=/font/big_bold.font>Commencez à reculer vers la place de stationnement.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Dirigez la remorque dans la place de stationnement.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Examen final (partie 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "L’examen final vous attend, où toutes les compétences que vous avez apprises lors des scénarios précédents seront mises à l’épreuve. Nous ferons un tour dans tout le centre de formation pour voir dans quelle mesure vous avez appris les situations que vous avez rencontrées jusqu’à présent.<br><br>Une fois que vous aurez terminé toutes les sections et manœuvres, vous pourrez passer à la prochaine étape pour valider votre formation de routier professionnel !"

