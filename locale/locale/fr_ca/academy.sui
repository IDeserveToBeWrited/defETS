	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Commandes de la caméra"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Dans ce scénario, nous découvrirons les différents types de caméras disponibles et la manière dont ils peuvent vous aider à contrôler et à manœuvrer le camion."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Position sur le siège"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Vue vers l’arrière"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Contrôle des rétroviseurs"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Passer à la caméra extérieure"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Regarder autour du camion"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Dans ce scénario, nous allons passer en revue<br>les différentes caméras disponibles."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Il existe sept caméras au total. Nous allons maintenant en examiner<br>quelques-unes et expliquer les fonctions auxquelles elles sont destinées."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Les différentes caméras et leurs angles de vue peuvent vous aider à manœuvrer dans des endroits étroits."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Regarder où l’on va est la base d’une conduite sûre et professionnelle. Si la position sur le siège actuelle ne vous convient pas, vous pouvez la modifier dans « @@adjust_link_t@@ » (Accès via le menu pause).<br><br><font face=/font/big_bold.font>Confirmez pour commencer avec @@imv_nrm_activate@@.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Lorsque vous reculez, les rétroviseurs n’offrent pas toujours une vue parfaite. Il peut être nécessaire de regarder derrière vous par la fenêtre pour avoir une meilleure vue.<br><br><font face=/font/big_bold.font>Tournez complètement votre caméra du côté du conducteur pour regarder à travers la fenêtre vers l’arrière de la remorque.</font>@@aca_goal_tip@@ Vous devez vous trouver à l’intérieur du véhicule."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Utilisez cette vue pour contrôler la remorque lors des manœuvres lorsque vous reculez avec une remorque. Il est toujours préférable de reculer du côté conducteur pour utiliser cette vue. Lorsque vous reculez du côté passager, vous avez une vue beaucoup plus limitée de ce qu’il se passe derrière vous.<br><br><font face=/font/big_bold.font>Regardez du côté passager.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "C’est pourquoi il est généralement déconseillé de reculer du côté du passager, car la visibilité est alors très réduite. Heureusement, sept caméras extérieures sont également à votre disposition.<br><br>La touche @@imv_nrm_camcycle@@ permet de passer à la caméra suivante dans la séquence. Après avoir parcouru les sept caméras, vous reviendrez au début du cycle.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_camcycle@@ pour passer à la caméra suivante.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "La caméra extérieure offre la meilleure perspective sur ce qu’il se passe autour du camion.<br><br><font face=/font/big_bold.font>Regardez autour du camion.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>En appuyant à nouveau sur @@imv_nrm_camcycle@@, vous pouvez passer à la caméra suivante.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "La vue du dessus offre une excellente vue d’ensemble de la situation autour du camion, ce qui simplifie considérablement le stationnement et la conduite dans les espaces restreints.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_camcycle@@ pour passer à la caméra suivante.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "La vue du toit offre une vue claire de la route loin devant le camion, sans trop d’obstruction.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_camcycle@@ pour passer à la dernière caméra que nous allons étudier pour le moment.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "La vue arrière est un raccourci de la vue que vous avez obtenue précédemment en tournant la caméra intérieure. Comme nous l’avons vu, elle est utile pour reculer ou se garer.<br><br>En jeu, il y a d’autres caméras que vous pouvez essayer en appuyant plusieurs fois sur @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_cam1@@ pour revenir à l’intérieur.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Pour une expérience authentique de l’académie de conduite, nous vous recommandons de rester sur la vue \"Caméra intérieure\" pendant que vous suivez chacun des scénarios.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_activate@@ pour confirmer et terminer le scénario.</font>@@aca_goal_tip@@ Vous pouvez utiliser la fonction @@o_im_cam_zoom@@ pour mieux voir ce qui vous entoure. Elle est particulièrement utile lorsque vous regardez dans les rétroviseurs. Consultez l’écran des options - \"@@options_bindings_screen@@\" - pour voir et/ou modifier les combinaisons de touches correspondantes."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Premiers tours de roue"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Dans ce scénario, nous allons apprendre à préparer le camion pour la conduite, puis à le conduire en marche avant pour la première fois."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Mettre le contact"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Démarrer le moteur"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Contrôler l’environnement"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Actionner le frein de service"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Engager une vitesse"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Relâcher le frein de stationnement"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Avancer"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "S’arrêter"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Serrer le frein de stationnement"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Passer au point mort"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Arrêter le moteur"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Pour vos premiers tours de roue, nous n’utiliserons que le tracteur.<br>Un camion est appelé tracteur lorsque sa carrosserie n’inclut qu’une cabine : il dépend alors d’une remorque pour transporter des marchandises et des matériaux."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Les tracteurs sont courants parce qu’ils permettent une plus grande polyvalence : ils peuvent déposer une remorque vide et en prendre une chargée sans avoir à attendre, ou passer à un autre type de remorque."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Pour votre première conduite, votre tâche consistera à avancer et à vous arrêter après la ligne en pointillés.<br>Démarrez le moteur, suivez les instructions pour que le camion soit prêt à partir. Une fois la procédure terminée, conduisez tout droit."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Dépassez la ligne en pointillés, arrêtez-vous, coupez le moteur et sécurisez le camion."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Pour la prochaine étape de votre formation, vous déplacerez le camion pour la première fois.<br><br>Bien sûr, si le moteur ne tourne pas, cela ne fonctionnera pas, il faut donc d’abord mettre le contact.<br><br><font face=/font/big_bold.font>Appuyez sur $input engineelect$ pour mettre le contact.</font>@@aca_goal_tip@@ Dans le mode Carrière, le moteur démarre automatiquement par défaut en même temps que le contact. Dans le mode Carrière, vous pouvez modifier ce comportement dans l’onglet « Jouabilité » dans l’écran des options - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Le contact active l’électronique du camion. Vous avez peut-être remarqué que les voyants d’avertissement clignotent sur le tableau de bord. C’est tout à fait normal. S’ils restent allumés une fois le moteur démarré, c’est probablement parce que le camion a un problème. L’exception est le témoin du frein de stationnement, qui s’éteint lorsque l’on desserre les freins de stationnement.<br><br>Heureusement, ce camion est en bon état et nous pouvons continuer.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_engine@@ pour démarrer le moteur.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Maintenant que le moteur est en marche, il est essentiel de vérifier les alentours avant de commencer à vous déplacer.<br><br><font face=/font/big_bold.font>Regardez autour du camion et dans les rétroviseurs latéraux du côté conducteur et du côté passager pour vous assurer que la zone entourant le camion est dégagée.</font>@@aca_goal_tip@@ Vous devez vous trouver à l’intérieur du véhicule."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Cela peut paraître évident, mais il faut savoir s’arrêter avant de commencer tout mouvement.<br><br><font face=/font/big_bold.font>Activez le frein de service avec $input backward$.</font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Ensuite, vous allons apprendre à changer de direction.<br><br>Avec une transmission automatique simplifiée, il n’est pas nécessaire de changer de vitesse, tout se fait automatiquement pour vous.<font face=/font/big_bold.font><br><br>Utilisez $input forward$ pour engager une vitesse de marche avant.</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Ensuite, nous allons apprendre à changer de direction.<br><br>La transmission automatique réaliste vous permet de passer de la marche avant à la marche arrière, en passant par le point mort, comme dans les vraies transmissions automatiques.<br><br><font face=/font/big_bold.font>Utilisez @@imv_nrm_gearup@@ pour engager une vitesse de marche avant.</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Ensuite, nous allons apprendre à changer de direction.<br><br>La transmission séquentielle permet des changements de vitesse par paliers, tout comme les vraies transmissions séquentielles.<br><br>De la même manière que vous engagez une vitesse avant, vous devez passer à des vitesses supérieures lorsque vous accélérez.<br><br><font face=/font/big_bold.font>Utilisez @@imv_nrm_gearup@@ pour engager la première vitesse.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Ensuite, nous allons apprendre à changer de direction.<br><br>Grâce au levier de vitesse et à l’embrayage, vous éprouverez la même sensation de changement de vitesse qu’avec une vraie boîte de vitesses manuelle.<br><br>Appuyez à fond sur la pédale d’embrayage et sur la pédale de frein. <font face=/font/big_bold.font>Utilisez le levier de vitesse pour engager la première vitesse. <color value=@@clr_txt@@>Maintenez l’embrayage et le frein de service complètement enfoncés.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Pour commencer à avancer, vous devez commencer par relâcher le frein de stationnement.<br><br><font face=/font/big_bold.font>Utilisez @@imv_nrm_parkingbrake@@ pour relâcher le frein de stationnement.</font> @@aca_goal_tip@@ Dans le mode Carrière, le frein de stationnement est initialement désactivé. Vous pouvez modifier ce comportement dans l’onglet « Jouabilité » dans l’écran des options - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Le camion est maintenant prêt à avancer. Commencez à vous déplacer et franchissez la ligne en pointillés.<br><br><font face=/font/big_bold.font>Initiez le mouvement avec l’accélérateur : $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Le camion est maintenant prêt à avancer. Commencez à vous déplacer et franchissez la ligne en pointillés.<br><br><font face=/font/big_bold.font>Initiez le mouvement avec l’accélérateur : $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Le camion est maintenant prêt à avancer. Commencez à vous déplacer et franchissez la ligne en pointillés.<br><br><font face=/font/big_bold.font>Initiez le mouvement avec l’accélérateur : $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Le camion est maintenant prêt à avancer. Commencez à vous déplacer et franchissez la ligne en pointillés.<br><br><font face=/font/big_bold.font>Relâchez la pédale de frein, relâchez progressivement l’embrayage pour l’engager tout en utilisant simultanément l’accélérateur pour maintenir le régime à un niveau élevé afin d’éviter que le camion ne cale. Une fois l’embrayage complètement relâché, vous pouvez accélérer et changer de vitesse si nécessaire.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Utilisez le frein de service pour vous arrêter.<br><br><font face=/font/big_bold.font>Utilisez $input backward$ pour arrêter le camion.</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Utilisez le frein de service pour vous arrêter.<br><br><font face=/font/big_bold.font>Utilisez $input backward$ pour arrêter le camion.</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Utilisez le frein de service pour vous arrêter.<br><br><font face=/font/big_bold.font>Utilisez $input backward$ pour arrêter le camion.</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Lorsqu’il est temps de s’arrêter, appuyez à fond sur la pédale d’embrayage <font face=/font/big_bold.font>et arrêtez le camion en utilisant le frein de service.<color value=@@clr_txt@@> Passez au point mort à l’aide du levier de vitesse, puis relâchez l’embrayage.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Maintenant, sécurisez le camion. Le frein de stationnement empêche le camion de se déplacer involontairement une fois que vous l’avez garé.<br><br><font face=/font/big_bold.font>Utilisez @@imv_nrm_parkingbrake@@ pour enclencher le frein de stationnement.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Avec une transmission automatique simplifiée, il n’est pas nécessaire de changer de vitesse, tout se fait automatiquement pour vous.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_activate@@ pour confirmer.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Passez au point mort en appuyant sur @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Passez au point mort en appuyant sur @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Mettez le levier de vitesse au point mort, puis relâchez l’embrayage.</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Vous savez désormais comment mettre le camion en mouvement et comment l’arrêter en toute sécurité.<br><br><font face=/font/big_bold.font>Appuyez sur $input engineelect$ pour arrêter le moteur.</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Reculer"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Dans ce scénario, nous allons essayer de reculer pour la première fois. Nous verrons également comment utiliser les rétroviseurs pour regarder derrière vous, à quoi il faut faire attention et comment se préparer à une marche arrière."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Démarrer le moteur"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Contrôler le rétroviseur côté passager"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Contrôler le rétroviseur côté conducteur"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Engager une vitesse"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Relâcher le frein de stationnement"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Passer au point mort"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Arrêter le moteur"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Pour ce trajet, nous allons effectuer une marche arrière en ligne droite. Vous devrez reculer au-delà de la ligne en pointillés et vous y arrêter."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Lors d’une marche arrière avec un camion, il est essentiel de regarder constamment autour de soi, de contrôler tous les rétroviseurs et de s’assurer que l’espace autour et derrière soi est dégagé."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Démarrez le moteur, passez la marche arrière et commencez à vous déplacer."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Reculez au-delà de la ligne en pointillés, arrêtez-vous, coupez le moteur et sécurisez le camion."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Préparez le camion pour la conduite comme vous l’avez appris dans le scénario précédent.<br><br><font face=/font/big_bold.font>Lorsque vous êtes prêt(e), démarrez le moteur.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Contrôlez les rétroviseurs pour vous assurer que la zone autour de vous est dégagée. Si leur position ne vous convient pas, vous pouvez les ajuster dans « @@adjust_link_t@@ ».<br><br><font face=/font/big_bold.font>Regardez dans le rétroviseur côté passager.</font>@@aca_goal_tip@@ Vous devez vous trouvez à l’intérieur du véhicule."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Vous allez franchir la ligne en pointillés. La voie est maintenant libre, mais en conduite normale, il est essentiel de surveiller constamment votre environnement en regardant autour de vous et en utilisant les rétroviseurs.<br><br><font face=/font/big_bold.font>Contrôlez le rétroviseur côté conducteur.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Utilisez $input backward$ pour passer la marche arrière.</font>@@aca_goal_tip@@ En marche arrière, le bip de recul se déclenche automatiquement sur la plupart des camions. Vous pouvez le désactiver dans l’écran « Options » - « Audio » - @@sound_of_reverse@@"

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Appuyez sur @@imv_nrm_geardown@@ pour passer la marche arrière.</font>@@aca_goal_tip@@ En marche arrière, le bip de recul se déclenche automatiquement sur la plupart des camions. Vous pouvez le désactiver dans l’écran « Options » - « Audio » - @@sound_of_reverse@@"

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Appuyez sur @@imv_nrm_geardown@@ pour passer la marche arrière.</font>@@aca_goal_tip@@ En marche arrière, le bip de recul se déclenche automatiquement sur la plupart des camions. Vous pouvez le désactiver dans l’écran « Options » - « Audio » - @@sound_of_reverse@@"

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Appuyez à fond sur la pédale d'embrayage et mettez le levier de vitesse sur la position marche arrière.</font>@@aca_goal_tip@@ En marche arrière, le bip de recul se déclenche automatiquement sur la plupart des camions. Vous pouvez le désactiver dans l’écran « Options » - « Audio » - @@sound_of_reverse@@"

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "La marche arrière est maintenant engagée.<br><br><font face=/font/big_bold.font>Relâchez le frein de stationnement en utilisant @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Commencez à vous déplacer avec $input backward$.<br><br><font face=/font/big_bold.font>Reculez au-delà de la ligne en pointillés.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Commencez à vous déplacer avec l’accélérateur : $input forward$.<br><br><font face=/font/big_bold.font>Reculez au-delà de la ligne en pointillés.</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Commencez à vous déplacer avec l’accélérateur : $input forward$.<br><br><font face=/font/big_bold.font>Reculez au-delà de la ligne en pointillés.</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Relâchez la pédale d’embrayage lentement, tout en maintenant le régime du moteur avec l’accélérateur.<br><br><font face=/font/big_bold.font>Reculez au-delà de la ligne en pointillés.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Arrêtez le camion en utilisant votre frein de service : $input forward$</font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Arrêtez le camion en utilisant votre frein de service : $input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Arrêtez le camion en utilisant votre frein de service : $input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Appuyez complètement sur la pédale d’embrayage et arrêtez le camion en utilisant le frein de service.</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Actionnez le frein de stationnement en utilisant @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Avec une transmission automatique simplifiée, il n’est pas nécessaire de changer de vitesse, car tout se fait automatiquement pour vous, contrairement à la réalité.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_activate@@ pour confirmer.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Passez au point mort en appuyant sur @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Les camions modernes passent automatiquement au point mort lorsque le frein de stationnement est serré. Toutefois, il est bon de toujours le faire soi-même. Dans les scénarios suivants, cette étape n’est pas nécessaire."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Passez au point mort en appuyant sur @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Les camions modernes passent automatiquement au point mort lorsque le frein de stationnement est serré. Toutefois, il est bon de toujours le faire soi-même. Dans les scénarios suivants, cette étape n’est pas nécessaire."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Mettez le levier de vitesse au point mort, puis relâchez l’embrayage.</font>@@aca_goal_tip@@ Les camions modernes passent automatiquement au point mort lorsque le frein de stationnement est serré. Toutefois, il est bon de toujours le faire soi-même. Dans les scénarios suivants, cette étape n’est pas nécessaire."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "N’oubliez pas de rester à l’affût de votre environnement lorsque vous reculez, en particulier dans les zones très fréquentées où il y a beaucoup de circulation.<br><br><font face=/font/big_bold.font>Arrêtez le moteur en appuyant sur $input engineelect$.</font>"
#@}

