#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Dans ce scénario, nous allons effectuer une manœuvre en marche arrière pour nous garer à côté d’un trottoir."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Reculez vers le bord du trottoir.<br>Vous devez avoir pleine conscience de votre environnement lorsque vous reculez, utilisez donc les rétroviseurs."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Au fur et à mesure que vous vous rapprochez, vous pouvez commencer à aligner le camion sur la place de stationnement. Surveillez les deux côtés du camion lorsque vous reculez."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Arrêtez-vous sur la place de stationnement et sécurisez le camion."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "La place de stationnement se trouve derrière vous, côté passager. Utilisez les rétroviseurs pour vous diriger vers la place.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "N’oubliez pas d’utiliser les rétroviseurs pour vérifier votre environnement avant de déplacer le camion.<br><br><font face=/font/big_bold.font>Commencez à reculer vers le bord du trottoir.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continuez à surveiller votre environnement pendant que vous reculez pour vous garer.<br><br><font face=/font/big_bold.font>Arrêtez-vous à l’endroit indiqué.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Cours de formation avancée"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Le dernier scénario de ce chapitre est une conduite sur un parcours de formation avancée. Nous allons mettre à l’épreuve les compétences que vous avez acquises avec un tracteur !"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_check1"
