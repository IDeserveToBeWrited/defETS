#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "S’arrêter à proximité d’un obstacle"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Dans ce scénario, nous parlerons de l’antéviseur, de son emplacement et de la manière de l’utiliser efficacement pour s’arrêter à proximité d’un obstacle."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Contrôler l’antéviseur"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Comprendre son rôle"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "S’arrêter à proximité de l’obstacle"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Les camions ont un large angle mort dans la zone située devant le tracteur. Il est facile de perdre de vue un piéton ou même une voiture dans cette zone, c’est pourquoi les camions sont équipés d’un antéviseur visible à travers le pare-brise."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "L’antéviseur est conçu pour permettre au conducteur de voir cet angle mort.<br>Il s’agit d’un outil essentiel pour éviter les collisions avec des obstacles lors de manœuvres dans des espaces restreints."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Commencez à conduire, dirigez-vous vers la barrière qui vous fait face, puis ralentissez à l’approche de celle-ci.<br>Gardez un œil dans l’antéviseur."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Arrêtez-vous entre la ligne et l’obstacle."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Dans ce scénario, nous allons apprendre à utiliser l’antéviseur illustré dans le schéma.<br><br><font face=/font/big_bold.font>Regardez à travers la partie supérieure du pare-brise pour le voir.</font>@@aca_goal_tip@@ Vous devez vous trouver à l’intérieur du véhicule."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "L’antéviseur vous permet de voir dans l’angle mort à l’avant du camion. Il peut vous aider à maintenir la sécurité et la précision dans votre conduite.<br><br>Si ce réglage ne vous convient pas, ouvrez « '@@adjust_link_t@@ » (accessible via le menu pause) pour l’ajuster à votre convenance.<br><br><font face=/font/big_bold.font>Appuyez sur @@imv_nrm_activate@@ pour continuer.</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Juste devant le camion se trouve un emplacement délimité. Vous remarquerez qu’il y a un obstacle de l’autre côté de la place. Lorsque vous vous en approchez, roulez très lentement et vérifiez la distance qui vous sépare de l’obstacle dans l’antéviseur.<br><br><font face=/font/big_bold.font>Préparez-vous à prendre le départ.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Le camion n’est toujours pas prêt à partir, peut-être avez-vous oublié quelque chose ?<br><br>Le moteur est-il en marche ? Avez-vous desserré le frein de stationnement ?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Conduisez vers la place de stationnement.</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Arrêtez l’avant du camion entre l’obstacle et le marquage routier.</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
