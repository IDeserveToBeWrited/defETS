#+ Viewpoint descriptions for Tourist Jobs photo album
#@{
	
	key[]: "at_cut_grossglockner_desc"
	val[]: "Grossglockner, đỉnh núi cao nhất nước Áo với độ cao 3.798 mét, sừng sững vươn cao giữa dãy Alps. Nơi đây nổi tiếng với cung đường High Alpine Road dài 48 km gồm 36 khúc cua tay áo, cùng với Pasterze – dòng sông băng dài nhất tại Áo và khu vực dãy Alps phía Đông.<br><br>Đôi khi, cát từ sa mạc Sahara bị gió thổi bay hàng ngàn km về phía bắc đã khiến lớp tuyết trên cung đường núi này chuyển sang màu vàng rực hoặc màu cam."

	key[]: "at_cut_schonbrunn_desc"
	val[]: "Cung điện Schönbrunn, từng là nơi ở mùa hè của hoàng tộc Habsburg, là Di sản Thế giới được UNESCO công nhận và là một trong những quần thể kiến trúc Baroque tuyệt vời nhất châu Âu.<br><br>Vườn thú tại đây, được thành lập vào năm 1752, là vườn thú lâu đời nhất thế giới vẫn còn hoạt động liên tục cho đến ngày nay."

	key[]: "at_cut_worthersee_desc"
	val[]: "Hồ Wörthersee là một viên ngọc màu ngọc lam được hình thành từ kỷ băng hà cuối cùng, nổi tiếng với làn nước trong trẻo, giàu khoáng chất.<br><br>Theo truyền thuyết, cả một thị trấn cùng ngôi nhà thờ tại đó đã chìm xuống đáy hồ; người dân địa phương vẫn kể rằng họ thỉnh thoảng còn nghe thấy tiếng chuông nhà thờ vang lên dưới mặt nước."

	key[]: "de_cut_ettal_desc"
	val[]: "Tu viện Ettal là một tu viện dòng Biển Đức nằm trên dãy Alps thuộc vùng Bavaria, được Hoàng đế Ludwig IV xứ Bavaria thành lập vào năm 1330.<br><br>Theo truyền thuyết, con ngựa của Hoàng đế Ludwig đã quỳ xuống ba lần tại chính địa điểm này; ông coi đó là một điềm báo và quyết định xây dựng tu viện tại đây."

	key[]: "de_cut_stuttgart_city_desc"
	val[]: "Nhà hát Staatstheater tại Stuttgart, do kiến trúc sư Max Littmann thiết kế, được khánh thành vào năm 1912 với vai trò là nhà hát hoàng gia của Vương quốc Württemberg.<br><br>Stuttgart nằm trên một trong những mỏ nước khoáng lớn thứ hai châu Âu; một số nguồn nước tại đây có chứa ga tự nhiên đến mức khi tắm, người ta có cảm giác như đang ngâm mình trong rượu sâm panh."

	key[]: "de_cut_nurnberg_city_desc"
	val[]: "Nuremberg từng là một trong những thành phố quan trọng nhất của Đế quốc La Mã Thần thánh và đến nay vẫn nổi tiếng với hệ thống công sự thời trung cổ quy mô đáng kinh ngạc.<br><br>Vào năm 1561, những cư dân Nuremberg khiếp đảm đã chứng kiến một \"trận chiến trên không\" diễn ra vào lúc bình minh, với sự xuất hiện của vô số vật thể phát sáng hình cầu và hình chữ thập. Sự kiện này đã được ghi lại trong một bức tranh khắc gỗ, hiện được xem là một trong những trường hợp nhìn thấy vật thể bay không xác định (UFO) sớm nhất trong lịch sử."

	key[]: "de_cut_frankfurt_city_desc"
	val[]: "Khu tài chính Bankenviertel tại Frankfurt, được mệnh danh là \"Mainhattan\", là nơi đặt trụ sở của nhiều ngân hàng quan trọng.<br><br>Frankfurt cũng là nơi tổ chức một trong những hội chợ thương mại lâu đời nhất thế giới, có lịch sử từ thế kỷ 12. Ngày nay, vào mỗi mùa thu, thành phố này còn là nơi diễn ra hội chợ sách lớn nhất thế giới."

	key[]: "de_cut_rostock_desc"
	val[]: "Quảng trường Neuer Markt ở Rostock, nơi được bao quanh bởi các tòa nhà thương nhân có mái đầu hồi theo phong cách Gothic gạch, đã là khu chợ trung tâm của thành phố từ thế kỷ 13.<br><br>Rostock là nơi tọa lạc của trường đại học lâu đời nhất bên bờ biển Baltic, được thành lập vào năm 1419, cách đây hơn 600 năm."

	key[]: "de_cut_duisburg_desc"
	val[]: "Tòa thị chính (Rathaus) của Duisburg, được hoàn thành vào năm 1902 theo phong cách mô phỏng thời Phục hưng sớm, tọa lạc trên nền đất từng là vị trí của một cung điện hoàng gia thời trung cổ.<br><br>Duisburg nằm tại nơi hợp lưu của hai con sông Rhine và Ruhr, nhờ đó cảng nội địa của thành phố này trở thành cảng sông lớn nhất thế giới."

	key[]: "de_cut_kassel_desc"
	val[]: "Những ghi chép lịch sử đầu tiên về Kassel có từ năm 913, mô tả một địa điểm được kiên cố hóa nằm cạnh một cây cầu bắc qua sông.<br><br>Bản thân cái tên này còn cổ xưa hơn nhiều, bắt nguồn từ tên gọi của bộ tộc người German có tên là Chatti."

	key[]: "de_cut_berlin_desc"
	val[]: "Cột Chiến thắng tại Berlin, hoàn thành vào năm 1873, là công trình kỷ niệm các thắng lợi quân sự của Phổ trong thế kỷ XIX và tọa lạc trong công viên Tiergarten.<br><br>Vào giai đoạn 1938–1939, cột này đã được di dời 1,5 km đến vị trí hiện tại như một phần trong kế hoạch tái thiết quy mô lớn của thành phố; đồng thời, một tầng thứ tư cũng được bổ sung, khiến công trình trở nên cao hơn nữa."

	key[]: "de_cut_dresden_desc"
	val[]: "Nhà thờ Frauenkirche theo phong cách Baroque ở Dresden, hoàn thành vào năm 1743 tại quảng trường Neumarkt gần sông Elbe, là một trong những công trình kiến trúc mang tính biểu tượng của thành phố vốn được mệnh danh là \"Florence bên sông Elbe\" hay \"Florence của nước Đức\".<br><br>Năm 2009, Dresden trở thành địa điểm đầu tiên tại châu Âu bị tước danh hiệu Di sản Thế giới của UNESCO, sau khi thành phố này cho xây dựng một cây cầu."

	key[]: "ch_cut_geneve_desc"
	val[]: "Đài phun nước Jet d'Eau ở Geneva phun nước từ hồ lên độ cao tới 140 mét, tại vị trí gần nơi sông Rhône chảy ra khỏi hồ Geneva.<br><br>Từ năm 1818, Geneva đã đánh dấu thời điểm mùa xuân về bằng cách quan sát một cây dẻ ngựa chính thức. Một quan chức chính phủ sẽ công bố mùa xuân bắt đầu khi chiếc lá đầu tiên của cây này bung nở – một truyền thống vẫn còn được duy trì cho đến ngày nay."

	key[]: "ch_cut_zurichw_desc"
	val[]: "Zurich West từng là một khu công nghiệp, từ thập niên 1990 đã được chuyển đổi thành một quận thời thượng, với điểm nhấn là tòa tháp kính Prime Tower.<br><br>Cửa hiệu độc đáo nhất tại Zurich West được xây dựng từ 19 thùng container vận chuyển hoen gỉ, xếp chồng lên nhau cao chín tầng trên nền đất vốn là một khu công nghiệp bị bỏ hoang."

	key[]: "ch_cut_furka_desc"
	val[]: "Đèo Furka là một con đèo trên núi cao, nằm ở độ cao 2.429 mét, nối liền hai bang Uri và Valais tại miền trung Thụy Sĩ.<br><br>Những khúc cua tay áo tại đây từng xuất hiện trong phân cảnh rượt đuổi bằng ô tô của bộ phim \"Goldfinger\" (1964), và một trong số các khúc cua đó còn được đặt biệt danh là \"James Bond Strasse\" (Đường James Bond)."

	key[]: "nl_cut_devlieter_desc"
	val[]: "De Vlieter là một đoạn thuộc Afsluitdijk – con đê dài 32 km từng ngăn cách vịnh Zuiderzee để tạo thành hồ IJsselmeer.<br><br>Kênh thủy triều cùng các vùng nước thuộc biển Wadden bao quanh khu vực De Vlieter đã nhấn chìm khoảng 500 đến 1.000 con tàu trong suốt chiều dài lịch sử."

	key[]: "nl_cut_eindhoven_desc"
	val[]: "Eindhoven là một thành phố của Hà Lan nằm tại tỉnh Bắc Brabant, được biết đến là nơi khởi nguồn và là trụ sở lâu năm của tập đoàn điện tử khổng lồ Philips.<br><br>Philips bắt đầu hoạt động tại đây vào năm 1891 với việc sản xuất bóng đèn, nhờ đó Eindhoven có biệt danh là \"Thành phố Ánh sáng\"."

	key[]: "nl_cut_groningen_desc"
	val[]: "Groningen là một thành phố đại học sôi động ở miền bắc Hà Lan, nổi bật với ngọn tháp nhà thờ Martinitoren cao vút.<br><br>Người dân địa phương trìu mến gọi Martinitoren là \"d’Olle Grieze\" – nghĩa là \"Lão Xám\"; đây là tòa tháp thứ ba được xây dựng tại vị trí này, sau khi hai tòa tháp trước đó đã bị phá hủy do sét đánh."

	key[]: "be_cut_ardennes_desc"
	val[]: "La Roche-en-Ardenne là một thị trấn nhỏ của Bỉ, nổi bật với tàn tích của một lâu đài thời trung cổ nằm phía trên khúc quanh của dòng sông Ourthe."

	key[]: "be_cut_antwerp_desc"
	val[]: "Antwerp là thành phố lớn thứ hai của Bỉ và là một cảng biển lịch sử, nổi tiếng là thủ phủ giao dịch kim cương của thế giới từ năm 1447.<br><br>Khoảng 80 đến 90 phần trăm lượng kim cương thô trên toàn thế giới đều đi qua Khu Kim cương (Diamond Quarter) tại Antwerp mỗi năm."

	key[]: "fr_cut_brest_desc"
	val[]: "Bến du thuyền tại Brest nằm trong khu vực cảng lịch sử – nơi từng được Hồng y Richelieu chuyển đổi thành căn cứ hải quân Pháp vào năm 1631.<br><br>Các bến du thuyền ở Brest là trung tâm quan trọng cho các cuộc đua thuyền trên đại dương; đây là nơi các tay đua thuyền cừ khôi tụ hội trước khi bắt đầu hành trình vượt Đại Tây Dương hoặc chinh phục những kỷ lục thế giới khó khăn nhất trong môn đua thuyền buồm."

	key[]: "fr_cut_marseille_desc"
	val[]: "Cảng Cũ Marseille đã đóng vai trò là bến cảng tự nhiên của thành phố kể từ khi những người định cư Hy Lạp thành lập nên Massalia vào khoảng năm 600 trước Công nguyên.<br><br>Đây là một trong những cảng biển lâu đời nhất vẫn còn hoạt động liên tục tại châu Âu."

	key[]: "fr_cut_peyrat_desc"
	val[]: "Peyrat-le-Château là một ngôi làng nhỏ thuộc tỉnh Haute-Vienne, nằm bên cạnh một hồ nước trên cao nguyên Millevaches ở vùng Limousin.<br><br>Cái tên độc đáo \"Millevaches\" của cao nguyên này có thể bắt nguồn từ cụm từ \"một nghìn con bò\" (từng được chăn thả tại đây), hoặc từ một từ cổ dùng để chỉ vô số con suối tự nhiên rải rác trên cao nguyên; hiện vẫn chưa ai khẳng định chắc chắn cách giải thích nào mới là chính xác!"

	key[]: "fr_cut_rousse_desc"
	val[]: "L'Île-Rousse là một thị trấn ven biển thuộc vùng Balagne ở phía tây bắc đảo Corsica, được Pasquale Paoli thành lập vào năm 1758.<br><br>Paoli đã xây dựng cảng này để người dân Corsica có thể giao thương mà không cần phụ thuộc vào cảng Calvi – nơi vốn nằm dưới sự kiểm soát của đối thủ là người Genoa."

	key[]: "fr_cut_serre_desc"
	val[]: "Hồ Serre-Ponçon là một hồ chứa nước rộng lớn nằm tại vùng Hautes-Alpes, được hình thành trong khoảng thời gian từ năm 1955 đến 1960 thông qua việc xây dựng đập ngăn sông Durance.<br><br>Với diện tích lên tới gần 3.000 héc-ta, hồ Serre-Ponçon rộng lớn đến mức được mệnh danh là \"biển giữa lòng núi\", nơi có một nhà nguyện đơn độc nằm trên một hòn đảo nhỏ, với phần đỉnh vẫn nhô lên trên mặt nước hồ."

	key[]: "fr_cut_usse_desc"
	val[]: "Château d'Ussé là một lâu đài mang phong cách cổ tích nằm tại thung lũng Loire, được xây dựng từ thế kỷ 15 đến thế kỷ 17 trên nền một pháo đài của người Viking trước đây.<br><br>Tương truyền, nhà văn Charles Perrault đã lấy cảm hứng từ những tòa tháp màu trắng của lâu đài này khi viết tác phẩm \"Người đẹp ngủ trong rừng\" vào thế kỷ 17."

	key[]: "it_cut_bari_desc"
	val[]: "Cảng Bari nằm trên bờ biển Adriatic của Ý và từ lâu đã đóng vai trò là cửa ngõ kết nối châu Âu với vùng Balkan.<br><br>Trong khoảng thời gian từ năm 847 đến năm 871 sau Công nguyên, Bari từng là thủ đô của một tiểu quốc Hồi giáo tồn tại trong thời gian ngắn – đây cũng là tiểu quốc Hồi giáo duy nhất từng được thành lập trên đất liền nước Ý."

	key[]: "it_cut_etna_desc"
	val[]: "Núi Etna, nằm trên bờ biển phía đông của đảo Sicily, là ngọn núi lửa đang hoạt động cao nhất châu Âu và là một trong những núi lửa hoạt động mạnh nhất trên Trái Đất.<br><br>Tên gọi của nó thường được cho là bắt nguồn từ từ \"Aitnē\" trong tiếng Hy Lạp, vốn xuất phát từ từ \"aithō\" với nghĩa là \"tôi đốt cháy\"."

	key[]: "it_cut_neapol_desc"
	val[]: "Cảng Naples, được hình thành từ khu định cư Hy Lạp cổ đại Neapolis, là một trong những bến cảng lâu đời và nhộn nhịp nhất tại Ý.<br><br>Trong quá trình đào xây một nhà ga tàu điện ngầm bên cạnh cảng Naples ngày nay, các nhà khảo cổ đã phát hiện ra bến cảng cổ cùng bảy xác tàu đắm có niên đại từ thời kỳ Hy Lạp hóa và thời kỳ La Mã."

	key[]: "it_cut_sassari_desc"
	val[]: "Nhà thờ Santa Maria di Betlem ở Sassari, Sardinia, là một quần thể kiến trúc dòng Phanxicô có lịch sử từ thế kỷ 12.<br><br>Vào tháng 8 hằng năm, các phường hội tại Sassari lại cùng nhau khiêng những \"cây nến\" bằng gỗ cao vút, nặng hàng trăm kilôgam, tiến về nhà thờ này trong khuôn khổ lễ hội Candelieri – một nghi thức nhằm tái khẳng định lời thề xưa cũ gắn liền với đại dịch năm nào."

	key[]: "it_cut_taranto_desc"
	val[]: "Taranto là một thành phố ở miền nam nước Ý, nằm bên bờ biển Ionian; thành phố này được những người định cư từ Sparta thành lập vào khoảng năm 706 trước Công nguyên với tên gọi Taras – một thành phố của người Hy Lạp.<br><br>Vùng vịnh công nghiệp của Taranto là nơi sinh sống của một quần thể cá heo phát triển mạnh, trong đó có loài cá heo sọc sở hữu những đặc điểm di truyền không tìm thấy ở bất kỳ nơi nào khác tại Địa Trung Hải."

	key[]: "it_cut_villa_san_giovanni_desc"
	val[]: "Villa San Giovanni là một thị trấn thuộc vùng Calabria trên đất liền nước Ý, đồng thời là bến phà chính kết nối qua eo biển Messina để đến đảo Sicily.<br><br>Villa San Giovanni được thành lập bởi Rocco Antonio Caracciolo, một doanh nhân kinh doanh tơ lụa; ông đã hợp nhất năm ngôi làng vốn là đối thủ của nhau. Năm 1791, Vua Ferdinand IV của Naples đã chính thức đặt tên cho thị trấn mới này."

	key[]: "balt_cut_castles_desc"
	val[]: "Lâu đài Hermann được người Đan Mạch xây dựng vào thế kỷ 13 và sau đó được Dòng tu Livonia xây dựng lại. Pháo đài Ivangorod được Ivan III thành lập vào năm 1492 nhằm bảo vệ biên giới phía tây của nước Nga (Muscovy)."

	key[]: "balt_cut_convent_desc"
	val[]: "Được Thánh Euphrosynus thành lập vào năm 1447 ở phía bắc Pskov, nơi đây đã phát triển thành một trung tâm giáo dục nổi tiếng."

	key[]: "balt_cut_daugavpils_desc"
	val[]: "Thành phố lớn thứ hai của Latvia khởi nguồn từ lâu đài Dinaburg, được Dòng tu Livonia xây dựng bên bờ sông Daugava vào năm 1275.<br><br>Thành phố này từng mang ít nhất bốn tên gọi khác nhau – bao gồm Dinaburg, Borisoglebsk và Dvinsk – trước khi chính thức có tên là Daugavpils vào năm 1920."

	key[]: "balt_cut_klaipeda_desc"
	val[]: "Klaipėda, cảng biển lớn duy nhất của Litva, được thành lập vào những năm 1250 bởi Dòng Livonia, một nhánh của các Hiệp sĩ Teuton.<br><br>Trong khoảng 500 năm, thành phố này chưa từng nằm dưới sự cai trị của một nhà nước Litva nào, và chỉ trở thành một phần của Litva sau cuộc nổi dậy năm 1923."

	key[]: "balt_cut_riga_power_plant_desc"
	val[]: "Được xây dựng trên sông Daugava trong khoảng thời gian từ năm 1966 đến năm 1975, con đập này đã tạo ra một hồ chứa nước bằng cách làm ngập một nửa hòn đảo Doles sala.<br><br>Phần đỉnh đập đồng thời đóng vai trò là một tuyến đường công cộng, trong khi tuyến đường sắt từng chạy qua đây vào thời kỳ xây dựng về sau đã bị dỡ bỏ."

	key[]: "balt_cut_valmiera_desc"
	val[]: "Trung tâm Olympic Vidzeme tại Valmiera là một nhà thi đấu đa năng với diện tích gần 2.900 mét vuông, được sử dụng cho các môn bóng rổ và bóng sàn (floorball).<br><br>Jānis Daliņš, một vận động viên đi bộ thể thao sinh ra tại Valmiera, đã giành huy chương Olympic Mùa hè đầu tiên cho đất nước Latvia độc lập – một huy chương bạc ở nội dung đi bộ 50 km tại Thế vận hội Los Angeles năm 1932. Hiện nay, sân vận động của thành phố này đã được đặt theo tên ông."

	key[]: "blke_cut_cerna_voda_desc"
	val[]: "Cầu Anghel Saligny tại Cernavodă, hoàn thành vào năm 1895, từng là cây cầu dài nhất châu Âu với chiều dài hơn bốn km.<br><br>Năm 1916, quân đội Romania trong quá trình rút lui đã gây hư hại cho cây cầu bắc qua sông Danube này, đồng thời phá hủy đoạn cầu Borcea. Cả hai phần đều được xây dựng lại, và đến năm 1987, một công trình vượt sông mới đã được xây dựng để thay thế."

	key[]: "blke_cut_edirne_desc"
	val[]: "Edirne từng là thủ đô của Đế quốc Ottoman trong gần một thế kỷ trước khi Constantinople bị chinh phục vào năm 1453.<br><br>Lễ hội đấu vật bôi dầu Kırkpınar tại Edirne, được tổ chức từ thế kỷ 14, sử dụng gần hai tấn dầu ô liu để thoa lên người các đô vật; sự kiện này hiện nắm giữ kỷ lục Guinness là cuộc thi đấu thể thao lâu đời nhất."

	key[]: "blke_cut_orsova_desc"
	val[]: "Orșova là một thị trấn nằm bên dòng sông Danube ở phía tây nam Romania, tọa lạc ngay phía trên hẻm núi Iron Gates (Cổng Sắt), gần nơi sông Cerna đổ vào sông Danube.<br><br>Việc xây dựng đập Iron Gates I đã làm mực nước sông Danube dâng cao khoảng 30 mét, nhấn chìm thị trấn Orșova cũ vào năm 1970. Cư dân tại đây đã được di dời đến một thị trấn hoàn toàn mới, được xây dựng trên vùng đất cao hơn trong khoảng thời gian từ năm 1966 đến năm 1971."

	key[]: "blke_cut_pernik_desc"
	val[]: "Pernik, một thành phố khai thác than gần Sofia, là nơi đặt một nhà máy thép lớn từ năm 1953.<br><br>Nhà máy này sản xuất phần lớn thép từ phế liệu tái chế, trở thành một trong những cơ sở tiêu biểu cho mô hình kinh tế tuần hoàn trong khu vực."

	key[]: "blke_cut_poiana_viaduct_desc"
	val[]: "Cầu cạn Poiana Teiului là cây cầu đường bộ dài 634 mét bắc qua đuôi Hồ Bicaz ở Hạt Neamț của Romania."

	key[]: "blke_cut_r73_desc"
	val[]: "Piatra Craiului là một dãy núi đá vôi dài 25 km thuộc dãy Carpath tại Romania, được bảo tồn dưới hình thức vườn quốc gia từ năm 1990.<br><br>Tên gọi này có nghĩa là \"Tảng đá của Nhà vua\", và vườn quốc gia này là nơi sinh sống của một số loài động vật không xương sống đặc hữu."

	key[]: "ibe_cut_barcelona_desc"
	val[]: "Barcelona khởi nguồn từ khu định cư Barcino của người La Mã; những tàn tích cổ xưa từ thời kỳ này hiện vẫn nằm bên dưới các đường phố của thành phố hiện đại.<br><br>Bảy trong số chín Di sản Thế giới được UNESCO công nhận tại Barcelona là các công trình riêng biệt do kiến trúc sư Antoni Gaudí thiết kế, bao gồm cả nhà thờ Sagrada Família vẫn còn dang dở."

	key[]: "ibe_cut_ejido_desc"
	val[]: "El Ejido, nằm tại khu vực Campo de Dalías thuộc tỉnh Almería, là nơi tập trung một trong những hệ thống nhà kính nông nghiệp lớn nhất thế giới.<br><br>Những nhà kính tại Almería – được ví như một \"biển nhựa\" – trải rộng trên diện tích 370 km vuông và phản chiếu lượng ánh sáng mặt trời lớn đến mức các phi hành gia có thể nhìn thấy chúng từ quỹ đạo."

	key[]: "ibe_cut_guadiana_desc"
	val[]: "Cầu quốc tế Guadiana là một cây cầu dây văng nối liền Ayamonte (Tây Ban Nha) và Castro Marim (Bồ Đào Nha), nằm tại điểm giao cắt cực nam của biên giới hai nước.<br><br>Khi đi qua cây cầu này, du khách cũng đồng thời băng qua ranh giới múi giờ; nhờ đó, những ai di chuyển từ Tây Ban Nha sang Bồ Đào Nha có thể trải nghiệm hai lần đếm ngược đón năm mới riêng biệt."

	key[]: "ibe_cut_lisboa_desc"
	val[]: "Cầu 25 tháng Tư bắc qua sông Tagus, nối liền Lisbon và Almada, là một trong những cây cầu treo dài nhất châu Âu."

	key[]: "ibe_cut_olhao_desc"
	val[]: "Olhão là một thị trấn chài với những ngôi nhà sơn trắng nằm trên bờ biển Algarve của Bồ Đào Nha, nhìn thẳng ra đầm phá Ria Formosa.<br><br>Truyền thuyết kể rằng vào năm 1808, mười bảy ngư dân Olhão đã chèo một chiếc thuyền hở đi suốt quãng đường đến tận Brazil, chỉ để báo cho vị vua Bồ Đào Nha đang lưu vong biết rằng đất nước của ngài đã được giải phóng."

	key[]: "ibe_cut_reservoir_desc"
	val[]: "Hồ chứa nước Barrios de Luna tại tỉnh León được hình thành vào năm 1956, khi một con đập chặn dòng sông Luna trong một hẻm núi hẹp.<br><br>Việc tích nước cho hồ chứa đã nhấn chìm mười sáu ngôi làng và khu định cư; ngày nay, lòng hồ trải dài khoảng 40 km dọc theo thung lũng này."

	key[]: "ibe_cut_santander_desc"
	val[]: "Cảng Santander nằm cách trung tâm thành phố một khoảng cách có thể đi bộ được.<br><br>Được người La Mã thành lập sau các cuộc chiến tranh Cantabria vào năm 19 trước Công nguyên, cảng biển kín gió của Santander khởi đầu là một trung tâm xuất khẩu khoáng sản, rồi dần phát triển song hành cùng chính thành phố mà nó góp phần hình thành nên."

	key[]: "ibe_cut_zaragoza_desc"
	val[]: "Một trong những tổ hợp mua sắm và giải trí lớn nhất châu Âu, với diện tích hơn 200.000 mét vuông.<br><br>Được xây dựng xung quanh một hồ nước nhân tạo, công trình này kết hợp trung tâm mua sắm với các nhà hàng, rạp chiếu phim, cơ sở thể thao và khu vui chơi giải trí."

	key[]: "sc_cut_mabodalen_desc"
	val[]: "Måbødalen là một thung lũng dốc đứng được hình thành bởi các dòng sông băng, nằm gần Eidfjord ở miền tây Na Uy; đây cũng là nơi tọa lạc của thác nước Vøringsfossen.<br><br>Với cú đổ mình tự do ngoạn mục từ độ cao 145 mét xuống lòng thung lũng Måbødalen, Vøringsfossen trở thành thác nước mang tính biểu tượng nhất tại Na Uy, thu hút du khách đến chiêm ngưỡng sức mạnh đầy uy lực của nó."

	key[]: "sc_cut_stockholm_desc"
	val[]: "Đường bờ biển của Stockholm mở ra một quần đảo gồm khoảng 30.000 hòn đảo, đảo nhỏ và các mỏm đá nhô lên khỏi mặt nước, trải dài ra tận biển Baltic.<br><br>Những toa tàu điện ngầm \"Silverpilen\" (Mũi tên Bạc) không sơn màu tại Stockholm, được đưa vào sử dụng từ năm 1965, đã khơi nguồn cho một truyền thuyết đô thị về một chuyến tàu ma xuất hiện vào lúc nửa đêm, khiến bất kỳ hành khách nào bước lên tàu đều biến mất."

	key[]: "sc_cut_kalmar_desc"
	val[]: "Kalmar là một thành phố cảng lâu đời ở đông nam Thụy Điển, được ghi chép lần đầu vào thế kỷ 11 và là nơi tọa lạc của một lâu đài thời Phục hưng.<br><br>Trong suốt chiều dài lịch sử, Lâu đài Kalmar đã trụ vững qua 22 cuộc bao vây mà chưa từng bị đánh chiếm."

	key[]: "sc_cut_copenhagen_desc"
	val[]: "Copenhagen là thủ đô của Đan Mạch, được xây dựng xung quanh một bến cảng lâu đời với các kênh đào, những tòa tháp nhọn và các con phố dành cho người đi bộ.<br><br>Vườn Tivoli tại Copenhagen là nơi có tàu lượn siêu tốc lâu đời nhất còn hoạt động ở châu Âu – Rutschebanen – vốn đã mang lại những trải nghiệm đầy phấn khích cho người chơi từ năm 1914."

	key[]: "blkw_cut_durdevica_desc"
	val[]: "Vườn quốc gia Durmitor tại Montenegro – Di sản Thế giới được UNESCO công nhận, nổi tiếng với những dãy núi hiểm trở, các hồ băng và hẻm núi sông Tara – là nơi tọa lạc của cây cầu bê tông năm nhịp này; công trình được hoàn thành vào năm 1940 và vươn cao hơn 150 mét so với mặt sông.<br><br>Ngày nay, đây là một trong những địa điểm trải nghiệm đu dây (zipline) phổ biến nhất tại khu vực Balkan."

	key[]: "blkw_cut_durres_desc"
	val[]: "Durrës, được thành lập với tên gọi Epidamnus – một thuộc địa của Hy Lạp – vào năm 627 TCN, là cảng biển lâu đời và nhộn nhịp nhất tại Albania.<br><br>Người La Mã đã chọn nơi đây làm điểm cuối phía tây của Via Egnatia, tuyến đường huyết mạch trải dài tận đến Thessaloniki."

	key[]: "blkw_cut_pristina_desc"
	val[]: "Pristina, thủ đô của Kosovo, nằm gần tàn tích của thành phố cổ Ulpiana và đã có người sinh sống từ thời kỳ đồ đá mới.<br><br>Đến thế kỷ 13, Pristina trở thành một trung tâm hoàng gia và thương mại quan trọng trong nhà nước Serbia thời trung cổ, trước khi sự cai trị của Đế quốc Ottoman dần dần thiết lập tại đây sau năm 1389."

	key[]: "blkw_cut_split_desc"
	val[]: "Khu vực ven biển tại Split nổi bật với Cung điện Diocletian và tháp chuông của Nhà thờ chính tòa Thánh Domnius. Toàn bộ khu phố cổ đã hình thành bên trong các bức tường của cung điện này.<br><br>Hoàng đế La Mã Diocletian đã chọn nghỉ hưu tại Split và chuyên tâm trồng bắp cải đến mức ông từ chối mọi lời khẩn cầu quay lại ngai vàng, với lý do rằng những luống rau của mình còn quan trọng hơn nhiều."

	key[]: "blkw_cut_bihac_desc"
	val[]: "Trung tâm lịch sử của Bihać bao gồm tháp chuông còn sót lại của nhà thờ Thánh Anthony, Tháp Thuyền trưởng (Captain’s Tower) và lăng mộ bằng đá Turbe. Tháp Thuyền trưởng về sau từng được sử dụng làm nhà tù dưới thời Áo-Hung. Nhà thờ này đã bị phá hủy phần lớn trong các đợt ném bom của phe Đồng minh vào năm 1944.<br><br>Cả ba công trình này nằm cách nhau chỉ vài mét, phản ánh di sản từ các thời kỳ Cơ đốc giáo, Ottoman và Áo-Hung tại Bihać."

	key[]: "blkw_cut_sarajevo_desc"
	val[]: "Đây là khu vực lâu đời nhất và có ý nghĩa lịch sử quan trọng nhất tại Sarajevo. Trung tâm của khu vực này là Baščaršija – khu chợ từ thời Ottoman, được thống đốc Isa-beg Isaković thành lập vào năm 1462.<br><br>Tòa thị chính Sarajevo, hay còn gọi là Vijećnica, là một công trình mang tính biểu tượng từ thời Áo-Hung, được thiết kế theo phong cách tân Moor bởi kiến trúc sư người Séc Karel Pařík."

	key[]: "blkw_cut_ljubljana_desc"
	val[]: "Ljubljana, thủ đô của Slovenia, hình thành dọc theo dòng sông Ljubljanica, ngay trên vị trí của khu định cư Emona từ thời La Mã.<br><br>Theo truyền thuyết, Jason cùng các thủy thủ tàu Argo đã tiêu diệt một con rồng ngay tại nơi mà ngày nay chính là thành phố Ljubljana; hình ảnh con quái vật này vẫn còn xuất hiện trên huy hiệu của thành phố."

	key[]: "blkw_cut_tirana_desc"
	val[]: "Tirana được thành lập vào năm 1614 bởi lãnh chúa Ottoman Sulejman Bargjini. Nơi đây trở thành thủ đô lâm thời của Albania vào năm 1920 và là thủ đô chính thức từ năm 1925.<br><br>Kthesa e Kamzës, một trong những cửa ngõ giao thông quan trọng ở phía tây Tirana, kết nối thủ đô với Kamëz cùng các tuyến đường dẫn về phía bắc và phía tây."

	key[]: "blkw_cut_prokuplje_desc"
	val[]: "Prokuplje, trung tâm của quận Toplica ở miền nam Serbia, có nguồn gốc từ khu định cư Hammeum thời La Mã.<br><br>Thị trấn này cũng là nguồn gốc tên gọi của Prokupac – một giống nho làm rượu vang đỏ đã được canh tác tại địa phương từ thời Trung cổ."

	key[]: "gr_cut_piraeus_desc"
	val[]: "Piraeus là cảng chính của Athens và là một trong những cảng hành khách lớn nhất tại khu vực Địa Trung Hải.<br><br>Tòa nhà Silo vốn được xây dựng để làm kho chứa ngũ cốc. Ngày nay, công trình này đang được chuyển đổi công năng thành Bảo tàng Cổ vật Dưới nước, nơi sẽ trưng bày các hiện vật khảo cổ được tìm thấy dưới vùng biển Hy Lạp."

	key[]: "gr_cut_kavala_desc"
	val[]: "Kavala là một thành phố cảng lịch sử ở miền bắc Hy Lạp, được thành lập vào cuối thế kỷ thứ 7 trước Công nguyên với tên gọi Neapolis.<br><br>Ngọn đồi tại đây đã được xây dựng công sự từ ít nhất là thế kỷ thứ 5 trước Công nguyên. Pháo đài Kavala hiện nay chủ yếu mang dấu ấn thời Ottoman, được xây dựng lại vào năm 1425 trên nền các công trình phòng thủ từ thời Byzantine trước đó."

	key[]: "gr_cut_kalabaka_desc"
	val[]: "Meteora là một quần thể tu viện được UNESCO công nhận là Di sản Thế giới, tọa lạc trên đỉnh các cột đá sa thạch gần Kalabaka.<br><br>Trong suốt nhiều thế kỷ, các nhà sư đã đưa khách tham quan lên những vách đá cao 400 mét bằng một tấm lưới dây đung đưa; họ còn nói đùa rằng tấm lưới này chỉ được thay mới khi nó bị đứt."

	key[]: "gr_cut_beach_desc"
	val[]: "Faliraki là một khu nghỉ dưỡng ven biển nằm trên bờ biển phía đông bắc của đảo Rhodes, cách thị trấn Rhodes khoảng 14 km về phía nam, nổi tiếng với bãi biển cát trải dài.<br><br>Faliraki là một trong những khu nghỉ dưỡng được ưa chuộng nhất trên đảo Rhodes dành cho các môn thể thao dưới nước, từ lái mô tô nước cho đến dù lượn trên cao phía trên vịnh."

	key[]: "gr_cut_lixouri_desc"
	val[]: "Lixouri là thị trấn lớn thứ hai trên đảo Kefalonia, nằm trên bán đảo Paliki, gần vị trí của thành phố cổ Pale."

	key[]: "gr_cut_corinth_desc"
	val[]: "Kênh đào Corinth cắt ngang eo đất Corinth, nối liền biển Aegean với vịnh Corinth thông qua một tuyến đường thủy dài 6,4 km.<br><br>Hoàng đế La Mã Nero đã đích thân khởi công xây dựng kênh đào này vào năm 67 sau Công nguyên, gần 1.800 năm trước khi công trình chính thức hoàn thành vào năm 1893."

	key[]: "gr_cut_souda_desc"
	val[]: "Vịnh Souda, nằm gần Chania trên đảo Crete, là một trong những cảng tự nhiên lớn nhất và sâu nhất ở Địa Trung Hải.<br><br>Tại cửa vịnh, người Venice đã xây dựng công sự trên hòn đảo nhỏ Souda vào thế kỷ XVI; pháo đài tại đây đã chống lại các lực lượng Ottoman và vẫn nằm dưới quyền kiểm soát của người Venice cho đến năm 1715 — nhiều thập kỷ sau khi phần còn lại của đảo Crete rơi vào tay Ottoman vào năm 1669."

	key[]: "gr_cut_polyfytos_desc"
	val[]: "Cầu Polyfytos bắc qua hồ nhân tạo Polyfytos trên sông Aliakmon – con sông dài nhất Hy Lạp – gần thành phố Kozani.<br><br>Được hoàn thành vào năm 1975, cây cầu dài 1.372 mét này do kỹ sư nổi tiếng người Ý Riccardo Morandi thiết kế."

	key[]: "poc_cut_alesund_desc"
	val[]: "Ålesund là một thị trấn cảng quan trọng tại Na Uy, thường xuyên đón các tàu du lịch biển.<br><br>Hoàng đế Đức Wilhelm II, người từng ghé thăm thị trấn này trước đó, đã cử các tàu hải quân chở theo vật liệu xây dựng đến để hỗ trợ tái thiết sau khi một trận hỏa hoạn tàn khốc thiêu rụi gần như toàn bộ thị trấn vốn được xây dựng chủ yếu bằng gỗ vào năm 1904."

	key[]: "poc_cut_bodo_desc"
	val[]: "Bodø là một thành phố ven biển nằm ngay phía bắc Vòng Bắc Cực, được chọn là Thủ đô Văn hóa châu Âu năm 2024."

	key[]: "poc_cut_nordkapp_desc"
	val[]: "North Cape là một cao nguyên vách đá cao 307 mét nằm trên đảo Magerøya, thường được quảng bá là điểm cực bắc của lục địa châu Âu.<br><br>Trên thực tế, North Cape không phải là điểm cực bắc của châu Âu; mũi đất Knivskjellodden gần đó còn vươn xa hơn về phía bắc khoảng 1.450 mét."

	key[]: "poc_cut_santa_desc"
	val[]: "Làng Ông già Noel nằm ngay trên Vòng Bắc Cực, cách Rovaniemi khoảng tám km về phía bắc và mở cửa quanh năm.<br><br>Du khách có thể đứng trên một vạch kẻ đánh dấu Vòng Bắc Cực và nhận giấy chứng nhận chính thức xác nhận rằng họ đã vượt qua ranh giới này."

	key[]: "poc_cut_muotkatakka_desc"
	val[]: "Muotkatakka, nằm cách Kilpisjärvi khoảng 12 km về phía nam, là điểm cao nhất trên toàn bộ mạng lưới đường công cộng của Phần Lan với độ cao 565,8 mét.<br><br>Con đường chạy qua đèo này nối liền Phần Lan với Na Uy; tại đây, du khách thường bắt gặp những đàn tuần lộc đi lang thang ngay bên vệ đường gần khu vực đỉnh đèo."

	key[]: "poc_cut_farm_desc"
	val[]: "Tohmajärvi là một đô thị nhỏ với những ngọn đồi phủ rừng và các hồ nước, nằm tại vùng Bắc Karelia, gần biên giới phía đông của Phần Lan giáp với Nga.<br><br>Huy hiệu của đô thị này khắc họa hình ảnh một chiếc đe và ngọn lửa, gợi nhớ về ngành công nghiệp sắt từng đóng vai trò quan trọng tại khu vực này."

	key[]: "poc_cut_viitasaari_desc"
	val[]: "Viitasaari là một thị trấn nằm ở miền Trung Phần Lan, nơi có khoảng 230 hồ nước rải rác khắp địa bàn đô thị.<br><br>Lễ hội âm nhạc mùa hè tại Viitasaari thường bắt đầu hàng năm bằng một cuộc diễu hành của các xe máy kéo chạy qua thị trấn trước khi các buổi hòa nhạc chính thức diễn ra."

	key[]: "poc_cut_lalby_desc"
	val[]: "Lålby là một ngôi làng nhỏ nằm trong phạm vi Kristinestad, thuộc vùng Ostrobothnia trên bờ biển phía tây Phần Lan."

	key[]: "poc_cut_kiruna_desc"
	val[]: "Kiruna là thị trấn cực bắc của Thụy Điển, được xây dựng xung quanh Kirunavaara – mỏ quặng sắt ngầm lớn nhất thế giới.<br><br>Khối quặng sắt này trồi lên từ độ sâu hai km cách đây khoảng 1,6 tỷ năm, và ngày nay, mỏ này cung cấp khoảng 80% lượng quặng sắt cho Liên minh châu Âu (EU)."

	key[]: "poc_cut_gavle_desc"
	val[]: "Gävle là một thành phố cảng nằm trên bờ biển phía đông Thụy Điển, tại cửa sông Gavleån thuộc vùng Gästrikland.<br><br>Kể từ năm 1966, cứ đến mùa Vọng, thành phố này lại dựng lên một con dê Yule khổng lồ làm bằng rơm; tuy nhiên, nó đã bị những kẻ phóng hỏa thiêu rụi hơn 30 lần."

	key[]: "poc_cut_lulea_desc"
	val[]: "Luleå, thủ phủ của hạt Norrbotten, nằm bên vịnh Bothnia và bao gồm một quần đảo với hơn 1.300 hòn đảo.<br><br>Một công ty công nghệ lớn đã xây dựng một trung tâm dữ liệu khổng lồ tại Luleå, chủ yếu là vì cái lạnh khắc nghiệt của vùng Bắc Cực đóng vai trò như một hệ thống làm mát tự nhiên, miễn phí cho các máy chủ tại đây."

	key[]: "poc_cut_heia_desc"
	val[]: "Điểm dừng chân có phong cảnh đẹp trên quốc lộ E6 tại Balsfjord, Troms, với tầm nhìn ra núi ở độ cao khoảng 240 mét."

	key[]: "poc_cut_svolvaer_desc"
	val[]: "Svolvær, nằm trên đảo Austvågøya, là thị trấn lớn nhất và được coi là thủ phủ không chính thức của quần đảo Lofoten tại Na Uy."

	key[]: "poc_cut_bjornfjell_desc"
	val[]: "Bjørnfjell là một nhà ga trên tuyến đường sắt Ofoten, nằm ngay tại biên giới Na Uy – Thụy Điển, gần Narvik.<br><br>Do tọa lạc ở vị trí rất cao trên núi, nhà ga Bjørnfjell thường bị tuyết bao phủ trong phần lớn thời gian của năm; hơn nữa, tuyến đường sắt chạy qua đây còn được xem là một trong những hành trình tàu hỏa có phong cảnh đẹp nhất tại Bắc Âu."

	key[]: "poc_cut_trondheim_desc"
	val[]: "Trondheim, được thành lập vào khoảng năm 997 với tên gọi Kaupangr – sau này được biết đến là Nidaros – từng là thủ đô của Na Uy trong thời kỳ Viking.<br><br>Nhà thờ Nidaros tại đây, được xây dựng trên phần mộ của Thánh Olav, là nhà thờ Gothic thời trung cổ nằm ở vị trí cực bắc trên thế giới."

	key[]: "is_cut_thingvellir_desc"
	val[]: "Vườn quốc gia Þingvellir nằm trong một thung lũng tách giãn giữa các mảng kiến tạo Bắc Mỹ và Á-Âu. Nơi đây đã được UNESCO công nhận là Di sản Thế giới vào năm 2004.<br><br>Quốc hội Iceland, gọi là Alþingi, lần đầu tiên nhóm họp tại đây dưới bầu trời thoáng đãng vào năm 930, biến nó trở thành một trong những cơ quan quốc hội lâu đời nhất trên thế giới."

	key[]: "is_cut_barthastran_desc"
	val[]: "Barðastrandarvegur (Tuyến đường 62) chạy dọc theo bờ biển Barðaströnd ở phía nam vùng Westfjords, men theo bờ phía bắc của vịnh Breiðafjörður rộng lớn.<br><br>Vị thủ lĩnh người Viking Hrafna-Flóki Vilgerðarson đã trải qua một mùa đông trên bờ biển này; sau khi nhìn thấy một vịnh hẹp đầy những tảng băng trôi từ một ngọn núi gần đó, ông đã đặt tên cho cả đất nước này là Iceland (xứ sở băng giá)."

	key[]: "is_cut_lagoon_desc"
	val[]: "Khu spa đầm phá địa nhiệt này nằm trên một cánh đồng dung nham tại bán đảo Reykjanes, nơi du khách có thể thư giãn trong làn nước màu xanh đục với nhiệt độ trung bình từ 37–39°C.<br><br>Đây là một đầm phá nhân tạo: khu spa được thành lập nhằm tận dụng nguồn nước ấm chảy ra từ nhà máy điện địa nhiệt gần đó, vốn đi vào hoạt động từ năm 1976."

	key[]: "is_cut_selfoss_desc"
	val[]: "Selfoss là thị trấn lớn nhất ở miền Nam Iceland. Thị trấn này được xây dựng bên bờ sông Ölfusá – nơi có cây cầu treo đầu tiên được bắc qua vào năm 1891.<br><br>Kể từ năm 2011, Selfoss đã trở thành một trong những địa điểm tổ chức cuộc thi \"Người đàn ông khỏe nhất Iceland\" (Iceland's Strongest Man), nơi các lực sĩ với sức mạnh phi thường cùng nhau nâng những tảng đá lớn và kéo những chiếc xe tải nặng."

	key[]: "is_cut_seljaland_desc"
	val[]: "Seljalandsfoss là một thác nước cao 60 mét nằm ở miền Nam Iceland, được nuôi dưỡng bởi một dòng sông bắt nguồn từ núi lửa băng hà Eyjafjallajökull.<br><br>Một lối mòn dẫn thẳng ra phía sau dòng thác, đi vào một hang động nhỏ, cho phép du khách chiêm ngưỡng thác nước từ bên trong."

	key[]: "is_cut_geyser_desc"
	val[]: "Strokkur, nằm trong cánh đồng địa nhiệt Haukadalur, là mạch nước phun hoạt động mạnh nhất tại Iceland, với các đợt phun trào diễn ra chỉ cách nhau vài phút.<br><br>Mạch nước phun lân cận đó, Great Geysir, chính là nguồn gốc tên gọi cho tất cả các mạch nước phun trên thế giới; tên gọi này bắt nguồn từ động từ \"geysa\" trong tiếng Iceland, có nghĩa là \"la tới phía trước một cách nhanh chóng\"."

	key[]: "is_cut_gullfoss_desc"
	val[]: "Gullfoss, hay còn gọi là \"Thác Vàng\", là một thác nước nằm trên dòng sông Hvítá. Thác đổ xuống qua hai bậc, với độ cao lần lượt là 11 mét và 21 mét, rồi rơi vào một khe nứt sâu 32 mét.<br><br>Khi các nhà đầu tư nước ngoài muốn khai thác thác nước này để sản xuất điện, Sigríður Tómasdóttir – con gái của một nông dân địa phương – đã đứng lên vận động để bảo vệ nó. Phía trên thác nước hiện có một đài tưởng niệm bằng đá để vinh danh bà."

	key[]: "is_cut_joekul_desc"
	val[]: "Jökulsárlón là một hồ băng nằm ở phần đầu của Breiðamerkurjökull – một dòng sông băng nhánh bắt nguồn từ dải băng khổng lồ Vatnajökull.<br><br>Hồ này bắt đầu hình thành từ những năm 1930 khi sông băng rút dần; với độ sâu hơn 280 mét, đây hiện là hồ sâu nhất tại Iceland."

	key[]: "is_cut_gothafoss_desc"
	val[]: "Goðafoss là một thác nước cao 12 mét, rộng 30 mét, nằm trên dòng sông Skjálfandafljót ở miền Bắc Iceland.<br><br>Tên gọi của thác thường được dịch là \"thác của các vị thần\", mặc dù cái tên này có thể bắt nguồn từ hai tảng đá tại thác trông giống như những pho tượng thần ngoại giáo."

	key[]: "is_cut_canyon_desc"
	val[]: "Stuðlagil là một hẻm núi nằm tại thung lũng Jökuldalur ở miền Đông Iceland, với các cột đá bazalt hình lục giác cao vút chạy dọc theo dòng sông Jökla.<br><br>Trước đây, hẻm núi này từng nằm ẩn mình dưới nước. Sau khi đập thủy điện Kárahnjúkar hoàn thành vào năm 2009, mực nước sông đã giảm xuống, để lộ ra hẻm núi này; nơi đây chỉ thực sự trở nên nổi tiếng sau khi một nhiếp ảnh gia chia sẻ hình ảnh về nó vào năm 2016."
#@}

