#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "CHỌN CHẾ ĐỘ ĐẤU NỐI STEAM INPUT" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Giới thiệu <color value=@@clr_sel@@>Chế độ đấu nối trong trò chơi<color value=@@clr_txt@@>, hỗ trợ đầy đủ các thiết lập đấu nối phím trong trò chơi với các gợi ý nút tốt hơn. Đây là chế độ được khuyến nghị.<br><br>Giữ <color value=@@clr_sel@@>Chế độ đấu nối Steam Client<color value=@@clr_txt@@> nếu bạn đã tuỳ chỉnh bố cục tay cầm thông qua Steam Client.<br><br>Bạn có thể thay đổi chế độ trong tuỳ chọn thông qua Trình Input." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Giữ chế độ Steam Client" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Mở Trình Input" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Chế độ sơ đồ Steam Input" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Sơ đồ đầu vào trong trò chơi" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Sơ đồ đầu vào từ Steam Client" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Chọn chế độ cho tay cầm chơi game như @@controller_ps5@@, @@controller_xbox_one@@ hoặc @@controller_steam_deck@@ đã được tích hợp vào giao diện Steam Input:<br>- \"Ánh xạ máy khách Steam\" - Sử dụng bố cục độc lập được cấu hình thông qua máy khách Steam. Hỗ trợ hạn chế cho gợi ý nút trong trò chơi và không có cấu hình liên kết trong trò chơi.<br>- \"Ánh xạ trong trò chơi\" - Sử dụng bố cục đơn giản phổ quát. Hỗ trợ đầy đủ cấu hình liên kết phím trong trò chơi và gợi ý nút tốt hơn. Nên chạy Input Wizard khi chuyển sang chế độ này. Đây là chế độ được khuyến nghị."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Bộ điều khiển Steam"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Steam Input Controller"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Đồng bộ Steam cloud:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Bạn đang sử dụng phiên bản cũ hơn của trò chơi.<br>Steam sẽ tự động cập nhật trò chơi trừ khi bạn đã tắt tính năng cập nhật tự động."
#@}

	key[]: "steam_demo"
	val[]: "Nếu bạn thích trò chơi thông qua bản demo, hãy vui lòng mua bản đầy đủ của trò chơi tại <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 không thể truy cập vào Steam. Bạn hãy kiểm tra theo các bước sau:\n\n1. Kiểm tra xem Steam có đang được mở không..\n2. Kiểm tra xem Steam được nâng cấp bản mới nhất chưa.\n3. Kiểm trang xem phần tự động nâng cầp có được kích hoạt không và game đã được nâng cấp phiên bản mới nhất chưa."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Một phần trong nội dung download không phù hợp với phiên bản trò chơi hiện tại và sẽ không hiển thị được. Xin vui lòng kiểm tra phần lưu cache của Steam.<br><br>Phần nội dung sau đây bị lỗi:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Không thể tạo hồ sơ Steam với tên đã cho vì đã có hồ sơ Steam có tên đó." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Không thể di chuyển hồ sơ, đã có một hồ sơ khác trùng tên." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Quá trình chuyển đổi hồ sơ đã thất bại." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Đồng bộ hóa vào Steam Cloud" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "Steam Cloud của bạn không đủ dung lượng để tải lên tệp của bạn." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Bạn sắp hết dung lượng trên Steam Cloud!<color value=@@clr_txt@@><br><br>Hãy xóa một số bản ghi trước khi tiếp tục. Đây là một số thông tin có thể giúp bạn:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Đã vượt quá dung lượng: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Đã vượt quá số lượng tệp: <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Dung lượng Steam Cloud đã sử dụng: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Tệp trên Steam Cloud: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "Mục đã chọn lưu <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> có <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@> trong <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> tập tin." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Bạn hết dung lượng trên Steam Cloud. Vui lòng xóa một số tệp lưu để tiếp tục.<br><br>Vui lòng đọc thông tin chi tiết trên bảng bên phải." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Bằng cách chuyển sang loại hồ sơ cục bộ, hồ sơ này từ nay sẽ chỉ khả dụng trên máy tính này, bất kể tài khoản Steam nào đang đăng nhập " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Quá trình chuyển đổi hồ sơ đã thất bại. Không có dữ liệu nào được chuyển và hệ thống vẫn giữ nguyên hồ sơ cũ. Vui lòng thử lại." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

