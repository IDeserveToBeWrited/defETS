    key[]: "hint_driv_arc_title"
	val[]: "Lái xe"

    key[]: "hint_driv_arc_text"
	val[]: "Sử dụng $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ và $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ để tiến hoặc lùi.<br><offset vshift=8>Sử dụng $SPECIAL_steering$ để điều khiển vô lăng."


    key[]: "hint_driv_auto_title"
	val[]: "Lái xe"

    key[]: "hint_driv_auto_text"
	val[]: "Sử dụng $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ và $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ để tiến hoặc lùi.<br><offset vshift=8>Sử dụng $SPECIAL_steering$ để điều khiển vô lăng.<br><offset vshift=8>Nhấn $KEY_gearup$ và $KEY_geardown$ để chọn số."


    key[]: "hint_driv_seq_title"
	val[]: "Lái xe"

    key[]: "hint_driv_seq_text"
	val[]: "Sử dụng $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ và $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ để tiến hoặc lùi.<br><offset vshift=8>Sử dụng $SPECIAL_steering$ để lái.<br><offset vshift=8>Nhấn $KEY_gearup$ và $KEY_geardown$ để điều khiển ly hợp."


    key[]: "hint_driv_hshift_title"
	val[]: "Lái xe"

    key[]: "hint_driv_hshift_text"
	val[]: "Sử dụng $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ và $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ để tiến hoặc lùi.<br><offset vshift=8>Sử dụng $SPECIAL_steering$ để lái.<br><offset vshift=8>Thay đổi số bằng <color value=@@clr_sel@@>cần số<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Tiến đến điểm đích"

    key[]: "hint_depot_deliv_text"
    val[]: "Dừng lại ở khu vực được đánh dấu để chọn độ khó của điểm đỗ xe cuối cùng và nhận điểm kinh nghiệm tương ứng."


    key[]: "hint_fin_deliv_title"
    val[]: "Hoàn tất việc giao hàng"

    key[]: "hint_fin_deliv_text"
    val[]: "Đỗ xe vào vị trí đỗ xe đã chọn. Bạn có thể nhấn phím $KEY_activate$ để bỏ qua bước này khi đến gần điểm giao hàng."


    key[]: "hint_fin_deliv2_title"
    val[]: "Hoàn tất việc giao hàng"

    key[]: "hint_fin_deliv2_text"
    val[]: "Hãy đỗ vào vị trí đã chọn. Bạn có thể bật widget trong @@desktop_menu_category_options@@ để cho phép bỏ qua việc đỗ xe."


    key[]: "hint_lights_title"
    val[]: "Bật đèn lên"

    key[]: "hint_lights_text"
    val[]: "Sử dụng phím $KEY_light$ để bật đèn. Chuyển đổi giữa các chế độ khác nhau bằng cách nhấn phím này nhiều lần."


    key[]: "hint_high_beam_title"
    val[]: "Bật đèn pha chiếu xa"

    key[]: "hint_high_beam_text"
    val[]: "Sử dụng $KEY_hblight$ để bật đèn pha chiếu xa."


    key[]: "hint_wipers_title"
    val[]: "Kích hoạt cần gạt nước"

    key[]: "hint_wipers_text"
    val[]: "Sử dụng $KEY_wipers$ để kích hoạt cần gạt nước và chuyển đổi giữa các tốc độ khác nhau."


    key[]: "hint_zoom_title"
    val[]: "Nhìn kỹ hơn"

    key[]: "hint_zoom_text"
    val[]: "Sử dụng $KEY_camzoom$ để phóng to khi ở trong nội thất. Bạn có thể thiết lập chế độ phóng to thành giữ hoặc chuyển đổi trong @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Nhìn xung quanh"

    key[]: "hint_cam_int_text"
    val[]: "Sử dụng $KEY_cam1$ để chuyển camera sang chế độ xem bên trong."


    key[]: "hint_cam_ext_title"
    val[]: "Nhìn xung quanh"

    key[]: "hint_cam_ext_text"
    val[]: "Bạn có thể chuyển đổi giữa các góc nhìn camera khác nhau bằng cách nhấn phím $KEY_camcycle$.<br><offset vshift=8>Sử dụng phím $KEY_cam2$ để chuyển camera sang chế độ xem bên ngoài."


    key[]: "hint_indicators_title"
    val[]: "Đèn báo rẽ"

    key[]: "hint_indicators_text"
    val[]: "Sử dụng $KEY_lblinker$ và $KEY_rblinker$ để bật đèn báo rẽ."


    key[]: "hint_tow_title"
    val[]: "Dịch vụ kéo xe"

    key[]: "hint_tow_text"
    val[]: "Nếu bạn không thể tự thoát khỏi tình huống khó khăn, bạn có thể sử dụng dịch vụ kéo xe. Để truy cập dịch vụ này, hãy mở menu @@quick_info_word@@ bằng phím $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Khóa vi sai"

    key[]: "hint_diff_lock_text"
    val[]: "Nếu bạn không thể bắt đầu di chuyển, có lẽ khóa vi sai sẽ giúp ích cho bạn. Sử dụng $KEY_diflock$ để kích hoạt nó hoặc bật khóa vi sai tự động trong @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Khóa vi sai đã được kích hoạt"

    key[]: "hint_diff_unlock_text"
    val[]: "Bạn nên mở khóa vi sai trong khi lái xe bình thường, nếu không sẽ có nguy cơ làm hỏng nó. Sử dụng $KEY_diflock$ để tắt hoặc bật khóa vi sai tự động trong @@desktop_menu_category_options@@."


