#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Trong tình huống này, bạn sẽ phải đối mặt với nhiều khúc cua khác nhau để giúp bạn làm quen với việc lái xe có rơ-moóc. Hãy tập trung, điều chỉnh tốc độ cho phù hợp với từng tình huống và tận dụng tối đa không gian có sẵn trên đường tập lái."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Khúc cua đầu tiên là một khúc cua gấp - hai khúc cua trong một. Bạn phải chuẩn bị rẽ trái, nhưng chuyển sang rẽ phải ở giữa khúc cua."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Khúc cua tiếp theo sẽ đưa bạn sang phía bên kia dải phân cách. Việc này không quá khó nhưng bạn cần chú ý chừa đủ khoảng trống cho rơ-moóc của mình."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Tiếp theo, bạn sẽ phải điều khiển xe vượt qua các rào chắn bê tông một cách khéo léo. Hãy đi chậm và sử dụng gương chiếu hậu, đồng thời đảm bảo bạn đánh lái đủ rộng để rơ-moóc của bạn có thể vượt qua các rào chắn."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Đến đoạn này, bạn sẽ bước vào một đường zíc-zắc khác với các cọc tiêu bổ sung ở đỉnh mỗi khúc cua. <br>Hãy cẩn thận đừng đâm vào bất kỳ cọc tiêu nào!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Tiếp theo là một vài khúc cua dễ đi trên đường đến vòng xoay."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Hãy tận dụng đoạn đường thẳng để chuẩn bị vào vòng xuyến. Giữ làn đường phía ngoài trước khi vào vòng xuyến."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Đi vào vòng xuyến và quan sát vị trí của rơ-moóc. Nó sẽ di chuyển khác đi khi bạn đã vào trong vòng xuyến so với lúc bạn đi vào."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Rời khỏi vòng xuyến và tiếp tục lái xe đến ngã rẽ tiếp theo."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "XÓA ĐOẠN PHIM NÀY"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Khúc cua ở đây cực kỳ gắt. Hãy đi chậm và sử dụng không gian xung quanh một cách khéo léo. Đồng thời, hãy lưu ý đến hiện tượng văng đuôi của rơ-moóc."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Khi lái xe qua vài khúc cua tiếp theo, hãy nhớ cố gắng chuẩn bị tư thế cho khúc cua tiếp theo ngay khi vừa ra khỏi khúc cua trước đó."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Đừng vội vàng ở khúc cua cuối cùng. Trông có vẻ dễ, nhưng không gian để xoay sở hẹp hơn so với vẻ bề ngoài."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Dừng xe tại khu vực quy định, khóa xe và tắt máy."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Tăng tốc về phía khúc cua đầu tiên.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Khúc cua đầu tiên là một khúc cua gấp dễ dàng.<br><br><font face=/font/big_bold.font>Hãy thực hiện khúc cua.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "BỎ DẤU KIỂM NÀY"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Phía trước, đường đua tiếp tục ở bên trái dải phân cách.<br><br><font face=/font/big_bold.font>Hãy đi qua đoạn giao cắt.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Lách qua các rào chắn và nhớ để ý đến rơ-moóc của bạn.<br><br><font face=/font/big_bold.font>Lái xe qua đoạn đường ngoằn ngoèo.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Đường zíc zắc này đơn giản hơn, nhưng các cọc tiêu giao thông khiến nó hẹp hơn đáng kể.<br><br><font face=/font/big_bold.font>Lái xe qua đường zíc zắc và tránh đâm vào bất kỳ cọc tiêu nào.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Phía trước có một vài khúc cua dễ, nhưng bạn vẫn cần chuẩn bị kỹ lưỡng để giữ cho rơ-moóc không va vào các rào chắn bên trong.<br><br><font face=/font/big_bold.font>Thực hiện các khúc cua.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Bạn đang đến gần một vòng xuyến. Hãy nhớ chừa đủ khoảng trống cho rơ-moóc của bạn không chỉ khi vào và ra khỏi vòng xuyến, mà cả khi bạn lái xe qua vòng xuyến.<br><br><font face=/font/big_bold.font>Lái xe qua vòng xuyến.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Phía trước có một đoạn đường thẳng ngắn, bạn có thể tăng tốc nếu muốn.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Khúc cua ở đây cực kỳ gấp. Hãy đi chậm, tận dụng tối đa không gian có sẵn và chú ý đến việc đuôi xe moóc có thể văng ra. <br><br><font face=/font/big_bold.font>Lái xe qua khúc cua gấp.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Những khúc cua cuối cùng khá dễ đi. Nhớ chú ý đến rơ-moóc của bạn.<br><br><font face=/font/big_bold.font>Tiếp tục đi.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Tiếp tục đi về phía chỗ đỗ xe cuối cùng. </font>"
