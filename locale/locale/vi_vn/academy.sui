#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Đỗ xe khi đang lái tiến, hay còn gọi là 'nosing in', là thao tác khá dễ dàng trong số các kỹ thuật đỗ xe.<br>Tuy nhiên, bạn vẫn sẽ cần phải bù lái cho hiện tượng lệch quỹ đạo của rơ-moóc."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Bạn sẽ phải lái xe vượt qua điểm mà thông thường bạn sẽ tự động quay đầu xe đầu kéo. Điều này sẽ giúp bạn căn chỉnh rơ-moóc hiệu quả hơn."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Khi đến gần chỗ đỗ xe, hãy đánh lái để đưa đầu kéo vào phía trước rơ-moóc. Căn chỉnh đúng vị trí và tiến vào chỗ đỗ. <br>Dừng lại, đỗ xe, chốt an toàn xe tải và tắt máy."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Phía trước bạn có một chỗ đỗ xe mà bạn cần lái xe đến và đỗ vào đó.<br><br><font face=/font/big_bold.font>Hãy chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Bắt đầu lái xe và rẽ vào chỗ đỗ xe.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Lái xe qua chỗ đỗ xe để căn chỉnh rơ-moóc của bạn thẳng hàng với khu vực được đánh dấu, sau đó đưa máy kéo vào vị trí và chỉnh thẳng.<br><br><font face=/font/big_bold.font>Đỗ xe trong khu vực được chỉ định.</font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Dừng xe tại khu vực quy định.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Kéo phanh tay xe tải và tắt động cơ.</font>"
#@}

