#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Phía trước là nhiều khúc cua và chướng ngại vật phức tạp.<br>Hãy vận dụng tất cả những gì bạn đã học được cho đến nay và nó sẽ không quá khó khăn."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Các vạch kẻ đường có thể giúp bạn hình dung cách vượt qua từng chướng ngại vật."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Giữ máy kéo ở phía ngoài góc cua. <br>Bạn cần đánh lái rộng vì rơ-moóc đi theo đường ngắn hơn."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Góc cua tiếp theo là một khúc cua 90 độ dễ dàng. <br> Một lần nữa, hãy giữ xe tải ở phía ngoài của khúc cua và tận dụng tối đa không gian có sẵn."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Hãy dành thời gian ở đây. Khóa học sẽ dần mở ra, nhưng bạn vẫn cần phải chính xác."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Giữ khoảng cách an toàn với các rào chắn."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Hãy cẩn thận khi đi vào đoạn đường hẹp này. <br>Hãy xoay máy kéo rộng hết cỡ trước khi vào để chuẩn bị rơ-moóc cho việc đi vào."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Khúc cua 90 độ cuối cùng gấp hơn nhiều so với khúc cua đầu tiên, nhưng vẫn có đủ không gian nếu bạn biết cách tận dụng không gian một cách khôn ngoan."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Đỗ xe vào khu vực quy định, sau đó khóa xe và tắt máy."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Hãy nhớ tận dụng các vạch kẻ đường để định hướng.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Sử dụng gương chiếu hậu cũng sẽ giúp bạn điều khiển xe an toàn hơn. Bạn phải luôn chú ý đến hướng di chuyển của rơ-moóc phía sau.<br><br><font face=/font/big_bold.font>Tiếp tục đi qua khúc cua đầu tiên.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Quan sát rơ-moóc khi bạn ra khỏi khúc cua và chuẩn bị vào khúc cua tiếp theo.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Tiếp tục đi qua khúc cua tiếp theo.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Hãy nhớ quan sát rơ-moóc của bạn để đảm bảo không có chướng ngại vật xung quanh trước khi quay đầu xe tải.<br><br><font face=/font/big_bold.font>Tiếp tục đi vòng qua chướng ngại vật phía trước.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Khi rơ-moóc của bạn đã vượt qua rào chắn, hãy đánh lái mạnh sang phía bên phụ để thẳng hàng với lối đi hẹp. <br><br><font face=/font/big_bold.font>Tiếp tục đi về phía lối đi hẹp.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Đoạn đường này đòi hỏi kỹ năng lái xe rất chính xác. Hãy lái chậm rãi và sử dụng gương chiếu hậu.<br><br><font face=/font/big_bold.font>Giữ xe ở phía ngoài mỗi khúc cua.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Khúc cua này rất gấp, nhưng bạn có thể tận dụng tối đa không gian phía trước để vượt qua dễ dàng.<br><br><font face=/font/big_bold.font>Thực hiện cú rẽ cuối cùng.</font>"
