#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Trong tình huống cuối cùng của chương này, chúng ta sẽ lái xe trên đường thử với cấu hình phức tạp."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Chướng ngại vật đầu tiên là một đoạn đường ngoằn ngoèo vượt qua một số rào chắn. Hãy lái xe qua đó và nhớ sử dụng gương chiếu hậu."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Tiếp theo là một khúc cua hình chữ U. Giữ cho xe đi rộng và nó sẽ không gây ra vấn đề gì cho bạn."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Ở đây có một khúc cua trái 90 độ. Nhớ lái xe vào sâu sao cho đuôi xe tải không chạm vào rào chắn bên trong."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Chướng ngại vật dốc có thể hơi khó vượt qua. Hãy căn chỉnh xe sao cho thẳng hàng nhất có thể trước khi lái lên và sử dụng gương chiếu hậu phía trước và hai bên để định hướng."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Phần tiếp theo phải được thực hiện bằng cách lùi xe. Hãy tiếp cận các rào chắn phía trước với lưu ý đó."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Hãy đi theo vạch kẻ đường ở phía sau và bên phải bạn."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Lùi về phía rào chắn, sau đó dừng lại và tiến lên về phía bên trái."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Tiếp tục đi qua đoạn đường phân cách để đến phần tiếp theo."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Đoạn đường qua các cọc tiêu này rất hẹp. Hãy lái xe chậm và sử dụng gương để định hướng vị trí xe trong lối đi."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Hãy nhớ đánh lái thật sâu khi vào cua 90 độ."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Bạn đang đi vào một đoạn đường thoáng đãng và đẹp. Bạn có thể tăng tốc, nhưng hãy nhớ rằng bạn cần giảm tốc độ sớm khi đến khúc cua phía trước."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Dưới chân đồi có một số rào chắn ngang đường. Hãy lái xe lên đến đó, sau đó lùi xe vào chỗ đậu xe bên trái."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Lùi xe vào chỗ đỗ."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Đỗ xe, sau đó tắt máy và cố định xe tải."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Trước mặt bạn là một đường đua ngoằn ngoèo được tạo thành từ các chướng ngại vật.<br><br><font face=/font/big_bold.font>Hãy lái xe qua đường đua ngoằn ngoèo này.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Giữ xe ở phía ngoài khúc cua để đảm bảo phần đuôi máy kéo không bị vượt qua lề đường.<br><br><font face=/font/big_bold.font>Thực hiện cú rẽ.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Bạn sắp đến một khúc cua trái 90 độ. Hãy nhớ tận dụng tối đa không gian có sẵn.<br><br><font face=/font/big_bold.font>Rẽ vào khúc cua.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Hãy căn chỉnh xe sao cho thẳng hàng với đường dốc. Sẽ không có nhiều chỗ để điều chỉnh khi bạn đã lên trên đó.<br><br><font face=/font/big_bold.font>Lái xe qua đường dốc.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Đi theo hướng bên trái.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Phần tiếp theo phải được hoàn thành theo chiều ngược lại. Dừng lại ở các rào chắn phía trước để sau đó bạn có thể lùi xe sang phải.<br><br><font face=/font/big_bold.font>Dừng lại ở các rào chắn.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Lùi xe về phía khu vực phía sau và bên phải. Có các mũi tên trên đường để hỗ trợ bạn.<br><br><font face=/font/big_bold.font>Lùi xe về phía đoạn đường tiếp theo.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Hãy tiếp tục lùi về phía các rào chắn phía sau bạn.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Dừng lại và chuyển sang số tiến, sau đó tiếp tục đi về bên trái. <br><br><font face=/font/big_bold.font>Lái xe tiến về phía trước.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Có một đoạn đứt quãng ở dải phân cách bên trái. Hãy lái xe qua đó.<br><br><font face=/font/big_bold.font>Tiếp tục đi thẳng.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Phía trước bạn là một con đường hẹp quanh co xuyên qua một số cọc tiêu. Hãy lái xe cẩn thận và sử dụng gương chiếu hậu nếu cần thiết.<br><br><font face=/font/big_bold.font>Lái xe qua các cọc tiêu.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Tiếp tục đi theo lộ trình.<br><br><font face=/font/big_bold.font>Rẽ trái.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Hãy nhớ giữ bên trái trước khi rẽ để có được khoảng trống tối đa.<br><br><font face=/font/big_bold.font>Rẽ vào.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Bạn có thể tăng tốc ở đây, nhưng phía trước có một khúc cua.<br><br><font face=/font/big_bold.font>Tiếp tục đi theo lộ trình.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Đường cong sẽ càng dốc hơn khi bạn đi tiếp.<br><br><font face=/font/big_bold.font>Hãy điều chỉnh tốc độ cho phù hợp và tiếp tục.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Ở dưới chân đồi, bạn sẽ thấy các rào chắn chặn đường. <br><br><font face=/font/big_bold.font>Dừng xe gần các rào chắn.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Phía sau bạn và bên trái có một chỗ đậu xe.<br><br><font face=/font/big_bold.font>Lùi xe vào chỗ đậu.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Dừng lại ở vị trí đã được đánh dấu.</font>"
