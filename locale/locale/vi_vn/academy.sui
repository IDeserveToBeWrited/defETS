#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Lái xe trên sân tập kỹ năng"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Trong tình huống này, chúng ta sẽ lái xe trên một đường đua được thiết kế để kiểm tra khả năng điều khiển xe tải của bạn qua các khúc cua và góc đường khác nhau."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Bắt đầu khóa học"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Rẽ trái từ từ"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Lái xe qua những khúc cua chữ S"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Đoạn đường thẳng"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Những khúc cua dễ"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Kết thúc khóa đào tạo"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Tiến đến chỗ đỗ xe"
