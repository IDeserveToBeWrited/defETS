#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Trong bài tập này, chúng ta sẽ lùi xe theo đường thẳng. Bạn phải lùi xe qua vạch chấm và dừng lại ở đó."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Khi lùi xe tải, điều cần thiết là phải liên tục quan sát xung quanh, nhìn vào tất cả các gương chiếu hậu và đảm bảo không gian xung quanh và phía sau xe được thông thoáng."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Khởi động động cơ, chuyển cần số về số lùi và bắt đầu di chuyển."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Lùi xe qua vạch chấm, dừng lại, tắt máy và hãm phanh xe tải."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Chuẩn bị xe tải để lái như bạn đã học trong tình huống trước.<br><br><font face=/font/big_bold.font>Khi bạn đã sẵn sàng, hãy khởi động động cơ.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "\"Hãy kiểm tra các gương chiếu hậu để đảm bảo khu vực xung quanh bạn không có vật cản. Nếu chưa hài lòng với vị trí của chúng, bạn có thể điều chỉnh lại trong mục '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Hãy nhìn vào gương chiếu hậu bên phía hành khách.</font>@@aca_goal_tip@@ Bạn phải ở bên trong cabin xe.\""

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Bạn sẽ đi qua vạch kẻ đứt đoạn. Làn đường hiện đã thông thoáng, nhưng trong điều kiện lái xe bình thường, điều cần thiết là phải liên tục quan sát xung quanh bằng cách nhìn quanh và sử dụng gương chiếu hậu.<br><br><font face=/font/big_bold.font>Kiểm tra gương chiếu hậu bên phía người lái.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "\"<font face=/font/big_bold.font>Sử dụng $input backward$ để vào số lùi.</font>@@aca_goal_tip@@ Khi lùi xe, âm báo lùi sẽ tự động kích hoạt trên hầu hết các xe tải. Bạn có thể tắt âm thanh này trong phần Tùy chọn - 'Âm thanh' - @@sound_of_reverse@@.\""

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "\"<font face=/font/big_bold.font>Nhấn @@imv_nrm_geardown@@ để chuyển sang số lùi.</font>@@aca_goal_tip@@ Khi lùi xe, âm báo lùi sẽ tự động kích hoạt trên hầu hết các xe tải. Bạn có thể tắt âm thanh này trong phần Tùy chọn - 'Âm thanh' - @@sound_of_reverse@@.\""

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Nhấn @@imv_nrm_geardown@@ để chuyển sang số lùi.</font>@@aca_goal_tip@@ Khi lùi xe, còi báo lùi sẽ tự động kích hoạt trên hầu hết các xe tải. Bạn có thể tắt nó trong màn hình Tùy chọn - 'Âm thanh' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Nhấn hết chân côn và chuyển cần số về số lùi.</font>@@aca_goal_tip@@ Khi lùi xe, còi báo lùi sẽ tự động kích hoạt trên hầu hết các xe tải. Bạn có thể tắt nó trong màn hình Tùy chọn - 'Âm thanh' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Bạn hiện đã gài số lùi.<br><br><font face=/font/big_bold.font>Nhả phanh tay bằng lệnh @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Bắt đầu di chuyển bằng cách sử dụng lệnh `$input backward$`.<br><br><font face=/font/big_bold.font>Lùi qua vạch chấm.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Bắt đầu di chuyển bằng cách sử dụng bàn đạp ga: $input forward$.<br><br><font face=/font/big_bold.font>Lùi xe qua vạch chấm. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Bắt đầu di chuyển bằng cách sử dụng bàn đạp ga: $input forward$.<br><br><font face=/font/big_bold.font>Lùi xe qua vạch chấm. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Nhả côn từ từ, đồng thời duy trì vòng tua máy bằng cách sử dụng chân ga. <br><br><font face=/font/big_bold.font>Lùi xe qua vạch chấm.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Dừng xe tải bằng phanh chính: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Dừng xe tải bằng phanh chính: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Dừng xe tải bằng phanh chính: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Nhấn hết cỡ bàn đạp ly hợp rồi dừng xe bằng phanh chính. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Kích hoạt phanh tay bằng lệnh @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "\"Với hộp số tự động đơn giản, bạn không cần phải tự sang số vì mọi thứ đều được thực hiện tự động, khác với thực tế.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_activate@@ để xác nhận.</font>\""

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "\"<font face=/font/big_bold.font>Chuyển về số Mo bằng cách nhấn @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Các dòng xe tải hiện đại sẽ tự động chuyển về số Mo khi phanh tay được kéo. Tuy nhiên, tự mình thực hiện thao tác này luôn là một thói quen tốt. Trong các kịch bản tiếp theo, chúng tôi sẽ không bắt buộc thực hiện bước này.\""

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "\"<font face=/font/big_bold.font>Chuyển về số Mo bằng cách nhấn @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Các dòng xe tải hiện đại sẽ tự động chuyển về số Mo khi phanh tay được kéo. Tuy nhiên, việc tự mình thực hiện thao tác này luôn là một thói quen tốt. Trong các kịch bản tiếp theo, chúng tôi sẽ không yêu cầu bắt buộc bước này.\""

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "\"<font face=/font/big_bold.font>Đưa cần số về số Mo, sau đó nhả chân côn.</font>@@aca_goal_tip@@ Các dòng xe tải hiện đại sẽ tự động chuyển về số Mo khi phanh tay được kéo. Tuy nhiên, việc tự mình thực hiện thao tác này luôn là một thói quen tốt. Trong các kịch bản tiếp theo, chúng tôi sẽ không yêu cầu bắt buộc bước này.\""

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Hãy luôn chú ý đến môi trường xung quanh khi lùi xe, đặc biệt là ở những khu vực đông đúc, nhiều phương tiện giao thông.<br><br><font face=/font/big_bold.font>Tắt động cơ bằng cách nhấn $input engineelect$.</font>"
#@}

