#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Trong tình huống này, nhiệm vụ của bạn là đỗ xe vào khoảng trống bên cạnh. Không gian khá hẹp, vì vậy bạn sẽ phải tốn thêm chút công sức để đưa xe kéo đến vị trí mong muốn."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Lái xe thẳng đến rào chắn."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Dừng lại trước rào chắn."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Đánh mạnh vô lăng về phía người lái trước khi di chuyển. Bằng cách này, bạn sẽ bắt đầu xoay rơ-moóc về phía chỗ đỗ ngay khi bắt đầu lùi xe, tiết kiệm được không gian quý giá."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Khi đã định hướng rơ-moóc đến vị trí mong muốn, hãy đưa đầu kéo đến trước rơ-moóc và bắt đầu điều khiển vào chỗ đỗ."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Từ điểm này trở đi, thao tác này không khác mấy so với thao tác đỗ xe thông thường."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Tiếp tục lùi xe và quan sát cả hai bên. Giữ cho đầu kéo và rơ-moóc thẳng hàng với chỗ đỗ xe."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Dừng xe tại khu vực quy định, khóa xe và tắt máy."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Bạn đang ở một vị trí đỗ xe, nhưng có một vị trí đỗ thứ hai ở phía bên phải mà bạn phải di chuyển vào đó.<br><br><font face=/font/big_bold.font>Hãy chuẩn bị khởi hành. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Có một khu vực được đánh dấu phía trước bạn.<br><br><font face=/font/big_bold.font>Lái xe tiến lên.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Hãy nhớ lập tức điều khiển vô lăng vì không gian khá hẹp.<br><br><font face=/font/big_bold.font>Lùi xe về vị trí đã được đánh dấu phía sau.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Lái xe qua những khúc cua đơn giản"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Trong tình huống này, bạn sẽ lái xe một đoạn ngắn qua một đường đua huấn luyện giúp bạn học cách điều khiển rơ-moóc vượt qua các khúc cua 90 độ đơn giản."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Rẽ vào khúc cua đầu tiên"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Lượt thứ hai"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Lượt cuối cùng"
#!{
	key[]: "aca_goal_book1_3_15_check5"
