#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Lùi xe với rơ-moóc"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Trong tình huống này, bạn sẽ thử lùi xe với rơ-moóc lần đầu tiên. Đây là một thao tác khá đơn giản, nhưng bạn vẫn cần điều khiển tay lái chính xác để đưa rơ-moóc vào đúng vị trí."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Lùi xe về phía rơ-moóc"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Kết nối rơ-moóc"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Nhả phanh tay"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Lùi xe với rơ-moóc"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Tiếp tục đi về phía chỗ đậu xe"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Chúng ta hãy thử lùi xe với rơ-moóc xem sao. Việc này dễ hơn bạn nghĩ; bạn chỉ cần kiên nhẫn thôi."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Bắt đầu lùi xe và đưa đầu kéo thẳng hàng với rơ-moóc."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Hãy chắc chắn rằng bạn đã căn chỉnh đúng vị trí, nếu không bạn sẽ không thể kết nối được. Nếu chưa đúng, bạn luôn có thể kéo về phía trước và thử lại."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Mâm cặp của máy kéo sẽ khớp với chốt nối của rơ-moóc."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Kéo phanh tay và nối rơ-moóc. Trong thực tế, bạn sẽ phải ra khỏi xe tải để nối đường ống dẫn khí và điện cũng như nâng chân chống, nhưng ở đây, chúng tôi sẽ làm điều đó cho bạn."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Rơ-moóc sẽ luôn chuyển hướng <color value=@@clr_sel@@>ngược lại <color value=@@clr_txt@@>với xe đầu kéo."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Để chuyển hướng rơ-moóc, bạn cần điều khiển xe đầu kéo theo hướng <color value=@@clr_sel@@> ngược lại <color value=@@clr_txt@@> với hướng mà bạn muốn rơ-moóc đi tới."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Để làm thẳng rơ-moóc trở lại, hãy điều khiển xe đầu kéo hướng <br><color value=@@clr_sel@@>về phía<color value=@@clr_txt@@> rơ-moóc."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Cố gắng giữ cho xe thẳng hàng với rơ-moóc - bạn sẽ phải liên tục điều chỉnh nhỏ để giữ cho rơ-moóc luôn hướng về khu vực đã được đánh dấu."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Ngay khi gặp phải những sai lệch so với lộ trình, hãy điều chỉnh vô lăng bằng những cú xoay nhẹ. Nếu xoay vô lăng quá mạnh, bạn có thể đi lạc ra khỏi lộ trình mong muốn."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Dừng xe tại khu vực quy định. Chốt cửa xe và tắt máy."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Phía sau bạn và bên phía hành khách, bạn sẽ thấy một chiếc rơ-moóc. Nhiệm vụ đầu tiên của bạn là lùi xe về phía nó.<br><br><font face=/font/big_bold.font>Chuẩn bị xe tải để lùi.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Bắt đầu lùi xe về phía rơ-moóc.</font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Căn chỉnh xe sao cho thẳng hàng với rơ-moóc. Khớp nối thứ năm cần khớp với chốt kéo. Tiến lên phía trước để điều chỉnh nếu cần.<br><br><font face=/font/big_bold.font>Tiếp tục lùi cho đến khi cảm thấy khớp nối chắc chắn.</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Bánh xe thứ năm đã được nối với chốt kéo, và bạn đã sẵn sàng hoàn tất việc nối với rơ-moóc.<br><br><font face=/font/big_bold.font>Kéo phanh tay.</font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Nhấn @@imv_nrm_attach@@ để kết nối rơ-moóc. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Hiện tại, rơ-moóc đã được nối chắc chắn với máy kéo, đường ống dẫn khí và điện đã được kết nối, và chân chống đã được nâng lên.<br><br><font face=/font/big_bold.font>Nhả phanh tay.</font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Bạn phải lùi xe vào chỗ đỗ ngay phía sau. Hãy nhớ rằng rơ-moóc sẽ quay ngược chiều với hướng bạn điều khiển xe đầu kéo. Một chút xoay vô lăng cũng có thể khiến rơ-moóc di chuyển đáng kể.<br><br><font face=/font/big_bold.font>Bắt đầu lùi rơ-moóc.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Đừng đánh lái quá mạnh, chỉ cần cố gắng giữ cho rơ-moóc thẳng hàng với vị trí đỗ. <br><br><font face=/font/big_bold.font>Tiếp tục tiến về phía chỗ đỗ xe.</font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
