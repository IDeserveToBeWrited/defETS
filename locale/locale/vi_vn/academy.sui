#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Gương chiếu hậu bên hông là một công cụ khác giúp bạn điều khiển xe tải một cách an toàn. Nó được đặt trên khung phía trên của cửa bên hành khách."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Lái xe thẳng về phía trước và từ từ rẽ sang phía ghế hành khách."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Những tấm ván gỗ này tượng trưng cho lề đường. Bạn cần đỗ xe sát bên cạnh. <br>Hãy quay xe về phía lề đường để đưa xe tải vào vị trí thuận lợi, thẳng hàng với chỗ đỗ xe."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Giảm tốc độ từ từ trước khi đến lề đường và hướng xe về phía chỗ đậu. Khi xe đi thẳng, bạn có thể dùng gương chiếu hậu để ước lượng khoảng cách đến lề đường."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Dừng xe tại chỗ đỗ và khóa xe tải lại."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Hãy nhìn qua cửa sổ bên phía hành khách. Bạn có thể thấy gương chiếu hậu ở đó.</font>@@aca_goal_tip@@ Bạn phải ở bên trong xe."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Gương chiếu hậu bên hông bao phủ khu vực phía hành khách mà người lái không thể nhìn thấy. Đây là một trong những điểm mù gây nhiều vấn đề nhất trên xe tải. Nếu góc nhìn của gương không phù hợp với bạn, bạn có thể điều chỉnh nó trong '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Xe tải vẫn chưa sẵn sàng di chuyển, có lẽ anh quên thứ gì đó?<br><br>Động cơ đã nổ chưa? Bạn đã nhả phanh tay chưa?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Phía trước bạn là một hàng ván gỗ tượng trưng cho lề đường. Cuối lề đường là một chỗ đậu xe. Bạn cần lái xe đến đó. <br><br><font face=/font/big_bold.font>Hãy tiếp tục khi bạn đã sẵn sàng.</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Quay xe về phía lề đường. Sử dụng gương chiếu hậu phía trước và hai bên để kiểm tra vị trí của xe so với lề đường, đồng thời đảm bảo không cán qua bất kỳ biển báo giao thông nào.<br><br><font face=/font/big_bold.font>Lái xe về phía lề đường và vào chỗ đậu xe.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Cố định xe tải và tắt máy.</font>@@aca_goal_tip@@ Bạn có thể sử dụng các thiết lập sẵn về giao diện nội thất để dễ dàng quan sát gương hơn. Kiểm tra màn hình Tùy chọn - '@@options_bindings_screen@@' - để xem và/hoặc thay đổi các điều khiển tương ứng."
#@}

