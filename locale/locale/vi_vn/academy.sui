	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Đỗ xe song song"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Trong tình huống này, chúng ta sẽ xem xét việc đỗ xe song song giữa hai chiếc xe tải khác."

#### 2_09 goal

