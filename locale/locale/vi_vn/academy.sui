#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Xe tải có một điểm mù lớn ở khu vực phía trước đầu kéo. Rất dễ mất tầm nhìn đối với người đi bộ hoặc thậm chí là ô tô trong khu vực này, vì vậy xe tải được trang bị gương chiếu hậu phía trước có thể nhìn thấy qua kính chắn gió."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Gương chiếu hậu phía trước được thiết kế để giúp người lái quan sát được điểm mù này.<br>Đây là một công cụ thiết yếu để đảm bảo bạn không va chạm với bất kỳ chướng ngại vật nào khi di chuyển trong không gian hẹp."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Bắt đầu lái xe, tiến về phía rào chắn phía trước, sau đó giảm tốc độ khi đến gần.<br>Quan sát gương chiếu hậu phía trước."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Dừng lại giữa vạch kẻ và chướng ngại vật."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Trong tình huống này, chúng ta sẽ học cách sử dụng gương chiếu hậu phía trước được hiển thị trong sơ đồ.<br><br><font face=/font/big_bold.font>Hãy nhìn qua phần trên của kính chắn gió để thấy nó.</font>@@aca_goal_tip@@ Bạn phải ở bên trong xe."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Gương đầu xe cho phép bạn quan sát điểm mù ở ngay phía trước xe tải. Nó giúp bạn lái xe an toàn và chính xác hơn.<br><br>Nếu chưa hài lòng với việc điều chỉnh này, hãy mở mục '@@adjust_link_t@@' (có thể truy cập thông qua menu tạm dừng) để điều chỉnh theo ý muốn của bạn.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_activate@@ để tiếp tục.</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Ngay phía trước xe tải có một điểm được đánh dấu. Bạn sẽ nhận thấy có một chướng ngại vật ở phía bên kia điểm đó; khi đến gần, hãy lái xe thật chậm và kiểm tra khoảng cách đến chướng ngại vật qua gương chiếu hậu phía trước.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Xe tải vẫn chưa sẵn sàng di chuyển, có lẽ anh quên thứ gì đó?<br><br>Động cơ đã nổ chưa? Bạn đã nhả phanh tay chưa?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Lái xe về phía chỗ đậu xe. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Dừng phần trước của xe tải giữa chướng ngại vật và vạch kẻ đường.</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

