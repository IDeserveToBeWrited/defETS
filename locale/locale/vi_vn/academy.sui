#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Lùi xe đỗ chéo"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Trong tình huống này, chúng ta sẽ tìm hiểu cách đỗ xe chéo khi lùi xe. Tình huống này có thể xảy ra ở các khu vực nghỉ ngơi, trạm dừng xe tải, và thậm chí cả ở các kho hàng. Thường thì không gian rất hạn chế vì bãi đỗ xe chật kín xe tải, nên việc đỗ xe càng trở nên khó khăn hơn do thiếu không gian."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Đánh lái rơ-moóc"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Đỗ xe chéo thoạt nhìn có vẻ dễ hơn, nhưng trên thực tế, nó thường khó hơn so với các thao tác \"lùi xe vào hẻm\" thông thường."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Lùi xe về phía chỗ đỗ. Giữ cho đầu kéo và rơ-moóc thẳng hàng trong lúc này."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Khi đến gần, hãy để rơ-moóc của bạn từ từ tiến lại gần những chiếc xe tải đang đỗ. Điều này sẽ giúp bạn dễ dàng xoay rơ-moóc vào đúng vị trí khi đến nơi."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Bắt đầu xoay rơ-moóc vào chỗ đỗ. Giữ rơ-moóc sát xe tải ở phía bên lái, vì bạn sẽ cần không gian ở phía bên kia."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Khi rơ-moóc đã vào đúng vị trí đỗ, hãy bắt đầu xoay máy kéo để theo sau rơ-moóc."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Đỗ xe vào khu vực quy định, khóa xe tải và tắt máy."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Đỗ xe tải vào khoảng trống phía sau bạn. Sử dụng cả hai gương chiếu hậu để điều khiển khi lùi xe.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Kiểm tra xung quanh, sau đó tiến về phía chỗ đậu xe.<br><br><font face=/font/big_bold.font>Bắt đầu lùi xe.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Bắt đầu di chuyển rơ-moóc về phía các xe tải bên cạnh. Khi đã sẵn sàng, hãy xoay rơ-moóc vào chỗ đỗ. Nhớ lưu ý đến độ văng của đuôi rơ-moóc.<br><br><font face=/font/big_bold.font>Xoay vào chỗ đỗ.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
