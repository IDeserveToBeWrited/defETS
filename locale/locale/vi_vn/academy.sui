	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Để rẽ, bạn có thể cần phải đi ra khỏi mặt đường nhựa một chút.<br><br><font face=/font/big_bold.font>Rẽ cẩn thận, sử dụng đủ không gian cần thiết.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Rời khỏi sa hình và lái xe vào chỗ đỗ xe.</font>"
