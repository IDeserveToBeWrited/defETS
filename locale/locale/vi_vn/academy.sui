#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Các thao tác điều khiển và chuyển động cơ bản"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Tìm hiểu các thao tác điều khiển cơ bản của xe và cách di chuyển xe tải tiến và lùi."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 1: @@aca_chapter_book1_1_title@@.<br><br>Bạn đã học được cách chuẩn bị xe trước khi khởi hành,<br>cách lái xe tiến, lùi cũng như cách sử dụng đèn và cần gạt nước.</font><br><br>\""

	key[]: "aca_chapter_book1_2_title"
	val[]: "Các kỹ năng điều khiển cơ bản"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Học cách lái, điều khiển và đỗ xe đầu kéo. Khám phá công dụng của từng loại gương và cách sử dụng chúng."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 2: @@aca_chapter_book1_2_title@@.<br><br>Bạn đã học được cách sử dụng hiệu quả từng gương trên xe tải, cách kiểm tra không gian xung quanh xe trước khi di chuyển, và thực hiện thành thạo các kỹ năng điều khiển từ cơ bản đến nâng cao.</font>\""

	key[]: "aca_chapter_book1_3_title"
	val[]: "Điều khiển xe kéo với rơ-moóc"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Học cách kết nối và điều khiển rơ-moóc trong các tình huống khác nhau."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 3: @@aca_chapter_book1_3_title@@.<br><br>Bạn đã học được cách kết nối và tháo rời rơ-moóc,<br>cảm nhận được trọng lượng cũng như kích thước của xe khi có rơ-moóc,<br>và lái xe cùng rơ-moóc trên các cung đường đầy thử thách.</font><br><br>\""

	key[]: "aca_chapter_book1_4_title"
	val[]: "Lùi xe với rơ-moóc"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Hãy học các thao tác mới để lùi xe và đỗ xe hiệu quả khi kéo rơ-moóc."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 4: @@aca_chapter_book1_4_title@@.<br><br>Bạn đã học được cách lùi xe khi có rơ-moóc<br>và các kỹ thuật đỗ xe khác nhau.</font><br><br>\""

	key[]: "aca_chapter_book1_5_title"
	val[]: "Bài kiểm tra cuối kỳ"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Hãy thể hiện kiến thức và kỹ năng của bạn để chứng minh giá trị bản thân với tư cách là một tài xế xe tải!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 5: @@aca_chapter_book1_5_title@@.<br><br>Bạn đã chứng minh rằng mình có đầy đủ các kỹ năng cần thiết<br>để lái xe, điều khiển và đỗ xe tải một cách chuyên nghiệp!</font><br><br>\""

	key[]: "aca_chapter_book2_0_title"
	val[]: "Khởi động động cơ"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Bạn đã hoàn thành khóa đào tạo: @@aca_chapter_book2_0_title@@.<br><br>Bạn đã nắm rõ các quy tắc và tính năng của phần Kỹ năng Lái xe Chuyên nghiệp.</font><br><br>\""

	key[]: "aca_chapter_book2_1_title"
	val[]: "Trở lại đường đua"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "\"@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 2: @@aca_chapter_book2_1_title@@.<br><br>Bạn đã khởi động cơ, kiểm tra các cấp số, điều khiển bánh xe quay đúng cách và kiểm tra hiệu suất phanh. Những chương tiếp theo sẽ đầy thử thách hơn đấy.</font><br><br>\""

	key[]: "aca_chapter_book2_2_title"
	val[]: "Bánh xe lăn bánh"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 3: @@aca_chapter_book2_2_title@@.<br><br>Bạn đã thành thạo các tình huống khó khăn và đa dạng. Bạn đã thể hiện kỹ năng và năng lực của mình.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Chặng Đường Về Đích"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Chúc mừng!<br>Bạn đã hoàn thành Chương 4: @@aca_chapter_book2_3_title@@.<br><br>Bạn đã xử lý nhiều tình huống khó khăn khi điều khiển, đỗ xe và lùi xe với rơ-moóc. Bạn đã chứng minh mình là một người lái xe lành nghề, có khả năng xử lý mọi tình huống khó khăn khi lái xe tải."

