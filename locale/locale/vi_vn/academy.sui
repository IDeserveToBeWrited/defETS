#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Chào mừng đến với @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Các tình huống sau đây thể hiện bước đầu tiên trên hành trình trở thành tài xế xe tải chuyên nghiệp của bạn."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Tại đây, bạn sẽ học mọi thứ từ các hệ thống và bộ điều khiển cơ bản của xe tải..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...thực hiện các thao tác phức tạp cả khi có và không có rơ-moóc."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Chúng tôi sẽ giúp bạn hình thành những thói quen giúp bạn xử lý an toàn nhiều tình huống khác nhau,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "và hướng dẫn bạn cách sử dụng không gian một cách khôn ngoan để điều khiển xe tải hiệu quả."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Bằng cách hoàn thành tất cả các tình huống và vượt qua kỳ thi cuối cùng,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "bạn sẽ sẵn sàng chinh phục những con đường châu Âu và tìm kiếm những thử thách mới."

#@}

