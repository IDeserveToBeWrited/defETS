#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Trong tình huống này, chúng ta sẽ cùng tìm hiểu cách quay đầu xe trong không gian hẹp bằng thao tác lùi xe từ phía khuất tầm nhìn. Kỹ năng này sẽ rất hữu ích khi bạn không thể quay đầu xe hoặc lùi xe về phía bên lái."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Các vạch kẻ đường sẽ giúp bạn định hướng trong suốt khóa huấn luyện."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Hãy quay xe rộng để đảm bảo rơ-moóc của bạn không chạm vào các xe tải đang đỗ."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Khi ra khỏi khúc cua, hãy cân nhắc cách bạn sẽ điều chỉnh xe tải để thực hiện thao tác lùi xe."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Sẽ dễ hơn nếu bạn đặt xe tải nghiêng một góc hướng về phía chỗ đỗ xe trống bên phía hành khách, nơi bạn sẽ lùi xe vào."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Nên tránh lùi xe ở vị trí khuất tầm nhìn nếu có thể vì tầm nhìn sẽ bị hạn chế đáng kể. Tuy nhiên, đôi khi bạn sẽ không còn lựa chọn nào khác ngoài việc phải làm vậy."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Hãy xoay vô lăng trước khi lùi xe. Điều này sẽ giúp bạn đưa rơ-moóc đến vị trí mong muốn ngay lập tức, rất hữu ích trong những tình huống chật hẹp."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Khi rơ-moóc đã vào đúng vị trí, hãy đặt đầu kéo phía trước rơ-moóc và chỉnh thẳng xe."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Dừng lại khi bạn đã đi thẳng và có đủ không gian để tiếp tục tiến lên. Bắt đầu quay trở lại theo hướng bạn vừa đi vào."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Hãy đi theo các vạch kẻ đường để ra khỏi khu vực huấn luyện."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Lái xe qua khúc cua phía trước và tiếp tục đi vào khu vực được chỉ định."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Dừng lại."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Kéo phanh tay xe tải và tắt động cơ."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Phía trước mặt bạn là một khu vực huấn luyện mô phỏng bãi đậu xe của một công ty vận chuyển. Nhiệm vụ của bạn là đi vào đó và quay đầu xe tải để đi ra. Hãy tận dụng tối đa không gian xung quanh.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Hãy tiến về phía khóa đào tạo.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Rẽ qua góc cua và tiếp tục đi hết sân tập. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Đi theo vạch kẻ đường đến rào chắn ở cuối đoạn đường. Đỗ xe hơi nghiêng một chút sao cho rơ-moóc hướng về phía chỗ đỗ xe trống bên phía hành khách.<br><br><font face=/font/big_bold.font>Tiếp tục đi thẳng.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Khi xe bị mất cảnh báo, tầm nhìn của bạn về những gì đang diễn ra xung quanh sẽ bị hạn chế hơn nhiều. Hãy đi chậm, sử dụng gương chiếu hậu và luôn cẩn thận.<br><br><font face=/font/big_bold.font>Bắt đầu lùi xe và xoay rơ-moóc vào chỗ đỗ xe trống.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Như vậy là đủ rồi. Giờ bạn có thể tiến về phía trước và rời khỏi sân tập theo hướng bạn vừa đến.<br><br><font face=/font/big_bold.font>Hãy bắt đầu đi về phía lối ra.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Rời khỏi sân tập. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Hãy đi theo biển chỉ dẫn đường đến chỗ đỗ xe cuối cùng.<br><br><font face=/font/big_bold.font>Tiếp tục đi vào khu vực được chỉ định.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Thao tác lùi xe lệch làn"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Trong kịch bản này, bạn sẽ được giao nhiệm vụ lùi xe vào một vị trí đỗ không nằm ngay phía sau xe mình. Không gian để xoay xở rất hạn chế, vì vậy bạn phải sử dụng diện tích của mình một cách khôn ngoan."

#### 3_13 goal

