#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Trong tình huống này, bạn sẽ phải lùi xe vào chỗ đỗ xe phía sau bên phía người lái."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Có một vài lời khuyên cần nhớ sẽ giúp ích rất nhiều khi lùi xe moóc. <br>Đầu tiên là xe moóc sẽ luôn có xu hướng quay ngược hướng với hướng bạn lái xe đầu kéo."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Thứ hai là bạn có thể đoán được hướng đi của rơ-moóc bằng cách quan sát trục của xe tải và rơ-moóc."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Thứ ba, những nỗ lực nhỏ sẽ giúp bạn đạt được mục tiêu, không cần phải làm việc quá sức."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Bắt đầu xoay nhẹ máy kéo ra khỏi chỗ đỗ, và rơ-moóc sẽ bắt đầu hướng về phía đó."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Hãy bám sát theo đường đi của xe moóc, điều chỉnh hướng đi khi cần để giữ cho xe đi đúng hướng."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Hãy quan sát bánh xe rơ-moóc và bánh sau của máy kéo. Chúng sẽ cho bạn biết rơ-moóc đang hướng về đâu và máy kéo đang đẩy nó đi về hướng nào."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Mẹo thứ tư là luôn dễ dàng hơn khi xoay rơ-moóc gấp hơn một chút so với việc cố gắng chỉnh thẳng nó từ trạng thái gập khúc. Hãy nhắm vào phía ngoài của điểm cần chỉnh cho đến khi bạn đến gần hơn, sau đó bạn có thể xoay gấp hơn một chút để căn chỉnh rơ-moóc."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Khi rơ-moóc tiến vào chỗ đỗ, hãy đưa đầu kéo vào phía trước rơ-moóc. Cố gắng tránh điều chỉnh quá nhiều bên trong chỗ đỗ."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Lùi xe giữa các rào chắn, kiểm tra cả hai phía khi di chuyển."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Kéo phanh tay xe tải và tắt động cơ."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Hãy nhớ những lời khuyên này khi lùi xe vào khúc cua với rơ-moóc:<br><br>— Rơ-moóc quay ngược hướng với hướng bạn lái xe đầu kéo<br><br>— Quan sát bánh xe rơ-moóc để xem nó đang hướng về đâu<br><br>— Quan sát bánh sau của xe đầu kéo để xem nó đang đẩy rơ-moóc về đâu<br><br>— Hãy để rơ-moóc tự làm việc, đừng đánh lái quá mức<br><br>— Luôn dễ dàng hơn khi đánh lái rơ-moóc gấp hơn là giữ thẳng nó<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Hãy nhìn phía sau để xác định hướng cần đến. Luôn kiểm tra xung quanh trước khi bắt đầu lùi xe.<br><br><font face=/font/big_bold.font>Bắt đầu lùi xe về phía chỗ đỗ.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Bắt đầu xoay rơ-moóc về phía chỗ đậu xe và đi vào.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Dừng xe tại vị trí quy định.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Lùi xe vào chỗ đậu xe chật hẹp"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Trong tình huống này, bạn sẽ được giao nhiệm vụ lùi xe moóc vào chỗ đậu xe trong một bãi đỗ xe đông đúc."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Đánh lái rơ-moóc"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Đây là một bãi đỗ xe điển hình dành cho xe tải. Các tài xế xe tải sẽ gặp phải tình huống đỗ xe như thế này gần như hàng ngày trong sự nghiệp của họ.<br>Việc đỗ xe ở đây đòi hỏi phải thực hiện thao tác \"đỗ xe trong hẻm\"."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Đây là một thao tác tương tự như tình huống trước, nhưng bạn sẽ có ít không gian hơn để hoạt động, vì vậy bạn cần lên kế hoạch cho các bước đi của mình một cách phù hợp và cẩn thận để không va chạm với bất cứ thứ gì."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Vì không gian hẹp hơn, việc căn thời gian càng quan trọng. Quay rơ-moóc đúng lúc và quan sát bánh xe của đầu kéo và rơ-moóc để xem nó sẽ đi về đâu. Luôn chú ý đến độ văng của đuôi xe và nhớ đừng để xe bị gập khúc – hãy tiếp tục đẩy rơ-moóc."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Cố gắng giữ xe sát xe tải ở phía bên lái, điều này sẽ tạo không gian cho rơ-moóc xoay chuyển và bạn sẽ bớt lo lắng hơn về xe tải ở phía bên phụ."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Khi rơ-moóc đã vào đúng vị trí, hãy đưa đầu kéo đến phía trước. Tốt hơn hết là nên làm điều này sớm hơn một chút so với bản năng ban đầu của bạn. Bạn luôn có thể điều chỉnh lại khi lùi xe đến vị trí cuối cùng."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Điều chỉnh xe đầu kéo và rơ-moóc thẳng hàng và dừng lại ở khu vực quy định."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Kéo phanh tay xe tải và tắt động cơ."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Bây giờ chúng ta sẽ thử quay đầu xe moóc trong một khu vực nhỏ hơn nhiều bằng thao tác \"lùi vào ngõ hẹp\". <br><br><font face=/font/big_bold.font>Chuẩn bị xuất phát.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Quan sát xung quanh và tìm chỗ đỗ xe phía sau bạn. <br><br><font face=/font/big_bold.font>Bắt đầu lùi xe về phía chỗ đỗ.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Đưa xe moóc vào chỗ đỗ xe.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
