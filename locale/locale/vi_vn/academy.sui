	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Vòng xuyến rất phổ biến trên các đường phố ở châu Âu, vì vậy điều quan trọng là phải biết cách đi qua chúng."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Hãy giữ xe ở làn ngoài cùng khi đến gần vòng xuyến. Điều này sẽ giúp rơ-moóc của bạn dễ dàng đi vào từ phía trong khúc cua đầu tiên."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Khi vào vòng xuyến, hãy lái xe hướng về trung tâm. Sau khi vào bên trong, bạn phải đi về phía ngoài. Điều này nhằm giữ cho rơ-moóc của bạn không nằm ở trung tâm vòng xuyến."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Hãy chú ý quan sát gương chiếu hậu để đảm bảo rơ-moóc không tiến quá gần các rào chắn bên trong."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Rời khỏi vòng xuyến khá dễ dàng vì rơ-moóc của bạn đã được đặt ở vị trí cách xa lối ra phía trong. Khi ra khỏi vòng xuyến, hãy đánh lái rộng và rơ-moóc sẽ đi theo một cách thuận lợi."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Đỗ xe vào khu vực quy định và khóa xe tải lại."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Phía trước bạn có một vòng xuyến được thiết kế để bạn lái xe vào. <br><br><font face=/font/big_bold.font>Từ từ tiến đến vòng xuyến.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Khi vào vòng xuyến, hãy rẽ rộng để rơ-moóc của bạn có thể vào phía sau mà không gặp vấn đề gì. <br><br><font face=/font/big_bold.font>Vào vòng xuyến.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Lái xe ra phía ngoài vòng xuyến. Bạn cần giữ xe tải càng xa trung tâm vòng xuyến càng tốt để tránh cho rơ-moóc va vào dải phân cách ở giữa. <br><br><font face=/font/big_bold.font>Tiếp tục đi qua vòng xuyến.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Hãy giữ khoảng cách sát với các cọc tiêu bên ngoài. <br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Rời khỏi vòng xoay.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Hãy tiến đến chỗ đỗ xe phía trước.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Dừng xe tại khu vực quy định.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Kéo phanh tay xe tải và tắt động cơ.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Di chuyển trong không gian chật hẹp"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Trong tình huống cuối cùng, bạn sẽ được giao nhiệm vụ quay đầu xe tải trong một không gian chật hẹp. Điều này đòi hỏi bạn phải lùi xe về phía khuất tầm nhìn trong khu vực có không gian điều khiển hạn chế, do đó cần phải chú ý đến môi trường xung quanh và sử dụng không gian một cách thông minh."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Lái xe vào sân tập"

	key[]: "aca_goal_book1_3_12_check2"
