#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Khóa học phía trước sẽ giúp bạn làm quen với việc thực hiện các cú xoay kép qua các khúc cua 90 độ với độ khó khác nhau."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Những khúc cua đầu tiên khá rộng, có nhiều không gian. Hãy tận dụng điều này để cảm nhận các xe kéo phía sau khi bạn rẽ."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Từ đây trở đi, các khúc cua sẽ hẹp hơn và đòi hỏi kỹ thuật cao hơn. Hãy tiếp cận chúng một cách chậm rãi và đảm bảo bạn lái xe vào sâu trong các khúc cua để rơ-moóc của bạn có đủ không gian để bám đường."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Đây là một trong những khúc cua hẹp nhất trên đường đua. Việc tận dụng khoảng không gian nhỏ bên phải có thể giúp bạn đưa xe kéo của mình vượt qua những cọc tiêu khó chịu bên trong."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Bạn luôn phải nghĩ đến lượt đi tiếp theo - khi kết thúc một lượt chơi, hãy lên kế hoạch chuẩn bị cho lượt tiếp theo."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Luôn chú ý đến rơ-moóc của bạn cho đến khi chúng vượt qua mọi chướng ngại vật."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Tiếp tục tiến về phía trước đến khúc cua đầu tiên."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Hãy chú ý quan sát gương chiếu hậu khi lái xe để hiểu rõ cách các rơ-moóc phía sau di chuyển."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Hãy giữ khoảng cách rộng trước mỗi khúc cua, điều này rất quan trọng để bạn có đủ không gian đưa rơ-moóc vào cua."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Việc chuẩn bị cho vài khúc cua tiếp theo rất quan trọng, vì sau đó là một khúc cua rất hẹp. Một sai lầm ngay từ đầu có thể khiến bạn phải trả giá đắt hơn nữa về sau. <br><br>Hãy chậm rãi và cẩn thận, và chú ý đến môi trường xung quanh."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Khúc cua này cực kỳ hẹp, và dẫn thẳng đến một khúc cua hẹp khác. Bạn không chỉ cần cân nhắc cách vào cua mà còn cả cách thoát cua và chuẩn bị cho khúc cua tiếp theo."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Tiếp tục lái xe qua những khúc cua cuối cùng hướng đến khu vực đã được chỉ định."

