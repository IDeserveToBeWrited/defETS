	val[]: "Không gian ở đây có hạn, vì vậy hãy cẩn thận và dành thời gian."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Hãy nhớ cẩn thận và đừng vội vàng. Không sao nếu bạn không làm được ngay lần đầu, điều quan trọng là không làm hỏng xe tải hoặc gây nguy hiểm cho những người xung quanh. <font face=/font/big_bold.font><br><br>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Hãy chuyển sang phần đầu tiên của bài kiểm tra.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Nhiệm vụ đầu tiên của bạn là thực hiện thao tác đỗ xe lệch. Vị trí cần lùi xe moóc nằm bên trái bạn.<br><br><font face=/font/big_bold.font>Thực hiện thao tác đỗ xe lệch.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Nhiệm vụ tiếp theo là lùi xe vào một hàng xe tải đang đỗ. Hãy cẩn thận đừng va vào các xe tải khác!<br><br><font face=/font/big_bold.font>Thực hiện thao tác đỗ xe chéo.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Tiếp tục đi qua bãi đậu xe. Cẩn thận với những tình huống bất ngờ.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Bây giờ chúng ta hãy thử đỗ xe song song giữa hai chiếc xe tải bên lề đường phía trước.<br><br><font face=/font/big_bold.font>Thực hiện thao tác đỗ xe song song.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Một thao tác đỗ xe cuối cùng bên trái! Bạn có thể chọn cách tiếp cận nào tùy thích.<br><br><font face=/font/big_bold.font>Lùi xe vào khu vực được chỉ định.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Gần xong rồi. Rời khỏi khu vực thử nghiệm và đỗ xe tải.<br><br><font face=/font/big_bold.font>Đi ra khỏi khu vực thử nghiệm về phía bên trái.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Bạn có thể đỗ xe tải bên phải cùng với những xe khác.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Đỗ xe song song với rơ-moóc"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "Trong tình huống này, chúng ta sẽ xem xét việc đỗ xe song song khi có gắn rơ-moóc."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Dừng xe trong khu vực được đánh dấu"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Đỗ xe song song với rơ-moóc là một kỹ năng cần thiết cho tất cả các tài xế xe tải.<br>Cho dù là đỗ xe trên đường phố trong thành phố lớn hay dừng chân tại khu vực nghỉ ngơi ở vùng nông thôn, đây là điều mà mọi tài xế xe tải nên biết cách thực hiện."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Khi đi ngang qua chỗ đậu xe, hãy quan sát kỹ để đảm bảo có đủ chỗ cho máy kéo và rơ-moóc. Ở đây, chúng tôi đã đảm bảo bạn có đủ không gian."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Hãy đứng thẳng hàng với chiếc xe tải phía trước chỗ đỗ xe. Đừng đỗ quá sát, giữ khoảng cách nhất định để có đủ không gian làm việc."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Đánh lái gấp ra khỏi chỗ đỗ và bắt đầu lùi xe. Mục đích là để rơ-moóc nhanh chóng vào đúng chỗ đỗ."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Khi xe moóc đã được định hướng đúng vào vị trí, bạn có thể bắt đầu đi theo nó vào."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Bắt đầu điều khiển rơ-moóc rời khỏi lề đường trước khi bánh xe rơ-moóc phía người lái vào đúng vị trí."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Duỗi thẳng đầu kéo và rơ-moóc, sau đó căn chỉnh xe vào giữa chỗ đỗ.<br> Đỗ xe, tắt máy và cố định xe tải."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Bạn có thể nhìn thấy chỗ đỗ xe phía trước, giữa các xe tải khác. Khi đỗ xe, hãy nhớ kiểm tra gương chiếu hậu và giữ khoảng cách an toàn giữa xe tải và các vật cản xung quanh.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Di chuyển qua bãi đỗ xe để tìm chỗ đậu xe của bạn.<br><br><font face=/font/big_bold.font>Lái xe tiến về phía trước.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Lái xe qua vị trí đỗ xe mong muốn vào khu vực được đánh dấu. Từ đây, bạn có thể bắt đầu thao tác lùi xe.<br><br><font face=/font/big_bold.font>Dừng xe tại vị trí được đánh dấu.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Quay máy kéo ra khỏi vị trí để bắt đầu quay rơ-moóc vào đó. Đừng quay quá gấp, nếu không bạn sẽ lao vào lề đường. <br><br><font face=/font/big_bold.font>Bắt đầu lùi xe.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Căn chỉnh rơ-moóc sao cho thẳng hàng với vị trí đỗ. Nếu cần, hãy di chuyển tiến hoặc lùi đồng thời điều chỉnh tay lái để thay đổi vị trí.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Chúc mừng, bạn đã hoàn thành xuất sắc các bài kiểm tra về Kỹ năng lái xe tải cơ bản và nắm vững tất cả các kỹ năng cần thiết để điều khiển xe tải một cách an toàn."

	key[]: "aca_msg_book1_outro02"
	val[]: "Đây là bước đầu tiên trên hành trình hiện thực hóa ước mơ trở thành một tài xế xe tải chuyên nghiệp của bạn."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Giờ đây bạn đã sẵn sàng lên đường khám phá những con đường châu Âu và đối mặt với những thử thách đầu tiên..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...nhưng cuộc phiêu lưu chỉ mới bắt đầu."
#@}


