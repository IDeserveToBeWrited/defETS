#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Trước khi bạn lái xe"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Trong tình huống đầu tiên, chúng ta sẽ tìm hiểu những điều cơ bản trong khoang lái. Việc điều chỉnh ghế ngồi, vô lăng và gương chiếu hậu đúng cách rất quan trọng, vì tầm nhìn tốt là yếu tố cần thiết để xử lý các tình huống căng thẳng hoặc nguy hiểm.<br><br>Chúng ta sẽ xem xét từng nút điều khiển để điều chỉnh các bộ phận này."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Điều chỉnh ghế và gương"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Kiểm tra gương và tầm nhìn"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Chào mừng đến với bài học đầu tiên!<br>Chúng ta hãy bắt đầu bằng việc học cách chuẩn bị xe tải để lên đường."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Điều tối quan trọng là phải đảm bảo việc lái xe của bạn an toàn, chuyên nghiệp và được kiểm soát mọi lúc.<br>Việc điều chỉnh đúng vị trí ghế ngồi, vô lăng và gương chiếu hậu sẽ giúp bạn đạt được điều này."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Ở mỗi bên của xe tải đều có một số phương tiện khác.<br>Họ sẽ giúp hướng dẫn bạn điều chỉnh gương chiếu hậu cho đúng cách."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Hãy dành thời gian để điều chỉnh mọi thứ theo ý thích của bạn vì các cài đặt<br>này sẽ có tác động đáng kể đến khả năng điều khiển xe tải của bạn."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Điều chỉnh ghế và vô lăng"

	key[]: "adj_tut_title_1"
	val[]: "Điều chỉnh gương chiếu hậu chính"

	key[]: "adj_tut_title_2"
	val[]: "Điều chỉnh gương lồi"

	key[]: "adj_tut_title_3"
	val[]: "Kiểm tra tầm nhìn và điều chỉnh gương lần cuối"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "Nhấn vào @@imv_nrm_adjuster@@ hoặc truy cập mục này thông qua phần điều chỉnh xe trong menu tạm dừng"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "Bạn có thể truy cập chức năng này thông qua phần điều chỉnh xe trong menu tạm dừng"

	key[]: "adj_tut_open_adj"
	val[]: "Để hiển thị '@@adjust_link_t@@' trong khi chơi game, hãy sử dụng $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Trước tiên, hãy điều chỉnh ghế lái và vô lăng.<br><br><font face=/font/big_bold.font>Mở '@@adj_seats@@' để tiếp tục.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Mở @@adj_mirrors@@ để cấu hình cài đặt gương.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Khi lần đầu tiên lên xe tải, điều quan trọng là phải điều chỉnh ghế ngồi, vô lăng và gương chiếu hậu sao cho phù hợp với sở thích của bạn.<br><br>Vị trí ngồi đúng sau vô lăng rất quan trọng để có tầm nhìn tốt. Tất cả các nút điều khiển phải nằm trong tầm tay, và người lái cần có tầm nhìn rõ ràng phía trước, hai bên và trong gương chiếu hậu.<br><br><font face=/font/big_bold.font>Để hiển thị menu cấu hình, hãy nhấn $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Điều chỉnh ghế ngồi sao cho bạn có tầm nhìn rõ ràng xung quanh cũng như gương chiếu hậu, và có thể dễ dàng với tới tất cả các nút điều khiển.<br><br>Điều chỉnh vô lăng sao cho ở vị trí thoải mái và không che khuất tầm nhìn của bạn đối với bất kỳ bảng đồng hồ nào.<br><br><font face=/font/big_bold.font>Khi bạn đã hài lòng với các điều chỉnh của mình, hãy nhấn @@imv_nrm_back@@ để quay lại menu cấu hình. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Xe tải có nhiều điểm mù lớn, vì vậy chúng được trang bị nhiều gương chiếu hậu bên ngoài để giúp người lái quan sát được nhiều nhất có thể. <br><br>Điều chỉnh gương chiếu hậu đúng cách sẽ giúp bạn có tầm nhìn tốt nhất về môi trường xung quanh.<br><br><font face=/font/big_bold.font>Mở '@@adj_mirrors@@' để tiếp tục.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Gương chiếu hậu chính bao phủ không gian dọc theo hai bên của xe tải và rơ-moóc.<br><br>Để điều chỉnh vị trí chính xác của gương chiếu hậu chính, hãy sử dụng các xe ở hai bên xe làm tham chiếu.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_selectfcs@@ để tiếp tục.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Gương chiếu hậu chính là công cụ chủ yếu giúp bạn quan sát những gì đang diễn ra bên cạnh và phía sau xe. Bạn nên có tầm nhìn tốt về chiếc xe bên cạnh, nhưng hãy đảm bảo vẫn nhìn thấy một phần rơ-moóc trong gương để giúp bạn đánh giá chính xác vị trí của các chướng ngại vật xung quanh."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Sau khi bạn đã hài lòng với việc điều chỉnh, hãy chuyển sang điều chỉnh gương chiếu hậu chính bên phía hành khách."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Một lần nữa, bạn cần quan sát rõ xe bên cạnh đồng thời vẫn để lộ một phần rơ-moóc trong gương chiếu hậu."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Sau khi bạn đã hài lòng với việc điều chỉnh gương, hãy chuyển sang gương lồi bên phía người lái."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Gương lồi cung cấp trường nhìn rộng hơn, cho phép bạn nhìn thấy nhiều hơn những gì đang diễn ra bên cạnh bạn.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_selectfcs@@ để tiếp tục.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Lý tưởng nhất là bạn nên nhìn thấy cả xe hơi và xe tải đang đỗ bên đường, đồng thời vẫn để lộ một phần nhỏ xe tải của mình."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Sau khi bạn đã hài lòng với việc điều chỉnh gương, hãy chuyển sang gương lồi bên phía ghế phụ."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Một lần nữa, bạn nên quan sát cả xe hơi và xe tải đang đỗ bên đường, đồng thời vẫn để lộ một phần nhỏ xe tải của mình."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Sau khi bạn đã hài lòng với việc điều chỉnh gương, hãy nhấn @@imv_nrm_back@@ để đóng cài đặt gương."

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Nhấn @@imv_nrm_back@@ để quay lại menu cấu hình.</font>"

	key[]: "adj_tut_close_adj"
	val[]: "Tuyệt vời, với ghế ngồi và gương chiếu hậu đã được điều chỉnh theo ý thích của bạn, giờ đây bạn đã tiến gần hơn một bước đến việc lên đường!<br><br><font face=/font/big_bold.font>Đóng menu cấu hình bằng lệnh @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Hãy nhìn xung quanh một lần nữa để đảm bảo bạn hài lòng với tầm nhìn từ cabin và gương chiếu hậu cung cấp cho bạn tầm nhìn tốt về những gì đang xảy ra xung quanh xe tải.<br><br>Nếu có gì đó không vừa ý, bạn có thể điều chỉnh lại gương chiếu hậu trong menu cấu hình '@@adjust_link_t@@'. <br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_activate@@ để kết thúc kịch bản đầu tiên.</font> @@aca_goal_tip@@ Để hiển thị hoặc ẩn gương chiếu hậu trên màn hình, bạn có thể vào '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' trong menu tạm dừng. Gương chiếu hậu trên màn hình giúp bạn dễ dàng quan sát phía hành khách hơn."
#@}

