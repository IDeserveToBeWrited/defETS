	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Lái xe thẳng đến cuối bãi đậu xe rồi quay đầu xe."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Nhớ rẽ rộng."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Tiếp tục tiến về phía trước cho đến khi bạn cảm thấy có đủ không gian để xoay sở, sau đó bắt đầu lùi xe."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Lùi vào vị trí đỗ nếu bạn thấy đủ không gian để điều động."

