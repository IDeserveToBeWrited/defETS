#+ Book 2 long_reverse
#@{
#### common
	key[]: "aca_scenario_book2_long_reverse_title"
	val[]: "Lùi xe đường dài"

	key[]: "aca_scenario_book2_long_reverse_desc"
	val[]: "Trong kịch bản này, bạn được giao nhiệm vụ lùi xe tới, sau đó lùi dọc xuống một con hẻm dài. Thử thách này sẽ kiểm tra khả năng kiểm soát rơ-moóc của bạn trong các thao tác lùi xe trên quãng đường dài."

#### intro text

	key[]: "aca_scenario_book2_long_reverse_cutscene1"
	val[]: "Trong bài tập này, bạn sẽ thực hành lùi xe thẳng.<br><br>Hãy căn chỉnh xe tải của bạn với lối đi được tạo bởi các hình nón và lùi thẳng đến cuối.<br><br>Hãy nhớ rằng, ngay cả một sự điều chỉnh tay lái nhỏ cũng có thể làm thay đổi đáng kể hướng đi của rơ-moóc."

#@}


#+ Book 2 wedge
