#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Việc điều khiển xe đầu kéo hai rơ-moóc qua vòng xuyến phức tạp hơn một chút so với xe đầu kéo một rơ-moóc."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Bạn phải lái xe vào đủ sâu để cả hai rơ-moóc đều có thể vào được, nhưng sau đó phải lái ra phía ngoài để giữ cho các rơ-moóc không chạm vào trung tâm."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "Không sao nếu cả hai rơ-moóc không vừa trong một làn đường - trên thực tế, thậm chí có thể tốt hơn nếu chúng chiếm cả hai làn đường để người lái xe khác không cố gắng vượt bạn."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Lái xe sang phía xa của làn đường ra để đảm bảo cả hai rơ-moóc đều không có nguy cơ va chạm."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Tiếp tục đi đến vòng xuyến thứ hai."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Vòng xuyến này chỉ có một làn đường, vì vậy hãy đi chậm và cẩn thận."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Hãy tận dụng toàn bộ không gian bạn có - việc cắt cua ở đây sẽ chỉ khiến mọi thứ trở nên khó khăn hơn thôi."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Hãy đi ra theo lối thoát và tiến về phía khu vực đậu xe."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Đỗ xe và khóa xe tải lại."

