#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Trong tình huống này, chúng ta sẽ lái thử chiếc xe đầu kéo một đoạn ngắn để xem bạn điều khiển nó như thế nào với những kỹ năng mới học được."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Trên đường đua có nhiều loại và sự kết hợp khác nhau của các khúc cua. Đây không phải là cuộc đua và cũng không phải là vấn đề thời gian. Hãy kiên nhẫn và điều chỉnh tốc độ lái xe của bạn cho phù hợp với các khúc cua và chướng ngại vật mà bạn gặp phải."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Ban đầu, đường đua khá nhẹ nhàng và dễ đi, nhưng càng về sau, các khúc cua sẽ càng trở nên phức tạp hơn."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Hãy chú ý đến tốc độ của bạn; rất dễ tăng tốc quá nhanh và sau đó phán đoán sai khi vào cua."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Lối ra khỏi đường đua là một khúc cua tay áo rất hẹp. Hãy đi chậm và tận dụng tối đa không gian có sẵn."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Đỗ xe giữa các rào chắn và khóa xe tải lại."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Để hoàn thành tình huống này thành công, bạn không được va chạm, lái xe ra khỏi đường đua hoặc đâm vào bất kỳ cọc tiêu giao thông nào.<br><br><font face=/font/big_bold.font>Chuẩn bị xuất phát.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Tiếp tục đi thẳng vào khúc cua gấp bên phải để vào đường đua.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Lái xe qua khúc cua với tốc độ ổn định.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Bạn đang tiến đến một đoạn đường quanh co phức tạp hơn.<br><br><font face=/font/big_bold.font>Hãy điều chỉnh tốc độ cho phù hợp và tiếp tục.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Tiếp tục đi về phía các khúc cua tiếp theo.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Sẽ có một vài khúc cua nhẹ nhàng phía trước. Giữ tốc độ ổn định.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Đoạn rẽ ra khỏi đường đua là một khúc cua gấp hình chữ U. Giảm tốc độ và giữ làn đường phía ngoài trước khi vào cua. Nhớ sử dụng gương chiếu hậu!<br><br><font face=/font/big_bold.font>Rẽ ra khỏi đường đua.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Phía trước bạn có một chỗ đậu xe nằm giữa hai rào chắn.<br><br><font face=/font/big_bold.font>Hãy tiến về phía chỗ đậu xe.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

