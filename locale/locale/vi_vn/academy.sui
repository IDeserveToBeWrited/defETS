	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Bắt đầu lùi xe từ từ. Hãy nhớ chỉ lùi với những thao tác nhỏ, không cần phải lùi đột ngột ngay lập tức.<br><br>Cố gắng lùi thẳng hoặc đưa rơ-moóc về phía người lái."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Hãy kiên nhẫn và đừng nản lòng. <br><br>Mọi bậc thầy đều từng là người mới bắt đầu."

