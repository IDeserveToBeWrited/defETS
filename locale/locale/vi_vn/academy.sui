#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Chào mừng đến với phần đầu tiên của bài kiểm tra cuối kỳ. Tại đây, chúng ta sẽ xem bạn đã học lái xe tải tốt đến mức nào sau thời gian học tại Học viện."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Đầu tiên, bạn sẽ gắn rơ-moóc vào xe. Sau khi nối xong, bạn sẽ lái xe tải vòng quanh toàn bộ khu vực thử nghiệm."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Đoạn đường đầu tiên dẫn từ bãi đỗ xe nhỏ đến đường thử phía đông."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Sa hình bao gồm các đoạn đường đầy thử thách nằm giữa các rào chắn."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Một phần đáng kể của tuyến đường đi qua khu vực thử nghiệm phía đông."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Chúng tôi sẽ kiểm tra khả năng điều khiển xe tải của bạn trong các tình huống khác nhau."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Bạn sẽ phải điều khiển chiếc xe tải vượt qua một số khúc cua gấp."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Bạn sẽ lái xe đi qua đoạn đường nối giữa các sân tập."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Phần cuối cùng là lái xe qua đường nhỏ."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Đường có nhiều đoạn ngoằn ngoèo và khúc cua gấp."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Để hoàn thành bài kiểm tra, bạn cần phải đỗ xe chính xác."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Không cần phải lo lắng, bạn đã học được tất cả những gì cần thiết để vượt qua kỳ thi rồi.<br><br>Chúc may mắn!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Phía trước bạn là rơ-moóc.<br><br><font face=/font/big_bold.font>Lái xe về phía rơ-moóc.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Căn chỉnh đầu kéo với rơ-moóc.<br><br><font face=/font/big_bold.font>Lùi xe và nối vào chốt kéo.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Hãm phanh tay xe tải.</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Nhấn @@imv_nrm_attach@@<font face=/font/big_bold.font> để kết nối rơ-moóc. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Rơ-moóc đã được nối vào và xe tải đã sẵn sàng để chạy.<br><br><font face=/font/big_bold.font>Nhả phanh tay.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Bắt đầu lái xe về phía lối ra của bãi đậu xe.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Hãy tuân theo vạch kẻ đường và chú ý các rào chắn.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Phần tiếp theo sẽ khó khăn hơn.<br><br><font face=/font/big_bold.font>Hãy cẩn thận vượt qua các chướng ngại vật.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Phần này sẽ kiểm tra kỹ năng điều khiển xe moóc của bạn khi di chuyển qua các khúc cua khác nhau.<br><br><font face=/font/big_bold.font>Rẽ vào đường đua.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Lái xe qua lối đi này.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Đi thẳng</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Hãy cẩn thận khi vào cua.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Bạn đang đi vào đoạn đường phức tạp hơn. Hãy lái xe cẩn thận.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe xuống dốc.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Rẽ trái gấp.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Hãy rời khỏi sa hình</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Bạn đang đi vào đoạn đường dễ hơn.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe xuống dốc.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Hãy tiếp tục lái xe trên đường.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Phía trước là chỗ rẽ sang đường tiếp theo.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Rẽ phải.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Tiếp tục lái xe theo đúng lộ trình.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Phía trước còn nhiều khúc cua gấp.<br><br><font face=/font/big_bold.font>Hãy điều chỉnh tốc độ cho phù hợp.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Rẽ trái.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_19_check18"
