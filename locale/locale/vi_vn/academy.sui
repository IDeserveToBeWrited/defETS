#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Trong tình huống này, chúng ta sẽ thực hiện thao tác lùi xe để đỗ sát lề đường."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Lùi xe về phía lề đường.<br>Bạn phải chú ý đến xung quanh khi lùi xe, vì vậy hãy sử dụng gương chiếu hậu."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Khi đến gần hơn, bạn có thể bắt đầu căn chỉnh xe tải sao cho thẳng hàng với chỗ đỗ xe. Quan sát cả hai bên xe tải khi lùi xe."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Dừng xe tại chỗ đỗ và khóa xe tải lại."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Chỗ đỗ xe nằm phía sau bạn, bên phía hành khách. Sử dụng gương chiếu hậu để điều khiển xe tiến đến chỗ đỗ.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Hãy nhớ sử dụng gương chiếu hậu để kiểm tra xung quanh trước khi di chuyển xe tải.<br><br><font face=/font/big_bold.font>Bắt đầu lùi xe về phía lề đường.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Tiếp tục quan sát xung quanh khi lùi xe vào chỗ đỗ.<br><br><font face=/font/big_bold.font>Dừng xe tại vị trí quy định.</font>"
