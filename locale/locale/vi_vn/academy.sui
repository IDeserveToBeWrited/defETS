#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Phía trước bạn có một rào chắn. Hãy lái xe đến sát rào chắn và dừng lại."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Phía sau xe tải, bên phía người lái, có một rào chắn khác. Lùi xe vòng qua khúc cua đến đó. Có thể dùng vạch kẻ đường làm hướng dẫn."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Ngay phía trước có một khúc cua gấp 90 độ. Hãy lái xe về phía đó."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Chúng ta phải lái xe vào sát góc cua để bánh sau không bị vướng vào cọc tiêu giao thông ở góc trong.<br>Hãy dùng gương chiếu hậu!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Đi thẳng, lái xe về phía các rào chắn cuối cùng, sau đó dừng lại và cố định xe tải."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Xe tải vẫn chưa sẵn sàng di chuyển, có lẽ anh quên thứ gì đó?<br><br>Động cơ đã nổ chưa? Bạn đã nhả phanh tay chưa?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Ngay trước mặt bạn là một điểm được đánh dấu, ngay trước rào chắn.<br><br><font face=/font/big_bold.font>Hãy lái xe tiến lên và dừng lại ở điểm được đánh dấu.</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Hãy nhìn ra phía sau bên phía người lái; bạn sẽ thấy một điểm đánh dấu khác ở đó. Bạn phải kết hợp việc lùi xe và quay đầu cùng lúc.<br><br><font face=/font/big_bold.font>Lùi xe quanh khúc cua và dừng lại ở điểm đánh dấu.</font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Chặng đường tiếp tục phía trước với một khúc cua 90 độ.<br><br>Giữ xe ở phía người lái trước khi vào cua, lái xe vào sâu trong góc cua và rẽ nhanh và gấp. Cẩn thận đừng đâm vào cọc tiêu giao thông bên trong.<br><br><font face=/font/big_bold.font>Lái xe thẳng và rẽ. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Sử dụng gương chiếu hậu phía trước và hai bên để đảm bảo bạn không va chạm với bất cứ vật gì.<br><br><font face=/font/big_bold.font>Hoàn thành việc rẽ và dừng lại ở khu vực quy định.</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Tắt máy và hãm phanh tay xe tải</font>"
#@}

