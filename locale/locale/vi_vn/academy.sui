#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Đỗ xe chéo"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Trong tình huống này, bạn sẽ đỗ xe ở một vị trí đỗ xe chéo trong một bãi đỗ xe đông đúc. <br><br>Không có nhiều không gian để xoay sở, vì vậy bạn sẽ phải lái xe rất chính xác và cẩn trọng."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Tiến đến chỗ đỗ xe"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Các chỗ đỗ xe chéo như thế này rất phổ biến. Chúng đặc biệt phổ biến ở nhiều khu vực nghỉ ngơi dọc theo các đường cao tốc châu Âu. <br>Một lần nữa, chúng ta lại phải \"đưa xe sát vào\" chỗ đỗ phía trước."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Lái xe đến chỗ đỗ được chỉ định ở cuối dãy."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Giữ xe ở giữa làn đường, hoặc hơi lệch về phía người lái. Không lái quá sát rào chắn vì phần đuôi xe moóc có thể va vào chúng khi rẽ."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Lái xe vượt qua chỗ đỗ một đoạn đủ xa, sau đó đánh lái gấp và nhanh về phía chỗ đỗ. Hãy chú ý cả hai gương chiếu hậu: gương bên trái để đảm bảo đầu rơ-moóc không va vào rơ-moóc bên cạnh, và gương bên phải để chắc chắn rơ-moóc đang vào chỗ đỗ an toàn."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Dừng xe tại khu vực quy định, khóa xe và tắt máy."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Khi đỗ xe chéo, điều quan trọng là phải ước lượng vị trí chính xác. Một khi đã vào cua được một nửa, việc lùi xe và định vị lại vị trí an toàn sẽ khó khăn, vì vậy lý tưởng nhất là đảm bảo bạn có đủ không gian ngay từ lần thử đầu tiên.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Bắt đầu lái xe về phía chỗ đậu xe.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Lái xe vượt qua chỗ đỗ xe để rơ-moóc của bạn có đủ không gian xoay quanh xe tải ở phía trong.<br><br><font face=/font/big_bold.font>Rẽ vào chỗ đỗ xe.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Lùi xe phía khuất tầm nhìn"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Trong tình huống này, chúng ta sẽ xem xét việc lùi xe tải vào chỗ đỗ mà không nhìn thấy đường. Vì không thể nhìn ra ngoài cửa sổ để quan sát đường đi, bạn sẽ phải dựa hoàn toàn vào gương chiếu hậu để đưa xe đến vị trí cần đỗ."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Trong tình huống này, bạn sẽ học cách lùi xe vào chỗ khuất tầm nhìn. Lùi xe vào chỗ khuất tầm nhìn thường nên tránh trừ khi không còn cách nào khác, vì tầm nhìn của bạn bị hạn chế nghiêm trọng. Hãy dành thời gian và hết sức cẩn thận."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Hãy lái xe vượt qua vị trí đỗ xe để có đủ không gian thao tác khi bắt đầu lùi xe."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Dừng xe, quan sát xung quanh, sau đó bắt đầu lùi xe."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Xoay máy kéo ra khỏi vị trí. Điều này sẽ đẩy phần trước của rơ-moóc quay theo, và từ đó hướng phần sau của rơ-moóc về phía chỗ đỗ xe bạn muốn vào. Hãy cẩn thận đừng xoay quá mạnh kẻo toàn bộ tổ hợp rơ-moóc bị gập khúc."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Khi xe moóc tiến vào chỗ đỗ, hãy bắt đầu chỉnh thẳng xe tải."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Dừng xe tại khu vực quy định và khóa xe tải."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Lùi xe trong điều kiện tầm nhìn hạn chế đòi hỏi các bước tương tự như lùi xe trong điều kiện tầm nhìn thuận lợi, nhưng bạn sẽ gặp khó khăn hơn do tầm nhìn hạn chế ở phía đó. Hãy sử dụng gương chiếu hậu và khả năng phán đoán tốt nhất của bạn để đỗ xe tải.<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Có một chỗ đậu xe phía trước, bên phía hành khách. Bạn cần lái xe vượt qua chỗ đó hẳn một chút để có đủ không gian thao tác khi lùi xe.<br><br><font face=/font/big_bold.font>Lái xe tiến lên.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Hãy nhớ rằng, việc xoay xe tải ra khỏi vị trí đỗ sẽ làm cho rơ-moóc quay về phía vị trí đó. Sử dụng gương chiếu hậu một cách tốt nhất có thể để hỗ trợ bạn vào chỗ đỗ.<br><br><font face=/font/big_bold.font>Bắt đầu lùi xe.</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Lái xe trên vòng xuyến"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Trong tình huống này, chúng ta sẽ xem xét cách điều khiển xe qua vòng xuyến.<br><br>Bạn cần đặc biệt chú ý đến rơ-moóc của mình vì nó sẽ di chuyển phía sau bạn khác nhau khi bạn vào, đi qua vòng xuyến và khi ra khỏi vòng xuyến."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Đi vào vòng xuyến"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Lái xe trong vòng xuyến"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Lái xe trong vòng xuyến"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Rời khỏi vòng xuyến"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Lái xe đến khu vực được chỉ định"
