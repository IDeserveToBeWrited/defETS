#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Đỗ xe song song là một kỹ năng thiết yếu mà mọi tài xế xe tải nên biết.<br>Chuẩn bị khởi hành."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Lái xe về phía chỗ đậu xe.<br>Hãy chú ý quan sát xung quanh."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Hãy đỗ xe sao cho thẳng hàng với chiếc xe tải phía trước chỗ đỗ của bạn. Đừng đỗ quá sát, giữ khoảng cách nhất định để có đủ không gian thao tác."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Quay xe đột ngột về phía khoảng trống và bắt đầu lùi xe."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Khi nhìn qua gương chiếu hậu bên phía người lái, hãy nhắm vào lề đường ngay phía trước chiếc xe tải phía sau bạn."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Khi cản trước của xe bạn đã vượt qua xe tải phía trước, bạn có thể bắt đầu điều khiển phần đầu xe vào vị trí, căn chỉnh xe sao cho thẳng hàng với chỗ đỗ xe."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Chỉnh thẳng bánh xe và căn giữa xe tải trong chỗ đỗ.<br>Đỗ xe và cố định xe tải."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Phía trước bạn có một vài chiếc xe tải đang đậu. Còn một chỗ trống để bạn đậu xe. <br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Hãy nhớ luôn chú ý đến môi trường xung quanh. Sử dụng gương chiếu hậu thật tốt trong suốt quá trình thực hiện thao tác này. <br><br><font face=/font/big_bold.font>Lái xe tiến về phía trước.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Lái xe qua chỗ đỗ và vào khu vực được đánh dấu. Từ đó, bạn có thể bắt đầu thao tác lùi xe.<br><br><font face=/font/big_bold.font>Dừng xe tại vị trí được đánh dấu.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Kiểm tra xung quanh xem có chướng ngại vật nào không và đảm bảo bạn có đủ không gian để lùi xe.<br><br><font face=/font/big_bold.font>Nhìn qua gương chiếu hậu bên phía hành khách.</font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Xoay vô lăng và lùi vào chỗ đỗ xe.<br><br><font face=/font/big_bold.font>Bắt đầu lùi xe.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Bắt đầu chỉnh thẳng xe tải khi thích hợp. Không được lái xe vượt qua lề đường!<br><br><font face=/font/big_bold.font>Căn chỉnh xe tải thẳng hàng với vị trí đỗ.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

