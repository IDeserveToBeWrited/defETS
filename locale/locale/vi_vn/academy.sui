#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Sa bàn lùi xe tự do"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Trong tình huống này, bạn sẽ được đưa vào một bãi đỗ xe trống để thực hành lùi xe với hai bánh."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Bắt đầu"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Thử nghiệm"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Hoàn thành"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Kết thúc kịch bản"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Lùi xe với rơ-moóc đôi đòi hỏi sự chú ý nhiều hơn so với rơ-moóc đơn. Bạn cần lên kế hoạch trước cho vị trí bạn muốn rơ-moóc phía sau di chuyển, đồng thời vẫn phải kiểm soát được rơ-moóc phía trước và cabin. <br><br>Hãy nghĩ theo cách này - bạn phải sử dụng rơ-moóc phía trước để điều khiển hướng đi của rơ-moóc phía sau."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Trong trường hợp này, chúng ta muốn xoay rơ-moóc phía sau về phía người lái. Để lái theo cách này, chúng ta cần đẩy phần trước của rơ-moóc phía sau về phía hành khách. <br><br>Lưu ý rằng điều này về cơ bản có nghĩa là bạn phải xoay rơ-moóc phía trước theo hướng ngược lại với hướng bạn muốn lái rơ-moóc phía sau."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Khi rơ-moóc phía sau bắt đầu quay, điều cần thiết là phải giữ cho đầu kéo thẳng hàng với rơ-moóc phía trước. Đây là điểm mà hầu hết mọi người thường mắc sai lầm đầu tiên."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Ở đây, ta thấy người lái xe đã không tuân theo chỉ dẫn và sắp làm lật rơ-moóc của mình."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Hiện tượng gập khúc xảy ra khi góc giữa hai xe bất kỳ trong tổ hợp xe đạt khoảng 90 độ. Một khi điều này xảy ra, không thể khắc phục được - bạn phải tiến lên phía trước và thử lại. <br><br> Cũng như khi lùi một rơ-moóc, mục tiêu luôn phải đảm bảo tất cả các bánh xe trên rơ-moóc đều đang chuyển động. Nếu một bánh xe dừng lại và rơ-moóc quay tại chỗ, bạn không thể tiếp tục."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Bạn có thể tiến lên đến vị trí mà bạn đã làm đúng lần cuối, hay nói đúng hơn, một vị trí mà bạn có thể tiếp tục làm việc ngược lại mà không mắc phải lỗi tương tự nữa. <br><br>Trong trường hợp này, chúng ta sẽ tiến lên đến vị trí thẳng và thử lại từ đầu."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Một lần nữa, khi rơ-moóc phía sau bắt đầu quay, hãy đưa đầu kéo lên trước rơ-moóc và để rơ-moóc phía sau tự quay trong giây lát."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Bây giờ rơ-moóc phía sau đang quay về hướng chúng ta muốn, đã đến lúc điều khiển rơ-moóc phía trước để đi theo. Bạn có thể điều chỉnh góc giữa rơ-moóc phía trước và phía sau để kiểm soát hướng quay và làm cho nó gấp hơn hoặc rộng hơn."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Bước cuối cùng của thao tác là chỉnh cho mọi thứ thẳng hàng. Đảm bảo phần đầu xe thẳng hàng với phần đuôi xe."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Bạn nên lưu ý thời gian cần thiết để di chuyển rơ-moóc phía trước; nếu bạn chờ quá lâu, rơ-moóc phía sau sẽ có xu hướng quay trở lại vị trí ban đầu!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Hãy thoải mái dành bao nhiêu thời gian tùy thích ở đây, thử nghiệm các thao tác khác nhau cho đến khi bạn cảm thấy mình đã nắm được cách điều khiển rơ-moóc lùi. <br><br>Nhưng quan trọng nhất là, hãy nhớ tận hưởng quá trình này!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Chuẩn bị khởi hành."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Hãy sử dụng bãi đỗ xe này để làm quen với việc điều khiển rơ-moóc lùi. <br><br>@@aca_goal_tip@@ Bạn mới làm quen với việc lùi rơ-moóc? Hãy thử chơi trò chơi \"Những điều cơ bản khi lái xe tải\"."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Hãy dành thời gian tùy thích để luyện tập. <br><br>Khi bạn đã hài lòng, bạn có thể dừng lại và cố định xe tải để kết thúc tình huống."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Tắt động cơ để kết thúc tình huống."
#@}


