#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "Trong tình huống này, chúng ta sẽ thử nối và tháo rơ-moóc lần đầu tiên. Chuẩn bị xe tải sẵn sàng, sau đó lùi xe vào dưới rơ-moóc phía sau."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Nối rơ-moóc vào xe, sau đó tiến về phía trước."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Dừng lại ở khu vực được đánh dấu."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Tháo rơ-moóc, tiến lên phía trước."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Dừng xe tại chỗ đỗ và khóa xe tải lại."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "Trong tình huống này, chúng ta sẽ thảo luận về các thủ tục kết nối và ngắt kết nối đầu kéo và rơ-moóc. Đây là một quy trình đơn giản hóa so với những gì một tài xế xe tải sẽ gặp phải trong thực tế. <br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Có một rơ-moóc nằm phía sau đầu kéo. Lùi xe từ từ vào dưới rơ-moóc cho đến khi khớp nối rơ-moóc chạm vào chốt kéo. Hiện tại, xe tải đang được căn chỉnh đúng nên không cần đánh lái, chỉ cần lùi thẳng.<br><br><font face=/font/big_bold.font>Lùi chậm cho đến khi cảm thấy khớp nối.</font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Mâm xe thứ năm đã được nối với chốt kéo.<br><br><font face=/font/big_bold.font>Cố định xe tải bằng cách kéo phanh tay.</font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Trong thực tế, khớp nối rơ-moóc tự động khóa chốt kéo, sau đó người lái xe tải cần phải ra khỏi xe để thu càng đáp và kết nối đường ống dẫn khí và điện. <br><br><font face=/font/big_bold.font>Với chúng tôi, chỉ cần nhấn @@imv_nrm_attach@@ là có thể kết nối rơ-moóc. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Giờ đây, khi đầu kéo đã được nối an toàn với rơ-moóc, bạn đã sẵn sàng tiến về phía trước. Hãy nhớ rằng xe của bạn giờ đây dài hơn và nặng hơn đáng kể, và sẽ đòi hỏi bạn phải có những kỹ năng mới để điều khiển. <br><br><font face=/font/big_bold.font>Nhả phanh tay và chuẩn bị lái xe về phía trước.</font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Lái xe tiến về phía trước.<br><br><font face=/font/big_bold.font>Dừng lại ở khu vực được đánh dấu phía trước.</font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Kéo phanh tay.</font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Kích hoạt phanh tay.</font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Một lần nữa, trong thực tế, người lái xe tải sẽ phải ra khỏi xe, hạ càng đáp, ngắt đường ống dẫn khí và điện, và mở khóa cơ cấu khớp nối rơ-moóc. <br><br><font face=/font/big_bold.font>Chúng tôi đơn giản hóa quy trình này cho bạn, vì vậy việc nhấn @@imv_nrm_attach@@ sẽ ngắt kết nối rơ-moóc.</font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Hãy nhả phanh tay.</font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Kéo máy kéo ra khỏi gầm rơ-moóc và tiến về phía trước.<br><br><font face=/font/big_bold.font>Dừng lại ở khu vực được đánh dấu.</font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Dừng lại ở khu vực được đánh dấu.</font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
