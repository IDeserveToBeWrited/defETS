#### common
	key[]: "aca_scenario_book2_track_rain_title"
	val[]: "Lái xe trong thời tiết xấu"

	key[]: "aca_scenario_book2_track_rain_desc"
	val[]: "Trong tình huống này, bạn phải lái xe trên một đường đua với nhiều chướng ngại vật trong điều kiện thời tiết xấu."

#### intro text

	key[]: "aca_scenario_book2_track_rain_cutscene1"
