	key[]: "aca_goal_book3_sup_end"
	val[]: "Dừng đỗ xe an toàn"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Lái xe với rơ-moóc kép (B-double) có vẻ đáng sợ, nhưng thực ra không khác gì lái xe với rơ-moóc đơn - bạn chỉ cần lưu ý thêm về hướng di chuyển của rơ-moóc phía sau!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Trước mặt bạn là một chỗ đỗ xe hẹp. Bạn sẽ không có đủ không gian để đỗ thẳng hàng trước khi vào, vì vậy bạn cần cân nhắc kỹ cách đưa cả hai rơ-moóc vào."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Hãy lập tức rẽ về phía bên kia của chỗ đậu xe và lái xe vượt qua vị trí mà bạn thường rẽ vào."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Giờ rơ-moóc phía sau đã đi đúng hướng, bạn có thể tiến về phía điểm đến; chỉ cần đảm bảo bạn đi tiếp về phía bên kia để giúp đưa rơ-moóc đầu tiên quay vòng."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Tiếp tục tiến vào vị trí, cả hai xe moóc sẽ đi theo bạn và thẳng hàng khi bạn di chuyển."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Đỗ xe vào khu vực quy định và khóa xe tải lại."

#### sup Driving Instructions

