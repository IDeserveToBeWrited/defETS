	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Phía trước bạn là một số khúc cua gắt với rất ít khoảng trống. Những khúc cua này sẽ giúp bạn học cách điều khiển rơ-moóc một cách hiệu quả."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Hãy đi theo vạch kẻ đường hướng về phía rào chắn bên phía người lái để chuẩn bị cho khúc cua đầu tiên."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Hãy giữ xe bám sát rào chắn phía ngoài khi vào cua, rơ-moóc sẽ đi theo bạn vào sân tập một cách thuận lợi."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Tiếp tục theo vạch kẻ đường để chuẩn bị cho khúc cua thứ hai, một khúc cua hẹp 90 độ."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Bạn sẽ phải lái sâu vào góc cua để đảm bảo rơ-moóc của mình vượt qua được các rào chắn phía trong. Hãy sử dụng gương đầu xe để giúp bạn tiến xa nhất có thể vào góc cua mà không va chạm vào bất cứ thứ gì."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Tiếp tục đi dọc theo hàng rào bên ngoài."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Một lần nữa, một khúc cua 90 độ hẹp khác sẽ đòi hỏi bạn phải tận dụng tối đa không gian có sẵn."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Dừng xe tại khu vực quy định và khóa xe tải."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Hãy nhớ tận dụng tối đa không gian có sẵn để giúp bạn dễ dàng vượt qua mỗi khúc cua.<br><br><font face=/font/big_bold.font>Khởi hành và đi theo vạch kẻ đường ra phía ngoài.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Đi theo hàng rào ngoài cùng, nhưng nhớ để ý đến rơ-moóc của bạn qua gương chiếu hậu.<br><br><font face=/font/big_bold.font>Rẽ vào ngã rẽ đầu tiên.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Hãy làm theo vạch kẻ đường để chuẩn bị cho khúc cua 90 độ phía trước.<br><br><font face=/font/big_bold.font>Thực hiện khúc cua 90 độ.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Giữ cho xe tải đi rộng sau khi rẽ, vì phía trước bạn còn một khúc cua 90 độ hẹp hơn nữa.<br><br><font face=/font/big_bold.font>Tiếp tục lái xe.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Hãy tiến đến chỗ đỗ xe phía trước.</font>"
