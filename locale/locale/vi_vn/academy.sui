#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Trong tình huống này, chúng ta sẽ lái xe tải một đoạn ngắn. Bạn sẽ có cơ hội làm quen với việc phanh khi kéo rơ-moóc trong lúc xuống dốc phía trước. Chuẩn bị xe tải và khởi hành."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Đạt tốc độ ít nhất 60 km/h (37 mph). Chuẩn bị sẵn sàng cho khu vực phanh phía trước."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Bắt đầu giảm tốc độ để dừng lại. Hãy chắc chắn rằng bạn không chờ quá lâu, nếu không bạn có thể đâm vào các rào chắn phía trước!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Đỗ xe vào khu vực quy định, sau đó khóa xe và tắt máy."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Trong chuyến lái xe này, bạn sẽ làm quen với việc sử dụng phanh chính khi xuống dốc. Mục đích của bài tập này là để bạn nhận thức được trọng lượng phía sau và ảnh hưởng của nó đến quãng đường phanh của xe.<br><br><font face=/font/big_bold.font>Chuẩn bị xuất phát.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Bắt đầu lái xe ngay bây giờ và nhớ rằng bạn cần đạt tốc độ 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Lái xe qua khúc cua.</font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Tiếp tục tăng tốc xuống dốc.</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Đạt tốc độ ít nhất 60 km/h (37 mph).</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Bạn đã đạt tốc độ yêu cầu.<br><br><font face=/font/big_bold.font>Dừng lại ở rào chắn phía trước.</font>"
