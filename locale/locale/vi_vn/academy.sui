#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Đỗ xe cạnh chướng ngại vật"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Trong tình huống này, chúng ta sẽ học cách đỗ xe sát lề đường bằng cách sử dụng gương chiếu hậu bên hông."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Kiểm tra gương chiếu hậu bên hông"


	key[]: "aca_goal_book1_2_04_check1"
