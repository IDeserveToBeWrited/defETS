#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Đỗ xe trong không gian hẹp"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "Trong tình huống này, chúng ta sẽ đỗ xe trong một không gian hẹp.<br><br>Bạn sẽ phải điều khiển rơ-moóc để thẳng hàng với một chỗ đỗ xe lệch."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Di chuyển vào vị trí"
