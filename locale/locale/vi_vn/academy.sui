	key[]: "aca_scenario_book3_diag_desc"
	val[]: "Trong tình huống này, bạn sẽ đỗ cùng với rơ-moóc kép của mình vào một chỗ đỗ xe chéo trong một bãi đỗ xe đông đúc "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Các chỗ đỗ xe chéo như thế này rất phổ biến. Chúng đặc biệt phổ biến ở nhiều khu vực nghỉ ngơi dọc theo các đường cao tốc châu Âu."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Lái xe đến chỗ đỗ được chỉ định ở cuối dãy."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Giữ xe ở phía ngoài làn đường, nhưng không được sát vào rào chắn vì phần đuôi xe moóc có thể va vào rào chắn khi rẽ vào."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Hãy lái xe chạy qua vị trí đỗ để tạo khoảng trống cho cả hai rơ-moóc đi theo sau vào. Sau đó, hướng xe về phía xa của vị trí đỗ để đưa rơ-moóc thứ nhất vào đúng vị trí."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Cân thẳng xe, sau đó dừng lại trong khu vực quy định và khóa xe an toàn."

