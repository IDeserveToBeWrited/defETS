#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Kỹ năng lái xe tải"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Chào mừng trở lại với @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Các tình huống sau đây thể hiện bước tiếp theo trên hành trình trở thành tài xế xe tải chuyên nghiệp của bạn."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Lần này chúng tôi sẽ không hướng dẫn bạn từng bước một, vì vậy bạn cần tự mình vận dụng kỹ năng và kinh nghiệm của mình."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Bạn có thể bắt gặp một số thao tác quen thuộc, nhưng lần này trong môi trường mới được thiết kế giống với các tình huống thực tế hơn."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Điểm mới tại @@driving_academy@@ là việc bổ sung các điều kiện \"Đạt\" và \"Thưởng\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Như trước đây, bạn vẫn phải hoàn thành mỗi tình huống mà không va chạm với bất cứ thứ gì, bằng cách đỗ xe thành công và đảm bảo an toàn cho xe tải..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...nhưng giờ đây bạn cũng phải thực hiện điều đó trong thời gian quy định và với giới hạn về số lần chuyển hướng giữa lái tiến và lái lùi."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bạn có thể đạt được điều kiện nhận thưởng bằng cách hoàn thành mỗi kịch bản với những điều kiện khó khăn hơn nữa..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...chẳng hạn như giới hạn thời gian nghiêm ngặt hơn, ít thay đổi hướng đi hơn và chỉ sử dụng camera bên trong."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Hoàn thành tất cả các tình huống, bạn có thể tự coi mình là một tài xế xe tải lành nghề và sẵn sàng cho thử thách tiếp theo.<br><br>Để thử thách bản thân hơn nữa, hãy hoàn thành tất cả các điều kiện thưởng cho mỗi tình huống; khi đó bạn sẽ thực sự trở thành một ngôi sao lái xe tải!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Hướng dẫn"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Trong kịch bản hướng dẫn này, chúng tôi sẽ giúp bạn làm quen với các tính năng mới trong phần Kỹ năng Lái xe tải Chuyên nghiệp."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Tại thời điểm bắt đầu mỗi kịch bản, bạn sẽ thấy một cửa sổ <color value=@@clr_sel@@>\"Tóm tắt Kịch bản\"<color value=@@clr_txt@@>. Cửa sổ này sẽ cung cấp thông tin về các điều kiện Đạt và Thưởng mới của kịch bản đó. <br><br>Các điều kiện Đạt phải được đáp ứng để hoàn thành thành công kịch bản, trong khi các điều kiện Thưởng là những thử thách bổ sung tùy chọn dành cho những người chơi dày dạn kinh nghiệm và kỹ năng. <br><br><font face=/font/big_bold.font>Để tiếp tục, hãy bật hệ thống đánh lửa.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Một trong các điều kiện thưởng yêu cầu bạn hoàn thành kịch bản trong khi sử dụng <color value=@@clr_sel@@>Camera Trong xe<color value=@@clr_txt@@>. Bạn vẫn có thể sử dụng các camera bên ngoài để kiểm tra xung quanh, nhưng chỉ khi xe tải đã dừng hẳn.<br><br>Hiện tại bạn có thể quan sát xung quanh để xác định phương hướng, sau đó hãy chuyển về camera trong xe.<br><br><font face=/font/big_bold.font>Hãy chuyển sang camera ngoài để kiểm tra xung quanh</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Xác định phương hướng, sau đó chuyển lại sang camera bên trong.<br><br><font face=/font/big_bold.font>Quan sát xung quanh xe tải</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Chuyển lại sang camera trong xe</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Thời gian<color value=@@clr_txt@@> cũng sẽ là một yếu tố trong Kỹ năng Lái xe tải Chuyên nghiệp. Tất cả các kịch bản sẽ có giới hạn thời gian riêng biệt mà bạn phải hoàn thành như một điều kiện Đạt, và nhiều kịch bản cũng sẽ có thêm một giới hạn nghiêm ngặt hơn đóng vai trò là điều kiện Thưởng.<br><br>Đồng hồ tính giờ chỉ bắt đầu chạy sau khi xe tải di chuyển.<br><br><font face=/font/big_bold.font>Hãy nổ máy và nhả phanh tay để tiếp tục.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Một bổ sung mới khác cho Kỹ năng Lái xe tải Chuyên nghiệp là các điểm mốc. Tất cả các điểm mốc phải được đi đến trước khi một kịch bản có thể hoàn thành. <br><br>Ngoài ra, các điểm mốc này còn nhạy cảm với hướng đầu xe khi bạn đi tới, vì vậy hãy chú ý đến bất kỳ chỉ dẫn đánh dấu nào trên mặt đất gần điểm mốc để định hướng bản thân một cách chính xác.<br><br><font face=/font/big_bold.font>Lái xe về phía trước đến điểm mốc trước mặt bạn.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Bạn đã đến được điểm mốc và giờ có thể chuyển sang bước tiếp theo. <br><br>Có một điểm mốc khác ở phía sau mà bạn phải lùi xe vào đó. Hãy chú ý mũi tên trên mặt đất cho biết hướng mà xe tải cần phải đối diện khi bạn chạm tới điểm mốc. <br><br>Một điều kiện Đạt và Thưởng khác cần lưu ý là <color value=@@clr_sel@@>Số lần Thay đổi Hướng<color value=@@clr_txt@@>. Chúng tôi sẽ đếm số lần bạn thay đổi hướng giữa việc lái tiến và lùi. Hãy giữ số lần này dưới mức giới hạn để hoàn thành điều kiện bài tập.<br><br><font face=/font/big_bold.font>Lùi xe đến điểm mốc và dừng lại.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Vì vậy, tính đến thời điểm hiện tại, bạn chắc hẳn đã tích lũy một lần thay đổi hướng. <br><br>Hãy lấy rơ-moóc ở phía sau bạn để tiếp tục bước tiếp theo. <br><br><font face=/font/big_bold.font>Hãy lùi xe xuống dưới rơ-moóc để thực hiện kết nối.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Khu vực đỗ xe cuối cùng nằm ở phía bên phải của bạn. Một số kịch bản có thể chỉ có một vị trí đỗ, trong khi những kịch bản khác sẽ có nhiều vị trí để bạn lựa chọn. Đỗ xe chính xác vào bất kỳ vị trí nào trong số đó đều sẽ cho phép bạn hoàn thành kịch bản. <br><br><font face=/font/big_bold.font> Nhấn @@imv_nrm_attach@@ để kết nối rơ-moóc. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Các vị trí đỗ xe cũng chỉ dẫn hướng mà xe tải cần phải quay về phía đó. Nếu đỗ sai hướng, bạn sẽ không thể hoàn thành kịch bản cho đến khi tự điều chỉnh lại, việc này sẽ làm bạn tiêu tốn thêm thời gian và số lần thay đổi hướng.<br><br><font face=/font/big_bold.font>Hãy lái xe đến một trong các vị trí đỗ và đỗ xe chính xác.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Kỹ năng lái xe tải"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Giờ đây bạn chắc hẳn đã làm quen với các tham số mới cho Điều kiện Đạt và Mục tiêu Thưởng, và đã sẵn sàng để đương đầu với những kịch bản mới trong Kỹ năng Lái xe tải Chuyên nghiệp!<br><br><font face=/font/big_bold.font>Hãy đảm bảo xe an toàn bằng cách cài phanh tay và tắt máy để hoàn thành kịch bản.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Phím tắt"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "Trong trường hợp này, bạn sẽ cố gắng sử dụng một đường tắt, nhưng không may là đường tắt đó bị chặn ở cuối. Khi đó, bạn phải quay ngược lại theo con đường bạn đã đi."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Lái xe đến điểm đánh dấu trên đỉnh đồi rồi quay ngược lại theo cùng một con đường xuống. <br><br>Sau khi trở lại đường chính, lái xe đến khu vực đỗ xe cuối cùng."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Kẻ đến sớm"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "Trong kịch bản này, bạn phải điều khiển xe đi qua một bãi đỗ đang quá tải. Không gian cực kỳ hạn chế, vì vậy hãy cố gắng lên kế hoạch cho các bước di chuyển của bạn từ trước."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Có những thời điểm chỗ đỗ xe khan hiếm đến mức các tài xế khác sẽ đỗ bất cứ nơi nào họ có thể trong suốt đêm. Điều này có thể khiến việc điều khiển xe lách qua họ vào buổi sáng trở nên khá khó khăn.<br><br> Hãy cố gắng hết sức để vượt qua bãi đỗ và tiến đến vị trí đỗ cuối cùng."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Khúc cua ngặt nghèo"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "Trong kịch bản này, bạn được giao nhiệm vụ lái xe đi qua một sa bàn đào tạo rất phức tạp. Trên đường đi, bạn phải tìm và kết nối với một rơ-moóc, sau đó kéo nó cùng với bạn về đến đích."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Kịch bản này sẽ kiểm tra khả năng nhận thức không gian và tình huống của bạn. Đoạn đường phía trước đầy rẫy những chướng ngại vật mà không phải lúc nào bạn cũng có thể dễ dàng phát hiện ra."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Hãy đi theo con đường dẫn đến chỗ xe kéo. Khi đã tìm thấy, hãy nối xe kéo với nó và kéo đến vị trí đỗ cuối cùng."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Chóng mặt"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "Trong kịch bản này, chúng tôi sẽ kiểm tra kỹ năng điều khiển xe của bạn. Hãy lái xe vòng quanh liên tục cho đến khi bạn đi tới điểm cuối!"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "Đã đến lúc đưa kỹ năng điều khiển xe tải của bạn vào thử thách; đường chạy này được thiết kế để xem bạn hiểu chiếc xe của mình đến mức nào!"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "Điểm nhấn chính là một đường xoắn ốc dài, sẽ thử thách khả năng điều khiển xe tải của bạn qua những khúc cua dài và uốn lượn."

#@}




#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Lùi xe quanh góc đường"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "Trong kịch bản này, bạn phải lùi xe tải của mình qua một góc khuất và đi vào vị trí đỗ."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Các khu vực dỡ hàng không phải lúc nào cũng nằm ở vị trí lý tưởng. Trong trường hợp này, nó đã bị tòa nhà bên cạnh che khuất khỏi tầm mắt của bạn."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Lùi xe vòng quanh tòa nhà và vào chỗ đỗ xe."

#@}



#+ Book 2 depot_options
#@{
#### common
	key[]: "aca_scenario_book2_depot_options_title"
	val[]: "Đỗ xe tại kho bãi"

	key[]: "aca_scenario_book2_depot_options_desc"
	val[]: "Trong kịch bản này, bạn được giao nhiệm vụ đỗ xe tải vào một trong ba vị trí đỗ khác nhau, mỗi vị trí đều yêu cầu những kỹ năng điều khiển riêng biệt."

#### intro text

	key[]: "aca_scenario_book2_depot_options_cutscene1"
	val[]: "Có ba vị trí đỗ xe khác nhau dành cho bạn với độ khó khác nhau. Hãy chọn một vị trí, lái xe đến đó và lùi xe vào theo bất cứ cách nào bạn thấy phù hợp."


#@}

#+ Book 2 night_parallel
#@{
#### common
	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Đỗ xe song song trong đêm"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "Trong kịch bản này, bạn phải đỗ xe song song sát mép vỉa hè. Vì đang là ban đêm, tầm nhìn của bạn sẽ bị hạn chế."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Thời gian và thời tiết không phải lúc nào cũng lý tưởng khi bạn cần đỗ xe nghỉ đêm, vì vậy bạn sẽ cần phải chú ý kỹ hơn đến môi trường xung quanh mình.<br><br>Đừng quên bật đèn xe nhé!"

#@}

