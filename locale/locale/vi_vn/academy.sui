	key[]: "aca_msg_book3_train_check5"
	val[]: "Sẽ có lúc bạn không còn lựa chọn nào khác ngoài việc bẻ lái gấp toàn bộ tổ hợp xe. <br><br>Hãy làm mọi cách để vượt qua khúc cua cực kỳ gấp khúc này."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Tiếp tục lái xe theo lộ trình."

	key[]: "aca_msg_book3_train_check7"
