	key[]: "aca_goal_book1_2_01_end"
	val[]: "Dừng đỗ xe an toàn"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "Trong tình huống này, chúng ta sẽ lái chiếc xe đầu kéo đi một đoạn ngắn qua một đường ngoằn ngoèo được tạo thành từ các cọc tiêu giao thông."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Lái xe cẩn thận và chú ý đến xung quanh. Quan sát cả hai bên xe tải và nhớ sử dụng gương chiếu hậu để hỗ trợ điều khiển xe."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "Đường đua càng về cuối càng hẹp, vì vậy sự chính xác là chìa khóa."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Đỗ xe vào khu vực quy định và khóa xe tải lại."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "Để hoàn thành tình huống này, bạn phải lái xe vòng qua tất cả các hình nón mà không được đâm vào bất kỳ hình nón nào. <br><br><font face=/font/big bold.font>Nhấn @@imv_nrm_activate@@ để xác nhận.</font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Sử dụng gương chiếu hậu để giúp duy trì tầm nhìn dọc theo cả hai bên xe tải.<br><br>Đối với phía hành khách, gương chiếu hậu phía trước và hai bên có thể rất hữu ích trong việc định hướng.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_activate@@ để xác nhận.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Điều chỉnh gương chiếu hậu nếu cần thiết trong '@@adjust_link_t@@' (Truy cập qua menu tạm dừng).<br><br><font face=/font/big_bold.font>Chuẩn bị khởi hành.</font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "Xe tải vẫn chưa sẵn sàng di chuyển, có lẽ anh quên thứ gì đó?<br><br>Động cơ đã nổ chưa? Bạn đã nhả phanh tay chưa?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Tiến về phía trước chậm rãi và lái xe qua khúc cua ngoằn ngoèo.</font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Tiếp tục đi vòng qua các cọc tiêu. Đặc biệt chú ý đến phía bên hành khách.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Hãy tiếp tục di chuyển theo đường zích zắc qua chướng ngại vật mà không va vào bất kỳ cọc tiêu nào.</font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Dừng xe tại khu vực quy định. </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Kéo phanh tay xe tải và tắt động cơ.</font>"
#@}

