#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Điều khiển máy ảnh"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Trong tình huống này, chúng ta sẽ tìm hiểu về các loại camera khác nhau hiện có và cách chúng có thể giúp bạn điều khiển và vận hành xe tải."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Vị trí ngồi"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Cảnh nhìn ra phía sau"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Kiểm tra gương"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Chuyển sang Camera ngoài"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Hãy nhìn xung quanh chiếc xe tải"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Trong trường hợp này, chúng ta sẽ xem xét các loại<br>máy ảnh khác nhau hiện có để sử dụng."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Tổng cộng có bảy máy ảnh để lựa chọn, chúng ta sẽ xem xét một vài<br>trong số đó ngay bây giờ và giải thích chức năng dự định của chúng."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Các camera khác nhau với góc quay đa dạng có thể giúp bạn dễ dàng di chuyển trong không gian chật hẹp."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Quan sát đường đi là nền tảng cốt lõi của việc lái xe an toàn và chuyên nghiệp. Nếu vị trí ngồi hiện tại không phù hợp, bạn có thể thay đổi nó trong '@@adjust_link_t@@' (Truy cập qua menu tạm dừng).<br><br><font face=/font/big_bold.font>Xác nhận khi bạn đã sẵn sàng bằng cách sử dụng @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Khi lùi xe, gương chiếu hậu không phải lúc nào cũng cho tầm nhìn rõ ràng. Có thể bạn cần nhìn ra ngoài cửa sổ phía sau để có tầm nhìn tốt hơn.<br><br><font face=/font/big_bold.font>Hãy xoay camera hết cỡ về phía người lái để nhìn ra ngoài cửa sổ về phía sau rơ-moóc.</font>@@aca_goal_tip@@ Bạn phải ở bên trong xe."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Sử dụng góc nhìn này để kiểm tra rơ-moóc trong quá trình lùi xe có rơ-moóc. Tốt hơn hết là nên lùi về phía người lái để có thể tận dụng góc nhìn này. Khi lùi về phía hành khách, tầm nhìn phía sau của bạn sẽ bị hạn chế hơn nhiều.<br><br><font face=/font/big_bold.font>Hãy nhìn về phía hành khách.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Đây là lý do tại sao thường không nên lùi xe về phía bên hành khách; bạn có thể thấy tầm nhìn khá hạn chế. May mắn thay, có bảy camera ngoại thất để bạn quan sát. <br><br>Nút @@imv_nrm_camcycle@@ có thể được sử dụng để chuyển sang camera tiếp theo theo trình tự. Sau khi chuyển qua cả bảy camera, bạn sẽ quay lại đầu chu trình. <br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_camcycle@@ để chuyển sang camera tiếp theo.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Camera ngoài cung cấp góc nhìn tốt nhất về những gì đang xảy ra xung quanh xe tải.<br><br><font face=/font/big_bold.font>Hãy quan sát xung quanh xe tải.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Bằng cách nhấn @@imv_nrm_camcycle@@ một lần nữa, bạn có thể chuyển sang camera tiếp theo.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Góc nhìn từ trên xuống cung cấp cái nhìn tổng quan tuyệt vời về tình hình xung quanh xe tải, giúp việc đỗ xe và lái xe trong không gian chật hẹp trở nên dễ dàng hơn đáng kể.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_camcycle@@ để chuyển sang camera tiếp theo.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Camera trên nóc xe cung cấp tầm nhìn rõ ràng về con đường phía trước xe tải mà không bị cản trở nhiều.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_camcycle@@ để chuyển sang camera cuối cùng mà chúng ta sẽ xem xét bây giờ.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Góc nhìn phía sau là một lối tắt để quay lại góc nhìn bạn đã có được trước đó bằng cách xoay camera bên trong. Như chúng ta đã thảo luận, nó rất hữu ích khi lùi xe hoặc đỗ xe.<br><br>Trong trò chơi, chúng ta có nhiều camera hơn mà bạn có thể thử bằng cách nhấn liên tục vào @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_cam1@@ để quay lại góc nhìn bên trong.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Để có trải nghiệm học lái xe chân thực, chúng tôi khuyên bạn nên giữ nguyên chế độ xem 'Camera bên trong' khi thực hiện từng tình huống.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_activate@@ để xác nhận và kết thúc tình huống.</font>@@aca_goal_tip@@ Bạn có thể sử dụng tính năng @@o_im_cam_zoom@@ để có tầm nhìn tốt hơn về môi trường xung quanh. Tính năng này đặc biệt hữu ích khi nhìn qua gương chiếu hậu. Kiểm tra Màn hình Tùy chọn - '@@options_bindings_screen@@' - để xem và/hoặc thay đổi các điều khiển tương ứng."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Lái thử lần đầu"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Trong tình huống này, chúng ta sẽ học cách chuẩn bị xe tải để lái và sau đó lái xe tiến về phía trước lần đầu tiên."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Bật khóa điện"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Khởi động động cơ"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Kiểm tra xung quanh"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Áp dụng phanh chính"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Chuyển số"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Nhả phanh tay"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Tiến về phía trước"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Dừng lại"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Kéo phanh tay"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Trả số về N"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Tắt động cơ"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Trong vài chuyến lái thử đầu tiên, chúng ta sẽ chỉ sử dụng đầu kéo.<br>Một chiếc xe tải được gọi là đầu kéo khi nó không có thùng chở hàng riêng, mà thay vào đó dựa vào rơ-moóc để vận chuyển hàng hóa và vật liệu."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Máy kéo rất phổ biến vì chúng mang lại tính linh hoạt cao hơn: chúng có thể thả rơ-moóc trống và nâng rơ-moóc có hàng lên mà không cần phải chờ đợi, hoặc chuyển sang loại rơ-moóc khác hoàn toàn."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Trong lần lái thử đầu tiên, nhiệm vụ của bạn là lái xe tiến về phía trước và dừng lại sau vạch chấm.<br>Khởi động động cơ, làm theo hướng dẫn để chuẩn bị xe tải sẵn sàng di chuyển. Sau khi chuẩn bị xong, hãy lái thẳng về phía trước."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Lái xe vượt qua vạch kẻ đứt quãng, dừng lại, tắt máy và hãm phanh xe tải."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "\"Bước tiếp theo trong quá trình đào tạo, bạn sẽ bắt đầu cho xe di chuyển lần đầu tiên.<br><br>Tất nhiên, xe sẽ không hoạt động nếu động cơ chưa chạy, vì vậy trước tiên bạn cần bật hệ thống điện.<br><br><font face=/font/big_bold.font>Nhấn $input engineelect$ để bật hệ thống điện.</font>@@aca_goal_tip@@ Trong chế độ Sự nghiệp, theo mặc định, động cơ sẽ tự động khởi động cùng với hệ thống điện. Bạn có thể điều chỉnh thiết lập này trong phần Tùy chọn - 'Lối chơi' - @@auto_engine_start@@.\""

	key[]: "aca_msg_book1_1_03_start"
	val[]: "\"Hệ thống điện sẽ kích hoạt các thiết bị điện tử trên xe. Bạn có thể thấy các đèn cảnh báo nhấp nháy trên bảng đồng hồ - đó là điều bình thường. Nếu các đèn này vẫn sáng sau khi động cơ đã khởi động, đó có thể là dấu hiệu xe đang gặp sự cố. Ngoại lệ là đèn phanh tay, đèn này sẽ chỉ tắt khi chúng ta nhả phanh tay.<br><br>May mắn thay, chiếc xe này đang ở tình trạng tốt và chúng ta đã sẵn sàng để tiếp tục.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_engine@@ để khởi động động cơ.</font>\""

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "\"Bây giờ khi động cơ đã khởi động, việc kiểm tra môi trường xung quanh trước khi bắt đầu di chuyển là cực kỳ quan trọng.<br><br><font face=/font/big_bold.font>Hãy quan sát quanh xe và nhìn vào gương chiếu hậu bên phía người lái và hành khách để đảm bảo khu vực xung quanh xe không có vật cản.</font>@@aca_goal_tip@@ Bạn phải ở bên trong cabin xe.\""

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "\"Nghe có vẻ hiển nhiên, nhưng bạn nên biết cách dừng xe trước khi bắt đầu bất kỳ chuyển động nào.<br><br><font face=/font/big_bold.font>Hãy kích hoạt phanh chân bằng cách nhấn $input backward$.</font>\""

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "\"Tiếp theo, bạn sẽ học cách thay đổi hướng di chuyển của xe.<br><br>Với hộp số tự động đơn giản, bạn không cần phải tự sang số, mọi thứ đều được thực hiện tự động.<font face=/font/big_bold.font><br><br>Sử dụng $input forward$ để vào số tiến.</font>\""

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Tiếp theo, bạn sẽ học cách thay đổi hướng di chuyển.<br><br>Hộp số tự động chân thực cho phép bạn chuyển đổi giữa chế độ Lái, Trung lập và Lùi giống như hộp số tự động thực tế.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_gearup@@ để kích hoạt số tiến.</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Tiếp theo, bạn sẽ học cách thay đổi hướng di chuyển.<br><br>Hộp số tuần tự cho phép chuyển số từng bước, giống như hộp số tuần tự thực sự.<br><br>Cũng giống như khi bạn vào số tiến, khi tăng tốc, bạn cần chuyển sang số cao hơn.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_gearup@@ để vào số một.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Tiếp theo, bạn sẽ học cách thay đổi hướng di chuyển.<br><br>Với cần số và bàn đạp ly hợp, bạn sẽ trải nghiệm cảm giác sang số vật lý tương tự như với hộp số sàn thực sự.<br><br>Nhấn hết cỡ bàn đạp ly hợp và phanh chính. <font face=/font/big_bold.font>Sử dụng cần số để vào số một. <color value=@@clr_txt@@>Giữ nguyên bàn đạp ly hợp và phanh chính ở vị trí nhấn hết cỡ.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Để bắt đầu di chuyển, trước tiên bạn phải nhả phanh tay.<br><br><font face=/font/big_bold.font>Sử dụng @@imv_nrm_parkingbrake@@ để nhả phanh tay.</font> @@aca_goal_tip@@ Trong chế độ Sự nghiệp, phanh tay ban đầu bị vô hiệu hóa. Bạn có thể điều chỉnh hành vi này trong Màn hình Tùy chọn - 'Lối chơi' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Giờ xe tải đã sẵn sàng di chuyển về phía trước. Bắt đầu di chuyển và vượt qua vạch chấm.<br><br><font face=/font/big_bold.font>Bắt đầu di chuyển bằng cách sử dụng bàn đạp ga: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Giờ xe tải đã sẵn sàng di chuyển về phía trước. Bắt đầu di chuyển và vượt qua vạch chấm.<br><br><font face=/font/big_bold.font>Bắt đầu di chuyển bằng cách sử dụng bàn đạp ga: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Giờ xe tải đã sẵn sàng di chuyển về phía trước. Bắt đầu di chuyển và vượt qua vạch chấm.<br><br><font face=/font/big_bold.font>Bắt đầu di chuyển bằng cách sử dụng bàn đạp ga: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Giờ xe tải đã sẵn sàng di chuyển về phía trước. Bắt đầu di chuyển và vượt qua vạch chấm.<br><br><font face=/font/big_bold.font>Nhả phanh chính, từ từ nhả ly hợp để vào số đồng thời sử dụng chân ga để giữ vòng tua máy cao, tránh cho xe chết máy. Khi ly hợp đã được nhả hoàn toàn, bạn có thể tăng tốc và sang số khi cần thiết.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Sử dụng phanh chính để dừng xe.<br><br><font face=/font/big_bold.font>Sử dụng lệnh $input backward$ để dừng xe tải. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Sử dụng phanh chính để dừng xe.<br><br><font face=/font/big_bold.font>Sử dụng lệnh $input backward$ để dừng xe tải. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Sử dụng phanh chính để dừng xe.<br><br><font face=/font/big_bold.font>Sử dụng lệnh $input backward$ để dừng xe tải. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Khi đến lúc dừng xe, hãy nhấn hết bàn đạp ly hợp <font face=/font/big_bold.font>và sau đó dừng xe bằng phanh chính.<color value=@@clr_txt@@> Chuyển cần số về vị trí số mo, sau đó bạn có thể nhả ly hợp. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Bây giờ, hãy cố định xe tải. Phanh tay đảm bảo xe tải sẽ không di chuyển ngoài ý muốn sau khi bạn đã đỗ xe.<br><br><font face=/font/big_bold.font>Sử dụng @@imv_nrm_parkingbrake@@ để kích hoạt phanh tay.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Với hộp số tự động đơn giản, bạn không cần phải sang số, mọi thứ đều được thực hiện tự động.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_activate@@ để xác nhận.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Chuyển sang số mo bằng cách nhấn @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Chuyển sang số mo bằng cách nhấn @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Gạt cần số về vị trí số mo, sau đó nhả côn.</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Giờ bạn đã biết cách khởi động xe tải và cách dừng xe an toàn.<br><br><font face=/font/big_bold.font>Nhấn $input engineelect$ để tắt động cơ.</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Lùi xe"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Trong tình huống này, chúng ta sẽ thử lùi xe lần đầu tiên. Chúng ta cũng sẽ thảo luận về cách sử dụng gương chiếu hậu để quan sát phía sau, những điều cần chú ý và cách chuẩn bị cho việc lùi xe."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Khởi động động cơ"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Kiểm tra gương chiếu hậu bên phía hành khách"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Kiểm tra gương chiếu hậu bên lái"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Chuyển số"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Nhả phanh tay"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

