#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "Đèn và cần gạt nước"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "Trong tình huống này, chúng ta sẽ khám phá một số chức năng cơ bản của xe tải giúp bạn duy trì tầm nhìn rõ ràng về môi trường xung quanh và làm cho việc lái xe của bạn dễ đoán hơn đối với những người tham gia giao thông khác.<br><br>Bạn sẽ học cách sử dụng cần gạt nước kính chắn gió để duy trì tầm nhìn tốt trong thời tiết xấu cũng như các nút điều khiển đèn và đèn báo rẽ."

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "Khởi động động cơ"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "Đèn đỗ xe"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "Đèn chiếu gần"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "Đèn chiếu xa"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "Đèn xi nhan trái"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Đèn xi nhan phải"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Đèn cảnh báo"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Cần gạt nước kính chắn gió"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Tắt động cơ"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "Trong tình huống này, chúng ta sẽ xem xét một số tính năng của xe tải giúp bạn có thể vừa nhìn thấy mọi thứ xung quanh vừa được người khác nhìn thấy cùng một lúc."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Chúng ta sẽ kích hoạt các hệ thống chiếu sáng khác nhau và tìm hiểu khi nào cần sử dụng từng hệ thống."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Chúng tôi sẽ sử dụng đèn xi nhan trái và phải."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "Cuối cùng, chúng ta sẽ xem xét cách điều chỉnh cần gạt nước để đảm bảo chúng hoạt động hiệu quả trong các điều kiện lượng mưa khác nhau."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Hãy cùng tìm hiểu cách sử dụng các loại đèn khác nhau, cũng như cách điều khiển cần gạt nước kính chắn gió.<br><br>Đèn pha chiếu gần và chiếu xa đảm bảo tầm nhìn tốt về phía trước. Đèn xi nhan và đèn báo nguy hiểm được sử dụng để người tham gia giao thông khác có thể dự đoán các thao tác của bạn.<br><br>Cần gạt nước được sử dụng để giữ cho kính chắn gió sạch sẽ khỏi nước và các mảnh vụn khác.<font face=/font/big_bold.font><br><br>Khởi động động cơ, nhưng không được nhả phanh tay. </font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Cho đến nay, bạn chỉ sử dụng đèn chiếu sáng ban ngày. Chúng tự động bật khi bật chìa khóa điện và được sử dụng để tăng khả năng quan sát xe trong điều kiện bình thường. Tuy nhiên, hiện tại điều kiện thời tiết đã xấu đi, bạn sẽ cần sử dụng toàn bộ hệ thống đèn chiếu sáng.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_light@@ để bật đèn đỗ xe.</font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>Đèn đỗ xe chiếu sáng các đèn báo hiệu phía trước, bên hông và phía sau. Chúng được sử dụng khi bạn đỗ xe trong điều kiện ánh sáng yếu để các tài xế khác có thể nhìn thấy bạn.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_light@@ để chuyển sang đèn pha chiếu gần. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>Đèn chiếu gần giúp soi sáng con đường phía trước và cải thiện khả năng nhận diện xe của bạn trong điều kiện ánh sáng kém.<font face=/font/big_bold.font><br><br>Sử dụng @@imv_nrm_hblight@@ để chuyển sang đèn chiếu xa.</font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>Đèn pha chiếu xa giúp bạn nhìn rõ hơn trên đường trong điều kiện ánh sáng yếu.<br><br>Tuy nhiên, hãy cẩn thận khi sử dụng chúng, vì chúng có thể làm chói mắt những người tham gia giao thông khác, đặc biệt là những người lái xe ngược chiều. Hãy nhớ tắt đèn pha chiếu xa khi bạn đến gần các phương tiện khác.<font face=/font/big_bold.font><br><br>Sử dụng @@imv_nrm_hblight@@ để tắt đèn pha chiếu xa. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Bây giờ, chúng ta hãy xem xét đèn xi nhan. Chức năng của đèn xi nhan là cung cấp tín hiệu trực quan cho những người tham gia giao thông khác về việc chuyển làn hoặc thay đổi hướng.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_lblinker@@ để kích hoạt đèn xi nhan trái.</font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Bạn sẽ thấy đèn báo rẽ trái nhấp nháy trên bảng điều khiển. Đèn báo rẽ trái cũng nhấp nháy ở phía bên trái của xe tải.<font face=/font/big_bold.font><br><br>Bây giờ hãy nhấn @@imv_nrm_lblinker@@ để tắt đèn báo rẽ trái. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Bạn nên đưa ra tín hiệu báo hiệu thay đổi hướng đi kịp thời để những người tham gia giao thông khác có thời gian dự đoán thao tác của bạn và điều chỉnh cách lái xe cho phù hợp.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_rblinker@@ để kích hoạt đèn xi nhan rẽ phải.</font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>Trên bảng điều khiển, đèn báo rẽ phải đang nhấp nháy. Đồng thời, đèn xi nhan bên phải xe tải cũng đang nhấp nháy.<font face=/font/big_bold.font><br><br>Bây giờ hãy nhấn @@imv_nrm_rblinker@@ để tắt đèn xi nhan phải. </font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>Công tắc đèn báo nguy hiểm được biểu thị bằng logo hình tam giác màu đỏ. Những đèn này là một phần quan trọng của an toàn giao thông và chỉ nên được sử dụng khi cần thiết. Chức năng này kích hoạt cả đèn xi nhan trái và phải cùng một lúc.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_flasher4way@@ để bật đèn báo nguy hiểm.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Cả hai đèn xi nhan đều đang nhấp nháy, báo hiệu đèn báo nguy hiểm đang bật. Đồng thời, đèn xi nhan ở cả hai bên xe tải cũng đang nhấp nháy.<br><br>Đèn báo nguy hiểm thường được sử dụng khi xe tải dừng ở những nơi mà bình thường nó không nên dừng, chẳng hạn như bên đường do sự cố kỹ thuật hoặc cơ khí. Chúng cũng có thể được sử dụng để cảnh báo người lái xe phía sau về tình trạng giao thông dừng phía trước.<font face=/font/big_bold.font><br><br>Bây giờ, hãy nhấn @@imv_nrm_flasher4way@@ để tắt đèn báo nguy hiểm. </font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Giờ chúng ta hãy chuyển sang phần cần gạt nước kính chắn gió. Cần gạt nước kính chắn gió được sử dụng để loại bỏ nước mưa và các mảnh vụn khác khỏi kính chắn gió của xe. Chức năng chính của chúng là giữ cho kính chắn gió sạch sẽ và trong suốt. Cần gạt nước có nhiều tốc độ khác nhau.<br><br><font face=/font/big_bold.font>Nhấn @@imv_nrm_wipers@@ để đặt cần gạt nước kính chắn gió ở chế độ gián đoạn. </font>@@aca_goal_tip@@ Trong chế độ Sự nghiệp, bạn có thể sử dụng cảm biến mưa để tự động kích hoạt cần gạt nước kính chắn gió khi trời mưa. Bạn có thể tìm thấy cài đặt @@rain_sensor@@ trong Màn hình Tùy chọn - 'Lối chơi'."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Cài đặt này cho phép cần gạt mưa hoạt động định kỳ. Điều này hữu ích khi lượng mưa rất nhỏ.<br><br>Như bạn thấy, mưa quá to và cần gạt mưa không thể xử lý kịp lượng mưa rơi trên kính chắn gió.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_wipers@@ một lần nữa để chuyển cần gạt mưa sang chế độ tốc độ thấp. </font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Hiện tại cần gạt nước đang hoạt động với tốc độ ổn định để gạt sạch nước mưa.<font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_wipers@@ một lần nữa để thiết lập chế độ tốc độ cao.</font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "Bạn có thể thấy cần gạt nước đang hoạt động nhanh hơn nhiều để làm sạch kính chắn gió, giúp tầm nhìn tối đa. <font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_wipers@@ để tắt cần gạt nước.</font>@@aca_goal_tip@@ Bạn cũng có thể sử dụng chức năng @@o_im_wipers_back@@ để chuyển đổi ngược lại giữa các cài đặt tốc độ gạt nước. Kiểm tra Màn hình Tùy chọn - '@@options_bindings_screen@@' - để xem và/hoặc thay đổi các điều khiển tương ứng."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Bạn có thể thấy cần gạt nước đang hoạt động nhanh hơn nhiều để làm sạch kính chắn gió, giúp tầm nhìn tối đa. <font face=/font/big_bold.font><br><br>Nhấn @@imv_nrm_wipersback@@ nhiều lần cho đến khi cần gạt nước tắt.</font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Tắt đèn và tắt máy. </font>"
#@}

#+ Book 1 Scenario 2_01
#@{

#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Lái xe zic-zắc qua các cọc tiêu"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "Trong tình huống này, chúng ta sẽ học cách điều khiển xe tải tránh các cọc tiêu giao thông bằng cách sử dụng gương chiếu hậu."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Tuân theo hướng dẫn"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Kiểm tra gương"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Bắt đầu"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "Điều khiển xe tải"



	key[]: "aca_goal_book1_2_01_check1"
	val[]: "Vào khu vực lái xe zic-zắc"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "Tránh các cọc tiêu giao thông"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "Lái xe zic-zắc qua các cọc tiêu giao thông"
