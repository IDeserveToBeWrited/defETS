#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Lựa chọn các chủ đề được hiển thị trên nền khi bạn duyệt qua menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Cho phép chọn ngẫu nhiên chủ đề hình nền mỗi khi bạn khởi động trò chơi."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Thiết lập độ trễ sau đó các phần tử trên màn hình nền sẽ mờ dần."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, bạn sẽ bắt đầu cảm thấy mệt mỏi theo thời gian.<br><br>Việc không nghỉ ngơi sẽ dẫn đến vi phạm luật giao thông."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, bạn phải tuân thủ luật giao thông, nếu không sẽ có nguy cơ bị phạt. Nguy cơ này tăng cao khi ở gần xe cảnh sát, máy đo tốc độ và camera giao thông."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh độ dài trung bình của các công việc được cung cấp."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Chọn giới hạn tốc độ bạn muốn hiển thị trên widget chỉ đường."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Tốc độ hiện tại trên hệ thống định vị sẽ chuyển sang màu đỏ khi tốc độ giới hạn bị vượt quá."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi bạn đến điểm đến, một tiện ích sẽ hiển thị cho phép bạn bỏ qua bước đỗ xe."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Luôn ẩn tất cả widget."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Giữ cho cả hai gương chiếu hậu HUD luôn ẩn."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Duy trì trạng thái ẩn cho toàn bộ thông báo nhận được."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Hiển thị thông số xe trước khi nhận chở một đơn hàng nặng."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Chọn cách căn chỉnh bản đồ thế giới."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Chọn cách khám phá Bản đồ Thế giới:<br>- \"Khám phá lân cận\" đánh dấu một khu vực rộng lớn hơn là đã được khám phá.<br>- \"Khám phá chính xác\" chỉ hiển thị các khu vực ngay xung quanh người chơi."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Chọn cách hiển thị điều hướng."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi cách định tuyến điều hướng:<br>- Chế độ điều hướng \"Tốt nhất\" chọn tỷ lệ hiệu quả nhất giữa độ dài và thời gian của tuyến đường, cố gắng tránh các giao lộ có đèn giao thông, v.v.<br>- Chế độ điều hướng \"Ngắn nhất\" luôn chọn tuyến đường ngắn nhất có thể.<br>- Chế độ điều hướng \"Đường nhỏ\" chọn tránh đường cao tốc bất cứ khi nào có thể."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ khó khi đỗ xe:<br>- \"Luôn lựa chọn\" cho phép bạn tự chọn khi đến điểm trả hàng.<br>- \"Đỗ xe an toàn\" không yêu cầu các thao tác lùi xe.<br>- \"Đỗ xe điêu luyện\" thường sẽ yêu cầu các thao tác lùi xe thử thách hơn."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Điều chỉnh xác suất gặp các sự cố nguy hiểm trên đường xung quanh bạn, bao gồm tai nạn, xe hỏng, chướng ngại vật, v.v."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Điều chỉnh xác suất gặp phải đường vòng thay đổi lộ trình khi đang lái xe làm việc."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Điều chỉnh xác suất xảy ra thời tiết xấu."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn có hiển thị thông tin múi giờ bên cạnh thời gian hiện tại hay không."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Cho phép hiển thị các đoạn phim cắt cảnh trong game, thường được trình chiếu sau khi mua xe tải, nâng cấp gara hoặc trong quá trình đón khách."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn xem có hiển thị các vật cản bán trong suốt trên những con đường không thể đi qua hay không."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Đảo ngược trục Y của chuột khi điều khiển camera trong game."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Chọn loại hộp số:<br>- \"Tự động đơn giản\" cho phép sử dụng chân ga và phanh để điều khiển chuyển động tiến và lùi.<br>- \"Tự động thực sự\" yêu cầu thao tác bằng tay để chuyển đổi giữa số tiến và số lùi.<br>- \"Tuần tự\" yêu cầu sang số bằng tay với các nút lên/xuống số.<br>- \"Cần số chữ H\" yêu cầu sử dụng bộ điều khiển có cần gạt số để chọn số bằng tay."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Kích hoạt tính năng này sẽ cho phép \"bỏ qua các cấp số\" - bỏ qua các cấp số khi cần thiết hoặc khả thi để tránh phải sang số ở mọi cấp số trong hộp số."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Tự động đưa vô lăng trở về vị trí trung tâm khi sử dụng bàn phím hoặc bộ điều khiển.<br><br>Việc tắt tính năng này có nghĩa là bạn sẽ phải tự điều chỉnh vô lăng về vị trí trung tâm sau mỗi khúc cua. Tính năng này chỉ khả dụng khi chơi bằng bàn phím hoặc gamepad."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh bán kính hoạt ảnh xoay của vô lăng."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh cường độ phanh."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ ổn định của xe bằng cách hạ thấp trọng tâm."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ ổn định của rơ móc bằng cách hạ thấp trọng tâm xe."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi cường độ mô-men xoắn được tạo ra từ hệ thống truyền động.<br><br>Tăng cài đặt này sẽ làm tăng cảm giác xe \"xoắn\" sang phải."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ cứng của hệ thống treo khung gầm."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ cứng của hệ thống treo cabin/khoang ngủ."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh cường độ của các gờ nổi trên bề mặt được tạo ra theo thuật toán để tạo cảm giác không hoàn hảo cho đường sá và các địa hình khác.<br><br>Tùy thuộc vào các cài đặt hệ thống treo và camera khác, hiệu ứng cảm nhận có thể rõ rệt hơn hoặc ít rõ rệt hơn."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Kích hoạt cơ chế nối rơ-moóc nâng cao, yêu cầu độ chính xác cao hơn khi căn chỉnh mâm kéo của xe tải với chốt chịu lực của rơ-moóc.<br><br>Khi tắt, việc nối rơ-moóc sẽ trở nên dễ dàng hơn nhiều vì không có va chạm giữa chốt chịu lực và mâm kéo."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn có hiển thị hiệu ứng chuyển động của dây cáp rơ-moóc hay không, và loại dây cáp nào sẽ được hiển thị.<br><br><color value=@@clr_txt_d@@>Việc bật dây cáp trên nhiều phương tiện có thể ảnh hưởng đến hiệu năng của các máy tính đời cũ."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Cho phép giới hạn tốc độ điện tử của xe tải ở mức 90 km/h (56 mph).<br><br>Các công việc từ World of Trucks đều bật tính năng này vĩnh viễn."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Khi kích hoạt và cần gạt nước được đặt ở vị trí thứ nhất, gạt nước sẽ tự động bật và điều chỉnh tốc độ theo điều kiện thực tế."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Kích hoạt tự động gài guốc hãm thủy lực khi phanh."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, xe sẽ hỗ trợ khởi hành trên dốc bằng cách giữ phanh, đảm bảo quá trình khởi động diễn ra êm mượt."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Kích hoạt tự động gài phanh động cơ khi phanh."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, động cơ sẽ khởi động ngay khi nhấn cần ga."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, phanh tay của xe sẽ tự động được sử dụng (sau khi sử dụng phà, kéo xe đi bảo dưỡng, di chuyển nhanh, v.v.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Tự động triển khai trục nâng khi cần thiết tùy theo trọng tải xe."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, xe sẽ giữ ga ở mức thấp theo mặc định. Sau khi nhấn nhanh nút ga hai lần, xe sẽ giữ ga tối đa cho đến khi nhả nút ga.<br><br>Chỉ ảnh hưởng đến nhập từ bàn phím."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Mô phỏng việc mất hơi khi dùng phanh nhiều giống như ngoài đời thật.<br><br>Khi được kích hoạt, bạn sẽ phải kiểm soát áp suất hơi của mình khi xuống dốc hoặc các khúc cua chậm có sử dụng phanh nhiều."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi tắt, mức tiêu thụ nhiên liệu không phụ thuộc vào phong cách lái hay điều kiện đường xá.<br><br>Khi bật, mức tiêu thụ sẽ thay đổi dựa trên các yếu tố như trọng lượng hàng, lực cản lăn, địa hình và phong cách lái. Kỹ năng @@skill_mechanical_title@@ sẽ không còn tác dụng."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, ABS sẽ ngăn bó bánh xe nhằm giữ kiểm soát và cải thiện khả năng phanh."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, xe sẽ tự động phanh từng bánh để ngăn ngừa hiện tượng trượt bánh, thiếu lái hoặc thừa lái, giúp duy trì khả năng kiểm soát."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, xe sẽ khóa vi sai nếu bánh xe bắt đầu trượt để cải thiện độ bám đường."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh mức tăng hoặc giảm tốc độ của hệ thống kiểm soát hành trình khi nhấn nút tương ứng."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh dung sai của hệ thống điều khiển hành trình để duy trì tốc độ mục tiêu."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, hệ thống điều khiển hành trình sẽ tự động điều chỉnh tốc độ để duy trì khoảng cách an toàn với xe phía trước."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Kích hoạt phanh khẩn cấp nếu hệ thống cảm biến thấy sắp có va chạm xảy ra.<br>Chọn để hệ thống chỉ phản hồi với các phương tiện hoặc với tất cả chướng ngại vật."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Lựa chọn các chế độ hỗ trợ giữ làn đường:<br>- Chế độ \"Cảnh báo lệch làn đường\" sẽ cảnh báo bằng âm thanh khi bạn sắp rời khỏi làn đường.<br>- Ngoài cảnh báo bằng âm thanh, chế độ \"Hỗ trợ giữ làn đường\" cũng tự động điều khiển vô lăng để tránh xe bị lệch khỏi làn đường.<br><br>Cả hai chế độ chỉ hoạt động ở tốc độ trên 55 km/h (~35 mph).<br>Hệ thống hỗ trợ giữ làn đường cũng xem xét việc bạn sử dụng đèn báo rẽ trước khi kích hoạt."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Kích hoạt chức năng cảm biến điểm mù, nếu xe của bạn được trang bị tính năng này."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt và đèn pha được đặt ở vị trí đầu tiên, đèn pha sẽ tự động bật trong điều kiện ánh sáng yếu."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt và đèn pha được bật với chế độ chiếu xa, xe sẽ tự động giảm độ sáng đèn chiếu xa khi phát hiện xe ngược chiều hoặc xe ở gần phía trước."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, đèn báo rẽ sẽ tự động tắt sau mỗi lần rẽ khi vô lăng được xoay trở lại vị trí trung tâm."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, một số phụ kiện nội thất sẽ phản ứng với chuyển động vật lý của xe (đồ trang trí treo, tượng nhỏ lắc đầu, v.v.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Cho phép điều chỉnh góc quay ngang của camera nội thất dựa trên thao tác lái."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ phản hồi của tính năng \"xoay camera theo hướng lái\" dựa trên thao tác đánh lái."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi hành vi của tính năng \"xoay camera theo hướng lái\" khi lùi xe."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, camera bên trong sẽ hướng nhìn sang trái hoặc phải tùy thuộc vào việc sử dụng đèn báo rẽ."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Khi được kích hoạt, camera bên trong xe sẽ phản ứng với chuyển động của xe."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Thay đổi độ nhạy của camera bên trong xe đối với chuyển động của xe."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Điều chỉnh phạm vi xoay của camera bên trong dựa trên chuyển động của xe."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Thiết lập độ trễ trước khi camera tự động căn giữa lại.<br><br>Để chức năng này được kích hoạt, xe phải đang di chuyển với tốc độ đáng kể. Chỉ áp dụng cho camera bên trong và camera theo dõi khi di chuyển về phía trước và camera nghiêng ra ngoài khi di chuyển lùi."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Thiết lập tốc độ di chuyển camera. Được sử dụng bởi tính năng tự động căn giữa camera và chuyển đổi giữa các thiết lập camera nội thất có sẵn."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Xác định cách hoạt động của tính năng thu phóng bên trong: giữ nút để thu phóng tạm thời, hoặc nhấn một lần để bật/tắt tính năng này." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn ngôn ngữ sẽ hiển thị trong suốt trò chơi."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Thay đổi các thiết lập sẵn về tiền tệ và đơn vị dựa trên khu vực đã chọn."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được bật, các thành phố và quốc gia sẽ được hiển thị bằng ngôn ngữ bạn đã chọn."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, các thành phố và quốc gia sẽ được hiển thị bằng cả ngôn ngữ bạn đã chọn và ngôn ngữ bản địa của khu vực đó trên bản đồ."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn loại tiền tệ bạn muốn sử dụng."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn định dạng giữa 12 giờ hoặc 24 giờ."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn đơn vị đo khoảng cách bạn muốn hiển thị."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn đơn vị khối lượng nào bạn muốn hiển thị."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn đơn vị nhiệt độ nào để hiển thị"

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Hãy chọn đơn vị áp suất bạn muốn hiển thị."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Chọn đơn vị đo thể tích bạn muốn hiển thị."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Hãy chọn đơn vị tiêu thụ nào bạn muốn hiển thị."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, việc sử dụng phím \"Kích hoạt\" (@@imv_nrm_activate@@) sẽ mở cửa sổ trò chuyện trong các phiên Đoàn xe."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, thanh nhập liệu trò chuyện sẽ đóng sau khi tin nhắn được gửi đi."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được bật, tin nhắn trò chuyện sẽ mờ dần sau vài giây sau mỗi tin nhắn."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Thay đổi thời gian hiển thị tin nhắn trò chuyện trước khi chúng biến mất."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Khi được kích hoạt, tên người chơi sẽ hiển thị phía trên phương tiện của họ trong các phiên Đoàn xe."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Mở menu nâng cao để thiết lập các câu trả lời nhanh cho cuộc trò chuyện trong các phiên Đoàn xe."

