	val[]: "NỘI DUNG" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Kết nối" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks phát hiện có nội dung trò chơi mới. Kết nối với World of Trucks để trải nghiệm nó" #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Trực tuyến" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Điều chỉnh tất cả những thiết lập liên quan đến World of Trucks" #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Bạn có chắc muốn dừng quá trình đăng nhập?<br><br> Bạn có thể truy cập những nội dung trực tuyến sau này bằng cách thay đổi thiết lập trực tuyến được đặt ở màn hình chính" #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "ĐANG KẾT NỐI NỘI DUNG" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Đang kết nối nội dung..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Kết nối thất bại : $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Tài khoản Steam bạn dùng để đăng ký DLC này khác với tài khoản bạn đã sử dụng để tạo tài khoản trên trang World of Trucks hoặc để tạo tài khoảng game. Hãy thử đổi tài khoản Steam của bạn sau đó thử lại." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Tài khoản Steam bạn dùng để đăng ký DLC này đã được liên kết với một tài khoản World of Trucks khác. Để đăng ký DLC với tài khoản hiện tại bạn cần một tài khoản Steam chưa kết nối với tài khoản World of Trucks nào." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token đã hết hạn. Vui lòng thử lại sau" #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Số sê-ri dùng để kích hoạt DLC không hợp lệ, hãy liên hệ hỗ trợ để được hướng dẫn: support@scssoft.com " #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Có lỗi xảy ra trong quá trình đăng kí game, hãy thử lại sau" #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "THÀNH CÔNG" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "THÔNG TIN" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "TRỰC TUYẾN" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "TRÌNH DUYỆT NỘI DUNG" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Chúc mừng! Các DLC đã chọn đã kết nối thành công đến tài khoản World of Trucks của bạn." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Không thể kết nối nội dung vì tài khoản Steam hiện tại đã liên kết với một tài khoản World of Trucks khác." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Một vài DLC kết nối thật bại.<br> Di chuột đến từng dâu chấm than để biết thêm chi tiết." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Đang đăng ký $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Hồ sơ hiện tại chưa được kết nối với World of Trucks hoặc trò chơi đang chạy ở chế độ ngoại tuyến. Hãy chỉnh sửa hồ sơ để kết nối." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Nhấp chuột để bỏ qua"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/$TOTAL_CONTENT$ hiện tại tương thích với các DLC đã kết nối. Nếu một vài DLC không được kết nối tới World of Trucks, một số tính năng của chúng có thể bị mất." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Chúc mừng! <color value=@@clr_txt@@>Tất cả các nội dung đã được kết nối đến World of Trucks! Bây giờ bạn có thể sử dụng các tính năng của nó." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Không thể kết nối đến World of Trucks vì tải khoản Steam hiện tại không khớp với tài khoản Steam đã liên kết với tài khoản World of Trucks tương ứng." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Đã kết nối" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Không kết nối" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Không thể lấy thông tin về những nội dung đã sở hữu" #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Không thể thu thập thông tin về những nội dung đã kết nối." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Không thể thu thập thông tin về tài khoản đang sử dụng" #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Để sau" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Không thể đăng kí DLC này vì không có bản quyền trọn đời cho DLC này được tìm thấy thông qua Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Không có sở hữu vĩnh viễn" #+ The state of the content that cannot be connected due to invalid license.
#@}


