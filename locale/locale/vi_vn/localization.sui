	key[]: "controller_subtype"
	val[]: "Kiểu điều khiển phụ" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "Vô Lăng" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
	val[]: "Tay điểu khiển, cần điều khiển" #+ Gamepad like device. Value of the input controls speed of turning of the vehicle wheels.
#@}


	key[]: "steer_sens"
