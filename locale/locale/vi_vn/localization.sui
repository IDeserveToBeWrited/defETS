#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "Phản hồi lực" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "Khôi phục mặc định" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Tổng mức phản hồi" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "Trả về giữa khi tốc độ cao" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "Trả về giữa khi tốc độ thấp" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "Ma sát nội" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "Tiếng dội động cơ" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "Bề mặt địa hình" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "Xóc" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "Va chạm" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "Tiếng mài hộp số" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "Độ trượt thiếu lái" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "Hệ thống lái trợ lực" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "Rung bề mặt địa hình" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "Rung xóc" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Rung va chạm" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

	key[]: "ffb_lut_usage_hint"
	val[]: "Trò chơi dùng cơ chế phản hồi lực tùy chỉnh LUT và hiện không có hỗ trợ thêm. Trong trường hợp có vấn đề với phản hồi lực hãy xóa tệp đó từ thư mục hồ sơ người dùng của bạn!" #+ Hint telling player that the game is using custom force feedback LUT loaded from profile folder and to remove it in case of problems.
#@}

