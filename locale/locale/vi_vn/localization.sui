#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "ĐỒ HỌA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Đồ họa" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Điều chỉnh cài đặt đồ họa bằng các thiết lập được tinh chỉnh kỹ lưỡng để tùy chỉnh hiệu suất hình ảnh của trò chơi theo sở thích của bạn."

	key[]: "apply"
	val[]: "Áp dụng" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Nền bàn làm việc" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "Hiển thị" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "CHẤT LƯỢNG HÌNH ẢNH" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "KẾT CẤU" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "PHẢN CHIẾU" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "ĐỔ BÓNG" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ÁNH SÁNG" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "XỬ LÝ HẬU KỲ" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "MÔI TRƯỜNG" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Chế độ toàn màn hình" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Độ sáng / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Thiết đặt" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Độ phân giải" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Tốc độ làm mới" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Giới hạn FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Giới hạn FPS khi chạy nền" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Làm mới mặc định" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Đồng bộ hóa theo chiều dọc" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Tiết kiệm (Tiết kiệm điện cho laptop)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "CÀI ĐẶT ĐỒ HỌA ĐƠN GIẢN" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ÁP DỤNG HIỆU CHỈNH KHÁCH HÀNG" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "CÀI ĐẶT ĐỒ HỌA NÂNG CAO" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Cài đặt đồ họa đơn giản/nâng cao" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Ẩn cài đặt nâng cao" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Hiện cài đặt nâng cao" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Tỷ lệ hiển thị" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Khử răng cưa" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Độ sắc nét luma TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Điều chỉnh TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Độ rõ thích ứng" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Luôn mềm mại" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Luôn sắc nét" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Đổ bóng chiều sâu môi trường (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Dải rộng cao (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Độ sâu trường ảnh (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Tia nắng" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Điều chỉnh màu sắc" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Tỉ lệ phản chiếu" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Phản ánh chi tiết" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Chất lượng rau củ" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Mật độ cỏ" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Chất lượng đổ bóng"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Kích thước chi tiết đổ bóng" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Bóng ở xa" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Bóng tối bên trong xe" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Chất lượng hiệu ứng thời tiết"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Chất lượng gương" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Độ phân giải kính" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Khoảng cách gương" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Chất lượng kết cấu" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Lọc dị hướng" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Bản đồ pháp tuyến" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Đèn giao thông" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Đèn pha phụ" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Phạm vi chiếu sáng của đèn" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Người đi bộ" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Cài đặt hiển thị đã được thay đổi.<br>Bạn có muốn giữ nguyên các cài đặt này không?"

	key[]: "reverting_in"
	val[]: "Hoàn tác sau" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "giây" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Khi được kích hoạt, trò chơi sẽ hiển thị ở chế độ toàn màn hình."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Điều chỉnh độ sáng tổng thể của trò chơi cho phù hợp với màn hình của bạn. Trên các màn hình tương thích HDR, tùy chọn hiệu chỉnh HDR cũng sẽ có sẵn trong cài đặt này."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Thay đổi độ phân giải của trò chơi."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Thay đổi tốc độ làm mới mục tiêu của trò chơi."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Chế độ này đồng bộ tốc độ khung hình với màn hình để chống xé hình. Chế độ Tiết kiệm cũng giảm một nửa khung hình để giảm tiêu thụ điện năng."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Thiết lập tốc độ khung hình tối đa cho phép của trò chơi.<br><br>Đặt giá trị bằng 0 sẽ vô hiệu hóa chức năng này."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Thiết lập tốc độ khung hình tối đa cho phép của trò chơi khi nó được thu nhỏ ở chế độ nền.<br><br>Đặt giá trị bằng 0 sẽ vô hiệu hóa chức năng này."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Chuyển đổi giữa các thiết lập đồ họa đơn giản (cài đặt sẵn) hoặc các thiết lập đồ họa nâng cao (khả năng thay đổi các thông số riêng lẻ)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Cải thiện độ chi tiết của đồ họa bằng cách dựng hình trò chơi ở độ phân giải nội bộ cao hơn, giúp giảm răng cưa và tăng cường độ sắc nét.<br>Ví dụ: chọn tỷ lệ hiển thị cao hơn sẽ giúp hình ảnh rõ nét hơn và ít bị nhòe hơn, giúp trò chơi trông đẹp hơn nhưng sẽ tiêu tốn tài nguyên hệ thống hơn.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động rất lớn đến hiệu năng."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Lựa chọn các phương pháp khử răng cưa tốc độ cao giúp làm mịn các đường răng cưa trong trò chơi:<br>- SMAA lấy mẫu mỗi điểm ảnh nhiều lần (tùy thuộc vào chất lượng được chọn) tại các vị trí khác nhau trong khung hình và tính trung bình các mẫu đó để tạo ra hình ảnh cuối cùng.<br>- TAA chỉ lấy mẫu mỗi điểm ảnh một lần trên mỗi khung hình, nhưng nó lấy mẫu ở các vị trí khác nhau và trên các khung hình khác nhau.<br>- Để có kết quả tốt nhất, bạn cũng có thể chọn kết hợp cả hai phương pháp, nhưng sẽ làm giảm hiệu năng.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Thêm hiệu ứng đổ bóng mềm vào các kẽ hở và những vật thể ở gần nhau, giúp cải thiện độ chi tiết và chiều sâu đồ họa cho toàn bộ thế giới trong trò chơi.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Lựa chọn các mức thiết lập sẵn cho TAA:<br>- \"Luôn làm mềm\" sẽ giảm bớt hiện tượng nhấp nháy nhưng làm hình ảnh nhòe hơn - tùy chọn này phù hợp cho người dùng PC có bật tính năng siêu lấy mẫu (supersampling) hoặc dùng màn hình DPI cao, cũng như người dùng TV 1080p ngồi xa màn hình.<br>- \"Luôn sắc nét\" sẽ khiến hình ảnh sắc nét hơn nhưng xuất hiện nhiều hiện tượng nhấp nháy hơn - đây có lẽ là lựa chọn tốt nhất cho độ phân giải dưới 1080p, chẳng hạn như trên laptop hoặc Steam Deck.<br>- \"Độ rõ nét thích ứng\" sẽ tự động tắt tính năng làm nhiễu (jitter) của TAA khi camera ở trạng thái tĩnh.<br><br><color value=@@clr_txt_d@@>Thiết lập này chỉ có thể sử dụng khi TAA được chọn làm giải pháp khử răng cưa."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh cường độ làm sắc nét độ sáng của TAA.<br><br><color value=@@clr_txt_d@@>Cài đặt này chỉ có thể được sử dụng khi TAA được chọn làm giải pháp khử răng cưa."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Khi được bật, các khu vực xa trên bản đồ có thể được làm mờ một cách nhân tạo để tạo hiệu ứng giảm độ nét thực tế ở hậu cảnh."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Khi được kích hoạt, các tia sáng có thể được nhìn thấy khi nhìn vào mặt trời, hoặc nhìn vào mặt trời xuyên qua các vật thể như cây cối, nhà cửa hoặc phương tiện giao thông."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Khi được kích hoạt, màu sắc trong trò chơi sẽ được điều chỉnh linh hoạt vì lý do thẩm mỹ. Các cảnh sẽ phù hợp hơn với thời gian trong ngày và điều kiện thời tiết, màu sắc của phương tiện và các vật thể khác có thể rực rỡ hơn, v.v."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Cải thiện hình ảnh phản chiếu bằng cách điều chỉnh độ rõ nét và tính chân thực của các hình ảnh phản chiếu trong game, đồng thời áp dụng phương pháp khử răng cưa tốt hơn . <br><br><color value=@@clr_txt_d@@>Các thay đổi đối với thiết lập này sẽ chỉ có hiệu lực sau khi khởi động lại trò chơi thủ công."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh mức độ chi tiết của hình ảnh phản chiếu trên bề mặt xe, cửa kính và các bề mặt phản chiếu khác như vũng nước, đường ướt hoặc các vùng nước hở.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng.<br><br>Các thay đổi đối với thiết lập này sẽ chỉ có hiệu lực sau khi khởi động lại trò chơi thủ công.\""

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh độ chi tiết và độ phức tạp của cây cối.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh mật độ cỏ nhìn thấy ở hai bên đường.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh chất lượng bóng đổ của mặt trời hoặc mặt trăng.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Cho phép hiển thị bóng đổ ngay cả từ các vật thể ở rất xa.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Cho phép tạo bóng đổ động vào ban đêm trong nội thất xe.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh chất lượng các hiệu ứng thời tiết, chẳng hạn như phản chiếu."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh chất lượng hình ảnh phản chiếu trên gương xe (độc lập với cài đặt phản chiếu).<br><br><color value=@@clr_txt_d@@>Cài đặt này thường có tác động vừa phải đến hiệu năng."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh độ phân giải của hình ảnh hiển thị trên gương chiếu hậu xe của bạn."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh khoảng cách mà các đối tượng bắt đầu hiển thị trong gương.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động lớn đến hiệu năng."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh chất lượng của một số họa tiết được áp dụng cho các đối tượng và bề mặt trong trò chơi."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Cải thiện độ sắc nét của các chi tiết, đặc biệt là những chi tiết được nhìn từ xa hoặc ở góc nghiêng.<br><br><color value=@@clr_txt_d@@>Những thay đổi đối với cài đặt này sẽ chỉ có hiệu lực sau khi khởi động lại trò chơi theo cách thủ công."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Tạo hiệu ứng chi tiết hình học cho vỉa hè, mặt đường và các vật thể khác để cải thiện ngoại quan của chúng.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng.<br><br>Các thay đổi đối với thiết lập này sẽ chỉ có hiệu lực sau khi khởi động lại trò chơi thủ công."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Cho phép ánh sáng từ đèn pha của các phương tiện khác trong giao thông chiếu vào."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Cho phép chiếu sáng từ đèn phụ của các phương tiện khác trong giao thông, chẳng hạn như đèn xi nhan, đèn phanh, v.v."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Điều chỉnh khoảng cách mà từ đó có thể nhìn thấy các nguồn sáng nhân tạo.<br><br><color value=@@clr_txt_d@@>Thiết lập này thường có tác động vừa phải đến hiệu năng."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Cho phép người đi bộ xuất hiện trong thế giới game."
