	key[]: "controller"
	val[]: "Điều khiển" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "LOẠI ĐẦU VÀO" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "BỘ ĐIỀU KHIỂN" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "PHẢN HỒI BỘ ĐIỀU KHIỂN" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "TRỤC ĐIỀU KHIỂN" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Chỉ dùng bàn phím" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Bàn phím" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Bẻ lái bằng chuột" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Bẻ lái bằng chuột có cả bàn đạp" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Không có" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "Cài đặt nhanh tay cầm hoặc vô lăng"

#+ Selection of the controller subtype
