#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Gói DLC (bản mở rộng chính thức) bắt buộc $DEPENDENCY_NAME$ bị thiếu. Để file lưu này hoạt động chính xác, gói DLC này cần phải có và được kích hoạt trên máy tính này. Bạn cần khắc phục sự cố trước khi có thể tải file lưu này." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Gói DLC tùy chọn (bản mở rộng chính thức của trò chơi) $DEPENDENCY_NAME$ bị thiếu. Nếu bạn không mong đợi điều này, vui lòng kiểm tra trạng thái của DLC.<br><br>Nếu không, bạn vẫn có thể tải file lưu, tuy nhiên một số chức năng do DLC cung cấp có thể bị mất." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "MOD $DEPENDENCY_NAME$ bị thiếu hoặc bị vô hiệu hóa. Nếu bạn không mong muốn điều này, vui lòng kiểm tra trạng thái của MOD. Bạn có thể thử tải lại file lưu game. Tuy nhiên, tùy thuộc vào chức năng của MOD, có thể game sẽ không tải được hoặc gây ra các sự cố khác." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Bản mod $DEPENDENCY_NAME$ không tương thích với phiên bản trò chơi của bạn. Điều này có nghĩa là tác giả của bản mod này đã đánh dấu bản mod chỉ tương thích với một số phiên bản trò chơi nhất định và phiên bản hiện tại của trò chơi không nằm trong số đó.<br><br>Các giải pháp:<br>- Hãy thử tìm một phiên bản MOD được cập nhật và tương thích với phiên bản trò chơi hiện tại.<br>- Cập nhật hoặc hạ cấp trò chơi lên phiên bản tương thích với bản mod.<br><br>Bạn có thể thử tải lại file save. Tuy nhiên, bản mod sẽ không được tải và tùy thuộc vào những gì bản mod đã làm, việc tải có thể thất bại hoặc gây ra các vấn đề khác." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "CÁC YẾU TỐ PHỤ THUỘC BỊ MẤT" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "CHI TIẾT" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Mở trang workshop"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Bản lưu này phụ thuộc vào các DLC hoặc MOD hiện đang bị thiếu. Chúng được liệt kê bên dưới. Bằng cách chọn một mục trong danh sách, bạn có thể xem thêm thông tin về từng mục cụ thể." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Tệp lưu này phụ thuộc vào ít nhất một DLC hoặc MOD bắt buộc. Bạn cần khắc phục sự cố đó trước khi có thể tải bản lưu này." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Hủy tải" #+ Abort loading button.

	key[]: "type"
	val[]: "Loại" #+ Type column.

	key[]: "dependency_name"
	val[]: "Tên sự phụ thuộc" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "MOD tại máy" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "MOD Steam Workshop" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "DLC tùy chọn" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "DLC bắt buộc" #+ DLC that is required to load save that is depending on it.
#@}

