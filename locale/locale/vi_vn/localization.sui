	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Việc tải DLC mất nhiều thời gian hơn dự kiến. Bạn có muốn tiếp tục chờ không?<br><br>Nếu bạn tiếp tục, quá trình tải sẽ tiếp tục diễn ra trong nền."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Bạn đã có quyền truy cập vào một số DLC. Bạn có muốn quay lại màn hình chính để truy cập nội dung mới không?<br><br>Tiến trình của bạn sẽ được lưu tự động."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "Bạn đã mất quyền truy cập vào một số DLC. Bạn sẽ được đưa trở lại Màn hình Tiêu đề để xem các thay đổi về nội dung.<br><br>Tiến trình của bạn sẽ được lưu tự động."
#@}

