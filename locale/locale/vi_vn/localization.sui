#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Ảnh chụp màn hình có dung lượng quá lớn. Vui lòng thử giảm độ phân giải màn hình." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Ảnh chụp màn hình đã bị hỏng hoặc không hỗ trợ." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Độ phân giải của ảnh chụp màn hình quá cao. Vui lòng thử giảm độ phân giải màn hình." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Dịch vụ đã từ chối ảnh chụp màn hình." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Tài khoản này không được phép tải lên ảnh chụp màn hình." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Có một thao tác tải lên đồng thời vào cùng một slot này." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Chức năng tải lên hiện đang bị vô hiệu hóa. Vui lòng thử lại sau." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Đã xảy ra lỗi không xác định trong quá trình tải lên. Vui lòng thử lại sau." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Ảnh chụp màn hình lớn hơn kích thước tối đa cho phép của $LIMIT$ và đã được thay đổi kích thước." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Tệp ảnh chụp màn hình có kích thước lớn hơn kích thước tối đa cho phép là $LIMIT$KB và đã được thay đổi kích thước." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

