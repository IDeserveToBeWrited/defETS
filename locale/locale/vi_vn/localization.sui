#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Tiếp tục ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Chào mừng bạn đến với Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Cuối cùng bạn cũng có cơ hội trải nghiệm công việc mơ ước của mình - lái một chiếc xe tải to lớn!"

	key[]: "intro_3"
	val[]: "Công ty vận tải của bạn đã chính thức đi vào hoạt động, nhưng tiếc là bạn lại thiếu tiền để mua xe tải. Hiện tại, bạn sẽ phải làm việc cho các công ty khác với tư cách là tài xế tự do."

	key[]: "intro_4"
	val[]: "Nhiệm vụ của bạn là vận chuyển an toàn lô hàng $JOB_CARGO$ đến bến của $JOB_TARGET_COMPANY$ tại $JOB_TARGET_CITY$. Chủ lao động đã cung cấp cho bạn phương tiện vận chuyển và sẽ chi trả mọi chi phí. Đừng làm ai thất vọng và hãy đến đúng giờ."


	key[]: "intro_garage_1"
	val[]: "Đây là trụ sở chính của bạn."

	key[]: "intro_garage_2"
	val[]: "Đây là một gara khá đơn giản. Có thể không có gì đặc biệt, nhưng đó là một khởi đầu."

	key[]: "intro_garage_3"
	val[]: "Thật không may, hiện tại bạn chưa có xe gì để đậu ở đó, nên không thấy xe tải nào cả."

	key[]: "intro_garage_4"
	val[]: "Khi bạn kiếm đủ tiền và mua được một chiếc xe tải, bạn sẽ có thể tự do đi lại khắp thế giới và điều hành công việc kinh doanh của riêng mình từ đó."

	key[]: "intro_garage_5"
	val[]: "Chúc may mắn!"


	key[]: "desktop_tut_t"
	val[]: "TÍNH NĂNG ĐÃ ĐƯỢC MỞ KHÓA"

	key[]: "desktop_tut_job"
	val[]: "Chọn công việc tiếp theo"

	key[]: "desktop_tut_cargo_market"
	val[]: "Hãy sử dụng rơ-moóc hoàn toàn mới của bạn để truy cập Thị trường Hàng hóa và vận chuyển nhiều loại hàng hóa khác nhau đến các điểm đến." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Bạn có thể thấy tiến trình ở đây."

	key[]: "desktop_tut_company"
	val[]: "Bạn có thể theo dõi các gara của mình, tuyển dụng tài xế mới và quản lý công ty từ đây."

	key[]: "desktop_tut_trailers"
	val[]: "Từ giờ trở đi, bạn có thể mua rơ-moóc riêng, nâng cấp hoặc sơn chúng sao cho phù hợp với xe tải của mình.<br><br>Rơ-moóc có thể được cất giữ trong (các) gara bạn đã chọn; chúng có thể được các tài xế của bạn sử dụng để tăng lợi nhuận. Để quản lý rơ-moóc, hãy sử dụng Trình quản lý rơ-moóc."

	key[]: "desktop_tut_visit_directive"
	val[]: "Truy cập $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "CHÀO MỪNG"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Chào mừng đến với giao diện Desktop mới.<br>Từ đây, bạn có thể tương tác với tất cả các chức năng trong trò chơi."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Dưới đây, Menu Chính cung cấp quyền truy cập trực tiếp vào tất cả các chức năng cốt lõi của trò chơi mà bạn đã quen thuộc."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Ở phía trên cùng, thanh trạng thái mới luôn hiển thị các số liệu thống kê hữu ích về hồ sơ người chơi và các quy định đi lại địa phương."

	key[]: "desktop_tut_tour_home"
	val[]: "Nút Desktop luôn có sẵn để đưa bạn trở lại màn hình Desktop."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Menu nhanh cố định cung cấp các phím tắt tiện lợi để truy cập tất cả các chức năng của trò chơi từ bất kỳ màn hình nào."

	key[]: "desktop_tut_tour_drive"
	val[]: "Nút Drive được cập nhật vẫn là cầu nối của bạn với thế giới lái xe, sẵn sàng đưa bạn trở lại đường."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "HƯỚNG DẪN ĐÃ HOÀN THÀNH"

	key[]: "desktop_tut_tour_finish"
	val[]: "Cảm ơn bạn đã xem xét bản cập nhật Desktop chúng tôi."
