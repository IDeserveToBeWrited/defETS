#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Trình hướng dẫn sẽ áp dụng các cài đặt được đề xuất dựa trên các thiết bị đã kết nối.<br><color value=@@clr_sel@@>Nếu bạn đang sử dụng tay cầm chơi game tương thích với Steam, hãy cân nhắc bật hỗ trợ cấu hình trong <br><color value=@@clr_txt_d@@> \"Steam > Cài đặt > Bộ điều khiển > Cài đặt chung bộ điều khiển\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Lái xe bằng bàn phím và quan sát thế giới xung quanh bằng chuột. Đây là hình thức điều khiển đơn giản nhất nhưng kém chính xác nhất mà bất kỳ ai cũng có thể sử dụng."

	key[]: "wiz_control_mouse"
	val[]: "Sử dụng chuột để điều khiển nhạy hơn. Các thao tác khác vẫn được thực hiện trên bàn phím. Bạn chỉ có thể dùng chuột để nhìn xung quanh nếu đồng thời giữ một phím hoặc nút điều khiển camera đặc biệt."

	key[]: "wiz_control_controller"
	val[]: "Hãy sử dụng vô lăng, tay cầm chơi game hoặc cần điều khiển để có trải nghiệm chơi game chân thực nhất. Bạn vẫn có thể sử dụng các phím tắt trên bàn phím để thực hiện nhiều thao tác, và có thể tự do quan sát bằng chuột (mouselook)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Không tìm thấy bộ điều khiển chơi game nào. Bạn cần kết nối một bộ điều khiển ngay bây giờ để kích hoạt tùy chọn này!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Đang phát hiện các bộ điều khiển khả dụng..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "CHỌN API BỘ ĐIỀU KHIỂN" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Chế độ gán nút trong trò chơi (khuyên dùng)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Chế độ gán nút qua Steam Client"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Bộ điều khiển cổ điển"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Các tay cầm chơi game như @@controller_ps5@@, @@controller_xbox_one@@ hoặc @@controller_steam_deck@@ đã chọn giao diện Steam Input và sử dụng bố cục đơn giản.<br><br>Hỗ trợ cấu hình gán phím đầy đủ trong game."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Tay cầm chơi game được chọn vào giao diện Steam Input và sử dụng bố cục độc lập được cấu hình thông qua Steam Client.<br><br>Hỗ trợ hạn chế cho gợi ý nút trong game và không có cấu hình gán phím trong game."

	key[]: "wiz_api_classical"
	val[]: "Bộ điều khiển, vô lăng hay cần lái sử dụng DirectInput, XInput hoặc tương tự."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "CHỌN LOẠI BỘ ĐIỀU KHIỂN"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Xoay vô lăng"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Tay cầm hay Cần Lái"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Bộ điều khiển là một vô lăng hoặc hoạt động giống như một vô lăng. Vị trí của bộ điều khiển sẽ trực tiếp xác định vị trí của vô lăng trong trò chơi."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Bộ điều khiển là một tay cầm chơi game hoặc cần điều khiển. Vị trí của bộ điều khiển sẽ xác định tốc độ quay của vô lăng trong trò chơi."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "CHỌN LOẠI HỘP SỐ" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Nhấn nút TIẾN để di chuyển về phía trước, và nhấn nút LÙI để phanh hoặc lùi xe. Hộp số tự động quản lý mọi thứ khác, xử lý các chuyển đổi giữa chế độ lái, phanh và lùi, cũng như chọn số phù hợp."

	key[]: "wiz_gb_automatic"
	val[]: "Sử dụng các nút để chuyển đổi giữa chế độ lái tiến, số mo hoặc lùi. Sau đó nhấn bàn đạp ga và để hộp số tự động điều khiển việc chuyển số."

	key[]: "wiz_gb_sequential"
	val[]: "Người lái có thể tự chuyển số lên xuống để chọn từng cấp số riêng lẻ trong hộp số. Cấu hình này cho phép kiểm soát hoàn toàn hộp số của xe."

	key[]: "wiz_gb_hshifter"
	val[]: "Chọn trực tiếp số mong muốn. Điều này mang lại cấu hình thực tế nhất. Nên sử dụng cần số kiểu chữ H vật lý và cần phải sử dụng côn."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Chức năng này yêu cầu thiết bị điều khiển là vô lăng, tay cầm hay tay lái máy bay."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Không tìm thấy thiết bị hỗ trợ hộp số dạng H, tính năng này sẽ ko thể sử dụng được."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "CHỌN BỐ TRÍ CẦN SỐ KIỂU H"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Bô hộp số giải rộng là sự lựa chọn đơn giản nhất. Nó có 2 thiết lập số. Một là từ số 1 đến số 6 và thứ 2 là từ số 7 đến số 12. Có một cái nút để chuyển qua lại giữa 2 chế độ này."

	key[]: "wiz_hs_splitter"
	val[]: "Hộp số chia nhỏi là sự lựa chọn đơn giản. Nó cũng chia làm 2 thiết lập. Mội là các số lẽ như (1, 3, 5 ...) và cái thứ 2 là các số chẵn (2, 4, 6 ...). Và cũng có một nút bấm chuyển đổi qua lại 2 chế độ này.."

	key[]: "wiz_hs_range_splitter"
	val[]: "Hộp số chia tải được dựa trên kết cấu của một hộp số thật. Các cấp số sẽ được chia nhóm 4 trên mỗi cần số H và sử dụng 2 cần gạt. Khuyến nghị dành cho người có am hiểu sâu về xe tải mới nên sử dụng."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Trò chơi được cấu hình bằng cách sử dụng các thiết lập mặc định được mô tả dưới đây. Bạn có thể tinh chỉnh nó bằng cách sử dụng các cài đặt nâng cao hoặc bạn có thể tiếp tục trực tiếp vào trò chơi"

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Cái đặt nâng cao"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Trò chơi đã được cấu hình xong và bạn có thể tiếp tục. Bạn có thể thay đổi cấu hình sau trong mục Tùy chọn."

	key[]: "wiz_cfg_steam"
	val[]: "Bạn có thể kiểm tra và thiết lập cài đặt nút và trục cho thiết bị điều khiển này bằng Steam. Thiết lập tay cầm Steam cho trò chơi trong Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Mở cài đặt bộ điều khiển"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Sử dụng @@imm_wiz_dsteerleft@@ và @@imm_wiz_dsteerright@@ để lái vô lăng."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Di chuyển chuột qua trái hay phải để xoay vô lăng trong xe."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Sử dụng @@ima_wiz_j_steer@@ để bẻ lái."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Sử dụng @@imm_wiz_dforward@@ để lái lên phía trước và sử dụng @@imm_wiz_dbackward@@ để de lại."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Di chuyển @@ima_wiz_j_throttle@@ về phía trước để đi tiến lên, về phía sau để de xe lại."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Sử dụng @@ima_wiz_j_throttle@@ để lái về trước và chọn @@ima_wiz_j_brake@@ để de xe."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Sử dụng @@imm_wiz_dforward@@ để tăng tốc và sử dụng @@imm_wiz_dbackward@@ để thắng lại."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Di chuyển @@ima_wiz_j_throttle@@ về phía trước đi tăng tốc, về phía sau để thắng xe.."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Sử dụng @@ima_wiz_j_throttle@@ để tăng tốc và sử dụng @@ima_wiz_j_brake@@ để thắng lại."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Sử dụng @@imv_wiz_gearup@@ để cài số tiến và @@imv_wiz_geardown@@ để cài số lùi."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Sử dụng @@imv_wiz_gearup@@ để tiến lên và @@imv_wiz_geardown@@ để đi lùi nếu bạn đang sử dụng bàn phím hoặc tay điều khiển. Sử dụng @@imv_wiz_drive@@ và @@imv_wiz_reverse@@ để chọn hướng lái nếu bạn đang sử dụng hộp số kiểu H"

	key[]: "wiz_cfg_gb_manual"
	val[]: "Sử dụng @@imv_wiz_gearup@@ và @@imv_wiz_geardown@@ để chọn lên xuống số."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Hãy sử dụng hộp số H với thiết bị @@ima_wiz_j_clutch@@ để đổi số thật chuyên nghiệp."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "CÀI ĐẶT TRỤC BỘ ĐIỀU KHIỂN" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Trực quan hóa các trục"

	key[]: "wiz_setup_axes_desc"
	val[]: "Bạn có thể thử chức năng của tất cả các trục đã chọn một cách trực quan. Sử dụng bộ điều khiển và quan sát các thanh di chuyển. Nó sẽ cho bạn biết giới hạn, vị trí trung tâm, hướng và hành vi tổng thể của từng trục được sử dụng."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Thiết lập trục (Axis)"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Để chọn trục, hãy nhấp vào nút bên cạnh tên trục. Thao tác này sẽ chuyển bạn sang chế độ nhập liệu. Sau đó, sử dụng bộ điều khiển để gán trục đã chọn bằng cách di chuyển cần điều khiển, vô lăng hoặc bàn đạp đến trục bạn đã chọn."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Vùng chết"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Vùng chết (deadzone) là vùng trục được thiết kế cố ý để không nhận tín hiệu đầu vào. Để điều chỉnh vùng chết của một trục đã chọn, hãy di chuyển thanh trượt tương ứng. Kéo thanh trượt sang phải sẽ mở rộng vùng chết. Tính năng này đặc biệt hữu ích cho các bộ điều khiển cũ, vì việc xác định vùng chết lớn hơn có thể giảm thiểu các vấn đề như độ chính xác thấp hoặc tín hiệu đầu vào sai do hao mòn phần cứng."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Chế độ trục"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Chế độ trục xác định cách nó được xử lý trong trò chơi. Trục đảo ngược sẽ đảo chiều hướng được báo cáo, dẫn đến việc điều khiển sang trái thay vì sang phải, chẳng hạn. Trục ở giữa có vị trí mặc định ở giữa phạm vi của nó, giống như trong cần điều khiển. Chế độ này hữu ích để hiệu chỉnh một trục đã được phát hiện không chính xác."

	key[]: "normal"
	val[]: "Bình thường" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Đảo ngược" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Canh Giữa" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Đảo ngược và căn giữa" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "CÀI ĐẶT HỘP SỐ TỰ ĐỘNG" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Với hộp số tự động, bạn chỉ có thể chuyển qua lại giữa đi tới, số N và số de. Bạn sẽ phải làm quen với sử dụng phím bấm hay nút trên tay cầm. Để đổi thiết lập, hãy nhấp chuột vài nút và chọn phím hay nút trên tay cầm tương ứng."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Nếu bạn có thiết bị cần số chữ H (H-shifter) kết nối với máy tính, bạn có thể sử dụng nó để giả lập cần số tự động như ngoài đời thực. Khi bật tùy chọn này, bạn có thể gán các vị trí trên cần số chữ H cho chế độ tiến và lùi. Các vị trí còn lại trên cần số sẽ được tính là số N (số mo). Thiết lập này được tạo riêng cho thiết bị điều khiển cần số chữ H, vì vậy nó sẽ không hoạt động với các phím bấm thông thường hay nút bấm trên tay cầm. Để thay đổi thiết lập gán nút, hãy nhấp vào một nút trên màn hình, sau đó đẩy cần số vào vị trí mong muốn rồi đưa về vị trí số N."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "CẤU HÌNH HỘP SỐ TUẦN TỰ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Hộp số tuần tự chỉ thay đổi giữa những số đi tới, số N và số de. Đây là những phím bấm giúp bạn tăng và giảm số. Để thay đổi thiếp lập này, nhấp chuột vào cái nút  và nhấn phím hay nút trên gamepad để thay đổi."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "CẤU HÌNH HỘP SỐ H-SHIFTER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Ở đây bạn có thể chọn giao diện chuẩn cho hộp số kiểu H và thử chức năng này. Trong bức ảnh bạn có thể thấy vị trí các cần số. Tuy nhiên hộp số trong xe tải có nhiều số hơn số lượng vị trí này nên bạn cần dùng 1 phìm để chuyển qua lại các thiết lập."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Vi trí số hiện tại quá thấp nên Để thay đổi phần điều khiển được giao, nhấn vào nút thích hợp và bắt đầu sang số đến vị trí mong muốn, sau đó thả ra lại"
#@}

