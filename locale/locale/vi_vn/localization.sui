	val[]: "Đề nghị c.việc đặc biệt:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Bạn sắp vận chuyển một kiện hàng đặc biệt! Sẽ có hai xe hộ tống dẫn đường cho bạn. Hãy cẩn thận và làm theo chỉ dẫn cũng như các thông báo hướng dẫn của chúng. Các chuyến vận chuyển đặc biệt như thế này không phải dừng lại ở đèn đỏ và có quyền ưu tiên trong hầu hết các trường hợp. Trong các chuyến giao hàng này, các bản lưu sẽ được thiết lập thường xuyên hơn để lưu lại tiến độ hiện tại của bạn."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Hãy đặc biệt chú ý đến những điểm sau:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Tránh mọi xung đột có thể xảy ra với các xe hộ tống và giữ hàng hóa ở giữa chúng."

	key[]: "oversize_tutorial_warning_offroad"
