	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Để truy cập vào Thị trường Hàng hóa, trước tiên bạn phải được chỉ định một rơ-moóc."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Để truy cập vào các Hợp đồng bên ngoài, bạn phải được chỉ định một xe tải và có hồ sơ được kết nối với World of Trucks."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Để truy cập Thị trường Bên ngoài, bạn phải có rơ-moóc được chỉ định và hồ sơ được kết nối với World of Trucks."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Xem bản đồ thế giới, các khu vực đã khám phá và các điểm dừng chân hiện tại của bạn hoặc thiết lập các điểm dừng chân mới."

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Dịch vụ di chuyển nhanh đến một thành phố đã được khám phá trước đó, với một khoản phí."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Tìm kiếm, duyệt và lọc các phiên họp nhóm trực tuyến để tham gia hoặc tạo và tổ chức phiên họp của riêng bạn cho người khác."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Hộp thư đến của bạn sẽ nhận được các tin nhắn từ thế giới kinh doanh, ngân hàng và thông báo tuyển dụng nhân viên mới của công ty."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "Bạn sẽ bắt đầu nhận được email khi đã thăng tiến trong sự nghiệp."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Tìm kiếm và mua các gara có sẵn trên bản đồ thế giới."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Tìm kiếm và xem xét các loại xe tải đã qua sử dụng có sẵn để mua."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Bạn vẫn chưa tìm thấy bất kỳ đại lý xe tải nào."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Tìm kiếm, xem xét và cấu hình lại các rơ-moóc có sẵn để mua."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Hãy nâng tầm trải nghiệm lái xe của bạn với âm nhạc."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Đài phát thanh không hoạt động."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Tùy chỉnh đồ họa, âm thanh, lối chơi, điều khiển và các tùy chọn trực tuyến."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Xem lại tiến trình sự nghiệp, số liệu thống kê và các công việc đã hoàn thành gần đây của bạn."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Để truy cập Chế độ Đoàn xe đang hoạt động, trước tiên bạn cần tham gia một phiên đoàn xe."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Cảnh báo sức khỏe"

	key[]: "health_warning_description"
	val[]: "Một số ít người dùng có thể dễ bị co giật động kinh hoặc mất ý thức khi tiếp xúc với một số loại ánh sáng nhấp nháy hoặc các kiểu ánh sáng nhất định. Những người này có thể bị co giật khi xem một số hình ảnh hoặc chơi trò chơi điện tử. Nếu bạn hoặc bất kỳ ai trong gia đình bạn đã từng có các triệu chứng liên quan đến động kinh (co giật hoặc mất ý thức) khi tiếp xúc với ánh sáng nhấp nháy, vui lòng tham khảo ý kiến chuyên gia y tế và thực hiện tất cả các biện pháp phòng ngừa cần thiết trước khi chơi trò chơi.<br offset=20>Nếu bạn hoặc con bạn gặp bất kỳ triệu chứng nào sau đây khi chơi bất kỳ trò chơi điện tử nào: chóng mặt, thay đổi thị lực, co giật mắt hoặc cơ, mất ý thức, mất phương hướng, co giật, cử động không tự chủ, hãy ngừng sử dụng trò chơi điện tử ngay lập tức và tham khảo ý kiến chuyên gia y tế."

	key[]: "trademark"
	val[]: "Tất cả tên thương hiệu, nhãn hiệu, nhãn hiệu đã đăng ký, logo và biểu tượng trên các phương tiện trong trò chơi đều thuộc sở hữu của chủ sở hữu hợp pháp. Được sử dụng với sự cho phép. Các nhãn hiệu và thiết kế MAN® là quyền đã đăng ký của MAN Truck & Bus AG và được sử dụng theo giấy phép của SCS Software s.r.o. \"Mercedes-Benz\" và \"Ngôi sao ba cánh trong vòng tròn\" là nhãn hiệu của Daimler AG và được sử dụng theo giấy phép của SCS Software s.r.o. Các nhãn hiệu và thiết kế RENAULT là quyền đã đăng ký hoặc được cấp phép cho AB Volvo Group và được sử dụng theo giấy phép. Các nhãn hiệu và thiết kế VOLVO là quyền đã đăng ký hoặc được cấp phép cho AB Volvo Group và được sử dụng theo giấy phép."
#@}

