	val[]: "Bạn không thể tự do đi lại trên thế giới vì không có phương tiện di chuyển! Bạn có thể mua một chiếc hoặc lấy một chiếc từ đội xe của mình.<br><br>Bạn có muốn nhận một công việc nhanh chóng ngay bây giờ không?"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "TẢI GAME"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Tải game" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Tải lại phần lưu game gần đây nhất! Tất cả tiến trình hiện tại sẽ bị mất!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Bạn có chắc chắn muốn tải một trò chơi khác không?<br><br>Tiến trình hiện tại của bạn sẽ bị mất trừ khi bạn đã lưu trước đó."

	key[]: "load_progress_lost_mp"
	val[]: "Bạn có chắc chắn muốn tải một bản lưu trò chơi khác không?<br>Việc này trong chế độ nhiều người chơi có thể dẫn đến việc hủy hoặc tạm dừng công việc, dịch chuyển đến điểm dịch vụ gần nhất hoặc công việc đã chọn không khả dụng.<br><br>Tiến trình hiện tại của bạn sẽ bị mất trừ khi bạn đã lưu trước đó."

	key[]: "load_game_mp_suspended_job"
	val[]: "Quá trình lưu đã thành công, nhưng công việc World of Trucks hiện tại của bạn đã bị tạm dừng và không khả dụng trong phiên này."

	key[]: "autosave"
	val[]: "- Lưu tự động -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Lưu nhanh -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Hiển thị các mục lưu tự động" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Không tìm thấy bản lưu thủ công nào." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Tải" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Bản lưu không tương thích!<br><color value=@@clr_txt@@>Hãy thử nâng cấp game lên phiên bản mới nhất." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Không thể tải và hiển thị tất cả các tệp lưu cho hồ sơ này." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "LƯU Ý" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Lỗi khi tải file lưu.<color value=@@clr_txt@@><br><br> File lưu không tải được. Bạn có thể thử xác định và khắc phục sự cố bằng cách sử dụng thông tin bên dưới. Hoặc, bạn có thể thử tải một file lưu khác.<br><br>Các lý do sau thường gây ra sự cố:<br><br>1. File lưu không tương thích với một số MOD đã được cài đặt.<br><br>2. File lưu chứa thông tin từ MOD bị thiếu hoặc bị vô hiệu hóa.<br><br>3. File lưu bị hỏng do sử dụng MOD được tạo kém chất lượng.<br><br>4. Máy tính bị treo trong hoặc ngay sau quá trình lưu có thể làm hỏng file lưu."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>MOD bị thất lạc.<color value=@@clr_txt@@><br><br>Bản lưu gần nhất bị mất thông tin MOD(s).<br><br>Nếu bạn không tin, bạn có thề kiểm tra lại MOD(s).<br><br>Cũng như bạn có thể load bản lưu lại một lần nữa. Tuy nhiên vấn đề này cũng có thể do những lý do khác.<br><br>Suy cho cùng, cách tốt nhất là bạn nên tải một bản lưu khác.."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Đã phát hiện DLC tùy chọn bị thiếu.<color value=@@clr_txt@@><br><br>Tệp lưu mới nhất có phụ thuộc vào một DLC bị thiếu (bản mở rộng chính thức của trò chơi).<br><br>Nếu bạn không mong muốn điều này, vui lòng kiểm tra trạng thái của (các) DLC.<br><br>Nếu không, bạn vẫn có thể tải tệp lưu, tuy nhiên một số chức năng do (các) DLC cung cấp có thể bị mất.<br><br>Ngoài ra, bạn có thể thử tải một tệp lưu khác, không phụ thuộc vào (các) DLC bị thiếu."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Đã phát hiện DLC bị thiếu.<color value=@@clr_txt@@><br><br>Tệp lưu game mới nhất phụ thuộc vào một DLC bị thiếu (bản mở rộng chính thức của game).<br><br>Để tệp lưu này hoạt động chính xác, DLC đó cần phải có và được kích hoạt trên máy tính này.<br><br>Ngoài ra, bạn có thể thử tải một tệp lưu khác không phụ thuộc vào DLC bị thiếu."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MOD phụ thuộc vào nội dung DLC.<color value=@@clr_txt@@><br><br>Ít nhất một MOD phụ thuộc vào DLC (bản mở rộng chính thức của trò chơi) hiện chưa được cài đặt.<br><br>Bạn cần vô hiệu hóa (các) MOD hoặc cài đặt (các) DLC mà chúng phụ thuộc vào."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Đã phát hiện lỗi<color value=@@clr_txt@@><br><br>Có vẻ như trò chơi đã bị lỗi trong quá trình tải trước đó.<br><br>Bạn có thể thử xác định và khắc phục sự cố bằng cách sử dụng thông tin bên dưới. Hoặc, bạn có thể thử tải một file lưu khác.<br><br>Các lý do sau thường gây ra sự cố:<br><br>1. Một hoặc nhiều MOD đã cài đặt bị lỗi hoặc không tương thích với phiên bản hiện tại của trò chơi.<br><br>2. File lưu chứa thông tin từ (các) MOD bị thiếu hoặc bị vô hiệu hóa.<br><br>3. File lưu bị hỏng do sử dụng MOD được tạo kém chất lượng.<br><br>4. Trong một số trường hợp, sự cố phần cứng hoặc trình điều khiển có thể gây ra lỗi trò chơi."

	key[]: "mods_detected_warning"
	val[]: "Phát hiện sự hiện diện của mod. Hãy ý thức rằng hỏng hóc, sự lỗi thời, hoặc mod không tương thích có thể gây mất ổn định trò chơi. Hãy xem các mod đang hoạt động trong trình quản lý mod." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

