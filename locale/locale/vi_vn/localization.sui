	key[]: "bank_title"
	val[]: "NGÂN HÀNG" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Ngân hàng" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Nếu cần tiền, bạn luôn có thể hỏi vay ngân hàng." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "KHOẢNG VAY ĐỀ NGHỊ" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "trả $MONEY$ / ngày" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Số lượng vay đang h.động: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Bạn có thể mượn: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "TỔNG QUAN VỀ KHOẢN VAY ĐANG HOẠT ĐỘNG"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Nợ" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Số tiền còn phải trả" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Thời gian vay còn lại" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Lãi suất (năm)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Trả góp" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Trả lại" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Tổng:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Số dư tài khoản: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

