#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Chọn loại bộ điều khiển phụ để trò chơi xử lý chính xác các phạm vi đầu vào."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Chọn loại hộp số:<br>- \"Tự động đơn giản\" cho phép sử dụng chân ga và phanh để điều khiển chuyển động tiến và lùi.<br>- \"Tự động thực sự\" yêu cầu thao tác bằng tay để chuyển đổi giữa số tiến và số lùi.<br>- \"Tuần tự\" yêu cầu sang số bằng tay với các nút lên/xuống số.<br>- \"Cần số chữ H\" yêu cầu sử dụng bộ điều khiển có cần gạt số để chọn số bằng tay."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Thay đổi logic sang số của hộp số tự động:<br>- Chế độ \"Economy\" (Tiết kiệm) ưu tiên số vòng quay thấp thiên về mô-men xoắn cực đại.<br>- Chế độ \"Power\" (Sức mạnh) sẽ thiên về mã lực cực đại để mang lại hiệu suất lái tốt hơn khi chở hàng nặng hoặc chạy đường đồi núi, đánh đổi bằng việc tiêu hao nhiên liệu."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh tỷ lệ giữa độ quay của thiết bị (vô lăng) với độ quay vô lăng thực tế của xe."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh độ tuyến tính giữa đầu vào điều khiển và hệ thống lái của xe.<br><br>Điều chỉnh giá trị này cao hơn đồng nghĩa với việc tay lái sẽ ít nhạy hơn khi vô lăng ở vị trí chính giữa, và tăng dần độ nhạy khi vô lăng được quay về phía góc khóa tối đa. Điều này giúp ổn định việc điều khiển tay lái khi lái xe chạy thẳng."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Cho phép phản hồi lực trong các bộ điều khiển có hỗ trợ."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh mức lực tổng thể cho tất cả cài đặt phản hồi lực trong khoảng từ 0N đến 10N.<br><br><color value=@@clr_txt_d@@>Lưu ý rằng việc điều chỉnh mức này cao hơn trên các bộ vô lăng có mô-men xoắn mạnh có thể gây chấn thương cho ngón tay hoặc bàn tay."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh lực định tâm khi lái xe ở tốc độ cao, đạt đỉnh điểm ở tốc độ 90 km/h (56 mph) trở lên.<br><br>Cài đặt tối thiểu sẽ không có lực định tâm bánh xe."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh lực định tâm khi lái xe ở tốc độ thấp.<br><br>Cài đặt tối thiểu sẽ không có lực định tâm bánh xe."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ ma sát nội bộ nhân tạo do các bộ phận lái cơ khí tạo ra."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ cộng hưởng động cơ nhân tạo thông qua cột lái.<br><br><color value=@@clr_txt_d@@>Lưu ý rằng việc đặt giá trị này trên 15% có thể gây ra hiện tượng rung lắc quá mức ở một số bánh xe."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ hiệu ứng bề mặt đường truyền qua trục lái.<br><br><color value=@@clr_txt_d@@>Lưu ý rằng việc thiết lập giá trị này trên 20% có thể gây ra hiện tượng rung lắc quá mức trên một số loại vô lăng khi lái xe ở tốc độ cao trên địa hình không bằng phẳng."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ tác động của các chướng ngại vật trên đường thông qua cột lái."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ hiệu ứng va chạm thông qua cột lái."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ của hiệu ứng nghiến răng số."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ của hiệu ứng trượt bánh trước."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ trợ lực lái (khi sử dụng tính năng hỗ trợ giữ làn đường, v.v.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ rung của bề mặt địa hình, nếu bộ điều khiển hỗ trợ phản hồi rung."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ rung khi va chạm, nếu bộ điều khiển hỗ trợ phản hồi rung."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh cường độ rung khi va chạm, nếu bộ điều khiển hỗ trợ phản hồi rung."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Trục thiết bị được sử dụng để điều khiển hướng lái."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh vùng chết của trục lái; đây là khoảng quay tính từ vị trí chính giữa mà tại đó các tín hiệu điều khiển sẽ bị bỏ qua.<br><br>Điều này có thể giảm thiểu các vấn đề từ những thiết bị điều khiển cũ, chẳng hạn như sự thiếu chính xác hoặc tín hiệu ảo do bị mài mòn sau thời gian dài sử dụng."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Xác định cách trò chơi xử lý tín hiệu đầu vào của trục lái:<br>- Căn giữa là lựa chọn lý tưởng cho vô lăng hoặc cần điều khiển (joystick).<br>- Đảo ngược được dùng để sửa lỗi cho trục bị nhận diện sai."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Trục thiết bị được sử dụng để tăng tốc xe."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh vùng chết của trục ga; đây là khoảng hành trình đạp mà tại đó tín hiệu sẽ không được ghi nhận.<br><br>Điều này có thể giảm thiểu các vấn đề từ những thiết bị điều khiển cũ, chẳng hạn như sự thiếu chính xác hoặc tín hiệu ảo do bị mài mòn sau thời gian dài sử dụng."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Xác định cách trò chơi xử lý tín hiệu từ thiết bị điều khiển:<br>- Căn giữa là lựa chọn lý tưởng cho cần điều khiển (joystick).<br>- Bình thường là lựa chọn lý tưởng cho các nút cò (trigger) hoặc bàn đạp.<br>- Đảo ngược có thể bù đắp cho các tín hiệu đầu vào bị nhận diện sai."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Trục thiết bị được sử dụng để phanh."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh vùng chết của trục phanh; đây là khoảng hành trình đạp mà tại đó tín hiệu sẽ không được ghi nhận.<br><br>Điều này có thể giảm thiểu các vấn đề từ những thiết bị điều khiển cũ, chẳng hạn như sự thiếu chính xác hoặc tín hiệu ảo do bị mài mòn sau thời gian dài sử dụng."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Xác định cách trò chơi xử lý tín hiệu từ thiết bị điều khiển:<br>- Căn giữa là lựa chọn lý tưởng cho cần điều khiển (joystick).<br>- Bình thường là lựa chọn lý tưởng cho các nút cò (trigger) hoặc bàn đạp.<br>- Đảo ngược có thể bù đắp cho các tín hiệu đầu vào bị nhận diện sai."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Trục thiết bị được sử dụng để khớp ly hợp."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh vùng chết của trục côn; đây là khoảng hành trình đạp mà tại đó tín hiệu sẽ không được ghi nhận.<br><br>Điều này có thể giảm thiểu các vấn đề từ những thiết bị điều khiển cũ, chẳng hạn như sự thiếu chính xác hoặc tín hiệu ảo do bị mài mòn sau thời gian dài sử dụng."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "\"Xác định cách trò chơi xử lý tín hiệu từ thiết bị điều khiển:<br>- Căn giữa là lựa chọn lý tưởng cho cần điều khiển (joystick).<br>- Bình thường là lựa chọn lý tưởng cho các nút cò (trigger) hoặc bàn đạp.<br>- Đảo ngược có thể bù đắp cho các tín hiệu đầu vào bị nhận diện sai.\""

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh phạm vi hoạt động của ly hợp.<br><br>Bạn càng đặt phạm vi sang phải, bạn càng cần nhấn bàn đạp sâu hơn để ly hợp hoạt động."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Trục thiết bị được sử dụng để nghiêng camera lên xuống."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Điều chỉnh vùng chết của trục nhìn lên-xuống; lượng hành trình đầu vào mà tại đó không có tín hiệu đầu vào nào được ghi nhận.<br><br>Điều này có thể giảm thiểu các vấn đề từ các bộ điều khiển cũ hơn như độ chính xác thấp hoặc tín hiệu đầu vào sai do hao mòn."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Xác định cách trò chơi xử lý đầu vào trục:<br>- Căn giữa là lý tưởng cho cần điều khiển.<br>- Đảo ngược được sử dụng để sửa trục đã được phát hiện sai."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Trục thiết bị được sử dụng để xoay camera sang trái và phải."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "\"Điều chỉnh vùng chết của trục nhìn trái-phải; đây là khoảng hành trình điều khiển mà tại đó tín hiệu sẽ không được ghi nhận.<br><br>Điều này có thể giảm thiểu các vấn đề từ những thiết bị điều khiển cũ, chẳng hạn như sự thiếu chính xác hoặc tín hiệu ảo do bị mài mòn sau thời gian dài sử dụng.\""

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Xác định cách trò chơi xử lý đầu vào trục:<br>- Căn giữa là lý tưởng cho cần điều khiển.<br>- Đảo ngược được sử dụng để sửa trục đã được phát hiện sai."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Chọn cách bố trí số sẽ sử dụng với cần số H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Thay đổi hành vi của cần số:<br>- Với tùy chọn \"Đơn giản\", bạn sẽ không bao giờ bị kẹt số khi sang số.<br>- Tùy chọn \"Đơn giản + âm thanh cảnh báo\" cho phép bạn sang số đơn giản, nhưng sẽ có tiếng kẹt số khi bạn sang số sai.<br>- Tùy chọn \"Nâng cao\" sẽ không cho phép bạn sang số nếu bạn sang số sai, và bạn sẽ chỉ nghe thấy tiếng kẹt số. Tùy chọn \"Nâng cao\" cũng cho phép bạn sử dụng cài đặt \"sang số nhanh\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Chọn cách trò chơi xử lý việc chuyển số nhanh:<br>- \"Không bao giờ\" yêu cầu cần số phải được chuyển về vị trí trung lập giữa các lần chuyển số.<br>- \"Nhấn côn\" yêu cầu nhấn côn trong giây lát mà không cần chuyển cần số.<br>- \"Nhả ga\" yêu cầu người lái chỉ nhả ga để chuyển số mà không cần chuyển cần số, và \"côn hoặc ga\" là sự kết hợp của hai tùy chọn sau."

