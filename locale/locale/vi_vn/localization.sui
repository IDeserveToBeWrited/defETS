#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Lớp mạng không khả dụng. Vui lòng kiểm tra xem cấu hình máy khách có chính xác hay không."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Không thể kết nối với dịch vụ trực tuyến. Vui lòng kiểm tra xem kết nối internet của bạn có hoạt động bình thường hay không."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Đã xảy ra lỗi trong quá trình kết nối với dịch vụ trực tuyến. Vui lòng thử lại sau."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Dữ liệu trả về từ dịch vụ trực tuyến không chính xác. Nếu đang sử dụng proxy HTTP, hãy kiểm tra cấu hình của nó. Nếu không, hãy thử lại sau."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Dữ liệu trả về từ dịch vụ trực tuyến không chính xác. Vui lòng thử lại sau."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Dịch vụ này không tương thích với phiên bản hiện tại của trò chơi. Vui lòng kiểm tra xem có bản vá lỗi mới nào cho trò chơi hay không."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Dịch vụ hiện không khả dụng. Vui lòng thử lại sau."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Hiện tại dịch vụ đang được bảo trì hoặc quá tải. Vui lòng quay lại sau."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Thông tin xác thực không hợp lệ. Vui lòng thử đăng nhập lại."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Tài khoản trực tuyến hiện đang bị khóa do quá nhiều lần đăng nhập không thành công. Vui lòng thử lại sau 30 phút nữa."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Tài khoản trực tuyến hiện đang bị khóa do truy cập đáng ngờ. Vui lòng thử lại sau 24 giờ."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Trò chơi này không được đăng ký với tài khoản trực tuyến này."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Tài khoản chưa được kích hoạt. Vui lòng kiểm tra hộp thư đến của bạn để tìm email kích hoạt tài khoản."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Tài khoản đã bị khóa. Vui lòng liên hệ bộ phận hỗ trợ kỹ thuật."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Tài khoản đã bị cấm. Vui lòng liên hệ bộ phận hỗ trợ kỹ thuật."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Trò chơi này không hỗ trợ xác thực qua proxy. Vui lòng sử dụng proxy khác hoặc kết nối trực tiếp."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Đối tượng cần thiết hiện không khả dụng. Vui lòng thử lại sau vài phút."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Lỗi SSL. Không thể thiết lập kết nối an toàn."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Trò chơi đã bị tạm dừng trong quá trình giao tiếp trực tuyến. Vui lòng thử lại sau."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Lỗi nội bộ. Tệp net.log có thể chứa thêm thông tin."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 đang gặp sự cố và không thể vẽ đồ họa trên máy tính của bạn (không tìm thấy thiết bị đồ họa hợp lệ).\nCác bước được đề xuất:\n\n1. Kiểm tra xem máy tính và card màn hình của bạn có đáp ứng các yêu cầu phần cứng tối thiểu hay không.\n2. Cập nhật máy tính của bạn lên phiên bản DirectX mới nhất của Microsoft.\n3. Tải xuống và cài đặt trình điều khiển đồ họa mới nhất cho card video của bạn từ trang web của nhà cung cấp - trình điều khiển đồ họa của bạn có thể đã lỗi thời.\n4. Thử thay đổi phương thức kết xuất từ OpenGL sang DirectX hoặc ngược lại.\n5. Xóa tệp cấu hình trò chơi 'config.cfg' trong thư mục 'Documents' - 'Euro Truck Simulator 2' của bạn. Nó có thể đã bị hỏng.\n    Tệp này sẽ được tự động tạo lại với các giá trị mặc định hợp lệ trong lần khởi chạy trò chơi tiếp theo."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 đang gặp sự cố và không thể vẽ đồ họa trên máy tính của bạn (không tìm thấy thiết bị đồ họa hợp lệ)."
#@}

