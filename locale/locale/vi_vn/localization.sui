	key[]: "new_inventory_items_help"
	val[]: "Phát hiện vật phẩm từ kho đồ Steam." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Phụ kiện xe " #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Phụ kiện Cabin" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Nền bàn làm việc" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Màu sơn" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Tắt kho đồ" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Thử lại sau" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
