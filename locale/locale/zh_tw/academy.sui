	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "聯結車平行停車是每個卡車司機的必備技能｡<br>無論是在大城市的路邊停車，或是在鄉間的休息區停車，這是每個卡車司機都應該知道如何去做的事｡"

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "當你經過車位時，仔細觀察是否有足夠空間可停下你的聯結車。 在這裡，我們確保你是有足夠的空間。"

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "將自己與車位前的卡車對齊｡ 但不要靠得太近，與它保持一定距離，這樣你才有空間操作｡"

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "向車位的反方向打方向並開始倒車。 這是為了讓拖車快速的進入車位。"

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "一旦拖車指向的位置正確，你就可以跟著它繼續倒車。"

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "在司機邊的拖車車輪進入車位前，轉動方向盤使拖車不再靠近路邊。"

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "將曳引車與拖車拉正並停入車位中間。<br>停車，關閉引擎，然後安全停放卡車。"

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "你能看見和其他卡車前的停車位｡ 在倒車時，務必觀察後視鏡，保持卡車與周圍障礙物間有足夠的安全距離｡<br><br><font face=/font/big_bold.font>準備出發｡</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "在停車場找到車位。<br><br><font face=/font/big_bold.font>向前行駛。</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>駛過你所需的停車位，進入標記區域｡ 從這裡開始，你可以開始倒車了｡<br><br><font face=/font/big_bold.font>停在標記處｡</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "讓曳引車朝遠離車位的方向倒，這樣拖車就能進入車位了。 但轉得不要太急，否則可能會碰上路緣。<br><br><font face=/font/big_bold.font>開始倒車。</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "將拖車對準車格｡ 如有必要，向前或向後移動，同時轉動方向盤以調整位置｡<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "恭喜，你已經成功完成了\"卡車駕駛基礎\"的考試，並學會了正確操縱卡車所需的所有技能。"

	key[]: "aca_msg_book1_outro02"
	val[]: "這是你邁向職業卡車司機夢想前的第一步。"

	key[]:	"aca_msg_book1_outro03"
	val[]: "現在，你已經準備好踏上歐洲的旅程，迎接你的第一個挑戰…"

	key[]: "aca_msg_book1_outro04"
	val[]: "……但冒險才剛開始。"
#@}


