#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "歡迎來到最終考核的第 1 部分。 在這裡，我們將考驗你在學院學習後的卡車駕駛程度。"

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "首先，你要連接上拖車。 連接好後，你將會駕駛通過整個測試區域。"

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "第一部分是從這個通道離開小型停車場，前往東部的測試區域。"

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "該路段有很多障礙，具有挑戰性。"

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "這是通過東部測試路段很重要的一段路線。"

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "我們將會測試你在不同情況下對卡車的操作。"

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "你將駕駛卡車通過幾個急轉彎。"

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "你將駕駛穿過連接各個場地間的路段。"

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "最後一部分是開車通過這個小型路段。"

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "此路段有許多複雜道路與急轉彎。"

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "若要完成測試，你需要準確的停放車輛｡"

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "不要過於緊張。 你已經學習過通過此測試所需的所有內容。 <br><br>祝你好運！"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "前面是你的拖車。<br><br><font face=/font/big_bold.font>駛向拖車。</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "讓曳引車對準拖車。<br><br><font face=/font/big_bold.font>倒車，然後連接上磨盤心。</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>安全停放卡車。</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "按下 @@imv_nrm_attach@@<font face=/font/big_bold.font> 來連接拖車。</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "拖車已連接，卡車已準備好上路了｡<br><br><font face=/font/big_bold.font>釋放手煞車｡</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>駛向停車場出口｡</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "跟隨道路標線並留意路障｡<br><br><font face=/font/big_bold.font>繼續行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "即將迎接更具有挑戰的部分。<br><br><font face=/font/big_bold.font>小心的在路障之間行駛。</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>繼續行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "此部分將考驗你在有拖車的情況下操控通過不同轉彎的能力。<br><br><font face=/font/big_bold.font>轉向駛入路段。</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>駛過通道。</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>直行。</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>小心地駛過彎道。</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "你即將進入更複雜的路段｡ 小心駕駛｡<br><br><font face=/font/big_bold.font>繼續下坡行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>向左急轉彎。</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>駛出路段。</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "你即將駛入較容易的部分｡<br><br><font face=/font/big_bold.font>繼續下坡行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>保持沿道路行駛。</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "前方轉彎進入下一路段｡<br><br><font face=/font/big_bold.font>繼續行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>右轉。</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>繼續沿路線行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "前方將出現更多急彎。<br><br><font face=/font/big_bold.font>請相應調整你的速度｡ </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>向左轉彎。</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>繼續行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>進入彎道，繼續行駛｡</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "要完成轉彎，你可能需要稍微駛離道路一點。<br><br><font face=/font/big_bold.font>小心地轉彎，盡可能使用必需的空間。</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>駛離路段並駛入停車區。</font>"
