#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "您的前方有一個路障。開到該處，然後停下。"

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "在司機側的後方還有一個路障。沿著彎道倒車至該處。您可使用道路標線作為指引。"

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "正前方有一個急轉的 90 度彎道。開到該處。"

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "我們需要駛入彎道深處，使後輪能避開彎道內側的交通錐。<br>記得使用後視鏡！"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "將車輛回正、駛向最後的路障，然後停下並鎖妥卡車。"

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "卡車仍未準備好行駛，也許您漏了某些步驟？<br><br>引擎啟動了嗎？手煞車釋放了嗎？"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "在您的正前方、路障的前面有一處標記地點。<br><br><font face=/font/big_bold.font>向前行駛並停在標記地點。</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "在司機側探頭往後看；您會看見該處有一個標記地點。您需要同時進行倒車和轉向。<br><br><font face=/font/big_bold.font>沿著彎道倒車並停在標記地點。</font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "前方有一個 90 度彎道。<br><br>轉彎前保持在司機側，駛入彎道深處並快速進行急轉彎。不要撞擊彎道內側的交通錐。<br><br><font face=/font/big_bold.font>向前行駛並轉彎。</font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "使用前視鏡和側視鏡來確保不會撞到任何物件。<br><br><font face=/font/big_bold.font>完成轉彎並停在指定區域。</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>關閉引擎並鎖妥卡車。</font>"
#@}

