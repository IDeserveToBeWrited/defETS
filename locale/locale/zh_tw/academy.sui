#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "在這個場景中，我們將駕駛卡車進行一次短程行駛。駛下前方坡道時，您將體驗聯結拖車進行煞車時的感覺。使卡車準備就緒，然後出發。"

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "令車速達到至少 60 公里/小時（37 英里/小時）。準備應對前方的煞車區域。"

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "開始煞車。不要太晚煞車，否則有可能會撞上前方的路障！"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "停在指定區域。鎖妥卡車並關閉引擎。"


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "在這次行駛中，您將體驗在下坡時使用主煞車的感覺。目的是為了讓您感受到車後的重量，以及其對煞車距離的影響。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "開始向前行駛。注意——您需令車速達到 60 公里/小時（37 英里/小時）。<br><br><font face=/font/big_bold.font>駛過彎道。</font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>繼續加速下坡。</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>令車速達到 60 公里/小時（37 英里/小時）。</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "已達到指定車速。<br><br><font face=/font/big_bold.font>停下在前方的路障處。</font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

