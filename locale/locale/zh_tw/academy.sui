#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "基礎操縱與移動"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "學習基本的車輛控制以及如何向前和向後移動卡車｡"

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 1 章:@@aca_chapter_book1_1_title@@。<br><br>你已經學會如何在駕駛前設置卡車，<br>前進和倒車以及如何使用車燈和雨刷｡</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "基本車輛操控"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "學習駕駛，操縱和停放曳引車｡ 了解每種視鏡的類型及其用途｡"

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜!<br>你已完成第 2 章:@@aca_chapter_book1_2_title@@<br><br>你已經學會如何使用卡車上的每個鏡子、在移動前檢查卡車周圍的空間，以及執行基本和高級操作技術｡</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "拖車的熟練操作"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "學習如何連接拖車及在各種場景下的操作｡"

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜!<br>你已完成第 3 章:@@aca_chapter_book1_3_title@@<br><br>你已經學會了連接和分離拖車，<br>感受到了連接拖車時的重量感和空間感<br>並完成了具有挑戰性的課程｡</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "連接拖車倒車"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "學習新的操縱方法以便有效的連接拖車倒車和停放｡"

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜!<br>你已完成第 4 章:@@aca_chapter_book1_4_title@@<br><br>你已經學會了連接拖車倒車，<br>以及各種車輛停放技巧｡</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "最終考核"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "實地測驗你的知識和技能並證明你是出色的卡車司機!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜!<br>你已完成第 5 章:@@aca_chapter_book1_5_title@@<br><br>你已經證明你擁有所有必要的技能<br>用於駕駛、操縱和停放卡車!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "引擎預熱"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>你已完成培訓: @@aca_chapter_book2_0_title@@。<br><br>你已經了解了駕駛進階的規則和特點。</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "重回正軌"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已經完成了第 2 章: @@aca_chapter_book2_1_title@@。<br><br>你已完成引擎預熱、排檔測試、車輪旋轉檢查及煞車效率檢測。 接下來的章節將更具挑戰性。</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "繼續轉動"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已經完成了第 3 章: @@aca_chapter_book2_2_title@@。<br><br>你已經掌握了困難且多樣的場景。 你已展現出技術和表現。</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "最後衝刺"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已經完成了第 4 章: @@aca_chapter_book2_3_title@@。<br><br>你處理過許多拖車操縱、停車和倒車的困難情況。 你已經證明自己是一名技術熟練的駕駛員，能夠應對所有具有挑戰性的卡車駕駛狀況。"

	key[]: "aca_chapter_book3_1_title"
	val[]: "向前行駛"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "學習向前行駛時操控雙拖車所需的所有基本技巧。"

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 1 章:@@aca_chapter_book3_1_title@@。<br><br>你已經體驗過如何有效地駕駛和操控雙拖車。</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "倒車控制"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "了解倒車時操控雙拖車所需的必要步驟。"

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 2 章:@@aca_chapter_book3_2_title@@。<br><br>你已經學會了雙拖倒車的非凡技巧。</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "真實世界的準備"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "將你新學到的知識運用到更進階的場景中。"

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 3 章:@@aca_chapter_book3_3_title@@。<br><br>你在操控、停車和倒車時，成功應對了許多專屬雙拖車的多種困難情境。 你已在此證明了自己的實力，現在是時候在《歐洲卡車模擬2》的道路上拖曳雙拖車大顯身手了！</font><br><br>"


