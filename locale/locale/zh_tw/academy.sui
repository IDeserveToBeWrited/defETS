#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "在障礙物附近停下"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "在這個場景中，我們將介紹前視鏡——關於它的位置，以及如何在接近前方障礙物時利用它來確實停車。"

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "檢查前視鏡"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "了解其功能"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "在障礙物附近停下"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "在卡車——嚴格來說，是曳引車的正前方存在大型視野盲區。在這個範圍內，很容易看不到行人、甚至是汽車。因此卡車都會配備前視鏡，能透過擋風玻璃直接查看。"

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "前視鏡是為了讓司機能看見這片死角而設。<br>在狹小空間操控卡車時，只要充分利用好這一工具、您便不會撞上任何障礙物。"

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "開始駕駛，向前方的路障前進，然後在快要接近時減速。<br>請留意前視鏡。"

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "在標線和障礙物之間停下。"

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "在這個場景中，我們將學習如何使用圖中所示的前視鏡。<br><br><font face=/font/big_bold.font>您可透過擋風玻璃的上方直接查看。</font>@@aca_goal_tip@@您需位於車輛內部。"

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "前視鏡能讓您看見卡車前方的死角，幫助您安全且精準地行駛。<br><br>如果對其位置不滿意，您可在『@@adjust_link_t@@』（於暫停選單中進入）依個人喜好進行調整。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 繼續。</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "在卡車的正前方有一處標記地點。您會留意到該區域的另一側設有障礙物；靠近障礙物時，需緩速行駛、並透過前視鏡確認與障礙物之間的距離。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "卡車仍未準備好行駛，也許您漏了某些步驟？<br><br>引擎啟動了嗎？手煞車釋放了嗎？"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>駛向停車處。</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>將卡車前部停在障礙物與道路標線之間。</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

