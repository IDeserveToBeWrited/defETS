#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "倒車沙盒"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "在這個場景中，你將被安排到一個空停車場練習雙拖倒車。"

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "準備開始"

	key[]: "aca_goal_book3_urf_move"
	val[]: "嘗試"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "收尾"

	key[]: "aca_goal_book3_urf_end"
	val[]: "結束場景"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "雙拖車倒車需要比半拖倒車更多的注意力。 你必須提前規劃後拖車的位置，同時也要掌控前拖車和曳引車。<br><br>這樣理解吧 - 你必須用前拖車來引導後拖車。"

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "在此情況下，我們需要將後拖車轉向司機邊一側。 要實現這種轉向，必須將後拖車的前部推向助手邊一側。<br><br>請注意，這實際上意味著你必須讓前拖車轉向你目標方向的反方向，才能使後拖車轉向你的目標方向。"

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "一旦後拖車開始轉向，務必將曳引車與前拖車對齊。 這常常是大多數人初次操作失誤的地方。"

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "我們可以看到，該駕駛未能及時調整前拖車的走向，即將發生拖車折甘蔗事故。"

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "折甘蔗會出現在車組中任兩個車輛之間的夾角達到約90度時。 一旦出現這種情況，便無法挽救 - 你必須向前行駛，重新嘗試倒車。<br><br>與半拖車倒車操作的要領一致，倒車時始終要確保拖車的所有車輪都處於轉動狀態。 一旦某個車輪停止轉動，拖車便會原地打轉，你就無法繼續倒車操作了。"

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "你可以向前開回到上一次操作正確的位置，更準確地說，是一個能讓你繼續倒車且不會再出現相同失誤的位置。<br><br>在這種情況下，我們將向前移動，直至車身筆直，並從頭開始重新嘗試。"

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "再次提醒，一旦後拖車開始轉向，請將曳引車移至前拖車前方，讓後拖車自行轉向片刻。"

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "既然後拖車已轉向目標方向，現在該引導前拖車跟隨轉向了。 你可以調整前拖車與後拖車之間的夾角來控制轉彎幅度，使其更急或更緩。"

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "操作的最後一步是擺正所有車輛。 確保前拖車和後拖車對齊。"

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "請務必留意移動前拖車所花費的時間，若拖延過久，後拖車就會試圖回到你剛才出發的方向!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "儘管在這裡花些時間練習，嘗試各種操作方式，直到你大致掌握拖車倒車的技巧為止。<br><br>但最重要的是，記得享受其中的樂趣!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "準備出發｡"

	key[]: "aca_msg_book3_urf_move"
	val[]: "用這個停車場來熟悉拖車倒車操作。<br><br>@@aca_goal_tip@@ 如果你是拖車倒車新手，建議先體驗《卡車駕駛基礎》課程。"

	key[]: "aca_msg_book3_urf_stop"
	val[]: "練習時間不限。<br><br>當你感到滿意時，即可停止操作並病安全停好車來結束場景。"

	key[]: "aca_msg_book3_urf_end"
	val[]: "關閉引擎結束場景。"
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "狹窄空間內停車"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "在這個場景中，你需要將雙拖車停入一個狹窄空間。"

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "準備開始"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "出發"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "繼續行駛"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "停下"

	key[]: "aca_goal_book3_sup_end"
	val[]: "安全停放車輛"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "開車拖曳雙拖車看似令人望而生畏，但其實與拖曳半拖車並無太大區別 - 你只需同時考慮後拖車的行駛軌跡即可！"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "眼前有一個狹窄的車位。 你沒有足夠空間在駛入前將車身完全拉直，因此需要仔細考慮如何才能拖曳兩輛拖車駛入此處。"

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "立刻轉向車位的遠端方向，駛過常規的轉向位置再繼續往前開。"

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "當後拖車往正確方向移動時，你就可以徑直駛向車位了；切記要再次朝車位遠端方向開，這樣有助於引導前拖車順利轉向。"

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "繼續駛入該車位，兩輛拖車都會跟隨你，並會在前進過程中自行拉直。"

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "將卡車安全停放在指定區域｡"

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "準備出發｡"

	key[]: "aca_msg_book3_sup_forward"
	val[]: "向前行駛，進入狹窄空間。"

	key[]: "aca_msg_book3_sup_check1"
	val[]: "繼續行駛｡"

	key[]: "aca_msg_book3_sup_stop"
	val[]: "停在指定區域｡"

	key[]: "aca_msg_book3_sup_end"
	val[]: "安全停放卡車並關閉引擎｡"
#@}


