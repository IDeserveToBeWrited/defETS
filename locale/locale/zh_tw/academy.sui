#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "在本章的最後一個場景中，我們將在具有複雜配置的測試路段上行駛。"

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "首個需要克服的困難是由路障組成的蛇行彎道。通過時，記得充分利用好後視鏡。"

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "緊接而來的是髮夾彎道。轉彎時盡量保持在外側，應該就不會有太大問題。"

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "這裡有一個 90 度左轉彎道。記得要深入彎角，好讓卡車後部避開內側的路障。"

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "坡道稍微有點棘手。駛上坡道之前，請盡可能調整好自己的位置、並利用前視鏡和側視鏡來判斷方位。"

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "接下來的區段必須透過倒車來完成。請在接近前方路障時牢記這一點。"

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "跟隨道路標線，倒車並向右側行駛。"

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "倒車至路障處，然後停下並靠左向前行駛。"

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "駛過中央分隔帶的開口，進入下一區段。"

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "這條交通錐的通道非常狹窄。請慢速行駛，並利用後視鏡確認自己在通道中的位置。"

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "記住——在通過 90 度彎道時，要深入彎角。"

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "您將駛入一個開闊區段。您可以適當提速。但請記住——前方很快就會進入彎道，您需提前減速。"

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "在坡底設有一些路障。開到該處，然後倒車駛入左側的停車處。"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "倒車至停車處。"

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "關閉引擎並鎖妥卡車。"

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "前方是一個由路障組成的蛇行彎道。<br><br><font face=/font/big_bold.font>駛過蛇行彎道。</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "沿著彎道外側行駛，確保曳引車後部不會壓到路緣。<br><br><font face=/font/big_bold.font>轉彎。</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "即將迎來 90 度左轉彎道。記得善用所有可供利用的空間。<br><br><font face=/font/big_bold.font>轉彎。</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "對準坡道。一旦駛上坡道，就基本上沒有什麼能調整的餘地了。<br><br><font face=/font/big_bold.font>駛過坡道。</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>沿著左方道路行駛。</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "接下來的區段必須透過倒車來完成。停在前方路障處，以便之後向右倒車。<br><br><font face=/font/big_bold.font>停在路障處。</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "倒車駛入右後方區域。路面上有可用作參考的箭頭。<br><br><font face=/font/big_bold.font>倒車前往下一區段。</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>繼續向後方的路障倒車。</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "停下並掛入前進檔，然後繼續向左行駛。<br><br><font face=/font/big_bold.font>向前行駛。</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "駛過左側中央分隔的開口。<br><br><font face=/font/big_bold.font>繼續前進。</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "前方是一條交通錐狹窄彎道。請務必小心行駛，必要時使用後視鏡確認。<br><br><font face=/font/big_bold.font>駛過圓錐路段。</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "繼續通過路段。<br><br><font face=/font/big_bold.font>向左轉彎。</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "轉彎前記得靠左行駛，盡量為自己留出最大的空間。<br><br><font face=/font/big_bold.font>轉彎。</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "您可在此處適當提速，但前方即將進入一個彎道。<br><br><font face=/font/big_bold.font>繼續沿著路段行駛。</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "越是往前，彎道越急。<br><br><font face=/font/big_bold.font>請視情況調整車速，繼續行駛。</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "在坡底，您會看到有路障阻擋道路。<br><br><font face=/font/big_bold.font>停在路障附近。</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "您的左後方設有停車處。<br><br><font face=/font/big_bold.font>倒車進入停車處。</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>停在標記地點。</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

