	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "繞過路障"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "前方設有各種複雜彎道及障礙物。<br>只要能運用迄今學到的所有技巧，應對起來並不會太過困難。"

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "路面標線將指引您如何通過每一組障礙物。"

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "將曳引車保持在彎道外側。<br>由於拖車的轉彎半徑更小，您需向外側大幅擺動。"

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "下個彎道是簡單 90 度彎道。<br>同樣，將卡車保持在彎道外側，並善用所有可供利用的空間。"

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "不要著急——雖然路段變得開闊了，但您仍要保持精準。"

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "與路障保持較遠距離。"

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "進入狹窄區段要特別小心。<br>在進入前，先使曳引車向外側大幅擺動、確保拖車可以通過。"

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "最後一個 90 度彎道要比首個更加的急。但只要妥善利用空間，迴轉的餘地就很充足。"

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "停在指定區域。鎖妥卡車並關閉引擎。"


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "記住——您可以從道路標線上獲得指引，從而幫您通過這一路段。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "善用後視鏡也可以幫你安全通過這一路段。您需隨時留意後方拖車的軌跡。<br><br><font face=/font/big_bold.font>通過首個彎道。</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "駛離彎道時留意後方拖車的狀況，然後準備進入下個彎道。<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>通過下個彎道。</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "在轉彎前，務必確認拖車周圍沒有任何路障。<br><br><font face=/font/big_bold.font>繼續繞過前方的路障。</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "確認拖車周圍沒有任何路障後，便向副駕駛側大幅轉向以通過狹窄通道。<br><br><font face=/font/big_bold.font>駛向狹窄通道。</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "此區段需要非常精準的駕駛操作。不要操之過急，記得善用您的後視鏡。<br><br><font face=/font/big_bold.font>通過每個彎道時，都盡量靠近外側行駛。</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "這個彎道非常急，但只要善用前方空間、即可平穩、輕鬆地通過。<br><br><font face=/font/big_bold.font>通過最後一個彎道。</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "進階訓練路段 - 拖車"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "在第三章的最後一個場景中，我們將行駛在一條更長的、設有各種彎道的訓練路段上，藉此檢驗您拖車操控技巧是否已經熟練。"

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "狗腿彎道"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "移除此目標"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "中央分隔帶通道"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "首個蛇行彎道"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "第二個蛇行彎道"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "簡單彎道"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "圓環"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "直線區段"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "急轉彎道"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "最終彎道"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "駛向停車處"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "在這個場景中，您將面對各種不同的彎道、藉此習慣如何在聯結拖車時行駛。請集中精神、根據情況調整車速，並充分利用場地內的可用空間。"

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "首先需要面對的是狗腿彎道——一個路段之中包含兩次轉彎。您需先做好向左轉彎的準備，然後在操作途中向右轉彎。"

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "接下來的彎道會讓您駛過中央分隔帶，以前往另一側。雖然並不困難，但請務必注意為拖車預留足夠的空間。"

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "然後，您需通過由混凝土路障組成的蛇行彎道。請緩慢行駛、善用後視鏡，確保轉彎時的幅度夠大、使拖車不會撞上路障。"

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "您會在此處再次進入蛇行彎道，而這次每個彎道的頂點都額外設置交通錐。<br>千萬不要撞到任何一個！"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "在通往圓環的途中，會先遇上幾個簡單彎道。"

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "駛過直線區段進入圓環。進入前需靠近外側行駛。"

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "進入圓環後需注意拖車的位置。拖車在圓環內的軌跡會和剛進入時有所不同。"

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "駛離圓環，繼續駛向下組彎道。"

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "移除此過場動畫"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "此處彎道極為急促。請緩速行駛，善用所有可用的空間。與此同時，也要注意拖車的尾擺。"

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "駛過以下幾個彎道時，記住要在出彎的同時為下個彎道做準備、調整行車路線。"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "不要急著衝向最後的彎道。看似簡單，其實可操作的空間卻比看起來還要更小。"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "停在指定區域。鎖妥卡車並關閉引擎。"


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>加速行駛，前往首個彎道。</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "首個彎道——狗腿彎道的難度並不大。<br><br><font face=/font/big_bold.font>轉彎。</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "移除此檢查點"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "前方路段會沿著中央分隔帶向左側延伸。<br><br><font face=/font/big_bold.font>駛過中央分隔帶。</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "繞過路障，記得留意拖車的狀態。<br><br><font face=/font/big_bold.font>駛過蛇行彎道。</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "這個蛇行彎道相對要簡單一點，但交通錐桶讓行車路徑變得更為狹窄。<br><br><font face=/font/big_bold.font>駛過蛇行彎道，且不要撞到任何交通錐。</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "前方有幾個簡單彎道。雖說如此，您仍需給拖車的內側預留足夠的空間、使其遠離路障。<br><br><font face=/font/big_bold.font>轉彎。</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "您即將駛入圓環。注意——駛入、駛於和駛出圓環時，都需要給拖車預留足夠的空間。<br><br><font face=/font/big_bold.font>駛過圓環。</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "前方是一個短距直線區段。您可適當提速。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "此處彎道極為狹窄。緩速前進、善用所有可供利用的空間，並注意拖車的尾擺。<br><br><font face=/font/big_bold.font>駛過狹窄彎道。</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "最後幾個彎道的難度不高。記得留意拖車的狀態。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>繼續行駛，前往最終的停車處。</font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

