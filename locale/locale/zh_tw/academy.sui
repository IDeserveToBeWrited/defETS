	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "在這個場景中，我們將駕駛曳引車進行一次短程行駛、以此測試您會如何運用剛剛學到的技巧。"

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "路段設有各種類型和組合的彎道。我們既不競速、也不計時。請您耐心駕駛，並根據遇到的彎道和障礙物調整車速。"

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "路段在開始時較為平緩、輕鬆。但隨著您繼續行駛，彎道會逐漸變得複雜。"

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "留意車速。如果過快，很容易導致轉彎時誤判。"

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "路段的出口是一個非常狹窄的髮夾彎道。請慢速行駛，並善用所有可供利用的空間。"

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "在路障之間停下，鎖妥卡車。"


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "您需避免撞車、駛離路段或撞到任何交通錐，否則便無法完成此場景。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>向前行駛，通過右方急彎以進入路段。</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>以穩定車速通過彎道。</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "您即將進入一段更為複雜的連續彎道。<br><br><font face=/font/big_bold.font>請視情況調整車速，繼續行駛。</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>繼續駛向下組彎道。</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "前方即將進入數個平緩、輕鬆的彎道。請保持車速穩定。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "路段的結尾是一個急轉髮夾彎道。請減速，並在轉彎前靠向外側行駛。務必充分利用後視鏡！<br><br><font face=/font/big_bold.font>駛出路段。</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "前方的路障之間設有停車處。<br><br><font face=/font/big_bold.font>駛向停車處。</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "平行停車"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "在這個場景中，我們將學習如何在兩輛卡車之間進行平行停車。"

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "停在前方的停車處"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "檢查後視鏡"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "倒車進入停車處"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "在停車處對齊卡車"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "平行停車是每個卡車司機都應掌握的一項重要技巧。<br>準備出發。"

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "駛向停車處。<br>留意周遭的環境。"

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "對齊停車處前方的卡車。不要靠得太近，其保持適當距離、預留操作空間。"

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "急打方向，開始倒車。"

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "從司機側的後視鏡觀察時，對準後方卡車前方的路緣。"

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "前保險桿越開前方卡車後，就可以開始將卡車前端轉向停車處、使車身與車位對齊。"

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "回正方向盤，將卡車停在停車處的中央。<br>停下並鎖妥卡車。"

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "前方已經停著幾輛卡車。只剩一個空位供您停放。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "請持續留意周圍環境。整個操作過程中務必善用後視鏡。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>駛過停車處，進入標記區域。您可從該處開始倒車。<br><br><font face=/font/big_bold.font>停在標記區域。</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "檢查周圍是否有障礙物，確定是否可以安全倒車。<br><br><font face=/font/big_bold.font>查看副駕駛側的後視鏡。</font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "轉動方向盤，倒車進入停車處。<br><br><font face=/font/big_bold.font>開始倒車。</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "適時回正卡車。不要壓到路緣！<br><br><font face=/font/big_bold.font>將卡車對準車位。</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
