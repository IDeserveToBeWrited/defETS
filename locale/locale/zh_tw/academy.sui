	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "在這個場景中，我們將執行倒車操作、將卡車停在路緣旁邊。"

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "倒車靠近路緣。<br>倒車時務必注意周圍環境，請使用後視鏡進行觀察。"

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "隨著距離接近，便可開始將卡車對準停車處。倒車時務必注意卡車兩側的情況。"

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "在停車處停下，鎖妥卡車。"

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "停車處在您的後方，偏向副駕駛側。使用後視鏡調整方向、倒進停車處。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "移動卡車之前，記得使用後視鏡檢查周圍環境。<br><br><font face=/font/big_bold.font>開始倒車靠近路緣。</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "倒進停車處時，請持續留意周圍環境。<br><br><font face=/font/big_bold.font>停在指定地點。</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
