ont><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/time.mat width=22 height=22><offset vshift=2>@@aca_goal_time_limit@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_time_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/camera.mat width=22 height=22><offset vshift=2>@@aca_goal_exterior_drive@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_camera_desc@@</font></margin></align><br><offset vshift=15>"
#!}

#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "卡車駕駛進階資訊" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "完成要求"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "滿足所有通過條件即可完成場景"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "完成獎勵條件即可獲得星章"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "條件"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "前進與倒車之間的最大變更次數"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "完成場景所允許的最長時間"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "僅限使用車內鏡頭——靜止時仍可使用車外鏡頭"

	key[]: "aca_book_book2_completed_t"
	val[]: "已通過卡車駕駛進階"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br><br>您已完成卡車駕駛進階模塊中的所有通過條件，並獲得了相應的生涯檔案獎勵。您仍然可以挑戰，透過完成所有獎勵條件來獲得更多獎勵。</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "已完成卡車駕駛進階"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br><br>您已完成卡車駕駛進階模塊中的所有通過條件和獎勵條件，並獲得了相應的生涯檔案獎勵。</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "卡車駕駛進階"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "歡迎回到@@driving_academy@@！"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "以下場景是您邁向專業卡車駕駛之旅的下一步。"

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "這次，我們不會再手把手地引導您完成每項任務。因此，您需要發揮自己的技術和經驗來進行應對。"

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "您可能會遇到一些熟悉的操作，但本次會在全新環境中執行——場景將更貼近真實情況。"

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "在@@driving_academy@@中，新增了「通過」和「獎勵」條件。"

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "一如既往，您仍需在不撞到任何物件的情況下完成每個場景。然後順利停車，將其鎖妥……"

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "……只是，現在您還需要在規定的時限內完成任務。與此同時，前進與倒車的次數也存在限制。"

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "在更為嚴苛的情況下完成場景，即可達成獎勵條件……"

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "……例如更加嚴格的時限、更少的變向次數，以及僅限使用車內鏡頭。"

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "完成所有場景後，您便可將自己視為一名技藝純熟的卡車司機、並準備好迎接前路的下個挑戰。<br><br>如果想要進一步地挑戰自己，就完成每個場景的所有獎勵條件吧。如此一來，您便是名副其實的卡車駕駛之星！"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "教學"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "在這個教學場景中，我們將協助您熟悉「卡車駕駛進階」的全新功能。"

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "每個場景開始時，都會顯示<color value=@@clr_sel@@>「場景簡報」<color value=@@clr_txt@@>視窗。其中，將顯示該場景的全新通過條件和獎勵條件的資訊。<br><br>您需滿足通過條件，才能成功完成場景。至於獎勵條件，則是為經驗豐富、技術嫻熟的玩家準備的額外挑戰。<br><br><font face=/font/big_bold.font>請開啟點火系統以繼續。</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "其中一項獎勵條件要求您使用<color value=@@clr_sel@@>車內鏡頭<color value=@@clr_txt@@>完成場景。您仍可使用車外鏡頭檢查周圍環境，但——僅限在卡車靜止時。<br><br>現在，您可環顧四周、確定方位，然後切換回車內鏡頭。<br><br><font face=/font/big_bold.font>切換至跟隨鏡頭檢查周圍環境</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "確定方位，然後切換回車內鏡頭。<br><br><font face=/font/big_bold.font>查看卡車周圍</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>切換回車內鏡頭</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>時間<color value=@@clr_txt@@>也是「卡車駕駛進階」中的評斷因素。所有場景都設有單獨的時限。您需在時限內完成場景，否則便無法滿足通過條件。而其中的大量場景還額外設有更為嚴格的時限作為獎勵條件。<br><br>計時器僅會在卡車開始移動後啟動。<br><br><font face=/font/big_bold.font>啟動引擎並鬆開手煞車以繼續。</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "路徑點也是「卡車駕駛進階」的一項新增內容。您需抵達全部路徑點，否則便無法完成場景。<br><br>此外，系統會判定您抵達路徑點時卡車的朝向。因此，請務必留意路徑點附近的道路標線，確保方向正確。<br><br><font face=/font/big_bold.font>向前行駛至前方的路徑點。</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "您已抵達路徑點。現在，請繼續進行下一步。<br><br>後方還有一個路徑點，您需倒車前往。留意地面上的箭頭標誌，其表明卡車抵達路徑點時應面朝的方向。<br><br>此外，另一項需考慮的通過與獎勵條件是<color value=@@clr_sel@@>方向變更<color value=@@clr_txt@@>。我們會記錄您在前進與倒車之間的切換次數。您需保持在限制次數內，否則便無法滿足條件。<br><br><font face=/font/big_bold.font>倒車至路徑點，然後停下。</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "好了——目前為止，您已積累一次方向變更。<br><br>與後方的拖車聯結，繼續進行下一步。<br><br><font face=/font/big_bold.font>倒車至拖車處，與其聯結。</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "最後一個停車區域於你的右方。部分場景可能只有一個停車處，其他場景則可能會提供數個、供您自由選擇。只要正確停入任意一個停車處，即可完成本場景。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_attach@@ 聯結拖車。</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "停車處也標示卡車在停放時應該面朝的方向。如果方向有誤，將無法完成場景、直至將其修正為止。而這不僅耗費時間，還會增加方向變更的次數。<br><br><font face=/font/big_bold.font>駛向其中一個停車處，並正確地停於其中。</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "現在，您應該已經熟悉通過條件與獎勵目標的全新規則、並準備好挑戰「卡車駕駛進階」的全新場景了！<br><br><font face=/font/big_bold.font>拉起手煞車並關閉引擎以完成本場景。</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "捷徑"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "在這個場景中，您會嘗試使用一條捷徑……但不幸的是，其末端已被封鎖。然後，您需沿著原路倒車返回。"

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "駛向山頂的路徑點。然後，沿著原路倒車返回。<br><br>回到道路上後，駛向最後的停車區域。"



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "早鳥"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "在這個場景中，您需駛過擁擠不堪的場地。由於空間極為有限，請提前規劃各項行動。"

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "並不總會有空的停車處——在這種情況下，其他司機就會隨便找個地方停下卡車過夜、導致早上需要費上一番功夫來繞過它們。<br><br>盡己所能駛過場地，前往最後的停車處。"



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "蜿蜒曲折"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "在這個場景中，您的任務是通過一條非常複雜的訓練路段。您需在路上找到拖車、與其聯結，然後駛向終點。"

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "本場景旨在測試您的空間判斷和環境觀察能力。前方的路段充滿障礙物，而且部分無法輕易察覺。"

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "駛過路段，前往拖車處。找到之後、與其聯結，並駛至最後的停車處。"



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "頭暈眼花"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "在這個場景中，我們將測試您的操控技巧。一路繞行，直至抵達終點為止！"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "現在，是時候考驗一下您的卡車駕駛技術了——本路線專為測試您對卡車的熟悉程度而設！"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "關鍵區段是一條長距離螺旋路線，旨在考驗您駕駛卡車連續通過大弧度彎道的能力。"

#@}




#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "轉角倒車停車"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "在這個場景中，您需倒車繞過盲角、並駛入停車處。"

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "卸貨區域並不總會位於理想位置。在本場景中，其被旁邊的建築擋住、無法看清。"

