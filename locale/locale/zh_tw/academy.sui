	key[]: "aca_msg_book1_3_06_start"
	val[]: "前方有個車位，你需要停進去｡<br><br><font face=/font/big_bold.font>準備出發｡</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>開始駕駛並轉向車位｡</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "開過該車位，將拖車與標記區域對正，然後讓曳引車進入車位並對正。<br><br><font face=/font/big_bold.font>在指定區域停車。</font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>停在指定區域｡</font>"

	key[]: "aca_msg_book1_3_06_end"
