#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "基礎操作與移動"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "學習卡車的基礎操作，以及如何向前行駛和倒車。"

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>您已完成第一章：@@aca_chapter_book1_1_title@@。<br><br>您已經學會如何在駕駛前設定卡車、<br>前進和倒車，以及車燈和雨刷的使用方式。</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "基礎操控"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "學習如何駕駛、操控和停放曳引車。了解各種後視鏡及其用途。"

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>您已完成第二章：@@aca_chapter_book1_2_title@@<br><br>您已經學會如何使用卡車上的每面後視鏡、在移動前檢查卡車周圍的空間，以及執行基礎和進階操控技巧。</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "拖車的操控技巧"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "學習如何聯結拖車，以及在不同狀況下的操控技巧。"

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>您已完成第三章：@@aca_chapter_book1_3_title@@<br><br>您已經學會如何聯結/卸下拖車，<br>並感受到卡車在聯結拖車時的重量感和空間感。<br>與此同時，也在聯結拖車的情況下完成了數條具有挑戰性的路段。</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "聯結拖車倒車"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "學習新的操控技巧，從而更好地在聯結拖車時進行倒車和停車。"

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>您已完成第四章：@@aca_chapter_book1_4_title@@<br><br>您已經學會如何在聯結拖車時進行倒車，<br>以及各式各樣的停車技巧。</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "最終考核"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "展現您的知識和技巧，證明自己是一名出色的卡車司機！"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>恭喜！<br>您已完成第五章：@@aca_chapter_book1_5_title@@<br><br>您已經證明自己掌握駕駛、操控和停放卡車<br>所需具備的全部技巧！</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "引擎預熱"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>您已完成訓練：@@aca_chapter_book2_0_title@@。<br><br>您已了解「卡車駕駛進階」的規則和特點。</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "重回正軌"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>您已完成第二章：@@aca_chapter_book2_1_title@@。<br><br>您已預熱引擎、測試排檔、旋轉車輪，以及檢查煞車效能。後續章節將會更具挑戰性。</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "繼續轉動"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>您已完成第三章：@@aca_chapter_book2_2_title@@。<br><br>您已通過一系列困難且複雜的場景。您已展現出相應的技術和良好的表現。</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "最後衝刺"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜！<br>您已完成第四章：@@aca_chapter_book2_3_title@@。<br><br>您已成功完成各種操作——拖車操控、拖車停車以及拖車倒車，順利處理各種難題。您已證明自己是一名技術熟練的司機，能應對各種具有挑戰性的卡車駕駛狀況。"

	key[]: "aca_chapter_book3_1_title"
	val[]: "向前行駛"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "學習向前行駛時操控雙拖車所需的所有基本技巧。"

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 1 章:@@aca_chapter_book3_1_title@@。<br><br>你已經體驗過如何有效地駕駛和操控雙拖車。</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "倒車控制"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "了解倒車時操控雙拖車所需的必要步驟。"

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 2 章:@@aca_chapter_book3_2_title@@。<br><br>你已經學會了雙拖倒車的非凡技巧。</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "真實世界的準備"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "將你新學到的知識運用到更進階的場景中。"

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>恭喜!<br>你已完成第 3 章:@@aca_chapter_book3_3_title@@。<br><br>你在操控、停車和倒車時，成功應對了許多專屬雙拖車的多種困難情境。 你已在此證明了自己的實力，現在是時候在《歐洲卡車模擬2》的道路上拖曳雙拖車大顯身手了！</font><br><br>"


