#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "前方有各種複雜彎道及障礙物｡<br>把你已學會的都用上，這應該不算太難｡"

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "路上的指引將幫助你如何繞過這些障礙｡"

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "讓曳引車在彎道的外側｡<br>由於拖車的轉彎半徑會小於曳引車(正所謂\"內輪差\")，因此轉彎時需要尻大一些｡"

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "下一個轉角是一個簡單的 90 度轉彎｡ <br> 同樣的，讓卡車從彎道外側轉彎，並利用所有可用空間｡"

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "從這裡慢慢來，儘管道路變寬但你仍要保持精準｡"

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "與路障保持較遠距離｡"

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "進入狹窄區域要特別小心｡<br>讓曳引車在進入前靠外以確保拖車可以通過｡"

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "最後一個 90 度彎比第一個轉彎要急得多，但如果你明智地利用空間，還是有足夠的空間｡"

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "停在指定區域，然後安全停放卡車並關閉引擎｡"


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "請記住，你可以利用道路上的指引來幫助你通過這些道路｡<br><br><font face=/font/big_bold.font>準備出發｡</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "使用後視鏡也可以幫助你安全通過道路｡ 你必須隨時注意後側拖車的路徑｡<br><br><font face=/font/big_bold.font>轉過第一個彎道｡</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "離開彎道後需觀察後側拖車，準備進入下一個彎道｡<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>繼續通過下一個彎道｡</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "在轉彎前，一定要確認拖車周圍沒有任何障礙物｡<br><br><font face=/font/big_bold.font>繼續繞過前方的障礙物｡</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "當拖車遠離障礙物時，向助手邊快速轉向以通過狹窄通道｡<br><br><font face=/font/big_bold.font>向狹窄通道前進｡</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "這裡需要非常精準的駕駛。 隨時注意你的後視鏡。<br><br><font face=/font/big_bold.font>向每個彎道外側靠近。</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "這個彎道非常急，但你利用好前面的空間就可以安全通過了。<br><br><font face=/font/big_bold.font>通過最後的彎道。</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "進階訓練課程 - 拖車"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "在章節三的最後一個場景，我們會在一條更長的訓練路段上通過各種彎道來幫助你學習如何熟練的拖著拖車駕駛｡"

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "狗腿彎"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "移除此目標"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "中央分隔帶"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "第一個蛇形彎"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "第二個蛇形彎"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "簡單的彎道"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "圓環"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "直線路段"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "急彎"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "最終彎道"

	key[]: "aca_goal_book1_3_04_check11"
