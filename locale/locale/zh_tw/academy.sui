#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "駕駛之前"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "在第一個場景中，我們將介紹駕駛室的基礎知識。正確調整座椅、方向盤和後視鏡至關重要，良好的視野能幫助您應對各種緊張或危險的狀況。<br><br>我們將逐一介紹調整這些部件的操作方式。"

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "座椅和後視鏡調整"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "後視鏡與視野檢查"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "歡迎來到第一堂課！<br>我們將學習如何執行卡車上路前的準備工作。"

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "無論何時，都需要確保安全、專業和可控的駕駛狀態——這點至關重要。<br>正確調整座椅、方向盤和後視鏡將能幫您達成這一目的。"

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "在卡車的兩側有一些車輛。<br>它們將幫助您正確調整後視鏡。"

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "不必著急——慢慢調整每項設定，直至自己滿意為止。<br>因為這些設定會大幅影響您操控卡車的能力。"

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "座椅和方向盤調整"

	key[]: "adj_tut_title_1"
	val[]: "調整主後視鏡"

	key[]: "adj_tut_title_2"
	val[]: "調整凸面鏡"

	key[]: "adj_tut_title_3"
	val[]: "視野檢查和最終後視鏡調整"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "按下 @@imv_nrm_adjuster@@ 或在暫停選單中選擇「車輛調整」進入"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "在暫停選單中選擇「車輛調整」進入"

	key[]: "adj_tut_open_adj"
	val[]: "如需在遊戲中顯示『@@adjust_link_t@@』，$OPEN_ADJUSTER$。"

	key[]: "adj_tut_open_seat"
	val[]: "首先，讓我們來調整駕駛座和方向盤。<br><br><font face=/font/big_bold.font>開啟『@@adj_seats@@』繼續。</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>開啟 @@adj_mirrors@@ 調整後視鏡設定。</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "首次進入卡車時，務必先根據自己的喜好調整座椅、方向盤和後視鏡——這點至關重要。<br><br>正確的坐姿對取得良好的視野起到關鍵作用。所有的操控裝置都必須在觸手可及的範圍內，且司機要能清楚看見前方、兩側和後視鏡內的狀況。<br><br><font face=/font/big_bold.font>按下 $OPEN_ADJUSTER$ 顯示設定選單。</font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>調整座椅，令您能清楚地看見周圍環境和後視鏡，且所有的操控裝置都必須在觸手可及的範圍內。<br><br>調整方向盤，使其處於舒適的位置，且不會遮擋任何儀表。<br><br><font face=/font/big_bold.font>調整到滿意後，按下 @@imv_nrm_back@@ 返回設定選單。</font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>卡車有著許多大型盲區，因此配備了多組車外後視鏡，以幫助司機盡可能地掌握周圍情況。<br><br>正確調整這些後視鏡，將使您獲得最佳的周邊視野。<br><br><font face=/font/big_bold.font>開啟『@@adj_mirrors@@』繼續。</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>主後視鏡涵蓋卡車和拖車側面的區域。<br><br>請以兩側的汽車作為參照，將主後視鏡調整至正確位置。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_selectfcs@@ 繼續。</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "主後視鏡是您查看車側和車後狀況的主要工具。您應能清楚看見旁邊的汽車，同時確保能在鏡中看到部分拖車，以便準確判斷周圍障礙物的位置。"

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "調整到滿意後，切換至副駕駛側的主後視鏡。"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "同樣，您應能清楚看見旁邊的汽車、且能在鏡中看到部分拖車。"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "調整到滿意後，切換至司機側的凸面鏡。"

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>凸面鏡能提供更廣闊的視野，令您可以看見更多的車側狀況。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_selectfcs@@ 繼續。</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "理想狀況下，您應能看見停在旁邊的汽車和卡車，同時仍能看見自己卡車的一小部分。"

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "調整到滿意後，切換至副駕駛側的凸面鏡。"

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "同樣，您應能看見停在旁邊的汽車和卡車，同時仍能看見自己卡車的一小部分。"

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "調整到滿意後，按下 @@imv_nrm_back@@ 關閉後視鏡設定。"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_back@@ 返回設置選單。</font>"

	key[]: "adj_tut_close_adj"
	val[]: "很好，座椅和後視鏡皆已調整至您偏好的狀態。距離正式上路又近了一步！<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_back@@ 關閉配置選單。</font>"

	key[]: "adj_tut_open_con"
	val[]: "再次環顧四周，確保你對駕駛室內的視野感到滿意，並確保後視鏡能讓自己清楚的看到卡車周圍的情況。<br><br>如果對目前設定不滿意，您可在『@@adjust_link_t@@』配置選單再次對後視鏡進行調整。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 結束首個場景。</font>@@aca_goal_tip@@ 如要顯示或隱藏 UI 後視鏡，您可在暫停選單中的『@@adjust_link_t@@』—『@@adj_ui_mirrors@@』進行調整。您可利用 UI 後視鏡更輕鬆地查看副駕駛側後方的情況。"
#@}

# Book 1 Scenario 1_02 - strings not needing translation
#!{
	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "鏡頭控制"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "在這個場景中，我們將了解可供您使用的各類鏡頭、以及它們會如何協助您操控和移動卡車。"

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "座椅位置"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "後方視野"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "檢查後視鏡"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "切換至外部鏡頭"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "查看卡車周圍"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "在這個場景中，<br>我們將了解可用的各個鏡頭。"

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "共有 7 種鏡頭供您選擇。我們只會介紹<br>其中幾種，並說明各自的用途。"

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "多種角度不同的鏡頭，能幫助您在狹小空間內更好地操控車輛。"


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "留意行車方向是安全且專業駕駛的核心基礎。如果目前的座椅位置並不適合自己，您可在『@@adjust_link_t@@』進行調整（於暫停選單中進入）。<br><br><font face=/font/big_bold.font>準備好後，按下 @@imv_nrm_activate@@ 確認。</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "倒車時，後視鏡未必能提供清晰的視野。必要時，您需將頭探出窗外、向後觀察，以獲得更好的視野。<br><br><font face=/font/big_bold.font>請將鏡頭完全轉到司機側，以看向窗外、觀察拖車後方。</font>@@aca_goal_tip@@ 您需位於車輛內部。"

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "聯結拖車倒車時，使用此鏡頭檢查拖車。從司機側倒車會更好，因為可以充分利用這個鏡頭。而從副駕駛側倒車，車後視野將非常受限。<br><br><font face=/font/big_bold.font>請看向副駕駛側。</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "沒錯——這便是一般不建議從副駕駛側倒車的原因；你會發現視野非常受限。幸好，您還有 7 個車外鏡頭可供使用。<br><br>按下 @@imv_nrm_camcycle@@ 即可依照順序切換至下個鏡頭。循環切換完全部 7 個鏡頭後，就會回到最開始的鏡頭。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_camcycle@@ 切換至下個鏡頭。</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "車外鏡頭能為您提供觀察卡車周圍狀況的最佳視角。<br><br><font face=/font/big_bold.font>查看卡車周圍。</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>再次按下 @@imv_nrm_camcycle@@ 即可切換至下個鏡頭。</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "俯瞰視角能提供卡車周圍的全景概覽，極大簡化了停車和在狹小空間內的駕駛操作。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_camcycle@@ 切換至下個鏡頭。</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "車頂鏡頭能令您在幾乎沒有遮擋的情況下清楚看見卡車前方遠處的路況。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_camcycle@@ 切換至我們本次要介紹的最後一個鏡頭。</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "後部視角是快速切換至先前透過轉動車內鏡頭所得視野的捷徑。正如之前所說，在倒車或停車時很有幫助。<br><br>在遊戲中，還有更多的鏡頭可供選擇。您可按下 @@imv_nrm_camcycle@@ 逐一嘗試。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_cam1@@ 返回車內鏡頭。</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "首次駕駛"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "在這個場景中，我們將學習如何使卡車準備就緒，並首次向前行駛。"

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "啟動點火系統"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "啟動引擎"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "檢查周圍"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "踩下主煞車"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "掛入擋位"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "釋放手煞車"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "向前行駛"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "停車"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "拉起手煞車"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "切回空檔"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "關閉引擎"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "在最初的幾次駕駛中，我們僅會使用曳引車。<br>沒有載貨車廂、需透過拖車來運輸貨物和材料的卡車，便是所謂的「曳引車」。"

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "曳引車因用途廣泛而較為常見：能在卸下空的拖車後立即聯結其他滿載拖車，無需等待。與此同時，也能直接變為使用其他種類的拖車。"

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "在首次駕駛中，您的任務是向前行駛並在虛線後方停車。<br>啟動引擎，遵循指令使卡車準備就緒。完成之後，向前行駛。"

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "駛過虛線、停下、關閉引擎，然後鎖妥卡車。"

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "在接下來的訓練中，您將首次移動卡車。<br><br>當然，您需先啟動引擎、否則便無從談起。而為了啟動引擎，您得啟動點火系統。<br><br><font face=/font/big_bold.font>按下 $input engineelect$ 啟動點火系統。</font>@@aca_goal_tip@@ 在預設情況下，開啟通電即自動發動引擎。您可在選項介面中調整此行為 -『遊戲設定』- @@auto_engine_start@@。"

	key[]: "aca_msg_book1_1_03_start"
	val[]: "啟動點火系統後，卡車的電子系統便會隨之點亮。您可能已經注意到儀表板上的警示燈正在閃爍——不必擔心，這是正常現象。如果在引擎啟動後警示燈仍然亮著，則代表卡車很可能出現了故障。唯一的例外是停車燈，其只會在我們釋放手煞車時熄滅。<br><br>幸好，這輛卡車狀況良好。我們可以繼續進行訓練。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_engine@@ 啟動引擎。</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "啟動引擎後，記得在開始移動之前檢查周圍——這點至關重要。<br><br><font face=/font/big_bold.font>查看卡車周圍並檢視司機側和副駕駛側的後視鏡，確認卡車周圍的區域淨空、沒有任何障礙物。</font>@@aca_goal_tip@@您需位於車輛內部。"

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "雖然顯而易見，但在開始移動之前、需先知道如何停車。<br><br><font face=/font/big_bold.font>使用 $input backward$ 即可踩下主煞車。</font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "接下來，您將學習如何變更行駛方向。<br><br>憑藉自動變速箱，您不需要手動換檔——一切都會自動完成。<br><br><font face=/font/big_bold.font>使用 $input forward$ 切換至前進檔。</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "接下來，您將學習如何變更行駛方向。<br><br>真實自動變速箱能讓您在前進檔、空檔和倒車檔之間切換，就跟現實中的自動變速箱一樣。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_gearup@@ 切換至前進檔。</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "接下來，您將學習如何變更行駛方向。<br><br>序列變速箱能讓您依照順序換檔，就跟現實中的序列變速箱一樣。<br><br>與掛入前進檔的方式相同，加速時需切換至更高的檔位。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_gearup@@ 掛入一檔。</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "接下來，您將學習如何變更行駛方向。<br><br>透過排檔桿和離合器，您能體驗與現實手排變速箱相同的換檔感受。<br><br>完全踩下離合器和主煞車。<font face=/font/big_bold.font>使用排檔桿掛入一檔。<color value=@@clr_txt@@>保持完全踩下離合器和主煞車。</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "如要開始移動，您需先釋放手煞車。<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 釋放手煞車。</font> @@aca_goal_tip@@ 在預設情況下，將不會啟用手煞車。您可以在選項介面中調整此行為 -『遊戲設定』- @@auto_park_brake@@。"

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "卡車已經準備好前進了。開始移動並越過虛線。<br><br><font face=/font/big_bold.font>踩下加速踏板開始移動：$input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "卡車已經準備好前進了。開始移動並越過虛線。<br><br><font face=/font/big_bold.font>踩下加速踏板開始移動：$input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "卡車已經準備好前進了。開始移動並越過虛線。<br><br><font face=/font/big_bold.font>踩下加速踏板開始移動：$input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "卡車已經準備好前進了。開始移動並越過虛線。<br><br><font face=/font/big_bold.font>釋放主煞車，逐漸釋放離合器使其接合，同時踩下加速踏板維持轉速、避免引擎熄火。完全釋放離合器後，即可根據需要加速和換檔。</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "使用主煞車停車。<br><br><font face=/font/big_bold.font>使用 $input backward$ 將卡車停下。</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "使用煞車來停車｡<br><br><font face=/font/big_bold.font>使用 $input backward$ 將卡車停下。</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "使用主煞車停車。<br><br><font face=/font/big_bold.font>使用 $input backward$ 將卡車停下。</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "需要停車時，先完全踩下離合器， <font face=/font/big_bold.font>然後踩下主煞車踏、將卡車停下。<color value=@@clr_txt@@>使用排檔桿切回空檔，之後便可釋放離合器。</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "現在，鎖妥卡車。手煞車可確保卡車在停好後不會意外滑動。<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 拉起手煞車。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "憑藉自動變速箱，您不需要手動換檔——一切都會自動完成。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 確認。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_geardown@@ 切換至空檔。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_geardown@@ 切換至空檔。</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>將排檔桿切回空檔，然後釋放離合器。</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "您已經學會如何讓卡車移動，以及如何令其安全停穩了。<br><br><font face=/font/big_bold.font>按下 $input engineelect$ 關閉引擎。</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "倒車"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "在這個場景中，我們將首次嘗試倒車。同時還將學習在倒車時如何利用後視鏡觀察車後情況、需要留意的事情，以及怎樣做好準備。"

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "啟動引擎"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "檢查副駕駛側的後視鏡"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "檢查駕駛側的後視鏡"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "掛入擋位"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "釋放手煞車"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "切回空檔"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "關閉引擎"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "在這次駕駛中，我們將進行直線倒車。您需倒車越過虛線，然後停在該處。"

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "倒車時，務必持續環顧四周、觀察所有的後視鏡，並確保周圍和後方暢通無阻。"

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "啟動引擎、掛入倒車檔，並開始移動。"

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "倒車越過虛線、停下、關閉引擎，然後鎖妥卡車。"

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "按照在上個場景學到的方法，使卡車準備就緒。<br><br><font face=/font/big_bold.font>完成之後，啟動引擎。</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "檢查後視鏡，確認周圍區域淨空。如果對後視鏡的位置不滿意，您可在『@@adjust_link_t@@』進行調整。<br><br><font face=/font/big_bold.font>查看副駕駛側的後視鏡。</font>@@aca_goal_tip@@您需位於車輛內部。"

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "您即將駛過虛線。雖然目前車道暢通，但在正常駕駛時務必持續觀察四周、透過後視鏡來掌握周遭情況。<br><br><font face=/font/big_bold.font>檢查司機側的後視鏡。</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>使用 $input backward$ 切換為倒車檔。</font>@@aca_goal_tip@@ 大多數卡車在倒車時，會自動啟動倒車提示告警音｡ 您可在選項介面中將其關閉 -『音訊』- @@sound_of_reverse@@。"

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_geardown@@ 切換至倒車檔。</font>@@aca_goal_tip@@ 大多數卡車在倒車時，會自動啟動倒車提示告警音｡ 您可在選項介面中將其關閉 -『音訊』- @@sound_of_reverse@@。"

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_geardown@@ 切換至倒車檔。</font>@@aca_goal_tip@@ 大多數卡車在倒車時，會自動啟動倒車提示告警音｡ 您可在選項介面中將其關閉 -『音訊』- @@sound_of_reverse@@。"

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>踩下離合器並將排檔桿移動至倒車檔。</font>@@aca_goal_tip@@ 大多數卡車在倒車時，會自動啟動倒車提示告警音｡ 您可在選項介面中將其關閉 -『音訊』- @@sound_of_reverse@@。"

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "您已掛入倒車檔。<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 釋放手煞車。</font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "使用 $input backward$ 開始移動。<br><br><font face=/font/big_bold.font>倒車越過虛線。</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "踩下加速踏板開始移動：$input forward$。<br><br><font face=/font/big_bold.font>倒車越過虛線。</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "踩下加速踏板開始移動：$input forward$。<br><br><font face=/font/big_bold.font>倒車越過虛線。</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "緩慢釋放離合器，同時踩下加速踏板維持引擎轉速。<br><br><font face=/font/big_bold.font>倒車越過虛線。</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>踩下主煞車來停下卡車：$input forward$</font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>踩下主煞車來停下卡車：$input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>踩下主煞車來停下卡車：$input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>完全踩下離合器，然後踩下主煞車踏板來停下卡車。</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 啟用手煞車。</font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "憑藉自動變速箱，您不需要手動換檔——與現實中不同，一切都會自動完成。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 確認。</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_gearup@@ 切回空檔。</font>@@aca_goal_tip@@現代卡車在啟用手煞車時，會自動切換至空檔。然而，養成親手操作的習慣仍很重要。在後續場景中，我們將不再要求執行此步驟。"

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_gearup@@ 切回空檔。</font>@@aca_goal_tip@@現代卡車在啟用手煞車時，會自動切換至空檔。然而，養成親手操作的習慣仍很重要。在後續場景中，我們將不再要求執行此步驟。"

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>將排檔桿切換回空檔，然後釋放離合器。</font>@@aca_goal_tip@@ 現代卡車在啟用手煞車時，會自動切換至空檔。然而，養成親手操作的習慣仍很重要。在後續場景中，我們將不再要求執行此步驟。"

	key[]: "aca_msg_book1_1_04_end"
	val[]: "記住——倒車時要持續留意周圍環境，特別是在交通繁忙的地區。<br><br><font face=/font/big_bold.font>按下 $input engineelect$ 關閉引擎。</font>"
#@}

# Scenario 1_05 formatting
#!{
	key[]: "aca_msg_book1_1_05_low_beam_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/parking_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

