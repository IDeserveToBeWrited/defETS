#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "歡迎來到最終考核的第一部分。在這裡，我們將檢驗您在學院習得的卡車駕駛技術。"

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "首先，您需聯結拖車。完成之後，駕駛卡車繞行整個測試區域。"

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "您需從小型停車場出發，前往東部測試路段。"

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "環道設有數段需要在路障之間行駛的通道，極具挑戰。"

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "路線的絕大部分將經過東部測試路段。"

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "我們將測試您在各種情況下操控卡車的能力。"

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "您將駕駛卡車通過幾個急轉彎道。"

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "您將駛過連接各個路段的區段。"

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "最後，您需通過小型環道。"

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "其中設有大量複雜通道和急轉彎道。"

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "您需精準停車，否則便無法完成本次考核。"

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "不必緊張。您已經學習過通過考核所需的所有技巧。<br><br>祝您好運！"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "拖車位於您的前方。<br><br><font face=/font/big_bold.font>駛向拖車。</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "將曳引車對準拖車。<br><br><font face=/font/big_bold.font>倒車，然後連接大王銷。</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>鎖妥卡車。</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "按下 @@imv_nrm_attach@@<font face=/font/big_bold.font> 聯結拖車。</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "已聯結拖車。與此同時，卡車也準備就緒、隨時可以上路。<br><br><font face=/font/big_bold.font>釋放手煞車。</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>開始行駛，前往停車場出口。</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "跟隨道路標線。與此同時，留意路障。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "更具挑戰的區段即將到來。<br><br><font face=/font/big_bold.font>小心地在路障之間行駛。</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "我們會在此部分考驗您操控拖車通過各種彎道的能力。<br><br><font face=/font/big_bold.font>轉入路段。</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>駛過通道。</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>直行。</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>小心通過彎道。</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "您即將進入更為複雜的區段。小心行駛。<br><br><font face=/font/big_bold.font>繼續下坡。</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>向左急轉彎。</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>駛出路段。</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "您即將駛入較為簡單的區段。<br><br><font face=/font/big_bold.font>繼續下坡。</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>繼續沿著道路行駛。</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "前方即將轉彎，進入下個路段。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>向右轉彎。</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>繼續沿著路段行駛。</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "前方將會出現更多急轉彎道。<br><br><font face=/font/big_bold.font>請適當調整速度。</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>向左轉彎。</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>進入彎道，繼續行駛。</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "您可能需要稍微駛離瀝青路面以進行轉彎。<br><br><font face=/font/big_bold.font>小心轉彎，善用可供利用的空間。</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>駛出環道，然後駛入停車處。</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "最終考核（第 2 部分）"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "最終考核的最後一關就在眼前。我們將評估您在之前的場景中習得的停車技巧。只要能謹慎、精準地停車，您就能作為一名技術精湛的卡車司機、正式馳騁在歐洲的道路上！"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "錯位操作"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "斜向停車"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "駛過停車場"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "平行停車"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "最終停車"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "歡迎來到最終考核的第二部分。我們將前往附近的停車場測試您的倒車和入庫技巧。"

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "您將面對數個連續停車挑戰，您的能力將會得到充分的檢驗。"

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "此處空間有限。提高警惕，不要操之過急。"


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "務必小心，切勿急躁。即便首次嘗試沒有成功也無所謂，重要的是不傷及卡車或周圍的一切。<font face=/font/big_bold.font><br><br>準備出發。</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>駛向考核的第一部分。</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "您的首個任務是示範錯位停車操作。您需在聯結拖車的情況下倒車進入的左側的車位。<br><br><font face=/font/big_bold.font>執行錯位停車操作。</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "下個任務是倒車進入一排已經停放好了的卡車之間。小心不要碰到其他卡車！<br><br><font face=/font/big_bold.font>執行斜向停車操作。</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "繼續駛過停車場。小心提防意外狀況。<br><br><font face=/font/big_bold.font>繼續行駛。</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "現在，來嘗試在前方路緣旁邊的兩輛卡車之間執行平行停車操作吧。<br><br><font face=/font/big_bold.font>執行平行停車操作。</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "好了，接下來便是最後一次停車操作——將車輛停在您的左側吧！方式不限。<br><br><font face=/font/big_bold.font>倒車進入指定區域。</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "只差一步。離開測試區域，停放卡車。<br><br><font face=/font/big_bold.font>從左側駛離測試區域。</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "您可以將卡車停在右側，與其他車輛停在一起。<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "聯結拖車平行停車"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "在這個場景中，我們將學習如何在聯結拖車的情況下進行平行停車。"

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "停在標記區域"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "在聯結拖車的情況下進行平行停車，是每個卡車司機的必備技能。<br>無論是在大城市的路邊停車、或是在鄉間的休息區裡停靠，是每個卡車司機都應該掌握的技巧。"

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "經過停車處時，仔細觀察、確認有足夠的空間可以停放曳引車和拖車。在這裡，我們已經為您準備了足夠的空間。"

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "對齊停車處前方的卡車。不要靠得太近，與其保持適當距離、預留操作空間。"

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "往與停車處相反的方向急打方向並開始倒車。目的是為了讓拖車能立即轉入其中。"

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "拖車與車位對齊後，即可將其順勢推入。"

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "在司機側的拖車車輪進入車位前，就開始轉動方向盤、使拖車遠離路緣。"

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "使曳引車與拖車對齊並停入車位中間。<br>停下、關閉引擎，然後鎖妥卡車。"

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "您可以看見前方其他卡車之間的停車處。倒車時務必觀察後視鏡，保持卡車與周圍的障礙物之間保持安全距離。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "在停車場找到車位。<br><br><font face=/font/big_bold.font>向前行駛。</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>駛過停車位，進入標記區域。您可從該處開始倒車。<br><br><font face=/font/big_bold.font>停在標記地點。</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "將曳引車往遠離車位的方向倒，從而使拖車進入其中。但不要轉得太急，否則有可能會碰上路緣。<br><br><font face=/font/big_bold.font>開始倒車。</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "將拖車對準車位。必要時可透過向前/向後移動，並轉動方向盤以調整位置。<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "恭喜，您已經成功通過「卡車駕駛基礎」的考核、掌握了正確操控卡車所需的全部技巧。"

	key[]: "aca_msg_book1_outro02"
	val[]: "您已經向職業卡車司機的夢想邁出了第一步。"

	key[]:	"aca_msg_book1_outro03"
	val[]: "現在，您已經準備好踏上歐洲的道路、迎接自己的首個挑戰了……"

	key[]: "aca_msg_book1_outro04"
	val[]: "……但，冒險才剛剛開始。"
#@}


