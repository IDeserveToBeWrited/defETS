	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@無意取代實車訓練。</font><br><br> <color value=@@clr_txt@@>我們強烈建議，在現實中嘗試駕駛卡車之前，先向經過認證的卡車訓練機構尋求指導。<br><br>意欲使用@@driving_academy@@作為司機實車培訓輔助工具的機構，請透過 academy@scssoft.com 與我們聯絡。"

	key[]: "aca_book_book1_title"
	val[]: "卡車駕駛基礎"

	key[]: "aca_book_book1_desc"
	val[]: "了解駕駛卡車的基礎知識，從基本功能與操作到拖車的操控技巧。"

	key[]: "aca_book_book2_title"
	val[]: "卡車駕駛進階"

	key[]: "aca_book_book2_desc"
	val[]: "在更具挑戰性的條件下透過新場景精進您的卡車駕駛技術。"

	key[]: "aca_book_book3_title"
	val[]: "雙拖操控"

	key[]: "aca_book_book3_desc"
	val[]: "挑戰用雙拖車組合駕駛與倒車的獨特考驗。"

