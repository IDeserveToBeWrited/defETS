	key[]: "aca_msg_book1_1_05_high_beam_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/high_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_lblinker_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/blinkers_left.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_rblinker_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/blinkers_right.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights_blink.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"
#!}

#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "照明和雨刷"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "在這個場景中，我們將介紹卡車的幾項基礎操作——您可憑此維持清晰的視野，並讓其他道路使用者預判您的行車動向。<br><br>您將學習在惡劣天氣下利用雨刷維持良好的能見度，以及照明和方向燈的使用方式。"

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "啟動引擎"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "停車燈"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "近光燈"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "遠光燈"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "左轉方向燈"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "右轉方向燈"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "危險警告燈"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "雨刷"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "關閉引擎"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "在這個場景中，我們將學習卡車的幾項功能—您可憑此維持清晰的視野，同時讓其他道路使用者看見您。"

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "我們會啟用各個照明系統，並學習何時需要使用它們。"

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "我們將操作左、右轉方向燈。"

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "最後，我們將學習如何使用雨刷，確保其在不同程度的降水量下都能發揮效用。"



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "來學習如何使用各種車燈，以及雨刷的控制方法吧。<br><br>近光和遠光頭燈能確保您看清前方道路。方向燈和危險警告燈是為了告知其他道路使用者您接下來的動作。<br><br>雨刷是用於清除擋風玻璃上的水漬和其他雜物。<font face=/font/big_bold.font><br><br>啟動引擎，但先不要釋放手煞車。</font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "到目前為止，您只使用了日行燈。其會在點火系統啟動後自動開啟，用於在一般情況下提高車輛的能見度。但現在情況有所惡化，您需要使用全套照明系統。<font face=/font/big_bold.font><br><br>按下 @@imv_nrm_light@@ 開啟停車燈。</font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>開啟停車燈後，前方、車側和後方的標誌燈便會隨之點亮。在光線不足的環境停車時使用此燈，能讓其他道路使用者注意到您。<font face=/font/big_bold.font><br><br>按下 @@imv_nrm_light@@ 開啟近光燈。</font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>近光燈能照亮前方道路，並在光線不足的情況下提高車輛的能見度。<font face=/font/big_bold.font><br><br>使用 @@imv_nrm_hblight@@ 切換至遠光燈。</font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>遠光燈能讓您在光線不足的情況下看得更遠。<br><br>不過使用時要特別注意，因為遠光會使其他道路使用者、特別是迎面來車眩目。接近迎面來車時，應關閉遠光燈。<font face=/font/big_bold.font><br><br>使用 @@imv_nrm_hblight@@ 關閉遠光燈。</font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "現在，來看看方向燈吧。方向燈的功能是發出視覺訊號，告知其他道路使用者您即將變更車道或轉彎。<font face=/font/big_bold.font><br><br>按下 @@imv_nrm_lblinker@@ 開啟左轉方向燈。</font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>您會發現儀表板上的左轉方向燈指示燈正在閃爍。與此同時，卡車左側的方向燈也在閃爍。<font face=/font/big_bold.font><br><br>現在按下 @@imv_nrm_lblinker@@ 關閉左轉方向燈。</font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "轉向燈號應及時亮起，好讓其他道路使用者有足夠的時間預判您的動作、進而調整自己的行車方式。<font face=/font/big_bold.font><br><br>按下 @@imv_nrm_rblinker@@ 開啟右轉方向燈。</font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>儀表板上的右轉方向燈指示燈正在閃爍。與此同時，卡車右側的方向燈也在閃爍。<font face=/font/big_bold.font><br><br>現在，按下 @@imv_nrm_rblinker@@ 關閉右轉方向燈。</font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>危險警告燈的開關以紅色三角形標誌來表示。 其乃道路安全的重要一環，僅應在必要時使用。此功能會同時啟用左、右轉方向燈。<font face=/font/big_bold.font><br><br>按下 @@imv_nrm_flasher4way@@ 開啟危險警告燈。</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>現在兩個方向燈指示燈都在閃爍，表示危險警告燈已經開啟。與此同時，卡車兩側的方向燈也在閃爍。<br><br>危險警告燈一般在卡車停於非常規位置時使用，例如因技術或機器問題停靠路邊時。也可用於提醒後方司機在前方有車輛停滯。<font face=/font/big_bold.font><br><br>現在，按下 @@imv_nrm_flasher4way@@ 關閉危險警告燈。</font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "現在，來看看擋風玻璃雨刷吧。雨刷是用來清除除附著於車輛擋風玻璃上的雨點及灰塵的裝置。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_wipers@@ 將雨刷設定為間隔。</font>@@aca_goal_tip@@ 您可啟用雨量感測器，使雨刷在下雨時自動啟動。您可在選項介面 -『遊戲設定』- 中找到 @@rain_sensor@@ 設定。"

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "此設定可令雨刷間歇性作動，適用於降水量較小的情況。<br><br>如您所見——現在降水量過大，雨刷無法及時清除擋風玻璃上的雨水。<font face=/font/big_bold.font><br><br>再次按下 @@imv_nrm_wipers@@ 將雨刷切換至低速模式。</font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "現在，雨刷正以穩定的速度運作，持續清除雨水。<font face=/font/big_bold.font><br><br>再次按下 @@imv_nrm_wipers@@ 切換至高速模式。</font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "You can see the wipers are working much faster now to clear the windscreen for maximum visibility. <font face=/font/big_bold.font><br><br>Press @@imv_nrm_wipers@@ to turn the wipers off. </font>@@aca_goal_tip@@ You can also use the @@o_im_wipers_back@@ function to cycle backwards through the wipers speed settings. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "您可以看到雨刷擺動得更快了，能確實清楚雨水、獲得最大的能見度。<font face=/font/big_bold.font><br><br>按下 @@imv_nrm_wipersback@@ 數次，直至雨刷關閉為止。</font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>關掉車燈並關閉引擎。</font>"
#@}

#+ Book 1 Scenario 2_01
#@{

#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "繞行交通錐"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "在這個場景中，我們將學習如何在後視鏡的幫助下駕駛卡車繞過數個交通錐。"

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "遵循指令"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "檢查後視鏡"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "準備開始"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "駕駛卡車"



	key[]: "aca_goal_book1_2_01_check1"
	val[]: "進入蛇行彎道"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "避開交通錐"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "「之」字駛過交通錐"
#!{
	key[]: "aca_goal_book1_2_01_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_01_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
	key[]: "aca_goal_book1_2_01_end"
	val[]: "鎖妥車輛"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "在這個場景中，我們將駕駛曳引車通過一個由交通錐組成的短距蛇行彎道。"

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "小心駕駛，並隨時注意周遭環境。留意卡車兩側的情況，並利用後視鏡來輔助行駛。"

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "臨近終點時，路段會變得越來越窄。因此，需要您進行精準操作。"

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "停在指定區域，鎖妥卡車。"

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "您需繞過所有交通錐、不能撞到任何一個，否則便無法完成此場景。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 確認。</font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "使用後視鏡來兼顧卡車兩側的情況。<br><br>副駕駛側前方和側邊的後視鏡能有效幫您確認方位。<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 確認。</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "如有必要，您可在『@@adjust_link_t@@』（於暫停選單中進入）調整後視鏡。<br><br><font face=/font/big_bold.font>準備出發。</font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "卡車仍未準備好行駛，也許您漏了某些步驟？<br><br>引擎啟動了嗎？手煞車釋放了嗎？"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>緩慢向前行駛，通過蛇行彎道。</font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>繼續繞行交通錐。請特別留意副駕駛側。</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>繼續在蛇行彎道中折返行駛，且不要碰到任何交通錐。</font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>停在指定區域。</font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>鎖妥卡車並關閉引擎。</font>"
#@}

