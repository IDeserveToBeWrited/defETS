	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "在這個場景中，你需要倒車停入位於司機邊後方的停車位｡"

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "在拖車倒車時有幾個需要記住的可以極大幫助你倒車的要點。<br>首先是拖車總是朝曳引車的反方向。"

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "其二則是你可以透過觀察卡車和拖車車軸來方便的了解拖車將要行進的方向。"

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "第三，微的操作即可讓你到達你要去的位置，無需過度操作。"

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "開始將曳引車略微轉離停車位，拖車將開始指向它。"

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "跟隨拖車，邊倒車邊調整以將其保持在正確路徑上。"

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "留意你的拖車以及曳引車後方的車輪。 它們將會告訴你拖車的指向，以及曳引車推行的方向。"

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "第四點則是將拖車急轉彎總是比嘗試將其從極限角度拉直更容易。 直到你距離車位夠近之前都要瞄準車位外側，然後你可以稍微急轉以便對正拖車。"

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "當拖車進入停車位時，讓曳引車頭在拖車前面｡ 盡量避免在車位內做過多的調整｡"

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "在路障中間倒車，途中記得檢查後視鏡。"

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "安全停放卡車並關閉引擎｡"

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "記住這些拖著拖車倒車時的要點:<br><br>—拖車轉向曳引車打方向的反方向<br><br>—查看拖車車輪確認其對準的方向<br><br>—查看曳引車後輪以確認推行方向<br><br>—不要將拖車過度轉向<br><br>—拗折拖車總比將其拉直更容易\n<br><br><font face=/font/big_bold.font>準備出發｡</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "向後看，找到你需要去的地方｡ 開始倒車前，請務必檢查周遭環境｡<br><br><font face=/font/big_bold.font>開始向停車位倒車｡</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>開始將拖車轉向停車位並跟隨它倒車進入。</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>在指定區域停下。</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

