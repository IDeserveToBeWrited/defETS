#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "視角控制"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "在這個場景中，我們將了解可供你使用的各類視角以及它們如何協助你操作和操縱卡車｡"

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "座位位置"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "後向視野"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "檢查後視鏡"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "切換至外部鏡頭視角"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "查看卡車周圍"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "在這個場景中，<br>我們將瀏覽可用的幾個鏡頭視角｡"

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "共有 7 個鏡頭視角可供選擇，我們這裡只介紹<br>其中幾個並解釋其預期功能｡"

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "多種鏡頭以及其不同的視角將會在你於狹小空間內操控車輛時提供協助｡"


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "看得見你將要去哪裡是安全且專業的駕駛基礎｡ 如果目前的座位位置不適合你，你可以調整位於 '@@adjust_link_t@@' 的設置(使用暫停選單前往)｡<br><br><font face=/font/big_bold.font>準備完成後使用 @@imv_nrm_activate@@ 進行確認｡ </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "倒車時，後視鏡並不總是能提供清晰的視野｡ 你可能需要探頭出窗外看以獲得更好的視野｡<br><br><font face=/font/big_bold.font>將鏡頭完全轉到司機邊以便觀察拖車的後部｡</font>@@aca_goal_tip@@ 你必須在駕駛室視角｡"

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "使用此鏡頭視角在拖著拖車倒車操作時檢查拖車｡ 從駕駛側(司機邊;之後課程將使用此術語) 倒車總是更好的選擇因為你可以利用這個視角｡ 當你從副駕駛側(助手邊;之後課程將使用此術語) 倒車時，你對後向的視野將極大受限｡<br><br><font face=/font/big_bold.font>看向助手邊｡</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "這就是一般不建議從助手邊倒車的原因；你可以看出你的視野較為受限｡ 萬幸的是，還有七個外部鏡頭可供使用｡<br><br>按鍵 @@imv_nrm_camcycle@@ 可用於切換順序循環至下一個鏡頭｡</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "外部鏡頭提供對卡車周圍事物最佳的視角｡<br><br><font face=/font/big_bold.font>查看卡車周圍｡</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>再次按下 @@imv_nrm_camcycle@@ 即可切換至下一個鏡頭視角｡</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "上方視角提供了卡車周圍全景概覽，極大簡化了停車在狹小空間內和駕駛｡<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_camcycle@@ 切換至下一個鏡頭視角｡</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "車頂視角可讓你在可能少的障礙物下清楚看到卡車前方遠處的路況｡<br><br><font face=/font/big_bold.font>現在按下 @@imv_nrm_camcycle@@ 切換到我們將要查看的最後一個鏡頭視角｡</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "後向視野是你早些時候透過轉動駕駛座視角鏡頭所獲得的視野的捷徑｡ 正如我們所討論的，倒車或停車時很有幫助｡<br><br>遊戲中，我們有更多的鏡頭視角可供你選擇，你可以按下 @@imv_nrm_camcycle@@ 逐一嘗試｡<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_cam1@@ 返回駕駛座視角｡</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "為了獲得真實的\"駕駛學院\"體驗，我們建議你在瀏覽每個場景時盡量使用\"駕駛座視角\"鏡頭｡<br><br><font face=/font/big_bold.font>按 @@imv_nrm_activate@@ 確認並結束場景｡</font>@@aca_goal_tip@@ 你可以使用 @@o_im_cam_zoom@@ 功能可以更好地觀察周圍環境｡ 使用鏡子看時特別有幫助｡ 檢視選項頁面 - '鍵盤 & 按鍵設定' - 檢視 和/或 變更對應的控件｡"

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "首次駕駛"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "在這個場景中，我們將學習如何設置卡車，然後首次駕駛前進｡"

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "打開點火系統"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "啟動引擎"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "檢查車輛周圍"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "踩下煞車踏板"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "排入擋位"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "釋放手煞車"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "向前行駛"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "停車"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "拉起手煞車"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "打回空檔"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "關閉引擎"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "在你最初的幾次駕駛中，我們僅使用曳引車(空車頭)｡<br>卡車在沒有自身載貨車體時被稱為\"曳引車\"，因此需要使用拖車以便運輸貨物和材料｡"

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "曳引車因其廣泛用途而較為常見: 這可以是卸下空拖車然後拖掛起另一輛滿載的拖車而無需等待，亦或變更使用完全不同種類的拖車｡"

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "在第一次駕駛中，你的任務是向前行駛並在虛線後停車｡<br>啟動引擎，遵循指令讓卡車做好行駛準備｡ 準備就緒後，向前直行｡"

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "駛過虛線處、停車、關閉引擎，安全停放卡車｡"

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "在訓練的下一步，你將第一次移動卡車｡<br><br>不過不啟動引擎的話肯定行不通，因此你需要先啟動點火系統｡<br><br><font face=/font/big_bold.font>按下 $input engineelect$ 啟動點火系統｡</font>@@aca_goal_tip@@ 在遊戲中的預設情況下，開啟通電即自動發動引擎｡ 你可以在選項頁面中調整此行為 - '遊戲設定' - @@auto_engine_start@@｡"

	key[]: "aca_msg_book1_1_03_start"
	val[]: "點火系統啟動卡車的電力系統｡你可能已經注意到儀表板上的警示燈閃爍 - 這是正常現象｡ 如果引擎啟動後，這些燈仍亮著，則表示卡車可能存在問題｡ 煞車系統警示燈是例外，當我們鬆開手煞車時，煞車系統警示燈就會熄滅｡<br><br>這輛卡車狀況良好，我們已準備好繼續前進｡<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_engine@@ 起啟動引擎｡</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "既然引擎已經啟動，在開始移動之前檢查周圍是至關重要的｡<br><br><font face=/font/big_bold.font>查看卡車周圍以及兩側的後視鏡，以確認卡車周圍的區域空曠安全無人車｡</font>@@aca_goal_tip@@ 你必須在駕駛室視角｡"

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "這可能顯而易見，但是你應該在開始任何移動之前要知道如何停止｡<br><br><font face=/font/big_bold.font>使用 $input backward$ 踩下煞車｡</font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "接下來，你將學習如何更改行駛方向｡<br><br>採用\"簡單自排\"變速箱，你不需要換檔，一切都會為你自動完成｡<font face=/font/big_bold.font><br><br>使用 $input forward$ 啟動前進檔｡</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "接下來，你將學習如何更改行駛方向｡<br><br>\"真實化自排\"變速箱可讓你就像現實自排變速箱一樣在前進檔、空檔和倒車檔之間變檔｡<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_gearup@@ 換入前進檔｡</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "接下來，你將學習如何更改行駛方向｡<br><br>\"序列式手排\"變速箱可讓你就像現實的序列檔變速箱一樣按順序換檔｡<br><br>正如同你換入前進檔位的方式那樣，但加速時你需要換入更高的檔位｡<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_gearup@@  換入一檔｡</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "接下來，你將學習如何更改行駛方向｡<br><br>排檔桿和離合器，你可以體驗與現實手排變速箱相同的換檔感受｡<br><br>完全踩下離合器和煞車踏板｡<font face=/font/big_bold.font>使用排檔桿換入一檔｡<color value=@@clr_txt@@>保持完全踩下離合器和煞車踏板｡</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "要開始移動，必須先放開手煞車(總煞車)｡<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 來放開手煞車｡</font> @@aca_goal_tip@@ 在遊戲中，手煞車預設將不啟用｡ 你可以在選項頁面中調整此行為 - '遊戲設定' - @@auto_park_brake@@｡"

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "現在卡車準備好前進了｡ 開始移動並越過虛線｡<br><br><font face=/font/big_bold.font>按下油門開始移動: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "現在卡車準備好前進了｡ 開始移動並越過虛線｡<br><br><font face=/font/big_bold.font>按下油門開始移動: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "現在卡車準備好前進了｡ 開始移動並越過虛線｡<br><br><font face=/font/big_bold.font>按下油門開始移動: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "現在卡車準備好前進了｡ 開始移動並越過虛線｡<br><br><font face=/font/big_bold.font>放開煞車踏板，緩慢放開離合器踏板使離合器接合，同時輕踩油門踏板保持轉速，避免引擎熄火｡ 車輛開始移動則完全放開離合器，你就可以根據需要加速和換檔｡</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "使用煞車來停車｡<br><br><font face=/font/big_bold.font>使用 $input backward$ 來停止卡車｡</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "使用煞車來停車｡<br><br><font face=/font/big_bold.font>使用 $input backward$ 來停止卡車｡</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "使用煞車來停車｡<br><br><font face=/font/big_bold.font>使用 $input backward$ 來停止卡車｡</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "需要停車時，完全踩下離合器踏板 <font face=/font/big_bold.font>然後踩下煞車踏板停止卡車｡<color value=@@clr_txt@@> 使用排檔桿退回空檔，然後即可放開離合器踏板｡</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "現在，將卡車安全停放｡ 手煞車可確保卡車在你停好車後不會意外滑動｡<br><br><font face=/font/big_bold.font>使用 @@imv_nrm_parkingbrake@@ 拉起手煞車｡</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "採用\"簡單自排\"變速箱，不需要換檔，一切都會自動為你完成｡<br><br><font face=/font/big_bold.font>按下 @@imv_nrm_activate@@ 以確認｡</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_geardown@@ 退回空檔｡</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>按下 @@imv_nrm_geardown@@ 退回空檔｡</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>將排檔桿退回空檔並放開離合器踏板｡</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "你現在知道如何讓卡車移動以及如何讓卡車安全停止｡<br><br><font face=/font/big_bold.font>按下 $input engineelect$ 關閉引擎｡</font>"
#@}

