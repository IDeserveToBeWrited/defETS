	val[]: "總體增益" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "以高速為中心" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "以低速為中心" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "內部摩擦" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "引擎共振" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "地形表面" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "顛簸" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "碰撞" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "變速箱磨削" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "轉向不足滑移" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "轉向輔助" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "地形表面震動" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "顛簸震動" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "碰撞震動" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

