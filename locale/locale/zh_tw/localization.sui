#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "無法存取網路層。請檢查用戶端配置是否正確。"

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "無法與線上伺服器建立連線。請檢查您的網路連線狀況是否正常。"

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "與線上伺服器通訊時發生錯誤。請稍後再試。"

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "線上伺服器傳回不正確的資料。如有使用 HTTP 代理伺服器，請檢查其設定。如未使用，請稍後再試。"

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "線上伺服器傳回不正確的資料。請稍後再試。"

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "此服務與目前的遊戲版本不相容。請檢查是否有新的遊戲補丁可供下載。"

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "此服務目前無法使用。請稍後再試。"

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "此服務目前因維護或超出負荷而無法使用。請稍後再試。"

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "無效驗證資訊。請嘗試再次登入。"

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "由於登入失敗次數過多，此線上帳戶目前已被鎖定。請在半小時後再試。"

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "由於存在可疑存取行為，此線上帳戶目前已被鎖定。請在 24 小時後再試。"

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "此遊戲並未註冊至此線上帳戶。"

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "此帳戶尚未啟用。請檢查收件匣中的帳戶啟用郵件。"

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "此帳戶已被暫時停權。請聯絡技術支援。"

# The account was banned.
	key[]: "generic_banned"
	val[]: "此帳戶已被停權。請聯絡技術支援。"

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "本遊戲不支援代理驗證。請使用其他代理或直接連線。"

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "必要資源暫時無法使用。請在數分鐘後再試。"

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL 錯誤。無法建立安全連線。"

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "遊戲於線上通訊的過程中暫停。請稍後再試。"

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "內部錯誤。net.log 檔案可能包含更多相關資訊。"

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "《歐洲卡車模擬 2》出現問題，無法在您的電腦上繪製圖形（未找到有效的圖形裝置）。\n建議處理步驟：\n\n1. 確認您的電腦與顯示卡滿足最低硬體要求。\n2. 將 DirectX 更新至最新版本。\n3. 從顯示卡製造商的官方網站下載並安裝最新的驅動程式——您的驅動程式可能太舊。\n4. 嘗試切換渲染模式，從 OpenGL 改為 DirectX、或是從 DirectX 改為 OpenGL。\n5. 刪除「文件」資料夾中、《歐洲卡車模擬 2》目錄內的遊戲配置檔案「config.cfg」。其有可能已經損壞。\n    下次啟動遊戲時系統會以有效的預設值自動重建此檔案。"

	key[]: "sys_no_graphics_simple"
	val[]: "《歐洲卡車模擬 2》出現問題，無法在您的電腦上繪製圖形（未找到有效的圖形裝置）。"
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "輸入嚮導" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "向後"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "完成嚮導"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "跳過嚮導"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "輸入嚮導"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "要取消輸入嚮導嗎？"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "選擇操作方式" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "控制器"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>嚮導將根據已連接的裝置套用推薦的設定。<br><color value=@@clr_sel@@>如果您使用的是與 Steam 相容遊戲手把，建議在<br><color value=@@clr_txt_d@@>「Steam > 設定 > 控制器 > 一般控制器設定」中啟用配置支援。"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "使用鍵盤進行駕駛，使用滑鼠調整視角。雖然是最為簡單，卻也是最不精準的操作方式。"

	key[]: "wiz_control_mouse"
	val[]: "使用滑鼠進行更加靈敏、更為精準的轉向。其他操作仍透過鍵盤執行。需要按住專門的鏡頭控制按鍵/按鈕，才能使用滑鼠調整視角。"

	key[]: "wiz_control_controller"
	val[]: "使用方向盤、遊戲手把或搖桿，能體驗最為擬真的遊戲感受。您仍可透過鍵盤執行各種操作，也能使用滑鼠自由環視（滑鼠視角）。"
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "未偵測到遊戲控制器。需先連接，才能啟用！"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "正在偵測可供使用的控制器……"

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "選擇控制器 API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam 輸入 - 遊戲內對應模式（建議使用）"

	key[]: "api_steam_input_advanced"
	val[]: "Steam 輸入 - Steam 用戶端對應模式"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "傳統控制器"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "@@controller_ps5@@、@@controller_xbox_one@@或@@controller_steam_deck@@等等已經接入 Steam 輸入界面並使用簡易佈局的遊戲手把。<br><br>支援完整的遊戲內按鍵綁定。"

	key[]: "wiz_api_steam_input_advanced"
	val[]: "已經接入 Steam 輸入界面並使用透過 Steam 用戶端配置的獨立佈局的遊戲手把。<br><br>對遊戲內按鈕提示的支援有限，而且無法在遊戲內進行按鈕綁定。"

	key[]: "wiz_api_classical"
	val[]: "採用 DirectInput、XInput 或類似介面的控制器、方向盤或搖桿。"
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "選擇控制器種類"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "方向盤"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "手把或搖桿"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "此控制器為方向盤或類似裝置。此控制器的位置會直接對應遊戲內方向盤的位置。"

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "此控制器為遊戲手把或搖桿。此控制器的位置會決定遊戲內方向盤的轉動速度。"
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "選擇傳動箱種類" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "需先連接方向盤、遊戲手把或搖桿後，才能使用此功能。"

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "未偵測到 H 型排擋桿硬體控制器，此功能有可能會無法使用。"

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "選擇 H 型排檔桿佈局"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "範圍變速箱是最為簡單的選擇。其設有兩組檔位：1-6 檔，以及7-12 檔。只透過一個按鈕，即可在兩者之間進行切換、然後再以排擋桿選擇對應的檔位。"

	key[]: "wiz_hs_splitter"
	val[]: "分離變速箱是簡單的替代選擇。其也設有兩組檔位：奇數檔（1、3、5……）和偶數檔（2、4、6……）。只透過一個按鈕，即可在兩者之間進行切換、然後再以排擋桿選擇對應的檔位。"

	key[]: "wiz_hs_range_splitter"
	val[]: "範圍-分離變速箱基於現實的手動範圍-分離變速箱而設。每個 H 型排擋位置都對應著四個檔位，需透過兩個按鈕進行切換。因此僅建議專業司機使用。"
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "已使用以下預設配置完成設定。您可於進階設定中進行細致調整或是直接進入遊戲。"

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "進階設置"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "The game is now configured and you can continue. You can change the configuration later in Options."

	key[]: "wiz_cfg_steam"
	val[]: "您可使用 Steam 用戶端檢查並配置此控制器的按鈕和軸對應。本遊戲的 Steam 遊戲手把設定可在 Steam > 收藏庫 > Euro Truck Simulator 2 > 控制器配置中找到。"

	key[]: "wiz_cfg_open_overlay"
	val[]: "開啟控制器設定"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>使用 @@imm_wiz_dsteerleft@@ 和 @@imm_wiz_dsteerright@@ 轉向。"

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>只要向左或向右移動滑鼠，方向盤便會向對應方向轉動。"

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>使用 @@ima_wiz_j_steer@@ 轉向。"


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "使用 @@imm_wiz_dforward@@ 前進，使用 @@imm_wiz_dbackward@@ 後退。"

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "向前移動 @@ima_wiz_j_throttle@@ 前進，向後移動 @@ima_wiz_j_throttle@@ 後退。"

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "使用 @@ima_wiz_j_throttle@@ 前進，使用 @@ima_wiz_j_brake@@ 後退。"


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "使用 @@imm_wiz_dforward@@ 加速，使用 @@imm_wiz_dbackward@@ 煞車。"

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "向前移動 @@ima_wiz_j_throttle@@ 加速，向後移動 @@ima_wiz_j_throttle@@ 煞車。"

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "使用 @@ima_wiz_j_throttle@@ 加速，使用 @@ima_wiz_j_throttle@@ 煞車。"


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "使用 @@imv_wiz_gearup@@ 切換為前進檔，使用 @@imv_wiz_geardown@@ 切換為後退檔。"

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "如果您使用的是鍵盤或遊戲手把，使用 @@imv_wiz_gearup@@ 讓檔位變成前進檔，使用 @@imv_wiz_geardown@@ 讓檔位變成後退檔。如果您使用的是 H 型排檔桿，使用 @@imv_wiz_drive@@ 前進、@@imv_wiz_reverse@@ 後退。"

	key[]: "wiz_cfg_gb_manual"
	val[]: "使用 @@imv_wiz_gearup@@ 和 @@imv_wiz_geardown@@ 選擇所需檔位。"

	key[]: "wiz_cfg_gb_direct"
	val[]: "使用 H 型排檔桿和 @@ima_wiz_j_clutch@@ 選擇所需檔位。"
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "配置控制器軸" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "可視化軸"

	key[]: "wiz_setup_axes_desc"
	val[]: "您可直觀地查看、測試全部所選軸的功能。操作控制器，然後觀察正在移動條狀圖示。您可憑此判斷每個軸的定位、限制、中心和其他行為的運作狀態。"

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "軸設置"

	key[]: "wiz_setup_axes_desc2"
	val[]: "點擊軸名稱旁邊的按鈕以選擇軸。此舉將使您切換至輸入模式。然後，使用您的控制器——例如移動搖桿、轉動方向盤或是踩下踏板，來將其綁定至所選軸上。"

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "死區"

	key[]: "wiz_setup_axes_desc3"
	val[]: "死區指輸入行程中不會被系統偵測的軸範圍。如需調整所選軸的死區，只要移動相應的滑塊即可。向右會增大死區。此功能對於老舊控制器而言特別實用——設定較大的死區可改善硬體因磨損而出現的不準確或誤觸發問題。"

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "軸模式"

	key[]: "wiz_setup_axes_desc4"
	val[]: "決定遊戲如何處理軸。反轉軸會翻轉其反饋的方向，例如向左轉會變成向右轉。中心軸的預設位置在範圍中央，例如在搖桿的中間。此模式可用於修正偵測異常的軸。"

	key[]: "normal"
	val[]: "一般" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "反轉" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "中心" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "反轉 + 中心" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "自動傳動箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "使用自動傳動箱時，僅需在前進、空檔和倒車模式之間進行切換。您需透過以下按鍵和控制器按鈕完成操作。如需變更設定，點擊對應按鈕並按下想要用於該操作的按鍵或控制器按鈕即可。"

	key[]: "automatic_gb_setup_desc2"
	val[]: "如果連接了 H 型排檔桿，就能使用這一硬體模擬真實的自動排檔。啟用此選項後，便可為 H 型排檔桿的各個位置分配各個前進與倒車模式。其餘位置皆會視為空檔。此設定專為 H 型排檔桿控制器而設，因此並不適用於一般按鍵或控制器按鈕如需變更分配，點擊某個按鈕、將排擋桿移動至所需位置，然後再移動回空檔即可。"
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "序列傳動箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "序列傳動箱可於所有前進檔、空檔和倒車檔之間切換以下是用於依此順序執行升檔/降檔的按鍵和控制器按鈕。如需變更分配，點擊對應按鈕並按下想要用於該操作的按鍵或控制器按鈕即可。"
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H 型傳動箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "您可在此選擇 H 型排檔桿的主要佈局，並測試其功能。畫面中會顯示排擋桿目前所在的位置和所選檔位。由於傳動箱的檔位要多於設備的檔位，您需使用按鈕在不同的檔組之間進行切換。"

	key[]: "hshifter_gb_setup_desc2"
	val[]: "目前所選檔位和啟用開關也會顯示在下方對應的操作選項旁邊。如需變更已分配的操作選項，點擊對應的按鈕、將排擋桿移動至所需位置，然後再移動回空檔即可。"
#@}

