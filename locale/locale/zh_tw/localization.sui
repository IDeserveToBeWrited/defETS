#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "配置控制器軸" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "可視化軸"

	key[]: "wiz_setup_axes_desc"
	val[]: "你可以觀看到你操作遊戲控制器時所對應的控制軸的效果 ｡ 請操作你遊戲控制器上的控制軸並觀看設置中正在移動的顯示條，它將告訴你該控制軸的定位 ､ 限制 ､ 中心點和其他行為 ｡ "

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "軸線設定"

	key[]: "wiz_setup_axes_desc2"
	val[]: "要選擇一個軸，請點擊軸名旁邊的按鈕 ｡ 這將使您進入輸入模式 ｡ 然後，使用您的控制器綁定到您選擇的軸上，方法是移動搖桿、方向盤或踏板到您選擇的軸 ｡"

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "死區"

	key[]: "wiz_setup_axes_desc3"
	val[]: "死區是指一個故意設計用來不提供輸入的軸區域 ｡ 要調整所選軸的死區，移動相應的滑塊 ｡ 將滑塊向右移動會增大死區 ｡ 此功能對於較舊式的控制器特別有益，因為定義更大的死區可以減少硬體磨損造成的不精確或錯誤輸入等問題 ｡"

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "軸模式"

	key[]: "wiz_setup_axes_desc4"
	val[]: "軸心模式決定了它在遊戲中的處理方式。反轉軸心會翻轉其反饋的方向，例如將方向盤向左轉而不是向右轉。中心軸的預設位置位於其範圍的中間，例如在搖桿中間。此模式可用於更正檢測不正確的軸心 ｡"

	key[]: "normal"
	val[]: "標準" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "反轉" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "中心" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "反轉 + 中心" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "自排變速箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "自動變速箱模式下你只需要打入前進檔 ､ 空檔或者倒擋 ｡ 你可以點擊一個按鈕或按鍵為你所需的功能進行更改 ｡ "

	key[]: "automatic_gb_setup_desc2"
	val[]: "如果你連接了一個 H-shifter 設備，你就可以真實模擬卡車上的檔位 ｡ 啟用此選項，你可以指定 H-shifter 位置到前進或後退模式 ｡ 其他位置將當作空檔 (N) ｡ 這設定只針對 H-shifter ，所以不會對其他按鍵或控制器產生作用 ｡ 請對該設備的各種按鈕或按鍵進行設定 ｡ 想要自定義按鍵，請點擊一個按鈕，然後移到排檔所需位置，最後回到空檔 (N) ｡ "
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "序列式變速箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "手動變速箱包含前進檔 ､ 空檔和倒車檔 ｡ 這是進檔和降檔的控制鍵或者按鈕 ｡ 如要進行改變，請按下一個按鍵或按鈕 ｡ "
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H型變速箱配置" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "你可以選擇 H-shifter 的佈局並進行各種功能的測試 ｡ 目前畫面中檔位就是變速箱的檔位 ｡ 遊戲中變速箱的檔位要比 H-shifter 設備的檔位多，你需要使用按鈕在2套或以上檔位中進行切換 ｡ "

	key[]: "hshifter_gb_setup_desc2"
	val[]: "目前所選的檔位和觸發顯示在下面 ｡ 如要改變控制，按下適合的按鈕，將檔位切換到目標位置，再返回空檔 (N) ｡ "
#@}

