	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "你需要先購買一輛拖車並將角色檔案連接至 World of Trucks 才能進入外部市場頁面 ｡"

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "查看世界地圖、已探索的區域以及當前的導航標記或設定新的標記 ｡"

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
