#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "截圖的檔案太大了 ｡ 請嘗試降低圖片的解析度 ｡ " #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "截圖檔案已損壞或不支援 ｡ " #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "截圖的解析度太大了 ｡ 請嘗試降低圖片的解析度 ｡ " #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "線上服務拒絕你的截圖 ｡ " #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "你的帳戶不允許上傳截圖 ｡ " #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
