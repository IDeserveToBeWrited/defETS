	val[]: "移動 @@ima_wiz_j_throttle@@ 前進或倒退 ｡ "

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "使用 @@ima_wiz_j_throttle@@ 前進，使用 @@ima_wiz_j_brake@@ 後退 ｡ "


	key[]: "wiz_cfg_pedals_button_complex"
