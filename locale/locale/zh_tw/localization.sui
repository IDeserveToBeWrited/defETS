#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "圖形" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "圖形" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "透過精調預設組合來根據自己的喜好調整遊戲的視覺效能。"

	key[]: "apply"
	val[]: "套用" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "桌面主題" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "顯示" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "影像品質" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "紋理" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "反射" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "陰影" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "光照" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "後期處理" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "環境" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "全螢幕模式" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "亮度 / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "設置" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "解析度" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "更新率" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "幀率限制" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "背景幀率限制" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "預設更新率" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "赫茲" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "垂直同步" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "節能（為筆記型電腦降低能耗）" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "簡易圖形設定" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "已套用自訂設定" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "進階圖形設定" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "簡易/進階圖形設定" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "隱藏進階設定" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "顯示進階設定" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "縮放" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "反鋸齒" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA 亮度銳化" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA 微調" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "自適應清晰度" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "始終柔和" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "始終銳利" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "螢幕空間環境光遮蔽（SSAO）" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "高動態範圍（HDR）" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "景深（DOF）" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "光束" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "色彩校正" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "反射比例" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "反射細節" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "植被細節" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "草叢密度" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "陰影品質"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "陰影材質尺寸" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "遠處陰影" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "車內陰影" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "天氣品質"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "後視鏡品質" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "後視鏡解析度" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "後視鏡距離" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "材質品質" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "各向異性過濾" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "法線貼圖" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "AI 車輛頭燈" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "次要車輛輔助照明" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "照明能見度範圍" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "行人" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "顯示設定已被變更。<br>要保留目前設定嗎？"

	key[]: "reverting_in"
	val[]: "距離恢復先前的設定，還剩" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "秒" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "啟用後，遊戲將以全螢幕顯示。"

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "調整遊戲整體亮度，以配合顯示器。在支援 HDR 的顯示器上，此設定中也會提供 HDR 校準選項。"

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "變更遊戲的解析度。"

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "變更遊戲的目標更新率。"

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "使幀率與顯示器的更新率同步，以防止畫面產生撕裂。節能設定會將幀率減半，從而降低功耗。"

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "設定遊戲允許的最高幀率。<br><br>將數值設為 0 將會停用此功能。"

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "設定遊戲最小化至背景時允許的最高幀率。<br><br>將數值設為 0 將會停用此功能。"

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "變更簡易圖形設定（預設）或進階圖形設定（能個別調整參數）。"

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "透過在內部以更高的解析度渲染遊戲來提高圖形保真度，從而減少鋸齒邊緣並增強細節。<br>例如選擇較高的縮放選項會產生清晰度更高、模糊度更低的圖片，從而使遊戲的整體視覺效果更佳，但會犧牲效能。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生很大影響。"

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "選擇高速反鋸齒方法，使遊戲中出現的鋸齒邊緣變得平滑：<br>- SMAA 會在畫面的不同位置對每個像素取樣多次（取決於選擇的品質），然後將取樣結果平均以生成最終畫面。<br>- TAA 每幀只對每個像素取樣一次，但會在不同的位置和不同的幀上取樣。<br>- 為了獲得最佳效果，您也可以同時選擇兩種方式、進行組合，但會犧牲效能。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "為縫隙和彼此靠近的物件添加柔化陰影，提高整個遊戲世界的感知圖形保真度。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "選擇 TAA 預設：<br>-「始終柔和」會減少閃爍、增加模糊 - 既適用於開啟超取樣或擁有高 DPI 顯示器的 PC 使用者，也適用於距離螢幕較遠的 1080p 電視使用者。<br>-「始終銳利」會增加閃爍、減少模糊 - 較適合低於 1080p 的使用環境，例如筆記型電腦或 Steam Deck。<br>-「自適應清晰度」會在鏡頭靜止時動態禁用 TAA 抖動。<br><br><color value=@@clr_txt_d@@>此設定僅會在選擇 TAA 作為反鋸齒解決方案時才會生效。"

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "調整 TAA 亮度銳化的強度。<br><br><color value=@@clr_txt_d@@>此設定僅在選擇 TAA 作為反鋸齒解決方案時才能使用。"

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "啟用後，地圖中的遠處區域將被人為模糊處理，以在背景中呈現真實的焦點衰減效果。"

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "啟用後，直接觀看太陽或透過樹木、建築或車輛等物件觀看太陽時，將能看到光線效果。"

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "啟用後，遊戲色彩會因美觀效果而進行動態調整。場景將更符合時間和天氣狀況，車輛和其他物件的色彩也會更加鮮豔。"

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "透過在內部以更高的解析度渲染遊戲與使用更佳的反鋸齒處理來增強反射效果。<br><br><color value=@@clr_txt_d@@>變更此設定後，須手動重啟遊戲才會生效。"

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "調整車輛表面、車窗和其他反射表面（如水坑、濕路和開闊水域）的反射細節。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。<br><br>變更此設定後，須手動重啟遊戲才會生效。"

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "調整植物和樹木的細節和複雜度。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "調整道路兩側草叢的密度。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "調整因太陽或月亮所產生陰影的品質。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "啟用後，即使距離很遠的物件也會渲染陰影。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "調整天氣效果的品質，例如反射。"

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "調整車輛鏡面的反射品質（與反射設定無關）。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "調整車輛鏡面中圖像渲染的解析度。"

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "調整鏡面中的物件開始渲染的距離。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生很大影響。"

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "調整遊戲中物件和表面所套用的的部分材質品質。"

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "提高材質的銳利度，特別是在遠距離或以斜角觀看時。<br><br><color value=@@clr_txt_d@@>變更此設定後，須手動重啟遊戲才會生效。"

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "為人行道、道路和其他物件添加幾何細節來改善外觀。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。<br><br>變更此設定後，須手動重啟遊戲才會生效。"

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "啟用來自 AI 車輛的頭燈照明。"

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "啟用來自 AI 車輛的輔助照明，例如方向燈、停車燈等等。"

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "調整人工光源的可見距離。<br><br><color value=@@clr_txt_d@@>此設定通常會對效能產生中等影響。"

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "啟用遊戲世界中的行人。"
