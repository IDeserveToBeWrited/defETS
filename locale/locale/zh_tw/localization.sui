#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "載入遊戲"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "載入遊戲" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.
	
	key[]: "load_game_failed"
	val[]: "無法載入存檔。"

	key[]: "load_game_desc"
	val[]: "載入先前儲存的遊戲。目前的進度將會遺失！" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "確定要載入其他遊戲嗎？<br><br>如果先前並未儲存，目前的進度將會遺失。"

	key[]: "load_progress_lost_mp"
	val[]: "確定要載入其他遊戲嗎？<br>如果在多人遊戲中執行此操作，有可能會導致工作取消或暫停、傳送到最近的維修中心，或是選取的工作無法使用。<br><br>如果先前並未儲存，目前的進度將會遺失。"

	key[]: "load_game_mp_suspended_job"
	val[]: "已成功載入存檔，但您正在進行的 World of Trucks 工作已暫停、並無法在本次會話中使用。"

	key[]: "autosave"
	val[]: "- 自動存檔 -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- 快速存檔 -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "顯示自動存檔" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "無法找到手動存檔。" #+ Shown when no saves are found.

	key[]: "load"
	val[]: "載入" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>存檔不相容！<br><color value=@@clr_txt@@>請嘗試將遊戲更新至最新版本。" #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "無法載入並顯示此個人檔案的所有存檔。" #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "注意" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>載入存檔時出現問題。<color value=@@clr_txt@@><br><br>載入存檔失敗。您可以嘗試參考以下資訊排查並修復問題。也可以嘗試載入其他存檔。<br><br>以下為導致此問題出現的常見原因：<br><br>1. 存檔與目前安裝的部分 MOD 不相容。<br><br>2. 存檔包含遺失或停用的 MOD 資訊。<br><br>3. 存檔因品質不佳的 MOD 損毀。<br><br>4. 電腦在存檔過程中或存檔不久後當機，將有可能會損毀存檔。"

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>偵測到遺失的 MOD。<color value=@@clr_txt@@><br><br>最新的存檔依賴遺失或停用的 MOD。<br><br>如果這超出了您的預期，請檢查各個 MOD 的狀態。<br><br>您也可以嘗試繼續載入存檔。但依照 MOD 的功能，仍有可能會載入失敗或導致其他問題。<br><br>此外，您也可以嘗試載入其他並未依賴遺失 MOD 的存檔。"

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>偵測到遺失的可選 DLC。<color value=@@clr_txt@@><br><br>最新的存檔依賴遺失的 DLC（官方遊戲擴充內容）。<br><br>如果這超出了您的預期，請檢查各個 DLC 的狀態。<br><br>您也可以嘗試繼續載入存檔，但 DLC 提供的功能有可能會遺失。<br><br>此外，您也可以嘗試載入其他並未依賴遺失 DLC 的存檔。"

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>偵測到遺失的 DLC。<color value=@@clr_txt@@><br><br>最新的存檔依賴遺失的 DLC（官方遊戲擴充內容）。<br><br>為了能讓存檔正確執行，必須在此電腦上啟用該 DLC。<br><br>此外，您也可以嘗試載入其他並未依賴遺失 DLC 的存檔。"

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MOD 依賴 DLC 的內容。<color value=@@clr_txt@@><br><br>至少一個 MOD 依賴目前尚未安裝的 DLC（官方遊戲擴充內容）。<br><br>必須停用相關的 MOD 或安裝其依賴的 DLC。"

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>偵測到當機。<color value=@@clr_txt@@><br><br>上次載入存檔時遊戲似乎發生當機。<br><br>您可以嘗試參考以下資訊排查並修復問題。也可以嘗試載入其他存檔。<br><br>以下為導致此問題出現的常見原因：<br><br>1. 一個或多個已安裝的 MOD 損毀，或與目前遊戲版本不相容。<br><br>2. 存檔包含遺失或停用的 MOD 資訊。<br><br>3. 存檔因品質不佳的 MOD 損毀。<br><br>4. 在某些情況下，硬體或驅動程式故障也有可能會導致遊戲當機。"

	key[]: "mods_detected_warning"
	val[]: "偵測到 MOD。請注意——已損壞、已過時或不相容 MOD 有可能會導致遊戲不穩定。請在 MOD 管理檢查目前啟用的 MOD。" #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

