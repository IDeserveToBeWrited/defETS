#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "銀行" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "銀行" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "如果你需要一些資金，你可以向銀行貸款 ｡ " #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "貸款方案" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "每天需償還的金額: $MONEY$" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "目前貸款項目: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "尚餘貸款金額: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "目前貸款總覽"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "貸款" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "剩餘還款額" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "為期 (天)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "利率 (p.a.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "每日還款額" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "償還" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "總計:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "帳戶餘額：$MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "進行貸款" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "你所申請的貸款金額為 $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "償還期限:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "利率 (p.a.):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "每日還款額:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "是否確認申請貸款？"
#@}

