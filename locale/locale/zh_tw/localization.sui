	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "移動@@ima_wiz_j_throttle@@控制卡車加速或剎車 ｡"

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "使用 @@ima_wiz_j_throttle@@ 加速，使用 @@ima_wiz_j_brake@@ 煞車 ｡ "


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "使用 @@imv_wiz_gearup@@ 切換為前進檔，使用 @@imv_wiz_geardown@@ 切換為倒退檔 ｡ "

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "如果你是使用鍵盤或是手把時，使用 @@imv_wiz_gearup@@ 讓檔位變成前進檔，使用 @@imv_wiz_geardown@@ 讓檔位變成倒退檔 ｡ 如果你使用的是H-shifter的話，使用 @@imv_wiz_drive@@ 前進或 @@imv_wiz_reverse@@ 後退 ｡ "

	key[]: "wiz_cfg_gb_manual"
	val[]: "使用 @@imv_wiz_gearup@@ 和 @@imv_wiz_geardown@@ 選擇想要的排檔 ｡ "

	key[]: "wiz_cfg_gb_direct"
	val[]: "配合 H-shifter 排檔裝置和 @@ima_wiz_j_clutch@@ 一起使用完成換檔 ｡ "
