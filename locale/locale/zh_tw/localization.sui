	key[]: "eye_head_roll"
	val[]: "啟用滾動" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "啟用位置" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "偏航係數 (在駕駛艙中)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "俯仰係數 (在駕駛艙中)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "偏航係數 (在行走模式中)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "俯仰係數 (在行走模式中)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "最大凝視角度" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "凝視追蹤速度"

