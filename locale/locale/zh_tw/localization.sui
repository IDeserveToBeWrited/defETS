#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>該嚮導將根據連接的設備應用推薦的設置 ｡ <br><color value=@@clr_sel@@>如果您使用的是Steam相容遊戲搖桿，請考慮在<br><color value=@@clr_txt_d@@>\"Steam > 設定 > 控制器 > 一般控制器設定\"中啟用配置支援 ｡ "

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "此模式使用鍵盤進行駕駛，使用滑鼠調整遊戲視角 ｡ 這是最不精準的控制模式，但卻是適合所有玩家進行遊戲的最簡單的模式 ｡ "

	key[]: "wiz_control_mouse"
	val[]: "此模式下使用滑鼠進行轉向操作以實現更靈敏和更精準的操控，其他控制仍使用鍵盤 ｡ 當您按下並保持視角切換鍵時，您仍然可以使用滑鼠進行視角控制 ｡ "

	key[]: "wiz_control_controller"
	val[]: "此模式是為方向盤 ､ 遊戲手把 ､ 搖桿和其他遊戲控制器設計的模式，您可以從此模式中得到最真實的遊戲體驗 ｡ 此模式中仍然保留鍵盤從而實現特定的遊戲功能，同時仍然保留了滑鼠操控視角的方式 ｡ "
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "未偵測到控制器 ｡ 請連接遊戲控制器！"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "檢查可使用的控制器..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "選擇控制器 API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam 輸入 - 遊戲內對應模式 (建議使用)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam 輸入 - Steam 用戶端對應模式"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "傳統控制器"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "像 @@controller_ps5@@， @@controller_xbox_one@@ 或 @@controller_steam_deck@@ 這樣的遊戲手把，可選擇進入 Steam 輸入介面並使用簡單的佈局｡<br><br>支援完整的遊戲內按鍵綁定設定｡"

	key[]: "wiz_api_steam_input_advanced"
	val[]: "遊戲把選用 Steam 輸入介面，並使用透過 Steam 用戶端設定的獨立佈局｡<br><br>對遊戲內按鈕提示的支援有限，而且沒有遊戲內的綁定設定｡"

	key[]: "wiz_api_classical"
	val[]: "使用 DirectInput、XInput 或類似介面的控制器、方向盤或搖桿｡"
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "選擇控制器類型"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "方向盤"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "手把或搖桿"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "控制器是一個方向盤或者類似的設備 ｡ 該控制器的位置和遊戲中的方向盤位置相對應 ｡"

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "控制器是手把或搖桿 ｡ 控制器的位置決定遊戲中方向盤的轉向速度 ｡ "
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "選擇變速箱類型" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "這是為鍵盤設計的（但不局限於鍵盤）最簡單的控制方式，按上箭頭前進，按下箭頭制動和倒車 ｡ 此模式中的自動變速箱將為你打理一切——全自動的檔位控制將不需要煩惱打檔的問題 ｡ "

	key[]: "wiz_gb_automatic"
	val[]: "此模式是現實中卡車的自動換擋電子變速箱，你將手動在前進檔 ､ 空檔和倒擋之間進行切換 ｡ 當你打進檔位之後請按照自動檔的方式駕駛，車輛將根據路況自動選擇合適的檔位 ｡ "

	key[]: "wiz_gb_sequential"
	val[]: "手排就是最常見的手動變速箱，你將在每一個檔位之間手動切換 ｡ 此模式難度稍為困難，但你將可以完全控制你的卡車來實現最佳的駕駛性能，同時可以更充分的面對突發狀況 ｡ "

	key[]: "wiz_gb_hshifter"
	val[]: "H-shifter 專門為羅技G25 ､ 羅技G27 ､ Thrusmaster TH8RS遊戲控制器設計的操作模式，讓玩家進行完全擬真的變速箱操作 ｡ 此模式將比手排更加有挑戰性，但體驗更真實 ｡ 此模式同時要求配有離合器 ｡ "
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "此功能在連接方向盤 ､ 遊戲手把或者搖桿後才可以使用 ｡ "

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "未偵測到 H-shifter 設備，此功能可能無法使用 ｡ "

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "選擇H型變速箱佈局"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "範圍檔是簡單的選擇 ｡ 它有2套齒輪，第一組包含1到6檔，第二組包含7至12檔 ｡ 2組檔位之間用按鈕進行切換 ｡ "

	key[]: "wiz_hs_splitter"
	val[]: "分離檔是另一個簡單的替代佈局 ｡ 它也有2套檔位 ｡ 第一組包含奇數檔位 (1，3，5...)第二組包含偶數檔位 (2，4，6...) ｡ 2組檔位之間用按鈕進行切換 ｡ "

	key[]: "wiz_hs_range_splitter"
	val[]: "範圍-分離檔基於真實佈局 ｡ 每個位置分別代表4個檔位，由兩個按鈕進行切換 ｡ 所以，只推薦專業司機使用 ｡ "
#@}

#@}

