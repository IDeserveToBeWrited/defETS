#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "截圖檔案過大。請嘗試降低解析度。" #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "截圖檔案已損壞或不支援。" #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "截圖的解析度過高。請嘗試降低解析度。" #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "服務端拒絕接收該截圖。" #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "此帳戶無權上傳截圖。" #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "無法上傳至同一展位。" #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "上傳功能目前已停用。請稍後再試。" #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "上傳過程中遇到未知錯誤。請稍後再試。" #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
