#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "繼續（$KEY$）" #+ Message box button.


	key[]: "intro_1"
	val[]: "歡迎來到《歐洲卡車模擬 2》！"

	key[]: "intro_2"
	val[]: "終於，您得到了夢寐以求的工作——駕駛卡車！"

	key[]: "intro_3"
	val[]: "您所經營的運輸公司正式開業了，但……遺憾的是，您並沒有足夠的資金來購買卡車。因此，您目前只能受僱於其他公司、作為司機工作。"

	key[]: "intro_4"
	val[]: "您的工作是將一批$JOB_CARGO$安全運輸到位於$JOB_TARGET_CITY$的$JOB_TARGET_COMPANY$碼頭。雇主為您提供了車輛並且承擔了所有必要的費用。務必準時到達，別讓大家失望。"


	key[]: "intro_garage_1"
	val[]: "這是您的總部。"

	key[]: "intro_garage_2"
	val[]: "雖然只是一間非常簡易的車庫，但也是踏出了第一步。"

	key[]: "intro_garage_3"
	val[]: "然而，遺憾的是——您還沒有擁有能停放在這裡的卡車，所以還空無一物。"

	key[]: "intro_garage_4"
	val[]: "等您賺到足夠的資金、購買一輛卡車後，就能在世界裡自由地行駛、並於此開創自己的事業。"

	key[]: "intro_garage_5"
	val[]: "祝您好運！"


	key[]: "desktop_tut_t"
	val[]: "已解鎖新功能"

	key[]: "desktop_tut_job"
	val[]: "挑選下個工作"

	key[]: "desktop_tut_cargo_market"
	val[]: "使用全新的拖車前往貨物市場，將各式各樣的貨物送往目的地。" #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "您可以在這裡檢視進度。"

	key[]: "desktop_tut_company"
	val[]: "在這裡管理您的車庫、僱用新的司機，並管理公司的各項事務。"

	key[]: "desktop_tut_trailers"
	val[]: "從現在起，您可以購買屬於自己的拖車，並對其進行改裝或塗裝、以搭配您的卡車。<br><br>您可將拖車停放在所選車庫——您的司機會使用它們來完成工作、提升收益。您可透過「拖車管理」介面來管理自己的拖車。"

	key[]: "desktop_tut_visit_directive"
	val[]: "前往 $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "使用「模式」按鈕即可切換不同的桌面模式與車輛類型。"

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "歡迎"

	key[]: "desktop_tut_tour_welcome"
	val[]: "歡迎來到新的主介面<br>在這裡你可以和遊戲中的所有功能進行互動｡"

	key[]: "desktop_tut_tour_main_menu"
	val[]: "您可在下方的主選單直接存取各項早已十分熟悉的遊戲核心功能。"

	key[]: "desktop_tut_tour_top_bar"
	val[]: "頂部的全新狀態欄將持續顯示對玩家十分有用的個人檔案統計資料和當地法規。"

	key[]: "desktop_tut_tour_home"
	val[]: "您隨時都可以使用「桌面」按鈕直接返回桌面。"

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "永久常駐的快速選單可讓您從任何介面透過捷徑存取遊戲中的所有功能。"

	key[]: "desktop_tut_tour_drive"
	val[]: "更新後的「駕駛」按鈕可讓您與遊戲世界保持聯繫，隨時都可重新上路。"

	key[]: "desktop_tut_tour_finish_t"
	val[]: "已完成教學"

	key[]: "desktop_tut_tour_finish"
	val[]: "感謝你查看我們更新的主畫面｡"


	key[]: "desktop_vehicle_mode_reenable_hints_t"
