#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "選擇控制器子種類，以便遊戲正確處理輸入範圍。"

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "選擇變速箱種類：<br>-「簡易自動」：僅需使用加速踏板和煞車，即可前進和倒車。<br>-「真實自動」：需要切換前進檔和倒車檔。<br>-「序列式」：需使用升檔/降檔按鈕手動切換各個檔位。<br>-「H 型」：需使用具備排檔桿、排擋槽的控制器手動切換各個檔位。"

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "變更自動變速箱的排擋邏輯：<br>-「節能」模式偏向維持較低轉速，優先輸出峰值扭力。<br>-「高功率」模式偏向輸出峰值馬力，以油耗為代價換取在重載或山區地形下的更高技能。"

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "調整裝置旋轉角度與車輛實際轉向角度的比例。"

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "調整輸入和車輛轉向之間的線性度。<br><br>將數值調高代表方向盤置中時轉向反應將較為遲鈍，並隨著方向盤轉至最大鎖定位置的過程中逐漸提高。這樣有助於在直行時平滑轉向輸入。"

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "啟用力回饋（如果控制器支援力回饋）。"

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "調整 0N 到 10N 之間所有力回饋設定的整體增益。<br><br><color value=@@clr_txt_d@@>注意——在使用高功率方向盤底座的情況下，將其調高有可能會導致手指或手部受傷。"

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "調整高速行駛時方向盤的回正力道，其將於速度在 90 公里/小時（56 英里/小時）或 以上時達到峰值。<br><br>設定為最小值則無回正效果。"

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "調整低速行駛時方向盤的回正力道。<br><br>設定為最小值則無回正效果。"

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
