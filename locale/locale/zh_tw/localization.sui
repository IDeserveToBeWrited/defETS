	key[]: "eye_t"
	val[]: "眼球追蹤" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "擴展視角" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "預設擴展視角" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
