	key[]: "controller_feedback_settings_t"
	val[]: "控制器回饋" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "控制器軸" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
