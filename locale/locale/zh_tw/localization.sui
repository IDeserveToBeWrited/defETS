	key[]: "eye_head_mode_direct"
	val[]: "直接" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "動態" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "視線視角靈敏度" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
