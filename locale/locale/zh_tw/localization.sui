	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "選擇排檔種類:<br>-\"簡單自排\"允許只使用油門和煞車來控制前進和倒車｡<br>-\"真實化自排\"需要切換前進檔或倒車檔｡<br>-\"序列式手排\"需要手動升/降每一個檔位｡<br>-\"H型排檔\"需要用排檔控制器來手動換檔｡"

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "更改自動變速器的換檔邏輯:<br>-“節能”模式偏向於較低的轉速峰值扭矩。<br>-而“高耗能”模式則偏向於輸出峰值馬力，以便在重載或山區地形下獲得更好的駕駛性能，但會犧牲燃油經濟性｡<br><br>你可以在\"鍵盤 & 按鍵設定->變速箱->切換 自適應自動變速箱模式\"設置一個按鍵，方便在駕駛中直接切換此功能｡"

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "調整裝置旋轉度與車輛實際轉向旋轉度的比值"

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "調整輸入和車輛轉向之間的線性度｡<br><br>將此值調整得較高代表當方向盤位於中心時轉向的靈敏度會降低，而當方向盤轉到最大鎖定位置時，轉向的靈敏度最大｡ 這有助於在直線行駛時平滑轉向輸入｡"

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "啟用力回饋在支援力回饋的控制器中"

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "調整 0N 到 10N 之間所有力回饋設定的總體增益｡<br><br><color value=@@clr_txt_d@@>請注意，在強大的扭矩下將其調整到更高的設置可能會對手指或手造成傷害｡"

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "調整高速行駛時的回中力，最高速度為 90 km/h(56 mph) 以上｡<br><br>設定最小將導致方向盤沒有回中力｡"

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "調整低速行駛時的回中力｡<br><br>設定最小將導致方向盤沒有回中力｡"

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "調整人為所造成的機械轉向部件內摩擦力的強度｡"

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "調整透過轉向柱產生的人為引擎共振強度｡<br><br><color value=@@clr_txt_d@@>請注意，將此值設定超過15%以上可能會導致某些方向盤過度晃動和震動｡"

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "調整透過轉向柱產生的路面效果的強度｡<br><br><color value=@@clr_txt_d@@>請注意，將此值設定超過20%以上，在不平坦的地形上高速行駛時，可能會導致某些方向盤過度晃動和震動｡"

