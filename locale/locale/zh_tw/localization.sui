	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "你將會運送特殊運輸貨物！ 兩輛護送車輛會帶領你行駛。  請務必小心，並遵循它們的引導與提示通知。 特殊運輸無須停等紅燈，並且在大部份情況下擁有道路優先權。 在運送途中，快速存檔將會更加頻繁。"

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "請特別留意以下事項："

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "請勿碰撞護送車輛，並將貨物保持在它們之間。"

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "請勿駛離規劃路線，也不要前往諸如加油站、休息站等地點。"

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "請遵守限速規定，前方的護送車輛會確保嚴格執行。"

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "請小心道路上的超車車輛和其他司機。"

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "變換車道："

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "如果無法遵守這些規定，特殊運輸工作可能會失敗！"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "此操作會由<color value=@@clr_sel@@>後方<color value=@@clr_txt@@>的護送車輛透過變更並封鎖指定車道來啟動。"

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>前方<color value=@@clr_txt@@>的護送車輛會等待指定車道淨空，然後隨之變換車道。"

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "然後，<color value=@@clr_sel@@>玩家<color value=@@clr_txt@@>——也就是您，即可安全地駛至指定車道。"

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "卡車油箱已經注滿，駕駛時數已經恢復。"

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "您無法在特殊運輸工作中呼叫救援。"

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "您無法在特殊運輸工作中使用渡輪。"

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "您正在休息……<br>卡車正在補充燃油……"

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "即將強制停車。<br>請跟隨護送車隊前往停車處休息！"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "強制停車"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "按下此按鍵休息並補充燃油："
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "載入 Steam 物品庫項目時發生錯誤。<br><br>$ERROR$<br><br>選擇「繼續」來保持啟用狀態，遊戲會定時嘗試搜尋。<br><br>您可以暫時停用相關內容來防止此類錯誤訊息反復出現。下次啟動遊戲時，系統會自動重新啟用相關內容。" #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "無法下載 Steam 物品庫中的項目。" #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "Steam 物品庫" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "正在載入 Steam 物品庫中的項目……" #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "新的物品庫項目" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "偵測到新的 Steam 物品庫項目。" #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "車輛配件" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "駕駛室配件" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "桌面背景" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "塗裝" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "停用物品庫" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "請稍後再試" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "Steam 物品庫" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "部份項目已從您的 Steam 物品庫中移除。您將無法再在改裝商店中購買這些項目。<br><br>已經安裝的項目並不會受到影響。" #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


