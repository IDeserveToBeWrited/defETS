#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "繼續 ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "歡迎來到 Euro Truck Simulator 2！"

	key[]: "intro_2"
	val[]: "現在，你將會有機會實現你的夢想 - 駕駛一輛卡車！"

	key[]: "intro_3"
	val[]: "屬於你自己的運輸公司現在開張了！但是很遺憾的是，你現在缺少資金來購買你的卡車，所以現在你只能作為一位普通的卡車司機為其他的公司打工 ｡ "

	key[]: "intro_4"
	val[]: "你的工作是安全地將 $JOB_CARGO$ 運送到位於 $JOB_TARGET_CITY$ 的  $JOB_TARGET_COMPANY$ 的集貨場 ｡ 雇主提供了一輛臨時的卡車並且承擔了所有必要的費用 ｡ 請準時到達，別讓任何人為你感到失望 ｡ "


	key[]: "intro_garage_1"
	val[]: "這是你的總部 ｡ "

	key[]: "intro_garage_2"
	val[]: "這是你的第一個車庫 ｡ 雖然不怎麼樣，但算是個不錯的開始 ｡ "

	key[]: "intro_garage_3"
	val[]: "非常抱歉，你還沒有擁有卡車能夠停放，所以你看不到任何卡車 ｡"

	key[]: "intro_garage_4"
	val[]: "當你賺到足夠的錢並且買了一輛卡車，你將可以世界中自由地穿梭並且開創你自己的事業 ｡ "

	key[]: "intro_garage_5"
	val[]: "祝你好運！"


	key[]: "desktop_tut_t"
	val[]: "功能已解鎖"

	key[]: "desktop_tut_job"
	val[]: "挑選你的下一個工作"

	key[]: "desktop_tut_cargo_market"
	val[]: "使用全新的拖車前往貨物市場，即可將各種各樣的貨物運送到目的地 ｡" #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "這裡可以看到你的進度 ｡"

	key[]: "desktop_tut_company"
	val[]: "從這裡管理你的車庫，僱用新的司機和管理你的公司 ｡ "

	key[]: "desktop_tut_trailers"
	val[]: "從現在開始，你可以購買屬於自己的拖車，以及升級或塗裝它們以配合你的卡車 ｡ <br><br>你可以把拖車存放在你所選的車庫；你的司機可以使用它們來賺錢 ｡ 使用拖車管理來管理你的拖車 ｡"

	key[]: "desktop_tut_visit_directive"
	val[]: "訪問 $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "歡迎"

	key[]: "desktop_tut_tour_welcome"
	val[]: "歡迎來到新的主介面<br>在這裡你可以和遊戲中的所有功能進行互動｡"

	key[]: "desktop_tut_tour_main_menu"
	val[]: "下面的主選單可以直接操作你熟悉的所有核心遊戲功能｡"

	key[]: "desktop_tut_tour_top_bar"
	val[]: "頂部是新的狀態欄，提供了持續可見對玩家有幫助的個人資料統計和當地的法規｡"

	key[]: "desktop_tut_tour_home"
	val[]: "\"主頁\"按鈕始終可以讓你直接回到主畫面"

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "永久的快捷選單是一個方便的快捷方式，可從任何介面快速使用遊戲的功能｡"

	key[]: "desktop_tut_tour_drive"
	val[]: "更新後的\"駕駛\"按鈕可讓你與遊戲世界保持聯繫，準備好即可重新上路｡"

	key[]: "desktop_tut_tour_finish_t"
	val[]: "教學已結束"

	key[]: "desktop_tut_tour_finish"
	val[]: "感謝你查看我們更新的主畫面｡"
