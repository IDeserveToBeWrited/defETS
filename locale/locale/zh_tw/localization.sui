	val[]: "連接 $CONTENT_NAME$ 失敗 ｡ " #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "你用來註冊DLC的Steam帳戶與用來連接 World of Trucks 的不符合。請切換你的Steam帳戶再重試。" #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

