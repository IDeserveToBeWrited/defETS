	val[]: "發現新的MOD" #+ Label indicating that the game has detected new mods.

	key[]: "name"
	val[]: "名稱" #+ Label of field used to show the name of the mod and also a entry of sorting dropdown indicating sorting according to the name.

	key[]: "author"
	val[]: "作者" #+ Label of field used to show the author of the mod and also a entry of sorting dropdown indicating sorting according to the author.

	key[]: "install_time"
	val[]: "安裝時間" #+ Entry in sorting drop down in mod manager allowing sorting accoding to the installation time of the mod.

	key[]: "package_name"
	val[]: "檔案名稱" #+ Label of field used to show the name of the mod package (i.e. the name of the zip file of folder containing the mod)

	key[]: "view_workshop_page"
	val[]: "在 Steam Workshop 查看 MOD" #+ Button that allows user to open webbrowser with Steam workshop items page.

	key[]: "no_mods_found"
	val[]: "找不到任何MOD ｡ " #+ Shown in the UI if there are no mods matching the current filters.

	key[]: "installed"
	val[]: "已安裝" #+ Status value indicating that the mod is present but it is not used.

	key[]: "incompatible"
	val[]: "不相容" #+ State value indicating that the mod is not compatible with the current version of the game.

	key[]: "mod_multi_move_left_confirm"
	val[]: "你確定要停用所有MOD嗎？" #+ Confirmation message shown when user selects button to deactivate all mods.

	key[]: "mod_multi_move_right_confirm"
	val[]: "你確定要啟用所有MOD嗎？<br><br>所有未啟用的MOD將會加入到已啟用的MOD的最上方 ｡ <br><br><br>(不相容的MOD不會被啟用)" #+ Confirmation message shown when user selects button to activate all mods.

	key[]: "no_mods_active"
