	key[]: "screenshot_resized_file_size"
	val[]: "截圖檔案超出最大允許大小 $LIMIT$KB，已自動調整尺寸。" # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

