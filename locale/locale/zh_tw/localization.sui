	key[]: "eye_preset_delete_confirmation"
	val[]: "你確定要刪除所選的預設嗎？" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "已有相同名稱的預設將被覆蓋。您要繼續嗎?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "眼球追蹤設定" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "頭部追蹤設定" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "鍵盤控制" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "啟用擴展視角" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "啟用自動置中" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "頭部追蹤模式" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "直接" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "動態" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "注視視圖靈敏度" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
