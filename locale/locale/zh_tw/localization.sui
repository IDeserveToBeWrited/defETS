	key[]: "connect_selected_content"
	val[]: "連線" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks 偵測到新的遊戲內容。請連線至 World of Trucks 服務以存取新的內容。" #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "線上" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "線上偏好。調整所有與 World of Trucks 相關的設定。" #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "確定要延後註冊嗎？<br><br>您稍後可以透過桌面的「線上選項」開啟「線上連線內容」視窗。" #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "正在連線內容" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "正在連線內容……" #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "排程連線作業失敗：$CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "用於註冊此 DLC 的 Steam 帳戶與用於建立 World of Trucks 帳戶時的不一致。請切換至對應的 Steam 帳戶後再試。" #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "用於註冊此 DLC 的 Steam 帳戶已關聯至其他 World of Trucks 帳戶。請使用其他並未連線至 World of Trucks 的 Steam 帳戶來將此 DLC 註冊至目前的帳戶。" #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam 令牌已失效。請稍後再試。" #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "用來啟用此 DLC 的產品序號無效。請聯絡技術支援取得協助：support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "遊戲註冊過程中發生內部錯誤。請稍後再試。" #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "成功" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "資訊" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "線上" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "內容瀏覽" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "恭喜！所選 DLC 已成功連線至您的 World of Trucks 帳戶。" #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "由於目前的 Steam 帳戶已關聯至其他 World of Trucks 帳戶，無法連線內容。" #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "無法連接部份 DLC。<br>將滑鼠懸停至各個 DLC 的驚嘆號即可檢視詳情。" #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "正在註冊 $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "目前的個人檔案並未連線至 World of Trucks，或是遊戲正以離線模式執行。請編輯個人檔案，進行連線。" #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "點擊以關閉"

	key[]: "online_connect_content_info"
	val[]: "已連線 <color value=@@clr_sel@@>$CONNECTED_CONTENT$<color value=@@clr_txt@@>/$TOTAL_CONTENT$ 個相容的 DLC。如果部份 DLC 沒有連線至 World of Trucks，您可能無法使用其中的功能。" #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>恭喜！<color value=@@clr_txt@@>所有的內容皆已連線至 World of Trucks！您已可以使用全部的功能。" #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "由於目前所使用的 Steam 帳戶與 World of Trucks 帳戶所關聯的 Steam 帳戶不一致，無法將新內容連線至 World of Trucks。" #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "已連線" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "未連線" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "無法取得已擁有內容的資訊。" #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "無法取得已連線內容的資訊。" #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "無法取得目前所帳戶的資訊。" #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "以後再說" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "無法註冊此 DLC。未找到永久授權。而這有可能是由於 Steam 家庭共享導致的。" #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "無永久所有權" #+ The state of the content that cannot be connected due to invalid license.
