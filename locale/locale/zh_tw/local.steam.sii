#!}
#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "選擇 STEAM 輸入對應模式" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "介紹新的 <color value=@@clr_sel@@>遊戲中的對應模式<color value=@@clr_txt@@>，它支援完整的遊戲內按鍵綁定配置和更好的按鍵提示｡<br><br>如果你已透過 Steam 用戶端自訂遊戲手把按鍵佈局，建議保持 <color value=@@clr_sel@@>Steam 用戶端對應模式<color value=@@clr_txt@@>｡<br><br>你可以使用\"輸入嚮導\"的選項中隨時變更模式｡" #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "保留 Steam 用戶端模式" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "打開輸入嚮導" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Steam 輸入對應模式" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "遊戲內對應" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Steam 用戶端對應" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "選擇@@controller_ps5@@、@@controller_xbox_one@@或@@controller_steam_deck@@等等已經接入 Steam 輸入界面的遊戲手把模式。<br>「Steam 用戶端對應」- 使用透過 Steam 用戶端配置的獨立佈局。對遊戲內按鈕提示的支援有限，而且無法在遊戲內進行按鈕綁定。<br>「遊戲內對應」- 使用簡單的通用佈局。支援完整的遊戲內按鍵綁定和更好的按鍵提示。切換至此模式時，建議執行「輸入嚮導」。此為推薦模式。"
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Steam 控制器"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Steam 輸入控制器"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Steam 雲端同步：" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "有新的版本可以使用 ｡<br>除非你關閉自動更新，否則 Steam 將會自動幫你更新 ｡"
#@}

	key[]: "steam_demo"
	val[]: "如果您喜歡《歐洲卡車模擬 2》的試玩版，請前往 <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK> 購買完整版！" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 無法存取 Steam 用戶端 ｡ 建議步驟: \n\n1. 確保 Steam 用戶端正在運行 ｡ \n2. 確保 Steam 用戶端已更新到最新版本\n3. 確保已啟用遊戲的自動更新並更新到最新版本 ｡ "
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "現在安裝的 DLC 與目前遊戲版本不相容，並且將會被停用 ｡ 請驗證 Steam 遊戲快取的完整性 ｡<br><br>以下是不相容的內容:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "無法以此名稱建立 Steam 檔案。已存在相同名稱的 Steam 檔案。" #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "無法移動檔案，另一相同名稱的檔案已存在 ｡" #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "角色檔案遷移失敗 ｡" #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Steam 雲端同步" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "你的 Steam 雲端已有足夠空間儲存存檔 ｡" #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>你在 Steam 雲端上的空間已滿！<color value=@@clr_txt@@><br><br>請刪除一些存檔文件以繼續 ｡ 以下是一些可以幫助你的資訊：" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "已超出空間限制: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "已超出檔案數量限制: <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "已使用的 Steam 雲端空間: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Steam 雲端檔案: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "選取的存檔 <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> 佔用 <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>，共 <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>個檔案｡" #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "你的 Steam 雲端空間不足 ｡ 請刪除一些存檔文件以繼續 ｡<br><br>請閱讀右側面板上的詳細資訊 ｡" #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "轉換為本地檔案類型後，此檔案今後僅能在這台電腦上使用、與所登入的 Steam 帳戶無關。" #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "個人資料遷移失敗 ｡ 未轉移任何數據，系統保留了原始角檔資料 ｡ 請重試 ｡" #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

