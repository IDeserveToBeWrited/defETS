
    key[]: "hint_engine_title"
	val[]: "啟動引擎"

    key[]: "hint_engine_text"
	val[]: "使用 $KEY_engine$ 啟動引擎 ｡ "


    key[]: "hint_ignition_title"
	val[]: "啟動點火系統"

    key[]: "hint_ignition_text"
	val[]: "用 $KEY_engineelect|KEY_engine$ 啟動點火系統。"


    key[]: "hint_driv_arc_title"
	val[]: "駕駛"

    key[]: "hint_driv_arc_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。"


    key[]: "hint_driv_auto_title"
	val[]: "駕駛"

    key[]: "hint_driv_auto_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。<br><offset vshift=8>按下 $KEY_gearup$ 和 $KEY_geardown$ 升降檔位。"


    key[]: "hint_driv_seq_title"
	val[]: "駕駛"

    key[]: "hint_driv_seq_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。<br><offset vshift=8>按下 $KEY_gearup$ 和 $KEY_geardown$ 控制離合器。"


    key[]: "hint_driv_hshift_title"
	val[]: "駕駛"

    key[]: "hint_driv_hshift_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。<br><offset vshift=8>用 <color value=@@clr_sel@@>排檔器<color value=@@clr_txt@@> 換檔。"


    key[]: "hint_depot_deliv_title"
    val[]: "接近目的地"

    key[]: "hint_depot_deliv_text"
    val[]: "在標記區域停下，選擇停車位的難度並獲得相應的經驗值。"


    key[]: "hint_fin_deliv_title"
    val[]: "完成運輸任務"

    key[]: "hint_fin_deliv_text"
    val[]: "請將車輛停放在選定的停車位。 當你靠近交貨點時，可按下 $KEY_activate$ 跳過停車步驟。"


    key[]: "hint_fin_deliv2_title"
    val[]: "完成運輸任務"

    key[]: "hint_fin_deliv2_text"
    val[]: "請將車停在選定的停車位。 你可以在 @@desktop_menu_category_options@@ 中啟用小工具來跳過停車步驟。"


    key[]: "hint_lights_title"
    val[]: "打開車燈"

    key[]: "hint_lights_text"
    val[]: "用 $KEY_light$ 開啟車燈。 重複按下可循環切換不同模式。"


    key[]: "hint_high_beam_title"
    val[]: "開啟遠光燈"

    key[]: "hint_high_beam_text"
    val[]: "用 $KEY_hblight$ 開啟遠光燈。"


    key[]: "hint_wipers_title"
    val[]: "開啟雨刷"

    key[]: "hint_wipers_text"
    val[]: "用 $KEY_wipers$ 開啟雨刷並循環切換不同速度設定。"


    key[]: "hint_zoom_title"
    val[]: "仔細看"

    key[]: "hint_zoom_text"
    val[]: "在駕駛艙內可用 $KEY_camzoom$ 縮放視角。 你可以在 @@desktop_menu_category_options@@ 中設定縮放模式為長按或開關切換。"


    key[]: "hint_cam_int_title"
    val[]: "環顧四周"

    key[]: "hint_cam_int_text"
    val[]: "用 $KEY_cam1$ 切換至內部視角。"


    key[]: "hint_cam_ext_title"
    val[]: "環顧四周"

    key[]: "hint_cam_ext_text"
    val[]: "可用 $KEY_camcycle$ 在不同視角之間切換。<br><offset vshift=8>用 $KEY_cam2$ 切換至外部視角。"


    key[]: "hint_indicators_title"
    val[]: "方向燈"

    key[]: "hint_indicators_text"
    val[]: "用 $KEY_lblinker$ 和 $KEY_rblinker$ 分別開啟左右方向燈。"


    key[]: "hint_tow_title"
    val[]: "拖吊服務"

    key[]: "hint_tow_text"
    val[]: "如果你無法脫離困境，可以使用拖車服務。 用 $KEY_advmouse$ 開啟 @@quick_info_word@@ 選單即可。"


    key[]: "hint_diff_lock_title"
    val[]: "差速鎖"

    key[]: "hint_diff_lock_text"
    val[]: "如果你無法移動，差速鎖或許能幫助你。 用 $KEY_diflock$ 開啟差速鎖，或在 @@desktop_menu_category_options@@ 中啟用自動差速鎖。"


    key[]: "hint_diff_unlock_title"
    val[]: "差速鎖已接合"

    key[]: "hint_diff_unlock_text"
    val[]: "正常駕駛時應解除差速鎖，否則可能會損壞差速器。 用 $KEY_diflock$ 解除差速器，或在 @@desktop_menu_category_options@@ 中啟用自動差速鎖。"


    key[]: "hint_wipers_off_title"
