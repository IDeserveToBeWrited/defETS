SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "系統" #+ Message sender
		subject: "測試訊息" #+ Message subject
		body: "嗨！<br><br>這是來自管理員的測試訊息 ;-)<br><br>謝謝" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "銀行" #+ Message sender
		subject: "需要資金嗎？我們可以提供幫助！" #+ Message subject
		body: "親愛的先生/女士，<br><br>我們認為您可能想要知道——本行正為新創企業提供優惠貸款服務。不知，您是否需要更多的資金來營運事業？我們樂意提供協助！請$SHORTCUT1$<link url=screen.bank color=@@clr_link@@>前往當地銀行</link>咨詢更多的相關訊息。<br><br>敬祝商祺，<br>銷售經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "銀行" #+ Message sender
		subject: "我們可以幫助您成長" #+ Message subject
		body: "親愛的先生/女士，<br><br>我們留意到您的營收入正在穩定增長——我們希望助您一臂之力，進一步發掘自身的潛力。您的信用額度已調升至 $MONEY$。您可以隨時前往$SHORTCUT1$<link url=screen.bank color=@@clr_link@@>當地銀行運用</link>。<br><br>敬祝商祺，<br>銷售經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "銀行" #+ Message sender
		subject: "您的帳戶已經透支" #+ Message subject
		body: "親愛的客戶，<br><br>您從帳戶內提取的金額已經超出可用餘額。我們已為您提供數天的免費短期信用額度，協助解决燃眉之急。請您盡快償還債務。<br><br>敬祝順安，<br>客戶經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "銀行" #+ Message sender
		subject: "您有一筆尚未結清的透支款項！" #+ Message subject
		body: "親愛的客戶，<br><br>您的銀行餘額已為負數！請在 $DAYS$ 天内清償債務，否則我們將依法扣押對您的資產。<br><br>敬啟，<br>客戶經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "銀行" #+ Message sender
		subject: "最後一次警告！" #+ Message subject
		body: "親愛的客戶，<br><br>此為最後警告。您的銀行帳戶已經透支。請於明日前還清欠款，否則我們將依法沒收您的財產以抵償債務。<br><br>敬啟，<br>客戶經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "銀行" #+ Message sender
		subject: "已結清透支款項" #+ Message subject
		body: "親愛的客戶，<br><br>您的帳戶透支款項已經全部結清。未來若有任何需求，我們很樂意為您服務。<br><br>祝您有愉快的一天，<br>客戶經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "銀行" #+ Message sender
		subject: "您的個人卡車已被出售" #+ Message subject
		body: "親愛的客戶。<br><br>很遺憾告知您，我們不得不以 $MONEY$ 的價格出售您的個人卡車——$TRUCK_NAME$。由於您長期積欠本行債務、且並無其他償還方式，我們別無選擇，只好採取此等極端措施。建議您先承接快速工作，直至財務狀況得到改善為止。<br><br>敬啟，<br>您的客戶經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "銀行" #+ Message sender
		subject: "您的個人拖車已被出售" #+ Message subject
		body: "親愛的客戶。<br><br>很遺憾告知您，我們不得不以 $MONEY$ 的價格出售您的個人拖車——$TRAILER_NAME$。由於您長期積欠本行債務、且並無其他償還方式，我們別無選擇，只好採取此等極端措施。建議您先承接快速工作，直財務狀況得到改善為止。<br><br>敬啟，<br>您的客戶經理<br>銀行" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "銀行" #+ Message sender
		subject: "您的個人資產已被出售" #+ Message subject
		body: "親愛的客戶，<br><br>由於您的帳戶長期積欠負債，我們不得不沒收並出手您的資產。所獲金額<br>$MONEY$ 已用於償還債務。受到扣押的資產如下：<br><br>$ITEM_LIST$<br>情況演變至此，我們十分遺憾。希望此結果並不會造成您未來的發展造成太大的影響。<br><br>祝您好運，<br>客戶經理<br>銀行" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "卡車經銷中心 - $CITY$" #+ Message sender
		subject: "正在出售嶄新的 $BRAND$ 卡車！" #+ Message subject
		body: "親愛的先生/女士，<br><br>我們是$BRAND$卡車的授權經銷商。我們擁有各種型號的卡車供您選擇，也可根據您的特殊需求提供自訂服務。歡迎$SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>蒞臨我們位於$CITY$的展示中心</link>。您夢寐以求的卡車或許就在門口等候著您。<br><br>敬祝商祺，<br>$BRAND$卡車經銷商" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "二手卡車經銷中心" #+ Message sender
		subject: "正在出售二手卡車！" #+ Message subject
		body: "親愛的先生/女士，<br><br>我們很高興地宣布——「二手卡車」經銷中心正式開張本店是您選購高品質二手卡車的最佳去處！ 無論您是想要性能強勁的車款、抑或是穩固耐用的車款，我們都能為您提供最為適合的選擇。<br><br>歡迎瀏覽我們的$SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>二手卡車專區</link>。相信您一定能找到符合需求的理想卡車。<br><br>敬啟，<br><br>二手卡車經銷團隊<br><br>P.S. 別忘了常來看看是否有新到車輛！我們的庫存會持續更新，隨時都有機會撿到超值好車。" #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$，$CITY$" #+ Message sender
		subject: "誠徵自備卡車的司機" #+ Message subject
		body: "致有志人士，<br><br>我們尋求技術純熟、自備卡車的司機承接大量運輸工作。本公司提供優厚的報酬，每項工作最多可獲 $MONEY$。如果您擁有自己的卡車，請前往我們位於$CITY$的碼頭洽詢。<br><br>$COMPANY$<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "司機 $NAME$" #+ Message sender
		subject: "我需要一輛卡車來工作" #+ Message subject
		body: "嗨，老闆。<br><br>我不知道你是否有注意到——我已經在$CITY$閒待了 $DAYS$ 天，完全沒有工作可做。我感到相當的不滿，因為我還需要繳付各種開銷。然而没有工作，就賺不到錢！希望你能在接下來的 $DAYS2$ 天内為我安排一輛卡車，讓我可以開始承接運輸工作。否則，我只好選擇離開。<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "司機 $NAME$" #+ Message sender - written by female
		subject: "我需要一輛卡車來工作" #+ Message subject - written by female
		body: "嗨，老闆。<br><br>我不知道你是否有注意到——我已經在$CITY$閒待了 $DAYS$ 天，完全沒有工作可做。我感到相當的不滿，因為我還需要繳付各種開銷。然而没有工作，就賺不到錢！希望你能在接下來的 $DAYS2$ 天内為我安排一輛卡車，讓我可以開始承接運輸工作。否則，我只好選擇離開。<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "司機 $NAME$" #+ Message sender
		subject: "再見" #+ Message subject
		body: "嗨。<br><br>我不能繼續浪費自己的時間了。沒有卡車，我根本就無法工作。我不想再等下去了。我已經錯過了許多的機會。因此，我要離開這家公司、去其他公司碰碰運氣。你可以在我之前位於$CITY$的車庫找到配發的所有裝備。<br><br>再見，<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "司機 $NAME$" #+ Message sender - written by female
		subject: "再見" #+ Message subject - written by female
		body: "嗨。<br><br>我不能繼續浪費自己的時間了。沒有卡車，我根本就無法工作。我不想再等下去了。我已經錯過了許多的機會。因此，我要離開這家公司、去其他公司碰碰運氣。你可以在我之前位於$CITY$的車庫找到配發的所有裝備。<br><br>再見，<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "司機 $NAME$" #+ Message sender
		subject: "我的卡車需要全面檢修" #+ Message subject
		body: "嗨，老闆。<br><br>我知道你很忙，但——我的卡車需要全面檢修。它實在太過老舊、磨損嚴重，無法安全行駛。我已經 $DAYS$ 天沒有工作可做了。坦白說，我很沮喪。我得支付生活開銷。沒有能上路的卡車，我就根本無法工作。拜託——要嘛為我安排一輛新的卡車、要嘛就把現在這輛給徹底修好，我好繼續工作。否則，我只好選擇離開。<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "司機 $NAME$" #+ Message sender - written by female
		subject: "我的卡車需要全面檢修" #+ Message subject - written by female
		body: "嗨，老闆。<br><br>我知道你很忙，但——我的卡車需要全面檢修。它實在太過老舊、磨損嚴重，無法安全行駛。我已經 $DAYS$ 天沒有工作可做了。坦白說，我很沮喪。我得支付生活開銷。沒有能上路的卡車，我就根本無法工作。拜託——要嘛為我安排一輛新的卡車、要嘛就把現在這輛給徹底修好，我好繼續工作。否則，我只好選擇離開。<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "司機 $NAME$" #+ Message sender
		subject: "再見" #+ Message subject
		body: "嗨。<br><br>我也不想這麼說，但……我的卡車已經磨損嚴重、無法行駛。我已經沒有時間去處理了。我目前沒有工作，開銷卻不斷累積。因此，我得另謀出路。建議在下個司機接手之前，先給這輛卡車進行全面檢修。你可以在我之前位於$CITY$的車庫找到配發的所有裝備。<br><br>再見。<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "司機 $NAME$" #+ Message sender - written by female
		subject: "再見" #+ Message subject - written by female
		body: "嗨。<br><br>我也不想這麼說，但……我的卡車已經磨損嚴重、無法行駛。我已經沒有時間去處理了。我目前沒有工作，開銷卻不斷累積。因此，我得另謀出路。建議在下個司機接手之前，先給這輛卡車進行全面檢修。你可以在我之前位於$CITY$的車庫找到配發的所有裝備。<br><br>再見。<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "司機 $NAME$" #+ Message sender
		subject: "我要離開了" #+ Message subject
		body: "你好，老闆。<br><br>我原本使用的那間位於$CITY$的車庫已被查封。銀行的人過來通知我說必需搬離。看来公司最近的狀況不是很好。因此，我決定辭職。反正沒有卡車，我繼續待在這裡也只是在混日子。我會去別的地方碰碰運氣。<br><br>再見，請別見怪。<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "司機 $NAME$" #+ Message sender - written by female
		subject: "我要離開了" #+ Message subject - written by female
		body: "你好，老闆。<br><br>我原本使用的那間位於$CITY$的車庫已被查封。銀行的人過來通知我說必需搬離。看来公司最近的狀況不是很好。因此，我決定辭職。反正沒有卡車，我繼續待在這裡也只是在混日子。我會去別的地方碰碰運氣。<br><br>再見，請別見怪。<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "調度員" #+ Message sender
		subject: "特殊運輸" #+ Message subject
		body: "你好，老闆。<br><br>我為你準備了一系列特別任務。憑藉現在的人脈，我們終於能接到真正的挑戰了。一些超大型、超重型特殊貨物需要真正的專業司機來運輸。雖然並不簡單，需要一些技巧、耐心，還得格外謹慎地與護送車隊進行協作，但我相信你都具備這些特質，對吧？而且，風險越高、報酬也越豐厚。<br><br>如果你有興趣，就前往這些城市吧：<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "調度員" #+ Message sender
		subject: "全新的特殊運輸" #+ Message subject
		body: "嗨，老闆。<br><br>更多公司希望僱用你這位專業司機來運輸特殊貨物。一如既往——雖然並不簡單，需要一些技巧、耐心，還得格外謹慎地與護送車隊進行協作，但我相信你依然具備這些特質，對吧？不要忘了——這類工作的報酬也更為優渥。<br><br>除現正提供特殊運輸工作的城市之外：<br><br>$OLD_CITIES$<br><br>您還可以在這些城市承接<color value=@@clr_sel@@>新的特殊運輸工作<color value=@@clr_txt@@>：<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "房地產仲介" #+ Message sender
		subject: "想要擴大公司規模嗎？" #+ Message subject
		body: "親愛的先生/女士，<br><br>恭喜貴公司的業務蓬勃發展、蒸蒸日上！我們對您的經營成果印象深刻，並希望為您提供新的方案、協助您進一步擴展事業。從現在起，您可以透過我們的服務來快速購買額外資產！更多詳細資訊，請前往$SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>車庫購買頁面</link>查詢。<br><br>敬啟，<br>公關經理<br>房地產仲介" #+ Message body
	}
	
#@}
}