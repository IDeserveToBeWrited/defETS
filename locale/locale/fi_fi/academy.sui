#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Esteiden kiertäminen"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Edessä on erilaisia haastavia käännöksiä ja esteitä.<br>Tämän ei pitäisi olla liian vaikeaa, kunhan muistat kaiken aiemmin oppimasi."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Tiemerkintöjen avulla voit saada vihjeen kuinka sinun tulisi selvitä esteistä."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Pidä vetoauto mutkan ulkoreunassa. <br>Sinun tulee koukata leveästi, koska perävaunu seuraa lyhyempää reittiä."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Seuraava mutka on helppo 90 asteen käännös. <br> Jälleen kerran, pidä kuorma-autosi mutkan ulkoreunassa ja hyödynnä kaikki käytettävissäsi oleva tila."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Etene rauhassa. Rata levenee, mutta sinun tulee silti ajaa tarkasti."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Pidä kunnolla etäisyyttä esteisiin."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Pidä varasi kun tulet tälle kapealle osuudelle. <br>Koukkaa vetoautolla leveästi ennen sinne ajamista, jotta perävaunusi on asemoitu oikein."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Viimeinen 90 asteen käännös on paljon terävämpi kuin ensimmäinen, mutta viisaasti ajamalla sinulla on reilusti tilaa."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Pysähdy kohdealueelle, varmista sitten kuorma-auto ja sammuta moottori."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Muista hyödyntää tiemerkintöjä selvittääksesi radan.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Peilien käyttö auttaa sinua selviytymään radasta turvallisesti. Sinun tulee jatkuvasti tarkkailla, miten perävaunu kulkee takanasi.<br><br><font face=/font/big_bold.font>Suorita ensimmäinen käännös. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Tarkkaile perävaunua kun poistut käännöksestä ja valmistaudu ajamaan seuraavaan.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Suorita seuraava käännös. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Muista tarkkailla perävaunuasi varmistaaksesi, että olet ohittanut ympärilläsi olevat esteet ennen kuorma-auton kääntämistä.<br><br><font face=/font/big_bold.font>Jatka edessä olevan esteen ohi. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Kun perävaunusi on ohittanut esteen, käännä tiukasti apukuskin puolelle kohdistaaksesi ajoneuvosi kapealle väylälle.<br><br><font face=/font/big_bold.font>Jatka kohti kapeaa väylää.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Tässä osuudessa vaaditaan tarkkaa ajoa. Aja rauhassa ja käytä peilejäsi.<br><br><font face=/font/big_bold.font>Pysyttele kunkin käännöksen ulkoreunassa. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Tämä käännös on todella terävä, mutta selviät siitä helposti käyttämällä kaiken edessä olevan tilan hyödyksi.<br><br><font face=/font/big_bold.font>Suorita viimeinen käännös. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

