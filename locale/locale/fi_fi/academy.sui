	val[]: "Tupla-yhdistelmän vinoparkkeeraus"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "Tässä tehtävässä pysäköit tupla-yhdistelmäsi vinoparkkiin vilkkaalla alueella. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Tämänkaltaiset vinoparkit ovat erittäin yleisiä. Saatat nähdä sellaisia monilla levähdysalueilla Euroopan moottoriteiden varrella."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Aja kohti merkittyä pysäköintipaikkaa lähellä rivin päätä."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Pysyttele kaistan ulkoreunassa, mutta älä liian lähellä reunalla olevia esteitä, sillä perävaunu voi osua niihin kun käännyt."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Drive past the parking spot to make room for both trailers to follow you in. Then dive towards the far side of the spot to bring your first trailer into position."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Suorista, pysähdy sitten kohdealueelle ja varmista kuorma-auto."

