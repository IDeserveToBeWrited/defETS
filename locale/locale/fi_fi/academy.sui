#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Esteen lähelle pysähtyminen"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Tässä tehtävässä käsittelemme etupeiliä - sen sijaintia ja kuinka hyödynnät sitä tehokkaasti pysähtyäksesi edessä olevan esteen lähelle."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Etupeilin tarkistaminen"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Toiminnallisuuden ymmärtäminen"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Esteen viereen pysähtyminen"
