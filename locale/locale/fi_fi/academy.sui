	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Vaihtaminen vapaalle"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Moottorin sammuttaminen"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Tämän ajon aikana peruutamme suoraan. Sinun tulee peruuttaa katkoviivan yli ja pysähtyä."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Kuorma-autoa peruuttaessa on tärkeää katsoa jatkuvasti ympärilleen, tarkkailla kaikkia peilejä ja varmistua, että ympärilläsi tai takanasi ei ole esteitä."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Käynnistä moottori, kytke peruutusvaihde ja lähde liikkeelle."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Peruuta katkoviivan ohi, pysähdy, sammuta moottori ja varmista kuorma-auto."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Valmistele kuorma-auto ajoa varten edellisen tehtävän oppien mukaan.<br><br><font face=/font/big_bold.font>Käynnistä moottori, kun olet valmis. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Tarkista peileistäsi, että ympäristösi on tyhjä. Jos et ole tyytyväinen peilien säätöihin, voit säätää niitä valitsemalla '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Katso apukuskin puolen sivupeiliäsi.</font>@@aca_goal_tip@@ Sinun tulee olla ajoneuvon sisällä."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Ajat katkoviivan yli. Reitti on nyt selvä, mutta normaalissa ajossa on tärkeää tarkkailla ympäristöäsi katselemalla sekä ympärillesi, että peileihin.<br><br><font face=/font/big_bold.font>Tarkista kuljettajan puolen peili.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Paina $input backward$ kytkeäksesi peruutusvaihteen. </font>@@aca_goal_tip@@ Suurimmassa osassa kuorma-autoja peruutushälytin kytkeytyy automaattisesti päälle peruutettaessa. Voit kytkeä sen pois päältä Asetuksista - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Paina @@imv_nrm_geardown@@ kytkeäksesi peruutusvaihteen. </font>@@aca_goal_tip@@ Suurimmassa osassa kuorma-autoja peruutushälytin kytkeytyy automaattisesti päälle peruutettaessa. Voit kytkeä sen pois päältä Asetuksista - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Paina @@imv_nrm_geardown@@ kytkeäksesi peruutusvaihteen. </font>@@aca_goal_tip@@ Suurimmassa osassa kuorma-autoja peruutushälytin kytkeytyy automaattisesti päälle peruutettaessa. Voit kytkeä sen pois päältä Asetuksista - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Paina kytkin pohjaan ja siirrä vaihdevipu peruutusvaihteelle. </font>@@aca_goal_tip@@ Suurimmassa osassa kuorma-autoja peruutushälytin kytkeytyy automaattisesti päälle peruutettaessa. Voit kytkeä sen pois päältä Asetuksista - 'Audio' - @sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Peruutusvaihteesi on nyt kytketty.<br><br><font face=/font/big_bold.font>Vapauta käsijarru painamalla @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Lähde liikkeelle painamalla $input backward$.<br><br><font face=/font/big_bold.font>Peruuta katkoviivan ohitse. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Lähde liikkeelle painamalla kaasua: $input forward$.<br><br><font face=/font/big_bold.font>Peruuta katkoviivan ohitse. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Lähde liikkeelle painamalla kaasua: $input forward$.<br><br><font face=/font/big_bold.font>Peruuta katkoviivan ohitse. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Nosta kytkin rauhallisesti ylläpitäen samaan aikaan moottorin kierroksia käyttäen kaasupoljilta. <br><br><font face=/font/big_bold.font>Peruuta katkoviivan ohi. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Pysäytä kuorma-auto käyttöjarrulla: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Pysäytä kuorma-auto käyttöjarrulla: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Pysäytä kuorma-auto käyttöjarrulla: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Paina kytkin kokonaan pohjaan ja pysäytä kuorma-auto käyttöjarrulla. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Kytke käsijarru painamalla @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Yksinkertaistetulla automaattivaihteistolla sinun ei tarvitse vaihtaa itse vaihteita, vaan kaikki tapahtuu automaattisesti, toisin kuin oikeassa elämässä.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_activate@@ jatkaaksesi. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Vaihda vaihde vapaalle painamalla @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderneissa kuorma-autoissa vaihde kytkeytyy automaattisesti vapaalle, kun käsijarru laitetaan päälle. On kuitenkin hyvä ottaa tavaksi tehdä se aina itse. Seuraavissa tehtävissä emme vaadi tämän toimenpiteen suorittamista."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Vaihda vapaalle painamalla @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderneissa kuorma-autoissa vaihde kytkeytyy automaattisesti vapaalle, kun käsijarru laitetaan päälle. On kuitenkin hyvä ottaa tavaksi tehdä se aina itse. Seuraavissa tehtävissä emme vaadi tämän toimenpiteen suorittamista."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Vaihda vaihde vapaalle ja nosta sen jälkeen kytkin.</font>@@aca_goal_tip@@ Moderneissa kuorma-autoissa vaihde kytkeytyy automaattisesti vapaalle, kun jäsijarru laitetaan päälle. On kuitenkin hyvä ottaa tavaksi tehdä se aina itse. Seuraavissa tehtävissä emme vaadi tämän toimenpiteen suorittamista."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Muista peruuttaessasi tarkkailla aina ympäristöäsi, erityisesti alueilla, joissa on paljon liikennettä.<br><br><font face=/font/big_bold.font>Sammuta moottori painamalla $input engineelect$. </font>"
#@}

