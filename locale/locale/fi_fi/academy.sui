#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Ennen ajoa"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Ensimmäisessä tehtävässäsi käymme läpi kuorma-auton hytin perusasiat. On tärkeää säätää istuin, ohjauspyörä ja sivupeilit oikein, sillä hyvä näkyvyys on stressavista ja epävarmoista tilanteista selviämisen kannalta tärkeää.<br><br>Käymme yksi kerrallaan läpi kunkin osa-alueen säätämisen."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Istuimen ja peilien säätäminen"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Peilien ja näkyvyyden tarkistaminen"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Tervetuloa ensimmäiselle oppitunnille!<br>Aloitetaan opettelemalla miten kuorma-auto valmistellaan ajoa varten."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "On tärkeää varmistaa, että ajosi on aina turvallista, ammattimaista ja hallittua.<br>Istuimen, ohjauspyörän ja peilien säätäminen oikein auttavat sinua tässä."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Kuorma-auton kummallakin puolella on ajoneuvoja.<br>Ne auttavat sinua säätämään peilisi oikein."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Käytä aikaa asetusten säätämiseen mieleiseksesi, sillä näillä<br>asetuksilla on merkittävä vaikutus kykyysi hallita kuorma-autoa."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Istuimen ja ohjauspyörän säätäminen"

	key[]: "adj_tut_title_1"
	val[]: "Sivupeilien säätäminen"

	key[]: "adj_tut_title_2"
	val[]: "Kuperien peilien säätäminen"

	key[]: "adj_tut_title_3"
	val[]: "Näkyvyyden tarkistaminen ja peilien säätöjen viimeistely"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "paina @@imv_nrm_adjuster@@ tai avaa ne pysäytysvalikon ajoneuvon säädöt -valinnasta"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "avaa ne pysäytysvalikon ajoneuvon säädöt -valinnasta"

	key[]: "adj_tut_open_adj"
	val[]: "Näyttääksesi '@@adjust_link_t@@' pelin aikana, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Aloitetaan säätämällä kuljettajan istuin ja ohjauspyörä.<br><br><font face=/font/big_bold.font>Valitse '@@adj_seats@@' jatkaaksesi.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Avaa @@adj_mirrors@@ säätääksesi peilejäsi.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Kun istut ensimmäisen kerran kuorma-autoon, on tärkeää ensiksi säätää istuin, ohjauspyörä ja peilit mieleiseksesi.<br><br>Oikea istuma-asento ratin takana on hyvän näkyvyyden kannalta tärkeää. Kaikki hallintalaitteet tulee olla käden ulottuvilla ja kuljettajalla tulee olla hyvä näkyvyys eteenpäin, sivuille ja peileihin.<br><br><font face=/font/big_bold.font>Päästäksesi määritysvalikkoon, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Säädä istuin niin, että sinulla on selkeä näkyvyys ympäristöön ja peileihin, ja että yllät kaikkiin hallintalaitteisiin.<br><br>Säädä ohjauspyörä mukavaan asentoon niin, ettei se estä näkyvyyttä mittaristoon.<br><br><font face=/font/big_bold.font>Kun olet tyytyväinen säätöihin, paina @@imv_nrm_back@@ palataksesi määritysvalikkoon </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Kuorma-autoissa on monta suurta katvealuetta, joten ne on varustettu usealla ulkopeilillä, jotka helpottavat kuljettajaa näkemään niin paljon kuin mahdollista. <br><br>Saat parhaan mahdollisen näkyvyyden ympäristöösi säätämällä nämä peilit asianmukaisesti.<br><br><font face=/font/big_bold.font>Avaa '@@adj_mirrors@@' jatkaaksesi.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Sivupeileistä näet kuorma-auton ja perävaunun sivustan.<br><br>Käytä apunasi autoja kuorma-auton molemmilla puolilla säätääksesi sivupeilit oikeaan asentoon.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_selectfcs@@ jatkaaksesi.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Sivupeilit ovat tärkein työkalusi nähdäksesi mitä sivuillasi ja takanasi tapahtuu. Sinun tulisi nähdä viereinen auto hyvin, mutta varmista, että näet peileistäsi myös osan perävaunustasi, jotta voit arvioida tarkasti ympärilläsi olevien esteiden sijainnin."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Kun olet tyytyväinen säätöihin, vaihda apukuskin puolen sivupeiliin."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Kuten äsken, sinun tulisi nähdä viereinen auto hyvin, mutta myös osa perävaunustasi."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Kun olet tyytyväinen peilin säätöihin, vaihda kuljettajan puolen kuperaan peiliin."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Kuperat peilit tarjoavat leveämmän näkökentän, jotta näet paremmin mitä sivuillasi tapahtuu.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_selectfcs@@ jatkaaksesi. </font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Ihanteellisesti sinun tulisi nähdä sekä viereen pysäköity auto että kuorma-auto, samalla kun pieni osa omasta kuorma-autostasi on yhä näkyvissä."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Kun olet tyytyväinen peilin säätöihin, vaihda apukuskin puolen kuperaan peiliin."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Kuten äsken, sinun tulisi nähdä sekä viereen pysäköity auto, että kuorma-auto samalla, kun pieni osa omasta kuorma-autostasi on yhä näkyvissä."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Kun olet tyytyväinen peilin säätöihin, paina @@imv_nrm_back@@ sulkeaksesi peilien säädöt."

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Paina @@imv_nrm_back@@ palataksesi asetusvalikkoon. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Hienoa. Nyt kun istuin ja peilit on säädetty mieleiseksesi, olet askeleen lähempänä tien päälle pääsyä!<br><br><font face=/font/big_bold.font>Sulje asetusvalikko painamalla @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Vilkaise vielä kerran ympärillesi ja varmista, että olet tyytyväinen näkymään ohjaamosta, ja että näet peileistä hyvin mitä kuorma-auton ympärillä tapahtuu.<br><br>Jos huomaat puutteita, voit säätää peilisi uudestaan valitsemalla '@@adjust_link_t@@'. <br><br><font face=/font/big_bold.font>Paina @@imv_nrm_activate@@ päättääksesi ensimmäisen tehtävän.</font> @@aca_goal_tip@@ Näyttääksesi tai piilottaaksesi näytöllä näkyvät peilit, voit valita pysäytysvalikosta '@@adjust_link_t@@' — '@@adj_ui_mirrors@@'. Näytöllä näkyvät peilit helpottavat näkemistä apukuskin puolelle."
#@}

