#!{
	key[]: "aca_msg_book1_3_09_start_img"
	val[]: "<align vstyle=top hstyle=left><img src=/material/ui/academy/book/book1/illustration/diagonal.mat bottom=p204 right=p204 color=FFFFFFFF></align><offset vshift=204>"

	key[]: "aca_msg_book1_3_09_start_img_uk"
	val[]: "<align vstyle=top hstyle=left><img src=/material/ui/academy/book/book1/illustration/diagonal_gb.mat bottom=p204 right=p204 color=FFFFFFFF></align><offset vshift=204>"
#!}

#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Vinoparkkeeraus"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Tässä tehtävässä ajat vinoparkkiin vilkkaalla alueella. <br><br>Täällä ei ole ylimääräistä tilaa, joten sinun tulee ajaa tarkasti ja harkitusti."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Pysäköintipaikan lähestyminen"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Tämänkaltaiset vinoparkit ovat erittäin yleisiä. Saatat nähdä sellaisia monilla levähdysalueilla Euroopan moottoriteiden varrella. <br>Meidän täytyy jälleen kerran ajaa keula edellä pysäköintipaikkaan."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Aja kohti merkittyä pysäköintipaikkaa lähellä rivin päätä."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Pysyttele kaistan keskellä tai hieman kuljettajan puolella. Älä aja liian lähelle esteitä tai perävaunun perä saattaa osua niihin kääntyessäsi."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Aja reilusti pysäköintipaikan ohi, käännä sitten tiukasti ja nopeasti kohti paikkaa. Sinun tulee tarkkailla molempia sivupeilejäsi: Kuljettajan puolen peilistä varmistat, ettei perävaunusi etupää osu vieressäsi olevaan perävaunuun ja apukuskin puolen peilistä varmistat että perävaunusi menee turvallisesti kohti pysäköintipaikkaa."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Pysähdy merkitylle alueelle, varmista kuorma-auto ja sammuta moottori."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Vinoon parkkeeratessa on tärkeä arvioida tarkasti sijaintisi. Kun olet puolimatkassa, on hankala peruuttaa ja sijoittautua uudelleen, joten heti aluksi on syytä varmistua, että sinulla on riittävästi tilaa.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Lähde ajamaan kohti pysäköintipaikkaa. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Aja pysäköintipaikan ohi niin, että perävaunullasi on tilaa kääntyä kuorma-autosi viereen.<br><br><font face=/font/big_bold.font>Käänny pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Peruuttaminen apukuskin puolelle"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Tässä tehtävässä harjoittelemme peruuttamista pysäköintipaikkaan apukuskin puolella. Sinun tulee luottaa peileihisi päästäksesi minne haluat, sillä et voi katsoa ulos ikkunasta."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Tässä tehtävässä opit peruuttamaan apukuskin puolelle. Tätä tulisi käyttää vain jos muuta vaihtoehtoa ei ole, sillä näkyvyytesi on erittäin rajoitettu. Aja rauhassa ja ole mieluummin liian varovainen."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Aja reilusti pysäköintipaikan ohi, jotta saat riittävästi tilaa aloittaessasi peruuttamisen."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Pysähdy, tarkista ympäristösi ja aloita sitten peruuttaminen."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Käännä vetoauto pois päin paikasta työntääksesi perävaunun etupäätä ohjaten takapään kohti haluamaasi pysäköintipaikkaa. Varo liioittelemasta ohjausliikettä tai saatat saada yhdistelmän linkkuun."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Aloita kuorma-auton oikaiseminen kun perävaunu osuu pysäköintipaikkaan."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Pysähdy kohdealueelle ja varmista kuorma-auto."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Peruuttaminen apukuskin puolelle vaatii samat toimenpiteet kuin toisellekin puolelle peruutettaessa, mutta rajoitettu näkyvyys lisää haastetta. Käytä peilejäsi ja arviointikykyäsi pysäköidäksesi kuorma-auton.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Edessäsi apukuskin puolella on pysäköintipaikka. Sinun tulee ajaa reilusti sen ohi, jotta sinulle jää riittävästi tilaa ohjata kun peruutat.<br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Muista, että kuorma-auton kääntäminen pois päin kääntää perävaunun kohti pysäköintipaikkaa. Käytä peilejäsi parhaasi mukaan, jotta pääset pysäköintipaikkaan.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Ajaminen liikenneympyrässä"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Tässä tehtävässä opettelemme ajamaan liikenneympyrässä.<br><br>Sinun täytyy kiinnittää erityistä huomiota perävaunuusi, sillä se seuraa sinua eri tavalla kun ajat liikenneympyrään, liikenneympyrässä ja kun poistut sieltä."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Liikenneympyrään ajaminen"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Liikenneympyrässä ajaminen"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Liikenneympyrässä ajaminen"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Liikenneympyrästä poistuminen"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Kohdealueelle ajaminen"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Liikenneympyrät ovat yleisiä Euroopan kaduilla, joten on tärkeää tietää, kuinka niissä ajetaan."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Pysy kaistan ulkoreunassa lähestyessäsi liikenneympyrää. Näin perävaunusi ei osu sisäkaarteeseen ensimmäisessä käännöksessä."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Aja kohti keskustaa ajaessasi liikenneympyrään. Kun olet ympyrässä, tulee sinun siirtyä kohti ulkoreunaa. Näin saat pidettyä perävaunusi poissa liikenneympyrän keskeltä."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Tarkkaile peilejäsi varmistuaksesi, että perävaunu ei ajaudu liian lähelle keskellä olevia esteitä."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Liikenneympyrästä poistuminen on melko helppoa, sillä perävaunusi osoittaa jo pois ympyrän keskustasta. Kaarra leveästi poistuessasi ja perävaunusi pitäisi seurata sinua hienosti."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Pysäköi kohdealueelle ja varmista kuorma-auto."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Edessäsi on sinua varten tehty liikenneympyrä. <br><br><font face=/font/big_bold.font>Lähesty liikenneympyrää hitaasti. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Tee laaja käännös kun ajat liikenneympyrään, jotta perävaunusi seuraa perässäsi ongelmitta. <br><br><font face=/font/big_bold.font>Aja liikenneympyrään. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Aja kohti liikenneympyrän ulkoreunaa. Sinun tulee pitää kuorma-auto mahdollisimman kaukana liikenneympyrän keskustasta estääksesi perävaunuasi osumasta esteisiin keskellä. <br><br><font face=/font/big_bold.font>Jatka liikenneympyrässä ajamista.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Pysyttele ulkoreunan kartioiden lähellä. <br><br><font face=/font/big_bold.font>Jatka ajamista.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Poistu liikenneympyrästä.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Jatka kohti edessäsi olevaan pysäköintipaikkaa.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Pysähdy kohdealueelle.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Varmista kuorma-auto ja sammuta moottori.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Käsittely ahtaassa tilassa"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Viimeisessä tehtävässä sinun tulee kääntää kuorma-auto ympäri ahtaassa paikassa. Tämä vaatii peruuttamista apukuskin puolelle alueella, jossa on vähän tilaa. Tämä vaatii ympäristön huomioimista ja tilan järkevää hyödyntämistä."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Radalle ajaminen"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Valmistautuminen apukuskin puolelle"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Paikkaan peruuttaminen"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Peruuttaminen apukuskin puolelle"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Radalta poistuminen"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Tässä tehtävässä opetamme, miten käännytään ympäri ahtaassa tilassa peruuttamalla apukuskin puolelle. Tämä taito on hyödyllinen silloin, kun et voi tehdä U-käännöstä tai peruuttaa kuljettajan puolelle."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Tiemerkinnät helpottavat ajamaan harjoitteluradan läpi."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Tee laaja käännös varmistaaksesi, ettei perävaunu osu pysäköityihin kuorma-autoihin."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Kun poistut käännöksestä, mieti samalla miten asemoit kuorma-autosi peruutusta varten."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Helpottaa, jos kuorma-autosi osoittaa kohti apukuskin puolella olevaa tyhjää pysäköintipaikkaa jonne olet peruuttamassa."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Apukuskin puolelle peruuttamista tulisi välttää jos mahdollista, sillä näkyvyys on merkittävästi huonompi. Valitettavasti joskus ei ole mitään muuta vaihtoehtoa."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Käännä rattia ennen peruuttamista. Tällä tavoin saat perävaunusi lähtemään heti haluamaasi suuntaan, mikä helpottaa erittäin ahtaissa paikoissa."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Kun perävaunu on riittävän pitkällä, aloita vetoauton kääntäminen perävaunun eteen ja oikaise yhdistelmä."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Pysähdy kun olet suoristanut ja sinulla on riittävästi tilaa lähteä eteenpäin. Lähde palaamaan takaisin samaa tietä kuin tulitkin."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Seuraa tiemerkintöjä ulos harjoitteluradalta."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Aja edessä olevan kaarteen läpi ja jatka kohdealueelle."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Pysähtyminen."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Varmista kuorma-auto ja sammuta moottori."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Edessäsi olevalla alueella on kuljetusliikkeen terminaalia muistuttava harjoittelurata. Tehtäväsi on ajaa sinne, kääntää kuorma-auto ja tulla takaisin ulos. Käytä ympärilläsi oleva tila hyödyksesi<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Jatka kohti harjoittelurataa. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Käänny mutkasta ja jatka rataa eteenpäin. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Seuraa tiemerkintöjä radan lopussa olevalle esteelle. Pysäköi hieman kulmaan, jotta perävaunusi osoittaa kohti tyhjää pysäköintipaikkaa apukuskin puolella.<br><br><font face=/font/big_bold.font>Jatka eteenpäin. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Apukuskin puolelle peruuttaessa näkyvyytesi on rajallisempi. Etene hitaasti, käytä peilejäsi ja ole mieluummin liian varovainen.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen ja käännä perävaunu tyhjään pysäköintipaikkaan. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Se riittää. Voit nyt jatkaa eteenpäin ja poistua harjoittelualueelta samaa tietä josta tulit.<br><br><font face=/font/big_bold.font>Lähde liikkeelle kohti poistumistietä. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Poistu harjoitteluradalta. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Seuraa tiemerkintöjä lopulliseen pysäköintipaikkaan.<br><br><font face=/font/big_bold.font>Jatka kohdealueelle. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Sivuttaissiirtoliike peruuttamalla"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa pysäköintipaikkaa, joka ei ole suoraan takanasi. Tilaa on rajoitetusti, joten sinun tulee käyttää sitä harkiten."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Tässä tehtävässä sinun pitää pysäköidä vieressäsi olevaan pysäköintipaikkaan. Tilaa on rajoitetusti, joten sinun pitää nähdä hieman vaivaa saadaksesi perävaunun oikeaan paikkaan."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Aja suoraan esteen luokse."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Pysähdy ennen estettä."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Käännä rattia reilusti kuljettajan puolelle ennen liikkeellelähtöä. Näin heti kun lähden peruuttamaan, alkaa perävaunusi kääntyä kohti pysäköintipaikkaa säästäen kallisarvoista tilaa."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Heti kun perävaunusi osoittaa oikeaan suuntaan, ohjaa vetoauto perävaunun eteen ja ryhdy ohjaamaan kohti pysäköintipaikkaa."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Tästä eteenpäin, tämä on kuin mikä tahansa tavanomainen peruutusliike."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Jatka peruuttamista ja tarkkaile kumpaakin puolta. Pidä vetoauto ja perävaunu linjassa kohti pysäköintipaikkaa."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Pysähdy merkitylle alueelle, varmista kuorma-auto ja sammuta moottori."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Olet pysäköintipaikassa, mutta oikealla puolella on toinen pysäköintipaikka, johon sinun tulee siirtyä.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Edessäsi on merkitty alue.<br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Muista aloittaa kääntäminen heti, koska tilaa on rajoitetusti.<br><br><font face=/font/big_bold.font>Peruuta takanasi olevaan merkittyyn paikkaan. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Ajaminen yksinkertaisesta käännöksestä"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Tässä tehtävässä lähdet lyhyelle ajelulle harjoitteluradalle, jolla opit selviytymään perävaunun kanssa helpoista 90 asteen mutkista."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Ensimmäinen käännös"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Toinen käännös"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Viimeinen käännös"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Edessäsi on joitain tiukkoja käännöksiä, joissa ei ole juuri ylimääräistä tilaa. Nämä opettavat sinua kuljettamaan perävaunuyhdistelmää sujuvasti."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Seuraa tiemerkintöjä kohti esteitä kuljettajan puolella valmistautuaksesi ensimmäiseen käännökseen."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Pysyttele ulkoreunan esteiden lähellä käännöksen läpi ja perävaunusi pitäisi seurata sinua hienosti radalle."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Jatka tiemerkintöjen seuraamista valmistautuaksesi seuraavaan tiukkaan 90 asteen käännökseen."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Sinun tulee ajaa pitkälle mutkaan varmistaaksesi, että perävaunusi ei osu sisäreunan esteisiin. Käytä etupeiliäsi avuksesi, jotta voit ajaa niin pitkälle mutkaan kuin mahdollista osumatta mihinkään."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Jatka ulkoreunan esteiden vieressä."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Jälleen uusi tiukka 90 asteen käännös joka vaatii, että hyödynnät kaiken käytettävissäsi olevan tilan."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Pysähdy kohdealueelle ja varmista kuorma-auto."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Muista käyttää kaikki käytettävissä oleva tila, jotta suoriudut kaikista käännöksistä.<br><br><font face=/font/big_bold.font>Lähde liikkeelle ja seuraa tiemerkintöjä ulkoreunaan. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Seuraa ulkoreunan esteitä käännöksessä, mutta tarkkaile perävaunuasi peileistäsi.<br><br><font face=/font/big_bold.font>Suorita ensimmäinen käännös. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Seuraa tiemerkintöjä valmistautuaksesi edessä olevaan 90 asteen käännökseen.<br><br><font face=/font/big_bold.font>Suorita 90 asteen käännös. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Aja ulkoreunassa käännöksen jälkeen, sillä sinulla on yksi vielä ahtaampi 90 asteen käännös edessäsi.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Jatka kohti edessäsi olevaa pysäköintipaikkaa. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Vinoparkkeeraus peruuttamalla"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Tässä tehtävässä tutkimme vinoparkkeerausta peruuttamalla. Tällaisia tilanteita saattaa tulla levähdysalueilla, rekkaparkeissa tai jopa lähettäjien luona. Usein tilaa on vähän, koska kuorma-autoja on paljon, joten pysäköinti on vaikeampaa."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Perävaunun kääntäminen"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Vinoparkkeeraus saattaa vaikuttaa helpolta, mutta se saattaa usein olla haasteellisempi kuin perinteinen 'kujapysäköinti'."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Peruuta kohti pysäköintipaikkaa. Pidä vetoauto ja perävaunu suorassa toistaiseksi."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Kun pääset lähemmäs, anna perävaunun kulkea lähemmäs pysäköityjä kuorma-autoja. Tämä helpottaa sen kääntämistä pysäköintipaikkaan, kun pääset sinne asti."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Aloita perävaunun kääntäminen pysäköintipaikkaan. Pidä perävaunu lähellä kuljettajan puolella olevaa kuorma-autoa, sillä tarvitset kaiken tilan toiselta puolelta."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Kun perävaunu on riittävän pitkällä, aloita vetoauton kääntäminen perävaunun suuntaisesti."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Pysäköi kohdealueelle, varmista kuorma-auto ja sammuta moottori."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Pysäköi kuorma-auto takanasin olevaan tilaan. Käytä molempia peilejäsi avuksesi peruuttaessasi.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Tarkista ympäristösi ja jatka sitten kohti pysäköintipaikkaa.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Aloita perävaunun ohjaaminen lähemmäs vieressäsi olevia kuorma-autoja. Kun olet valmis, käännä perävaunu pysäköintipaikkaan. Muista huomioda perävaunun perän heilahdus.<br><br><font face=/font/big_bold.font>Käännä pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Peruuttaminen kaarteeseen"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Tässä tehtävässä peruutamme perävaunun kanssa käännökseen ensimmäistä kertaa. Tutkimme peruuttamisen perusperiaatteita ja mitä tulee huomioida käännökseen peruutettaessa."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Perävaunun kääntäminen"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa pysäköintipaikkaan joka on takanasi kuljettajan puolella."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "On muutamia muistettavia vinkkejä, jotka helpottavat peruuttamista perävaunun kanssa. <br>Ensimmäinen on se, että perävaunu kääntyy aina vastakkaiseen suuntaan mihin käännät vetoautoa."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Toinen on se, että saat hyvän käsityksen mihin perävaunu on menossa tarkkailemalla vetoauton ja perävaunun akseleita."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Kolmanneksi, pääset pienillä ohjausliikkeille sinne minne tahdot, ei ole tarpeen liioitella."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Ala kääntää vetoautoa hieman poispäin pysäköintipaikasta, jolloin perävaunu alkaa kääntyä sitä kohti."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Seuraa perävaunua tehden korjauksia pitääksesi yhdistelmän oikealla reitillä."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Tarkkaile perävaunun pyöriä ja vetoauton takapyöriä. Näistä näet mihin suuntaan perävaunu osoittaa ja mihin suuntaan vetoauto sitä työntää."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Neljäs vinkki on se, että on aina helpompaa kääntää perävaunua terävämmin kuin yrittää suoristaa sitä linkusta. Tähtää paikan ulkoreunaan ja kun pääset lähemmäs, voit alkaa kääntää hieman jyrkemmin kohdistaaksesi perävaunun."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Ohjaa vetoauto perävaunun eteen, kun perävaunu osuu pysäköintipaikkaan. Vältä liiallisia säätöliikkeitä kun olet paikassa."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Peruuta esteiden väliin tarkkaillen samalla molempia puolia."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Varmista kuorma-auto ja sammuta moottori."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Muista nämä vinkit peruuttaessasi perävaunulla käännökseen:<br><br>— Perävaunu kääntyy vastakkaiseen suuntaan kuin vetoauto<br><br>— Katso perävaunun pyöristä mihin suuntaan se osoittaa<br><br>— Katso vetoauton takapyöriä nähdäksesi mihin suuntaan työnnät perävaunua<br><br>— Anna perävaunun tehdä työ, älä yliohjaa.<br><br>— On aina helpompi kääntää enemmän kuin yrittää suoristaa<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Katso taaksesi, jotta näet minne sinun tulee mennä. Tarkista aina ympäristösi ennen peruuttamista.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen kohti pysäköintipaikkaa. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Aloita perävaunun kääntäminen kohti pysäköintipaikkaa ja seuraa perässä.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Pysähdy kohdealueelle. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Peruuttaminen ahtaaseen paikkaan"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa perävaunu pysäköintipaikkaan vilkkaalla alueella."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Perävaunun kääntäminen"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Tämä on tyypillinen kuorma-autojen pysäköintialue. Rekkamiehet kohtaavat lähes päivittäin tämänkaltaisia tilanteita.<br>Täällä pysäköinti vaatii 'kujapysäköinti' liikkeen."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Tämä on samanlainen kuin edellinen tehtävä, mutta sinulla on vähemmän työskentelytilaa, joten sinun tulee suunnitella liikkeesi ja varoa osumasta mihinkään."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Koska tilaa on vähemmän, ajoituksesi on tärkeämpi. Käännä perävaunu oikealla hetkellä ja katso vetoauton ja perävaunun pyöristä mihin yhdistelmä menee. Huomioi perän heilahdus äläkä aja linkkuun - jatka perävaunun työntämistä."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Yritä pysytellä lähellä kuljettajan puolen kuorma-autoa. Tämä antaa perävaunullesi tilaa kääntyä eikä sinun tarvitse huolehtia niin paljon kuorma-autosta apukuskin puolella."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Kun perävaunusi on paikassa, ohjaa vetoauto sen eteen. Tämä on parempi tehdä hieman aikaisemmin kuin vaistosi saattaisivat sanoa. Voit aina korjata sitä samalla kun peruutat lopulliseen sijaintiin."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Suorista vetoauto ja perävaunu ja pysähdy kohdealueelle."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Varmista kuorma-auto ja sammuta moottori."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Nyt koetamme perävaunun kääntämistä paljon pienemmällä alueella 'kujapysäköinti' liikkeellä. <br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Tarkista ympäristösi ja etsi pysäköintipaikka takaasi. <br><br><font face=/font/big_bold.font>Aloita peruuttaminen kohti pysäköintipaikkaa. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Käännä perävaunu pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Loppukoe (Osa 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Loppukoe odottaa sinua. Siinä pääset näyttämään taitosi kaikissa aikaisemmissa tehtävissä oppimissasi taidoissa. Ajamme ympäri koko harjoituskeskusta ja näemme miten hyvin selviät aikaisemmin kohtaamistasi tilanteista.<br><br>Kun olet suorittanut kaikki osuudet ja tilanteet, olet askeleen lähempänä voivasi kutsua itseäsi taitavaksi rekkakuskiksi!"

#### 3_19 goal


	key[]: "aca_goal_book1_3_19_coupling"
	val[]: "Perävaunun kytkeminen"

	key[]: "aca_goal_book1_3_19_park_br_on"
	val[]: "Käsijarrun käyttäminen"

	key[]: "aca_goal_book1_3_19_connect"
	val[]: "Perävaunun kytkeminen"

	key[]: "aca_goal_book1_3_19_park_br_off"
	val[]: "Käsijarrun vapauttaminen"

	key[]: "aca_goal_book1_3_19_b_trailer"
