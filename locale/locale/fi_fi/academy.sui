#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kameran hallinta"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Tässä tehtävässä käymme läpi käytössäsi olevat kuvakulmat sekä miten voit hyödyntää niitä kuorma-autoa ajaessasi."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Istuma-asento"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Näkymä taakse"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Peilien tarkistaminen"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Ulkokameraan vaihtaminen"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Katsele kuorma-auton ympärille"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Tässä tehtävässä käymme läpi erilaiset<br>käytössä olevat kamerat."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Sinulla on valittavanasi yhteensä seitsemän kuvakulmaa. Käymme nyt<br> läpi niistä muutamia ja selitämme niiden tarkoituksen."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Useat kamerat ja niiden eri kuvakulmat auttavat sinua ajamaan ahtaissa paikoissa."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Katsominen sinne minne olet menossa, on turvallisen ja ammattimaisen ajamisen kulmakivi. Jos nykyinen istuimen asento ei sovi sinulle, voit muuttaa sitä valitsemalla '@@adjust_link_t@@' (Pääset sinne pysäytysvalikosta).<br><br><font face=/font/big_bold.font>Kun olet valmis, paina @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Peruutettaessa et välttämättä aina näe peileistäsi riittävästi. Joskus voi olla tarpeen katsoa ikkunasta taaksesi nähdäksesi paremmin.<br><br><font face=/font/big_bold.font>Käännä kamera kuskin puolelle niin pitkälle kuin voit, katsoaksesi taaksesi ikkunasta kohti perävaunun takaosaa.</font>@@aca_goal_tip@@ Sinun tulee olla ajoneuvon sisällä."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Käytä tätä kuvakulmaa nähdäksesi perävaunusi peruuttaessa. On aina helpompi peruuttaa kuljettajan puolelle, koska silloin voit hyödyntää tätä näkymää. Apukuskin puolelle peruutettaessa näkymäsi tapahtumiin takanasi on paljon rajoitetumpi.<br><br><font face=/font/big_bold.font>Katso apukuskin puolelle. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Tästä syystä ei yleensä ole suositeltavaa peruuttaa apukuskin puolelle; huomaat että näkyvyys on melko rajallinen. Onneksi käytettävissäsi on seitsemän ulkokameraa. <br><br>Voit siirtyä seuraavaan kameraan painamalla @@imv_nrm_camcycle@@. Kun olet käynyt kaikki seitsemän läpi, palaat ensimmäiseen kameraan. <br><br><font face=/font/big_bold.font>Paina @@imv_nrm_camcycle@@ vaihtaaksesi seuraavaan kameraan. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Ulkokamera tarjoaa parhaan näkymän siihen mitä tapahtuu kuorma-auton ympärillä.<br><br><font face=/font/big_bold.font>Katsele kuorma-auton ympärille.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Voit vaihtaa seuraavaan kameraan painamalla uudestaan @@imv_nrm_camcycle@@. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Yläkuvakulma tarjoaa erinomaisen näkyvyyden kuorma-auton ympäristöön, selkeyttäen merkittävästi pysäköintiä ja ajamista ahtaissa paikoissa.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_camcycle@@ vaihtaaksesi seuraavaan kameraan.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Kattokamera tarjoaa hyvän näkymän pitkälle eteenpäin ilman suuria esteitä.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_camcycle@@ vaihtaaksesi viimeiseen kameraan, jota katsomme tällä kertaa.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Näkymä taakse on oikotie näkymään, jonka aikaisemmin näit kääntämällä sisäkameraa. Kuten kerroimme, se on hyödyllinen peruuttaessa ja pysäköidessä.<br><br>Pelissä on enemmän kameroita, joita voit vaihtaa painamalla toistuvasti @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_cam1@@ palataksesi hyttiin.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Ensimmäinen ajo"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Tässä tehtävässä opimme valmistelemaan kuorma-auton ajoon ja ajamme eteenpäin ensimmäistä kertaa."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Virtojen kytkeminen päälle"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Moottorin käynnistäminen"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Ympäristön tarkistaminen"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Käyttöjarrun käyttäminen"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Vaihteen kytkeminen"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Käsijarrun vapauttaminen"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Eteenpäin ajaminen"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Pysähtyminen"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Käsijarrun käyttäminen"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Vaihtaminen vapaalle"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Moottorin sammuttaminen"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Muutamissa ensimmäisissä ajotilanteissa käytämme ainoastaan vetoautoa.<br>Kuorma-autoa kutsutaan vetoautoksi silloin, kun siinä ei itsessään ole kuormatilaa, vaan se käyttää perävaunua tavaroiden ja materiaalin kuljetukseen."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Vetoautot ovat yleisiä joustavuutensa takia: Ne voivat jättää tyhjän perävaunun ja ottaa tilalle lastatun ilman odotusta tai tarvetta vaihtaa täysin toisenlaiseen perävaunuun."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Ensimmäisellä ajokerralla tehtäväsi on ajaa eteenpäin ja pysähtyä katkoviivan jälkeen.<br>Käynnistä moottori, seuraa ohjeita valmistellaksesi kuorma-auton ajoa varten. Kun olet valmis, aja suoraan eteenpäin."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Aja katkoviivan yli, pysähdy, sammuta moottori ja varmista kuorma-auto."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Koulutuksesi seuraavassa vaiheessa siirrät kuorma-autoa ensimmäistä kertaa.<br><br>Se ei tietenkään onnistu jos moottori ei ole käynnissä, joten ensimmäiseksi sinun tulee kytkeä virrat.<br><br><font face=/font/big_bold.font>Paina $input engineelect$ kytkeäksesi virrat.</font>@@aca_goal_tip@@ Uratilassa virrat ja moottori käynnityvät oletuksena samaan aikaan. Voit muuttaa tätä toiminnallisuutta Asetukset - 'Peliasetukset' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Virtakytkin kytkee kuorma-auton sähköt. Saatoit huomata varoitusvaloja kojetaulussa - tämä on tavallista. Jos varoitusvalot palavat edelleen kun moottori on käynnistetty, on se todennäköisesti merkki kuorma-auton ongelmasta. Poikkeus on käsijarrun merkkivalo, joka sammuu kun käsijarru vapautetaan.<br><br>Onneksi tämä kuorma-auto on hyvässä kunnossa ja olemme valmiita jatkamaan.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_engine@@ käynnistääksesi moottorin. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Nyt kun moottori on käynnissä, on tärkeää tarkistaa ympäristö ennen liikkeellelähtöä.<br><br><font face=/font/big_bold.font>Tarkista ympäristö sekä kuljettajan ja apukuskin puolen peilit varmistuaksesi, että kuorma-auton ympäristö on vapaa.</font>@@aca_goal_tip@@ Sinun tulee olla ajoneuvon sisällä."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Saattaa kuulostaa itsestäänselvältä, mutta ennen liikkeellelähtöä sinun tulee tietää kuinka pysähtyä.<br><br><font face=/font/big_bold.font>Käytä käyttöjarrua painamalla $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Seuraavaksi opit, miten muutat ajosuuntaa.<br><br>Yksinkertaistetulla automaattivaihteistolla sinun ei tarvitse vaihtaa vaihteita, vaan kaikki tapahtuu automaattisesti puolestasi.<font face=/font/big_bold.font><br><br>Paina $input forward$ kytkeäksesi ajovaihteen. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Seuraavaksi opit vaihtamaan ajosuuntaa.<br><br>Todellisella automaattivaihteistolla voit vaihtaa ajovaihteen, vapaan ja peruutusvaihteen välillä, kuten oikealla automaattivaihteistolla.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_gearup@@ kytkeäksesi ajovaihteen. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Seuraavaksi opit vaihtamaan ajosuuntaa.<br><br>Sekventiaalivaihteisto sallii vaihteen valinnan, aivan kuten oikea sekventiaalivaihteisto.<br><br>Samaan tapaan kun kytket ajovaihteen, sinun tulee vaihtaa kiihdyttäessä isommalle vaihteelle.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_gearup@@ kytkeäksi ykkösvaihteen.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Seuraavaksi opit vaihtamaan kulkusuuntaa.<br><br>Vaihdekepin ja kytkimen kanssa vaihtaminen on samanlaista kuin oikealla manuaalivaihteistolla.<br><br>Paina kytkin ja käyttöjarru täysin pohjaan. <font face=/font/big_bold.font>Vaihda vaihdekepillä vaihde ykköselle. <color value=@@clr_txt@@>Pidä kytkin ja käyttöjarru täysin painettuna.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Lähteäksesi liikkeelle tulee sinun ensin vapauttaa käsijarru.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_parkingbrake@@ vapauttaaksesi käsijarrun.</font> @@aca_goal_tip@@ Uratilassa käsijarru ei ole oletuksena aluksi kytkettynä. Voit muuttaa tätä toimintoa Asetuksista - 'Peliasetukset' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Nyt kuorma-auto on valmiina liikkeellelähtöön. Lähde liikkeelle ja ohita katkoviiva.<br><br><font face=/font/big_bold.font>Pääset liikkeelle painamalla kaasua: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Nyt kuorma-auto on valmiina liikkeellelähtöön. Lähde liikkeelle ja ohita katkoviiva.<br><br><font face=/font/big_bold.font>Pääset liikkeelle painamalla kaasua: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Nyt kuorma-auto on valmiina liikkeellelähtöön. Lähde liikkeelle ja ohita katkoviiva.<br><br><font face=/font/big_bold.font>Pääset liikkeelle painamalla kaasua: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Nyt kuorma-auto on valmiina liikkeellelähtöön. Lähde liikkeelle ja ohita katkoviiva.<br><br><font face=/font/big_bold.font>Vapauta jarrupoljin ja nosta kytkin hitaasti pitäen samalla kierroksia yllä kaasupolkimella, jottei kuorma-auto sakkaa. Kun kytkin on kokonaan ylhäällä, voit kiihdyttää ja vaihtaa vaihteita tarvittaessa.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Pysäytä kuorma-auto käyttöjarrulla.<br><br><font face=/font/big_bold.font>Paina $input backward$ pysähtyäksesi. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Pysäytä kuorma-auto käyttöjarrulla.<br><br><font face=/font/big_bold.font>Paina $input backward$ pysähtyäksesi. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Pysäytä kuorma-auto käyttöjarrulla.<br><br><font face=/font/big_bold.font>Paina $input backward$ pysähtyäksesi. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Kun haluat pysähtyä, paina kytkin kokonaan pohjaan<font face=/font/big_bold.font>ja pysäytä sen jälkeen kuorma-auto käyttöjarrulla.<color value=@@clr_txt@@> Vaihda vaihde vapaalle vaihdevivusta jonka jälkeen voit nostaa kytkimen. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Seuraavaksi varmista kuorma-auto. Käsijarrulla varmistat, että kuorma-auto ei vahingossa liiku pysäköinnin jälkeen.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_parkingbrake@@ kytkeäksesi käsijarrun.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Yksinkertaistetulla automaattivaihteistolla sinun ei tarvitse vaihtaa vaihteita, vaan kaikki tapahtuu automaattisesti.<br><br><font face=/font/big_bold.font>Paina @@imv_nrm_activate@@ jatkaaksesi. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Vaihda vapaalle painamalla @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Vaihda vapaalle painamalla @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Vaihda vaihdevipu vapaalle ja nosta sen jälkeen kytkin. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Saat nyt kuorma-auton liikkeelle ja tiedät miten se pysäytetään turvallisesti.<br><br><font face=/font/big_bold.font>Paina $input engineelect$ sammuttaaksesi moottorin. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Peruuttaminen"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Tässä tehtävässä kokeilemme peruuttaa ensimmäistä kertaa. Opimme myös miten hyödynnät peilejäsi nähdäksesi taaksesi, mitä huomioida ja miten valmistautua peruuttamaan."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Moottorin käynnistäminen"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Apukuskin puolen peilien tarkistaminen"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Kuljettajan puolen peilien tarkistaminen"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Vaihteen kytkeminen"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Käsijarrun vapauttaminen"

