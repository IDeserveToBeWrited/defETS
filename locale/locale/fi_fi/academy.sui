	key[]: "aca_scenario_book3_sup_desc"
	val[]: "Tässä tehtävässä sinun tulee pysäköidä tupla-yhdistelmä ahtaaseen paikkaan."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
