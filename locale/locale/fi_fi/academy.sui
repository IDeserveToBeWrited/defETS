#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Perävaunun kanssa jarruttaminen"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "Tässä tehtävässä saat tuntumaa ajamiseen ja jarruttamiseen perävaunun kanssa."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Liikkeelle lähteminen"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Alamäkiajo"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Tavoitenopeuden 60 km/h (37 mph) saavuttaminen"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Jarrujen käyttäminen"
