#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Tavanomaiset hallintalaitteet ja ajaminen"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Opettele kuorma-auton perustoiminnot sekä miten ajetaan eteen- ja taaksepäin."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 1: @@aca_chapter_book1_1_title@@.<br><br>Olet nyt oppinut kuinka kuorma-auto valmistellaan ajoa varten,<br>ajetaan eteen- ja taaksepäin, sekä miten valoja ja tuulilasinpyyhkijöitä käytetään.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Tavanomaiset ajotilanteet"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Opettele ajamaan, ohjaamaan ja pysäköimään vetoautoa. Tutki erityyppisten peilien tarkoitus ja kuinka niitä käytetään."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 2: @@aca_chapter_book1_2_title@@.<br><br>Olet nyt oppinut hyödyntämään kaikkia kuorma-auton peilejä, tarkistamaan kuorma-auton ympäristön ennen liikkeellelähtöä sekä ohjaamaan kuorma-autoa tavanomaisissa ja haasteellisimmissa tilanteissa.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Perävaunun kuljettaminen"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Opettele kytkemään perävaunu ja kuljettamaan sitä erilaisissa tilanteissa."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 3: @@aca_chapter_book1_3_title@@.<br><br>Olet oppinut kytkemään ja irroittamaan perävaunun,<br>tuntemaan perävaunuyhdistelmän painon ja mitat<br>ja ajamaan haastavia ratoja perävaunun kanssa.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Peruuttaminen perävaunun kanssa"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Opettele uusia tapoja peruuttaa ja pysäköidä sujuvasti perävaunun kanssa."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 4: @@aca_chapter_book1_4_title@@.<br><br>Olet oppinut erilaisia pysäköintitekniikoita<br>sekä peruuttamaan perävaunun kanssa.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Loppukoe"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Näytä tietämyksesi ja taitosi todistaaksesi arvosi rekkakuskina!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 5: @@aca_chapter_book1_5_title@@.<br><br>Olet osoittanut että hallitset kaikki tarvittavat<br>taidot kuorma-auton kuljettamiseen ja pysäköintiin!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Lämmitellään moottoria"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Olet suorittanut koulutuksen: @@aca_chapter_book2_0_title@@.<br><br>Olet oppinu kuorma-auton ajamiseen liittyvät säännöt ja toiminnot.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Vaihde silmään"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 2: @@aca_chapter_book2_1_title@@.<br><br>Olet lämmittänyt moottorin, vaihdellut vaihteita, ajanut ja testannut jarrujen toiminnan. Seuraavat kappaleet ovat haastavampia.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Pyörät pyörimään"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 3: @@aca_chapter_book2_2_title@@.<br><br>Olet onnistunut erilaisissa haastavissa tehtävissä. Olet antanut näytteen taidoistasi ja tehokkuudestasi.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Loppusuora"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 4: @@aca_chapter_book2_3_title@@.<br><br>Olet suoriutunut monista vaikeista tilanteista kuorma-auton käsittelyssä, pysäköinnissä ja peruuttamisessa perävaunun kanssa. Olet todistanut olevasi taitava kuljettaja, joka selviytyy kuorma-autolla kaikista haastavista ajotilanteista."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Mennään eteenpäin"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Opi kaikki tupla-yhdistelmän eteenpäin ajamisen olennaiset tekniikat."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 1: @@aca_chapter_book3_1_title@@.<br><br>Olet oppinut kuinka kuljetetaan tupla-yhdistelmiä tehokkaasti.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Peruuttamisen hallinta"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Ymmärrä tupla-yhdistelmän peruuttamiseen liittyvät olennaiset toimenpiteet."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 2: @@aca_chapter_book3_2_title@@.<br><br>Olet oppinut kunnioitusta herättävän taidon peruuttaa tupla-yhdistelmää.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Real World Preparation"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Käytä uusia taitojasi haastavammissa tehtävissä."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Onneksi olkoon!<br>Olet suorittanut kappaleen 3: @@aca_chapter_book3_3_title@@.<br><br>Olet käynyt läpi monia hankalia tilanteita tupla-yhdistelmän ajamisessa, pysäköinnissä ja peruuttamisessa. Olet näyttänyt taitosi täällä ja nyt on aika ryhtyä kuljettamaan tupla-yhdistelmiä Euro Truck Simulator 2:n teillä!</font><br><br>"


#@}

