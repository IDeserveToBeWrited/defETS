#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Tämä harjoittelurata antaa pienen maistiaisen tosielämän ajotilanteista turvallisessa ympäristössä. Käytä juuri oppimiasi taitoja ja muista huomioida ympäristösi ja hyödynnä kaikki käytettävissä oleva tila. <br><br>Myös ennakointi kannattaa!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Aja eteenpäin harjoitteluradalle."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Edessä on alamäkiosuus. Voit käyttää sitä saadaksesi tuntuman miten tupla-yhdistelmä käyttäytyy suuremmassa nopeudessa."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Valmistaudu jarruttamaan edessä olevaan käännökseen."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Ylitä keskikaista kääntymällä oikealle ja heti perään vasemmalle."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Aja jälleen keskikaistan yli."

	key[]: "aca_msg_book3_train_check5"
	val[]: "On tilanteita jolloin ainoa vaihtoehto on vetää koko yhdistelmä linkkuun. <br><br>Käytä kaikkia keinoja, jotta selviät tästä erittäin tiukasta käännöksestä."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Jatka radalla ajamista."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Pujottele huolellisesti ja varmista että perävaunut selvittävät jokaisen esteen, mutta muista myös asemoida itsesi niin, että selviät myös seuraavasta."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Jatka vasemmalle suoraan risteysten läpi."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Seuraa päällystettyä tietä oikealle."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Viimeinen käännös on harhaanjohtava; tilaa on paljon, mutta valmistaudu pysäköimään taimmaisen reunakiveyksen viereen."

#!{
	key[]: "aca_msg_book3_train_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_train_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ double_90
#@{

#### double_90 common

	key[]: "aca_scenario_book3_double_90_title"
	val[]: "90 asteen käännökset"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "Tässä tehtävässä sinun tulee ajaa vaihtelevista 90 asteen käännöksistä muodostettua rataa."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Liikkeelle lähteminen"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Eteenpäin ajaminen"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Käytä peilejäsi"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Ilmaista tilaa"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Valmistelu"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Suunnittele etukäteen"

#!{
	key[]: "aca_goal_book3_double_90_check5"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_double_90_stop"
