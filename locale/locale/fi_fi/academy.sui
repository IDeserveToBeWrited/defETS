	key[]: "aca_goal_book3_sup_forward"
	val[]: "Liikkeelle lähteminen"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Jatka ajamista"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Pysähtyminen"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Ajoneuvon varmistaminen"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Tupla-yhdistelmällä ajaminen saattaa vaikuttaa pelottavalta, mutta se on melkein sama, kuin ajaisi yhden perävaunun kanssa - sinun tulee vain lisäksi huomioida takimman perävaununkin ajolinja!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Edessäsi on kapea pysäköintipaikka. Tila ei riitä täysin suoristamaan ennen sitä, joten sinun tulee harkita tarkkaan miten mahdut molempien perävaunujen kanssa."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Käännä välittömästi kohti pysäköintipaikan takareunaa ja aja reilusti ohi kohdasta jossa normaalisti kääntyisit."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Nyt kun takimmainen perävaunusi on oikeilla urilla, voit ajaa kohti paikkaa; muista jälleen ajaa kohti takareunaa, jotta etummainen perävaunu seuraa perässä."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Jatka kohti pysäköintipaikkaa, jolloin molemmat perävaunut tulevat perässä ja oikenevat matkalla."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Pysäköi kohdealueelle ja varmista kuorma-auto."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Valmistaudu liikkeellelähtöön."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Jatka eteenpäin kapealle alueelle."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Jatka ajamista."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Pysähdy kohdealueelle."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Varmista kuorma-auto ja sammuta moottori."
