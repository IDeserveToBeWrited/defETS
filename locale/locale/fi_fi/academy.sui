#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Esteen viereen pysäköinti"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Tässä tehtävässä opettelemme pysäköimään reunakiveyksen viereen sivupeilejä käyttämällä."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Kylkipeilin tarkistaminen"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Reunakiveystä kohti ajaminen"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Kylkipeili on toinen työkalu, joka helpottaa kuorma-auton turvallista ohjaamista. Se on sijoitettu apukuskin oven yläkarmiin."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Aja eteenpäin ja käännä hitaasti kohti apukuskin puolta."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Nämä puulankut esittävät reunakiveystä. Sinun tulee pysäköidä niiden viereen. <br>Käännä kohti reunakiveystä saadaksesi kuorma-auton hyvään asemaan pysäköintipaikkaan nähden."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Pysähdy hyvissä ajoin ennen reunakiveystä ja käännä kohti pysäköintipaikkaa. Kun oikaiset, voit arvioida etäisyytesi reunakiveykseen kylkipeilistäsi."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Pysähdy pysäköintipaikkaan ja varmista kuorma-auto."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Katso ulos apukuskin ikkunasta. Näet siellä kylkipeilin.</font>@@aca_goal_tip@@ Sinun tulee olla ajoneuvon sisällä."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Kylkipeili näyttää alueen apukuskin puolelta, jonne kuljettaja ei suoraan näe. Se on yksi kuorma-auton ongelmallisimmista katvealueista. Jos peilin asento on väärä, voit säätää sitä valitsemalla '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Kuorma-auto ei vieläkään ole valmis lähtöön. Oletko kenties unohtanut jotain?<br><br>Onko moottori käynnissä? Oletko vapauttanut käsijarrun?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Edessäsi on lankkujono kuvaamassa reunakiveystä. Reunakiveyksen päässä on pysäköintipaikka. Sinun tulee ajaa sinne. <br><br><font face=/font/big_bold.font>Jatka kun olet valmis. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Käänny kohti reunakiveystä. Käytä etu- ja sivupeilejäsi tarkistaaksesi sijaintisi reunakiveykseen nähden, mutta varmista myös, ettet aja liikennekartioiden päältä.<br><br><font face=/font/big_bold.font>Aja kohti reunakiveystä ja siitä pysäköintipaikkaan.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Varmista kuorma-auto ja sammuta moottori.</font>@@aca_goal_tip@@ Voit käyttää sisätilan valmiita katselunäkymiä helpottaaksesi peileihin katsomista. Katso Asetuksista - '@@options_bindings_screen@@' määritelläksesi toiminnoille haluamasi näppäimet."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Esteen viereen pysäköinti peruuttamalla"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Tässä tehtävässä pysäköimme kuorma-auton reunakiveyksen viereen peruuttamalla."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Ohjeistus"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Reunakiveystä kohti peruuttaminen"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Kuorma-auton pysäköinti"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

