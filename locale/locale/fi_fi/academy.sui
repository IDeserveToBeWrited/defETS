#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Peruutteluleikkikenttä"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Tässä tehtävässä pääset tyhjälle pysäköintialueelle harjoittelemaan tupla-yhdistelmän peruuttamista."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Aloittaminen"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Kokeilu"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Viimeistely"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Tehtävän päättäminen"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Tupla-yhdistelmän peruuttaminen on vaativampaa kuin peruuttaminen yhdellä perävaunulla. Sinun tulee ennakoida minne haluat takimmaisen perävaunun menevän samalla kun huolehdit etummaisesta perävaunusta ja vetoautosta. <br><br>Voit ajatella sitä näin - sinun tulee käyttää etummaista perävaunua takimmaisen ohjaamiseen."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Tässä tapauksessa haluamme kääntää takimmaisen perävaunun kuljettajan puolelle. Jotta se kääntyy sinne, meidän tulee työntää takimmaisen perävaunun etupäätä apukuskin puolelle. <br><br>Huomaa, että käytännössä se tarkoittaa sitä, että sinun tulee kääntää etummaista perävaunua päinvastaiseen suuntaan."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Kun takimmainen perävaunu alkaa kääntyä, on olennaista suoristaa vetoauto samaan linjaan etummaisen perävaunun kanssa. Tässä useimmat kuljettajat tekevät ensimmäisen virheensä."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Tässä näemmä kuinka kuljettaja epäonnistui etummaisen perävaunun seuraamisessa ja tulee vetämään koko yhdistelmän linkkuun."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Linkkuun meneminen ilmenee, kun minkä tahansa kahden yhdistelmän osan välinen kulma suurenee noin 90 asteeseen. Kun näin tapahtuu, yhdistelmää ei voi enää oikaista - sinun pitää ajaa eteenpäin ja yrittää uudelleen. <br><br>Kuten yhdenkin perävaunun kanssa, tavoite on varmistaa aina, että perävaunun pyörät pyörivät. Kun pyörät pysähtyvät, perävaunu kääntyy paikallaan ja peli on pelattu."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Voit ajaa eteenpäin paikkaan, jossa tilanne oli vielä hallussa, tai oikeamin paikkaan, josta voit jatkaa peruuttamista ilman, että päädyt samaan virheeseen. <br><br>Tässä tapauksessa suoristamme yhdistelmän ja yritämme uudestaan alusta."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Jälleen kerran, kun takimmainen perävaunu alkaa kääntyä, käännä vetoauto etummaisen perävaunun eteen ja anna takimmaisen perävaunun kääntyä itsekseen hetken aikaa."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nyt kun takimmainen perävaunu on menossa haluttuun suuntaan, on aika kääntää etummainen perävaunu seuraamaan sitä. Voit säädellä etummaisen ja takimmaisen perävaunun välistä kulmaa ja muuttaa käännöksen tiukemmaksi tai loivemmaksi."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Toimenpiteen viimeinen vaihe on koko yhdistelmän suoristaminen. Käännä etummainen seuraamaan takimmaista."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Sinun kannattaa huomioida aika, jonka etummaisen perävaunun kääntäminen vaatii. Jos odotat liian kauan, takimmainen perävaunu alkaa pyrkiä takaisin siihen suuntaan josta tulit!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Käytä täällä niin paljon aikaa kuin haluat. Kokeile erilaisia liikkeitä kunnes sinulla on karkea ajatus siitä, kuinka perävaunuja hallitaan peruutettaessa. <br><br>Mutta muista ennen kaikkea pitää hauskaa!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Valmistaudu liikkeellelähtöön."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Käytä tätä pysäköintialuetta saadaksesi tuntuman perävaunujen käsittelyyn peruutettaessa. <br><br>@@aca_goal_tip@@ Onko ylipäänsä perävaunujen kanssa peruuttaminen uutta? Harkitse Kuorma-auton ajamisen perusteet -kurssia."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Harjoittele niin kauan kuin haluat. <br><br>Kun olet tyytyväinen, voit pysähtyä ja varmistaa kuorma-auton päättääksesi tehtävän."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Sammuta moottori päättääksesi tehtävän."
#@}


