#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Monimutkaisista käännöksistä ajaminen"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Tässä tehtävässä ajamme perävaunun kanssa lyhyellä, mutta hankalampia käännöksiä sisältävällä radalla."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Ensimmäiset käännökset"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Kapean väylän läpi ajaminen"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Tiukka 90 asteen käännös"
