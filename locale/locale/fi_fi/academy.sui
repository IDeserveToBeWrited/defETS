	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Ajaminen käsittelyradalla"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Tässä tehtävässä ajamme radalla, joka on suunniteltu koettelemaan kykyjäsi ohjata kuorma-autoa erilaisissa mutkissa ja käännöksissä."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Radalle saapuminen"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Loivan kaarteen ajaminen vasemmalle"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Ajaminen S-mutkien läpi"

	key[]: "aca_goal_book1_2_08_check3"
