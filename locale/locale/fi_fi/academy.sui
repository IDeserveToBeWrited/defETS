#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Tämän kappaleen viimeisessä tehtävässä ajamme testiradalla hankalissa tilanteissa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Ensimmäinen haaste on pujottelu esteiden ympäri. Suorita se ja muista käyttää peilejäsi."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Seuraavaksi tulee neulansilmä. Selviät siitä ongelmitta pitämällä ajolinjasi leveänä."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Tässä on 90 asteen käännös. Muista ajaa pitkälle, jotta kuorma-auton takaosa ohittaa sisäkaarteen esteet."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Ramppi-haaste voi olla hieman kinkkinen. Kohdista itsesi parhaasi mukaan ennen rampille ajamista ja käytä etu- ja sivupeilejäsi avuksesi ajaessasi."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Seuraava osuus pitää suorittaa peruuttamalla. Pidä se mielessä lähestyessäsi edessä olevia esteitä."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Seuraa tiemerkintöjä oikealle taaksesi."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Peruuta esteiden luo, pysähdy ja jatka sitten eteenpäin vasemmalle."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Jatka piennaralueen aukon läpi seuraavalle osuudelle."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Väylä kartioiden välissä on erittäin kapea. Aja hitaasti ja käytä peilejäsi pitääksesi kuorma-autosi väylällä."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Muista ajaa pitkälle 90 asteen käännöksissä."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Tulet tien leppoisalle avoimelle alueelle. Voit kiihdyttää hieman, mutta muista, että sinun tulee pian hidastaa edessä olevaa seuraavaa kaarretta varten."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Mäen alapäässä on esteitä tiellä. Aja niiden luo ja peruuta sitten pysäköintipaikkaan vasemmalla."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Peruuta pysäköintipaikkaan."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Pysäköi, sammuta sitten moottori ja varmista kuorma-auto."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Edessäsi on esteistä tehty pujottelurata.<br><br><font face=/font/big_bold.font>Aja pujotteluradan läpi.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Pysyttele käännöksen ulkoreunassa varmistuaksesi, ettei vetoauton perä osu reunakiveykseen.<br><br><font face=/font/big_bold.font>Suorita käännös. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Saavut 90 asteen käännöksen vasemmalle. Muista käyttää kaikki käytössäsi oleva tila.<br><br><font face=/font/big_bold.font>Suorita käännös. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Kohdista itsesi rampille. Sinulla ei ole paljoa tilaa tehdä korjauksia kun olet rampilla.<br><br><font face=/font/big_bold.font>Aja rampin yli. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Seuraa rataa vasemmalle. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Seuraava osuus tulee suorittaa peruuttamalla. Pysähdy edessä olevien esteiden kohdalla niin, että voit sen jälkeen peruuttaa oikealle.<br><br><font face=/font/big_bold.font>Pysähdy esteille.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Peruuta kohti takanasi oikealla olevaa aluetta. Voit käyttää tiessä olevia nuolia avuksesi.<br><br><font face=/font/big_bold.font>Peruuta kohti seuraavaa osuutta. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Jatka peruuttamista kohti takanasi olevia esteitä.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Pysähdy, vaihda ajovaihteelle ja jatka sitten vasemmalle. <br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Piennaralueessa vasemmalla on aukko. Aja siitä.<br><br><font face=/font/big_bold.font>Jatka eteenpäin. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Edessäsi on kapea mutkainen reitti kartioiden välistä. Aja varovasti ja käytä tarvittaessa peilejäsi.<br><br><font face=/font/big_bold.font>Aja kartioiden läpi. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Jatka radan läpi.<br><br><font face=/font/big_bold.font>Käänny vasemmalle. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Muista pysytellä vasemmalla ennen käännöstä, jotta saat mahdollisimman paljon tilaa.<br><br><font face=/font/big_bold.font>Suorita käännös. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Voit hieman kiihdyttää tässä, mutta mutka on tulossa edessäsi.<br><br><font face=/font/big_bold.font>Jatka rataa eteenpäin. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Kaarre tiukkenee ajaessasi eteenpäin.<br><br><font face=/font/big_bold.font>Säädä nopeuttasi sen mukaan ja jatka eteenpäin.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Mäen alla on esteitä tien poikki. <br><br><font face=/font/big_bold.font>Pysähdy esteiden lähelle. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Takanasi vasemmalla on pysäköintipaikka.<br><br><font face=/font/big_bold.font>Peruuta pysäköintipaikkaan. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Pysähdy merkittyyn paikkaan. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

