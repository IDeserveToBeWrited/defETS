#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Tässä tehtävässä viemme vetoauton pienelle ajelulle, jotta näemme miten laitat juuri oppimasi taidot käytäntöön."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Radalla on erilaisia käännöksiä ja niiden yhdistelmiä. Kyseessä ei ole kilpailu eikä ajalla ole merkitystä. Ole kärsivällinen ja valitse tilannenopeutesi kohtaamiesi käännösten ja esteiden mukaan."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Radan alku on mukava ja helppo, mutta käännökset muuttuvat pikku hiljaa vaikeammiksi."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Tarkkaile nopeuttasi; on helppoa ajaa liian kovaa ja arvioida siten käännös väärin."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Radalta poistuttaessa on tiukka neulansilmä. Aja hitaasti ja hyödynnä kaikki käytettävissä oleva tila."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Pysäköi esteiden väliin ja varmista kuorma-auto."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Onnistuaksesi tässä tehtävässä, et saa kolaroida, ajaa ulos radalta tai osua yhteenkään liikennekartioon.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Jatka kohti tiukkaa oikeaa mutkaa ajaaksesi radalle. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Aja kaarteen läpi mukavan tasaisella nopeudella. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Lähestyt hankalampaa mutkaista osuutta.<br><br><font face=/font/big_bold.font>Säädä nopeutesi tilanteeseen sopivaksi ja jatka matkaa.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Jatka kohti seuraavaa kaarteiden sarjaa.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Seuraavaksi tulee joitain helppoja ja mukavia käännöksiä. Pidä nopeutesi vakaana.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Radalta poistuttaessa on tiukka neulansilmä. Hidasta ja pysyttele ajoradan ulkoreunassa ennen käännöstä. Muista käyttää peilejäsi!<br><br><font face=/font/big_bold.font>Käänny pois radalta. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Edessäsi esteiden välissä on pysäköintipaikka.<br><br><font face=/font/big_bold.font>Jatka kohti pysäköintipaikkaa. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

