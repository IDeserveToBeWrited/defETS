#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "Tässä tehtävässä kiinnitämme ja irroitamme perävaunun ensimmäistä kertaa. Valmistele kuorma-auto ajoon ja peruuta sen jälkeen takanasi olevan perävaunun alle."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Kiinnitä perävaunu ja aja eteenpäin."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Pysähdy merkitylle alueelle."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Irroita perävaunu ja aja eteenpäin."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Pysähdy pysäköintipaikkaan ja varmista kuorma-auto."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "Tässä tehtävässä käsittelemme vetoauton ja perävaunun kytkentään ja irroittamiseen liittyviä toimenpiteitä. Tämä on yksinkertaistettu malli siitä, mitä kuorma-auton kuljettajat todellisuudessa tekevät. <br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Vetoauton takana on perävaunu. Peruuta hitaasti perävaunun alle kunnes vetopöytä osuu vetotappiin. Kuorma-auto on valmiiksi linjassa, joten sinun ei tarvitse kääntää, ainoastaan peruuttaa.<br><br><font face=/font/big_bold.font>Peruuta hitaasti kunnes tunnet kytkennän. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Vetotappi on liitetty vetopöytään.<br><br><font face=/font/big_bold.font>Varmista kuorma-auto kytkemällä käsijarru. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Oikeassa elämässä vetopöytä lukitsee automaattisesti vetotapin. Kuljettajan tulee sen jälkeen poistua ajoneuvosta nostamaan tukijalat ja kytkemään paineilmaletkut ja sähköjohdot. <br><br><font face=/font/big_bold.font>Meille riittää, että painat @@imv_nrm_attach@@ yhdistääksesi perävaunun. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Nyt kun vetoauto on turvallisesti kytketty perävaunuun, olet valmis lähtemään liikkeelle. Muista, että ajoneuvosi on nyt huomattavasti pidempi ja raskaampi ja sen ohjaaminen vaatii uusien taitojen oppimista. <br><br><font face=/font/big_bold.font>Vapauta käsijarru ja valmistaudu ajamaan eteenpäin. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Aja eteenpäin.<br><br><font face=/font/big_bold.font>Pysähdy edessä olevalla merkitylle alueelle. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Kytke käsijarru. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Kytke käsijarru. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Jälleen kerran, oikeassa elämässä kuljettajan tulisi poistua ajoneuvosta, laskea tukijalat ja irroittaa paineilmaletkut ja sähköjohdot sekä vapauttaa vetopöydän lukitus. <br><br><font face=/font/big_bold.font>Olemme yksinkertaistaneet prosessin niin, että @@imv_nrm_attach@@ irroittaa perävaunun. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Vapauta käsijarru. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Aja vetoauto pois perävaunun alta ja aja eteenpäin.<br><br><font face=/font/big_bold.font>Pysähdy merkitylle alueelle. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Pysähdy merkitylle alueelle. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
