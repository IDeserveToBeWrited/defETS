#!}
#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Edessä olevalla radalla pääset tutustumaan tupla-yhdistelmällä kääntymiseen vaihtelevissa 90 asteen käännöksissä."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Muutamat ensimmäiset käännökset ovat melko leveitä. Tutustu näissä perävaunujen käyttäytymiseen käännyttäessä."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Tästä eteenpäin käännökset muuttuvat tiukemmiksi ja teknisemmiksi. Lähesty hitaasti ja varmista, että ajat riittävän pitkälle käännökseen, jotta perävaunuilla on tilaa kääntyä."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Tämä on yksi radan tiukimmista käännöksistä. Kannattaa hyödyntää oikealla puolella oleva pieni tila, jotta perävaunusi kiertävät sisäkaarteen kiusalliset kartiot."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Seuraava käännös pitäisi aina olla takaraivossasi - poistuessasi edellisestä käännöksestä, suunnittele miten valmistaudut seuraavaan."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Tarkkaile aina perävaunujasi kunnes ne ovat ohittaneet mahdolliset esteet."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Jatka eteenpäin kohti ensimmäistä käännöstä."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Tarkkaile peilejäsi ajaessasi, jotta ymmärrät miten perävaunusi käyttäytyvät."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "On äärimmäisen tärkeää ottaa leveä ajolinja ennen jokaista käännöstä, jotta perävaunuille jää riittävästi tilaa kääntyä."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Seuraavissa muutamissa käännöksissä valmistelu on tärkeää, sillä käännöstä seuraa erittäin tiukka mutka. Virhe alussa saattaa kostautua myöhemmin. <br><br>Aja hitaasti ja huolellisesti, sekä tarkkaile ympäristöäsi."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Tämä käännös on erittäin tiukka ja johtaa suoraan toiseen tiukkaan käännökseen. Käännökseen ajamisen lisäksi sinun tulee suunnitella myös poistuminen ja seuraavaan käännökseen valmistautuminen."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Jatka ajamista viimeisten käännösten läpi kohti kohdealuetta."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Ensimmäinen peruutus"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "Tässä tehtävässä peruutamme ensimmäistä kertaa tupla-yhdistelmää."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Rentoudu, älä huoli"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Tupla-yhdistelmän peruuttaminen vaatii täysin uudenlaisen ajatusmaailman. Sen sijaan, että kääntäisit vain perävaunua, käytät nyt etummaista perävaunua takimmaisen ohjaamiseen. <br><br>Harjoittele tässä tehtävässä miten kaikki tämä toimii. Tässä ei ole tiettyä tavoitetta, voit käyttää aikaa ja yrittää hahmottaa mitä tapahtuu."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Suorasta yhdistelmästä voit kääntää vetoautoa samaan suuntaan, jonne haluat takimmaisen perävaunun menevän. <br><br>Älä liioittele; sinun tulee ainoastaan saada takimmainen perävaunu menemään kohti haluttua suuntaa. Sen jälkeen voit kääntää vetoauton etummaisen perävaunun suuntaisesti ja antaa takimmaisen perävaunun tehdä työtään."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Kun takimmainen perävaunu menee oikeaan suuntaan, voit kääntää etummaisen perävaunun samaan suuntaan. <br><br>Kun etummainen seuraa takimmaista, käytä vetoautoa perävaunujen välisen kulman säätämiseen, jotta voit tehdä käännöksestä tiukemman tai loivemman."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Tähän ei ole mitään tiettyä kaavaa, sinun pitää vaan olla tarkkaavainen, oppia virheistäsi ja jatkaa harjoittelua. <br><br>Kun olet tyytyväinen, voit suunnata merkitylle alueelle ja varmistaa ajoneuvon. <br><br>Käytä täällä kokeiluun aikaa niin paljon kuin tarvitset."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Lähde peruuttamaan hitaasti. Aloita pienillä ohjausliikkeillä jottet vedä yhdistelmää linkkuun heti kättelyssä.<br><br>Koeta peruuttaa suoraan taaksepäin tai peruuta perävaunut kuljettajan puolelle."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Käytä aikaa äläkä turhaudu. <br><br>Jokainen mestari oli joskus oppipoika."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Ensimmäinen peruutuksen korjaus"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "Tässä tehtävässä meidän tulee jatkaa siitä, mihin toinen kuljettaja on lopettanut."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Peruuttaminen"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "O-ou! Toinen kuljettaja hieman turhautui peruuttaessaan ja jätti rekkansa keskelle pysäköintialuetta."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Kohtaat väistämättä tilanteita, joissa olet todella pahassa pinteessä. Älä huoli, aja vain eteenpäin oikaistaksesi, kunnes olet tilanteessa josta pääset jatkamaan. <br><br>Jos olet epävarma, oikaise yhdistelmä, jotta voit aloittaa puhtaalta pöydältä."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Tämä on kohtuullinen asetelma aloittaa. Takimmainen perävaunu osoittaa edelleen haluttuun suuntaan ja saamme vetoauton nopeasti etummaisen perävaunun eteen ja voimme alkaa ohjata koko yhdistelmää haluttuun suuntaan."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Jatka kohdealueelle ja varmista kuorma-auto. <br><br>Jälleen kerran, voit harjoitella tätä tehtävää kunnes perävaunujen kanssa ajaminen tuntuu luontevalta."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Tästä sotkusta ei voi selvitä. Aja eteenpäin, jotta tilanne korjaantuu."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Aloita peruuttaminen."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Suoraan peruuttaminen"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa tupla-yhdistelmää suoraan taaksepäin."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Peruuttaminen"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Suoraan peruuttaminen saattaa vaikuttaa ensisilmäyksellä helpommalta, mutta se on todellisuudessa paljon haastavampaa. <br><br>Sen sijaan, että pienennät tai suurennat perävaunujen välistä kulmaa toisella puolella, sinun tulee nyt tehdä sama molemmilla puolilla, jotta saat pidettyä yhdistelmän suorassa."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Aloita melko pienillä ohjausliikkeillä. Saatat aluksi kiemurrella puolelta toiselle, mutta muista, että sinun tulee pitää vetoauton ja ensimmäisen perävaunun välinen kulma hieman suurempana muuttaaksesi ensimmäisen ja viimeisen perävaunun välistä kulmaa."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Voit joutua tekemään melko suuria ohjausliikkeitä vetoautolla, jotta takimmainen perävaunu pysyy halutussa linjassa. Yritä kuitenkin olla tekemättä liian rajuja liikkeitä alusta alkaen, niin selviät vähemmällä."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Korjataksesi asemaasi, voit ajaa eteenpäin niin usein kuin tarvitsee. Muu on toisarvoista, kunhan pääset pysäköintipaikkaan turvallisesti."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Aloita peruuttamalla hitaasti."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Suorista ja pysähdy kohdealueelle."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Varmista kuorma-auto ja sammuta moottori."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Suoraan peruuttamisen korjaus"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "Tässä tehtävässä jatkat siitä, kun toinen kuljettaja on jo yrittänyt suoraan peruuttamista. Korjaa hänen virheensä ja pysäköi kuorma-auto merkittyyn paikkaan."

#### correcting_straight_backing goal

