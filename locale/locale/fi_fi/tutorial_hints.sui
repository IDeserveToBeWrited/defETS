    key[]: "hint_sm_throttle_text"
    val[]: "Voit kytkeä päälle älykkään kaasunhallinnan @@desktop_menu_category_options@@-valikosta. Kytkemällä sen päälle, ajoneuvo rajoittaa kierroksia oletuksena. Kun kaasua painetaan nopeasti kahdesti, ajoneuvo pitää kaasun pohjassa, kunnes näppäin vapautetaan."

    key[]: "hint_bus_job_title"
	val[]: "Ensimmäinen bussityö"

    key[]: "hint_bus_job_text"
    val[]: "Kuljeta matkustajia heidän määränpäähänsä - aja aikataulun mukaan ja tarjoa mukava, tasainen ja turvallinen kyyti pitääksesi heidät tyytyväisenä.<br><br>Tarkkaile G-voimamittaria nähdäksesi miten tasaisesti ajat."


    key[]: "hint_satis_dec_title"
	val[]: "Matkustajien tyytyväisyyden hallinta"

    key[]: "hint_satis_dec_text"
    val[]: "Voit parantaa matkustajien tyytyväisyyttä tarjoamalla yhtäjaksoisesti tasaisen kyydin ilman vahinkoja ja liikennerikkomuksia.<br><br>Tarkkaile G-voimamittaria nähdäksesi miten tasaisesti ajat."


    key[]: "hint_low_satis_title"
	val[]: "Matkustajien tyytyväisyyden lisääminen"

    key[]: "hint_low_satis_text"
    val[]: "Matkustajat ovat tyytymättömiä ajamiseesi. Voit parantaa tyytyväisyyttä tarjoamalla mukavan kyydin.<br><br>Mikäli bussi on varustettu hidastimella, käytä sitä tasaiseen jarruttamiseen - paina $KEY_retarderup$ lisätäksesi sen voimakkuutta ja $KEY_retarderdown$ vähentääksesi sitä."


    key[]: "hint_bus_late_title"
	val[]: "Saapuminen myöhässä"

    key[]: "hint_bus_late_text"
    val[]: "Olet aikataulusta jäljessä. Tämä saattaa vaikuttaa asiakkaiden tyytyväisyyteen saavuttaessa perille. Voit saada aikataulua kiinni, mutta aja aina turvallisesti."


    key[]: "hint_bus_stop_title"
	val[]: "Lähesty bussipysäkkiä"

    key[]: "hint_bus_stop_text"
    val[]: "Pysähdy merkitylle alueelle, jotta matkustajat voivat poistua ja nousta kyytiin. Uudet matkustajat arvostavat siistiä ja vahingoittumatonta bussia."


    key[]: "hint_bus_stop_fin_title"
	val[]: "Lähesty bussipysäkkiä"

    key[]: "hint_bus_stop_fin_text"
    val[]: "Pysähdy merkitylle alueelle päättääksesi matkasi."