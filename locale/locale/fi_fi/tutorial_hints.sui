    key[]: "hint_lights_title"
    val[]: "Kytke valot päälle"

    key[]: "hint_lights_text"
    val[]: "Paina $KEY_light$ kytkeäksesi valot. Paina toistuvasti käydäksesi kaikki tilat läpi."


    key[]: "hint_high_beam_title"
    val[]: "Kytke pitkät valot"

    key[]: "hint_high_beam_text"
    val[]: "Paina $KEY_hblight$ kytkeäksesi pitkät valot."


    key[]: "hint_wipers_title"
