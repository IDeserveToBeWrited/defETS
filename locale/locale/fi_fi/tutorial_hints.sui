    key[]: "hint_tow_text"
    val[]: "Mikäli olet jumissa hankalassa paikassa, voit käyttää hinauspalvelua. Voit käyttää sitä avaamalla @@quick_info_word@@ valikon painamalla $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Tasauspyörästön lukko"

    key[]: "hint_diff_lock_text"
    val[]: "Tasauspyörästön lukon kytkeminen saattaa auttaa, mikäli et pääse liikkeelle. Kytke tasauspyörästön lukko painamalla $KEY_diflock$ tai kytke automaattinen lukko @@desktop_menu_category_options@@ valikosta."


    key[]: "hint_diff_unlock_title"
    val[]: "Tasauspyörästön lukko kytketty"

    key[]: "hint_diff_unlock_text"
    val[]: "On suositeltavaa vapauttaa tasauspyörästön lukko normaalin ajon ajaksi, ettei se vahingoitu. Kytke tasauspyörästön lukko pois päältä painamalla $KEY_diflock$ tai kytke automaattinen lukko @@desktop_menu_category_options@@ valikosta."


    key[]: "hint_wipers_off_title"
