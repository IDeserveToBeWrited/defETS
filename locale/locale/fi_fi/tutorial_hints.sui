    key[]: "hint_zoom_text"
    val[]: "Paina $KEY_camzoom$ suurentaaksesi sisätilanäkymässä. Voit määritellä tarkennustilan joko pidä tai kytke @@desktop_menu_category_options@@ valikosta."


    key[]: "hint_cam_int_title"
    val[]: "Katsele ympärille"

