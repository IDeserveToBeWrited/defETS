#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Jatka ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Tervetuloa Euro Truck Simulator 2:een!"

	key[]: "intro_2"
	val[]: "Viimeinkin sinulla on tilaisuus kokea unelmatyösi - rekan ajo!"

	key[]: "intro_3"
	val[]: "Kuljetusyrityksesi on nyt avattu, mutta valitettavasti sinulla ei ole rahaa ostaa rekka-autoa. Mahdollisuutenasi tällä hetkellä on työskennellä muille yrityksille renkinä."

	key[]: "intro_4"
	val[]: "Tehtäväsi on toimittaa $JOB_CARGO$ yrityksen $JOB_TARGET_COMPANY$ laiturille kaupunkiin $JOB_TARGET_CITY$. Työnantajasi tarjoaa sinulle ajoneuvon ja kattaa kaikki kulut. Saavu perille ajoissa äläkä tuota kenellekään pettymystä."


	key[]: "intro_garage_1"
	val[]: "Tämä on päämajasi."

	key[]: "intro_garage_2"
	val[]: "Se on melko vaatimaton talliksi eikä välttämättä tarjoa paljon, mutta se on alku."

	key[]: "intro_garage_3"
	val[]: "Toistaiseksi sinulla ei ole mitään pysäköitäväksi tänne, joten kuorma-autoja ei ole näkyvissä."

	key[]: "intro_garage_4"
	val[]: "Kun olet tienannut tarpeeksi rahaa ja ostanut kuorma-auton, voit liikkua kartalla vapaasti ja pyörittää omaa liiketoimintaasi täältä käsin."

	key[]: "intro_garage_5"
	val[]: "Onnea!"


	key[]: "desktop_tut_t"
	val[]: "TOIMINTO AVATTU"

	key[]: "desktop_tut_job"
	val[]: "Valitse seuraava työsi"

	key[]: "desktop_tut_cargo_market"
	val[]: "Käytä hankkimaasi perävaunua kuljettaaksesi Rahtipörssistä löytyviä toimituksia päämääriinsä." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Tässä näet edistyksesi."

	key[]: "desktop_tut_company"
	val[]: "Seuraa tallejasi, palkkaa uusia kuljettajia ja johda yritystäsi muilla tavoin täältä."

	key[]: "desktop_tut_trailers"
