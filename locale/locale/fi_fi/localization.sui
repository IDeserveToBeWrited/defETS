#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "VALITSE H-VAIHDEKAAVION ASETELMA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Aluevaihteisto on yksinkertaisin vaihtoehto. Siinä on kaksi nopeusaluetta. Ensimmäisessä alueessa on vaihteet 1-6 ja toisessa vaihteet 7-12. Vaihtopainikkeella vaihdetaan alueiden välillä, kun taas vaihdekepillä valitaan tietty vaihde alueelta."

	key[]: "wiz_hs_splitter"
	val[]: "Jakovaihteisto on yksinkertainen vaihtoehto, jossa on myös kaksi nopeusaluetta. Ensimmäisessä alueessa on parittoman luvun vaihteet (1, 3, 5 ...) ja toisessa alueessa on parillisen luvun vaihteet (2, 4, 6 ...). Vaihtopainikkeella vaihdetaan alueiden välillä, kun taas vaihdekepillä valitaan tietty vaihde alueelta."

	key[]: "wiz_hs_range_splitter"
	val[]: "Aluev-puolittajavaihteisto perustuu oikeaan alue-puolittajavaihteiston kaavioon. Vaihteisto on jaettu kahteen H-kaavioon ja se käyttää kahta vipua. Tämän vuoksi sitä suositellaan vain kokeneille kuljettajille."
#@}

#@}

