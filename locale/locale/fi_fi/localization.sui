#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "ASETA OHJAIMEN AKSELIT" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Akselien visualisointi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Voit kokeilla kaikkien valittujen akseleiden toimintaa visuaalisesti. Käytä ohjainta ja katso liikkuvia palkkeja. Ne kertovat sinulle jokaisen käytetyn akselin rajat, keskityksen, suunnan ja yleiskäyttäytymisen."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Akselien asetukset"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Akselin nimen vieressä oleva painike vaihtaa syöttötilaan. Syöttötilaan siirryttyäsi liikuta sauva- tai rattiohjainta tai poljinta asettaaksesi toiminnon valitsemaasi akseliin."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Kuolleet alueet"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Kuollut alue tarkoittaa akselissa olevaa aluetta, josta ei muodostu syötettä peliin. Voit muuttaa kuolleita alueita kunkin akselin kohdalla olevasta liukusäätimestä. Kuollut alue suurenee, kun kasvatat liukusäätimen asetusta oikealle. Tämä toiminto on hyödyllinen erityisesti vanhempien ohjainten kohdalla, joissa kulumisesta johtuvia epätarkkuuksia ja väärää syöttötietoa voi olla mahdollista vähentää suurentamalla kuollutta aluetta."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Akselien tilat"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Akselin tila määrittää kuinka akselia käytetään pelissä. Käänteinen akseli kääntää ympäri sen ilmoitetun suunnan, esim. todellisuudessa oikealle ohjaaminen muuttuu pelissä vasemmalle ohjaamiseksi. Keskitetyllä akselilla on sen oletusasema keskellä liikealuetta (esim. sauvaohjaimessa). Tämä asetus on auttaa korjaamaan akselin, mikäli se on havaittu ja näin ollen toimii väärin."

	key[]: "normal"
	val[]: "Normaali" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Käänteinen" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Keskitetty" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Käänteinen + keskitetty" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMAATTIVAIHTEISTON ASETUKSET" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Automaattivaihteiston kanssa sinun tulee vaihtaa ainoastaan ajovaihteen, vapaan ja peruutusvaihteen välillä. Onnistut siinä käyttämällä seuraavia näppäimiä ja ohjainpainikkeita. Vaihtaaksesi asetettuja näppäimiä, klikkaa painiketta ja paina näppäintä tai ohjainpainiketta, jonka haluat liittää toimintoon. "

	key[]: "automatic_gb_setup_desc2"
	val[]: "Mikäli sinulla on H-vaihdekaaviollinen ohjain liitettynä, voit käyttää sitä simuloimaan oikeaa automaattista vaihteenvalitsinta. Aktivoi tämä asetus ja voit määrittää H-vaihdekaavion asennot ajovaihteille ja peruutusvaihteelle. Mitkä tahansa muut H-vaihdekaavion asennot luetaan vapaavaihteeksi. Tämä asetus luodaan erityisesti H-vaihdekaavioiselle ohjaimelle, joten mahdollisuutta ei ole käyttää asetusta tavallisten näppäinten tai ohjaimen painikkeiden kanssa. Vaihtaaksesi määrittelyä, paina painiketta ja aseta vaihde haluamaasi kohtaan ja takaisin vapaalle."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEKVENTIAALIVAIHTEISTON ASETUKSET" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekventiaalivaihteisto vaihtaa kaikkien ajovaihteiden, vapaan ja peruutusvaihteen välillä. Tässä ovat näppäimet ja ohjaimen painikkeet joita käytetään ylös ja alas vaihtamiseen mainitussa järjestyksessä. Vaihtaaksesi määrittelyä paina painiketta ja paina näppäintä tai ohjaimen painiketta johon haluat käyttää toimintoa."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-VAIHDEKAAVIOVAIHTEISTON ASETUKSET" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Tässä voit valita pääasettelun H-vaihdekaaviolle ja koettaa sen toimintoja. Kuvassa näet vaihdekepin tämänhetkisen sijainnin sekä valitun vaihteen. Kun vaihdelaatikko sisältää enemmän vaihteita kuin vaihdekepin paikkoja on, sinun pitää käyttää vaihtopainiketta vaihtaaksesi eri nopeusalueiden välillä."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Parhaillaan valittu vaihde ja aluevalinta on myös osoitettuna alla, vierellä on ilmoitettuna liitetty kontrolli. Vaihtaaksesi määritettyä kontrollia paina haluamaasi valintaa ja tämän jälkeen valitse haluamasi vaihde, jonka jälkeen palauta vaihde vapaalle."
#@}

