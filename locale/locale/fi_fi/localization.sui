	val[]: "YLEISET ASETUKSET" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "YHDISTÄ SISÄLTÖÄ" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Yhdistä" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks on havainnut uutta pelisisältöä. Yhdistä uusi sisältö World of Trucks -palveluihin saadaksesi niistä enemmän irti." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online-valinnat. Säädä kaikkia World of Trucks asetuksia." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Haluatko varmasti lykätä rekisteröitymistä?<br><br>Pääset yhdistämään sisältöä myös myöhemmin työpöydällä sijaitsevan online-asetusvalikon kautta." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "YHDISTETÄÄN SISÄLTÖÄ" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Yhdistetään sisältöä.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Yhdistäminen epäonnistui seuraavalle sisällölle: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam-tili, jota käytit rekisteröidäksesi tämän lisäsisällön (DLC) ei ole sama, jolla olet luonut World of Trucks-tilisi tai rekisteröinyt pelin. Vaihda Steam-tiliä ja yritä uudelleen." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam-tili, jota yrität käyttää rekisteröidäksesi tämän lisäsisällön (DLC) on jo liitetty toiseen World of Trucks-tiliin. Rekisteröidäksesi lisäsisällön tälle tilille sinun tulee käyttää Steam-tiliä, joka ei ole liitetty yhteenkään World of Trucks-tiliin." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token on vanhentunut. Ole hyvä ja yritä myöhemmin uudelleen." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Lisäsisällön (DLC) aktivointiin käyttämäsi tuoteavain ei ole voimassa. Avun saamiseksi ota yhteys tukeen: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "On ilmennyt sisäinen virhe pelin rekisteröinnin yhteydessä. Ole hyvä ja yritä rekisteröintiä myöhemmin uudelleen." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "ONNISTUI" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "SISÄLLÖN SELAUS" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Onnittelut! Valitsemasi lisäsisällöt (DLC) yhdistettiin onnistuneesti World of Trucks-tiliisi." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Sisällön yhdistäminen ei onnistunut, koska nykyinen Steam-tili on liitetty toiseen World of Trucks-tiliin." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Joitakin lisäsisältöjä (DLC) ei pystytty yhdistämään.<br>Vie hiiren osoitin huutomerkin päälle saadaksesi lisätietoja." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Rekisteröidään $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Nykyinen profiili ei ole yhdistetty World of Trucksiin tai peli on offlie-tilassa. Muokkaa profiilia yhdistääksesi." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Click to Dismiss"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ yhteensopivaa lisäsisältöä (DLC) yhdistetty. Mikäli joitakin lisäsisältöjä ei ole yhdistetty, jotkin World of Trucksin ominaisuudet eivät välttämättä ole käytettävissä." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Onnittelut! <color value=@@clr_txt@@>Kaikki sisältö on nyt yhdistetty World of Trucksiin! Voit nyt käyttää kaikkia sen ominaisuuksia." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Uutta sisältöä ei pystytä liittämään World of Trucksiin, koska käytössä oleva Steam-tili ei täsmää World of Trucks-profiiliin liitetyn Steam-tilin kanssa." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Yhdistetty" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Ei yhdistetty" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
