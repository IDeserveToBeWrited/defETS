	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Pystytahdistus (v-sync)" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Säästö (säästää virtaa kannettavilla)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "YKSINKERTAISET NÄYTTÖASETUKSET" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "MUKAUTETUT ASETUKSET OTETTU KÄYTTÖÖN" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "LISÄÄ NÄYTTÖASETUKSIA" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Yksinkertaiset/Kehittyneet grafiikka-asetukset" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Piilota lisäasetukset" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Näytä lisäasetukset" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skaalaus" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Antialiasointi" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma tarkennus" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA-asetukset" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Mukautuva selkeys" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Aina pehmeä" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Aina terävä" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Screen Space Ambient Occlusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "High dynamic range (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Syväterävyysalue (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Auringonsäteet" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Värikorjaus" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Heijastusten skaalaus" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Heijastusten yksityiskohdat" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Kasvillisuuden yksityskohdat" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Ruohon tiheys" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Varjojen laatu"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Varjotekstuurien koko" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Kaukaiset varjot" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Sisätilan varjot" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Sään laatu"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Peilien laatu" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Peilien resoluutio" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Peilausetäisyys" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Tekstuurien laatu" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anisotrooppinen suodatus" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normaalit kartat" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Tekoälyn ohjaamien ajoneuvojen ajovalot" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Ajoneuvon toissijaiset valot" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Valojen näkyvyysalueet" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Jalankulkijat" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Näyttöasetukset on muutettu.<br>Haluatko säilyttää nämä asetukset?"

	key[]: "reverting_in"
	val[]: "Peruutetaan muutokset" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekuntia" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Kun tämä on valittuna, näytetään peli koko näytön kokoisena."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Säädä pelin kirkkautta näytöllesi parhaiten sopivaksi. HDR-kalibrointi on käytettävissä sitä tukevilla näytöillä."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Muuttaa pelin resoluutiota."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Muuttaa pelin tavoitevirkitystaajuutta."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Mukauttaa ruudunpäivityksen vastaamaan näytön virkistystaajuuttaa repeilyn (tearing) ehkäisemiseksi. Säästö-asetus lisäksi puolittaa ruudunpäivitysnopeuden virran säästämiseksi."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää pelin maksimi ruudunpäivitysnopeutta.<br><br>Asettamalla arvoksi 0, toiminto on pois käytöstä."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Asettaa suurimman sallitun ruudunpäivitysnopeuden kun peli on pienennettynä taustalla.<br><br>Toiminto ei ole käytössä mikäli valitset 0."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Vaihtaa yksinkertaisten (esiasetettu) ja kehittyneiden (mahdollisuus muuttaa yksittäisiä asetuksia) grafiikka-asetusten välillä."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Parantaa grafiikan tarkkuutta renderöimällä peli sisäisesti korkeammalla resoluutiolla, mikä vähentää sahalaitoja ja parantaa yksityiskohtia.<br>Esimerkiksi valitsemalla korkeamman skaalausvaihtoehdon, saadaan selkeämpi kuva, jossa on vähemmän sumeutta - tämä saa pelin näyttämään paremmalta suorituskyvyn kustannuksella.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on usein suuri vaikutus suorituskykyyn."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Valikoima nopeita antialiasointivaihtoehtoja jotka tasoittavat pelin rosoisia reunoja:<br>- SMAA ottaa pikseleistä useita näytteitä (riippuen valitusta laadusta) eri kohdista kuvaa ja tuottaa lopullisen kuvan näiden keskiarvosta.<br>- TAA ottaa näytteen pikselista kuvassa vain kerran, mutta ottaa näytteitä eri kohdista ja eri kuvista.<br>- Parhaan tuloksen saavuttamiseksi voit valita myös näiden yhdistelmän suorituskyvyn kustannuksella.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Lisää pehmeitä varjoja painaumiin ja toisiaan lähellä oleviin kappaleisiin parantaen koko pelimaailman koettua graafista tarkkuutta.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Valikoima TAA esiasetuksia:<br>- \"Aina pehmeä\" tuottaa vähemmän välkyntää/enemmän sumeutta - se sopii PC-pelaajille, joilla on ylinäytteistys (supersampling) käytössä tai joilla on korkeatarkkuuksinen näyttö, sekä 1080p resoluution TV:n käyttäjille, jotka istuvat kauempana ruudusta.<br>- \"Aina terävä\" tuottaa enemmän välkyntää/vähemmän sumeutta - se on todennäköisesti paras vaihtoehto alle 1080p resoluutiolle, kuten kannettavat tietokoneet tai Steam Deck.<br>- \"Mukautuva selkeys\" kytkee dynaamisesti TAA:n aiheuttaman heilahtelun (jitter) pois päältä kun kamera on paikoillaan.<br><br><color value=@@clr_txt_d@@>Tätä asetusta voidaan käyttää vain kun TAA on valittuna antialiasointimenetelmänä."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää TAA:n luma tarkennuksen voimakkuutta.<br><br><color value=@@clr_txt_d@@>Tätä asetusta voidaan käyttää vain kun TAA on valittuna antialiasointimenetelmänä."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Kun tämä on valittuna, kaukaiset alueet voidaan sumentaa keinotekoisesti, jotta taustalle syntyy realistinen tarkennuksen heikkeneminen."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Kun tämä on käytössä, valonsäteitä saattaa näkyä kun katsot aurinkoon tai kun katsot aurinkoon esineiden kuten puiden, rakennusten tai autojen välistä."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Kun tämä on käytössä, pelin värejä säädetään dynaamisesti esteettisyyden mukaan. Näkymät vastaavat paremmin vuorokaudenaikoja ja sääolosuhteita, ajoneuvojen ja muiden kohteiden värit voivat olla elävämpiä jne."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Parantaa heijastuksia renderöimällä ne parempilaatuisena ja käyttämällä parempaa antialiasointia.<br><br><color value=@@clr_txt_d@@>Asetukset tulevat käyttöön vasta kun peli käynnistetään uudelleen."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää ajoneuvojen pinnoilta, ikkunoista ja muista heijastavista pinnoista, kuten lätäköistä, märiltä teiltä ja vesialueilta nähtävien heijastusten yksityiskohtia.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn.<br><br>Muutokset tähän asetukseen tulevat voimaan vasta kun peli käynnistetään uudelleen."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää kasvien ja puiden yksityiskohtaisuutta ja monimutkaisuutta.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää tienvarsilla näkyvän ruohon tiheyttä.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää auringon tai kuun aiheuttamien varjojen tarkkuutta.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Määrittelee renderöidäänkö myös hyvin kaukaisten kappaleiden varjot.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Kytkee päälle yöajan dynaamiset varjot ohjaamossa.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää sääefektien, kuten heijastusten laatua."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää peileistä näkyvien heijastusten tarkkuutta (riippumatta heijastusasetuksista).<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää peileihin renderöityjen kuvien tarkkuutta."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää etäisyyttä, jossa peilissä näkyviä kohteita renderöidään.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on usein merkittävä vaikutus suorituskykyyn."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää joidenkin objekteissa ja pinnoissa käytettävien tekstuurien laatua."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Parantaa erityisesti kaukaisten tai vinossa kulmassa olevien tekstuurien terävyyttä.<br><br><color value=@@clr_txt_d@@>Muutokset tähän asetukseen tulevat voimaan vasta kun peli käynnistetään uudelleen."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Lisää geometristen yksityiskohtien vaikutelman jalkakäytäviin, teihin ja muihin esineisiin parantaien niiden ulkonäköä.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn.<br><br>Muutokset tähän asetukseen tulevat voimaan vasta kun peli käynnistetään uudelleen."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Näyttää muun liikenteen ajovalojen heijastuksen."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Näyttää muun liikenteen toissijaisten valojen, kuten vilkkujen, jarruvalojen, jne. heijastuksen."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Säätää etäisyyttä, jolta keinotekoiset valonlähteet voidaan nähdä.<br><br><color value=@@clr_txt_d@@>Tällä asetuksella on tavallisesti kohtalainen vaikutus suorituskykyyn."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Lisää peliin jalankulkijat."
