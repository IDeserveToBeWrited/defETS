#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Valikoima teemoja, joita näytetään taustalla kun selaat valikoita."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Valitsee satunnaisen taustakuvan aina kun käynnistät pelin."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Säätää viiveen, jonka jälkeen työpöydän elementit katoavat."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, koet ajan myötä väsymyksen oireita.<br><br>Lepotauon välttäminen johtaa liikennerikkomukseen."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, sinun tulee noudattaa liikennesääntöjä rikesakon uhalla. Riski saada sakot on suurempi poliisiautojen, tutkien ja liikennekameroiden lähellä."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää tarjottavien töiden keskipituutta."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Valitse mikä nopeusrajoitus näytetään navigaattori-pienoisohjelmassa."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Nykyinen nopeus navigaattorissa muuttuu punaiseksi, kun nopeusrajoitus ylitetään."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun saavut määränpäähän, näytetään pienoisohjelma, jolla voit ohittaa pysäköinnin."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Pitää kaikki pienoisohjelmat piilotettuna."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Piilottaa molemmat virtuaalipeilit."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Pitää kaikki tiedotteet piilotettuna myös silloin kun ne vastaanotetaan."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Näyttää yhteenvedon pelaajan nykyisen kuorma-auton ominaisuuksista ennen raskaan kuljetustehtävän hyväksymistä."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Valitse, miten navigaattorin kartta on suunnattu."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Choose how the World Map is explored:<br>- \"Proximity exploration\" marks a larger area as explored.<br>- \"Precision exploration\" reveals only the areas immediately around the player."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Valitse, miten navigointi näytetään."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Muuttaa miten navigaattorin reitti valitaan:<br>- \"Nopein\" tila valitsee tehokkaimman pituuden ja ajan yhdistelmän ja yrittää välttää valoristeyksiä jne.<br>- \"Lyhin\" tila valitsee aina lyhimmän mahdollisen reitin.<br>- \"Pienet tiet\" tila välttelee valtateitä mahdollisuuksien mukaan."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Muuttaa kuljetuksen pysäköinnin vaikeusastetta:<br>- \"Valitse aina\" antaa sinun valita aina kun olet saapunut määränpäähän.<br>- \"Turvallinen pysäköinti\" ei vaadi peruuttamista.<br>- \"Taitava pysäköijä\" vaatii yleensä peruuttamisen haasteellisempaan paikkaan."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Säätää todennäköisyyttä kuinka usein pelaaja kohtaa tieliikenteen esteitä, kuten onnettomuuksia, hajonneita ajoneuvoja, tielle kertynyttä roskaa, jne."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Säätää todennäköisyyttä kohdata vaihtoehtoiselle reitille ohjaavia tapahtumia kuljetustehtävän aikana."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Säätää huonon sään todennäköisyyttä."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Määrittelee näytetäänkö kellonajan lisäksi myös aikavyöhyketieto."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Enables in-game cutscenes typically displayed after vehicle purchases, garage upgrades or during passenger loading."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Valitsee näytetäänkö puoliläpinäkyvät esteet teillä, joita ei voi käyttää."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Kääntää hiiren Y-akselin kun ohjaat kameraa pelissä."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Valitsee vaihteiston tyypin:<br>- \"Yksinkertaistettu automaatti\" tarkoittaa, että kaasua ja jarrua käytetään kuorma-auton liikuttamiseen eteen- ja taaksepäin.<br>- \"Todellinen automaatti\" tarkoittaa, että sinun tulee vaihtaa suuntaa erillisestä napista.<br>- \"Sekventiaali\" vaatii vaihteiden vaihtamisen manuaalisesti ylös/alas-painikkeilla.<br>- \"H-vaihdekaavio\" vaatii vaihteisto-ohjaimen, jolla jokainen vaihde valitaan manuaalisesti."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Tämän käyttöönotto sallii vaihteiden väliin jättämisen tarpeen mukaan, jotta vältytään käymästä läpi kaikkia vaihteiston vaihteita."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Palauttaa ohjauspyörän takaisin keskelle, kun käytetään näppäimistöä tai peliohjainta.<br><br>Tämän poistaminen käytöstä tarkoittaa, että sinun tulee itse palauttaa ohjauspyörä keskelle kääntämisen jälkeen."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää ohjauspyörän animaation kääntösädettä."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Muuttaa jarrujen tehokkuutta."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää ajoneuvon vakautta madaltamalla sen painopistettä."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää perävaunun vakautta madaltamalla sen painopistettä."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää kuorma-auton jousituksen jäykkyyttä."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Muuttaa hytin jousituksen jäykkyyttä."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Adjusts the intensity of procedurally generated surface bumps to give roads and other terrains an imperfect feel.<br><br>Depending on other suspension and camera settings the perceived effect may be more or less prominent."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Ottaa käyttöön ammattimaisen perävaunun kytkennän, joka vaatii suurempaa tarkkuutta kuorma-auton vetopöydän ja perävaunun kytkentätapin kohdistamisessa.<br><br>Kun tämä on pois käytöstä, perävaunun kytkeminen on helpompaa, sillä kytkentätappi ja vetopöytä eivät voi osua toisiinsa."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Valitsee mitkä perävaunujen kaapelit animoidaan.<br><br><color value=@@clr_txt_d@@>Kaapeleiden näyttäminen useammassa ajoneuvossa saattaa vaikuttaa suorituskykyyn vanhemmilla järjestelmillä."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Enables the vehicle's electronic speed limiter at a value depending on its model.<br><br><color value=@@clr_txt_d@@>World of Trucks jobs have this feature permanently turned on."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna ja lasinpyyhkijät on kytketty ensimmäiseen asentoon, kytkeytyvät pyyhkijät automaattisesti päälle ja niiden nopeus säätyy automaattisesti olosuhteiden mukaan."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Automaattinen hidastimen käyttö jarrutettaessa."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on valittuna, ajoneuvo avustaa mäkilähdöissä painamalla jarrua varmistaen tasaisen liikkeellelähdön."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Automaattinen moottorijarrun käyttö jarrutettaessa."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on valittuna, moottori käynnistyy heti kun kaasua painetaan."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on valittuna, ajoneuvon seisontajarru kytketään automaattisesti (lauttamatkan, huoltoon hinauksen, pikamatkustuksen, jne. jälkeen)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Laskee telin tarpeen mukaan automaattisesti riippuen yhdistelmän painosta."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the throttle button is released.<br><br>Affects keyboard input only."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simuloi tosielämän liiallisesta jarruttamisesta johtuvaa ilmanpaineen alenemista.<br><br>Kun tämä on valittuna, tulee sinun tarkkailla ilmanpainetta ajaessasi alas rinnettä tai käyttäessäsi paljon jarrua ajaessasi hitaasti."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on valittuna, ABS estää pyöriä lukkiutumasta hallinnan säilyttämiseksi ja jarrutuksen tehostamiseksi."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on valittuna, käytetään jarruttaessa pyöräkohtaista jarrua, jolla estetään sutimista ja yli- tai aliohjausta ja pidetään ajoneuvo hallinnassa."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää porrasta, jolla vakionopeudensäätimen nopeutta muutetaan, kun säätönäppäimiä painetaan."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää vakionopeudensäätimen toleranssia kohdenopeuden säilyttämisessä."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on valittuna, vakionopeudensäädin muuttaa automaattisesti ajoneuvon nopeutta säilyttäen turvallisen välimatkan edellä ajavaan."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Tekee hätäjarrutuksen, mikäli järjestelmä havaitsee uhkaavan törmäyksen.<br>Voit valita reagoiko järjestelmä ainoastaan ajoneuvoihin vai kaikkiin esteisiin."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna ja ajovalot on kytketty ensimmäiseen asentoon, kytkeytyvät ajovalot automaattisesti päälle hämärissä olosuhteissa."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna ja pitkät valot ovat päällä, ajoneuvo kytkee automaattisesti pitkät pois päältä, mikäli se havaitsee vastaantulevan tai edessä lähellä olevan ajoneuvon."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, suuntavilkut kytkeytyvät automaattisesti pois päältä käännöksen jälkeen, kun ohjauspyörä palautuu keskiasentoon."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, jotkin sisustan lisävarusteet reagoivat ajoneuvon liikkeeseen (riippuvat koristeet, bobblehead-figuurit, jne.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Kytkee päälle ohjausliikkeisiin perustuvan sivusuuntaisen käännön sisätilakamerassa."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää kuinka voimakkaasti \"Ohjauskameran kierto\" reagoi kääntämiseen."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää miten \"Ohjauskameran kierto\" käyttäytyy peruutettaessa."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on käytössä, sisäkamera kääntyy oikealle tai vasemmalle vilkun käytön mukaan."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Kun tämä on käytössä, sisätilan kamera reagoi ajoneuvon liikkeeseen."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää, kuinka voimakkaasti sisätilan kamera reagoi ajoneuvon liikkeeseen."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Säätää kuinka paljon sisäkamera saa kiertää perustuen ajoneuvon liikkeeseen."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes how much the interior camera FOV is changed with vehicle movement speed."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Määrittelee viiveen, jonka jälkeen kamera keskittää automaattisesti.<br><br>Ajoneuvon tulee liikkua riittävällä nopeudella, jotta tämä aktivoituu. Vaikuttaa ainoastaan sisätila- ja seurantakamerassa eteenpäin ajettaessa, sekä ulos nojaavassa kamerassa peruutettaessa."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Määrittää kameran liikenopeuden. Käytetään automaattisessa kameran keskittämisessä ja vaihtaessa esiasetettujen sisätilakuvakulmien välillä."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Määrittelee miten sisätilan zoomaus toimii: pidä nappia painettuna zoomataksesi tilapäisesti tai paina nappia kerran kytkeäksesi sen päälle/pois." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Määrittää pelissä käytettävän kielen."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Vaihtaa mittayksiköitä ja valuuttaa aluevalinnan mukaisesti."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, kaupungit ja maat näytetään valitsemallasi kielellä."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, kaupungit ja maat näytetään sekä valitsemallasi kielellä, että kyseisen alueen alkuperäiskielellä."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä valuutta."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Voit valita joko 12 tai 24 tunnin kellon."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä pituusyksikkö."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä painon yksikkö."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä lämpötilayksikkö."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä paineen yksikkö."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä tilavuuden yksikkö."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Valitse käytettävä polttoaineenkulutusta ilmaiseva yksikkö."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, voit avata keskustelun Saattue-pelissä käyttämällä \"Aktivoi\" painiketta (@@imv_nrm_activate@@)."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, viestinkirjoitusruutu suljetaan viestin lähettämisen jälkeen."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, keskusteluviestit katoavat sekuntien kuluttua saapumisesta."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Säätää aikaa miten kauan keskusteluviestit näkyvät ruudulla."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Kun tämä on valittuna, näytetään Saattue-pelissä pelaajien nimet heidän ajoneuvojensa yläpuolella."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Avaa lisävalikon pikavastausten määrittelyyn Saattue-pelissä keskustelua varten."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Tarkista World of Trucksiin liitetyn sisällön tila."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Sallii online-uutisten lataamisen ja näyttämisen päävalikossa."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Sallii yhteisön kuvankaappausten lataamisen World of Trucksista sekä niiden näyttämisen latauskuvina."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Sallii oikeiden mainosten lataamisen ja näyttämisen valituissa pelinsisäisissä mainostauluissa."
