	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Määrittää vaihteiden sijoittelun, kun käytetään H-vaihdekaaviota."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Muuttaa vaihteenvalitseminen toimintaa:<br>- \"Yksinkertainen\" -valinnalla hammasrattaat eivät koskaan rahise vaihdettaessa.<br>- \"Yksinkertainen + varoitusäänet\" valinta sallii vaihteiden vaihtamisen yksinkertaisesti, mutta huonosti vaihdettaessa kuulet rattaiden rahinaa.<br>- \"Edistynyt\" valinta sallii vain oikein tehdyt vaihteen vaihdot ja muuten kuulet vain rattaiden rahinaa. \"Edistynyt\" valinnalla voit käyttää myös \"Vaihteiston nopea jako\" -asetusta."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Choose how the game handles fast gear splits:<br>- \"Never\" will require the gear stick to be moved to neutral between splits.<br>- \"Clutch Press\" requires a momentary depression of the clutch with no gear stick movement.<br>- \"Throttle release\" requires the driver to only release the throttle to split gears with no gear stick movement, and \"clutch or throttle\" is a combination of the latter two."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Vaihtaa vastaavan vaihteen."

