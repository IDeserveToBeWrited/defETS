#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Internet-yhteys ei ole käytettävissä. Tarkasta, että ohjelman asetukset ovat oikein."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Yhteyden muodostaminen online-palveluun epäonnistui. Tarkista, että internet-yhteytesi toimii."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Virhe kommunikoitaessa online-palvelun kanssa. Ole hyvä ja yritä myöhemmin uudelleen."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Vääränlaista tietoa palautui online-palvelusta. Jos HTTP-välityspalvelin on käytössä, tarkista sen asetukset. Muussa tapauksessa yritä myöhemmin uudestaan."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Vääränlaista tietoa palautui online-palvelusta. Ole hyvä ja yritä myöhemmin uudelleen."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Palvelu ei ole yhteensopiva sinun pelisi version kanssa. Tarkista korjausversion (patch) saatavuus."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Palvelu ei ole juuri nyt käytössä. Ole hyvä ja yritä myöhemmin uudelleen."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Palvelu ei ole käytössä huollon tai ylikuormituksen takia. Ole hyvä ja yritä myöhemmin uudelleen."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Kirjautumistiedot eivät ole oikein. Ole hyvä ja yritä kirjautua sisään uudelleen."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Online-tili on lukittuna liian monen epäonnistuneen sisäänkirjautumisen takia. Ole hyvä ja yritä uudelleen puolen tunnin kuluttua."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Online-tili on nyt lukittu epäilyttävän käytöksen takia. Ole hyvä ja yritä uudelleen 24 tunnin kuluttua."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Tätä peliä ei ole rekisteröity tälle online-tilille."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Tiliä ei ole aktivoitu vielä. Tarkista sähköpostisi aktivointipostin varalta."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Tili on suljettu. Ole hyvä ja ota yhteyttä tekniseen tukeen."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Tili on estetty. Ole hyvä ja ota yhteyttä tekniseen tukeen."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Tämä peli ei tue proxy-tunnistusta. Ole hyvä käytä toista välityspalvelinta tai suoraa yhteyttä."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Vaadittu kohde ei ole juuri nyt saatavilla. Ole hyvä ja yritä uudelleen muutaman minuutin kuluttua."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL virhe. Suojatun yhteyden muodostaminen ei onnistu."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Sisäinen virhe, net.log tiedosto saattaa sisältää lisää tietoa."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2:lla on ongelma eikä pysty piirtämään grafiikkaa tietokoneellasi (toimivaa grafiikkalaitetta ei löydetty).\nSuositellut vaiheet:\n\n1. Tarkista, että tietokoneesi ja näytönohjaimesi täyttää minimivaatimukset.\n2. Päivitä tietokoneesi viimeisimpään Microsoftin DirectX-versioon.\n3. Lataa ja asenna viimeisimmät ajurit näytönohjaimellesi valmistajan verkkosivulta - näytönohjaimen ajurisi ovat todennäköisesti vanhentuneet.\n4. Koeta vaihtaa renderöintimenetelmä OpenGL:stä DirectX:ään tai päinvastoin.\n5. Poista 'config.cfg'-peliasetustiedosto 'Euro Truck Simulator 2'-kansiosta, joka löytyy 'Tiedostot'-kansiostasi. Tiedosto on saattanut korruptoitua.\nTämä tiedosto uudelleenluodaan automaattisesti toimivilla oletusarvoilla, kun peli seuraavan kerran käynnistetään."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 on havainnut ongelman. Grafiikkaa ei pystytä piirtämään tietokoneellasi (grafiikkakiihdytyslaitetta ei löytynyt)."
#@}

