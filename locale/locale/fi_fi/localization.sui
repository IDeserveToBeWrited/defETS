	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Määrittelee miten peli käsittelee ohjaimen liikkeitä:<br>- Keskitetty sopii joystickeille.<br>- Normaali sopii liipaisimille ja polkimille.<br>- Käänteinen voi kompensoida kontrollit, jotka havaittiin väärin."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
