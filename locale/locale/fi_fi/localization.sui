	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Säätää kytkinpoljinakselin kuollutta aluetta; polkimen liikeradan pituutta, jolta syötettä ei rekisteröidä.<br><br>Tällä voidaan vähentää vanhempien ohjainten kulumisesta aiheutunutta epätarkkuutta ja väärää syöttötietoa."

