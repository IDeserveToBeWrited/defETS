	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Säätää kytkimen toiminta-aluetta.<br><br>Mitä pidemmälle oikealle säädät alueen, sen pidemmälle kytkinpoljinta tulee painaa, jotta kytkin ottaa kiinni."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
