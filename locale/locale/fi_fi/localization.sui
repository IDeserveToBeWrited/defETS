	key[]: "controllers"
	val[]: "Ohjaimet"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Avustaja lisää suositellut asetukset liitettyihin ohjaimiin.<br><color value=@@clr_sel@@>Mikäli käytät Steam-yhteensopivaa ohjainta, harkitse konfigurointiavun aktivoimista <br><color value=@@clr_txt_d@@> \"Steam > Asetukset > Ohjain > Yleiset ohjainasetukset\" (eng. \"Steam > Settings > Controller > General Controller Settings\")."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Aja käyttämällä näppäimistöohjausta ja katso ympärillesi hiirellä. Yksinkertaisin ja epätarkin ohjaustapa, mutta kaikkien käytettävissä."

	key[]: "wiz_control_mouse"
	val[]: "Käytä hiirtä tarkempaan ohjaukseen. Muut toiminnot suoritetaan silti näppäimistöllä. Voit käyttää hiirtä katsoaksesi ympärillesi vain jos pidät samaan aikaan pohjassa erikseen asetettua kamerakontrollipainiketta."

	key[]: "wiz_control_controller"
	val[]: "Käytä rattiohjainta, peliohjainta tai joystickiä saavuttaaksesi mahdollisimman realistinen pelikokemus. Näppäimistön pikapainikkeilla pääset käsiksi moniin toimintoihin ja voit vaihtaa kamerakulmaa hiirellä (hiirikatse)."
#@}

