#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "LATAA PELI"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Lataa peli" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.
	
	key[]: "load_game_failed"
	val[]: "Tallennuksen lataaminen epäonnistui."

	key[]: "load_game_desc"
	val[]: "Lataa aiemmin tallennettu peli. Nykyinen edistymisesi jää tallentamatta!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Oletko varma, että haluat ladata toisen pelin?<br><br>Kaikki tallentamaton edistyminen menetetään."

	key[]: "load_progress_lost_mp"
	val[]: "Haluatko varmasti ladata toisen pelin?<br>Pelin lataaminen moninpelissä saattaa johtaa työn peruuntumiseen tai keskeytymiseen, lähimpään huoltoon siirtymiseen tai että valittu työ ei ole suoritettavissa.<br><br>Menetät edistymisesi jos et ole tallentanut aikaisemmin."

	key[]: "load_game_mp_suspended_job"
	val[]: "Peli ladattiin onnistuneesti, mutta aktiivinen World of Trucks työsi on keskeytetty, etkä voi jatkaa sitä tämän istunnon aikana."

	key[]: "autosave"
	val[]: "- Automaattitallennus -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Pikatallennus -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Näytä automaattiset tallennukset" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Käsin tehtyjä tallennuksia ei löytynyt." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Lataa" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Yhteensopimaton tallennus!<br><color value=@@clr_txt@@>Koeta päivittää peli uusimpaan saatavilla olevaan versioon." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Kaikkien tämän profiilin tallennusten lataaminen ja näyttäminen epäonnistui." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "HUOMIO" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Virhe ladattaessa tallennusta.<color value=@@clr_txt@@><br><br>Tallennuksen lataus epäonnistui. Voit yrittää tunnistaa sekä mahdollisesti korjata virheen käyttämällä alla olevia tietoja. Vaihtoehtoisesti voit koettaa ladata toisen tallennuksen.<br><br>Seuraavat syyt aiheuttavat yleisimmin ongelman:<br><br>1. Tallennus on yhteensopimaton joidenkin asennettujen modien kanssa.<br><br>2. Tallennus sisältää tietoja modista, joka puuttuu tai on poistettu käytöstä.<br><br>3. Tallennus on korruptoitunut huonosti toteutetun modin takia.<br><br>4. Tietokoneen kaatuminen tallennusprosessin aikana tai juuri sen jälkeen voi aiheuttaa tallennuksen korruptoitumisen."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Puuttuva MODI havaittu.<color value=@@clr_txt@@><br><br>Viimeisin tallennus sisältää riippuvuuksia puuttuvaan tai käytöstä poistettuun modiin.<br><br>Jos tämä ei ole odotettua, ole hyvä ja tarkista modien tila.<br><br>Muussa tapauksessa voit koettaa ladata tallennuksen. Riippuen poistettujen modien vaikutuksesta tallennuksen lataus saattaa kuitenkin epäonnistua tai aiheuttaa muita ongelmia.<br><br>Vaihtoehtoisesti voit koettaa ladata toisen tallennuksen, joka ei ole riippuvainen puuttuvista modeista."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Löydetty puuttuva valinnainen DLC<color value=@@clr_txt@@><br><br>Viimeisessä tallennuksessa on riippuvuuksia DLC:stä (virallinen pelin laajennus).<br><br>Mikäli et ole poistanut DLC:tä, ole hyvä ja tarkista laajennuksien asennukset.<br><br>Muussa tapauksessa voit ladata tallennuksen, mutta huomaa, että osa DLC:n toiminnallisuuksista voi hävitä.<br><br>Vaihtoehtoisesti voit yrittää ladata jonkin toisen tallennuksen joka ei sisällä riippuvaisuuksia puuttuvasta DLC:stä."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Puuttuva lisäsisältö (DLC) havaittu.<color value=@@clr_txt@@><br><br>Viimeisin tallennus sisältää riippuvuuksia puuttuvaan lisäsisältöön (virallinen pelilaajennus).<br><br>Jotta tämä tallennus toimisi oikein, puuttuva lisäsisältö pitää olla ladattuna sekä aktivoituna tällä tietokoneella.<br><br>Vaihtoehtoisesti voit koettaa ladata toisen tallennuksen, joka ei ole riippuvainen puuttuvasta lisäsisällöstä."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Modi on riippuvainen ladattavasta lisäsisällöstä (DLC).<color value=@@clr_txt@@><br><br>Ainakin yksi modi on riippuvainen ladattavasta lisäsisällöstä (DLC - virallinen pelilaajennus), joka ei ole tällä hetkellä asennettuna.<br><br>Sinun pitää poistaa modit tai asentaa tarvittavat DLC:t."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Kaatuminen havaittu<color value=@@clr_txt@@><br><br>Peli on ilmeisesti kaatunut edellisen latauksen aikana.<br><br>Voit yrittää tunnistaa sekä mahdollisesti korjata ongelman käyttämällä alla olevia tietoja. Vaihtoehtoisesti voit koettaa ladata toisen tallennuksen.<br><br>Seuraavat syyt aiheuttavat yleisimmin ongelman:<br><br>1. Yksi tai useampi asennetuista modeista on yhteensopimaton pelin tämänhetkisen version kanssa.<br><br>2. Tallennus sisältää tietoja modista, joka puuttuu tai on poistettu käytöstä.<br><br>3. Tallennus on korruptoitunut huonosti toteutetun modin takia.<br><br>4. Joskus laite- tai ajuriviat voivat kaataa pelin."

	key[]: "mods_detected_warning"
	val[]: "Modeja havaittu. Huomioi, että rikkinäiset, vanhentuneet tai yhteensopimattomat modit voivat olla lähde pelin epävakaudelle. Ole hyvä ja tarkista aktiivisena olevat modit modien hallinnasta." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

