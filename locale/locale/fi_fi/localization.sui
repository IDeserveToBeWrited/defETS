	key[]: "eye_head_roll_op_tooltip"
	val[]: "Kun tämä on valittuna, käännetään pelin kameraan sen mukaan, miten käännät päätäsi puolelta toiselle."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Kerroin yhdistetylle pään ja katseen vaakasuuntaiselle käännölle (ohjaamossa)."

	key[]: "eye_pitch_scale_op_tooltip"
