#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Määrittelee ohjaimen alatyypin, jotta syöttöalueet käsitellään oikein."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Valitsee vaihteiston tyypin:<br>- \"Yksinkertaistettu automaatti\" tarkoittaa, että kaasua ja jarrua käytetään kuorma-auton liikuttamiseen eteen- ja taaksepäin.<br>- \"Todellinen automaatti\" tarkoittaa, että sinun tulee vaihtaa suuntaa erillisestä napista.<br>- \"Sekventiaali\" vaatii vaihteiden vaihtamisen manuaalisesti ylös/alas-painikkeilla.<br>- \"H-vaihdekaavio\" vaatii vaihteisto-ohjaimen, jolla jokainen vaihde valitaan manuaalisesti."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Muuttaa automaattivaihteiston vaihteenvaihtologiikkaa:<br>- \"Taloudellinen\" -tila suosii matalien kierrosten huippuvääntöä.<br>-\"Teho\" -tila antaa kierrosten nousta korkeammalle, jolloin saavutetaan parempi suorituskyky bensankulutuksen kustannuksella vedettäessä raskaita kuormia tai ajettaessa mäkisessä maastossa."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Säätää ohjainlaitteen ja ajoneuvon kääntöasteen suhdetta."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Säätää syötteen ja ajoneuvon kääntymisen välistä lineaarisuutta.<br><br>Suurempi arvo tarkoittaa, että ohjausvaste heikompi kun ratti on keskitetty ja käännettäessä rattia kohti ääriasentoa, herkkyys suurenee. Tämä saattaa helpottaa tasoittamaan ohjausliikkeitä suoraan ajettaessa."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Kytkee päälle force feedbackin sitä tukevissa ohjaimissa."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Säätää force feedbackin vahvistusta 0N ja 10N välillä.<br><br><color value=@@clr_txt_d@@>Huomaa, että säätämällä asetusta korkeaksi voimakkailla rungoilla saatat loukata sormesi tai kätesi."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Määritteleen ratin keskitysvoimaa ajettaessa suurella nopeudella; keskitysvoima on voimakkaimmillaan 90 km/h (56 mph) ja sitä suuremmissa nopeuksissa.<br><br>Pienin asetus poistaa keskitysvoiman kokonaan."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Määrittelee ratin keskitysvastuksen ajettaessa alhaisella nopeudella.<br><br>Pienin asetus tarkoittaa, että keskitysvastusta ei ole ollenkaan."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Määrittelee keinotekoisen mekaanisten ohjauskomponenttien aiheuttaman sisäisen kitkan voimakkuuden."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Säätää keinotekoisen moottoriresonoinnin voimakkuutta.<br><br><color value=@@clr_txt_d@@>Huomaa, että jos säädät arvon yli 15%, saattaa joidenkin rattiohjainten kanssa esiintyä liiallista ravistusta ja tärinää."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Säätää tienpinnan aiheuttaman tärinän voimakkuutta.<br><br><color value=@@clr_txt_d@@>Huomaa, että jos säädät arvon yli 20%, saattaa joidenkin rattiohjainten kanssa esiityä liiallista ravistusta ja tärinää ajettaessa kovaa vauhtia epätasaisella pinnalla."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Säätää tärinän voimakkuutta töyssyissä."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Säätää tärinän voimakkuutta törmäyksissä."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Säätää vaihteiston hammasrattaiden rahinatehosteiden voimakkuutta."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Säätää aliohjautumisesta johtuvan luiston tehosteiden voimakkuutta."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Säätää avustetun ohjauksen voimakkuutta esimerkiksi käytettäessä kaistavahti-toimintoa."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Säätää tien pinnoista aiheutuvan tärinän voimakkuutta, mikäli ohjain tukee tärinätehosteita."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Säätää töyssyistä aiheutuvan tärinän voimakkuutta, mikäli ohjain tukee tärinätehosteita."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Säätää törmäyksistä aiheutuvan tärinän voimakkuutta, mikäli ohjain tukee tärinätehosteita."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Laitteen akseli, jota käytetään ohjaukseen."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Säätää ohjausakselin kuollutta aluetta; käännöksen suuruutta keskikohdasta, josta syötettä ei rekisteröidä.<br><br>Tällä voidaan vähentää vanhempien ohjainten kulumisesta aiheutunutta epätarkkuutta ja väärää syöttötietoa."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
