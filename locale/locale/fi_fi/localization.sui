	key[]: "save_game_reset"
	val[]: "Muutos pelissä havaittu! Parhaan yhteensopivuuden takaamiseksi pelitallennuksen kanssa, toimitukset, jotka olivat keskeneräisiä on peruttu kustannuksia aiheuttamatta." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Muutos pelissä havaittu!<br><br>Parhaan yhteensopivuuden takaamiseksi pelitallennuksen kanssa, toimitukset, jotka olivat keskeneräisiä on peruttu kustannuksia aiheuttamatta. Kuorma-autosi on pysäköitävä turvalliseen sijaintiin.<br><br>Valitse pikamatkustuskohde jatkaaksesi." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Tallennetaan..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Ohittaaksesi välianimaatio paina $KEY$." #+ Shown when any key was pressed during viewpoint cutscene.

