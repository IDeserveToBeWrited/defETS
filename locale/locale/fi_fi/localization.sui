#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Tarvittava DLC (virallinen pelilaajennus) $DEPENDENCY_NAME$ puuttuu. Ladataksesi pelitallennuksen onnistuneesti DLC:n tulee olla asennettuna tietokoneellasi ja aktiivinen. Korjaa ongelma ladataksesi tämä tallennus." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Valinnainen DLC (virallinen pelilaajennus) $DEPENDENCY_NAME$ puuttuu. Mikäli et odottanut tätä ilmoitusta, tarkista DLC:n tila.<br><br>Muussa tapauksessa voit ladata pelitallennuksen, tällöin kuitenkin jotkin DLC:n tarjoamat toiminnallisuudet saattavat puuttua." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modi $DEPENDENCY_NAME$ puuttuu tai ei ole käytössä. Tarkista modin tila mikäli et odottanut tätä ilmoitusta. Voit koettaa ladata tallennuksen. Kuitenkin riippuen modin tekemistä muutoksista on mahdollista, että tallenuksen lataaminen epäonnistuu tai aiheuttaa muutoin ongelmia." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modi $DEPENDENCY_NAME$ ei ole yhteensopiva käyttämäsi peliversion kanssa. Tämä tarkoittaa sitä, että modin kehittäjä on asettanut sen toimimaan vain tiettyjen peliversioiden kanssa ja käyttämäsi versio ei ole niiden joukossa.<br><br>Vaihtoehdot:<br>- Yritä löytää ajantasainen versio modista joka sopii käyttämääsi peliversioon.<br>- Päivitä peli uuteen tai asenna vanhempi, modin kanssa yhteensopiva versio.<br><br>Voit kuitenkin yrittää ladata tallennuksen. Modia ei joka tapauksessa tulla lataamaan käynnistyksen yhteydessä ja riippuen modin tekemistä muutoksista on mahdollista, että tallenuksen lataaminen epäonnistuu tai aiheuttaa muutoin ongelmia." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "PUUTTUVAT TIEDOSTOT" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "YKSITYISKOHDAT" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Avaa Workshop-sivu"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Tämä tallennus on riippuvainen puuttuvasta ladattavasta lisäsisällöstä (DLC) tai modeista, jotka näet listattuna alla. Valitsemalla listasta saat lisätietoja puuttuvasta sisällöstä." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Tämä tallennus on riippuvainen ainakin yhdestä DLC:stä tai modista. Sinun tulee korjata ongelma ennen kuin voit ladata tallennuksen." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Keskeytä lataus" #+ Abort loading button.

	key[]: "type"
	val[]: "Tyyppi" #+ Type column.

	key[]: "dependency_name"
	val[]: "Tiedoston nimi" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Paikallinen modi" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop modi" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Valinnainen DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Tarvittava DLC" #+ DLC that is required to load save that is depending on it.
