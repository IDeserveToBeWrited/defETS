#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Kuvankaappaustiedosto on liian iso. Ole hyvä ja koeta pienentää näyttöresoluutiota." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Kuvankaappaustiedosto on korruptoitunut tai sitä ei tueta." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Kuvankaappauksen resoluutio on liian suuri. Ole hyvä ja koeta pienentää näyttöresoluutiota." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Palvelu hylkäsi kuvankaappauksen." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Tältä tililtä ei ole sallittu kuvankaappausten lataamista." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Yhteen kansioon oli useampi samanaikainen lataus." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Lataaminen on tällä hetkellä pois käytöstä. Ole hyvä ja yritä myöhemmin uudelleen." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Tuntematon virhe ladattaessa. Ole hyvä ja yritä myöhemmin uudelleen." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Kuvankaappauksen koko on suurempi kuin $LIMIT$ sallittu maksimikoko, joten sitä pienennettiin." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Kuvankaappauksen koko on suurempi kuin $LIMIT$KB sallittu maksimikoko, joten sitä pienennettiin." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

