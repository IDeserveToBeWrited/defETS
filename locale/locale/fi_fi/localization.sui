	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Liikuta @@ima_wiz_j_throttle@@ eteenpäin ajaaksesi eteenpäin ja liikuta sitä taaksepäin peruuttaaksesi."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Käytä @@ima_wiz_j_throttle@@ ajaaksesi eteenpäin ja @@ima_wiz_j_brake@@ peruuttaaksesi."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Käytä @@imm_wiz_dforward@@ kiihdyttääksesi ja käytä @@imm_wiz_dbackward@@ jarruttaaksesi."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Liikuta @@ima_wiz_j_throttle@@ kontrollia eteenpäin kiihdyttääksesi ja takaisin jarruttaaksesi."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Käytä @@ima_wiz_j_throttle@@ kiihydyttääksesi ja @@ima_wiz_j_brake@@ jarruttaaksesi."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Paina @@imv_wiz_gearup@@ vaihtaaksesi vaihdetta isommalle ja @@imv_wiz_geardown@@ vaihtaaksesi alemmas."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Paina @@imv_wiz_gearup@@ vaihtaaksesi vaihdetta isommalle ja @@imv_wiz_geardown@@ vaihtaaksesi alemmas, jos käytössäsi on näppäimistö tai ohjaimen painikkeet. Käytä @@imv_wiz_drive@@ ja @@imv_wiz_reverse@@ valitaksesi ajosuunta, jos käytössäsi on H-kaaviollinen vaihdin."

