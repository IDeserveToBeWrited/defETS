#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Baigiamasis egzaminas (2 dalis)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Laukia paskutinė baigiamojo egzamino dalis, kurioje įvertinsime anksčiau išmoktus parkavimo manevrus. Parkuok atidžiai ir tiksliai, ir galėsi traukti į Europos kelius!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manevras greta"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Įstrižas parkavimas"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Važiavimas aikštele"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Lygiagretus parkavimas"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Galutinis parkavimas"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Sveikiname antroje baigiamojo egzamino dalyje. Važiuosime į aikštelę netoliese ir išbandysime tavo parkavimo įgūdžius."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Tavo gebėjimai bus patikrinti keliuose parkavimo iššūkiuose."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Erdvės čia nedaug, todėl vairuok atidžiai ir neskubėk."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Atmink neskubėti. Nieko tokio, jei nepavyks pastatyti sunkvežimio iš pirmo karto, svarbiausia nepadaryti žalos sunkvežimiui ir kitiems aplink tave.<font face=/font/big_bold.font><br><br>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Važiuok į pirmą egzamino dalį.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tavo pirma užduotis yra pademonstruoti parkavimą ne tiesia linija. Vieta, kur reikia įvažiuoti su priekaba, yra kairėje.<br><br><font face=/font/big_bold.font>Atbulai įvažiuok į parkavimo vietą.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Kita užduotis - atbulai įvažiuoti tarp stovinčių sunkvežimių. Atsargiai, nepaliesk kitų sunkvežimių!<br><br><font face=/font/big_bold.font>Atlik įstrižo parkavimo manevrą.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Toliau važiuok aikštele. Saugokis netikėtų situacijų.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Dabar pabandykime lygiagretų parkavimą tarp dviejų sunkvežimių prie šaligatvio priekyje.<br><br><font face=/font/big_bold.font>Atlik lygiagretaus parkavimo manevrą.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Liko paskutinis parkavimo manevras! Gali pasirinkti būdą, kaip jį atlikti.<br><br><font face=/font/big_bold.font>Atbulai įvažiuok į pažymėtą vietą.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Beveik viskas. Išvažiuok iš bandymų zonos ir pastatyk sunkvežimį.<br><br><font face=/font/big_bold.font>Išvažiuok iš bandymų zonos į kairę.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Gali sustoti dešinėje, prie kitų sunkvežimių.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Lygiagretus parkavimas su priekaba"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "Šiame scenarijuje išbandysime lygiagretų parkavimą su priekaba."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Sustojimas pažymėtoje vietoje"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Lygiagretus parkavimas su priekaba yra visiems vairuotojams reikalingas įgūdis.<br>To gali prireikti tiek parkuojant gatvėje dideliame mieste, tiek stojant poilsio aikštelėje už miesto, ir tai turėtų mokėti kiekvienas vairuotojas."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Pravažiuodamas parkavimo vietą atidžiai įvertink, ar joje pakaks vietos vilkikui su priekaba. Čia mes užtikrinome, kad vietos užtektų."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Sustok prieš stovėjimo vietą. Nebūk per arti, kad turėtum laisvės manevravimui."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Staigiai pasuk nuo parkavimo vietos ir pajudėk atbulai. Reikia, kad priekaba įsuktų į stovėjimo vietą iš karto."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Kai priekaba įsuks į vietą, galėsi pradėti sekti ją."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Pradėk sukti priekabą nuo šaligatvio kol vairuotojo pusės priekabos ratai nepasiekė vietos."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Ištiesink vilkiką su priekaba ir atsistok stovėjimo vietos viduryje.<br>Sustok, įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Priekyje matai stovėjimo vietą tarp kitų sunkvežimių. Parkuojant reikia nuolat stebėti veidrodėlius ir išlaikyti saugų atstumą tarp sunkvežimio ir kliūčių aplink.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Judėk aikštele kol rasi vietą.<br><br><font face=/font/big_bold.font>Važiuok pirmyn.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Pravažiuok stovėjimo vietą į pažymėtą vietą. Iš jos galėsi pradėti važiavimą atbulai.<br><br><font face=/font/big_bold.font>Sustok pažymėtoje vietoje.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Pasuk vilkiką nuo stovėjimo vietos ir pradėk sukti priekabą į ją. Nesuk per staigiai, nes važiuosi tiesiai į šaligatvį.<br><br><font face=/font/big_bold.font>Pradėk judėti atbulai.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Ištiesink sunkvežimį su stovėjimo vieta. Jei reikia, pavažiuok pirmyn ar atgal reguliuojant savo padėtį.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Sveikiname, sėkmingai atliktai Sunkvežimio valdymo pagrindų egzaminus, ir išmokai visų įgūdžių, reikalingų tinkamai valdyti sunkvežimį."

	key[]: "aca_msg_book1_outro02"
	val[]: "Tai pirmas žingsnis kelyje į svajonę tapti profesionaliu sunkvežimio vairuotoju."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Tu pasiruošei keliauti į Europos kelius ir stoti prieš pirmus iššūkius..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...bet nuotykiai tik prasideda."
#@}


