	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ nesiekia pakeisti mokymų tikrame sunkvežimyje.</font><br><br><color value=@@clr_txt@@>Prieš bandant vairuoti sunkvežimį tikrame gyvenime, griežtai rekomenduojame pasimokyti tikroje vairavimo mokykloje.<br><br>Mokyklos, norinčios pasinaudoti @@driving_academy@@ papildant savo mokymus, gali susisiekti su mumis academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Sunkvežimio vairavimo pagrindai"

	key[]: "aca_book_book1_desc"
	val[]: "Išmok sunkvežimio vairavimo pagrindus, nuo pagrindinių funkcijų ir valdymo iki manevravimo su priekaba."

	key[]: "aca_book_book2_title"
	val[]: "Sunkvežimio vairavimo tobulinimas"

	key[]: "aca_book_book2_desc"
