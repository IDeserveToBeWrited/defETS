	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Jūsų priekyje yra barjeras. Privažiuok prie jo ir sustok."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Už sunkvežimio vairuotojo pusėje yra dar vienas barjeras. Važiuok atbulai posūkiu iki jo. Kelią parodys kelio žymėjimas."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Tiesiai priekyje yra staigus 90 laipsnių posūkis. Važiuok link jo."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Reikės giliai įvažiuoti į posūkį, kad galiniai ratai neužkliūtų už kūgių posūkio viduje.<br>Naudok veidrodėlius!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Ištiesink sunkvežimį, važiuok prie paskutinio barjero, sustok ir išjunk variklį."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Pasiruošk važiuoti. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Sunkvežimis dar neparuoštas judėti, gal kažką pamiršai?<br><br>Ar variklis užvestas? Ar stovėjimo stabdis išjungtas?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Tiesiai priekyje yra pažymėta vieta prieš pat barjerą.<br><br><font face=/font/big_bold.font>Važiuok priekin ir sustok pažymėtoje vietoje. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Pažiūrėk atgal, vairuotojo pusėje. Ten pamatysi dar vieną pažymėtą vietą. Turėsi ir važiuoti atbulai, ir įveikti posūkį.<br><br><font face=/font/big_bold.font>Važiuok atbulai posūkiu ir sustok pažymėtoje vietoje. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Toliau trasoje - 90 laipsnių posūkis.<br><br>Lik vairuotojo pusėje iki posūkio, važiuok giliai į posūkį ir tada pasuk greitai ir staigiai. Stebėk, kad neužvažiuotum už kūgio posūkio kampe.<br><br><font face=/font/big_bold.font>Važiuok priekin ir įveik posūkį. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Naudok priekinį ir šoninius veidrodėlius, kad stebėtum, ar nieko nepaliesi.<br><br><font face=/font/big_bold.font>Įveik posūkį ir sustok nurodytoje vietoje. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Išjunk variklį.</font>"
#@}

