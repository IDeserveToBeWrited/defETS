	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Gali pasirodyti, kad važiavimas atbulai tiesiai yra lengvas, tačiau iš tikrųjų tai daug sunkiau.<br><br>Užuot tik didinę arba mažinę kampą tarp priekabų vienoje pusėje, dabar turite dirbti abiejose pusėse, kad junginys būtų tiesus."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Pradėk nuo gana nedidelių korekcijų. Nieko tokio, jei galiausiai pradėsi vingiuoti į abu puses, tik nepamiršk, kad reikia išlaikyti kampą tarp sunkvežimio ir priekinės priekabos ilgiau, jei nori pakeisti kampą tarp abiejų priekabų."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Gali tekti atlikti gana didelius manevrus su vilkiku, kad galinė priekaba būtų nukreipta ten, kur nori, bet tiesiog stenkis iš pradžių nepersistengti, ir to neprireiks."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Gali pasitaisyti tiek kartų, kiek reikia. Svarbu saugiai pastatyti automobilį į reikiamą vietą, visa kita – nesvarbu."

#### Straight Backing Driving Instructions

