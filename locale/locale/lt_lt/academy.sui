	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Šiame scenarijuje išmoksime apsisukti mažoje erdvėje su atbulu manevru akloje pusėje. Šis įgūdis pravers, kai negalėsi apsisukti vairuotojo pusėje."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Kelio žymėjimai padės įveikti trasą."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Suk plačiai, kad priekaba neužkliudytų stovinčių sunkvežimių."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Išvažiuojant įvertink, kaip paruoši sunkvežimį judėjimui atbulai."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Bus lengviau, jei sunkvežimis bus nukreiptas kampu į tuščia stovėjimo vietą keleivio pusėje, į kurią važiuosi atbulai."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Važiavimo atbulai akloje pusėje reiktų vengti, nes jis gerokai sudėtingesnis dėl prasto matomumo. Deja, pasitaiko atvejų, kai nebūna kito pasirinkimo."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Pasuk vairą prieš pajudėdamas atbulai. Tai padės iš karto nukreipti priekabą norima kryptimi, o tai naudinga mažoje erdvėje."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Kai priekaba įvažiuos į vietą, pasuk vilkiką prieš priekabą."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Sustok kai išsitiesinsi ir pakaks vietos pajudėti priekin. Pradėk judėti ta pačia kryptimi, iš kur atvažiavai."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Sek kelio žymėjimais išvažiuojant iš trasos."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Važiuok posūkiu priekyje į nurodytą vietą."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Sustojimas."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Priekyje yra trasa, vaizduojanti krovinių kompanijos aikštelę. Tavo užduotis - važiuoti ten, apsisukti ir vėl išvažiuoti. Gerai išnaudok visą turimą erdvę.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Važiuok į trasą.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Pasuk ir toliau važiuok trasa.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Laikykis kelio žymėjimų iki barjero gale. Sustok šiek tiek mampu, kad priekaba jau būtų nukreipta į tuščią stovėjimo vietą keleivio pusėje.<br><br><font face=/font/big_bold.font>Tęsk.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Akloje pusėje matysi gerokai mažiau. Važiuok atidžiai, žiūrėk į veidrodėlius ir neskubėk.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai ir įsuk priekabą į tuščią stovėjimo vietą.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Pakankamai toli. Dabar gali važiuoti priekin ir išvažiuoti iš aikštelės ten, iš kur atvažiavai.<br><br><font face=/font/big_bold.font>Judėk link išvažiavimo.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Išvažiuok iš trasos.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Laikykis kelio žymėjimų iki galutinės stovėjimo vietos.<br><br><font face=/font/big_bold.font>Važiuok į nurodytą vietą.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Kreivas manevras atbulai"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Šiame scenarijuje turėsi atbulai įvažiuoti į parkavimo vietą, kuri nėra tiesiai už tavęs. Manverui vietos nėra daug, todėl reikia elgtis išmintingai."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Šiame scenarijuje reikia sustoti vietoje greta. Vietos manevrui nėra daug, todėl reikės padirbėti, kad priekaba atsidurtų ten, kur reikia."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Važiuok tiesiai prie barjero."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Sustok prieš barjerą."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Dar prieš pajudant susuk vairą į vairuotojo pusę. Taip pradėsi sukti priekabą į stovėjimo vietą kai tik pajudėsi, taip sutaupysi vertingos vietos."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Kai priekaba bus nukreipta ten, kur reikia, pasuk vilkiką prieš priekabą ir pradėk vairuoti ją į stovėjimo vietą."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Nuo šios vietos padėtis tokia pat, kaip įprastame parkavimo manevre."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Važiuok atbulai ir stebėk abi puses. Išlygink vilkiką ir priekabą pagal stovėjimo vietą."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Esi stovėjimo vietoje, bet yra kita stovėjimo vieta tavo dešinėje, į kurią reikia pervažiuoti.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Priekyje yra pažymėta vieta.<br><br><font face=/font/big_bold.font>Važiuok pirmyn.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Atmink sukti vairą iš karto, nes vietos nedaug.<br><br><font face=/font/big_bold.font>Atbulai važiuok į už tavęs pažymėtą vietą.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Važiavimas paprastais posūkiais"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Šiame scenarijuje laukia neilgas važiavimas trasa, kai geriau išmoksi įveikti paprastus 90 laipsnių posūkius."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Pirmas posūkis"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Antras posūkis"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Trečias posūkis"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Priekyje yra staigūs posūkiai su nedaug vietos. Tai padės išmokti tau efektyviai manevruoti priekaba,."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Laikykis kelio žymėjimų iki barjero vairuotojo pusėje ir pasiruošk pirmam posūkiui."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Visame posūkyje laikykis arti išorinio barjero ir priekaba turėtų gražiai įveikti trasą."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Toliau sek kelio žymėjimais ir pasiruošk antram posūkiui - siauram 90 laipsnių posūkiui."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Turėsi giliau įvažiuoti į posūkį, kad priekaba neužkabintų vidinių barjerų. Naudokis priekiniu veidrodėliu įvažiuoti kiek galima toliau nieko nepaliečiant."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Toliau važiuok prie išorinio barjero."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Dar vienas siauras 90 laipsnių posūkis pareikalaus išnaudoti visą erdvę."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Atmink išnaudoti visą erdvę kiekviename posūkyje.<br><br><font face=/font/big_bold.font>Pajudėk ir laikykis kelio žymėjimų.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Sek išorinį barjerą, bet veidrodėlyje stebėk priekabą.<br><br><font face=/font/big_bold.font>Įveik pirmą posūkį.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Laikykis kelio žymėjimų ruošiantis 90 laipsnių posūkiui priekyje.<br><br><font face=/font/big_bold.font>Įveik 90 laipsnių posūkį.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Po posūkio lik plačiai, nes laukia dar siauresnis 90 laipsnių posūkis.<br><br><font face=/font/big_bold.font>Tęsk.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Važiuok į stovėjimo vietą priekyje.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Įstrižas parkavimas atbulai"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Šiame scenarijuje nagrinėsime įstrižą parkavimą atbulai. To prireikti poilsio aikštelėse ar net kompanijose. Dažnai vietos būna mažai dėl kitų sunkvežimių, todėl parkuoti bus dar sunkiau dėl erdvės stokos."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Priekabos pasukimas"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Įstrižas parkavimas iš pirmo žvilgsnio atrodo paprastesnis, bet dažnai jis gali būti sudėtingesni už įprastus manevrus."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Važiuok atbulai link parkavimo vietos. Kol kas važiuok tiesiai."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Kai priartėsi, tegu priekaba artėja prie stovinčių sunkvežimių. Tai padės įsukti į vietą, kai ją pasieksi."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Pradėk sukti priekabą į parkavimo vietą. Laikyk priekabą arti sunkvežimio vairuotojo pusėje, nes prireiks vietos kitoje pusėje."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Kai priekaba nemažai įvažiuos į stovėjimo vietą, pradėk sukti vilkiką."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Pastatyk vilkiką vietoje už tavęs. Naudok abu veidrodėlius stebint kelią.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Patikrink aplinką ir judėk link stovėjimo vietos.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Pradėk sukti priekabą link sunkvežimių greta. Kai pasiruoši, suk priekabą į stovėjimo vietą. Nepamiršk įvertinti priekabos galo mosto.<br><br><font face=/font/big_bold.font>Suk į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Važiavimas atbulai į posūkį"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Šiame scenarijuje pirmą kartą atbulai važiuosime į posūkį. Panagrinėsime važiavimo atbulai principus ir ką reikia stebėti važiuojant atbulai."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Priekabos pasukimas"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Šiame scenarijuje turėsi atbulai nuvažiuoti į stovėjimo vietą už tavęs, vairuotojo pusėje."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Keli patarimai važiuojant atbulai su priekabomis.<br>Pirma - priekaba visada suks priešinga kryptimi, nei suksi vilkiką."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Antra - gali gerai pajausti, kur važiuoja priekaba stebint vilkiko ir priekabos ašis."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Trečia - nedidelės korekcijos vairu viską pasieks, nereiki jo sukti per daug."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Pradėk šiek tiek sukti vilkiką nuo stovėjimo vietos, ir priekaba pasuks į ją."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Sek priekabą, koreguodamas vairu, kad ji liktų teisingame kelyje."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Stebėk priekabos ratus ir viliko galinius ratus. Jie pasakys tau, kur krypsta priekaba ir kur vilkikas ją stumia."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Ketvirtas patarimas - visuomet lengviau pasukti priekabą staigiau, nei išsitiesinti iš \"susiskersavimo\". Taikykis į išorinę vietos dalį kol priartėsi, o tada galėsi pasukti staigiau."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Priekabai įvažiuojant į stovėjimo vietą vilkiką pastatyk prieš priekabą. Stenkis per daug nemanevruoti pačioje stovėjimo vietoje."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Važiuk atbulai tarp barjerų, nuolat stebėdamas abi puses."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Atmink šiuos patarimus sukdamas atbulai su priekaba:<br><br>— Priekaba suka į kitą pusę, nei suki vilkiką<br><br>— Stebėk priekabos ratus norint suprasti, kur ji krypsta<br><br>— Stebėk vilkiko galinius ratus norint suprasti, kur jis stumia priekabą<br><br>— Leisk priekabai viską daryti pačiai, nevairuok per daug<br><br>— Visuomet lengviau staigiau pasukti priekabą, nei ją ištiesinti<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Žiūrėk už savęs, kur reikia važiuoti. Visuomet patikrink aplinką prieš pajudėdamas.<br><br><font face=/font/big_bold.font> Pradėk atbulai važiuoti link stovėjimo vietos. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Pradėk sukti priekabą link stovėjimo vietos ir sek ją.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Atbulas parkavimas mažoje erdvėje"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Šiame scenarijuje turėsi atbulai pastatyti priekabą į stovėjimo vietą judrioje aikštelėje."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Priekabos pasukimas"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Tai dažnas parkavimas sunkvežimiams. Vairuotojai patenka į tokias parkavimo situacijas beveik kasdien.<br>Parkuojant čia reikės atliks kampo manevrą,."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Tai manevras, panašus į ankstesnį scenarijų, bet čia bus mažiau vietos, todėl reikės tinkamai suplanuoti veiksmus."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Kadangi vietos mažiau, tikslūs judesiai svarbesni. Pasuk priekabą tinkamu metu ir stebėk visus ratus, kur jie važiuoja. Atmink priekabos mostą ir pasistenk nesusiskersuoti."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Stenkis laikytis arti sunkvežimio vairuotojo pusėje, tai duos priekabai vietos mostui ir mažiau jaudinsies dėl sunkvežimio keleivio pusėje."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Kai priekaba bus vietoje, pasuk vilkiką prieš ją. Geriau tai padaryti šiek tiek anksčiau nei atrodo. Visada galėsi pasitaisyti važiuodamas į galutinę vietą."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Ištiesink vilkiką ir priekabą ir sustok nurodytoje vietoje."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Dabar pabandysime pasukti priekabą gerokai mažesnėje erdvėje.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Apsidairyk ir rask stovėjimo vietą už tavęs.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai į stovėjimo vietą.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Įsuk priekabą į stovėjimo vietą. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
