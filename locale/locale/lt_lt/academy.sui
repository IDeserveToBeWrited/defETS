	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Šiame scenarijuje sutiksi įvairaus sudėtingumo posūkius. Neprarask dėmesio, važiuok kiekvienai situacijai tinkamu greičiu ir pilnai išnaudok visą erdvę."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Pirmas posūkis bus dvigubas. Turėsi pasiruošti kairiam posūkiui, bet manevro viduryje pereiti į dešinį posūkį."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Kitame posūkyje kirsi barjerą. Tai nelabai sudėtingas manevras, bet reikia palikti pakankamai vietos priekabai."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Toliau laukia siauras slalomas su betoniniais barjerais. Važiuok lėtai ir naudok veidrodėlius, nepamiršk važiuoti plačiai, kad priekaba neužkliūtų."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Toliau bus dar vienas slalomas, su papildomais kūgiais kiekvieno posūkio kampe.<br>Neužkabink nei vieno!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Toliau - keli lengvi posūkiai kelyje link žiedo."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Tiesioje dalyje pasiruošk žiedui. Pasistenk įvažiuoti jo išorėje."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Įvažiuok į žiedą ir stebėk priekabos padėtį. Ji seks kitaip žiede, palyginus su įvažiavimu."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Išvažiuok iš žiedo ir važiuok link kitų posūkių."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "PAŠALINK ŠĮ FILMUKĄ"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Šis posūkis labai staigus. Važiuok lėtai ir protingai išnaudok visą vietą. Įvertink priekabos galo mostą."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Važiuodamas kitais posūkiais nepamiršk išvažiuodamas iš posūkio pasiruošti kitam."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Neskubėk paskutiniame posūkyje. Jis atrodo lengvas, bet čia mažiau vietos manevrui, nei atrodo."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Įsibėgėk link pirmo posūkio. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Pirmas posūkis bus lengvas dvigubas.<br><br><font face=/font/big_bold.font>Įveik posūkį.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "PAŠALINK ŠĮ PATIKRINIMĄ"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Toliau trasa eis kairėje barjero pusėje.<br><br><font face=/font/big_bold.font>Pervažiuok į kitą pusę. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manevruok tarp barjerų ir nepamiršk stebėti priekabos.<br><br><font face=/font/big_bold.font>Važiuok slalomu. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Šis slalomas paprastesnis, bet dėl kūgių jis gerokai siauresnis.<br><br><font face=/font/big_bold.font>Važiuok slalomu ir nekliūdyk kūgių. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Priekyje laukia keli lengvi posūkiai, bet vis tiek reikia tinkamai jiems pasiruošti, kad priekaba nepaliestų vidinių barjerų.<br><br><font face=/font/big_bold.font>Įveik posūkius. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Artėji prie žiedinės sankryžos. Atmink palikti pakankamai vietos priekabai ne tik įvažiuojanti ir išvažiuojant, bet pačiame ir žiede.<br><br><font face=/font/big_bold.font>Važiuok žiedu. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Priekyje neilga tiesi dalis, todėl gali įsibėgėti.<br><br><font face=/font/big_bold.font>Važiuok toliau. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Šis posūkis labai staigus. Važiuok lėtai, išnaudok visą erdvę ir nepamiršk priekabos galo mosto. <br><br><font face=/font/big_bold.font>Įveik staigų posūkį. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Paskutiniai keli posūkiai paprasti. Nepamiršk stebėti priekabos.<br><br><font face=/font/big_bold.font>Tęsk.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Važiuok į stovėjimo vietą.</font>"
