	val[]: "Sunkvežimio išjungimas"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "Šiame scenarijuje vilkiku pasivažinėsime slalomu tarp eismo kūgių."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Važiuok atsargiai ir stebėk aplinką. Stebėk abi sunkvežimio puses, naudok veidrodėlius važiuodamas slalome."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "Trasa vis siaurės, todėl išlaikyk atidumą."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "Šios scenarijaus užduotis - reikia apvažiuoti visus kūgius nepalietus nei vieno. <br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti. </font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Naudok veidrodėlius stebėti abi sunkvežimio puses.<br><br>Keleivio pusėje priekinis ir šoninis veidrodėliai gali labai padėti suprasti savo padėtį.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Jei reikia pareguliuok veidordėlius (\"@@adjust_link_t@@\", pasiekiamas iš pauzės meniu).<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti. </font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "Sunkvežimis dar neparuoštas judėti, gal kažką pamiršai?<br><br>Ar variklis užvestas? Ar stovėjimo stabdis išjungtas?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Lėtai važiuok pirmyn ir per slalomą. </font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Apvažiuok kūgius. Ypatingai stebėk keleivio pusę.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Toliau važiuok slalomu neliesdamas kūgių. </font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje. </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį ir išjunk variklį. </font>"
#@}

