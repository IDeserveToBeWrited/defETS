#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Jungtiniai vairavimo manevrai"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "Šiame scenarijuje sujungsime naujai išmoktus įgūdžius įveikiant trumpą, bet technišką trasą, kurioje reikės atbulai važiuoti į posūkį ir įveikti siaurą 90 laipsnių posūkį."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Važiavimas atbulai vairuotojo pusėje"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "90 laipsnių posūkis"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Posūkio užbaigimas"
