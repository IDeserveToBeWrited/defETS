#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Sveikiname pirmoje baigiamojo egzamino dalyje. Čia pamatysime, kaip gerai išmokai vairuoti sunkvežimį nuo Akademijos pradžios."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Pirma, prikabinsi priekabą. Tada važiuosi sunkvežimiu į užduočių zoną."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Pirma trasos dalis veda nuo nedidelės aikštelės į rytinę trasą."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Joje yra sudėtingi pravažiavimai tarp barjerų."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Didelė maršruto dalis yra rytinėje trasoje."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Išbandysime tavo gebėjimus valdyti sunkvežimį įvairiose situacijose."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Sunkvežimiu įveiksi kelis staigius posūkius."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Įveiksi kelią tarp posūkių."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Paskutinėje dalyje reikės įveikti mažą trasą."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Joje bus sudėtingi keliai ir staigūs posūkiai."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Testo pabaigoje reikės tiksliai pastatyti sunkvežimį."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Jaudintis nereikia, nes jau išmokai visko, ko reikės šiame egzamine.<br><br>Sėkmės!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Priekyje yra priekaba.<br><br><font face=/font/big_bold.font>Važiuok prie priekabos.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Pastatyk vilkiką prieš priekabą.<br><br><font face=/font/big_bold.font>Atbulai privažiuok po priekaba.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Spausk @@imv_nrm_attach@@<font face=/font/big_bold.font> prikabinti priekabą. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Priekaba prikabinta, sunkvežimis paruoštas.<br><br><font face=/font/big_bold.font>Išjunk stovėjimo stabdį.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Pradėk važiuoti link išvažiavimo iš aikštelės.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Laikykis kelio žymėjimų ir saugokis barjerų.<br><br><font face=/font/big_bold.font>Tęsk.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Artėja sudėtingesnė dalis.<br><br><font face=/font/big_bold.font>Atsargiai važiuok tarp barjerų.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Ši dalis patikrins tavo gebėjimus manevruoti su priekaba įvairiuose posūkiuose.<br><br><font face=/font/big_bold.font>Suk į trasą.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Važiuok keliu. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Važiuok tiesiai. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Atsargiai įveik posūkį. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Važiuoji į sudėtingesnę dalį. Atsargiai!<br><br><font face=/font/big_bold.font>Toliau važiuok nuo kalno. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Suk staigiai kairėn. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Išvažiuok iš trasos. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Toliau - lengvesnės dalis.<br><br><font face=/font/big_bold.font>Toliau važiuok nuo kalno. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Važiuok toliau keliu. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Priekyej laukia posūkis į kitą dalį.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Pasuk dešinėn. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Važiuok toliau trasa. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Priekyje bus daugiau staigių posūkių.<br><br><font face=/font/big_bold.font>Tinkamai pasirink greitį. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Pasuk kairėn. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Važiuok į posūkį. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Kad įveiktum posūkį, gali tekti šiek tiek nuvažiuoti nuo kelio.<br><br><font face=/font/big_bold.font>Pasuk atsargiai, panaudok tiek vietos, kiek reikia. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Išvažiuok iš trasos ir važiuok į stovėjimo vietą. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


