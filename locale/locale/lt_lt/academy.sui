	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Dešinys posūkio signalas"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Avarinis signalas"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Valytuvai"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Variklio išjungimas"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "Šiame scenarijuje išbandysime sunkvežimio funkcijas, padedančias geriau matyti tau ir kitiems geriau matyti tave."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Įjungsime įvairias apšvietimo sistemas ir išmoksime, kada jas reikia naudoti."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Mes junginėsime posūkių signalus."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "Ir pagaliau pažiūrėsime, kaip reguliuoti valytuvus, kad jie veiktų efektyviai įvairiuose krituliuose."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Apžvelkime, kaip naudoti įvairų apšvietimą bei valytuvus.<br><br>Artimos ir tolimos šviesos apšviečia kelią priekyje. Posūkių ir avarinis signalai naudojami, kad kiti vairuotojai galėtų suprasti tavo manevrus.<br><br>Valytuvai naudojami nuo priekinio stiklo nuvalyti vandenį ir nešvarumus.<font face=/font/big_bold.font><br><br>Užvesk variklį, bet neišjunk stovėjimo stabdžio. </font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Iki šiol naudojai tik dienos žibintus. Jie automatiškai įsijungia įjungus degimą ir naudojami normaliomis sąlygomis. Tačiau dabar, kai oro sąlygos pablogėjo, reikia įjungti visas šviesas.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_light@@ įjungti gabaritų šviesas. </font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>Gabaritų šviesos tai priekiniai, šoniniai ir galiniai žymekliai. Jie naudojami, kai sunkvežimis stovi prastai apšviestoje vietoje, kad būtų matomas kitiems vairuotojams.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_light@@ įjungti artimas šviesas. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>Artimos šviesos apšviečia kelią priekyje bei pagerina tavo sunkvežimio matomumą tamsoje.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_hblight@@ įjungti tolimas šviesas. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>Tolimos šviesos leidžia tamsoje pamatyti kelią toliau.<br><br>Tačiau reikia atminti, kad jos gali apakinti kitus vairuotojus, ypač atvažiuojančius iš priekio. Artėjant prie kitų vairuotojų būtinai reikia jas išjungti.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_hblight@@ išjungti tolimas šviesas. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Dabar pakalbėkime apie posūkių signalus. Posūkių signalų tikslas parodyti kitiems eismo dalyviams, kad nori persirikiuoti ar pasukti.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_lblinker@@ įjungti kairį posūkio signalą. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Pastebnėis, kad prie prietaisų mirksi kairio posūkio signalo lemputė. Taip pat mirksi posūkio signalai kairėje sunkvežimio pusėje.<font face=/font/big_bold.font><br><br>Dabar spausk @@imv_nrm_lblinker@@ išjungti kairį posūkio signalą. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Posūkio signalus, rodančius krypties pakeitimą, turi būti įjungti pakankamai anksti, kad kiti eismo dalyviai galėtų pasiruošti tavo manevrui ir atitinkamai pakeisti savo vairavimą.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_rblinker@@ įjungti dešinį posūkio signalą. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>Dabar prie prietaisų mirksi dešinys posūkio signalas. Tuo pat metu mirksi posūkio signalai dešinėje sunkvežimio pusėje.<font face=/font/big_bold.font><br><br>Dabar spausk @@imv_nrm_rblinker@@ išjungti dešinį posūkį signalą. </font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>Avarinio signalo mygtukas pažymėtas raudonu trikampio simboliu. Šis signalas yra svarbi kelių saugumo dalis ir turi būti naudojamas tik tada, kai būtina. Ši funkcija įjungia abiejų posūkių signalus vienu metu.<font face=/font/big_bold.font><br><br> Spausk @@imv_nrm_flasher4way@@ įjungti avarinį signalą.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Dabar mirksi abiejų posūkių lemputės prietaisuose ir abiejose sunkvežimio pusėse.<br><br>Avarinis signalas paprastai naudojamas, kai sunkvežimis sustoja ten, kur paprastai nestovi, pavyzdžiui pakelėje, dėl techninio ar mechaninio gedimo. Taip pat jais galima perspėti vairuotojus apie priekyje sustojusį eismą.<font face=/font/big_bold.font><br><br>Dabar spausk @@imv_nrm_flasher4way@@ išjungti avarinį signalą. </font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Dabar pakalbėkime apie valytuvus. Valytuvai pašalina nuo lango lietų ir kitus nešvarumus. Pagrindinė jų užduotis - kad langas būtų švarus ir skaidrus. Valytuvai turi kelis greičius.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_wipers@@ nustatyti valytuvus į veikimą su pauzėmis. </font>@@aca_goal_tip@@ Karjeroje galima naudoti automatinį lietaus daviklį, kuris automatiškai įjungia valytuvus pradėjus lyti. Jį galimarasti Nustatymuose - Žaidimas - @@rain_sensor@@."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Šis nustatymas leidžia valytuvams veikti su pertraukomis. Tai naudinga, kai lyja labai silpnai.<br><br>Kaip matai, lietus per stiprus, ir valytuvai nespėja nuvalyti viso vandens.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipers@@ dar kartą perjungti valytuvus į mažo greičio nustatymą. </font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Dabar valytuvai veikia pastoviu greičiu.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipers@@ dar kartą įjungti didelio greičio nustatymą. </font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "Matai, kad valytuvai dabar veikia gerokai greičiau. <font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipers@@ išjungti valytuvus. </font>@@aca_goal_tip@@ Taip pat gali naudoti funkciją @@o_im_wipers_back@@ perjungti valytuvų ciklą atgal. Atitinkamą klavišą rasti ar nustatyti gali Nustatymuose, skyriuje \"@@options_bindings_screen@@\"."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Dabar valytuvai veikia daug greičiau maksimaliai valydami stiklą.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipersback@@ kelis kartus, kol valytuvai išsijungs.</font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Išjunk šviesas ir išjunk variklį. </font>"
#@}

#+ Book 1 Scenario 2_01
#@{

#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Slalomas tarp kūgių"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "Šiame scenarijuje išmoksime manevruoti sunkvežimiu aplink eismo kūgius, padedant veidrodėliams."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Nurodymų laikymasis"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Veidrodėlių patikrinimas"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Pradžia"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "Sunkvežimio vairavimas"



	key[]: "aca_goal_book1_2_01_check1"
	val[]: "Slalomo pradžia"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "Eismo kūgių vengimas"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "Zigzagai tarp kūgių"
