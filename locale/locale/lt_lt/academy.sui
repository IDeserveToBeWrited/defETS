	key[]: "aca_book_book3_title"
	val[]: "Dvigubos priekabos valdymas"

	key[]: "aca_book_book3_desc"
	val[]: "Imkis įdomių iššūkių vairuoti pirmyn ir atbulai su dvigubomis priekabomis."

