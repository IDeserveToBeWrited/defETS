#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkavimas netoli kliūties"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Šiame scenarijuje išmoksime sustoti prie šaligatvio naudojantis šoninio vaizdo veidrodėliu."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Šoninio vaizdo veidrodėlio patikrinimas"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Važiavimas prie šaligatvio"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Šoninis veidrodėlis yra dar vienas įrankis, padedantis saugiai manevruoti sunkvežimiu. Jis yra keleivio durų viršuje."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Važiuok priekin ir lėtai pasuk keleivio pusėn."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Šios medinės lentos vaizduoja šaligatvį. Turi sustoti greta jų.<br>Pasuk link šaligatvio ir taikykis į stovėjimo vietą."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Smarkiai sulėtink prieš šaligatvį ir pasuk link stovėjimo vietos. Išsitiesindamas stebėk šoninio vaizdo veidrodėlį nustatydamas atstumą iki šaligatvio."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Sustok stovėjimo vietoje ir išjunk variklį."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Pažiūrėk pro keleivio langą. Ten pamatysi šoninio vaizdo veidrodėlį.</font>@@aca_goal_tip@@ Turi būti sunkvežimio viduje."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Šoninio vaizdo veidrodėlis parodo keleivio pusės zoną, kurios vairuotojas nemato. Tai viena iš problematiškiausių aklų zonų. Jei veidrodėlio kampas tau netinka, gali jį pareguliuoti \"@@adjust_link_t@@\".<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Sunkvežimis dar neparuoštas judėti, gal kažką pamiršai?<br><br>Ar variklis užvestas? Ar stovėjimo stabdis išjungtas?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Priekyje yra lentos, vaizduojančios šaligatvį. Jo pabaigoje yra stovėjimo vieta. Turi ten nuvažiuoti. <br><br><font face=/font/big_bold.font>Važiuok kai pasiruoši. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Pasuk link šaligatvio. Naudok priekinį ir šoninius veidrodėlius nustatydamas savo padėtį, bet taip pat nepervažiuok kūgių.<br><br><font face=/font/big_bold.font>Važiuok prie šaligatvio, į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Išjunk variklį ir įjunk stovėjimo stabdį.</font>@@aca_goal_tip@@ Gali naudoti vidinės kameros valdymo mygtukus lengviau žiūrint į veidrodėlius. Rasti ar pakeisti atitinkamus mygtukus gali Nustatymuose - \"@@options_bindings_screen@@\"."
#@}

