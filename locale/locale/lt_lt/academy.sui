	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Turėtum sugebėti įveikti tai savaankiškai. Neskubėk ir protingai išnaudok erdvė."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Atsargiai išvažiuok iš žiedo."

