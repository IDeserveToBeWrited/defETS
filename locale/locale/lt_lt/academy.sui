#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Lygiagretus parkavimas yra būtinas įgūdis, reikalingas visiems vairuotojams.<br>Pasiruošk važiuoti."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Važiuok į stovėjimo vietą.<br>Stebėk aplinką."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Sustok prieš stovėjimo vietą. Nebūk per arti, kad turėtum laisvės manevravimui."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Staigiai suk link stovėjimo vietos ir pradėk judėti atbulai."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Žiūrėdamas pro keleivio pusės veidordėlį nusitaikyk į šaligatvį prieš pat sunkvežimį už tavęs."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Kai tavo sunkvežimio priekis pravažiuos pro sunkvežimį prieš tave, gali pradėti sukti savo sunkvežimio priekį į vietą, išlygindamas sunkvežimį pagal stovėjimo vietą."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ištiesink vairą ir pastatyk sunkvežimį stovėjimo vietos centre.<br>Sustok ir išjunk variklį."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Priekyje yra keli stovintys sunkvežimiai. Tarp jų liko viena stovėjimo vieta tau.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Atmink stebėti aplinką. Šiame manevre naudokis visais veidrodėliais.<br><br><font face=/font/big_bold.font>Važiuok priekin.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Pravažiuok stovėjimo vietą į pažymėtą vietą. Iš jos galėsi pradėti važiavimą atbulai.<br><br><font face=/font/big_bold.font>Sustok pažymėtoje vietoje.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Stebėk aplinką ir kliūtis ir įsitikink, kad gali važiuoti atbulai.<br><br><font face=/font/big_bold.font>Stebėk keleivio pusės veidrodėlį.</font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Pasuk ratus ir važiuok atbulai į stovėjimo vietą.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Pradėk tiesinti sunkvežimį tinkamu metu. Neužvažiuok ant šaligatvio!<br><br><font face=/font/big_bold.font>Ištiesink sunkvežimį stovėjimo vietoje.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

