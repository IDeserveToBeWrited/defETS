	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Ši trasa padės jums susipažinti su dvigubų priekabų posūkiais 90 laipsnių kampu."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Pirmi keli posūkiai yra gana platūs, juose daug vietos. Naudok juos, kad pajustum priekabas."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Toliau posūkiai taps staigesni ir techniškesni. Artėk prie jų lėtai ir įsitikink, kad įvažiuojai giliai į posūkius, kad priekabos turėtų vietos važiuoti."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Tai vienas staigiausių posūkių trasoje. Gali būti naudinga išnaudoti nedidelę erdvę dešinėje, kad su priekabomis būtų lengviau apvažiuoti tuos erzinančius vidinius kūgius."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Visada reikia atminti kitą posūkį – išvažiuojant iš vieno posūkio sudaryk planą, kaip pasiruošti kitam."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Visada stebėk priekabas, kol jos pravažiuos kliūtis."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Važiuok link pirmo posūkio."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Stebėk veidrodėlius mokydamasis suprasti, kaip priekabos seka paskui sunkvežimį."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Prieš kiekvieną posūkį važiuokite plačiau – tai labai svarbu, kad turėtum pakankamai vietos, jog priekabos apvažiuotų posūkio kampą."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Pasiruošimas keliems kitiems posūkiams yra labai svarbus, nes po jų bus labai staigus posūkis. Klaida pradžioje gali jums kainuoti dar daugiau vėliau. <br><br>Važiuok lėtai ir atidžiai, stebėk aplinką."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Šis posūkis yra itin staigus ir veda tiesiai į kitą staigų posūkį. Reikia apgalvoti ne tik tai, kaip įvažiuosi į posūkį, bet ir kaip išvažiuosi bei pasiruoši kitam."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Važiuok toliau per paskuitnius posūkius link nurodytos zonos."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Pirmas atbulinis"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "Šiame scenarijuje pirmą kartą važiuosime atbulai su dvigubomis priekabomis."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Atsipalaiduok ir nesijaudink"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Važiavimas atbuline eiga su dviguba priekaba reikalauja visiškai naujo mąstymo apie tai, ką darai. Užuot nukreipiant tik priekabą, dabar su savo priekaba nukreipiate kitą, važiuojančią už pirmos. <br><br> Pasinaudok šiuo scenarijumi, kad suprastum, kaip viskas veikia. Nėra konkretaus tikslo, tiesiog neskubėk ir pabandyk suprasti, kas vyksta."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Iš tiesios padėties gali pasukti sunkvežimį ta pačia kryptimi, kuria nori, kad važiuotų galinė priekaba. <br><br>Nepersistenk; jums tereikia pasukti galinę priekabą norima kryptimi, o tada galite sulygiuoti vilkiką su pirma priekaba ir leisti galinei priekabai atlikti savo darbą."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Kai galinė priekaba važiuos norima kryptimi, galite pasukti priekinę priekabą ta pačia kryptimi. <br><br>Kai priekinė priekaba seks galinę, sunkvežimiu reguliuok kampą tarp dviejų priekabų, kad posūkis būtų staigesnis arba platesnis."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Nėra tikslios formulės, kaip tai padaryti teisingai, tereikia stebėti tai, kas vyksta, mokytis iš savo klaidų ir toliau praktikuotis. <br><br>Kai būsi patenkinti, galėsi vykti į nurodytą vietą ir išjungti savo sunkvežimį. <br><br>Nesivaržyk ir eksperimentuok čia tiek laiko, kiek manai, kad reikia."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Pradėk lėtai važiuoti atbulai. Atmink, kad reikia pradėti nuo mažų judesių, nereikia visko iš karto staigiai keisti.<br><br>Pabandyk važiuoti tiesiai atgal arba pristumk priekabas prie vairuotojo pusės."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Neskubėk ir nenusimink. <br><br>Kiekvienas meistras kažkada buvo pradedantysis."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Pirma atbulinė korekcija"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "Šiame scenarijuje pratęsime kažkieno paliktą darbą."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Važiavimas atbulai"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Oi! Kažkas šiek tiek susinervino važiuodamas atbulai ir paliko sunkvežimį viduryje aikštelės."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Neišvengiamai bus atvejų, kai visiškai susidirbsi. Nesijaudink, tiesiog važiuok tiesiai iš susiskersavimo, kol būsi tokioje padėtyje, su kuria bus galima dirbti. <br><br>Jei nesi tikri, stenkis viską ištiesinti, kad pradėtum nuo švaraus lapo."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Tai nebloga pradinė padėtis. Galinė priekaba vis dar nukreipta ten, kur norime važiuoti, ir galime greitai pastatyti sunkvežimį priešais priekinę priekabą, kad pradėtume vairuoti visą junginį ten, kur norime."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Važiuok į nurodytą vietą ir išjunk sunkvežimį. <br><br>Dar kartą, galite treniruotis šiame scenarijuje, kol įgysi įgūdį manevruot priekabomis."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Čia didelė betvarkė. Važiuok tiesiai, kol situacija pagerės."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Pradėk važiuoti atbulai."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Važiavimas tiesiai atbulai"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "Šiame scenarijuje reikia atbulai važiuoti su dvigubomis priekabomis tiesiai."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
