	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Kažkas bandė įvažiuoti atbuline eiga į stovėjimo vietą ir turėjo šiek tiek bėdų. Dabar tavo pareiga tai ištaisyti!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Pirmas žingsnis – pajudėti į priekį ir viską ištiesinti taip, kad galėtum pradėti dirbti. Labai svarbu, kad galinė priekaba būtų nukreipta ten, kur norite."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "Šiame scenarijuje pasirinkome labiau priartėti prie vairuotojo pusės. Taip geriau matysime, ką darome važiuodami atbuline eiga, ir galėsime dirbti iš vienos pusės. <br><br>Atmink, kad vairuoji galinę priekabą su priekine, todėl nekreipk daug dėmesio į sunkvežimį."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Junginys daugiau ar mažiau yra ten, kur mums reikia, bet vėl pavažiuoime į priekį, kad jį tinkamai išcentruotume."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Iš čia labai atsargiai važiuosime atbuline eiga, užtikrindami, kad galinė priekaba idealiai laikytųsi trajektorijos."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Dabar galime ištiesinti priekinę priekabą ir patį sunkvežimį."

