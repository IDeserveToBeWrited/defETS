#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Lygiagretus parkavimas"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Šiame scenarijuje išbandysime lygiagretų parkavimą tarp kių dviejų sunkvežimių."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Sustojimas prieš stovėjimo vietą"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Galinio vaizdo veidrodėlio patikrinimas"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Atbulas važiavimas į stovėjimo vietą"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Sunkvežimio išlyginimas stovėjimo vietoje"
