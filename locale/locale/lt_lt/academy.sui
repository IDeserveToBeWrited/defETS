	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Važiuoti atbuline eiga į šoną lengviau su dvigubomis priekabomis, nes pro šoninį langą matys aiškesnį vaizdą, kas vyksta."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Pirma važiuok į priekį ir apsisukite eilės gale. Tai leis jums pasiruošti iš matomos pusės ir geriau matyti viską pro vairuotojo pusės langą."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Gali pasirinkti pasiruošti priekabas taip, kaip atrodo tinkama, galbūt su galine priekaba jau nukreipta į tą vietą. Šiuo atveju pradėsime nuo tiesios pozicijos. <br><br>Nepamiršk paprastumo – vairuok galinę priekabą su priekine priekaba."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Šiek tiek pasuk priekinę priekabą tolyn nuo stovėjimo vietos, ir galinė priekaba pradės sukti į šią vietą. Tada reguliuok kampą tarp priekinės priekabos ir galinės priekabos, kad išlaikytum gražų, lygų vingį į stovėjimo vietą."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Atmink, jei galinė priekaba važiuoja per staigiu kampu, turi šiek tiek ištiesinti junginio kampą. Jei jis per platus, kampą padidinkite."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Tavo atliekami reguliavimo veiksmai su sunkvežimiu galinę priekabą veikia perpus mažiau nei priekinę priekabą, todėl nebijok plačiai manevruoti sunkvežimiu."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "Šiuo metu turi pradėti planuoti iš anksto. Taip pat turi į vietą įvairuoti ir priekinę priekabą, todėl pradėk planuoti, kaip ją pastatyti tiesiai priešais galinę priekabą."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Labai retai pavyksta įvairuoti priekabas iš pirmo karto. Šiuo atveju per ilgai laukėme ištiesinti priekinę priekabą, ir dabar galinė dalis nukrypsta nuo kelio. <br><br>Ne bėda, pajudėk į priekį ir bandyk dar kartą."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Drąsiai sukinėk vairą ir vairuok priekabas ten, kur nori. Gali pavažiuoti pirmyn tiek kartų, kiek reikia, kol viskas pavyks."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Ir štai taip sėkmingai pastatėme dvigubas priekabas."

#### backing_90_tight Driving Instructions

