#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Šį kartą atbulai važiuosime tiesia linija. Turėsi nuvažiuoti už brūkšninės linijos ir ten sustoti."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Sunkvežimiu važiuojant atbulai būtina nuolat dairytis, stebėti visus veidrodėlius ir nuolat užtikrinti, kad erdvėje aplink sunkvežimį nėra kliūčių."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Užvesk variklį, įjunk atbulinę pavarą ir pradėk judėti."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Pravažiuok brūkšninę liniją, sustok, išjunk variklį ir pasirūpink sunkvežimiu."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Paruošk sunkvežimį važiavimui kaip praeitame scenarijuje.<br><br><font face=/font/big_bold.font>Kai pasiruoši užvesk variklį. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Patikink veidrodėliuose, ar nėra kliūčių. Jei nepatinka jų padėtis, galima juos pareguliuoti \"@@adjust_link_t@@\".<br><br><font face=/font/big_bold.font>Pažiūrėk į keleivio pusės veidrodėlį.</font>@@aca_goal_tip@@ Turi būti sunkvežimio viduje."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Važiuosi už brūkšninės linijoss. Dabar juosta tuščia, bet įprastai vairuojant būtina nuolat stebėti aplinką dairantis ir per veidrodėlius.<br><br><font face=/font/big_bold.font>Patikrink keleivio pusės veirodėlį.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Spausk $input backward$ įjungti atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_geardown@@ įjungti atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_geardown@@ įjungti atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Nuspausk sankabą ir pavarų svirtį perjunk į atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Dabar įjungta atbulinė pavara.<br><br><font face=/font/big_bold.font>Išjunk stovėjimo stabdį su @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Pradėk judėti spaudžiant $input backward$.<br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Pradėk judėti spaudžiant akseleratorių: $input forwardd$.<br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Pradėk judėti spaudžiant akseleratorių: $input forwardd$.<br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Lėtai atleisk sankabą ir truputį nuspausk akseleratorių. <br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Sustok darbiniais stabdžiais: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Sustok darbiniais stabdžiais: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Sustok darbiniais stabdžiais: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Nuspausk sankabą ir sustok darbiniais stabdžiais. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį su @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Supaprastintoje automatinėje pavarų dėžėje nereikia perjungti pavarų, tai daroma automatiškai, kitaip nei gyvenime.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą su @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Šiuolaikiniai sunkvežimiai automatiškai įjungia laisvą pavarą įjungus stovėjimo stabdį. Tačiau geras įprotis yra visada padaryti tai savarankiškai. Kituose scenarijuose nereikalausime šio žingsnio."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą su @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Šiuolaikiniai sunkvežimiai automatiškai įjungia laisvą pavarą įjungus stovėjimo stabdį. Tačiau geras įprotis yra visada padaryti tai savarankiškai. Kituose scenarijuose nereikalausime šio žingsnio."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Perjunk pavarų svirtį į laisvą pavarą ir atleisk sankabą.</font>@@aca_goal_tip@@ Šiuolaikiniai sunkvežimiai automatiškai įjungia laisvą pavarą įjungus stovėjimo stabdį. Tačiau geras įprotis yra visada padaryti tai savarankiškai. Kituose scenarijuose nereikalausime šio žingsnio."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Atmink nuolat stebėti aplinką važiuojant atbulai, ypač ten, kur didelis eismas.<br><br><font face=/font/big_bold.font>Išjunk variklį su $input engineelect$. </font>"
#@}

