	val[]: "Darbinio stabdžio nuspaudimas"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Pavaros įjungimas"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Stovėjimo stabdžio išjungimas"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Važiavimas pirmyn"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Sustojimas"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Stovėjimo stabdžio įjungimas"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Laisvos pavaros įjungimas"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Variklio išjungimas"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Keliems pirmiems važiavimams naudosime tik vilkiką.<br>Sunkvežimis vadinamas vilkiku, kai jis neturi savo kėbulo kroviniams, o tik tempia priekabas."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Vilkikai yra dažni, nes jie suteikia didesnį universalumą: jie gali atkabinti tuščią priekabą ir prisikabinti pilną, nelaukiant pakrovimo, arba prisikabinti visai kito tipo priekabą."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Pirmo važiavimo užduotis bus pavažiuoti priekin ir sustoti už brūkšninės linijos.<br>Užvesk variklį ir laikykis nurodymų kaip važiuoti. Kai pasiruoši, važiuok tiesiai pirmyn."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Pravažiuok brūkšninę liniją, sustok, išjunk variklį ir pasirūpink sunkvežimiu."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Kitame mokymų žingsnyje pirmą kartą važiuosi sunkvežimiu.<br><br>Žinoma, tai nepavyks su išjungti varikliu, todėl pirma reikia įjungti degimą.<br><br><font face=/font/big_bold.font>Spausk $input engineelect$ įjungti degimą.</font>@@aca_goal_tip@@ Karjeroje, su standartiniais nustatymais, variklis automatiškai užsiveda įjungus elektrą. Karjeroje šį elgesį galima pakeisti Nustatymuose - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Degimas įjungis sunkvežimio elektroniką. Pamatysi įvairias lemputes prie prietaisų - tai normalu. Jei jos neužges užvedus variklį, gali būti, kad sunkvežimyje kažkas sugedo. Išimtis yra stovėjimo stabdžio lemputė, kuri išsijungs kai išjungsi stovėjimo stabdį.<br><br>Laimei šis sunkvežimis geros būklės ir viskas paruošta.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_engine@@ užvesti variklį.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Užvedus variklį, prieš važiuojant būtina gerai apsidairyti.<br><br><font face=/font/big_bold.font>Apsidairyk į visas puses, per visus veidrodėlius ir patikrink, ar sunkvežimis gali važiuoti.</font>@@aca_goal_tip@@ Turi būti sunkvežimio viduje."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Gali atrodyti akivaizdu, bet prieš pradedant važiuoti turėtum sužinoti, kaip sustoti.<br><br><font face=/font/big_bold.font>Naudok darbinius stabdžius su $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Supaprastintoje automatinėje pavarų dėžėje nereikia jungti pavarų, viskas atliekama automatiškai.<font face=/font/big_bold.font><br><br>Spausk $input forward$ jungti judėjimą priekin. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Realistiška automatinė pavarų dėžė leikdžia tau perjungti tarp Važiavimo (D), Laisvos (N) ir Atbulinės (R) pavarų, kaip tikroje automatinėje pavarų dėžėje.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_gearup@@ įjungti Važiavimo pavarą. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Sekvencinė pavarų dėžė leidžia jungti pavaras iš eilės, kaip tikrovėje.<br><br>Kaip įjungiant pirmą pavarą priekin, įsibėgėjant reikės įjungti aukštesnes pavaras.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_gearup@@ įjungti pirmą pavarą.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Su pavarų perjungimo svirtimi ir sankaba patirsi tą patį, kaip fiziškai perjungiant pavaras tikroje rankinėje pavarų dėžėje.<br><br>Nuspausk sankabą ir darbinius stabdžius. <font face=/font/big_bold.font>Pavarų perjungimo svirtimi įjunk pirmą pavarą. <color value=@@clr_txt@@>Sankabą ir darbinius stabdžius laikyk nuspaustus.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Pradedant judėti pirma reikia išjungti stovėjmo stabdį.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_parkingbrake@@ išjungti stovėjimo stabdį.</font> @@aca_goal_tip@@ Karjeroje stovėjimo stabdis pradžioje būna neįjungtas. Galima tai pakeisti Nustatymuose - Žaidimas - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Judėti pradėk su akseleratoriumi: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Judėti pradėk su akseleratoriumi: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Judėti pradėk su akseleratoriumi: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Atleisk darbinį stabdį, po truputį atleisk sankabą tuo pačiu truputį spaudžiant akseleratorių, kad variklis neužgęstų. Kai sankaba bus pilnai atleista, galėsi įsibėgėti ir toliau perjungti pavaras</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Sustok darbiniais stabdžiais.<br><br><font face=/font/big_bold.font>Spausk $input backward$ stabdyti sunkvežimį. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Sustok darbiniais stabdžiais.<br><br><font face=/font/big_bold.font>Spausk $input backward$ stabdyti sunkvežimį. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Sustok darbiniais stabdžiais.<br><br><font face=/font/big_bold.font>Spausk $input backward$ stabdyti sunkvežimį. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Atėjus laikui sustoti nuspausk sankabą <font face=/font/big_bold.font>ir sustok darbiniais stabdžiais.<color value=@@clr_txt@@> Pavarų perjungimo svirtimi įjunk laisvą pavarą ir tada galėsi atleisti sankabą. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Dabar pasirūpink sunkvežimiu. Stovėjimo stabdis neleis sunkvežimiui pajudėti netyčia.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_parkingbrake@@ įjungti stovėjimo stabdį.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Supaprastintoje automatinėje pavarų dėžėje nereikia perjungti pavarų, tai daroma automatiškai.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą - spausk @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą - spausk @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Perjunk pavarų svirtį į laisvą pavarą ir atleisk sankabą. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Dabar žinai kaip važiuoti sunkvežimiu ir kaip saugiai sustoti<br><br><font face=/font/big_bold.font>Spausk $input engineelect$ išjungti variklį. </font>"
#@}

#+ Book 1 Scenario 1_04
