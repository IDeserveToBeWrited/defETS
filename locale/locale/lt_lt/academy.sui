#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Šiame scenarijuje pasivažinėsime vilkiku ir išbandysime tavo naujus įgūdžius."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Šiojke trasoje yra įvairių tipų posūkų. Tai ne lenktynės, tad laikas nesvarbu. Būk kantrus ir pasirink greitį pagal posūkius ir kliūtis."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Pradžioje trasa bus lengva, bet toliau posūkiai sudėtingės."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Stebėk savo greitį. Lengva per daug įsibėgėti ir nepataikyti į posūkį."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Išvažiavimas iš trasos yra labai staigus apsisukimas. Važiuok lėtai ir išnaudok visą erdvę."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Sustok tarp barjerų ir išjunk variklį."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Scenarijaus užduotis - neatsitrenkti, neišvažiuoti iš trasos, nepervažiuoti kūgių.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Važiuok tiesiai į staigų dešinį posūkį - trasos pradžią.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Važiuok posūkiu ramiu, pastoviu greičiu.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Artėji prie sudėtingesnės dalies iš kelių vingių.<br><br><font face=/font/big_bold.font>Pasirink tinkamą greitį ir tęsk.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Važiuok link kitų vingių.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Toliau laukia lengvi posūkiai. Važiuok stabiliu greičiu.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Išvažiavimas iš šios trasos yra staigus apsisukimas. Sulėtink ir prieš posūkį pasitrauk į išorinę dalį. Naudok veidrodėlius!<br><br><font face=/font/big_bold.font>Išvažiuok iš trasos.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Priekyje tarp barjerų yra stovėjimo vieta.<br><br><font face=/font/big_bold.font>Važiuok į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

