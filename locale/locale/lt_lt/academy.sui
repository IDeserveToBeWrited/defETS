#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Paskutiniame šio skyriaus scenarijuje važiuosime sudėtinga trasa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Pirma kliūtis yra slalomas tarp barjerų. Važiuok juo ir nepamiršk veidrodėlių."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Toliau - staigus apsisukimas. Važiuok plačiai, tada viskas turėtų pavykti."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Čia bus 90 laipsnių posūkis kairėn. Atminkite įvažiuoti giliai, kad sunkvežimio galas neužkliūtų už barjerų kampe."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Rampos kliūtis gali būti kebli. Nusitaikyk prieš užvažiuodamas ir naudok visus veidrodėlius."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Kitą dalį reikia įveikti atbulai. Privažiuok prie barjerų priekyje tai atmindamas."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Sek kelio žymėjimu gale ir dešinėje."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Atbulai važiuok iki barjerų, tada sustok ir važiuok į priekį kairėn."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Važiuok pro tarpą barjeruose į kitą dalį."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Šis pravažiavimas tarp kūgių labai siauras. Važiuok lėtai ir naudok veidrodėlius."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Atmink giliai įvažiuoti į staigius posūkius."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Artėji prie malonios, atviros kelio dalies. Gali įsibėgėti, bet atmink, kad netrukus reikės pristabdyti prieš posūkį."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Kalno apačioje kelią užstoja barjerai. Važiuok iki jų, po to atbulai važiuok į stovėjimo vietą kairėje."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Atbulai važiuok į stovėjimo vietą."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Pastatyk sunkvežimį ir išjunk variklį."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Priekyje yra slalomas iš barjero.<br><br><font face=/font/big_bold.font>Važiuok slalomu.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Laikykis posūkio išorėje, kad vilkiko galiniai ratai neužvažiuotų ant posūkio ribos.<br><br><font face=/font/big_bold.font>Įveik posūkį.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Artėji prie 90 laipsnių kairio posūkio. Atmink naudoti visą turimą erdvę.<br><br><font face=/font/big_bold.font>Įveik posūkį.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Nusitaikyk į rampą. Ant jos užvažiavus nebus daug vietos korekcijoms.<br><br><font face=/font/big_bold.font>Pervažiuok rampą.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Važiuok trasa kairėje.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Šią dalį reikia įveikti atbulai. Sustok prie barjerų priekyje taip, kad galėtum iš karto važiuoti atbulai dešinėn.<br><br><font face=/font/big_bold.font>Sustok prie barjerų.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Važiuok atbulai į zoną už tavęs, dešinėje. Nupieštos rodyklės padės tau.<br><br><font face=/font/big_bold.font>Važiuok atbulai į kitą dalį.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Važiuok atbulai iki barjerų.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Sustok, įjunk pavarą pirmyn, ir važiuok kairėn.<br><br><font face=/font/big_bold.font>Važiuok pirmyn.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Kairėje tarp barjerų yra tarpas. Važiuok pro jį<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Priekyje yra siauras, vingiuojantis kelias tarp kūgių. Važiuok atsargiai ir naudok veidrodėlius.<br><br><font face=/font/big_bold.font>Važiuok tarp kūgių.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Važiuok toliau trasa.<br><br><font face=/font/big_bold.font>Suk kairėn.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Atmink laikytis kairiau, kad turėtum kuo daugiau vietos.<br><br><font face=/font/big_bold.font>Įveik posūkį.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Čia gali įsibėgėti, bet priekyje tavęs laukia posūkis.<br><br><font face=/font/big_bold.font>Važiuok toliau trasa.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Šis posūkis vis staigės.<br><br><font face=/font/big_bold.font>Pasirink tinkamą greitį ir tęsk toliau.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Kalno apačioje pamatys kelią užtvėrusius barjerus.<br><br><font face=/font/big_bold.font>Sustok netoli barjerų.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Už tavęs, kairėje yra stovėjimo vieta.<br><br><font face=/font/big_bold.font>Atbulai įvažiuok į stovėjimo vietą.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

