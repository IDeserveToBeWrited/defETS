#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Sustojimas arti kliūties"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Šiame scenarijuje pakalbėsime apie priekinį veidrodėlį - jo vietą ir kaip jį efektyviai panaudoti sustojant arti kliūties priekyje."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Priekinio veidrodėlio patikrinimas"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Jo funkcijos supratimas"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Sustojimas netoli kliūties"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Sunkvežimių priekyje, prieš vilkiką, yra didelė akla zona. Lengva joje nepastebėti pėsčiojo ar net visos mašinos, todėl sunkvežimiuose būna priekinis veidrodėlis, kurį galima pamatyti per priekinį stiklą."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Priekinis veidrodėlis leidžia vairuotojui pamatyti šią aklą zoną,<br>Tai būtinas įrankis, kad nesusidurtum su kliūtimis manevruojant siaurose vietose."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Pradėk važiuoti, važiuok prie barjero priekyje, priartėjęs prie jo sulėtink.<br>Stebėk priekinį veidrodėlį."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Sustok tarp linijos ir kliūties."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Šiame scenarijuje išmoksime naudotis priekiniu viedordėliu, parodytu diagramoje.<br><br><font face=/font/big_bold.font>Jį gali pamatyti priekinio stiklo viršutinėje dalyje.</font>@@aca_goal_tip@@ Turi būti sunkvežimio viduje."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Priekinis veidrodėlis leidžia tau pamatyti aklą zoną sunkvežimio priekyje. Jis gali padėti vairuoti saugiau ir tiksliau.<br><br>Jei reikia, gali pareguliuoti jį atidarant \"@@adjust_link_t@@\" (galima rasti pazuės meniu).<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ tęsti. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Tiesiai prieš sunkvežimį yra pažymėta vieta. Pastebėsi, kad kitoje tos vietos pusėje yra kliūtis. Kai būsi netoli jos, važiuok labai lėtai ir stebėk atstumą iki kliūties priekiniame veidrodyje.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Sunkvežimis dar neparuoštas judėti, gal kažką pamiršai?<br><br>Ar variklis užvestas? Ar stovėjimo stabdis išjungtas?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Važiuok tiesiai į stovėjimo vietą.</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Sustok taip, kad sunkvežimio priekis būtų tarp kliūties ir kelio žymėjimo. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
