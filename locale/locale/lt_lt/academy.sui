#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Važiavimas aplink barjerus"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Priekyje yra keli sudėtingi posūkiai ir kliūtys.<br>Jei panaudosi viską, ką išmokai iki šiol, neturėtų būti sunku."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Kelio žymėjimai padės tau suprasti, kaip įveikti kiekvieną kliūtį."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Važiuok arčiau posūkio išorės.<br>Turėsi važiuoti plačiau, nes priekaba šiek tiek kerta kampą."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Kitas posūkis bus lengvas 90 laipsnių posūkis.<br>Ir vėl važiuok arčiau posūkio išorės ir išnaudok visą turimą erdvę."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Neskubėk. Trasa praplatės, bet vis tiek reikia būti tiksliu."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Plačiai apvažiuok barjerus."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Neskubėk šioje siauroje dalyje.<br>Vilkiku važiuok plačiai gerokai prieš šią dalį, kad priekaba būtų tinkamai paruošta."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Paskutinis 90 laipsnių posūkis gerokai staigesnis nei pirmas, bet čia vietos pakaks, jei ją išnaudosi išmintingai."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Atmink, kad kelio žymėjimai padės tau rasti kelią.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Veirodėliai taip pat padės tau saugiai įveikti trasą. Visada turi atminti, kaip priekaba važiuos paskui tave.<br><br><font face=/font/big_bold.font>Važiuok į pirmą posūkį.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Stebėk priekabą išvažiuodamas iš posūkio ir pasiruošk kitam.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Važiuok į kitą posūkį.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Prieš sukdamas nepamiršk stebėti priekabos, kad ji neužvažiuotų ant kliūčių.<br><br><font face=/font/big_bold.font>Toliau važiuok aplink kliūtį.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Kai priekaba pravažiuos pro barjerą staigiai suk keleivio pusėn, kad pasiruoštum siauram keliui.<br><br><font face=/font/big_bold.font>Važiuok link siauro kelio.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Šioje dalyje reikia labai tikslaus vairavimo. Neskubėk ir naudok veidrodėlius.<br><br><font face=/font/big_bold.font>Laikykis kiekvieno posūkio išorėje.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Šis posūkis labai staigus, bet gali išnaudoti visą erdvę priekyje.<br><br><font face=/font/big_bold.font>Įveik paskutinį posūkį.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

