#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Važiavimas atbulai su priekaba"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Šiame scenarijuje pirmą kartą pabandysi važiuoti atbulai su priekaba. Tai gana paprastas manevras, bet vis tiek reikia teisingai vairuoti, kad priekaba atsidurtų ten, kur reikia."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Važiavimas atbulai link priekabos"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Priekabos prikabinimas"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Stovėjimo stabdžio išjungimas"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Važiavimas atbulai su priekaba"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Važiavimas link stovėjimo vietos"
