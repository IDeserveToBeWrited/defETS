#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Važiavimo atbulai mokymas"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Šiame scenarijuje būsi tuščioje stovėjimo aikštelėje, kur galėsi pasimokyti važiuoti atbulai su dvigubomis priekabomis."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Pradžia"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentai"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Užbaigimas"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Scenarijaus pabaiga"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Važiavimas atbuline eiga su dviguba priekaba reikalauja daug daugiau dėmesio nei su viena. Reikia iš anksto suplanuoti, kur norite važiuoti galine priekaba, tuo pačiu metu valdant priekinę ir sunkvežimį. <br><br>Galvok šitaip – su priekine priekaba turi vairuoti galinę priekabą."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Šiuo atveju norime pasukti galinę priekabą į vairuotojo pusę. Norėdami ją ten pasukti, turime pastumti galinės priekabos priekį į keleivio pusę.<br><br>Atkreipk dėmesį, kad tai iš esmės reiškia, jog turite pasukti priekinę priekabą priešinga kryptimi, nei norite vairuoti galinę priekabą."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Kai galinė priekaba pradeda sukti, būtina sulyginti sunkvežimį su priekine priekaba. Būtent čia dauguma žmonių padaro pirmąją klaidą."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Matome, kad vairuotojas neišsilygino su priekine priekaba ir tuoj suskersuos priekabas."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Suskersavimas įvyksta, kai kampas tarp bet kurių dviejų junginio transporto priemonių tampa maždaug 90 laipsnių. Kai tai nutinka padėties pataisyti nebeįmanoma – reikia pajudėti į priekį ir bandyti iš naujo. <br><br> Kaip ir važiuojant atbuline eiga viena priekaba, tikslas visada turėtų būti užtikrinti, kad visi priekabų ratai judėtų. Kai vienas ratas sustoja ir priekaba sukasi vietoje, važiuoti toliau negalima."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Gali pajudėti į priekį iki ten, kur paskutinį kartą stovėjai teisingai, arba, tiksliau, iki padėties, kurioje galėsi tęsti judėjimą atbulai, nekartojant tos pačios klaidos. <br><br>Šiuo atveju pajudėsime į priekį iki tiesios padėties ir bandysime dar kartą nuo pradžių."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Dar kartą, kai galinė priekaba pradeda sukti, ištiesink sunkvežimį su priekinės priekabos priekiu ir leisk galinei priekabai kurį laiką sukti pačiai."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Dabar, kai galinė priekaba sukasi norima kryptimi, laikas nukreipti priekinę dalį, kad ji ją sektų. Gali reguliuoti kampą tarp priekinės ir galinės dalies, kad valdytum posūkio staigumą."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Paskutinė manevro dalis - visko ištiesinimas. Priekinę priekabą sulygink su galine."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Turėtum atminti, kad reikės laiko pagrindinės priekabos pajudinimui, nes jei per ilgai lauksi, galinė priekaba grįž ten, iš kur ką tik atvažavote!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Gali čia praleisti tiek laiko, kiek nori, eksperimentuoti su skirtingais manevrais, kol galvosi, kad apytiksliai supranti, kaip valdyti priekabas važiuojant atbulai. <br><br>Tačiau svarbiausia – nepamiršk smagiai leisti laiką!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Pasiruošk važiuoti."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Šioje aikštelėje gali pabandyti atbulai valdyti priekabas. <br><br>@@aca_goal_tip@@ Iš viso neteko atbulai valdyti priekabos? Pagalvok apie Sunkvežimio valdymo pagrindų modulį."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Gali treniruotis kiek nori laiko. <br><br>Kai manysi, kad jau gana, gali sustoti ir išjungti sunkvežimį ir užbaigti scenarijų."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Išjunk variklį, kad užbaigtum scenarijų."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkavimas siauroje vietoje"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "Šiame scenarijuje reikia pastatyti dvigubas priekabas siauroje erdvėje."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Pradžia"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Pajudėjimas"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Važiuok toliau"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Sustojimas"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Sunkvežimio išjungimas"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Vairavimas su dviem priekabomis gali pasirodyti bauginantis, tačiau tai nelabai sudėtingiau nei vairavimas su viena priekaba – tereikia atsižvelgti ir į galinės priekabos kelią!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Priekyje yra siaura stovėjimo vieta. Neužteks vietos sustoti visiškai tiesiai prieš įvažiuojant, todėl reikės atidžiai apsvarstyti, kaip įvažiuoti su abiem priekabomis."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Iš karto suk į tolimąją stovėjimo vietos pusę ir pravažiuok gerokai toliau nei įprastai."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Dabar, kai galinė priekaba yra tiesiai, galite judėti link stovėjimo vietos; tik nepamiršk vėl judėti į tolimąją pusę, kad padėtum pasukti pirmąją priekabą."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Toliau važiuok į vietą, ir abi priekabos seks paskui jus ir išsitiesins jums važiuojant."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Pasiruošk važiuoti."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Važiuok tiesiai į siaurą vietą."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Važiuok toliau."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Sustok nurodytoje vietoje."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."
#@}


