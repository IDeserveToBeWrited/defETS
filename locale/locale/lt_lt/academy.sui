	val[]: "Persiriuok dešinėn, po to iš karto kairėn."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Dar kartą persirikiuok."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Kartais tenka skersuoti visą junginį. <br><br>Daryk ką reikia, kad įveiktum šį ypač staigų posūkį."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Važiuok toliau trasa."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Atsargiai įveik slalomo trasą, taip, kad priekabos ne tik pravažiuotų kiekvieną barjerą, bet ir kad pasiruoštum kitam posūkiui."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Tęsk kaitėn ir važiuok tiesiai per sankryžas."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Važiuok keliu į dešinę."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Paskutinis posūkis klaidinantis. Vietos daug, bet reikės pasiruošti sustoti prie tolimo bordiūro."

