#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Nėra galimas tinklas. Prašome patikrinti, ar teisinga kliento konfigūracija."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Neįmanoma susijungti su internetinėmis paslaugomis. Prašome patikrinti ar veikia jūsų internetas. "

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Klaida susijungiant su internetinėmis paslaugomis. Prašome pamėginti vėliau."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Gauti neteisingi duomenys iš internetinių paslaugų. Jeigų yra naudojamas HTTP proxy serveris, patikrinkite jo konfigūraciją. Kitu atveju pabandykite vėliau."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Gauti neteisingi duomenys iš internetinių paslaugų. Pabandykite vėliau."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Paslaugos nėra suderinamos su esama žaidimo versija. Prašome patikrinti ar yra galimybė atsinaujinti žaidimą."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Paslauga šiuo metu negalima. Pabandykite vėliau."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Paslauga šiuo metu išjungta aptarnavimui arba per daug apkrauta. Pabandykite vėliau."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Prisijungimo informacija neteisinga. Pabandykite prisijungti dar kartą."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Interneto paskyra šiuo metu užrakinta dėl per dažnų nepavykusių prisijungimų. Pabandykite dar po pusvalandžio."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Interneto paskyra šiuo metu užrakinta dėl įtartinų prisijungimų. Pabandykite po 24 valandų."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Šis žaidimas neregistruotas šiai paskyrai."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Paskyra dar neaktyvuota. Paskyros aktyvacijos laišką rasite savo e-pašte."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Paskyra suspenduota. Kreipkitės į techninę pagalbą."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Paskyra uždrausta. Kreipkitės į techninę pagalbą."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy serverio patvirtinimas nėra palaikomas žaidimo. Prašom naudot kitą proxy arba tiesiogini ryšį."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Reikalingas objektas nepasiekiamas. Pabandykite po kelių minučių."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL klaida. Negalėjau sukurti saugaus prisijungimo."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Žaidimas buvo pristabdytas interneto komunikacijos metu. Pabandyk vėliau."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Vidinė klaida. Daugiau informacijos gali būti faile net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 turi problemą ir negali piešti vaizdo Jūsų kompiuteryje (nerastas tinkamas vaizdo įrenginys).\nSiūlomi sprendimai:\n1. Patikrinkite, ar Jūsų kompiuteris ir vaizdo plokštė atitinka minimalius žaidimo reikalavimus.\n2. Atnaujinkite Jūsų Microsoft's DirectX.\n3. Atsisiųskite ir instaliuokite naujausius Jūsų vaizdo plokštės draiverius iš Jūsų gamintojo tinklapio, gali būti, kad jie pasenę.\n4. Pabandykite pakeisti piešimo metodą iš OpenGL į DirectX arba atvirkščiai.\n5. Ištrinkite failą 'config.cfg' Jūsų  'Documents' - 'Euro Truck Simulator 2' direktorijoje. Jis galėjo susigadinti.\nŠis failas bus automatiškai atkurtas su standartiniais nustatymais kitą kartą paleidus žaidimą."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 turi problemą ir negali piešti vaizdo Jūsų kompiuteryje (nerastas jokia vaizdo plokštė)."
#@}

