#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Neradau būtino DLC (oficialaus žaidimo išplėtimas) $DEPENDENCY_NAME$. Tam, kad šis išsaugojimas veiktų tinkamai, šis DLC turi būti įjungtas šiame kompiuteryje, kitaip negalėsite užkrauti šio išsaugojimo." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Neradau pasirenkamo DLC (oficialaus žaidimo išplėtimas) $DEPENDENCY_NAME$. Jei to nesitikėjote, patikrinkite, ar DLC nepašalintas.<br><br>Kitu atveju galite vis tiek bandyti užkrauti šį išsaugojimą, tačiau gali dingti DLC esančios funkcijos." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modas $DEPENDENCY_NAME$ dingęs arba išjungtas. Jei to nesitikėjote, patikrinkite, ar modas neištrintas. Galite vis tiek bandyti užkrauti išsaugojimą, tačiau gali kilti įvairių problemų." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modas $DEPENDENCY_NAME$ yra nesuderinamas su Jūsų žaidimo versija. Tai reiškia, kad modo autorius pažymėjo, kad šis modas suderianmas tik su tam tikromis žaidimo versijomis, o dabartinė versija nepatenka į šį sąrašą. <br><br>Sprendimai:<br>- Pabandykite paiekšoti atnaujintos Modo versijos, tinkamos Jūsų žaidimo versijai.<br>- Atnaujinkite ar pasendinkite žaidimo versiją iki suderinamos su modu.<br><br>Galite vis tiek pabandyti užkrauti išsaugojimą, tačiau modas neus užkrautas, ir priklausomai nuo modo tipo, gali būti kad tokiu atveju iškils įvairių problemų." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "TRŪKSTAMOS PRIKLAUSOMYBĖS" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "SMULKMENOS" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Atidaryti dirbtuvių puslapį"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Šis išsaugojimas priklauso nuo DLC ar modų, kurių nerandu. Jų sąrašas pateikiamas žemiau. Pasirinkę punktą sąraše gausite daugiau informacijos apie tą punktą." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Šis išsaugojimas priklauso nuo bent vieno būtino DLC ar modo. Be jų šio išsaugojimo užkrauti nepavyks." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Nutraukti krovimą" #+ Abort loading button.

	key[]: "type"
	val[]: "Tipas" #+ Type column.

	key[]: "dependency_name"
	val[]: "Priklausomybės pavadinimas" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Vietinis Modas" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Dirbtuvių Modai" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Pasirenkamas DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Būtini DLC" #+ DLC that is required to load save that is depending on it.
