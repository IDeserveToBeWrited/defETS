#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Diapazono transmisija yra paprasčiausias pasirinkimas. Joje yra du pavarų rinkiniai. Pirmame rinkinyje yra pavaros nuo 1 iki 6, o antrame - nuo 7 iki 12. Mygtuku perjungiami šie rinkiniai, o H-jungikliu pasirenkama pavara iš rinkinio."

	key[]: "wiz_hs_splitter"
	val[]: "Daliklio transmisija yra paprasta alternatyva. Joje yra du pavarų rinkiniai. Pirmame yra nelyginės pavaros (1, 3, 5...), antrame - lyginės (2, 4, 6...). Daliklio mygtukas perjungia tarp šių rinkinių, o H-jungikliu pasirenkama norima pavara iš rinkinio."

	key[]: "wiz_hs_range_splitter"
	val[]: "Diapazono daliklio transmisija yra paremta tikrų sunkvežimių schema. Pavaros sugrupuotos po keturias kiekvienai H-jungiklio padėčiai, ir naudojami du jungikliai. Todėl ji rekomenduojama tik patyrusiems vairuotojams."
#@}

