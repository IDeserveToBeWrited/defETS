#+ Progress history screen
#@{

	key[]: "job_log_t"
	val[]: "PROGRESO ISTORIJA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "job_log"
	val[]: "Progreso istorija" #+ Icon opening the progress history. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "job_log_desc"
	val[]: "Sekite savo progresą. Prisiminkite nugabentus krovinius ir gautus apdovanojimus." #+ Help message associated the progress history icon.


	key[]: "stats_t"
	val[]: "Jūsų statistika" #+ Header of section with statistics info.

	key[]: "stats_dist_total"
	val[]: "Viso nuvažiuota:"

	key[]: "stats_dist_onjob"
	val[]: "Nuvažiuota dirbant:"

	key[]: "stats_dist_free"
	val[]: "Laisvai nuvažiuota:"

	key[]: "stats_jobs_done"
	val[]: "Pristatyta krovinių:"

	key[]: "stats_jobs_failed"
	val[]: "Nutraukta pristatymų:"

	key[]: "stats_time_real"
	val[]: "Žaista laiko:"

	key[]: "stats_time_game"
	val[]: "Viso praleista žaidimo laiko:"

	key[]: "stats_roads_explored"
	val[]: "Aplankyta kelių:"


	key[]: "free_roam"
	val[]: "Laisvas važiavimas" #+ Indicates that points were gained for distance driven during free roaming.

	key[]: "profit"
	val[]: "Pelnas:"
#@}

