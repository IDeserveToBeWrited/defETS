	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Spauskite @@imm_wiz_dforward@@ kad važiuotumėte pirmyn ir @@imm_wiz_dbackward@@ kad važiuotumėte atbulai."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Spauskite @@ima_wiz_j_throttle@@ pirmyn kad važiuotumėte pirmyn, ir atgal kad važiuotumėte atbulai."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Spausktie @@ima_wiz_j_throttle@@ kad važiuoti pirmyn ir @@ima_wiz_j_brake@@ kad važiuoti atbulai."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Spausktie @@imm_wiz_dforward@@ kad įsibėgėtumėtė ir @@imm_wiz_dbackward@@ kad stabdytumėte."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Spauskite @@ima_wiz_j_throttle@@ pirmyn kad įsibėgėtumėte ir atgal kad stabdytumėte."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Spauskite @@ima_wiz_j_throttle@@ kad įsibėgėtumėte ir @@ima_wiz_j_brake@@ kad stabdytumėte."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Spauskite @@imv_wiz_gearup@@ judėjimui pirmyn ir @@imv_wiz_geardown@@ judėjimui atgal."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Spauskite @@imv_wiz_gearup@@ judėjimui pirmyn ir @@imv_wiz_geardown@@ judėjimui atgal jei naudojate klaviatūrą ar valdiklio mygtukas. Spauskite @@imv_wiz_drive@@ arba @@imv_wiz_reverse@@ norėdami pasirinkti judėjimo kryptį, jei naudojate H-jungiklį."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Naudokite @@imv_wiz_gearup@@ ir @@imv_wiz_geardown@@ norimos pavaros pasirinkimui."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Naudokite savo H-jungiklį kartu su @@ima_wiz_j_clutch@@ kad perjungtumėte pavaras."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "NUSTATYK VALDIKLIO AŠIS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Ašių vaizdavimas"

	key[]: "wiz_setup_axes_desc"
	val[]: "Galite vizualiai patikrinti visų ašių veiklą. Išbandykite visas ašis. Čia pamatysite jų ribas, centravimą, kryptį ir kitas charakteristikas."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Ašių nustatymas"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Pasirenkant ašį reikia paspausti mygtuką prie ašies pavadinimo. Taip bus įjungtas įvedimo režimas. Tada panaudok savo valdiklio ašį, kurią nori naudoti šiai funkcijai."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Negyvos zonos"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Negyvos zonos yra ašies judėjimo dalis, kuri tyčia nestebima. Norėdamas pareguliuoti pasirinktos ašies negyvąją zoną perkelk atitinkamą šliaužiklį. Stumiant jį dešinėn negyva zona didės. Tai ypač naudinga seniems valdikliams, nes taip galima sumažinti netikslumus dėl nusidėvėjusios įrangos."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Ašies režimai"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Ašie režimaa nustato, kaip ji bus naudojama žaidime. Apversta ašis stebima žaidime atvirkščiai, taip sukeičiant sukimą kairėn su sukimu dešinėn, pavyzdžiui. Centruotos ašies bazinė padėtis yra jos ruožo viduryje, kaip džoistike. Šis režimas naudingas patikslinant ašis, kurios buvo neteisingai aptiktos."

	key[]: "normal"
	val[]: "Normali" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Apversta" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centruota" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Apversta ir centruota" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATINĖS PAVARŲ DĖŽĖS NUSTATYMAI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Su automatine pavarų dėže tereikia įjungti judėjimą pirmyn, atgal arba laisvą pavarą. Tai galima padaryti šiais klasvišais. Norėdami pakeisti nustatymus paspauskite ant mygtuko, o po to paspauskite klavišą tai funkcijai."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Jei prijungtas Jūsų H-jungiklis, galite juo simuliuoti tikrą automatinę pavarų dėžę. Pasirinkite šią opciją, ir galėsite pasirinkit H-jungiklio padėtis Vairavimo ir Atbulinio režimams, o kitos H-jungiklio padėtis bus laikomos Laisva pavara. Šis nustatymas skirtas specialiai H-jungikliams, ir jis neveiks nei su klaviatūra, nei su kitokiais valdikliais. Jei norite juos pakeisti, spauskite ant mygtuko, o po to pasirinkite norimą H-jungiklio padėtį."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEKVENCINĖS PAVARŲ DĖŽĖS NUSTATYMAI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvencinė pavarų dėžė jungia tarp visų pavarų, laisvos ir atbulinės. Štai mygtukai, naudojami pavarų perjungimui aukštyn ar žemyn. Galite juos pakeisti paspausdami ant mygtuko, o po to paspausdami norimą klavišą."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-JUNGIKLIO PAVARŲ DĖŽĖS NUSTATYMAI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Čia galite pasirinkti pagrindinį H-jungiklio išdėstymą ir išbandyti jo veikimą. Paveiksliuke matote dabartinę jungiklio padėtį, taip pat pasirinktą pavarą. Kadangi pavarų dėžė turi daugiau pavarų nei yra jungiklio padėčių, tenka daliklio mygtukais pasirinkti įvairius pavarų rinkinius."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Dabar pasirinkta jungiklio padėtis ir dalikliai taip pat rodomi apačioje. Norėdami pakeisti priskirtą funkciją, paspauskite ant atitinkamo mygtuko ir perjunkite jungiklį į norimą padėtį ir atgal į laisvą pavarą."
#@}

