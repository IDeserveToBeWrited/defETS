	val[]: "Pasirenk, kokį greičio apribojimą rodyti Navigacijos programėlėje."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Navigacijoje rodomas momentinis greitis paraudonuoja viršijus leistiną greitį."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Pasiekus tikslą bus parodyta programėlė, kuri leis praleisti parkavimą."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Palikti visas programėles paslėptas."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Palieka abu virtualius veidrodėlius paslėptus."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Palikti visus pranešimus paslėptais net kai jie gaunami."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Prieš priimant sunkaus krovinio užduotį parodo langą, rodantį žaidėjo dabartinio sunkvežimio charakteristikas."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Pasirink, kaip lygiuojamas Pasaulio Žemėlapis."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Pasirink, kaip atskleidžiamas Pasaulio Žemėlapis:<br>- \"Artumo tyrinėjimas\" pažymi didesnę zoną.<br>- \"Tikslus tyrinėjimas\" atskleidžia zona tik prie žaidėjo."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Pasirenkama, kaip rodoma navigacija"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia kaip dėliojamas maršrutas navigacijoje.<br>\"Geriausias\" navigacijos režimas parenka našiausią santykį tarp maršruto ilgio ir laiko, stengiasi išvengti šviesoforais reguliuojamų sankryžų ir pan.<br>\"Trumpiausias\" režimas visada parenka trumpiausią įmanomą kelią.<br>\"Maži keliai\" režimas stengiasi išvengti greitkelių."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Pakeičia parkavimo sudėtingumą.<br>\"Visada pasirinkti\" leidžia pasirinkti jį pasiekus tikslą.<br>\"Saugus parkavimas\" nereikalaus važiuoti atbulai.<br>\"Įgudęs parkavimas\" paprastai pareikalaus sudėtingesnio važiavimo atbulai."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Reguliuoja tikimybę sutikti pavojų kelyje - avarijos, sugedę automobiliai, šiukšlės kelyje ir pan."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Reguliuojama tikimybė sutikti uždarytą kelią ir apvažiavimą."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Reguliuoja blogo oro tikimybę."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirenkama, ar laiko zonos informacija rodoma greta dabartinio laiko."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungiami žaidimo filmukai, paprastai parodomi po sunkvežimio pirkimo, garažo atnaujinimo ar keleivių laipinimo."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirenkama, ar rodomos pusiau permatomos užtvaros keliuose, kur negalima važiuoti."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Apverčia pelės Y ašį valdant kamerą žaidime."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Pasirenka pavarų dėžės tipą.<br>\"Paprasta automatinė\" leidžia naudoti akseleratorių ir stabdį važiuojant pirmyn ir atgal.<br>\"Tikra automatinė\" reikalaus iš žaidėjo pačiam perjungti tarp judėjimo pirmyn ir atgal.<br>\"Sekvencinė\" reikalaus pačiam perjungti pavaras po vieną.<br>\"H perjungėjas\" reikalauja naudoti valdiklį ir rankiniu būdu rinktis pavaras."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Pasirinkus tai bus įjungtas \"pavarų praleidimas\" - pavarų praleidimas atliekamas, kai būtina arba praktiška perjungti po daugiau nei vieną pavarą."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Grąžina vairą į vidurį naudojant klaviatūrą arba žaidimų pultelį.<br><br>Tai išjungus žaidėjas pats turės atsukti vairą po posūkio."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Reguliuoja vairo animacijos intervalą. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia stabdžių intensyvumą."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia transporto stabilumą žeminant masės centrą."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia priekabos stabilumą žeminant masės centrą."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia transmisijos generuojamo sukimo momento intensyvumą.<br><br>Padidinus tai padidės jausmas, kad transportas \"riečiasi\" dešinėn."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia važiuoklės pakabos kietumą."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia kabinos pakabos kietumą."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Reguliuoja generuojamų paviršiaus nelygumų intensyvumą, kad keliai ir kita danga nebūtų tobula.<br><br>Priklausomai nuo kitų pakabos ir kameros nustatymų jaučiamas efektas gali būti daugiau ar mažiau pastebimas."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungia pažangų sukabinimą, reikalaujantį didesnio tikslumo privažiuojant prie priekabos.<br><br>Išjungus priekabos prikabinimas tampa gerokai lengvesniu."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirenkama ar animuoti priekabos kabelius ir kuriuos.<br><br><color value=@@clr_txt_d@@>Įjungus kabelius daugiau automobilių gali sulėtėti senesnių kompiuterių vaizdas."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungia sunkvežimio elektroninį greičio ribotuvą - 90 kmh (56 mph).<br><br><color value=@@clr_txt_d@@>World of Trucks užduotyse ribotuvas įjungtas visada."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus tai ir valytuvų svirtį įjungus į pirmą padėtį, valytuvai automatiškai įsijungs ir reguliuos savo greitį pagal sąlygas."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungia automatinį retarderio naudojimą stabdant."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus pagalbininkas padeda pajudėti įkalnėje laikydamas nuspaustus stabdžius."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungia automatinį variklio stabdžio naudojimą stabdant."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus tai variklis įsijungs vos palietus akseleratorių."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus tai transporto stovėjimo stabdis įjungiamas pagal nutylėjimą (pasinaudojus keltu, nutempus į servisą, po greitos kelionės ir pan.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Automatiškai reguliuoja pakeliamas ašis priklausomai nuo svorio."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus sunkvežimis palaikys mažesnes apsukas. Greitai du kartus paspaudus akseleratorių sunkvežimis laikys maksimalias apsukas kol nebus paleistas akseleratoriaus mygtukas.<br><br>Veikia tik su klaviatūra."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simuliuoja tikrą oro slėgio praradimą dėl per dažno stabdymo.<br><br>Įjungus tai teks stebėti oro slėgį leidžiantis nuo kalno ar daug manevruojant aikštelėse."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Išjungus tai kuro sąnaudų neveiks vairavimo stilius ar kelio sąlygos.<br><br>Įjungus kuro sąnaudas veiks įvairūs faktoriai, įskaitant vairavimo stilių, krovinio svorį, riedėjimo pasipriešinimą ir kalnuotumą. Kuro sąnaudų nebeveiks @@skill_mechanical_title@@ įgūdis."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus ABS neleis užsirakinti ratams, taip leidžiant geriau valdyti sunkvežimį stabdymo metu."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus transportas pristabdys atskirus ratus prasisukant ar slystant ratams."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus tai transportas užrakins diferencialus jei ratai pradės slysti."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia žingsnį, kuriuo reguliuojama greičio palaikymo sistema."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia greičio palaikymo sistemos paklaidą palaikant nustatytą greitį."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus tai greičio palaikymo sistema automatiškai reguliuos greitį išlaikydama saugų atstumą iki priekyje važiuojančios transporto priemonės."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungia avarinį stabdymą, jei sistema pajaučia neišvengiamą pavojų.<br>Pasirenkama, ar sistema reaguos tik į kitus automobilius, ar į visas kliūtis."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Juostos pagalbos režimai.<br>\"Juostos nukrypimo perspėjimo\" režimas garsu praneš, kad artėji prie eismo juostos ribos.<br>Papildomai prie garsinio pranešimo \"Juostos palaikymo pagalba\" taip pat pavairuos transportą, kad jis neišvažiuotų iš juostos.<br><br>Abu režimai veikia tik virš 55 kmh (35 mph) greičio.<br>Juostos pagalbininkas taip pat įvertina naudojamus posūkių signalus."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungia aklos zonos jutiklio funkciją, jei transportas turi tokį jutiklį."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus ir pasirinkus pirmą šviesų padėtį, šviesos automatiškai įsijungs sutemus."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus tai ir šviesas sunkvežimis automatiškai išjungs tolimas šviesas kai pastebės artėjančią transporto priemonę."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus, posūkių signalai automatiškai išsijungs, atsukus vairą į vidurį."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus kai kurie vidaus aksesuarai reaguos į fizinį sunkvežimio judėjimo (kabančios dekoracijos, judančios galvos ir pan.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Leidžia paversti vidaus kamerą pagal vairo pasukimą."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Pakeičia, kaip aštriai reaguoja \"vairavimo kameros sukimas\". "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia \"vairavimo kameros sukimo\" elgesį važiuojant atbulai."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus tai vidaus kamera pasuks kairėn ar dešinėn pagal rodomą posūkio signalą."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Įjungus vidaus kamera reaguos į sunkvežimio judėjimą."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Keičia, kaip aštriai vidaus kamera reaguoja į sunkvežimio judėjimą."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Pakeičia kiek vidaus kamera pasivers pagal sunkvežimio judėjimą."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Nustato laiką, po kurio kamera automatiškai grįžta į centrą.<br><br>Sunkvežimis turi judėti reikšmingu greičiu, kad tai suveiktų. Taikoma tik vidaus kamerai ir kamerai, sekančiai iš paskos judant į priekį, taip pat judant atbulai taikoma žiūrint pro vairuotojo langą."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Nustato kameros judėjimo greitį. Jį naudoja automatinis kameros centravimas ir perjungimas tarp vidaus kamerų."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Nustato, kaip veikia priartinimas viduje: ar laikyti mygtuką laikinam priartinimui, ar paspaudus perjungti priartinimą." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Parenka kalbą, rodomą žaidime."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Keičia valiutą ir matavimo vienetus pasirinktame regione."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus miestai ir valstybės bus rodomi tavo pasirinkta kalba."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus miestai ir valstybės bus rodomi ir tavo pasirinkta kalba, ir gimtąja to regiono kalba."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirink valiutą."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirink 12-os ar 24-iū valandų laikrodį."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirink atstumo matavimo vienetus."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirink svorio matavimo vienetus."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Pasirink temperatūros matavimo vienetus."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Pakeičia slėgio matavimo vienetus."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Pakeičia tūrio matavimo vienetus."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Pakeičia sąnaudų matavimo vienetus."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus \"Aktyvuoti\" klavišas (@@imv_nrm_activate@@) Konvojaus metu atidarys pokalbių langą."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus pokalbio lango teksto įvedimo juostelė liks aktyvi išsiuntus žinutę."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus pokalbių pranešimai išnyks po kelių sekundžių."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Pakeičia, po kiek laiko išnyksta pokalbių pranešimai."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Įjungus Konvojuje žaidėjų vardai bus rodomi virš jų sunkvežimių."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Atidaro papildomą meniu, kuriame galime paruošti greitus atsakymus pokalbiams Konvojuje."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Patikrina prijungto World of Trucks turinio būseną."

	key[]: "online_news_op_tooltip" # - Online, Simple
