#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Įvyko klaida kraunant Steam inventorių.<br><br>$ERROR$<br><br>Spauskite tęsti kad palikti įjungta turinį. Žaidimas automatiškai kartos paiešką.<br><br>Galite laikinai išjungti turinį kad nepasirodytų daugiau pranešimų apie klaidą, tokių kaip šis. Žaidimas automatiškai vėl įjungs Jūsų turinį kitą kartą paleidus žaidimą." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Nepavyko atsisiųsti daiktų iš Steam inventoriaus." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTORIUS" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Kraunu Steam inventoriaus daiktus..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NAUJI DAIKTAI INVENTORIUJE" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
