	val[]: "Kadrų per sekundę riba sumažinus žaidimą" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Įprastas dažnis" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikali sinchronizacija" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomiškas (taupo energiją laptopuose)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "PAPRASTI GRAFIKOS NUSTATYMAI" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "PRITAIKYTI KITOKIE NUSTATYMAI" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "PAPILDOMI GRAFIKOS NUSTATYMAI" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Paprasti/sudėtingi grafikos nustatymai" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Paslėpti papildomus nustatymus" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Rodyti papildomus nustatymus" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Mastelis" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Glodinimas (AA)" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma aštrinimas" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA reguliavimas" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Prisitaikantis ryškumas" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Visada švelnu" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Visada aštru" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Ekrano erdvės okliuzija (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Aukštas dinaminis ruožas (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Ryškumo gylis (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Saulės atspindžiai" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Spalvų korekcija" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Atspindžių kokybė" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Atspindžių detalės" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Augalijos detalumas" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Žolės tankis" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Šešėlių kokybė"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Šešėlio tekstūros dydis" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Tolimi šešėliai" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Vidaus šešėliai" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Oro sąlygų kokybė"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Veidrodžio kokybė" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Veidrodžių rezoliucija" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Veidrodžių atstumas" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Tekstūrų kokybė" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropinis filtravimas" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normalūs žemėlapiai" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Eismo automobilių šviesos" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Papildomos transporto šviesos" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Šviesų matomumo atstumas" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Pėstieji" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Buvo pakeisti ekrano nustatymai.<br>Ar norite juos patvirtinti?"

	key[]: "reverting_in"
	val[]: "Bus atstatyta po" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sek." #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Įjungus žaidimas bus rodomas per visą ekraną."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Reguliuoja bendrą žaidimo ryškumą. HDR palaikančiuose ekranuose čia bus galima kalibruoti HDR nustatymus."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Keičia žaidimo rezoliuciją."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Keičia žaidimo vaizdo atnaujinimo dažnį."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Suderina kadrus per sekundę su monitoriaus atnaujinimo dažniu dėl geresnio vaizdo. Ekonomiškas nustatymas taip pat perpus sumažina kadrus per sekundę mažinant energijos suvartojimą."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Nustato maksimalų kadrų skaičių žaidime.<br><br>Nustačius 0 ribojimas bus išjungtas."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Nustato maksimalų kadrų skaičių žaidime kai jis sumažintas į foną.<br><br>Nustačius 0 ribojimas bus išjungtas."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Pasirenkama rodyti paprastus grafikos nustatymus (iš anksto parengtus rinkinius) ar sudėtingus grafikos nustatymus (galimybė keisti atskirus parametrus)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Pagerina bendrą vaizdą piešiant žaidimą didesne vidine rezoliucija, taip suapvalinant aštrius kampus ir piešiant daugiau detalių.<br>Pavyzdžiui, pasirinkus didesnį mastelio nustatymą vaizdas bus aiškesnis, su mažiau išplaukimo, dėl to žaidimas atrodys geriau, bet su mažiau kadrų per sekundę.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi didelį poveikį."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Didelio greičio antialiasing metodų, sušvelninančių aštrias linijas, pasirinkimas:<br>- SMAA kelis kartus patikrina kiekvieną pikselį (priklausomai nuo pasirinktos kokybės) įvairiose kadro vietose ir apskaičuoja vidurkį kurdamas galutinį vaizdą.<br>- TAA tikrina kiekvieną pikselį tik kartą per kadrą, bet įvairiose vietose ir įvairiuose kadruose.<br>- Geriausiam rezultatui galima įjungti juos abu, bet sumažės nupiešiamų kadrų per sekundę kiekis.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Prideda minkštus šešėlius plyšiams ir objektams, esantiems arti vienas kito. Taip pagerėja viso žaidimo pasaulio grafinis vientisumas.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Pasirenkama TAA nustatymai:<br>- \"Visada švelnūs\" sukurs mažiau mirgėjimo ir daugiau išplaukimo - tai tinkama žaidėjams, kurie įjungia supersampling arba turi didelės raiškos monitorių, taip pat 1080p TV vartotojams, sėdintiems toliau nuo ekrano.<br>- \"Visada aštrūs\" sukurs daugiau mirgėjimo ir mažiau išplaukimo - tai turbūt geriausias pasirinkimas mažiau nei 1080p naudojimui, pvz. nešiojamuose kompiuteriuose.<br>- Pasirinkus \"Adaptyvus ryškumas\" TAA mirgėjimas bus dinamiškai išjungiamas kamerai nejudant.<br><br><color value=@@clr_txt_d@@>Šis nustatymas gali būti naudojamas tik pasirinkus TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja TAA apšvietimo aštrumo stiprumą.<br><br><color value=@@clr_txt_d@@>Šis nustatymas veikia tik pasirinkus TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungus tolimos vietos žemėlapyje bus dirbtinai suliejamos kuriant realistišką ryškumo mažėjimą tolumoje."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungus šviesos spinduliai gali būti matomi žiūrint į Saulę, arba žiūrint į Saulę pro medžius, pastatus ar automobilius."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungus žaidimo spalvos dinamiškai reguliuojamos dėl grožio. Vaizdai bus geriau pritaikyti prie paros meto ir oro sąlygų, automobilių ir kitų objektų spalvos gali būti gyvesnės ir pan."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Pagerina atspindžius piešiant juos didesne kokybe, taip pat naudojant gersnį gludinimą.<br><br><color value=@@clr_txt_d@@>Šio nustatymo pakeitimai įsigalios tik iš naujo paleidus žaidimą."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja atspindžius, matomus transporto paviršiuose, languose ir kituose atspindinčiuose objektuose, pvz. balose, šlapiuose keliuose ir ant vandens.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį.<br><br>Šio nustatymo pakeitimai įsigalioja tik iš naujo paleidus žaidimą."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja augalų ir medžių detalumą.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja pakelės žolės tankumą.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja Saulės ar Mėnulio metamų šešėlių kokybę.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Leidžia piešti šešėlius net nuo labai tolimų objektų.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungia dinaminius nakties šešėlius transporto viduje.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja oro efektų kokybę, pavyzdžiui atspindžių."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja kokybę atspindžių, matomų transporto veidrodėliuose (nepriklausomai nuo atspindžių nustatymo).<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja tavo sunkvežimio veidrodyje piešiamo vaizdo rezoliuciją."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja atstumą, nuo kuriuo objektai piešiami veidrodžiuose.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi didelį poveikį."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja žaidimo objektų ir paviršių kai kurių tekstūrų kokybę."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Gerina tekstūrų aštrumą, ypač matomų iš toli ir nuožulniu kampu.<br><br><color value=@@clr_txt_d@@>Šio nustatymo pakeitimai įsigalios tik iš naujo paleidus žaidimą."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Prie šaligantvių, kelių ir kitų objektų prideda geometrinių detalių išvaizdą, pagerinant jų vaizdą.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį.<br><br>Šio nustatymo pakeitimai įsigalioja tik iš naujo paleidus žaidimą."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungia apšvietimą nuo kitų eismo transporto priemonių šviesų."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungia apšvietimą nuo kitų eismo transporto priemonių antrinių šviesų, tokių kaip posūkių signalai ar stabdžių žibintai."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Reguliuoja atstumą, nuo kurio matomi dirbtiniai šviesos šaltiniai.<br><br><color value=@@clr_txt_d@@>Šis nustatymas dažnai turi vidutinį poveikį."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Įjungia žaidimo pasaulyje pėsčiuosius."
