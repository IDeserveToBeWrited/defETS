	key[]: "connecting_content_t"
	val[]: "TURINIO PRIJUNGIMAS" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Prijungiu turinį." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Nepavyko pastatyti į eilę prisijungimo operacijos: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam sąskaita, kuria užregistravote šį DLC, skiriasi nuo tos, kuria buvo sukurta jūsų World of Trucks sąskaita ar registruotas žaidimas. Pakeiskite Steam sąskaitą ir bandykite vėl." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam sąskaita, kuriai norite užregistruoti šį DLC, jau yra susieta su kita World of Trucks sąskaita. Kad užregistruomėte DLC šiai sąskaitai, reikia Steam sąskaitos, kuri neprijungta prie jokios World of Trucks sąskaitos." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam žetonas paseno. Bandyk vėliau." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "DLC aktyvavimui naudojamas raktas neteisingas. Galite kreiptis pagalbos čia: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Registruojant žaidimą įvyko vidinė klaida. Pabandykite vėliau." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "PAVYKO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "INTERNETAS" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "TURINIO NARŠYKLĖ" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Sveikinu! Pasirinkti DLC buvo sėkmingai prijungti prie World of Trucks sąskaitos." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nepavyko prijungti turinio, nes dabartinė Steam sąskaita yra susieta su kita World of Trucks sąskaita." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Nepavyko prijungti kai kurių DLC.<br>Užveskite pelės kursorių ant kiekvieno šauktuko ir sužinokite daugiau." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registruoju $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Dabartinis profilis neprijungtas prie World of Trucks arba žaidimas neturi interneto. Paredaguok profilį kad prisijungtum." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Paspausk kad atmestum"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ suderinamų DLC prijungta. Jei dalis DLC nebus prijungti prie World Of Trucks, gali neveikti kai kurios funkcijos." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Sveikiname! <color value=@@clr_txt@@>Visas tavo turinys prijungtas prie World of Trucks! Dabar galite naudoti visas funkcijas." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Nepavyko prijungti naujo turinio prie World of Trucks, nes dabartinė Steam sąskaita neatitinka World of Trucks profilio naudojamos Steam sąskaitos." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Prijungta" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Neprijungta" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Nepavyko gauti info apie turimą turinį." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Nepavyko gauti info apie prijungtą turinį." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Nepavyko gauti info apie naudojamą sąskaitą." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Vėliau" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Nepavyko užregistruoti šio DLC. Neradau pastovios licencijos, gal dėl Steam Šeimos dalijimosi." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Nėra nuolatinės priklausomybės" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Ypatingo krovinio misija atlikta!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISIJA NEPAVYKO!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Nutraukti"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Užkrauti tarpinį tašką"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Apgadinai palydos automobilį!<br> Gali užkrauti tarpinį tašką ar nutraukti pristatymą su bauda $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Palydos automobilis susidūrė su kitu automobiliu dėl neteisingo vairavimo.<br>Gali užkrauti tarpinį tašką ar nutraukti pristatymą su bauda $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Turėjai laikytis maršruto.<br> Gali užkrauti tarpinį tašką ar nutraukti pristatymą su bauda $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Turėjai laikytis tarp palydos automobilių.<br> Gali užkrauti tarpinį tašką ar nutraukti pristatymą su bauda $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Atsiplėšei nuo palydos!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Apgadinote palydos automobilį!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Palydos automobilis patyrė avariją!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Nukrypai nuo maršruto!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Matmenys"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Ypatingo krovinio pristatymas"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Važiuokite tarp palydos automobilių."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Ypatingi pristatymai"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Matmenys"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Ypatingas krovinys"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Važiuokite lėčiau kad nesusidurtumėte su palydos automobiliu..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Palaukite galinio palydos automobilio..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Atsargiai, netrukus bus sudėtinga kelio dalis..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Netrukus reikės persirikiuoti. Neskubėkite..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Priekinė palyda perspės kitus vairuotojus... <br> Važiuokite tokiu greičiu, kad išvengtumėte avarijos..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Palydos automobiliai laukia tavęs prie sankryžos. Važiuokite maršrutu."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Atsargiai!<br>Važiuojate link galinės palydos!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Atsargiai!<br>Privažiavote labai arti galo palydos!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Spauskite šį mygtuką kad peržiūrėtumėte Ypatingo Darbo pasiūlymą:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Ypatingo krovinio pasiūlymas:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Netrukus imsiesi Ypatingo krovinio pristatymo! Tave lydės du palydos automobiliai. Būk atidus ir sek jų nurodymais ir pasiūlymais. Tokie Ypatingi kroviniai nestoja prie raudono šviesoforo signalo ir daugeliu atvejų turi pirmenybę. Tokiuose pristatymuose gana dažnai bus atliekami automatiniai išsaugojimai."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Ypatingai atkreipkite dėmesį į:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Venkite nesutarimų su palyda ir važiuokite tarp jų."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Nenukrypkite nuo numatyto maršruto ribų, nevažiuokite į degalines ar poilsio aikšteles."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Laikykitės greičio apribojimų, o jums padės priekinis palydos automobilis."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Stebėkite lenkiančius ir kitus vairuotojus keliuose."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Persirikiavimo manevras:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Jei nesilaikysite šių taisyklių, ypatingo krovinio misija nepavyks!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manevrą pradeda <color value=@@clr_sel@@>galo<color value=@@clr_txt@@> palyda, užblokuodama numatytą juostą."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Priekio<color value=@@clr_txt@@> palyda laukia, kol juosta atlaisvės, tada taip pat persirikiuoja."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Tada bus saugu <color value=@@clr_sel@@>žaidėjui<color value=@@clr_txt@@> persirikiuoti į numatytą juostą."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Sunkvežimio kuro bakai pripildyti, o vairavimo valandos atkurtos."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Ypatingo krovinio misijoje negalima iškviesti pagalbos."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Ypatingo krovinio misijoje negalima naudoti kelto."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Ilsiesi...<br>Sunkvežimio bakai užpildomi..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Artėja privalomas sustojimas.<br>Sek paskui palydą iki sustojimo vietos, kad pailsėtum!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Privalomas sustojimas"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Spausk šį mygtuką kad pailsėtum ir papildytum degalų atsargas:"
