#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Tęsti ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Jus sveikina Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Pagaliau galite išbandyti savo svajonių darbą - sunkvežimio vairavimą!"

	key[]: "intro_3"
	val[]: "Jūsų transporto kompanija pradeda veiklą, tačiau kol kas neturite pinigų savo sunkvežimio įsigijimui. Kol kas teks dirbti kitoms kompanijoms samdomu vairuotoju."

	key[]: "intro_4"
	val[]: "Jūsų užduotis yra saugiai nugabenti krovinį $JOB_CARGO$ iš $JOB_TARGET_COMPANY$ doko mieste $JOB_TARGET_CITY$. Jūsų darbdavys suteiks Jums sunkvežimį ir padengs visas išlaidas. Nieko neapvilkite ir atvykite laiku."


	key[]: "intro_garage_1"
	val[]: "Tai jūsų štabas."

	key[]: "intro_garage_2"
	val[]: "Tai bazinis garažas. Nieko ypatingo, bet tai pradžia."

	key[]: "intro_garage_3"
	val[]: "Deja, kol kas čia niekas nepriparkuota, todėl nesimato jokio sunkvežimio."

	key[]: "intro_garage_4"
	val[]: "Kai užsidirbsite pakankamai pinigų ir nusipirksite sunkvežimį, galėsite laisvai keliauti po pasaulį ir valdyti savo verslą iš čia."

	key[]: "intro_garage_5"
	val[]: "Sėkmės!"


	key[]: "desktop_tut_t"
	val[]: "ATRAKINTA FUNKCIJA"

	key[]: "desktop_tut_job"
	val[]: "Rinkitės sekantį darbą"

	key[]: "desktop_tut_cargo_market"
	val[]: "Savo nauja priekaba ir Krovinių birža pervežkite daugybę įvairių krovinių." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Čia galite matyti savo progresą."

	key[]: "desktop_tut_company"
	val[]: "Čia galite stebėti savo garažus, samdyti naujus vairuotojus ir kitaip valdyti kompaniją."

	key[]: "desktop_tut_trailers"
	val[]: "Nuo šiol gali nusipirkti priekabas bei atnaujinti ir perdažyti jas.<br><br>Priekabos bus saugomos pasirinktame garaže, jas galės naudoti visi tavo vairuotojai. Priekabas tvarkyti gali Priekabų valdyme."

	key[]: "desktop_tut_visit_directive"
	val[]: "Aplankyk $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "SVEIKI ATVYKĘ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Sveiki atvykę į naują Namų ekraną<br>Čia galima naudoti visas žaidimo funkcijas."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Apačioje Pagrindinis meniu suteikia tiesioginį kelią į visas pagrindines, tau jau pažįstamas žaidimo funkcijas."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Viršuje nauja Būsenos juosta visuomet matoma ir padeda žaidėjams pamatyti profilio statistiką ir vietos eismo taisykles."

	key[]: "desktop_tut_tour_home"
	val[]: "Mygtukas \"Namai\" visada perkels tave atgal į Namų Ekraną."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Nuolatinis Greitas meniu pateikia patogų priėjimą prie žaidimo funkcijų iš bet kurio ekrano."

	key[]: "desktop_tut_tour_drive"
	val[]: "Atnaujintas Važiavimo mygtukas lieka tavo ryšiu su vairavimo pasauliu, pasiruošęs grąžinti tave į kelią."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "MOKYMAS BAIGTAS"

	key[]: "desktop_tut_tour_finish"
	val[]: "Dėkojame, kad peržiūrėjai mūsų Namų ekrano atnaujinimą."
