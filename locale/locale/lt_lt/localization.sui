	key[]: "desktop_background"
	val[]: "Darbastalio fonas" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Nudažymas" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Išjungti inventorių" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Bandykite vėliau" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

