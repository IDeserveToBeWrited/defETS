	key[]: "load_save_t"
	val[]: "IŠSAUGOTI AR UŽKRAUTI ŽAIDIMĄ" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "Išsaugoti ir užkrauti" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Aptiktas žaidimo pakeitimas! Norint išvengti problemų su išsaugojimų suderinamumu dėl pokyčių žaidimo pasaulyje, visi nepristatyti kroviniai buvo atšaukti be jokių baudų." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Aptiktas žaidimo pakeitimas!<br><br> Norint išvengti problemų su išsaugojimų suderinamumu dėl pokyčių žaidimo pasaulyje, visi nepristatyti kroviniai buvo atšaukti be jokių baudų. Reikia saugiai perkelti sunkvežimį.<br><br>Prašau pasirinkti greitos kelionės tikslą." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Išsaugau..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Paspauskite klavišą $KEY$, kad praleistumėte filmuką." #+ Shown when any key was pressed during viewpoint cutscene.

