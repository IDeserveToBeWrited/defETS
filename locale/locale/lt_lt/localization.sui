#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Parenka žaidimų pultelio tipą žaidime."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Pasirenka pavarų dėžės tipą.<br>\"Paprasta automatinė\" leidžia naudoti akseleratorių ir stabdį važiuojant pirmyn ir atgal.<br>\"Tikra automatinė\" reikalaus iš žaidėjo pačiam perjungti tarp judėjimo pirmyn ir atgal.<br>\"Sekvencinė\" reikalaus pačiam perjungti pavaras po vieną.<br>\"H perjungėjas\" reikalauja naudoti valdiklį ir rankiniu būdu rinktis pavaras."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Pakeičia automatinės pavarų dėžės pavarų perjungimo logiką.<br>- \"Ekonominis\" režimas dažniau naudoja žemesnes apsukas, arčiau sukimo momento piko.<br>-\"Galios\" režimas labiau naudoja maksimalaus galingumo apsukas, geresniam vairavimui vežant sunkius krovinius ar kalnuose, bet aukojant kuro suvartojimą."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Priderina įrenginio vairo pasukimo laipsnius prie sunkvežimio tikro vairo pasukimo laipsnių."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Derina vairo pasukimo linijiškumą.<br><br>Aukšta reikšmė reiškia, kad vairo pasukimas bus ne toks jautrus centre, ir bus vis aštresnis labiau pasukant vairą. tai gali padėti švelniau vairuoti važiuojant tiesiai."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Įjungia galios reagavimą tai palaikančiuose įrenginiuose."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja bendrą visos galios reagavimo nustatymą nuo 0N iki 10N.<br><br><color value=@@clr_txt_d@@>Atmink, kad per didelis nustatymas galinguose vairuose gali sužaloti pirštus ar rankas."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja centravimo jėgą važiuojant dideliu greičiu, pasiekiant piką prie 90 kmh (56 mph) ir daugiau.<br><br>Minimalus nustatymas reikš, kad centravimo jėgos nebus visai."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja centravimo jėgą važiuojant mažu greičiu.<br><br>Minimalus nustatymas reikš, kad centravimo jėgos nebus visai."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja dirbtinės vidinės trinties jėgą, imituojant mechaninius vairo komponentus."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja dirbtinio variklio rezonanso jėgą, perduodamą per vairą.<br><br><color value=@@clr_txt_d@@>Atmink, kad nustačius daugiau nei 15% kai kurie vairai gali per smarkiai drebėti ar vibruoti."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja kelio paviršiaus efektų, perduodamų per vairą, jėgą.<br><br><color value=@@clr_txt_d@@>Atmink, kad nustačius daugiau nei 20% kai kurie vairai gali per smarkiai drebėti ar vibruoti dideliu greičiu važiuojant nelygiu keliu."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja kelio duobių efektų, perduodamų per vairą, jėgą."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja susidūrimų efektų, perduodamų per vairą, jėgą."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja pavarų dėžės blogo perjungimo intensyvumą."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja slystančių priekinių ratų efekto jėgą."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja pagalbinio vairavimo stiprumą, (pvz. naudojant juostos padėjėją)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja paviršiaus vibracijos intensyvumą, jei valdiklis palaiko vibraciją."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja duobių vibracijos intensyvumą, jei valdiklis palaiko vibraciją."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Reguliuoja susidūrimų vibracijos intensyvumą, jei valdiklis palaiko vibraciją."

