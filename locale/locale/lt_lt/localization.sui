#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Ekrano nuotraukos failas per didelis. Pabandykite sumažinti ekrano rezoliuciją." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Ekrano nuotraukos failas sugedęs arba nepalaikomas" #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Ekrano nuotraukos rezoliucija per didelė. Pabandykite sumažinti ekrano rezoliuciją." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Tarnyba atmetė ekrano nuotrauką." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
