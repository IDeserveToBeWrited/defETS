#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKAS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Bankas" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Jei Jums reikia pinigų, visada galite paimti paskolą iš banko." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "PASKOLŲ PASIŪLYMAI" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "už $MONEY$ per dieną" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Turima aktyvių paskolų: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Galite pasiskolinti: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "AKTYVIŲ PASKOLŲ APŽVALGA"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Paskola" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Liko grąžinti" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Trukmė (dienomis)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Metinė palūkanų norma" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Mokėjimai" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Grąžinti" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Viso:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Sąskaitos likutis: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NAUJA PASKOLA" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Prašote $MONEY$ paskolos" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Grąžinimo laikas:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Metinė palūkanų norma:" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Kasdienis mokejimas:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Ar norite patvirtinti prašymą?"
#@}

