	key[]: "controllers"
	val[]: "Valdikliai"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Pagalbininkas pritaikys rekomenduojamu nustatymus pagal prijungtus įrenginius.<br><color value=@@clr_sel@@>Jei naudoji su Steam suderinamą žaidimų pultelį, galite įjungti konfigūracijos palaikymą <br><color value=@@clr_txt_d@@> \"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Vairuokite naudojami klaviatūrą, o dairykitės pele. Tai paprasčiausias ir mažiausiai tikslus valdymo būdas, tačiau prieinamas visiems."

	key[]: "wiz_control_mouse"
	val[]: "Naudokite pelę tiksliam vairavimui. Klaviatūra naudojama kitiems veiksmams. Apsidairyti aplinkui naudojant pelę bus galima tik laikant nuspaudus kameros valdymo mygtuką."

	key[]: "wiz_control_controller"
	val[]: "Naudokite vairą, geimpadą arba kreiptuką realistiškiausiems potyriams. Klaviatūra gali būti naudojama greitam įvairių funkcijų iškvietimui, o kamerą valdyti galima pele."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nerastas joks žaidimų valdiklis. Norėdami šio pasirinkimo turite prijungti kokį nors valdiklį!"

