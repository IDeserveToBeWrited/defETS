	key[]: "no_drive_t"
	val[]: "TRANSPORTO NĖRA" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "Negalite laisvai važinėti po pasaulį nes neturite transporto. Galite jį nusipirkti arba paimti iš kito vairuotojo.<br><br>Ar norite imtis greito darbo?"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "UŽKRAUTI ŽAIDIMĄ"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Užkrauti žaidimą" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Užkrauti anksčiau išsaugotą žaidimą. Dabartinis progresas bus prarastas!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Ar tikrai norite užkrauti kitą žaidimą?<br><br>Prarasite visą dabartinį progresą nuo paskutinio išsaugojimo."

	key[]: "load_progress_lost_mp"
	val[]: "Ar tikrai nori užkrauti kitą žaidimą?<br>Taip darant žaidžianti internete gali būti nutrauktas darbas, perkeltas į artimiausias dirbtuves ar nebeįmanoma vykdyti pasirinktą darbą.<br><br>Dabartinis progresas bus prarastas, nebent buvo išsaugota anksčiau."

	key[]: "load_game_mp_suspended_job"
	val[]: "Išsaugotas žaidimas sėkmingai užkrautas, bet tavo aktyvus World of Trucks darbas pristabdytas ir šoje sesijoje bus negalimas."

	key[]: "autosave"
	val[]: "- Autoišsaugojimas -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Greitas išsaugojimas -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Rodyti auto-išsaugojimus" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Neradau neautomatinių išsaugojimų." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Užkrauti" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Nesuderinamas išsaugojimas!<br><color value=@@clr_txt@@>Pabandyk atnaujinti žaidimą iki naujausios versijos." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nepavyko užkrauti ir parodyti visų šio profilio išsaugotų žaidimų." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "DĖMESIO" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problema kraunant išsaugojimą.<color value=@@clr_txt@@><br><br>Nepavyko užkrauti išsaugojimo. Galite pabandyti nustatyti ir pataisyti problema naudodamiesi žemiau pateikta informacija. Arba galite pabandyti užkrauti kitą išsaugojimą.<br><br>Dažnai problemas kelia šios priežastys:<br><br>1. Išsaugojimas nesuderinamas su kai kuriais instaliuotais modais.<br><br>2. Išsaugojime yra informacijos iš modų, kurie išjungti arba ištrinti.<br><br>3. Išsaugojimą sugadino prastai sukurtas modas.<br><br>4. Kompiuterio perkrovimas per ar iš karto po išsaugojimo galėjo jį sugadinti."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Nustatyta, kad trūksta modo.<color value=@@clr_txt@@><br><br>Paskutiniame išsaugojime buvo naudotas dingęs arba išjungtas modas.<br><br>Jei to nesitikėjote, patikrinkite savo modus.<br><br>Kitaip galite vis tiek pabandyti užkrauti išsaugojimą. Tačiau priklausomai nuo to, ką darė trūkstami modai, gali būti, kad užkrauti nepavyks arba kils kitų problemų.<br><br>Arba galite pabandyti užkrauti kitą išsaugojimą, kuriam nereikia trūkstamų modų."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Nustatytas trūkstamas DLC.<color value=@@clr_txt@@><br><br>Vėliausias išsaugojimas priklauso nuo trūkstamo DLC (oficialaus žaidimo papildymo).<br><br>Jei šito nesitikėjote, patikrinkite DLC būklę.<br><br>Kitu atveju galite vis tiek krauti išsaugojimą, tačiau gali trūkti DLC esančios medžiagos.<br><br>Arba galite pabandyti krauti išsaugojimą, nepriklausomą nuo trūkstamo DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Nustatyta, kad trūksta DLC.<color value=@@clr_txt@@><br><br>Paskutiniame išsaugojime buvo naudotas DLC (oficialus žaidimo papildymas).<br><br>Jei norite, kad šis išsaugojimas veiktų tinkamai, reikia, kad šis DLC būtų instaliuotas ir aktyvuotas šiame kompiuteryje.<br><br>Arba galite pabandyti užkrauti kitą išsaugojimą, kuriam nereikia trūkstamų modų."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Modui reikalingas DLC turinys.<color value=@@clr_txt@@><br><br>Bent vienam modui reikalingas DLC (oficialus žaidimo papildymas) kuris šiuo metu neinstaliuotas.<br><br>Reikia arba išjungti modą(-us), arba instaliuoti reikalingą (-us) DLC."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Aptiktas lūžis<color value=@@clr_txt@@><br><br>Atrodo, kad paskutinio krovimo metu įvyko lūžis.<br><br>Galite pabandyti nustatyti ir pataisyti problema naudodamiesi žemiau pateikta informacija. Arba galite pabandyti užkrauti kitą išsaugojimą.<br><br>Dažnai problemas kelia šios priežastys:<br><br>1. Sugedo ar šiai žaidimo versijai netinka vienas ar daugiau modų.<br><br>2. Išsaugojime yra informacijos iš modų, kurie išjungti arba ištrinti.<br><br>3. Išsaugojimą sugadino prastai sukurtas modas.<br><br>4. Kartais žaidimą nulaužia geležies arba draiverių gedimai."

	key[]: "mods_detected_warning"
	val[]: "Aptikau Modų. Atminkite, kad nekorektiški, pasenę arba nesuderinami modai gali būti nestabilumo šaltiniu. Peržiūrėkite aktyvius modus Modų valdyme." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

