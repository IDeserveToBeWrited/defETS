#+ Missing controller screen
#+
#+ Informs the player that one from the controllers used by input configuration is missing.
#@{
	key[]: "missing_controllers_t"
	val[]: "CONTROLADORES EM FALTA" #+ Title of window containing information about missing controlllers. Please keep in upper case where possible.

	key[]: "missing_controllers"
	val[]: "Os controladores de jogo (ex.: gamepads, volantes) listados abaixo que são utilizados pela tua configuração de controlos estão em falta. Certifica-te de que estão ligados e não se encontram desligados, e pressiona o botão '@@controllers_detect@@' abaixo." #+ General explanation of the reason for the message.

	key[]: "controllers_detect"
	val[]: "Detectar" #+ Button which triggers detection of new controllers.

	key[]: "controllers_use_keyboard"
