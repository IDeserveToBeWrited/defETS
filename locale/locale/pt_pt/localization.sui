	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "A aquisição de DLCs está a demorar mais do que o esperado. Deseja continuar a aguardar?<br><br>Se você prosseguir, a aquisição continuará em segundo plano."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "O acesso a alguns DLCs foi adquirido. Deseja retornar ao Ecrã Inicial agora para aceder ao novo conteúdo?<br><br>O seu progresso será guardado automaticamente. Deseja continuar a aguardar?<br><br>Se prosseguir, a aquisição continuará em segundo plano."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "O acesso a alguns DLCs foi perdido. Irá voltar ao Ecrã Inicial para reflectir as mudanças de conteúdo?<br><br>O seu progresso será guardado automaticamente."
#@}

