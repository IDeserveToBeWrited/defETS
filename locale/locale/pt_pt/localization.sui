	val[]: "Espaços da galeria de fotografias do World of Trucks." #+ Slots title

	key[]: "screenshotman_empty"
	val[]: "Tirar captura de ecrã para mostrar aqui." #+ Empty screenshot position

	key[]: "screenshotman_offline"
	val[]: "PERFIL SEM LIGAÇÃO!<br><br>Para enviares uma imagem, o teu perfil deve estar ligado à conta online.<br><br>Queres editar o teu perfil agora?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Espaço vazio" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Erro" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Upload para o espaço seleccionado" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Usar como o meu camião do perfil" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Deseja eliminar permanentemente a captura de ecrã?"

	key[]: "upload_screenshot"
	val[]: "Deseja fazer upload da captura de ecrã para este espaço?<br><br>O conteúdo do espaço será substituído!"

	key[]: "upload_profile_screenshot"
	val[]: "Deseja fazer upload da captura de ecrã para ser o teu camião do perfil do World of Trucks?<br><br> A imagem anterior do camião do perfil será substituída!"

	key[]: "wotr_upload_title"
	val[]: "AVISO DE UPLOAD"

	key[]: "new_screenshot"
	val[]: "Novas capturas de ecrã disponíveis para upload!" #+ New screenshot notification

	key[]: "uploading_screenshot"
