	val[]: "CONFIGURAÇÕES GERAIS" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "LIGAR CONTEÚDO" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Ligar" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "O World of Trucks detetou novo conteúdo de jogo. Liga-te aos serviços do World of Trucks para acederes ao novo conteúdo." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Preferências online. Ajusta todas as configurações relacionadas do World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "De certeza que pretendes adiar o registo?<br><br>Podes aceder, mais tarde, à janela de diálogo do Conteúdo do Contrato Online a partir das Opções Online, no menu principal." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "A LIGAR CONTEÚDO" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "A ligar conteúdo.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Falha na operação de conexão para: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "A conta Steam que utilizaste para registar este DLC é diferente da que foi utilizada para criar a tua conta World of Trucks ou para registar o jogo. Por favor, muda a conta Steam e tenta novamente." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "A conta Steam que estás a usar para registar este DLC já está associada a outra conta do World Of Trucks. Para registar o DLC na conta actual, precisas de uma conta Steam que não esteja associada a nenhuma conta do World Of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Ligação à Steam expirou. Por favor, tenta novamente mais tarde." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "A chave usada para activar o DLC não é válida. Por favor contacta o suporte: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Ocorreu um erro interno ao registar o jogo. Por favor, tenta mais tarde." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCESSO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "PROCURAR CONTEÚDO" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Parabéns! As DLCs selecionadas foram ligadas com sucesso à tua conta do World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Não foi possível efectuar a conexão, porque a conta Steam actual está associada a uma conta diferente no World Of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Alguns DLCs falharam a conexão.<br>Passa o rato por cima por cima do ponto de exclamação de cada DLC para obter mais detalhes." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "A registar $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "O perfil atual não está ligado ao World of Trucks ou o jogo está a correr em modo offline. Edita o perfil para fazeres a ligação." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Clica para Dispensar"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLCs compatíveis atualmente ligadas. Se algumas DLCs não estiverem ligadas ao World of Trucks, poderás perder algumas das suas funcionalidades." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Parabéns! <color value=@@clr_txt@@>Todo o teu conteúdo está ligado ao World of Trucks! Podes agora utilizar todas as suas funcionalidades." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Não foi possível ligar o novo conteúdo ao World of Trucks porque a conta Steam atualmente utilizada não corresponde à conta Steam utilizada pelo perfil do World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Ligado" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Sem Ligação" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Não foi possível obter informação sobre os teus conteúdos." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Não foi possível obter informações sobre o conteúdo ligado." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Não foi possível obter informação sobre a conta actual." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Mais tarde" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Não foi possível registar este DLC. Não foi encontrada uma licença permanente, provavelmente devido à partilha familiar da Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Sem licença permanente" #+ The state of the content that cannot be connected due to invalid license.
