#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Selecciona o subtipo de controlador do jogo para lidar correctamente com os intervalos de entrada."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Seleciona o tipo de transmissão:<br>- O \"automático simples\" permite o uso do acelerador e do travão para controlar os movimentos de avanço e recuo.<br>- \"Automático real\" requer uma entrada para alternar entre velocidade de avanço e recuo.<br>- \"Sequencial\" requer mudanças manuais de todas as velocidades com entradas de subida/descida de marcha.<br>- \"H-Shifter\" requer o uso de um controlador com portas de mudança para selecionar as velocidades manualmente."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Altera a lógica de mudança de velocidade da transmissão automática.<br>-O modo \"Economia\" prefere rotações mais baixas voltadas para o binário máximo.<br>- O modo \"Performance\" prefere a potência máxima para uma melhor condução com cargas pesadas ou terrenos montanhosos em detrimento da economia de combustível."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a relação entre o grau de rotação do dispositivo e o grau real de rotação da direção do veículo."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a linearidade entre a entrada e a direção do veículo.<br><br>Aumentar este valor significa que a direção responderá menos quando o volante estiver no centro e aumentará a sensibilidade à medida que o volante for virado em direção ao limite. Isso pode ser útil para suavizar as ações da direção ao conduzir em linha reta."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Activa o feedback de força em controladores que o suportam."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta o ganho geral para todas as configurações de force feedback entre 0N e 10N.<br><br><color value=@@clr_txt_d@@>Atenção que ajustar esta configuração para uma configuração mais alta em bases de volante poderosas pode causar ferimentos nos dedos ou nas mãos."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força de centralização ao conduzir em alta velocidade, com pico de 90 km/h (56 mph) e acima.<br><br>A configuração mínima resultará em nenhuma força de centralização do volante."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força de centralização ao conduzir em baixa velocidade.<br><br>A configuração mínima resultará em nenhuma força de centralização do volante."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força do atrito interno artificial causado pelos componentes mecânicos da direção."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força da ressonância artificial do motor através da coluna de direção.<br><br><color value=@@clr_txt_d@@>Atenção que definir este valor acima de 15% pode causar trepidação e vibração excessivas em alguns volantes."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos da superfície da estrada através da coluna de direção.<br><br><color value=@@clr_txt_d@@>Atenção que definir este valor acima de 20% pode causar trepidação e vibração excessivas em alguns volantes ao conduzir em terreno irregular em alta velocidade."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos dos impactos da estrada através da coluna de direção."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de colisão através da coluna de direção."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de rectificação da caixa de velocidades."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de subviragem."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade da assistência da direção (quando se utiliza a funcionalidade de assistência de faixa, etc.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade das vibrações da superfície do terreno, se o controlador suportar feedback de vibração."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade das vibrações de impacto, se o controlador suportar feedback de vibração."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade das vibrações de colisão, se o controlador suportar feedback de vibração."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para direção."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de direção; a quantidade de rotação do centro em que a entrada é ignorada.<br><br>Isso pode atenuar problemas de controladores mais antigos, como imprecisões ou entradas falsas causadas por desgaste."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do eixo de direção.<br>- Centralizado é ideal para volantes ou joysticks.<br>- Invertido é usado para corrigir um eixo que foi detectado incorretamente."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para acelerar o veículo."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de aceleração; a quantidade de deslocamento de entrada em que nenhuma entrada é registada.<br><br>Isso pode atenuar problemas de controladores mais antigos, como imprecisões ou entradas falsas causadas por desgaste."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo gere os dispositivos:<br>- Centrado é o ideal para joysticks.<br>- Normal é o ideal para triggers ou pedais.<br>- Invertido pode compensar comandos que foram detetados incorretamente."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para travagem."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de travagem; a quantidade de deslocamento de entrada em que nenhuma entrada é registada.<br><br>Isso pode atenuar problemas de controladores mais antigos, como imprecisões ou entradas falsas causadas por desgaste."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo gere os dispositivos:<br>- Centrado é o ideal para joysticks.<br>- Normal é o ideal para triggers ou pedais.<br>- Invertido pode compensar comandos que foram detetados incorretamente."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para usar a embraiagem."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de embraiagem; a quantidade de deslocamento de entrada em que nenhuma entrada é registada.<br><br>Isso pode atenuar problemas de controladores mais antigos, como imprecisões ou entradas falsas causadas por desgaste."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo gere os dispositivos:<br>- Centrado é o ideal para joysticks.<br>- Normal é o ideal para triggers ou pedais.<br>- Invertido pode compensar comandos que foram detetados incorretamente."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta o alcance da embraiagem.<br><br>Quanto mais à direita se definir a função, mais precisará pressionar o pedal para engatar a embraiagem."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para inclinar a câmara para cima e para baixo."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de ver para cima e para baixo; a quantidade de deslocamento de entrada em que nenhuma entrada é registada.<br><br>Isso pode atenuar problemas de controladores mais antigos, como imprecisões ou entradas falsas causadas por desgaste."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do eixo.<br>- Centralizado é ideal para volantes ou joysticks.<br>- Invertido é usado para corrigir um eixo que foi detectado incorretamente."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para movimentar a câmara para a esquerda e para a direita."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de ver para a esquerda e para a direita; a quantidade de deslocamento de entrada em que nenhuma entrada é registada.<br><br>Isso pode atenuar problemas de controladores mais antigos, como imprecisões ou entradas falsas causadas por desgaste."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do eixo.<br>- Centralizado é ideal para volantes ou joysticks.<br>- Invertido é usado para corrigir um eixo que foi detectado incorretamente."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Seleciona o layout de velocidades a ser usado com o H-Shifter."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Muda o comportamento do shifter.<br>- Com a opção \"Simples\" nunca irás desgastar as engrenagens ao mudar.<br>- A opção \"Simples + som de aviso\" também permitirá que mudes de maneira simples, mas com sons de \"arranhar\" quando mudas de velocidade incorretamente.<br>- A opção \"Avançado\" não permitirá que mudes de marcha se mudar de velocidade incorretamente e ouvirás apenas sons de \"arranhar\". A opção \"Avançado\" também permite utilizar a configuração \"shifter fast split\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Escolhe como o jogo lida com divisões rápidas de equipamentos.<br>- \"Nunca\" exigirá que a alavanca de mudanças seja movida para ponto morto entre as divisões.<br>- \"Pressão da embraiagem\" requer uma depressão momentânea da embraiagem sem movimento da alavanca de mudanças.<br>- \"Soltar o acelerador\" exige que o motorista solte o acelerador apenas para dividir as velocidades sem movimento da alavanca de mudanças e \"embraiagem ou acelerador\" é uma combinação dos dois últimos."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a entrada usada para alternar entre intervalos com base no layout da alavanca."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Atribui um botão para alternar o divisor das mudanças com base no layout da alavanca."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Activa ao usar interruptores em vez de botões para entradas de intervalo ou divisor."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Atribui botão para mudar para o modo Drive da transmissão automática."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Atribui botão para mudar para o modo Marcha-atrás da transmissão automática."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Permite feedback dinâmico do RGB em dispositivos compatíveis."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Activa e configura recursos de rastreamento ocular para dispositivos compatíveis."
#@}

