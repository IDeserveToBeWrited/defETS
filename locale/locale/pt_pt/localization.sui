#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "DESEMPENHO VISUAL" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Gráficos" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Ajusta as definições gráficas ao utilizar opções predefinidas para ajustar a performance visual do jogo ao teu gosto."

	key[]: "apply"
	val[]: "Aplicar" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Tema de Fundo" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "Monitor" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "QUALIDADE DA IMAGEM" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURAS" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEXOS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SOMBRAS" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "LUZ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "PÓS-PROCESSAMENTO" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "AMBIENTE" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Modo de ecrã completo" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Brilho / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Configurar" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Resolução" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Taxa de atualização" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limite de FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limite de FPS no fundo" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Actualização por defeito" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Sincronização vertical" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Económico (Poupa energia em portáteis)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "CONFIGURAÇÕES GRÁFICAS SIMPLES" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "CONFIGURAÇÕES PERSONALIZADAS APLICADAS" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "CONFIGURAÇÕES GRÁFICAS AVANÇADAS" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Configurações gráficas simples/avançadas" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Esconder configurações avançadas" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Mostrar configurações avançadas" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Escala" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Afiação de luma TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Afinação de TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Claridade Adaptativa" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Sempre suave" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Sempre definido" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Oclusão ambiental do espaço do ecrã (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Alto alcance dinâmico (AAD)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Profundidade do Campo (PDC)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Raios solares" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Correção da cor" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Escala de Reflexão" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detalhe dos reflexos" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detalhe da vegetação" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densidade da relva" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Qualidades das sombras"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Tamanho da textura da sombra" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Sombras ao longe" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Sombras Interiores" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Qualidade Efeitos Metereológicos"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Qualidade dos espelhos" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Resolução do espelho" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Distância do espelho" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Qualidade das texturas" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtro anisotrópico" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Mapas normais" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Faróis do trânsito" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Luzes secundárias do veículo" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Alcance da visibilidade da luz" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Peões" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "As configurações do monitor foram alteradas.<br>Queres manter estas configurações?"

	key[]: "reverting_in"
	val[]: "A reverter em" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "segundos" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Quando activo, o jogo será mostrado em ecrã inteiro."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Ajusta o brilho geral do jogo de acordo com o ecrã do teu dispositivo. Em ecrãs compatíveis com HDR, a opção de calibração HDR também estará disponível nesta configuração."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Altera a resolução do jogo."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Altera a taxa de actualização do jogo."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a taxa de quadros à taxa de atualização do monitor para evitar ecrãs rasgados. A configuração económica também reduz a taxa de quadros pela metade, resultando em menor consumo de energia."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Define a taxa de frames máxima permitida para o jogo.<br><br>Definir para 0 irá desabilitar a função."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Define a taxa de frames máxima permitida para o jogo quando minimizado.<br><br>Definir para 0 irá desabilitar a função."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Altera entre configurações gráficas simples (pré-definidas) ou configurações gráficas avançadas (possibilidade de ajustar pârametros individuais)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Melhora a fidelidade gráfica ao renderizar o jogo internamente numa resolução mais alta, o que reduz bordas irregulares e aprimora os detalhes.<br>Por exemplo, selecionar uma opção de escala mais alta resulta numa imagem mais nítida e com menos desfoque, fazendo com que o jogo tenha uma aparência geral melhor em detrimento do desempenho.<br><br><color value=@@clr_txt_d@@>Esta configuração tem um grande impacto na performance."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Seleção de métodos de antialiasing de alta velocidade que suavizam a aparência de bordas irregulares no jogo.<br>- O SMAA mostra cada pixel várias vezes (dependendo da qualidade selecionada) em diferentes locais do ecrã e calcula a média das amostras para produzir a imagem final.<br>- O TAA mostra cada pixel apenas uma vez por ecrã, mas mostra-os em locais e quadros diferentes.<br>- Para obter o melhor resultado, também podes seleccionar uma combinação de ambos em detrimento do desempenho.<br><br><color value=@@clr_txt_d@@>Esta configuração normalmente tem impacto moderado na performance."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Adiciona sombras suaves a fendas e objetos próximos uns dos outros, melhorando a fidelidade gráfica percebida de todo o mundo do jogo.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Seleção de predefinições TAA.<br>- \"Sempre suave\" resultará em menos cintilação/mais desfoque - é apropriado para utilizadores de PC que habilitam superamostragem ou têm um monitor de alto DPI, mas também para utilizadores de TV 1080p que ficam mais longe da tela.<br>- \"Sempre nítido\" resulta em mais cintilação/menos desfoque - é provavelmente a melhor opção para uso abaixo de 1080p, como portáteis ou plataformas Steam.<br>- Quando \"Clareza adaptativa\" é selecionada, o jitter TAA é desativado dinamicamente se a câmera estiver estática.<br><br><color value=@@clr_txt_d@@>Esta configuração apenas pode ser usada quando o TAA está selecionado com uma solução anti-aliasing."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a intensidade da nitidez da luma do TAA.<br><br><color value=@@clr_txt_d@@>Esta configuração só pode ser usada quando o TAA é selecionado como uma solução anti-aliasing."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Quando ativado, áreas distantes no mapa podem ser desfocadas artificialmente para criar uma queda de foco realista no fundo."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Quando ativado, os raios de luz podem ser visíveis ao olhar para o sol ou através de objetos como árvores, edifícios ou veículos."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Quando ativado, as cores do jogo são ajustadas dinamicamente por razões estéticas. As cenas corresponderão melhor à hora do dia e às condições climáticas, as cores dos veículos e outros objetos poderão ser mais vibrantes, etc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Melhora os reflexos renderizando-os com maior qualidade internamente, além de usar um melhor antialiasing.<br><br><color value=@@clr_txt_d@@>As alterações nesta configuração entrarão em vigor somente após uma reinicialização manual do jogo."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta os detalhes dos reflexos vistos em superfícies de veículos, janelas e outras superfícies reflexivas, como poças, estradas molhadas e corpos de água abertos.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho.<br><br>As alterações nessa configuração entrarão em vigor somente após uma reinicialização manual do jogo."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta os detalhes e a complexidade de plantas e árvores.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a densidade da relva vista nas laterais da estrada.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a qualidade das sombras projectadas pelo sol ou pela lua.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Ativa a renderização de sombras até para objetos muito distantes.<br><br><color value=@@clr_txt_d@@>Esta definição tem normalmente um impacto moderado no desempenho."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Ativa as sombras dinâmicas noturnas no interior do veículo.<br><br><color value=@@clr_txt_d@@>Esta definição tem normalmente um impacto moderado no desempenho."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a qualidade dos efeitos climáticos, como reflexos."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a qualidade dos reflexos vistos nos espelhos do veículo (independentemente das configurações de reflexão).<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a resolução da imagem renderizada nos espelhos do teu veículo."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a distância na qual os objetos começam a ser renderizados no espelho.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um grande impacto no desempenho."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a qualidade de algumas texturas aplicadas a todos os objectos e superfícies do jogo."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Melhora a nitidez das texturas, especialmente aquelas vistas à distância ou em ângulo oblíquo.<br><br><color value=@@clr_txt_d@@>As alterações nesta configuração entrarão em vigor somente após uma reinicialização manual do jogo."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Adiciona a aparência de detalhes geométricos a calçadas, estradas e outros objetos para melhorar sua aparência.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho.<br><br>As alterações nessa configuração entrarão em vigor somente após uma reinicialização manual do jogo."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Ativa a iluminação dos faróis de outros veículos no trânsito."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Ativa a iluminação das luzes secundárias de outros veículos no trânsito, tais como indicadores, luzes de travão, etc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a distância em que fontes de luz artificiais podem ser vistas.<br><br><color value=@@clr_txt_d@@>Esta configuração geralmente tem um impacto moderado no desempenho."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Ativa peões no mundo do jogo."
