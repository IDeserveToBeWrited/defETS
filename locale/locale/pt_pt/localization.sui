#+ Progress history screen
#@{

	key[]: "job_log_t"
	val[]: "HISTÓRICO DE PROGRESSO" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "job_log"
	val[]: "Histórico de Progresso" #+ Icon opening the progress history. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "job_log_desc"
	val[]: "Segue o progresso no jogo. Lembra-te das entregas que fizeste e dos bónus que recebeste." #+ Help message associated the progress history icon.


	key[]: "stats_t"
	val[]: "As Tuas Estatísticas" #+ Header of section with statistics info.

	key[]: "stats_dist_total"
	val[]: "Distância total conduzida:"

	key[]: "stats_dist_onjob"
	val[]: "Distância conduzida em serviço: "

	key[]: "stats_dist_free"
	val[]: "Distância de condução livre: "

	key[]: "stats_jobs_done"
	val[]: "Entregas terminadas: "

	key[]: "stats_jobs_failed"
	val[]: "Entregas canceladas:"

	key[]: "stats_time_real"
	val[]: "Tempo de jogo:"

	key[]: "stats_time_game"
	val[]: "Tempo total de jogo: "

	key[]: "stats_roads_explored"
	val[]: "Explorado:"


	key[]: "free_roam"
	val[]: "Condução livre" #+ Indicates that points were gained for distance driven during free roaming.

	key[]: "profit"
	val[]: "Lucro: "
#@}

