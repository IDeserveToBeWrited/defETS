#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Camada de rede indisponível. Por favor, verifica se a configuração do cliente está correcta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Não é possível estabelecer ligação com o serviço online. Por favor, verifica se a tua ligação à internet está a funcionar."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Erro durante a comunicação com o serviço online. Por favor, tenta novamente mais tarde."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Dados incorrectos retornados do serviço online. Se a proxy de HTTP está em uso, verifica a sua configuração. Caso contrário, tenta novamente mais tarde."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Dados incorretos retornados do serviço online. Por favor, tenta novamente mais tarde."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "O serviço não é compatível com a versão actual do jogo. Por favor, verifica se um novo patch para o jogo está disponível."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "O serviço está indisponível no momento. Por favor, tente novamente mais tarde."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "O serviço está actualmente em manutenção ou sobrecarregado. Por favor, tenta novamente mais tarde."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "A informação de autenticação não é válida. Por favor, tente inscrever-se novamente."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "A conta online está, actualmente, bloqueada devido a demasiadas tentativas de acesso falhadas. Por favor tente de novo em 30 minutos."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "A conta online, actualmente, está bloqueada devido a acessos indevidos. Por favor tente de novo em 24h."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "O jogo não está registado para esta conta online."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "A conta ainda não está activada. Por favor consulte a sua caixa de correio para verificar se recebeu o email de activação."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "A conta está suspensa. Por favor contacte o suporte técnico."

# The account was banned.
	key[]: "generic_banned"
	val[]: "A conta está banida. Por favor contacte o suporte técnico."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "A autenticação de proxy não é suportada neste jogo. Por favor, usa uma proxy diferente ou ligação directa."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "O objeto pretendido não está disponível de momento. Por favor tente outra vez uns minutos mais tarde."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Erro SSL. Não foi possível estabelecer uma ligação segura."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "O jogo foi suspenso durante a comunicação online. Por favor tente novamente mais tarde."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Erro interno. O arquivo net.log pode conter mais informações."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "O Euro Truck Simulator 2 está com um problema e não é capaz de desenhar os gráficos no teu computador (nenhuma placa gráfica válida encontrada). \nSugestões:\n1. Certifica-te de que o computador e a placa de vídeo suportam os requisitos mínimos.\n2. Actualiza o teu computador com a última versão do DirectX.\n3. Faz download e instala a última versão dos driveres para a tua placa de vídeo a partir do site do fabricante - as tuas drivers estão muito provavelemente desactualizada.\n4. Tena alterar o modo de renderização de OpenGL para DirectX ou vice-versa.\n5. Elimina o ficheiro de configuração 'config.cfg' na pasta 'Documentos' - 'Euro Truck Simulator 2'. Poderá estar corrumpido. \nEste ficheiro será automaticamete re-criado com valores por defeito válidos na próxima vez que o jogo iniciar."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 está com um problema e não consegue desenhar os gráficos no teu computador (nenhum dispositivo gráfico suportado foi encontrado)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "ASSISTENTE DE ENTRADA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Próxima"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Terminar o assistente"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Saltar o assistente"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Assistente de configuração de dispositivos de entrada"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Queres cancelar o assistente de entrada?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SELECCIONAR MÉTODO DE CONTROLO" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Controladores"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>O assistente vai aplicar as definições recomendadas com base nos dispositivos ligados.<br><color value=@@clr_sel@@>Se estiveres a usar um comando compatível com o Steam, pondera ativar o suporte de configuração em <br><color value=@@clr_txt_d@@> \"Steam > Definições > Comando > Definições Gerais do Comando\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Conduz utilizando o teclado para controlar o camião, e olha á tua volta usando o rato. Esta é a forma de controlo mais simples e menos eficaz, mas está disponível para toda a gente."

	key[]: "wiz_control_mouse"
	val[]: "Utiliza o rato para uma direção mais sensível. As outras ações continuam a ser realizadas no teclado. Podes usar o rato para olhar em redor apenas se mantiveres premida, simultaneamente, uma tecla ou botão especial de controlo de câmara."

	key[]: "wiz_control_controller"
	val[]: "Usa o teu volante, comando ou joystick para uma experiência de jogo mais realista. Algumas teclas do teclado poderão ser usadas para várias ações e podes mudar o ângulo de visão com o rato (vista com o rato)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Não foi encontrado nenhum controlador. Tens de ligar um para activar esta opção!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "A detectar controladores disponivéis ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECCIONAR API DO CONTROLADOR" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Entrada Steam - Modo de mapeamento no jogo (recomendado)"

	key[]: "api_steam_input_advanced"
	val[]: "Entrada Steam - Modo de mapeamento do cliente Steam"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Controlador clássico"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Comandos como @@controller_ps5@@, @@controller_xbox_one@@ ou @@controller_steam_deck@@ configurados pela interface de entrada do Steam e usa um layout simples.<br><br>Suporta configurações completas de vinculação de teclas no jogo."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Os comandos configurados pela interface Steam Input e que usam layouts independentes configurados através do cliente Steam.<br><br>Suporte limitado para dicas de botões no jogo e sem configurações de vinculação no jogo."

	key[]: "wiz_api_classical"
	val[]: "Controlador, volante ou joystick a usar DirectInput, XInput ou interface semelhante."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELECCIONAR TIPO DE CONTROLADOR"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volante"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Comando ou joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "O controlador é um volante ou então comporta-se como um. A posição do controlador especifica a posição do volante do camião no jogo."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "O controlador é um comando ou um joystick. A posição do controlador especifica a velocidade da rotação do volante do camião no jogo."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECCIONAR TIPO DE CAIXA DE VELOCIDADES" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Pressiona AVANÇAR para avançar e pressiona RECUAR para travar ou marchar atrás. A caixa de velocidades gere automaticamente tudo o resto, tratando das transições entre condução, travagem e marcha atrás, assim como da seleção das mudanças adequadas."

	key[]: "wiz_gb_automatic"
	val[]: "Usa os botões para alternar entre marcha à frente, ponto morto ou marcha atrás. Depois, pressiona o acelerador e deixa a transmissão automática gerir a troca de mudanças."

	key[]: "wiz_gb_sequential"
	val[]: "Muda as mudanças manualmente para cima e para baixo para selecionar cada mudança individual da transmissão. Esta configuração dá-te o controlo total sobre a caixa de velocidades do veículo."

	key[]: "wiz_gb_hshifter"
	val[]: "Seleciona a mudança pretendida diretamente. Esta é a configuração mais realista. É recomendada uma alavanca de velocidades em H física e requer a utilização da embraiagem."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Esta opção requer um volante, comando ou joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Não foi detectado hardware H-Shifter, esta funcionalidade poderá ser inutilizável."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECCIONAR LAYOUT DO CÂMBIO EM H"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "O alcance da transmissão é bastante simples. Tem duas opções. A primeira contém as velocidades 1 a 6 e a segunda contém as velocidades 7 a 12. O botão muda entre estas duas opções enquanto o selector selecciona a velocidade específica do conjunto."

	key[]: "wiz_hs_splitter"
	val[]: "A transmissão repartida é uma alternativa simples. Tem dois conjuntos de mudanças. O primeiro contém as mudanças ímpares (1, 3, 5 ...) e o segundo contém as mudanças pares (2, 4, 6 ...). Activando o botão, mudas entre estes dois conjuntos enquanto o selector selecciona a mudança específica do conjunto."

	key[]: "wiz_hs_range_splitter"
	val[]: "A transmissão do repartidor de alcance é baseada no layout de caixas reais. As mudanças estão agrupadas em quatro por cada posição da alavanca e usam dois modos. É recomendado apenas para condutores avançados."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "O jogo está configurado para usar a configuração pré-definida para o hardware mencionado abaixo. Pode fazer as suas alterações de configuração nas 'Opções Avançadas', ou pode prosseguir para o jogo."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Configurações avançadas"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "O jogo está agora configurado e podes continuar. Podes alterar a configuração mais tarde nas Definições."

	key[]: "wiz_cfg_steam"
	val[]: "Podes verificar e configurar as definições dos botões e eixos deste controlador no cliente da Steam. As configurações do controlador da Steam para o jogo estão disponíveis em Steam > Biblioteca > Euro Truck Simulator 2 > Configuração do Controlador."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Abrir definições do controlador"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Usa @@imm_wiz_dsteerleft@@ e @@imm_wiz_dsteerright@@ para virar o volante."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Move o rato para a esquerda ou para a direita para rodar o volante na direção correspondente."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Usa @@ima_wiz_j_steer@@ para a direção."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Usa @@imm_wiz_dforward@@ para andar para a frente e usa @@imm_wiz_dbackward@@ para retroceder."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Move o @@ima_wiz_j_throttle@@ para a frente para andar em frente e para trás para retroceder."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Usa o @@ima_wiz_j_throttle@@ para andar para a frente, e usa o @@ima_wiz_j_brake@@ para recuar."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Usa @@imm_wiz_dforward@@ para acelerar e usa @@imm_wiz_dbackward@@ para travar."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Move o @@ima_wiz_j_throttle@@ para a frente para acelerar e para trás para retroceder."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Usa o @@ima_wiz_j_throttle@@ para acelerar e usa o @@ima_wiz_j_brake@@ para travar."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Usa @@imv_wiz_gearup@@ para aumentar a mudança e @@imv_wiz_geardown@@ para reduzir."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Usa @@imv_wiz_gearup@@ para aumentar a mudança e @@imv_wiz_geardown@@ para reduzir se usas o teclado ou um controlador com botões. Usa @@imv_wiz_drive@@ e @@imv_wiz_reverse@@ para seleccionar o sentido da marcha se usas um layout em H."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Usa @@imv_wiz_gearup@@ e @@imv_wiz_geardown@@ para seleccionar a velocidade desejada."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Usa o teu selector da caixa em H em conjunto com @@ima_wiz_j_clutch@@ para seleccionar a velocidade desejada."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "CONFIGURAR EIXOS DO COMANDO" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualização dos Eixos"

	key[]: "wiz_setup_axes_desc"
	val[]: "Podes experimentar visualmente a função de todos os eixos seleccionados. Usa o controlador e olha para as barras em movimento. Elas mostram os limites, centros, orientações e comportamento geral de cada eixo usado."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Configuração dos Eixos"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Para escolheres um eixo, clica no botão ao lado do nome do eixo. Isto vai mudar-te para o modo de introdução. Depois, usa o teu comando para mapear o eixo selecionado, movendo o manípulo, o volante ou o pedal para o eixo pretendido."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Zonas mortas"

	key[]: "wiz_setup_axes_desc3"
	val[]: "A zona morta refere-se a uma área do eixo concebida intencionalmente para não registar qualquer movimento. Para ajustares a zona morta de um eixo escolhido, move a barra deslizante correspondente. Se moveres a barra para a direita, vais aumentar a zona morta. Esta funcionalidade é particularmente útil para comandos mais antigos, visto que definir uma zona morta maior pode mitigar problemas como a imprecisão ou falsos comandos provocados pelo desgaste do hardware."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Modos dos Eixos"

	key[]: "wiz_setup_axes_desc4"
	val[]: "O modo de um eixo determina como esse eixo é gerido durante o jogo. Invertendo-o, trocas o seu sentido normal, logo virar para a direita pode ser virar para a esquerda, por exemplo. Um eixo centrado tem a sua posição por defeito no meio do seu curs, por exemplo num joystick. Esta configuração deve ser usada quando um eixo é detectado incorrectamente."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Invertido" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrado" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Invertido e Centrado" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "CONFIGURAÇÃO AUTOMÁTICA DA CAIXA DE VELOCIDADES" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Com a caixa de velocidades automática, só precisas de alternar entre os modos de marcha à frente, neutro e marcha-atrás. Irás conseguir fazê-lo utilizando as teclas e os botões do comando que se seguem. Para alterar as definições, clica num botão e prime a tecla, ou o botão do comando, que pretendes utilizar para essa ação."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Se tiver ligado ao computador um controlador de jogo com suporte físico da caixa de velocidades (H-Shifter), pode utilizá-lo no jogo para simular uma utilização real. Activa esta opção e podes definir as posições para cada uma das mudanças. Qualquer outra posição será considerada ponto-morto (N). Esta configuração foi programada para funcionar exclusivamente com hardware de simulação de mudanças (H-Shifter), por isso não funcionará com os botões do controlador. Caso queiras alterar algum, clica no botão e move o seleccionador de mudança para a posição desejada, e depois de novo para ponto morto (N)."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "CONFIGURAÇÃO DE CAIXA DE VELOCIDADES SEQUENCIAL" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Caixas sequenciais alteram a mudança entre todas as mudanças, incluindo ponto morto e marcha-atrás. Aqui estão as teclas ou botões de controlador usados para alterar a mudança actual, nesta ordem. Podes configurar as tuas próprias, clicando na mudança que queres alterar, e depois no botão que queres usar para tal."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "CONFIGURAÇÃO DE CAIXA DE VELOCIDADES COM CÂMBIO EM H" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Aqui podes escolhar a principal disposição da caixa em H e experimentar as suas funções. Na imagem podes ver a posição actual do selector bem como a velocidade engrenada. Como a caixa tem mais mudanças que o selector, precisas de usar um botão para mudar de conjuntos de velocidades."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "O posição actual do selector e os botões activos estão indicados abaixo, perto do próximo controlador. Para mudar um controlo já alocado clica no botão apropriado e move o selector para a posição desejada e depois para ponto-morto."
#@}

