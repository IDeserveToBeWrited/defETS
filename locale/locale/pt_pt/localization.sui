	val[]: "A manobra é iniciada pelo<color value=@@clr_sel@@>veículo de acompanhamento traseiro<color value=@@clr_txt@@>que muda e bloqueia a via designada."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "O <color value=@@clr_sel@@>veículo de acompanhamento da frente<color value=@@clr_txt@@>espera até que a via designada esteja livre, depois, também, muda a via."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "É seguro para um <color value=@@clr_sel@@>jogador<color value=@@clr_txt@@> mudar para a via designada."

