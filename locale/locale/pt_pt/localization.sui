	val[]: "Causaste danos no veículo que faz o acompanhamento!<br>Podes carregar o jogo num ponto anterior ou cancelar a entrega com uma penalização de $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "O veículo de acompanhamento foi danificado por outro veículo devido a uma condução incorrecta e imprudente.<br>Podes carregar o jogo num ponto anterior ou cancelar a entrega com uma penalização de $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "É suposto seguires a rota.<br>Podes carregar o jogo num ponto anterior ou cancelar a entrega com uma penalização de $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
