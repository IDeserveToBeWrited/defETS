	val[]: "Por favor, pressiona a seguinte tecla para ver as ofertas dos Transportes Especiais:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Oferta Especial de Trabalho:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Estás prestes a transportar uma carga de Transportes Especiais! Existem dois veículos de acompanhamento que te guiarão. Por favor sê cuidadoso e segue as suas recomendações. Transportes especiais como este não param em sinais vermelhos e têm prioridade na maioria das situações. Durante estas entregas, os pontos de verificação são mais frequentes para guardar o teu progresso."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Presta atenção redobrada ao seguinte:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Evita possíveis conflitos com os veículos de acompanhamento e mantém a carga entre eles."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Não te desvies da rota estabelecida, nem para áreas de serviço, áreas de descanso etc."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Cumpre os limites de velocidade que serão garantidos pelo veículo de acompanhamento da frente."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Cuidado com o tráfego em ultrapassagem e com outros condutores na estrada."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manobra de mudança de via:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Se não seguires estas regras, a tua missão de Transporte Especial pode falhar!"

	#+ First changle lane maneuver popup text.
