#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuar ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Bem-vindo ao Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Finalmente tens a oportunidade de experimentar o teu emprego de sonho - conduzir um camião!"

	key[]: "intro_3"
	val[]: "A tua própria companhia de transporte está aberta ao negócio, mas infelizmente falta-te dinheiro para comprar um camião. Por agora, terás de trabalhar para outras companhias como um condutor de aluguer."

	key[]: "intro_4"
	val[]: "A tua tarefa é entregar de forma segura uma carga de $JOB_CARGO$ no depósito de $JOB_TARGET_COMPANY$ em $JOB_TARGET_CITY$. O teu empregador pôs ao teu dispor um veículo e irá cobrir todas as despesas. Não desiludas ninguém e sê pontual. "


	key[]: "intro_garage_1"
	val[]: "Esta é a tua sede."

	key[]: "intro_garage_2"
	val[]: "É uma garagem muito simples. Pode não ser muito, mas é um começo."

	key[]: "intro_garage_3"
	val[]: "Infelizmente, não tens nada para estacionar aqui, por isso não há camiões por perto."

	key[]: "intro_garage_4"
	val[]: "Assim que ganhares dinheiro suficiente e comprares um camião, serás capaz de andar livremente pelo mundo e gerir o teu negócio a partir daí."

	key[]: "intro_garage_5"
	val[]: "Boa Sorte!"


	key[]: "desktop_tut_t"
	val[]: "CARACTERÍSTICA DESBLOQUEADA"

	key[]: "desktop_tut_job"
	val[]: "Escolhe o teu próximo trabalho"

	key[]: "desktop_tut_cargo_market"
	val[]: "Usa o teu novo reboque para acederes ao Mercado de Cargas e entregar um vasto leque de opções de carga aos seus destinos." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Aqui consegues visualizar o teu progresso."

	key[]: "desktop_tut_company"
	val[]: "A partir daqui, mantém debaixo de olho o progresso das tuas garagens, contrata novos condutores e gere a tua companhia."

	key[]: "desktop_tut_trailers"
	val[]: "A partir de agora, podes comprar, modificar e pintar os teus próprios reboques, para ficarem iguais ao teu camião.<br><br>Os teus reboques podem ser guardados na(s) garagen(s) que escolheres; eles podem ser usados pelos teus condutores para aumentar os lucros. Para gerires os teus reboques, usa o Gestor de Reboques."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visita $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Usa o botão Modo para alternar entre diferentes modos de ambiente de trabalho e diferentes tipos de veículos."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BEM-VINDO"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Bem-vindo ao novo Ecrã Inicial<br>Daqui podes interagir com todas as funcionalidades do jogo."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Abaixo, o Menu Principal dá acesso directo a todas as funções do jogo com que estás familiarizado."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "No topo, a nova Barra de Estado providencia visibilidade a estatísticas do perfil do jogador e regulamentações locais."

	key[]: "desktop_tut_tour_home"
	val[]: "O botão \"Início\" está sempre disponível para regressares ao ecrã inicial."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Um atalho para o Menu providencia um acesso rápido a todas as funções do jogo a partir de qualquer ecrã."

	key[]: "desktop_tut_tour_drive"
	val[]: "O renovado botão \"Conduzir\" continua a ser a tua ligação ao mundo virtual de forma a colocar-te de volta à estrada."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL CONCLUÍDO"

	key[]: "desktop_tut_tour_finish"
	val[]: "Obrigado por assistires à nossa actualização do Ecrã Inicial."


	key[]: "desktop_vehicle_mode_reenable_hints_t"
    val[]: "ATIVAR DICAS"

    key[]: "desktop_vehicle_mode_reenable_hints"
    val[]: "Estás a entrar num novo modo de jogo e as dicas contextuais estão atualmente desativadas. As dicas podem ajudar-te a aprender a jogar. Queres ativá-las novamente?"
#@}


