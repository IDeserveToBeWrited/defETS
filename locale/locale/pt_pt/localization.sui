#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "A foto é muito grande. Por favor tenta reduzir a resolução do ecrã." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "A foto está corrompida ou não é suportada." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "A resolução da captura de ecra é muito grande. Por favor, tenta reduzir a resolução do ecrã." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "O serviço rejeitou a foto." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Esta conta não pode fazer upload de fotos." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Houve um upload simultâneo para o mesmo espaço." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "O upload está desativado. Por favor tenta mais tarde." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Erro desconhecido durante o upload. Por favor tenta mais tarde." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "A foto é maior do que o máximo permitido de $LIMIT$ e foi redimensionada." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "A foto é maior do que o máximo permitido de $LIMIT$KB e foi redimensionada." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "MODS ACTIVAS" #+ Mod selection title

	key[]: "missing_deps"
	val[]: "O jogo gravado que queres retomar usa opções adicionais, que estão indisponíveis de momento. Os pacotes de conteúdo ausentes são:"

	key[]: "missing_deps_cont"
	val[]: "Desejas continuar na mesma?<br>O jogo poderá ficar com erros!" #+ missing mods warning

	key[]: "missing_deps_rdlc_cont"
	val[]: "Desejas continuar na mesma?<br>Algumas funcionalidades podem ser perdidas!" #+ missing dlc warning if the save depends only on functionality from removable DLCs (e.g. paintjob)

	key[]: "add_all"
	val[]: "Activar tudo" #+ Button used to add all mods to active mod list

	key[]: "remove_all"
	val[]: "Desactivar tudo" #+ Button used to remove all mods from active mod list

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "dlc_t"
	val[]: "DLC INCOMPATÍVEL" #+ Window title

	key[]: "incompatible_dlc"
	val[]: "Parte do conteúdo do DLC atualmente instalado não é compatível com a versão do jogo e será desativado. Precisas de instalar a seguinte <LINK URL=http://www.eurotrucksimulator2.com/update.php$VERSION_INFO$ COLOR=@@clr_link@@>atualização</LINK> para o conteúdo ser compatível.<br><br>O seguinte conteúdo é incompatível:"

