#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "RASTREAMENTO COM OS OLHOS" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Vista Extendida" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Pré-definições da Vista Extendida" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Inserir nome da pré-definição" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Tem a certeza que quer eliminar a pré-definição seleccionada?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "A configuração existente com o mesmo nome será substituída. Deseja continuar?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Configurações do Olhar" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Configurações da Cabeça" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Controlos do Teclado" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Activar Vista Extendida" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Activar centralização automática" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Modo do rastreamento da cabeça" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Directo" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinâmico" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Resposta da vista Gaze" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Resposta da vista de cabeça" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Activar inclinação" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Activar posição" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Multiplicador de viragem (na cabina)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Multiplicador de arremesso (na cabina)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Multiplicador de viragem (no modo de caminhada)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Multiplicador de arremesso (no modo de caminhada)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
