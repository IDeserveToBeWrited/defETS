	val[]: "O veículo de acompanhamento frontal vai avisar os outros condutores...<br>Adapta a tua velocidade para evitar um possível acidente..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Os veículos de acompanhamento estão à sua espera no próximo cruzamento. Por favor, siga a rota."

