#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Seleção de temas que são mostrados no fundo enquanto navegas pelo menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Ativa a seleção aleatória do tema de fundo de cada vez que inicias o jogo."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta o atraso após o qual o fundo fica desfocado."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activo, irás experimentar os efeitos da fadiga ao longo do tempo.<br><br>Evitar o descanso resultará em multas."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativo, deves obedecer às regras da estrada ou corres o risco de seres multado. O risco aumenta perto de carros da polícia, radares e câmaras de tráfego."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta a distância média dos trabalhos que são propostos."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleciona qual o limite de velocidade a mostrar no widget do navegador."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "A velocidade atual na navegação muda para vermelho quando ultrapassado o limite de velocidade."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando chegares ao destino, irá aparecer um widget que permitirá saltar o estacionamento."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Manter todos os widgets escondidos."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantém ambos os espelhos do HUD ocultos."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Manter todas as notificações escondidas mesmo quando são recebidas."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Mostra uma janela que mostra as capacidades do camião actual do jogador antes de aceitar um trabalho de carga pesada."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Escolhe como o Mapa Mundo é alinhado."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Escolha o método de exploração do Mapa:<br>- \"Exploração por proximidade\" assinala uma área de maior dimensão como explorada.<br>- \"Exploração por precisão\" revela apenas as áreas imediatamente circundantes ao jogador."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleccionar como a navegação irá ser mostrada"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera o modo como a navegação é mostrada.<br>- O modo \"Melhor\" escolhe a rota mais eficiente entre distância e tempo, tenta evitar semáforos, etc.<br>- O modo \"Curto\" escolhe sempre a rota mais curta possível.<br>- O modo \"Estradas secundárias\" evita as auto-estradas quando possível."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a dificuldade de estacionamento:<br>- \"Escolher sempre\" permite escolher ao chegar ao destino.<br>- \"Estacionamento seguro\" não requer manobras.<br>- \"Estacionamento difícil\" requer manobras em marcha-atrás mais complicadas."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Ajustar a probabilidade de encontrar perigos rodoviários, incluindo acidentes, veículos avariados, destroços, etc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Ajustar a probabilidade de encontrar um desvio na tua rota enquanto em trabalho."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta a probabilidade de mau tempo."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Mostrar a informação do fuso horário."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Ativa as sequências cinemáticas do jogo, normalmente apresentadas após a aquisição de camiões, upgrade de garagens ou durante o embarque de passageiros."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Escolher se os bloqueadores transparentes serão mostrados em estradas que não podem ser acedidas."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverte o eixo Y do rato ao controlar a câmara no jogo."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleciona o tipo de transmissão:<br>- O \"automático simples\" permite o uso do acelerador e do travão para controlar os movimentos de avanço e recuo.<br>- \"Automático real\" requer uma entrada para alternar entre velocidade de avanço e recuo.<br>- \"Sequencial\" requer mudanças manuais de todas as velocidades com entradas de subida/descida de marcha.<br>- \"H-Shifter\" requer o uso de um controlador com portas de mudança para selecionar as velocidades manualmente."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleccionar esta função permitirá \"saltar mudanças\" - saltar velocidades quando necessário ou prático para evitar passar por todas as velocidades da transmissão."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Coloca o volante novamente no centro quando se usa um teclado ou comando.<br><br>Se desativares esta funcionalidade, terás de rodar manualmente o volante de volta ao centro após uma curva."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta o alcance da animação do volante. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta a intensidade dos travões."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a estabilidade do veículo ao baixar o seu centro de gravidade."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a estabilidade do reboque ao baixar o seu centro de gravidade."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a intensidade do binário gerado pela transmissão.<br><br>Aumentar esta definição aumentará a sensação de o veículo \"fugir\" para a direita."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a rigidez da suspensão do chassis."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a rigidez da suspensão da cabine."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta a intensidade das irregularidades da superfície geradas processualmente para dar às estradas e outros terrenos uma sensação imperfeita.<br><br>Dependendo de outras configurações de suspensão e câmara, o efeito percebido pode ser mais ou menos proeminente."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite o acoplamento avançado que exige maior precisão para alinhar a quinta roda do camião com o pino mestre do reboque.<br><br>Quando desativado, o acoplamento de um reboque torna-se muito mais fácil, pois não há colisão entre o pino mestre e a quinta roda."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona se, e quais os cabos do reboque que serão animados.<br><br><color value=@@clr_txt_d@@>Activar cabos em mais veículos pode afectar a performance em sistemas mais antigos."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Ativa o limitador eletrónico de velocidade do veículo para um valor que depende do seu modelo.<br><br><color value=@@clr_txt_d@@>Os trabalhos do World of Trucks têm esta funcionalidade permanentemente ligada."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activo e os limpa pára-brisas estão na primeira posição, as escovas irão funcionar automaticamente e ajustar a sua velocidade de acordo com as condições climatéricas."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativa o acionamento automático do retarder ao travar."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo auxilia no arranque em subidas, segurando os travões, garantindo um arranque suave."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite o accionamento automático do travão motor durante a travagem."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando seleccionado, o motor liga-se automaticamente ao pressionar o acelerador."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o travão de estacionamento do veículo é aplicado por predefinição (após utilizar um ferry, reboque para a oficina, viagem rápida, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Acciona automaticamente os eixos quando necessário, dependendo do peso do veículo."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo manterá uma aceleração mais baixa por predefinição. Após pressionares rapidamente o botão de aceleração duas vezes, o veículo manterá a aceleração máxima até que o botão seja libertado.<br><br>Apenas aplicável ao teclado."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simula a perda de ar na vida real devido a aplicações excessivas de travão.<br><br>Terá que gerir a pressão de ar ao descer colinas ou ao manobrar lentamente com múltiplas aplicações de travão."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando inactivo, o consumo de combustível não é afectado pelo estilo de condução ou pelas condições da estrada.<br><br>Quando activo, o consumo de combustível é afectado por vários factores incluíndo estilo de condução, peso da carga, resistência ao andamento e perfis do terreno. Já não é afectado pela habilidade @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando activo, o ABS previne o bloquei odas rodas para manter o controlo e aumentar a capacidade de travagem."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo aplicará travagem em cada roda individualmente para evitar a patinagem das rodas, subviragem ou sobreviragem, ajudando a manter o controlo."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo bloqueará o diferencial se as rodas começarem a patinar, para melhorar a tração."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera o incremento de velocidade na qual o controlo de velocidade aumentará ou diminuirá quando a tecla apropriada for pressionada."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a tolerância do controlo de velocidade para manter a velocidade alvo."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "O controlo de velocidade ajustará automaticamente a velocidade para manter uma distância segura do veículo à frente."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa a travagem de emergência se o sistema detectar uma colisão iminente.<br>Escolha se o sistema reagirá apenas aos veículos ou a todos os obstáculos."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleção dos modos do assistente de faixa:<br>- O modo \"Aviso de saída de faixa\" avisa-o sonoramente quando está prestes a sair da faixa.<br>- Para além do aviso sonoro, o \"Suporte de manutenção de faixa\" também vira automaticamente o seu veículo para evitar que saia da faixa.<br><br>Ambos os modos só estão ativos a velocidades superiores a 55 km/h (~35 mph).<br>O Assistente de Faixa também considera a sua utilização dos sinais de mudança de direção antes de ser ativado."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativa as funções do sensor de ângulo morto, caso o seu veículo esteja equipado com o mesmo."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado e os faróis estiverem na primeira posição, os faróis acenderão automaticamente em situações de pouca luz."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, e os faróis estiverem ligados com os máximos acionados, o veículo desliga automaticamente os máximos quando detetar um veículo em sentido contrário ou um veículo próximo à frente."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, os indicadores serão cancelados automaticamente após uma curva quando o volante for voltado para o centro."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativados, alguns acessórios interiores reagem ao movimento físico do veículo (enfeites pendurados, bobbleheads, etc.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa a guinada na câmara interna com base na entrada de direção."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera o quão reativo a definição \"rotação da câmara de direção\" é à entrada de direção."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera o comportamento da definição \"rotação da câmara de direção\" ao fazer marcha-atrás."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "A câmara interior muda para a esquerda e para a direita baseado no uso dos indicadores."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativa, a câmara interior reage ao movimento do veículo."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a reação da câmara interior ao movimento do veículo."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativa, a câmara interior pode rodar consoante o movimento do veículo."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta o nível de alteração do FOV da câmara interior com base na velocidade do veículo."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta o atraso antes da câmara se centrar automaticamente.<br><br>O veículo deve estar a mover-se numa velocidade não negligenciável para ativar esta configuração. Aplica-se apenas à câmara interna e atrás ao mover-se para frente e à câmara inclinada para fora ao mover-se para trás."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Define a velocidade do movimento da câmara. Usado para centralizar automaticamente a câmara e alternar entre predefinições da câmara interna."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determina como funciona o zoom interior: pressiona o botão para fazer zoom temporariamente, ou pressiona uma vez para ativá-lo." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona a linguagem a mostrar durante o jogo."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Altera as predefinições de moeda e unidades com base na região selecionada."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activa, as cidades e países irão ser mostrados na tua língua seleccionada."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activa, as cidades e países irão ser mostrados na tua língua seleccionada bem como na língua original daquela região do mapa."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a moeda a usar."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona entre mostrar 12h ou 24h na informação do tempo."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a unidade para mostrar a distância."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a unidade para mostrar o peso."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a unidade para mostrar a temperatura."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a unidade utilizada para mostrar a pressão."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a unidade para mostrar o volume."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolhe qual a unidade utilizada para mostrar o consumo."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activo, usar a tecla \"Activar\" (@@imv_nrm_activate@@) abrirá o chat durante as sessões do Comboio."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activo, o chat irá permanecer activo após enviar uma mensagem."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Quando activo, as mensagens de chat irão desaparecer alguns segundos após cada mensagem."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Altera o tempo que demora as mensagens do chat a serem visíveis antes de desaparecerem."

