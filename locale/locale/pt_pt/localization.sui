	val[]: "(Dinâmico)"

	key[]: "cargo_market_t"
	val[]: "MERCADO DE CARGAS"

	key[]: "cargo_market"
	val[]: "Mercado de Cargas"

	key[]: "cargo_market_desc"
	val[]: "Usa o teu próprio reboque para entregares um vasto leque de cargas aos seus destinos." #+ The description of an Cargo Planner icon, used to open a window for selecting cargo with owned trailer.

	key[]: "trailerman_title"
	val[]: "OS MEUS REBOQUES"

	key[]: "trailerman_link_title"
	val[]: "Gestor de Reboques"

	key[]: "trailerman_notice_t"
	val[]: "GESTOR DE REBOQUES"

	key[]: "trailerman_help"
	val[]: "Gere os reboques da tua companhia, assigna-os a condutores, compra-os, troca-os e muito mais."

	key[]: "trailerman_summary_hint"
	val[]: "Selecciona um reboque no lado direito para ver os seus detalhes"

	key[]: "trailerman_tut_utilization"
	val[]: "Percentagem da utilização diária do reboque no estado actual da economia. É baseada no número de horas por dia que os teus condutores utilizam o reboque. O gráfico é actualizado no início de cada dia. % mais altas indicam uma maior procura por um determinado reboque na sua garagem." #+ The utilization graph hint text.

	key[]: "trailerman_tut_overview"
	val[]: "Todos os reboques que compraste estão listados e são geridos a partir daqui - o ecrã de Gestão de Reboques.<br><br>Os teus condutores são atribuídos automaticamente aos reboques dentro da mesma garagem e vão começar a utilizar todos os reboques disponíveis para as suas entregas.<br><br>Define o uso do reboque como Privado para restringir o uso apenas a ti, ou Público para disponibilizar o reboque a todos os teus condutores para aumentar a economia da garagem." #+ The text shown in trailer manager overview tutorial box.

	key[]: "trailer_config"
	val[]: "Configuração do Reboque"

	key[]: "trailer_config_about"
	val[]: "Personaliza a configuração do teu reboque, afina ou pinta-o para corresponder às tuas necessidades operacionais e estéticas."

	key[]: "truckman_gar_trailers"
	val[]: "Reboques:"

	key[]: "garage_name"
	val[]: "Garagem:"

