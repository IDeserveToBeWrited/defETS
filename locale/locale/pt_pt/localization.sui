	val[]: "Não foi possível concluir a operação. Tens de completar o teu trabalho actual." #+ The message shown when user cannot do the operation because he is on job.

	key[]: "trailerman_msg_takefail_notruck"
	val[]: "Não foi possível seleccionar o reboque. Nãos estás a conduzir nenhum camião." #+ The message shown when user cannot take trailer because he is currently not driving any truck.

	key[]: "trailerman_trailer_taken"
	val[]: "O reboque seleccionado está à tua espera na garagem em $CITY$." #+ Success message when trailer was delivered to the selected garage.

	key[]: "trailerman_trailer_taken_ingarage"
