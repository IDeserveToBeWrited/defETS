
    key[]: "hint_engine_title"
	val[]: "Ligue o motor"

    key[]: "hint_engine_text"
	val[]: "Usa $KEY_engine$ para ligar o motor."


    key[]: "hint_ignition_title"
	val[]: "Ligue a ignição"

    key[]: "hint_ignition_text"
	val[]: "Usa $KEY_engineelect|KEY_engine$ para ligar a ignição."


    key[]: "hint_driv_arc_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_arc_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direcção."


    key[]: "hint_driv_auto_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_auto_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direcção.<br><offset vshift=8>Pressiona $KEY_gearup$ e $KEY_geardown$ para mudar de velocidade."


    key[]: "hint_driv_seq_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_seq_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direcção.<br><offset vshift=8>Pressiona $KEY_gearup$ e $KEY_geardown$ para controlar a embraiagem."


    key[]: "hint_driv_hshift_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_hshift_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direcção.<br><offset vshift=8>Troca de mudanças com a <color value=@@clr_sel@@>alavanca<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "A aproximar-se do destino"

    key[]: "hint_depot_deliv_text"
    val[]: "Pare na área demarcada para seleccionar o nível de dificuldade do lugar de estacionamento e ganhar a experiência correspondente."


    key[]: "hint_fin_deliv_title"
    val[]: "Termine a entrega"

    key[]: "hint_fin_deliv_text"
    val[]: "Estacione no lugar seleccionado. Você pode pressionar $KEY_activate$ para saltar esta etapa quando estiver perto do ponto de entrega."


    key[]: "hint_fin_deliv2_title"
    val[]: "Termine a entrega"

    key[]: "hint_fin_deliv2_text"
    val[]: "Estacione no lugar seleccionado. Você pode activar um widget nas @@desktop_menu_category_options@@ para saltar a etapa de estacionamento."


    key[]: "hint_lights_title"
    val[]: "Ligue as luzes"

    key[]: "hint_lights_text"
    val[]: "Use a tecla $KEY_light$ para activar as luzes. Alterne entre os diferentes modos pressionando-a repetidamente."


    key[]: "hint_high_beam_title"
    val[]: "Accione os máximos"

    key[]: "hint_high_beam_text"
    val[]: "Use a tecla $KEY_hblight$ para ligar os máximos."


    key[]: "hint_wipers_title"
    val[]: "Active os limpa pára-brisas"

    key[]: "hint_wipers_text"
    val[]: "Use a tecla $KEY_wipers$ para activar os limpa pára-brisas e alternar entre as diferentes velocidades."


    key[]: "hint_zoom_title"
    val[]: "Olhando mais de perto"

    key[]: "hint_zoom_text"
    val[]: "Use a tecla $KEY_camzoom$ para aplicar zoom enquanto estiver no interior. Você pode definir o modo de zoom para manter pressionado ou alternar em @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "A olhar em volta"

    key[]: "hint_cam_int_text"
    val[]: "Use $KEY_cam1$ para mudar a câmera para a vista interior."


    key[]: "hint_cam_ext_title"
    val[]: "A olhar em volta"

    key[]: "hint_cam_ext_text"
    val[]: "Você pode alternar entre diferentes ângulos da câmera pressionando $KEY_camcycle$.<br><offset vshift=8>Use $KEY_cam2$ para mudar a câmera para a visão exterior."


    key[]: "hint_indicators_title"
    val[]: "Indicadores"

    key[]: "hint_indicators_text"
    val[]: "Use $KEY_lblinker$ e $KEY_rblinker$ para ligar os indicadores de mudança."


    key[]: "hint_tow_title"
    val[]: "Serviço de reboque"

    key[]: "hint_tow_text"
    val[]: "Se você não conseguir sair de uma situação difícil, pode usar o serviço de reboque. Para aceder, abra o menu @@quick_info_word@@ utilizando $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Bloqueio do diferencial"

    key[]: "hint_diff_lock_text"
    val[]: "Se você não conseguir iniciar o movimento, talvez o bloqueio do diferencial possa ajudar. Use a tecla $KEY_diflock$ para activá-lo ou habilite o bloqueio automático do diferencial em @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Bloqueio do diferencial activado"

    key[]: "hint_diff_unlock_text"
    val[]: "Você deve desligar o diferencial durante a condução normal, caso contrário, corre o risco de danificá-lo. Use a tecla $KEY_diflock$ para desactivá-lo ou active o bloqueio automático do diferencial em @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Desactive os limpa pára-brisas"

    key[]: "hint_wipers_off_text"
    val[]: "Use a tecla $KEY_wipers$ para desactivar os limpa pára-brisas e alternar entre as diferentes velocidades."


    key[]: "hint_world_map_title"
    val[]: "Vista do mapa"

    key[]: "hint_world_map_text"
    val[]: "Use $KEY_navmap$ para abrir o mapa mundo."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Use $KEY_advmouse$ para abrir @@quick_info_word@@ - uma visão geral do seu estado com atalhos convenientes."


    key[]: "hint_pause_border_title"
    val[]: "Regulamentações locais"

    key[]: "hint_pause_border_text"
    val[]: "Use $KEY_advmouse$ para abrir @@quick_info_word@@ e ver as regulamentações actuais da região que você inseriu."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Abra @@quick_info_word@@ utilizando $KEY_advmouse$ para entrar em @@photo_mode_word@@ e capturar @@landmark_word@@ próximo <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ próximo"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> está por perto - encontre-o e active-o para ver a cena."


    key[]: "hint_resting_title"
    val[]: "Área de descanso próxima"

    key[]: "hint_resting_text"
    val[]: "Áreas de descanso <img src=/material/ui/map/parking_ico.mat width=20 height=20> ajudam-no a recuperar da fadiga e continuar a sua viagem com segurança."


    key[]: "hint_gas_title"
    val[]: "Bomba de combustível próxima"

    key[]: "hint_gas_text"
    val[]: "As bombas de combustível <img src=/material/ui/map/gas_ico.mat width=20 height=20> podem ser usadas para reabastecer o seu veículo."
