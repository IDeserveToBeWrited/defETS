#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Conduz Através de Curvas Complexas"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Neste deafio, vamos manobrar o reboque através de um pequeno curso de obstáculos com mais curvas complexas."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primeiras Curvas"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Conduz Através de Uma Passagem Estreita"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Curva de 90 Graus Apertada"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Conduzir à Volta das Barreiras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "À tua frente está uma variedade de curvas e obstáculos complexos.<br>Usa tudo o que aprendeste até agora e não deve ser muito difícil."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "As marcações na estrada podem ajudar-te a ter uma ideia de como proceder através de cada conjunto de obstáculos."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Mantém o tractor na parte de fora da curva.<br>Precisas de alargar a trajectória uma vez que o reboque segue um caminho mais curto."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "A próxima curva é uma curva fácil de 90 graus. <br> má vez mais mantém o camião na parte de fora da curva e utiliza todo o espaço disponível."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Leva o teu tempo. O percurso alarga mas tens de ser preciso."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Mantém um espaço aberto à volta das barreiras."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Tem cuidado ao entrar nesta secção estreita.<br>Mantém o tractor largo antes de colocares o reboque na trajectória."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "A última curva de 90 graus é muito mais apertada que a primeira, mas há muito espaço se o usares eficazmente."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Lembra-te de utilizar as marcações da estrada para te ajudar a navegar no percurso.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Usar os espelhos também ajuda a navegar no percurso com segurança. Deves estar sempre ciente de como o reboque vai atrás de ri.<br><br><font face=/font/big_bold.font>Prossegue através da primeira curva.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observa o reboque aí medida que entras na curva e preparas a próxima.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Prossegue para a próxima curva.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Lembra-te de observar o reboque para garantir que não tens obstáculos à tua volta antes de virar o camião.<br><br><font face=/font/big_bold.font>Continua através do obstáculo de barreiras à frente. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Quando irei reboque passar a barreira vira rapidamente para o lado do passageiro para te alinhares com a passagem estreita. <br><br><font face=/font/big_bold.font>Prossegue para a passagem estreita.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Está secção requer uma condução precisa. Leva o teu tempo e usa os espelhos.<br><br><font face=/font/big_bold.font>Mantém-te do lado de fora de cada curva. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Está curva é muito apertada, mas podes utilizar o espaço à tua frente para passar na curva facilmente.<br><br><font face=/font/big_bold.font>Faz a curva final.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Curso de Treino Avançado - Trailer"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "No desafio final do Capítulo 3, vamos para uma viagem num percurso mais longo com uma variedade de curvas para ver o quão bem aprendeste a manobrar com um reboque."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Curva Dogleg"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVER ESTE OBJECTIVO"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Cruzamento Mediano"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Primeiro Slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Segundo Slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Curvas Fáceis"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rotunda"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Seccção a Direito"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Curva Apertada"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Curvas Finais"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Conduzir até ao Lugar de Estacionamento"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Neste desafio, vais encontrar uma variedade de curvas para te habituares a conduzir com um reboque. Mantém o foco, ajusta a tua velocidade a cada situação e usa todo o espaço disponível no percurso de treino."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "A primeira curva é um conjunto de curvas - duas curvas numa. Tens que te preparar para uma curva à esquerda com uma transição para a direita a meio da manobra."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "A próxima curva leva-te ao outro lado da estrada. Não é difícil mas tens de deixar espaço suficiente para o reboque."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "A seguir, tens de negociar com um slalom estreito através das barreiras de cimento. Vai devagar e usa os espelhos e garante que tens espaço para passar com o reboque pelas barreiras."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Aqui, vais entrar noutro slalom complementado com cones extra no vértice da curva <br>Não toques em nenhum cone!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "A seguir há umas curvas fáceis no teu caminho para a rotunda."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Usa a secção em recta para te preparares para a entrada na rotunda. Mantém-te do lado de fora antes de entrar na rotunda."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Entra na rotunda e observa o reboque. Vai ter uma trajectória diferente quando estiveres na rotunda em relação à trajectória de quando entraste na rotunda."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Sai da rotunda e conduz até ao próximo conjunto de curvas."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "REMOVER ESTE VÍDEO"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Esta cruva é extremamente apertada. Vai devagar e usa o espaço à tua volta eficazmente. Tem em conta a trajectória do reboque."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "À medida que vais passando pelas curvas, lembra-te de te preparares para a o próxima curva assim que sais da curva anterior."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Não te apresses na curva final. Parece fácil mas há menos espaço do que parece."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Acelera em direcção à primeira curva. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "A curva é uma curva e contracurva.<br><br><font face=/font/big_bold.font>Faz a curva. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "REMOVER ESTA VERIFICAÇÃO"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Mais à frente, o percurso continua à esquerda do mediano.<br><br><font face=/font/big_bold.font>Atravessa a passagem. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manobra através das barreiras e lembra-te de verificar o teu reboque.<br><br><font face=/font/big_bold.font>Conduz pelo slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "O slalom é mais directo mas os cones tornam-me mais apertado.<br><br><font face=/font/big_bold.font>Conduz pelo slalom e evita tocar nos cones. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Mais à frente, há curvas fáceis mas ainda assim tens de te preparar para manter o teu reboque afastado das barreiras interiores.<br><br><font face=/font/big_bold.font>Faz as curvas. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Estás a aproximar-te de uma rotunda. Lemabra-te de deixar espaço para o teu reboque não só para entrar e sair da rotunda mas também a circular dentro dela.<br><br><font face=/font/big_bold.font>Conduz pela rotunda. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Há uma pequena secção a direito à tua frente, podes ganhar alguma velocidade.<br><br><font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "A curva é bastante apertada. Vai devagar, usa todo o espaço disponível e tem em conta o balanço do reboque. <br><br><font face=/font/big_bold.font>Conduz pela curva apertada. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "As últimas curvas são directas. Lembra-te do teu reboque.<br><br><font face=/font/big_bold.font>Continua. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Conduz até ao lugar de estacionamento. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

