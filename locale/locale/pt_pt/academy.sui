#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Estacionamento na Diagonal"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Neste desafio, vais estacionar na diagonal num parque congestionado. <br><br>Não há muito espaço para manobrar, por isso tens de ser preciso na tua condução."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "A Chegar ao Lugar de Estacionamento"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "O estacionamento na diagonal num lugar destes é muito comum. São especialmente comuns nas áreas e serviço das auto estradas europeias. <br>Mais uma vez, vamos ter que meter o \"nariz\" do camião no lugar mais à frente."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Conduz em direcção ao lugar de estacionamento designado próximo do fim da fila."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Mantém-te no meio da via ou ligeiramente mais para o lado do condutor. Não conduzas muito perto das barreiras ou a traseira do reboque pode tocar nelas ao curvar."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Passa o lugar um pouco e vira rapidamente em direcção ao lugar. Precisas de ver ambos os espelhos: o do condutor para assegurar que a frente do reboque não bate no reboque ao lado e o do passageiro para verificar que o reboque tem espaço para entrar no lugar."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Ao estacionar na diagonal, é importante verificar a tua posição. Assim que começares a curvar, é difícil recuar e reposicionares-te, por isso é bom ter espaço suficiente na primeira tentativa.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Começa a conduzir em direcção ao lugar de estacionamento.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Passa pelo lugar de estacionamento para que o teu reboque tenha espaço para se mover.<br><br><font face=/font/big_bold.font>Vira para o lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Marcha-atrás pelo Lado do Passageiro"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Neste desafio, vamos estacionar de marcha-atrás pelo lado do passageiro. Sem poderes olhar pela janela para ver o que se passa, tens de confiar no que vês pelos espelhos para veres para onde queres ir."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Neste desafio, vamos aprender a manobra de marcha-atrás pelo lado do passageiro. Este lado deve ser evitado a não ser que não haja alternativa, devido à visibilidade reduzida. Leva o teu tempo e encosta com o máximo cuidado."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Conduz para lá do lugar de estacionamento para teres espaço para andar em marcha-atrás."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Pára, observa em teu redor, depois começa a andar de marcha-atrás."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Vira o tractor para longe do lugar. Isto vai dar espaço ao reboque e aponta a traseira do reboque para o lugar de estacionamento que queres ir. Tem cuidado para não exagerares e fazeres uma tesoura\" com o reboque."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "À medida que o reboque entra no lugar de estacionamento, vai endireitando o camião."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Pára na área designada e coloca o camião em marcada."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "A manobra de marcha-atrás para o lado do passageiro requer os mesmos procedimentos que para o lado do condutor, apenas tem menos visibilidade. Usa os espelhos e a tua intuição para estacionares.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Há um lugar de estacionamento mais à frente, do lado do passageiro. Precisas de o passar para teres espaço para a manobra de marcha-atrás.<br><br><font face=/font/big_bold.font>Conduz em frente. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Lembra-te, virar o camião para fora do lugar vai virar o reboque para dentro do lugar. Usa os espelhos para e ajudarem a estacionar.<br><br><font face=/font/big_bold.font>Começa a fazer marcha-atrás. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Conduzir numa Rotunda"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Neste desafio, vamos aprender a circular em rotundas.<br><br>Tens que prestar especial atenção ao teu reboque já que vai ter uma trajectória diferente quando entras, circular e sais da rotunda."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entrar na Rotunda"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Conduzir na Rotunda"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Conduzir numa Rotunda"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Sair da Rotunda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Conduz até à Área Marcada"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "As rotundas são muito comuns nas estradas europeias, por isso é importante aprender a circular nelas."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Mantém-te da parte de fora da rua via à medida que te aproximas da rotunda. Isto ajuda o reboque a passar a parte inicial da curva."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Conduz em direcção ao centro da rotunda quando entrares. Uma vez lá dentro, tens de manter na parte de fora para evitar que o reboque chegue ao centro da rotunda."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Mantém um olho no espelho para garantir que o reboque não está a chegar perto das barreiras interiores."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Sair da rotunda é fácil porque o reboque já está posicionado longe da parte interior da saída. Alarga a trajectória na saída e o reboque deverá fazer o mesmo."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Estaciona na área designada e coloca o camião em marcada."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "À tua frente está uma rotunda preparada para conduzires nela. <br><br><font face=/font/big_bold.font>Aproxima-te devagar da rotunda. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Faz uma curva larga ao entrar na rotunda para que o reboque não tenha problemas.<br><br><font face=/font/big_bold.font>Entra na rotunda. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Conduz em direcção à parte exterior da rotunda. Tens de manter o camião afastado do centro da rotunda para que o reboque não bata nas barreiras. <br><br><font face=/font/big_bold.font>Continua pela rotunda.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Mantém-te perto dos cones exteriores. <br><br><font face=/font/big_bold.font>Continua a conduzir.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Sai da rotunda.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Prossegue para o lugar de estacionamento à frente.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Pára na área marcada. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Coloca o camião em segurança e desliga o motor. </font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manobrar num Espaço Apertado"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Para o desafio final, terás de virar o camião num espaço apertado. Requer que faças marcha-atrás para o lado do pasasgeiro numa área com espaço limitado e requer a tua atenção às tuas imediações uso eficaz do espaço."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Conduzir pelo Percurso"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Preparar para o Lado do Passageiro"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "A Andar de Marcha-atrás até ao Lugar de Estacionamento"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Concluir o Lado do Passageiro"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "A Sair do Percurso"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Neste desafio, vamos aprender a virar num espaço apertado com uma manobra de marcha-atrás para o lado do passageiro. Está habilidade é útil quando não consegues fazer inversão de marcha ou não consegues virar para o lado do condutor."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "As marcações da estrada ajudar-te a circular pelo percurso de treino."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Faz uma curva larga para garantir que o reboque passa pelos camiões estacionados."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "À medida que sais da curva, considera como vais preparar o camião ara a manobra de marcha-atrás."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Ter o camião apontado ao lugar de estacionamento do lado do passageiro, ajuda, já que vais ter de fazer marcha-atrás."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "A manobra de marcha-atrás do lado do passageiro deve ser evitada sempre que possível devido à visibilidade inferior.\nInfelizmente, há alturas em que não tens outra escolha senão fazê-la."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Vira o volante antes de fazer marcha-atrás. Isto ajuda a apontar o reboque para onde o queres, o que ajuda em situações apertadas."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Assim que o reboque estiver no lugar, posiciona o tactor à sua frente e endireita-o."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Pára assim que endireitares a direcção e tiveres espaço suficiente para andar para a frente. Dirige-te para o mesmo sítio de onde vieste."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Segue as marcações da estrada para sair do percurso de treino."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Conduz pela curva à frente e prossegue para a área marcada."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "A Parar."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Coloca o camião em segurança e desliga o motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Na área à tua frente há um percurso de treino exemplificativo de um parque de uma companhia. A tua tarefa é conduzir até e dar a volta ao camião para sair de lá. Assegura-tr de que usas bem o espaço à tua volta.<br><br><font face=/font/big_bold.font>Prepara-te para partir </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Prossegue para o percurso de treino. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Faz a curva e prossegue pelo percurso. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Segue as marcações da estrada até à barreira no fim do percurso. Estaciona ligeiramente inclinado para que o reboque fique apontado para o lugar de estacionamento do lado passageiro.<br><br><font face=/font/big_bold.font>Continua em frente. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Tens uma visão muito mais limitada à tua volta do lado do passageiro. Vai devagar, usa os espelhos e encosta ao lado com cuidado.<br><br><font face=/font/big_bold.font>Começa a andar em marcha-atrás e vira o reboque para o lugar de estacionamento vazio. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Está bom. Podes prosseguir em frente e sair do centro de treino pela mesma direcção em que vieste.<br><br><font face=/font/big_bold.font>Prossegue para a saída. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Sai do percurso de treino. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Segue as marcações da estrada até ao último lugar de estacionamento.<br><br><font face=/font/big_bold.font>Prossegue até à área marcada. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manobra de Marcha-atrás Deslocada"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Neste desafio, tens a tarefa de fazer marcha-atrás para um lugar que não está directamente atrás de ti. Há espaço limitado para manobrar, por usa-o com cuidado."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Neste desafio, a tua tarefa é estacionar num lugar vago perto de ti. Não há muito espaço para manobras, por isso irás ter mais trabalho a colocar o reboque onde o queres."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Conduz em frente até à barreira."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Pára antes da barreira."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Vira o volante bruscamente para o lado do motorista antes de te moveres. Dessa forma, começarás a virar o reboque em direcção à vaga de estacionamento assim que começares a fazer marcha-atrás, economizando espaço valioso."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Assim que tiveres o reboque apontado para onde o queres, coloco tractor em frente do reboque e começa a virá-lo em direcção ao lugar de estacionamento."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "A partir este momento, não é tão diferente e uma manobra de estacionamento normal."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continua a fazer marcha-atrás e olha para os dois lados. Mantém o camião e o reboque alinhados com o lugar de estacionamento."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Estás estacionado mas há um segundo lugar à tua direita para onde deves ir.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Há uma área marcada à tua frente.<br><br><font face=/font/big_bold.font>Continua em frente. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Lembra-te de começar a virar imediatamente já que não há muito espaço.<br><br><font face=/font/big_bold.font>Anda de marcha-atrás até ao lugar marcado atrás de ti. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Conduz Através de Curvas Simples"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Neste desafio, vamos para uma curta viagem num percurso de treino que te irá ajudar a manobrar o reboque em curvas de 90 graus."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "A Fazer a Primeira Curva"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Segunda Curva"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Curva Final"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "À tua frente há curvas apertadas com pouco espaço disponível. Elas irão ajudar-te a manobrar o reboque."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Segue as marcações da estrada até às barreiras do lado do condutor para te preparares para a primeira curva."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Mantém-te perto do lado de fora da barreira durante a curva e o reboqued everá seguir o mesmo caminho sem problemas."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Continua a seguir as marcações da estrada para te preparares para a segunda curva, uma com um ângulo de 90 graus."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Tens de entrar bem na curva para garantir que o reboque não bate nas barreiras interiores. Usa o espelho da frente para te ajudar a ir o mais longe possível sem bateres em nada."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continua ao longo da barreira exterior."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Mais uma vez, uma curva apertada de 90 graus que requer que uses todo o espaço disponível à tua volta."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Pára na área marcada e coloca o camião em segurança."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Lembra-te de usares todo o espaço disponível para te ajudar a passar por cada curva.<br><br><font face=/font/big_bold.font>Começa a andar e segue as marcações exteriores da estrada. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Segue a barreira exterior mas mantém o reboque debaixo de olho pelo espelho.<br><br><font face=/font/big_bold.font>Faz a primeira curva. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Segue as marcações da estrada para te preparares para a curva de 90 graus mais à frente.<br><br><font face=/font/big_bold.font>Faz a curva de 90 graus. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Mantém o camião largo após a curva, já que tens outra curva de 90 graus ainda mais apertada mais à frente.<br><br><font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Prossegue para o lugar de estacionamento à frente.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Estacionamento na Diagonal em Marcha-atrás"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Neste desafio, vamos explorar o estacionamento na diagonal em marcha-atrás. Isto pode ser necessário em áreas de descanso, áreas de serviço para camiões e até nas companhias. Normalmente há sempre pouco espçao porque o parque está lotado com camiões, daí ser mais difícil estacionar devido à falta de espaço."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "A Virar o Reboque"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "O estacionamento na diagonal parece fácil, mas pode ser muito mais desafiante que a típica manobra de reversão numa esquina."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Anda em amrcha-atrás até ao lugar de estacionamento. Mantém o tractor e o reboque direitos por agora."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "À medida que te vais aproximando, deixa o reboque chegar perto dos outros camiões estacionados. Isto ajuda-te a virar para o lugar que chegares ao lugar."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Começa a virar o reboque para o lugar. Mantém o teu reboque perto do camião do lado do condutor, já que precisas do espaço no outro lado."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Assim que o reboque estiver dentro do lugar de estacionamento, começa a virar o tractor para seguir o reboque para dentro do lugar."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Estaciona o camião no espaço atrás de ti. Usa ambos os espelhos para verificares a manobra enquanto fazes marcha-atrás.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Verifica as tuas imediações, depois vai até ao lugar de estacionamento.<br><br><font face=/font/big_bold.font>Começa a fazer marcha-atrás.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Começa a mover o reboque em direcção ao camião ao teu lado. Quando estiveres pronto, vira o reboque para o lugar de estacionamento. Lembra-te de considerar o balanço do reboque.<br><br><font face=/font/big_bold.font>Vira para o lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Andar de Marcha-atrás para uma Curva"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Neste desafio, vamos andar de marcha-atrás com o reboque para uma curva pela primeira vez. Vamos explorar os princípios báscios da manobra e o que deves verificar enquanto efectuas a manobra."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "A Virar o Reboque"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Neste desafio, tens de fazer marcha-atrás para o lugar de estacionamento atrás de ti do lado do condutor."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Há algumas dicas para te lembrares quando fizeres marcha-atrás com um reboque. <br>A primeira é que o reboque vai sempre virar na direcção oposta aquela em que viras o tractor."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "A segunda é que podes uma boa noção para onde o reboque está a virar se observares os eixos do camião e do reboque."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Terceira, pequenos ajustes levam-te onde queres, não precisas de virar demasiado."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Começa a virar o tractor ligeiramente para longe do lugar de estacionamento e o reboque vai começar a apontar para o lugar."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Segue o reboque, faz ajustes se necessário para manter a rota correcta."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Observa as rodas do teu reboque e a roda traseira do teu tractor. Estas dir-te-ão para onde o reboque está apontado e para onde o tractor está a empurrar."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "A quarta dica é que é sempre mais fácil virar o reboque rapidamente do que endireitá-lo após uma manobra de \"tesoura\". Aponta para a parte de fora do lugar até chegares perto e depois vira rapidamente para alinhar o reboque."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "À medida que o reboque entra no lugar de estacionamento, coloca o tractor à frente do reboque. Tenta não fazer demasiados ajustes já dentro do lugar."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Anda em marcha-atrás entre as barreiras, observa ambos os lados à medida que vais avançando."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Coloca o camião em segurança e desliga o motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Lembra-te destas dicas quando andares de marcha-atrás com um reboque:<br><br>- O reboque vira sempre na direcção oposta à do tractor<br><br>- Observa as rodas do reboque para ver para onde ele vai<br><br>-Observa a roda traseira do camião para ver para onde ele está a empurrar o reboque<br><br>-Deixar o reboque andar, não vires demasiado o volante<br><br>-É sempre mais fácil virar rapidamente o reboque do que o endireitar<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Olha para trás para veres para onde precisas de ir. Verifica sempre as tuas imediações antes de começar a fazer marcha-atrás.<br><br><font face=/font/big_bold.font>Começa a fazer marcha-atrás em direcção ao lugar de estacionamento. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Começa a virar o reboque em direcção ao lugar de estacionamento e segue-o para o lugar.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Pára na área designada. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Estacionamento em Marcha-atrás num parque apertado"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Neste desafio, terás a tarefa de andar de marcha-atrás com o reboque para um lugar de estacionamento num parque lotado."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "A Virar o Reboque"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Isto é um parque de estacionamento típico para camiões. Os camionistas irão encontrar este tipo de estacionamento quase diariamente nas suas carreiras.<br>Estacionar aqui requer uma manobra de “estacionamento em esquina”."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Esta é uma manobra semelhante ao desafio anterior, mas terás menos espaço para trabalhar, então precisarás de planear os teus movimentos adequadamente e ter cuidado para não acertar em nada."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Como há menos espaço, o teu tempo é mais importante. Vira o reboque na hora certa e observa as rodas do tractor e do reboque para ver para onde ele irá. Lembra-te do balanço do reboque e lembra-te de não fazer \"tesoura\" - continua empurrar o reboque."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Tenta ficar perto do camião do lado do condutor, isso dá espaço para o reboque balançar e podes preocupar-te menos com o camião do lado do passageiro."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Assim que o reboque estiver no local, coloca o tractor na frente dele. É melhor fazer isso um pouco mais cedo do que o teu instinto inicialmente pode fazer-te acreditar. Podes sempre corrigi-lo enquanto retrocedes para a sua posição final."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Endireita o tractor e o reboque e pára na área marcada."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Coloca o camião em segurança e desliga o motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Agora vamos tentar virar um reboque numa área muito menor com uma manobra de ‘marcha-atrás em esquina’. <br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Observa as tuas imediações e procura pelo lugar de estacionamento atrás de ti. <br><br><font face=/font/big_bold.font>Começa a andar em marcha-atrás em direcção ao lugar. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Vira o reboque em direcção ao lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Exame Final (Parte 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "O exame final aguarda-te e é onde serão postas à prova todas as habilidades que aprendeste nos desafios anteriores. Faremos um passeio por todo o centro de treinos para ver se aprendeste bem as situações que encontraste até agora.<br><br>Depois de concluir todas as secções e manobras, estarás um passo mais perto de te autodenominares um camionista habilidoso!"

