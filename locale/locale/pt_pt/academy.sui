#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Estacionar Perto de um Obstáculo"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Neste desafio, vamos aprender a estacionar perto do passeio utilizando o espelho lateral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Verifica o Espelho Lateral"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "A Conduzir Para Perto do Passeio"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "O espelho lateral é outra ferramenta que vai ajudar-te a manobrar o camião em segurança. Está localizado na parte superior da porta do passageiro."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Conduz em frente e vira devagar para o lado do passageiro."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Estás paletes de madeira representam um passeio. Vais precisar de estacionar perto delas. <br>Vira em direcção ao passeio para colocar o camião numa posição alinhada com o lugar de estacionamento."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Abranda antes do passeio e vira para o lugar de estacionamento. Quando endireitares o camião, podes usar o espelho lateral para ver a tua distância do passeio."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Pára no lugar de estacionamento e coloca o camião em segurança."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Olha através da janela no lugar do passageiro. Podes ver o espelho lateral aí.</font>@@aca_goal_tip@@ Tens de estar dentro do veículo."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "O espelho lateral cobre a área do lado do passageiro onde o condutor não vê. É um dos ângulos mortos mais problemáticos de um camião.Se o ângulo não te agradar, podes ajustá-lo em '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Prepara-te para arrancar. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "O camião ainda não está pronto para partir, talvez te tenhas esquecido de alguma coisa?<br><br>O motor está ligado? Desengataste o travão de estacionamento?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "À tua frente está uma linha de paletes que representa um passeio. No fim do passeio está um lugar de estacionamento. Precisas de conduzir até lá. <br><br><font face=/font/big_bold.font>Avança quando estiveres pronto. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Vira de encontro ao passeio. Usa o espelho frontal e lateral para ver a tua posição em relação ao passeio mas assegura-te que não vais de encontro aos cones de tráfico.<br><br><font face=/font/big_bold.font>Conduz em dirrecção ao passeio e para o lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Coloca o camião em segurança e desliga o motor.</font>@@aca_goal_tip@@ Podes usar as pre-definições para facilitar a escolha da tua vista. Verifica o Ecrã de Opções - 'Teclas & Botões' - para ver e/ou mudar os controlos correspondentes."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Retroceder e Estacionar Perto de um Obstáculo"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Neste desafio, vamos andar em marcha-atrás com o camião para um lugar de estacionamento perto do passeio."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instruções"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Andar em Marcha-atrás em Direcção ao Passeio"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Estaciona o Camião"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Neste desafio, vamos andar em marcha-atrás para estacionar perto do passeio."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Anda em marcha-atrás em direcção ao passeio.<br>Deves estar ciente do espaço à tua volta, por isso usa os espelhos."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "À medida que chegas perto, podes começar a alinhar o camião com o lugar de estacionamento. Verifica ambos os lados do camião enquanto fazes marcha-atrás."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Pára no lugar de estacionamento e coloca o camião em segurança."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "O lugar de estacionamento está atrás de ti, no lado do passageiro. Usa os espelhos para navegares em direcção ao lugar.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Lembra-te de utilizares os espelhos para verificar as tuas imediações enquanto moves o camião.<br><br><font face=/font/big_bold.font>Começa a andar em marcha-atrás em direcção ao passeio. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continua a verificar as tuas imediações enquanto andas de marcha-atrás até ao lugar de estacionamento.<br><br><font face=/font/big_bold.font>Pára na área designada. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

