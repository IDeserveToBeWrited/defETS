#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Bem-vindo à primeira parte do exame final. Aqui, veremos se vaprendeste a conduzir um camião depois de estudares na Academia."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Primeiro, vais engatar o reboque. Uma vez engatado, vais conduzir por toda a área de teste."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "A primeira secção da pista leva-te desde o pequeno parque de estacionamento até o percurso de testes a oriente."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "O circuito inclui passagens desafiantes entre barreiras."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Uma parte significativa da rota passa pelo percurso de testes a oriente."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Vamos testar a tua habilidade a manobrar o camião em diferentes situações."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Vais manobrar o camião através de algumas curvas apertadas."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Vais conduzir pela secção de estrada que liga os percursos."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "A parte final involve conduzires pelo circuito pequeno."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "O circuito tem muitas passagens intrigantes e curvas fechadas."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Para completar o teste, precisarás de estacionar com precisão."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Não precisas de ficar nervoso, já aprendeste tudo o que será necessário para passar.<br><br>Boa sorte!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "O reboque está à tua frente.<br><br><font face=/font/big_bold.font>Conduz em direcção ao reboque. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Alinha o tractor com o reboque.<br><br><font face=/font/big_bold.font>Anda em marcha-atrás e conecta o pino. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Coloca o camião em segurança. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Pressiona @@imv_nrm_attach@@<font face=/font/big_bold.font> para engatar o reboque. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "O reboque está conectado e o camião está pronto para conduzir.<br><br><font face=/font/big_bold.font>Desengata o travão de estacionamento. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Começa a conduzir em direcção à saída do parque de estacionamento.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Segue as marcações da estrada e está atento às barreiras.<br><br><font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Uma secção mais desafiante está a aproximar-se.<br><br><font face=/font/big_bold.font>Cirucla com cuidado por entre as barreiras. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Esta parte vai testar as tuas habilidades a manobrar um reboque em vários tipos de curvas.<br><br><font face=/font/big_bold.font>Circula em direcção ao percurso. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Conduz através da passagem. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Conduz em frente. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Circula devagar na curva. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Estás a entrar numa secção mais complexa. Conduz com cuidado.<br><br><font face=/font/big_bold.font>Continua a conduzir pela descida. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Faz a curva fechada à esquerda. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Sai do circuito. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Estás a entrar numa secção mais fácil.<br><br><font face=/font/big_bold.font>Continua a conduzir na descida. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Mantém-te na estrada. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "À frente, está a curva para o próximo percurso.<br><br><font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Vira à direita. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Continua conduzir no percurso. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "À frente há mais curvas apertadas.<br><br><font face=/font/big_bold.font>Ajusta a tua velocidade. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Vira à esquerda. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Entra na curva, continua a conduzir. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Para fazer a curva, precisas de sair ligeiramente do asfalto.<br><br><font face=/font/big_bold.font>Vira com cuidado, utilizando o máximo de espaço possível.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Sai do circuito e conduz até ao lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Exame Final (Parte 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "A última parte do exame final espera por ti, onde serão avaliadas as habilidades de estacionamento que aprendeste nos desafios anteriores. Estaciona com cuidado e precisão e estarás pronto para pegar as estradas da Europa como um camionista habilidoso!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manobra Deslocada"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Estacionamento na Diagonal"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Conduzir no Parque de Estacionamento"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Estacionamento Paralelo"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Último Estacionamento"
