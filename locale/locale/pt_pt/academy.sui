#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Conduzir numa Pista de Manutenção"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Neste desafio, vamos conduzir numa pista desenhada para testar a tua habilidade em manter lidar com o camião em diferentes curvas e cantos."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "A Entrar no Percurso"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Fazer uma Curva Gradual à Esquerda"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Conduzir Através de Curvas em S"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Seccção a Direito"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Curvas Fáceis"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "A Sair do Percurso de Treino"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "A Chegar ao Lugar de Estacionamento"
