#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Neste desafio, vamos levar o camião para uma curta viagem. Serás capaz de sentir a travagem com um reboque enquando descemos a montanha. Prepara o camião e arranca."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Atinge uma velocidade de pelo menos 60 km/h (37 mph). Está pronto para a zona de travagem mais à frente."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Começa a travar até parar. Não esperes até muito tarde ou podes colidir com as barreiras à tua frente!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Durante esta viagem, vais experimentar os travões de serviços numa descida. O propósito deste exercício é ficares atento ao peso atrás de ti e como isso afecta a distância de travagem do teu veículo.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Começa a conduzir e tem em conta que tens de atingir uma velocidade 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Conduz através da curva. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Continua a acelerar pela descida. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Atinge uma velocidade de pelo menos 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Atingiste a velocidade pretendida. <br><br><font face=/font/big_bold.font>Pára nas barreiras à frente. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

