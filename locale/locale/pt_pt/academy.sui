#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Controlos Básicos e Movimento"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Aprende controlos básicos do veículo e como mover o camião para a frente e em marcha-atrás."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Completaste o Capítulo 1: @@aca_chapter_book1_1_title@@.<br><br>Aprendeste a preparar o camião antes da condução,<br>conduzir para a frente e para trás e a usar as luzes e as escovas.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Manobras Básicas"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Aprende a conduzir, manobrar e estacionar com uma unidade tractor. Explora o propósito de cada espelho e como os usar."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Concluíste o Capítulo 2: @@aca_chapter_book1_1_title@@.<br><br>Aprendeste a utilizar os espelhos, verificar o espaço à tua volta antes de arrancares e manobras básicas e avançadas</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manobrar com um Reboque"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Aprende a atrelar e a manobrar com o reboque em diferentes situações."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Concluíste o Capítulo 3: @@aca_chapter_book1_3_title@@.<br><br>Aprendeste a atrelar e desatrelar o reboque,<br>sentir o peso e dimensões do camião com o reboque<br>e a conduzir em percursos desafiantes com o reboque</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Marcha-atrás com um Reboque"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Aprende novas manobras para manobrar em marcha-atrás e estacionar com o reboque."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Concluíste o Capítulo 4: @@aca_chapter_book1_3_title@@.<br><br>Aprendeste a manobrar em marcha-atrás com o reboque,<br>e várias técnicas de estacionamento.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Exame Final"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Demonstra o teu conhecimento e habilidades para provares o teu valor como camionista!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Concluíste o Capítulo 5: @@aca_chapter_book1_5_title@@.<br><br>Provaste que possuís todas as habilidades necessárias<br>para conduzir, manobrar e estacionar um camião!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "A Aquecer o Motor"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Você concluiu o treino: @@aca_chapter_book2_0_title@@.<br><br>Você aprendeu as regras e características da Proficiência de Condução.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "De volta à Marcha"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 2: @@aca_chapter_book2_1_title@@.<br><br>Você aqueceu o motor, testou as marchas, virou as rodas corretamente e verificou a eficiência dos travões. Os próximos capítulos serão mais desafiantes.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Rodas em Movimento"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 3: @@aca_chapter_book2_2_title@@.<br><br>Você dominou desafios difíceis e variados. Você demonstrou habilidade e desempenho.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "O Caminho Inicial"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 4: @@aca_chapter_book2_3_title@@.<br><br>Você lidou com muitas situações difíceis ao manobrar, estacionar e marcha-atrás com um reboque. Você provou ser um motorista habilidoso, capaz de lidar com todas as situações desafiadoras de condução de camiões."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Em Frente"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Aprenda todas as técnicas essenciais para lidar com reboques duplos ao andar para a frente."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluíu o Capítulo 1: @@aca_chapter_book3_1_title@@.<br><br>Você aprendeu a conduzir e a manobrar com reboques duplos de maneira eficaz.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Controlo a Retroceder"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Entenda as etapas necessárias para manobrar reboques duplos em marcha-atrás."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluíu o Capítulo 2: @@aca_chapter_book3_2_title@@.<br><br>Você aprendeu a formidável habilidade de andar em marcha-atrás com reboques duplos.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Preparação para o Mundo Real"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Aplique o seu novo conhecimento em cenários mais avançados."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 3: @@aca_chapter_book3_3_title@@.<br><br>Você lidou com muitas situações difíceis ao manobrar, estacionar e marcha-atrás com um reboque duplo. Você provou ser um motorista habilidoso, agora é altura de utilizar reboques duplos nas estradas do Euro Truck simulator 2!</font><br><br>"


#@}

