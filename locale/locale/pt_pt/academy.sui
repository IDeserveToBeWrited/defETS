#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "O estacionamento paralelo é uma habilidade que qualquer camionista deve saber.<br>Prepara-te para partir."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Avança até ao lugar de estacionamento.<br>Presta atenção às tuas imediações."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Alinha o camião em frente ao teu lugar de estacionamento. Não fiques demasiado perto dele, fica com alguma distância para que tenhas espaço para estacionar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Vira rapidamente em direcção ao espaço e começa a fazer marcha-atrás."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Enquanto olhas pelo espelho do lado do condutor, aponta para o passeio à frente do camião atrás de ti."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Assim que o pára-choques dianteiro passar pelo camião à tua frente, podes começar a virar a extremidade dianteira do camião para o local, alinhando o camião com a lugar de estacionamento."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Endireita o volante e centra o camião dentro do lugar de estacionamento.<br>Estaciona e coloca o camião em segurança."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "À tua frente estão alguns camiões estacionados. Há um espaço livre à esquerda para estacionares. <br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Lembra-te de verificares as tuas imediações. Usa bem os espelhos durante a manobra. <br><br><font face=/font/big_bold.font>Conduz em frente. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Conduz para lá do lugar de estacionamento até à área marcada. Daí podes começar a tua manobra de marcha-atrás.<br><br><font face=/font/big_bold.font>Pára no lugar assinalado. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Verifica as tuas imediações e garante que está tudo livre para fazeres marcha-atrás.<br><br><font face=/font/big_bold.font>Olha pelo espelho do lado do passageiro. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Vira as tuas rodas e anda em marcha-atrás até ao lugar de estacionamento.<br><br><font face=/font/big_bold.font>Começa a andar em marcha-atrás. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Começa a endireitar o camião quando possível. Não subas o passeio!<br><br><font face=/font/big_bold.font>Alinha o camião com o lugar. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

