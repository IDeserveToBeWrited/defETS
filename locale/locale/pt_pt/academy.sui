	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Prossiga até ao fim da fila e encontre o seu lugar de estacionamento."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Conduza além do lugar de estacionamento para garantir que o reboque traseiro mantém-se na trajectória correcta, de seguida vire rapidamente para assegurar que o reboque dianteiro não bata no camião ao lado."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Continue lentamente enquanto endireita o conjunto e depois pare na área designada."

