	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Vamos experimentar fazer marcha-atrás com um reboque. É mais facil do que parece; apenas tens de ser paciente."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Começa a andar para trás e alinha o tractor com o reboque."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Assegura-te de que estás correctamente alinha ou não vais conseguir engatar o reboque. Se não estiver bem, podes sempre andar para a frente e tentar novamente."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "A quinta roda do tractor vai engatar no pino do reboque."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Engata o travão de estacionamento e engata o reboque. Na vida real, terias de air do camião para conectar as mangueiras de ar e eléctricas e levantar o trem, mas aqui fazêmo-lo por ti."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>O reboque vai virar sempre para o lado <color value=@@clr_sel@@>oposto <color value=@@clr_txt@@>do tractor."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Para virar o reboque, precisas de virar o tractor na direcção<color value=@@clr_sel@@> oposta<color value=@@clr_txt@@> aquela que queres que o reboque vire."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Para endireitar o reboque, vira o tractor na mesma <br><color value=@@clr_sel@@>direcção <color value=@@clr_txt@@> do reboque."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Tenta manter-te alinhado com o reboque - vais precisar de efectuar pequenas correcções para manter o reboque apontado à área marcada."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corrige os desvios na tua trajectória ao virar devagar o volante, assim que notas o desvio. Se virares demais, podes sair do teu caminho desejado."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Estaciona na área marcada, coloca o camião em segurança e desliga o motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Atrás de ti, no lado do passageiro, está um reboque. Vais andar para trás até ele.<br><br><font face=/font/big_bold.font>Prepara o camião para fazer marcha-atrás. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Começa a andar para trás em direcção ao reboque. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Alinha-te de maneira a estares direito em relação ao reboque. A quinta roda precisa de tocar no pino. Vai anda para a frente para ajustar se necessário.<br><br><font face=/font/big_bold.font>Continua a andar para trás até sentires a conexão. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "A quinta roda está bloqueada no pino e estás pronto para terminar o engate do reboque. <br><br><font face=/font/big_bold.font>Engata o travão de estacionamento. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Pressiona @@imv_nrm_attach@@ para engatar o reboque. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Agora que o reboque está engatado ao tractor, as mangueiras estão conectadas e o trem está levantado.<br><br><font face=/font/big_bold.font>Desengata o travão de estacionamento. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Deves andar de marcha-atrás até ao lugar de estacionamento atrás de ti. Lembra-te que o reboque vira na direcção oposta à do tractor. Uma pequena mexida no volante pode causar um movimento significativo do reboque.<br><br><font face=/font/big_bold.font>Começa a andar para trás com o reboque. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Não vires demais, mantém o reboque alinhado com o lugar. <br><br><font face=/font/big_bold.font>Continua até ao lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Estacionar num Sítio Apertado"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "Neste deafio vamos estacionar num sítio apertado.<br><br>Tens de manobrar o reboque e alinhá-lo direito com o lugar de estacionamento ao lado."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "A Manobrar Para o Lugar"
