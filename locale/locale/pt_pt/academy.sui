#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Neste desafio, vamos levar a unidade tractora para uma curta viagem para ver como lidas com as novas habilidades que aprendeste."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Há vários tipos de combinações de curvas na pista. Não é uma corrida nem é sobre o tempo. Sê paciente e ajusta a tua velocidade às curvas e obstáculos que encontrares."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "No início o percurso é fácil, mas à medida que avanças as curvas vão ser mais exigentes."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Tem cuidado com a tua velocidade; é fácil andares depressa e calculares mal a curva."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "A saída da pista é uma curva fechada. Vai devagar e usa todo o espaço disponível."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Estaciona entre as barreiras e coloca o camião em segurança."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Para completares este desafio com sucesso, não podes ter nenhuma colisão, não podes sair da pista ou atingir cones de trânsito.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Avança em frente para a curva apertada à direita para entrares no percurso. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Conduz pela curva a uma velocidade constante. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Estás a aproximar-te de uma secção complexa de curvas sinuosas.<br><br><font face=/font/big_bold.font>Ajusta a tua velocidade e continua.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continua em frente até às próximas curvas.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Há algumas curvas fáceis a aproximarem-se. Mantém a tua velocidade estável.<br><br><font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "A curva de saída do percurso é uma curva bastante apertada. Abranda e mantém-te do lado de fora da curva. Usa os espelhos!<br><br><font face=/font/big_bold.font>Sai do percurso. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "À tua frente está um lugar de estacionamento entre algumas barreiras.<br><br><font face=/font/big_bold.font>Avança até ao lugar de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Estacionamento Paralelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Neste desafio vamos ver o estacionamento paralelo entre dois camiões."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "A Parar em Frente ao Lugar de Estacionamento"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "A Verificar o Espelho Retrovisor"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "A Andar de Marcha-atrás até ao Lugar de Estacionamento"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "A Alinhar o Camião Dentro do Lugar de Estacionamento"
