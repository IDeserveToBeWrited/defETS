	val[]: "Ponto de passagem atingido"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Prossiga com o desafio."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Lugar de estacionamento"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Para terminar o deafio, coloca o camião em segurança e desliga o motor.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Está no sítio certo, mas virado ao contrário.<br><br><font face=/font/big_bold.font>Dê a volta ao camião antes de concluir o desafio.</font>"
#@}

#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Bem-vindo à @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Os próximos desafios representam o primeiro passo na tua jornada de camionista."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Aqui, irás aprender tudo desde sistemas básicos e controlos de um camião..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...a manboras complexas com e sem reboque."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Ajudaremos a incutir hábitos que te ajudarão a navegar com segurança em diversas situações,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "e ensinarte a fazer uso inteligente do espaço disponível para manobrar o teu camião com eficácia."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Ao completares todos os desafios e passares nos exames finais,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "estarás pronto para ir para as estradas da Europa e encontrar novos desafios para enfrentar."

#@}

