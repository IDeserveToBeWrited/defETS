	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Controlos da Câmera"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Neste desafio, vamos aprender sobre os vários tipos de câmeras disponíveis para ti e como podem ajudar-te a controlar e manobrar o camião."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Posição de Condução"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Vista para Trás"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Verificar Espelhos"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Mudar para Câmera Externa"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Ver à Volta do Camião"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Neste cenário, vamos passar por várias câmeras<br>que estão disponíveis para usar."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Existem sete câmeras no total, vamos ver<br> algumas delas agora e explicar a sua função."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "As várias câmeras e os seus diferentes ângulos podem ajudar-te quando manobrares em espaços apertados."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Ver para onde vais é a principal função para uma condução segura e profissional. Se a posição de condução actual não te serve, pode mudar em '@@adjust_link_t@@' (Acede via menu de pausa).<br><br><font face=/font/big_bold.font>Confirma quando estiveres pronto com @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Quando estiveres a a andar em marcha-atrás, os espelhos não oferecem sempre uma boa visibilidade. Pode ser necessário olhares pela janela para trás de ti para ter uma melhor visibilidade.<br><br><font face=/font/big_bold.font>Vira a tua câmera até ao lado do condutor oara vere pela janela até à traseira do reboque.</font>@@aca_goal_tip@@ Tens de estar dentro do veículo."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Usa esta vista para verificares o reboque durante manobras em marcha-atrás. É sempre melhor andares para trás para o lado do condutor para que utilizes esta vista. Se andares para trás para o lado do passageiro, terás uma vista muito mais limitada do que se está a passar atrás de ti.<br><br><font face=/font/big_bold.font>Olha pelo lado do passageiro. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "É por isto que não é recomendado fazeres marcha-atrás para o lado do passageiro; podes ver que essa viabilidade é muito limitada. Felizmente, há sete câmeras exteriores disponíveis.<br><br>O botão @@imv_nrm_camcycle@@ pode ser usado para mudar para a próxima câmera. Após passares por todas as sete câmeras, voltas ao início da sequência de câmeras. <br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_camcycle@@ para mudares para a câmera seguinte. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "A câmera exterior fornece a melhor perspectiva sobre o que se passa à volta do camião.<br><br><font face=/font/big_bold.font>Olha à volta do camião.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Pressionar @@imv_nrm_camcycle@@ outra vez muda para a câmera seguinte. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "A vista de cima permite uma excelente visão da situção à volta do camião, simplificando o estacionamento e a condução em espaço apertados.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_camcycle@@ para mudar para a câmera seguinte.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "A câmera do tecto permite uma visão clara da estrada à frente do camião sem muita obstrução.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_camcycle@@ para mudar para a última câmera que veremos por agora.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "A vista para trás é um atalho para a vista que tens ao virar a câmera interior. Como falado, é útil para andar em marcha-atrás ou estacionar.<br><br>No jogo, temos mais câmeras que podes usar ao pressionar @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Pressionar @@imv_nrm_cam1@@ para voltar para o interior.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Para uma experiência autêntica, recomendamos utilizares a câmera interior conforme vais passando pelos vários desafios.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_activate@@ para confirmar e terminar o cenário.</font>@@aca_goal_tip@@ Podes utilizar a funcionalidade @@o_im_cam_zoom@@para uma melhor vista das tuas imediações. É especialmente útil ao veres pelos espelhos. Verifica o separador 'Teclas & Botões' no Ecrã de Opções para ver e/ou mudar os mapeamentos das teclas correspondentes."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Primeira Condução"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Neste desafio, iremos preparar o camião para ser conduzido e depois andar para a frente pela primeira vez."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "A Ligar a Ignição"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "A Ligar o Motor"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "A Verificar Imediações"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "A Aplicar Travão de Serviço"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "A Mudar de Marcha"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "A Libertar o Travão de Estacionamento"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "A Conduzir para a Frente"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "A Parar"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "A Engatar o Travão de Estacionamento"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "A Mudar para Ponto-morto"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "A Desligar o Motor"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Para as primeiras viagens, iremos utilizar apenas o tractor.<br>Um camião é referenciado como um tractor quando não tem estrutura de carga sua e precisa de utilizar um reboque para transportar bens e materiais."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Os tractores são comuns porque têm maior versatilidade: eles podem desengatar um reboque sem carga e engatar um reboque com carga sem ter que esperar ou mudar para outro tipo de reboque."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Para a tua primeira viagem, a tua tarefa é avançar para a frente e parar após a linha tracejada.<br>Liga o motor, segue as instruções e prepara o camião para se mover. Assim que estiveres pronto, avança em frente."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Conduz para lá da linha tracejada, desliga o motor e segura o camião."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Para o teu próximo treino, vais mover o camião pela primeira vez.<br><br>Claro que, com o motor desligado, não vai funcionar, por isso liga primeiro a ignição.<br><br><font face=/font/big_bold.font>Pressiona $input engineelect$ para ligares a ignição.</font>@@aca_goal_tip@@ No modo Carreira, por defeito, o motor está ligado automaticamente. Para o modo Carreira, podes ajustar este comprotamento no Ecrã de Opções - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "A ignição activa a electrónica do camião. Podes ver luzes a piscar no quadrante - é normal. Se se mantiverem acesas após o motor ser ligado, então pode haver um problema com o camião. A excepção é a luz do travão de estacionamento, que se apaga quando se desengatar o travão de estacionamento.<br><br>Felizmente, este camião está em óptimas condições e estamos prontos para prosseguir.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_engine@@ para ligar o motor. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Agora que o motor está ligado, é crucial verificares o espaço à tua volta antes de qualquer movimento.<br><br><font face=/font/big_bold.font>Olha à volta do camião e para os teus espelhos laterais para confirmar que a área está livre.</font>@@aca_goal_tip@@ Tens de estar dentro do veículo."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Parece óbvio, mas deves saber como parar antes de iniciar qualquer movimento.<br><br><font face=/font/big_bold.font>Activa o travão de serviço utilizando $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "A seguir, vais aprender a mudar a direcção da tua viagem.<br><br>Com uma transmissão simplificada, não precisas de mudar de mudanças, tudo é feito por ti.<font face=/font/big_bold.font><br><br>Usa $input forward$ para mudar para uma mudança para a frente. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "A seguir, vais aprender a mudar a direcção da tua viagem.<br><br>A transmissão automática realística permite-te mudar entre Conduzir, Ponto-mort e Marcha-atrás tal como numa caixa automática real.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_gearup@@ para activar uma mudança para a frente. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "A seguir, vais aprender a mudar a direcção da tua viagem.<br><br>A transmissão sequencial permite mudanças escalonadas, assim como as transmissões sequenciais reais.<br><br>Da mesma forma que engatas u<br><br><font face=/font/big_bold.font>ma marcha à frente, ao acelerar precisas de mudar para marchas mais altas.Pressiona @@imv_nrm_gearup@@  para engatar a primeira velocidade.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "A seguir, vais aprender a mudar a direcção da tua viagem.<br><br>Coma alavanca das mudanças, vais experimentar a sensação de mudar de marcha como numa caixa manual real.<br><br>Pressiona a embraiagem e o travaão de serviço. <font face=/font/big_bold.font>Usa a alavanca para engatar a primeira velocidade. <color value=@@clr_txt@@>Mantém o pé fora da embraiagem e do travão.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Para começares a andar, tens que libertar primeiro o travaõ de mão.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ para libertar o travão de mão.</font> @@aca_goal_tip@@ No modo Carreira, o travão de mão está desactivado. Podes ajustar este comportamento no Ecrã de Opções - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Agora o camião está pronto para andar para a frente. Começa a andar e atravaessa a linha.<br><br><font face=/font/big_bold.font>Inicia o movimento ao usares o acelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Agora o camião está pronto para andar para a frente. Começa a andar e atravaessa a linha.<br><br><font face=/font/big_bold.font>Inicia o movimento ao usares o acelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Agora o camião está pronto para andar para a frente. Começa a andar e atravaessa a linha.<br><br><font face=/font/big_bold.font>Inicia o movimento ao usares o acelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Agora o camião está pronto para andar para a frente. Começa a andar e atravaessa a linha.<br><br><font face=/font/big_bold.font>Tira o pé do travão, liberta gradualmente o pé da embraiagem enquanto carregas no acelerador para manter as RPM em cima para que o camião não vá abaixo. Assim que libertares a embraiagem podes acelerar e trocar de mudanças conforme for necessário. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Usa o travão de pé para parares.<br><br><font face=/font/big_bold.font>Usa $input backward$ para parares o camião. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Usa o travão de serviço para parares.<br><br><font face=/font/big_bold.font>Usa $input backward$ para parares o camião. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Usa o travão de serviço para parares.<br><br><font face=/font/big_bold.font>Usa $input backward$ para parares o camião. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Quando for para parar, pressiona a embraiagem <font face=/font/big_bold.font>e depois pára o camião utilizando o travão de serviço.<color value=@@clr_txt@@>Coloca em ponto-morto utilizando a alavanca e depois podes largar a embraiagem. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Agora, trava o camião. O travão de estacionamento assegura que o camião não se moverá após estacionares.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ para activar o travão de estacionamento.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Com uma transmissão automática simplificada, não há necessidades de mudares de mudança, tudo é feito por ti.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_activate@@ para confirmar. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Coloca em ponto-morto, ao pressionares @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Coloca em ponto-morto, ao pressionares @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Coloca em ponto-morto, depois liberta a embraiagem. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Agora sabes como colocar o camião em andamento e como o parar em segurança.<br><br><font face=/font/big_bold.font>Pressiona $input engineelect$ para desligar o motor. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "A Andar em Marcha-atrás"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Neste desafio, iremos experimentar andar em marcha-atrás pela primeira vez. Vamos falar de como utilizar os espelhos, o que ter em conta e como preparar esta manobra."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "A Ligar o Motor"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "A Verificar o Espelho do Lado do Passageiro"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "A Verificar o Espelho do Lado do Condutor"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "A Mudar de Marcha"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "A Libertar o Travão de Estacionamento"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "A Mudar para Ponto-morto"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "A Desligar o Motor"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Para esta viagem, iremos andar em marcha-atrás em linha recta. Tens que andar em marcha-atrás para lá da linha tracejada e parar aí."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Ao andar para trás com o camião, é essencial verificar constantemente os espelhos e assegurares-te de que o espaço à volta e atrás está livre."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Liga o motor, engata a marcha-atrás e começa a andar."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Retrocede para lá da linha tracejada, desliga o motor e segura o camião."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Prepara o camião para ser conduzido conforme aprendeste no desafio anterior.<br><br><font face=/font/big_bold.font>Quando estiveres pronto, liga o motor. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Verifica os espelhos para te assegurares de que a área à tua volta está livre. Podese sempre ajustar os espelhos em '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Olha pelo espelho do lado do passageiro.</font>@@aca_goal_tip@@ Tens de estar dentro do veículo."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Vais passar para lá da linha tracejada. Agora a via está desimpedida mas durante a condução é essencial verificares o espaço à tua volta utilizando os espelhos.<br><br><font face=/font/big_bold.font>Verifica o espelho do lado do condutor.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Utiliza $input backward$ para engatar a marcha-atrás. </font>@@aca_goal_tip@@ Quando em marcha-atrás, o som de recuo activa-se automaticamente na maioria dos camiões. Podes desactivá-lo no Ecrã de Opções - \"Áudio\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Pressiona @@imv_nrm_geardown@@ para engatar a marcha-atrás. </font>@@aca_goal_tip@@ Quando em marcha-atrás, o som de recuo activa-se automaticamente na maioria dos camiões. Podes desactivá-lo no Ecrã de Opções - \"Áudio\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Pressiona @@imv_nrm_geardown@@ para engatar a marcha-atrás. </font>@@aca_goal_tip@@ Quando em marcha-atrás, o som de recuo activa-se automaticamente na maioria dos camiões. Podes desactivá-lo no Ecrã de Opções - \"Áudio\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Pressiona a embraiagem e mexe a alavanca para engatar a marcha-atrás. </font>@@aca_goal_tip@@ Quando em marcha-atrás, o som de recuo activa-se automaticamente na maioria dos camiões. Podes desactivá-lo no Ecrã de Opções - \"Áudio\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Engataste a marcha-atrás.<br><br><font face=/font/big_bold.font>Liberta o travão de estacionamento utilizando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Começa a mover-te utilizando $input backward$.<br><br><font face=/font/big_bold.font>Retrocede para lá da linha tracejada. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Começa a mover-te utilizando o acelerador: $input forward$.<br><br><font face=/font/big_bold.font>Retrocede para lá da linha tracejada. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Começa a mover-te utilizando o acelerador: $input forward$.<br><br><font face=/font/big_bold.font>Retrocede para lá da linha tracejada. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Liberta a embraiagem devagar enquanto manténs as RPM utilizando o acelerador. <br><br><font face=/font/big_bold.font>Retrocede para lá da linha tracejada. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Pára o camião utilizando o travão de serviço: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Pára o camião utilizando o travão de serviço: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Pára o camião utilizando o travão de serviço: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Pressiona a embraiagem e depois pára o camião utilizando o travão de serviço. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Activa o travão de estacionamento utilizando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Com uma transmissão automática simplificada, não há necessidades de mudares de mudança, tudo é feito por ti.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_activate@@ para confirmar. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Coloca em ponto-morto e liberta a embraiagem.</font>@@aca_goal_tip@@ Os camiões modernos colocam-se automaticamente em ponto-morto ao aplicar o travão de mão. No entanto, é um bom hábito sermos nós a fazê-lo. Nos desafios seguintes, não iremos precisar deste passo."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Coloca em ponto-morto e liberta a embraiagem.</font>@@aca_goal_tip@@ Os camiões modernos colocam-se automaticamente em ponto-morto ao aplicar o travão de mão. No entanto, é um bom hábito sermos nós a fazê-lo. Nos desafios seguintes, não iremos precisar deste passo."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Coloca em ponto-morto e liberta a embraiagem.</font>@@aca_goal_tip@@ Os camiões modernos colocam-se automaticamente em ponto-morto ao aplicar o travão de mão. No entanto, é um bom hábito sermos nós a fazê-lo. Nos desafios seguintes, não iremos precisar deste passo."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Lembra-te de estares sempre atento às tuas imediações enquanto retrocedes, especialmente em áreas com muito tráfego.<br><br><font face=/font/big_bold.font>Desliga o motor ao pressionar $input engineelect$. </font>"
#@}

