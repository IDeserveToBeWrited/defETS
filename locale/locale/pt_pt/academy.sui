#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Para o desafio final deste capítulo, vamos conduzir na pista de testes com uma configuração complexa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "O primeiro obstáculo é um slalom através de algumas barreiras. Conduz através delas e lembra-te de usares os espelhos."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "A seguir é uma curva fechada. Mantém o teu trajecto largo e não deverás ter problemas."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Há uma curva de 90 graus aqui. Lembra-te de conduzir até ao fim de maneira a que a traseira do camião passe dentro das barreiras."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "A rampa obstáculo pode ser complicada. Alinha-te o melhor que conseguires antes de conduzires sobre ela e usa os espelhos da frente e laterais para te ajudar a orientares."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "A próxima secção deve ser feita em marcha-atrás. Aproxima-te das barreiras à frente e tem isso em conta."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Segue as marcações da estrada atrás e para a tua direita."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Anda em marcha-atrás até às barreiras, pára e avança em frente para a esquerda."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Procede pelo espaço aberto no cruzamento para a próxima secção."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Esta passagem através dos cones é muito estreita. Conduz devagar e usa os espelhos para te orientares pela passagem."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Lembra-te de conduzir até ao fundo nas curvas de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Estás a entrar numa secção aberta de estrada. Podes ganhar alguma velocidade, mas tem em conta que precisas de abrandar para a curva mais à frente."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "No fim da descida há algumas barreiras ao longo da estrada. Conduz até elas, depois anda de marcha-atrás para o lugar de estacionamento à esquerda."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Anda de marcha-atrás até ao lugar de estacionamento."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Estaciona, desliga o motor e deixa o camião em segurança."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "À tua frente está um slalom de barreiras.<br><br><font face=/font/big_bold.font>Conduz através do slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Mantém-te da parte de fora da curva e garante que a traseira do tractor não passa por cima do passeio.<br><br><font face=/font/big_bold.font>Faz a curva. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Estás a chegar a uma curva à esquerda de 90 graus. Lembra-te de usar todo o espaço disponível.<br><br><font face=/font/big_bold.font>Faz a curva. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Alinha-te com a rampa. Não há muito espaço para correcções depois de estares na rampa.<br><br><font face=/font/big_bold.font>Conduz pela rampa. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Segue o curso para a esquerda. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "A seguinte secção deve ser feita em marcha-atrás. Pára nas barreiras maisà frente de maneira a que consigas andar para trás e para a direita.<br><br><font face=/font/big_bold.font>Pára nas barreiras. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Anda em marcha-atrás até à área atrás de ti e à direita. Há setas na estrada para te ajudarem.<br><br><font face=/font/big_bold.font>Anda de marcha-atrás para a próxima secção. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continua a andar em marcha-atrás até às barreiras atrás de ti.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Pára e muda para uma marcha à frente, depois continua para a esquerda. <br><br><font face=/font/big_bold.font>Conduz em frente. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Há um espaço no mediano à esquerda. Conduz através dele.<br><br><font face=/font/big_bold.font>Continua em frente. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "À tua frente está um caminho estreito através de alguns cones. Conduz com cuidado e usa os espelhos conforme necessário.<br><br><font face=/font/big_bold.font>Conduz através dos cones. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Conduz através dos cones.<br><br><font face=/font/big_bold.font>Vira à esquerda. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Lembra-te de te manteres à esquerda antes da curva para teres o maior espaço possível.<br><br><font face=/font/big_bold.font>Faz a curva. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continua a conduzir. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Podes ganhar alguma velocidade aqui, mas há uma curva mais à frente.<br><br><font face=/font/big_bold.font>Continua pelo percurso. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "A curva fica mais fechada à medida que passas por ela.<br><br><font face=/font/big_bold.font>Ajusta a tua velocidade e continua.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "No fundo da descida vais ver barreiras a bloquear a estrada. <br><br><font face=/font/big_bold.font>Pára junto das barreiras. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Atrás de ti à esquerda há um lugar de estacionamento.<br><br><font face=/font/big_bold.font>Anda em marcha--atrás até ao lugar de estacionamento. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Pára no lugar marcado. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
