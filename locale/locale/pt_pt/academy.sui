	val[]: "Siga em frente até ao final do lote e dê meia-volta."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Lembre-se de fazer uma curva larga."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Continue em frente até sentir que tem espaço suficiente para manobrar e depois comece a marcha-atrás."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Estacione de marcha-atrás se achar que tem espaço suficiente para manobrar."

