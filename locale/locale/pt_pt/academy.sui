#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Manobras de Condução Combinadas"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "Neste desafio, vamos combinar habilidades recentemente aprendidas para negociar um pequeno curso técnico que envolve retroceder numa curva com um ângulo de 90 graus."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Retroceder para o Lado do Condutor"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Curva de 90 Graus"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Concluir a Curva"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "À tua frente está uma barreira. Conduz até ela e pára."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Atrás do camião, no lado do condutor, está outra barreira. Retrocede à volta da curva até à barreira. As marcações da estrada podem servir de guia."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Sempre em frente há uma curva apertada de 90 graus. Conduz até lá."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Vamos ter que entrar na curva de maneira a que as rodas traseiras passem pelo cone na curva interior.<br>Usa os espelhos!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Endireita o camião, conduz em direcção às barreiras finais, pára e deixa o camião em segurança."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "O camião ainda não está pronto para partir, talvez te tenhas esquecido de alguma coisa?<br><br>O motor está ligado? Desengataste o travão de estacionamento?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "À tua frente está uma marcação mesmo junto à barreira.<br><br><font face=/font/big_bold.font>Conduz em frente e pára na marcação. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Olha pelo lado do condutor para trás; Vais ver outro sítio marcado. Tens de combinar a marcha-atrás com virar ao mesmo tempo.<br><br><font face=/font/big_bold.font>Retrocede pela curva e pára no sítio marcado. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "O percurso continua à tua frente através de um ângulo de 90 graus.<br><br>Mantém-te à esquerda antes da curva, entra na curva e vira rapidamente. Assegura-te que não bates no cone de trânsito interior<br><br><font face=/font/big_bold.font>Conduz em frente e faz a curva. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Usa o teu espelho lateral para garantir que não bates em nada.<br><br><font face=/font/big_bold.font>Completa a curva e pára na área marcada. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Desliga o motor e deixa o camião em segurança.</font>"
#@}

