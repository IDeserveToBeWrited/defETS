ont><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/time.mat width=22 height=22><offset vshift=2>@@aca_goal_time_limit@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_time_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/camera.mat width=22 height=22><offset vshift=2>@@aca_goal_exterior_drive@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_camera_desc@@</font></margin></align><br><offset vshift=15>"
#!}

#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFO DA PROFICIÊNCIA DE CONDUÇÃO DO CAMIÃO" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Requisitos de Conclusão"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Os desafios são concluídos ao atender a todas as condições de aprovação"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "As estrelas são ganhas ao completar condições de bónus"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Condições"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Número máximo de mudanças entre movimento para frente e para trás"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Tempo máximo permitido para concluir um desafio para uma determinada condição"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Uso exclusivo da câmera interna - câmeras externas ainda podem ser utilizadas enquanto estiverem paradas"

	key[]: "aca_book_book2_completed_t"
	val[]: "PROFICIÊNCIA DE CONDUÇÃO DO CAMIÃO CONCLUÍDA"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br><br>Você concluiu todas as condições de aprovação no módulo de Proficiência em Condução de Camiões e ganhou recompensas para o seu perfil de carreira. Você ainda pode se desafiar para obter mais recompensas concluindo todas as condições bónus.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "PROFICIÊNCIA DE CONDUÇÃO DO CAMIÃO COMPLETA"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br><br>Você concluiu todas as condições de aprovação e bónus no módulo Proficiência em Condução de Camiões e ganhou recompensas para o seu perfil de carreira.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Proeficiência da Condução do Camião"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Bem-vindo de volta à @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Os próximos desafios representam o próximo passo na tua jornada de camionista."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Desta vez, não o orientaremos em cada tarefa, então cabe a você colocar as suas habilidades e experiência em prática."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Você pode encontrar algumas manobras familiares, mas desta vez em novos ambientes feitos para parecer mais com cenários do mundo real."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Uma novidade para @@driving_academy@@ é a adição das condições \"Passou\" e \"Bónus\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Assim como antes, você ainda deve completar cada cenário sem bater em nada, estacionando com sucesso e colocando o camião em segurança..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...mas agora você também deve fazer isso no limite de tempo estipulado e com um limite no número de mudanças de direção entre a direcção para frente e para trás."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Condições de bónus podem ser atingidas ao completar cada cenário com condições ainda mais desafiadoras..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...como limites de tempo mais rigorosos, menos mudanças de direcção e uso exclusivo da câmera interna."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Ao completar todos os cenários, você pode-se considerar um camionista proficiente e pronto para o próximo desafio.<br><br>Para se desafiar ainda mais, complete todas as condições de bónus para cada cenário; então será uma estrela na direcção de camiões!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Neste cenário de tutorial, ajudaremos a familiarizar-se com os novos recursos encontrados na Proficiência de Condução de Camiões."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "No início de cada cenário, você verá uma janela <color value=@@clr_sel@@>\"Informações do Cenário\"<color value=@@clr_txt@@>. Ela fornecerá informações sobre as novas condições de Conclusão e Bónus para o cenário. <br><br>As condições de Conclusão devem ser cumpridas para concluir o cenário com sucesso, enquanto as condições de Bónus são um desafio extra opcional para jogadores experientes e habilidosos. <br><br><font face=/font/big_bold.font>Para continuar, ligue a ignição.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Uma das condições de bónus exige que você conclua o cenário usando a <color value=@@clr_sel@@>Câmera Interna<color value=@@clr_txt@@>. Você ainda pode usar as câmeras externas para verificar os arredores, mas apenas com o camião parado.<br><br>Agora você pode olhar ao redor para se orientar e, em seguida, voltar para a câmera interna.<br><br><font face=/font/big_bold.font>Alterne para a câmera de perseguição para verificar os arredores</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Oriente-se e depois volte para a câmera interna.<br><br><font face=/font/big_bold.font>Olhe ao redor do camião</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Mude para a câmera interior</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Tempo<color value=@@clr_txt@@> também será um fator na Proficiência em Condução de Camiões. Todos os cenários terão um limite de tempo individual, no qual o cenário deverá ser concluído como condição de Aprovação, e muitos também terão um limite adicional mais rigoroso como condição de Bónus.<br><br>O cronómetro só começa a contar após o camião ser movido.<br><br><font face=/font/big_bold.font>Ligue o motor e solte o travão de estacionamento para continuar.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Outra novidade para a Proficiência de Condução de Camiões são os pontos de referência. Todos os pontos de referência devem ser alcançados antes que um cenário possa ser concluído. <br><br>Além disso, os pontos de referência são sensíveis à direcção para a qual o camião está voltado ao chegar ao ponto de referência, portanto, preste atenção às marcações no solo próximas ao ponto de referência para se orientar corretamente. <br><br><font face=/font/big_bold.font>Conduza em frente até o ponto de referência à sua frente.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Você atingiu o ponto de referência e agora pode prosseguir para a próxima etapa. <br><br>Há outro ponto de referência atrás de você para o qual você deve efectuar marcha-atrás. Observe a seta no chão indicando para qual direcção o camião deve estar voltado ao chegar ao ponto de referência. <br><br>Outra condição de Conclusão e Bónus que deve ser considerada é <color value=@@clr_sel@@>Mudanças de Direcção<color value=@@clr_txt@@>. Contamos quantas vezes você muda de direcção entre conduzir para frente e em marcha-atrás. Mantenha-se abaixo do limite para completar a condição. <br><br><font face=/font/big_bold.font>Efectue marcha-atrás para o ponto de referência e pare.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Então, agora, você deve ter acumulado uma mudança de direcção. <br><br>Engate o reboque atrás de você para continuar para a próxima etapa. <br><br><font face=/font/big_bold.font>Efectue marcha-atrás sob o reboque para conectá-lo.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "A última área de estacionamento fica à sua direita. Alguns cenários podem ter apenas um lugar de estacionamento, enquanto outros terão várias para escolher. Estacionar corretamente em qualquer um dos lugares permitirá que você conclua o cenário. <br><br><font face=/font/big_bold.font> Pressione @@imv_nrm_attach@@ para engatar o reboque. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Os lugares de estacionamento também indicam a direcção que o camião deve seguir. Estacione na direcção errada e você não conseguirá completar o cenário até se corrigir, o que lhe custará tempo e mudanças de direção.<br><br><font face=/font/big_bold.font>Dirija até um dos lugares de estacionamento e estacione correctamente.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Proeficiência da Condução do Camião"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Agora você deve estar familiarizado com os novos parâmetros para Condições de Aprovação e Metas de Bónus e estar pronto para encarar os novos cenários em Proficiência de Condução de Camiões!<br><br><font face=/font/big_bold.font>Proteja o camião aplicando o travão de estacionamento e desligue o motor para completar o cenário.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Atalho"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "Neste cenário, você tentará usar um atalho que, infelizmente, está bloqueado no final. Você deverá então voltar pelo mesmo caminho de onde veio."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Conduza até ao ponto de referência no topo da colina e depois faça o mesmo caminho de volta para baixo. <br><br>De volta à estrada, conduza até à área de estacionamento final."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Madrugador"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "Neste cenário, você precisa de se movimentar por um estacionamento lotado. O espaço é extremamente limitado, então tente planear os seus movimentos com antecedência."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Às vezes, o estacionamento é tão limitado que outros motoristas estacionam onde podem durante a noite. Isso pode dificultar bastante a manobra pela manhã.<br><br> Faça o possível para atravessar o estacionamento até à última vaga."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Torcido"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "Neste cenário, você tem a tarefa de dirigir por um percurso de treino bastante complexo. Ao longo do caminho, você deve encontrar e conectar um reboque e levá-lo consigo até ao final."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Este cenário testará a sua noção espacial e situacional. O percurso à sua frente está cheio de obstáculos que você nem sempre conseguirá identificar facilmente."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Siga pelo percurso até ao reboque. Depois de localizá-lo, conecte-se a ele e puxe-o até ao lugar de estacionamento final."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Vertigem"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "Neste cenário, colocaremos as suas habilidades de direcção à prova. Conduza em círculos até chegar ao final!"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "É hora de testar as suas habilidades de manuseio de camiões; esta pista foi criada para ver o quanto você conhece o seu camião!"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
