#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Parar Perto de um Obstáculo"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Neste desafio, vamos falar do espelho da frente - a sua localização e como utilizá-lo para parar perto de um obstáculo à frente."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Verifica o Espelho Frontal"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Perceber a sua Função"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Parar Perto do Obstáculo"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Os camiões têm um grande ângulo morto à sua frente. É fácil perder um pedestre de vista ou mesmo um carro, por isso os camiões estão equipados com um espelho frontal que pode ser visto através do pára-brisas."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "O espelho da frente é desenhado para dar ao condutor uma visão deste ângulo morto<br>É uma ferramenta essencial para assegurar que não colidimos com nenhum obstáculo ao manobrar em espaço apertados."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Começa a conduzir, avança até à barreira à tua frente, abranda ao aproximar-te da barreira.<br>Mantém um olho no espelho da frente."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Pára entre a linha e o obstáculo."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Neste desafio, vamos aprender a usar o espelho da frente conforme mostrado no diagrama.<br><br><font face=/font/big_bold.font>Olha pela parte superior do pára-brisas para o veres.</font>@@aca_goal_tip@@ Tens de estar dentro do veículo."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "O espelho frontal permite-te ver o ângulo morto à frente do camião. Pode ajudar-te a seres seguro e preciso na tua condução.<br><br>Se não estás satisfeito com o ajuste, abre '@@adjust_link_t@@' (pode ser acedido a partir do menu de pausa) para ajustar o espelho.<br><br><font face=/font/big_bold.font>Pressiona @@imv_nrm_activate@@ para continuar. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "À frente do camião há um sítio marcado. Vais notar que existe um obstáculo no outro lado desse sítio; quando estiveres perto dele, conduz devagar e verifica a distância para o obstáculo no espelho frontal.<br><br><font face=/font/big_bold.font>Prepara-te para partir. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "O camião ainda não está pronto para partir, talvez te tenhas esquecido de alguma coisa?<br><br>O motor está ligado? Desengataste o travão de estacionamento?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Conduz até ao lugar de estacionamento. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Pára a frente do camião entre o obstáculo e a marcação pintada na estrada. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

