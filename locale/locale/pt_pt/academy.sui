	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ não substitui o treino num veículo real.</font><br><br> <color value=@@clr_txt@@>Recomendamos que procures instrução numa instituição creditada em camiões antes de operares um camião na vida real.<br><br>Instituições de treino interessadas em usufruir da @@driving_academy@@ para treino suplementar devem contactar-nos em academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Básicos da Condução do Camião"

	key[]: "aca_book_book1_desc"
	val[]: "Aprende os básicos da condução de um camião, desde funções e controlos básicos a manoborar com um reboque."

	key[]: "aca_book_book2_title"
