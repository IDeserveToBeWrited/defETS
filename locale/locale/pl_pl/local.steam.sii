#!}
#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "WYBIERZ TRYB MAPOWANIA WEJŚCIA STEAM" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Przedstawiamy nowy <color value=@@clr_sel@@>tryb mapowania w grze<color value=@@clr_txt@@>, który obsługuje pełne konfiguracje przypisań klawiszy w grze i lepsze podpowiedzi do przycisków. Jest to zalecany tryb.<br><br>Zachowaj <color value=@@clr_sel@@>tryb mapowania klienta Steam<color value=@@clr_txt@@>, jeśli dostosowałeś układ gamepada za pomocą klienta Steam.<br><br>Możesz w dowolnym momencie zmienić tryb w opcjach, korzystając z kreatora wprowadzania." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Zachowaj tryb klienta Steam" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Otwórz kreatora wprowadzania danych" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Tryb mapowania wejścia Steam" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Przypisania w grze" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Przypisania w klience Steam" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Wybiera tryb dla gamepadów takich jak @@controller_ps5@@, @@controller_xbox_one@@ lub @@controller_steam_deck@@ włączonych do interfejsu wyjściowego Steam:<br>- „Mapowanie klienta Steam” — korzystanie z samodzielnych układów skonfigurowanych za pomocą klienta Steam. Ograniczone wsparcie dla wskazówek dotyczących przycisków w grze i brak konfiguracji powiązań w grze.<br>- „Mapowanie w grze” — korzystanie z uniwersalnego prostego układu. Obsługuje pełne konfiguracje powiązań klawiszy w grze i lepsze wskazówki dotyczące przycisków. Zaleca się uruchomienie kreatora wprowadzania podczas przełączania się na ten tryb. Jest to zalecany tryb."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Kontroler Steam"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Kontroler wejściowy Steam"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Synchronizacja z chmurą Steam:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Używasz starszej wersji gry.<br>Steam automatycznie zaktualizuje grę, chyba że automatyczne aktualizacje są wyłączone."
#@}

	key[]: "steam_demo"
	val[]: "Jeżeli spodobało ci się demo Euro Truck Simulator 2, proszę kup pełną wersję na <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 nie może uzyskać połączenia z klientem Steam. Sugerowane czynności:\n\n1. Sprawdź czy klient Steam jest uruchomiony.\n2. Sprawdź czy posiadasz aktualną wersję klienta Steam.\n3. Sprawdź czy włączone są automatyczne aktualizacje oraz czy gra została zaktualizowana do najnowszej wersji."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Część aktualnie zainstalowanej zawartości do pobrania nie jest zgodna z aktualną wersją gry i zostanie wyłączona. Sprawdź integralność pamięci podręcznej gry na Steamie.<br><br>Następująca zawartość jest niezgodna:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Nie można utworzyć profilu Steam z podaną nazwą, ponieważ istnieje już profil o tej nazwie." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Nie można przenieść profilu, inny profil o tej samej nazwie już istnieje." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Migracja profilu nie powiodła się." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Synchronizacja z chmurą Steam" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "Twój chmura Steam ma wystarczającą ilość miejsca na Twoje zapisy stanu gry." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Kończy Ci się miejsce w chmurze Steam!<color value=@@clr_txt@@><br><br>Usuń niektóre pliki zapisu, aby kontynuować. Oto kilka informacji, które mogą Ci pomóc:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Przekroczona ilość miejsca: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Przekroczona liczba plików: <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Użyta przestrzeń w chmurze Steam: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Pliki w chmurze Steam: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "Wybrany plik <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> ma <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@> w <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>plikach." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Skończyło Ci się miejsce w chmurze Steam. Usuń niektóre pliki zapisu, aby kontynuować.<br><br>Przeczytaj szczegółowe informacje w prawym panelu." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Dzięki migracji do lokalnego typu profilu ten profil będzie od teraz dostępny tylko na tym komputerze, niezależnie od zalogowanego konta Steam. " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Migracja profilu nie powiodła się. Dane nie zostały przeniesione, a system zachował oryginalny profil w stanie nienaruszonym. Spróbuj ponownie." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

