#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Jazda przez skomplikowane zakręty"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "W tym scenariuszu czeka nas manewrowanie z naczepą przez krótki tor z przeszkodami zawierający bardziej skomplikowane zakręty."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Pierwsze zakręty"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Jazda przez wąski korytarz"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Ciasny zakręt 90°"
