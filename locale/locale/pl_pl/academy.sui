#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "W ostatnim scenariuszu tego rozdziału przejedziemy przez tor testowy ze skomplikowanym układem przeszkód."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Pierwszą przeszkodą jest slalom przez barierki. Przejedź, pamiętając o używaniu lusterek."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Następny jest ostry zakręt typu „agrafka”. Trzymaj swój zakręt szeroko, a nie powinno to sprawić Ci żadnych problemów."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Zbliżasz się do zakrętu 90°. Pamiętaj, aby podjechać trochę dalej, żeby nie zahaczyć ciężarówką o bariery."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Podczas tego zadania będziesz się musiał skupić. Przed ruszeniem ustaw się, najlepiej jak możesz, wspomagając się lusterkami zewnętrznymi pojazdu."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Podczas następnej części będziesz musiał cofać. Miej to na względzie, zbliżając się do barier."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Trzymaj się oznaczeń na asfalcie z tyłu i po prawej stronie."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Wycofaj do barier, następnie się zatrzymaj i kontynuuj w do przodu, po czym w lewo."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Użyj przejazdu między jezdniami, aby dojechać do następnej części."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Przejazd między pachołkami jest bardzo wąski. Jedź powoli i używaj lusterek, by orientować się wewnątrz korytarza."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Pamiętaj, żeby podjeżdżać trochę dalej, wykonując zakręty 90°."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Wjechałeś na prosty odcinek drogi. Możesz teraz przyspieszyć. Pamiętaj jednak, że wkrótce będziesz musiał zwolnić przed zakrętem."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Na dole zjazdu znajdują się bariery na drodze. Dojedź do nich, a następnie wycofaj w miejsce parkingowe po lewej stronie."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Wycofaj na miejsce parkingowe."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Zaparkuj, wyłącz silnik i zabezpiecz ciężarówkę."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Zbliżasz się do slalomu zbudowanego z barier.<br><br><font face=/font/big_bold.font>Przejedź przez slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Trzymaj się zewnętrznej strony zakrętu, aby mieć pewność, że ciężarówka nie najedzie na krawężnik.<br><br><font face=/font/big_bold.font>Wykonaj skręt.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Zbliżasz się do zakrętu 90° w lewo. Pamiętaj, aby w pełni wykorzystać dostępną przestrzeń.<br><br><font face=/font/big_bold.font>Pokonaj zakręt. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Ustaw się równolegle z rampą. Najechawszy, nie będziesz miał dużego pola do manewru.<br><br><font face=/font/big_bold.font>Wjedź na rampę.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Podążaj w lewo.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Następna część wymaga cofania. Zatrzymaj się przed barierami tak, abyś mógł później wycofać w prawą stronę.<br><br><font face=/font/big_bold.font>Zatrzymaj się przed barierami.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Wycofaj w kierunku prawej strony. Strzałki umieszczone na drodze pomogą Ci w orientacji.<br><br><font face=/font/big_bold.font>Wycofaj w kierunku kolejnej części.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Kontynuuj cofanie w kierunku barier za Tobą.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zatrzymaj się i wrzuć bieg do jazdy w przód. Następnie podążaj w lewo. <br><br><font face=/font/big_bold.font>Jedź prosto. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Z lewej strony znajduje się przejazd między jezdniami. Użyj go.<br><br><font face=/font/big_bold.font>Jedź dalej prosto. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Przed Tobą znajduje się kręta droga między pachołkami. Jedź ostrożnie, używając lusterek w razie potrzeby.<br><br><font face=/font/big_bold.font>Jedź między pachołkami. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Kontynuuj jazdę.<br><br><font face=/font/big_bold.font>Skręć w lewo. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Pamiętaj, aby trzymać się lewej strony, by dać sobie tyle miejsca ile potrzeba.<br><br><font face=/font/big_bold.font>Pokonaj zakręt.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Możesz teraz nabrać prędkości. Zważ jednak na nadchodzący zakręt.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Zakręt robi się ciaśniejszy w miarę pokonywania.<br><br><font face=/font/big_bold.font>Dostosuj swoją prędkość i jedź dalej.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na dole zjazdu znajdują się bariery na drodze. <br><br><font face=/font/big_bold.font>Zatrzymaj się przy barierach. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Za Tobą z lewej strony znajduje się miejsce parkingowe.<br><br><font face=/font/big_bold.font>Wycofaj w to miejsce. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj się na oznaczonym miejscu. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Jazda po torze testowym"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "W tym scenariuszu przejedziesz się po torze, zaprojektowanym, by sprawdzić Twoje umiejętności pokonywania różnych zakrętów i narożników."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Wjazd na tor"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Wykonywanie stopniowego zakrętu w lewo"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Jazda po śladzie S"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Prosty odcinek"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Łatwe zakręty"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Wyjazd z toru treningowego"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Zbliżanie się do miejsca parkingowego"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

