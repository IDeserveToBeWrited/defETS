	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "W tym scenariuszu przejdziemy przez zawracanie na „martwą stronę” w ciasnej przestrzeni. Ta umiejętność okaże się przydatna, gdy nie możesz wykonać manewru zawracania lub cofania na stronę kierowcy."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Oznaczenia na drodze ułatwią Ci poruszanie się po trasie szkolenia."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Wykonaj szeroki skręt, aby mieć pewność, że Twoja naczepa ominie zaparkowane ciężarówki."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Wychodząc z zakrętu, zastanów się nad tym, jak ustawisz ciężarówkę, aby wykonać manewr cofania."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Pomocne będzie ustawienie ciężarówki pod kątem, tak aby była skierowana w stronę pustego miejsca parkingowego po stronie pasażera, na które będziesz cofać."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Należy unikać cofania na „martwą stronę”, jeśli to możliwe, ponieważ widoczność jest znacznie ograniczona. Niestety, zdarzają się sytuacje, gdy nie masz innego wyjścia, jak to zrobić."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Obróć kierownicę przed cofaniem. Pomoże to natychmiast ustawić naczepę tam, gdzie chcesz, co jest pomocne w bardzo ciasnych sytuacjach."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Gdy naczepa znajdzie się już na swoim miejscu, ustaw ciężarówkę przed naczepą i wyprostuj ją."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Zatrzymaj się, gdy już się wyprostujesz i będziesz mieć wystarczająco dużo miejsca, aby znów ruszyć do przodu. Zacznij wracać tą samą drogą, którą wjechałeś."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Jedź wzdłuż linii do wyjazdu z toru treningowego."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Jedź przez łuk i kontynuuj do wyznaczonego obszaru."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Zatrzymywanie się."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Zabezpiecz ciężarówkę i wyłącz silnik."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Na obszarze przed Tobą znajduje się trasa szkoleniowa reprezentująca teren firmy spedycyjnej. Twoim zadaniem jest wjazd na teren i zawrócenie ciężarówki, aby wyjechać. Upewnij się, że dobrze wykorzystasz przestrzeń wokół siebie.<br><br><font face=/font/big_bold.font>Przygotuj się do jazdy.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Kontynuuj w kierunku toru treningowego. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Pokonaj zakręt i kontynuuj przez tor. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Podążaj za oznaczeniami na drodze do bariery na końcu toru. Zaparkuj nieco pod kątem, tak by naczepa celowała w kierunku pustego miejsca parkingowego po stronie pasażera.<br><br><font face=/font/big_bold.font>Kontynuuj przed siebie. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Masz o wiele bardziej ograniczony widok na to, co dzieje się po stronie pasażera. Jedź powoli, używając lusterek i ostrożnie skręcaj.<br><br><font face=/font/big_bold.font>Zacznij cofać i skieruj naczepę na puste miejsce parkingowe. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Tyle wystarczy. Możesz teraz kontynuować prosto i wyjechać z placu treningowego tą samą drogą, którą przyjechałeś.<br><br><font face=/font/big_bold.font>Zacznij kierować się do wyjazdu. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Wyjedź z toru treningowego. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Jedź zgodnie z oznaczeniami na drodze do ostatniego miejsca parkingowego.<br><br><font face=/font/big_bold.font>Kontynuuj do wyznaczonego obszaru. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

