	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Takie skośne miejsca parkingowe są bardzo powszechne, szczególnie na wielu parkingach wzdłuż europejskich autostrad. <br>Po raz kolejny będziemy musieli wjechać na miejsce parkingowe przed nami."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Jedź w kierunku wyznaczonego miejsca parkingowego przy końcu szeregu."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Pozostań na środku pasa lub lekko po stronie kierowcy. Nie jedź zbyt blisko barier, gdyż tył naczepy może o nie uderzyć przy skręcaniu."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Przejedź kawałek obok miejsca parkingowego, a następnie mocno i szybko skręć w jego kierunku. Musisz obserwować oba lusterka boczne: lusterko kierowcy, aby upewnić się, że przód naczepy nie uderzy w naczepę obok Ciebie oraz lusterko pasażera, aby upewnić się, że naczepa bezpiecznie wjeżdża na miejsce parkingowe."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Zatrzymaj się w wyznaczonym obszarze, zabezpiecz ciężarówkę i wyłącz silnik."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Parkując po skosie, ważne jest, aby dokładnie ocenić swoją pozycję. Gdy jesteś już w połowie zakrętu, trudno jest bezpiecznie cofnąć i zmienić pozycję, więc najlepiej jest upewnić się, że masz wystarczająco dużo miejsca przy pierwszej próbie.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Rozpocznij jazdę w kierunku miejsca parkingowego.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Przejedź obok miejsca parkingowego, aby naczepa miała miejsce objechać ciężarówkę po Twojej wewnętrznej.<br><br><font face=/font/big_bold.font>Skręć na miejsce parkingowe. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Cofanie na martwą stronę"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "W tym scenariuszu przyjrzymy się cofaniu na „martwą stronę” na miejsce parkingowe. Bez możliwości wychylenia się przez okno, by sprawdzić, gdzie jedziesz, będziesz musiał polegać jedynie na lusterkach, by dotrzeć tam, gdzie potrzebujesz."

