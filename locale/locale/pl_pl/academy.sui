	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br><br>Spełniłeś wszystkie warunki zaliczenia w module biegłości w jeździe ciężarówką i zdobyłeś nagrody w swoim profilu kariery. Nadal możesz rzucić sobie wyzwanie, aby zdobyć więcej nagród, spełniając wszystkie warunki bonusowe.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "BIEGŁOŚĆ W JEŹDZIE CIĘŻARÓWKĄ – UKOŃCZONA"

