	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Pamiętaj, aby natychmiast skręcać, gdyż nie ma tu dużo miejsca.<br><br><font face=/font/big_bold.font>Wycofaj na wyznaczone miejsce z tyłu. </font>"


#@}

#+ Book 1 Scenario 3_15
