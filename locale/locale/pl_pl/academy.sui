#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Witaj w pierwszej części egzaminu końcowego. Tutaj sprawdzimy, jak dobrze nauczyłeś się kierować ciężarówką, po czasie spędzonym w Akademii."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Najpierw podczep naczepę. Następnie będziesz jeździć ciężarówką po całym obszarze testowym."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Pierwszy odcinek trasy prowadzi z małego placu parkingowego do wschodniej trasy testowej."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Trasa zawiera wymagające przejazdy pomiędzy barierami."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Znaczna część trasy przebiega przez wschodni tor testowy."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Przetestujemy Twoje umiejętności manewrowania ciężarówką w trudnych sytuacjach."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Będziesz manewrować ciężarówką przez ostre zakręty."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Przejedziesz odcinkiem drogi łączącym tory."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Pierwsza część dotyczy jazdy przez mały tor."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Tor ma wiele złożonych korytarzy i ostrych zakrętów."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "By zakończyć test, będziesz musiał zaparkować dokładnie."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nie ma powodu do obaw. Nauczyłeś się już wszystkiego, czego potrzebujesz na zaliczenie.<br><br>Powodzenia!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Przed Tobą znajduje się naczepa.<br><br><font face=/font/big_bold.font>Jedź w jej kierunku.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Wyrównaj ciężarówkę względem naczepy.<br><br><font face=/font/big_bold.font>Wycofaj i połącz się z mocowaniem.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zabezpiecz ciężarówkę. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Naciśnij @@imv_nrm_attach@@, aby podczepić naczepę. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Naczepa jest podłączona, a ciężarówka jest gotowa do jazdy.<br><br><font face=/font/big_bold.font>Zwolnij hamulec ręczny. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Rozpocznij jazdę w kierunku wyjazdu z placu parkingowego. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Jedź zgodnie z oznaczeniami na drodze i uważaj na bariery.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Bardziej wymagająca sekcja na horyzoncie.<br><br><font face=/font/big_bold.font>Ostrożnie nawiguj pomiędzy barierami.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Ta część przetestuje Twoje umiejętności manewrowania naczepą na różnych rodzajach zakrętów.<br><br><font face=/font/big_bold.font>Skręć na tor.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Przejedź przez korytarz.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Jedź prosto. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Ostrożnie nawiguj przez zakręt. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Wjeżdżasz na bardziej skomplikowaną sekcję. Jedź ostrożnie.<br><br><font face=/font/big_bold.font>Kontynuuj zjazd ze wzniesienia. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Wykonaj ostry skręt w lewo. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Wyjedź z toru. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Wjeżdżasz na łatwiejszą sekcję.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę ze wzniesienia. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę drogą. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Przed Tobą znajduje się skręt na następny tor.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Skręć w prawo.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę po torze. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Przed Tobą więcej ostrych zakrętów.<br><br><font face=/font/big_bold.font>Dostosuj prędkość. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Wykonaj skręt w lewo.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Wejdź w zakręt, kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Aby wykonać zakręt, być może musisz trochę zjechać z asfaltu.<br><br><font face=/font/big_bold.font>Skręć ostrożnie, używając tyle miejsca, ile potrzebujesz. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Wyjedź z toru i wjedź na miejsce parkingowe. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

