#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Witamy w @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Poniższe scenariusze przedstawiają pierwszy krok w drodze do zostania zawodowym kierowcą ciężarówki."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Tutaj nauczysz się wszystkiego od podstawowych systemów i sterowania ciężarówką..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...aż po skomplikowane manewry zarówno z, jak i bez naczepy."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Pomożemy Ci wyrobić nawyki, które pomogą w bezpiecznym poruszaniu się w różnych sytuacjach"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "i nauczysz się, jak mądrze wykorzystywać dostępną przestrzeń, by skutecznie manewrować ciężarówką."

	key[]: "aca_msg_book1_intro_cutscene07"
