#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Podstawowe sterowanie i ruch"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Naucz się podstawowego kierowania pojazdem oraz jak ruszyć ciężarówką w przód i w tył."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 1: @@aca_chapter_book1_1_title@@.<br><br>Nauczyłeś się, jak przygotować ciężarówkę do jazdy,<br>jak jeździć do przodu i do tyłu oraz jak korzystać ze świateł i wycieraczek.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Podstawowe manewry"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Naucz się kierować, manewrować i parkować ciężarówką. Poznaj przeznaczenie każdego typu lusterka i jak ich używać."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 2: @@aca_chapter_book1_2_title@@.<br><br>Nauczyłeś się, jak korzystać z każdego lusterka w ciężarówce, jak sprawdzić przestrzeń wokół ciężarówki przed ruszeniem oraz wykonywać podstawowe i zaawansowane manewry.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manewrowanie z naczepą"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Naucz się podczepiać naczepę i manewrować z nią w różnych sytuacjach."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 3: @@aca_chapter_book1_3_title@@.<br><br>Nauczyłeś się podczepiać i odczepiać naczepę,<br>czuć ciężar i wymiary ciężarówki z naczepą<br>oraz jeździć po trudnych trasach z naczepą.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Cofanie z naczepą"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Poznaj nowe manewry pozwalające skutecznie cofać i parkować z naczepą."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 4: @@aca_chapter_book1_4_title@@.<br><br>Nauczyłeś się cofania z naczepą<br>oraz różnych technik parkowania.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Egzamin końcowy"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Wykaż się wiedzą i umiejętnościami, aby udowodnić swoją wartość jako kierowca ciężarówki!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 5: @@aca_chapter_book1_5_title@@.<br><br>Udowodniłeś, że posiadasz wszystkie niezbędne umiejętności prowadzenia,<br>manewrowania i parkowania ciężarówki!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Rozgrzewanie silnika"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Ukończyłeś szkolenie: @@aca_chapter_book2_0_title@@.<br><br>Poznałeś zasady i cechy umiejętności prowadzenia pojazdu.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Powrót do biegu"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 2: @@aca_chapter_book2_1_title@@.<br><br>Rozgrzałeś silnik, przetestowałeś biegi, prawidłowo zakręciłeś kołami i sprawdziłeś skuteczność hamulców. Następne rozdziały będą bardziej wymagające.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Koła w ruchu"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 3: @@aca_chapter_book2_2_title@@.<br><br>Opanowałeś trudne i zróżnicowane scenariusze. Wykazałeś się umiejętnościami i wydajnością.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Ostatnia prosta"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś rozdział 4: @@aca_chapter_book2_3_title@@.<br><br>Poradziłeś sobie z wieloma trudnymi sytuacjami podczas manewrowania, parkowania i cofania z naczepą. Udowodniłeś, że jesteś wykwalifikowanym kierowcą, zdolnym do radzenia sobie ze wszystkimi trudnymi sytuacjami podczas jazdy ciężarówką."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Idąc naprzód"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Poznaj wszystkie kluczowe techniki prowadzenia zestawów z dwiema naczepami podczas jazdy do przodu."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś Rozdział 1: @@aca_chapter_book3_1_title@@.<br><br>Doświadczyłeś, jak efektywnie prowadzić i manewrować podwójnymi naczepami.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Sterowanie odwrotne"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Zrozum kroki niezbędne do manewrowania zestawem z dwiema naczepami podczas cofania."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś Rozdział 2: @@aca_chapter_book3_2_title@@.<br><br>Opanowałeś trudną sztukę cofania z podwójnymi naczepami.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Przygotowanie do świata rzeczywistego"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Zastosuj nową wiedzę w bardziej zaawansowanych scenariuszach."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br>Ukończyłeś Rozdział 3: @@aca_chapter_book3_3_title@@.<br><br>Poradziłeś sobie z wieloma trudnymi sytuacjami podczas manewrowania, parkowania i cofania z podwójnymi naczepami. Udowodniłeś tutaj swoje umiejętności, teraz nadszedł czas, aby pociągnąć „dwójki” na drogach Euro Truck Simulator 2!</font><br><br>"


