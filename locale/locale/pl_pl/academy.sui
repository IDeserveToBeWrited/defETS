	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parkowanie tyłem obok przeszkody"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "W tym scenariuszu cofniemy ciężarówkę na miejsce parkingowe przy krawężniku."

