#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Piaskownica cofania"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "W tym scenariuszu trafisz na pusty parking, aby poćwiczyć cofanie zestawem z dwiema naczepami."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Pierwsze kroki"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperymentowanie"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Wykańczanie"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Zakończenie scenariusza"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Cofanie zestawem z dwiema naczepami wymaga znacznie więcej uwagi niż z jedną naczepą. Musisz planować z wyprzedzeniem, gdzie ma się znaleźć tylna naczepa, jednocześnie zachowując kontrolę nad naczepą prowadzącą i ciężarówką.<br><br>Pomyśl o tym w ten sposób – musisz użyć naczepy prowadzącej do sterowania tylną naczepą."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "W tym przypadku chcemy skierować tylną naczepę w stronę kierowcy. Aby tak nią sterować, musimy wypchnąć przód tylnej naczepy w stronę pasażera.<br><br>Zauważ, że w praktyce oznacza to, iż musisz skręcać pierwszą naczepą w kierunku przeciwnym do tego, w którym chcesz prowadzić tylną naczepę."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Gdy tylna naczepa zacznie skręcać, kluczowe jest wyprostowanie ciężarówki względem pierwszej naczepy. To właśnie w tym momencie większość osób popełnia swój pierwszy błąd."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Tutaj widzimy, że kierowca nie podążył za pierwszą naczepą i za chwilę doprowadzi do „złożenia się” zestawu."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Zjawisko „scyzoryka” występuje, gdy kąt między dowolnymi dwoma pojazdami w zestawie zbliża się do 90 stopni. Gdy to nastąpi, nie da się już tego skorygować – musisz podjechać do przodu i spróbować ponownie. <br><br> Podobnie jak przy cofaniu z jedną naczepą, celem powinno być zawsze zapewnienie, aby wszystkie koła naczep były w ruchu. Gdy koła się zatrzymają, a naczepa obraca się w miejscu, nie można kontynuować manewru."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Możesz podjechać do przodu do miejsca, w którym ostatnio byłeś w poprawnej pozycji, a raczej do punktu, z którego będziesz mógł kontynuować cofanie bez ponownego popełnienia tego samego błędu. <br><br>W tym przypadku podjedziemy do przodu do pozycji wyprostowanej i spróbujemy ponownie od początku."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Po raz kolejny, gdy tylna naczepa zacznie skręcać, ustaw ciężarówkę przed pierwszą naczepą i pozwól tylnej naczepie przez chwilę skręcać samoczynnie."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Teraz, gdy tylna naczepa zaczyna skręcać tam, gdzie chcemy, nadszedł czas, aby skierować pierwszą naczepę tak, by za nią podążyła. Możesz regulować kąt między pierwszą a tylną naczepą, aby kontrolować skręt i uczynić go ciaśniejszym lub szerszym."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Ostatnim etapem manewru jest wyprostowanie wszystkiego. Ustaw pierwszą naczepę w jednej linii z tylną."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Powinieneś pamiętać o czasie potrzebnym na przemieszczenie pierwszej naczepy – jeśli będziesz czekać zbyt długo, tylna naczepa zacznie wracać tam, skąd właśnie przyjechałeś!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Możesz spędzić tutaj tyle czasu, ile chcesz, eksperymentując z różnymi manewrami, aż uznasz, że masz ogólne pojęcie o tym, jak operować naczepami podczas cofania. <br><br>Ale co najważniejsze, pamiętaj, aby dobrze się przy tym bawić!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Przygotuj się do ruszenia."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Wykorzystaj ten parking, aby wyczuć, jak prowadzi się zestaw z naczepami na biegu wstecznym. <br><br>@@aca_goal_tip@@ Dopiero zaczynasz przygodę z cofaniem naczepami? Rozważ ukończenie modułu „Podstawy jazdy ciężarówką”."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Poświęć na ćwiczenia tyle czasu, ile chcesz. <br><br>Gdy uznasz, że jesteś gotowy, możesz się zatrzymać i zabezpieczyć ciężarówkę, aby zakończyć scenariusz."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Wyłącz silnik, aby zakończyć scenariusz."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkowanie w wąskim miejscu"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "W tym scenariuszu Twoim zadaniem jest zaparkowanie zestawu z podwójnymi naczepami w wąskim miejscu."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Pierwsze kroki"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Ruszanie z miejsca"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Kontynuuj jazdę"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zatrzymywanie się"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Zabezpieczanie pojazdu"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Prowadzenie zestawu z podwójnymi naczepami może wydawać się onieśmielające, ale nie różni się ono znacząco od jazdy z jedną naczepą – musisz po prostu brać pod uwagę również tor jazdy tylnej naczepy!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Przed Tobą znajduje się ciasne miejsce parkingowe. Nie będziesz mieć wystarczająco dużo przestrzeni, aby idealnie się wyprostować przed wjazdem, więc musisz starannie zaplanować, jak zmieścić się tam z obiema naczepami."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Skręć natychmiast w stronę dalszej krawędzi miejsca parkingowego i pojedź znacznie dalej niż punkt, w którym zazwyczaj zacząłbyś skręcać."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Skoro tylna naczepa jest już na właściwym torze, możesz skierować się w stronę miejsca parkingowego; upewnij się tylko, że ponownie celujesz w jego dalszą krawędź, aby pomóc pierwszej naczepie wejść w zakręt."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Kontynuuj wjazd na miejsce parkingowe, a obie naczepy wjadą za Tobą i wyprostują się w miarę jazdy."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Zaparkuj w wyznaczonym miejscu i zabezpiecz ciężarówkę."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Przygotuj się do ruszenia."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Jedź przed siebie i wjedź w wąskie miejsce."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Kontynuuj jazdę."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Zatrzymaj się w wyznaczonym obszarze."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Zabezpiecz ciężarówkę i wyłącz silnik."
#@}


