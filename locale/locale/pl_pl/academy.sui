	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "To typowy parking dla ciężarówek. Kierowcy ciężarówek będą spotykać się z tego typu sytuacjami parkingowymi niemal codziennie w swojej karierze.<br>Parking tutaj wymaga manewru „parkingu w alejce”."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "To podobny manewr do poprzedniego scenariusza, ale będzie mniej miejsca, więc musisz odpowiednio planować swoje ruchy i uważać, by w nic nie uderzyć."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Ze względu na mniej miejsca, Twoje wyczucie czasu jest jeszcze ważniejsze. Skręć naczepą w odpowiednim momencie i obserwując koła, pilnuj, gdzie jedziesz. Zwracaj uwagę na kąt naczepy i pamiętaj, aby nie złamać się w scyzoryk."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Postaraj się trzymać blisko ciężarówki po stronie kierowcy. Dzięki temu naczepa ma więcej miejsca na manewr i nie musisz się martwić o ciężarówkę po stronie pasażera."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Gdy naczepa jest już na miejscu, ustaw ciężarówkę przed nią. Lepiej jest to zrobić wcześniej, niż podpowiada instynkt na pierwszy rzut oka. Możesz się zawsze poprawić podczas cofania na końcową pozycję."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Wyprostuj ciągnij i naczepę, po czym zatrzymaj się w wyznaczonym obszarze."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Zabezpiecz ciężarówkę i wyłącz silnik."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Teraz spróbujemy zawrócić naczepą na znacznie mniejszym obszarze, wykonując manewr „cofania w alejce”. <br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Sprawdź swoje otoczenie i patrz na miejsce parkingowe za Tobą.<br><br><font face=/font/big_bold.font>Zacznij cofać w kierunku miejsca parkingowego. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Skręć naczepą w miejsce parkingowe. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Egzamin końcowy (część 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Czeka Cię egzamin końcowy, w którym wszystkie poznane w poprzednich scenariuszach umiejętności zostaną wystawione na próbę. Przejedziemy się po całym ośrodku szkoleniowym, aby sprawdzić, jak dobrze opanowałeś sytuacje, z którymi się do tej pory spotkałeś.<br><br>Po ukończeniu wszystkich sekcji i manewrów będziesz o krok bliżej do nazywania siebie wykwalifikowanym kierowcą ciężarówki!"

