#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "W tym scenariuszu spróbujemy podłączyć i odłączyć naczepę po raz pierwszy. Przygotuj ciężarówkę do jazdy, a następnie cofnij pod naczepę za sobą."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Podczep naczepę, a następnie podjedź do przodu."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Zatrzymaj się w zaznaczonym obszarze."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Odłącz naczepę, podjedź do przodu."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Zaparkuj na miejscu parkingowym i zabezpiecz ciężarówkę."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "W tym scenariuszu omówimy procedury podłączania i odłączania ciężarówki i naczepy. Jest to uproszczona procedura w porównaniu z tym, z czym kierowca ciężarówki zetknie się w prawdziwym życiu. <br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Za ciężarówką znajduje się naczepa. Powoli cofaj pod naczepę, aż siodło uderzy w mocowanie naczepy. Obecnie ciężarówka jest prawidłowo ustawiona, więc nie ma potrzeby skręcania, wystarczy cofnąć prosto.<br><br><font face=/font/big_bold.font>Cofaj powoli, aż poczujesz połączenie. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Siodło jest sprzężone z mocowaniem naczepy.<br><br><font face=/font/big_bold.font>Zabezpiecz ciężarówkę zaciągając hamulec ręczny. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "W rzeczywistości sprzęg siodłowy automatycznie blokuje mocowanie naczepy – wówczas kierowca ciężarówki musiałby wysiąść z pojazdu, aby podnieść podpory i podłączyć przewody pneumatyczne i elektryczne. <br><br><font face=/font/big_bold.font>W naszym przypadku podłączenie naczepy nastąpi po prostu poprzez naciśnięcie @@imv_nrm_attach@@. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Teraz, gdy ciężarówka jest bezpiecznie sprzężona z naczepą, możesz ruszyć do przodu. Pamiętaj, że Twój pojazd jest teraz znacznie dłuższy i cięższy, a jego obsługa będzie wymagała nowych umiejętności. <br><br><font face=/font/big_bold.font>Zwolnij hamulec ręczny i przygotuj się do jazdy do przodu. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Jedź do przodu.<br><br><font face=/font/big_bold.font>Zatrzymaj się w wyznaczonym miejscu.</font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Zaciągnij hamulec ręczny. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aktywuj hamulec ręczny. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "W rzeczywistości kierowca ciężarówki musiałby ponownie wysiąść z pojazdu, opuścić podpory, odłączyć przewody pneumatyczne i elektryczne, a także zwolnić mechanizm blokujący sprzęg siodłowy. <br><br><font face=/font/big_bold.font>Uprościliśmy ten proces dla Ciebie, dlatego naciśnięcie @@imv_nrm_attach@@ spowoduje to odłączenie naczepy. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Zwolnij hamulec ręczny. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Wyprowadź ciężarówkę spod naczepy i jedź do przodu.<br><br><font face=/font/big_bold.font>Zatrzymaj się w wyznaczonym miejscu. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj się w wyznaczonym miejscu.</font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Hamowanie z naczepą"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "W tym scenariuszu wyczujesz jazdę i hamowanie z naczepą."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Ruszanie"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Jazda ze wzniesienia"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Osiągnięcie prędkości 60km/h (37mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Hamowanie"
#!{
