#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Zatrzymywanie się blisko przeszkody"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "W tym scenariuszu omówimy lusterko przednie – jego lokalizację i sposób jego efektywnego wykorzystania, aby zatrzymać się tuż przed przeszkodą znajdującą się przed pojazdem."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Sprawdź lusterko przednie"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Zrozumienie jego funkcji"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Zatrzymanie się w pobliżu przeszkody"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Ciężarówki mają duży martwy punkt w obszarze przed nimi. Łatwo stracić z oczu pieszego lub nawet samochód w tym obszarze, dlatego ciężarówki są wyposażone w lusterko przednie, które można zobaczyć przez przednią szybę."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Lusterko przednie zaprojektowano tak, aby kierowca mógł zobaczyć martwy punkt.<br>Jest to niezbędne narzędzie, które pozwala uniknąć kolizji z przeszkodami podczas manewrowania w ciasnych przestrzeniach."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Rozpocznij jazdę, jedź w kierunku bariery przed Tobą, a następnie zwolnij, zbliżając się do niej.<br>Zwróć uwagę na lusterko przednie."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Zatrzymaj się między linią a przeszkodą."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "W tym scenariuszu nauczymy się korzystać z przedniego lusterka pokazanego na schemacie.<br><br><font face=/font/big_bold.font>Aby je zobaczyć, spójrz przez górną część przedniej szyby.</font>@@aca_goal_tip@@ Musisz znajdować się w pojeździe."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Lusterko przednie pozwala zobaczyć martwy punkt przed ciężarówką. Może pomóc Ci bezpiecznie i precyzyjnie prowadzić.<br><br>JJeśli nie jesteś zadowolony z ustawień, otwórz '@@adjust_link_t@@' (dostępny poprzez menu pauzy), aby dostosować ją do swoich upodobań.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_activate@@, aby kontynuować. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Na wprost ciężarówki jest oznaczone miejsce. Zauważysz, że po drugiej stronie tego miejsca jest przeszkoda; gdy będziesz blisko niej, jedź bardzo powoli i sprawdź odległość do przeszkody w przednim lusterku.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Ciężarówka nadal nie jest gotowa do jazdy, może o czymś zapomniałeś?<br><br>Czy silnik jest włączony? Czy zwolniłeś hamulec ręczny?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Jedź w kierunku miejsca parkingowego.</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Zatrzymaj przód ciężarówki pomiędzy przeszkodą a namalowanym oznaczeniem na drodze. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

