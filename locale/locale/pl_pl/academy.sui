	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulacje!<br><br>Spełniłeś wszystkie warunki zaliczenia i warunki bonusowe w module biegłości w jeździe ciężarówką i zdobyłeś nagrody w swoim profilu zawodowym.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Biegłość w jeździe ciężarówką"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Witamy ponownie w @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Poniższe scenariusze przedstawiają kolejny krok w Twojej drodze do zostania zawodowym kierowcą ciężarówki."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Tym razem nie będziemy Cię prowadzić przez każde zadanie, więc to od Ciebie zależy, czy wykorzystasz swoje umiejętności i doświadczenie."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Możesz natknąć się na kilka znanych manewrów, ale tym razem w nowym otoczeniu, stworzonym tak, aby bardziej przypominało scenariusze z życia rzeczywistego."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Nowością w @@driving_academy@@ jest dodanie warunków „Zaliczony” i „Bonus”."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Podobnie jak poprzednio, musisz ukończyć każdy scenariusz, nie uderzając w nic, prawidłowo parkując i zabezpieczając ciężarówkę..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...ale teraz musisz to zrobić w wyznaczonym czasie, a także z uwzględnieniem ograniczenia liczby zmian kierunku jazdy między jazdą do przodu i do tyłu."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Warunki bonusowe można spełnić, kończąc każdy scenariusz z jeszcze trudniejszymi warunkami..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...takie jak bardziej rygorystyczne limity czasowe, rzadsze zmiany kierunku i korzystanie wyłącznie z kamery wewnętrznej."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Po ukończeniu wszystkich scenariuszy możesz uznać się za doświadczonego kierowcę ciężarówki i być gotowym na kolejne wyzwania w przyszłości.<br><br>Aby rzucić sobie jeszcze większe wyzwanie, ukończ wszystkie warunki bonusowe dla każdego scenariusza. Wówczas naprawdę zostaniesz gwiazdą jazdy ciężarówką!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Samouczek"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "W tym scenariuszu samouczka pomożemy Ci zapoznać się z nowymi funkcjami dostępnymi w module „Biegłość w jeździe ciężarówką”."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Na początku każdego scenariusza zobaczysz okno <color value=@@clr_sel@@>„Omówienie scenariusza”<color value=@@clr_txt@@>. Znajdziesz w nim informacje o nowych warunkach zaliczenia i bonusowych dla scenariusza. <br><br>Warunki zaliczenia muszą zostać spełnione, aby pomyślnie ukończyć scenariusz, podczas gdy warunki bonusowe są opcjonalnym dodatkowym wyzwaniem dla doświadczonych i utalentowanych graczy. <br><br><font face=/font/big_bold.font>Aby kontynuować, włącz zapłon.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Jeden z warunków bonusowych wymaga ukończenia scenariusza przy użyciu <color value=@@clr_sel@@>kamery wewnętrznej<color value=@@clr_txt@@>. Nadal możesz używać kamer zewnętrznych, aby sprawdzić otoczenie, ale tylko wtedy, gdy ciężarówka jest zatrzymana.<br><br>Możesz teraz rozejrzeć się, aby zorientować się w terenie, a następnie przełączyć się z powrotem na kamerę wewnętrzną.<br><br><font face=/font/big_bold.font>Przełącz się na kamerę śledzącą, aby sprawdzić otoczenie</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Rozejrzyj się, a następnie wróć do kamery wewnętrznej.<br><br><font face=/font/big_bold.font>Rozejrzyj się po ciężarówce</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Przełącz z powrotem na kamerę wewnętrzną</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Czas<color value=@@clr_txt@@> będzie również czynnikiem wpływającym na biegłość w jeździe ciężarówką. Wszystkie scenariusze będą miały indywidualny limit czasu, w którym scenariusz musi zostać ukończony jako warunek zaliczenia, a wiele będzie miało również dodatkowy, bardziej rygorystyczny limit jako warunek bonusowy.<br><br>Licznik czasu zaczyna działać dopiero po przemieszczeniu ciężarówki.<br><br><font face=/font/big_bold.font>Uruchom silnik i zwolnij hamulec ręczny, aby kontynuować.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Kolejną nowością w biegłośći w jeździe ciężarówką są punkty orientacyjne. Wszystkie punkty orientacyjne muszą zostać osiągnięte, aby scenariusz mógł zostać ukończony. <br><br>Ponadto punkty orientacyjne są wrażliwe na kierunek, w którym zwrócona jest ciężarówka, gdy do nich dojeżdżasz, więc zwracaj uwagę na wszelkie oznaczenia na ziemi w pobliżu punktu orientacyjnego, aby prawidłowo się zorientować.<br><br><font face=/font/big_bold.font>Jedź do przodu do punktu orientacyjnego przed sobą.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Dotarłeś do punktu kontrolnego i możesz przejść do następnego kroku. <br><br>Za Tobą znajduje się kolejny punkt kontrolny, do którego musisz cofnąć. Zwróć uwagę na strzałkę na ziemi wskazującą, w którą stronę ciężarówka powinna być zwrócona, gdy dotrzesz do punktu kontrolnego. <br><br>Kolejnym warunkiem zaliczenia i bonusu, który należy wziąć pod uwagę, jest <color value=@@clr_sel@@>zmiana kierunku<color value=@@clr_txt@@>. Liczymy, ile razy zmienisz kierunek między jazdą do przodu a cofaniem. Nie przekraczaj limitu, aby ukończyć warunek.<br><br><font face=/font/big_bold.font>Cofnij do punktu kontrolnego i zatrzymaj się.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Teraz powinieneś już mieć za sobą jedną zmianę kierunku. <br><br>Podczep naczepę znajdującą się za Tobą, aby przejść do następnego kroku. <br><br><font face=/font/big_bold.font>Podjedź tyłem pod naczepę, aby ją podczepić.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Ostatni parking znajduje się po prawej stronie. Niektóre scenariusze mogą mieć tylko jedno miejsce parkingowe, podczas gdy inne będą miały wiele do wyboru. Prawidłowe zaparkowanie w dowolnym miejscu pozwoli Ci ukończyć scenariusz. <br><br><font face=/font/big_bold.font> Naciśnij @@imv_nrm_attach@@, aby podłączyć naczepę. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Miejsca parkingowe wskazują również, w którą stronę ciężarówka powinna być zorientowana w miejscu. Zaparkuj w złym kierunku, a nie będziesz w stanie ukończyć scenariusza, dopóki nie poprawisz się, co będzie Cię kosztować czas i zmiany kierunku.<br><br><font face=/font/big_bold.font>Podjedź na jedno z miejsc parkingowych i zaparkuj prawidłowo.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Biegłość w jeździe ciężarówką"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Powinieneś już znać nowe parametry warunków zaliczenia i celów bonusowych, a także być gotowym na nowe scenariusze w biegłości w jeździe ciężarówką!<br><br><font face=/font/big_bold.font>Zabezpiecz ciężarówkę, zaciągając hamulec ręczny i wyłączając silnik, aby ukończyć scenariusz.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
