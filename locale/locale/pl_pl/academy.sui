#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "W tym scenariuszu nauczymy się manewru cofania na „martwą stronę”. Najlepiej jest unikać takiego manewru, chyba że nie ma innego wyboru, gdyż widoczność jest znacznie ograniczona. Nie spiesz się i bądź szczególnie ostrożny."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Jedź kawałek za miejsce parkingowe, aby zrobić sobie miejsce na manewrowanie, gdy zaczniesz cofać."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Zatrzymaj się, sprawdź otoczenie, a następnie zacznij cofać."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Skręć ciężarówką od miejsca. W ten sposób popchniesz przód naczepy w taki sposób, że tył skieruje się na miejsce parkingowe, na które ma trafić. Uważaj, żeby nie przesadzić, bo grozi to „złamaniem” zestawu."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Zacznij prostować ciężarówkę, gdy naczepa wjedzie na miejsce parkingowe."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Zatrzymaj się w wyznaczonym obszarze i zabezpiecz ciężarówkę."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Cofanie na „martwą stronę” wymaga tych samych procedur, co cofanie po stronie widocznej, ale będziesz mieć utrudnienia z powodu braku widoczności po tej stronie. Użyj lusterek i swojej najlepszej oceny, aby zaparkować ciężarówkę.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Przed Tobą znajduje się miejsce parkingowe po stronie pasażera. Będziesz musiał się zatrzymać kawałek za nim, aby mieć miejsce na manewrowanie podczas cofania.<br><br><font face=/font/big_bold.font>Jedź do przodu. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Pamiętaj, skręcanie ciężarówką od miejsca sprawi, że naczepa skręci w jego stronę. Użyj lusterek najlepiej jak potrafisz, aby pomogły Ci wjechać na miejsce parkingowe.<br><br><font face=/font/big_bold.font>Zacznij cofać. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Jazda po rondzie"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "W tym scenariuszu przyjrzymy się pokonywaniu ronda.<br><br>Będziesz musiał zachować szczególną ostrożność w przypadku naczepy, gdyż będzie zachowywać się inaczej przy wjeździe, poruszaniu się po skrzyżowaniu, a także wyjeździe."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Wjazd na rondo"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Jazda na rondzie"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Jazda na rondzie"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Wyjazd z ronda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Jazda do wyznaczonego obszaru"
