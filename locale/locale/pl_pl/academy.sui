#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Przed Tobą znajdują się ciasne zakręty. Pomogą Ci w manewrowaniu naczepą bardziej precyzyjnie."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Podążaj za oznaczeniami do bariery po stronie kierowcy, aby przygotować się na pierwszy skręt."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Trzymaj się blisko bariery zewnętrznej podczas manewru. Zagwarantuje to niezahaczenie naczepy o żadną przeszkodę."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Podążaj dalej za oznaczeniami drogi, aby przygotować się na drugi zakręt – ciasny, 90°."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Będziesz musiał wziąć większy łuk na narożniku, by mieć pewność, że naczepa o nic nie zahaczy. Użyj swojego lusterka przedniego, aby wspomagać się w manewrowaniu."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Kontynuuj wzdłuż zewnętrznej barierki."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Ponownie, wykonanie ciasnego narożnika 90° będzie wymagało od Ciebie wykorzystania całego dostępnego miejsca."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Zatrzymaj się w wyznaczonym obszarze i zabezpiecz ciężarówkę."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Pamiętaj, aby wykorzystać całą dostępną przestrzeń podczas pokonywania zakrętów.<br><br><font face=/font/big_bold.font>Rozpocznij jazdę i podążaj za oznaczeniami. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Jedź wzdłuż zewnętrznej bariery, ale obserwuj naczepę w lusterku.<br><br><font face=/font/big_bold.font>Pokonaj pierwszy zakręt.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Podążaj za oznaczeniami na drodze, aby przygotować się do zakrętu 90°.<br><br><font face=/font/big_bold.font>Pokonaj zakręt 90°. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Po pokonaniu zakrętu utrzymuj szeroki tor jazdy, ponieważ przed Tobą jeszcze węższy zakręt 90°.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę na miejsce parkingowe przed Tobą.</font>"
