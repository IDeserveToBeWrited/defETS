#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "W tym scenariuszu zabierzemy ciężarówkę na krótką przejażdżkę. Zobaczysz, na czym polega hamowanie z naczepą podczas zjazdu z górki. Przygotuj ciężarówkę i ruszaj."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Osiągnij prędkość co najmniej 60km/h (37mph). Bądź gotów na strefę hamowania."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Rozpocznij hamowanie do zatrzymania. Upewnij się, że nie zwlekasz zbyt długo, albo zaryzykujesz uderzenie w barierki!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Zaparkuj w wyznaczonym obszarze, zabezpiecz ciężarówkę i wyłącz silnik."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Podczas tej jazdy poczujesz, jak używać hamulców podczas zjazdu ze wzniesienia. Celem tego ćwiczenia jest uświadomienie sobie ciężaru za tobą i tego, jak wpływa on na drogę hamowania pojazdu.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Rozpocznij jazdę, pamiętając, że musisz osiągnąć prędkość 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Przejedź przez zakręt. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Kontynuuj przyspieszanie ze wzniesienia.</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Osiągnij prędkość co najmniej 60km/h (37mph).</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Osiągnąłeś wymaganą prędkość.<br><br><font face=/font/big_bold.font>Zatrzymaj się przed barierkami.</font>"
