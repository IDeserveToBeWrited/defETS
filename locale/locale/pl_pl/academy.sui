#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Tor przed Tobą pomoże Ci oswoić się z pokonywaniem zakrętów o kącie 90° zestawem z podwójnymi naczepami przy różnym stopniu trudności."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Pierwszych kilka zakrętów jest dość szerokich i oferuje dużo miejsca. Wykorzystaj je, aby wyczuć zachowanie naczep podczas skręcania."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Od tego miejsca zakręty będą coraz ciaśniejsze i bardziej techniczne. Podjeżdżaj do nich powoli i upewnij się, że wjeżdżasz głęboko w zakręt, aby naczepy miały miejsce na złożenie się."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "To jeden z najciaśniejszych zakrętów na torze. Pomocne może być wykorzystanie niewielkiej przestrzeni po prawej stronie, co ułatwi przeprowadzenie naczep obok tych uciążliwych wewnętrznych pachołków."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Następny zakręt powinieneś mieć zawsze z tyłu głowy – wyjeżdżając z jednego łuku, przygotuj już plan na to, jak podejdziesz do kolejnego."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Zawsze obserwuj naczepy, dopóki nie miną wszystkich przeszkód."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Jedź naprzód w stronę pierwszego zakrętu."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Podczas jazdy obserwuj lusterka, aby zrozumieć, jak naczepy podążają za Tobą."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Trzymaj się szeroko przed każdym zakrętem; ma to kluczowe znaczenie, aby zapewnić sobie miejsce potrzebne na przeprowadzenie naczep przez łuk."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Ustawienie się do kolejnych kilku zakrętów jest kluczowe, ponieważ zaraz za nimi znajduje się bardzo ciasny łuk. Błąd popełniony na początku może Cię kosztować nawet później. <br><br>Jedź powoli i skrupulatnie, zwracając uwagę na otoczenie."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Ten zakręt jest niezwykle ciasny i prowadzi bezpośrednio w kolejny. Musisz przemyśleć nie tylko sposób, w jaki w niego wjeżdżasz, ale także to, jak z niego wyjeżdżasz i ustawiasz się do następnego."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Kontynuuj jazdę przez ostatnie zakręty w stronę wyznaczonego obszaru."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Pierwszy bieg wsteczny"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "W tym scenariuszu po raz pierwszy wykonasz manewr cofania zestawem z podwójnymi naczepami."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Spokojnie, nie martw się"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Cofanie zestawem z podwójnymi naczepami wymaga zupełnie nowego sposobu myślenia o wykonywanych czynnościach. Zamiast po prostu sterować naczepą, używasz teraz pierwszej naczepy do kierowania tą znajdującą się za nią. <br><br> Skorzystaj z tego scenariusza, aby wyczuć, jak to wszystko działa. Nie ma tu określonego celu, po prostu nie spiesz się i spróbuj zrozumieć, co się dzieje."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Z pozycji na wprost możesz skręcić ciężarówkę w tym samym kierunku, w którym ma jechać tylna naczepa.<br><br>Nie przesadzaj; musisz tylko skierować tylną naczepę w stronę, w którą chcesz, aby jechała, a następnie możesz ustawić ciężarówkę w linii z pierwszą naczepą i pozwolić tylnej naczepie zrobić swoje."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Gdy tylna naczepa zmierza już tam, gdzie chcesz, możesz skierować przednią naczepę tak, aby podążyła w tym samym kierunku. <br><br>Gdy przód podąża za tyłem, użyj ciągnika, aby dostosować kąt między obiema naczepami, co pozwoli na wykonanie ciaśniejszego lub szerszego, łagodniejszego skrętu."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Nie ma dokładnej recepty na to, jak zrobić to dobrze; musisz po prostu uważać na to, co się dzieje, uczyć się na błędach i ćwiczyć. <br><br>Gdy uznasz, że jesteś gotowy, możesz udać się do wyznaczonego obszaru i zabezpieczyć pojazd. <br><br>Możesz spędzić tutaj na eksperymentowaniu tyle czasu, ile tylko potrzebujesz."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Zacznij powoli cofać. Pamiętaj, aby zacząć od niewielkich ruchów kierownicą, nie ma potrzeby łamania zestawu pod dużym kątem już na samym początku.<br><br>Spróbuj cofać prosto lub skierować naczepy na stronę kierowcy."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Nie spiesz się i nie denerwuj. <br><br>Każdy mistrz był kiedyś początkującym."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

