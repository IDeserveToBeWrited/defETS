#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "W tym scenariuszu wykonamy manewr cofania, aby zaparkować przy krawężniku."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Cofaj w kierunku krawężnika.<br>Podczas cofania musisz być świadomy otoczenia, dlatego korzystaj z lusterek."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Gdy się zbliżysz, możesz zacząć ustawiać ciężarówkę w linii z miejscem parkingowym. Obserwuj obie strony ciężarówki podczas cofania."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Zatrzymaj się na miejscu parkingowym i zabezpiecz ciężarówkę."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Miejsce parkingowe znajduje się za Tobą, po stronie pasażera. Użyj lusterek, aby dotrzeć do tego miejsca.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Pamiętaj, aby przed ruszeniem ciężarówką sprawdzić otoczenie za pomocą lusterek.<br><br><font face=/font/big_bold.font>Rozpocznij cofanie w kierunku krawężnika.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Nadal monitoruj otoczenie podczas cofania na miejsce parkingowe.<br><br><font face=/font/big_bold.font>Zatrzymaj się w wyznaczonym miejscu.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

