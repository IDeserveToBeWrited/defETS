#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Jazda wokół barierek"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Przed Tobą szereg skomplikowanych zakrętów i przeszkód.<br>Weź pod uwagę wszystko, czego się do tej pory nauczyłeś, a nie powinno to być zbyt trudne."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Oznaczenia na drodze mogą pomóc Ci zorientować się, jak pokonać poszczególne przeszkody."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Jedź ciężarówką na zewnątrz narożnika. <br>Będziesz musiał skręcić szerzej, bo naczepa porusza się krótszą trasą."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Następny zakręt to łatwy skręt o 90°. <br> Ponownie trzymaj ciężarówkę po zewnętrznej stronie zakrętu i wykorzystaj całą dostępną przestrzeń."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Nie spiesz się. Kurs się otwiera, ale nadal musisz być precyzyjny."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Utrzymaj odpowiedni dystans w okolicy barierek."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Zachowaj ostrożność, wjeżdżając do tej wąskiej sekcji. <br>Przed wjazdem ustaw ciężarówkę na tyle szeroko, aby przygotować naczepę do wjazdu."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Ostatni zakręt 90° jest znacznie ostrzejszy niż pierwszy, ale miejsca jest mnóstwo, jeśli mądrze zagospodarujesz przestrzeń."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Zatrzymaj się w wyznaczonym obszarze, zabezpiecz ciężarówkę i wyłącz silnik."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Pamiętaj, aby korzystać z oznaczeń drogowych, które ułatwią Ci poruszanie się po drogach.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Korzystanie z lusterek pomoże Ci również bezpiecznie poruszać się po trasie. Zawsze musisz być świadomy tego, jak naczepa podąża za Tobą.<br><br><font face=/font/big_bold.font>Przejedź przez pierwszy zakręt. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Obserwuj naczepę, gdy wyjedziesz z zakrętu i przygotuj się do wjazdu w kolejny.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Przejedź przez następny zakręt. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Pamiętaj, aby obserwować naczepę i upewnić się, że nie ma żadnych przeszkód wokół niej, zanim zawrócisz ciężarówkę.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę, omijając przeszkodę znajdującą się przed Tobą. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Gdy naczepa odjedzie od bariery, mocno obróć się w stronę pasażera, aby ustawić się w wąskim przejeździe. <br><br><font face=/font/big_bold.font>Kontynuuj jazdę w kierunku wąskiego przejazdu.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Ta sekcja będzie wymagała bardzo precyzyjnej jazdy. Nie spiesz się i korzystaj z lusterek.<br><br><font face=/font/big_bold.font>Trzymaj się zewnętrznej strony każdego zakrętu. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ten zakręt jest bardzo ostry, ale możesz wykorzystać całą przestrzeń przed sobą, aby łatwo go pokonać.<br><br><font face=/font/big_bold.font>Wykonaj ostatni zakręt. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

