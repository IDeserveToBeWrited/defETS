#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parkowanie równoległe"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "W tym scenariuszu przyjrzymy się parkowaniu równoległemu między dwiema innymi ciężarówkami."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zatrzymywanie się przed miejscem parkingowym"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Sprawdzanie lusterka wstecznego"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Cofanie na miejsce parkingowe"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Wyrównanie ciężarówki wewnątrz miejsca parkingowego"
