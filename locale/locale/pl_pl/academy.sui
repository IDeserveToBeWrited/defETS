	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Podczepianie naczepy"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "W tym scenariuszu wyjaśnimy podstawy podczepiania i odczepiania ciężarówki od naczepy."

