	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "W tym scenariuszu sprawdzimy twoje nowo nabyte umiejętności prowadzenia pojazdu."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Na torze występują różne wariacje zakrętów. Pamiętaj, że to nie wyścig i nie liczy się czas. Bądź cierpliwy i dostosuj swoją prędkość do warunków na drodze."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Początek toru jest prosty jak bułka z masłem. Im dalej zajedziesz, tym trudniejszy się stanie."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Zwracaj uwagę na prędkość. Gdy nabierzesz jej zbyt dużo, możesz nie zmieścić się w zakręcie."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Wyjście z toru to bardzo ciasny zakręt typu „agrafka”. Jedź powoli i wykorzystaj całą dostępną przestrzeń."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Zaparkuj pomiędzy barierkami i zabezpiecz ciężarówkę."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Aby zakończyć ten scenariusz pomyślnie, nie możesz w nic uderzyć, wypaść z toru ani rozjechać pachołków.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Jedź prosto w kierunku ostrego zakrętu w prawo, aby wjechać na tor. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Przejedź przez zakręt z równomierną prędkością. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Zbliżasz się do bardziej skomplikowanego odcinka krętych zakrętów.<br><br><font face=/font/big_bold.font>Dostosuj odpowiednio prędkość i kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę w kierunku następnych zakrętów.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Nadchodzą łatwe, łagodne zakręty. Utrzymuj stałą prędkość.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Wyjście z trasy to ostry zakręt w kształcie agrafki (zakręt o 180°). Zwolnij i trzymaj się zewnętrznej przed zakrętem. Pamiętaj, aby używać lusterek!<br><br><font face=/font/big_bold.font>Wyjdź z kursu. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Przed Tobą znajduje się miejsce parkingowe pomiędzy barierkami.<br><br><font face=/font/big_bold.font>Kontynuuj w kierunku miejsca parkingowego.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
