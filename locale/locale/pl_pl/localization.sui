	key[]: "wiz_cfg_done"
	val[]: "The game is now configured and you can continue. You can change the configuration later in Options."

	key[]: "wiz_cfg_steam"
	val[]: "Możesz sprawdzić i skonfigurować mapowanie przycisków i osi dla tego kontrolera za pomocą klienta Steam. Ustawienia gamepada Steam dla gry są dostępne w Steam > Biblioteka > Euro Truck Simulator 2 > Kontroler."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Otwórz ustawienia kontrolera"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Używaj przycisków @@imm_wiz_dsteerleft@@ oraz @@imm_wiz_dsteerright@@ do kierowania."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Przesuwaj mysz w lewo lub w prawo, aby obracać kierownicę w odpowiednim kierunku."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Użyj @@ima_wiz_j_steer@@ do kierowania."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Używaj @@imm_wiz_dforward@@, aby jechać do przodu, do cofania zaś używaj @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Przesuń @@ima_wiz_j_throttle@@ do przodu, aby jechać przed siebie. Odwrotny ruch spowoduje cofanie."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Użyj @@ima_wiz_j_throttle@@, aby jechać do przodu. Do zawracania używaj @@ima_wiz_j_brake@@."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Używaj @@imm_wiz_dforward@@, aby przyspieszyć. Jako hamulec posłuży Ci @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Przesuń @@ima_wiz_j_throttle@@ do przodu, aby przyspieszyć. Odwrotny ruch spowoduje hamowanie."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Używaj @@ima_wiz_j_throttle@@, aby przyspieszyć. Jako hamulec posłuży Ci @@ima_wiz_j_brake@@."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Używaj @@imv_wiz_gearup@@ aby włączyć bieg do przodu oraz @@imv_wiz_geardown@@, aby wrzucić bieg wsteczny."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Jeżeli używasz klawiatury bądź przycisków kontrolera, użyj @@imv_wiz_gearup@@ aby włączyć bieg do przodu oraz @@imv_wiz_geardown@@, aby wrzucić bieg wsteczny. Jeżeli używasz kierownicy z H-Shifterem, użyj @@imv_wiz_drive@@ and @@imv_wiz_reverse@@ by wybrać kierunek jazdy."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Używaj @@imv_wiz_gearup@@ oraz @@imv_wiz_geardown@@, aby wrzucić pożądany bieg."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Użyj układu H-Shifter oraz @@ima_wiz_j_clutch@@, aby wybrać konkretny bieg."
