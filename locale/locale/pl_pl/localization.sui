	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Ustawia maksymalną dozwoloną liczbę klatek na sekundę dla gry, gdy jest ona zminimalizowana w tle.<br><br>Ustawienie wartości na 0 wyłączy tę funkcję."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Możliwość zmiany pomiędzy prostymi ustawieniami graficznymi (presetami) lub zaawansowanymi ustawieniami graficznymi (możliwość zmiany poszczególnych parametrów)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Poprawia jakość grafiki poprzez renderowanie gry wewnętrznie w wyższej rozdzielczości, co zmniejsza poszarpane krawędzie i poprawia szczegóły.<br>Na przykład wybranie wyższej opcji skalowania skutkuje wyraźniejszym obrazem z mniejszym rozmyciem, dzięki czemu gra wygląda ogólnie lepiej, ale dzieje się to kosztem wydajności.<br><br><color value=@@clr_txt_d@@>To ustawienie często ma duży wpływ na wydajność."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Wybór szybkich metod wygładzania krawędzi, które wygładzają postrzępione krawędzie w grze:<br>- SMAA próbkuje każdy piksel wielokrotnie (w zależności od wybranej jakości) w różnych miejscach klatki i uśrednia próbki w celu uzyskania ostatecznego obrazu.<br>- TAA próbkuje każdy piksel tylko raz na klatkę, ale próbkuje je w różnych miejscach i różnych klatkach.<br>- Aby uzyskać najlepszy wynik, możesz również wybrać kombinację obu metod kosztem wydajności.<br><br><color value=@@clr_txt_d@@>To ustawienie zwykle ma umiarkowany wpływ na wydajność."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje miękkie cienie do szczelin i obiektów znajdujących się blisko siebie, poprawiając postrzeganą wierność graficzną całego świata gry.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Wybór ustawień wstępnych TAA:<br>- „Zawsze miękki” spowoduje mniejsze migotanie/większe rozmycie — opcja ta jest odpowiednia dla użytkowników komputerów PC, którzy włączają supersampling lub mają monitory o wysokiej rozdzielczości, a także dla użytkowników telewizorów 1080p, którzy siedzą dalej od ekranu.<br>- „Zawsze ostry” spowoduje większe migotanie/mniejsze rozmycie — prawdopodobnie jest to najlepsza opcja do zastosowań poniżej 1080p, takich jak laptopy lub Steam Deck.<br>- „Adaptacyjna ostrość” dynamicznie wyłącza drgania TAA, gdy kamera jest statyczna.<br><br><color value=@@clr_txt_d@@>To ustawienie można stosować tylko wtedy, gdy TAA jest wybrane jako rozwiązanie antyaliasingowe."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje intensywność wyostrzania luminancji TAA.<br><br><color value=@@clr_txt_d@@>To ustawienie można stosować tylko wtedy, gdy TAA jest wybrane jako rozwiązanie antyaliasingowe."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Po włączeniu odległe obszary mapy mogą być sztucznie rozmyte, aby uzyskać realistyczny spadek ostrości w tle."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Po włączeniu promienie światła mogą być widoczne podczas patrzenia na słońce lub patrzenia na słońce przez obiekty takie jak drzewa, budynki lub pojazdy."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Po włączeniu kolory gry są dynamicznie dostosowywane ze względów estetycznych. Sceny będą lepiej dopasowane do pory dnia i warunków pogodowych, kolory pojazdów i innych obiektów mogą być żywsze itp."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Poprawia odbicia poprzez ich wewnętrzne renderowanie w wyższej jakości, a także poprzez użycie lepszego wygładzania krawędzi.<br><br><color value=@@clr_txt_d@@>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje szczegółowość odbić widocznych na powierzchniach pojazdów, szybach i innych powierzchniach odbijających, takich jak kałuże, mokre drogi i otwarte zbiorniki wodne.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zazwyczaj umiarkowany wpływ na wydajność.<br><br>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje poziom szczegółowości i złożoności roślin i drzew.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje gęstość trawy widocznej na poboczach drogi.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość cieni rzucanych przez słońce lub księżyc.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Umożliwia renderowanie cieni nawet z bardzo odległych obiektów.<br><br><color value=@@clr_txt_d@@>To ustawienie zwykle ma umiarkowany wpływ na wydajność."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość efektów pogodowych, takich jak odbicia."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość odbić widocznych w lusterkach pojazdu (niezależnie od ustawień odbicia).<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje rozdzielczość obrazu wyświetlanego na lusterkach pojazdu."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje odległość, w której obiekty zaczynają być renderowane w lustrze.<br><br><color value=@@clr_txt_d@@>To ustawienie często ma duży wpływ na wydajność."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje jakość niektórych tekstur stosowanych do obiektów i powierzchni w grze."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Poprawia ostrość tekstur, zwłaszcza tych oglądanych z daleka lub pod kątem.<br><br><color value=@@clr_txt_d@@>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje wygląd geometrycznych szczegółów do nawierzchni, dróg i innych obiektów, aby poprawić ich wygląd.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność.<br><br>Zmiany tego ustawienia zaczną obowiązywać dopiero po ponownym uruchomieniu gry."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Umożliwia oświetlenie światłami innych pojazdów w ruchu drogowym."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Umożliwia oświetlenie dodatkowymi światłami innych pojazdów w ruchu, kierunkowskazów, hamulców itp."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Dostosowuje odległość, z której widoczne są źródła sztucznego światła.<br><br><color value=@@clr_txt_d@@>To ustawienie ma zwykle umiarkowany wpływ na wydajność."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje pieszych poruszających się po świecie gry."
#@}

