	key[]: "api_classical_controller"
	val[]: "Klasyczny kontroler"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Kontrolery do gier takie jak @@controller_ps5@@, @@controller_xbox_one@@ lub @@controller_steam_deck@@ obsługują interfejs wejściowy Steam i wykorzystują prosty układ.<br><br>System obsługuje pełną konfigurację skrótów klawiszowych w grze."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Kontrolery do gier obsługują interfejs wejściowy Steam i korzystają z samodzielnych układów skonfigurowanych za pomocą klienta Steam.<br><br>System oferuje ograniczone wsparcie dla podpowiedzi dotyczących przycisków w grze i brak konfiguracji powiązań w grze."

	key[]: "wiz_api_classical"
	val[]: "Kontroler, kierownica lub joystick obsługujący interfejs DirectInput, XInput lub podobny."
