	val[]: "Sterowanie" #+ Rotates wheel to the left or right.

	key[]: "o_im_left"
	val[]: "Kierownica w lewo" #+ Rotates wheel to the left.

	key[]: "o_im_right"
	val[]: "Kierownica w prawo" #+ Rotates wheel to the right.

	key[]: "o_im_look_left"
	val[]: "Spojrzenie w lewo" #+ Rotates view to the left.

	key[]: "o_im_look_right"
