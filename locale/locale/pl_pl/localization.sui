	val[]: "Zbliża się manewr zmiany pasa. Dostosuj swoją prędkość aby uniknąć kolizji..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Przedni pojazd eskorty ostrzeże teraz innych kierowców...<br>Dostosuj swoją prędkość aby uniknąć kolizji..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Pojazdy eskortujące czekają na Ciebie na pobliskim skrzyżowaniu. Proszę podążać trasą."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Uważaj!<br>Dojeżdżasz do tylnego pojazdu eskorty!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Uważaj!<br>Poruszasz się niebezpiecznie blisko do tylnego pojazdu eskorty!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Aby wyświetlić specjalną ofertę zleceń, naciśnij następujący klawisz:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Specjalna oferta pracy:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Właśnie masz zamiar przewieźć ładunek gabarytowy (Special Transport)! Będą Cię prowadzić dwa pojazdy pilotujące. Zachowaj ostrożność i stosuj się do ich wskazówek oraz powiadomień. Transporty specjalne tego typu nie zatrzymują się na czerwonym świetle i w większości sytuacji mają pierwszeństwo przejazdu. Podczas tych dostaw punkty kontrolne są tworzone częściej, aby zapisywać Twoje aktualne postępy."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Zachowaj szczególną ostrożność w następujących przypadkach:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Unikaj konfliktów z pojazdami eskorty oraz utrzymaj ładunek pomiędzy nimi."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Nie zjeżdżaj z wyznaczonej trasy, nawet na stacje benzynowe, miejsca odpoczynku itp."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Przestrzegaj ograniczeń prędkości pilnowanych przez poprzedzający pojazd eskorty."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Uważaj na wyprzedzające Cię pojazdy i innych kierowców na drogach."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manewr zmiany pasa:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Jeśli nie będziesz stosował się do tych zasad, twoja misja Transportu Specjalnego może się nie powieść!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manewr został rozpoczęty przez <color value=@@clr_sel@@>tylny<color value=@@clr_txt@@> pojazd eskorty, który zmienił pas jazdy oraz go zablokował."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Przedni<color value=@@clr_txt@@> pojazd eskorty czeka aż docelowy pas będzie wolny, po czym również zmienia pas na docelowy."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Wtedy <color value=@@clr_sel@@>gracz<color value=@@clr_txt@@> może bezpiecznie zmienić pas jazdy na wyznaczony."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Bak paliwa został uzupełniony, a tachograf zresetowany."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Nie możesz wezwać pomocy drogowej podczas misji Transportu Specjalnego."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Nie możesz skorzystać z przeprawy promem podczas misji Transportu Specjalnego."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Odpoczywasz...<br>Zbiorniki paliwa ciężarówki są napełniane..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Zbliżasz się do obowiązkowego postoju.<br>Podążaj za eskortą do miejsca parkingowego, aby odpocząć!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Obowiązkowy postój"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Naciśnij następujący klawisz, aby odpocząć i zatankować paliwo:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Wystąpił błąd podczas wyczytywania zawartości ekwipunku serwisu Steam.<br><br>$ERROR$<br><br>Wybierz opcję kontynuowania, aby zachować zawartość włączoną. Gra będzie dalej próbowała ją wyszukać.<br><br>Możesz tymczasowo wyłączyć tę zawartość, aby zapobiec ponownemu wyświetlaniu komunikatów o błędach, takich jak ten. Gra automatycznie włączy zawartość ponownie, gdy ją uruchomisz." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Nie można pobrać przedmiotów z ekwipunku Steam." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "EKWIPUNEK STEAM" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Wczytywanie przedmiotów z ekwipunku Steam..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOWE PRZEDMIOTY Z EKWIPUNKU" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Wykryto nowe przedmioty w ekwipunku Steam." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Akcesoria pojazdu" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Akcesoria kabiny" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Tło pulpitu" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Malowanie" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Dezaktywuj ekwipunek" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Spróbuj ponownie poźniej" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "EKWIPUNEK STEAM" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Niektóre przedmioty zostały usunięte z ekwipunku Steam. Nie będzie już można ich kupić w warsztacie.<br><br>Nie ma to wpływu na aktualnie zainstalowane elementy." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


