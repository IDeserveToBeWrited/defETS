	key[]: "simple_gfx_hint"
	val[]: "Dostosuj ustawienia graficzne, korzystając z precyzyjnie dostrojonych ustawień wstępnych, aby dostosować wydajność wizualną gry do swoich upodobań."

	key[]: "apply"
	val[]: "Zastosuj" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Motyw pulpitu" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "EKRAN" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "JAKOŚĆ OBRAZU" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEKSTURY" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKSJE" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "CIENIE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "OŚWIETLENIE" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-PROCESSING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ŚRODOWISKO" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Tryb pełnoekranowy" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Jasność / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Dostosuj jasność" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Rozdzielczość" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Odświeżanie" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limit FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limit FPS w tle" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Domyślne odświeżanie" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Synchronizacja pionowa" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomiczny (oszczędza energię)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "PROSTE USTAWIENIA GRAFICZNE" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ZASTOSOWANO INDYWIDUALNE USTAWIENIA" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "ZAAWANSOWANE USTAWIENIA GRAFICZNE" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Proste/zaawansowane ustawienia graficzne" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Ukryj ustawienia zaawansowane" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Pokaż ustawienia zaawansowane" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skalowanie" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Wygładzanie krawędzi" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA — wyostrzanie wartości jasności (luma)" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Dostosowanie TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptacyjna przejrzystość" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Zawsze miękki" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Zawsze ostry" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Okluzja otoczenia przestrzeni ekranu (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "HDR" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Głębia ostrości (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Przebicia światła" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Korekcja barw" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Skalowanie odbicia" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Jakość odbić" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Szczegóły roślinności" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Zagęszczenie trawy" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Jakość cieni"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Rozmiary tekstur cieni" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Odległe cienie" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Cienie wnętrza" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Jakość warunków pogodowych"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Jakość obrazu w lusterkach" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Rozdzielczość obrazu lusterek" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Odległość rysowana w lusterkach" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Jakość tekstur" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtrowanie anizotropowe" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Teksturowanie reliefowe" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Światła mijania" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Drugie światła pojazdu" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Odległości widoczności świateł" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Piesi" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Ustawienia graficzne zmieniły się.<br>Czy chcesz zachować te ustawienia?"

	key[]: "reverting_in"
	val[]: "Przywrócenie za" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sek." #+ Suffix added after number of seconds in "Reverting in 18 seconds."

