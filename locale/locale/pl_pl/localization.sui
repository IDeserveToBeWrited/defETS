	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Istniejące ustawienia wstępne o tej samej nazwie zostaną zastąpione. Czy chcesz kontynuować?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
