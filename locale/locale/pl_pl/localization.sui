#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Widok rozszerzony" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Rozszerzone ustawienia wstępne widoku" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Wprowadź nazwę ustawienia wstępnego" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
