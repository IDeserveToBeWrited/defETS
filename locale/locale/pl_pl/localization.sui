#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Plik zdjęcia jest za duży. Spróbuj zmniejszyć rozdzielczość." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Zdjęcie jest uszkodzone lub nieobsługiwane." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Rozdzielczość zdjęcia jest zbyt duża. Spróbuj zmniejszyć wyświetlaną rozdzielczość." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Serwis odrzucił zdjęcie." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "To konto nie ma możliwości przesyłania zdjęć." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Wykryto jednoczesne przesyłanie kilku elementów w to samo miejsce." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Przesyłanie tymczasowo wyłączone. Spróbuj ponownie później." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Nieznany błąd podczas przesyłania. Spróbuj ponownie później." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Zdjęcie jest większe niż maksymalny dozwolony rozmiar $LIMIT$ i został zmieniony." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Plik zdjęcia jest większy niż maksymalny dozwolony rozmiar $LIMIT$KB i został zmniejszony." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "AKTYWNE MODYFIKACJE" #+ Mod selection title

	key[]: "missing_deps"
