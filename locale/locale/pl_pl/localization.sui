#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Warstwa sieci niedostępna. Sprawdź poprawność konfiguracji oprogramowania."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Nie można ustanowić połączenia z usługą. Sprawdź, czy łącze internetowe działa poprawnie."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Błąd komunikacji z usługą. Spróbuj ponownie później."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Usługa zwróciła nieprawidłowe dane. Jeśli korzystasz z bramki proxy, sprawdź jej konfigurację. W przeciwnym wypadku spróbuj ponownie później."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Usługa zwróciła nieprawidłowe dane. Spróbuj ponownie później."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Usługa nie jest kompatybilna z Twoją wersją gry. Sprawdź, czy jest dostępna nowa aktualizacja."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Usługa jest w tej chwili niedostępna. Spróbuj ponownie później."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Usługa jest w tej chwili niedostępna z uwagi na przeprowadzane prace konserwacyjne. Spróbuj ponownie później."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Dane dostępowe są nieprawidłowe. Spróbuj zalogować się ponownie."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Konto zostało zablokowane z powodu zbyt wielu nieudanych prób logowania. Spróbuj ponownie za pół godziny."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Konto online jest obecnie zablokowane z powodu podejrzanych logowań. Prosimy spróbować ponownie w ciągu 24 godzin."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Ta gra nie jest zarejestrowana na tym koncie."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Konto nie zostało jeszcze aktywowane. Sprawdź, czy w Twojej skrzynce nie czeka e-mail aktywacyjny."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Konto zostało zablokowane. Prosimy o kontakt z pomocą techniczną."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Konto zostało zbanowane. Prosimy o kontakt z pomocą techniczną."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Gra nie obsługuje uwierzytelniania przez bramkę proxy. Spróbuj użyć innej bramki proxy lub połączenia bezpośredniego."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Wymagany obiekt jest obecnie niedostępny. Proszę spróbować ponownie za kilka minut."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Błąd SSL. Nie można nawiązać bezpiecznego połączenia."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Gra została przerwana podczas łączenia z internetem. Spróbuj ponownie później."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Wystąpił błąd wewnętrzny. Więcej informacji znajdziesz w pliku net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Gra Euro Truck Simulator 2 napotkała problem i nie jest w stanie wyświetlić grafiki na twoim komputerze (nie znaleziono właściwego urządzenia graficznego).\nSugerowane kroki:\n1. Sprawdź, czy komputer i karta graficzna spełniają wymagania minimalne.\n2. Zaktualizuj Microsoft DirectX do najnowszej wersji.\n3. Pobierz i zainstaluj najnowsze sterowniki do twojej karty graficznej (powinny być na stronie producenta karty - najprawdopodobniej twoje sterowniki są już nieaktualne).\n4. Spróbuj zmienić metodę renderowania z OpenGL na DirectX lub odwrotnie.\n5. Usuń plik konfiguracyjny gry 'config.cfg' w katalogu 'Moje dokumenty' - 'Euro Truck Simulator 2'. Możliwe, że uległ uszkodzeniu.\nTen plik utworzy się automatycznie przy następnym uruchomieniu gry – będzie już miał właściwe wartości."

	key[]: "sys_no_graphics_simple"
	val[]: "Gra Euro Truck Simulator 2 ma problem z wyświetlaniem grafiki na Twoim komputerze (nie znaleziono poprawnego urządzenia do obsługi grafiki)."
#@}

