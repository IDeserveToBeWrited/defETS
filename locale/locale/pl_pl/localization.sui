	key[]: "select_controller_type"
	val[]: "WYBIERZ RODZAJ KONTROLERA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Kierownica"

