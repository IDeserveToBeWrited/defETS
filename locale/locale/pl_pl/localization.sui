#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Bank" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Jeśli potrzebujesz pieniędzy, to zawsze możesz poprosić bank o pożyczkę." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "OFERTY POŻYCZEK" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "za $MONEY$ dziennie" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Liczba aktywnych pożyczek: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Możesz pożyczyć: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "PRZEGLĄD AKTYWNYCH POŻYCZEK"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Pożyczka" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Pozostało do spłaty" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Czas trwania (w dniach)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Stopa procentowa (w skali roku)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Rata" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Spłata" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Suma:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Bilans konta: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

	key[]: "bank_loan_unlock_requirement"
	val[]: "Advance your career to unlock the loan."

	key[]: "bank_loan_locked_wrong_mode"
	val[]: "Rozwiń swoją karierę w trybie $MODE$, by odblokować kredyt."

    key[]: "bank_loan_in_debt"
	val[]: "Masz za dużo długu, by wziąć ten kredyt."

