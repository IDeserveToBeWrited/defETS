	key[]: "select_control_method"
	val[]: "WYBIERZ SPOSÓB STEROWANIA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Kontrolery"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Kreator zastosuje rekomendowane ustawienia na podstawie podłączonych urządzeń.<br><color value=@@clr_sel@@>Jeśli używasz gamepada kompatybilnego z Steam, rozważ włączenie obsługi konfiguracji w <br><color value=@@clr_txt_d@@> „Steam > Ustawienia > Kontroler > Ogólne ustawienia kontrolera”."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Prowadź ciężarówkę przy użyciu klawiatury, a do rozglądania się używaj myszy. To najprostsza i najmniej precyzyjna forma sterowania, ale cechuje ją przystępność."

	key[]: "wiz_control_mouse"
	val[]: "Użyj myszy do bardziej czułego sterowania. Inne czynności są nadal wykonywane na klawiaturze. Możesz używać myszy do rozglądania się tylko wtedy, gdy jednocześnie trzymasz specjalny klawisz lub przycisk sterowania kamerą."

	key[]: "wiz_control_controller"
	val[]: "Używaj kierownicy, gamepada lub joysticka, aby doświadczać gry w najbardziej realistyczny sposób. Skróty klawiszowe mogą być przypisane do najróżniejszych działań, a myszą można zmieniać kąt nachylenia kamery."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nie wykryto żadnego kontrolera do gry. Musisz coś podłączyć, aby umożliwić wybór!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Wyszukiwanie dostępnych kontrolerów..."

