	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Opcje online. Ustaw wszystkie opcje związane z World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Czy na pewno chcesz odłożyć rejestracje?<br><br>Możesz otworzyć ten dialog ponownie z okna Opcji Online, znajdującego się na pulpicie gry." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "ŁĄCZENIE ZAWARTOŚCI" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Łączenie zawartości..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Nie udało się wysłać polecenia rejestracji dla: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Konto Steam użyte do rejestracji tego DLC różni się od użytego do stworzenia konta World of Trucks lub zarejestrowania gry. Zmień konto Steam i spróbuj ponownie." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Konto Steam użyte do zarejestrowania tego DLC zostało użyte w innym koncie World of Trucks. Jeżeli chcesz zarejestrować DLC, musisz użyć konta Steam, które nie jest połączone z żadnym kontem World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Token Steam wygasł. Spróbuj ponownie później." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Klucz produktu użyty do aktywacji dodatku DLC jest niepoprawny. Skontaktuj się z naszym supportem: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Wystąpił wewnętrzny błąd podczas rejestracji gry. Spróbuj później." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUKCES" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMACJE" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "PRZEGLĄDARKA ZAWARTOŚCI" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Gratulacje! Wybrane dodatki DLC zostały pozytywnie połączone z Twoim kontem World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nie można połączyć zawartości, ponieważ obecne konto Steam jest powiązane z innym kontem World of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Niektórym dodatkom DLC nie udało się połączyć.<br>Najedź myszą na wykrzykniki dla każdego z dodatków DLC, aby zobaczyć więcej szczegółów." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Rejestrowanie $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Obecny profil nie jest połączony z World of Trucks lub gra działa w trybie offline. Edytuj profil, aby się połączyć." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Kliknij, aby odrzucić"

	key[]: "online_connect_content_info"
	val[]: "Podłączone obecnie kompatybilne dodatki DLC: <color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$. Jeżeli niektóre dodatki DLC nie są połączone z World of Trucks, to ominie cię ich zawartość." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Gratulacje!<color value=@@clr_txt@@> Cała Twoja zawartość jest połączona z World of Trucks! Możesz teraz z niej korzystać." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Nie można połączyć nowej zawartości do World of Trucks, ponieważ obecnie używane konto Steam nie pasuje do konta Steam używanego z profilem World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Połączono" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nie połączono" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Nie udało się wczytać informacji o posiadanej zawartości." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Nie udało się wczytać informacji o połączonej zawartości." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Nie można pobrać informacji o aktualnie używanym koncie." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Później" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Nie można zarejestrować tego dodatku DLC. Nie znaleziono stałej licencji. Prawdopodobnie sytuacja spowodowana jest przez funkcję udostępniania gier rodzinie serwisu Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Brak stałej własności" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
