#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "WCZYTAJ GRĘ"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Wczytaj grę" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.
	
	key[]: "load_game_failed"
	val[]: "Nie udało się wczytać zapisanej gry."

	key[]: "load_game_desc"
	val[]: "Wczytaj poprzednio zapisaną grę. Twoje obecne postępy zostaną utracone!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Czy na pewno chcesz wczytać inną grę?<br><br> Jeśli"

	key[]: "load_progress_lost_mp"
	val[]: "Czy na pewno chcesz wczytać inny zapis gry?\\?<br>]W przypadku wczytania innego zapisu gry w trybie wieloosobowym może to skutkować anulowaniem lub zawieszeniem zlecenia, teleportacją do najbliższego serwisu lub niedostępnością wybranego zlecenia.<br><br>Twoje bieżące postępy zostaną utracone, chyba że zostały wcześniej zapisane."

	key[]: "load_game_mp_suspended_job"
	val[]: "Zapisano pomyślnie, ale aktywne zlecenie z World of Trucks zostało zawieszone i jest niedostępne podczas tej sesji."

	key[]: "autosave"
	val[]: "- Automatyczny zapis -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Szybki zapis -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Pokaż automatyczne zapisy" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Nie znaleziono ręcznych zapisów." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Wczytaj" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Niekompatybilny zapis gry!<br><color value=@@clr_txt@@>Spróbuj zaktualizować grę do najnowszej dostępnej wersji." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nie udało się wczytać i wyświetlić wszystkich plików zapisu dla tego profilu." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "UWAGA" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problem z wczytaniem zapisu.<color value=@@clr_txt@@><br><br>Wczytywanie zapisu zakończyło się niepowodzeniem. Możesz spróbować zidentyfikować i naprawić problem, korzystając z informacji zawartych poniżej, bądź wczytać inny zapis. Tego typu problemy mogą mieć następujące powody:<br><br>1. Zapis jest niekompatybilny z zainstalowanymi modyfikacjami.<br><br>2. Zapis został sporządzony na modyfikacjach, które aktualnie nie są zainstalowane.<br><br>3. Zapis został uszkodzony w wyniku użycia wadliwej modyfikacji.<br><br>4. Zawieszenie się gry w trakcie lub krótko po procesie zapisywania może zaburzyć ich poprawność."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Wykryto brakującą modyfikację (MOD).<color value=@@clr_txt@@><br><br>Najnowszy zapis zawiera zależności od modyfikacji, której nie wykryto na tym komputerze bądź jest ona wyłączona.<br><br>Jeżeli nie jest to stanem pożądanym, sprawdź stan modyfikacji.<br><br>Możesz też spróbować wczytać grę, bez dokonywania żadnych zmian. Może to jednak wywołać problemy z jej uruchomieniem lub inne utrudnienia.<br><br>Alternatywnie możesz spróbować załadować inny zapis, który nie zależy od brakującej modyfikacji."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Wykryto brakujący opcjonalny dodatek DLC.<color value=@@clr_txt@@><br><br>Najnowszy zapis zawiera zależności od brakującego dodatku DLC (oficjalnego rozszerzenia gry).<br><br>Jeśli się tego nie spodziewasz, sprawdź stan dodatku(ów) DLC.<br><br>W przeciwnym wypadku możesz i tak wczytać zapis, jednak niektóre funkcje zapewniane przez dodatek(i) DLC mogą zostać utracone.<br><br>Alternatywnie możesz spróbować wczytać inny zapis, który nie jest zależny od brakującego dodatku(ów) DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Wykryto brakujący dodatek DLC.<color value=@@clr_txt@@><br><br>Najnowszy zapis zawiera zależności od brakującego dodatku DLC (oficjalnego rozszerzenia gry).<br><br>Aby ten zapis działał prawidłowo, dodatek DLC musi być obecny i aktywowany na tym komputerze.<br><br>Alternatywnie możesz spróbować wczytać inny zapis, który nie jest zależny od brakującego dodatku DLC."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Modyfikacja zależna od zawartości dodatku DLC.<color value=@@clr_txt@@><br><br>Co najmniej jedna z modyfikacji jest zależna od DLC (oficjalnego dodatku do gry), które aktualnie nie jest zainstalowane.<br><br>Musisz wyłączyć modyfikacje lub zainstalować DLC, od którego są one zależne."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Wykryto błąd<color value=@@clr_txt@@><br><br>Wygląda na to, że gra zawiesiła się podczas wczytywania danych.<br><br>Możesz spróbować zidentyfikować i naprawić problem, korzystając z informacji zawartych poniżej, bądź wczytać inny zapis.<br><br>Tego typu problemy mogą mieć następujące powody:<br><br>1. Zainstalowane modyfikacje są uszkodzone lub niekompatybilne z aktualną wersją gry.<br><br>2. Zapis stanu gry zawiera odniesienia do modyfikacji, której nie można odnaleźć na tym komputerze.<br><br>3. Zapis został uszkodzony przez użycie wadliwej modyfikacji.<br><br>4. Problem może powodować również sprzęt komputerowy lub awaria sterownika."

	key[]: "mods_detected_warning"
	val[]: "Została wykryta obecność modyfikacji. Pamiętaj o tym, że zepsute, przestarzałe lub niekompatybilne modyfikacje mogą być powodem niestabilności gry. Sprawdź listę aktywnych modyfikacji w menadżerze modyfikacji." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

