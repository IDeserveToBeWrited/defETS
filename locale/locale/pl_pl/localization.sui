#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Kontynuuj ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Witaj w grze Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "W końcu masz okazję sprawdzić się w wymarzonej pracy – prowadzeniu ciężarówki!"

	key[]: "intro_3"
	val[]: "Twoja firma przewozowa jest gotowa do akcji, ale niestety nie masz pieniędzy na zakup ciężarówki. Na razie musisz pracować dla innych firm jako najemny kierowca."

	key[]: "intro_4"
	val[]: "Twoim zadaniem jest bezpieczne dostarczenie ładunku o nazwie $JOB_CARGO$ do doku firmy $JOB_TARGET_COMPANY$ w mieście $JOB_TARGET_CITY$. Twój pracodawca zapewnił Ci pojazd i pokryje wszystkie koszty. Nie zawiedź go i dojedź na czas!"


	key[]: "intro_garage_1"
	val[]: "Oto główna siedziba Twojej firmy."

	key[]: "intro_garage_2"
	val[]: "To podstawowy garaż. Może to niezbyt wiele, ale w końcu od czegoś trzeba zacząć."

	key[]: "intro_garage_3"
	val[]: "Niestety, nie masz jeszcze czego tu zaparkować, więc nie widać żadnych ciężarówek."

	key[]: "intro_garage_4"
	val[]: "Po zarobieniu wystarczającej ilości pieniędzy i zakupieniu ciężarówki będziesz mieć możliwość swobodnego poruszania się po świecie i prowadzenia firmy na własną rękę."

	key[]: "intro_garage_5"
	val[]: "Powodzenia!"


	key[]: "desktop_tut_t"
	val[]: "FUNKCJA ODBLOKOWANA"

	key[]: "desktop_tut_job"
