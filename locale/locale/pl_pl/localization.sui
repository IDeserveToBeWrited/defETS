	val[]: "Przypisuje położenie dźwigni zmiany biegów."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje dane wejściowe służące do przełączania pomiędzy zakresami w oparciu o układ dźwigni zmiany biegów."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Przypisuje przycisk do przełączania rozdzielacza zmiany biegów w oparciu o układ dźwigni."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Włącz, jeśli używasz przełączników zamiast przycisków dla wejść zakresu lub rozdzielacza."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
