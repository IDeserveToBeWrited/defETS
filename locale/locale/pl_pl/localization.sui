	val[]: "Kontroler lub joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Kontroler jest kierownicą lub coś, co działa tak jak ona. Pozycja kontrolera bezpośrednio określa pozycję kierownicy w grze."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Kontrolerem jest klasyczny gamepad lub joystick. Ich pozycja określa prędkość rotacji kierownicy w grze."
