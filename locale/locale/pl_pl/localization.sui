	key[]: "undo"
	val[]: "Cofnij" #+ Button to undo the previous input assignment.

	key[]: "press_key_to_assign"
	val[]: "NACIŚNIJ klawisz, który chcesz przypisać do tej funkcji." #+ Key/button assignment hint.

	key[]: "press_or_hold_key_to_assign"
	val[]: "NACIŚNIJ lub PRZYTRZYMAJ klawisz, który chcesz przypisać do tej funkcji." #+ Key/button assignment hint.

	key[]: "press_button_to_assign"
	val[]: "Naciśnij przycisk, który chcesz przypisać do tej funkcji."#+ Key/button/axis assignment hint.

	key[]: "select_input_to_unassign"
	val[]: "Wybierz urządzenie, dla którego chcesz anulować przypisanie." #+ Hint shown when "unassign" button pressed.

	key[]: "lost_function_binding"
	val[]: "Stracono przypisanie funkcji:" #+ Shown when key was rebound to a different function.

	key[]: "unavailable_assignment"
	val[]: "$INPUT$ nie może zostać użyty." #+ Shown when the player presses a key that cannot in input binding.

