
    key[]: "hint_engine_title"
	val[]: "Uruchom silnik"

    key[]: "hint_engine_text"
	val[]: "Użyj $KEY_engine$, aby uruchomić silnik."


    key[]: "hint_ignition_title"
	val[]: "Włącz zapłon"

    key[]: "hint_ignition_text"
	val[]: "Użyj $KEY_engineelect|KEY_engine$, aby włączyć zapłon."


    key[]: "hint_driv_arc_title"
	val[]: "Jazda"

    key[]: "hint_driv_arc_text"
	val[]: "Użyj $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ oraz $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, aby poruszać się do przodu lub do tyłu.<br><offset vshift=8>Użyj $SPECIAL_steering$, aby sterować."


    key[]: "hint_driv_auto_title"
	val[]: "Jazda"

    key[]: "hint_driv_auto_text"
	val[]: "Użyj $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ oraz $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, aby poruszać się do przodu lub do tyłu.<br><offset vshift=8>Użyj $SPECIAL_steering$, aby sterować.<br><offset vshift=8>Naciśnij $KEY_gearup$ i $KEY_geardown$, aby wybrać bieg."


    key[]: "hint_driv_seq_title"
	val[]: "Jazda"

    key[]: "hint_driv_seq_text"
	val[]: "Użyj $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ oraz $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, aby poruszać się do przodu lub do tyłu.<br><offset vshift=8>Użyj $SPECIAL_steering$, aby sterować.<br><offset vshift=8>Naciśnij $KEY_gearup$ i $KEY_geardown$, aby kontrolować sprzęgło."


    key[]: "hint_driv_hshift_title"
	val[]: "Jazda"

    key[]: "hint_driv_hshift_text"
	val[]: "Użyj $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ oraz $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, aby poruszać się do przodu lub do tyłu.<br><offset vshift=8>Użyj $SPECIAL_steering$, aby sterować.<br><offset vshift=8>Zmieniaj biegi za pomocą <color value=@@clr_sel@@>drążka zmiany biegów<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Zbliż się do celu"

    key[]: "hint_depot_deliv_text"
    val[]: "Zatrzymaj się w wyznaczonym obszarze, aby wybrać poziom trudności końcowego miejsca parkingowego i zdobyć odpowiednie doświadczenie."


    key[]: "hint_fin_deliv_title"
    val[]: "Ukończ dostawę"

    key[]: "hint_fin_deliv_text"
    val[]: "Zaparkuj w wybranym miejscu parkingowym. Możesz nacisnąć $KEY_activate$, aby je pominąć, gdy będziesz blisko punktu dostawy."


    key[]: "hint_fin_deliv2_title"
    val[]: "Ukończ dostawę"

    key[]: "hint_fin_deliv2_text"
    val[]: "Zaparkuj w wybranym miejscu parkingowym. Możesz włączyć widżet w @@desktop_menu_category_options@@, aby umożliwić pomijanie parkowania."


    key[]: "hint_lights_title"
    val[]: "Włącz światła"

    key[]: "hint_lights_text"
    val[]: "Użyj $KEY_light$, aby włączyć światła. Przełączaj się między różnymi trybami, naciskając ten klawisz wielokrotnie."


    key[]: "hint_high_beam_title"
    val[]: "Włącz światła drogowe"

    key[]: "hint_high_beam_text"
    val[]: "Użyj $KEY_hblight$, aby włączyć światła drogowe."


    key[]: "hint_wipers_title"
    val[]: "Włącz wycieraczki"

    key[]: "hint_wipers_text"
    val[]: "Użyj $KEY_wipers$, aby włączyć wycieraczki i przełączać się między różnymi ustawieniami prędkości."


    key[]: "hint_zoom_title"
    val[]: "Przyjrzenie się z bliska"

    key[]: "hint_zoom_text"
    val[]: "Użyj $KEY_camzoom$, aby przybliżyć widok we wnętrzu. Możesz ustawić tryb przybliżenia na przytrzymanie lub przełączanie w @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Rozglądanie się"

    key[]: "hint_cam_int_text"
    val[]: "Użyj $KEY_cam1$, aby zmienić widok na wnętrze."


    key[]: "hint_cam_ext_title"
    val[]: "Rozglądanie się"

    key[]: "hint_cam_ext_text"
    val[]: "Możesz przełączać się między różnymi kątami kamery, naciskając $KEY_camcycle$.<br><offset vshift=8>Użyj $KEY_cam2$, aby zmienić widok na zewnętrzny."


    key[]: "hint_indicators_title"
    val[]: "Kierunkowskazy"

    key[]: "hint_indicators_text"
    val[]: "Użyj $KEY_lblinker$ i $KEY_rblinker$, aby włączyć kierunkowskazy."


    key[]: "hint_tow_title"
    val[]: "Serwis holowniczy"

    key[]: "hint_tow_text"
    val[]: "Jeśli nie możesz wydostać się z trudnej sytuacji, możesz skorzystać z serwisu holowniczego. Aby uzyskać do niego dostęp, otwórz menu @@quick_info_word@@ za pomocą $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Blokada dyferencjału"

    key[]: "hint_diff_lock_text"
    val[]: "Jeśli nie możesz ruszyć z miejsca, być może pomoże Ci blokada mechanizmu różnicowego. Użyj $KEY_diflock$, aby ją aktywować, lub włącz automatyczną blokadę mechanizmu różnicowego w @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Blokada mechanizmu różnicowego włączona"

    key[]: "hint_diff_unlock_text"
    val[]: "Powinieneś odblokować mechanizm różnicowy podczas zwykłej jazdy, inaczej ryzykujesz jego uszkodzeniem. Użyj $KEY_diflock$, aby go dezaktywować, lub włącz automatyczną blokadę mechanizmu różnicowego w @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Wyłącz wycieraczki"

    key[]: "hint_wipers_off_text"
    val[]: "Użyj $KEY_wipers$, aby wyłączyć wycieraczki i przełączać się między różnymi ustawieniami prędkości."


    key[]: "hint_world_map_title"
    val[]: "Widok mapy"

    key[]: "hint_world_map_text"
    val[]: "Użyj $KEY_navmap$, aby otworzyć mapę świata."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Użyj $KEY_advmouse$, aby otworzyć @@quick_info_word@@ – przegląd Twojego statusu z wygodnymi skrótami."


    key[]: "hint_pause_border_title"
    val[]: "Lokalne przepisy"

    key[]: "hint_pause_border_text"
    val[]: "Użyj $KEY_advmouse$, aby otworzyć @@quick_info_word@@ i sprawdzić aktualne przepisy dla regionu, do którego wjechałeś."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Otwórz @@quick_info_word@@ za pomocą $KEY_advmouse$, aby wejść w @@photo_mode_word@@ i uchwycić pobliski @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ w pobliżu"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> jest w pobliżu - znajdź go i aktywuj, by zobaczyć cutscenkę."


    key[]: "hint_resting_title"
    val[]: "Miejsce odpoczynku w pobliżu"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


