#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "TRUCK STATE OVERVIEW" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "Condition" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Vehicle has significant mechanical issues affecting performace and reliability. You may need to consider a total restoration or replacement of multiple parts." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "Vehicle exhibits mechanical issues that could compromise its performance or reliability. Service is required." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Vehicle is roadworthy but may have some issues. Service is recommended." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Vehicle is in solid condition with only minor wear and tear." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Vehicle is in excellent condition with minimal wear." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Maintenance" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "Represents systemic aging and continuous wear increase across the whole vehicle. Fixed by total restoration." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Parts Wear" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "Mileage and accidents lead to wear and tear on individual parts. Monitor their condition and replace if necessary." #+ Explanation unfixable wear.
#@}

