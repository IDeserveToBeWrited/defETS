#@}

#+ Adjuster common
#+
#+ Common strings used in windows tweaking seat, mirror and lights.
#@{
	key[]: "reset_defaults_single"
	val[]: "Reset selected" #+ Button which applies the default configuration for only selected option controlled by screen.

	key[]: "reset_defaults_all"
	val[]: "Reset all" #+ Button which applies the default configuration to the state controlled by screen.
#@}

	key[]: "exit"
	val[]: "Close panel" #+ Label near button which will close the adjuster panel.


	key[]: "drive"
	val[]: "Drive" #+ Button switching from desktop to the game. Note that the space for this is limited so keep as short as possible.

	key[]: "drive_tooltip"
	val[]: "Back to the driver's seat." #+ Explanation of the button for switching to the desktop. There is more leniency in the translation character limit.

