	key[]: "eye_gaze_scale"
	val[]: "Gaze tracking speed"

	key[]: "eye_gaze_exponent"
	val[]: "Gaze tracking exponent"

	key[]: "eye_gaze_inflection_point"
	val[]: "Gaze tracking inflection point"

