#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Selects the controller subtype for the game to correctly handle input ranges."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Selects the transmission type:<br>- \"Simple automatic\" allows the use of the accelerator and brake to control forward and reverse motions.<br>- \"Real automatic\" requires an input to switch between forward and reverse gears.<br>- \"Sequential\" requires manual shifting of all gears with gear up/down inputs.<br>- \"H-Shifter\" requires the use of a controller with shift gates to select gears manually."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Changes the automatic transmission's gear-shift logic:<br>- \"Economy\" mode prefers lower RPMs biased towards peak torque.<br>- \"Power\" mode will bias towards peak horsepower for better driving performance with heavy loads or mountainous terrain at the expense of fuel economy."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the ratio of the device's degree of rotation to the vehicle's actual degree of steering rotation."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the linearity between input and vehicle steering.<br><br>Adjusting this value higher means the steering will be less responsive when the wheel is at centre, and will increase in sensitivity as the wheel is turned towards maximum lock. This can be helpful to smooth out steering inputs when driving straight."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Enables force feedback in controllers that support it."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the overall gain for all force feedback settings between 0N and 10N.<br><br><color value=@@clr_txt_d@@>Be aware that adjusting this to a higher setting in powerful wheel bases may cause injury to fingers or hands."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the centring force when driving at high speed, which peaks at 90 km/h (56 mph) and above.<br><br>The minimum setting will result in no wheel centring force."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the centring force when driving at low speed.<br><br>The minimum setting will result in no wheel centring force."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the strength of artificial internal friction caused by mechanical steering components."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the strength of artificial engine resonance through the steering column.<br><br><color value=@@clr_txt_d@@>Be aware that setting this value over 15% may cause excessive shaking and vibration in some wheels."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the strength of road surface effects though the steering column.<br><br><color value=@@clr_txt_d@@>Be aware that setting this value over 20% may cause excessive shaking and vibration in some wheels when driving on uneven terrain at speed."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the strength of road bump effects through the steering column."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the strength of collision effects through the steering column."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the intensity of the gearbox grinding effects."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the intensity of understeer slip effects."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts intensity of assisted steering (when using the lane assistant feature etc.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the intensity of terrain surface vibrations, if the controller supports vibration feedback."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the intensity of bump vibrations, if the controller supports vibration feedback."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the intensity of collision vibrations, if the controller supports vibration feedback."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used for steering."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the steering axis deadzone; the amount of rotation from the centre whereby input is ignored.<br><br>This can mitigate issues from older controllers such as inaccuracy or false input caused by wear and tear."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determines how the game handles the steering axis input:<br>- Centred is ideal for wheels or joysticks.<br>- Inverted is used to correct an axis that has been detected wrongly."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used to accelerate the vehicle."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the acceleration axis deadzone; the amount of input travel whereby no input is registered.<br><br>This can mitigate issues from older controllers such as inaccuracy or false input caused by wear and tear."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determines how the game handles controller input:<br>- Centred is ideal for joysticks.<br>- Normal is ideal for triggers or pedals.<br>- Inverted can compensate for inputs that were detected incorrectly."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used for braking."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the brake axis deadzone; the amount of input travel whereby no input is registered.<br><br>This can mitigate issues from older controllers such as inaccuracy or false input caused by wear and tear."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determines how the game handles controller input:<br>- Centred is ideal for joysticks.<br>- Normal is ideal for triggers or pedals.<br>- Inverted can compensate for inputs that were detected incorrectly."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used to engage the clutch."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the clutch axis deadzone; the amount of input travel whereby no input is registered.<br><br>This can mitigate issues from older controllers such as inaccuracy or false input caused by wear and tear."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determines how the game handles controller input:<br>- Centred is ideal for joysticks.<br>- Normal is ideal for triggers or pedals.<br>- Inverted can compensate for inputs that were detected incorrectly."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the range of the clutch.<br><br>The further to the right you set the range, the further you'll need to depress the pedal to engage the clutch."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used to tilt the camera up and down."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the Look up-down axis deadzone; the amount of input travel whereby no input is registered.<br><br>This can mitigate issues from older controllers such as inaccuracy or false input caused by wear and tear."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determines how the game handles the axis input:<br>- Centred is ideal for joysticks.<br>- Inverted is used to correct an axis that has been detected wrongly."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "The device axis to be used to pan the camera left and right."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the Look left-right axis deadzone; the amount of input travel whereby no input is registered.<br><br>This can mitigate issues from older controllers such as inaccuracy or false input caused by wear and tear."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determines how the game handles the axis input:<br>- Centred is ideal for joysticks.<br>- Inverted is used to correct an axis that has been detected wrongly."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Selects the gear layout to be used with the H-Shifter."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Changes the behaviour of the shifter:<br>- With the \"Simple\" option you will never grind gears when shifting.<br>- The \"Simple + warning sound\" option will allow to you shift simply as well, but with gear grinding sounds when you shift incorrectly.<br>- The \"Advanced\" option will not allow you to change gears if you shift incorrectly, and you will be met only with gear grinding sounds. The \"Advanced\" option also allows you to utilize the \"shifter fast split\" setting."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Choose how the game handles fast gear splits:<br>- \"Never\" will require the gear stick to be moved to neutral between splits.<br>- \"Clutch Press\" requires a momentary depression of the clutch with no gear stick movement.<br>- \"Throttle release\" requires the driver to only release the throttle to split gears with no gear stick movement, and \"clutch or throttle\" is a combination of the latter two."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the position of the shifter."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Assigns the input used to toggle between ranges based on the shifter layout."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Assigns button for toggling the shifter splitter based on the shifter layout."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Enable when using switches instead of buttons for range or splitter inputs."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Assigns button for switching to Drive mode of the automatic transmission."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Assigns button for switching to Reverse mode of the automatic transmission."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Enables dynamic RGB feedback on compatible devices."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Enables and configures eye tracking features for compatible devices."
