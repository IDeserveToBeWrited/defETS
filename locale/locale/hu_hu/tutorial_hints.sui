
    key[]: "hint_engine_title"
	val[]: "Motor beindítása"

    key[]: "hint_engine_text"
	val[]: "$KEY_engine$ segítségével indítsd be a motort!"


    key[]: "hint_ignition_title"
	val[]: "Gyújtás bekapcsolása"

    key[]: "hint_ignition_text"
	val[]: "$KEY_engineelect|KEY_engine$ segítségével kapcsold be a gyújtást!"


    key[]: "hint_driv_arc_title"
	val[]: "Vezetés"

    key[]: "hint_driv_arc_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$, illetve $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ segítségével haladj előre, illetve hátra!<br><offset vshift=8>$SPECIAL_steering$ segítségével kormányozz!"


    key[]: "hint_driv_auto_title"
	val[]: "Vezetés"

    key[]: "hint_driv_auto_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$, illetve $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ segítségével haladj előre, illetve hátra!<br><offset vshift=8>$SPECIAL_steering$ segítségével kormányozz!<br><offset vshift=8>$KEY_gearup$ és $KEY_geardown$ segítségével válts sebességet!"


    key[]: "hint_driv_seq_title"
	val[]: "Vezetés"

    key[]: "hint_driv_seq_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$, illetve $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ segítségével haladj előre, illetve hátra!<br><offset vshift=8>$SPECIAL_steering$ segítségével kormányozz!<br><offset vshift=8>$KEY_gearup$ és $KEY_geardown$ segítségével válts sebességet!"


    key[]: "hint_driv_hshift_title"
	val[]: "Vezetés"

    key[]: "hint_driv_hshift_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$, illetve $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ segítségével haladj előre, illetve hátra!<br><offset vshift=8>$SPECIAL_steering$ segítségével kormányozz!<br><offset vshift=8>Válts sebességet a <color value=@@clr_sel@@>sebességváltóval<color value=@@clr_txt@@>!"


    key[]: "hint_depot_deliv_title"
    val[]: "Úticél megközelítése"

    key[]: "hint_depot_deliv_text"
    val[]: "Állj meg a kijelölt területen, majd válaszd ki a parkolás nehézségét!"


    key[]: "hint_fin_deliv_title"
    val[]: "Fuvar befejezése"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkolj le a kiválasztott parkolóhelyre! $KEY_activate$ segítségével átugorhatod a parkolást, ha közel vagy a rakodóálláshoz."


    key[]: "hint_fin_deliv2_title"
    val[]: "Fuvar befejezése"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkolj le a kiválasztott parkolóhelyre! A @@desktop_menu_category_options@@ menüben engedélyezhetsz egy felugró ablakot, amivel átugorhatod a parkolást."


    key[]: "hint_lights_title"
    val[]: "Fényszórók felkapcsolása"

    key[]: "hint_lights_text"
    val[]: "$KEY_light$ segítségével kapcsold fel a fényszórókat! Ismételt megnyomással válts a fényszórók különböző módjai között!"


    key[]: "hint_high_beam_title"
    val[]: "Távolsági fényszórók felkapcsolása"

    key[]: "hint_high_beam_text"
    val[]: "$KEY_hblight$ segítségével kapcsold fel a távolsági fényszórót!"


    key[]: "hint_wipers_title"
    val[]: "Ablaktörlők bekapcsolása"

    key[]: "hint_wipers_text"
    val[]: "$KEY_wipers$ segítségével kapcsold be az ablaktörlőket, vagy állítsd be azok sebességét!"


    key[]: "hint_zoom_title"
    val[]: "Közelítés"

    key[]: "hint_zoom_text"
    val[]: "$KEY_camzoom$ segítségével közelíthetsz a beltéri kamerával. A nagyítás módját (nyomva tartás vagy be-/kikapcsolás) a @@desktop_menu_category_options@@ menüben állíthatod be."


    key[]: "hint_cam_int_title"
    val[]: "Körülnézés"

    key[]: "hint_cam_int_text"
    val[]: "$KEY_cam1$ segítségével válts belső nézetbe!"


    key[]: "hint_cam_ext_title"
    val[]: "Körülnézés"

    key[]: "hint_cam_ext_text"
    val[]: "A különböző kameranézetek között $KEY_camcycle$ segítségével tudsz váltani.<br><offset vshift=8>$KEY_cam2$ segítségével válts külső nézetbe!"


    key[]: "hint_indicators_title"
    val[]: "Irányjelzők"

    key[]: "hint_indicators_text"
    val[]: "$KEY_lblinker$ és $KEY_rblinker$ megnyomásával kapcsold be az irányjelzőket!"


    key[]: "hint_tow_title"
    val[]: "Vontatás szervizbe"

    key[]: "hint_tow_text"
    val[]: "Ha nehéz helyzetbe kerültél, hívhatsz egy vontatót. A vontató megrendeléséhez nyisd meg a @@quick_info_word@@ menüt $KEY_advmouse$ segítségével!"


    key[]: "hint_diff_lock_title"
    val[]: "Differenciálzár"

    key[]: "hint_diff_lock_text"
    val[]: "Ha nem tudsz elindulni, lehet, hogy a differenciálzár segíthet.<br>$KEY_diflock$ segítségével kapcsold be, vagy állítsd be az automata differenciálzárat a @@desktop_menu_category_options@@ menüben!"


    key[]: "hint_diff_unlock_title"
    val[]: "Differenciálzár bekapcsolva"

    key[]: "hint_diff_unlock_text"
    val[]: "Szabályos vezetés közben kapcsold ki a differenciálzárat, hogy elkerüld a károsodást. $KEY_diflock$ segítségével kapcsold ki a differenciálzárat, vagy állítsd be az automata differenciálzárat a @@desktop_menu_category_options@@ menüben!"


    key[]: "hint_wipers_off_title"
    val[]: "Ablaktörlők kikapcsolása"

    key[]: "hint_wipers_off_text"
    val[]: "$KEY_wipers$ segítségével állítsd be az ablaktörlők sebességét, vagy kapcsold ki azt!"


    key[]: "hint_world_map_title"
    val[]: "Térképnézet"

    key[]: "hint_world_map_text"
    val[]: "Nyisd meg a világtérképet $KEY_navmap$ segítségével!"


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Nyisd meg a @@quick_info_word@@ menüt $KEY_advmouse$ segítségével, hogy áttekinthesd a járműved állapotát és a főbb billentyűparancsokat."


    key[]: "hint_pause_border_title"
    val[]: "Helyi előírások"

    key[]: "hint_pause_border_text"
    val[]: "Nyisd meg a @@quick_info_word@@ menüt $KEY_advmouse$ segítségével, és tekintsd meg a jelenlegi régióra vonatkozó közlekedési előírásokat!"


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Nyisd meg a @@quick_info_word@@ menüt $KEY_advmouse$ segítségével, hogy megnyithasd a @@photo_mode_word@@ menüt a @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20> lefényképezéséhez!"


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ a közelben!"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> a közelben - találd meg, és aktiváld, hogy megtekinthesd az átvezetővideót!"


    key[]: "hint_resting_title"
    val[]: "Pihenőhely a közelben!"

    key[]: "hint_resting_text"
    val[]: "A pihenőhelyeken <img src=/material/ui/map/parking_ico.mat width=20 height=20> ki tudod pihenni a fáradtságot, és kötelező pihenőidőd után biztonságosan folytathatod az utadat."


    key[]: "hint_gas_title"
    val[]: "Töltőállomás a közelben!"

    key[]: "hint_gas_text"
    val[]: "A töltőállomásokon <img src=/material/ui/map/gas_ico.mat width=20 height=20> megtankolhatod a járművedet."
