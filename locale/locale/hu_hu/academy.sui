#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "Ezen gyakorlat során először nyílik lehetőséged fel- majd lekapcsolni egy félpótkocsit. Készítsd fel a kamiont az indulásra, majd tolass a mögötted lévő félpótkocsi alá!"

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Kapcsold fel a pótkocsit, majd indulj el előre!"

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Állj meg a megjelölt helyen!"

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Kapcsold le a pótkocsit, majd haladj tovább előre!"

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Parkolj le a parkolóhelyen, majd biztosítsd a kamiont!"


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "Ezen gyakorlat során számba vesszük a félpótkocsik fel- és lecsatlakoztatásának folyamatát. Vedd figyelembe, hogy a való élethez képest az itt lejátszható procedúra jóval egyszerűbb!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "A vontatód mögött egy félpótkocsi található. Tolass lassan a pótkocsi alá, amíg a nyeregszerkezeted el nem éri a királycsapot! A kamionod ezúttal pont a pótkocsi előtt áll, így a tolatás során nem kanyarodnod.<br><br><font face=/font/big_bold.font>Tolass, amíg nem érzed a csatlakozást! </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "A nyeregszerkezet rákapcsolódott a királycsapra!<br><br><font face=/font/big_bold.font>Biztosítsd a kamiont a rögzítőfék behúzásával! </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "A való életben a nyeregszerkezet automatikusan zárja a királycsapot. Azt követően a sofőrnek ki kell szállnia, és fel kell húznia a pótkocsi gólyalábait, valamint csatlakoztatnia kell a lég- és elektromos kábeleket.<br><br><font face=/font/big_bold.font>A játékban viszont a felkapcsoláshoz elég csak megnyomnod a következő gombot: @@imv_nrm_attach@@. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Most, hogy a vontató biztonságosan csatlakozik a pótkocsihoz, készen állsz az indulásra! Vedd figyelembe, hogy a pótkocsit vontató kamion lényegesen hosszabb és nehezebb szerelvény, így új készségeket igényel a vezetése!<br><br><font face=/font/big_bold.font>Oldd fel a rögzítőféket, és indulj el előre! </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Haladj előre!<br><br><font face=/font/big_bold.font>Állj meg a jelzett ponton! </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Húzd be a rögzítőféket! </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aktiváld a rögzítőféket! </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "A való életben a lekapcsolás folyamata bonyolultabb: a sofőrnek ki kell szállnia, majd le kell eresztenie a gólyalábakat, le kell csatlakoztatnia a lég- és elektromos kábeleket, majd ki kell oldania a nyeregszerkezet zárját.<br><br><font face=/font/big_bold.font>A játékban mindezek helyett elég csak a következőt megnyomnod a lekapcsoláshoz: @@imv_nrm_attach@@. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Oldd ki a rögzítőféket! </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Hajts ki a vontatóval a félpótkocsi alól, és haladj tovább előre!<br><br><font face=/font/big_bold.font>Állj meg a jelzett helyen! </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Fékezés pótkocsival"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "Ezen gyakorlat során megtapasztalhatod, hogy milyen érzés pótkocsival vezetni és fékezni."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Elindulás"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Lejtmenet"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "60 km/h (37 mph) elérése"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Fékek használata"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
