#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Megállás akadály közelében"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Ezen gyakorlat során bemutatjuk az elülső tükröt - azaz, hogy hol található, és hogy hogyan használd, hogy megállj egy előtted lévő akadály előtt."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Elülső tükör ellenőrzése"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "A használat megértése"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Megállás az akadály közelében"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "A kamionoknak igen nagy holtterük van az orruk előtt, emiatt könnyű elveszteni szem elől az ott haladó gyalogosokat és autókat. A kamionokat épp ezért elülső tükörrel is felszerelik, amellyel a szélvédőn keresztül belátható ez a terület."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Az elülső tükör eme holttér ellenőrzésére szolgál.<br>Ennek megfelelően lényeges eszköz, amellyel biztosíthatod, hogy semminek nem mész neki, amikor szűk környezetben kell manőverezned."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Indulj el, haladj az előtted lévő akadály felé, majd lassíts, amint a közelébe érsz!<br>Tartsd a szemedet az elülső tükrön!"

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Állj meg a vonal és az akadály között!"

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Ezen gyakorlat során a diagramon mutatott elülső tükör használatát fogjuk megtanulni.<br><br><font face=/font/big_bold.font>Nézz a szélvédő teteje felé, hogy megtaláld a tükröt!</font>@@aca_goal_tip@@ Ehhez használd a beltéri nézetet!"

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Az elülső tükör segítségével ráláthatsz a kamion előtti holttérre. Ennek segítségével óvatosabban, precízebben tudsz vezetni.<br><br>Ha nem vagy elégedett a tükör állásával, nyisd meg a következőt: '@@adjust_link_t@@' (a Szünet menüből érhető el), és állítsd be a tükröt!<br><br><font face=/font/big_bold.font>A folytatáshoz nyomd meg a következőt: @@imv_nrm_activate@@! </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "A kamion előtt kijelöltünk egy pontot. Mint azt látni fogod, a pont másik oldalán egy akadály került elhelyezésre. Amint annak a közelébe érsz, alaposan lassíts le, és használd az elülső tükröt, hogy megállapítsd az akadálytól való távolságodat!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "A kamion még mindig nem tud elindulni! Lehet, hogy megfeledkeztél valamiről?<br><br>Jár a motor? Feloldottad a rögzítőféket?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Hajts tovább a parkolóhely felé! </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Állj meg a kamionnal az akadály és az útburkolati jel között! </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

