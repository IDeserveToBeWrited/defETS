#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Próbáljuk ki, hogy milyen pótkocsival tolatni! Ne aggódj, mert egyszerűbb, mint amilyennek tűnik - csak türelmesnek kell lenned!"

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Kezdd el a tolatást, és állj a vontatóval a pótkocsi vonalába!"

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Ügyelj rá, hogy egy vonalban legyen a vontató a félpótkocsival, különben nem tudod felcsatolni! Ha elsőre nem sikerül, csak hajts előrébb, majd próbálkozz újra!"

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "A vontató nyeregszerkezete rögzíti majd a pótkocsi királycsapját."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Húzd be a rögzítőféket, és kapcsold fel a pótkocsit! A való életben ehhez ki kellene szállnod, hogy bekösd a lég- és elektromos kábeleket, valamint hogy feltekerd a gólyalábakat, de a játékban ezt a munkát elvégezzük helyetted!"

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>A pótkocsi mindig a vontató irányával <color value=@@clr_sel@@>ellentétes<color value=@@clr_txt@@> irányba fordul."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>A pótkocsi adott irányba állításához kormányozd a vontatódat az <color value=@@clr_sel@@>ellentétes<color value=@@clr_txt@@> irányba!"

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>A szerelvény egyenesbe hozásához kanyarodj a vontatóval<br>a pótkocsi <color value=@@clr_sel@@>felé!<color value=@@clr_txt@@>"

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Próbálj meg egy vonalban maradni a pótkocsival! Készülj fel rá, hogy kisebb korrekciókat kell majd eszközölnöd ahhoz, hogy a pótkocsi a megjelölt terület felé nézzen!"

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Javítsd ki apróbb kormánymozdulatokkal az útvonaltól való esetleges eltéréseket, amint csak tudod! Ha nagyon túlkormányzod a szerelvényt, könnyen letérhetsz a kívánt útvonalról!"

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Állj meg a megjelölt helyen, majd biztosítsd a kamiont, és állítsd le a motort!"

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Mögötted, az utas felőli oldalon egy félpótkocsi parkol. Az első feladatod, hogy odatolass hozzá!<br><br><font face=/font/big_bold.font>Készülj fel a tolatásra! </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Kezdj el a pótkocsi felé tolatni! </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Igazítsd be a kamiont úgy, hogy egy vonalban legyen a pótkocsival! A nyeregszerkezet csak így tudja rögzíteni a királycsapot! Indulj el felé, és igazítsd ki az irányt, ha szükséges!<br><br><font face=/font/big_bold.font>Folytasd a tolatást, amíg el nem éred a királycsapot! </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "A nyeregszerkezet kapcsolódótt a királycsaphoz, így befejezheted a pótkocsi felkapcsolását!<br><br><font face=/font/big_bold.font>Húzd be a rögzítőféket! </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font>A pótkocsi felcsatolásához nyomd meg a következőt: @@imv_nrm_attach@@! </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Most, hogy a pótkocsit felcsatoltad, automatikusan csatlakoztattuk a lég- és elektromos kábeleket, valamint felhúztuk a gólyalábakat!<br><br><font face=/font/big_bold.font>Oldd ki a rögzítőféket! </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Tolass a közvetlenül mögötted lévő parkolóhelyre! Ne feledd, hogy ha tolatás közben kanyarodni kezdesz, akkor a pótkocsi mindig a kormányzásod irányával ellentétes irányba fordul! Akár egy enyhe kormánymozdulat is jelentősen elmozdíthatja a pótkocsit!<br><br><font face=/font/big_bold.font>Kezdd el a tolatást a pótkocsival! </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Ne kormányozd túl a szerelvényt! Csak tartsd a parkolóhely irányában!<br><br><font face=/font/big_bold.font>Folytasd az utat a parkolóhely felé! </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkolás szűk helyen"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "Ezen gyakorlat során egy szűk helyre kell beállnod.<br><br>Ehhez úgy kell manőverezned a pótkocsiddal, hogy egyenesbe hozd a parkolóhellyel!"

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Beállás a helyre"
#!{
	key[]: "aca_goal_book1_3_06_stop"
