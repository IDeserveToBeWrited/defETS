#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Ezen gyakorlat során egy útpadka melletti parkolóhelyre kell betolatnod."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Tolass a padka felé!<br>Mivel elengedhetetlen, hogy tisztában légy közben a környezeteddel, használd a tükröket!"

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Amint a hely közelébe érsz, igazítsd be a kamiont a parkolóhelyre! Tolatás közben ellenőrizd a kamion mindkét oldalát!"

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Állj meg a parkolóhelyen, majd biztosítsd a kamiont!"

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "A parkolóhely mögötted, az utasoldalon található. Használd a tükröket, hogy oda találj a parkolóhelyhez!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra!</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Ne felejtsd el ellenőrizni a közvetlen környezetedet a tükrökkel, mielőtt elindulsz!<br><br><font face=/font/big_bold.font>Kezdd el a tolatást a padka felé! </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Folytasd a közvetlen környezeted ellenőrzését, amíg betolatsz a parkolóhelyre!<br><br><font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

