#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Felállítottunk előtted pár szűk kanyart, amelyeknél igen kevés a hely. Ezek segítségével megtanulhatod, hogy hogyan manőverezz hatékonyan a pótkocsival."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Kövesd a vezetőoldalon felállított akadály felé mutató jelzéseket, hogy felkészülj az első kanyarra!"

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "A kanyar bevétele során maradj közel a külső akadályhoz! Így a pótkocsi gond nélkül fogja követni a vontatódat!"

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Kövesd az útburkolati jeleket a második fordulóhoz: egy szűk derékszögű kanyarhoz."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Ebbe a kanyarba elég mélyen bele kell majd hajtanod, hogy a pótkocsid ne menjen neki a belső akadályoknak! Használd az elülső tükröt, hogy olyan mélyen hajthass be a fordulóba koccanás nélkül, amennyire csak lehet!"

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Folytasd az utat a külső akadály mentén!"

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Egy másik szűk, derékszögű kanyart is be kell majd venned, amelynél a teljes rendelkezésre álló teret ki kell majd használnod!"

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Állj meg a megadott helyen, majd biztosítsd a kamiont!"

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Ne feledd: használd ki a teljes rendelkezésre álló területet a kanyarok teljesítéséhez!<br><br><font face=/font/big_bold.font>Indulj el, és kövesd az útburkolati jeleket! </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Haladj a külső akadály mentén, de tartsd a szemedet a pótkocsin a visszapillantó tükröd segítségével!<br><br><font face=/font/big_bold.font>Vedd be az első kanyart! </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Kövesd az útburkolati jeleket, hogy felkészülhess az előtted álló derékszögű kanyarra!<br><br><font face=/font/big_bold.font>Vedd be a derékszögű kanyart! </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Tartsd a széles ívet a kamionnal a kanyar bevétele után, mert azt követően egy még szűkebb derékszögű kanyar vár majd rád!<br><br><font face=/font/big_bold.font>Haladj tovább! </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Haladj tovább a parkolóhely felé!</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Ferde parkolás hátramenetben"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Ezen gyakorlat során egy ferde parkolóhelyre kell betolatnod, ami gyakran előfordulhat autópálya pihenőknél, kamionos pihenőknél, és telephelyeken is. Mivel eme parkolóhelyek gyakran tobzódnak az álló kamionokban, a szűk tér komoly parkolási kihívást jelent."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Pótkocsi bekormányzása"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "A ferde parkolás elsőre egyszerű manővernek tűnhet, de sokszor komolyabb kihívást jelent, mint a rakodóállásokba való betolatás."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Tolass be a parkolóhelyre! Ezen a ponton még tartsd egyenesen a szerelvényt!"

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Ahogy közelebb érsz, hagyd, hogy a pótkocsi közel kerüljön a parkoló kamionokhoz! Így könnyebben be tudod majd kormányozni a parkolóhelyre, amint eléred."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Kezdd el bekormányozni a pótkocsit a parkolóhelyre! Tartsd a pótkocsit a vezetőoldalon parkoló kamion közelében, mert szükséged lesz az utasoldali térre!"

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Amint a pótkocsi java elérte a parkolóhelyet, kezdj el bekanyarodni a vontatóval, hogy lekövesd a pótkocsit!"

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Állj meg a megjelölt helyen, majd biztosítsd a kamiont, és állítsd le a motort!"

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Állj be a kamionoddal a mögötted lévő helyre! Használd mind a két tükröt a tolatási manőverhez!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Ellenőrizd a közvetlen környezetedet, majd indulj el a parkoló felé!<br><br><font face=/font/big_bold.font>Kezdj neki a tolatásnak!</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Kezdd el a pótkocsit a melletted álló kamionok felé fordítani! Amint készen állsz, kormányozd be a pótkocsit a parkolóhelyre! Ne feledkezz meg a pótkocsi hátuljának túlnyúlásáról!<br><br><font face=/font/big_bold.font>Kanyarodj be a parkolóhelyre!</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Kanyarba tolatás pótkocsival"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Ezen gyakorlat során először kell betolatnod a pótkocsiddal egy kanyarba. A gyakorlat során számba vesszük a tolatás alapjait, és hogy mire kell odafigyelned, ha tolatás közben kanyarodnod kell."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Pótkocsi bekormányzása"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Ezen gyakorlat során egy, a vezetőoldalon található parkolóhelyre kell betolatnod."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Ne feledkezz meg a korábban már megtanult, tolatással kapcsolatos tippjeinkről!<br>Az első, hogy a pótkocsi mindig a vontató kormányzásával ellentétes irányba fordul!"

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "A második, hogy mindig jó képet kaphatsz arról, hogy merre halad a pótkocsi, ha odafigyelsz a vontató és a pótkocsi tengelyeire."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "A harmadik, hogy kisebb iránykorrekciókkal hamarabb célba érsz. Ne kormányozd túl a szerelvényt!"

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Kezdj el enyhén elkanyarodni a vontatóval a parkolóhelytől! A pótkocsit így afelé tudod irányítani!"

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Kövesd a pótkocsit, és a parkolóhely felé haladva végezd el a szükséges iránykorrekciókat!"

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Tartsd szemmel a pótkocsi kerekeit és a vontató hátsó kerekét! Így tudni fogod, hogy merrefelé áll a pótkocsi, és hogy merre tolja a vontató!"

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "A negyedik tippünk, hogy mindig egyszerűbb élesen befordulni egy pótkocsival, mint kiegyenesíteni a szerelvényt egy becsuklásból! Célozd be a parkolóhely szélét amíg a közelébe nem érsz, majd vegyél egy élesebb kanyart, hogy beigazítsd a pótkocsit!"

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Amint a pótkocsi eléri a parkolóhelyet, fordulj a vontatóval a pótkocsi elé! Végezz minél kevesebb igazítást a parkolóhelyen manőverezve!"

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Tolass be az akadályok közé, és menet közben ellenőrizd a szerelvény mindkét oldalát!"

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Biztosítsd a kamiont, és állítsd le a motort!"

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Ne felejtsd el a következő tippeket, ha tolatás közben kanyarodnod kell a pótkocsiddal:<br><br>— A pótkocsi mindig a vontató kormányzásával ellentétes irányba fordul.<br><br>— Figyeld a pótkocsi kerekeit, hogy lásd, merre halad!<br><br>— Figyeld a vontató hátsó kerekét, hogy lásd, hova tolja a pótkocsit!<br><br>— Hagyd \"dolgozni\" a pótkocsit, és ne kormányozd túl!<br><br>— Mindig könnyebb élesen befordítani a pótkocsit, mint egyenesbe hozni.<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Nézz hátra, hogy megtaláld, merre kell menned! Tolatás előtt mindig ellenőrizd a közvetlen környezetedet!<br><br><font face=/font/big_bold.font> Kezdd el a tolatást a parkolóhely felé! </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Kezdd el a parkolóhely felé kormányozni a pótkocsit, majd kövesd a vontatóval!</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
