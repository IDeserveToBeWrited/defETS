#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Üdvözlünk a záróvizsgád első részén! Ideje megmutatnod, hogy mennyire sikerült megtanulnod kamiont vezetni az itt eltöltött időd alatt!"

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Először is, kapcsold fel a pótkocsit! Amint rácsatlakoztál, az egész vezetéstechnikai központot be fogod járni vele!"

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Az út első szakasza a kis parkolótól a keleti oktatópályához vezet."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "A körpálya akadályok között kialakított, kihívásokkal teli szakaszokból áll."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Az út jelentős része a keleti oktatópályán halad át."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Itt különböző körülmények között mutathatod be, hogy milyen jól manőverezel a szerelvénnyel."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "A kamionoddal pár éles kanyaron is át kell majd haladnod."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Azt követően az oktatópályákat összekötő úton kell továbbhaladnod."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Végezetül teljesítened kell egy kis körpályát is."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Az aréna több összetett szakaszból és éles fordulóból áll."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "A vizsga befejezéséhez állj meg pontosan a kijelölt helyen!"

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "És csak nyugi! Ne idegeskedj, mert már mindent tudsz, ami a vizsga teljesítéséhez szükséges!<br><br>Sok sikert!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "A pótkocsi előtted áll. <br><br><font face=/font/big_bold.font>Hajts oda a pótkocsihoz! </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Igazítsd be a vontatót a pótkocsi elé!<br><br><font face=/font/big_bold.font>Tolass a pótkocsira, majd rögzítsd a királycsapot! </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Biztosítsd a vontatót! </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>A pótkocsi felcsatolásához nyomd meg a következőt: @@imv_nrm_attach@@! </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Felcsatoltad a félpótkocsit, a kamion így készen áll az indulásra!<br><br><font face=/font/big_bold.font>Oldd ki a rögzítőféket! </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Indulj el, és hagyd el a parkolót! </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Kövesd az útburkolati jeleket, és figyelj oda az akadályokra!<br><br><font face=/font/big_bold.font>Folytasd a vezetést! </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Egy nehezebb szakasz felé közeledsz.<br><br><font face=/font/big_bold.font>Haladj át óvatosan az akadályok között! </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Haladj tovább! </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Ezen a szakaszon bemutathatod, hogy mennyire ügyesen tudsz manőverezni a pótkocsiddal a különböző fordulókban.<br><br><font face=/font/big_bold.font>Fordulj rá a pályára!</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Haladj át a szakaszon! </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Haladj tovább egyenesen! </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Haladj át óvatosan a fordulón! </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Egy összetettebb szakaszhoz érkeztél. Vezess óvatosan!<br><br><font face=/font/big_bold.font>Haladj tovább a lejtőn! </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Vedd be az éles balkanyart! </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Hagyd el a körpályát! </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Most egy egyszerűbb szakasz következik.<br><br><font face=/font/big_bold.font>Hajts le a dombon! </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Haladj tovább az úton! </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Hamarosan ráfordulhatsz a következő oktatópályára!<br><br><font face=/font/big_bold.font>Haladj tovább! </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Fordulj jobbra! </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Haladj tovább a pályán! </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Élesebb kanyarok következnek!<br><br><font face=/font/big_bold.font>Vezess ennek megfelelő sebességgel! </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Kanyarodj balra! </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Haladj tovább! </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Érj be a fordulóba, és haladj tovább! </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "A forduló teljesítéséhez lehet, hogy részben el kell hagynod az úttestet!<br><br><font face=/font/big_bold.font>Fordulj be óvatosan, és használj annyi területet, amennyire szükséged van!</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Hagyd el a pályát, és hajts a parkolóhelyedhez! </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Záróvizsga (2. rész)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "A záróvizsgád második feléhez érkeztünk, amely során a parkolási készségeidről kell számot adnod az előző leckékben megtanult módon. Ha sikerül pontosan és óvatosan leparkolnod mindegyik helyre, akkor valóban készen állsz képzett kamionsofőrként meghódítani Európa útjait!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Átállás másik parkolóhelyre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Ferde parkolás"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Áthajtás a parkolón"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Párhuzamos parkolás"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Utolsó parkolás"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Üdvözlünk a záróvizsgád második részében! Ezúttal egy közeli parkolóhoz hajtunk majd, ahol a tolatási és parkolási készségeidről adhatsz számot!"

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Ennek során több parkolási kihívást kell majd teljesítened."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "A terület szűkös lesz, szóval légy óvatos, és ne siesd el a dolgot!"


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Ne rohanj, és manőverezz óvatosan! Nem lesz semmi baj, ha nem sikerül elsőre megcsinálnod egy feladatot. A legfontosabb a kamion és a körülötted lévők épsége!<font face=/font/big_bold.font><br><br>Készülj fel az indulásra!</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Indulj el a vizsga első állomása felé!</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Az első feladatod, hogy átállj egy másik parkolóhelyre. A hely, ahova be kell tolatnod, tőled balra található.<br><br><font face=/font/big_bold.font>Végezd el a parkolási feladatot!</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "A következő feladatban álló kamionok közé kell beállnod. Légy óvatos, és ne menj neki egyik járműnek sem!<br><br><font face=/font/big_bold.font>Végezd el a ferde parkolást!</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Haladj tovább a parkolóban, és készülj fel az esetleges váratlan helyzetekre!<br><br><font face=/font/big_bold.font>Folytasd az utat!</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Most pedig állj be párhuzamosan a két kamion közé az előtted lévő padkánál!<br><br><font face=/font/big_bold.font>Hajtsd végre a párhuzamos parkolást!</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Tőled balra az utolsó parkolási feladatot találhatod! Rád bízzuk, hogy miként hajtod végre a gyakorlatot!<br><br><font face=/font/big_bold.font>Tolass be a megadott helyre!</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Már majdnem készen vagy! Hagyd el a vizsgaterületet, és parkold le a kamiont!<br><br><font face=/font/big_bold.font>Hagyd el a területet bal kéz felé továbbhaladva!</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "You can park the truck on the right with the others.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Párhuzamos parkolás pótkocsival"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "Ezen gyakorlat során a pótkocsiddal együtt kell elvégezned egy párhuzamos parkolást."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Megállás a megjelölt helyen"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "A pótkocsival történő párhuzamos parkolás minden kamionsofőr számára fontos készség.<br>Történjék akár egy nagyváros utcáján, akár egy vidéki pihenőhelyen, ezt a manővert minden sofőr el kell, hogy tudja végezni."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "A parkolóhely mellett elhaladva ellenőrizd, hogy elegendő helye lesz-e a vontatónak és a pótkocsinak is a beálláshoz. Ebben a gyakorlatban elég helyet biztosítottunk a manőverhez."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Igazítsd a kamionodat a parkolóhely előtt álló kamionhoz, de ne állj túl közel hozzá! Helyette tarts elegendő távolságot, hogy elég helyed legyen a manőverezéshez!"

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Utána fordulj el élesen a parkolóhelytől, és kezdj neki a tolatásnak! A cél az lenne, hogy a pótkocsit azonnal a parkolóhelyre kormányozd!"

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Amint a pótkocsi java elérte a parkolóhelyet, kövesd a vontatóval!"

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Kezdd el elkormányozni a pótkocsit az útpadkától még azelőtt, hogy a pótkocsi vezetőoldali kerekei elérnék a parkolóhelyet!"

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Hozd egyenesbe a szerelvényt, majd igazítsd középre a vontatót és a pótkocsit a parkolóhelyen!<br>Végül állj meg, állítsd le a motort, és biztosítsd a kamiont!"

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "A parkolóhely, ahova be kell állnod, előtted található két kamion között. Parkoláskor használd a tükröket, és tarts biztos távolságot a körülötted lévő akadályoktól!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra!</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Hajts át a parkolón, hogy megtaláld a parkolóhelyedet!<br><br><font face=/font/big_bold.font>Haladj előre! </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Hajts el a kívánt parkoló mellett, és állj meg a megjelölt helyen! Innen kell majd elkezdened a tolatási manővert.<br><br><font face=/font/big_bold.font>Állj meg a megjelölt helyen!</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Kormányozd el a vontatót a parkolóhelytől, hogy felé irányítsd a pótkocsit! Ne fordulj azonban túl élesen, különben a padka felé veszed az irányt!<br><br><font face=/font/big_bold.font>Kezdj neki a tolatásnak!</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Igazítsd a pótkocsit a parkolóhelyhez! Ha kell, indulj meg előre vagy hátra, és közben korrigálj a kormánnyal, hogy véglegesítsd a pozíciódat!<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Gratulálunk! Sikeresen teljesítetted \"A kamionvezetés alapjai\" modul vizsgáit, és így megszerezted mindazon tudást, amely a kamionod megfelelő manőverezéséhez szükséges!"

	key[]: "aca_msg_book1_outro02"
	val[]: "Ez az első lépés azon a hosszú úton, amelynek a végén teljesülhet az álmod, és szakképzett kamionsofőrré válhatsz!"

	key[]:	"aca_msg_book1_outro03"
	val[]: "Immár készen állsz rá, hogy bejárd Európa útjait, és teljesítsd az első közúti kihívásokat..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...de a kalandod még csak most kezdődik!"
#@}


