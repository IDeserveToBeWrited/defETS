	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Behajtás a tesztpályára"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Felkészülés az utasoldali tolatásra"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Betolatás a megjelölt helyre"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Utasoldali tolatás végrehajtása"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Gyakorlópálya elhagyása"
