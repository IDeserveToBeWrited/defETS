#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Leparkolás akadály mellé"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Ezen gyakorlat során megtanulhatod, hogy hogyan állj meg az útpadka mellett az oldalsó tükör segítségével."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Oldalsó tükör ellenőrzése"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Haladás a padka felé"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Az oldalsó tükör szintén egy hasznos, a biztonságos manőverezést elősegítő eszköz. A tükör az utasoldali ajtó keretének tetején található."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Haladj előre, majd lassan kanyarodj az utasoldal felé!"

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Ezek a palánkok az útpadkát jelképezik, ami mellé le kell parkolnod.<br>Fordulj a padka felé, hogy megfelelő pozícióba állítsd a kamiont a parkolóhelyre való beálláshoz!"

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Lassíts le még jóval a padka előtt, majd kanyarodj a parkolóhely felé! Amint egyenesbe állítottad a gépet, használd az oldalsó tükröt, hogy megbecsüld a padkától való távolságodat!"

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Állj meg a parkolóhelyen, majd biztosítsd a kamiont!"

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Nézz ki az utasoldali ajtó ablakán, hogy megtaláld az oldalsó tükröt!</font>@@aca_goal_tip@@ Használd a beltéri nézetet!"

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Az oldalsó tükörrel a kamion utasoldalának azon részét ellenőrizheted, amelyet szabad szemmel nem tudsz belátni. Ez talán a kamion legproblematikusabb holttere. Ha a tükör látószöge nem megfelelő, állítsd be a következővel: '@@adjust_link_t@@'!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "A kamion még mindig nem tud elindulni! Lehet, hogy megfeledkeztél valamiről?<br><br>Jár a motor? Feloldottad a rögzítőféket?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Előtted egy sor palánk került elhelyezésre, amelyek az útpadkát szimulálják. A padka végén egy parkolóhely található. Hajts oda! <br><br><font face=/font/big_bold.font>Indulj el, amint készen állsz! </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Fordulj a padka felé! Használd az elülső és oldalsó tükröket, hogy ellenőrizd a padkához viszonyított pozíciódat, és hogy ne menj neki egyik bójának sem!<br><br><font face=/font/big_bold.font>Indulj el a padka, majd a parkoló felé!</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Biztosítsd a kamiont, majd állítsd le a motort!</font>@@aca_goal_tip@@ A különböző beltéri kamera sablonok segítségével megkönnyítheted a tükrök használatát. A vonatkozó beállításokat a játékbeállítások \"Billentyűk és gombok\" listájában találhatod."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Hátramenetben leparkolás akadály mellé"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Ezen gyakorlat során megtanulhatod, hogy miként tolass be egy útpadka melletti parkolóhelyre."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instrukciók"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Tolatás a padka felé"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Leparkolás a kamionnal"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

