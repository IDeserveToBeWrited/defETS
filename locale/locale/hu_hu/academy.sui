	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Tolatás szűk parkolóban"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Ezen gyakorlat során egy forgalmas területen kell betolatnod a megadott parkolóhelyre."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Pótkocsi bekormányzása"
