#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "A körforgalom gyakori forgalomszervezési megoldás Európa utcáin, így fontos megtanulnod, hogy hogyan kezeld őket."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Ha körforgalom felé közeledsz, maradj a sávod szélén! Így a pótkocsidnak elegendő helye marad a bekanyarodáshoz."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "A behajtás során hajts a körforgalom közepe felé, amint pedig beértél, tarts a széle felé! Így távol tarthatod a pótkocsidat a körforgalom közepétől!"

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Tartsd a szemedet a visszapillantó tükrön, hogy ellenőrizd, nem kerül-e veszélyesen közel a pótkocsi a belső akadályokhoz!"

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "A körforgalom elhagyása viszonylag egyszerű, mivel ezen a ponton a pótkocsid már nem a kijárat belseje felé tájolódik. Hajts ki nagy ívben, és a pótkocsi gond nélkül követni fog!"

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "A gyakorlat végeztével parkolj le a megadott helyen, és biztosítsd a kamiont!"



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Egy körforgalmat alakítottunk ki előtted, amelyen át kell hajtanod.<br><br><font face=/font/big_bold.font>Közelítsd meg lassan a körforgalmat! </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Kanyarodj be nagy ívben a körforgalomba, hogy a pótkocsi gond nélkül követhessen!<br><br><font face=/font/big_bold.font>Hajts be a körforgalomba! </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Haladj a körforgalom külseje felé! Tartsd a kamiont olyan távol a körforgalom közepétől, amennyire csak lehet, hogy távol tartsd a pótkocsit a középen található akadályoktól!<br><br><font face=/font/big_bold.font>Haladj tovább a körforgalomban!</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Maradj a külső bóják közelében! <br><br><font face=/font/big_bold.font>Haladj tovább!</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Hagyd el a körforgalmat!</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Haladj tovább a parkolóhely felé!</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Biztosítsd a kamiont, és állítsd le a motort! </font>"
#@}

#+ Book 1 Scenario 3_12
