	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Az előremenetben elvégzett parkolás (avagy \"orral beállás\") az egyszerűbb parkolási manőverek közé tartozik.<br>Viszont ekkor is oda kell figyelned a pótkocsid állására!"

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Ha pótkocsit vontatsz, akkor túl kell hajtanod azon a ponton, ahol csak a vontatót vezetve ráfordulnál a parkolóhelyre. Így jobban irányba tudod állítani a pótkocsit."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "A parkolóhely felé közeledve hozd egyenesbe a vontatót a pótkocsival és a parkolóhellyel, majd állj be!<br>Állj meg, parkolj le, majd biztosítsd a szerelvényt, és állítsd le a motort!"

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Kijelöltünk előtted egy parkolóhelyet, ahova be kell állnod.<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Indulj el, és fordulj rá a parkolóhelyre!</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Hajts túl a parkoló vonalán, hogy irányba állíthasd a pótkocsidat a megjelölt ponttal, majd fordulj rá a parkolóra a vontatóval, és hozd egyenesbe a szerelvényt!<br><br><font face=/font/big_bold.font>Parkolj le a megadott helyen! </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Biztosítsd a kamiont, és állítsd le a motort! </font>"
#@}

