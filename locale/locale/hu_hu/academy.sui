	key[]: "aca_book_disclaimer_topbar"
	val[]: "Ez nem hitelesített oktatóprogram!"

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>A játék vezetésoktatási modulja nem helyettesíti a valós oktatójárművel való oktatást!</font><br><br> <color value=@@clr_txt@@>Épp ezért, mielőtt megkísérelnél a való életben kamiont vezetni, erősen javasoljuk, hogy vegyél részt egy akkreditált tehergépkocsi-vezetői tanfolyamon!<br><br>A vezetésoktatási modulunkat felhasználni kívánó képzési központok megkeresését az academy@scssoft.com email címre várjuk."

	key[]: "aca_book_book1_title"
	val[]: "A kamionvezetés alapjai"

	key[]: "aca_book_book1_desc"
	val[]: "Sajátítsd el a kamionvezetés alapjait, az alapvető funkcióktól és kezelőszervektől kezdve a pótkocsival való manőverezésig!"

	key[]: "aca_book_book2_title"
	val[]: "Haladó kamionvezetési gyakorlatok"

	key[]: "aca_book_book2_desc"
	val[]: "Fejleszd tovább kamionvezetői tudásodat új, nehezebb körülmények között tartott gyakorlatokkal!"

	key[]: "aca_book_book3_title"
	val[]: "Dupla pótkocsik kezelése"

	key[]: "aca_book_book3_desc"
	val[]: "Nézz szembe a dupla pótkocsikkal való vezetés és tolatás kihívásaival!"

#@}

