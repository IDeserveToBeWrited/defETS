#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Ezen fejezet utolsó gyakorlatában egy komplex elrendezésű tesztpályát kell teljesítened."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Az első akadályt egy szlalom szakasz adja. Hajts át rajta, és ne felejtsd el használni a tükreidet!"

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Azt követően egy hajtűkanyart kell teljesítened. Kanyarodj széles ívben, és akkor nem jelenthet gondot!"

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Itt egy derékszögű balkanyart állítottunk fel. Ne felejts el mélyen behajtani a fordulóba, hogy a kamion hátulja távol álljon a belső akadályoktól!"

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "A rámpás akadály kicsit trükkös lehet! Mielőtt felhajtanál rá, állj irányba, amennyire csak tudsz, és használd a tükröket, hogy megfelelően tájékozódhass!"

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "A következő feladatot tolatva kell teljesítened, így annak megfelelően közelítsd meg az akadályokat!"

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Kövesd a mögötted és tőled jobbra található jelzéseket!"

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Tolass az akadályokhoz, majd állj meg, és folytasd tovább balra az utadat!"

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "A továbbhaladáshoz hajts át a középen található átjárón!"

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Ez egy felettébb szűk átkelőhely! Hajts hát lassan, és használd a tükröket, hogy megfelelően tájékozódhass ezen a szakaszon!"

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Ne felejts el mélyen behajtani a derékszögű fordulóba!"

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Ezt követően egy kellemesen nyílt útszakasz következik. Itt ráléphetsz a gázra, de ügyelj rá, hogy időben megállj majd a közelgő kanyar előtt!"

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "A lejtő alján pár akadályt helyeztünk el az úttesten. Hajts oda hozzájuk, majd tolass a balra található parkolóhelyre!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Tolass be a parkolóhelyre!"

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parkolj le, állítsd le a motort, és biztosítsd a kamiont!"

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Egy szlalompálya felé közeledsz.<br><br><font face=/font/big_bold.font>Hajts át a szlalomon!</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Tarts a kanyar külső íve felé! Így elkerülheted, hogy a vontató hátuljával ráhajts az útpadkára!<br><br><font face=/font/big_bold.font>Tudd le a kanyart!</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Egy derékszögű balkanyar felé közeledsz. Ne felejtsd el kihasználni a teljes rendelkezésedre álló teret!<br><br><font face=/font/big_bold.font>Vedd be a kanyart! </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Igazítsd be a kamiont a rámpára való felhajtáshoz, mivel amint ráhajtasz, nem nagyon tudod majd korrigálni az ívet!<br><br><font face=/font/big_bold.font>Hajts át a rámpán! </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Folytasd az utat balra! </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "A következő szakaszt tolatva kell teljesítened. Állj meg az előtted lévő akadályoknál, majd tolass be utána a jobb oldalad felé!<br><br><font face=/font/big_bold.font>Állj meg az akadályoknál!</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Tolass a mögötted jobb kéz felé eső területre! Ehhez használd segítségként az útburkolatra felfestett nyilakat!<br><br><font face=/font/big_bold.font>Tolass hátra a következő állomáshoz! </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Tolass tovább a mögötted lévő akadályok felé!</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Állj meg, majd válts előremenetbe, és hajts tovább balra!<br><br><font face=/font/big_bold.font>Haladj tovább előre! </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "A bal oldali elválasztón egy átkelőhely került kialakításra. Hajts át rajta!<br><br><font face=/font/big_bold.font>Folytasd az utat! </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Egy szűk, kanyargós szakaszhoz értél. Hajts át a terelőbóják között, és használd a tükröket, ha szükséges!<br><br><font face=/font/big_bold.font>Hajts át a bóják között! </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Haladj tovább a tesztpályán!<br><br><font face=/font/big_bold.font>Fordulj balra! </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Ne felejts el balra tartani a kanyar előtt, mivel így biztosíthatod a lehető legtöbb területet a kanyarodáshoz!<br><br><font face=/font/big_bold.font>Kanyarodj be! </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Haladj tovább! </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Itt egy kicsit gyorsabban haladhatsz, de hamarosan egy kanyarhoz érsz.<br><br><font face=/font/big_bold.font>Haladj tovább a tesztpályán! </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "A kanyar a vége felé egyre élesebbé válik.<br><br><font face=/font/big_bold.font>Igazítsd hozzá a sebességedet, és haladj tovább!</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "A lejtő alján több, az utat elzáró akadály található. <br><br><font face=/font/big_bold.font>Állj meg az akadályok előtt! </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Mögötted bal kéz fele egy parkolóhely található.<br><br><font face=/font/big_bold.font>Tolass be a parkolóhelyre!</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Kezelési pályán vezetés"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Ezen gyakorlat során egy kezelési pályát kell teljesítened, amelyet arra terveztek, hogy képet kaphass róla, milyen ügyesen kezeled a kamiont különböző kanyartípusokban."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Behajtás a gyakorlópályára"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Fokozatos balra kanyarodás"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Áthajtás az S kanyaron"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Egyenes szakasz"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Könnyű kanyarok"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Gyakorlópálya elhagyása"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Parkolóhely megközelítése"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Ezen gyakorlat során egy rövid kezelési pályát kell teljesítened, hogy megnézzük, hogyan kezeled a vontatót az újonnan megszerzett képességeiddel!"

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "A pálya többféle kanyartípust, és azok kombinációit tartalmazza. A feladat nem verseny, és az időt sem mérjük. Szóval légy nyugodt, és igazítsd a sebességedet az egyes kanyartípusokhoz és akadályokhoz!"

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "A pálya enyhe, könnyen bevehető kanyarokkal indít, de a későbbi szakaszok bonyolultabbak lesznek."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Ügyelj a sebességedre, nehogy túl gyorsan hajts, és félremérj egy kanyart!"

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "A pálya kijáratához egy nagyon szűk hajtűkanyar vezet. Hajts át rajta lassan, és használd ki a rendelkezésre álló teret!"

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parkolj le az akadályok között, és biztosítsd a kamiont!"


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "A gyakorlat teljesítéséhez kerüld el az ütközéseket, ne hagyd el a pályát, és ne menj neki egyik bójának sem!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>A pályára való behajtáshoz indulj el az éles jobbkanyar felé! </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Hajts át a kanyaron megfelelő, egyenletes sebességgel! </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Egy bonyolultabb, kanyargós rész felé közeledsz.<br><br><font face=/font/big_bold.font>Módosítsd ennek megfelelően a sebességedet, és folytasd az utat!</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Haladj tovább a következő kanyarkombináció felé!</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Ezúttal pár enyhébb, könnyebb kanyar következik. Tartsd egyenletesen a sebességedet!<br><br><font face=/font/big_bold.font>Folytasd a vezetést! </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "A gyakorlópályát egy éles hajtűkanyaron át hagyhatod el. Lassíts, és maradj a külső íven a behajtás előtt! Használd a tükröket a manőverezéshez!<br><br><font face=/font/big_bold.font>Hagyd el a tesztpályát! </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Előtted pár akadály között egy parkolóhely található.<br><br><font face=/font/big_bold.font>Hajts a parkolóhelyre! </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Párhuzamos parkolás"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Ezen gyakorlat során megtanulhatod, hogy hogyan állj be párhuzamosan két kamion közé."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Megállás a parkolóhely előtt"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Visszapillantó tükör ellenőrzése"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Betolatás a parkolóhelyre"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Kamion beigazítása a parkolóhelyre"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "A párhuzamos parkolás egy kulcsfontosságú készség, amit minden sofőrnek tudnia kell elvégezni.<br>Készülj fel az indulásra!"

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Hajts a parkolóhely felé!<br>Ügyelj a környezetedre!"

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Igazítsd a kamionodat a parkolóhely előtt álló kamionhoz, de ne állj túl közel hozzá! Helyette tarts elegendő távolságot, hogy elég helyed legyen a manőverezéshez!"

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Vegyél egy éles kanyart a parkolóhely felé, és kezdj el felé tolatni!"

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Használd az utasoldali tükröt, és célozd be vele a mögötted álló kamion előtti padkát!"

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Amint a lökhárítód az előtted álló kamion mögé került, kezdd el bekormányozni a vasad orrát a parkolóhelyre úgy, hogy beigazítsd a gépet a parkolóba!"

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Állítsd egyenes állásba a kerekeket, és igazítsd középre a kamiont a parkolóhelyen!<br>Parkolj le, és biztosítsd a járművedet!"

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Előtted pár parkoló kamion látható, illetve egy szabad parkolóhely, ahova be kell állnod. <br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Ne felejts el odafigyelni a közvetlen környezetedre! A manőverezés során használd a visszapillantó tükröket!<br><br><font face=/font/big_bold.font>Indulj el előre! </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Hajts el a parkoló mellett, és állj meg a megjelölt helyen! Onnan kell majd elkezdened a tolatási manővert.<br><br><font face=/font/big_bold.font>Állj meg a megjelölt helyen!</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Ellenőrizd a környezetedet, és bizonyosodj meg róla, hogy semmi sem gátolja a tolatást!<br><br><font face=/font/big_bold.font>Nézz bele az utasoldali tükörbe! </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Forgasd el a kormányt, és tolass be a parkolóhelyre!<br><br><font face=/font/big_bold.font>Kezdd el a tolatást! </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Kezdd el egyenesbe hozni a kamiont, amikor eljön az ideje! Ne hajts fel a padkára!<br><br><font face=/font/big_bold.font>Igazítsd be a kamiont a parkolóhelyre! </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Pótkocsi felkapcsolása"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "Ezen gyakorlat során megtanulhatod a félpótkocsik fel- és lekapcsolásának alapjait."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Tolatás a pótkocsihoz"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Pótkocsi felkapcsolása"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Rögzítőfék feloldása"





	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Pótkocsi lekapcsolása"


	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Pótkocsi lekapcsolása"



	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Pótkocsi lekapcsolása"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Megállás a megadott helyen"
#!{

	key[]: "aca_goal_book1_3_01_check_discon"
