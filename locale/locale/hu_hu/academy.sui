#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Vezetés összetett kanyarokban"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Ezen gyakorlat során a pótkocsival való manőverezést gyakorolhatod egy rövid, de összetettebb kanyarokat tartalmazó pályán."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Első kanyarok"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Áthaladás a szűk szakaszon"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Szűk derékszögű forduló"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
