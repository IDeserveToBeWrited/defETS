#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Ezen gyakorlat során több különböző kanyart kell teljesítened, hogy megszokd a pótkocsival való közlekedést. Figyelj oda, válaszd meg a sebességedet a helyzetnek megfelelően, és használd ki a rendelkezésedre álló teret!"

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Az első kanyar egy dogleg, azaz két kanyar egyben! Egy balkanyarral fogsz kezdeni, ami viszont a manőver közepén egy jobbkanyarba vált át."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "A következő kanyarral az elválasztó túloldalára kell eljutnod. A manőver nem kifejezetten nehéz, de ügyelj rá, hogy elég területet hagyj a pótkocsidnak!"

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Azt követően egy betonakadályok alkotta szlalompályán kell átjutnod. Lassíts le, használd a tükröket, és kanyarodj elég nagy ívben ahhoz, hogy a pótkocsid is átjusson az akadályokon!"

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Utána egy újabb szlalomot kell teljesítened, ahol mindegyik kanyar csúcsára bójákat helyeztünk ki.<br>Ügyelj rá, hogy ne menj neki egyiknek sem!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Az utadat pár könnyebb kanyarral folytathatod egy körforgalom felé."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Használd az egyenes szakaszt a körforgalomra való felkészüléshez! Maradj a külső oldalon a behajtás előtt!"

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Hajts be a körforgalomba, és figyelj oda a pótkocsid pozíciójára! A behajtáskori állásához képest a körforgalomban más pozíciót vesz majd fel!"

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Hajts ki a körforgalomból, majd haladj tovább a következő kanyarcsokor felé!"

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "TÁVOLÍTSD EL EZT AZ ÁTVEZETŐT"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Ez a kanyar nagyon éles! Vedd be lassan, és használd ki okosan a rendelkezésre álló teret! Figyelj oda a pótkocsi hátsó részének túlnyúlására is!"

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "A következő pár kanyar teljesítésénél ne felejts majd el mindig úgy kihajtani az adott kanyarból, hogy gond nélkül be tudj hajtani a következőbe!"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Ne siesd el az utolsó fordulót! Könnyűnek néz ki, de kevesebb terület áll majd rendelkezésedre a manőverezéshez, mint elsőre tűnik!"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Állj meg a megjelölt helyen, majd biztosítsd a kamiont, és állítsd le a motort!"


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Adj gázt, és indulj el az első kanyar felé! </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Az első kanyar egy könnyű dogleg.<br><br><font face=/font/big_bold.font>Vedd be a kanyart! </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "TÁVOLÍTSD EL EZT A PONTOT"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Az oktatópálya a mediántól balra folytatódik.<br><br><font face=/font/big_bold.font>Hajts át a túloldalra! </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Hagyd magad mögött az akadályokat, és figyelj oda a pótkocsidra!<br><br><font face=/font/big_bold.font>Teljesítsd a szlalomot! </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Ez a szlalom egyenesebb, de a bóják miatt sokkal szűkösebb!<br><br><font face=/font/big_bold.font>Hajts át a szlalomon, és ne menj neki egyik bójának sem! </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "A következő pár forduló könnyebb, de a megfelelő ívben kell behajtanod hozzájuk, hogy távol tartsd a pótkocsit az akadályoktól!<br><br><font face=/font/big_bold.font>Juss túl a kanyarokon! </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Egy körforgalom felé közeledsz. Ne felejts el elég helyet hagyni a pótkocsidnak nem csak a be- és kihajtáshoz, hanem a körforgalmon való áthaladáshoz is!<br><br><font face=/font/big_bold.font>Kelj át a körforgalmon! </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Egy rövid, egyenes szakasz következik, ahol kicsit felgyorsíthatsz, ha szeretnéd.<br><br><font face=/font/big_bold.font>Haladj tovább! </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Ez a kanyar nagyon éles! Lassíts le, használd ki a rendelkezésedre álló terület egészét, és figyelj oda a pótkocsid hátuljának túlnyúlására!<br><br><font face=/font/big_bold.font>Vedd be az éles kanyart! </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Az utolsó pár forduló már rutin munka kell, hogy legyen. De figyelj oda a pótkocsidra!<br><br><font face=/font/big_bold.font>Folytasd a vezetést! </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Hajts tovább az utolsó parkoló felé! </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

