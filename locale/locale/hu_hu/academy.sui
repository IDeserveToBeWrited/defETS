#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kameranézetek"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Ebben a gyakorlatban végigvesszük, hogy milyen kameranézetek érhetőek el a játékban, és hogy miként használhatod azokat a kamionod irányítása és manőverezése során."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Üléspozíció"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Kinézés hátra"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Tükrök ellenőrzése"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Átváltás külső nézetre"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Körülnézés a kamion körül"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Ebben a gyakorlatban számba vesszük a<br>játékban elérhető kameranézeteket."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "A játékban összesen hét kameranézet érhető el. A következőkben<br>ezek egy részét mutatjuk be, a használatukkal együtt."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "A különböző kameranézetek és azok látószögei igen hasznosak lehetnek szűk helyeken való manőverezés esetén."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "A biztonságos, szakszerű vezetéshez elengedhetetlen, hogy lásd, pontosan hova is mész. Ha a jelenlegi üléspozíciód ehhez nem megfelelő, akkor módosítsd itt: '@@adjust_link_t@@' (a Szünet menüből érhető el)!<br><br><font face=/font/big_bold.font>Ha készen állsz, jelezd a következővel: @@imv_nrm_activate@@! </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Tolatás közben nem támaszkodhatsz mindig a tükrökre - helyette olykor ki kell nézned hátra a fülkéből, hogy jobb képet kapj a mögötted lévő térről.<br><br><font face=/font/big_bold.font>Forgasd el teljesen a vezetőoldalra a kamerát, hogy kinézz a fülkéből a pótkocsi hátulja felé!</font>@@aca_goal_tip@@ Ehhez használd a beltéri kamerát!"

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Használd ezt a nézetet, hogy gyors képet kapj a pótkocsiról, amikor tolatási manővereket végzel vele! Ez a kameranézet akkor a leghatékonyabb, ha a vezetőoldal felé tolatsz - amennyiben utasoldal felé tolatsz, sokkal korlátozottabb képet ad a szerelvény hátuljáról.<br><br><font face=/font/big_bold.font>Nézz az utasoldal felé! </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Ezért van hát, hogy általában nem javasolt az utasoldal felé tolatni - mint láthatod, eléggé korlátozott a kilátás. Szerencsére a játék hét külsőnézeti kamerával is rendelkezik, amik segíthetnek ilyenkor.<br><br>Ezen kameranézetek között ciklikusan külön gombbal válthatsz (@@imv_nrm_camcycle@@) - ha mind a hét kamerát megnyitottad vele, ismét az első kamerára kapcsol. <br><br><font face=/font/big_bold.font>A következő kameranézet megnyitásához nyomd meg a következőt: @@imv_nrm_camcycle@@! </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "A kamion közvetlen környezetét a legjobban a külső kamerával láthatod be.<br><br><font face=/font/big_bold.font>Nézz körül alaposan!</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Nyomd meg ismét a megfelelő gombot (@@imv_nrm_camcycle@@), hogy átválts a következő kamerára! </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "A felülnézeti kamerával remekül beláthatod a kamion környezetét, ami jelentősen megkönnyíti a parkolást és a szűk helyen való vezetést.<br><br><font face=/font/big_bold.font>Nyomd meg ismét a megfelelő gombot (@@imv_nrm_camcycle@@), hogy átválts a következő kamerára!</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "A tetőkamerával komolyabb akadályok nélkül láthatod be a kamion előtti területet.<br><br><font face=/font/big_bold.font>Az utolsó, ebben a leckében bemutatott kameranézetre való átváltáshoz nyomd meg a következőt: @@imv_nrm_camcycle@@!</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "A hátsó nézettel azonnal elérheted azon kameranézetet, amelyet a fülkéből való kinézéssel is látsz. Mint említettük, ez különösen hasznos tolatásnál és parkolásnál.<br><br>A játék ezeken túlmenően további kameranézetekkel is segíti a fuvarokat, amelyeket a megfelelő gomb (@@imv_nrm_camcycle@@) lenyomásával érhetsz el.<br><br><font face=/font/big_bold.font>A fülkébe való visszatéréshez nyomd meg a következőt: @@imv_nrm_camcycle@@!</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Az élethű vezetésoktatási élményhez javasoljuk, hogy használd a beltéri kamerát minden gyakorlat során! <br><br><font face=/font/big_bold.font>A gyakorlat befejezéséhez nyomd meg a következőt: @@imv_nrm_activate@@!</font> @@aca_goal_tip@@ A környezeted jobb belátásához rá is közelíthetsz a kamerára (@@o_im_cam_zoom@@), ami különösen hasznos a tükrök használata során. A kapcsolódó kiosztás megtekintéséhez és módosításához nyisd meg a játékbeállítások \"Billentyűk és gombok\" fülét!"

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Az első elindulás"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Ezen gyakorlat során megtanulhatod, hogy miként készítsd fel elindulásra a kamiont, és hogyan indulj el vele előre!"

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Gyújtás bekapcsolása"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Motor beindítása"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Közvetlen környezet ellenőrzése"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Üzemi fék használata"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Sebességbe váltás"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Rögzítőfék feloldása"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Elindulás előre"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Megállás"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Rögzítőfék behúzása"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Üresbe váltás"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Motor leállítása"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Az első pár leckéhez csak a vontatót vesszük igénybe.<br>Egy kamionra \"vontató\"-ként hivatkozunk akkor, ha nem rendelkezik saját raktérrel, és csak pótkocsit vontatva képes áru- és anyagszállításra."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "A vontatók közkedveltek, mivel igen sokoldalúak: akár várakozás nélkül képesek lerakni egy üres pótkocsit, majd elszállítani egy másik megrakottat. Emellett több különböző pótkocsifajtát is képesek vontatni."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Az első elindulásnál a feladatod az lesz, hogy haladj előre, majd állj meg a szaggatott vonalnál.<br>Indítsd be a motort, kövesd az utasításokat, hogy elindulhass a kamionnal, majd haladj egyenesen előre!"

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Haladj át a szaggatott vonalon, majd állj meg, állítsd le a motort, és biztosítsd a kamiont!"

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "A képzés eme részében végre el is indulhatsz a kamionnal!<br><br>Ez persze nem lesz egyszerű leállított motor mellett, úgyhogy először kapcsold be a gyújtást!<br><br><font face=/font/big_bold.font>Ehhez nyomd meg a következőt $input engineelect$! </font>@@aca_goal_tip@@ A Karrier módban alapesetben a gyújtással együtt a motor is beindul. Ezt a viselkedést a Játékmenet opciók között a következő beállítással módosíthatod: @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "A gyújtás bekapcsolja a kamion elektronikai rendszereit. Ennek jele, hogy a műszerfalon felvillannak a figyelmeztető jelzések - ez teljesen normális! Ha azonban a motor beindítása után is ott maradnak, az esélyesen valamilyen hibát jelez, kivéve ha a rögzítőfék lámpája marad égve, ami csak akkor tűnik el, ha feloldottad azt!<br><br>Szerencsére ez a kamion patika állapotú, így el is indulhatunk vele.<br><br><font face=/font/big_bold.font>A motor beindításához nyomd meg a következőt: @@imv_nrm_engine@@! </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Most, hogy jár a motor, fontos, hogy elindulás előtt ellenőrizd a környezetedet!<br><br><font face=/font/big_bold.font>Nézz körül, és használd a vezetőoldali valamint utasoldali tükröket, hogy megbizonyosodj róla, hogy tiszta a kamion környéke! </font>@@aca_goal_tip@@ Ehhez használd a beltéri kamerát!"

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Bár nyilvánvalónak tűnik, de azért jó tudni már elindulás előtt, hogy miként is állhatsz majd meg.<br><br><font face=/font/big_bold.font>Lépj az üzemi fékre a következővel: $input backward$! </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Most pedig megtanítunk rá, hogy miként módosítsd a menetirányt!<br><br>Egyszerű automata váltó esetén ez nem ördöngősség, mivel a folyamat teljesen automatikus.<font face=/font/big_bold.font><br><br>Az előremenetbe váltáshoz használd a következőt: $input forward$! </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Most pedig megtanítunk rá, hogy miként módosítsd a menetirányt!<br><br>Valódi automata váltó esetén előremenet, üresjárat, és hátramenet módozatok között válthatsz, akárcsak egy valódi automataváltó esetén.<br><br><font face=/font/big_bold.font>Az előremenetbe váltáshoz használd a következőt: @@imv_nrm_gearup@@! </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Most pedig megtanítunk rá, hogy miként módosítsd a menetirányt!<br><br>Szekvenciális váltó esetén egyesével válthatsz a fokozatok között, akárcsak egy valódi szekvenciális váltó esetén.<br><br>Hasonlóan az előremenetbe váltáshoz, a kamion gyorsítása során így mindig magasabb fokozatba kell kapcsolnod.<br><br><font face=/font/big_bold.font>Az első sebességfokozatba váltáshoz használd a következőt: @@imv_nrm_gearup@@! </font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Most pedig megtanítunk rá, hogy miként módosítsd a menetirányt!<br><br>Váltókar és kuplungpedál használata esetén ugyanúgy kell váltanod a fokozatok között, mint egy valódi kéziváltóval tennéd.<br><br>Nyomd le teljesen a kuplung- és fékpedált! <font face=/font/big_bold.font>Utána helyezd a váltókart egyes állásba! <color value=@@clr_txt@@>Közben tartsd benyomva a kuplung- és fekpedálokat! </font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Az elinduláshoz először is oldd ki a rögzítőféket!<br><br><font face=/font/big_bold.font>Ehhez használd a következőt: @@imv_nrm_parkingbrake@@!</font> @@aca_goal_tip@@ A játék Karrier módjában a rögzítőfék alapesetben ki van kapcsolva. Ennek módosításához a Játékmenet beállítások között keresd meg a következő opciót: @@auto_park_brake@@!"

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "A kamion immár készen áll az elindulásra! Kelj hát útnak, és haladj át a szaggatott vonalon!<br><br><font face=/font/big_bold.font>Az elinduláshoz gyorsulj fel a következővel: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "A kamion immár készen áll az elindulásra! Kelj hát útnak, és haladj át a szaggatott vonalon!<br><br><font face=/font/big_bold.font>Az elinduláshoz gyorsulj fel a következővel: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "A kamion immár készen áll az elindulásra! Kelj hát útnak, és haladj át a szaggatott vonalon!<br><br><font face=/font/big_bold.font>Az elinduláshoz gyorsulj fel a következővel: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "A kamion immár készen áll az elindulásra! Kelj hát útnak, és haladj át a szaggatott vonalon!<br><br><font face=/font/big_bold.font>Engedd fel az üzemi féket, majd lassan engedd fel a kuplungot, és közben adj gázt, hogy fenntartsd a szükséges fordulatszámot, és elkerüld a lefulladást! Amint teljesen felengedted a kuplungot, gyorsíts és válts menetfokozatot, amennyire szükséges! </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Nyomd le az üzemi féket, hogy megállj!<br><br><font face=/font/big_bold.font>A megálláshoz használd a következőt: $input backward$! </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Nyomd le az üzemi féket, hogy megállj!<br><br><font face=/font/big_bold.font>A megálláshoz használd a következőt: $input backward$! </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Nyomd le az üzemi féket, hogy megállj!<br><br><font face=/font/big_bold.font>A megálláshoz használd a következőt: $input backward$! </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "A megálláshoz nyomd be teljesen a kuplungot, <font face=/font/big_bold.font>majd használd az üzemi féket! <color value=@@clr_txt@@>Helyezd üres állásba a váltókart, majd engedd fel a kuplungot! </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Most pedig biztosítsd a kamiont! Ehhez húzd be a rögzítőféket, mivel így elkerülheted, hogy a leparkolás után elmozduljon a jármű!<br><br><font face=/font/big_bold.font>A rögzítőfék bekapcsolásához használd a következőt: @@imv_nrm_parkingbrake@@!</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Egyszerű automataváltó használata esetén nem kell a váltással törődnöd - a játék mindent elintéz helyetted!<br><br><font face=/font/big_bold.font>A megerősítéshez nyomd le a következőt: @@imv_nrm_activate@@! </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Az üres fokozatba váltáshoz nyomd meg a következőt: @@imv_nrm_geardown@@! </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Az üres fokozatba váltáshoz nyomd meg a következőt: @@imv_nrm_geardown@@! </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Helyezd a váltókart üres állásba, majd engedd fel a kuplungot! </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Most már tudod, hogy hogyan kell elindulni és biztonságosan megállni a kamionnal!<br><br><font face=/font/big_bold.font>A motor leállításához nyomd meg a következőt: $input engineelect$! </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Tolatás"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Ebben a gyakorlatban megtanulhatod a tolatás alapjait. A leckében kitérünk rá, hogy hogyan használhatod a tükröket a hátrafelé nézéshez, mire kell odafigyelned, és hogy miként készülj fel a hátramenetre."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Motor beindítása"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Utasoldali tükör ellenőrzése"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Vezetőoldali tükör ellenőrzése"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Fokozatba kapcsolás"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Rögzítőfék feloldása"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Üresbe kapcsolás"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Motor leállítása"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Ezen gyakorlat során egyenesen kell majd tolatnod. Át kell majd haladnod a szaggatott vonalon, majd meg kell állnod."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Tolatás közben fontos, hogy mindig alaposan körülnézz, használd a tükröket, és hogy megbizonyosodj róla, hogy tiszta a körülötted és mögötted lévő terület!"

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Indítsd be a motort, válts hátramenetbe, majd indulj el!"

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Tolass át a szaggatott vonalon, majd állj meg, állítsd le a motort, és biztosítsd a kamiont!"

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Készülj fel az elindulásra, ahogy az előző gyakorlat során megtanultad!<br><br><font face=/font/big_bold.font>Ha készen állsz, indítsd be a motort! </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Ellenőrizd a visszapillantó tükrökkel, hogy tiszta-e körülötted a terep! Ha úgy érzed, hogy nincsenek jól beállítva a tükrök, igazítsd be őket itt: '@@adjust_link_t@@'!<br><br><font face=/font/big_bold.font>Nézz az utasoldali tükörbe! </font>@@aca_goal_tip@@ Használd a beltéri nézetet!"

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "A szaggatott vonalon kell majd áthaladnod. A sávod ezúttal üres, de normál körülmények között fontos, hogy mindig ellenőrizd a tükrökkel a közvetlen környezetedet!<br><br><font face=/font/big_bold.font>Nézz a vezetőoldali tükörbe!</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>A hátramenetbe kapcsoláshoz használd a következőt: $input backward$! </font>@@aca_goal_tip@@ Tolatás közben a legtöbb kamion esetén automatikusan bekapcsol a tolatásjelző hang. Ezt a beállítások között a Hangok beállításcsoport következő opciójával kapcsolhatod ki: @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>A hátramenetbe váltáshoz nyomd meg a következőt: $input backward$! </font>@@aca_goal_tip@@ Tolatás közben a legtöbb kamion esetén automatikusan bekapcsol a tolatásjelző hang. Ezt a beállítások között a Hangok beállításcsoport következő opciójával kapcsolhatod ki: @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>A hátramenetbe váltáshoz nyomd meg a következőt: $input backward$! </font>@@aca_goal_tip@@ Tolatás közben a legtöbb kamion esetén automatikusan bekapcsol a tolatásjelző hang. Ezt a beállítások között a Hangok beállításcsoport következő opciójával kapcsolhatod ki: @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Nyomd le teljesen a kuplungot, majd mozgasd a váltókart hátramenetbe! </font>@@aca_goal_tip@@ Tolatás közben a legtöbb kamion esetén automatikusan bekapcsol a tolatásjelző hang. Ezt a beállítások között a Hangok beállításcsoport következő opciójával kapcsolhatod ki: @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Immár hátramenetben vagy.<br><br><font face=/font/big_bold.font>Engedd fel a rögzítőféket a következővel: @@imv_nrm_parkingbrake@@! </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Indulj el a következővel: $input backward$! <br><br><font face=/font/big_bold.font>Haladj át tolatva a szaggatott vonalon! </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Az elinduláshoz adj gázt a következővel: $input forward$!<br><br><font face=/font/big_bold.font>Haladj át tolatva a szaggatott vonalon! </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Az elinduláshoz adj gázt a következővel: $input forward$!<br><br><font face=/font/big_bold.font>Haladj át tolatva a szaggatott vonalon! </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Engedd fel lassan a kuplungot, és közben adj némi gázt, hogy megfelelő fordulatszámon maradj! <br><br><font face=/font/big_bold.font>Haladj át tolatva a szaggatott vonalon! </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>A megálláshoz használd az üzemi féket a következővel: $input forward$! </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>A megálláshoz használd az üzemi féket a következővel: $input backward$! </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>A megálláshoz használd az üzemi féket a következővel: $input backward$! </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Nyomd be teljesen a kuplungot, majd használd az üzemi féket a kamion megállításához! </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Húzd be a rögzítőféket a következővel: @@imv_nrm_parkingbrake@@! </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Egyszerű automataváltó használata esetén nem kell a váltással törődnöd - a valósággal ellentétben ekkor a játék mindent elintéz helyetted!<br><br><font face=/font/big_bold.font>A megerősítéshez nyomd meg a következőt: @@imv_nrm_activate@@! </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Az üres fokozatba váltáshoz nyomd meg a következőt: @@imv_nrm_gearup@@. </font>@@aca_goal_tip@@ Bár a modern kamionok a rögzítőfék behúzásakor automatikusan üres fokozatba váltanak, azért érdemes ezt a lépést magad megcsinálnod. A későbbi gyakorlatok során viszont ezzel nem kell foglalkoznod!"

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Az üres fokozatba váltáshoz nyomd meg a következőt: @@imv_nrm_gearup@@!</font>@@aca_goal_tip@@  Bár a modern kamionok a rögzítőfék behúzásakor automatikusan üres fokozatba váltanak, azért érdemes ezt a lépést magad megcsinálnod. A későbbi gyakorlatok során viszont ezzel nem kell foglalkoznod!"

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Helyezd a váltókart üres állásba, majd engedd fel a kuplungot! </font>@@aca_goal_tip@@  Bár a modern kamionok a rögzítőfék behúzásakor automatikusan üres fokozatba váltanak, azért érdemes ezt a lépést magad megcsinálnod. A későbbi gyakorlatok során viszont ezzel nem kell foglalkoznod!"

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Ne feledd: tolatáskor mindig oda kell figyelned a közvetlen környezetedre, különösen zsúfolt, forgalmas területeken haladva!<br><br><font face=/font/big_bold.font>A motor leállításához nyomd meg a következőt: $input engineelect$! </font>"
#@}

