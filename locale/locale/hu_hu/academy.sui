	val[]: "@@aca_goal_book1_2_01_start@@"



 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Ezen gyakorlat során egy rövid vezetésre invitálunk, amely során megtapasztalhatod, hogy milyen érzés pótkocsival fékezni egy lejtőn haladva. Készítsd fel a kamiont, és indulj útnak!"

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Érd el a 60 km/h (37 mph) sebességet, majd készülj fel a fékezési zónára!"

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Fékezz, majd állj meg! Ügyelj rá, hogy időben lépj a fékre, nehogy nekimenj az előtted lévő akadályoknak!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parkolj le a megjelölt helyen, majd biztosítsd a kamiont, és állítsd le a motort!"


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Ezen gyakorlat során megtapasztalhatod, hogy milyen érzés az üzemi fékkel lefékezni egy lejtőn haladva. A gyakorlat célja, hogy képet kapj róla, miként befolyásolja a vontatott extra súly a járműved féktávolságát.<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Indulj útnak, és vedd figyelembe, hogy el kell érned a 60 km/h (37 mph) sebességet!<br><br><font face=/font/big_bold.font>Hajts át a kanyaron! </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Gyorsulj tovább a lejtőn haladva! </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Érd el a 60 km/h (37 mph) sebességet! </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Elérted a szükséges sebességet!<br><br><font face=/font/big_bold.font>Most pedig állj meg az akadályok előtt! </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

