	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ne felejts el azonnal kormányozni, mert nincs sok helyed a manőverezéshez!<br><br><font face=/font/big_bold.font>Tolass a mögötted lévő, megjelölt helyre! </font>"


#@}

