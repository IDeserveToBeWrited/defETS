#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Akadályok kikerülése"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Ez a pálya több összetett kanyarral és akadállyal vár.<br>Használd fel az összes, eddig megszerzett tudásodat, és nem lesz nehéz teljesítened!"

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Figyeld az útburkolati jeleket, mert segíthetnek abban, hogy miként teljesítsd az előtted álló feladatokat!"

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Tartsd a vontatót a kanyar külső ívében!<br>Itt széles kanyart kell majd leírnod, mivel a pótkocsi rövidebb útvonalat követ!"

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "A következő kanyar egy könnyű derékszögű forduló lesz. <br> Ezúttal is tartsd a kamiont a külső íven, és használd ki a teljes rendelkezésre álló teret!"

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Ne siesd el ezt a szakaszt! Bár a terület nyitottabb, mégis precíznek kell lenned!"

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Kerüld el nagy ívben ezeket az akadályokat!"

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Légy óvatos, amikor megközelíted ezt a szűk szakaszt!<br>Behajtás előtt kanyarodj nagy ívben, hogy a pótkocsit is gond nélkül be tudd vontatni!"

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Az utolsó derékszögű forduló sokkal élesebb, mint az első, de ha okosan használod ki a rendelkezésre álló teret, elég helyed lesz a bekanyarodáshoz!"

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Parkolj le a megjelölt helyen, majd biztosítsd a kamiont, és állítsd le a motort!"


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Ne felejts el odafigyelni az útburkolati jelekre a tesztpályán való navigálás során!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "A visszapillantó tükrök szintén sokat segíthetnek a pályán való végighaladásban. Légy mindig tisztában vele, hogy milyen pozícióban van a vontatott pótkocsid!<br><br><font face=/font/big_bold.font>Haladj át az első kanyaron! </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Figyelj oda a pótkocsira a kanyarból való kihajtásnál, és készülj fel a következőbe való behajtásra!<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Haladj át a következő kanyaron! </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Ne felejtsd el rendszeresen ellenőrizni a pótkocsit, hogy kanyarodás előtt megbizonyosodj róla, hogy nincs a közelben semmilyen akadály!<br><br><font face=/font/big_bold.font>Folytasd az utat az akadály körül! </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Amint a pótkocsi elhagyta az akadályt, vegyél egy éles kanyart az utasoldal felé, és igazítsd be a szerelvényt a szűk átjáróhoz!<br><br><font face=/font/big_bold.font>Haladj tovább a szűk átjáró felé!</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Ez a szakasz felettébb precíz vezetést igényel. Szóval ne kapkodj, és használd a tükröket!<br><br><font face=/font/big_bold.font>Maradj a külső íven minden kanyarban! </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ez a kanyar nagyon éles, de ha jól használod ki a rendelkezésre álló teret, könnyen teljesíthető.<br><br><font face=/font/big_bold.font>Juss túl az utolsó kanyaron!</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
