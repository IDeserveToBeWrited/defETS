#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Mielőtt útnak indulsz"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Az első gyakorlatod részeként átvesszük a vezetőfülke alapjait. Mivel a stresszesebb, odafigyelést igénylő közlekedési helyzeteknél elengedhetetlen, hogy jól belásd a környezetedet, így fontos, hogy megfelelően beállítsd az ülést, a kormányt, és a visszapillantó tükröket.<br><br>A következőkben ezeket vesszük számba egyesével."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Ülés és tükrök beállítása"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Tükrök és láthatóság ellenőrzése"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Üdvözlünk az első leckében!<br>Nézzük is át, hogy miként kell felkészíteni a kamiont az elindulásra!"

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "A munkád során elengedhetetlen, hogy óvatosan, profi módon, és a járművet az uralmad alatt tartva vezess!<br>Ehhez megfelelően be kell állítanod az ülést, a kormányt, és a visszapillantó tükröket!"

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "A kamion mindkét oldalán járműveket láthatsz.<br>A segítségükkel megfelelően beállíthatod a tükröket."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Ne siess, és állíts be mindent az igényeidnek megfelelően, mivel eme beállítások<br>erősen kihatnak arra, hogy mennyire tudod majd uralmad alatt tartani a kamiont."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Ülés- és kormánybeállítás"

	key[]: "adj_tut_title_1"
	val[]: "Fő tükrök beállítása"

	key[]: "adj_tut_title_2"
	val[]: "Domború tükrök beállítása"

	key[]: "adj_tut_title_3"
	val[]: "Láthatóság ellenőrzése és végső tükörigazítás"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "nyomd le a megfelelő gombot (@@imv_nrm_adjuster@@), vagy nyisd meg a Jármű beállítása ablakot a Szünet menüből"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "nyisd meg a Jármű beállítása ablakot a Szünet menüből"

	key[]: "adj_tut_open_adj"
	val[]: "Eme funkciót ('@@adjust_link_t@@') játék közben is elérheted. Ehhez $OPEN_ADJUSTER$!"

	key[]: "adj_tut_open_seat"
	val[]: "Először is, állítsuk be a vezetőülést és a kormányt!<br><br><font face=/font/big_bold.font>A folytatáshoz nyisd meg a következőt: '@@adj_seats@@'!</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>A tükörbeállítások megjelenítéséhez nyisd meg a következőt: @@adj_mirrors@@!</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Az első beszállás után fontos, hogy megfelelően beállítsd az ülést, a kormányt, és a visszapillantó tükröket.<br><br>A kormány mögötti pozíciód különösen jelentős a beláthatóság szempontjából, mivel minden vezérlőeszköznek elérhető közelségben kell lennie, valamint megfelelően rá kell látnod a kamion előtti területre, a szerelvény oldalaira, valamint a tükrökre is.<br><br><font face=/font/big_bold.font>A konfigurációs menü megnyitásához $OPEN_ADJUSTER$! </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Állítsd be az ülést úgy, hogy megfelelő rálátásod legyen a közvetlen környezetedre és a visszapillantó tükrökre, valamint hogy minden kezelőszervet el tudj érni!<br><br>Állítsd be a kormányt is úgy, hogy kényelmesen kezelhető legyen, és ne takarja ki a műszerfalat!<br><br><font face=/font/big_bold.font>Ha megfelelően beállítottál mindent, térj vissza a konfigurációs menübe a megfelelő gomb megnyomásával (@@imv_nrm_back@@)! </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>A kamionoknak több nagy holttere is van, épp ezért több visszapillantó tükörrel is felszerelik őket, hogy a sofőrök minél jobban belássák azokat. <br><br>Ezen tükrök megfelelő beállításával biztosíthatod, hogy a lehető legjobban tisztában legyél a jármű közvetlen környezetével.<br><br><font face=/font/big_bold.font>A folytatáshoz nyisd meg a következőt: '@@adj_mirrors@@'!</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>A fő tükrök a kamion és a pótkocsi oldalait teszik beláthatóbbá.<br><br>Állítsd be őket a megfelelő pozícióba a jármű mellett álló autók segítségével!<br><br><font face=/font/big_bold.font>A folytatáshoz nyomd meg a következőt: @@imv_nrm_selectfcs@@!</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "A fő tükrök az elsődleges segédeszközeid, amelyekkel beláthatod a melletted és mögötted lévő teret. Épp ezért jól kell látnod benne mind a melletted álló autót, mind a pótkocsid egy részét is, mivel csak így tudod pontosan megállapítani a körülötted lévő akadályok pozícióját."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Ha elégedett vagy a beállításokkal, állítsd be az utasoldali fő tükröt!"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Megint ügyelj rá, hogy jól lásd a melletted lévő autót, de közben a pótkocsid oldalát is lásd a tükörben!"

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Ha elégedett vagy a beállításokkal, állítsd be a vezetőoldali konvex tükröt!"

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>A domború tükrök szélesebb látótérrel rendelkeznek, így jobban beláthatod velük a melletted lévő teret.<br><br><font face=/font/big_bold.font>A folytatáshoz nyomd meg a következőt: @@imv_nrm_selectfcs@@! </font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Ideális esetben látnod kellene a melletted parkoló autót és kamiont is, valamint a saját kamionod egészen kis részét is."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Ha elégedett vagy a beállításokkal, állítsd be az utasoldali konvex tükröt!"

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Megint ügyelj rá, hogy lásd a melletted parkoló autót és kamiont is, valamint a saját kamionod egészen kis részét is!"

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Ha elégedett vagy a tükörbeállításokkal, nyomd meg a @@imv_nrm_back@@ gombot, hogy bezárd a tükörbeállításokat!"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>A konfigurációs menübe való visszatéréshez nyomd meg a következőt: @@imv_nrm_back@@! </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Tökéletes! Most, hogy az ülést és a tükröket a Neked megfelelő módon beállítottad, egy lépéssel közelebb kerültél az elinduláshoz!<br><br><font face=/font/big_bold.font>Zárd be a konfigurációs menüt a következővel: @@imv_nrm_back@@! </font>"

	key[]: "adj_tut_open_con"
	val[]: "Nézz körül még egyszer, hogy megbizonyosodj róla, hogy megfelelően kilátsz a vezetőfülkéből, és hogy a tükrökkel jól belátod a kamion körüli teret!<br><br>Ha bármit át szeretnél állítani, a tükröket a konfigurációs menü megfelelő opciójával módosíthatod: '@@adjust_link_t@@'!<br><br><font face=/font/big_bold.font>A gyakorlat befejezéséhez nyomd meg a következőt: @@imv_nrm_activate@@!</font> @@aca_goal_tip@@ A képernyőtükrök be- vagy kikapcsolásához használd a Szünet menü következő beállítását: '@@adjust_link_t@@' — '@@adj_ui_mirrors@@'! Eme virtuális tükrökkel könnyebben beláthatod a kamion utasoldalát."
#@}

