	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Az ehhez hasonló ferde parkolóhelyek igen elterjedtek - különösen az európai autópályák pihenőhelyein lelhető fel belőlük sok.<br>Ezúttal is \"orral előre\" kell beállnod a megadott helyre."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Hajts a megadott parkolóhelyhez a sor vége felé!"

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Maradj a sáv közepén, vagy tarts enyhén a vezetőoldal felé! Ne hajts túl közel az akadályokhoz, mert a pótkocsi vége nekikütközhet kanyarodás közben!"

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Hajts túl a megadott parkolóhelyen, majd vegyél egy éles és gyors kanyart, és állj be a helyre! A manőver során figyeld mindkét oldalsó tükrödet: a vezetőoldalival azt ellenőrizheted, hogy a pótkocsid eleje nem ütközik-e neki a melletted álló pótkocsinak, míg az utasoldalival azt, hogy a pótkocsit biztonságosan bevontattad-e a parkolóhelyre!"

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Állj meg a megjelölt helyen, majd biztosítsd a kamiont, és állítsd le a motort!"


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Ha ferdén kell parkolnod, akkor fontos, hogy pontosan felmérd a helyzetedet! Ha ugyanis már belekezdtél a kanyarba, akkor nehéz lesz kitolatnod és újra beigazítanod a szerelvényt! Épp ezért javasoljuk, hogy már az első próbálkozásodhoz elegendő hely álljon a rendelkezésedre!<br><br><font face=/font/big_bold.font>Készülj fel az indulásra!</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Indulj el a parkolóhely felé!</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Hajts túl a parkolóhelyen, hogy a pótkocsidnak elegendő helye legyen majd ráfordulni a vontatód vonalára!<br><br><font face=/font/big_bold.font>Fordulj rá a parkolóhelyre! </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Tolatás az utasoldal irányába"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Ezen gyakorlat során a kamionod átellenes oldala felé kell majd betolatnod egy parkolóhelyre. Mivel az utasoldalon nem tudsz kinézni hátra a fülkéből, így csak a tükreidre hagyatkozhatsz, hogy biztonságosan leparkolj a megjelölt helyre."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

