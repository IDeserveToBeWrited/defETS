#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Elhelyeztünk előtted egy akadályt. Hajts oda hozzá, majd állj meg!"

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "A kamionod mögött a vezetőoldalon egy másik akadály található. Tolass hátra az ív mentén, hogy odaérj! Használd segítségként az útburkolati jeleket!"

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Közvetlenül előtted egy éles, derékszögű kanyar található. Hajts oda!"

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Elég mélyen be kell majd hajtanod a kanyarba, hogy a hátsó kerekek elkerüljék a belül elhelyezett terelőbóját.<br>Használd a visszapillantó tükröket!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Hozd egyenesbe a szerelvényt, indulj el az utolsó akadály felé, majd állj meg, és biztosítsd a kamiont!"

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Készülj fel az indulásra! </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "A kamion még mindig nem tud elindulni! Lehet, hogy megfeledkeztél valamiről?<br><br>Jár a motor? Feloldottad a rögzítőféket?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Egyenesen előtted, az akadálynál, van egy megjelölt pont.<br><br><font face=/font/big_bold.font>Hajts oda, majd állj meg ott! </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Nézz hátra a vezetőoldalon: egy másik megjelölt pontot fogsz látni. A feladatod az, hogy kanyarodva betolass oda.<br><br><font face=/font/big_bold.font>Tolass hátra az ív mentén, majd állj meg a megjelölt helyen! </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "A pálya egy derékszögű kanyarral folytatódik.<br><br>A bekanyarodás előtt tarts a vezetőoldal felé, hajts be mélyen a fordulóba, majd vegyél egy gyors és éles kanyart! Ügyelj rá, hogy ne menj neki a belső terelőbójának!<br><br><font face=/font/big_bold.font>Hajts tovább, és vedd be a kanyart! </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Használd az elülső és oldalsó tükröket, hogy ne menj neki semminek!<br><br><font face=/font/big_bold.font>Fejezd be a kanyart, majd állj meg a megjelölt helyen! </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Állítsd le a motort, és biztosítsd a kamiont!</font>"
#@}

