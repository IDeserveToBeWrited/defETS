	key[]: "aca_goal_book1_2_01_end"
	val[]: "Jármű biztosítása"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "Eme gyakorlat során a vontatóval egy rövid, terelőbóják alkotta szlalompályát teljesítünk majd."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Vezess óvatosan, és ügyelj a környezetedre! Figyeld majd a kamion mindkét oldalát, és használd a tükröket, hogy sikeresen teljesítsd a tesztpályát!"

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "A pálya a vége felé egyre szűkebb lesz, a siker kulcsa így a precizitásban rejlik!"

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "A gyakorlat végeztével parkolj le a megjelölt helyen, és biztosítsd a kamiont!"

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "A gyakorlat teljesítéséhez juss el a tesztpálya végére úgy, hogy nem ütközöl neki egyik bójának sem!<br><br><font face=/font/big_bold.font>A megerősítéshez nyomd meg a következőt: @@imv_nrm_activate@@! </font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Használd a tükröket, hogy képet kaphass a kamion mindkét oldalának környezetéről!<br><br>Az utasoldalon az elülső és az oldalsó tükör is nagy segítséget jelenthet a navigálásban.<br><br><font face=/font/big_bold.font>A megerősítéshez nyomd meg a következőt: @@imv_nrm_activate@@!</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Ha szükséges, állítsd be a tükröket a következő menüben: '@@adjust_link_t@@' (a Szünet menüből érhető el).<br><br><font face=/font/big_bold.font>Készülj fel az indulásra!</font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "A kamion még mindig nem tud elindulni! Lehet, hogy megfeledkeztél valamiről?<br><br>Jár a motor? Feloldottad a rögzítőféket?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Indulj el lassan előre, és hajts át a szlalompályán! </font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Folytasd az utat a bóják körül! Különösen figyelj oda az utasoldalra!</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Folytasd a kacskaringózást a szlalompályán, és ügyelj rá, hogy ne menj neki egyik terelőbójának sem! </font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Állj meg a megjelölt helyen! </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Biztosítsd a kamiont, és állítsd le a motort! </font>"
#@}

# Scenario 2_02 formatting
