#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Üdvözlünk a vezetésoktatási modulban!"

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "A következő gyakorlatok teljesítésével megteheted az első lépéseket a képzett kamionsofőrré válás felé!"

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Eme játékmódban mindent megtanulhatsz a kamion alapvető rendszereinek használatától és irányításától kezdve..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...egészen az összetettebb manőverekig, pótkocsival és anélkül."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "A gyakorlatok során elsajátíthatod mindazon szokásokat, amelyekkel biztonságosan eligazodhatsz a legkülönbözőbb helyzetekben,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "és a lehető legjobban kihasználhatod a rendelkezésre álló teret, hogy hatékonyan manőverezhess a kamionoddal."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Ha teljesíted az összes gyakorlatot, és sikeres záróvizsgát teszel,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "készen fogsz rá állni, hogy bejárd Európa útjait, és új kihívásokkal nézz szembe!"

#@}

