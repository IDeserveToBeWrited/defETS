#+ WoTr event notifications realted strings
#@{
	key[]: "new_event_t"
	val[]: "ÚJ ESEMÉNY" #+ Title of the event popup when showed first time for currently runing event.

	key[]: "event_t"
	val[]: "ÉLŐ ESEMÉNYEK" #+ Title of the event popup.

	key[]: "event_completed"
