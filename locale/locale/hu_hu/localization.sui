#@{
	key[]: "screenshot_man"
	val[]: "KÉPMENTÉS KEZELŐ" #+ window title

	key[]: "screenshot_preview"
	val[]: "PILLANATKÉP ELŐNÉZET" #+ window title

	key[]: "screenshot_man_link"
	val[]: "Képmentés kezelő" #+ link button title

	key[]: "screenshotman_help"
	val[]: "Segítségével a World of Trucks portálra töltheted fel elmentett képeidet."

	key[]: "screenshotman_desc"
	val[]: "Használd a Fotómódot vagy a @@imv_nrm_screenshot@@ billentyűt, hogy képeket készíts játék közben, és feltölthesd őket a World of Trucks portálra.<br>Válassz ki egy képet, utána egy elérhető helyet az online galériádban, és kattints a <color value=@@clr_sel@@>Feltöltés a kiválasztott slotba<color value=@@clr_txt@@> gombra." #+ description

	key[]: "screenshotman_slot"
	val[]: "World of Trucks galéria slotok." #+ Slots title

	key[]: "screenshotman_empty"
	val[]: "Képmentéseid itt jelennek meg." #+ Empty screenshot position

	key[]: "screenshotman_offline"
	val[]: "NINCS CSATLAKOZTATVA A PROFILOD!<br><br>A képek feltöltéséhez a profilt hozzá kell kapcsolnod az online fiókodhoz!<br><br>Szeretnéd módosítani a profilodat?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Üres hely" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Hiba" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Feltöltés a kijelölt helyre" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Legyen a profilom kamionja" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Do you want to permanently delete the following screenshot?"

	key[]: "upload_screenshot"
	val[]: "Szeretnéd feltölteni a képet a kiválasztott helyre?<br><br>A korábban feltöltött kép felülírásra kerül!"

	key[]: "upload_profile_screenshot"
	val[]: "Szeretnéd feltölteni a képet a World of Trucks profilod kamionjaként? <br><br>Az előző profilkamiont ábrázoló kép felülírásra kerül!"

	key[]: "wotr_upload_title"
	val[]: "FELTÖLTÉSI FIGYELMEZTETÉS"

	key[]: "new_screenshot"
	val[]: "Új képeket lehet feltölteni!" #+ New screenshot notification

	key[]: "uploading_screenshot"
