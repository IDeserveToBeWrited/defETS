#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "KAMION ÁLLAPOTLAP" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "Állapot" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "A jármű jelentős műszaki problémákkal küzd, amely kihat a teljesítményére és a megbízhatóságára. A javításhoz több alkatrész cseréje, vagy teljes restaurálás szükséges." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "A jármű olyan műszaki problémákkal küzd, amely kihat a teljesítményére és a megbízhatóságára. Javasolt leszervizelni a járművet!" #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "A jármű közlekedésre alkalmas, de vannak problémái. Javasolt leszervizelni!" #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "A jármű jó állapotban van. Csak minimális elhasználódás jellemzi." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "A jármű kitűnő állapotban van! Csak minimális elhasználódás jellemzi." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Karbantartás" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "A jármű teljes elhasználódását, kopását jelzi. Teljes restaurálással javítható." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Alkatrészek kopottsága" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "A jármű futása és a balesetezés az alkatrészek elhasználódásához vezetnek. Kövesd nyomon az állapotukat, és cseréld őket, amikor szükséges!" #+ Explanation unfixable wear.
