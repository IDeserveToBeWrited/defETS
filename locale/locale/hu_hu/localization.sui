#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "A képfájl mérete túl nagy. Kérlek, állítsd alacsonyabbra a felbontást." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Hibás, vagy nem támogatott formátumú képfájl!" #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "A képfájl felbontása túl nagy. Kérlek, állítsd alacsonyabbra a felbontást." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "A szolgáltatás elutasította a képmentést!" #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Ezzel a fiókkal nem lehet képeket feltölteni!" #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
