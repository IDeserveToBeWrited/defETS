#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafika" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Finomhangolt sablonok, amelyekkel az igényeidnek megfelelően állíthatod be a játék grafikus teljesítményét."

	key[]: "apply"
	val[]: "Alkalmaz" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Asztali téma" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "KIJELZŐ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "KÉPMINŐSÉG" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTÚRÁK" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "TÜKRÖZŐDÉSEK" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "ÁRNYÉKOK" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "FÉNYEK" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "UTÓFELDOLGOZÁS" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "KÖRNYEZET" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Teljes képernyős mód" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Fényerő / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Beállítások" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Felbontás" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Frissítési frekvencia" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS korlát" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS korlát háttérben futáskor" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Alapértelmezett frissítés" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikális szinkronizáció" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Energiatakarékos (akkukímélő)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "EGYSZERŰ GRAFIKAI BEÁLLÍTÁSOK" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "EGYÉNI BEÁLLÍTÁSOK ELMENTVE" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "RÉSZLETES GRAFIKAI BEÁLLÍTÁSOK" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Egyszerű / haladó grafikai beállítások" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Haladó beállítások elrejtése" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Haladó beállítások megjelenítése" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Renderelési százalék" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Élsimítás (AA)" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma élesítés" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA tuning sablon" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptív mód" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Lágy renderelés" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Éles renderelés" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "SSAO" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Nagy dinamikatartomány (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Mélységélesség" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Napsugarak" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Színjavítás" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Tükröződés minősége" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Tükröződés minősége" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Növényzet részletessége" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Fű sűrűsége" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Árnyékminőség"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Árnyékok textúramérete" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Távoli árnyékok" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Beltéri árnyékok" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Időjáráseffektek minősége"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Tükörbeli kép minősége" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Tükörfelbontás" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Tükrök látótávolsága" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Textúrák minősége" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropikus szűrés" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normal mapping" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Forgalom fényszórói" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Segédfények" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Fények távolsága" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Gyalogosok" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "A grafikai beállítások megváltoztak.<br>Megtartod az új beállításokat?"

	key[]: "reverting_in"
	val[]: "Visszaállítás" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "másodperc múlva" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

