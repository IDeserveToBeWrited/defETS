#+ Options/Keyboard
#+
#+ Screen used to configure keyboard related options.
#@{

	key[]: "keyboard_t"
	val[]: "BILLENTYŰK ÉS GOMBOK"  #+ Title of the screen. Please keep in upper case where possible.

	key[]: "keyboard_ico"
	val[]: "Billentyűk és gombok" #+ Icon opening the keyboard options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "action"
	val[]: "Funkció" #+ Header of column containing name of the function (Throttle, Activate)

	key[]: "primary"
	val[]: "Elsődleges" #+ Header of column containing a primary key/button.

	key[]: "secondary"
	val[]: "Másodlagos" #+ Header of column containing a secondary key/button.

	key[]: "na"
	val[]: "Nincs" #+ Shown if no key is configured to this slot.


	key[]: "unassign"
	val[]: "Eltávolítás" #+ Button for cancelling the existing input assignent.

	key[]: "undo"
	val[]: "Visszavonás" #+ Button to undo the previous input assignment.

	key[]: "press_key_to_assign"
	val[]: "NYOMD le a billentyűt, amihez hozzá akarod rendelni a funkciót!" #+ Key/button assignment hint.

	key[]: "press_or_hold_key_to_assign"
	val[]: "NYOMD le vagy TARTSD a billentyűt, amihez hozzá akarod rendelni a funkciót!" #+ Key/button assignment hint.

	key[]: "press_button_to_assign"
	val[]: "Nyomd meg a gombot, amihez hozzá akarod rendelni a funkciót."#+ Key/button/axis assignment hint.

	key[]: "select_input_to_unassign"
	val[]: "Válaszd ki a megszüntetni kívánt hozzárendelést." #+ Hint shown when "unassign" button pressed.

	key[]: "lost_function_binding"
	val[]: "A következő hozzárendelés elveszett:" #+ Shown when key was rebound to a different function.

	key[]: "unavailable_assignment"
	val[]: "$INPUT$ cannot be used." #+ Shown when the player presses a key that cannot in input binding.

