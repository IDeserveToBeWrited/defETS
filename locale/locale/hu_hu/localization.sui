#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "A kontroller altípusának kiválasztására szolgál, hogy megfelelően beállítható legyen a kontroller beviteli tartománya."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "A váltó típusát választhatod ki vele:<br>- Az \"Egyszerű automata\" beállítással sima gázadás és fékezés mellett haladhatsz előre és hátra.<br>- \"Valódi automata\" beállításnál külön kell váltanod az előre- és hátramenet között.<br>- \"Szekvenciális\" váltó esetén külön kell váltanod az egyes sebességfokozatok között.<br>- \"H-váltó\" beállítás esetén külön váltókulisszás perifériával kell vezetned."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Az automataváltó váltási logikájának beállítására szolgál.<br>- A \"Gazdaságos\" üzemmód nyomatékosabb, és alacsonyabb fordulatszám mellett vált.<br>- A \"Teljesítmény\" mód maximalizálja az elérhető lóerőt. Utóbbi így jobb teljesítményt biztosít hegymenetben és súlyosabb rakományok esetén, de növeli a fogyasztást."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "A beviteli periféria fordulási fok arányának beállítása a játékbeli jármű fordulási fokához képest."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "A beviteli eszköz és a játékbeli jármű kormányzása közötti linearitás beállítására szolgál.<br><br>Magasabb értékek esetén a kormányzás kevésbé érzékeny, ha a kormány a középponthoz közelebb helyezkedik el, míg a szélekhez közeledve egyre érzékenyebbé válik. Ez segíthet elsimítani az egyenes vonalban vezetés során fellépő felesleges kormányzási inputot."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Az erő-visszacsatolási (force feedback) effektek bekapcsolására szolgál támogatott perifériák esetén."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Az erő-visszacsatolási (force feedback) effektek általános erejének beállítása 0N és 10N között.<br><br><color value=@@clr_txt_d@@>Légy óvatos, mert erősebb perifériák esetén a magasabb értékek kéz- és ujjsérülést okozhatnak!"

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "A középre kormányzás erejét befolyásolja nagy sebesség mellett (ennek csúcspontja 90 km/h vagy 56 mph, és afelett található).<br><br>Minimum beállítás esetén nincs középre kormányzási hatás."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "A középre kormányzás erejét befolyásolja alacsony sebesség mellett.<br><br>Minimum beállítás esetén nincs középre kormányzási hatás."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "A mesterséges, mechanikus kormányzási elemek keltette belső súrlódási effektek erejének beállítására szolgál."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "A járó motor keltette mesterséges rezonancia-effekt mértéke a kormányoszlopban.<br><br><color value=@@clr_txt_d@@>Légy óvatos, mert ez a beállítás 15% vagy afeletti érték esetén túlzott remegést és vibrációt okozhat egyes kormányokban!"

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Az úttest egyenetlenségei keltette rezgés mértéke a kormányoszlopban.<br><br><color value=@@clr_txt_d@@>Légy óvatos, mert ez a beállítás 20% vagy afeletti érték esetén túlzott remegést és vibrációt okozhat egyes kormányokban, ha nagy sebességgel hajtasz egyenetlen talajon!"

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "A bukkanók keltette rezgés mértékét állíthatod vele a kormányoszlopban."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Az ütközések keltette rezgés mértékét állíthatod vele a kormányoszlopban."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "A váltódarálás keltette rezgés mértékét állíthatod be vele."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Az alulkormányzás effektjeinek mértékét állíthatod be vele."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "A kormányzási segédletek (például a sávtartó automatika) erejét szabályozhatod vele."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "A terep keltette rezgések erősségének beállítására szolgál, ha a kontroller támogatja a rezgés effekteket."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "A bukkanók keltette rezgések erősségének beállítására szolgál, ha a kontroller támogatja a rezgés effekteket."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Az ütközések keltette rezgések erősségének beállítására szolgál, ha a kontroller támogatja a rezgés effekteket."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Az eszköz kormányzási tengelyének beállítására szolgál."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "A kormányzási tengely holtjátékának beállítására szolgál. A holtjáték az a beállított távolság a tengely közepétől számítva, amelyen belül a kormányzást ignorálja a játék.<br><br>Ez segíthet a régebbi perifériák elhasználódásából eredő pontatlan és hibás beviteli inputok kiszűrésében."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "A kormánytengely kezelésének módját állíthatod be vele.<br>- A \"Középre igazított\" beállítás ideális kormányokhoz és joystickokhoz.<br>- A \"Fordított\" beállítás helytelenül érzékelt tengely esetén hasznos."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "A gázadásra szolgáló tengely beállítása."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "A gázadási tengely holtjátékának beállítására szolgál. A holtjáték az a beviteli mérték, amelyen belül a gázadást ignorálja a játék.<br><br>Ez segíthet a régebbi perifériák elhasználódásából eredő pontatlan és hibás beviteli inputok kiszűrésében."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "A kuplungtengely kezelésének módját állíthatod be vele.<br>- A \"Középre igazított\" beállítás ideális joystickokhoz.<br>- A \"Normál\" ravaszok és pedálok esetén megfelelő választás.<br>- A \"Fordított\" beállítás helytelenül érzékelt tengely esetén hasznos."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Az eszköz féktengelyének beállítására szolgál."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "A féktengely holtjátékának beállítására szolgál.<br><br>A holtjáték az a beviteli mérték, amelyen belül a fékezést ignorálja a játék. Ez segíthet a régebbi perifériák elhasználódásából eredő pontatlan és hibás beviteli inputok kiszűrésében."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "A kuplungtengely kezelésének módját állíthatod be vele.<br>- A \"Középre igazított\" beállítás ideális joystickokhoz.<br>- A \"Normál\" ravaszok és pedálok esetén megfelelő választás.<br>- A \"Fordított\" beállítás helytelenül érzékelt tengely esetén hasznos."

