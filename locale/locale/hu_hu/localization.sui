#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "BEVITELI MÓD KIVÁLASZTÁSA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Játékvezérlők"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>A varázsló a csatlakoztatott eszközöknek megfelelő javasolt beállításokat fogja alkalmazni.<br><color value=@@clr_sel@@>Ha Steam-kompatibilis kontrollert használsz, akkor javasoljuk, hogy engedélyezd a konfigurációs támogatást a Steam-kliens következő menüjében: <br><color value=@@clr_txt_d@@> Steam > Beállítások > Játékvezérlő > Általános játékvezérlő-beállítások"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "A kamiont a billentyűzettel irányítod, míg a világban az egérrel nézel körül. Ez az irányítás legegyszerűbb és legkevésbé precíz formája, viszont mindenki számára elérhető."

	key[]: "wiz_control_mouse"
	val[]: "A precíz kormányzáshoz használd az egeret. Más tevékenységeket továbbra is a billentyűzettel végezhetsz. Az egérrel ilyenkor abban az esetben tudsz körülnézni, ha egyidejűleg lenyomva tartod a kamerakezelő billentyűt vagy gombot. "

	key[]: "wiz_control_controller"
	val[]: "A legvalósághűbb játékélmény érdekében használj kormányt, gamepadet vagy joystickot. Számos tevékenységet billentyűkombinációkkal érhetsz el, a kameraállást pedig az egérrel állíthatod.  "
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nem található játékvezérlő. Ehhez a választási lehetőséghez előbb csatlakoztatnod kell egyet! "

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Rendelkezésre álló játékvezérlők keresése..."

#@}

