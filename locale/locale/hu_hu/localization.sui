#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "IRÁNYÍTÁS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "BINDINGS" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "ADVANCED SETUP" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "Irányítás" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "BEVITELI MÓD" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "KONTROLLER" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "KONTROLLER VISSZACSATOLÁS" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "KONTROLLER TENGELYEK" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Csak billentyűzet" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Billentyűzet" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Kormányzás egérrel" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Kormányzás és pedálhasználat egérrel" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Semmi" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "Kontroller vagy kormány gyors beállítása"

#+ Selection of the controller subtype
#@{

	key[]: "controller_subtype"
	val[]: "Kontroller altípus" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "Kormány" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
	val[]: "Gamepad, joystick" #+ Gamepad like device. Value of the input controls speed of turning of the vehicle wheels.
#@}


	key[]: "steer_sens"
	val[]: "Kormányzás érzékenysége"

	key[]: "steer_nonlin"
	val[]: "Kormányzás non-linearitása"

#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "Erő-visszacsatolás" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "Vissza alapértelmezettre" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Erő-visszacsatolás ereje" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "Középre fordulás ereje nagy sebességnél" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "Középre fordulás ereje alacsony sebességnél" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "Belső súrlódás" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "Motorvibráció ereje" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "Domborzati effektek ereje" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "Bukkanók ereje" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "Ütközések ereje" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "Váltódarálás effekt" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "Alulkormányzás effekt" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "Kormányzás rásegítés" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "Terepvibráció ereje" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "Bukkanóvibráció ereje" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Ütközésvibráció ereje" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

	key[]: "ffb_lut_usage_hint"
	val[]: "A játék egyedi force feedback LUT-ot használ, amelyhez nem tudunk támogatást nyújtani! Amennyiben problémád támadna az erő-visszacsatolás effektekkel, távolítsd el a fájlt a felhasználói profilod mappájából!" #+ Hint telling player that the game is using custom force feedback LUT loaded from profile folder and to remove it in case of problems.
#@}

