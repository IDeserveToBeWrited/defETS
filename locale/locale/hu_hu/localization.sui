#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "KONTROLLER TÍPUS KIVÁLASZTÁSA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Kormány"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad vagy joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "A vezérlő a kormányod, vagy legalábbis annak megfelelően viselkedik. A vezérlő helyzete közvetlenül meghatározza a kormány helyzetét a játékban. "

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "A játékvezérlő gamepad vagy joystick. A játékvezérlő pozíciója határozza meg a játékban a kormány tekerésének sebességét. "
#@}

