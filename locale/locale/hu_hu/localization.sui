	val[]: "Nem sikerült a szűrőknek vagy a képzettségednek megfelelő munkát találni" #+ Text shown when there are no jobs found by filters.
#@}

#+ Game demo related strings.
#@{
	key[]: "demo_quit"
	val[]: "Tényleg kilépsz?" #+ The quit confirmation message
#@}

#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS-HOZ CSATLAKOZTATOTT TARTALMAK" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Csatlakoztatás" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Böngészés" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "ÁLTALÁNOS BEÁLLÍTÁSOK" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "TARTALOM CSATLAKOZTATÁS" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Csatlakoztatás" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "A World of Trucks új játéktartalmat érzékelt. Csatlakoztasd a World of Trucks szolgáltatáshoz, hogy használni tudd!" #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online opciók. Itt állíthatod be a World of Trucks-hoz kötődő beállításokat." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Valóban szeretnéd elnapolni a regisztrációt?<br><br>A későbbiekben az Online Tartalomcsatlakoztatás ablakot a főmenü Online Beállítások menüjéből érheted el." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "TARTALOM CSATLAKOZTATÁSA" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Tartalom csatlakoztatása..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Nem sikerült a kapcsolódási művelet a következő elemmel: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "A DLC regisztrálásához használt Steam fiók eltér attól, amelyet a World of Trucks fiók létrehozásához vagy a játék regisztrálásához használtál. Válts Steam-fiókot, majd próbáld újra!" #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "A DLC regisztrációjához használt Steam fiók egy másik World of Trucks fiókhoz van társítva. A DLC jelenlegi fiókhoz való kapcsolásához használj egy olyan Steam fiókot, ami még nincs World of Trucks fiókhoz társítva!" #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "A Steam token lejárt! Kérlek próbálkozz újra később!" #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "A DLC aktiválásához használt kulcs nem érvényes. Lépj kapcsolatba a támogatással ezen a címen: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Belső hiba lépett fel a játék regisztrálása közben! Kérlek próbálkozz újra később!" #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SIKER" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMÁCIÓ" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "TARTALOMBÖNGÉSZŐ" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Gratulálunk! A kiválasztott DLC-k sikeresen hozzákapcsolódtak a World of Trucks fiókodhoz!" #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nem sikerült tartalmat csatlakoztatni, mert a jelenlegi Steam fiók egy másik World of Trucks fiókhoz van társítva!" #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Néhány DLC-nek nem sikerült csatlakoznia!<br>A részletekért mozgasd az egérmutatót a DLC-k melletti felkiáltójelek fölé." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "$CURRENT_CONTENT_NAME$ regisztrálása" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "A jelenlegi profil nincs a World of Trucks-hoz csatlakoztatva, vagy a játék offline módban fut! Módosítsd a profilodat!" #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Elutasítás"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ jelenleg kompatibilis DLC van csatlakoztatva. Ha egy DLC nincs csatlakoztatva, annak egyes szolgáltatásai esetleg nem elérhetők." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Gratulálunk!<color value=@@clr_txt@@>Minden tartalmat csatlakoztattál a World of Trucks-hoz! Immár minden funkciójuk elérhető számodra!" #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Nem sikerült új tartalmat küldeni a World of Trucks oldalnak, mert a jelenleg használt Steam-fiók nem egyezik meg a World of Trucks profilhoz kapcsolt Steam fiókkal!" #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Csatlakoztatva" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nincs csatlakoztatva!" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Nem sikerült információt szerezni a birtokolt tartalmakról!" #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Nem sikerült információt szerezni a csatlakoztatott tartalomról!" #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Nem sikerült információt szerezni a jelenleg használt fiókról!" #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Később" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Nem sikerült regisztrálni a DLC-t! A játék nem talált tartós licencet, valószínűleg a Steam Családi Megosztás miatt." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Nem birtokolt tartalom" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Különleges megbízatás teljesítve!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "SIKERTELEN MEGBÍZATÁS!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Lemondás"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Mentés visszatöltése"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Kárt okoztál az egyik kísérőautóban!<br>Az újrapróbálkozáshoz tölts be egy mentést, de akár le is mondhatod a fuvart. Utóbbi esetben viszont $MONEY$ büntetést kell fizetned!"

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "A felelőtlen vezetésed miatt a kísérőautó karambolozott a forgalommal!<br>Az újrapróbálkozáshoz tölts be egy mentést, de akár le is mondhatod a fuvart. Utóbbi esetben viszont $MONEY$ büntetést kell fizetned!"

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Nem követted a kijelölt útvonalat!<br>Az újrapróbálkozáshoz tölts be egy mentést, de akár le is mondhatod a fuvart. Utóbbi esetben viszont $MONEY$ büntetést kell fizetned!"

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Nem követted a kísérőautókat!<br>Az újrapróbálkozáshoz tölts be egy mentést, de akár le is mondhatod a fuvart. Utóbbi esetben viszont $MONEY$ büntetést kell fizetned!"

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Elhagytad a kísérőautókat!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Kárt okoztál az egyik kísérőautón!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Összetört az egyik kísérőautó!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Elhagytad a kijelölt útvonalat!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Méretek"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Különleges rakomány szállítása"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Maradj a rakományoddal a kísérőautók között!"

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Különleges szállítmányok"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Méretek"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Különleges szállítmány"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Lassíts, hogy neki ne ütközz a kísérőautónak!"

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Várd be a hátsó kísérőautót..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Most légy nagyon óvatos! A következő szakasz különösen szűkös lesz..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Sávváltás következik! Változtass a sebességeden, hogy elkerüld az esetleges ütközést..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Az első kísérőautó figyelmeztetni fogja a forgalmat...<br>Igazítsd hozzá a sebességedet, hogy elkerüld az ütközést!"

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "A kísérőautók a közeli kereszteződésnél várnak. Kövesd a megadott útvonalat!"

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Légy óvatos!<br>A hátsó kísérőautó felé haladsz!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Vigyázz!<br>Veszélyesen közel kerültél a hátsó kísérőautóhoz!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "A következő billentyű megnyomásával tekintsd meg az ajánlott speciális megbízatást:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Különleges megbízatás:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Elvállaltál egy különleges szállítmányt! A fuvar során két kísérőautó lesz segítségedre. Légy óvatos, és kövesd őket, valamint az értesítésekben jelzett javaslatokat! Az ehhez hasonló különleges szállítmányokra nem vonatkozik a piros lámpa, és a legtöbb esetben elsőbbségük van. A megbízatás során a játék gyakrabban ment játékállást, mint normál fuvarok esetén."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "A fuvar során mindig tartsd be a következőket:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Ne ütközz a kísérőautókkal, és tartsd közöttük a járművedet valamint a rakományt!"

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ne hajts le a meghatározott útvonalról, még töltőállomásokhoz és pihenőhelyekhez se!"

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Tartsd be az első kísérőautó által diktált sebességhatárokat!"

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Ügyelj a járművedet előző forgalomra és az úton közlekedő többi sofőrre!"

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Tartsd be a sávváltás menetét:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Ha nem követed ezeket a szabályokat, a különleges megbízatásod sikertelen lehet!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "A manővert a <color value=@@clr_sel@@>hátsó<color value=@@clr_txt@@> kísérőautó kezdi a megadott sávba váltással, és így annak lezárásával."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Az <color value=@@clr_sel@@>első<color value=@@clr_txt@@> kísérőautó megvárja, amíg az adott sáv szabaddá válik, majd ő is sávot vált."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Amint a kísérőautók biztosították a megadott sávot, <color value=@@clr_sel@@>Te<color value=@@clr_txt@@> is besorolhatsz közéjük."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "A megbízatást teli tankkal és kipihenten, maximális vezetési idővel kezdheted."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "A kamionmentő nem elérhető különleges megbízatások alatt!"

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "A komp nem elérhető különleges megbízatások alatt!"

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Kipihened magad...<br>A kamiont addig feltankolják..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Kötelező pihenő következik!<br>Kövesd a kísérőautókat a parkolóhelyhez, hogy kipihend magad!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Kötelező megállás"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Nyomd le a következő gombot a pihenéshez és tankoláshoz:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Hiba történt a Steam Raktár tartalom betöltésekor!<br><br>$ERROR$<br><br>Kattints a folytatásra, hogy engedélyezve maradjon a tartalom. A játék időszakosan keresni fogja.<br><br>Ha nem szeretnéd, hogy ehhez hasonló üzenetek jelenjenek meg, átmenetileg le is tilthatod a tartalmat. A játék a következő indításkor ismét engedélyezni fogja azt." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Nem sikerült a Steam Raktár elemek letöltése." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM RAKTÁR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Steam Raktár elemek betöltése..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "ÚJ RAKTÁR ELEMEK" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Új Steam Raktár elemeket érzékeltünk." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Járműtartozék" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Vezetőfülke-kiegészítők" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Asztali háttér" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Festések" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Raktár letiltása" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Próbáld újra később" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM RAKTÁR" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Eltávolításra került pár elem a Steam Raktáradból, melyeket ezután nem tudsz megvásárolni a műhelyben!<br><br>Ez nincs kihatással a kamion(ok)ra jelenleg felszerelt elemekre." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


