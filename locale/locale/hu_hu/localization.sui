	val[]: "A játék maximális képkockaszámának beállítására szolgál.<br><br>Ha 0-ra állítod, a funkció letiltásra kerül."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "A játék maximális képkockaszámának beállítására szolgál, amikor a program a háttérben fut.<br><br>Ha 0-ra állítod, a funkció letiltásra kerül."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Az egyszerű grafikai sablonok és a részletesebb testreszabást lehetővé tevő grafikai beállítások közötti váltásra szolgál."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "A grafikai minőség feljavítására szolgál oly módon, hogy a játékot belsőleg magasabb felbontáson rendereli, csökkentve így a recés éleket és növelve a részletességet.<br>A magasabb százalékok tisztább és kevésbé elmosódott képet eredményeznek, az általános teljesítmény rovására.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában nagy hatással van a teljesítményre."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Az elérhető élsimítási (anti-aliasing, avagy AA) módszerek, amelyekkel csökkentheted a recés éleket a játékban:<br>- Az SMAA eljárás (a választott minőségtől függően) minden egyes pixelt többször is mintavételez a képkocka különböző részein, majd átlagolja a mintát, hogy legenerálja a végső képet.<br>- A TAA eljárás ugyanakkor minden pixelt csak egyszer mintavételez képkockánként, de különböző részeken és képkockákban teszi azt.<br>- A legjobb képminőség eléréséhez javasolt a két eljárás kombinációját használnod (ami viszont teljesítményromlással járhat).<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "A bekapcsolása esetén a játék halvány árnyékokat renderel a réseken és az egymáshoz közel eső objektumokon, ezzel javítva a játékvilág általános grafikai minőségét.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "A TAA élsimítási sablon kiválasztására szolgál:<br>- A \"Lágy renderelés\" kevesebb vibrálással, de nagyobb elmosódottsággal jár, és ideális választás akkor, ha magas renderelési százalékkal, magas DPI-vel rendelkező monitorral, vagy 1080p-s tévével, de attól távolabb ülve játszol.<br>- Az \"Éles renderelés\" több vibrálással, de kisebb elmosódottsággal jár, és ideális 1080p felbontás alatti kijelzőkhöz, például laptopokon vagy Steam Decken való játékhoz.<br>- \"Adaptív mód\" esetén ugyanakkor a TAA vibrálás dinamikusan lefojtásra kerül, ha a kamera statikus képet mutat.<br><br><color value=@@clr_txt_d@@>Ez a beállítás csak akkor használható, ha élsimítási megoldásként a TAA van kiválasztva."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "A TAA élsimítás luma-élesítésének erejét szabályozza.<br><br><color value=@@clr_txt_d@@>Ez a beállítás csak akkor használható, ha élsimítási megoldásként a TAA van kiválasztva."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, akkor a játékvilág távolabb eső területei elmosódottan jelennek meg, ezzel növelve a valós távolságérzetet."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, akkor a nap sugarai láthatóvá válnak a játékbeli napra nézve, főleg ha fákon, épületeken vagy járműveken keresztül teszed azt."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, akkor a játék a színeket dinamikusan módosítja esztétikai okokból. Ez látványosabbá teheti a különböző napszakokat és időjárási viszonyokat, vagy épp élénkebbé a járművek és egyéb objektumok színét."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Javítja a tükröződés minőségét, egyrészt a magasabb minőségben való rendereléssel, másrészt a jobb élsimítási módszer használatával.<br><br><color value=@@clr_txt_d@@>Ennek a beállításnak a módosítása csak a játék újraindítása után lép életbe."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "A járművek felületén, az ablakokon, és az egyéb tükröződő felületeken, például tócsákon, nedves úttesten és vízfelületeken látható tükröződés minőségét szabályozhatod vele.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre.<br><br>Ennek a beállításnak a módosítása csak a játék újraindítása után lép életbe."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "A növényzet és fák részletességét, összetettségét szabályozhatod vele.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Az út mentén látható fű sűrűségét szabályozza.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "A Nap és a Hold által vetett árnyékok minőségét szabályozza.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, a nagyon távoli objektumok is árnyékot vetnek.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Engedélyezi az éjszakai árnyékokat a jármű belterében.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Az időjárási effektek, mint pl. a visszatükröződések minőségének beállítására szolgál."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "A jármű visszapillantó tükreiben lévő kép minőségét szabályozza (függetlenül a tükröződési beállításoktól).<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "A jármű tükreiben megjelenő kép felbontását szabályozza."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Azon távolság beállítására szolgál, amelyen belül a játék kirajzolja az objektumokat a tükrökben.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában nagy hatással van a teljesítményre."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Az objektumok és felületek textúráinak minőségét állíthatod be vele."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "A textúrák élességét szabályozza, főleg ha azok távolabb találhatók, vagy ferde szögben láthatóak.<br><br><color value=@@clr_txt_d@@>Ennek a beállításnak a módosítása csak a játék újraindítása után lép életbe."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "További geometrikus részleteket ad a járdákhoz, úttestekhez és egyéb objektumokhoz, hogy javítson azok megjelenésén.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre.<br><br>Ennek a beállításnak a módosítása csak a játék újraindítása után lép életbe."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, akkor a forgalom többi járművének fényszórói is fényt vetnek."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, akkor a forgalom többi járművének irányjelzői és féklámpái is fényt vetnek."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Azon távolság beállítására szolgál, amelyen belül a mesterséges fényforrások láthatóvá válnak.<br><br><color value=@@clr_txt_d@@>Ez a beállítás általában mérsékelt hatással van a teljesítményre."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Ha bekapcsolod, gyalogosok népesítik be a játékvilágot."
#@}

