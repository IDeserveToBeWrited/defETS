	val[]: "Játékvezérlő beállítások megnyitása"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>A @@imm_wiz_dsteerleft@@ és @@imm_wiz_dsteerright@@ segítségével kormányozhatsz."

	key[]: "wiz_cfg_steer_mouse"
