#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "A játék menüjének böngészése közben látható háttértémák."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Eme beállítással a játék minden indításkor véletlenszerűen választ háttértémát."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Azon időtartam, amely után az asztalon található elemek elhalványulnak."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "A bekapcsolása esetén a karaktered idővel elfárad.<br><br>A pihenőidők be nem tartása idővel büntetéssel jár!"

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "A bekapcsolása esetén be kell tartanod a közlekedési szabályokat, különben megbüntethetnek! Rendőrautók, kamerák és sebességmérők közelében nagyobb eséllyel kaphatsz büntetést."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "A felkínált fuvarok átlagos hosszát szabályozza."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "A navigáción kijelzett sebességkorlátozás típusát állíthatod be vele."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "A navigáción a jelenlegi sebesség színe pirosra vált, ha túlléped a megengedett sebességet."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha odaértél a célállomáshoz, egy üzenet felajánlja a számodra a parkolás átugrását."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Minden virtuális grafikai elem elrejtése."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mindkét virtuális tükör elrejtése."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Minden értesítés elrejtése azok érkezésekor is."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Bekapcsolás esetén ha megpróbálsz elvállalni egy túlsúlyos fuvart, a játék egy külön ablakban megjeleníti a kamionod menettulajdonságait."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "A térkép tájolásának módját állíthatod be vele."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Válaszd ki, hogyan fedezed fel a világtérképet:<br>- Közelségi felfedezés: nagyobb területet fedez fel.<br>- Precíz felfedezés: csak a hozzád legközelebb eső területet fedezi fel."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "A navigáció megjelenítésének módját szabályozza."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "A GPS útvonaltervezési módját szabályozhatod vele:<br>- A \"Legjobb\" beállítással a leghatékonyabb (a távolságot és a menetidőt is figyelembe vevő) útvonalat tervezi meg a rendszer, és igyekszik elkerülni a lámpás útkereszteződéseket.<br>- A \"Legrövidebb\" beállítás mindig a legrövidebb útvonalat választja.<br>- A \"Másodrendű utak\" beállítás igyekszik elkerülni az autópályákat, amikor lehetséges."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "A parkolás nehézségét szabályozhatod vele:<br>- A \"Mindig kiválaszt\" opció esetén Te választhatod ki a parkolóhelyet megérkezéskor.<br>- \"Könnyű parkolás\" esetén nem kell tolatnod.<br>- \"Képzett parkolás\" esetén nehezebb tolatásokra is fel kell készülnöd."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "A közúti veszélyek (úgymint balesetek, lerobbant járművek, törmelékek, stb.) gyakoriságát szabályozhatod vele."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "A fuvar közben előforduló elterelések gyakoriságát szabályozhatod vele."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "A rossz időjárás gyakoriságát szabályozhatod vele."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "A bekapcsolása esetén a jelenlegi idő mellett az időzóna információi is megjelennek."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, a játék átvezető animációkat játszik le a fontosabb eseményeknél, pl. kamionvásárlásoknál, garázsfejlesztéseknél és utasok felszállásakor."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, a program áttetsző határvonalakkal fogja jelezni a játékvilág határain kívül eső, nem bejárható utakat."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Az egér Y-tengelyének megfordítása a játékbeli kamera kezelésekor."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "A váltó típusát választhatod ki vele:<br>- Az \"Egyszerű automata\" beállítással sima gázadás és fékezés mellett haladhatsz előre és hátra.<br>- \"Valódi automata\" beállításnál külön kell váltanod az előre- és hátramenet között.<br>- \"Szekvenciális\" váltó esetén külön kell váltanod az egyes sebességfokozatok között.<br>- \"H-váltó\" beállítás esetén külön váltókulisszás perifériával kell vezetned."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor átugorhatod az egyes sebességfokozatokat, azaz nem kell sorrendben az összes sebességfokozatba beváltanod."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor billentyűzet vagy kontroller használata esetén a kormánykerék automatikusan visszaáll középső helyzetbe.<br><br>Ha kikapcsolod, akkor saját magadnak kell középre visszakormányoznod a kormányt."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "A kormányzás animációjának terjedelmét szabályozhatod vele. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "A fék erejét módosíthatod vele."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "A jármű stabilitását szabályozhatod vele, a tömegközéppontjának a csökkentésével."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "A pótkocsi stabilitását szabályozhatod vele, a tömegközéppontjának a csökkentésével."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "A hajtáslánc nyomatékának erejét szabályozhatod vele.<br><br>Magasabb beállítások esetén a járműved hajlamos lehet jobbra \"húzni\"."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Az alváz felfüggesztésének merevségét állíthatod be vele."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "A vezetőfülke rugózásának merevségét állíthatod be vele."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "A procedurálisan generált útegyenetlenségek erősségét szabályozhatod vele. Ezek célja, hogy az úttest és egyéb felületek hibáit szimulálja.<br><br>A felfüggesztési és kamerabeállításoktól függően eltérő mértékben lehet érezhető."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor sokkal pontosabban kell a kamion nyeregszerkezetét a pótkocsi királycsapjára tolnod.<br><br>Ha kikapcsolod, akkor sokkal egyszerűbb lesz felkapcsolnod a pótkocsikat, mivel nem lesz ütközésvizsgálat a nyereg és a csap között."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "A pótkocsikábelek animálásának mértékét szabályozza.<br><br><color value=@@clr_txt_d@@>Régebbi rendszereken a több kábel engedélyezése ronthatja a teljesítményt."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "A jármű beépített sebességlimiterének engedélyezésére szolgál.<br><br><color value=@@clr_txt_d@@>World of Trucks-fuvarok esetén ez a beállítás mindig be van kapcsolva."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Ha engedélyezed, és az ablaktörlők az első törlési pozícióba vannak állítva, akkor az ablaktörlők automatikusan bekapcsolnak, és az időjárásnak megfelelő sebességgel működnek."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Fékezés esetén automatikusan bekapcsolja a retardert."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "A jármű emelkedőn induláskor fékez, ezzel segítve a biztonságos elindulást."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Fékezés esetén automatikusan bekapcsolja a motorféket."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, a motor gázadás esetén automatikusan beindul."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor bizonyos események (pl. kompozás, szervizbe vontatás vagy gyorsutazás) után a rögzítőfék automatikusan be lesz kapcsolva."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor a játék (a jármű tömegétől függően) automatikusan leereszti az emelhető tengelyeket, amikor szükséges."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the throttle button is released.<br><br>Affects keyboard input only."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Az eltúlzott fékhasználatból eredő légveszteséget szimulálja.<br><br>Ha bekapcsolod, akkor lejtőn haladva vagy óvatos manőverezéskor óvatosabban, megfontoltabban kell majd használnod a féket."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor az ABS rendszer megelőzi a kerekek blokkolást, megőrizve a jármű irányíthatóságát és javítva a fékezést."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, a játék fékezéskor minden kereket befékez, hogy javítsa az irányíthatóságot, és megelőzze a kipörgéseket, az alulkormányzást, vagy épp a túlkormányzást."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor a tapadás javítása érdekében a játék automatikusan bekapcsolja a jármű differenciálzárját, amikor a kerekek elkezdenek megcsúszni."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "A tempomat lépésközést szabályozhatod vele, amikor az adott gombbal növeled vagy csökkented a beállított sebességet."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "A tempomat érzékenységét szabályozhatod vele, amikor beállítasz egy célsebességet."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, a tempomat úgy állítja be a sebességet, hogy biztonságos távolságot tarthasson közted és az előtted haladó jármű között."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor ütközésveszély esetén automatikusan vészfékezni fog a kamionod.<br>Válaszd ki, hogy ez csak járművekre, vagy minden akadályra vonatkozzon-e!"

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "A sávtartási mód kiválasztására szolgál:<br>- A \"Sávelhagyási figyelmeztetés\" beállítással a jármű hangjelzést küld, ha kezded elhagyni a sávodat.<br>- A \"Sávtartási támogatás\" beállítás ugyanakkor a hangjelzés mellett automatikusan vissza is kormányozza a sávba a járművedet.<br><br>Mindkét beállítás csak 55 km/h (~35 mph) felett aktív,<br>és figyelembe veszik, hogy használod-e sávelhagyás előtt az irányjelződet."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Bekapcsolja a holttérfigyelő-szenzort, ha a járműved fel van szerelve vele."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, és a fényszórók az első pozícióba vannak állítva, akkor a fényszórók gyenge fényviszonyok esetén automatikusan felkapcsolnak."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, és fel vannak kapcsolva a távolsági fényszórók, akkor a kamionod automatikusan tompított fényszórókra kapcsol vissza, ha szembejövő vagy közeli járművet érzékel."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor kanyarodás után a kormány középre állításával automatikusan lekapcsol az irányjelző."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor egyes beltéri elemek (lógó díszítések, bólogató figurák, stb.) külön fizikai szimulációt kapnak."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor a beltéri kamera mozgása követni fogja a kormányzást."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "A kormányzást követő kameramozgás mértékét szabályozhatod vele. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "A kormányzást követő kameramozgás mértékét szabályozza tolatáskor."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor irányjelzéskor az annak megfelelő irányba fordul a beltéri kamera."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, akkor a beltéri kamera leköveti a jármű mozgását."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Itt állíthatod be, hogy mennyire erősen reagáljon a beltéri kamera a jármű mozgására."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ha bekapcsolod, a beltéri kamera a horizont egy adott pontjához rögzül, a jármű gördülési irányától függetlenül."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes how much the interior camera FOV is changed with vehicle movement speed."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "A kamera automatikus középre igazításának késleltetését szabályozhatod vele.<br><br>A funkció csak akkor működik, ha a járműved nem alacsony sebességgel halad. Előremenetben csak a beltéri és követő kamerákat, hátramenetben pedig a hátranézést befolyásolja."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "A kamera mozgásának sebességét szabályozhatod vele az automatikus középre igazítás és a beltéri kamerasablonok közötti váltás során."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "A beltéri nagyítás módját állíthatod be: a gomb nyomvatartása közben nagyítson, vagy gombnyomásra kapcsolódjon be és ki." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "A játék nyelvét választhatod ki itt."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "A játékban használt mértékegységek és pénznemek kiválasztása régió szerint."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor a városok és országok nevei a kiválasztott nyelven fognak megjelenni."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor a városok és országok nevei a kiválasztott nyelven és az adott város/ország hivatalos nyelvén is kiírásra kerülnek."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "A játékban használt pénznem kiválasztása."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Válaszd ki, hogy az idő 12 vagy 24 órás formátumban legyen-e jelezve."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "A játék által használt hosszmértékek kiválasztására szolgál."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "A játék által használt súlymértékek kiválasztására szolgál."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "A játék által használt hőmérsékleti mértékegységek kiválasztására szolgál."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "A játék által használt nyomásegységek kiválasztására szolgál."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "A játék által használt térfogategységek kiválasztására szolgál."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "A játék által használt üzemanyag-fogyasztási egységek kiválasztására szolgál."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor konvojmenetek alatt a \"Használ\" (@@imv_nrm_activate@@) billentyűvel tudod megnyitni a csetablakot."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor a cset beviteli mezője az üzenetek elküldése után is aktív marad."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor a csetüzenetek pár másodperc után eltűnnek."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Itt állíthatod be, hogy meddig látszódjanak a csetüzenetek, mielőtt eltűnnének."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Ha bekapcsolod, akkor konvojmenetek során a játékosok neve megjelenik a járművük felett."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Egy részletes menü megnyitása, amellyel gyorsválaszokat szerkeszthetsz a konvojmenetekhez."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "A World of Trucks-fiókodhoz kapcsolt tartalmak státuszát ellenőrzi."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Engedélyezi, hogy online híreket tölthessen le a játék a nyitólapra."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Engedélyezi, hogy közösségi képmentéseket tölthessen le a játék a World of Trucks weboldalról, amik aztán a töltőképernyőkön jelennek meg."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Engedélyezi, hogy a program a játékon belüli hirdetőtáblákra valódi hirdetéseket tölthessen le."
