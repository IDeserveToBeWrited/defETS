	key[]: "eye_extended_view_op_tooltip"
	val[]: "Engedélyezi a \"Kiterjesztett nézet\"-et, amellyel a fej- és szemmozgásod segítségével növelheted meg a látószögedet, és kezelheted a játékbeli kamerát."

	key[]: "eye_preset_op_tooltip"
	val[]: "Az elérhető \"Kiterjesztett nézet\" sablonok."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Az elérhető fejmozgás-követési módok kiválasztására szolgál:<br>- \"Közvetlen\" mód esetén a fejmozgásodat egy az egyben leköveti a játékbeli kamera mozgása, ami így ideális a beltéri nézetben való játékhoz.<br>- \"Dinamikus\" mód esetén a tekinteted viszont csak akkor befolyásolja a játékbeli kamerát, ha ténylegesen elforgatod a fejedet. Ez a mód így akkor javasolt, ha fontos, hogy a tekinteted a középpontban maradjon."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Ha bekapcsolod, akkor a program lassan és folyamatosan középre igazítja a játékbeli kamerát, amikor megváltozik a fejed természetes tartása a játék során."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Engedélyezi, hogy a fejed pozíciója kihasson a játékbeli kamera pozíciójára."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Ha bekapcsolod, akkor a játékbeli kamera leköveti a fejed oldalirányú billentését."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "A horizontális fej- és tekintetmozgás együttes sebességét szabályozza a szorzómérték beállításával (a kamionban ülve)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "A függőleges irányú fej- és tekintetmozgás együttes sebességét szabályozza a szorzómérték beállításával (a kamionban ülve)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "A horizontális fej- és tekintetmozgás együttes sebességét szabályozza a szorzómérték beállításával (séta közben)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "A függőleges irányú fej- és tekintetmozgás együttes sebességét szabályozza a szorzómérték beállításával (séta közben)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Milyen gyorsan kövesse le a játékbeli kamera a szemmozgásodat."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "A szemmozgás-követés sebességének mértékét állíthatod vele."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Azon távolság a képernyő közepétől, ahol a szemmozgás-követés gyorsítása elkezd kiegyenlítődni."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Azon távolság a képernyő közepétől, amelytől ha távolabb nézel, a játékbeli kamera elkezdi követni a tekintetedet."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Azon távolság a képernyő közepétől, amelytől a játékbeli kamera maximális sebességgel követi a tekintetedet."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Milyen messzire forduljon el a kamera, ha a képernyő széléhez ér a tekinteted."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Milyen gyorsan reagáljon a játékbeli kamera a fejmozgásodra."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Mennyire forduljon el a játékbeli kamera balra és jobbra a fejed elforgatásához képest (a kamionban ülve)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Mennyire nézzen fel és le a játékbeli kamera a fejeddel való fel- és lenézéshez képest (a kamionban ülve)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Mennyire forduljon el a játékbeli kamera balra és jobbra a fejed elforgatásához képest (séta közben)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Mennyire nézzen fel és le a játékbeli kamera a fejeddel való fel- és lenézéshez képest (séta közben)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "A fejmozgás-követés sebességének mértékét állíthatod vele."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Mennyire kell elforgatnod a fejedet, mielőtt a kameramozgás gyorsítása kiegyenlítődik."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Mennyire kell elmozdítanod a fejedet középső állásból ahhoz, hogy a játékbeli kamera lekövesse annak mozgását."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Mennyire kell elmozdítanod a fejedet középső állásból ahhoz, hogy a játékbeli kamera teljesen elforduljon abba az irányba."

