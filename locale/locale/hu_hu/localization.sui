	key[]: "trailerman_copy_configuration_t"
	val[]: "KIÉPÍTÉS MÁSOLÁSA" #+ Message box title. Please keep in upper case where possible.

	key[]: "trailerman_msg_nouse"
	val[]: "Ez a pótkocsi nem használható másolási sablonként, mivel hiányzó adatokat tartalmaz. Ennek oka valószínűleg egy MOD vagy DLC eltávolítása.<br><br>Telepítsd újra a hiányzó modokat vagy DLC-ket!"
#@}

#+ Message box shown when user requests to use total restoration of trailer in trailer manager.
#@{
	key[]: "trailerman_total_restoration_t"
	val[]: "TELJES RESTAURÁLÁS"  #+ Message box title. Please keep in upper case where possible.

	key[]: "trailerman_total_restoration_service"
	val[]: "A jelenleg használt pótkocsi restaurálásához kérjük, hogy látogass meg egy szervizt!" #+ Message shown when player tries to restore trailer that he is using.

	key[]: "trailerman_total_restoration_no_need"
	val[]: "A pótkocsi tökéletes állapotban van." #+ Message shown when player tries to restore trailer in perfect condition.

	key[]: "trailerman_total_restoration"
	val[]: "A teljes restaurálás költsége:<br><br><color value=@@clr_sel@@><font face=/font/big.font>$PRICE$</font><br><br><color value=@@clr_txt@@>Ennek során a járművedet teljesen szétszerelik, és minden elhasználódott elemét restaurálják, hogy tökéletes állapotban kapd vissza! Ez azonban nagyobb kihívás, mint új járművet építeni." #+ Content of the screen, explaining total restoration.
#@}

