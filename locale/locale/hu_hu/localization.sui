	key[]: "steam_result_serviceunavailable"
	val[]: "Nem sikerült csatlakozni a Steamhez! Kérlek, ellenőrizd az internetkapcsolatodat! Ha minden jónak tűnik, próbálkozz újra később!" #+ The message showed when game fails to connect to Steam servers.

	key[]: "steam_result_timeout"
	val[]: "Időtúllépés a Steam és a játék között. Kérlek, próbálkozz újra!" #+ The message showed when connection between game and Steam services times out.
#@}

