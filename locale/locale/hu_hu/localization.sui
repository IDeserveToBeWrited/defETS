#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Folytatás ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Üdvözöl a Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Végre eljött az idő, hogy azt csináld, amit mindig is szerettél volna - kamiont vezethetsz!"

	key[]: "intro_3"
	val[]: "Bár fuvarcéged megnyitotta kapuit, sajnos nincs elég pénzed, hogy saját kamiont vegyél. Egyelőre nagyobb cégeknél kell kilincselned, és alkalmi fuvarokból kell eltartanod magad."

	key[]: "intro_4"
	val[]: "A feladatod, hogy épségben elszállítsd a rakományt ($JOB_CARGO$) a megbízód ($JOB_TARGET_COMPANY$) $JOB_TARGET_CITY$ városában található telephelyére. A feladat elvégzéséhez szükséges járművet a cég biztosítja, és természetesen minden felmerülő költséget megtérít. Ne okozz csalódást, és érkezz meg időben!"


	key[]: "intro_garage_1"
	val[]: "Ez céged székhelye."

	key[]: "intro_garage_2"
	val[]: "Ez egy elég szerény garázs - lehetne jobb is, de kezdetnek megteszi."

	key[]: "intro_garage_3"
	val[]: "Sajnos még nincs kamionod, ami itt leparkolhatna."

	key[]: "intro_garage_4"
	val[]: "Ha elegendő pénzt gyűjtöttél ahhoz, hogy saját kamiont vásárolj, szabadon bejárhatod a játékvilágot, és saját vállalkozásba kezdhetsz."

	key[]: "intro_garage_5"
	val[]: "Sok szerencsét!"


	key[]: "desktop_tut_t"
	val[]: "FUNKCIÓ FELOLDVA"

	key[]: "desktop_tut_job"
	val[]: "Válaszd ki a következő munkát"

	key[]: "desktop_tut_cargo_market"
	val[]: "Használd a vadiúj pótkocsidat a Saját pótos fuvarok eléréséhez, és szállítsd le vele a megrendelő áruját a célállomásra!" #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

