#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SEBESSÉGVÁLTÓ KIVÁLASZTÁSA" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ehhez a funkcióhoz kormányra, gamepadre vagy joystickra van szükség."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nem található H-váltó. Elképzelhető, hogy a funkció nem használható. "

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "H-VÁLTÓ ELRENDEZÉS KIVÁLASZTÁSA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "A tartomány szerinti váltókiosztás a legegyszerűbb választás, ami két sebességkészlettel működik. Az első készlet tartalmazza az 1-6. sebességfokozatokat, a második pedig a 7-12. sebességfokozatokat. A kapcsoló gombbal a két készlet között válthatsz, míg a váltóval az adott készlet sebességfokozatai között."

	key[]: "wiz_hs_splitter"
	val[]: "A megosztott felezőváltó egyszerű alternatív váltó, amely két sebességkészlettel működik. Az első készletbe tartoznak a páratlan számú sebességfokozatok (1, 3, 5...), a második készletbe a párosak (2, 4, 6...). A kapcsoló gombbal a két készlet között válthatsz, míg a váltóval az adott készlet sebességfokozatai között."

	key[]: "wiz_hs_range_splitter"
	val[]: "A tartomány szerinti megosztott váltó az igazi manuális felezőváltókon alapul. Az egyes H-váltó állások négy-négy menetfokozatot foglalnak magukba, maga a váltó pedig két kapcsolót használ. Ezt a beállítást emiatt csak tapasztalt sofőröknek ajánljuk."
#@}

#@}

