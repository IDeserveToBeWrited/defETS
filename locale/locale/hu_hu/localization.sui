	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "A @@ima_wiz_j_throttle@@ forward megnyomásával gyorsítasz, a @@ima_wiz_j_brake@@ megnyomásával fékezel."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Használd a(z) @@imv_wiz_gearup@@-t az előremenetbe, a(z) @@imv_wiz_geardown@@-t pedig a hátramenetbe váltáshoz."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Amennyiben billentyűzettel vagy kontrollerrel játszol, használd a(z) @@imv_wiz_gearup@@ gombot az előremenetbe, a(z) @@imv_wiz_geardown@@ gombot pedig a hátramenetbe váltáshoz. Ha H-váltót használsz, használd a(z) @@imv_wiz_drive@@-t és a(z) @@imv_wiz_reverse@@-t a menetirány beállításához."

	key[]: "wiz_cfg_gb_manual"
	val[]: "A @@imv_wiz_gearup@@ és a @@imv_wiz_geardown@@ segítségével válaszd ki a kívánt sebességfokozatot.."

	key[]: "wiz_cfg_gb_direct"
	val[]: "A H-váltó és a @@ima_wiz_j_clutch@@ egyidejű használatával választhatod meg a kívánt sebességfokozatot."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "KONTROLLER TENGELYEK KIVÁLASZTÁSA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Tengelyek vizualizálása"

	key[]: "wiz_setup_axes_desc"
	val[]: "A kiválasztott tengelyek működését ki is próbálhatod. Mozgasd a vezérlőt és közben figyeld a mozgó sávokat. Ez megmutatja minden használt tengely határait, középpontját, irányát és általános működését."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Tengelybeállítás"

	key[]: "wiz_setup_axes_desc2"
	val[]: "A tengely kiválasztásához kattints rá annak nevére! Ezzel beviteli módba kerülsz. Azt követően használd a beviteli eszközöd karját, kormányát vagy pedálját, hogy a kiválasztott tengelyt a kívánt tengelyhez rendeld!"

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Holtjáték"

	key[]: "wiz_setup_axes_desc3"
	val[]: "A holtjáték a tengely azon sávja, amely szándékosan nem továbbít beviteli jelet. A kijelölt tengely holtjátéksávjának beállításához állítsd be a kapcsolódó csúszkát! A csúszka jobbra húzása növeli a holtjátékot, ami hasznos lehet azon régebbi játékvezérlők esetén, amelyek az alkatrészek elkopása miatt pontatlan vagy hamis beviteli jelet továbbítanak."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Tengely mód"

	key[]: "wiz_setup_axes_desc4"
	val[]: "A tengely módja azt határozza meg, hogy hogyan kezeli azt a játék. A fordított tengely felcseréli a tényleges irányt: például ha jobbra forgatod a kormányt, a játékban az balra fog fordulni. A középre igazított tengely alapértelmezett pozíciója a tartománya közepén helyezkedik el (pl. joystick esetén). Használd ezt a beállítást, ha helytelenül ismerte fel a program a tengelyt!"

	key[]: "normal"
	val[]: "Normál" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Fordított" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Középre igazított" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Fordított és középre igazított" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATA VÁLTÓ BEÁLLÍTÁSA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Az automata váltóval csak az előremenet, az üres fokozat, illetve a hátramenet között kell váltanod. Ezt a következő billentyűkkel és a vezérlőd alábbi gombjaival teheted meg. A beállítást úgy változtathatod meg, ha valamelyik gombra kattintasz, majd megnyomod az adott dologra beállítani kívánt billentyűt, illetve a vezérlő kívánt gombját.   "

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ha csatlakozik a gépedhez H-váltó hardver, szimulálhatod vele az igazi automata váltó működését. Engedélyezd ezt a beállítást és beállíthatod a H-váltó pozícióit előre-, illetve hátramenet esetére. Az ezeken kívüli összes pozíció üresnek minősül. Ez a beállítás kifejezetten a H-váltókra vonatkozik, nem működik sem az általános billentyűkkel, sem a vezérlő gombjaival. Ha szeretnéd megváltoztatni valamelyik beállítást, kattints az adott gombra, majd mozgasd a váltót a kívánt pozícióba és vissza üresbe. "
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SZEKVENCIÁLIS VÁLTÓ BEÁLLÍTÁSA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "A szekvenciális váltóval válthatsz az előremenet sebességfokozatai, az üres fokozat, illetve a hátramenet között. Íme, a billentyűk, illetve a vezérlő felfelé és lefelé váltásra szolgáló gombjai. A beállítást meg is változtathatod, ha valamelyik gombra kattintasz, majd megnyomod az adott dologra beállítani kívánt billentyűt, illetve a vezérlő kívánt gombját.   "
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-VÁLTÓ BEÁLLÍTÁSA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Itt a H-váltó alapvető elrendezését állíthatod be és ki is próbálhatod a működését. A képen a váltó jelenlegi pozícióját láthatod, valamint azt, melyik sebességben van éppen. Mivel a játékbeli váltó több sebességes, mint amennyi pozíció a váltódon van, a kapcsológombok segítségével válthatsz a különböző sebességkészletek között."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "A váltó aktuális pozícióját és az aktív kapcsolókat lent bejelöltük, mellettük láthatod a vezérlő hozzárendelt gombját. A hozzárendelt gomb megváltoztatásához kattints a megfelelő gombra, majd mozgasd a váltót a kívánt pozícióba, végül vissza üresbe."
#@}

