#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "U ovom scenariju susrest ćete se s nizom različitih skretanja koji će vam pomoći da se naviknete na vožnju s prikolicom. Ostanite usredotočeni, prilagodite brzinu svakoj situaciji i u potpunosti iskoristite dostupni prostor."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "The first turn is a dogleg turn - two turns in one. You'll have to set up for a left turn, but transition to a right turn in the middle of the manoeuvre."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "This next turn crosses you over to the other side of the median. It's not particularly difficult but you will need to watch that you leave enough space for your trailer."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Sada ćete morati svladati uski slalom kroz tvrde prepreke. Idite sporo i upotrijebite retrovizore i držite se dovoljno široko da vaša prikolica može proći barijere."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "U ovom trenutku ulazite u još jedan slalom s dodatnim čunjevima na vrhu svakog zavoja <br>Pazite da nijednoga ne udarite!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Slijedi nekoliko laganih zavoja putem do kružnog toka."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Na ravnom dijelu se pripremite za ulazak u kružni tok. Ostanite vani prije nego što uđete u njega."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Uđite u kružni tok i promatrajte položaj vaše prikolice. Pratiti će vas drugačije kada ste unutar kružnog toka u odnosu na način na koji ste ušli."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Izađite iz kružnog toka i vozite do sljedećeg skretanja."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "UKLONITE OVAJ ISJEČAK"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Skretanje je ovdje izuzetno oštro. Polako i pametno iskoristite prostor oko sebe. Imajte na umu i zakretanje stražnjeg dijela prikolice."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Dok vozite kroz sljedećih nekoliko zavoja, ne zaboravite se pripremiti za sljedeće zavoje dok izlazite iz prethodnog."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Nemojte žuriti s posljednjim zavojem. Izgleda lako, ali ima manje prostora za manevriranje nego što se čini."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Zaustavite se na predviđenom području, osigurajte kamion i ugasite motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Ubrzajte prema prvom skretanju. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Prvo skretanje je lagano skretanje.<br><br><font face=/font/big_bold.font>Napravite skretanje. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "UKLONITE OZNAKU"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Ahead the course continues on the left of the median.<br><br><font face=/font/big_bold.font>Make your way through the crossover. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Upravljajte kroz prepreke i ne zaboravite paziti na svoju prikolicu.<br><br><font face=/font/big_bold.font>Vozite kroz slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Ovaj slalom je jednostavniji, ali ga prometni čunjevi čine znatno užim.<br><br><font face=/font/big_bold.font>Vozite kroz slalom i izbjegavajte udarce u bilo koji čunj. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Ispred vas je nekoliko lakih zavoja, i dalje ćete se morati pravilno postaviti kako biste svoju prikolicu držali podalje od unutarnjih prepreka.<br><br><font face=/font/big_bold.font>Učinite skretanja. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Približavate se kružnom toku. Ne zaboravite ostaviti dovoljno mjesta za svoju prikolicu ne samo kada ulazite i izlazite, već i dok se vozite njime.<br><br><font face=/font/big_bold.font>Vozite kroz kružni tok. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Ispred vas je kratka ravna dionica, možete malo ubrzati ako želite.<br><br><font face=/font/big_bold.font>Nastavite voziti. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Skretanje je ovdje izuzetno oštro. Idite polako, iskoristite sav prostor koji vam je na raspolaganju i imajte na umu da se zanošenje stražnjeg dijela prikolice. <br><br><font face=/font/big_bold.font>Vozite kroz oštar zavoj. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "The last few turns are straight forward. Remember to keep your trailer in mind.<br><br><font face=/font/big_bold.font>Continue on. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Nastavite prema posljednjem parkirališnom mjestu. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

