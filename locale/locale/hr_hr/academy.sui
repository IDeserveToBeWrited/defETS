#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkiranje pokraj prepreke"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "U ovom scenariju naučit ćemo parkirati pored rubnika pomoću bočnog retrovizora."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Provjera bočnog ogledala"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Vožnja prema rubniku"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Bočni retrovizor još je jedan alat koji će vam pomoći da sigurno upravljate kamionom. Nalazi se na gornjem okviru suvozačevih vrata."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Vozite naprijed i polako se okrenite prema suvozačevoj strani."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Ove drvene daske predstavljaju ivičnjak. Morat ćete parkirati pokraj njega. <br>Skrenite prema rubniku kako biste doveli kamion u dobar položaj za poravnanje s parkirnim mjestom."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Usporite dosta prije rubnika i skrenite prema parkirnom mjestu. Dok se poravnavate, pomoću bočnog retrovizora možete procijeniti svoju udaljenost od rubnika."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Zaustavite se na parkirnom mjestu i osigurajte kamion."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Pogledajte kroz prozor na suvozačevoj strani. Tamo možete vidjeti bočni retrovizor.</font>@@aca_goal_tip@@ Morate biti u vozilu."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Bočni retrovizor pokriva područje na suvozačevoj strani gdje vozač ne može vidjeti. To je jedan od najproblematičnijih mrtvih kutova na kamionu. Ako vam kut retrovizora ne odgovara, možete ga podesiti u '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Kamion još nije spreman za pokret, možda ste nešto zaboravili?<br><br>Je li motor uključen? Jeste li otpustili parkirnu kočnicu?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Ispred vas je niz dasaka koje predstavljaju ivičnjak. Na kraju rubnika je parkirno mjesto. Morat ćete se odvesti tamo. <br><br><font face=/font/big_bold.font>Nastavite kada budete spremni. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Okrenite se prema rubniku. Upotrijebite prednje i bočne retrovizore da provjerite svoj položaj u odnosu na rubnik, ali također pazite da ne pregazite prometne čunjeve.<br><br><font face=/font/big_bold.font>Vozite prema rubniku i na parkirno mjesto.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Osigurajte kamion i ugasite motor.</font>@@aca_goal_tip@@ Možete upotrijebiti unaprijed postavljene postavke Izgled unutrašnjosti kako biste lakše gledali u retrovizore. Provjerite zaslon s opcijama - 'Tipke i gumbi' - da biste vidjeli i/ili promijenili odgovarajuće kontrole."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parkiranje unazad pored prepreke"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "U ovom scenariju, vozit ćemo kamion unatrag na parkirno mjesto pored rubnika."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Upute"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Vožnja unatrag prema rubniku"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parkiranje kamiona"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "U ovom scenariju, izvršit ćemo vožnju unatrag kako bismo parkirali uz rubnik."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Vozite unatrag prema rubniku.<br>Morate paziti na svoju okolinu kada vozite unatrag, stoga koristite retrovizore."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Kako se približavate, možete početi poravnavati kamion s parkirnim mjestom. Pazite na obje strane kamiona dok vozite unatrag."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Zaustavite se na parkirnom mjestu i osigurajte kamion."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Parkirno mjesto je iza vas na suvozačevoj strani. Upotrijebite retrovizore za navigaciju prema mjestu.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Ne zaboravite upotrijebiti ogledala da provjerite okolinu prije nego što pomaknete kamion.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag prema rubniku. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Nastavite pratiti svoju okolinu dok vozite unatrag na parkirno mjesto.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom mjestu. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Napredni tečaj"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Posljednji scenarij u ovom poglavlju je vožnja na naprednom tečaju. Iskušat ćemo vještine koje ste naučili sa šleperom/tegljačem!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_check1"
