	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Ispred vas je prepreka. Dovezite se do nje i zaustavite se."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Iza kamiona s vozačeve strane nalazi se još jedna prepreka. Okrenite se oko zavoja do nje. Oznake na cesti mogu poslužiti kao vodič."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Točno ispred je oštar zavoj od 90 stupnjeva. Vozite prema njemu."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Morat ćemo voziti duboko u zavoj tako da stražnji kotači prođu kroz prometni stožac na unutarnjem zavoju.<br>Upotrijebite svoje retrovizore!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Poravnajte se, vozite prema posljednjim preprekama, zatim zaustavite i osigurajte kamion."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Kamion još nije spreman za pokret, možda ste nešto zaboravili?<br><br>Je li motor uključen? Jeste li otpustili parkirnu kočnicu?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Ravno ispred vas je označeno mjesto neposredno prije prepreke.<br><br><font face=/font/big_bold.font>Vozite naprijed i zaustavite se na označenom mjestu. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Pogledajte iza sebe na vozačevoj strani; Tamo ćete vidjeti još jedno označeno mjesto. Morat ćete kombinirati vožnju unatrag sa skretanjem u isto vrijeme.<br><br><font face=/font/big_bold.font>Vozite unatrag u zavoj i zaustavite se na označenom mjestu. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Staza se nastavlja ispred vas kroz zavoj od 90 stupnjeva.<br><br>Ostanite uz vozačevu stranu prije skretanja, vozite duboko u zavoj i skrenite brzo i oštro. Pazite da ne udarite u unutarnji prometni stožac.<br><br><font face=/font/big_bold.font>Vozite naprijed i skrenite. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Upotrijebite prednje i bočne retrovizore kako ne biste ništa udarili.<br><br><font face=/font/big_bold.font>Završite skretanje i zaustavite se na označenom području. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Ugasite motor i osigurajte kamion.</font>"
#@}

