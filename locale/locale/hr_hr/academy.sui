#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Kružni tok je malo kompliciraniji za savladavanje s dvostrukom prikolicom nego jednom prikolicom."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Morate se voziti dovoljno daleko da obje prikolice uspješno uđu, ali zatim morate voziti prema van kako biste prikolice držali podalje od središta."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "U redu je ako obje prikolice ne stanu u jednu traku - zapravo, možda je čak i bolje zauzeti obje trake kako vas optimističan vozač ne bi pokušao prestići."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Vozite se do suprotne strane izlazne trake kako biste ponovno bili sigurni da su obje prikolice izvan opasnosti od potencijalnih sudara."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Nastavite do drugog kružnog toka."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Ovaj kružni tok ima samo jednu traku, stoga ne žurite i budite precizni."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Iskoristite sav prostor koji vam je dostupan - kraćenje zavoja ovdje će samo otežati stvari."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Izađite na izlazu i nastavite prema parkiralištu."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Parkirajte i osigurajte kamion."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Nalazite se na tečaju upoznavanja kružnih tokova. Nastavite naprijed kada budete spremni."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Prije nego što krenete prema vanjskim čunjevima, dobro se uključite u kružni tok kako biste osigurali siguran ulazak obje prikolice."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Morat ćete voziti na drugu stranu izlaza kako biste spriječili udaranje prikolica u čunjeve. <br><br>Možda bi bilo korisno skrenuti prema središtu kružnog toka neposredno prije izlaska iz njega."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Trebali biste biti u stanju sami se nositi s ovim, odvojite vrijeme i mudro iskoristite prostor."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Pažljivo izađite iz kružnog toka."

