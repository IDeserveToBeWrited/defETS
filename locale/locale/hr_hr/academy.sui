	key[]: "aca_goal_book1_3_19_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_19_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


 #!}


#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Dobrodošli na prvi dio završnog ispita. Ovdje ćemo vidjeti koliko ste dobro naučili voziti kamion nakon završetka Akademije."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Prvo ćete pričvrstiti prikolicu. Nakon spajanja, vozit ćete kamion po cijelom ispitnom području."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "The first section of the track leads from the small parking lot to the eastern test course."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "The circuit includes challenging passages between barriers."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "A significant part of the route goes through the eastern test course."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "We'll test your ability to manoeuvre the truck through different situations."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Upravljat ćete kamionom kroz nekoliko oštrih zavoja."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "You'll drive through the road section connecting the courses."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "The final part involves driving through the small circuit."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "The circuit has many intricate passages and sharp turns."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Da biste dovršili test, morat ćete precizno parkirati."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nemate potrebe biti nervozni, već ste naučili sve što je potrebno za prolaz.<br><br>Sretno!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Ispred vas je prikolica.<br><br><font face=/font/big_bold.font>Vozite prema prikolici. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Poravnajte šleper/tegljač s prikolicom.<br><br><font face=/font/big_bold.font>Krenite unatrag i povežite se s vučnim klinom. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Osigurajte kamion. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Pritisnite @@imv_nrm_attach@@<font face=/font/big_bold.font> za povezivanje prikolice. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Prikolica je spojena i kamion je spreman za vožnju.<br><br><font face=/font/big_bold.font>Oslobodite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Počnite voziti prema izlazu s parkirališta. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Pratite cestovne oznake i pazite na prepreke.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Dolazi još zahtjevniji dio.<br><br><font face=/font/big_bold.font>Pažljivo se krećite između prepreka. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "This part will test your skills at manoeuvring a trailer around different kinds of corners.<br><br><font face=/font/big_bold.font>Turn onto the course. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Vozite kroz prolaz. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Vozite ravno. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Pažljivo vozite kroz skretanje. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Ulazite u kompleksniji dio. Vozite pažljivo.<br><br><font face=/font/big_bold.font>Nastavite vožnju nizbrdo. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Oštro skrenite ulijevo. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Izađite iz staze. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Ulazite u lakši dio.<br><br><font face=/font/big_bold.font>Nastavite vožnju nizbrdo. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Nastavite voziti cestom. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Ispred je skretanje na sljedeću stazu.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Skrenite udesno. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju stazom. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Slijedi više oštrih zavoja.<br><br><font face=/font/big_bold.font>Prilagodite brzinu sukladno tome. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Skrenite ulijevo. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Uđite u skretanje, nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Da biste skrenuli, možda ćete morati malo skrenuti s asfalta.<br><br><font face=/font/big_bold.font>Skrećite oprezno, koristite onoliko prostora koliko vam je potrebno. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Izađite sa staze i odvezite se do parkirnog mjesta. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Završni ispit (2. dio)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Čeka vas posljednji dio završnog ispita na kojem će se ocjenjivati vještine parkiranja koje ste naučili u prethodnim scenarijima. Pažljivo i precizno parkirajte i bit ćete spremni krenuti europskim cestama kao vješti vozač kamiona!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Offset Manoeuvre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Dijagonalno parkiranje"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Vožnja parkiralištem"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Bočno parkiranje"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Završno parkiranje"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Dobrodošli na drugi dio završnog ispita. Premjestit ćemo se na obližnje parkiralište i testirati vaše vještine vožnje unatrag i manevriranja na parkirna mjesta."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Nekoliko uzastopnih izazova parkiranja čeka na vas da procijenite svoje sposobnosti."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Ovdje je prostor ograničen, stoga budite oprezni i uzmite si vremena."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Ne zaboravite biti oprezni i ne žuriti. U redu je ako ne uspijete ući iz prvog pokušaja, važno je da ne oštetite kamion ili one oko sebe. <font face=/font/big_bold.font><br><br>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Vozite naprijed na prvi dio ispita.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Your first task is to demonstrate the offset parking manoeuvre. The spot where you need to back up with the trailer is on your left.<br><br><font face=/font/big_bold.font>Perform an offset parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "The next task is to back into a row of stationary trucks. Be careful not to hit the other trucks!<br><br><font face=/font/big_bold.font>Perform a diagonal parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Continue through the parking lot. Watch out for unexpected situations.<br><br><font face=/font/big_bold.font>Continue driving.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Now let's try parallel parking between the two trucks by the kerb ahead of you.<br><br><font face=/font/big_bold.font>Perform a parallel parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Još jedan manevar parkiranja s vaše lijeve strane! Možete odlučiti pristupiti ovome kako god želite.<br><br><font face=/font/big_bold.font>Vozite unatrag do naznačenog područja.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Skoro gotovo. Napustite područje testiranja i parkirajte kamion.<br><br><font face=/font/big_bold.font>Izađite s područja testiranja ulijevo.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Možete parkirati kamion s desne strane s ostalima.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Bočno parkiranje s prikolicom"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "U ovom scenariju, razmotrit ćemo paralelno parkiranje sa spojenom prikolicom."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Zaustavljanje u označenom području"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Bočno parkiranje s prikolicom važna je vještina za sve vozače kamiona.<br>Bilo da parkirate na ulici u velikom gradu ili se zaustavljate na odmorištu u prirodi, to je nešto što bi trebao znati uraditi svaki vozač kamiona."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Dok prolazite pokraj parkirnog mjesta, pažljivo gledajte ima li dovoljno mjesta za šleper/tegljač i prikolicu. Ovdje smo se pobrinuli da imate dovoljno mjesta."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Poravnajte se s kamionom ispred parkirnog mjesta. Nemojte mu biti preblizu, držite se na određenoj udaljenosti od njega kako biste imali prostora za rad."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Naglo skrenite s parkirnog mjesta i počnite voziti unatrag. Ideja je da se prikolica odmah okrene prema parkirnom mjestu."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Nakon što je prikolica dobro usmjerena u točku, možete je početi pratiti."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Počnite okretati prikolicu dalje od rubnika prije nego što kotači tegljača/šlepera s vozačeve strane uđu u to mjesto."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Poravnajte tegljač/šleper s prikolicom i zatim se centrirajte unutar parkirnog mjesta.<br> Parkirajte, ugasite motor i osigurajte kamion."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Možete vidjeti parkirno mjesto ispred sebe, između ostalih kamiona. Dok parkirate, provjerite retrovizore i održavajte siguran razmak između kamiona i prepreka oko vas.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Krećite se kroz parkiralište kako biste pronašli svoje parkirno mjesto.<br><br><font face=/font/big_bold.font>Vozite naprijed. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Prođite pokraj željenog parkirnog mjesta do označenog područja. Odavde možete započeti svoju vožnju unatrag.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom mjestu. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Okrenite tegljač/šleper od mjesta kako biste počeli okretati prikolicu u njega. Nemojte skrenuti prenaglo ili ćete krenuti prema rubniku. <br><br><font face=/font/big_bold.font>Započnite vožnju unazad. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Poravnajte prikolicu s točkom. Ako je potrebno, pomičite se unaprijed ili unatrag dok okrećete volan kako biste prilagodili položaj.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Čestitamo, uspješno ste položili ispite za Osnove vožnje kamiona i naučili sve vještine potrebne za pravilno upravljanje kamionom."

	key[]: "aca_msg_book1_outro02"
	val[]: "Ovo je prvi korak na vašem putu prema ostvarenju vašeg sna da postanete profesionalni vozač kamiona."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Sada ste spremni zaputiti se cestama Europe i suočiti se s prvim izazovima..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...ali avantura je tek počela."
#@}


