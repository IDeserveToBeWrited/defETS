#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Vožnja kroz složene zavoje"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "U ovom scenariju, istražit ćemo upravljanje prikolicom kroz kratku stazu s preprekama sa složenijim zavojima."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Prva skretanja"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Vožnja uskim prolazom"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Usko skretanje od 90 stupnjeva"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Vožnja oko prepreka"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Pred vama su razni složeni zavoji i prepreke.<br>Uzmite u obzir sve što ste do sada naučili i ne bi trebalo biti previše teško."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Oznake na cesti mogu vam pomoći da dobijete ideju o tome kako nastaviti kroz svaki skup prepreka."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Keep the tractor to the outside of the corner. <br>You'll need to swing wide as the trailer follows a shorter path."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Sljedeći zavoj je lagano skretanje od 90 stupnjeva. <br> Još jednom, držite kamion s vanjske strane skretanja i iskoristite sav prostor koji vam je na raspolaganju."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Take your time here. The course opens up, but you will still need to be precise."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Keep a wide berth around the barriers."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Budite oprezni dok ulazite u ovaj uski dio. <br>Dobro zakrenite šleper/tegljač prije nego uđete kako biste pripremili prikolicu za ulazak."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Posljednje skretanje od 90 stupnjeva mnogo je oštrije od prvog, ali ima dovoljno prostora ako mudro koristite prostor."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Parkirajte na predviđenom području, zatim osigurajte kamion i ugasite motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Ne zaboravite koristiti oznake na cesti kako biste lakše upravljali stazom.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Korištenje retrovizora također će vam pomoći da se sigurno krećete stazom. Uvijek morate biti svjesni kako se prikolica kreće iza vas.<br><br><font face=/font/big_bold.font>Prođite kroz prvi zavoj. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Promatrajte prikolicu dok izlazite iz zavoja i pripremite se za ulazak u sljedeći.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Prođite kroz sljedeći zavoj. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Ne zaboravite promatrati svoju prikolicu kako biste bili sigurni da nemate prepreka oko sebe prije nego što okrenete kamion.<br><br><font face=/font/big_bold.font>Nastavite obilaziti prepreku ispred sebe. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Kada se vaša prikolica udalji od prepreke, snažno se okrenite na suvozačevu stranu kako biste se poravnali za uski prolaz. <br><br><font face=/font/big_bold.font>Nastavite prema uskom prolazu.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Ova će dionica zahtijevati vrlo preciznu vožnju. Uzmite si vremena i upotrijebite svoje retrovizore.<br><br><font face=/font/big_bold.font>Ostanite na vanjskoj strani svakog ugla. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ovaj zavoj je vrlo oštar, ali možete iskoristiti cijeli prostor ispred sebe da ga lako savladate.<br><br><font face=/font/big_bold.font>Napravite posljednji zavoj. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Napredni tečaj - prikolica"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "U završnom scenariju u 3. poglavlju, odvest ćemo se na dužu obuku s nizom različitih zavoja da vidimo koliko ste dobro naučili upravljati s prikolicom."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Dogleg Turn"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "UKLONITE OVAJ CILJ"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Median Crossover"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Prvi slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Drugi slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Lagana skretanja"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Kružni tok"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Ravni dio"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Usko skretanje"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Završna skretanja"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Vožnja do parkirnog mjesta"
