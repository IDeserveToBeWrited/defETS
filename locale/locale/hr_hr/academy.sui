#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kontrole kamere"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "U ovom scenariju naučit ćemo o raznim vrstama dostupnih kamera i kako vam one mogu pomoći u kontroli i upravljanju kamionom."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Položaj sjedenja"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Pogled straga"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Provjera ogledala"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Prebacivanje na vanjsku kameru"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Pogledajte oko kamiona"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "U ovom scenariju, proći ćemo kroz različite kamere<br>koje su dostupne za korištenje."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Postoji ukupno sedam kamera koje možete izabrati, sada ćemo proći<br> kroz neke od njih i objasniti njihove namjene."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Razne kamere i njihovi različiti kutovi mogu vam pomoći pri upravljanju na skučenim mjestima."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Gledajući kamo idete temelj je sigurne i profesionalne vožnje. Ako vam trenutni položaj sjedenja ne odgovara, možete ga promijeniti u '@@adjust_link_t@@' (pristupite mu putem izbornika pauze).<br><br><font face=/font/big_bold.font>Potvrdite kada ste spremni s @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Kad vozite unatrag, retrovizori ne pružaju uvijek jasan pogled. Možda ćete morati pogledati kroz prozor iza sebe kako biste imali bolji pogled.<br><br><font face=/font/big_bold.font>Okrenite kameru do kraja na vozačevu stranu kako biste gledali kroz prozor prema stražnji dio prikolice.</font>@@aca_goal_tip@@ Morate biti u vozilu."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Koristite ovaj prikaz za provjeru prikolice tijekom upravljanja pri vožnji unatrag s prikolicom. Uvijek je bolje voziti unatrag okrenuti prema vozačevoj strani kako biste mogli iskoristiti ovaj pogled. Kada vozite unatrag okrenuti prema suvozačevoj strani, imate mnogo ograničeniji pogled na ono što se događa iza vas.<br><br><font face=/font/big_bold.font>Gledajte prema suvozačevoj strani. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Zbog toga se obično ne preporučuje vožnja unatrag prema suvozačevoj strani; možete vidjeti da je vidljivost prilično ograničena. Srećom, na raspolaganju vam je i sedam vanjskih kamera. <br><br>Tipka @@imv_nrm_camcycle@@ može se koristiti za prebacivanje na sljedeću kameru u nizu. Nakon što prođete kroz svih sedam kamera, vratit ćete se na početak ciklusa. <br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_camcycle@@ za prebacivanje na sljedeću kameru. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Vanjska kamera pruža najbolju perspektivu onoga što se događa oko kamiona.<br><br><font face=/font/big_bold.font>Pogledajte oko kamiona.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Ponovnim pritiskom @@imv_nrm_camcycle@@ možete prijeći na sljedeću kameru. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Pogled odozgo prema dolje pruža izvrstan pregled situacije oko kamiona, značajno pojednostavljujući parkiranje i vožnju u uskim mjestima.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_camcycle@@ za prebacivanje na sljedeću kameru.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Krovna kamera pruža jasan pogled na cestu daleko ispred kamiona bez mnogo prepreka.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_camcycle@@ za prebacivanje na posljednju kameru koju ćemo pogledati za sada. </font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Stražnji pogled je prečac do pogleda koji ste ranije dobili okretanjem unutarnje kamere. Kao što smo spomenuli, pomaže pri vožnji unatrag ili parkiranju.<br><br>U igri imamo više kamera koje možete isprobati uzastopnim pritiskanjem @@imv_nrm_camcycle@@.<br><br><font face=/font /big_bold.font>Pritisnite @@imv_nrm_cam1@@ za povratak u unutrašnjost.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Za autentično iskustvo autoškole, preporučujemo da ostanete na prikazu 'Unutarnja kamera' dok prolazite kroz svaki od scenarija.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ za potvrdu i završetak scenarija.</font>@@aca_goal_tip@@ Možete koristiti značajku @@o_im_cam_zoom@@ za bolji pregled okoline. Posebno je korisno gledanje kroz retrovizore. Provjerite zaslon s opcijama - 'Tipke i gumbi' - da biste vidjeli i/ili promijenili odgovarajuće kontrole."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Prva vožnja"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "U ovom scenariju naučit ćemo kako pripremiti kamion za vožnju, a zatim ga voziti naprijed po prvi put."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Uključivanje paljenja"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Pokretanje motora"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Provjera okoline"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Primjena kočnice"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Prebacivanje u brzinu"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Vožnja naprijed"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Zaustavljanje"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Primjena parkirne kočnice"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Prebacivanje u neutralni položaj"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Gašenje motora"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Za prvih nekoliko vožnji koristit ćemo samo šleper/tegljač.<br>Kamion se naziva šleper/tegljač kada nema vlastiti teretni sanduk, već se oslanja na upotrebu prikolice za prijevoz robe i materijala."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Šleperi/tegljači su uobičajeni jer omogućuju veću svestranost: mogu ispustiti praznu prikolicu i preuzeti natovarenu bez čekanja ili se mogu potpuno prebaciti na drugu vrstu prikolice."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Za vašu prvu vožnju, vaš će zadatak biti voziti naprijed i zaustaviti se nakon isprekidane crte.<br>Pokrenite motor, slijedite upute da pripremite kamion za kretanje. Kad ste spremni, vozite ravno naprijed."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Vozite pored isprekidane linije, zaustavite se, ugasite motor i osigurajte kamion."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Za sljedeći korak u vašoj obuci, prvi put ćete pomaknuti kamion.<br><br>Naravno, bez upaljenog motora neće raditi, pa ćete prvo morati uključiti paljenje. <br><br><font face=/font/big_bold.font>Pritisnite $input engineelect$ da uključite paljenje.</font>@@aca_goal_tip@@ U karijeri, prema zadanim postavkama, motor se uključuje zajedno s električnom energijom automatski. Za karijeru, možete prilagoditi ovo ponašanje na zaslonu s opcijama - 'Igranje' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Paljenje aktivira elektroniku kamiona. Možda ste primijetili da lampice upozorenja trepere na kontrolnoj ploči - to je normalno. Ako ostanu uključeni nakon pokretanja motora, to vjerojatno signalizira problem s kamionom. Izuzetak je lampica parkirne kočnice, koja će se ugasiti kada otpustimo parkirne kočnice.<br><br>Srećom, ovaj kamion je u dobrom stanju i spremni smo za nastavak.<br><br><font face= /font/big_bold.font>Pritisnite @@imv_nrm_engine@@ za pokretanje motora. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Sada kada je motor pokrenut, ključno je provjeriti svoju okolinu prije bilo kakvog kretanja.<br><br><font face=/font/big_bold.font>Pogledajte oko kamiona i retrovizore na vozačevoj i suvozačevoj strani kako biste utvrdili da je područje oko kamiona slobodno.</font>@@aca_goal_tip@@ Morate biti unutar vozila."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Možda se čini očiglednim, ali trebali biste znati kako stati prije pokretanja.<br><br><font face=/font/big_bold.font>Aktivirajte kočnicu koristeći $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Zatim ćete naučiti kako promijeniti smjer kretanja.<br><br>S pojednostavljenim automatskim mjenjačem, nema potrebe za mijenjanjem brzina, sve se radi automatski za vas.<font face=/font/big_bold.font <br><br>Koristite $input forward$ za aktiviranje vožnje prema naprijed. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Zatim ćete naučiti kako promijeniti smjer kretanja.<br><br>Realistični automatski mjenjač omogućuje vam prebacivanje između vožnje, neutralnog položaja i vožnje unatrag baš kao i pravi automatski mjenjači.<br><br><font face= /font/big_bold.font>Pritisnite @@imv_nrm_gearup@@ za aktiviranje vožnje prema naprijed. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Zatim ćete naučiti kako promijeniti smjer vožnje.<br><br>Sekvencijalni mjenjač omogućuje postupno mijenjanje stupnjeva prijenosa, baš kao pravi sekvencijalni mjenjač.<br><br>Na isti način kao što uključujete brzinu prema naprijed, dok ubrzavate morat ćete prebaciti u više stupnjeve prijenosa.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_gearup@@ za uključivanje prve brzine.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Zatim ćete naučiti kako promijeniti smjer kretanja.<br><br>S ručicom mjenjača i kvačilom doživjet ćete isti osjećaj fizičkog mijenjanja brzina kao i s pravim ručnim mjenjačem.<br><br >Do kraja pritisnite kvačilo i kočnicu. <font face=/font/big_bold.font>Upotrijebite polugu mjenjača za uključivanje prve brzine. <color value=@@clr_txt@@>Držite kvačilo i kočnicu do kraja.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Da biste se počeli kretati, prvo morate otpustiti parkirnu kočnicu.<br><br><font face=/font/big_bold.font>Upotrijebite @@imv_nrm_parkingbrake@@ za otpuštanje parkirne kočnice.</font> @@aca_goal_tip@@ U karijeri, parkirna kočnica je u početku onemogućena. Ovo postavku možete prilagoditi na zaslonu s opcijama - 'Igranje' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Sada je kamion spreman za kretanje naprijed. Počnite se kretati i prijeđite isprekidanu liniju.<br><br><font face=/font/big_bold.font>Pokrenite kretanje pomoću akceleratora: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Sada je kamion spreman za kretanje naprijed. Počnite se kretati i prijeđite isprekidnu liniju.<br><br><font face=/font/big_bold.font>Pokrenite kretanje pomoću akceleratora: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Sada je kamion spreman za kretanje naprijed. Počnite se kretati i prijeđite isprekidnu liniju.<br><br><font face=/font/big_bold.font>Pokrenite kretanje pomoću akceleratora: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Sada je kamion spreman za kretanje naprijed. Počnite se kretati i prijeđite isprekidanu liniju.<br><br><font face=/font/big_bold.font>Oslobodite radnu kočnicu, postupno otpuštajte kvačilo da je uključite dok istovremeno koristite papučicu gasa kako biste održali broj okretaja u minuti tako da kamion ne zastaje. Nakon što je kvačilo potpuno otpušteno, možete ubrzati i prebaciti po potrebi. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Za zaustavljanje koristite radnu kočnicu.<br><br><font face=/font/big_bold.font>Koristite $input backward$ za zaustavljanje kamiona. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Za zaustavljanje koristite radnu kočnicu.<br><br><font face=/font/big_bold.font>Koristite $input backward$ za zaustavljanje kamiona. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Za zaustavljanje koristite radnu kočnicu.<br><br><font face=/font/big_bold.font>Koristite $input backward$ za zaustavljanje kamiona. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Kada dođe vrijeme za zaustavljanje, pritisnite kvačilo do kraja <font face=/font/big_bold.font>i zatim zaustavite kamion pomoću radne kočnice.<color value=@@clr_txt@@> Prebacite u neutralni položaj pomoću ručice mjenjača i tada možete otpustiti kvačilo. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Sada osigurajte kamion. Parkirna kočnica osigurava da se kamion neće nenamjerno pomaknuti nakon što ste parkirali.<br><br><font face=/font/big_bold.font>Koristite @@imv_nrm_parkingbrake@@ za aktiviranje parkirne kočnice.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Uz pojednostavljeni automatski mjenjač, nema potrebe za mijenjanjem brzina, sve se radi automatski za vas.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ za potvrdu. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Shift into neutral by pressing @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Shift into neutral by pressing @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Prebacite ručicu mjenjača u neutralni položaj, zatim otpustite kvačilo. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Sada znate kako pokrenuti kamion i kako ga sigurno zaustaviti.<br><br><font face=/font/big_bold.font>Pritisnite $input engineelect$ za isključivanje motora. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Vožnja unatrag"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "U ovom scenariju, prvi put ćemo probati vožnju unatrag. Također ćemo razgovarati o tome kako koristiti ogledala da vidite iza sebe, na što paziti i kako se pripremiti za kretanje unazad."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Pokretanje motora"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Provjera suvozačevog retrovizora"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Provjera vozačkog retrovizora"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Prebacivanje u brzinu"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Prebacivanje u neutralni položaj"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Gašenje motora"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Za ovu vožnju, vozit ćemo unatrag u ravnoj liniji. Morat ćete voziti unazad iza isprekidane crte i tamo se zaustaviti."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Kada vozite kamion unatrag, bitno je stalno gledati oko sebe, promatrati sva ogledala i osigurati da je prostor oko i iza vas slobodan."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Pokrenite motor, prebacite u rikverc i krenite."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Vozite unatrag iza isprekidane linije, zaustavite se, ugasite motor i osigurajte kamion."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Pripremite kamion za vožnju kao što ste naučili u prethodnom scenariju.<br><br><font face=/font/big_bold.font>Kada budete spremni, uključite motor. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Provjerite svoja ogledala kako biste bili sigurni da je područje oko vas čisto. Ako niste zadovoljni njihovim položajem, možete ih prilagoditi u '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Pogledajte retrovizor na suvozačevoj strani.</font>@@aca_goal_tip @@ Morate biti u vozilu."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Kretat ćete se pokraj isprekidane linije. Traka je sada slobodna, ali tijekom redovne vožnje važno je neprestano nadzirati okolinu gledajući okolo i koristeći se retrovizorima.<br><br><font face=/font/big_bold.font>Provjerite retrovizor na vozačevoj strani.< /font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Koristite $input backward$ za prebacivanje u vožnju unazad. </font>@@aca_goal_tip@@ Prilikom vožnje unatrag, pomoćni alarm automatski se aktivira na većini kamiona. Možete ga isključiti na zaslonu s opcijama - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_geardown@@ za prebacivanje u vožnju unatrag. </font>@@aca_goal_tip@@ Prilikom vožnje unatrag, pomoćni alarm automatski se aktivira na većini kamiona. Možete ga isključiti na zaslonu s opcijama - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_geardown@@ za prebacivanje u vožnju unatrag. </font>@@aca_goal_tip@@ Prilikom vožnje unatrag, pomoćni alarm automatski se aktivira na većini kamiona. Možete ga isključiti na zaslonu s opcijama - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Pritisnite kvačilo do kraja i pomaknite ručicu mjenjača u vožnju unatrag. </font>@@aca_goal_tip@@ Prilikom vožnje unatrag, pomoćni alarm automatski se aktivira na većini kamiona. Možete ga isključiti na zaslonu s opcijama - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Sada imate uključen stupanj prijenosa za vožnju unatrag.<br><br><font face=/font/big_bold.font>Otpustite parkirnu kočnicu pomoću @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Počnite se kretati koristeći $input backward$.<br><br><font face=/font/big_bold.font>Vozite unatrag iza isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Počnite se kretati pomoću akceleratora: $input forward$.<br><br><font face=/font/big_bold.font>Vozite unatrag iza isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Počnite se kretati pomoću akceleratora: $input forward$.<br><br><font face=/font/big_bold.font>Vozite unatrag iza isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Polako otpuštajte kvačilo, održavajući broj okretaja motora pomoću gasa. <br><br><font face=/font/big_bold.font>Vozite unatrag iza isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Zaustavite kamion pomoću kočnice: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Zaustavite kamion pomoću kočnice: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Zaustavite kamion pomoću kočnice: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Pritisnite kvačilo do kraja, a zatim zaustavite kamion pomoću kočnica. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Aktivirajte parkirnu kočnicu koristeći @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "S pojednostavljenim automatskim mjenjačem, nema potrebe za mijenjanjem brzina jer se sve radi automatski za vas, za razliku od stvarnosti.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ za potvrdu. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Prebacite u neutralni položaj pritiskom na @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderni kamioni će automatski prebaciti u neutralni položaj kada se pritisne parkirna kočnica. Međutim, dobra je navika da to uvijek učinite sami. U sljedećim scenarijima nećemo zahtijevati ovaj korak."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Prebacite u neutralni položaj pritiskom na @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderni kamioni će automatski prebaciti u neutralni položaj kada se pritisne parkirna kočnica. Međutim, dobra je navika da to uvijek učinite sami. U sljedećim scenarijima nećemo zahtijevati ovaj korak."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Prebacite ručicu mjenjača u neutralni položaj, a zatim otpustite kvačilo.</font>@@aca_goal_tip@@ Moderni kamioni automatski će prebaciti u neutralni položaj kada se pritisne parkirna kočnica. Međutim, dobra je navika da to uvijek učinite sami. U sljedećim scenarijima nećemo zahtijevati ovaj korak."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Uvijek budite svjesni svoje okoline dok vozite unatrag, posebno u područjima s puno prometa.<br><br><font face=/font/big_bold.font>Ugasite motor pritiskom na $input engineelect$. </font>"
#@}

