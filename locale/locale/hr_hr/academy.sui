#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Ovaj tečaj obuke dat će vam mali uvid u stvarnu vožnju u sigurnosti naših poligona za obuku. Isprobajte neke od svojih novih vještina i ne zaboravite biti svjesni svoje okoline i iskoristiti sav prostor koji vam je dostupan. <br><br>Također se isplati razmišljati unaprijed!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Proceed forward and find your way into the course."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Pred vama je nizbrdica, iskoristite je kako biste dobili osjećaj za ponašanje skupa vozila s dvije prikolice pri većim brzinama."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Pripremite se za kočenje zbog zavoja koji slijedi."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Pređite preko središnjeg pojasa skretanjem udesno, a zatim odmah ulijevo."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Još jednom prijeđite kroz središnji pojas."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Bit će trenutaka kada nećete imati drugog izbora nego ući u \"škare\" cijelom kompozicijom. <br><br>\nUčinite što morate kako biste prošli kroz ovaj iznimno oštri zavoj."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Nastavite vožnju stazom."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Pažljivo prođite kroz slalom, pazeći ne samo da vaše prikolice zaobiđu svaku prepreku, nego i da se pravovremeno postavite za sljedeću."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Držite se lijeve strane i prođite ravno kroz raskrižja."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Pratite asfalt s desne strane."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Posljednji zavoj zavarava; ima puno prostora, ali budite spremni parkirati tik uz najudaljeniji rubnik."

