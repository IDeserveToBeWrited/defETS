#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Kombinirani manevri"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "In this scenario, we'll combine your newly learned skills to negotiate a short but technical course that will involve reversing into a turn and managing a tight 90 degree corner."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Vožnja unatrag na vozačevu stranu"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Okret od 90 stupnjeva"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Dovršavanje zaokreta"
