	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkiranje na uskom mjestu"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "U ovom scenariju, parkirat ćemo na uskom prostoru.<br><br>Morat ćete upravljati prikolicom da se poravna s pomaknutim parkirnim mjestom."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Upravljanje na mjestu"
