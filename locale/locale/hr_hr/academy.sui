	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Putna točka dosegnuta"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Nastavite sa scenarijem."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Parkirno mjesto"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Za kraj scenarija osigurajte kamion i ugasite motor.</font>"

