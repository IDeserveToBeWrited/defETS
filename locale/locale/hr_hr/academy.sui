#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Vožnja unatrag s prikolicom"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "U ovom ćete se scenariju po prvi put okušati u vožnji unatrag s prikolicom. To je prilično jednostavan manevar, ali ipak ćete morati pravilno upravljati kako biste postavili prikolicu u ispravan položaj."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Vožnja unatrag do prikolice"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Spajanje prikolice"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Vožnja unatrag s prikolicom"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Nastavak prema parkirnom mjestu"
