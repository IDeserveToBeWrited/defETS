#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Prije vožnje"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Za vaš prvi scenarij, proći ćemo kroz osnove vozačke kabine. Važno je pravilno namjestiti sjedalo, upravljač i bočna zrcala, jer je dobra vidljivost važna za upravljanje stresnim ili nesigurnim situacijama.<br><br>Proći ćemo kroz kontrole za podešavanje ovih komponenti jednu po jednu."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Podešavanje sjedala i retrovizora"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Provjera retrovizora i vidljivosti"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Dobro došli na svoju prvu lekciju!<br>Počnimo s učenjem kako pripremiti kamion za cestu."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Najvažnije je osigurati da vaša vožnja bude sigurna, profesionalna i pod kontrolom u svakom trenutku.<br>Pravilno podešavanje sjedala, upravljača i retrovizora pomoći će vam da to postignete."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Sa svake strane kamiona nalaze se neka vozila.<br>Ona će vam pomoći da pravilno namjestite retrovizore."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Uzmite si vremena da sve prilagodite svojim željama jer će te postavke<br>imati značajan utjecaj na vašu sposobnost upravljanja kamionom."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Podešavanje sjedala i volana"

	key[]: "adj_tut_title_1"
	val[]: "Podešavanje glavnih retrovizora"

	key[]: "adj_tut_title_2"
	val[]: "Podešavanje konveksnih retrovizora"

	key[]: "adj_tut_title_3"
	val[]: "Provjera vidljivosti i završno podešavanje retrovizora"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "pritisnite @@imv_nrm_adjuster@@ ili pristupite putem podešavanja vozila u izborniku pauze"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "pristupite putem podešavanja vozila u izborniku pauze"

	key[]: "adj_tut_open_adj"
	val[]: "Za prikaz '@@adjust_link_t@@' tijekom igranja, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Prvo, prilagodimo vozačevo sjedalo i upravljač.<br><br><font face=/font/big_bold.font>Otvorite '@@adj_seats@@' za nastavak.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Otvorite @@adj_mirrors@@ da biste podesili postavke retrovizora.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Kada prvi put ulazite u kamion, važno je najprije namjestiti sjedalo, upravljač i retrovizore prema vašim željama.<br><br>Ispravan položaj za upravljačem ključan je za dobru vidljivost. Sve kontrole moraju biti nadohvat ruke, a vozač mora imati jasan pogled naprijed, sa strane i u ogledala.<br><br><font face=/font/big_bold.font>Za prikaz konfiguracijskog izbornika, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Namjestite sjedalo tako da imate jasan pogled na okolinu, kao i na retrovizore, te da možete dosegnuti sve kontrole.<br><br>Namjestite upravljač tako da bude u udobnom položaju i ne zaklanja vam pogled na instrumente.<br><br><font face=/font/big_bold.font>Kada ste zadovoljni svojim prilagodbama, pritisnite @@imv_nrm_back@@ za povratak na konfiguracijski izbornik. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Kamioni imaju mnogo velikih mrtvih kutova, pa su opremljeni s više vanjskih retrovizora kako bi vozač vidio što je više moguće. <br><br>Pravilno podešavanje ovih retovizora omogućit će vam najbolju moguću vidljivost vaše okoline.<br><br><font face=/font/big_bold.font>Otvorite '@@adj_mirrors@@' za nastavak.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Glavni retrovizori pokrivaju prostor duž bočne strane kamiona i prikolice.<br><br>Za podešavanje ispravnog položaja glavnih retrovizora, koristite automobile s obje strane vozila kao referencu.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_selectfcs@@ za nastavak.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Glavni retrovizori su vaš primarni alat za gledanje što se događa pokraj i iza vas. Trebali biste imati dobar pogled na automobil pokraj sebe, ali svakako držite i dio prikolice u ogledalu kako biste lakše procijenili položaj prepreka oko sebe."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Nakon što ste zadovoljni podešavanjem, prijeđite na glavni retrovizor na suvozačevoj strani."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Ponavljamo, trebali bi imati dobar pregled automobila pored sebe, dok dio prikolice također mora biti vidljiv u zrcalu."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Nakon što ste zadovoljni podešavanjem retrovizora, prijeđite na konveksni retrovizor na strani vozača."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Konveksni retrovizori pružaju šire vidno polje, omogućujući vam da vidite više onoga što se događa pokraj vas.<br><br><font face=/font/big_bold.font>Pritisnite @@ imv_nrm_selectfcs@@ za nastavak. </font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "U idealnom slučaju, trebali biste vidjeti i automobil i kamion parkirane sa strane, dok je vrlo mali dio vašeg vlastitog kamiona još uvijek vidljiv."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Nakon što ste zadovoljni podešavanjem retrovizora, prijeđite na konveksni retrovizor na suvozačevoj strani."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Ponavljamo, trebali biste vidjeti i automobil i kamion parkirane sa strane, dok još uvijek imate vidljiv mali dio vlastitog kamiona."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Nakon što ste zadovoljni podešavanjem retrovizora, pritisnite @@imv_nrm_back@@ za zatvaranje postavki retrovizora."

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_back@@ za povratak na konfiguracijski izbornik. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Izvrsno, s vašim sjedalom i retrovizorima postavljenim po vašim željama, sada ste korak bliže odlasku na cestu!<br><br><font face=/font/big_bold.font>Zatvorite konfiguracijski izbornik koristeći @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Osvrnite se još jednom oko sebe kako biste bili sigurni da ste zadovoljni pogledom iz kabine i da vam retrovizori pružaju dobar pogled na ono što se događa oko kamiona.<br><br>Ako vam nešto ne odgovara, možete ponovno podesiti retrovizore u konfiguracijskom izborniku '@@adjust_link_t@@'. <br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ za završetak prvog scenarija.</font> @@aca_goal_tip@@ Da biste prikazali ili sakrili retrovizore na zaslonu, možete ići na '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' u izborniku pauze. Retrovizori na ekranu olakšavaju pregled suvozačeve strane."
#@}

