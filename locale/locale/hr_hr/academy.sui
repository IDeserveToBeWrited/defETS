#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Dijagonalno parkiranje"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "U ovom scenariju, parkirat ćete na dijagonalno parkirno mjesto na prometnom parkiralištu. <br><br>Nema puno prostora za manevriranje, pa ćete morati biti vrlo točni i promišljeni u vožnji."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Približavanje parkirnom mjestu"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Ovakva dijagonalna parkirna mjesta vrlo su česta. Posebno su česti na mnogim odmorištima duž europskih autocesta. <br>Još jednom ćemo se morati \"uvući\" u parkirno mjesto ispred nas."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Vozite prema označenom parkirnom mjestu blizu kraja reda."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Držite se prema sredini trake ili malo uz vozačevu stranu. Nemojte se voziti preblizu preprekama jer ih stražnji dio prikolice može udariti tijekom skretanja."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Provezite se malo dalje pokraj parkirnog mjesta, a zatim oštro i brzo skrenite prema mjestu. Morat ćete paziti na oba bočna retrovizora: retrovizor na vozačevoj strani kako biste osigurali da prednji dio vaše prikolice ne udari u prikolicu pokraj vas i retrovizor na suvozačevoj strani kako biste vidjeli da vaša prikolica sigurno ulazi na parkirno mjesto."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Zaustavite se na predviđenom području, osigurajte kamion i ugasite motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Kod dijagonalnog parkiranja važno je točno procijeniti svoju poziciju. Kad jednom uđete u zavoj, teško je voziti unazad i sigurno promijeniti položaj, pa je idealno provjeriti imate li dovoljno mjesta u prvom pokušaju.<br><br><font face=/font/big_bold.font >Pripremite se za polazak.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Vozite prema parkirnom mjestu. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Drive past the parking spot so your trailer has room to pivot around the truck on your inside.<br><br><font face=/font/big_bold.font>Turn into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Vožnja unatrag slijepom stranom"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "U ovom scenariju, pogledat ćemo \"slijepu stranu\" kretanja kamiona unatrag na parkirno mjesto. Bez mogućnosti da vidite kroz prozor kamo idete, morat ćete se osloniti samo na svoje retrovizore da vas dovedu tamo gdje trebate ići."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "U ovom scenariju naučit ćete manevar vožnje unatrag 'slijepom stranom'. Ovo općenito treba izbjegavati osim ako nema alternative, jer je vaša vidljivost ozbiljno ograničena. Uzmite si vremena i pogriješite na strani krajnjeg opreza."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Vozite dalje od parkirnog mjesta kako biste imali prostora za rad nakon što krenete unatrag."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Zaustavite se, provjerite okolinu i počnite voziti unatrag."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Turn the tractor away from the spot. This will push the front of the trailer around, and in turn point the rear of the trailer towards the parking spot you want to go into. Be careful not to overdo it or you can risk 'jack-knifing' the combination."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Kad prikolica uđe na parkirno mjesto, počnite ispravljati kamion."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Zaustavite se na predviđenom području i osigurajte kamion."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Vožnja unazad na slijepoj strani zahtijeva iste postupke kao i vožnja unatrag na vozačevoj strani, ali ćete biti hendikepirani nedostatkom vidljivosti na toj strani. Koristite svoje retrovizore i svoju najbolju prosudbu da parkirate kamion.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "There is a parking spot ahead and on the passenger's side. You'll need to pull well past it so that you have room to manoeuvre as you reverse.<br><br><font face=/font/big_bold.font>Drive forwards. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Zapamtite, pomicanje kamiona od mjesta će pomaknuti prikolicu prema njemu. Koristite svoje retrovizore najbolje što možete kako biste lakše ušli na parkirno mjesto.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Vožnja kružnim tokom"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "U ovom scenariju, pogledat ćemo kako savladati kružni tok.<br><br>Morat ćete obratiti posebnu pozornost na svoju prikolicu jer će se drugačije kretati iza vas dok ulazite, vozite kroz kružni tok i dok izlazite."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Ulazak u kružni tok"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Vožnja kružnim tokom"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Vožnja kružnim tokom"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Izlazak iz kružnog toka"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Vožnja do označenog područja"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Kružni tokovi vrlo su česti na europskim ulicama, stoga je važno znati kako ih svladavati."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Stay to the outside of your lane as you approach the roundabout. This will help your trailer clear the inside of the initial turn in."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Drive towards the centre of the roundabout as you enter. Once inside, you'll have to head towards the outside. This is to keep your trailer away from the centre of the roundabout."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Pazite na retrovizor kako biste bili sigurni da se prikolica ne približava preblizu unutarnjim preprekama."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Leaving the roundabout is fairly easy since your trailer is already positioned away from the inside of the exit. Swing wide on exit and the trailer should follow nicely."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parkirajte na predviđenom području i osigurajte kamion."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Ispred vas je postavljen kružni tok kojim ćete voziti. <br><br><font face=/font/big_bold.font>Polako se približite kružnom toku. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Napravite široki okret kada ulazite u kružni tok kako bi vaša prikolica bez problema ušla iza vas. <br><br><font face=/font/big_bold.font>Uđite u kružni tok. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Vozite prema vanjskoj strani kružnog toka. Morat ćete držati kamion što dalje od središta kružnog toka kako biste svoju prikolicu držali podalje od središnjih barijera. <br><br><font face=/font/big_bold.font>Nastavite kroz kružni tok.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Ostanite blizu vanjskih čunjeva. <br><br><font face=/font/big_bold.font>Nastavite voziti.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Izađite iz kružnog toka.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Nastavite do parkirnog mjesta ispred vas.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se u označenom području. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Osigurajte kamion i ugasite motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manevriranje u skučenom prostoru"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "For the final scenario, you'll be tasked with turning the truck around in a tight space. It will require you to reverse to the blind side in an area with limited room to manoeuvre, which will require attention to your surroundings and smart use of space."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Driving into the Course"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Setting Up for a Blind Side"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Vožnja unatrag na mjesto"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Dovršavanje Slijepe strane"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Izlazak s tečaja"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In this scenario, we'll go over how to turn around in a tight space with a blind side reversing manoeuvre. This skill will come in handy when you can't make a U-turn or back in on your driver's side."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Oznake na cesti pomoći će vam u kretanju kroz tečaj obuke."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Make a wide turn to ensure your trailer clears the parked trucks."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "As you exit the turn, consider how you will set up the truck for your reversing manoeuvre."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "It will help to have the truck on an angle pointed towards the empty parking spot on your passenger's side, where you will be reversing into."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Blind side reversing should be avoided when possible as there is significantly less visibility. Unfortunately, there are times when you will have no choice but to do it."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Turn the wheel before reversing. This will help get your trailer pointed where you want it immediately, which helps in very tight situations."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Once the trailer is well into the spot, position the tractor in front of the trailer and straighten it out."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Stop once you've straightened out and have enough room to pull forwards again. Start heading back the same way you came in."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Follow the road markings out of the training course."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Drive through the curve ahead and proceed to the designated area."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Zaustavljanje."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Osigurajte kamion i ugasite motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "In the area in front of you there's a training course representing a shipping company's lot. Your task is to head in there and turn the truck around to come back out. Be sure to make good use of the room around you.<br><br><font face=/font/big_bold.font>Prepare to set off </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Proceed towards the training course. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Turn the corner and continue through the course. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Follow the road markings to the barrier at the end of the course. Park on a bit of an angle so that your trailer is pointed towards the empty parking spot on your passenger's side.<br><br><font face=/font/big_bold.font>Continue forwards. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Imate puno ograničeniji pogled na ono što se događa oko vas kada ne vidite. Vozite polako, koristite retrovizore i budite oprezni.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag i okrenite prikolicu na prazno parkirno mjesto. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "That's far enough. You can now proceed forwards and head out of the training ground from the same direction you came from.<br><br><font face=/font/big_bold.font>Start heading towards the exit. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Napustite tečaj. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Slijedite oznake na cesti do posljednjeg parkirnog mjesta.<br><br><font face=/font/big_bold.font>Nastavite do označenog područja. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Offset Reversing Manoeuvre"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "U ovom scenariju, imat ćete zadatak voziti unatrag na parkirno mjesto koje nije neposredno iza vas. Prostor za upravljanje je ograničen, pa ga mudro iskoristite."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "U ovom scenariju, vaš će zadatak biti parkirati na mjesto koje se nalazi pokraj vas. Nema puno prostora za manevriranje, pa ćete morati malo više poraditi kako biste prikolicu doveli gdje želite."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Vozite ravno do prepreke."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Zaustavite se prije prepreke."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Prije kretanja skroz okrenite volan prema vozačevoj strani. Na taj način počet ćete okretati prikolicu prema parkirnom mjestu čim krenete unatrag, štedeći tako dragocjeni prostor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Nakon što prikolicu usmjerite kamo želite, postavite šleper/tegljač ispred prikolice i počnite je usmjeravati na parkirno mjesto."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Od ove točke pa nadalje, to se ne razlikuje toliko od uobičajenog parkiranja."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Nastavite voziti unatrag i promatrajte obje strane. Držite šleper/tegljač i prikolicu poravnate s parkirnim mjestom."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zaustavite se na predviđenom području, osigurajte kamion i ugasite motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Nalazite se na parkirnom mjestu, ali s vaše desne strane postoji drugo parkirno mjesto na koje se morate pomaknuti.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Ispred vas je označeno područje.<br><br><font face=/font/big_bold.font>Vozite naprijed. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ne zaboravite odmah početi okretati, jer nema puno mjesta.<br><br><font face=/font/big_bold.font>Vozite unatrag do označenog mjesta iza vas. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Vožnja kroz jednostavne zavoje"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "U ovom scenariju, proći ćete kratku vožnju kroz tečaj obuke koji će vam pomoći da naučite upravljati prikolicom oko jednostavnih zavoja od 90 stupnjeva."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Prolazak prvoj zavoja"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Drugi zavoj"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Zadnji zavoj"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Pred vama su uski zavoji s malo slobodnog prostora. To će vam pomoći da naučite učinkovito upravljati prikolicom."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Slijedite oznake na cesti prema prepreci na vozačkoj strani kako biste se pripremili za prvo skretanje."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Stay close to the outside barrier through the turn and the trailer should follow you nicely into the course."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Nastavite slijediti oznake na cesti kako biste se postavili za drugo skretanje, uski zavoj od 90 stupnjeva."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "You'll have to drive deep into the corner to ensure your trailer will clear the inside barriers. Use your front mirror to help you go as far as you can into the corner without hitting anything."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Nastavite uz vanjsku prepreku."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Još jednom, još jedan uski zavoj od 90 stupnjeva zahtijevat će da iskoristite sav prostorij koji vam je na raspolaganju."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Zaustavite se na predviđenom području i osigurajte kamion."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Remember to use all the room available to you to help you negotiate each turn.<br><br><font face=/font/big_bold.font>Set off and follow the road markings to the outside. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Follow the outer barrier around, but keep an eye on your trailer in the mirror.<br><br><font face=/font/big_bold.font>Make the first turn. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Slijedite oznake na cesti kako biste se postavili za skretanje od 90 stupnjeva ispred.<br><br><font face=/font/big_bold.font>Napravite skretanje od 90 stupnjeva. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Držite kamion široko nakon skretanja, jer vas čeka još jedan još uski zaokret od 90 stupnjeva.<br><br><font face=/font/big_bold.font>Nastavite voziti. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Nastavite do parkirnog mjesta ispred. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Dijagonalno parkiranje unatrag"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "In this scenario, we'll explore parking diagonally while reversing. This can occur at rest areas, truck stops, and even at shippers. Often there's little space because the lots are crowded with trucks, so parking is all the more difficult due to the lack of space."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonal parking seems easier at a glance, but it can often be more challenging than typical 'alley-backing' manoeuvres."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Vozite unatrag prema parkirnom mjestu. Za sada držite tegljač/šleper i prikolicu ravno."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "As you get closer, let your trailer walk closer to the parked trucks. This will help you turn it into the spot when you reach it."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Start turning the trailer into the parking spot. Keep your trailer close to the truck on your driver's side, as you'll need the space on the other side."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Once the trailer is well into the parking spot, start turning the tractor to follow the trailer in."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parkirajte na predviđenom području, osigurajte kamion i ugasite motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parkirajte kamion na mjesto iza sebe. Koristite oba retrovizora za navigaciju unatrag.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Provjerite svoju okolinu, a zatim krenite prema parkirnom mjestu.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Start moving the trailer towards the trucks beside you. When you're ready, turn the trailer into the parking spot. Remember to consider the tail swing of the trailer.<br><br><font face=/font/big_bold.font>Turn into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Vožnja unatrag u zavoj"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "U ovom ćemo scenariju po prvi put voziti unatrag s prikolicom u zavoj. Istražit ćemo osnovne principe vožnje unatrag i na što treba paziti prilikom skretanja unatrag."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "U ovom scenariju, morat ćete voziti unatrag do parkirnog mjesta koje je iza vas sa vozačeve strane."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Imajte na umu nekoliko savjeta koji će vam puno pomoći s prikolicama pri vožnji unatrag. <br>Prvi je da će prikolica uvijek htjeti skrenuti u smjeru suprotnom od smjera kojim upravljate šleperom/tegljačem."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Drugo je da možete dobiti dobar osjećaj kamo ide prikolica promatrajući osovine kamiona i prikolice."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Treće, mali pomaci dovest će vas tamo gdje trebate ići, nema potrebe za pretjeranim radom."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Start turning the tractor away from the parking spot slightly, and the trailer will begin to point towards it."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Follow the trailer, making adjustments as you go to keep it on the right path."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Watch your trailer wheels and the rear wheel of the tractor. These will tell you where the trailer is pointed, and where the tractor is pushing it."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "A fourth tip is that it's always easier to turn the trailer sharper than it is to try and straighten it out from a jackknife. Aim for the outside of the spot until you are closer to it, then you can turn a bit sharper to align your trailer."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "As the trailer enters the parking spot, get the tractor in front of the trailer. Try to avoid too many adjustments inside the spot."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Vozite unatrag između barijera, provjerite obje strane dok vozite."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Osigurajte kamion i ugasite motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Remember these tips when reversing into a turn with a trailer:<br><br>— The trailer turns opposite to how you steer the tractor<br><br>— Watch trailer's wheels to see where it's aiming<br><br>— Watch the tractor's rear wheel to see where it's pushing the trailer<br><br>— Let the trailer do the work, don't oversteer it<br><br>— It's always easier to turn the trailer sharper than it is to straighten it out<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Pogledajte iza sebe kako biste vidjeli kamo trebate ići. Uvijek provjerite svoju okolinu prije nego krenete unatrag.<br><br><font face=/font/big_bold.font>Krenite unatrag prema mjestu parkiranja. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Start turning the trailer towards the parking spot and follow it in.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se na označenom mjestu. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Parkiranje unatrag na uskom parkiralištu"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "In this scenario, you'll be tasked with reversing the trailer into a parking spot in a busy lot."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "This is a typical parking lot for trucks. Truckers will encounter this sort of parking situation almost daily in their careers.<br>Parking here requires an 'alley parking' manoeuvre."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "This is a similar manoeuvre to the previous scenario, but you'll have less room to work so you will need to plan your moves accordingly and be careful not to hit anything."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Since there is less room, your timing is more important. Turn the trailer at the right time and watch the tractor and trailer wheels to see where it will go. Keep your tail swing in mind and remember not to jackknife - keep pushing the trailer."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Try to keep close to the truck on your driver's side, this gives your trailer room to swing and you can worry less about the truck on your passenger's side."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Once your trailer is in the spot, get the tractor in front of it. It's better to do this a bit earlier than your instinct might initially have you believe. You can always correct it as your reverse to your final position."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Poravnajte šleper/tegljač i prikolicu i zaustavite se na predviđenom području."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Osigurajte kamion i ugasite motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Now we'll try turning a trailer in a much smaller area with an 'alley-backing' manoeuvre. <br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Provjerite svoju okolinu i potražite parkirno mjesto iza sebe. <br><br><font face=/font/big_bold.font>Počnite voziti unatrag prema parkirnom mjestu. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Turn the trailer into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
