#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Za konačni scenarij ovog poglavlja, vozit ćemo se po testnoj stazi sa složenom konfiguracijom."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Prvo je slalom kroz prepreke. Vozite kroza nj i ne zaboravite koristiti retrovizore."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Slijedi oštar zavoj. Držite se široko i to vam ne bi trebalo predstavljati probleme."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Ovdje je lijevo skretanje od 90 stupnjeva. Ne zaboravite voziti duboko tako da stražnji dio kamiona oslobodi unutarnje prepreke."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Rampa može biti malo nezgodna. Poravnajte se što je bolje moguće prije nego što se vozite preko nje te koristite prednja i bočna ogledala da biste se lakše snašli."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Sljedeći dio mora biti odrađen unatrag. Pristupite preprekama ispred sebe imajući to na umu."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Pratite oznake na cesti iza i desno od vas."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Vozite unatrag do prepreka, zatim se zaustavite i nastavite naprijed lijevo."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Proceed through the break in the median to the next section."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Ovaj prolaz kroz čunjeve je vrlo uzak. Vozite polako i pomoću retrovizora se orijentirajte unutar prolaza."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Ne zaboravite voziti duboko u zavojima od 90 stupnjeva."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Ulazite u lijepu otvorenu dionicu ceste. Možete malo ubrzati, ali imajte na umu da ćete uskoro morati usporiti zbog zavoja ispred vas."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "U podnožju brda postoje prepreke preko ceste. Vozite do njih, zatim vozite unatrag na parkirno mjesto s lijeve strane."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Vožnja unatrag do parkirnog mjesta."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parkirajte, zatim ugasite motor i osigurajte kamion."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Pred vama je slalom sastavljen od prepreka.<br><br><font face=/font/big_bold.font>Vozite kroz slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Držite se vanjske strane zavoja kako biste osigurali da stražnji dio šlepera/tegljača ne prijeđe preko rubnika.<br><br><font face=/font/big_bold.font>Napravite zaokret. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Dolazite do lijevog skretanja od 90 stupnjeva. Ne zaboravite iskoristiti sav prostor koji imate na raspolaganju.<br><br><font face=/font/big_bold.font>Skrenite. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Poravnajte se s rampom. Nema puno prostora za ispravke kada ste na njoj.<br><br><font face=/font/big_bold.font>Vozite preko rampe. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Pratite stazu ulijevo. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Sljedeći dio mora se ispuniti vozeći unatrag. Zaustavite se kod prepreka ispred vas kako biste nakon toga mogli krenuti unatrag udesno.<br><br><font face=/font/big_bold.font>Zaustavite se kod prepreka.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Vozite unatrag prema području iza vas i desno. Na cesti su strelice koje će vam pomoći.<br><br><font face=/font/big_bold.font>Krenite unatrag prema sljedećem dijelu. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Nastavite voziti unatrag prema preprekama iza sebe.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zaustavite se i ubacite u brzinu za naprijed, zatim nastavite ulijevo. <br><br><font face=/font/big_bold.font>Vozite naprijed. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "There is a break in the median to the left. Drive through it.<br><br><font face=/font/big_bold.font>Continue onwards. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Ispred vas je uska vijugava staza kroz nekoliko čunjeva. Vozite pažljivo i koristite retrovizore ako je potrebno.<br><br><font face=/font/big_bold.font>Vozite kroz čunjeve. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Nastavite kroz stazu.<br><br><font face=/font/big_bold.font>Skrenite ulijevo. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Ne zaboravite se držati lijeve strane prije skretanja kako biste imali što više prostora.<br><br><font face=/font/big_bold.font>Skrenite. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Ovdje možete malo ubrzati, ali ispred vas je zavoj.<br><br><font face=/font/big_bold.font>Nastavite stazom. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Zavoj postaje oštriji kako ga prolazite.<br><br><font face=/font/big_bold.font>Prilagodite brzinu sukladno tome i nastavite.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "U podnožju brda vidjet ćete prepreke koje blokiraju cestu. <br><br><font face=/font/big_bold.font>Zaustavite se blizu prepreka. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Iza vas nalijevo nalazi se parkirno mjesto.<br><br><font face=/font/big_bold.font>Vozite unatrag na parkirno mjesto. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Zaustavite se u označenom području. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Driving on a Handling Track"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "U ovom scenariju, odvest ćemo se na stazu dizajniranu da testira vašu sposobnost upravljanja kamionom kroz različite vrste zavoja i zavoja."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Ulazak u stazu"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Postupno skretanje ulijevo"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Vožnja kroz S-zavoje"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Ravni dio"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Lagana skretanja"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Izlazak iz tečaja obuke"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Približavanje parkirnom mjestu"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "U ovom scenariju, odvest ćemo šleper/tegljač na kratku vožnju da vidimo kako se nosite sa svojim novostečenim vještinama."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Postoje razne vrste i kombinacije zavoja na stazi. Ovo nije utrka i nije na vrijeme. Budite strpljivi i prilagodite brzinu vožnje zavojima i preprekama na koje nailazite."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "U početku je staza blaga i lagana, ali će zavoji dalje biti sve složeniji."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Pazite na svoju brzinu; lako je krenuti prebrzo i onda krivo procijeniti skretanje."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Izlaz sa staze je vrlo uski zavoj. Idite polako i iskoristite cijeli prostor koji vam je na raspolaganju."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parkirajte između prepreka i osigurajte kamion."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Da biste uspješno dovršili ovaj scenarij, ne smijete se sudariti, skrenuti sa staze ili udariti u prometne čunjeve.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Nastavite naprijed u oštar desni zavoj za ulazak na stazu. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Vozite kroz skretanje ravnomjernom brzinom. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Približavate se složenijem dijelu zavojitih skretanja.<br><br><font face=/font/big_bold.font>Prilagodite svoju brzinu u skladu s time i nastavite.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Nastavite prema sljedećem nizu skretanja.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Dolaze lagana skretanja. Održavajte ujednačenu brzinu.<br><br><font face=/font/big_bold.font>Nastavite voziti. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "The turn out of the course is a sharp hairpin turn. Slow down and stay to the outside before the turn. Be sure to use your mirrors!<br><br><font face=/font/big_bold.font>Turn out of the course. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Ispred vas je mjesto za parkiranje između prepreka.<br><br><font face=/font/big_bold.font>Nastavite prema mjestu za parkiranje. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Bočno parkiranje"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "U ovom scenariju, pogledat ćemo bočno parkiranje između druga dva kamiona."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zaustavljanje ispred parkirnog mjesta"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Provjera retrovizora"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Vožnja unatrag na parkirno mjesto"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Poravnanje kamiona unutar parkirnog mjesta"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Bočno parkiranje ključna je vještina koju svaki vozač kamiona treba znati.<br>Pripremite se za polazak."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Vozite prema parkirnom mjestu.<br>Obratite pozornost na okolinu."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Poravnajte se s kamionom ispred vašeg parkirnog mjesta. Nemojte mu biti preblizu, držite se na određenoj udaljenosti od njega kako biste imali prostora za rad."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Naglo skrenite prema mjestu i počnite voziti unatrag."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Kada gledate u retrovizor na vozačevoj strani, ciljajte na rubnik koji se nalazi točno ispred kamiona iza vas."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Once your front bumper clears the truck ahead of you, you can begin steering the front end of the truck into the spot, aligning the truck with the parking spot."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ispravite kotač i poravnajte kamion unutar parkirnog mjesta.<br>Parkirajte i osigurajte kamion."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Ispred vas su parkirani kamioni. Ostalo je jedno slobodno mjesto za parkiranje. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Ne zaboravite biti svjesni svoje okoline. Dobro koristite svoja retrovizore tijekom ovog manevra. <br><br><font face=/font/big_bold.font>Vozite naprijed. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Prođite pokraj parkirnog mjesta do označenog područja. Odatle možete započeti vožnju unazad.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom mjestu. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Provjerite ima li u okolini prepreka i jeste li sigurni za vožnju unatrag.<br><br><font face=/font/big_bold.font>Pogledajte kroz retrovizor na suvozačevoj strani. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Okrenite kotače i krenite unatrag do parkirnog mjesta.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Počnite ispravljati kamion kada je to potrebno. Nemojte voziti preko rubnika!<br><br><font face=/font/big_bold.font>Poravnajte kamion na mjesto. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
