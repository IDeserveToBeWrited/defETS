	val[]: "World of Trucks je otkrio novi sadržaj igre. Povežite se s uslugom World of Trucks da biste pristupili novom sadržaju." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Mrežne" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online postavke. Podesite sve postavke vezane uz World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Želite li zaista odgoditi registraciju?<br><br>Možete kasnije pristupiti dijalogu Online Connect Content iz Online opcija koje se nalaze na radnoj površini." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "POVEZIVANJE SADRŽAJA" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Povezivanje sadržaja.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Neuspješno stavljanje operacije povezivanja u red čekanja za: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam račun koji ste upotrijebili za registraciju ovog DLC-a razlikuje se od onog koji je korišten za kreiranje vašeg World of Trucks računa ili za registraciju igre. Promijenite svoj Steam račun i pokušajte ponovno." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam račun koji koristite za registraciju ovog DLC-a već je povezan s drugim World of Trucks računom. Za registraciju DLC-a na trenutni račun morate koristiti Steam račun koji nije povezan ni s jednim računom World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token je istekao. Molimo pokušajte ponovo kasnije." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Serijski ključ za aktiviranje DLC-a nije valjan. Molimo kontaktirajte službu za pomoć: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Došlo je do interne pogreške tijekom registracije igre. Molimo pokušajte ponovo kasnije." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "USPJEH" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "PREGLEDNIK SADRŽAJA" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Čestitamo! Odabrani DLC-ovi uspješno su povezani s vašim računom World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nije moguće povezati sadržaj jer je trenutni Steam račun povezan s drugim računom World of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Neki se DLC-ovi nisu uspjeli povezati.<br>Pređite mišem preko uskličnika za svaki DLC da biste vidjeli više detalja." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registracija $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Trenutačni profil nije povezan sa World of Trucks ili igra radi u izvanmrežnom načinu rada. Uredite profil za povezivanje." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Kliknite za odbacivanje"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ trenutno kompatibilni DLC-ovi povezani. Ako neki DLC-ovi nisu povezani s World of Trucks, možda će vam nedostajati neke njegove značajke." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Čestitamo!<color value=@@clr_txt@@>Sav vaš sadržaj povezan je sa World of Trucks! Sada možete koristiti sve njegove značajke." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Nije moguće povezati novi sadržaj sa World of Trucks jer se trenutno korišteni Steam račun ne podudara sa Steam računom koji koristi profil World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Spojen" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nije spojen" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Nije moguće dohvatiti informacije o sadržaju u vlasništvu." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Nije moguće dohvatiti informacije o povezanom sadržaju." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Nije moguće dohvatiti informacije o trenutno korištenom računu." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Kasnije" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Nije moguće registrirati ovaj DLC. Nije pronađena trajna licenca vjerojatno zbog Steam Family Sharinga." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Nema trajnog vlasništva" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Misija Izvanredni prijevoz izvršena!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "NEUSPJEŠNA MISIJA!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Napusti"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Učitaj kontrolnu točku"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Oštetili ste vozilo za pratnju!<br>Možete učitati kontrolnu točku ili otkazati isporuku s novčanom kaznom u iznosu od $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Vozilo za pratnju se uništilo u prometu zbog neispravne vožnje.<br>Možete učitati kontrolnu točku ili otkazati dostavu uz novčanu kaznu u iznosu od $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Trebali biste slijediti rutu.<br> Možete učitati kontrolnu točku ili otkazati isporuku s novčanom kaznom u iznosu od $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Trebali ste ostati s vozilima za pratnju.<br> Možete učitati kontrolnu točku ili otkazati isporuku s novčanom kaznom u iznosu od $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Odvezli ste se od vozila za pratnju!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Oštetili ste vozilo za pratnju!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Vozilo za pratnju se razbilo!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Sišli ste s rute!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimenzije"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Izvanredni prijevoz"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Držite teret između vozila za pratnju."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Posebne isporuke"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimenzije"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Izvanredni prijevoz"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Molimo usporite da spriječite sudar s vozilom za pratnju..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Pričekajte stražnje vozilo za pratnju..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Oprezno, molim vas, dolazi zaista tijesni dio rute..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Približava se manevar promjene trake. Prilagodite brzinu kako biste izbjegli mogući sudar..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Vozilo prednje za pratnju upozorit će ostale vozače...<br> Prilagodite brzinu kako biste izbjegli mogući sudar..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Vozila za pratnju čekaju vas na obližnjem raskrižju. Molimo slijedite rutu."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Pazite!<br> Prilazite stražnjem vozilu za pratnju!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Pazite!<br>Krećete se opasno blizu stražnje pratnje!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Pritisnite sljedeću tipku za prikaz ponude izvanrednog posla:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Ponuda izvanrednog posla:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Prevozit ćete vangabaritni teret! Imat ćete pratnju dva vozila. Molimo vas da budete oprezni i slijedite njihova upozorenja i obavijesti. Vangabaritni tereti poput ovog ne staju na crvenom semaforu i u većini situacija imaju prednost. Tijekom ovih isporuka, kontrolne točke se postavljaju češće kako bi se sačuvao vaš trenutni napredak."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Obratite dodatnu pozornost na sljedeće:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Izbjegavajte moguće sudare s vozilima za pratnju i držite teret između njih."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ne vozite se izvan predviđene rute, niti prema benzinskim stanicama, stanicama za odmor i sl."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Pridržavajte se ograničenja brzine koja će osigurati prednje vozilo za pratnju."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Pazite na pretjecanje i ostale vozače na cestama."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manevar promjene trake:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Ako ne slijedite ova pravila, zadatak vašeg izvanrednog prijevoza možda neće uspjeti!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manevar započinje <color value=@@clr_sel@@>straga<color value=@@clr_txt@@> promjenom i blokiranjem označene trake."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Prednja<color value=@@clr_txt@@> pratnja čeka dok ne bude oslobođena traka, a zatim mijenja traku."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Tada je sigurno da se <color value=@@clr_sel@@>igrač<color value=@@clr_txt@@> pomakne u određeni trak."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Cisterne kamiona su napunjene, a sati vožnje obnovljeni."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Ne možete zvati pomoć za vrijeme izvanrednog prijevoza."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Ne možete koristiti trajekt za vrijeme izvanrednog prijevoza."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Malo se odmarate...<br>Rezervoari kamiona se pune..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Približavamo se obveznom zaustavljanju.<br>Pratite pratnju do parkirnog mjesta za odmor!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Obavezno zaustavljanje"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Pritisnite sljedeću tipku za odmor i punjenje goriva:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Došlo je do pogreške prilikom učitavanja sadržaja Steam inventara.<br><br>$ERROR$<br><br>Odaberite nastavi kako bi sadržaj ostao omogućen. Igra će ga povremeno tražiti.<br><br>Možete privremeno onemogućiti sadržaj kako se poruke o pogrešci poput ove više ne bi pojavljivale. Igra će automatski ponovo omogućiti sadržaj sljedeći put kada je pokrenete." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Nije moguće preuzeti stavke Steam inventara." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTAR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Učitavanje stavki Steam inventara..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOVE STAVKE INVENTARA" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Otkrivene su nove stavke Steam inventara." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Dodatna oprema za vozila" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Pribor za kabinu" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Pozadina radne površine" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Boja" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Onemogući inventar" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Probajte ponovno kasnije" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM INVENTAR" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Neke su stavke uklonjene iz vašeg Steam inventara. Više ih nećete moći kupiti u trgovini za nadogradnju.<br><br>Ovo ne utječe na vaše trenutno instalirane stavke." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


