#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banka" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Ako trebaš novaca, uvijek banku možeš tražiti kredit." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "KREDITNE PONUDE" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "za $MONEY$ na dan" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Broj aktivnih kredita: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Možeš posuditi: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "PREGLED AKTIVNIH KREDITA"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Kredit" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Preostaje za otplatu" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Trajanje (u danima)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Kamata (godišnja)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Rata" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Otplati" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Ukupno:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Stanje računa: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NOVI KREDIT" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Tražiš kredit u iznosu od $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Period otplate:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Kamata (godišnje):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Dnevna rata:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Želiš li potvrditi svoj zahtjev?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "OTPLATI KREDIT" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Želiš li zaista potrošiti $MONEY$ za otplatu kredita?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


	key[]: "bank_msg_payment"
