#+ Version change detected message box.
#@{
	key[]: "version_change_detected_t"
	val[]: "OTKRIVENA PROMJENA VERZIJE" #+ Title of the infomational message box when version change has been detected.

	key[]: "version_upgrade_detected"
	val[]: "Igra je nadograđena na noviju verziju." #+ The message showed when upgrade of the game to the newer version has been detected.

	key[]: "version_downgrade_detected"
	val[]: "Igra je vraćena na stariju verziju." #+ The message showed when downgrade of the game to the older version has been detected.

	key[]: "version_change_detected_common"
	val[]: "<br><br>Promjene verzije igre mogu pokvariti dodatke, što može dovesti do pada igre ili nestabilnosti; autori dodataka odgovorni su za održavanje kompatibilnosti modova. Provjerite jesu li vaši aktivirani dodaci kompatibilni.<br><br>Savjet za rješavanje problema: Ako trenutno izdanje dodatka nije kompatibilno, pokušajte ga onemogućiti u Mod Manageru.<br><br>Verzija igre: $GAME_VERSION$" #+ Common message (showed for both downgrade and upgrade) in the version change dialog.
#@}

