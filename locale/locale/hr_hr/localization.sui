	key[]: "wanna_assistance"
	val[]: "Služba za pomoć može vas i vaš kamion odvesti do $CITY$. Koštat će $MONEY$, a putovanje će potrajati $TIME$.<br offset=30>Slažete li se?"

	key[]: "wanna_assistance_quick"
	val[]: "Služba za pomoć može vas i vaš kamion odvesti do $CITY$. Koštat će $MONEY$, a putovanje će potrajati $TIME$.<br>(Naplatu će snositi vaš poslodavac.)<br offset=30>Slažete li se?"

	key[]: "wanna_assistance_online"
	val[]: "Služba za pomoć može vas i vaš kamion odvesti do $CITY$. Koštat će $MONEY$, a putovanje će potrajati $TIME$.<br offset=30>Vaša trenutna isporuka bit će otkazana.<br offset=30>Slažete li se?"

	key[]: "wanna_recover"
	val[]: "Assistance Service can take you and your truck to the nearest road. It will cost $MONEY$ and the trip will take $TIME$.<br offset=30>Do you agree?"

	key[]: "wanna_recover_quick"
	val[]: "Assistance Service can take you and your truck to the nearest road. It will cost $MONEY$ and the trip will take $TIME$.<br>(The charge will be covered by your employer.)<br offset=30>Do you agree?"

	key[]: "wanna_recover_online"
	val[]: "Assistance Service can take you and your truck to the nearest road. It will cost $MONEY$ and the trip will take $TIME$.<br offset=30>Your current delivery will be cancelled.<br offset=30>Do you agree?"

	key[]: "wanna_refuel"
	val[]: "Usluga dopunjavanja gorivom u slučaju nužde opskrbit će vas s $VOLUME$ dizela. Koštat će $MONEY$ i trajat će $TIME$.<br offset=30>Slažete li se?"

	key[]: "wanna_refuel_quick"
	val[]: "Usluga dopunjavanja gorivom u slučaju nužde opskrbit će vas s $VOLUME$ dizela. Koštat će $MONEY$ i trajat će $TIME$.<br>(Naplatu će snositi vaš poslodavac.)<br offset=30>Slažete li se?"

	key[]: "wanna_refuel_online"
	val[]: "Usluga dopunjavanja gorivom u slučaju nužde opskrbit će vas s $VOLUME$ dizela. Koštat će $MONEY$ i trajat će $TIME$.<br offset=30>Slažete li se?"

	key[]: "wanna_recharge"
