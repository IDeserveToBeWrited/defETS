#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "KONTROLE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
