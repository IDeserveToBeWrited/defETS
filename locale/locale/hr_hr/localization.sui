#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Odabir tema koje se prikazuju u pozadini dok pregledavate izbornik."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Omogućuje nasumični odabir pozadinske teme svaki put kada pokrenete igru."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Postavlja odgodu nakon koje elementi na radnoj površini nestaju."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, s vremenom ćete početi osjećati posljedice umora.<br><br>Izbjegavanje odmora rezultirat će prometnim prekršajima."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "When enabled, you must obey traffic rules or risk getting traffic offences. The risk is increased near police vehicles, radar and traffic cameras."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Prilagođava prosječno trajanje ponuđenih poslova."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Odaberite koje ograničenje brzine želite prikazati na navigacijskom programu."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Trenutna brzina na navigaciji mijenja se u crvenu kada se prekorači ograničenje brzine."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada stignete na odredište, prikazat će se widget koji vam omogućuje da preskočite parkiranje."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all widgets hidden."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Skriva oba HUD zrcala."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all notifications hidden even when they are received."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Prikazuje prozor mogućnosti trenutnog kamiona prije prihvaćanja posla teškog tereta."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Odaberite način poravnanja karte."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Odaberite kako će navigacija biti prikazana"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja način usmjeravanja navigacije:<br>- \"Najbolji\" način navigacije odabire najučinkovitiji omjer između duljine i vremena rute, pokušava izbjeći križanja sa semaforima itd.<br>- \"Najkraći\" način navigacije uvijek bira najkraću moguću rutu.<br>- Način navigacije \"Male ceste\" odabire izbjegavanje autocesta gdje god je to moguće."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja težinu parkiranja:<br>- \"Uvijek odaberi\" omogućuje vam da odaberete kada stignete na odredište.<br>- \"Sigurno parkiranje\" ne zahtijeva manevre vožnje unatrag.<br>- \"Vješto parkiranje\" obično zahtijeva zahtjevniji manevar vožnje unatrag."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Prilagođava vjerojatnost susreta s opasnostima na cesti u vašoj blizini, uključujući nesreće, onesposobljena vozila, ostatke ceste itd."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Prilagođava vjerojatnost nailaska na obilazak koja mijenja rutu tijekom vožnje na posao."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Podešava vjerojatnost lošeg vremena."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Odaberite hoće li se informacije o vremenskoj zoni prikazivati uz trenutno vrijeme."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Omogućuje scene unutar igre koji se obično prikazuju nakon kupnje kamiona ili nadogradnje garaže."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Odaberite hoće li se poluprozirni blokatori prikazivati na cestama kojima se ne može pristupiti."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Okreće os Y miša prilikom upravljanja kamerom u igri."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Odabire vrstu mjenjača:<br>- \"Jednostavan automatski\" dopušta korištenje gasa i kočnice za upravljanje kretanjem naprijed i unatrag.<br>- \"Pravi automatski\" zahtijeva unos za prebacivanje između brzina naprijed i nazad.<br>- \"Sekvencijalni\" zahtijeva ručno mijenjanje svih stupnjeva prijenosa s unosom brzina gore/dolje.<br>- \"H-Shifter\" zahtijeva upotrebu kontrolera s mjenjačem za biranje za ručni odabir prijenosa."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućavanje ove značajke omogućit će \"preskakanje stupnjeva prijenosa\" - preskakanje stupnjeva prijenosa kada je to potrebno ili praktično kako bi se izbjeglo mijenjanje svakog stupnja prijenosa u mjenjaču."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Brings the steering wheel back to the centre when a keyboard or controller is used.<br><br>Disabling this feature means you will have to manually steer back to centre after a turn."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Podešava raspon animacije upravljača. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja intenzitet kočnica."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja stabilnost kamiona spuštanjem njegovog težišta."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja stabilnost prikolice spuštanjem težišta."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the truck \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja krutost ovjesa šasije."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja krutost ovjesa kabine/spavaćeg mjesta."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Prilagođava intenzitet proceduralno generiranih površinskih neravnina kako bi cestama i drugim terenima dao nesavršen dojam.<br><br>Ovisno o drugim postavkama ovjesa i kamere, uočeni učinak može biti više ili manje izražen."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućuje napredno spajanje koje zahtijeva veću preciznost za poravnavanje sedla kamiona s glavnim klinom prikolice.<br><br>Kada je onemogućeno, spajanje prikolice postaje mnogo lakše jer nema sudara između glavnog klina i sedla."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Odabir hoće li se i koji kabeli prikolice animirati.<br><br><color value=@@clr_txt_d@@>Omogućavanje kabela na više vozila može utjecati na performanse na starijim sustavima."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Omogućuje elektronički limitator brzine kamiona od 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>Poslovi u World of Trucks imaju ovu značajku trajno uključenu."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, a brisači vjetrobrana postavljeni na prvi položaj, brisači će se automatski uključiti i prilagoditi svoju brzinu prema uvjetima."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućuje automatsko uključivanje retardera pri kočenju."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, vozilo pomaže pri kretanju na uzbrdici držeći kočnice, osiguravajući glatko pokretanje."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućuje automatsko uključivanje motorne kočnice prilikom kočenja."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, motor će se pokrenuti čim se pritisne gas."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, parkirna kočnica kamiona se primjenjuje prema zadanim postavkama (nakon korištenja trajekta, vuče na servis, brzog putovanja itd.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Automatski postavlja podizne osovine kada je to potrebno ovisno o težini vozila."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, vozilo će prema zadanim postavkama držati niži gas. Nakon što dva puta brzo pritisnete gumb gasa, vozilo će držati puni gas dok se gumb gasa ne otpusti.<br><br>Utječe samo na unos s tipkovnice."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulates real life air loss from excessive brake applications.<br><br>When enabled, you will have to manage your air pressures when descending hills or making slow manoeuvres with multiple brake applications."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućen, ABS će spriječiti blokiranje kotača kako bi održao kontrolu i poboljšao sposobnost kočenja."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, kamion će primijeniti kočenje po kotaču kako bi spriječio proklizavanje kotača, podupravljanje ili preupravljanje kako bi se održala kontrola."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, kamion će zaključati diferencijal ako kotači počnu proklizavati radi poboljšanja vuče."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes the increment of speed at which cruise control will increase or decrease when the appropriate button is pressed."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Mijenja toleranciju tempomata za održavanje ciljane brzine."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, tempomat će automatski prilagoditi brzinu kako bi održao sigurnu udaljenost u odnosu na vozilo ispred."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activates emergency braking if the system senses an imminent collision.<br>Choose if the system will only react to vehicles or all obstacles."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your truck to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućuje funkcije senzora mrtvog kuta, ako je vaš kamion njime opremljen."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno i prednja svjetla su postavljena na prvi položaj, prednja svjetla će se automatski uključiti u situacijama slabog osvjetljenja."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno i duga prednja svjetla su uključena, vozilo će automatski prigušiti duga svjetla kada detektira nadolazeće vozilo ili vozilo u blizini."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, indikatori će se automatski poništiti nakon skretanja kada se upravljač vrati u središte."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, neki dodaci u unutrašnjosti reagiraju na fizičko kretanje vozila (viseći ukrasi, naglavci, itd.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućuje skretanje unutarnje kamere temeljem unosa upravljanja."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
