	key[]: "no_drive_t"
	val[]: "NEMAŠ KAMION" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "Ne možeš se slobodno kretati svijetom jer nemaš kamion! Možeš kupiti novi ili kamion ili ga uzeti iz neke od svojih garaža.<br><br>Želiš li uzeti brzi posao?"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "UČITAJ IGRU"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Učitaj igru" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Učitaj prethodno spremljenu igru. Trenutni napredak bit će izgubljen!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Želiš li učitati drugu igru?<br><br>Tvoj trenutni napredak bit će izgubljen ako prethodno nije snimljen."

	key[]: "load_progress_lost_mp"
	val[]: "Jeste li sigurni da želite učitati drugu igru?<br>Ako to učinite u igri za više igrača, to može rezultirati otkazivanjem ili obustavom posla, teleportacijom do najbližeg servisa ili nedostupnošću odabranog posla.<br><br>Vaš trenutni napredak bit će izgubljen osim ako nije ranije spremljen."

	key[]: "load_game_mp_suspended_job"
	val[]: "Snimka je uspješno učitana, ali je vaš aktivni posao u World of Trucks obustavljen i nije dostupan dok ste u ovoj sesiji."

	key[]: "autosave"
	val[]: "- Automatska snimka -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Brza snimka -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Prikaži automatske snimke" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Nisu pronađene ručno napravljene snimke." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Učitaj" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Nekompatibilna snimka!<br><color value=@@clr_txt@@>Pokušajte nadograditi igru na najnoviju dostupnu verziju." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nije uspjelo učitavanje i prikaz svih spremljenih datoteka za ovaj profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "UPOZORENJE" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problem prilikom učitavanja snimke igre.<color value=@@clr_txt@@><br><br>Snimka igre nije mogla biti učitana. Možeš pokušati identificirati i možda otkloniti problem koristeći niže navedene informacije. Ili možeš pokušati učitati neku drugu snimku igre.<br><br>Razlozi koji često uzrokuju ovaj problem su sljedeći:<br><br>1. Snimka igre je nekompatibilna s nekom od trenutno instaliranih datoteka izmjena igre.<br><br>2. Snimka igre sadrži informacije vezane za datoteke izmjena koje nedostaju ili su isključene.<br><br>3. Snimka igre je oštećena korištenjem loše napravljenih datoteka izmjena.<br><br>4. Rušenje računala tijekom ili odmah nakon završetka procesa spremanja igre može oštetiti snimku igre."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Detektirane su nedostajuće datoteke izmjena.<color value=@@clr_txt@@><br><br>Zadnja snimka igre ovisi o nedostajućim ili isključenim datotekama izmjena igre.<br><br>Ako ovo nije očekivano, molimo provjeri status datoteka izmjena.<br><br>U protivnom, bez obzira na ovo, možeš pokušati učitati ovu snimku igre. Ipak, ovisno o svrsi tih nedostajućih datoteka izmjena, moguće je da se igra neće moći učitati ili da će uzrokovati neke druge probleme.<br><br>Ili možeš pokušati učitati drugu snimku igre koja ne ovisi o nedostajućim datotekama izmjena."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Detektiran je nedostajući opcionalni DLC.<color value=@@clr_txt@@><br><br>Zadnja snimka igre ovisi o nedostajućem DLC-u (službenoj nadogradnji igre).<br><br>Ako ovo nije očekivano, molimo provjeri status DLC-a.<br><br>U protivnom možeš pokušati učitati snimku, no neke od funkcionalnosti koje su dio DLC-a mogle bi biti izgubljene.<br><br>Ili možeš pokušati učitati drugu snimku igre koja ne ovisi o nedostajućem DLC-u."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Detektiran je nedostajući DLC.<color value=@@clr_txt@@><br><br>Zadnja snimka igre ovisi o nedostajućem DLC-u (službenoj nadogradnji igre).<br><br>Kako bi ova snimka igre funkcionirala ispravno, taj DLC mora biti prisutan i aktiviran na ovom računalu.<br><br>Ili možeš pokušati učitati drugu snimku igre koja ne ovisi o nedostajućem DLC-u."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Datoteka izmjena ovisi o DLC sadržaju.<color value=@@clr_txt@@><br><br>Barem jedna datoteka izmjena ovisi o DLC-u (službenoj nadogradnji igre) koji trenutno nije instaliran.<br><br>Moraš onemogućiti datoteke izmjena ili instalirati DLC-ove o kojima one ovise."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Detektirano je rušenje igre<color value=@@clr_txt@@><br><br>Čini se da se igra srušila prilikom prethodnog učitavanja.<br><br>Možete pokušati identificirati i možda otkloniti problem koristeći se niže navedenim informacijama. Možete pokušati i učitati neku drugu snimku igre.<br><br>Razlozi koji često uzrokuju ovaj problem su sljedeći:<br><br>1. Jedan mod ili više njih nije ispravno ili kompatibilno s trenutačnom inačicom igre.<br><br>2. Snimka igre sadrži informacije vezane za modove koje nedostaju ili su isključeni.<br><br>3. Snimka igre je oštećena upotrebom loše napravljenih modova.<br><br>4. U nekim slučajevima neispravnost hardvera ili pogonskih programa mogu uzrokovati rušenje igre."

	key[]: "mods_detected_warning"
	val[]: "Otkrivena prisutnost dodataka igri. Imajte na umu da slomljeni zastarjeli ili nekompatibilni dodatci mogu biti izvor nestabilnosti. Pregledajte svoje aktivne dodatke u Upravitelju modova." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

