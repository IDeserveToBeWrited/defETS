	val[]: "Grafika" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Prilagodite grafičke postavke koristeći unaprijed postavljene postavke kako biste prilagodili vizualnu izvedbu svoje igre svojim željama."

	key[]: "apply"
	val[]: "Primijeni" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Tema radne površine" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ZASLON" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "KVALITETA SLIKE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEKSTURE" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKSIJE" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SJENE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "RASVJETA" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "NAKNADNA OBRADA" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "OKOLIŠ" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Prikaz punog zaslona" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Svjetlina / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Setup" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Razlučivost" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Frekvencija osvježavanja" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS ograničenje" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS ograničenje u pozadini" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Osnovno osvježavanje" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikalno usklađivanje" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomično (štedi energiju na prijen. rač.)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "JEDNOSTAVNE GRAFIČKE POSTAVKE" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "PRIMIJENJENE SU PRILAGOĐENE POSTAVKE" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "NAPREDNE GRAFIČKE POSTAVKE" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Jednostavne/napredne grafičke postavke" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Sakrij napredne postavke" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Prikaži napredne postavke" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skaliranje" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Zaglađivanje rubova" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA izoštravanje svjetla" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA tuning" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Prilagodljiva jasnoća" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Uvijek mekano" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Uvijek oštro" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Okluzija ambijentalnog prostora zaslona (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Visoki dinamički raspon prikaza (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Dubina polja (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Sunčeve zrake" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Podešavanje boja" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Podešavanje odsjaja" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detalji odsjaja" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detalji vegetacije" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Gustoća trave" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Kvaliteta sjene"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Veličina tekstura sjene" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Udaljene sjene" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Unutarnje sjene" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Kvaliteta vremena"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Kvaliteta retrovizora" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Razlučivost retrovizora" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Udaljenost pogleda retrovizora" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Kvaliteta tekstura" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropno filtiranje" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normalne karte" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Svjetla prometa" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Pomoćna svjetla vozila" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Raspon vidljivosti svjetala" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Pješaci" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Postavke prikaza su izmijenjene.<br>Želiš li zadržati te postavke?"

	key[]: "reverting_in"
	val[]: "Vraćanje za" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekundi" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Kada je omogućeno, igra će biti prikazana na cijelom ekranu."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Adjust the overall brightness of the game to suit your display. On HDR-compatible displays, the HDR calibration option will also be available in this setting."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Mijenjanje rezolucije igre."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Mijenja ciljnu brzinu osvježavanja igre."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Matches the framerate with the monitor's refresh rate to prevent screen tearing. Economic setting also halves the framerate, resulting in a lower power consumption."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Sets the maximum allowed frame rate for the game.<br><br>Setting the value to 0 will disable the function."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Sets the maximum allowed frame rate for the game when it is minimized in the background.<br><br>Setting the value to 0 will disable the function."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Promjene između jednostavnih grafičkih postavki (presets) ili naprednih grafičkih postavki (mogućnost promjene pojedinačnih parametara)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Improves graphical fidelity by rendering the game at a higher resolution internally, which reduces jagged edges and enhances detail.<br>For example, selecting a higher scaling option results in a clearer picture with less blurriness, making the game look better overall at the expense of performance.<br><br><color value=@@clr_txt_d@@>This setting often has a large impact on performance."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Selection of high-speed antialiasing methods that smooth the appearance of jagged edges in the game:<br>- SMAA samples each pixel multiple times (depending on the selected quality) at different locations within the frame and averages the samples to produce the final picture.<br>- TAA samples each pixel only once per frame, but it samples them at different locations and different frames.<br>- For the best result you can also select a combination of both at the expense of performance.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Adds soft shadows to crevices and objects that are in close proximity to one other, improving perceived graphical fidelity of the whole in-game world.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Odabir TAA unaprijed postavljenih postavki:<br>- \"Uvijek mekano\" rezultirat će s manje treperenja/više zamućenja - prikladno je za korisnike osobnih računala koji omogućuju supersampling ili imaju monitor s visokim DPI-jem, ali i korisnike 1080p TV-a koji sjede dalje od svog zaslona.<br>- \"Uvijek oštro\" rezultira s više treperenja/manje zamućenja - to je vjerojatno najbolja opcija za upotrebu ispod 1080p, kao što su prijenosna računala ili Steam Deck.<br>- \"Prilagodljiva jasnoća\" dinamički onemogućuje podrhtavanje TAA kada je kamera statična.<br><br><color value=@@clr_txt_d@@>Ova se postavka može koristiti samo kada je TAA odabran kao rješenje za uklanjanje aliasinga."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the strength of TAA's luma sharpening.<br><br><color value=@@clr_txt_d@@>This setting can only be used when TAA is selected as an anti-aliasing solution."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Kada je omogućeno, udaljena područja na karti mogu biti umjetno zamućena kako bi se stvorio realističan pad fokusa u pozadini."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Kada je omogućeno, zrake svjetlosti mogu biti vidljive kada gledate u sunce ili gledate u sunce kroz predmete poput drveća, zgrada ili vozila."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Kada je omogućeno, boje igre se dinamički prilagođavaju iz estetskih razloga. Scene će bolje odgovarati dobu dana i vremenskim uvjetima, boje vozila i drugih objekata mogu biti življe itd."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Improves reflections by rendering them at a higher quality internally, as well as using better antialiasing.<br><br><color value=@@clr_txt_d@@>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the detail of reflections seen on vehicle surfaces, windows and other reflective surfaces such as puddles, wet roads and open bodies of water.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance.<br><br>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the detail and complexity of plants and trees.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the density of grass seen on the sides of the road.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of shadows cast by the sun or moon.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables shadows to be rendered even from very far objects.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the truck interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of weather effects, such as reflections."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the quality of reflections seen in vehicle mirrors (independent of reflection settings).<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava razlučivost slike prikazane na retrovizorima vašeg vozila."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava udaljenost na kojoj se objekti počinju iscrtavati u zrcalu.<br><br><color value=@@clr_txt_d@@>Ova postavka često ima veliki utjecaj na performanse."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava kvalitetu nekih tekstura primijenjenih na objekte i površine u igri."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Poboljšava oštrinu tekstura, posebno onih gledanih iz daljine ili pod kosim kutom.<br><br><color value=@@clr_txt_d@@>Promjene ove postavke stupit će na snagu tek nakon ručnog ponovnog pokretanja igre."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Adds the appearance of geometric detail to pavements, roads and other objects to improve their appearance.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance.<br><br>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućuje osvjetljenje farovima drugih vozila u prometu."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućuje osvjetljenje od sekundarnih svjetala drugih vozila u prometu kao što su pokazivači smjera, kočnice itd."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava udaljenost s koje se mogu vidjeti umjetni izvori svjetlosti.<br><br><color value=@@clr_txt_d@@>Ova postavka obično ima umjerni utjecaj na performanse."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućuje pješake u igri."
#@}

