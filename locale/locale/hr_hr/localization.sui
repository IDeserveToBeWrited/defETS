	key[]: "online_job_t"
	val[]: "VANJSKI UGOVORI" #+ Title of WOTR jobs window

	key[]: "job_online"
	val[]: "Vanjski ugovori" #+ name of WOTR Jobs icon on desktop

	key[]: "online_job_desc"
	val[]: "Završite World of Trucks ugovore pomoću vlastite opreme. Zapis tih isporuka pohranjuje se na vaš profil u World of Trucks." #+ description of the WOTR Jobs icon on desktop

	key[]: "external_market"
	val[]: "Vanjsko tržište"

	key[]: "external_market_desc"
	val[]: "Završite World of Trucks ugovore o isporuci pomoću vlastite prikolice. Zapisnik tih isporuka pohranjuje se na vaš profil u World of Trucks."

	key[]: "external_market_t"
	val[]: "VANJSKO TRIŽIŠTE"

	key[]: "game_time"
	val[]: "Vrijeme igre" #+ Time inside the game world

	key[]: "no_online_job_message"
	val[]: "Trenutno na World of Trucks nemate ugovora." #+ Message shown when player does't have any online job taken

	key[]: "refresh_jobs"
	val[]: "Osvježi" #+ Connects with server and fetches WOTR job into the game

	key[]: "get_new_job"
	val[]: "Pretraži ugovore" #+ Opens browser on WOTR page to search for a job

	key[]: "get_random_job"
	val[]: "Potpiši nasumični ugovor" #+ Connects with server and accept random job in proximity of player's current position

	key[]: "synchronizing_wotr_t"
	val[]: "USKLAĐIVANJE" #+ Name of the window pop-up during WOTR synchronization

	key[]: "synchronizing_wotr"
	val[]: "Usklađivanje vašeg napretka sa<br>World of Trucks." #+ Message inside window pop-up during WOTR synchronization

	key[]: "confirm_random_job"
	val[]: "World of Trucks automatski će odabrati ugovor o isporuci koji je dostupan oko vašeg trenutnog položaja.<br><br>Nikad ne znate kamo će vas odvesti sudbina!<br><br>Nastaviti?" #+ pop-up message to accept taking random job from WOTR

	key[]: "online_job_not_started"
	val[]: "Novi World of Trucks ugovor je u tijeku." #+ Icons with this text appears on the desktop when online job is taken from web yet not started

	key[]: "connect"
	val[]: "Povezivanje" #+ Button to connect to WOTR service

	key[]: "begin_job"
	val[]: "Započni isporuku" #+ Button to begin WOTR job with

	key[]: "abort_job"
	val[]: "Napusti" #+ Button to cancel WOTR job with

	key[]: "cancel_online_job"
	val[]: "Želite li zaista napustiti trenutni ugovor?" #+ A pop-up warning notification on attempt to Cancel WOTR job

	key[]: "online_job_resumed"
	val[]: "World of Trucks posao je u tijeku." #+ Icons with this text appears on the desktop when online job in progress

	key[]: "suspend_job"
	val[]: "Obustaviti isporuka" #+ Button to suspend / pause WOTR job

	key[]: "resume_job"
	val[]: "Nastaviti isporuku" #+ Button to resume WOTR job

	key[]: "online_job_suspended"
	val[]: "World of Trucks posao je obustavljen." #+ Icons with this text appears on the desktop when online job in suspended / paused

	key[]: "economy_sync_failed"
	val[]: "Veza s World of Trucks izgubljena.<br>Ne možete spremiti svoj napredak." #+ Advisor message when game unable establish server connection to save the progress

	key[]: "suspend_online_job"
	val[]: "Posao u World of Trucks koji je u tijeku mora biti obustavljen kako bi mogli prihvatiti drugi posao.<br><br>Možete nastaviti s dovršavanjem ugovora za World of Trucks nakon što završite drugi posao.<br><br>Započnite sad drugi posao?" #+ Warning message to inform that player about to suspend online job in order to take offline one.

	key[]: "connection_error_message"
	val[]: "Ne može se povezati sa World of Trucks. <br><br>Uspostavite vezu, a zatim pritisnite Spoji za preuzimanje podataka o ugovoru." #+ Message shows instead of the cargo in WOTR jobs screen if no internet connection found.

	key[]: "error_resuming_online_job"
	val[]: "Ne može se povezati sa World of Trucks.<br><br>Uspostavite vezu, a zatim pritisnite Spoji da biste dobili podatke o ugovoru kako biste nastavili svoj napredak." #+ Message shows instead of the cargo in WOTR jobs screen if no internet connection found after attempt to resume job.

	key[]: "error_aborting_online_job"
	val[]: "Ne može se povezati sa World of Trucks.<br><br>Uspostavite vezu, a zatim pritisnite Spoji za preuzimanje informacija o ugovoru kako biste nastavili sa otkazivanjem ugovora." #+ Message shows instead of the cargo in WOTR jobs screen if no internet connection found after attempt to cancel the job.

	key[]: "wotr_not_connected"
	val[]: "Veza sa World of Trucks je izgubljena." #+ Icons with this text appears on the desktop when online job lost its connection with WOTR

	key[]: "sync_invalid_position_t"
	val[]: "NEUSKLAĐENO" #+ pop-up title of the pop-up informing about mismatch player position to server position

	key[]: "sync_invalid_position"
	val[]: "Ne može se uskladiti vaš trenutni položaj sa World of Trucks.<br><br>Obnavljanje posljednjeg poznatog položaja..." #+ message inside the pop-up informing about mismatch player position to server position

	key[]: "sync_invalid_position_suspend"
	val[]: "Nije moguće sinkronizirati vašu trenutnu poziciju sa World of Trucks.<br><br>Obustavljanje online posla..." #+ message inside the pop-up informing about mismatch player position to server position which will result in suspension of the job

	key[]: "sync_restoring_position"
	val[]: "Vraćanje zadnje poznate pozicije World of Trucks..." #+ message during restoring player's position

	key[]: "confirm_get_job_page"
	val[]: "Želite li otvoriti internetski preglednik i otići na stranicu World of Trucks poslova?" #+ pop-up message to inform about opening WOTR jobs page in web browser

	key[]: "offline_profile_message"
	val[]: "Profil nije povezan sa World of Trucks! <br><br> Da biste mogli primati ugovore, uredite svoj profil kako biste ga povezali sa World of Trucks."#+ A message on WOTR job screen if profile isn't connected to WOTR

	key[]: "edit_profile"
	val[]: "Uredi profil" #+ Button in WOTR jobs screens to begin editing profile if WOTR isn't conneted

	key[]: "online_jobs_completed_count"
	val[]: "World of Trucks završenih ugovora" #+ number of completed WOTR jobs

	key[]: "error_report_progress_t"
	val[]: "NEVAŽEĆI UGOVOR"

	key[]: "error_report_progress_online_job"
	val[]: "World of Trucks ugovor, na kojem trenutno radite, više nije važeći."

	key[]: "sync_suspending_job"
	val[]: "Obustava mrežnog posla"

	key[]: "error_resuming_online_job_invalid_position"
	val[]: "Vaš preinačeni kamion ili prikolica su predugi da bi ga sigurno postavili na početno mjesto za posao World of Trucks. Molimo koristite drugi kamion ili prikolicu. Zatim nastavite s ugovorom."

	key[]: "online_job_unable_to_resume_wotr_desync"
	val[]: "Ne možete nastaviti svoj World of Trucks posao."

	key[]: "online_job_unable_to_resume_in_mp"
	val[]: "Vaš obustavljeni posao u World of Trucksu nije dostupan dok ste u ovoj sesiji.<br><br>Posao je obustavljen u blizini tvrtke koja je trenutačno u drugom stanju nego kada je posao obustavljen, teret se nalazi u neaktivnoj tvrtki ili ciljna tvrtka je neaktivna u ovoj sesiji."

	key[]: "job_detail_t"
	val[]: "TRENUTNI POSAO" #+ name of job detail screen

	key[]: "no_online_jobs_message"
	val[]: "Nisu pronađeni ugovori oko vašeg trenutnog položaja.<br><br>Približite se gradu ili logističkoj tvrtki i pokušajte ponovno." #+ message shown when there are no online jobs around player's position

	key[]: "no_company_online_jobs_message"
	val[]: "U ovoj tvrtki nisu pronađeni ugovori." #+ message shown when there are no online jobs at company activation point

	key[]: "show_nearest_online_jobs"
	val[]: "Prikaži najbližu" #+ Button to show online jobs in radius instead of jobs at company activation point

	key[]: "error_taking_online_job"
	val[]: "Nije moguće potpisati ugovor." #+ message shown when taking of online job fails

	key[]: "error_fetching_online_jobs"
	val[]: "Nije moguće preuzeti popis ugovora s poslužitelja." #+ message shown when listing of online jobs fails

	key[]: "error_taking_online_job_expired"
	val[]: "Ovaj je ugovor već istekao. Molimo odaberite drugi." #+  message shown when taking online job that is already expired - it happens when job list screen is opened for a long time

	key[]: "error_job_missing_dlc"
	val[]: "Trenutni vanjski ugovor zahtijeva sljedeće DLC-ove:<br><br>" #+ messages shown when resuming online job that requires some unmounted DLCs, it is followed by new line separated names of DLCs

	key[]: "error_unknown_trailer"
	val[]: "Nije moguće pregledati detalje posla. Oni će biti prikazani nakon što nastavite trenutni ugovor." #+ Message is shown if an error occured during server synchronization.

	key[]: "error_no_own_trailer_attached"
	val[]: "Za posao je potrebna vlastita prikolica. Međutim, trenutno nemate spojenu takvu prikolicu." #+ Message shown when player tries to continue external market job however they have no compatible trailer attached.

	key[]: "error_no_compatible_trailer_owned"
	val[]: "Nemate nikakvu prikolicu koja je kompatibilna s tim poslom." #+ Message shown if player does not own any trailer that would be compatible with the job but there is at least one available in trailer dealer.

	key[]: "required_trailer_external_header"
	val[]: "Potrebni parametri prikolice:" #+ Header of the section describing what trailer is needed to finish the job.

	key[]: "error_no_compatible_trailer_available"
	val[]: "Ne postoji kompatibilna prikolica dostupna u igri; moguće je da se to dogodilo zbog uklanjanja MOD-a ili DLC-a. Ponovno instalirajte paket sadržaja ili napustite posao." #+ Message shown if player does not own any trailer that would be compatible with the job and there is no compatible trailer available in game, probably due to removal od MOD or DLC.

	key[]: "error_incompatible_trailer_in_use"
	val[]: "Trenutačno priključena prikolica nije kompatibilna s poslom." #+ Message shown if player tries to resume external market job however currently attached trailer is not compatible with the job.

	key[]: "error_you_own_compatible_trailers"
	val[]: "U vašim garažama postoje prikolice kompatibilne s poslom." #+ Message shown if player owns at least one trailer compatible with the current external market.

	key[]: "browse_compatible_trailers"
	val[]: "Pregledajte kompatibilne prikolice" #+ Button opening compatible trailers browser where user can select trailer to continue delivering external market job from his own trailers.

	key[]: "open_trailer_dealer"
	val[]: "Otvorite kupnju prikolice" #+ Button opening trailer dealer external market job.

	key[]: "trailer_selector_t"
	val[]: "IZBOR PRIKOLICE"

	key[]: "trailer_brand"
	val[]: "Marka"

	key[]: "expired"
	val[]: "Isteklo" #+ Text shown on job offer instead of the time till expiration if job is expired.
