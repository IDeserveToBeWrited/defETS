#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Slika ekrana je prevelika. Molim pokušaj smanjiti razlučivost ekrana." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

