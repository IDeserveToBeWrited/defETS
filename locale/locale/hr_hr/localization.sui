#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Nastavak ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Dobrodošli u Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Napokon imaš priliku iskusiti posao svog života - vožnju kamiona!"

	key[]: "intro_3"
	val[]: "Tvoja prijevozna tvrtka sada je spremna za poslovanje, no na žalost, nemaš dovoljno novaca za kupnju kamiona. Za sada ćeš morati raditi za druge tvrtke, kao unajmljeni vozač."

	key[]: "intro_4"
	val[]: "Tvoj zadatak je da sigurno isporučiš teret $JOB_CARGO$ do $JOB_TARGET_COMPANY$ doka u $JOB_TARGET_CITY$. Tvoj poslodavac te je opskrbio vozilom i pokrit će sve troškove. Nikoga nemoj iznevjeriti i stigni na vrijeme."


	key[]: "intro_garage_1"
	val[]: "Ovo je tvoje sjedište."

	key[]: "intro_garage_2"
	val[]: "Ovo je osnovna garaža. Možda nije mnogo, no i to je neki početak."

	key[]: "intro_garage_3"
	val[]: "Na žalost, ovdje za sada nemaš što parkirati pa nema kamiona na vidiku."

	key[]: "intro_garage_4"
	val[]: "Jednom kad zaradiš dovoljno novaca i kupiš kamion, moći ćeš se slobodno kretati svijetom i odatle voditi vlastiti posao."

	key[]: "intro_garage_5"
	val[]: "Sretno!"


	key[]: "desktop_tut_t"
	val[]: "ZNAČAJKA OTKLJUČANA"

	key[]: "desktop_tut_job"
	val[]: "Odaberi sljedeći posao"

	key[]: "desktop_tut_cargo_market"
	val[]: "Upotrijebite svoju potpuno novu prikolicu za pristup Tržištu tereta za isporuku širokog asortimana tereta do njihovih odredišta." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Ovdje možeš vidjeti svoj napredak."

	key[]: "desktop_tut_company"
	val[]: "Prati svoje garaže, unajmi nove vozače i na druge načine odavde vodi svoju tvrtku."

	key[]: "desktop_tut_trailers"
	val[]: "Od sada možete kupiti vlastite prikolice, nadograditi ih ili lakirati kako bi odgovarali vašem kamionu.<br><br>Vaše prikolice mogu se skladištiti u odabranim garažama; mogu ih koristiti vaši vozači za povećanje zarade. Da biste upravljali svojim prikolicama, koristite Upravitelja prikolica."

	key[]: "desktop_tut_visit_directive"
	val[]: "Posjetite $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "DOBRODOŠLI"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Dobrodošli na novi početni zaslon<br>Odavde možete podešavati sve funkcije unutar igre."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Glavni izbornik u nastavku pruža izravan pristup svim osnovnim funkcijama igre s kojima ste upoznati."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Na vrhu, nova statusna traka pruža stalnu vidljivost korisne statistike profila igrača i lokalnih propisa o putovanju."

	key[]: "desktop_tut_tour_home"
	val[]: "Tipka Home uvijek je tu da vas vrati na početni zaslon."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Stalni brzi izbornik pruža praktičan pristup prečacima svim funkcijama igre s bilo kojeg zaslona."

	key[]: "desktop_tut_tour_drive"
	val[]: "Ažurirani gumb Vožnja ostaje vaša veza sa svijetom vožnje, spreman da vas vrati na cestu."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL ZAVRŠEN"

	key[]: "desktop_tut_tour_finish"
	val[]: "Hvala što ste pregledali naše ažuriranje Početnog zaslona."
#@}


	key[]: "show_help"
	val[]: "Uključi/isključi savjete"

	key[]: "weblinks_t"
	val[]: "ZAJEDNICA"

	key[]: "weblinks_but"
	val[]: "Zajednica"

