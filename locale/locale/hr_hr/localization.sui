	val[]: "Želiš li otvoriti Internetski preglednik i otići na odabranu web stranicu?"

#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Mreža nedostupna. Provjeri točnost klijentske konfiguracije."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Ne mogu uspostaviti vezu s mrežnim servisom. Provjeri radi li tvoja Internet veza."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Greška u komunikaciji s mrežnim servisom. Poslije pokušaj opet."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Krivi podaci vraćeni s mrežnog servisa. Ako koristiš HTTP proxy, provjeri njegovu konfiguraciju. Ako ne koristiš HTTP proxy, poslije pokušaj opet."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Krivi podaci vraćeni s mrežnog servisa. Poslije pokušaj opet."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Servis nije kompatibilan s trenutnom verzijom igre. Provjeri postoji li nova zakrpa za igru."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Servis je trenutno nedostupan. Probajte kasnije."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Servis je trenutno ugašen radi održavanja ili je preopterećen. Probajte kasnije."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Informacije o autentikaciji nisu valjane. Probaj se opet prijaviti."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Mrežni račun je trenutno zaključan zbog prevelikog broja neuspjelih pokušaja prijave. Molimo pokušaj ponovno za pola sata."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Mrežni račun trenutno je zaključan zbog sumnjivih pristupa. Molimo pokušaj ponovno za 24 sata."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Igra nije povezana s ovim mrežnim računom."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Račun još nije aktiviran. Molimo provjeri imaš li aktivacijsku poruku u dolaznom sandučiću e-pošte."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Račun je suspendiran. Molimo kontaktiraj tehničku podršku."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Račun je ukinut. Molimo kontaktiraj tehničku podršku."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Ova igra ne podržava proxy autentikaciju. Koristi drugi proxy ili direktnu vezu."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Traženi objekt trenutno nije dostupan. Molimo pokušaj ponovno za nekoliko minuta."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL error. Unable to establish a secure connection."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Unutarnja greška. Datoteka net.log bi mogla sadržavati više informacija."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 je naišao na problem, te ne može iscrtati grafiku na tvojem računalu (nije pronađena valjana grafička kartica).\nPredloženi koraci:\n\n1. Provjeri da li tvoje računalo i grafička kartica ispunjavaju minimalne hardverske zahtjeve.\n2. Nadogradi računalo na zadnju verziju Microsoftovog DirectX-a.\n3. Sa stranice proizvođača preuzmi i instaliraj zadnje drivere za grafičku karticu - tvoji driveri za grafičku karticu vjerojatno su zastarjeli.\n4. Pokušaj promijeniti način iscrtavanja iz OpenGL-a na DirectX ili obratno.\n5. Obriši datoteku 'config.cfg' u kojoj se nalaze postavke igre - datoteka je u tvojim 'Dokumentima', u 'Euro Truck Simulator 2' direktoriju. Datoteka je možda oštećena.\nDatoteka će prilikom sljedećeg pokretanja igre automatski biti ponovno izrađena, uz primjenjivanje valjanih tvorničkih vrijednosti."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 je naišao na problem, te ne može iscrtati grafiku na tvojem računalu (nije pronađena valjana grafička kartica)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "ČAROBNJAK ULAZNIH KONTROLA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Sljedeća"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Završi čarobnjaka"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Preskoči čarobnjaka"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Čarobnjak ulaznih kontrola"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Želiš li prekinuti čarobnjaka ulaznih kontrola?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "ODABERITE METODU UPRAVLJANJA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Kontroler"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Čarobnjak će primijeniti preporučene postavke na temelju povezanih uređaja.<br><color value=@@clr_sel@@>Ako koristite gamepad kompatibilan sa Steamom, razmislite o omogućavanju konfiguracijske podrške u < br><color value=@@clr_txt_d@@> \"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Vozi koristeći tipkovnicu, a razgledavaj okolo pomoću miša. Najjednostavniji ali i najneprecizniji oblik upravljanja dostupan svakome."

	key[]: "wiz_control_mouse"
	val[]: "Za precizno skretanje koristi miša. Ostale operacije i dalje se vrše pomoću tipkovnice. Miša možeš koristiti i za razgledavanje, no samo ako istovremeno držiš i posebnu tipku ili gumb za kontrolu kamere."

	key[]: "wiz_control_controller"
	val[]: "Koristi volan, gamepad ili igraću palicu za najrealističniji doživljaj igranja. Tipkovnicu i dalje možeš koristiti za pristup mnogim akcijama, a možeš i slobodno razgledavati pomoću miša ('mouselook')."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nijedan kontroler za igru nije pronađen. Za omogućavanje ove opcije morate priključiti neki kontroler!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Detektiram dostupne kontrolere..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECT CONTROLLER API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam unos - Način mapiranja u igri (preporučeno)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam unos - Način mapiranja putem Steam klijenta"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klasični kontorler"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepadovi kao što su @@controller_ps5@@, @@controller_xbox_one@@ ili @@controller_steam_deck@@ uključeni su u Steam Input sučelje i koriste jednostavan raspored.<br><br>Podržava potpune konfiguracije povezivanja tipki u igri."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepadovi su se uključili u sučelje Steam unosa i koriste samostalne postavke konfigurirane putem Steam klijenta.<br><br>Ograničena podrška za savjete o tipkama u igri i nema konfiguracija povezivanja u igri."

	key[]: "wiz_api_classical"
	val[]: "Kontroler, volan ili upravljačka palica pomoću DirectInput-a, XInput-a ili sličnog sučelja."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "ODABERITE TIP KOTROLERA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volan"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad ili igraća palica"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Kontroler je volan i ponaša se kao i pravi. Pozicija kontrolera izravno određuje poziciju volana u igri."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Kontroler je gamepad ili igraća palica. Pozicija kontrolera određuje brzinu vrtnje volana tijekom igre. "
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "ODABERITE TIP MJENJAČA" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Najjednostavniji način vožnje namijenjen posebno (no ne i samo) za upravljanje tipkovnicom. Pritisnite NAPRIJED za vožnju unaprijed, a NATRAG za kočenje ili vožnju unatrag. Mjenjač će za vas obaviti sve drugo: prebacivanje između vožnje unaprijed, kočenja ili vožnje unatrag, te ubacivanje u pravu brzinu itd."

	key[]: "wiz_gb_automatic"
	val[]: "Savršeno za volan s pedalama. Koristite tipke za prebacivanje između vožnje unaprijed, neutralne pozicije ili vožnje unatrag. Zatim pritisnite pedalu gasa i prebacivanje brzina prepustite automatu."

	key[]: "wiz_gb_sequential"
	val[]: "Ručno prebacuj brzine naviše i naniže za odabir između vožnje unaprijed, lera i rikverca. To je malo teže za savladati, no možeš postići bolje performanse vožnje i imati potpunu kontrolu nad vozilom u raznim situacijama."

	key[]: "wiz_gb_hshifter"
	val[]: "Izravno ubaci u željenu brzinu. Po kompleksnosti slično sekvencijalnom mjenjaču, no realističnije. Preporučljivi su fizički H-mjenjači kakve posjeduju G27 ili G25. Zahtijeva kvačilo. "
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ova opcija zahtijeva volan, gamepad ili igraću palicu."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nije pronađen kontroler sa H-mjenjačem; ova opcija možda se neće moći koristiti."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "ODABERITE RASPORED H-MJENJAČA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "'Raspon' vrsta mjenjača je najjednostavniji izbor. Ima dva seta brzina. Prvi set sadrži brzine od 1. do 6., a drugi set brzine od 7. do 12.. Gumb preklopnika prebacuje između ta dva seta brzina dok mjenjač odabire pojedinu brzinu iz seta."

	key[]: "wiz_hs_splitter"
	val[]: "'Podjela' vrsta mjenjača je jednostavna alternativa. Također ima dva seta brzina. Prvi set sadrži neparne brzine (1., 3., 5...), a drugi set sadrži parne brzine (2., 4., 6...). Gumb preklopnika prebacuje između ta dva seta brzina dok mjenjač odabire pojedinu brzinu iz seta."

	key[]: "wiz_hs_range_splitter"
	val[]: "Prijenos s razdjelnikom dometa temelji se na izgledu pravih ručnih razdjelnika dometa. Zupčanici su grupirani po četiri po svakom položaju H-mjenjača i koriste dva prekidača. Stoga se preporučuje samo za napredne vozače."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Igra je sada konfigurirana pomoću zadanih postavki opisanih u nastavku. Možete ih podesiti pomoću naprednih postavki ili možete nastaviti izravno u igru."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Napredno podešavanje"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Igra je sada iskonfigurirana pa možeš nastaviti. Konfiguraciju možeš promijeniti kasnije, na ekranu Kontrolera u Opcijama."

	key[]: "wiz_cfg_steam"
	val[]: "Možete provjeriti i konfigurirati mapiranje tipki i osi za ovaj kontroler pomoću Steam klijenta. Postavke Steam gamepada za igru dostupne su u Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Otvorite postavke kontolera"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Za skretanje koristi @@imm_wiz_dsteerleft@@ i @@imm_wiz_dsteerright@@."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Pomakni miša lijevo ili desno za pomicanje volana u odgovarajućem smjeru."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Za skretanje koristi @@ima_wiz_j_steer@@."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Za vožnju unaprijed koristi @@imm_wiz_dforward@@, a za vožnju unatrag @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Pomakni @@ima_wiz_j_throttle@@ kontrolu naprijed za vožnju unaprijed, te natrag za vožnju unatrag."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Za vožnju unaprijed koristi @@ima_wiz_j_throttle@@, a za vožnju unatrag @@ima_wiz_j_brake@@."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Za ubrzavanje koristi @@imm_wiz_dforward@@, a za kočenje @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Pomakni @@ima_wiz_j_throttle@@ kontrolu naprijed za ubrzavanje, te natrag za kočenje."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Za ubrzavanje koristi @@ima_wiz_j_throttle@@, a za kočenje @@ima_wiz_j_brake@@."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Za kretanje naprijed koristi @@imv_wiz_gearup@@, a @@imv_wiz_geardown@@ za kretanje unatrag."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Za kretanje naprijed koristi @@imv_wiz_gearup@@, a @@imv_wiz_geardown@@ za kretanje unatrag ako koristiš tipkovnicu ili gumbe na kontroleru. Ako koristiš H-mjenjač, za odabiranje smjera kretanja koristi @@imv_wiz_drive@@ i @@imv_wiz_reverse@@."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Za mijenjanje brzina koristi @@imv_wiz_gearup@@ i @@imv_wiz_geardown@@."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Za promjenu brzina koristi svoj H-mjenjač u kombinaciji s @@ima_wiz_j_clutch@@."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "POSTAVLJANJE OSI KONTROLERA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Vizualizacija osi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Možete isprobati funkciju svih odabranih osi vizualno. Upotrijebite upravljač i promatrajte trake koje se kreću. Reći će vam granice, centriranje, orijentaciju i ukupno ponašanje svake korištene osi."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Postavke osi"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Za odabir osi kliknite na gumb pored naziva osi. Ovo će vas prebaciti u način unosa. Zatim upotrijebite upravljač za vezanje odabrane osi pomicanjem palice, kotačića ili pedale na odabranu os."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Mrtve zone"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Mrtva zona odnosi se na područje osi koje je namjerno dizajnirano da ne pruža nikakav unos. Za podešavanje mrtve zone odabrane osi, pomaknite odgovarajući klizač. Povećanjem klizača udesno povećat ćete mrtvu zonu. Ova značajka je posebno korisna za starije kontrolere, jer definiranje veće mrtve zone može ublažiti probleme kao što su netočnost ili lažni unos uzrokovan istrošenošću hardvera."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Načini osi"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Način osi određuje kako se njime rukuje u igri. Invertirana os okreće svoj prijavljeni smjer, što rezultira upravljanjem lijevo umjesto, na primjer, desno. Centrirana os ima svoj zadani položaj u sredini svog raspona, kao što je igraća palica. Ovaj način je koristan za ispravljanje osi koja je pogrešno detektirana."

	key[]: "normal"
	val[]: "Normalno" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Invertirano" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrirano" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Invertirano i centrirano" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "POSTAVKA AUTOMATSKOG MJENJAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "U režimu automatskog mjenjača morate prebacivati samo između vožnje unaprijed, neutralnog položaja i vožnje unatrag. To možete postići korištenjem sljedećih tipaka i gumba kontrolera. Za promjenu postavki kliknite na gumb i pritisnite tipku ili gumb kontrolera kojeg želite koristiti za odabranu akciju."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ako imaš priključen kontroler sa H-mjenjačem možeš ga koristiti za simuliranje pravih automatskih mjenjača brzina. Omogući ovu opciju pa ćeš pozicije H-mjenjača moći dodijeliti načinima vožnje unaprijed i unatrag. Sve druge pozicije H-mjenjača računaju se kao ler. Ova postavka je napravljena posebno za kontrolere sa H-mjenjačem i neće raditi s običnim tipkama ili s gumbima kontrolera. Za promjenu dodijeljene kontrole klikni na odgovarajući gumb, pomakni mjenjač u željenu poziciju i na kraju ga vrati natrag u ler."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "POSTAVKA SEKVENCIJALNOG MJENJAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvencijalni mjenjač prebacuje između brzina za vožnju unaprijed, neutralnog položaja i vožnje unatrag. Ovo su tipke i gumbi kontrolera koji se koriste za prebacivanje brzina naviše i naniže, po već spomenutom redoslijedu. Za promjenu dodjeljivanja, kliknite na gumb i pritisnite tipku ili gumb na kontroleru kojeg želite koristiti za odabranu akciju."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "POSTAVKA H-MJENJAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Ovdje možete izabrati glavni raspored H-mjenjača i isprobati njegove funkcije. Na slici možete vidjeti trenutni položaj mjenjača kao i odabranu brzinu. Pošto mjenjač sadrži više brzina nego što H-mjenjač ima pozicija, morate koristiti tipke preklopnika za prebacivanje između različitih setova brzina."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Trenutno odabrana pozicija mjenjača i aktivni preklopnici navedeni su ispod, odmah pokraj dodijeljene kontrole. Za promjenu dodijeljene kontrole klikni na odgovarajući gumb, pomakni mjenjač u željenu poziciju i na kraju ga vrati natrag u ler."
#@}

