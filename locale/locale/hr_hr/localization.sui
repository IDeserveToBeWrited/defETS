#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Nedostaje potrebni DLC (službeno proširenje igre) $DEPENDENCY_NAME$. Kako bi ovo spremanje ispravno funkcioniralo, ovaj DLC mora biti prisutan i aktiviran na ovom računalu. Morate riješiti problem prije nego što možete učitati ovo spremanje." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Nedostaje dodatni DLC (službeno proširenje igre) $DEPENDENCY_NAME$. Ako ovo ne očekujete, provjerite stanje DLC-a.<br><br>U suprotnom biste mogli ipak učitati spremanje, no neke funkcije koje pruža DLC mogle bi biti izgubljene." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "MOD $DEPENDENCY_NAME$ nedostaje ili je onemogućen. Ako to ne očekujete, provjerite stanje MOD-a. Svejedno možete pokušati učitati spremanje. Međutim, ovisno o tome što je MOD napravio, moguće je da se neće uspjeti učitati ili uzrokovati druge probleme." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "MOD $DEPENDENCY_NAME$ nije kompatibilan s vašom verzijom igre. To znači da je autor ovog moda označio mod kao kompatibilan samo s ograničenim verzijama igre, a trenutna verzija igre nije među njima.<br><br>Rješenja:<br>- Pokušajte pronaći ažuriranu verzija MOD-a koja je dizajnirana za rad s trenutnom verzijom igre.<br>- Ažurirajte ili vratite igru na verziju kompatibilnu s modom.<br><br>Možete pokušati učitati spremanje svejedno. Međutim, mod se neće učitati i, ovisno o tome što je MOD napravio, moguće je da učitavanje ne uspije ili izazove druge probleme." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "NEDOSTAJU OVISNOSTI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETALJI" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Otvori stranicu radionice"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Ova snimka ovisi o dodacima ili modovima koji trenutačno nedostaju. Navedeni su ispod. Odabirom elementa s popisa možete dobiti više detalja o svakom elementu." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Ovo spremanje ovisi o najmanje jednom potrebnom DLC-u ili MOD-u. Morate riješiti problem prije nego što možete učitati ovo spremanje." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Prekini ukrcaj" #+ Abort loading button.

	key[]: "type"
	val[]: "Tip" #+ Type column.

	key[]: "dependency_name"
	val[]: "Naziv ovisnosti" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokalni MOD" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop MOD" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Izborni DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Potrebni DLC" #+ DLC that is required to load save that is depending on it.
#@}

