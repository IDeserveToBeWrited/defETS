	val[]: "Spremi & Učitaj" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Otkrivena promjena igre! Kako biste izbjegli probleme s kompatibilnošću spremanja igre zbog promjena u igri, sve nedovršene isporuke su otkazane bez kazne za vas." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Otkrivena promjena igre!<br><br>Kako bismo spriječili probleme s kompatibilnošću spremanja igre, sve nedovršene isporuke su otkazane bez kazne za vas. Potrebno je ponovno parkiranje kamiona na sigurnom mjestu.<br><br>Odaberite brzo putovanje na destinaciju za nastavak." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Spremanje..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Pritisnite $KEY$ za preskakanje scene." #+ Shown when any key was pressed during viewpoint cutscene.

