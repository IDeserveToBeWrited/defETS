
    key[]: "hint_engine_title"
	val[]: "Upalite motor"

    key[]: "hint_engine_text"
	val[]: "Koristite $KEY_engine$ za pokretanje motora."


    key[]: "hint_ignition_title"
	val[]: "Pokrenite paljenje"

    key[]: "hint_ignition_text"
	val[]: "Koristite $KEY_engineelect|KEY_engine$ za pokretanje paljenja."


    key[]: "hint_driv_arc_title"
	val[]: "Vožnja"

    key[]: "hint_driv_arc_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za kretanje naprijed ili natrag.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje."


    key[]: "hint_driv_auto_title"
	val[]: "Vožnja"

    key[]: "hint_driv_auto_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za kretanje naprijed ili natrag.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje.<br><offset vshift=8>Pritisnite $KEY_gearup$ i $KEY_geardown$ za odabir brzine."


    key[]: "hint_driv_seq_title"
	val[]: "Vožnja"

    key[]: "hint_driv_seq_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za kretanje naprijed ili natrag.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje.<br><offset vshift=8>Pritisnite $KEY_gearup$ i $KEY_geardown$ za upravljanje spojkom."


    key[]: "hint_driv_hshift_title"
	val[]: "Vožnja"

    key[]: "hint_driv_hshift_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za kretanje naprijed ili natrag.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje.<br><offset vshift=8>Mijenjajte brzine pomoću <color value=@@clr_sel@@>ručice mjenjača<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Približavanje odredištu"

    key[]: "hint_depot_deliv_text"
    val[]: "Zaustavite se na označenom području kako biste odabrali završnu težinu parkirnog mjesta i zaradili odgovarajuće iskustvo."


    key[]: "hint_fin_deliv_title"
    val[]: "Dovršite isporuku"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkirajte na odabranom parkirnom mjestu. Možete pritisnuti $KEY_activate$ da biste to preskočili kada ste blizu mjesta isporuke."


    key[]: "hint_fin_deliv2_title"
    val[]: "Dovršite isporuku"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkirajte na odabranom parkirnom mjestu. Možete omogućiti widget u @@desktop_menu_category_options@@ kako biste mogli preskočiti parkiranje."


    key[]: "hint_lights_title"
    val[]: "Upalite svjetla"

    key[]: "hint_lights_text"
    val[]: "Koristite $KEY_light$ za aktiviranje svjetala. Prebacujte se između različitih načina rada ponovljenim pritiskom."


    key[]: "hint_high_beam_title"
    val[]: "Aktivirajte duga svjetla"

    key[]: "hint_high_beam_text"
    val[]: "Koristite $KEY_hblight$ za uključivanje dugih svjetala."


    key[]: "hint_wipers_title"
    val[]: "Aktivirajte brisače"

    key[]: "hint_wipers_text"
    val[]: "Koristite $KEY_wipers$ za aktiviranje brisača i cikličko mijenjanje različitih postavki brzine."


    key[]: "hint_zoom_title"
    val[]: "Gledajući bliže"

    key[]: "hint_zoom_text"
    val[]: "Koristite $KEY_camzoom$ za zumiranje dok ste u unutrašnjosti. Način zumiranja možete postaviti na zadržavanje ili prebacivanje u @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Gledanje uokolo"

    key[]: "hint_cam_int_text"
    val[]: "Koristite $KEY_cam1$ za promjenu kamere na unutarnji prikaz."


    key[]: "hint_cam_ext_title"
    val[]: "Gledanje uokolo"

    key[]: "hint_cam_ext_text"
    val[]: "Možete mijenjati različite kutove kamere pritiskom na $KEY_camcycle$.<br><offset vshift=8>Koristite $KEY_cam2$ za prebacivanje kamere na vanjski prikaz."


    key[]: "hint_indicators_title"
    val[]: "Žmigavci"

    key[]: "hint_indicators_text"
    val[]: "Koristite $KEY_lblinker$ i $KEY_rblinker$ za uključivanje žmigavca."


    key[]: "hint_tow_title"
    val[]: "Vučna služba"

    key[]: "hint_tow_text"
    val[]: "Ako se ne možete izvući iz teške situacije, možete koristiti uslugu vuče. Za pristup toj usluzi otvorite izbornik @@quick_info_word@@ pomoću tipke $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Blokada diferencijala"

    key[]: "hint_diff_lock_text"
    val[]: "Ako se ne možete pokrenuti, možda bi vam mogla pomoći blokada diferencijala. Upotrijebite $KEY_diflock$ za aktivaciju ili uključite automatsku blokadu diferencijala u @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Blokada diferencijala uključena"

    key[]: "hint_diff_unlock_text"
    val[]: "Trebali biste otključati diferencijal tijekom redovne vožnje ili riskirate njegovo oštećenje. Koristite $KEY_diflock$ za deaktivaciju ili uključite automatsku blokadu diferencijala u @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Deaktivirajte brisače"

    key[]: "hint_wipers_off_text"
    val[]: "Koristite $KEY_wipers$ za deaktiviranje brisača i cikličko mijenjanje različitih postavki brzine."


    key[]: "hint_world_map_title"
    val[]: "Pogled karte"

    key[]: "hint_world_map_text"
    val[]: "Koristite $KEY_navmap$ za otvaranje karte svijeta."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Koristite $KEY_advmouse$ za otvaranje @@quick_info_word@@ - pregleda vašeg statusa s praktičnim prečacima."


    key[]: "hint_pause_border_title"
    val[]: "Lokalni propisi"

    key[]: "hint_pause_border_text"
    val[]: "Koristite $KEY_advmouse$ za otvaranje @@quick_info_word@@ i pregled trenutnih propisa za regiju koju ste unijeli."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Otvorite @@quick_info_word@@ pomoću $KEY_advmouse$ za ulazak u @@photo_mode_word@@ i snimanje obližnjeg @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ u blizini"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> je u blizini - pronađite ga i aktivirajte za pregled scene."


    key[]: "hint_resting_title"
    val[]: "Resting place nearby"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Filling station nearby"

    key[]: "hint_gas_text"
    val[]: "Filling stations <img src=/material/ui/map/gas_ico.mat width=20 height=20> can be used to refuel your vehicle."
