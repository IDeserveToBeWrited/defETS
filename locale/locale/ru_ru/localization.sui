#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Слишком большой файл скриншота. Попробуйте уменьшить разрешение экрана." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Неподдерживаемый формат файла или повреждённый файл скриншота." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Слишком большое разрешение скриншота. Попробуйте уменьшить разрешение экрана." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Сервис отклонил скриншот." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
