#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор оформления фона игры в меню."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор случайной темы оформления при каждом запуске игры."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор времени, после которого элементы меню скрываются."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Включение накопления усталости по мере хода времени.<br><br>Избегание отдыха будет приводить к штрафам."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Если эта функция включена, вы должны соблюдать правила дорожного движения, иначе рискуете стать нарушителем. Риск повышается вблизи полицейских машин, радаров и дорожных камер."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка средней дальности рейсов, создаваемых игрой."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор ограничения скорости, отображаемого на виджете навигации."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Индикатор скорости на навигаторе становится красным при превышении скорости."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Во время парковки на пункте назначения, на виджете будет предложение пропустить парковку."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Отключение отображения всех виджетов."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Скрывать оба виртуальных зеркала заднего вида."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Отключение отображения уведомлений."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Включает отображение окна с характеристиками грузовика игрока при взятии заказа с тяжёлым грузом."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор способа выравнивания карты мира."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор режима исследования карты:<br>- \"Исследование в радиусе\" отмечает более широкую зону как исследованную.<br>- \"Точечное исследование\" открывает только сегменты в непосредственной близости от игрока."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор режима отображения навигации."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор режима навигации:<br>- \"Оптимальный\" режим навигации выбирает наиболее эффективное соотношение длины и времени маршрута, избегая перекрёстки со светофорами и т. п.<br>- \"Кратчайший\" режим навигации всегда выбирает кратчайший возможный маршрут.<br>- В режиме \"Региональные дороги\" по возможности избегаются автомагистрали."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор сложности парковки.<br>- \"Выбирать всегда\" позволяет выбирать сложность каждый раз в пункте назначения.<br>- \"Лёгкая\" не требует манёвров задним ходом.<br>- \"Нормальная\" обычно требует заезд задним ходом и сложные манёвры."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Настройка вероятности появления опасностей на дороге, например, дорожные работы, ДТП, остановленные машины, мусор и т. п."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Настройка вероятности появления на пути препятствия, требующего объезда по другому маршруту."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Настройка вероятности плохой погоды."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор режима отображения часового пояса в дополнение к текущему времени."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Включение внутриигровых видеовставок, например, после покупки грузовика, модернизации гаража или при посадке пассажиров."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Включение отображения полупрозрачных барьеров, закрывающих недоступные для игрока дороги."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Инверсия движения мыши по вертикали при управлении камерой."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор режима работы КПП:<br>- \"Автоматическая (упрощённая)\" позволяет использовать только газ и тормоз для движения вперёд и назад.<br>- \"Автоматическая\" требует ручного выбора режима движения вперёд и назад.<br>- \"Секвентальная\" требует ручного переключения между всеми передачами вверх и вниз.<br>- \"Ручная\" требует использования специального контроллера для ручного выбора передачи."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение этой функции позволит \"пропускать переключение\" — пропускать передачи, когда это необходимо или практически целесообразно, чтобы избежать переключения каждой передачи поочерёдно."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "При использовании клавиатуры или контроллера, руль возвращается в центральное положение.<br><br>При отключении этой функции после поворота вам придётся вручную возвращать руль в центральное положение."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка диапазона анимации руля."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка интенсивности работы тормозов."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка устойчивости транспортного средства через понижение центра тяжести."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка устойчивости прицепа путем понижения центра тяжести."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка интенсивности эффекта крутящего момента двигателя и трансмиссии.<br><br>Увеличение параметра приведёт к усилению эффекта скручивания рамы вправо."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка жёсткости подвески шасси."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка жёсткости подвески кабины и спальника."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка интенсивности неровностей, кочек и ям, процедурно генерируемых игрой для имитации несовершенства дорожного покрытия.<br><br>Выраженность эффекта зависит от настроек подвески и камеры."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение режима продвинутой симуляции сцепки, требующего точного попадания шкворнем прицепа в седельно-сцепное устройство тягача.<br><br>При отключении, процесс сцепки заметно упрощается, достаточно примерного нахождения седла и шкворня рядом, коллизии между шкворнем и седлом отсутствуют."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор соединительных кабелей к прицепам, которые будут отображаться в игре.<br><br><color value=@@clr_txt_d@@>Включение большего количества может приводить к снижению производительности на слабых устройствах."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Включает электронный ограничитель скорости, в зависимости от модели транспортного средства.<br><br><color value=@@clr_txt_d@@>При выполнении внешних заказов World of Trucks эта функция включена постоянно."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "При включении, при установке переключателя дворников в первое положение, дворники будут автоматически включаться и настраивать скорость в зависимости от количества воды на лобовом стекле."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение автоматической активации ретардера при торможении."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "При включении, транспортное средство будет придерживать тормоза при старте в гору для плавного трогания."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение автоматической активации моторного тормоза при торможении."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение автоматического запуска двигателя при нажатии на педаль газа."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение стояночного тормоза по умолчанию, например, после использования парома, буксировки в сервис, быстрого перемещения и т. п."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение автоматического опускания и поднятия осей в зависимости от загрузки транспортного средства."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "При включении, обычное нажатие на кнопку газа удерживает педаль газа в частично нажатом состоянии. После быстрого нажатия дважды на кнопку газа, педаль газа будет нажата полностью до отпускания кнопки.<br><br>Режим применяется только для ввода с клавиатуры."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение симуляции расхода воздуха из пневматической системы при использовании тормозов.<br><br>При включении требует слежения за давлением воздуха при частых нажатиях на педаль тормоза, например, на спусках или при активном маневрировании."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Если параметр выключен, расход топлива не зависит от стиля вождения или дорожных условий.<br><br>Если включен, на расход топлива влияют несколько факторов, включая стиль вождения, вес груза, сопротивление качению и рельеф местности. На расход также не влияет навык @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение антиблокировочной системы тормозов (ABS), предотвращающей блокировку колёс для сокращения тормозного пути и поддержания управляемости при торможении."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение системы контроля тяги, подтормаживающей отдельные колёса для предотвращения пробуксовки, сноса и заноса и поддержания управляемости."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "При включении, дифференциал будет автоматически блокироваться при пробуксовке для улучшения сцепления с дорогой."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "При нажатии соответствующей кнопки, изменяется шаг увеличения или уменьшения скорости круиз-контроля."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка точности, с которой круиз-контроль поддерживает скорость."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение режима автоматической подстройки круиз-контроля под скорость транспортного средства, следующего впереди, для удержания безопасного интервала движения."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка режима срабатывания системы автоматического экстренного торможения.<br>Позволяет выбрать между активацией перед любыми препятствиями или только другими транспортными средствами."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Выбор режима работы системы предупреждения о сходе с полосы.<br>Режим \"Предупреждение о сходе с полосы\" предупреждает звуковым сигналом при попытке покинуть полосу без включения соответствующего указателя поворота.<br>Режим \"Удержание полосы движения\", помимо сигнала, также автоматически задействует рулевое управление для предотвращения покидания полосы.<br><br>Оба режима доступны на скорости выше 55 км/ч (ок. 35 ми/ч) и учитывают включенные указатели поворота."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение датчиков слепых зон, если транспортное средство оборудовано ими."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Если включено, при установке режима фар в первое положение, фары ближнего света будут автоматически включаться в темноте."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "При включении, фары дальнего света будут автоматически приглушаться при наличии рядом других транспортных средств, движущихся в попутном или встречном направлении."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Если включено, указатели поворота автоматически выключаются при возврате руля в центральное положение."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Включение симуляции физики декоративных аксессуаров в кабине (например, подвесные украшения)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение автоматического поворота камеры из кабины в сторону вращения рулевого колеса."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка скорости поворота камеры вслед за поворотом рулевого колеса."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка поведения камеры, следующей за рулевым колесом, при движении задним ходом."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение автоматического поворота камеры из кабины в направлении включенного указателя поворота."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Включение реакции камеры из кабины на движения транспортного средства."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка интенсивности реакции камеры из кабины на движения грузовика."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка наклона камеры из кабины вокруг продольной оси вслед за движениями грузовика."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка изменения поля зрения камеры из кабины в зависимости от скорости транспортного средства."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка задержки перед тем, как камера будет автоматически возвращена в центральное положение.<br><br>Автоматическое центрирование работает только в режиме вида из кабины и внешней камеры с видом сзади при движении вперёд и виде из водительского окна при движении задним ходом. Не применяется при незначительной скорости движения транспортного средства."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Настройка скорости, с которой камера перемещается межу положениями в виде из кабины и при автоматическом возврате в центр."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Выбор режима работы функции приближения камеры из кабины: приближение, пока удерживается кнопка, или включение и отключение приближения по нажатию." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор языка, используемого в интерфейсе игры."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор предустановок валюты и единиц измерения."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Включение отображения названий городов и стран на выбранном языке игры."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Включение отображения названий городов и стран на карте на двух языках: местном и выбранном языке игры."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор используемой валюты."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор 12-часового или 24-часового формата времени."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор единицы измерения расстояний."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор единиц измерения массы."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор единицы измерения температуры."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор единицы измерения давления."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор единицы измерения объёма."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Выбор единицы измерения расхода."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Если включено, нажатие кнопки \"Активировать\" (@@imv_nrm_activate@@) открывает чат в режиме конвоя."

