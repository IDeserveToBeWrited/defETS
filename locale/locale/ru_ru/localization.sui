#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Продолжить ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Добро пожаловать в Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Наконец-то у вас появилась возможность почувствовать себя в шкуре водителя-дальнобойщика!"

	key[]: "intro_3"
	val[]: "Ваша транспортная компания начинает свою деятельность. К сожалению, у вас не хватает средств на покупку грузовика. Поэтому вам придётся временно поработать наёмным водителем."

	key[]: "intro_4"
	val[]: "Ваша задача — довезти груз \"$JOB_CARGO$\" до компании $JOB_TARGET_COMPANY$ в городе $JOB_TARGET_CITY$. Работодатель предоставляет вам транспорт и берёт на себя все расходы. Постарайтесь уложиться в установленные сроки. Не подведите!"


	key[]: "intro_garage_1"
	val[]: "Это ваша штаб-квартира."

	key[]: "intro_garage_2"
	val[]: "Это обычный гараж. Он не особо просторный, но для начала сойдет."

	key[]: "intro_garage_3"
	val[]: "К сожалению, вам ещё нечего тут припарковать, поэтому вокруг так пусто."

	key[]: "intro_garage_4"
	val[]: "Заработав достаточно денег и купив грузовик, вы сможете свободно ездить по миру и развивать свой собственный бизнес."

	key[]: "intro_garage_5"
	val[]: "Удачи!"


	key[]: "desktop_tut_t"
	val[]: "ФУНКЦИЯ РАЗБЛОКИРОВАНА"

	key[]: "desktop_tut_job"
	val[]: "Выберите следующий заказ"

	key[]: "desktop_tut_cargo_market"
	val[]: "Используйте ваш новый прицеп для доступа на биржу грузов и доставки широкого ассортимента грузов." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Здесь вы можете просмотреть ваши текущие результаты."

	key[]: "desktop_tut_company"
	val[]: "Следите за своими гаражами, нанимайте новых водителей и управляйте своей компанией из них."

	key[]: "desktop_tut_trailers"
	val[]: "Начиная с данного момента, вы можете приобретать собственные прицепы, улучшать или перекрашивать их.<br><br>Ваши прицепы могут быть размещены в ваших выбранных гаражах. Также они могут быть использованы вашими водителями для увеличения прибыли. Чтобы управлять вашими прицепами, используйте раздел \"Управление прицепами\"."

	key[]: "desktop_tut_visit_directive"
	val[]: "Откройте $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Нажмите кнопку \"Режим\" для переключения между разными типами транспортного средства и режимами рабочего стола."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "ДОБРО ПОЖАЛОВАТЬ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Добро пожаловать на новый домашний экран!<br>Отсюда вы сможете управлять всеми функциями игры."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Главное меню снизу предоставляет доступ ко всем привычным основным функциям игры."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Сверху находится новая панель статуса, на которую постоянно выводится полезная информация, статистика и местные ПДД."

	key[]: "desktop_tut_tour_home"
	val[]: "Кнопка \"Домой\" позволяет вернуться на главный экран в любой момент."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Быстрое меню предоставляет постоянный доступ ко всем функциям игры с любого игрового экрана или меню."

	key[]: "desktop_tut_tour_drive"
	val[]: "Обновлённая кнопка \"В путь\" остаётся вашим связующим с режимом вождения."

