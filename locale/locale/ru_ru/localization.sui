#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "ПОДКЛЮЧЕННЫЙ КОНТЕНТ WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Подключить" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Просмотр" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "ОБЩИЕ НАСТРОЙКИ" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "ПОДКЛЮЧИТЬ КОНТЕНТ" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Подключить" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World Of Trucks обнаружил новый игровой контент. Чтобы получить доступ к контенту, подключите его к сервису World Of Trucks." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Онлайн" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Управление всеми настройками, связанными с World Of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Вы действительно хотите отложить регистрацию?<br><br>Вы сможете перейти в раздел подключения онлайн-контента позже в настройках игры, в разделе онлайн-опций." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "ПОДКЛЮЧЕНИЕ КОНТЕНТА" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Подключение контента.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Не удалось подключить: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Учётная запись Steam, которую вы использовали для регистрации дополнения (DLC), отличается от использованной при регистрации учётной записи World Of Trucks или регистрации игры. Смените учётную запись Steam и повторите попытку." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Учётная запись Steam, которую вы пытаетесь использовать для регистрации дополнения (DLC), уже связана с другой учётной записью World Of Trucks. Для регистрации дополнения на эту учётную запись вам необходимо использовать учётную запись Steam, не связанную ни с какой учётной записью World Of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Токен Steam истёк. Повторите попытку позже." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Используемый при регистрации дополнения (DLC) серийный код недействительный. За помощью обратитесь в службу поддержки: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Во время регистрации игры произошла внутренняя ошибка. Пожалуйста, попробуйте позже." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "УСПЕШНО" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "ИНФОРМАЦИЯ" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ОНЛАЙН" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "ПРОСМОТР КОНТЕНТА" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Поздравляем! Выбранные дополнения (DLC) успешно подключены к вашей учётной записи World Of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Не удалось подключить контент, поскольку текущая учётная запись Steam связана с другой учётной записью World Of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Не удалось подключить некоторые дополнения (DLC).<br>Наведите мышь на восклицательный знак у каждого дополнения для подробностей." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "$CURRENT_CONTENT_NAME$ регистрируется" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Текущий профиль не подключен к World of Trucks или игра работает в автономном режиме. Для подключения используйте меню редактирования профиля." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Нажмите, чтобы отклонить"

	key[]: "online_connect_content_info"
	val[]: "Подключено совместимых дополнений (DLC): <color value=@@clr_sel@@>$CONNECTED_CONTENT$<color value=@@clr_txt@@>/$TOTAL_CONTENT$. Если дополнения не подключены к World Of Trucks, вы не сможете воспользоваться некоторыми их функциями." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Поздравляем!<color value=@@clr_txt@@> Весь контент подключен к World of Trucks!" #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Не удалось подключить новый контент World of Trucks, поскольку используемая учётная запись Steam не совпадает с той учётной записью, которая подключена к профилю World Of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Подключено" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Не подключено" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Не удалось загрузить информацию об имеющемся контенте." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Не удалось загрузить информацию о подключенном контенте." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Не удалось загрузить информацию об используемой учётной записи." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Позже" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Не удалось зарегистрировать это дополнение (DLC). Не найдена постоянная лицензия, возможно вследствие Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Ограниченное владение" #+ The state of the content that cannot be connected due to invalid license.
#@}


