#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Сеть недоступна. Проверьте настройки клиента."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Не удалось подключиться к онлайн-сервису. Проверьте работоспособность подключения к Интернету."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Ошибка соединения с онлайн-сервисом. Повторите попытку позже."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Онлайн-сервис вернул неверные данные. Если вы используете соединение через HTTP-прокси, проверьте конфигурацию прокси-сервера, либо попробуйте соединиться позже."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Онлайн-сервис вернул неверные данные. Попробуйте соединиться позже."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Этот сервис несовместим с текущей версией игры. Проверьте наличие новых патчей на сайте разработчика."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Сервис недоступен. Попробуйте соединиться позже."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Данный сервис находится на обслуживании, либо перегружен. Попробуйте соединиться позже."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Неверная идентификационная информация. Повторите попытку аутентификации еще раз."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Учётная запись заблокирована по причине большого количества неудачных попыток аутентификации. Вы можете произвести авторизацию не ранее, чем через полчаса."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Учётная запись пользователя заблокирована из-за подозрительной активности. Попробуйте войти снова в течение 24 часов."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Эта копия игры не привязана к данной учётной записи."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Эта учётная запись ещё не активирована. На адрес эл. почты, указанный вами при регистрации, отправлено письмо с дальнейшими инструкциями."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Обслуживание этой учётной записи приостановлено. Свяжитесь со службой поддержки."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Эта учётная запись заблокирована. Свяжитесь со службой поддержки."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Аутентификация на прокси-сервере не поддерживается этой игрой. Используйте другой прокси-сервер, либо прямое подключение к интернету."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Требуемый объект на данный момент недоступен. Попробуйте снова через несколько минут."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Ошибка протокола безопасности передачи данных (SSL). Не удалось установить защищённое соединение."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Игра была остановлена в процессе обмена данными. Пожалуйста, повторите позднее."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Произошла внутренняя ошибка. Более подробная информация может содержаться в файле net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Обнаружена ошибка: совместимый видеоадаптер не найден.\nВозможные пути решения проблемы:\n\n1. Убедитесь, что ваш компьютер и видеокарта удовлетворяет минимальным аппаратным требованиям.\n2. Установите последнюю версию Microsoft DirectX.\n3. Загрузите и установите последнюю версию драйверов для вашей видеокарты — вполне вероятно, что текущие драйверы устарели.\n4. Попробуйте изменить метод рендеринга с OpenGL на DirectX, или наоборот.\n5. Удалите файл конфигурации игры \"config.cfg\", находящийся в папке Документы/Euro Truck Simulator 2. Он может быть поврежден.\n    Этот файл будет создан автоматически при следующем запуске игры, настройки примут стандартные значения."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 — обнаружена ошибка: совместимый видеоадаптер не найден."
#@}

