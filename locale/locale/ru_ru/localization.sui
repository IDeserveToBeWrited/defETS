#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "ОТСЛЕЖИВАНИЕ ГЛАЗ" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Расширенный вид" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Предустановки расширенного вида" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Введите название для предустановки" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Вы уверены, что хотите удалить выбранную предустановку?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Предустановка с таким же именем будет перезаписана. Вы хотите продолжить?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Настройки отслеживания взгляда" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Настройки отслеживания головы" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Управление с клавиатуры" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Включить расширенный вид" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Включить автоматический возврат к центру" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Режим отслеживания головы" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Прямой" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Динамический" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Отзывчивость отслеживания взгляда" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Отзывчивость отслеживания головы" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Включить отслеживание наклона вбок" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Включить отслеживание положения" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Множитель поворота (в кабине)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Множитель наклона (в кабине)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Множитель поворота (в режиме ходьбы)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Множитель наклона (в режиме ходьбы)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Максимальный угол взгляда" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Скорость отслеживания взгляда"

	key[]: "eye_gaze_exponent"
	val[]: "Экспонента отслеживания взгляда"

	key[]: "eye_gaze_inflection_point"
	val[]: "Точка перегиба отслеживания взгляда"

	key[]: "eye_gaze_start_point"
	val[]: "Точка начала отслеживания взгляда"

	key[]: "eye_gaze_end_point"
	val[]: "Точка конца отслеживания взгляда"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Чувствительность вращения головы (в кабине)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Чувствительность наклона головы (в кабине)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Чувствительность вращения головы (режим ходьбы)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Чувствительность наклона головы (режим ходьбы)"

	key[]: "eye_head_exponent"
	val[]: "Экспонента отслеживания головы"

	key[]: "eye_head_inflection_point"
	val[]: "Точка перегиба отслеживания головы"

	key[]: "eye_head_start_point"
	val[]: "Точка начала отслеживания головы"

	key[]: "eye_head_end_point"
	val[]: "Точка конца отслеживания головы"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Включение Extended View, который увеличивает угол обзора за счёт движения головы и/или глаз для управления игровой камерой."

	key[]: "eye_preset_op_tooltip"
	val[]: "Выбор пресетов расширенного просмотра."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Выбор режима отслеживания головы.<br>- В режиме \"Прямой\" поворот головы напрямую соответствует повороту камеры в игре. Рекомендуется в обычных ситуациях в кабине.<br>- В \"Динамическом\" режиме ваш взгляд будет влиять на игровую камеру только тогда, когда вы поворачиваете и голову. Рекомендуется, если вам важно, чтобы взгляд в игре был строго по центру."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Если эта функция включена, игровая камера будет постоянно медленно перемещаться по центру, когда вы меняете естественное положение головы во время игры."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Если эта функция включена, положение вашей головы влияет на положение камеры в игре."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Если включена эта функция, игровая камера будет наклоняться в соответствии с тем, куда вы наклоняете голову."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Множитель чувствительности вращения головы и взгляда в горизонтальном направлении (в кабине)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Множитель чувствительности вращения головы и взгляда в вертикальном направлении (в кабине)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Множитель чувствительности вращения головы и взгляда в горизонтальном направлении (в режиме ходьбы)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Множитель чувствительности вращения головы и взгляда в вертикальном направлении (в режиме ходьбы)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Настройка скорости реакции игровой камеры на движения взгляда."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Настройка плавности ускорения."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Настройка расстояния от центра экрана, на котором ускорение начнет выравниваться."

	key[]: "eye_gaze_start_point_op_tooltip"
