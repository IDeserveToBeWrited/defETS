	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Был получен доступ к некоторым DLC. Хотите перейти на главный экран, для получения доступа к новому контенту?<br><br>Ваш прогресс будет сохранен автоматически."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
