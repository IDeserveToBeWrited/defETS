	val[]: "Режим автопаузы" #+ Type of the autopause

	key[]: "eye_autopause_mode_never"
	val[]: "Отключена" #+ Autopause is disabled

	key[]: "eye_autopause_mode_presence"
	val[]: "Присутствие" #+ Autopause if user is not present

	key[]: "eye_autopause_mode_gaze"
	val[]: "Присутствие + взгляд" #+ Autopause if user is not present or not looking at the game for at least eye_autopause_gaze

