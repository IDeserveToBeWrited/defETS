#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Возникла ошибка при загрузке из инвентаря Steam.<br><br>$ERROR$<br><br>Нажмите \"Продолжить\", чтобы оставить контент подключённым. Периодически игра будет искать его.<br><br>Вы можете временно отключить контент и получать сообщения об ошибках наподобие этого. Контент подключится автоматически при следующем запуске игры." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Не удалось загрузить предметы из инвентаря Steam." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "ИНВЕНТАРЬ STEAM" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Загрузка предметов из инвентаря Steam..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "НОВЫЕ ПРЕДМЕТЫ В ИНВЕНТАРЕ" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Обнаружены новые предметы в инвентаре Steam." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Наружные аксессуары" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Аксессуары в салон" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Оформление меню" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Покраска" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Отключить инвентарь" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Попробуйте позже" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "ИНВЕНТАРЬ STEAM" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Некоторые предметы были удалены из инвентаря Steam. Вы больше не сможете купить их в мастерской по модернизации.<br><br>Это никак не повлияет на уже установленные предметы." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
