#+ Options/Brightness
#+
#+ Screen used to configure brightness related options.
#@{
	key[]: "brightness_t"
	val[]: "НАСТРОЙКА ЯРКОСТИ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "brightness_title"
	val[]: "Настройка яркости" #+ Label shown at the top of the screen.

	key[]: "brightness_subtitle"
	val[]: "Настройте яркость так, чтобы детали изображения были чётко видны."

	key[]: "open_hdr"
