#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "БАНК" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Банк" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Если срочно потребуются деньги, вы всегда можете обратиться в банк за кредитом." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "КРЕДИТНЫЕ ПРЕДЛОЖЕНИЯ" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "$MONEY$ в день" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Количество непогашенных кредитов: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Максимальный кредит: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "ДЕЙСТВУЮЩИЕ КРЕДИТНЫЕ ДОГОВОРЫ"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Кредит" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Не погашено" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Срок (в днях)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Процентная ставка (годовая)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Платёж" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Погасить" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Всего:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Средств на счёте: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

	key[]: "bank_loan_unlock_requirement"
	val[]: "Продвинтесь по карьере в грузовом режиме, чтобы разблокировать займ."

	key[]: "bank_loan_locked_wrong_mode"
