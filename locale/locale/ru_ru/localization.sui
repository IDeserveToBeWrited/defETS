	val[]: "Амплитуда камеры" #+ Slider for physics based camera movement multiplier.

	key[]: "toy_phys_move"
	val[]: "Физика аксессуаров в кабине" #+ Checkbox enabling cabin toys movement.

	key[]: "cam_horizon_lock_factor"
	val[]: "Фиксация камеры из кабины на горизонт" #+ Slider for interior camera horizon locking.

	key[]: "cam_fov_speed_factor"
	val[]: "Изменение поля зрения камеры из кабины по скорости" #+ Slider for interior camera speed-based FOV changes.

	key[]: "cam_auto_center_delay"
	val[]: "Задержка автоматического центрирования камеры" #+ Dropdown for camera auto centering delay.

	key[]: "cam_auto_move_speed"
	val[]: "Скорость вращения камеры" #+ Dropdown for automatic camera movement speed.

	key[]: "cam_interior_zoom_mode"
	val[]: "Режим приближения камеры из кабины" #+ Choose how the interior camera zoom behaves.

