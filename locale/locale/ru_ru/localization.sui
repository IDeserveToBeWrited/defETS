#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "ГРАФИКА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Графика" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Настройка параметров графики и производительности с помощью готовых предустановок."

	key[]: "apply"
	val[]: "Применить" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Тема меню" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ДИСПЛЕЙ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "КАЧЕСТВО ИЗОБРАЖЕНИЯ" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "ТЕКСТУРЫ" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "ОТРАЖЕНИЯ" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "ТЕНИ" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ОСВЕЩЕНИЕ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "ПОСТОБРАБОТКА" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ОКРУЖАЮЩАЯ СРЕДА" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Полноэкранный режим" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Яркость / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Настройка" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Разрешение" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Частота обновления" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Ограничение кадров" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Ограничение кадров в фоновом режиме" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "По умолчанию" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Гц" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Вертикальная синхронизация" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Энергосберегающий режим" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "БАЗОВЫЕ НАСТРОЙКИ ГРАФИКИ" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ПРИМЕНЕНЫ ПОЛЬЗОВАТЕЛЬСКИЕ НАСТРОЙКИ" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ГРАФИКИ" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Переключение между обычными и расширенными настройками графики" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Скрыть расширенные настройки" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Показать расширенные настройки" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Масштаб" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Сглаживание" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Резкость сглаживания Luma TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Настройка TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Адаптивная чёткость" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Всегда мягко" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Всегда чётко" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Затенение в местах сближения объектов (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Высокий динамический диапазон (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Глубина резкости (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Солнечные лучи" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Цветовая коррекция" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Масштаб отражений" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Качество отражений" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Качество растительности" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Плотность растительности" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Качество теней"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Размер текстуры тени" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Тени вдалеке" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Тени интерьера" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Погодные условия"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Качество отражений в зеркалах" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Разрешение в зеркалах" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Дальность прорисовки в зеркалах" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Качество текстур" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Анизотропная фильтрация" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Карты нормалей" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Фары трафика" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Дополнительная светотехника" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Дальность видимости света" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Пешеходы" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Графические настройки были изменены.<br>Вы хотите сохранить изменения?"

	key[]: "reverting_in"
	val[]: "Возврат через" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "с" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Включение отображения игры на весь экран."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Настройка общей яркости игры. На HDR-совместимых устройствах также будет доступна калибровка HDR."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Настройка разрешения игры."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка частоты обновления экрана игры."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Вертикальная синхронизация подстраивает частоту кадров игры под частоту обновления монитора для устранения разрывов в изображении. Экономичный режим дополнительно снижает частоту кадров вдвое, для уменьшения потребления энергии."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка максимально допустимой частоты кадров игры.<br><br>Установка значения 0 отключает ограничение."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка максимально допустимой частоты кадров игры, когда окно игры свёрнуто.<br><br>Установка значения 0 отключает ограничение."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Переключение между обычными графическими настройками (выбор предустановок) и расширенными графическими настройками (с возможностью изменения отдельных параметров)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Улучшение качества изображения, деталей и краёв объектов путём отрисовки игры в более высоком разрешении, чем выбранное (суперсэмплинг).<br>Выбор большего масштаба приводит к более качественному и чёткому изображению, но более низкой производительности.<br><br><color value=@@clr_txt_d@@>Данная настройка может иметь большое влияние на общую производительность игры."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Выбор высокоскоростных методов сглаживания неровных краёв в игре.<br>- SMAA производит выборку для каждого пикселя несколько раз (в зависимости от выбранного качества) в разных местах кадра и усредняет для получения окончательного изображения.<br>- TAA производит выборку каждого пикселя только один раз за кадр, но в разных местах на протяжении нескольких кадров.<br>- Для достижения наилучшего результата вы также можете выбрать комбинацию обоих методов, но в ущерб производительности.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Мягкое затенение полостей, впадин и объектов, расположенных близко друг к другу, что повышает общую визуальную реалистичность игрового мира.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Выбор предустановки сглаживания TAA:<br>- Режим \"Всегда мягко\" приведёт к более размытому изображению с меньшим мерцанием, он предпочтителен для игроков, использующих высокое значение масштаба или играющих на мониторах с большой плотностью пикселей (dpi), а так же тех, кто играет с большого расстояния, например, на телевизоре с разрешением 1080.<br>- В режиме \"Всегда чётко\" изображение более чёткое, но мерцание больше, он предпочтителен на экранах с более низким разрешением (ниже 1080), например, ноутбуков и компактных игровых устройств вроде Steam Deck.<br>- \"Адаптивная чёткость\" динамически подавляет дрожание картинки из-за TAA, когда камера статична.<br><br><color value=@@clr_txt_d@@>Данная настройка активна только при выборе TAA в качестве метода сглаживания."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка силы увеличения чёткости TAA Luma.<br><br><color value=@@clr_txt_d@@>Данная настройка активна только при выборе TAA в качестве метода сглаживания."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Включает искусственное размытие деталей на дальних расстояниях, симулируя эффект расфокусировки."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Включает прорисовку лучей, видимых при прямом взгляде на солнце, а также просвечивающих через листву, облака, из-за домов и транспортных средств."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Включает автоматическую подстройку цвета изображения для повышения эстетики. Например, освещение будет лучше подходить ко времени суток и погодным условиям, цвета транспортных средств и других объектов могут быть более насыщенными, и т. п."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Улучшение отражений путём отрисовки их в более высоком разрешении, а также использования более продвинутого сглаживания.<br><br><color value=@@clr_txt_d@@>Изменения данной настройки применятся только после полного перезапуска игры."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка детализации отражений в объектах игрового мира, таких как глянцевые и хромированные поверхности транспортных средств, окна, лужи, водоёмы, мокрые дороги и т. п.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность.<br><br>Изменения данной настройки применятся только после полного перезапуска игры."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка детализации моделей деревьев и прочих растений.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка плотности травы по краям дорог.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка качества теней, отбрасываемых объектами в свете солнца и луны.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Включение отрисовки теней даже от очень далёких объектов.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Включение динамических теней в салоне транспортного средства в ночное время.<br><br><color value=@@clr_txt_d@@>Этот параметр обычно оказывает умеренное влияние на производительность."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка качества эффектов погоды, например, отражений в мокрых поверхностях."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка качества отражений в зеркалах заднего вида (не зависит от настроек отражений в объектах).<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка разрешения отражений в зеркалах заднего вида."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка расстояния отрисовки объектов в зеркалах заднего вида.<br><br><color value=@@clr_txt_d@@>Данная настройка может иметь высокое влияние на производительность."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка качества текстур некоторых объектов и поверхностей в игре."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Увеличение чёткости текстур, видимых на больших расстояниях и под большими углами.<br><br><color value=@@clr_txt_d@@>Изменения данной настройки применятся только после полного перезапуска игры."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Включение более реалистичного отображения деталей рельефа поверхностей, таких как тротуары, дороги и т. п.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность.<br><br>Изменения данной настройки применятся только после полного перезапуска игры."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Включение освещения поверхностей фарами трафика."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Включение освещения поверхностей дополнительными огнями трафика, такими, как указатели поворота, стоп-сигналы и т. п."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка расстояния отрисовки освещения поверхностей искусственными источниками света.<br><br><color value=@@clr_txt_d@@>Данная настройка обычно имеет среднее влияние на производительность."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Включение пешеходов в игровом мире."
#@}

