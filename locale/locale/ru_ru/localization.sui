	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Специальный заказ:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Приготовьтесь к перевозке спецтранспортом. вас  будут сопровождать две машины. Будьте осторожны, следуйте за сопровождающей машиной и подсказкам. При перевозке спецтранспортом вам предоставляется преимущество проезда в большинстве случаев, а также право проезда на красный свет. Во время перевозки игра будет чаще автоматически сохраняться, чтобы сохранить ваш прогресс."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Обратите особое внимание:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Избегайте конфликтных ситуаций с машинами сопровождения и держитесь между ними."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Запрещено отклоняться от заданного маршрута, в том числе на заправки, стоянки для отдыха и т.д."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Соблюдайте ограничения скорости, устанавливаемые передней машиной сопровождения."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Не забывайте о других участниках дорожного движения."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Манёвр перестроения:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Перевозка спецтранпортом будет провалена, если вы не будете соблюдать эти правила!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "<color value=@@clr_sel@@>Задняя<color value=@@clr_txt@@> сопровождающая машина начинает манёвр, перестраиваясь и перекрывая выбранную полосу."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Передняя<color value=@@clr_txt@@> сопровождающая машина дожидается, пока полоса освободится, а затем тоже перестраивается."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Теперь <color value=@@clr_sel@@>игрок<color value=@@clr_txt@@> может перестроиться."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Доступные часы вождения в журнале восстановлены, топливо дозаправлено."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Во время перевозки негабаритного груза вызвать эвакуатор нельзя."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Вы не можете использовать паром во время выполнения перевозки спецтранпортом."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Вы немного отдыхаете...<br>Топливные баки заправляются..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Вы приближаетесь к обязательной остановке.<br>Следуйте за автомобилем сопровождения до места стоянки, чтобы прерваться на отдых."

	#+ Adviser title for mandatory stop activation point
