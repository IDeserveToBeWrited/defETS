
    key[]: "hint_engine_title"
	val[]: "Запустите двигатель"

    key[]: "hint_engine_text"
	val[]: "Используйте $KEY_engine$ для запуска двигателя."


    key[]: "hint_ignition_title"
	val[]: "Включите зажигание"

    key[]: "hint_ignition_text"
	val[]: "Нажмите клавишу $KEY_engineelect|KEY_engine$ для включения зажигания."


    key[]: "hint_driv_arc_title"
	val[]: "Движение"

    key[]: "hint_driv_arc_text"
	val[]: "Нажмите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для движения вперёд или назад.<br><offset vshift=8>Нажмите $SPECIAL_steering$ для управления."


    key[]: "hint_driv_auto_title"
	val[]: "Движение"

    key[]: "hint_driv_auto_text"
	val[]: "Нажмите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для движения вперёд или назад.<br><offset vshift=8>Нажмите $SPECIAL_steering$ для управления.<br><offset vshift=8>Нажмите $KEY_gearup$ и $KEY_geardown$ для выбора передачи."


    key[]: "hint_driv_seq_title"
	val[]: "Движение"

    key[]: "hint_driv_seq_text"
	val[]: "Нажмите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для движения вперёд или назад.<br><offset vshift=8>Нажмите $SPECIAL_steering$ для управления.<br><offset vshift=8>Нажмите $KEY_gearup$ и $KEY_geardown$ для управления сцеплением."


    key[]: "hint_driv_hshift_title"
	val[]: "Движение"

    key[]: "hint_driv_hshift_text"
	val[]: "Нажмите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для движения вперёд или назад.<br><offset vshift=8>Нажмите $SPECIAL_steering$ для управления.<br><offset vshift=8>Переключайте передачи с помощью <color value=@@clr_sel@@>рычага КПП<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Подъедьте к месту назначения"

    key[]: "hint_depot_deliv_text"
    val[]: "Остановитесь в обозначенной зоне, чтобы выбрать уровень сложности парковки и получить соответствующее количество опыта."


    key[]: "hint_fin_deliv_title"
    val[]: "Завершить доставку"

    key[]: "hint_fin_deliv_text"
    val[]: "Припаркуйтесь на выбранном месте. Нажмите $KEY_activate$, чтобы пропустить это, если вы недалеко от точки разгрузки."


    key[]: "hint_fin_deliv2_title"
    val[]: "Завершить доставку"

    key[]: "hint_fin_deliv2_text"
    val[]: "Припаркуйтесь на выбранном месте. Вы можете включить виджет в @@desktop_menu_category_options@@, который позволит вам пропустить парковку."


    key[]: "hint_lights_title"
    val[]: "Включите свет"

    key[]: "hint_lights_text"
    val[]: "Нажмите $KEY_light$ для включения света. Для переключения режимов света нажмите кнопку снова."


    key[]: "hint_high_beam_title"
    val[]: "Включите дальний свет"

    key[]: "hint_high_beam_text"
    val[]: "Нажмите $KEY_hblight$ для включения дальнего света."


    key[]: "hint_wipers_title"
    val[]: "Включите стеклоочистители"

    key[]: "hint_wipers_text"
    val[]: "Нажмите $KEY_wipers$ для включения стеклоочистителей и переключения скорости их работы."


    key[]: "hint_zoom_title"
    val[]: "Приблизить"

    key[]: "hint_zoom_text"
    val[]: "Нажмите $KEY_camzoom$ для масштабирования вида из кабины. Вы можете выбрать режим масштабирования на удержание или переключение в @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Осмотритесь"

    key[]: "hint_cam_int_text"
    val[]: "Нажмите $KEY_cam1$ для переключения на камеру в кабине."


    key[]: "hint_cam_ext_title"
    val[]: "Осмотритесь"

    key[]: "hint_cam_ext_text"
    val[]: "Вы можете переключаться между различными камерами, нажимая клавишу $KEY_camcycle$.<br><offset vshift=8>Нажмите $KEY_cam2$ чтобы переключиться на внешнюю камеру."


    key[]: "hint_indicators_title"
    val[]: "Указатели поворота"

    key[]: "hint_indicators_text"
    val[]: "Нажмите $KEY_lblinker$ и $KEY_rblinker$ чтобы включить указатели поворота."


    key[]: "hint_tow_title"
    val[]: "Эвакуатор"

    key[]: "hint_tow_text"
    val[]: "Если вы не можете выбраться из сложной ситуации, вы можете воспользоваться услугами эвакуатора. Чтобы получить к нему доступ, откройте @@quick_info_word@@ с помощью $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Блокировка дифференциала"

    key[]: "hint_diff_lock_text"
    val[]: "Если вы не можете начать движение, возможно, вам поможет блокировка дифференциала. Нажмите $KEY_diflock$, чтобы активировать его или включить автоматическую блокировку в @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Блокировка дифференциала включена"

    key[]: "hint_diff_unlock_text"
    val[]: "Разблокировать дифференциал следует во время обычной езды, иначе существует риск его повреждения. Нажмите $KEY_diflock$, чтобы отключить его или включить автоматическую блокировку дифференциала в @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Отключить стеклоочистители"

    key[]: "hint_wipers_off_text"
    val[]: "Нажмите $KEY_wipers$ для отключения стеклоочистителей и переключения скорости их работы."


    key[]: "hint_world_map_title"
    val[]: "Карта"

    key[]: "hint_world_map_text"
    val[]: "Нажмите $KEY_navmap$ чтобы открыть карту."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Нажмите $KEY_advmouse$, чтобы открыть @@quick_info_word@@ — обзор состояния с удобными ярлыками."


    key[]: "hint_pause_border_title"
    val[]: "Местные ПДД"

    key[]: "hint_pause_border_text"
    val[]: "Нажмите $KEY_advmouse$ чтобы открыть @@quick_info_word@@ и ознакомьтесь с действующими правилами региона, в который вы въехали."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Откройте @@quick_info_word@@, нажав $KEY_advmouse$ для выбора @@photo_mode_word@@, чтобы запечатлеть @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "Поблизости @@viewpoint_title@@"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> находится неподалеку — найдите её и активируйте, чтобы посмотреть видеовставку."


    key[]: "hint_resting_title"
    val[]: "Место отдыха неподалеку"

    key[]: "hint_resting_text"
    val[]: "Места отдыха <img src=/material/ui/map/parking_ico.mat width=20 height=20> помогут вам избавиться от усталости и провести обязательный перерыв, чтобы безопасно продолжить путешествие."


    key[]: "hint_gas_title"
    val[]: "Поблизости заправка"

    key[]: "hint_gas_text"
    val[]: "Заправка <img src=/material/ui/map/gas_ico.mat width=20 height=20> используется для пополнения топливом вашего автомобиля."
