SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "Система" #+ Message sender
		subject: "Тестовое сообщение" #+ Message subject
		body: "Привет! <br><br>Это тестовое сообщение от твоего коллеги-администратора ;-)<br><br>Будьте здоровы" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "Банк" #+ Message sender
		subject: "Кредиты на выгодных условиях!" #+ Message subject
		body: "Уважаемые клиенты,<br><br>Возможно, вам будет интересно узнать о наших новых программах кредитования для новых предприятий. Вам нужно внешнее финансирование для становления вашего бизнеса? Мы можем вам помочь! Пожалуйста, $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>посетите ваше местное отделение банка</link> для получения дополнительной информации.<br><br>С уважением,<br>Менеджер по работе с клиентами<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "Банк" #+ Message sender
		subject: "Мы можем помочь вам в развитии" #+ Message subject
		body: "Уважаемый клиент,<br><br>Ваши достижения не остались для нас незамеченными, и мы хотели бы помочь вам раскрыть ваш потенциал. Мы повысили ваш кредитный лимит до $MONEY$. Вы можете получить требуемую сумму в любой момент $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>в ближайшем отделении</link>.<br><br>С уважением,<br>Менеджер по работе с клиентами<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "Банк" #+ Message sender
		subject: "Вы превысили кредитный лимит" #+ Message subject
		body: "Уважаемый клиент,<br><br>Вы сняли больше денег с вашего счета, чем было доступно. Мы предоставим вам краткосрочный кредит на несколько дней, чтобы вы могли разрешить сложившуюся ситуацию. Пожалуйста, погасите вашу задолженность как можно скорее.<br><br>С наилучшими пожеланиями,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "Банк" #+ Message sender
		subject: "Внимание: непогашенный овердрафт!" #+ Message subject
		body: "Уважаемый клиент,<br><br>Баланс вашего банковского счёта стал отрицательным! Пожалуйста, ликвидируйте задолженность в течение $DAYS$, иначе банк будет вынужден конфисковать ваше имущество.<br><br>Искренне ваш,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "Банк" #+ Message sender
		subject: "Последнее предупреждение!" #+ Message subject
		body: "Уважаемый клиент,<br><br>Мы последний раз предупреждаем вас о том, что вы превысили ваш кредитный лимит. Пожалуйста, ликвидируйте вашу задолженность завтра, или мы будем вынуждены конфисковать ваше имущество для покрытия долгов.<br><br>Искренне ваш,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "Банк" #+ Message sender
		subject: "Овердрафт погашен" #+ Message subject
		body: "Уважаемый клиент,<br><br>Хотим вас информировать, что перерасход кредитуемых средств вашего счёта устранен. Мы будем рады помочь вам при малейшей необходимости.<br><br>Мы желаем вам приятного дня,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "Банк" #+ Message sender
		subject: "Ваш личный грузовик продан" #+ Message subject
		body: "Уважаемый клиент!<br><br>Мы с сожалением сообщаем вам о том, что ваш грузовик — $TRUCK_NAME$ — был продан за $MONEY$. К сожалению, ваша задолженность слишком велика, и вы больше не в состоянии покрыть её. Поэтому мы были вынуждены принять крайние меры. Мы можем предложить вам выполнять быстрые заказы, чтобы улучшить вашу финансовую ситуацию.<br><br>Искренне ваш,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "Банк" #+ Message sender
		subject: "Ваш личный прицеп продан" #+ Message subject
		body: "Уважаемый клиент,<br><br>Мы с сожалением сообщаем вам о том, что ваш прицеп - $TRAILER_NAME$ — был продан за $MONEY$. К сожалению, ваша задолженность слишком велика, и вы больше не в состоянии покрыть её. Поэтому мы были вынуждены принять крайние меры. Мы можем предложить вам выполнять быстрые заказы, чтобы улучшить вашу финансовую ситуацию.<br><br>Искренне ваш,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "Банк" #+ Message sender
		subject: "Ваша собственность была продана" #+ Message subject
		body: "Уважаемый клиент!<br><br>В связи с высокой задолженностью, мы были вынуждены конфисковать и продать вашу собственность. Вырученные средства, в размере <br>$MONEY$ были потрачены на погашение задолженности. Следующая собственность была конфискована:<br><br>$ITEM_LIST$<br>Мы сожалеем, что так произошло, и надеемся, что последствия не будут такими тяжелыми для вас.<br><br>С наилучшими пожеланиями,<br>Менеджер по обслуживанию<br>Банк" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "Дилер грузовиков -  $CITY$" #+ Message sender
		subject: "Ищете новый грузовик $BRAND$? Вам сюда!" #+ Message subject
		body: "Уважаемый клиент,<br><br>Мы являемся официальным дилером марки $BRAND$. Мы предлагаем широкий выбор моделей, а также можем выполнять индивидуальные заказы. Пожалуйста, <nowrap>$SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>посетите наш салон в городе $CITY$</link></nowrap>. Грузовик вашей мечты ждёт вас!<br><br>С наилучшими пожеланиями,<br>Ваш дилер грузовиков $BRAND$" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "Салон грузовиков с пробегом" #+ Message sender
		subject: "Грузовики с пробегом уже в продаже!" #+ Message subject
		body: "Здравствуйте!<br><br>Мы рады объявить об открытии нашего нового салона по продаже проверенных грузовиков с пробегом. Не важно, ищете ли вы могучего зверя, или просто рабочую лошадку, у нас есть превосходные варианты для любой вашей задачи.<br><br>Пожалуйста, рассмотрите $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>наши предложения</link>. Мы уверены, что ваш новый грузовик с пробегом найдётся у нас. <br><br>Искренне ваши,<br><br>Команда дилера грузовиков с пробегом.<br><br>P. S. Не забывайте заглядывать к нам почаще! Наши предложения постоянно обновляются, кто знает, какое выгодное предложение может быть в наличии." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "Требуется водитель с личным транспортом" #+ Message subject
		body: "Информация для работников сферы автотранспортных грузоперевозок.<br><br>Приглашаем опытного водителя с личным грузовиком для выполнения большого количества заказов. Наша компания предлагает высокие ставки, до $MONEY$ за рейс. Если вас заинтересовало это предложение, мы будем рады видеть вас в нашем офисе, в $CITY$.<br><br>$COMPANY$,<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "Водитель $NAME$" #+ Message sender
		subject: "Мне нужен грузовик" #+ Message subject
		body: "Добрый день.<br><br>Хочу привлечь ваше внимание к одной незначительной проблеме: я уже $DAYS$ сижу без дела в гараже, что в городе $CITY$. Это начинает раздражать, ведь мне тоже нужно платить по счетам, а я не могу работать, не имея грузовика. Пожалуйста, займитесь решением этой проблемы в течение ближайших $DAYS2$, иначе я буду вынужден уволиться.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "Водитель $NAME$" #+ Message sender - written by female
		subject: "Мне нужен грузовик" #+ Message subject - written by female
		body: "Добрый день.<br><br>Хочу привлечь ваше внимание к одной незначительной проблеме: я уже $DAYS$ сижу без дела в гараже, что в городе $CITY$. Это начинает раздражать, ведь мне тоже нужно платить по счетам, а я не могу работать, не имея грузовика. Пожалуйста, займитесь решением этой проблемы в течение ближайших $DAYS2$, иначе я буду вынуждена уволиться.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "Водитель $NAME$" #+ Message sender
		subject: "Прощайте" #+ Message subject
		body: "Добрый день.<br><br> Я больше не могу тратить время впустую, просиживая в гараже без работы и грузовика. За время бездействия я и так упустил несколько хороших заказов, поэтому вынужден покинуть вашу компанию и попытать счастья в другом месте. Всё выданное мне оборудование я оставил в гараже города $CITY$.<br><br>Удачи!<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "Водитель $NAME$" #+ Message sender - written by female
		subject: "Прощайте" #+ Message subject - written by female
		body: "Добрый день.<br><br> Я больше не могу тратить время впустую, просиживая в гараже без работы и грузовика. За время бездействия я и так упустила несколько хороших заказов, поэтому вынуждена покинуть вашу компанию и попытать счастья в другом месте. Всё выданное мне оборудование я оставила в гараже города $CITY$.<br><br>Удачи!<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "Водитель $NAME$" #+ Message sender
		subject: "Моему грузовику требуется капитальный ремонт" #+ Message subject
		body: "Здравствуйте, босс.<br><br>Извините, если отвлекаю, но моему грузовику требуется капитальный ремонт. Он слишком старый и изношенный, водить его просто небезопасно. Я сижу без работы уже $DAYS$, потому что ездить на нём невозможно, а деньги нужны, мне скоро по счетам платить. Пожалуйста, предоставьте мне другой грузовик, или отремонтируйте этот, чтобы я мог вернуться к работе, иначе у меня не будет другого выбора, кроме как уволиться.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "Водитель $NAME$" #+ Message sender - written by female
		subject: "Моему грузовику требуется капитальный ремонт" #+ Message subject - written by female
		body: "Здравствуйте, босс.<br><br>Извините, если отвлекаю, но моему грузовику требуется капитальный ремонт. Он слишком старый и изношенный, водить его просто небезопасно. Я сижу без работы уже $DAYS$, потому что ездить на нём невозможно, а деньги нужны, мне скоро по счетам платить. Пожалуйста, предоставьте мне другой грузовик, или отремонтируйте этот, чтобы я могла вернуться к работе, иначе у меня не будет другого выбора, кроме как уволиться.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "Водитель $NAME$" #+ Message sender
		subject: "Прощайте" #+ Message subject
		body: "Здравствуйте.<br><br>Жаль, что до этого дошло, но выданный мне грузовик разваливается на ходу, и я так больше не могу. Я не могу на нём работать и зарабатывать, а мои расходы никуда не делись, поэтому мне пришлось найти другую работу. Я оставил всё, что мне было выдано или назначено, в гараже города $CITY$. Рекомендую всё-таки починить этот грузовик, прежде чем назначать на него нового водителя.<br><br>Всего хорошего.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "Водитель $NAME$" #+ Message sender - written by female
		subject: "Прощайте" #+ Message subject - written by female
		body: "Здравствуйте.<br><br>Жаль, что до этого дошло, но выданный мне грузовик разваливается на ходу, и я так больше не могу. Я не могу на нём работать и зарабатывать, а мои расходы никуда не делись, поэтому мне пришлось найти другую работу. Я оставила всё, что мне было выдано или назначено, в гараже города $CITY$. Рекомендую всё-таки починить этот грузовик, прежде чем назначать на него нового водителя.<br><br>Всего хорошего.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "Водитель $NAME$" #+ Message sender
		subject: "Я увольняюсь" #+ Message subject
		body: "Здравствуйте босс,<br><br>Гараж в городе $CITY$, в котором я нахожусь, закрывают. Какие-то люди из банка сказали, что я должен покинуть его. Похоже, дела у компании плохи, поэтому я решил уволиться. Всё равно, работы, как и грузовика уже нет. Попробую устроиться куда-нибудь ещё.<br><br>До свидания,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "Водитель $NAME$" #+ Message sender - written by female
		subject: "Я увольняюсь" #+ Message subject - written by female
		body: "Здравствуйте босс,<br><br>Гараж в городе $CITY$, в котором я нахожусь, закрывают. Какие-то люди из банка сказали, что я должна покинуть его. Похоже, дела у компании плохи, поэтому я решила уволиться. Всё равно, работы, как и грузовика уже нет. Попробую устроиться куда-нибудь ещё.<br><br>До свидания,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "Диспетчер" #+ Message sender
		subject: "Перевозки спецтранпортом" #+ Message subject
		body: "Привет, босс.<br><br>У меня есть для вас  кое-что особенное. Благодаря нашим связям, теперь мы можем принять настоящий вызов. Есть специальные, сверхкрупные и тяжёлые грузы, которые должны перевозить настоящие профессионалы. Это будет непросто и потребует особых навыков, терпения, сотрудничества с машинами сопровождения и особой осторожности, но я думаю, вы справитесь. К тому же, чем больше риск, тем больше прибыль.<br><br>Если вам интересно, вы можете посетить эти города:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "Диспетчер" #+ Message sender
		subject: "Новые перевозки спецтранпортом" #+ Message subject
		body: "Привет, босс.<br><br>Всё больше компаний хотели бы использовать ваши профессиональные навыки вождения для некоторых специальных поставок. Как и в прошлый раз, это будет непросто и для этого потребуются мастерство, терпение, взаимодействие с автомобилями сопровождения и особая осторожность, но, я думаю, вы справитесь. И не забывайте, что эти грузы еще и более прибыльны.<br><br>Кроме уже имеющихся предложений по перевозке специальных поставок в городах<br><br>$OLD_CITIES$<br><br>вы также можете взять <color value=@@clr_sel@@>новые<color value=@@clr_txt@@> заказы в городах:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "Риэлторское агентство" #+ Message sender
		subject: "Желаете расширить компанию?" #+ Message subject
		body: "Уважаемый клиент,<br><br>Мы хотим поздравить вас с ростом вашей компании. Успех вашей компании впечатляет нас, и мы рады сообщить, что с этого момента вы можете воспользоваться нашими услугами, чтобы покупать недвижимость практически мгновенно. Для получения дополнительной информации вы можете посетить $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>нашу страницу покупки гаражей</link>.<br><br>Искренне ваш,<br>Менеджер по работе с клиентами<br>Риэлторское Агентство" #+ Message body
	}
	
#@}
}