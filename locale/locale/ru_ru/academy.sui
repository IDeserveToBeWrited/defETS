#+ Books general.
#@{
	key[]: "aca_modded_book"
	val[]: "Модификация"

	key[]: "aca_book_inaccessible"
	val[]: "Новый контент будет скоро добавлен. Следите за новостями."

	key[]: "aca_book_inaccessible_t"
	val[]: "СКОРО"

	key[]: "aca_book_inaccessible_u"
	val[]: "Уже скоро!"

	key[]: "aca_book_disclaimer_t"
	val[]: "ПРЕДУПРЕЖДЕНИЕ"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Не является сертифицированной программой обучения."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ не предназначена для замены обучения вождению.</font><br><br><color value=@@clr_txt@@> Мы настоятельно рекомендуем пройти обучение в аккредитованной автошколе или ином учебном заведении, прежде чем пытаться управлять грузовиком в реальном мире.<br><br>Образовательные учреждения, желающие использовать компонент \"@@driving_academy@@\" в качестве дополнительного учебного материала, могут связаться с нами по адресу academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Основы вождения грузовика"

	key[]: "aca_book_book1_desc"
	val[]: "Изучите основы управления грузовиком, от базовых функций и органов управления, до маневрирования с прицепом."

	key[]: "aca_book_book2_title"
	val[]: "Мастерство вождения"

	key[]: "aca_book_book2_desc"
	val[]: "Оттачивайте свои навыки вождения грузовика, выполняя новые упражнения в более сложных условиях."

	key[]: "aca_book_book3_title"
	val[]: "Управление автопоездом"

	key[]: "aca_book_book3_desc"
	val[]: "Попробуйте себя в непростых испытаниях в сцепке из двух прицепов."

#@}

