#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Движение по тренировочной трассе"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "В этом упражнении мы проедемся по трассе, разработанной для проверки ваших способностей управлять грузовиком на различных виражах и поворотах."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Выезд на маршрут"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Плавный поворот налево"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Прохождение S-образных поворотов"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Прямой участок"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Лёгкие повороты"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Выезд с учебного маршрута"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Приближение к парковочному месту"
