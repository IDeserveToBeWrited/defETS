	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Прохождение сложных поворотов"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "В этом упражнении мы преодолеем короткую полосу препятствий с более сложными поворотами."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Первые повороты"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Движение через узкий проезд"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Крутой поворот на 90 градусов"
