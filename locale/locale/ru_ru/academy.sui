#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Параллельная парковка"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "В этом упражнении мы рассмотрим параллельную парковку между двумя другими грузовиками."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Остановка перед парковочным местом"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Проверка зеркала заднего вида"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Выезд задним ходом на парковочное место"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Выравнивание грузовика внутри места для парковки"
