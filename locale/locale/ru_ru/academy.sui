#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Назад под 90 грудусов"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "В этом упражнении вам потребуется выполнить манёвр задним ходом на 90 градусов, чтобы припарковаться в ряду других грузовиков."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Разворот"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Подготовка"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Движение назад"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "С двойными прицепами легче съезжать задним ходом, так как из бокового окна открывается более чёткий обзор всего происходящего."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Сначала проедьте вперёд и развернитесь в конце ряда. Это позволит вам расположиться со стороны водителя, что обеспечит лучший обзор из окна."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Вы можете расположить прицепы так, как считаете нужным, например, задний прицеп сразу направить в сторону места парковки. В этом случае мы начнем с прямой позиции. <br><br>Всё должно быть просто — управляйте задним прицепом, поворачивая передним."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Слегка отведите передний прицеп от места парковки, тогда задний прицеп начнёт поворачивать в нужную сторону. Затем отрегулируйте угол между передним и задним прицепами, чтобы обеспечить плавный и ровный въезд на парковочное место."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Помните, если задний прицеп заезжает слишком близко, то необходимо немного выровнять угол. Если же он заезжает слишком широко, то следует сделать угол более острым."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Вносимые вами корректировки тягачом оказывают на задний прицеп вдвое меньшее влияние, чем на передний, поэтому не бойтесь по-настоящему эксплуатировать свой тягач."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "На этом этапе необходимо заранее планировать. Также нужно загнать ведущий прицеп на место, поэтому составьте план, как расположить его прямо перед задним прицепом."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Очень редко удаётся загнать прицепы с первой попытки. В этом случае мы слишком затянули, прежде чем выровнять передний прицеп, и теперь задний смещается с пути. <br><br>Не проблема, проедьте вперёд и попробуйте снова."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Поработайте рулём как следует и направьте прицепы туда, куда вам нужно. Можете протягивать вперёд столько раз, сколько потребуется, пока не будете удовлетворены результатом."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "И вот, мы успешно припарковали двойной прицеп."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Проезжайте до конца парковки и развернитесь."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Не забудьте сделать широкий поворот."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Продолжайте движение вперёд, пока не почувствуете, что у вас достаточно места для маневрирования, затем начните движение задним ходом."

	key[]: "aca_msg_book3_backing_90_tight_check3"
