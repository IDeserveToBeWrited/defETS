	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "В этом упражнении ваша задача — припарковаться на месте, расположенном рядом с вами. Пространство для манёвра ограничено, поэтому вам придётся приложить немного дополнительных усилий, чтобы направить прицеп туда, куда нужно."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Подъезжайте к барьеру."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Остановитесь перед ограждением."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Перед началом движения сразу поверните руль в сторону водителя. Таким образом, вы начнёте поворачивать прицеп к парковочному месту сразу после начала движения задним ходом, экономя ценное пространство."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Как только вы направите прицеп в нужном направлении, выставьте тягач перед прицепом и начните направлять его на место для парковки."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "С этого момента это не сильно отличается от обычного манёвра парковки."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Продолжайте двигаться задним ходом и наблюдайте за обеими сторонами. Держите тягач и прицеп на одной линии с местом для парковки."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Остановитесь в обозначенном месте, поставьте грузовик на стояночный тормоз и заглушите двигатель."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Вы находитесь на парковочном месте, но справа от вас есть второе парковочное место, куда вам нужно переехать.<br><br><font face=/font/big_bold.font>Приготовьтесь к движению. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Перед вами отмеченная область.<br><br><font face=/font/big_bold.font>Двигайтесь вперёд. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Не забудьте сразу начать подруливать, так как места мало.<br><br><font face=/font/big_bold.font>Двигайтесь назад к обозначенному месту позади вас. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Прохождение простых поворотов"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "В этом упражнении вы совершите короткую поездку и пройдёте учебный курс, который поможет вам научиться маневрировать прицепом на простых поворотах под углом 90 градусов."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Сделать первый поворот"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Второй поворот"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Последний поворот"
