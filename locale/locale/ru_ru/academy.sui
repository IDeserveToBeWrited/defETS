ont><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/time.mat width=22 height=22><offset vshift=2>@@aca_goal_time_limit@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_time_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/camera.mat width=22 height=22><offset vshift=2>@@aca_goal_exterior_drive@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_camera_desc@@</font></margin></align><br><offset vshift=15>"
#!}

#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "О КУРСЕ МАСТЕРСТВА ВОЖДЕНИЯ" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Требования для завершения"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Упражнения считаются выполненными при соблюдении всех условий"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Звёзды начисляются за выполнение бонусных условий"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Условия"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Максимум переключений между движением вперёд и назад"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Максимальное время, отведённое на выполнение условий упражнения"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Использование только камеры из кабины — наружные камеры могут использоваться в неподвижном состоянии"

	key[]: "aca_book_book2_completed_t"
	val[]: "КУРС МАСТЕРСТВА ВОЖДЕНИЯ ПРОЙДЕН"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравляем!<br><br>Вы выполнили все условия прохождения курса \"Мастерство вождения\" и получили награды для вашего профиля карьеры. Вы можете бросить себе вызов и получить больше наград, выполнив все бонусные условия.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "КУРС МАСТЕРСТВА ВОЖДЕНИЯ ЗАВЕРШЁН"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравляем!<br><br>Вы выполнили все условия прохождения и бонусы курса \"Мастерство вождения\" и получили награды для вашего профиля карьеры.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Мастерство вождения"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "С возвращением в @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Следующие упражнения представляют собой очередные шаги на вашем пути к профессиональному вождению грузовика."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Мы не будем сопровождать вас на каждом задании, поэтому вам придётся применить на практике все свои навыки и опыт."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Вы можете столкнуться с некоторыми знакомыми манёврами, но на этот раз в новых условиях, больше похожих на реальные сценарии."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Новым для @@driving_academy@@ является добавление требований к \"Выполнено\" и \"Бонус\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Как и прежде, вам необходимо выполнить каждое упражнение ничего не задев, успешно припарковавшись и установив стояночный тормоз..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...но теперь вы также должны сделать это за отведённое время и с ограничением по количеству смен направления движения между движением вперёд и назад."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Бонусные условия можно выполнить, пройдя каждое упражнение с ещё более сложными условиями..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...например, более строгие временные рамки, меньшее количество изменений направления движения и использование только камеры из кабины."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Выполнив все упражнения, вы сможете считать себя опытным дальнобойщиком, готовым к испытаниям на дороге.<br><br>Чтобы бросить вызов самому себе, выполните все бонусные условия для каждого упражнения, тогда вы действительно станете звездой вождения грузовиков!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Обучение"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "В этом учебном упражнении мы поможем вам ознакомиться с новыми функциями, представленными на курсе мастерства вождения."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "В начале каждого упражнения вы увидите окно <color value=@@clr_sel@@>\"Обзор упражнения\"<color value=@@clr_txt@@>. Оно содержит информацию о новых условиях выполнения и бонуса для упражнения. <br><br>Для завершения упражнения необходимо выполнить условия, в то время как бонусные условия представляют собой необязательное дополнительное испытание для опытных и профессиональных игроков.<br><br><font face=/font/big_bold.font>Для продолжения включите зажигание.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Одно из бонусных условий требует, чтобы вы выполняли упражнение, используя <color value=@@clr_sel@@>камеру из кабины<color value=@@clr_txt@@>. Вы можете использовать внешние камеры для осмотра обстановки вокруг, но только когда грузовик не двигается.<br><br>Сейчас вы можете осмотреться, чтобы сориентироваться, а затем снова переключитесь на камеру из кабины.<br><br><font face=/font/big_bold.font>Переключитесь на внешнюю камеру с видом сзади, чтобы осмотреться</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Сориентируйтесь, а затем снова переключитесь на камеру из кабины.<br><br><font face=/font/big_bold.font>Осмотрите грузовик</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Переключитесь обратно на камеру из кабины</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Время<color value=@@clr_txt@@> также будет фактором, влияющим на мастерство вождения грузовика. Все упражнения будут иметь временной лимит, в течение которого упражнение должно быть завершено в качестве условия прохождения, а многие из них будут иметь дополнительный, более строгий лимит в качестве бонусного условия.<br><br>Таймер запускается только после того, как грузовик сдвинется с места.<br><br><font face=/font/big_bold.font>Запустите двигатель и отпустите стояночный тормоз, чтобы продолжить.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Ещё одно нововведение в курсе Мастерства вождения — это точки маршрута. Все эти точки должны быть достигнуты, прежде чем упражнение будет завершено.<br><br>Кроме того, точки маршрута чувствительны к направлению грузовика при их достижении, поэтому обращайте внимание на любые наземные маркировки вблизи точки маршрута, чтобы правильно сориентироваться.<br><br><font face=/font/big_bold.font>Двигайтесь вперёд к точке маршрута, расположенной перед вами.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Вы достигли точки маршрута и теперь можете перейти к следующему шагу. <br><br>Ещё одна точка позади вас, куда вы должны сдать назад. Обратите внимание на стрелку, указывающую, в какую сторону должен быть направлен грузовик, когда вы достигнете этой точки. <br><br>Ещё одно условие выполнения и бонуса, которое необходимо учитывать — это <color value=@@clr_sel@@>изменения направления<color value=@@clr_txt@@>. Мы считаем, сколько раз вы меняете направление между движением вперёд и назад. Не превышайте лимиты, чтобы выполнить условия.<br><br><font face=/font/big_bold.font>Двигайтесь назад к точке маршрута и остановитесь.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Итак, на данный момент вы должны были использовать одно изменение направления. <br><br>Подцепите прицеп позади вас, чтобы перейти к следующему шагу. <br><br><font face=/font/big_bold.font>Для сцепки подъедьте под прицеп задним ходом.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Последняя парковка находится справа. В некоторых упражнениях может быть только одно парковочное место, а в некоторых — несколько на выбор. Правильная парковка в любом из мест позволит вам завершить упражнение. <br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_attach@@, чтобы зацепить прицеп.</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Места для парковки также указывают, в какую сторону должен быть ориентирован грузовик. Припаркуйтесь в неправильном направлении, и вы не сможете завершить упражнение, пока не исправите ситуацию, что будет стоить вам времени и смены направления.<br><br><font face=/font/big_bold.font>Подъезжайте к одному из парковочных мест и припаркуйтесь правильно.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Мастерство вождения"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Теперь вы знакомы с новыми условиями прохождения и бонусными целями, а значит готовы к решению новых задач Мастерства вождения!<br><br><font face=/font/big_bold.font>Включите стояночный тормоз и выключите двигатель, чтобы завершить упражнение.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Короткий путь"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "В этом упражнении вы воспользуетесь короткой дорогой, которая, к сожалению, заблокирована в конце. Так что вам придётся вернуться назад, двигаясь задним ходом."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Двигайтесь до точки маршрута на вершине холма, а затем спуститесь по той же дороге обратно. <br><br>Вернувшись на дорогу, направляйтесь до конечной парковки."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Ранняя пташка"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "В этом упражнении вам придётся двигаться через переполненную стоянку. Пространство крайне ограничено, поэтому постарайтесь заранее спланировать свои действия."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Бывают моменты, когда парковка настолько заполнена, что другие водители паркуются, где только смогут в течение ночи. Это может затруднить маневрирование вокруг них утром.<br><br>Сделайте все возможное, чтобы добраться до конечного парковочного места."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Извилистый маршрут"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "В этом упражнении вам нужно проехать очень сложный учебный маршрут. По пути вы должны найти и зацепить прицеп, а затем доставить его до конца."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Это упражнение проверит вашу пространственную и ситуационную осведомлённость. Маршрут впереди полон препятствий, которые вы не всегда сможете легко заметить."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Двигайтесь по маршруту к прицепу. Как только вы его обнаружите, подцепите и доставьте его к месту парковки."



#@}

