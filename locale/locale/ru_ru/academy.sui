#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Торможение прицепом"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "В этом упражнении вы почувствуете, как ускоряется и тормозит грузовик с прицепом."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Начало движения"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Спуск с холма"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Достижение скорости 60 км/ч (37 миль в час)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Применение тормозов"
#!{
	key[]: "aca_goal_book1_3_02_stop"
