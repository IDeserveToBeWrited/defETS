#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Добро пожаловать на первую часть выпускного экзамена. Здесь мы проверим, насколько хорошо вы научились водить грузовик после обучения в Академии."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Сначала вы подцепите прицеп. После чего вы проедете на грузовике по всему испытательному полигону."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Первый участок трассы ведёт от небольшой парковки к восточному тестовому полигону."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Автодром включает в себя сложные проезды между ограждениями."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Значительная часть маршрута проходит через восточную испытательную трассу."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Мы проверим вашу способность маневрировать в различных ситуациях."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Вам предстоит маневрировать на грузовике, преодолевая крутые повороты."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Вы проедете по участку дороги, соединяющей маршруты."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Последняя часть включает в себя движение по небольшому автодрому."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "На этом автодроме много запутанных проездов и резких поворотов."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Чтобы завершить тест, вам нужно аккуратно припарковаться."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Не стоит нервничать, вы уже выучили всё, что потребуется для сдачи экзамена.<br><br>Удачи!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Перед вами прицеп.<br><br><font face=/font/big_bold.font>Двигайтесь к нему. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Выровняйте тягач с прицепом.<br><br><font face=/font/big_bold.font>Двигайтесь назад до соединения со шкворнем. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Поставьте грузовик на стояночный тормоз. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Нажмите @@imv_nrm_attach@@<font face=/font/big_bold.font>, чтобы подцепить прицеп. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Прицеп подсоединен, и грузовик готов к движению.<br><br><font face=/font/big_bold.font>Отпустите стояночный тормоз. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Начните движение в сторону выезда с парковки. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Следуйте дорожной разметке и следите за препятствиями.<br><br><font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Впереди более сложный участок.<br><br><font face=/font/big_bold.font>Осторожно перемещайтесь между барьерами. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Эта часть проверит ваши навыки маневрирования прицепом на различных поворотах.<br><br><font face=/font/big_bold.font>Поверните на маршрут. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Проезжайте через проход. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Двигайтесь прямо. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Осторожно пройдите поворот. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Вы въезжаете на более сложный участок.<br><br><font face=/font/big_bold.font>Продолжайте движение вниз по склону. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Резко поверните налево. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Выезжайте с автодрома. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Вы переходите на более лёгкий участок.<br><br><font face=/font/big_bold.font>Продолжайте ехать вниз по склону. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Продолжайте ехать по дороге. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Впереди поворот на следующий участок.<br><br><font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Поверните вправо. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Продолжайте движение по маршруту. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Впереди ещё больше крутых поворотов.<br><br><font face=/font/big_bold.font>Грамотно выбирайте скорость. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Поверните налево. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Войдите в поворот, продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Чтобы сделать поворот, вам, возможно, придётся немного съехать с асфальта.<br><br><font face=/font/big_bold.font>Поворачивайте осторожно, используйте столько места, сколько нужно. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Покиньте автодром и заезжайте на парковку. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Выпускной экзамен (Часть 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Вас ждёт последняя часть финального экзамена, где будут оцениваться навыки парковки, полученные в предыдущих упражнениях. Паркуйтесь осторожно и аккуратно, и вы будете готовы отправиться в путь по дорогам Европы в качестве опытного дальнобойщика!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Парковка со смещением"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Диагональная парковка"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Проезд через парковку"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Параллельная парковка"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Последняя парковка"
