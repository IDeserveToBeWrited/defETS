#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Тренажер заднего хода"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "В этом упражнении вы на пустой парковке, чтобы попрактиковаться в движении задним ходом с двойным прицепом."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Перед началом движения"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Эксперименты"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Завершение"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Завершение упражнения"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Движение задним ходом с двойным прицепом требует гораздо большего внимания, чем с одиночным. Вам необходимо заранее спланировать, куда вы хотите направить задний прицеп, не забывая при этом о переднем и тягаче. <br><br>Держите в голове: вы должны использовать передний прицеп для управления задним."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "В данном случае мы хотим повернуть задний прицеп в сторону водителя. Чтобы это сделать, нам нужно прижать переднюю часть заднего прицепа к стороне пассажира. <br><br>Обратите внимание, что это, по сути, означает, что вы должны повернуть передний прицеп в противоположную сторону, чтобы управлять задним прицепом."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Как только задний прицеп начнёт поворачивать, необходимо выровнять тягач с передним прицепом. Именно здесь большинство людей часто совершают свою первую ошибку."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Здесь мы видим, что водитель не следовал указаниям и вот-вот сложит прицеп."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Складывание происходит, когда угол между любыми двумя сцепками становится равным примерно 90 градусам. Как только это произойдёт, спасения уже не будет — вы должны проехать вперёд и предпринять ещё одну попытку. <br><br>Как и при движении назад с одним прицепом, необходимо чтобы все колёса прицепа двигались. Если одно колесо останавливается, то прицеп разворачивается на месте и вы не можете продолжить движение."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Вы можете вернуться к тому месту, где ещё двигались правильно, или, скорее, к положению, в котором вы можете продолжить движение назад, не допуская повторения той же ошибки. <br><br>В этом случае мы протянем вперёд и выровняемся, а затем повторим попытку сначала."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "И снова, когда задний прицеп начнёт поворачивать, держите тягач прямо и дайте заднему прицепу на мгновение повернуть самостоятельно."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Теперь, когда задний прицеп поворачивает туда, куда мы хотим, самое время направить передний, чтобы следовать за ним. Вы можете регулировать угол между передней и задней частью сцепки, чтобы контролировать поворот и делать его более резким или широким."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Заключительная часть манёвра — привести всё в порядок. Следите за тем, чтобы ведущий прицеп был на одной линии с замыкающим."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Не забывайте о времени, необходимом для перемещения переднего прицепа — если вы будете ждать слишком долго, задний прицеп в итоге попытается вернуться туда, откуда вы только что приехали!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Вы можете провести здесь столько времени, сколько захотите — экспериментируйте с различными манёврами, пока не поймёте, что у вас есть приблизительное представление о том, как управлять прицепами двигаясь назад. <br><br>Но главное, не забывайте получать от этого удовольствие!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Приготовьтесь к началу движения."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Воспользуйтесь этой парковкой, чтобы получить представление о том, как управлять прицепами, двигаясь назад. <br><br>@@aca_goal_tip@@. Впервые пытаетесь двигаться назад? Воспользуйтесь разделом \"Основы вождения грузовика\"."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Тренируйтесь столько, сколько захотите. <br><br>Когда вы будете удовлетворены, остановитесь и активируйте ручной тормоз, чтобы завершить упражнение."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Заглушите двигатель, чтобы завершить упражнение."
#@}


