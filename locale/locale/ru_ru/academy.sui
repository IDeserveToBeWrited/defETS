#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Следующий маршрут поможет вам освоить выполнение поворотов на 90 градусов различной сложности с двойными прицепами."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Первые несколько поворотов довольно широкие, с достаточным пространством. Используйте их, чтобы почувствовать прицепы позади вас во время поворота."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Следующие повороты станут круче и сложнее. Приближайтесь к ним медленно и заезжайте в повороты достаточно широко, чтобы у ваших прицепов было достаточно места для движения."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Это один из самых крутых поворотов на маршруте. Возможно, вам поможет небольшое пространство справа, чтобы объехать эти надоедливые внутренние конусы."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Следующий поворот всегда должен быть у вас в голове — после прохождения одного поворота составьте план подготовки к следующему."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Всегда внимательно следите за своими прицепами, пока они не отъедут от любых препятствий."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Двигайтесь вперёд к первому повороту."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Обращайте внимание на зеркала заднего вида во время движения, чтобы понимать, как прицепы движутся позади вас."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Держитесь шире перед каждым поворотом, это важно, чтобы обеспечить пространство, необходимое для того, чтобы прицепы завернули за угол."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Правильная подготовка к следующим нескольким поворотам имеет решающее значение, поскольку после них следует очень крутой вираж. Ошибка в начале может дорого обойтись вам позже.<br><br>Действуйте не спеша и тщательно, обращая внимание на окружающую обстановку."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Этот поворот чрезвычайно крутой и плавно переходит в следующий крутой поворот. Вам нужно будет продумать не только вход в поворот, но и выход из него, а также подготовку к следующему."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Продолжайте движение через последние повороты к обозначенной зоне."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Первое движение назад"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "В этом упражнении мы впервые осуществим движение задним ходом с двойным прицепом."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Расслабьтесь, не волнуйтесь"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Движение назад с двойным прицепом требует совершенно нового подхода к тому, что вы делаете. Вместо того чтобы просто управлять прицепом, вы используете ведущий прицеп для управления прицепом, идущим за ним. <br><br> Используйте это упражнение, чтобы понять, как всё работает. Конкретной цели нет, просто не торопитесь и постарайтесь разобраться в происходящем."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Из прямолинейного положения вы можете повернуть свой грузовик в том направлении, в котором хотите, чтобы двигался задний прицеп. <br><br>Не переусердствуйте; вам нужно лишь направить задний прицеп в нужном направлении, а затем выровнять тягач с ведущим прицепом и позволить заднему прицепу делать своё дело."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Как только задний прицеп направится в нужное вам место, вы можете скорректировать направление движения ведущего прицепа. <br><br>Как только ведущий прицеп последует за ним, с помощью тягача отрегулируйте угол между двумя прицепами, чтобы сделать угол более крутым или более широким."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Не существует идеальной формулы успеха, нужно лишь внимательно следить за происходящим, учиться на своих ошибках и постоянно практиковаться. <br><br>Когда убедитесь, что всё в порядке, можете направиться в обозначенное место и зафиксировать грузовик. <br><br>Не стесняйтесь экспериментировать здесь столько времени, сколько посчитаете нужным."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Начинайте движение назад медленно. Начинайте с небольших движений, не нужно сразу же резко разворачивать руль.<br><br>Постарайтесь двигаться прямо назад или подъехать прицепами к стороне водителя."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Не торопитесь и не расстраивайтесь. <br><br>Каждый мастер был когда-то новичком."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Исправление ошибки"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "В этом упражнении нам придётся продолжить с того места, где остановился кто-то другой."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Движение назад"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Да уж! Кто-то немного рассердился, сдавая назад, и оставил свой грузовик посреди стоянки."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Неизбежно будут моменты, когда вы окажетесь в совершенно безвыходной ситуации. Не волнуйтесь, просто вытащите машину из положения складывания, пока не получите что-то, с чем можно работать. <br><br>Если не уверены, постарайтесь выровнять в одну линию, чтобы начать с чистого листа."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Это неплохая отправная точка. Задний прицеп по-прежнему направлен туда, куда нам нужно, и мы можем быстро вывести тягач перед ведущим прицепом, чтобы начать направлять всю сцепку в нужное нам место."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Двигайтесь к указанному месту и зафиксируйте грузовик. <br><br>Вы можете потренироваться в этом упражнении, пока не почувствуете себя уверенно в управлении двойной сцепкой."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Из этой передряги нет выхода. Продвигайтесь вперёд, чтобы вам было с чем работать."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Начинайте движение задним ходом."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Прямая назад"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "В этом упражнении вам нужно двигаться назад с двумя прицепами по прямой линии."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Движение назад"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Движение назад по прямой может казаться простым на первый взгляд, но на самом деле это гораздо сложнее. <br><br>Вместо того чтобы увеличивать или уменьшать угол между прицепами с одной стороны, вы должны работать с обеих сторон, чтобы сцепка оставалась прямой."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Начните с относительно небольших корректировок. Ничего страшного, если в итоге вы будете раскачиваться из стороны в сторону, имейте в виду, что вам нужно будет немного дольше удерживать угол между грузовиком и передним прицепом, чтобы изменить угол между передним и задним прицепами."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Возможно, вам придётся совершать довольно сложные манёвры грузовиком, чтобы удерживать задний прицеп в нужном положении, не переусердствуйте в самом начале и вам не придётся это делать."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Вы можете несколько раз протянуть вперёд, чтобы исправить ситуацию. Главное, чтобы в итоге вы благополучно припарковались, остальное не имеет значения."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Не спеша двигайтесь задним ходом."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Выпрямитесь и остановитесь в обозначенном месте."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Поставьте грузовик на стояночный тормоз и заглушите двигатель."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Исправление прямой назад"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "В этом упражнении вы сядете за руль после кого-то, кто уже попытался двигаться задним ходом по прямой. Исправьте его ошибку и припаркуйте грузовик в указанном месте."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Выравнивание"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Движение назад"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
