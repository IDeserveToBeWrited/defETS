#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Курс повышения квалификации"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Последнее упражнение в этой теме — поездка по сложному учебному маршруту. Мы проверим ваши навыки управления тягачом!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Слалом"

