#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Fahren durch anspruchsvolle Kurven"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In diesem Szenario üben wir das Manövrieren des Aufliegers durch einen kurzen Hindernisparcours mit anspruchsvolleren Kurven."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Erste Kurven"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Fahren durch eine enge Passage"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Enge 90-Grad-Kurve"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Fahre um die Absperrungen herum"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Vor dir liegen verschiedene anspruchsvolle Kurven und Hindernisse.<br>Berücksichtige alles, was du bisher gelernt hast, und es sollte nicht allzu schwierig sein."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Die Fahrbahnmarkierungen können dir dabei helfen, eine Vorstellung davon zu bekommen, wie du jedes Hindernis durchfahren solltest."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Halte die Zugmaschine an der Außenseite der Kurve.<br>Du musst weit ausholen, da der Auflieger einem kürzeren Weg folgt."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Die nächste Kurve ist eine einfache 90-Grad-Kurve.<br>Halte den Lkw erneut an der Außenseite der Kurve und nutze den gesamten verfügbaren Platz."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Lass dir hier Zeit. Der Parcours wird zwar breiter, aber du musst weiterhin präzise bleiben."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Halte großzügigen Abstand zu den Absperrungen."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Sei vorsichtig, wenn du in diesen engen Abschnitt einfährst.<br>Lenke die Zugmaschine weit aus, bevor du einfährst, um den Auflieger richtig auszurichten."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Die letzte 90-Grad-Kurve ist deutlich schärfer als die erste, aber es gibt ausreichend Platz, wenn du deinen Raum klug nutzt."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Halte im vorgesehenen Bereich an, sichere den Lkw und schalte den Motor aus."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Denke daran, die Fahrbahnmarkierungen zu nutzen, um dir die Navigation durch den Parcours zu erleichtern.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Die Verwendung deiner Spiegel hilft dir ebenfalls, den Parcours sicher zu durchfahren. Du musst stets im Blick behalten, wie dir der Auflieger folgt.<br><br><font face=/font/big_bold.font>Fahre durch die erste Kurve. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Beobachte den Auflieger, während du die Kurve verlässt, und bereite dich darauf vor, in die nächste Kurve einzufahren.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fahre durch die nächste Kurve. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Achte darauf, deinen Auflieger im Blick zu behalten, um sicherzugehen, dass du alle Hindernisse um dich herum passiert hast, bevor du den Lkw einlenkst.<br><br><font face=/font/big_bold.font>Umfahre die Absperrung vor dir. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Sobald der Auflieger die Absperrung passiert hat, lenke stark zur Beifahrerseite, um dich für die enge Passage auszurichten.<br><br><font face=/font/big_bold.font>Fahre zur engen Passage vor.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Dieser Abschnitt erfordert sehr präzises Fahren. Lass dir Zeit und nutze deine Spiegel.<br><br><font face=/font/big_bold.font>Halte dich an der Außenseite jeder Kurve. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Diese Kurve ist sehr scharf, aber du kannst den gesamten Platz vor dir nutzen, um sie problemlos zu meistern.<br><br><font face=/font/big_bold.font>Fahre die letzte Kurve. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Fortgeschrittener Trainingskurs – Auflieger"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "Im letzten Szenario von Kapitel 3 fahren wir auf einem längeren Trainingskurs mit verschiedenen Kurven, um zu sehen, wie gut du das Manövrieren mit einem Auflieger gelernt hast."

