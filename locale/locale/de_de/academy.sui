	key[]: "aca_msg_book1_2_02_check3_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/turning1_2_02.mat width=202 height=221 color=FFFFFFFF></align><offset vshift=221>"

	key[]: "aca_msg_book1_2_02_check3_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/turning_gb_1_2_02.mat width=202 height=221 color=FFFFFFFF></align><offset vshift=221>"
#!}

#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Kombinierte Fahrmanöver"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "In diesem Szenario werden wir deine neu erlernten Fähigkeiten kombinieren, um einen kurzen, aber technischen Kurs zu bewältigen, der das Rückwärtsfahren in eine Kurve und das Manövrieren durch eine enge 90-Grad-Kurve umfasst."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Rückwärtsfahren zur Fahrerseite"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "90-Grad-Kurve"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Abschließen der Kurve"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Vor dir befindet sich eine Absperrung. Fahre bis zu ihr vor und halte an."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Hinter dem Lkw auf der Fahrerseite befindet sich eine weitere Absperrung. Fahre rückwärts um die Kurve bis dorthin. Die Straßenmarkierungen können dir als Orientierungshilfe dienen."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Direkt voraus befindet sich eine scharfe 90-Grad-Kurve. Fahre darauf zu."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Wir müssen tief in die Kurve hineinlenken, damit die Hinterräder den Leitkegel an der Innenseite der Kurve nicht streifen.<br>Benutze deine Spiegel!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Fahre gerade, steuere auf die letzten Absperrungen zu, halte an und sichere den Lkw."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Der Lkw ist noch nicht bereit zur Abfahrt – hast du vielleicht etwas vergessen?<br><br>Ist der Motor eingeschaltet? Hast du die Feststellbremse gelöst?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Direkt vor dir befindet sich ein markierter Bereich kurz vor der Absperrung.<br><br><font face=/font/big_bold.font>Fahre vorwärts und halte im markierten Bereich an. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Schau hinter dich auf der Fahrerseite; dort siehst du einen weiteren markierten Bereich. Du musst das Rückwärtsfahren mit gleichzeitigem Lenken kombinieren.<br><br><font face=/font/big_bold.font>Fahre rückwärts um die Kurve und halte im markierten Bereich an. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Der Kurs führt dich vor dir durch eine 90-Grad-Kurve weiter.<br><br>Halte dich vor der Kurve auf der linken Seite, fahre tief in die Kurve hinein und lenke dann schnell und scharf ein. Achte darauf, den Leitkegel auf der Innenseite nicht zu berühren.<br><br><font face=/font/big_bold.font>Fahre vorwärts und nimm die Kurve. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Nutze deine Front- und Seitenspiegel, um sicherzustellen, dass du nichts berührst.<br><br><font face=/font/big_bold.font>Fahre um die Kurve und halte im ausgewiesenen Bereich an. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Schalte den Motor aus und sichere den Lkw.</font>"
#@}

