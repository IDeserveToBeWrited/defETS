	key[]: "aca_goal_book1_3_19_check15"
	val[]: "Komplexe Durchfahrt"

	key[]: "aca_goal_book1_3_19_check16"
	val[]: "Anspruchsvolle Kreuzung"

	key[]: "aca_goal_book1_3_19_check17"
	val[]: "Leichtere Kurven"

	key[]: "aca_goal_book1_3_19_check18"
	val[]: "Weite Kurve"

	key[]: "aca_goal_book1_3_19_check19"
	val[]: "Äußerst enge Kurve"

	key[]: "aca_goal_book1_3_19_check20"
	val[]: "Verlassen des Rundkurses"
