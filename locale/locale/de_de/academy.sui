#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Schrägparken"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "In diesem Szenario parkst du in einer Parklücke mit Schrägaufstellung auf einem belebten Parkplatz.<br><br>Es gibt nicht viel Platz zum Manövrieren, daher musst du beim Fahren sehr genau und überlegt vorgehen."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Annäherung an die Parklücke"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Schrägparklücken wie diese sind sehr verbreitet, besonders an den vielen Raststätten entlang der europäischen Autobahnen.<br>Wie zuvor müssen wir auch hier wieder in die Parklücke vor uns einparken."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Fahre in Richtung der vorgesehenen Parklücke am Ende der Reihe."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Halte dich in der Mitte der Spur oder leicht zur Fahrerseite. Fahre nicht zu nah an den Barrieren vorbei, da sonst das Heck des Aufliegers während des Einlenkens dagegen stoßen könnte."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Fahre ein Stück über die Parklücke hinaus und lenke dann schnell und kräftig in Richtung der Lücke. Achte dabei auf beide Seitenspiegel: Im Fahrerspiegel, um sicherzustellen, dass die Front deines Aufliegers nicht den nebenstehenden Auflieger berührt, und im Beifahrerspiegel, um zu überprüfen, dass dein Auflieger sicher in die Parklücke einfährt."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Halte im vorgesehenen Bereich an, sichere den Lkw und stelle den Motor ab."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Beim Schrägparken ist es wichtig, deine Position genau einzuschätzen. Sobald du ein Stück in die Kurve eingefahren bist, wird es schwierig, sicher rückwärts zu fahren und dich neu zu positionieren. Daher ist es ideal, beim ersten Versuch genügend Platz zu haben.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Beginne, in Richtung der Parklücke zu fahren.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Fahre an der Parklücke vorbei, damit dein Auflieger Platz hat, um sich um den Lkw auf der Innenseite zu drehen.<br><br><font face=/font/big_bold.font>Lenke in die Parklücke ein.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Rückwärtsfahren im toten Winkel"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "In dieser Lektion werden wir das Rückwärtsfahren im toten Winkel üben, um den Lkw in eine Parklücke zu manövrieren. Da du nicht aus dem Fenster schauen kannst, um zu sehen, wo du hinfährst, musst du dich ausschließlich auf deine Spiegel verlassen, um dorthin zu gelangen, wo du hin musst."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "In dieser Lektion wirst du das Rückwärtsfahren im „toten Winkel“ lernen. Das Rückwärtsfahren in dieser Position sollte im Allgemeinen vermieden werden, es sei denn, es gibt keine Alternative, da deine Sicht stark eingeschränkt ist. Nimm dir Zeit und gehe äußerst vorsichtig vor."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Fahre gut über die Parklücke hinaus, um dir genügend Platz zu verschaffen, sobald du mit dem Rückwärtsfahren beginnst."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Halte an, überprüfe deine Umgebung und beginne dann mit dem Rückwärtsfahren."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Lenke die Zugmaschine von der Parklücke weg. Dadurch wird die Front des Aufliegers gedreht, was wiederum das Heck des Aufliegers in Richtung der Parklücke ausrichtet, in die du fahren möchtest. Achte darauf, es nicht zu übertreiben, da du sonst das Risiko eines „Knickens“ der Kombination eingehen kannst."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Wenn der Auflieger in die Parklücke einfährt, beginne, die Zugmaschine wieder gerade auszurichten."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Halte im vorgesehenen Bereich an und sichere den Lkw."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Das Rückwärtsfahren im toten Winkel erfordert die gleichen Verfahren wie das Rückwärtsfahren auf der sichtbaren Seite, aber du wirst durch die eingeschränkte Sicht auf dieser Seite benachteiligt. Nutze deine Spiegel und dein bestes Urteilsvermögen, um den Lkw zu parken.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Vor dir befindet sich eine Parklücke auf der Beifahrerseite. Du musst weit über die Parklücke hinausfahren, damit du ausreichend Platz zum Manövrieren beim Rückwärtsfahren hast.<br><br><font face=/font/big_bold.font>Fahre vorwärts.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Denke daran, dass das Wenden des Lkw von der Parklücke weg den Auflieger in Richtung der Parklücke dreht. Nutze deine Spiegel bestmöglich, um dir beim Einparken zu helfen.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren.</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Fahren im Kreisverkehr"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "In dieser Lektion schauen wir uns an, wie man einen Kreisverkehr richtig durchfährt.<br><br>Achte besonders auf deinen Auflieger, da er deinem Weg anders folgt, wenn du in den Kreisverkehr ein- und wieder ausfährst."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Einfahren in den Kreisverkehr"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Fahren im Kreisverkehr"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Fahren im Kreisverkehr"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Ausfahren aus dem Kreisverkehr"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Fahren zum vorgesehenen Bereich"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Kreisverkehre sind in den Straßen Europas sehr verbreitet, daher ist es wichtig zu wissen, wie man sie richtig durchfährt."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Halte dich an der Außenseite deiner Spur, während du dich dem Kreisverkehr näherst. Das wird helfen, dass dein Auflieger die Innenseite der ersten Kurve gut passiert."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Fahre beim Einfahren in die Mitte des Kreisverkehrs. Sobald du im Kreisverkehr bist, musst du zur Außenseite steuern. Dadurch bleibt dein Auflieger von der Mitte des Kreisverkehrs fern."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Behalte deinen Spiegel im Auge, um sicherzustellen, dass der Auflieger nicht zu nah an die inneren Barrieren kommt."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Das Verlassen des Kreisverkehrs ist relativ einfach, da dein Auflieger bereits von der Innenseite der Ausfahrt weg positioniert ist. Lenke weit aus, wenn du die Ausfahrt nimmst, und der Auflieger sollte gut folgen."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parke im vorgesehenen Bereich und sichere den Lkw."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Vor dir befindet sich ein Kreisverkehr, in den du einfahren kannst.<br><br><font face=/font/big_bold.font>Fahre langsam auf den Kreisverkehr zu.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Nimm beim Einfahren in den Kreisverkehr eine weite Kurve, damit dein Auflieger problemlos hinter dir einfährt.<br><br><font face=/font/big_bold.font>Fahre in den Kreisverkehr ein.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Fahre zur Außenseite des Kreisverkehrs. Halte den Lkw so weit wie möglich von der Mitte des Kreisverkehrs entfernt, um den Auflieger von den inneren Barrieren fernzuhalten.<br><br><font face=/font/big_bold.font>Fahre weiter durch den Kreisverkehr.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Halte dich nah an den äußeren Leitkegeln.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Verlasse den Kreisverkehr.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Fahre zur Parklücke vor dir.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Halte im vorgesehenen Bereich an.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Sichere den Lkw und stelle den Motor ab.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manövrieren unter engen Platzverhältnissen"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "In diesem Szenario hast du die Aufgabe, den Lkw unter engen Platzverhältnissen zu wenden. Dabei musst du in einem Bereich mit begrenztem Platz zum Manövrieren im toten Winkel rückwärts fahren, was deine Aufmerksamkeit für die Umgebung und eine clevere Nutzung des Raums erfordert."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Fahren auf dem Kurs"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Vorbereitung für das Rückwärtsfahren im toten Winkel"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Rückwärts in die Parklücke einfahren"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Das Rückwärtsfahren im toten Winkel abschließen"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Ausfahrt aus dem Kurs"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In diesem Szenario lernst du, wie du in einem engen Raum durch Rückwärtsfahren im toten Winkel wenden kannst. Diese Technik ist besonders hilfreich, wenn eine Kehrtwende nicht möglich ist oder du auf der Fahrerseite keinen Platz zum Rückwärtsfahren hast."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Die Fahrbahnmarkierungen helfen dir dabei, dich auf dem Trainingskurs zurechtzufinden."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Mache eine weite Kurve, damit dein Auflieger sicher an den parkenden Lkws vorbeikommt."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Überlege beim Verlassen der Kurve, wie du den Lkw für dein Rückwärtsmanöver positionieren wirst."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Es hilft, den Lkw in einem Winkel zur leeren Parklücke auf der Beifahrerseite auszurichten, in die du rückwärts einparken wirst."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Das Rückwärtsfahren im toten Winkel sollte, wenn möglich, vermieden werden, da die Sicht deutlich eingeschränkt ist. Leider gibt es Situationen, in denen du keine andere Wahl hast."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Lenke das Rad ein, bevor du mit dem Rückwärtsfahren beginnst. So zeigt der Auflieger sofort in die gewünschte Richtung, was in sehr engen Situationen hilfreich ist."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Sobald der Auflieger gut in der Parklücke steht, positioniere die Zugmaschine vor dem Auflieger und richte sie gerade aus."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Halte an, sobald du geradeaus ausgerichtet bist und genügend Platz hast, um wieder vorwärtszufahren. Fahre dann den gleichen Weg zurück, den du hereingekommen bist."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Folge den Fahrbahnmarkierungen, um den Trainingskurs zu verlassen."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Fahre durch die Kurve vor dir und weiter zum vorgesehenen Bereich."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Anhalten."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Sichere den Lkw und stelle den Motor ab."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Im Bereich vor dir befindet sich ein Trainingskurs, der den Hof einer Spedition darstellt. Deine Aufgabe ist es, dorthin zu fahren, den Lkw zu wenden und wieder herauszufahren. Nutze den verfügbaren Platz gut aus.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Fahre zum Trainingskurs.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Biege um die Ecke und fahre durch den Kurs weiter.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Folge den Straßenmarkierungen bis zur Schranke am Ende des Kurses. Parke leicht schräg, sodass dein Auflieger in Richtung des freien Parkplatzes auf der Beifahrerseite zeigt.<br><br><font face=/font/big_bold.font>Fahre weiter vorwärts.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Beim Rangieren im toten Winkel ist deine Sicht auf das Umfeld stark eingeschränkt. Fahre langsam, nutze deine Spiegel und sei lieber zu vorsichtig.<br><br><font face=/font/big_bold.font>Beginne rückwärtszufahren und lenke den Auflieger in die freie Parklücke.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Das reicht aus. Du kannst jetzt vorwärts fahren und den Trainingsbereich in die gleiche Richtung verlassen, aus der du gekommen bist.<br><br><font face=/font/big_bold.font>Fahre in Richtung Ausfahrt.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Verlasse den Trainingskurs.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Folge den Straßenmarkierungen zum endgültigen Parkplatz.<br><br><font face=/font/big_bold.font>Fahre zum vorgesehenen Bereich.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Versetztes Rückwärtsfahr-Manöver"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "In diesem Szenario besteht deine Aufgabe darin, rückwärts in eine Parklücke einzuparken, die sich nicht direkt hinter dir befindet. Der Platz zum Manövrieren ist begrenzt, daher musst du den vorhandenen Raum klug nutzen."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "In diesem Szenario besteht deine Aufgabe darin, in die Parklücke neben dir einzuparken. Der Platz zum Manövrieren ist begrenzt, daher musst du etwas mehr Aufwand betreiben, um den Auflieger an die gewünschte Stelle zu bringen."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Fahre geradeaus bis zur Absperrung."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Halte vor der Absperrung an."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Lenke das Lenkrad vor dem Losfahren kräftig zur Fahrerseite ein. So beginnt der Auflieger sofort in Richtung der Parklücke zu schwenken, sobald du mit dem Rückwärtsfahren beginnst und du sparst wertvollen Platz."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Sobald der Auflieger in die gewünschte Richtung zeigt, bring die Zugmaschine vor den Auflieger und beginne, ihn in die Parklücke zu lenken."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Ab diesem Punkt unterscheidet es sich kaum mehr von einem gewöhnlichen Parkmanöver."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Fahre weiter rückwärts und beobachte beide Seiten. Halte die Zugmaschine und den Auflieger in einer Linie mit der Parklücke."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Halte im vorgesehenen Bereich an, sichere den Lkw und stelle den Motor ab."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Du befindest dich in einer Parklücke, aber rechts von dir gibt es eine zweite Parklücke, in die du umparken musst.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Vor dir befindet sich ein markierter Bereich.<br><br><font face=/font/big_bold.font>Fahre vorwärts.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Denke daran, sofort zu lenken, da nur wenig Platz vorhanden ist.<br><br><font face=/font/big_bold.font>Setze zurück bis zum markierten Bereich hinter dir.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Einfache Kurven fahren"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "In diesem Szenario machst du eine kurze Fahrt durch einen Trainingskurs, der dir hilft, den Auflieger durch einfache 90-Grad-Kurven zu manövrieren."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Nimm die erste Kurve"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Zweite Kurve"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Letzte Kurve"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Vor dir liegen einige enge Kurven mit wenig Platz. Diese helfen dir, den Auflieger effektiv zu manövrieren."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Folge den Straßenmarkierungen zur Absperrung auf der Fahrerseite, um dich auf die erste Kurve vorzubereiten."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Bleibe während der Kurve nah an der äußeren Absperrung, damit der Auflieger gut in den Kurs folgt."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Folge weiterhin den Straßenmarkierungen, um dich auf die zweite Kurve vorzubereiten – eine enge 90-Grad-Kurve."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Du musst tief in die Kurve hineinfahren, damit dein Auflieger die inneren Absperrungen nicht berührt. Nutze deinen Frontspiegel, um so weit wie möglich in die Kurve zu fahren, ohne etwas zu streifen."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Fahre entlang der äußeren Absperrung weiter."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Erneut erfordert eine enge 90-Grad-Kurve, dass du den gesamten verfügbaren Platz nutzt."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Halte im vorgesehenen Bereich an und sichere den Lkw."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Denke daran, den gesamten verfügbaren Platz zu nutzen, um jede Kurve gut zu meistern.<br><br><font face=/font/big_bold.font>Fahre los und folge den Straßenmarkierungen zur Außenseite.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Folge der äußeren Absperrung, aber behalte deinen Auflieger im Spiegel im Auge.<br><br><font face=/font/big_bold.font>Nimm die erste Kurve.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Folge den Straßenmarkierungen, um dich auf die bevorstehende 90-Grad-Kurve vorzubereiten.<br><br><font face=/font/big_bold.font>Nimm die 90-Grad-Kurve.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Positioniere den Lkw nach der Kurve möglichst weit außen, da eine noch engere 90-Grad-Kurve vor dir liegt.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Fahre zur Parklücke vor dir.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Schrägparken im Rückwärtsgang"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "In diesem Szenario werden wir das Schrägparken im Rückwärtsgang behandeln. Dies kann an Raststätten, Lkw-Parkplätzen und sogar bei Speditionen vorkommen. Oft ist der Platz begrenzt, da die Parkplätze mit Lkw überfüllt sind, was das Parken aufgrund des fehlenden Raums noch schwieriger macht."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Wende den Auflieger"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Schrägparken mag auf den ersten Blick leichter erscheinen, doch es kann in der Praxis oft schwieriger sein als die typischen „Gasseparken“-Manöver."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Setze rückwärts in Richtung der Parklücke. Halte die Zugmaschine und den Auflieger zunächst gerade."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Wenn du näher kommst, führe deinen Auflieger dichter an die parkenden Lkw heran. Das erleichtert es dir, ihn in die Parklücke zu lenken, sobald du dort angekommen bist."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Beginne, den Auflieger in die Parklücke zu lenken. Halte ihn nah am Lkw auf deiner Fahrerseite, da du den Platz auf der anderen Seite benötigen wirst."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Sobald der Auflieger gut in der Parklücke steht, beginne, die Zugmaschine so zu lenken, dass sie dem Auflieger in die Parklücke folgt."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parke im vorgesehenen Bereich, sichere den Lkw und stelle den Motor ab."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parke den Lkw in die Parklücke hinter dir. Nutze beide Spiegel, um dich beim Rückwärtsfahren zu orientieren.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Überprüfe deine Umgebung und fahre dann in Richtung der Parklücke.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Bewege den Auflieger in Richtung der Lkw neben dir. Wenn du soweit bist, lenke den Auflieger in die Parklücke. Denke daran, den Heckschwenk des Aufliegers zu berücksichtigen.<br><br><font face=/font/big_bold.font>Lenke in die Parklücke.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Rückwärts in eine Kurve fahren"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "In diesem Szenario werden wir zum ersten Mal mit einem Auflieger rückwärts in eine Kurve fahren. Wir werden die grundlegenden Prinzipien des Rückwärtsfahrens erkunden und lernen, worauf man beim Rückwärtsfahren in eine Kurve achten muss."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Wende den Auflieger"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "In diesem Szenario musst du rückwärts in die Parklücke fahren, die sich hinter dir auf der Fahrerseite befindet."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Es gibt ein paar Tipps, die dir beim Rückwärtsfahren mit Aufliegern sehr helfen werden.<br>Der erste ist, dass der Auflieger immer in die entgegengesetzte Richtung lenken möchte, als du mit der Zugmaschine steuerst."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Der zweite Tipp ist, dass du ein gutes Gefühl dafür bekommst, wohin der Auflieger steuert, wenn du die Achsen des Lkw und des Aufliegers im Blick behältst."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Drittens: Kleine Lenkeingaben bringen dich ans Ziel, es ist nicht nötig, übermäßig zu korrigieren."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Lenke die Zugmaschine leicht von der Parklücke weg, und der Auflieger wird sich in Richtung der Parklücke ausrichten."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Folge dem Auflieger und nimm dabei Anpassungen vor, um ihn auf dem richtigen Kurs zu halten."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Behalte die Räder des Aufliegers und das Hinterrad der Zugmaschine im Auge. Sie zeigen dir, in welche Richtung der Auflieger weist und wohin die Zugmaschine ihn schiebt."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Ein vierter Tipp ist, dass es immer einfacher ist, den Auflieger schärfer zu drehen, als ihn aus einem „Einknicken“ heraus zu begradigen. Ziele zunächst auf die Außenseite der Parklücke, bis du näher dran bist, dann kannst du etwas schärfer lenken, um den Auflieger auszurichten."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Während der Auflieger in die Parklücke einfährt, bring die Zugmaschine vor den Auflieger. Versuche, zu viele Anpassungen innerhalb der Parklücke zu vermeiden."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Fahre rückwärts zwischen die Absperrungen und überprüfe dabei beide Seiten."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Sichere den Lkw und stelle den Motor ab."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Merke dir diese Tipps, wenn du mit einem Auflieger rückwärts in eine Kurve fährst:<br><br>— Der Auflieger lenkt entgegengesetzt zu deiner Steuerung der Zugmaschine<br><br>— Beobachte die Räder des Aufliegers, um zu sehen, wohin er zielt<br><br>— Achte auf das Hinterrad der Zugmaschine, um zu sehen, wohin sie den Auflieger schiebt<br><br>— Lass den Auflieger die Arbeit machen, übersteuere nicht<br><br>— Es ist immer einfacher, den Auflieger schärfer zu drehen, als ihn geradezurichten<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Schau hinter dich, um zu sehen, wo du hinfahren musst. Achte immer auf deine Umgebung, bevor du mit dem Rückwärtsfahren beginnst.<br><br><font face=/font/big_bold.font>Beginne, rückwärts zur Parklücke zu fahren.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Lenke den Auflieger in Richtung der Parklücke und folge ihm hinein.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Halte im vorgesehenen Bereich an. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Rückwärtsparken auf einem engen Parkplatz"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "In diesem Szenario besteht deine Aufgabe darin, den Auflieger rückwärts in eine Parklücke auf einem vollen Parkplatz einzuparken."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Wende den Auflieger"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Dies ist ein typischer Parkplatz für Lkw. Berufskraftfahrer begegnen einer solchen Parksituation fast täglich in ihrem Berufsleben.<br>Das Parken hier erfordert ein „Gasseparken“-Manöver."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Dies ist ein ähnliches Manöver wie im vorherigen Szenario, jedoch mit weniger Platz, sodass du deine Bewegungen sorgfältig planen musst und darauf achten solltest, nichts zu berühren."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Da weniger Platz zur Verfügung steht, ist dein Timing entscheidend. Lenke den Auflieger im richtigen Moment und beobachte die Räder von Zugmaschine und Auflieger, um zu sehen, wohin er sich bewegt. Achte auf den Heckschwenk und vermeide ein Einknicken – schiebe den Auflieger kontinuierlich weiter."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Bleibe nah am Lkw auf deiner Fahrerseite, so hat dein Auflieger Platz zum Schwenken, und du musst dir weniger Sorgen um den Lkw auf deiner Beifahrerseite machen."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Sobald dein Auflieger in der Parklücke steht, bring die Zugmaschine davor. Es ist besser, dies etwas früher zu tun, als dein Instinkt dir vielleicht zunächst vorgibt. Du kannst beim Rückwärtsfahren jederzeit Korrekturen vornehmen, um die endgültige Position zu erreichen."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Bringe die Zugmaschine und den Auflieger in eine gerade Linie und halte im vorgesehenen Bereich an."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Sichere den Lkw und stelle den Motor ab."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Jetzt werden wir versuchen, einen Auflieger in einem deutlich kleineren Bereich mit einem „Gasseparken“-Manöver zu wenden.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Überprüfe deine Umgebung und suche die Parklücke hinter dir.<br><br><font face=/font/big_bold.font>Beginne rückwärts in Richtung der Parklücke zu fahren.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Lenke den Auflieger in die Parklücke.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Abschlussprüfung (Teil 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Die Abschlussprüfung erwartet dich, in der alle Fähigkeiten, die du in den vorherigen Szenarien gelernt hast, auf die Probe gestellt werden. Wir machen eine Fahrt durch das gesamte Trainingszentrum, um zu sehen, wie gut du die bisher erlernten Fähigkeiten anwenden kannst.<br><br>Sobald du alle Abschnitte und Manöver abgeschlossen hast, bist du einen Schritt näher dran, dich als ausgebildeter Lkw-Fahrer zu bezeichnen!"

