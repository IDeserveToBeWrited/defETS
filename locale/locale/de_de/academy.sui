#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "In diesem Szenario werden wir zum ersten Mal einen Auflieger an- und abkuppeln. Mache den Lkw bereit und fahre dann rückwärts unter den Auflieger hinter dir."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Kupple den Auflieger an und fahre dann vorwärts."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Halte im markierten Bereich an."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Kupple den Auflieger ab und fahre vorwärts."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Parke in der Parklücke und sichere den Lkw."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "In diesem Szenario erläutern wir die Vorgehensweise zum An- und Abkuppeln von Zugmaschine und Auflieger. Das Verfahren ist vereinfacht dargestellt und unterscheidet sich von den komplexeren Abläufen im realen Berufsalltag eines Lkw-Fahrers. ￼<br><br><font face=/font/big_bold.font>Mach dich bereit für die Abfahrt.</font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Hinter der Zugmaschine befindet sich ein Auflieger. Fahre langsam rückwärts unter den Auflieger, bis die Sattelkupplung den Königszapfen erreicht. Der Lkw ist aktuell korrekt ausgerichtet, sodass kein Lenken erforderlich ist – fahre einfach gerade rückwärts.<br><br><font face=/font/big_bold.font>Fahre langsam rückwärts, bis du eine Verbindung spürst. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Die Sattelkupplung hat sich mit dem Königszapfen verbunden.<br><br><font face=/font/big_bold.font>Sichere den Lkw, indem du die Feststellbremse anziehst. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Im echten Leben verriegelt die Sattelkupplung automatisch den Königszapfen. Anschließend müsste der Fahrer aussteigen, um das Stützrad einzufahren und die Luft- sowie Elektroleitungen anzuschließen.<br><br><font face=/font/big_bold.font>Für uns reicht es, einfach @@imv_nrm_attach@@ zu drücken, um den Auflieger zu verbinden. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Jetzt, da die Zugmaschine sicher mit dem Auflieger verbunden ist, bist du bereit, vorwärts zu fahren. Bedenke, dass dein Fahrzeug nun erheblich länger und schwerer ist und neue Fertigkeiten im Umgang erfordert.<br><br><font face=/font/big_bold.font>Löse die Feststellbremse und bereite dich darauf vor, vorwärts zu fahren. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Fahre vorwärts.<br><br><font face=/font/big_bold.font>Halte im markierten Bereich vor dir an. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Ziehe die Feststellbremse an. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aktiviere die Feststellbremse. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Im echten Leben müsste der Fahrer erneut aussteigen, das Stützrad absenken, die Luft- und Elektroleitungen trennen und die Verriegelung der Sattelkupplung lösen.<br><br><font face=/font/big_bold.font>Wir vereinfachen diesen Vorgang für dich, sodass das Drücken von @@imv_nrm_attach@@ den Auflieger trennt. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Löse die Feststellbremse. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Ziehe die Zugmaschine unter dem Auflieger hervor und fahre vorwärts.<br><br><font face=/font/big_bold.font>Halte im markierten Bereich an. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Halte im markierten Bereich an.</font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Bremsen mit einem Auflieger"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "In diesem Szenario bekommst du ein Gefühl dafür, wie es sich anfühlt, mit angekoppeltem Auflieger zu fahren und zu bremsen."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Abfahrt"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Fahre den Hügel hinunter"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Erreiche eine Geschwindigkeit von 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Betätige die Bremsen"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"



 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "In diesem Szenario machen wir eine kurze Fahrt mit dem Lkw. Du wirst ein Gefühl dafür bekommen, wie es ist, mit angekoppeltem Auflieger zu bremsen, während wir den Hügel hinabfahren. Bereite den Lkw vor und fahre los."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Erreiche eine Geschwindigkeit von mindestens 60 km/h (37 mph). Sei bereit für die kommende Bremszone."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Beginne zu bremsen, um zum Stillstand zu kommen. Warte nicht zu lange, sonst könntest du die Absperrungen vor dir rammen!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parke im vorgesehenen Bereich, sichere den Lkw und schalte den Motor aus."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Auf dieser Fahrt bekommst du ein Gefühl für die Nutzung der Betriebsbremse beim Abfahren einer Gefällestrecke. Ziel dieser Übung ist es, dir das Gewicht des Aufliegers bewusst zu machen und zu verstehen, wie es den Bremsweg des Fahrzeugs beeinflusst.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Beginne jetzt zu fahren und bedenke, dass du eine Geschwindigkeit von 60 km/h (37 mph) erreichen musst.<br><br><font face=/font/big_bold.font>Fahre durch die Kurve. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Beschleunige weiter den Hügel hinunter. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Erreiche eine Geschwindigkeit von mindestens 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Du hast die erforderliche Geschwindigkeit erreicht.<br><br><font face=/font/big_bold.font>Halte an den Absperrungen vor dir an. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

