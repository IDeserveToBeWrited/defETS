#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Anhalten knapp vor einem Hindernis"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "In diesem Szenario sprechen wir über den Frontspiegel – seine Position und wie man ihn effektiv nutzt, um nah an einem Hindernis vor sich anzuhalten."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Kontrolliere den Frontspiegel"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Verstehe seine Funktionsweise"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Halte knapp vor dem Hindernis an"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Lkw haben einen erheblichen toten Winkel im Bereich vor der Zugmaschine. Es ist leicht, in diesem Bereich einen Fußgänger oder sogar ein Auto aus dem Blick zu verlieren, daher sind Lkw mit einem Frontspiegel ausgestattet, der durch die Windschutzscheibe sichtbar ist."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Der Frontspiegel ist so konzipiert, dass er dem Fahrer Einsicht in diesen toten Winkel gibt.<br>Er ist ein unverzichtbares Hilfsmittel, um sicherzustellen, dass keine Kollisionen mit Hindernissen entstehen, wenn man in engen Bereichen manövriert."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Fahre los, bewege dich in Richtung der Absperrung vor dir und bremse ab, je näher du ihr kommst.<br>Behalte dabei den Frontspiegel im Blick."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Halte zwischen der Linie und dem Hindernis an."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "In diesem Szenario lernen wir, den im Diagramm gezeigten Frontspiegel zu nutzen.<br><br><font face=/font/big_bold.font>Schau durch den oberen Bereich der Windschutzscheibe, um ihn zu sehen.</font>@@aca_goal_tip@@ Du musst dich im Fahrzeug befinden."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Der Frontspiegel ermöglicht es dir, in den toten Winkel vor dem Lkw zu sehen. Er hilft dir, sicher und präzise zu fahren.<br><br>Wenn du mit der Einstellung nicht zufrieden bist, öffne „@@adjust_link_t@@“ (zugänglich über das Pausenmenü), um ihn nach deinen Wünschen anzupassen.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_activate@@, um fortzufahren. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Direkt vor dem Lkw befindet sich ein markierter Bereich. Du wirst bemerken, dass sich auf der anderen Seite des Bereichs ein Hindernis befindet. Wenn du dich diesem näherst, fahre sehr langsam und kontrolliere den Abstand zum Hindernis im Frontspiegel.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Der Lkw ist noch nicht bereit zur Abfahrt – hast du vielleicht etwas vergessen?<br><br>Ist der Motor eingeschaltet? Hast du die Feststellbremse gelöst?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Fahre zum Parkplatz. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Halte die Front des Lkw zwischen dem Hindernis und der markierten Straßenlinie an. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

