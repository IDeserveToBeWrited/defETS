#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Willkommen in der @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Die folgenden Szenarien repräsentieren den ersten Schritt deiner Entwicklung zum professionellen Lkw Fahrer."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Hier lernst du alles von den grundlegenden Systemen und der Steuerung des Lkw ..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...hin zu komplexen Manövern mit und ohne Auflieger."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Wir helfen dir, Gewohnheiten zu entwickeln, die dir dabei helfen, eine Vielzahl von Situationen sicher zu meistern,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "und zeigen dir, wie du den verfügbaren Raum klug nutzt, um deinen Lkw effektiv zu manövrieren."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Indem du alle Szenarien abschließt und die Abschlussprüfungen bestehst,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "wirst du bereit sein, die Straßen Europas zu erobern und dich neuen Herausforderungen zu stellen."

#@}

