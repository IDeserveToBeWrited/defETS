#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Für das letzte Szenario dieses Kapitels fahren wir auf dem Prüfungsparcours mit einer komplexen Konfiguration."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Das erste Hindernis ist ein Slalom durch einige Absperrungen. Fahre hindurch und denke daran, deine Spiegel zu benutzen."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Als Nächstes folgt eine Kehre. Hole weit aus, dann sollte sie dir keine Probleme bereiten."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Hier gibt es eine 90-Grad-Linkskurve. Denke daran, tief einzufahren, damit das Heck des Lkw die inneren Absperrungen passiert."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Das Rampenhindernis kann etwas knifflig sein. Richte dich so gut wie möglich aus, bevor du darauf fährst, und nutze deinen Front- und Seitenspiegel zur Orientierung."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Der nächste Abschnitt muss rückwärts gefahren werden. Denke daran, wenn du dich den Absperrungen näherst."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Folge den Straßenmarkierungen zurück und achte darauf, dass du nach rechts lenkst."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Fahre rückwärts zu den Absperrungen, halte an und fahre dann vorwärts nach links."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Fahre durch die Lücke im Mittelstreifen in den nächsten Abschnitt."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Die Passage durch die Leitkegel ist sehr eng. Fahre langsam und nutze deine Spiegel, um dich innerhalb der Passage zu orientieren."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Achte darauf, bei 90-Grad-Kurven tief in die Kurve hineinzufahren."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Du fährst jetzt in einen offenen Straßenabschnitt. Du kannst etwas Geschwindigkeit aufnehmen, aber bedenke, dass du bald für die kommende Kurve abbremsen musst."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Am Fuß des Hügels befinden sich einige Absperrungen quer zur Straße. Fahre bis dorthin vor und setze dann zurück in die Parklücke auf der linken Seite."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Fahre rückwärts zur Parklücke."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parke, schalte dann den Motor aus und sichere den Lkw."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Vor dir befindet sich ein Slalom aus Absperrungen.<br><br><font face=/font/big_bold.font>Fahre durch den Slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Bleibe am äußeren Rand der Kurve, um sicherzustellen, dass das Heck der Zugmaschine nicht über den Bordstein gerät.<br><br><font face=/font/big_bold.font>Fahre die Kurve.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Du näherst dich einer 90-Grad-Linkskurve. Denke daran, den gesamten verfügbaren Platz zu nutzen.<br><br><font face=/font/big_bold.font>Nimm die Kurve.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Richte dich genau zur Rampe aus. Es gibt wenig Spielraum für Korrekturen, sobald du darauf bist.<br><br><font face=/font/big_bold.font>Fahre über die Rampe.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Folge dem Kurs nach links. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Der nächste Abschnitt muss rückwärts gefahren werden. Halte an den Absperrungen vor dir an, damit du anschließend rückwärts nach rechts fahren kannst.<br><br><font face=/font/big_bold.font>Halte an den Absperrungen.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Setze rückwärts in den Bereich rechts hinter dir zurück. Orientiere dich dabei an den Pfeilen auf der Fahrbahn.<br><br><font face=/font/big_bold.font>Fahre rückwärts in den nächsten Abschnitt.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Setze rückwärts bis zu den Absperrungen hinter dir zurück.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Halte an und schalte in einen Vorwärtsgang, dann fahre nach links weiter.<br><br><font face=/font/big_bold.font>Fahre vorwärts.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Links befindet sich eine Lücke im Mittelstreifen. Fahre hindurch.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Vor dir liegt ein schmaler, kurviger Pfad durch einige Leitkegel. Fahre vorsichtig und nutze bei Bedarf deine Spiegel.<br><br><font face=/font/big_bold.font>Fahre durch die Leitkegel.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Fahre weiter durch den Kurs.<br><br><font face=/font/big_bold.font>Lenke nach links.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Denke daran, vor der Kurve links zu bleiben, um dir so viel Platz wie möglich zu verschaffen.<br><br><font face=/font/big_bold.font>Nimm die Kurve.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Hier kannst du etwas Geschwindigkeit aufnehmen, aber es kommt bald eine Kurve.<br><br><font face=/font/big_bold.font>Fahre weiter entlang des Kurses.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Die Kurve wird enger, je weiter du hindurchfährst.<br><br><font face=/font/big_bold.font>Passe deine Geschwindigkeit entsprechend an und fahre weiter.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Unten am Hang siehst du Absperrungen, die die Straße blockieren.<br><br><font face=/font/big_bold.font>Halte in der Nähe der Absperrungen an.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Hinter dir auf der linken Seite ist eine Parklücke.<br><br><font face=/font/big_bold.font>Fahre rückwärts in die Parklücke.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Halte im markierten Bereich an.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Fahren auf einem Fahrtechnik-Kurs"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In diesem Szenario fahren wir auf einem Kurs, der dazu dient, deine Fähigkeit zu testen, den Lkw durch verschiedene Arten von Kurven zu steuern."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Fahre in den Kurs ein"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Eine leichte Linkskurve fahren"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Fahren durch S-Kurven"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Gerader Abschnitt"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Leichte Kurven"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Verlassen des Trainingskurses"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Annäherung an die Parklücke"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In diesem Szenario fahren wir mit der Zugmaschine eine kurze Strecke, um zu sehen, wie du sie mit deinen neu erworbenen Fähigkeiten beherrschst."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Auf der Strecke gibt es verschiedene Arten und Kombinationen von Kurven. Es ist kein Rennen und es geht nicht um Zeit. Sei geduldig und passe deine Geschwindigkeit den Kurven und Hindernissen an, die du vor dir hast."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Am Anfang ist der Kurs sanft und einfach, doch die Kurven werden mit der Zeit anspruchsvoller."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Achte auf deine Geschwindigkeit; es ist leicht, zu schnell zu werden und dann eine Kurve falsch einzuschätzen."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Am Ausgang der Strecke wartet eine sehr enge Kehre. Reduziere deine Geschwindigkeit und nutze den gesamten Platz, den du hast."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parke zwischen den Absperrungen und sichere den Lkw."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Um dieses Szenario erfolgreich abzuschließen, darfst du nicht einen Unfall verursachen, von der Strecke abkommen oder Leitkegel berühren.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Fahre vorwärts in die scharfe Rechtskurve, um auf den Kurs zu gelangen.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Fahre mit gleichmäßiger Geschwindigkeit durch die Kurve.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Du näherst dich einem komplexeren Abschnitt mit kurvigen Passagen.<br><br><font face=/font/big_bold.font>Passe deine Geschwindigkeit entsprechend an und fahre weiter.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Fahre weiter zu den nächsten Kurven.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Es kommen einige leichte, sanfte Kurven. Halte deine Geschwindigkeit gleichmäßig.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Die Ausfahrt aus dem Kurs ist eine scharfe Kehre. Reduziere deine Geschwindigkeit und bleibe vor der Kurve an der Außenseite. Nutze unbedingt deine Spiegel!<br><br><font face=/font/big_bold.font>Fahre aus dem Kurs.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Vor dir befindet sich eine Parklücke zwischen einigen Absperrungen.<br><br><font face=/font/big_bold.font>Fahre zur Parklücke.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Längsparken"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "In diesem Szenario schauen wir uns das Längsparken zwischen zwei anderen Lkw an."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Anhalten vor der Parklücke"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Überprüfen des Rückspiegels"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Rückwärts in die Parklücke einfahren"

	key[]: "aca_goal_book1_2_09_stop"
