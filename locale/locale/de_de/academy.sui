	key[]: "aca_scenario_book3_justc_title"
	val[]: "Erste Rückwärtskorrektur"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "In diesem Szenario müssen wir dort weitermachen, wo jemand anderes aufgehört hat."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Rückwärtsfahren"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Oh je! Da hat sich jemand beim Rückwärtsfahren etwas geärgert und seinen Lkw mitten auf dem Parkplatz stehen lassen."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Es wird unvermeidlich Situationen geben, in denen du völlig durcheinander kommst. Keine Sorge, zieh einfach aus der Sackgasse heraus, bis du etwas hast, mit dem du arbeiten kannst. <br><br>Wenn du dir nicht sicher bist, versuche, alles geradezurichten, damit du einen Neuanfang machen kannst."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Das ist eine gute Ausgangsposition. Der hintere Auflieger zeigt immer noch in die gewünschte Richtung und wir können die Zugmaschine schnell vor den Auflieger bringen, um die gesamte Kombination in die gewünschte Richtung zu lenken."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Begib dich zum vorgesehenen Bereich und sichere den Lkw. <br><br>Auch dieses Szenario kannst du so oft üben, bis du mit dem Manövrieren der Auflieger vertraut bist."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Es gibt keinen Ausweg aus diesem Schlamassel. Fahre vorwärts, damit du es neu versuchen kannst."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Beginne mit dem Rückwärtsfahren."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Geradeaus rückwärts fahren"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "In diesem Szenario musst du eine Reihe von Doppelaufliegern in einer geraden Linie rückwärts fahren."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Rückwärtsfahren"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
