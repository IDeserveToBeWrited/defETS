	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Schrägparken mit Doppelaufliegern"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "In diesem Szenario parkst du deinen Doppelauflieger-Sattelzug in einer Schräg-Parklücke auf einem stark frequentierten Parkplatz."

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Schräg-Parklücken wie diese sind sehr verbreitet. Sie sind besonders häufig an den vielen Raststätten entlang der europäischen Autobahnen anzutreffen."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Fahre in Richtung der vorgesehenen Parklücke am Ende der Reihe."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Bleibe am äußeren Rand der Fahrspur, aber nicht zu nah an den Leitplanken, da das Heck des Aufliegers beim Einbiegen gegen diese stoßen könnte."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Fahre an der Parklücke vorbei, um Platz für deine beiden Auflieger zu schaffen. Halte dich dann auf der anderen Seite der Parklücke, um deinen ersten Auflieger in Position zu bringen."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Richte das Fahrzeug aus, halte dann im dafür vorgesehenen Bereich an und sichere den Lkw."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Fahre bis zum Ende der Reihe und suche dir einen Parkplatz."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Fahre an der Parklücke vorbei, um sicherzustellen, dass dein hinterer Auflieger korrekt in die Parklücke passt, und wende dann, wobei du darauf achtest, dass die Vorderseite deines vorderen Aufliegers nicht mit dem neben dir stehenden Lkw in Berührung kommt."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Fahre langsam fort, während du die Kombination aufrichtest, und halte dann im dafür vorgesehenen Bereich an."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


