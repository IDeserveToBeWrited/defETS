#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Lkw-Fahrerfahrung"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Willkommen zurück in der @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Die folgenden Szenarien stellen den nächsten Schritt auf deinem Weg zum professionellen Lkw-Fahrer dar."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Dieses Mal werden wir dich nicht durch jede Aufgabe führen, daher liegt es an dir, deine Fähigkeiten und Erfahrungen einzusetzen."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Du wirst vielleicht auf einige bekannte Manöver stoßen, aber diesmal in neuen Umgebungen, die eher wie reale Szenarien aussehen."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Neu bei @@driving_academy@@ sind die Bedingungen „Bestanden“ und „Bonus“."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Wie zuvor musst du auch weiterhin jedes Szenario abschließen, ohne etwas zu rammen, indem du erfolgreich parkst und den Lkw sicherst ..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...aber jetzt musst du das auch innerhalb der vorgegebenen Zeit und mit einer Begrenzung der Anzahl der Richtungswechsel zwischen Vorwärts- und Rückwärtsfahrt tun."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Die Bonusbedingungen können erfüllt werden, indem jedes Szenario mit noch anspruchsvolleren Bedingungen abgeschlossen wird ..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...wie etwa strengere Zeitvorgaben, weniger Richtungswechsel und die ausschließliche Verwendung der Innenkamera."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Wenn du alle Szenarien abgeschlossen hast, kannst du dich als erfahrenen Trucker bezeichnen und bist bereit für die nächste Herausforderung auf der Straße.<br><br>Um dich selbst noch mehr herauszufordern, erfülle alle Bonusbedingungen für jedes Szenario. Dann bist du wirklich ein Trucking-Star!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "In diesem Tutorial-Szenario helfen wir dir dabei, dich mit den neuen Funktionen von Lkw-Fahrerfahrung vertraut zu machen."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Zu Beginn jedes Szenarios wird das Fenster <color value=@@clr_sel@@>„Szenario-Einweisung“<color value=@@clr_txt@@> angezeigt. Hier findest du Informationen zu den neuen Pass- und Bonusbedingungen für das Szenario. <br><br>Die Passbedingungen müssen erfüllt sein, um das Szenario erfolgreich abzuschließen, während die Bonusbedingungen eine optionale zusätzliche Herausforderung für erfahrene und geübte Spieler darstellen. <br><br><font face=/font/big_bold.font>Um fortzufahren, schalte die Zündung ein.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Eine der Bonusbedingungen verlangt, dass du das Szenario unter Verwendung der <color value=@@clr_sel@@>Innenkamera<color value=@@clr_txt@@> abschließst. Du kannst weiterhin die Außenkameras verwenden, um deine Umgebung zu überprüfen, jedoch nur, wenn der Lkw steht. <br><br>Du kannst dich umsehen, um sich zu orientieren, und dann wieder zur Innenkamera zurückwechseln. <br><br><font face=/font/big_bold.font>Wechsle zur Verfolgungskamera, um die Umgebung zu überprüfen</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Orientiere dich und wechsle dann zurück zur Innenkamera.<br><br><font face=/font/big_bold.font>Sieh dich im Lkw um</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Wechsle zurück zur Innenkamera</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Die Zeit<color value=@@clr_txt@@> ist ebenfalls ein Faktor für die Lkw-Fahrerfahrung. Alle Szenarien haben ein individuelles Zeitlimit, innerhalb dessen das Szenario als Bestehensbedingung abgeschlossen werden muss, und viele haben zusätzlich ein strengeres Limit als Bonusbedingung. <br><br>Die Zeitmessung beginnt erst, nachdem der Lkw bewegt wurde. <br><br><font face=/font/big_bold.font>Starte den Motor und löse die Feststellbremse, um fortzufahren. </font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Eine weitere Neuerung bei Lkw-Fahrerfahrung sind Wegpunkte. Alle Wegpunkte müssen erreicht werden, bevor ein Szenario abgeschlossen werden kann. <br><br>Außerdem reagieren Wegpunkte empfindlich auf die Ausrichtung des Lkw beim Erreichen des Wegpunkts. Achte daher auf Bodenmarkierungen in der Nähe des Wegpunkts, um sich richtig zu orientieren. <br><br><font face=/font/big_bold.font>Fahre vorwärts zum Wegpunkt vor dir. </font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Du hast den Wegpunkt erreicht und kannst nun mit dem nächsten Schritt fortfahren. <br><br>Hinter dir befindet sich ein weiterer Wegpunkt, in den du rückwärts einfahren musst. Beachte den Pfeil auf dem Boden, der angibt, in welche Richtung der Lkw zeigen sollte, wenn du den Wegpunkt erreichst. <br><br>Eine weitere Pass- und Bonusbedingung, die berücksichtigt werden muss, ist <color value=@@clr_sel@@>Richtungswechsel<color value=@@clr_txt@@>. Wir zählen, wie oft du zwischen Vorwärts- und Rückwärtsfahrt wechselst. Bleibe unter dem Limit, um die Bedingung zu erfüllen.<br><br><font face=/font/big_bold.font>Fahre rückwärts zum Wegpunkt und halte an.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Bis jetzt solltest du also eine Richtungsänderung angesammelt haben. <br><br>Nimm den Auflieger hinter dir auf, um mit dem nächsten Schritt fortzufahren. <br><br><font face=/font/big_bold.font>Fahre rückwärts unter den Auflieger, um ihn anzukoppeln.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Der endgültige Parkplatz befindet sich zu deiner Rechten. In einigen Szenarien gibt es nur eine Parklücke, in anderen stehen mehrere zur Auswahl. Wenn du in einer der Lücken korrekt parkst, kannst du das Szenario abschließen. <br><br><font face=/font/big_bold.font> Drücke @@imv_nrm_attach@@, um den Auflieger anzukoppeln. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Die Parkplätze geben auch an, in welche Richtung der Lkw auf dem Parkplatz ausgerichtet sein soll. Wenn du in die falsche Richtung parkst, kannst du das Szenario erst abschließen, wenn du dies korrigiert hast, was dir Zeit und Richtungsänderungen kostet. <br><br><font face=/font/big_bold.font>Fahre zu einem der Parkplätze und parke korrekt. </font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Lkw-Fahrerfahrung"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Du solltest nun mit den neuen Parametern für Passbedingungen und Bonusziele vertraut sein und bereit sein, die neuen Szenarien in Lkw-Fahrerfahrung in Angriff zu nehmen!<br><br><font face=/font/big_bold.font>Sichere den Lkw, indem du die Feststellbremse anziehst und den Motor abstellst, um das Szenario abzuschließen.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Tastenkombination"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "In diesem Szenario versuchst du, eine Abkürzung zu nehmen, die leider am Ende gesperrt ist. Du musst dann denselben Weg zurückfahren, den du gekommen bist."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Fahre zum Wegpunkt oben auf dem Hügel und dann denselben Weg zurück. <br><br>Sobald du wieder auf der Straße bist, fahre zum letzten Parkplatz."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Früher Vogel"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "In diesem Szenario musst du dich durch einen überfüllten Parkplatz manövrieren. Der Platz ist extrem begrenzt, also versuche, deine Bewegungen im Voraus zu planen."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Manchmal sind die Parkmöglichkeiten so begrenzt, dass andere Fahrer über Nacht einfach dort parken, wo sie gerade Platz finden. Das kann es morgens ziemlich schwierig machen, an ihnen vorbeizukommen.<br><br>Gib dein Bestes, um dich durch den Parkplatz bis zur letzten Parklücke durchzuschlängeln."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Verdreht"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "In diesem Szenario musst du einen sehr komplexen Trainingsparcours durchfahren. Unterwegs musst du einen Auflieger finden, ihn ankoppeln und dann bis zum Ende mitnehmen."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Dieses Szenario testet dein räumliches und situationsbezogenes Bewusstsein. Der vor dir liegende Parcours ist voller Hindernisse, die du nicht immer leicht erkennen kannst."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Begib dich durch den Parcours zum Auflieger. Sobald du ihn gefunden hast, koppele ihn an und ziehe ihn zur endgültigen Parklücke."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Schwindel"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "In diesem Szenario werden wir deine Fahrkünste auf die Probe stellen. Fahre so lange im Kreis, bis du das Ziel erreicht hast!"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "Es ist Zeit, deine Fähigkeiten im Umgang mit dem Lkw unter Beweis zu stellen. Diese Strecke wurde entwickelt, um zu sehen, wie gut du deinen Lkw kennst!"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "Das Herzstück ist eine lange Spirale, die deine Fähigkeiten beim Fahren des Lkw in langen, geschwungenen Kurven auf die Probe stellen wird."

#@}




