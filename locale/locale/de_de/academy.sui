#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Längsparken ist eine wichtige Fähigkeit, die jeder Lkw-Fahrer beherrschen sollte.<br>Bereite dich auf die Abfahrt vor."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Fahre zur Parklücke.<br>Achte auf deine Umgebung."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Stelle dich parallel zum Lkw vor deiner Parklücke auf. Halte ausreichend Abstand, damit du beim Einparken genug Platz zum Rangieren hast."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Lenke scharf in Richtung der Lücke ein und beginne rückwärts zu fahren."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Wenn du in den Spiegel auf der Fahrerseite schaust, richte dich am Bordstein knapp vor dem Lkw hinter dir aus."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Sobald dein vorderer Stoßfänger den Lkw vor dir passiert hat, kannst du beginnen, das vordere Ende des Lkw in die Lücke zu lenken, um den Lkw mit der Parklücke auszurichten."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Richte das Lenkrad gerade aus und zentriere den Lkw in der Parklücke.<br>Parke und sichere den Lkw."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Vor dir stehen mehrere geparkte Lkw, und eine letzte freie Parklücke wartet auf dich.<br><br><font face=/font/big_bold.font>Mach dich startklar.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Denke daran, auf deine Umgebung zu achten. Nutze deine Spiegel aufmerksam während des gesamten Manövers.<br><br><font face=/font/big_bold.font>Fahre vorwärts.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Fahre an der Parklücke vorbei und in den markierten Bereich. Von dort aus kannst du mit dem Rückwärtsfahren beginnen.<br><br><font face=/font/big_bold.font>Halte im markierten Bereich an.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Überprüfe deine Umgebung auf Hindernisse und stelle sicher, dass der Weg zum Rückwärtsfahren frei ist.<br><br><font face=/font/big_bold.font>Schau durch den Beifahrerspiegel.</font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Lenke ein und fahre rückwärts in die Parklücke.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Beginne, den Lkw gerade auszurichten, sobald es passend ist. Fahre nicht über den Bordstein!<br><br><font face=/font/big_bold.font>Richte den Lkw in der Parklücke aus.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Ankuppeln eines Aufliegers"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "In dieser Lektion erklären wir die Grundlagen des Ankuppelns und Abkuppelns der Zugmaschine an einen Auflieger."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Rückwärtsfahren zum Auflieger"



	key[]: "aca_goal_book1_3_01_connect"
