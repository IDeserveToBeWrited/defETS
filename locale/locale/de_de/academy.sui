#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Abschlussprüfung"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "In diesem Szenario werden deine neuen Fähigkeiten in einem Kurs auf die Probe gestellt, der darauf ausgelegt ist, deine Präzision und dein Verständnis für das Fahren mit Doppelaufliegern zu testen."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Rückwärtsfahren"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Fahre in den Kurs ein"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Komme auf Geschwindigkeit"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Bereite dich aufs Bremsen vor"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Unzureichende Geschwindigkeit"

