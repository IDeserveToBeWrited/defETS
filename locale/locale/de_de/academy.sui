#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Dieser Trainingskurs gibt dir einen kleinen Vorgeschmack auf das echte Fahren in der realen Welt, aber in der Sicherheit unseres Trainingsgeländes. Probier ein paar deiner neuen Fähigkeiten aus und denk daran, auf deine Umgebung zu achten und den ganzen Platz zu nutzen, der dir zur Verfügung steht. <br><br>Es lohnt sich auch, vorauszudenken!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Fahre weiter und finde den Weg zum Kurs."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Vor dir liegt eine Abfahrt, die du nutzen kannst, um ein Gefühl für den Doppelauflieger bei hoher Geschwindigkeit zu bekommen."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Bereite dich darauf vor, für die bevorstehende Kurve zu bremsen."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Überquere den Mittelstreifen, indem du nach rechts und dann sofort wieder nach links abbiegst."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Überquere erneut den Mittelstreifen."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Es gibt Situationen, in denen du keine andere Wahl hast, als die gesamte Kombination zu knicken. <br><br>Tu, was du tun musst, um diese extrem scharfe Kurve zu bewältigen."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Fahre weiter auf dem Kurs."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Fahre vorsichtig durch den Slalom und achte nicht nur darauf, dass deine Auflieger jede Barriere passieren, sondern auch darauf, dass du bereit bist, die nächste zu umfahren."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Fahre weiter nach links und überquere die Kreuzungen geradeaus."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Folge der asphaltierten Straße nach rechts."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Die letzte Kurve ist irreführend; es gibt viel Platz, aber sei darauf vorbereitet, dicht an der gegenüberliegenden Bordsteinkante zu parken."

#!{
	key[]: "aca_msg_book3_train_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_train_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ double_90
