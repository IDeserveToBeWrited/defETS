#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Rückwärtsfahren mit einem Auflieger"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "In diesem Szenario wirst du zum ersten Mal das Rückwärtsfahren mit einem Auflieger ausprobieren. Es handelt sich um ein relativ einfaches Manöver, aber du musst dennoch richtig lenken, um den Auflieger in die korrekte Position zu bringen."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Rückwärtsfahren zum Auflieger"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Auflieger ankuppeln"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Feststellbremse lösen"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Rückwärtsfahren mit dem Auflieger"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Weiter zur Parklücke"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Lass uns versuchen, mit einem Auflieger rückwärts zu fahren. Es ist einfacher, als es aussieht; du musst nur geduldig sein."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Beginne mit dem Rückwärtsfahren und richte die Zugmaschine parallel zum Auflieger aus."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Achte darauf, dass du richtig ausgerichtet bist, sonst kannst du die Verbindung nicht herstellen. Wenn es nicht passt, kannst du nochmal nach vorne fahren und es erneut versuchen."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Die Sattelkupplung der Zugmaschine wird sich mit dem Königszapfen des Aufliegers verriegeln."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Ziehe die Feststellbremse an und kupple den Auflieger an. In der Realität müsstest du den Lkw verlassen, um die Luft- und Elektroleitungen anzuschließen und das Stützrad hochzukurbeln, aber hier übernehmen wir das für dich."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Der Auflieger wird sich immer <color value=@@clr_sel@@>entgegengesetzt <color value=@@clr_txt@@>zur Zugmaschine drehen."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Um den Auflieger zu drehen, musst du die Zugmaschine in die <color value=@@clr_sel@@>entgegengesetzte <color value=@@clr_txt@@>Richtung lenken, in die der Auflieger fahren soll."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Um den Auflieger wieder gerade auszurichten, lenke die Zugmaschine <br><color value=@@clr_sel@@>in Richtung <color value=@@clr_txt@@>des Aufliegers."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Versuche, mit dem Auflieger ausgerichtet zu bleiben – du musst ständig kleine Korrekturen vornehmen, um den Auflieger auf die markierte Fläche auszurichten."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Korrigiere Abweichungen von deinem Kurs mit kleinen Lenkbewegungen, sobald sie auftreten. Übersteuerst du, kannst du schnell weit von deiner gewünschten Spur abkommen."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Halte im vorgesehenen Bereich an, sichere den Lkw und stelle den Motor ab."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Hinter dir, auf der Beifahrerseite, siehst du einen Auflieger. Deine erste Aufgabe wird es sein, rückwärts darauf zuzufahren.<br><br><font face=/font/big_bold.font>Bereite den Lkw für das Rückwärtsfahren vor.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Beginne, rückwärts in Richtung des Aufliegers zu fahren. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Richte dich so aus, dass du exakt in einer Linie mit dem Auflieger stehst. Die Sattelkupplung muss den Königszapfen erfassen. Fahre gegebenenfalls ein Stück vor, um deine Position anzupassen.<br><br><font face=/font/big_bold.font>Setze das Rückwärtsfahren fort, bis du eine Verbindung spürst. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Die Sattelkupplung hat den Königszapfen erfasst und du bist bereit, das Ankuppeln des Aufliegers abzuschließen.<br><br><font face=/font/big_bold.font>Ziehe die Feststellbremse an. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font>Drücke @@imv_nrm_attach@@, um den Auflieger anzukuppeln. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Der Auflieger ist nun sicher an die Zugmaschine angekuppelt, die Luft- und Elektroleitungen sind angeschlossen und das Stützrad ist eingezogen.<br><br><font face=/font/big_bold.font>Löse die Feststellbremse. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Du musst rückwärts in die Parklücke direkt hinter dir einfahren. Denke daran, dass der Auflieger in die entgegengesetzte Richtung lenkt, wenn du die Zugmaschine steuerst. Schon eine kleine Bewegung am Lenkrad kann große Auswirkungen auf die Position des Aufliegers haben.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren des Aufliegers. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Lenke nicht zu stark ein, sondern versuche, den Auflieger in einer Linie mit der Parklücke zu halten.<br><br><font face=/font/big_bold.font>Fahre weiter in Richtung Parklücke. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Einparken in einer engen Lücke"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "In diesem Szenario üben wir das Einparken in eine enge Lücke.<br><br>Du musst den Auflieger so steuern, dass er sich exakt gerade mit einer leicht versetzten Parklücke ausrichtet."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Einparken in die richtige Position"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Vorwärts einzuparken, also mit der Front zuerst, ist im Vergleich zu anderen Parkmanövern relativ einfach.<br>Du musst jedoch weiterhin das versetzte Nachlaufen des Aufliegers ausgleichen."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Du musst über den Punkt hinausfahren, an dem du normalerweise die Zugmaschine allein einlenken würdest. So kannst du den Auflieger besser ausrichten."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Wenn du dich der Parklücke näherst, lenke ein, sodass die Zugmaschine vor dem Auflieger steht. Richte dich gerade aus und fahre in die Lücke.<br>Halte an, parke, sichere den Lkw und stelle den Motor ab."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Vor dir befindet sich eine Parklücke, zu der du hinfahren und in der du parken musst.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Fahre los und lenke in Richtung der Parklücke.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Fahre an der Parklücke vorbei, um den Auflieger mit dem markierten Bereich auszurichten. Bringe dann die Zugmaschine in die Lücke und richte sie gerade aus.<br><br><font face=/font/big_bold.font>Parke im vorgesehenen Bereich. </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Halte im vorgesehenen Bereich an.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Sichere den Lkw und stelle den Motor ab.</font>"
#@}

