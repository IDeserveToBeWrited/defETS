	key[]: "aca_msg_scenario_reverse_in_forward_out"
	val[]: "Fahre rückwärts in die markierte Stelle hinein und dann wieder vorwärts heraus."

	key[]: "aca_msg_scenario_forward_in_reverse_out"
	val[]: "Fahre vorwärts in die markierte Stelle hinein und dann rückwärts wieder heraus."

	key[]: "aca_msg_scenario_reverse_continue"
