#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parken neben einem Hindernis"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "In diesem Szenario lernen wir, mithilfe des Seitenspiegels neben einem Bordstein zu parken."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Überprüfe den Seitenspiegel"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Fahre auf den Bordstein zu"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Der Seitenspiegel ist ein weiteres Hilfsmittel, das dir beim sicheren Manövrieren des Lkw hilft. Er befindet sich am oberen Rahmen der Beifahrertür."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Fahre vorwärts und lenke langsam zur Beifahrerseite."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Diese Holzplanken stellen einen Bordstein dar. Du musst daneben parken.<br>Lenke in Richtung des Bordsteins, um den Lkw in eine gute Position zu bringen und die Parklücke sauber anzufahren."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Bremse gut vor dem Bordstein ab und lenke in Richtung der Parklücke. Während du den Lkw geradeaus ausrichtest, kannst du den Seitenspiegel nutzen, um den Abstand zum Bordstein einzuschätzen."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Halte in der Parklücke an und sichere den Lkw."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Schau durch das Fenster auf der Beifahrerseite. Dort siehst du den Seitenspiegel.</font>@@aca_goal_tip@@ Du musst dich im Fahrzeug befinden."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Der Seitenspiegel deckt den Bereich auf der Beifahrerseite ab, den der Fahrer nicht einsehen kann. Es ist einer der problematischsten toten Winkel am Lkw. Wenn der Winkel des Spiegels dir nicht zusagt, kannst du ihn unter „@@adjust_link_t@@“ anpassen.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Der Lkw ist noch nicht bereit zur Abfahrt – hast du vielleicht etwas vergessen?<br><br>Ist der Motor eingeschaltet? Hast du die Feststellbremse gelöst?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Vor dir befindet sich eine Reihe von Planken, die einen Bordstein darstellen. Am Ende des Bordsteins liegt eine Parklücke, die du anfahren musst.<br><br><font face=/font/big_bold.font>Fahre los, wenn du bereit bist. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Lenke in Richtung des Bordsteins. Nutze den Front- und Seitenspiegel, um deine Position zum Bordstein einzuschätzen und achte darauf, keine Leitkegel zu überfahren.<br><br><font face=/font/big_bold.font>Fahre zum Bordstein und in die Parklücke.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Sichere den Truck und stelle den Motor ab.</font>@@aca_goal_tip@@ Du kannst die Voreinstellungen für den Innenraumblick verwenden, um leichter in die Spiegel zu schauen. Sieh im Optionsbildschirm unter „@@options_bindings_screen@@“ nach, um die entsprechenden Steuerungen anzuzeigen und/oder zu ändern."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Rückwärtseinparken neben einem Hindernis"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "In diesem Szenario werden wir den Lkw rückwärts in eine Parklücke neben einem Bordstein einparken."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Anweisung"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Fahre rückwärts auf den Bordstein zu"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parke den Lkw"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "In diesem Szenario führen wir eine Rückwärtsfahrt durch, um neben einem Bordstein zu parken."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Fahre rückwärts in Richtung des Bordsteins.<br>Sei dir deiner Umgebung beim Rückwärtsfahren bewusst und nutze deine Spiegel."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Wenn du näher kommst, kannst du beginnen, den Lkw mit der Parklücke auszurichten. Behalte beim Rückwärtsfahren beide Seiten des Lkw im Blick."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Halte in der Parklücke an und sichere den Lkw."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Die Parklücke befindet sich hinter dir auf der Beifahrerseite. Nutze deine Spiegel, um den Weg zur Parklücke zu finden.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Denke daran, deine Spiegel zu nutzen, um deine Umgebung zu überprüfen, bevor du den Lkw bewegst.<br><br><font face=/font/big_bold.font>Beginne, rückwärts in Richtung des Bordsteins zu fahren.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Beobachte weiterhin deine Umgebung, während du rückwärts in die Parklücke fährst.<br><br><font face=/font/big_bold.font>Halte an der vorgesehenen Stelle an.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Fortgeschrittener Trainingskurs"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Das letzte Szenario in diesem Kapitel ist eine Fahrt auf einem fortgeschrittenen Trainingskurs. Wir werden die Fähigkeiten, die du mit einer Zugmaschine erlernt hast, auf die Probe stellen!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
