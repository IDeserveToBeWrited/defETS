	key[]: "aca_goal_book3_parallel_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### parallel msg - intro text

	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "Fahre um die Ecke und auf die Straße. Dort findest du einen freien Platz."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "Fahre in die Parklücke hinein und durchfahre diese; so kannst du deinen Auflieger näher an die gewünschte Stelle heranbringen."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "Fahre aus der Parklücke heraus und rolle so weit vor, dass du genug Platz zum Manövrieren hast."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "Verwende deinen vorderen Auflieger zum Lenken und schiebe deinen hinteren Auflieger in die Lücke. Du musst wirklich vorausplanen, um sicherzustellen, dass jeder Auflieger dort landet, wo du ihn haben möchtest."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "Möglicherweise musst du ein paar Mal vor- und zurückfahren, bis alles so sitzt, wie du es haben willst."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "Wenn du sicher bist, dass du an der Straßenkante ausgerichtet bist, zentriere die Kombination in der Parklücke und sichere das Fahrzeug."

#### parallel Driving Instructions

#!{
	key[]: "aca_msg_book3_parallel_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_parallel_forward"
	val[]: "Fahre vorwärts, suche dir einen Parkplatz und richte dein Fahrzeug so aus, dass du rückwärts einparken kannst."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Fahre rückwärts in die Parklücke."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Halte im vorgesehenen Bereich an."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Sichere den Lkw und stelle den Motor ab."
#@}




