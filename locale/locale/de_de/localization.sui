	key[]: "show_blockers"
	val[]: "Sperrsymbole anzeigen (mit Vorsicht deaktivieren)" #+ Checkbox for enabling/disabling game blockers rendering (e.g. dead road ends, or DLC blockers)

	key[]: "steer_cam_rotation"
	val[]: "Rotation Lenkungskamera" #+ Checkbox enabling camera rotation based on steering angle.

	key[]: "steer_cam_rotation_factor"
