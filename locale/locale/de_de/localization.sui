#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Weiter ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Willkommen im Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Endlich hast du die Chance auf deinen Traumjob - das Fahren eines Lkw!"

	key[]: "intro_3"
	val[]: "Deine eigene Transportfirma hat nun ihre Pforten geöffnet, leider fehlt dir aber das Kapital für einen Lkw. Bis auf weiteres wirst du daher als Angestellter für andere Speditionen arbeiten müssen."

	key[]: "intro_4"
	val[]: "Dein Auftrag ist es, eine Ladung $JOB_CARGO$ für $JOB_TARGET_COMPANY$ sicher zur Entladestelle nach $JOB_TARGET_CITY$ zu bringen. Dein Arbeitgeber hat dich mit einer Zugmaschine ausgestattet und wird sämtliche Spesen tragen. Fahre sorgsam und sei pünktlich."


	key[]: "intro_garage_1"
	val[]: "Das ist deine Firmenzentrale."

	key[]: "intro_garage_2"
	val[]: "Eine sehr schlichte Garage - nichts Besonderes, aber immerhin ein Anfang."

	key[]: "intro_garage_3"
	val[]: "Leider hast du noch nichts, was du dort abstellen könntest. Deshalb kannst du hier auch keine Lkw sehen."

	key[]: "intro_garage_4"
	val[]: "Hast du erstmal genug Geld verdient und dir eine Zugmaschine gekauft, so kannst du dich frei bewegen und dein Geschäft von hier betreiben."

	key[]: "intro_garage_5"
	val[]: "Viel Glück!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE FREIGESCHALTET"

	key[]: "desktop_tut_job"
	val[]: "Wähle deinen nächsten Auftrag"

	key[]: "desktop_tut_cargo_market"
	val[]: "Verwende deinen brandneuen Auflieger, um über den Frachtmarkt eine große Vielfalt von Frachten an ihr Ziel zu bringen." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Hier kannst du deinen Fortschritt sehen."

	key[]: "desktop_tut_company"
	val[]: "Behalte deine Garagen im Auge, stelle neue Fahrer an und verwalte deine Firma von hier."

	key[]: "desktop_tut_trailers"
	val[]: "Ab jetzt kannst du deine eigenen Auflieger kaufen, aufrüsten und lackieren, um sie zu deinem Lkw passend zu gestalten. <br><br>Eigene Auflieger kannst du jeweils in der Garage deiner Wahl abstellen lassen und sie deinen Fahrern zur Verfügung stellen, um deine Gewinne zu steigern. Die Verwaltung deiner Auflieger erfolgt über den Auflieger-Manager."

	key[]: "desktop_tut_visit_directive"
	val[]: "Besuche $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "WILLKOMMEN"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Willkommen auf dem neuen Desktop.<br>Von hier aus kannst du alle Funktionen des Spiels steuern."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Das Hauptmenü bietet direkten Zugriff auf alle bekannten und wichtigen Spielfunktionen."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Die neue Statusleiste am oberen Bildschirmrand bietet einen ständigen Überblick über hilfreiche Profilstatistiken und lokale Verkehrsregeln."

	key[]: "desktop_tut_tour_home"
	val[]: "Die Schaltfläche Desktop (Haussymbol) ist immer da, um auf den Desktop zurückzukehren."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Ein dauerhaft eingeblendetes Schnellstartmenü bietet praktischen Zugriff auf alle Spielfunktionen von jedem Bildschirm aus."

	key[]: "desktop_tut_tour_drive"
	val[]: "Die aktualisierte „Fahren“-Schaltfläche bleibt die Verbindung zu den Straßen der virtuellen Welt."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL ABGESCHLOSSEN"

	key[]: "desktop_tut_tour_finish"
	val[]: "Vielen Dank für das Ansehen unseres Desktop-Updates."
#@}


