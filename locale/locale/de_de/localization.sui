#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafik" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Passe die Grafikeinstellungen mithilfe genau abgestimmter Voreinstellungen an, um die visuelle Leistung des Spiels nach deinen Wünschen zu gestalten."

	key[]: "apply"
	val[]: "Anwenden" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Desktop-Hintergrundbild" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ANZEIGE" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "BILDQUALITÄT" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTUREN" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKTIONEN" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SCHATTEN" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "BELEUCHTUNG" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "NACHBEARBEITUNG" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "UMFELD" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Vollbildmodus" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Helligkeit / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Einrichtung" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Auflösung" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Bildwiederholrate" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS-Limit" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS-Limit im Hintergrund" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Standardwiederholrate" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikale Synchronisation" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Energiesparend (Betrieb auf Notebooks)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "EINFACHE GRAFIKEINSTELLUNGEN" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "VERWENDE BENUTZERDEFINIERTE EINSTELLUNGEN " #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "ERWEITERTE GRAFIKEINSTELLUNGEN" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Einfache/erweiterte Grafikeinstellungen" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Erweiterte Einstellungen ausblenden" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Erweiterte Einstellungen anzeigen" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skalierung" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-Aliasing Kantenglättung" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA-Luma-Schärfung" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA-Einstellung" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptive Klarheit" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Immer weich" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Immer scharf" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Bildschirm-Umgebungsokklusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Hochkontrastgrafik (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Tiefenschärfe (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Sonnenstrahlen" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Farbkorrektur" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Reflexionsskalierung" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Spiegelungsdetails" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Vegetationsdetails" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Grasdichte" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Schattenqualität"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Größe der Schattentexturen" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Entfernte Schatten" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Schatten im Fahrerhaus" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Wetterqualität"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Spiegelqualität" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Spiegel-Auflösung" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Spiegel-Sichtweite" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Texturqualität" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anisotropische Filterung" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normal-Mapping" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Scheinwerfer anderer Fahrzeuge" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Zusätzliche Fahrzeugbeleuchtung" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Reichweite der Lichtkegel" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Fußgänger" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Bildschirmeinstellungen wurden geändert.<br>Möchtest du diese Einstellungen beibehalten?"

	key[]: "reverting_in"
	val[]: "Zurücksetzen in" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "Sekunden" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Wenn diese Option aktiviert ist, wird das Spiel im Vollbildmodus angezeigt."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Passt die allgemeine Helligkeit des Spiels an deinen Bildschirm an. Auf HDR-kompatiblen Bildschirmen steht dir in dieser Einstellung auch die Option zur HDR-Kalibrierung zur Verfügung."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Ändert die Auflösung des Spiels."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Ändert die Bildwiederholrate des Spiels."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Framerate an die Bildwiederholfrequenz des Monitors an, um ein Tearing des Bildschirms zu verhindern. Die sparsame Einstellung halbiert auch die Bildwiederholrate, was zu einem geringeren Stromverbrauch führt."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Legt die maximal erlaubte Framerate für das Spiel fest.<br><br>Setzt man den Wert auf 0, wird die Funktion deaktiviert."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Legt die maximal zulässige Bildrate für das Spiel fest, wenn es im Hintergrund minimiert ist.<br><br>Setzt man den Wert auf 0, wird die Funktion deaktiviert."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Wechsel zwischen den einfachen Grafikeinstellungen (Voreinstellungen) und erweiterten Grafikeinstellungen (Möglichkeit zur Änderung einzelner Parameter)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Verbessert die grafische Darstellung, indem das Spiel intern mit einer höheren Auflösung gerendert wird, wodurch der „Treppeneffekt“ reduziert und Details verbessert werden.<br>Die Auswahl einer höheren Skalierungsoption führt beispielsweise zu einem klareren Bild mit weniger Unschärfe, wodurch das Spiel auf Kosten der Leistung insgesamt besser aussieht.<br><br><color value=@@clr_txt_d@@> Diese Einstellung hat oft einen großen Einfluss auf die Leistung."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Auswahl sehr schneller Anti-Aliasing-Techniken zur Kantenglättung im Spiel.<br>- SMAA betrachtet jeden Bildpunkt mehrfach (abhängig von der gewählten Bildqualität) an verschiedenen Positionen im Einzelbild und bildet daraus einen Durchschnitt, um das endgültige Bild zu erstellen.<br>- TAA betrachtet jeden Bildpunkt nur einmal pro Einzelbild, jedoch an verschiedenen Positionen und in verschiedenen Einzelbildern.<br>- Um das beste Ergebnis zu erzielen, lässt sich außerdem eine Kombination aus beiden wählen, was Einbußen in der Leistung zur Folge hat..<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Fügt weiche Schatten zu Spalten und Objekten hinzu, die sich in unmittelbarer Nähe zueinander befinden, wodurch die wahrgenommene grafische Wiedergabetreue der gesamten Spielwelt verbessert wird.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Auswahl der TAA-Voreinstellung:<br>- \"Immer weich\" bewirkt geringeres Flimmern/mehr Unschärfe – das ist geeignet für PC-Benutzer, die Supersampling aktiviert haben oder einen hochauflösenden Monitor benutzen, aber auch für TV-Benutzer mit 1080p-Auflösung, die weiter weg vom Bildschirm sitzen.<br>- \"Immer scharf\" bedeutet stärkeres Flimmern/weniger Unschärfe – wahrscheinlich die beste Wahl für Geräte mit einer kleineren Auflösung als 1080p wie z. B. Laptops oder das Steam Deck.<br>- Wenn \"Adaptive Klarheit\" ausgewählt ist, wird das TAA-Flimmern dynamisch abgeschaltet, sobald die Kamera stillsteht.<br><br><color value=@@clr_txt_d@@>Diese Einstellung kann nur verwendet werden, wenn TAA als Anti-Aliasing-Lösung ausgewählt ist."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Stärke der Luminanzschärfung von TAA an.<br><br><color value=@@clr_txt_d@@>Diese Einstellung kann nur verwendet werden, wenn TAA als Anti-Aliasing-Lösung ausgewählt ist."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Wenn diese Option aktiviert ist, können weit entfernte Bereiche auf der Karte künstlich unscharf gemacht werden, um einen realistischen Fokusabfall im Hintergrund zu erzeugen."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Wenn diese Option aktiviert ist, können Lichtstrahlen sichtbar sein, wenn man in die Sonne blickt oder die Sonne durch Objekte wie Bäume, Gebäude oder Fahrzeuge betrachtet."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Wenn diese Option aktiviert ist, werden die Farben des Spiels aus ästhetischen Gründen dynamisch angepasst. Die Szenen werden besser an die Tageszeit und die Wetterbedingungen angepasst. Beispielsweise können die Farben von Fahrzeugen und anderen Objekten lebendiger sein."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Verbessert Reflexionen, indem sie intern in höherer Qualität gerendert werden und ein besseres Antialiasing verwendet wird.<br><br><color value=@@clr_txt_d@@>Änderungen an dieser Einstellung werden erst nach einem manuellen Neustart des Spiels wirksam."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Detailgenauigkeit von Reflexionen auf Fahrzeugoberflächen, Fenstern und anderen reflektierenden Oberflächen wie Pfützen, nassen Straßen und offenen Gewässern an.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung.<br><br>Änderungen an dieser Einstellung werden erst nach einem manuellen Neustart des Spiels wirksam."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Detailgenauigkeit und Komplexität von Pflanzen und Bäumen an.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Dichte des Grases an den Straßenrändern an.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Qualität der Schatten an, die von Sonne oder Mond geworfen werden.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Ermöglicht die Darstellung von Schatten auch bei sehr weit entfernten Objekten.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Qualität von Wettereffekten wie Reflexionen an."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Qualität der Reflexionen in Fahrzeugspiegeln an (unabhängig von den Reflexionseinstellungen).<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Auflösung des Bildes an, das auf den Fahrzeugspiegeln dargestellt wird."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Passt den Abstand an, ab dem Objekte im Spiegel gerendert werden. <br><br><color value=@@clr_txt_d@@>Diese Einstellung hat oft einen großen Einfluss auf die Leistung."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Qualität einiger Texturen an, die auf Objekte und Oberflächen im Spiel angewendet werden."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Verbessert die Schärfe von Texturen, insbesondere von solchen, die aus der Entfernung oder in einem schrägen Winkel betrachtet werden. <br><br><color value=@@clr_txt_d@@>Änderungen an dieser Einstellung werden erst nach einem manuellen Neustart des Spiels wirksam."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Fügt Gehwegen, Straßen und anderen Objekten geometrische Details hinzu, um ihr Aussehen zu verbessern.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung.<br><br>Änderungen an dieser Einstellung werden erst nach einem manuellen Neustart des Spiels wirksam."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiviert die Lichtkegel der anderen Verkehrsteilnehmer."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Andere Fahrzeuge im Verkehr werden auch von Zusatzscheinwerfern, wie Blinkern oder Bremsleuchten, beleuchtet."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Passt die Entfernung an, aus der künstliche Lichtquellen sichtbar sind.<br><br><color value=@@clr_txt_d@@>Diese Einstellung hat in der Regel moderate Auswirkungen auf die Leistung."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiviert Fußgänger in der Spielwelt."
