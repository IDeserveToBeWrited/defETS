#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "MIT WORLD OF TRUCKS VERBUNDENE INHALTE" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Verbinden" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Suchen" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "ALLGEMEINE EINSTELLUNGEN" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "INHALTE VERBINDEN" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Verbinden" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "'World of Trucks' hat neue Spielinhalte gefunden. Verbinde sie mit den 'World of Trucks'-Diensten, um dir ihre Vorteile zu erschließen." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online-Einstellungen. Bestimme alle 'World of Trucks'-bezogenen Einstellungen." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Möchtest du die Registrierung wirklich verschieben?<br><br>Du kannst auf das Fenster mit den Inhalten von 'Online Verbinden' später über die Online-Optionen auf dem Desktop zugreifen." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "INHALTE WERDEN VERBUNDEN" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Verbinde Inhalte ..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Der Prozess zum Verbinden von Inhalten schlug fehl bei: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Das von dir für die Registrierung dieser Erweiterung genutzte Steam-Benutzerkonto ist nicht identisch mit jenem, das für die Erstellung deines 'World of Trucks'-Kontos oder die Spielregistrierung verwendet wurde. Bitte wechsle dein Steam-Benutzerkonto und versuche es erneut." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Das von dir für die Registrierung dieses DLCs genutzte Steam-Benutzerkonto ist nicht identisch mit jenem, das für die Erstellung deines 'World of Trucks'-Kontos oder die Spielregistrierung verwendet wurde. Bitte wechsele dein Steam-Benutzerkonto und versuche es erneut." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam-Token ist verfallen. Bitte versuche es später erneut." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Der Produktschlüssel zur DLC-Aktivierung ist nicht gültig. Bitte kontaktiere für Hilfe den Support: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Ein interner Fehler ist während der Registrierung des Spiels aufgetreten. Versuche es bitte später noch einmal." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "ERFOLG" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "INHALTE-BROWSER" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Glückwunsch! Die ausgewählten Erweiterungen wurden erfolgreich mit deinem 'World of Trucks'-Konto verbunden." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Das Verbinden von Inhalten ist nicht möglich, da das momentane Steam-Benutzerkonto zu einem anderen 'World of Trucks'-Benutzerkonto gehört." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Einige Erweiterungen konnten nicht mit dem Grundspiel verbunden werden.<br> Bewege den Mauszeiger über die Ausrufezeichen der betroffenen Erweiterungen, um mehr Informationen zu erhalten." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registriere $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Das aktuelle Profil ist nicht mit World of Trucks verbunden oder das Spiel läuft im Offline-Modus. Bearbeite das Profil, um eine Verbindung herzustellen." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Zum Verlassen klicken"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ kompatiblen Erweiterungen verbunden. Sollten einige Erweiterungen nicht mit 'World of Trucks' verbunden sein, könnten dir Spielinhalte fehlen." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Glückwunsch! <color value=@@clr_txt@@>Sämtliche deiner Inhalte sind mit World of Trucks verbunden! Du kannst nun alle Spielinhalte nutzen." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Keine Verbindung zu neuen Inhalten von 'World of Trucks' möglich, da das momentan genutzte Steam-Benutzerkonto nicht das Konto ist, das vom 'World of Trucks'-Profil verwendet wird." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Verbunden" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nicht verbunden" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Einholen von Informationen über eigene Inhalte nicht möglich." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Einholen von Informationen über verbundene Inhalte nicht möglich." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Einholen von Informationen über verwendetes Benutzerkonto nicht möglich." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Später" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Erweiterung konnte nicht registriert werden, weil keine dauerhafte Spiellizenz gefunden wurde. Wahrscheinliche Ursache ist die Nutzung des Spiels über die Steam-Familienbibliothek." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Keine permanente Lizenz vorhanden" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Schwertransport abgeschlossen!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISSION GESCHEITERT!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Abbrechen"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Wegpunkt laden"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Du hast das Begleitfahrzeug beschädigt!<br> Lade wahlweise einen Wegpunkt oder brich die Lieferung gegen eine Strafzahlung von $MONEY$ ab."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Begleitfahrzeug wurde aufgrund falscher Fahrweise in einen Verkehrsunfall verwickelt.<br> Lade wahlweise einen Wegpunkt oder brich die Lieferung gegen eine Strafzahlung von $MONEY$ ab."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Du warst angehalten der Route zu folgen.<br> Lade wahlweise einen Wegpunkt oder brich die Lieferung gegen eine Strafzahlung von $MONEY$ ab."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Du warst angehalten, bei den Begleitfahrzeugen zu bleiben.<br> Lade wahlweise einen Wegpunkt oder brich die Lieferung gegen eine Strafzahlung von $MONEY$ ab."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Du hast deine Position zwischen den Begleitfahrzeugen verlassen!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Du hast das Begleitfahrzeug beschädigt!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Unfall des Begleitfahrzeugs!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Du hast die Route verlassen!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Abmessungen"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Schwertransport"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Die Fracht ist zwischen den Begleitfahrzeugen zu halten."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Schwertransporte"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Abmessungen"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Spezialtransport"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Geschwindigkeit reduzieren, um Kollision mit Begleitfahrzeug zu vermeiden ..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Bitte auf hinteres Begleitfahrzeug warten ..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Unmittelbar bevorstehender Routenabschnitt erfordert besondere Vorsicht ..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Spurwechselmanöver steht bevor. Geschwindigkeit anpassen, um Kollision zu vermeiden ..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Das vordere Begleitfahrzeug warnt andere Verkehrsteilnehmer ...<br> Passen Sie Ihre Geschwindigkeit zur Vermeidung von Kollisionen an ..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Die Begleitfahrzeuge warten an einer Kreuzung auf dich. Folge einfach der Route."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Achtung!<br>Sie fahren auf das hintere Begleitfahrzeug zu!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Achtung!<br>Sie kommen dem hinteren Begleitfahrzeug gefährlich nah!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Um das Schwertransportangebot anzusehen, drücke:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Schwertransportangebot:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Du bist dabei, eine Sondertransportladung zu befördern! Es gibt zwei Begleitfahrzeuge, die dir vorangehen werden. Bitte sei vorsichtig und folge ihren Anweisungen und Hinweisen. Sondertransporte wie dieser halten nicht an roten Ampeln und haben in den meisten Situationen Vorfahrt. Während dieser Lieferungen werden häufiger Kontrollpunkte eingerichtet, um deinen aktuellen Fortschritt zu speichern."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Achte besonders auf Folgendes:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Vermeide jeglichen Konflikt mit den Begleitfahrzeugen und halte die Fracht zwischen ihnen."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Weiche nicht von der geplanten Route ab und suche keinesfalls Tankstellen, Rastplätze oder Ähnliches auf."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Beachte die Geschwindigkeitsbeschränkungen, die durch das vordere Begleitfahrzeug sichergestellt werden."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Achte auf Überholer und andere Fahrzeuge."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Spurwechselmanöver:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Befolgst du diese Regeln nicht, könnte dein Schwertransport scheitern!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Das Manöver wird vom <color value=@@clr_sel@@>hinteren<color value=@@clr_txt@@> Begleitfahrzeug eingeleitet, das auf die vorgesehene Spur wechselt und sie freihält."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Das <color value=@@clr_sel@@>vordere<color value=@@clr_txt@@> Begleitfahrzeug wartet, bis die vorgesehene Spur frei ist, und wechselt dann ebenfalls die Spur."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Danach kannst <color value=@@clr_sel@@>Du<color value=@@clr_txt@@> gefahrlos auf die vorgesehene Spur wechseln."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Die Tanks wurden aufgefüllt und die Fahrzeiten zurückgesetzt."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Während eines Schwertransports kannst du keinen Pannendienst rufen."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Während eines Schwertransports kannst du keine Fähre nutzen."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Du machst eine Ruhepause...<br>Dein Lkw wird getankt..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Verpflichtende Ruhepause.<br>Folge dem Begleitfahrzeug zum Parkplatz!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Pflichtpause"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Drücke die folgende Taste, um zu tanken und eine Ruhepause zu machen:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Fehler während des Ladens von Steam-Inventarinhalten.<br><br>$ERROR$<br><br>Wähle \"Fortfahren\", um die Inhalte weiterhin zuzulassen. Das Spiel wird in gewissen Abständen danach suchen.<br><br>Deaktiviere die Inhalte, um Fehlermeldungen wie diese nicht erneut zu sehen. Die Inhalte werden beim nächsten Spielstart automatisch wieder aktiviert." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Download von Steam-Inventarobjekten nicht möglich." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM-INVENTAR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Lade Steam-Inventarobjekte ..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NEUE INVENTAROBJEKTE" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Es wurden neue Steam-Inventarobjekte erkannt." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Fahrzeugzubehör" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Kabinenzubehör" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Desktop-Hintergrund" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Lackierung" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Deaktiviere Inventar" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Bitte später erneut versuchen" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM-INVENTAR" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Einige Objekte wurden aus deinem Steam-Inventar entfernt. Du wirst diese nicht länger in der Werkstatt kaufen können.<br><br>Davon unberührt bleiben deine momentan installierten Objekte." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


