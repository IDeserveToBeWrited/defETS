	key[]: "verification"
	val[]: "SCHLÜSSELÜBERPRÜFUNG" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "verifying"
	val[]: "Überprüfung des Produktschlüssels. Bitte warten." #+ Shown in message box while the verification operation is in progress.

	key[]: "verification_required"
	val[]: "Es ist erforderlich, dass das Spiel den Produktschlüssel überprüft. Hierzu wird es versuchen, deine Internetverbindung zu nutzen.<br><br>Sollte dieser Computer nicht mit dem Internet verbunden sein, könntest du die auf <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK> beschriebene Offline-Aktivierung anwenden."

	key[]: "unable_to_verify"
	val[]: "Es war dem Spiel nicht möglich, den Produktschlüssel zu prüfen. Du kannst zunächst fortfahren.<br><br>Eine erneute Überprüfung wird während des nächsten Spielstarts erfolgen. Sollte das Problem weiter bestehen, so vergewissere dich bitte, dass du mit dem Internet verbunden bist, oder nutze die auf <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK> beschriebene Offline-Aktivierung."

	key[]: "unable_to_verify_version"
	val[]: "Es war nicht möglich, den Produktschlüssel zu prüfen, ein Spielupdate wird empfohlen. Du kannst zunächst fortfahren.<br><br>Eine erneute Überprüfung wird während des nächsten Spielstarts erfolgen. Sollte das Problem weiter bestehen, so vergewissere dich bitte, dass du mit dem Internet verbunden bist, oder nutze die auf <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK> beschriebene Offline-Aktivierung."

