	key[]: "gamepad_or_joy"
	val[]: "Gamepad oder Joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Der Controller ist ein Lenkrad oder verhält sich wie eines. Die Stellung des Controllers bestimmt direkt die Position des Lenkrades im Spiel."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Der Controller ist ein Gamepad oder ein Joystick. Die Position des Controllers bestimmt die Drehgeschwindigkeit des Lenkrads im Spiel."
#@}

