#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Auswahl der Themen, die im Hintergrund angezeigt werden."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiviert die zufällige Auswahl eines Hintergrundbilds bei jedem Spielstart."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Bestimmt die Zeit, nach der die Elemente auf dem Desktop ausgeblendet werden."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Funktion aktiviert ist, wirst du mit der Zeit die Auswirkungen von Müdigkeit spüren.<br><br>Verstöße gegen Ruhezeiten werden mit Bußgeldern geahndet."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Funktion aktiviert ist, musst du dich an die Verkehrsregeln halten oder du riskierst ein Bußgeld. Das Risiko ist in der Nähe von Polizeifahrzeugen, Geschwindigkeitsmessgeräten und Videoüberwachung erhöht."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert die durchschnittliche Länge der angebotenen Aufträge."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Wähle aus, welche Geschwindigkeitsbegrenzung auf dem Navigationswidget angezeigt werden soll."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Die aktuelle Geschwindigkeit auf der Navigation wird rot angezeigt, wenn die Geschwindigkeitsbegrenzung überschritten wird."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn du dein Ziel erreichst, wird ein Widget angezeigt, mit dem du das Parken überspringen kannst."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Blendet alle Widgets aus."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Hält beide HUD-Spiegel verdeckt."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Verbirgt alle Benachrichtigungen, auch wenn sie empfangen werden."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Zeigt vor der Annahme eines Schwerlast-Auftrags ein Fenster mit den Fahreigenschaften der aktuellen Zugmaschine an."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Wähle die Ausrichtung der Weltkarte aus."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Wähle aus, wie die Weltkarte erkundet werden soll:<br>- Bei der „Umgebungserkundung“ wird ein größeres Gebiet als erkundet markiert.<br>- Bei der „Präzisionserkundung“ werden nur die Bereiche unmittelbar um den Spieler herum angezeigt."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Wähle aus, wo das Navi angezeigt werden soll."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändert die Navigationsführung der Route.<br>- Der Navigationsmodus \"Beste\" wählt das effektivste Verhältnis zwischen Länge und Fahrtdauer der Route und versucht Ampelkreuzungen usw. zu vermeiden.<br>- Der Navigationsmodus \"Kürzeste\" wählt immer die kürzeste Route. <br>- Der Navigationsmodus \"Kleine Straßen\" vermeidet Autobahnen, wo dies möglich ist."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändert den Schwierigkeitsgrad beim Parken.<br>- „Immer wählen“ kannst du bei Ankunft selbst bestimmen, wie du parken willst. <br>- „Einfaches Parken“ erfordert kein Rückwärtsfahren.<br>- „Parken für Geübte“ erfordert in der Regel ein anspruchsvolleres Manöver mit Rückwärtsfahren."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Passt die Wahrscheinlichkeit an, dass du in der Umgebung auf Straßenhindernisse wie Unfälle, defekte Fahrzeuge, Gegenstände auf der Fahrbahn usw. stößt."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Passt die Wahrscheinlichkeit an, dass du während der Auftragsfahrt auf eine Umleitung stößt."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Passt die Wahrscheinlichkeit von schlechtem Wetter an."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, ob zusätzlich zur aktuellen Zeit Informationen zur Zeitzone angezeigt werden."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiviert Zwischensequenzen im Spiel, die normalerweise nach dem Kauf von Lkw, nach Garagen-Upgrades oder während des Einsteigens von Passagieren angezeigt werden."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, ob vor nicht befahrbaren Straßen halbdurchsichtige Sperrzeichen angezeigt werden."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Kehrt die Bewegung auf der Y-Achse bei der Steuerung der Kamera mit der Maus im Spiel um."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Wählt die Getriebeart aus.<br>- \"Einfache Automatik\" ermöglicht die Verwendung von Gaspedal und Bremse zum Vorwärts- und Rückwärtsfahren.<br>- \"Echte Automatik\" erfordert eine Eingabe, um zwischen Vorwärts- und Rückwärtsgang zu wechseln.<br>- \"Sequentielle Schaltung\" erfordert das manuelle Schalten aller Gänge mit Hoch- und Herunterschalten.<br>- \"H-Schaltung\" erfordert die Verwendung eines Steuergeräts mit Kulissenschaltung, um die Gänge manuell zu wählen."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Diese Funktion ermöglicht es, Gänge zu überspringen, wenn dies notwendig oder sinnvoll ist, um nicht jeden Gang des Getriebes zu schalten."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Zentriert das Lenkrad automatisch, wenn eine Tastatur oder ein Gamepad verwendet wird.<br><br>Wenn diese Funktion deaktiviert wird, muss das Lenkrad nach einer Kurve wieder manuell zentriert werden."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Passt die Reichweite der Lenkradanimation an."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert die Stärke der Bremsen."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert die Stabilität des Aufliegers durch Absenkung des Schwerpunkts."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert die Steifigkeit der Fahrwerksfederung."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert die Steifigkeit der Kabinenfederung."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Passt die Intensität der erzeugten Oberflächenunebenheiten an, um Straßen und anderes Terrain uneben wirken zu lassen. <br><br>Abhängig von anderen Federungs- und Kameraeinstellungen kann der wahrgenommene Effekt mehr oder weniger ausgeprägt sein."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Ermöglicht das Aufsatteln für Erfahrene, das eine höhere Präzision erfordert, um die Sattelkupplung des Lkw mit dem Königszapfen des Aufliegers zu verbinden.<br><br>Wenn diese Funktion deaktiviert ist, wird das Aufsatteln eines Aufliegers wesentlich einfacher, da es keine Kollision zwischen dem Königszapfen und der Sattelkupplung gibt."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Legt fest, ob und welche Kabelverbindungen zwischen Lkw und Auflieger animiert werden. <br><br><color value=@@clr_txt_d@@> Die Aktivierung von Kabelverbindungen kann je nach Einstellung die Leistung von Systemen mit älterer Hardware beeinträchtigen."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiviert den elektronischen Geschwindigkeitsbegrenzer des Lkw von 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>Bei World-of-Trucks-Aufträgen ist diese Funktion dauerhaft aktiviert."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Funktion aktiviert ist und die Scheibenwischer auf die erste Stufe gestellt sind, schalten sich die Scheibenwischer automatisch ein und passen ihre Geschwindigkeit der jeweiligen Intensität des Regens an."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiviert die automatische Betätigung des Retarders beim Bremsen."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn diese Funktion aktiviert ist, unterstützt das Fahrzeug das Anfahren am Berg, indem es die Bremsen hält und so für einen sanften Start sorgt."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiviert die automatische Betätigung der Motorbremse beim Bremsen."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn diese Option aktiviert ist, startet der Motor, sobald das Gaspedal betätigt wird."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Senkt in Abhängigkeit vom Fahrzeuggewicht bei Bedarf automatisch die Liftachsen ab."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn diese Funktion aktiviert ist, hält das Fahrzeug standardmäßig eine niedrigere Drehzahl. Nach zweimaligem kurzem Drücken der Gas-Taste hält das Fahrzeug die volle Drehzahl, bis die Gas-Taste losgelassen wird. <br><br>Betrifft nur die Tastatureingabe."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simuliert den Druckluftverlust, der in der Realität bei zu häufigem Betätigen des Bremspedals auftritt.<br><br>Du musst dir den Druckluftvorrat gut einteilen, wenn du bergab fährst oder beim langsamen Einparken die Bremse mehrmals betätigst."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn diese Funktion deaktiviert ist, wird der Kraftstoffverbrauch weder durch den Fahrstil noch durch die Straßenverhältnisse beeinflusst.<br><br>Wenn diese Funktion aktiviert ist, wird der Kraftstoffverbrauch von verschiedenen Faktoren beeinflusst, darunter Fahrstil, Ladungsgewicht, Rollwiderstand und Geländeprofil. Er wird nicht mehr von der Fertigkeit @@skill_mechanical_title@@ beeinflusst."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn diese Option aktiviert ist, verhindert das ABS ein Blockieren der Räder, damit das Fahrzeug kontrollierbar bleibt und die Bremswirkung verbessert wird."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert die Schrittgröße, mit der die Geschwindigkeit des Tempomaten bei entsprechendem Tastendruck erhöht oder verringert wird."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändert die Abweichungstoleranz für die Zielgeschwindigkeit des Tempomaten."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Der Abstandstempomat regelt automatisch die Geschwindigkeit, um den Sicherheitsabstand zum vorausfahrenden Fahrzeug einzuhalten."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiviert die Notbremsung, wenn das System eine drohende Kollision erkennt.<br>Wähle, ob das System nur auf Fahrzeuge oder auf alle Hindernisse reagieren soll."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist und der Lichtschalter auf Position 1 steht, wird bei nachlassendem Tageslicht automatisch das Abblendlicht eingeschaltet."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert und das Fernlicht eingeschaltet ist, blendet das Fahrzeug automatisch das Fernlicht ab, wenn es ein entgegenkommendes oder vorausfahrendes Fahrzeug erkennt."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, wird der Blinker beim Zurückdrehen des Lenkrads automatisch ausgeschaltet."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, reagieren einige Zubehörteile im Innenraum auf Bewegungen des Fahrzeugs (z. B. hängende Deko und Wackelkopffiguren)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiviert das Schlingern der Innenkamera in Abhängigkeit von den Lenkbewegungen."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Regelt, wie stark die Funktion „Rotation Lenkungskamera“ auf Lenkbewegungen reagiert."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Regelt den Effekt der Funktion \"Rotation Lenkungskamera\" bei Rückwärtsfahrt."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "In Abhängigkeit vom Gebrauch der Blinker schwenkt die Innenkamera nach links bzw. rechts."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Wenn diese Option aktiviert ist, reagiert die Innenkamera auf Bewegungen des Fahrzeugs."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Regelt, wie stark die Innenkamera auf Bewegungen des Fahrzeugs reagiert."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Verändert, wie stark das Rollen der Innenkamera in Abhängigkeit von den Bewegungen des Fahrzeugs ausfällt."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Legt die Verzögerung fest, bevor die Kamera automatisch zurückzentriert wird.<br><br>Das Fahrzeug muss sich mit einer spürbaren Geschwindigkeit bewegen, damit dies aktiviert wird. Gilt nur für die Innen- und Verfolgungskamera beim Vorwärtsfahren und für die Herauslehn-Kamera beim Rückwärtsfahren."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Legt die Geschwindigkeit für die Kamerabewegung fest. Wird bei der automatischen Zentrierung der Kamera und beim Umschalten zwischen Innenkamera-Voreinstellungen verwendet."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Legt fest, wie der Innenzoom funktioniert: Halte die Taste gedrückt, um vorübergehend zu zoomen, oder drücke einmal, um ihn umzuschalten." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Wählt die Sprache aus, die im Spiel angezeigt wird."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Ändert die Voreinstellungen für Währung und Maßeinheiten auf Grundlage der ausgewählten Region."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, werden die Namen der Städte und Staaten in deiner gewählten Sprache angezeigt."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, werden die Namen der Städte und Staaten auf der Karte sowohl in deiner gewählten Sprache als auch in der Landessprache der jeweiligen Region angezeigt."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Währung verwendet werden soll."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle für die Anzeige der Uhrzeit zwischen 12 und 24 Stunden."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Längeneinheit verwendet werden soll."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Gewichtseinheit verwendet werden soll."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Temperatureinheit verwendet werden soll."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Druckeinheit angezeigt werden soll."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Volumeneinheit verwendet werden soll."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Wähle, welche Verbrauchseinheit angezeigt werden soll."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, wird mit der Taste \"Aktivieren\" (@@imv_nrm_activate@@) in Konvoi-Sitzungen der Chat geöffnet."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, bleibt die Chat-Eingabezeile nach dem Senden einer Nachricht geöffnet."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, werden Chat-Nachrichten nach einigen Sekunden ausgeblendet."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Legt fest, nach welcher Zeitdauer die Chat-Nachrichten ausgeblendet werden."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Wenn diese Option aktiviert ist, werden in Konvoi-Sitzungen die Namen der Spieler über ihren Fahrzeugen angezeigt."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Öffnet ein erweitertes Menü zur Konfiguration der Schnellantworten im Konvoi-Chat."

