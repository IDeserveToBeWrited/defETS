	val[]: "Startpunkt der Blickverfolgung"

	key[]: "eye_gaze_end_point"
	val[]: "Endpunkt der Blickverfolgung"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Gierempfindlichkeit der Kopfverfolgung (im Fahrerhaus)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Neigungsempfindlichkeit der Kopfverfolgung (im Fahrerhaus)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Gierempfindlichkeit der Kopfverfolgung (im Laufmodus)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Neigungsempfindlichkeit der Kopfverfolgung (im Laufmodus)"

	key[]: "eye_head_exponent"
	val[]: "Exponent für die Verfolgung der Kopfbewegung"

	key[]: "eye_head_inflection_point"
	val[]: "Wendepunkt für die Verfolgung der Kopfbewegung"

	key[]: "eye_head_start_point"
	val[]: "Startpunkt für die Verfolgung der Kopfbewegung"

	key[]: "eye_head_end_point"
	val[]: "Endpunkt für die Verfolgung der Kopfbewegung"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Aktiviert die erweiterte Sicht, die es ermöglicht, das Sichtfeld zu vergrößern, indem mit Kopf- und/oder Augenbewegungen die Kamera im Spiel gesteuert wird."

	key[]: "eye_preset_op_tooltip"
	val[]: "Auswahl der Voreinstellungen der erweiterten Sicht."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Auswahl des Modus für die Verfolgung der Kopfbewegung.<br>- Im Modus \"Direkt\" bewirkt jede Kopfdrehung unmittelbar eine entsprechende Kamerarotation im Spiel. Diese Einstellung wird für normale Cockpit- oder Fahrerhausperspektiven empfohlen.<br>- Im Modus \"Dynamisch\" beeinflusst die Blickveränderung erst dann die Kamera, wenn auch der Kopf gedreht wird. Dies wird für Situationen empfohlen, die eine absolut zentrierte Ansicht erfordern."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Wenn diese Option aktiviert ist, bewegt sich die Blickrichtung im Spiel permanent langsam in die Mitte zurück, um deine natürliche Kopfbewegung während des Spiels auszugleichen."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Wenn diese Option aktiviert ist, beeinflusst deine Kopfposition die Blickrichtung im Spiel."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Wenn diese Option aktiviert ist und du deinen Kopf zur Seite neigst, neigt sich die Ansicht im Spiel entsprechend mit."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multipliziert die kombinierte Kopf- und Blickdrehung in horizontaler Richtung (im Fahrerhaus)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multipliziert die kombinierte Kopf- und Blickdrehung in vertikaler Richtung (im Fahrerhaus)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multipliziert die kombinierte Kopf- und Blickdrehung in horizontaler Richtung (im Laufmodus)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multipliziert die kombinierte Kopf- und Blickdrehung in vertikaler Richtung (im Laufmodus)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Legt fest, wie schnell die Kamera im Spiel auf Veränderungen deiner Blickrichtung reagiert."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Legt fest, wie schnell die Geschwindigkeit ansteigt."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Legt die Entfernung der Blickrichtung von der Mitte des Bildschirms fest, ab der die Beschleunigung nicht mehr größer wird."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Legt die Entfernung der Blickrichtung von der Bildmitte fest, ab der die Kamera anfängt, sich zu bewegen."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Legt die Entfernung der Blickrichtung von der Bildmitte fest, ab der die Bewegung der Kamera ihre Maximalgeschwindigkeit erreicht."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Legt fest, wie weit die Kamera schwenken kann, wenn du an die Ränder des Bildschirms schaust."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Legt fest, wie schnell die Kamera im Spiel auf deine Kopfbewegungen reagiert."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Legt fest, wie weit sich die Kamera im Verhältnis zur Kopfdrehung nach links oder rechts mitdreht (im Fahrerhaus)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Legt fest, wie stark sich die Kamera im Verhältnis zu deiner Kopfbewegung nach oben oder unten mitbewegt (im Fahrerhaus)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Legt fest, wie weit sich die Kamera im Verhältnis zur Kopfdrehung nach links oder rechts mitdreht (im Laufmodus)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Legt fest, wie stark sich die Kamera im Verhältnis zu deiner Kopfbewegung nach oben oder unten mitbewegt (im Laufmodus)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Legt fest, wie schnell die Geschwindigkeit ansteigt."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Legt fest, wie weit du deinen Kopf drehen musst, bis die Beschleunigung nicht mehr größer wird."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Legt fest, wie weit du deinen Kopf aus der Mittelposition drehen musst, bis sich die Kamera bewegt."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Legt fest, wie weit du deinen Kopf aus der Mittelposition drehen musst, bis die Rotation der Kamera ihr Maximum erreicht."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Auswahl der Modi für die automatische Pausierung."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Zeit in Millisekunden, bevor das Spiel automatisch angehalten wird, wenn dein Blick nicht mehr erkannt wird."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Legt eine Taste fest, die deine aktuelle Kopfposition als neuen Standard speichert, wodurch die Ansicht im Spiel entsprechend zentriert wird."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Legt eine Taste zum Ein-Ausschalten aller Funktionen der erweiterten Sicht von Tobii fest."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Legt eine Taste fest, mit der die Einstellungen der Blickverfolgung geöffnet werden."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Legt eine Taste fest, mit der die Verfolgung der Kopfbewegung eingeschaltet wird."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Legt eine Taste für die entsprechende Voreinstellung der erweiterten Sicht fest."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Legt eine Taste für die entsprechende Voreinstellung der erweiterten Sicht fest."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Legt eine Taste für die entsprechende Voreinstellung der erweiterten Sicht fest."
