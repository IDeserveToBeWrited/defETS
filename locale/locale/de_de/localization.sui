	key[]: "wotr_connected_content"
	val[]: "Mit World of Trucks verbundene Inhalte" #+ Information and buttons for connecting World of Trucks content.

	key[]: "online_news"
	val[]: "Online-Neuigkeiten" #+ Checkbox enabling display of online news and informations about game updates.

	key[]: "online_loading_screens"
