#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Bank" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Wenn du Geld brauchst, kannst du jederzeit bei der Bank nach einem Darlehen fragen." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "KREDITANGEBOTE" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "für $MONEY$ pro Tag" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Anzahl offener Kredite: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Ungenutzter Kreditrahmen: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "OFFENE KREDITE - ÜBERBLICK"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Kredit" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Zur Rückzahlung<br>verbleibend" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Laufzeit (in Tagen)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Zinssatz (p. a.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Rate" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Zurückzahlen" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Gesamt:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Kontostand: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NEUER KREDIT" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Anfrage für einen Kredit in Höhe von<br> $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Rückzahlungszeitraum:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Zinssatz (p. a.):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Tägliche Rate:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Möchtest du deinen Antrag bestätigen?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "KREDIT ZURÜCKZAHLEN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Sicher, dass du jetzt $MONEY$ für die Rückzahlung des Kredits verwenden möchtest?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


	key[]: "bank_msg_payment"
	val[]: "Kreditraten in einer Gesamthöhe von $MONEY$ wurden gezahlt."

	key[]: "bank_msg_ptsold"
	val[]: "Zur Tilgung Ihres Kredites wurde Ihr Lkw versteigert. Erlös: $MONEY$."

