	key[]: "wiz_cfg_open_overlay"
	val[]: "Controller-Einstellungen öffnen"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Verwende @@imm_wiz_dsteerleft@@ und @@imm_wiz_dsteerright@@, um zu lenken."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Bewege die Maus nach links oder rechts, um das Lenkrad sich in die entsprechende Richtung drehen zu lassen. "

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Verwende @@ima_wiz_j_steer@@, um zu lenken."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Verwende @@imm_wiz_dforward@@, um vorwärts zu fahren und @@imm_wiz_dbackward@@, um rückwärts zu fahren."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Bewege @@ima_wiz_j_throttle@@ nach vorne, um vorwärts zu fahren und ziehe ihn nach hinten, um rückwärts zu fahren."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Verwende @@ima_wiz_j_throttle@@, um vorwärts zu fahren und @@ima_wiz_j_brake@@, um rückwärts zu fahren."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Verwende @@imm_wiz_dforward@@, um zu beschleunigen und @@imm_wiz_dbackward@@, um zu bremsen."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Bewege @@ima_wiz_j_throttle@@ nach vorne, um zu beschleunigen und ziehe ihn nach hinten, um zu bremsen."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Verwende @@ima_wiz_j_throttle@@, um zu beschleunigen und @@ima_wiz_j_brake@@, um zu bremsen."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Verwende @@imv_wiz_gearup@@, um vorwärts zu schalten und @@imv_wiz_geardown@@ zum Rückwärtsschalten."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Verwende @@imv_wiz_gearup@@, um vorwärts zu schalten und @@imv_wiz_geardown@@ zum Rückwärtsschalten, wenn du Tastatur oder Controllerbuttons nutzt. Über @@imv_wiz_drive@@ und @@imv_wiz_reverse@@ wählst du die Fahrtrichtung, wenn du mit H-Schaltung fährst."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Verwende @@imv_wiz_gearup@@ und @@imv_wiz_geardown@@, um den gewünschten Gang auszuwählen."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Benutze deine H-Schaltung zusammen mit @@ima_wiz_j_clutch@@, um den gewünschten Gang einzulegen."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "CONTROLLER-ACHSEN EINSTELLEN" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Achsenvisualisierung"

	key[]: "wiz_setup_axes_desc"
	val[]: "Du kannst dir optisch einen Eindruck von der Funktionsweise aller gewählten Achsen verschaffen: Nutze den Controller und betrachte dabei die sich bewegenden Balken. Es werden dir die Reaktionsgrenzen, die Ausrichtung und das Gesamtverhalten der getesteten Achsen angezeigt."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Achseneinstellungen"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Um eine Achse zu wählen, drücke auf die Taste neben dem Achsennamen. Dadurch kommst du zum Eingabemodus. Bewege danach den Stick, das Rad oder das Pedal deines Eingabegeräts, um die Geräteachse mit der ausgewählten Achse zu verknüpfen."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Reaktionsschwellen"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Die Reaktionsschwelle blendet einen Teilbereich der Eingabeachse absichtlich aus. Nutze den entsprechenden Schieberegler, um die Reaktionsschwelle der ausgewählten Achse einzustellen. Die Reaktionsschwelle kann vergrößert werden, indem der Regler nach rechts geschoben wird. Diese Funktion ist besonders für ältere Geräte von Vorteil, da die Einstellung einer höheren Reaktionsschwelle Probleme wie Ungenauigkeit oder verschleißbedingte Fehlsignale verringern kann."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Achsenmodi"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Der Achsenmodus bestimmt, wie das Spiel die Eingabe interpretiert. Eine vertauschte Achse kehrt die Eingaberichtung um (d. h. wenn du mit dem Controller nach links lenkst, lenkt der Lkw im Spiel nach rechts). Eine zentrierte Achse hat ihre Ausgangsposition in der Mitte ihres Bewegungsfeldes (z. B. bei einem Joystick). Mit dem Achsenmodus lässt sich die Eingabe korrigieren, wenn eine Achse vom Spiel falsch erkannt wurde."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Vertauscht" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Zentriert" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Vertauscht und zentriert" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "EINSTELLUNG: AUTOMATIKGETRIEBE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Mit der Automatikschaltung musst du nur zwischen 'Drive', 'Neutral' und 'Reverse' umschalten. Dies erreichst du durch Drücken folgender Tasten/Knöpfe. Um die Einstellungen zu ändern, klicke auf eine Schaltfläche und drücke die gewünschte Taste bzw. den Knopf."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Wenn ein Gerät mit H-Schaltung angeschlossen ist, kannst du es zur Simulation einer echten Automatikschaltung nutzen. Aktiviere diese Option und du kannst die Schaltpositionen für die 'Drive'- und 'Reverse'-Modi festlegen. Alle anderen Positionen der H-Schaltung verhalten sich wie der 'Neutral'-Modus. Diese Einstellung wurde speziell für Geräte mit H-Schaltung entwickelt, sie funktioniert weder mit Maus noch Tastatur. Möchtest du etwas ändern, klicke auf eine Schaltfläche, bewege den Schalthebel in die gewünschte Position und dann in den Leerlauf."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "EINSTELLUNG: SEQUENTIELLES GETRIEBE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Das sequenzielle Getriebe schaltet zwischen allen Vorwärtsgängen, dem Leerlauf und dem Rückwärtsgang hin und her. Hier siehst du die Tasten oder Knöpfe für das Hoch- und Runterschalten. Um die Belegung zu verändern, klicke auf die entsprechende Schaltfläche und betätige die gewünschte Taste bzw. den Knopf."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "EINSTELLUNG: H-SCHALTUNGSGETRIEBE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Hier kannst du die Hauptanordnung für die H-Schaltung wählen und ausprobieren. Auf der Abbildung ist die momentane Position des Schalthebels und der ausgewählte Gang angezeigt. Weil ein echtes Lkw-Getriebe mehr Gänge hat als Schaltpositionen verfügbar sind, brauchst du Umschalter, mit denen du zwischen verschiedenen Getriebesätzen wechseln kannst."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Die momentane Schaltposition und der ausgewählte Getriebemodus sind unten markiert (orange). Um eine Belegung zu ändern, klicke auf die jeweilige Schaltfläche, bewege den Schalthebel in die gewünschte Position und dann wieder in den Leerlauf."
#@}

