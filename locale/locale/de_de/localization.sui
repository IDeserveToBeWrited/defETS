	val[]: "Fahre zu der auf der Karte angezeigten grünen Fahne."

	key[]: "job_load_title"
	val[]: "Auflieger wird beladen"

	key[]: "job_load"
	val[]: "Drücken Sie folgende Taste, um<br>den Auflieger zu beladen:"

	key[]: "job_autoload_title"
	val[]: "Automatisches Beladen"

	key[]: "job_autoload"
	val[]: "Um das Aufladen der Fracht zu überspringen,<br>drücke:"

	key[]: "job_unload_title"
	val[]: "Auflieger wird entladen"

	key[]: "job_unload"
	val[]: "Drücken Sie folgende Taste, um den Auflieger abzuladen."

	key[]: "dynamic_cargo_job_load_title"
	val[]: "Auflieger wird beladen"

	key[]: "dynamic_cargo_load_progress"  #+ This text is shown in the adviser during dynamic cargo loading. Example: Loading progress:<br> 86 %. <br offset> To skip loading the trailer, press Enter or Num Enter.
	val[]: "Ladefortschritt:<br><color value=@@clr_sel@@><font face=/font/normal.font>$PERCENT$</font><color value=@@clr_txt@@><br offset=10>Um das Laden des Trailers zu überspringen, drücke:<br>"

	key[]: "dynamic_cargo_load_next_trailer"  #+ This text is shown in the adviser during dynamic cargo loading when a player has completed loading of the current trailer and needs to move the next empty one under the loader.
	val[]: "Der aktuelle Anhänger ist voll. Bitte fahre einen leeren Anhänger unter den Lader. <br $OFFSET$>Um das Beladen des Anhängers zu überspringen, drücke:<br>"

	key[]: "dynamic_cargo_job_unload_title"
	val[]: "Auflieger wird entladen"

	key[]: "dynamic_cargo_unload_progress" #+ This text is shown in the adviser during dynamic cargo unloading. Example: Unloading progress:<br> 86 %. <br offset> To skip unloading the trailer, press Enter or Num Enter.
	val[]: "Entladefortschritt:<br><color value=@@clr_sel@@><font face=/font/normal.font>$PERCENT$</font><color value=@@clr_txt@@><br offset=10>Um das Entladen des Anhängers zu überspringen, drücke:<br>"

	key[]: "dynamic_cargo_unload_next_trailer"  #+ This text is shown in the adviser during dynamic cargo unloading.
	val[]: "Der aktuelle Anhänger ist leer. Bitte fahre einen nicht leeren Anhänger unter den Lader. <br $OFFSET$>Um das Entladen des Anhängers zu überspringen, drücke:<br>"

	key[]: "dynamic_cargo_job_button_hint" #+ This text is added to buttons with parking difficulty. Example: Where do you need it? (Dynamic). Space is added separately.
	val[]: "(Dynamisch)"

	key[]: "cargo_market_t"
	val[]: "FRACHTMARKT"

	key[]: "cargo_market"
	val[]: "Frachtmarkt"

	key[]: "cargo_market_desc"
	val[]: "Verwende deinen eigenen Auflieger, um eine große Vielfalt von Frachten an ihr Ziel zu bringen." #+ The description of an Cargo Planner icon, used to open a window for selecting cargo with owned trailer.

	key[]: "trailerman_title"
	val[]: "EIGENE AUFLIEGER"

	key[]: "trailerman_link_title"
	val[]: "Auflieger-Manager"

	key[]: "trailerman_notice_t"
	val[]: "AUFLIEGER-MANAGER"

	key[]: "trailerman_help"
	val[]: "Verwalte deine Auflieger, weise sie deinen Fahrern zu, kaufe neue, verlege den Standort und vieles mehr."

	key[]: "trailerman_summary_hint"
	val[]: "Wähle rechts einen Auflieger, um seine Details anzuzeigen."

	key[]: "trailerman_tut_utilization"
	val[]: "Prozentwert der täglichen Aufliegernutzung bei der momentanen Wirtschaftssituation. Grundlage ist die Stundenzahl pro Tag, die deine Fahrer mit dem Auflieger arbeiten. Die Grafik wird zu Beginn jedes Tages aktualisiert. Höhere Prozentwerte weisen auf eine größere Nachfrage nach einem bestimmten Aufliegertyp in einer Garage hin." #+ The utilization graph hint text.

	key[]: "trailerman_tut_overview"
	val[]: "Alle Auflieger, die du bisher erworben hast, kannst du dir hier ansehen und verwalten – im Auflieger-Manager.<br><br>Deinen Fahrern wird automatisch ein Auflieger zugewiesen, der sich in derselben Garage befindet. Auf diese Weise können sie alle an ihrem Standort verfügbaren Auflieger für ihre Fahrten nutzen.<br><br> Um den Einsatz bestimmter Auflieger auf dich zu beschränken, wähle „Privat“ in den Einstellungen. Wenn du sie wieder freigeben willst, um die Wirtschaftlichkeit deiner Garagen zu erhöhen, wähle „Freigeben“." #+ The text shown in trailer manager overview tutorial box.

	key[]: "trailer_config"
	val[]: "Auflieger- Konfigurator"

	key[]: "trailer_config_about"
	val[]: "Passe die Konfiguration deines Aufliegers an, rüste ihn auf oder lackiere ihn nach deinen persönlichen Vorlieben."

	key[]: "truckman_gar_trailers"
	val[]: "Auflieger:"

	key[]: "garage_name"
	val[]: "Garage:"

	key[]: "no_truck_assigned"
	val[]: "Kein Lkw zugewiesen."

	key[]: "no_trailer_assigned"
	val[]: "Kein Auflieger zugewiesen."

	key[]: "no_driver_assigned"
	val[]: "Kein Fahrer zugewiesen."

	key[]: "garageman_op_log"
	val[]: "Ökonom. Erfolg" #+ Garage manager operation opening economy log of the garage.

	key[]: "garageman_op_upgrade"
	val[]: "Aufrüsten" #+ Garage manager operation upgrading garage.

	key[]: "garageman_op_travel"
	val[]: "Schnell- reise" #+ Garage manager operation for teleporting player to the selected garage.

	key[]: "trailerman_msg_operationfail_onjob"
	val[]: "Aktion konnte nicht ausgeführt werden. Beende zunächst deinen aktuellen Auftrag." #+ The message shown when user cannot do the operation because he is on job.

	key[]: "trailerman_msg_takefail_notruck"
	val[]: "Auflieger konnte nicht ausgewählt werden, da du momentan keinen Lkw fährst." #+ The message shown when user cannot take trailer because he is currently not driving any truck.

	key[]: "trailerman_trailer_taken"
	val[]: "Der ausgewählte Auflieger steht abholbereit in deiner Garage in $CITY$." #+ Success message when trailer was delivered to the selected garage.

	key[]: "trailerman_trailer_taken_ingarage"
	val[]: "Der ausgewählte Auflieger wurde angekuppelt." #+ Success message when trailer was taken and attached to player's truck.

