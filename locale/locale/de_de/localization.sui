	key[]: "eye_t"
	val[]: "EYE-TRACKING" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Erweiterte Sicht" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Vorlagen für Erweiterte Sicht" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Name für Vorlage eingeben" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Bist du sicher, dass du die ausgewählte Vorlage löschen möchtest?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Es existiert bereits eine Vorlage mit diesem Namen. Soll sie überschrieben werden?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Blick-Tracking-Einstellungen" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Kopf-Tracking-Einstellungen" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Tastenbelegung" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Erweiterte Sicht aktivieren" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Autozentrierung aktivieren" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Head-Tracking-Modus" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Direkt" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dynamisch" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Geschwindigkeit der Reaktion auf Blickveränderungen" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Geschwindigkeit der Reaktion auf Kopfbewegungen" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Rollen aktivieren" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Position aktivieren" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Giermultiplikator (im Fahrerhaus)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Neigungsmultiplikator (im Fahrerhaus)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Giermultiplikator (im Laufmodus)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Neigungsmultiplikator (im Laufmodus)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
