	key[]: "blinker_auto_off"
	val[]: "Automatische Blinkerabschaltung" #+ Checkbox for enabling of automatic blinker turning off.

	key[]: "road_events"
	val[]: "Zufällige Straßenereignisse" #+ Slider for player modification of road event probability and placement.

	key[]: "rain_factor"
