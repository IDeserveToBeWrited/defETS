#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Unterart des Controllers fest, damit das Spiel die Eingabesignale fehlerfrei interpretiert."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Wählt die Getriebeart aus.<br>- \"Einfache Automatik\" ermöglicht die Verwendung von Gaspedal und Bremse zum Vorwärts- und Rückwärtsfahren.<br>- \"Echte Automatik\" erfordert eine Eingabe, um zwischen Vorwärts- und Rückwärtsgang zu wechseln.<br>- \"Sequentielle Schaltung\" erfordert das manuelle Schalten aller Gänge mit Hoch- und Herunterschalten.<br>- \"H-Schaltung\" erfordert die Verwendung eines Steuergeräts mit Kulissenschaltung, um die Gänge manuell zu wählen."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Ändert die Schaltlogik des Automatikgetriebes.<br>- Im \"Wirtschaftlichkeitsmodus\" werden zugunsten eines hohen Drehmoments geringere Drehzahlen bevorzugt.<br>- Im \"Leistungsmodus\" werden auf Kosten des Kraftstoffverbrauchs auf eine möglichst hohe PS-Zahl abgezielt, um das Fahrverhalten mit schwerer Fracht oder in bergigem Gelände zu verbessern."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Regelt das Verhältnis zwischen Drehbewegung des Eingabegeräts und tatsächlicher Lenkbewegung des Fahrzeugs."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Regelt den nicht-linearen Zusammenhang zwischen Eingabesignal und Fahrzeuglenkung.<br><br>Ein hoher Wert bewirkt, dass das Fahrzeug im Bereich der Mittelstellung des Lenkrads weniger stark auf Lenkbewegungen reagiert als im Bereich des maximalen Lenkeinschlags. Das kann hilfreich sein, um Lenkbewegungen auf gerader Strecke zu entschärfen."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Aktiviert Force Feedback, falls das Eingabegerät dies unterstützt."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die generelle Stärke aller Funktionen des Force Feedbacks im Bereich von 0N bis 10N.<br><br><color value=@@clr_txt_d@@> Bedenke dabei, dass eine höhere Einstellung bei kräftigen Lenkradmodellen Verletzungen an Händen oder Fingern verursachen kann."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Zentrierkraft bei hoher Geschwindigkeit, also 90 km/h (56 mph) oder mehr.<br><br>Die kleinste Einstellung bewirkt das Abschalten der Zentrierung."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Zentrierkraft bei niedriger Geschwindigkeit.<br><br>Die kleinste Einstellung bewirkt das Abschalten der Zentrierung."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Stärke der Reibung, die innerhalb der Fahrzeuglenkung zwischen den mechanischen Komponenten auftritt."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Regelt, wie stark sich die Motorresonanz auf die Lenksäule überträgt.<br><br><color value=@@clr_txt_d@@> Beachte, dass ein Wert über 15 % bei einigen Lenkradmodellen übermäßiges Wackeln und Vibrieren bewirken kann."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Regelt, wie stark sich die Beschaffenheit der Straßenoberfläche auf die Lenksäule überträgt.<br><br><color value=@@clr_txt_d@@> Beachte, dass ein Wert über 20% bei einigen Lenkradmodellen übermäßiges Wackeln und Vibrieren bewirken kann, wenn du auf unbefestigten Wegen schneller fährst."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Regelt, wie stark sich Bodenwellen auf die Lenksäule übertragen."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Regelt, wie stark sich Kollisionseffekte auf die Lenksäule übertragen."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Stärke der Schleifgeräusche bei Schaltfehlern."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Stärke der Rutscheffekte beim Untersteuern."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Passt die Intensität der Lenkunterstützung an (z. B. bei Verwendung des Spurassistenten.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Stärke der Vibrationen durch die Geländeoberfläche, falls der Controller eine Vibrationsfunktion hat."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Stärke der Vibrationen durch Bodenwellen, falls der Controller eine Vibrationsfunktion hat."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Regelt die Stärke der kollisionsbedingten Vibrationen, falls der Controller eine Vibrationsfunktion hat."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Auswahl der Lenkachse."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Verändert die Reaktionsschwelle der Lenkachse; bis zu dieser Schwelle werden Eingaben ignoriert.<br><br>Damit können Probleme mit alten Controllern wie z. B. Ungenauigkeit oder verschleißbedingte Fehlsignale verringert werden."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel die Eingabeachse interpretiert.<br>- \"Zentriert\" ist für Lenkräder oder Joysticks am besten geeignet.<br>- Mit \"Vertauscht\" kann eine Achse korrigiert werden, die fehlerhaft erkannt wurde."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Auswahl der Beschleunigungsachse."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Verändert die Reaktionsschwelle der Beschleunigungsachse; bis zu dieser Schwelle werden Eingaben ignoriert.<br><br>Damit können Probleme mit alten Controllern wie z. B. Ungenauigkeit oder verschleißbedingte Fehlsignale verringert werden."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel die Eingaben des Controllers interpretiert:<br>- \"Zentriert\" ist für Joysticks am besten geeignet.<br>- \"Normal\" ist für Triggertasten oder Pedale ideal. <br>- \"Vertauscht\" können Eingaben korrigiert werden, die fehlerhaft erkannt wurden."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Auswahl der Bremsachse."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Verändert die Totzone der Bremsachse an, d.h. den Betrag des Eingabewegs, bei dem keine Eingabe registriert wird.<br><br>Dies kann Probleme älterer Steuerungen wie Ungenauigkeit oder falsche Eingaben aufgrund von Abnutzung abmildern."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel die Eingaben des Controllers interpretiert:<br>- \"Zentriert\" ist für Joysticks am besten geeignet.<br>- \"Normal\" ist für Triggertasten oder Pedale ideal. <br>- \"Vertauscht\" können Eingaben korrigiert werden, die fehlerhaft erkannt wurden."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Auswahl der Kupplungsachse."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Verändert die Totzone der Kupplungsachse an, d.h. den Betrag des Eingabewegs, bei dem keine Eingabe registriert wird.<br><br>Dies kann Probleme älterer Steuerungen wie Ungenauigkeit oder falsche Eingaben aufgrund von Abnutzung abmildern."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel die Eingaben des Controllers interpretiert:<br>- \"Zentriert\" ist für Joysticks am besten geeignet.<br>- \"Normal\" ist für Triggertasten oder Pedale ideal. <br>- \"Vertauscht\" können Eingaben korrigiert werden, die fehlerhaft erkannt wurden."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Verändert den Kupplungsweg.<br><br>Je weiter nach rechts der Bereich eingestellt ist, desto stärker muss das Pedal zurückgenommen werden, um einzukuppeln."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Die Sichtachse für die vertikale Kamerabewegung."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Verändert die Reaktionsschwelle der vertikalen Sichtachse; bis zu dieser Schwelle werden Eingaben ignoriert.<br><br>Damit können Probleme mit alten Controllern wie z. B. Ungenauigkeit oder verschleißbedingte Fehlsignale verringert werden."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel die Eingabeachse interpretiert.<br>- \"Zentriert\" ist für Joysticks am besten geeignet.<br>- Mit \"Vertauscht\" kann eine Achse korrigiert werden, die fehlerhaft erkannt wurde."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Die Sichtachse für die horizontale Kamerabewegung."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Verändert die Reaktionsschwelle der horizontalen Sichtachse; bis zu dieser Schwelle werden Eingaben ignoriert.<br><br>Damit können Probleme mit alten Controllern wie z. B. Ungenauigkeit oder verschleißbedingte Fehlsignale verringert werden."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel die Eingabeachse interpretiert.<br>- \"Zentriert\" ist für Joysticks am besten geeignet.<br>- Mit \"Vertauscht\" kann eine Achse korrigiert werden, die fehlerhaft erkannt wurde."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Anordnung der Gänge für die H-Schaltung fest."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Ändert das Verhalten der Schaltung:<br>- Mit der Option \"Einfach\" tritt kein Schleifgeräusch auf.<br>- Die Option \"Einfach + Warngeräusche\" gestattet ebenfalls einfaches Schalten, verursacht bei Schaltfehlern jedoch ein Schleifgeräusch.<br>- Die Option \"Fortgeschritten\" erlaubt keinen Gangwechsel, wenn fehlerhaft geschaltet wird, sondern erzeugt dann nur Schleifgeräusche.<br>- Mit \"Fortgeschritten\" ist es außerdem möglich, die Einstellung \"Schaltung mit schnellem Split\" zu verwenden."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Legt fest, wie das Spiel mit schnellen Splits umgeht.<br>- Mit der Option \"Nie\" muss der Schalthebel zwischen den Splits in die Neutralstellung gebracht werden.<br>- \"Kupplung treten\" macht ein kurzes Betätigen der Kupplung ohne Bewegung des Schalthebels erforderlich.<br>- \"Gas zurücknehmen\" bedeutet ein kurzes Zurücknehmen des Gaspedals zum Split ohne Schalthebelbewegung.<br>- \"Kupplung oder Gas\" kombiniert die letzten beiden Optionen."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Position des Schalthebels fest."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Eingabe für den Range-Wechsel in Abhängigkeit von der Anordnung der Gänge fest."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Legt in Abhängigkeit von der Ganganordnung einen Umschalter für den Splitter der Schaltung fest."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Muss aktiviert werden, wenn die Range- oder Splitter-Eingabe per Schalter statt Taste erfolgt."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Taste für den Fahrmodus 'Drive' der Automatikschaltung fest."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Legt die Taste für den Fahrmodus 'Reverse' der Automatikschaltung fest."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Ermöglicht dynamisches RGB-Feedback auf kompatiblen Geräten."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Aktiviert und konfiguriert die Eye-Tracking-Funktionen für kompatible Geräte."
#@}

