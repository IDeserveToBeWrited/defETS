#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Die Bilddatei ist zu groß. Versuche bitte, die Bildschirmauflösung zu verringern." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Die Bilddatei ist beschädigt oder ihr Format wird nicht unterstützt." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Die Auflösung des Screenshots ist zu hoch. Versuche, die Bildauflösung zu verringern." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Der Dienst hat den Screenshot abgewiesen." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Das Konto erlaubt kein Hochladen von Screenshots." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Es gab ein gleichzeitiges Hochladen auf den selben Slot." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Das Hochladen ist momentan deaktiviert. Versuche es bitte später erneut." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Unbekannter Fehler während des Hochladens aufgetreten. Bitte später erneut versuchen. " #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Der Screenshot überschreitet die maximale Größe von $LIMIT$ und wurde daher verkleinert." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Die Bilddatei ist größer als das zulässige Limit von $LIMIT$KB und wurde daher angepasst." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

