	key[]: "screenshotman_help"
	val[]: "Ermöglicht dir das Hochladen von Screenshots auf das 'World of Trucks'-Portal."

	key[]: "screenshotman_desc"
	val[]: "Nutze den Fotomodus oder @@imv_nrm_screenshot@@, um Screenshots zu knipsen. Du kannst diese auf das 'World of Trucks'-Portal hochladen.<br> Wähle einen Screenshot, dann einen der unteren Web-Slots und drücke den <color value=@@clr_sel@@>Hochladen auf gewählten Slot<color value=@@clr_txt@@>-Button." #+ description

	key[]: "screenshotman_slot"
	val[]: "Speicherplätze der World-of-Trucks-Galerie." #+ Slots title

	key[]: "screenshotman_empty"
	val[]: "Wenn du einen Screenshot machst, kannst du ihn hier sehen." #+ Empty screenshot position

	key[]: "screenshotman_offline"
	val[]: "PROFIL IST NICHT VERBUNDEN!<br><br>Um ein Bild hochzuladen, muss dein Profil mit dem Onlinekonto verbunden sein.<br><br>Möchtest du dein Profil jetzt ändern?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Leerer Slot" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Fehler" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Hochladen auf gewählten Slot" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Als Zugmaschine meines Profils wählen" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Do you want to permanently delete the following screenshot?"

	key[]: "upload_screenshot"
	val[]: "Möchtest du den Screenshot auf den gewählten Slot hochladen?<br><br>Früher auf diesen Platz hochgeladene Inhalte werden damit überschrieben!"

	key[]: "upload_profile_screenshot"
	val[]: "Möchtest du den Screenshot als deinen 'World of Trucks'-Profil-Lkw hochladen? <br><br> Ein vorheriges Profilbild wird damit überschrieben!"

	key[]: "wotr_upload_title"
	val[]: "HOCHLADEHINWEIS"

	key[]: "new_screenshot"
	val[]: "Neue Fotos können hochgeladen werden!" #+ New screenshot notification

	key[]: "uploading_screenshot"
