#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "STEUERUNGSMETHODE WÄHLEN" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Controller"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value:@@clr_txt_d@@>Der Assistent wendet empfohlene Einstellungen basierend auf den angeschlossenen Geräten an.<br><color value=@@clr_sel@@>Wenn du ein Steam-kompatibles Gamepad verwendest, solltest du bei Steam den Konfigurationsassistenten aktivieren:<br><color value=@@clr_txt_d@@> \"Steam > Einstellungen > Controller > Allgemeine Controllereinstellungen\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Fahre mit der Tastatur und sieh dich mit der Maus um. Die einfachste und unpräziseste Art der Steuerung, aber für jeden verfügbar."

	key[]: "wiz_control_mouse"
	val[]: "Benutze die Maus, um präziser zu lenken. Die Tastatur wird weiterhin für andere Funktionen verwendet. Wenn du dich mit der Maus umsehen willst, musst du dabei die Taste zum Drehen der Ansicht gedrückt halten."

	key[]: "wiz_control_controller"
	val[]: "Nutze Lenkrad, Gamepad oder Joystick, um ein möglichst realistisches Spielerlebnis zu haben. Dazu kannst du weiterhin die Tastatur für viele Funktionen nutzen und mit der Maus die Kameraperspektive verändern (Mausblick)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Keinen Controller gefunden. Diese Auswahl wird nur aktiviert, wenn du einen Controller anschließt."

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Suche nach verfügbaren Controllern ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "CONTROLLER-API WÄHLEN" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Eingabe - In-Spiel Mapping Modus (empfohlen)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Eingabe - Steam Client Mapping Modus"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klassischer Controller"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepads wie @@controller_ps5@@, @@controller_xbox_one@@ oder @@controller_steam_deck@@, die das Steam Input-Interface und ein einfaches Layout verwenden.<br><br>Unterstützt vollständige Tastenbelegungen im Spiel."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepads, die das Steam Input-Interface verwenden und eigenständige Layouts nutzen, die über den Steam-Client konfiguriert wurden.<br><br>Eingeschränkte Unterstützung für Tastenhinweise im Spiel und keine Konfigurationen für Tastenbelegungen im Spiel."

	key[]: "wiz_api_classical"
	val[]: "Controller, Lenkrad oder Joystick, die DirectInput, XInput oder ein ähnliches Interface verwenden."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "CONTROLLERTYP WÄHLEN"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Lenkrad"

