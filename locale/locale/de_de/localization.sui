	key[]: "phys_cam_move"
	val[]: "Physikalisch beeinflusste Kamerabewegung" #+ Checkbox enabling camera movement based on driver physics.

	key[]: "phys_cam_move_factor"
	val[]: "Faktor der physikalisch beeinflussten Kamerabewegung" #+ Slider for physics based camera movement multiplier.

