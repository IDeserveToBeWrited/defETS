#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Die benötigte Spielerweiterung (DLC) $DEPENDENCY_NAME$ fehlt. Damit dieser Spielstand störungsfrei funktioniert, muss der genannte DLC auf deinem Computer vorhanden und aktiviert sein. Bevor du deinen Spielstand jetzt laden kannst, musst du dieses Problem beheben." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Folgende Spielerweiterung fehlt: $DEPENDENCY_NAME$. Ist diese Meldung für dich neu, solltest du den Status der Erweiterung prüfen.<br><br>Du kannst den Spielstand trotzdem laden, allerdings stehen Spielinhalte, die von dieser Erweiterung abhängig sind, dann nicht mehr zur Verfügung." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Folgender Mod fehlt oder ist inaktiv: $DEPENDENCY_NAME$ - ist diese Meldung für dich neu, solltest du den Zustand des Mods prüfen.<br><br>Du kannst versuchen, den Spielstand trotzdem zu laden. Je nach Funktion des fehlenden Mods kann es jedoch sein, dass der Ladevorgang fehlschlägt oder Probleme im Spiel auftreten." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Der Mod $DEPENDENCY_NAME$ ist mit deiner Spielversion inkompatibel. Der Modautor kennzeichnete den Mod als eingeschränkt kompatibel (nur für eine Auswahl von Spielversionen) und deine jetzige Spielversion ist nicht darunter.<br><br>Lösungen:<br>- Versuche eine aktuelle Version des Mods zu finden, die auch für deine jetzige Spielversion geeignet ist.<br>- Update dein Spiel oder installiere eine ältere Spielversion, um Kompatibilität mit dem Mod herzustellen.<br><br>Hinweis: Du könntest jetzt mit dem Laden des Spielstandes fortfahren, doch der inkompatible Mod wird nicht geladen. Die Folge kann sein, dass der Ladevorgang fehlschlägt oder andere Probleme auftreten (abhängig davon, was der fehlende Mod zuvor im Spiel bewirkte)." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "FEHLENDE ABHÄNGIGKEITEN" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETAILS" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Workshopseite öffnen"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Dieser Spielstand kann nicht geladen werden, da er von Zusatzpaketen (offizielle Erweiterungen/DLCs oder Mods) abhängig ist, die momentan nicht aktiv sind. In der folgenden Liste sind die fehlenden Inhalte aufgeführt. Wähle die einzelnen Einträge aus, um mehr Informationen zu erhalten." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Dieser Spielstand ist abhängig von mindestens einer zusätzlichen offiziellen Erweiterung (DLC) oder einem Mod, die nicht installiert oder aktiviert sind. Er kann nicht geladen werden, ehe der Fehler behoben ist. " #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Ladevorgang abbrechen" #+ Abort loading button.

	key[]: "type"
	val[]: "Art" #+ Type column.

	key[]: "dependency_name"
	val[]: "Name der Abhängigkeit" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokaler Mod" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop-Mod" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Optionaler DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Benötigte Spielerweiterung" #+ DLC that is required to load save that is depending on it.
#@}

