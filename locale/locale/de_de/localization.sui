#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Netzwerkebene nicht verfügbar. Bitte überprüfe, ob deine Klienteinstellungen richtig sind."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Fehler beim Verbinden mit dem Online-Server.<br>Bitte prüfe, ob deine Internet-Verbindung funktioniert."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Fehler während der Kommunikation mit dem Online-Dienst. Versuche es später noch einmal."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Fehlerhafte Daten vom Online-Dienst erhalten. Ist ein HTTP-Proxy in Gebrauch, überprüfe bitte dessen Konfiguration. Andernfalls versuche es später noch einmal."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Fehlerhafte Daten vom Online-Dienst erhalten. Versuche es später noch einmal."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Dieser Dienst ist nicht kompatibel mit der momentanen Version deines Spiels. Bitte überprüfe, ob ein neuer Patch für das Spiel vorhanden ist."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Dieser Dienst ist momentan nicht erreichbar. Bitte versuche es später nochmal. "

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Dieser Dienst ist momentan wegen Wartungsarbeiten oder Überlastung nicht verfügbar. Bitte versuche es später nochmal."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Die Authentifizierungsinformation ist nicht gültig. Bitte versuche dich erneut anzumelden. "

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Das Online-Konto ist momentan wegen zu häufiger fehlgeschlagener Anmeldeversuche gesperrt. Versuche es bitte in einer halben Stunde erneut. "

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Aufgrund verdächtiger Zugriffe ist dieses Online-Konto momentan gesperrt. Versuche es bitte in 24 Stunden nochmal."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Dieses Spiel ist nicht auf dieses Online-Konto registriert."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Das Konto wurde noch nicht aktiviert. Bitte prüfe deinen E-Mail-Posteingang auf eine eingegangene Nachricht zur Kontoaktivierung."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Dieses Konto wurde deaktiviert. Bitte wende dich an den technischen Support."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Dieses Konto wurde gesperrt. Bitte wende dich an den technischen Support."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy-Authentifizierung wird von diesem Spiel nicht unterstützt. Bitte verwende einen anderen Proxy oder eine Direktverbindung."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Das erforderliche Objekt ist momentan nicht verfügbar. Bitte versuche es in ein paar Minuten wieder."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL-Fehler. Es kann keine sichere Verbindung hergestellt werden."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Das Spiel wurde während der Online-Kommunikation unterbrochen. Bitte versuche es später erneut."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Interner Fehler. Die net.log-Datei könnte nähere Informationen enthalten."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 hat ein Problem festgestellt und kann auf deinem Computer keine Grafiken darstellen (keine gültige Grafikkarte gefunden).\nWir schlagen folgende Schritte vor:\n\n1. Prüfe, ob dein Computer und die Grafikkarte die minimalen Hardwareanforderungen erfüllt.\n2. Aktualisiere deinen Computer auf die neueste Version von Microsofts DirectX.\n3. Lade die neuesten Grafiktreiber von der Herstellerseite herunter und installiere sie – deine Grafiktreiber sind wahrscheinlich nicht mehr aktuell.\n4. Versuche die Rendering-Verfahren von OpenGL auf DirectX, oder umgekehrt, zu stellen.\n5. Lösche die Spiel-Konfigurations-Datei „config.cfg“ in deinem „Dokumente“ – „Euro Truck Simulator 2“-Ordner. Sie könnte fehlerhaft sein.\n    Diese Datei wird beim nächsten Spielstart automatisch und mit gültigen Standardwerten wieder erstellt."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 hat ein Problem festgestellt und ist unfähig, auf deinem Computer Grafiken darzustellen (keine gültige Grafikkarte gefunden)."
#@}

