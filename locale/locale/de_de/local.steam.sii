#!}
#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "STEAM-EINGABE-ZUORDNUNGSMODUS WÄHLEN" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Einführung des neuen <color value=@@clr_sel@@>In-Game-Mapping-Modus<color value=@@clr_txt@@>, der vollständige Konfigurationen der Tastenbelegung im Spiel und verbesserte Tastenhinweise unterstützt. Dies ist der empfohlene Modus.<br><br>Behalte den <color value=@@clr_sel@@>Steam-Client-Mapping-Modus<color value=@@clr_txt@@>, wenn du das Layout deines Gamepads über den Steam-Client angepasst hast.<br><br>Du kannst den Modus jederzeit in den Optionen mithilfe des Eingabe-Assistenten ändern." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Steam Client-Modus beibehalten" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Eingabeassistent öffnen" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Steam-Eingabe-Zuordnungsmodus" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "In-Spiel Mapping" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Steam Client Mapping" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Wählt den Modus für Gamepads wie @@controller_ps5@@, @@controller_xbox_one@@ oder @@controller_steam_deck@@, die das Steam Input-Interface verwenden.<br>Steam Client-Mapping – Verwendung von eigenständigen Layouts, die über den Steam-Client konfiguriert wurden. Unterstützt eingeschränkt In-Game-Tastenhinweise und keine Konfigurationen für Tastenbelegungen im Spiel.<br>In-Game-Mapping – Verwendung eines universellen, einfachen Layouts. Unterstützt vollständige Tastenbelegungen im Spiel und bietet bessere Tastenhinweise. Es wird empfohlen, beim Wechsel zu diesem Modus den Eingabe-Assistenten auszuführen. Dies ist der empfohlene Modus."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Steam-Controller"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Steam Eingabe-Controller"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Steam-Cloud-Synchronisierung:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Du verwendest eine ältere Version des Spiels.<br>Steam aktualisiert das Spiel automatisch, sofern automatische Updates nicht deaktiviert sind."
#@}

	key[]: "steam_demo"
	val[]: "Wenn dir die Demo des Euro Truck Simulator 2 gefällt, kannst du die Vollversion über <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK> beziehen!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 kann nicht auf den Steam-Client zugreifen. Folgende Schritte werden empfohlen:\n\n1. Stelle sicher, dass der Steam-Client läuft.\n2. Stelle sicher, dass du die aktualisierte Version des Steam-Clients hast.\n3. Stelle sicher, dass die automatischen Updates aktiviert sind und dass das Spiel auf die neueste Version aktualisiert ist."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Eine oder mehrere der momentan installierten Erweiterungen sind nicht kompatibel mit der momentanen Version des Spiels und werden daher deaktiviert. Bitte überprüfe die Integrität des Spiel-Cache in Steam.<br><br>Folgende Inhalte sind inkompatibel:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Erstellung eines Steam-Profils nicht möglich, da ein gleichnamiges Profil bereits existiert." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Profilübertragung nicht möglich, da bereits ein Profil mit diesem Namen besteht." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Profilübertragung fehlgeschlagen." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Steam-Cloud synchronisieren" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "Deine Steam-Cloud verfügt über ausreichend Platz für deine Spielstände." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Dein Speicher in der Steam-Cloud wird knapp!<color value=@@clr_txt@@><br><br>Um fortzufahren, lösche bitte einige Spielstände. Hier weitere Infos:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Überschrittener Speicherplatz: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Überschrittene Dateien: <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Verwendeter Steam Cloud-Speicherplatz: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Dateien in Steam Cloud: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "Ausgewählter Speicher <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> hat <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@> in <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> Dateien." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Die maximale Speichergrenze der Steam-Cloud ist erreicht. Um fortfahren zu können, entferne einige Speicherstände.<br><br>Genaue Infos hierzu im rechten Feld." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Durch das Umwandeln in ein lokales Profil wird dieses Profil nur noch von diesem Computer aus spielbar sein, egal welcher Steam-Account angemeldet ist. " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Die Profilübertragung ist fehlgeschlagen. Es wurden keine Daten übertragen, und das System hat das ursprüngliche Profil unverändert beibehalten. Bitte versuche es erneut." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

