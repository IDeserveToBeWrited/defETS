	key[]: "load"
	val[]: "Yükle" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Uyumsuz kayıt!<br><color value=@@clr_txt@@>Lütfen oyunu kullanılabilir en son versiyona yükseltmeyi deneyin." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
