#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "KONTROLCÜ EKSENLERİNİ AYARLAYIN" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Eksenlerin Vaziyeti"

	key[]: "wiz_setup_axes_desc"
	val[]: "Seçtiğiniz bütün eksenlerin işlevini görerek deneyebilirsiniz. Kontrolcüyü oynatın ve hareketlenen çubuklara bakın. Böylece kullanılan her eksenin sınırından, ortalanmasından, yönlendirilmesinden ve genel tavrından haberdar olursunuz."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Eksen Ayarı"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Bir eksen seçmek için eksen isminin yanındaki düğmeye tıklayın. Böylece giriş moduna geçersiniz. Akabinde çubuğu, direksiyonu veya pedalı oynatarak seçilen ekseni tercih ettiğiniz eksene bağlayın."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Ölü Bölgeler"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Ölü bölge, kasten hiçbir veri girişi sağlamayan ve eksen üzerinde bulunan bir bölgedir. Bir eksenin ölü bölgesini değiştirmek isterseniz ilgili eksenin yanındaki çubuğu kaydırın. Ölü bölge sağa kaydırdıkça büyüyecektir. Bu seçenek eski tip kontrolcülerle daha rahat oynayabilmek için uygundur. Ölü bölgeyi büyüttüğünüzde kontrol aletinizin yıpranmasından ötürü oluşan yanlış veri girişlerini en aza indirebilirsiniz."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Eksen Modları"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Bir eksen modu eksenin oyunda nasıl ele alındığını belirler. Ters bir eksen bildirilen yönü tersine çevirir. Mesela direksiyon sağa döndüğünde oyundaki direksiyon sola dönebilir. Ortalanmış bir eksenin varsayılan pozisyonu, aralığının ortasında bulunur (mesela oyun çubuğu). Bir eksen yanlış tespit edilmişse bu ayarı kullanmanızda fayda vardır."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Ters" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Ortalanmış" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Ters ve Ortalanmış" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "OTOMATİK ŞANZIMAN AYARI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Otomatik şanzımanda size yalnızca ileri, boş ve geri modlarından birini seçmek kalır. Bu seçimi aşağıda belirtilen tuş ve kontrolcü düğmeleriyle yapabilirsiniz. Ayarları değiştirmek için bir düğmeye tıklayın ve eylem için kullanmak istediğiniz tuşa veya kontrolcü düğmesine basın."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Bilgisayarınıza bağlı bir H vites kolu donanımı varsa gerçek otomatik vites kolu simülasyonu için kullanabilirsiniz. Bu seçeneği aktifleştirerek H vites kolu pozisyonlarını ileri ve geri modlarına atayabilirsiniz. Diğer H vites kolu pozisyonları ise boş vites sayılır. Bu ayar H vites kolu kontrolcüsü için özel olarak oluşturulmuştur yani ne normal tuşlarla ne de kontrolcü düğmeleriyle çalışacaktır. Atamayı değiştirmek için bir düğmeye tıklayın, vites kolunu arzu ettiğiniz pozisyona getirin ve akabinde tekrar boşa alın."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SIRALI ŞANZIMAN AYARI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sıralı şanzıman bütün ileri, boş ve geri vitesler arasında geçiş yapar. Belirtilen sırayla vites yükseltmek ve küçültmek için kullanılan tuş ve kontrolcü düğmeleri burada mevcuttur. Atamayı değiştirmek için bir düğmeye tıklayın ve eylem için kullanmak istediğiniz tuşa veya kontrolcü düğmesine basın."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H VİTES KOLU ŞANZIMANI AYARI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Buradan ana H vites kolu dizilimini seçebilir ve işlevlerini deneyebilirsiniz. Resimde vites kolunun mevcut pozisyonunun yanı sıra hangi vitese geçtiğinizi de görebilirsiniz. Şanzıman, vites kolu pozisyonlarından daha fazla vitese sahip olduğundan farklı vites serileri arasında geçiş yapmak için mandal kullanmanız lazım."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Hâlihazırdaki vites kolu pozisyonu ve aktif mandallar da aşağıda belirtilir. Atanmış bir kontrolü değiştirmek için ilgili düğmeye tıklayın, vites kolunu arzu ettiğiniz pozisyona getirin ve akabinde tekrar boşa alın."
#@}

