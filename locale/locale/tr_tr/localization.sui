	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Yollara ve diğer zeminlere kusurlu bir his vermek için rastgele oluşturulan yüzey tümseklerinin yoğunluğunu ayarlar.<br><br>Diğer süspansiyon ve kamera ayarlarına bağlı olarak fark edilen tesir daha fazla veya daha az belirgin olabilir."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Çekicinin beşinci tekerini dorsenin king pimiyle hizalamak için daha fazla hassasiyet gerektiren ileri seviye bağlamayı açar.<br><br>Kapatıldığında, king pimi ile beşinci teker arasında çarpışma olmadığından dorsenin bağlanması çok daha kolay hâle gelir."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Dorse kablolarının animasyonlu olup olmayacağını ve hangilerinin animasyonlu olacağını seçer.<br><br><color value=@@clr_txt_d@@>Daha fazla araçta kabloların görünmesi, eski sistemlerdeki performansı etkileyebilir."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Çekicinin 90 km/sa. (56 mil/sa.) olan elektronik hız sınırlayıcısını açar.<br><br><color value=@@clr_txt_d@@>World of Trucks işlerinde bu özellik sürekli açıktır."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında ve ön cam silecekleri ilk konuma ayarlandığında, silecekler otomatik olarak açılacak ve hızlarını hava koşullarına göre ayarlayacaktır."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Frenleme sırasında rötarderin otomatik olarak devreye girmesini sağlar."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, araç frenler sayesinde eğimli yollarda kalkışa yardımcı olur ve sorunsuz bir kalkış sağlar."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Frenleme sırasında motor freninin otomatik olarak devreye girmesini sağlar."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, gaz pedalına basılır basılmaz motor çalışacaktır."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
