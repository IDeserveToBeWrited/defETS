	key[]: "load_game_desc"
	val[]: "Daha önceden kaydedilmiş bir oyunu yükleyin. Mevcut ilerleme kaybolacaktır!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Başka bir oyun yüklemek istediğinizden emin misiniz?<br><br>Kaydetmediyseniz mevcut ilerlemeniz kaybolacaktır."

	key[]: "load_progress_lost_mp"
	val[]: "Başka bir kayıt yüklemek istediğinizden emin misiniz?<br>Çok oyunculu modda bunu yapmak işin iptal edilmesine veya askıya alınmasına, en yakın servise ışınlanmaya veya seçilen işin kullanılamamasına neden olabilir.<br><br>Daha önce kaydedilmediği sürece mevcut ilerlemeniz kaybolacaktır."

	key[]: "load_game_mp_suspended_job"
	val[]: "Kayıt başarıyla yüklendi, ancak aktif World of Trucks işiniz askıya alındı ve bu oturumdayken kullanılamayacak."

	key[]: "autosave"
	val[]: "- Otomatik kayıt -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Hızlı kayıt -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
