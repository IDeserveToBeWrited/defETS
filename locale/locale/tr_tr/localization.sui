	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "Şu anda bu oturumda etkin olmayan bir şirkete teslimat yapıyorsunuz.<br>Bağlanmak istiyorsanız, önce işinizi teslim edin, aksi takdirde işiniz bu oturum sırasında askıya alınacak ve kullanılamayacaktır.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Şu anda bu oturumda etkin olmayan bir şirkete teslimat yapıyorsunuz.<br>Bağlanmak istiyorsanız, önce işinizi teslim edin, aksi takdirde işiniz iptal edilecek.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Bu oturuma katılabilmeniz için çekicinizin veya dorsenizin yakınındaki bir şirketin etkinleştirilmesi gerekir.<br>Herhangi bir sorun yaşamamak için lütfen çekicinizi veya dorsenizi şirketten daha uzaklaştırın, aksi takdirde mevcut işiniz askıya alınacak (ayrıca bu oturumda kullanılamayacak) ve en yakın servise ışınlanacaksınız.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Bu oturuma katılabilmeniz için çekicinizin veya dorsenizin yakınındaki bir şirketin etkinleştirilmesi gerekir.<br>Herhangi bir sorun yaşamamak için lütfen çekicinizi ve dorsenizi şirketten uzaklaştırın, aksi takdirde mevcut işiniz iptal edilecek ve en yakın servise ışınlanacaksınız.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Tek seferlik işinizi kabul etmeden önce çekicinizi veya dorsenizi bıraktığınız yere yakın bir şirketin bu oturuma katılabilmeniz için aktif hâle getirilmesi gerekir.<br>Çekicinize döndüğünüzde herhangi bir sorun yaşamamak için tek seferlik işinizin iptal edilmesi ve en yakın servise ışınlanmanız gerekir.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Seçtiğiniz iş, bu oturumda etkin olmayan bir şirketten veya şirkete teslim ediliyor ve bağlandığınızda mevcut olmayacak.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Yükünüz bu oturumda etkin olmayan bir şirkette bulunmaktadır.<br>Bağlanmak istiyorsanız, yükünüzü yükleyin, aksi takdirde mevcut işiniz askıya alınacak ve bu oturumda kullanılamayacaktır.<br><br>Devam etmek istiyor musunuz?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "İşiniz, bu oturumda etkin olmayan bir şirkete teslim edileceği için iptal edildi."

	key[]: "mp_warning_load_job_canceled_special"
