	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, araç varsayılan olarak düşük gazda çalışacaktır. Gaz düğmesine hızlıca iki kere basıldıktan sonra, gaz düğmesi bırakılana kadar araç tam gazda çalışacaktır.<br><br>Sadece klavye için geçerlidir."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Haddinden fazla frene basmaktan kaynaklanan gerçek hava kaybını simüle eder.<br><br>Açıldığında, yokuş aşağı inerken veya tekrar tekrar fren basmak suretiyle ağır manevralar yaparken hava basınçlarınızı idare etmeniz gerekir."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Kapatıldığında yakıt sarfiyatı, sürüş tarzından veya yol şartlarından etkilenmez.<br><br>Açıldığında yakıt sarfiyatı; sürüş tarzı, yük ağırlığı, yuvarlanma direnci ve arazi profilleri dâhil olmak üzere çeşitli faktörlerden etkilenir. Artık @@skill_mechanical_title@@ becerisinden etkilenmez."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, ABS kontrolü korumak ve frenleme kabiliyetini geliştirmek için tekerlek kilitlenmesini önler."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, çekici kontrolü korumaya yardımcı olmak amacıyla patinajı, önden kaymayı veya aşırı kaymayı önlemek için tekerlek başına frenleme uygular."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, tekerlekler kaymaya başlarsa çekici çekişi iyileştirmek için diferansiyeli kilitleyecektir."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Hız sabitleyicisinin ilgili düğmeye basıldığında hangi kademeyle artacağını veya azalacağını değiştirir."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Hedef hızı korumak için hız sabitleyici toleransını değiştirir."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, hız sabitleyici öndeki araçla güvenli bir takip mesafesini korumak için hızı ayarlayacaktır."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Sistem yaklaşan bir çarpışmayı tespit ederse acil frenlemeyi çalıştırır.<br>Sistemin yalnızca araçlara mı yoksa bütün engellere mi tepki vereceğini seçin."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Şerit takip asistanı modlarının seçimi:<br>- \"Şeritten çıkma ikazı\" modu, şeritten çıkmak üzereyken sizi sesli olarak uyarır.<br>- Sesli uyarıya ilaveten, \"Şeritte tutma desteği\" aracınızın şeritten çıkmasını önlemek için otomatik olarak direksiyonu çevirir.<br><br>Her iki mod da yalnızca 55 km/sa. (~35 mil/sa.) üzerindeki süratlerde çalışır.<br>Şerit Takip Asistanı ayrıca devreye girmeden önce sinyal kullanımınızı da dikkate alır."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Çekicinizde varsa kör nokta uyarı sistemi işlevlerini etkinleştirir."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında ve farlar ilk konuma ayarlandığında, farlar düşük ışık koşullarında otomatik olarak yanacaktır."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında ve uzun farlar devredeyken araç, yaklaşan bir araç veya yakındaki bir aracı tespit ettiğinde uzunları otomatik olarak kapatacaktır."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında, direksiyon merkeze geri döndürüldüğünde sinyaller bir dönüşten sonra kendiliğinden atar."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında, bazı iç aksesuarlar aracın fiziksel hareketine tepki verir. (asılı süslemeler, sallabaşlar, vb.)"

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Direksiyon girdisine bağlı olarak iç kamerada yatay hareket çarpanını etkinleştirir."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "\"Direksiyon takipli kamera dönüşü\" özelliğinin direksiyon girdisine ne kadar duyarlı olduğunu değiştirir."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Geri giderken \"direksiyon takipli kamera dönüşü\" özelliğinin davranışını değiştirir."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, iç mekân kamerası sinyale bağlı olarak sola veya sağa döner."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Açıldığında, iç kamera araç hareketine tepki verir."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "İç kameranın araç hareketine ne kadar tepki vereceğini değiştirir."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "İç mekân kamerasının araç hareketine bağlı olarak ne kadar yalpalayabileceğini değiştirir."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Kameranın kendiliğinden ortalanmasından önceki gecikmeyi ayarlar.<br><br>Bunun çalışması için aracın ihmal edilemeyecek bir süratte seyretmesi gerekir. İleriye doğru seyrederken sadece iç mekân ve takip kamerası, geriye doğru seyrederken ise camdan dışarı bakma kamerası için geçerlidir."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Kamera hareketinin hızını ayarlar. Kamera kendiliğinden ortalanırken ve iç mekân kamerası ön ayarları arasında geçiş yaparken kullanılır."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "İç mekân kamerasının yakınlaştırmasının nasıl çalışacağını belirler: Yakınlaştırmak için düğmeyi geçici olarak basılı tutun veya yakınlaştırmayı açıp kapatmak için bir defa basın." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Oyun boyunca görüntülenecek dili seçer."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Seçilen bölgeye göre kur ve birimlerin ön ayarlarını değiştirir."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında, şehirler ve ülkeler seçtiğiniz dilde görüntülenecektir."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında, şehirler ve ülkeler haritada hem seçtiğiniz dilde hem de o bölgenin ana dilinde görüntülenecektir."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Hangi para biriminin kullanılacağını seçin."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "12 saatlik veya 24 saatlik zaman gösterimi arasında seçim yapın."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Hangi mesafe birimlerinin görüntüleneceğini seçin."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Hangi kütle birimlerinin görüntüleneceğini seçin."

