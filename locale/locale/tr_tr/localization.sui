#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFİK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafik" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Oyununuzun görsel performansını beğeninize göre uyarlamak için ince ayarlı ön ayarları kullanarak grafik ayarlarını yapın."

	key[]: "apply"
	val[]: "Uygula" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Ana Ekran Teması" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "EKRAN" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "GÖRSEL KALİTE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "DOKULAR" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "YANSIMALAR" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "GÖLGELER" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "IŞIKLANDIRMA" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "SON İŞLEME" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ÇEVRE" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Tam ekran modu" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Parlaklık / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Ayarla" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Çözünürlük" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Yenileme oranı" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS sınırı" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Arka plandayken FPS sınırı" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Varsayılan yenileme oranı" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Dikey eşitleme" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Tasarruflu (Dizüstü bilgisayarlarda enerji tasarruf eder)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "BASİT GRAFİK AYARLARI" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ÖZEL AYARLAR UYGULANDI" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "İLERİ SEVİYE GRAFİK AYARLARI" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Basit/ileri seviye grafik ayarları" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "İleri seviye ayarları gizle" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "İleri seviye ayarları göster" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Ölçekleme" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma keskinleştirme" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA ön ayarları" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Uyarlanabilir netlik" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Her zaman yumuşak" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Her zaman keskin" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Ekran uzayı ortam örtmesi (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Yüksek dinamik aralık (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Alan derinliği (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Güneş ışığı hüzmeleri" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Renk düzeltme" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Yansıma ölçeklemesi" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Yansıma detayı" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Bitki örtüsü detayı" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Çimen yoğunluğu" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Gölge kalitesi"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Gölge dokusu boyutu" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Uzaktaki gölgeler" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "İç mekân gölgeleri" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Hava kalitesi"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Ayna kalitesi" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Ayna çözünürlüğü" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Ayna mesafesi" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Doku kalitesi" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropik filtreleme" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normal mapping" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Diğer araçların farları" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "İkincil araç ışıkları" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Işığın görünürlük mesafesi" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Yayalar" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Grafik ayarları değiştirildi.<br>Bu ayarları saklamak istiyor musunuz?"

	key[]: "reverting_in"
	val[]: "Geri dönülecek" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "saniye" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Açıldığında, oyun tam ekranda görüntülenecektir."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Oyunun genel parlaklığını ekranınıza uyacak şekilde ayarlayın. HDR ile uyumlu ekranlarda, HDR kalibrasyonu tercihi de bu ayarda mevcut olacaktır."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Oyunun çözünürlüğünü değiştirir."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Oyunun hedef yenileme oranını değiştirir."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Ekran yırtılmasını önlemek için kare oranını monitörün yenileme oranıyla eşleştirir. Ekonomik ayar aynı zamanda kare oranını yarıya indirerek daha düşük güç tüketimi sağlar."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Oyun için izin verilen azami kare oranını ayarlar.<br><br>Değeri 0 olarak ayarlamak ayarı devre dışı bırakacaktır."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Oyun arka planda simge durumuna küçültüldüğünde izin verilen azami kare oranını ayarlar.<br><br>Değeri 0 olarak ayarlamak ayarı devre dışı bırakacaktır."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Basit grafik ayarları (ön ayarlar) veya ileri seviye grafik ayarları (tek tek seçenekleri değiştirme imkânı) arasında geçişler."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Oyunu dâhilî olarak daha yüksek bir çözünürlükte işleyerek grafik doğruluğunu artırır, bu da pürüzlü kenarları azaltır ve detayları iyileştirir.<br>Mesela, daha yüksek bir ölçeklemeyi seçmek, daha az bulanıklıklığa sahip daha net bir görüntü elde edilmesini sağlar ve oyunun genel görünümünü performans pahasına iyileştirir.<br><br><color value=@@clr_txt_d@@>Bu ayarın performans üzerinde genellikle büyük bir etkisi vardır."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Oyundaki pürüzlü kenarların görünümünü yumuşatan yüksek hızlı antialiasing yöntemlerinin seçimi:<br>- SMAA, her pikseli karenin farklı yerlerinde birden çok kez (seçilen kaliteye bağlı olarak) örnekler ve örneklerin ortalamasını alarak nihai görüntüyü oluşturur.<br>- TAA, her pikseli kare başına yalnızca bir kez örnekler, ancak bunları farklı yerlerde ve farklı karelerde örnekler.<br>- En iyi sonuç için performans pahasına her ikisinin bir kombinasyonunu da seçebilirsiniz.<br><br><color value=@@clr_txt_d@@>Bu ayarın performans üzerinde genellikle orta derecede bir etkisi vardır."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Birbirine yakın olan çatlaklara ve nesnelere yumuşak gölgeler ekleyerek oyun dünyasının tamamının grafik doğruluğunu artırır.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "TAA ön ayarlarının seçimi:<br>- \"Her zaman yumuşak\" daha az titreme/daha fazla bulanıklıkla sonuçlanır - süper örneklemeyi açan veya yüksek DPI monitörü olan PC kullanıcıları için uygundur, ancak aynı zamanda ekranlarından daha uzakta oturan 1080p TV kullanıcıları için de uygundur.<br>- \"Her zaman keskin\" daha fazla titreme/daha az bulanıklıkla sonuçlanır - dizüstü bilgisayarlar veya Steam Deck gibi 1080p altı kullanımlar için muhtemelen en iyi tercihtir.<br>- \"Uyarlanabilir netlik\" kamera sabit olduğunda TAA titremesini dinamik olarak devre dışı bırakır.<br><br><color value=@@clr_txt_d@@>Bu ayar yalnızca TAA'nın anti-aliasing çözümü olarak seçilmesi hâlinde kullanılabilir."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "TAA'nın luma keskinleştirmesinin şiddetini ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayar yalnızca TAA'nın anti-aliasing çözümü olarak seçilmesi hâlinde kullanılabilir."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Açıldığında, arka planda gerçekçi bir odak düşüşü oluşturmak için haritadaki uzak alanlar yapay olarak bulanıklaştırılabilir."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Açıldığında, direkt güneşe bakarken ya da ağaçlar, binalar veya araçlar gibi nesnelerin arasından güneşe bakarken ışık hüzmeleri görülebilir."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Açıldığında, oyunun renkleri göze hoş gelmesi için dinamik olarak ayarlanır. Manzaralar günün saatine ve hava koşullarına daha sadık olacak, araçların ve diğer nesnelerin renkleri daha canlı vb. gözükecektir."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Yansımaları dâhilî olarak daha yüksek kalitede işleyerek ve daha iyi antialiasing kullanarak iyileştirir.<br><br><color value=@@clr_txt_d@@>Bu ayarda yapılan değişiklikler yalnızca oyunun manuel olarak yeniden başlatılmasından sonra geçerli olacaktır."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Araç yüzeylerinde, camlarda ve su birikintileri, ıslak yollar ve açık su kütleleri gibi diğer yansıtıcı yüzeylerde görülen yansımaların ayrıntılarını ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayarın genellikle performans üzerinde orta seviyede bir etkisi vardır.<br><br>Bu ayarda yapılan değişiklikler yalnızca oyunun manuel olarak yeniden başlatılmasından sonra geçerli olur."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Bitki ve ağaçların detay ve karmaşıklığını ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Yol kenarlarında görülen çimenlerin yoğunluğunu ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Güneş veya ayın oluşturduğu gölgelerin kalitesini ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Gölgelerin çok uzaktaki nesnelerde bile oluşturulmasını sağlar.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Gece çekicinin iç mekânında dinamik gölgeler oluşturur.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Yansımalar gibi hava efektlerinin kalitesini ayarlar."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Araç aynalarında görülen yansımaların kalitesini ayarlar (yansıma ayarlarından bağımsız olarak).<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Nesnelerin aynada oluşturulan görüntüsünün çözünürlüğünü ayarlar."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Nesnelerin aynada işlenmeye başlayacağı mesafeyi ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde büyük bir etkiye sahiptir."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Oyundaki nesnelere ve yüzeylere uygulanan bazı dokuların kalitesini ayarlar."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Dokuların, bilhassa uzaktan veya eğik açıyla bakılanların, keskinliğini artırır.<br><br><color value=@@clr_txt_d@@>Bu ayarda yapılan değişiklikler yalnızca oyunun manuel olarak yeniden başlatılmasından sonra geçerli olur."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Kaldırımlara, yollara ve diğer nesnelere geometrik ayrıntı katarak görünümlerini iyileştirir.<br><br><color value=@@clr_txt_d@@>Bu ayarın genellikle performans üzerinde orta seviyede etkisi vardır.<br><br>Bu ayarda yapılan değişiklikler yalnızca oyunun manuel olarak yeniden başlatılmasından sonra geçerli olur."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Trafikteki diğer araçların farlarından aydınlatma sağlar."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Trafikteki diğer araçların sinyal lambaları, fren lambaları vb. ikincil lambalarının aydınlatılmasını sağlar."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Suni ışık kaynaklarının görülebildiği mesafeyi ayarlar.<br><br><color value=@@clr_txt_d@@>Bu ayar genellikle performans üzerinde orta seviyede bir etkiye sahiptir."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Oyun dünyasında yayaları açar."
