	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Navigasyonun işleyişini değiştirir.<br>- \"En iyi\" modu mesafe ve süre arasındaki en verimli oranı tercih eder ve trafik ışığı olan kavşaklara vs. girmemeye çalışır.<br>- \"En kısa\" modu daima mümkün olan en kısa güzergâhı tercih eder.<br>- \"Tali yollar\" modu mümkün mertebe otobanlara girmemeye çalışır."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Park etme zorluğunu değiştirir.<br>- \"Her zaman seç\" hedefinize ulaştığınızda seçim yapmanıza imkan sağlar.<br>- \"Güvenli park etme\" geri geri gitme manevralarını gerektirmez.<br>- \"Ustaca park etme\" ekseriyetle daha zor bir geri geri gitme manevrası gerektirir."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Çevrenizdeki kazalar, bozulmuş araçlar, yol döküntüleri vb. yol tehlikeleriyle karşılaşma olasılığını ayarlar."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "İş başındayken güzergâh değiştirmenize sebep olan servis yollarıyla karşılaşma ihtimalinizi ayarlar."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Kötü hava şartlarının ihtimalini ayarlar."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Geçerli saate ek olarak saat dilimi bilgilerinin görüntülenip görüntülenmeyeceğini seçin."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Genellikle çekici satın alımları veya garaj geliştirmelerinden sonra gösterilen oyun içi ara sahneleri açar."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Yarı şeffaf engellerin girilemeyen yollarda gösterilip gösterilmeyeceğini seçin."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Oyun içinde kamerayı kontrol ederken fare Y eksenini ters çevirir."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Şanzıman tipini seçer.<br>- \"Basit otomatik\" ileri ve geri hareketleri kontrol etmek için gaz ve frenin kullanılmasına izin verir.<br>- \"Gerçek otomatik\" ileri ve geri vitesler arasında geçiş yapmak için bir girdi gerektirir.<br>- \"Sıralı\", vites yükseltme/küçültme girdileriyle bütün viteslerin manuel olarak değiştirilmesini gerektirir.<br>- \"H Vites\" vites kanalları olan bir kontrolcünün kullanılmasını gerektirir."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Bu özelliği açmak \"vites atlama\"ya izin verir; yani şanzımandaki her vitese geçmemek için gerekli veya kullanışlı olduğunda vites atlama."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Bir klavye veya kontrolcü kullanılırken direksiyonu toplar.<br><br>Bu özelliğin devre dışı bırakılması, bir dönüşten sonra direksiyonu manuel olarak toplamanız gerektiği anlamına gelir."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Direksiyon simidi animasyonunun aralığını ayarlar. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Frenlerin şiddetini değiştirir."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Ağırlık merkezini alçaltarak çekicinin dengesini değiştirir."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Ağırlık merkezini alçaltarak dorsesnin dengesini değiştirir."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Güç aktarma organları tarafından üretilen torkun şiddetini değiştirir.<br><br>Bu ayarın yükseltilmesi, çekicinin sağa doğru \"yaslanma\" hissini artıracaktır."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Süspansiyonun sertliğini değiştirir."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
