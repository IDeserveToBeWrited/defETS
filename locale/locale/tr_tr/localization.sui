	key[]: "intro_continue"
	val[]: "Devam et ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Euro Truck Simulator 2'ye hoş geldiniz!"

	key[]: "intro_2"
	val[]: "Sonunda hayallerinizdeki mesleğe kavuştunuz. Artık tır şoförüsünüz!"

	key[]: "intro_3"
	val[]: "Hayırlı olsun, kendi nakliye şirketinizi kurdunuz ancak henüz yeni bir çekici alacak paranız yok. Bir süreliğine başka firmalara şoför olarak çalışmanız gerekecek."

	key[]: "intro_4"
	val[]: "Göreviniz, $JOB_CARGO$ yükünü $JOB_TARGET_CITY$ şehrindeki $JOB_TARGET_COMPANY$ şirketine sağlam bir şekilde teslim etmek. İşvereniniz size bir çekici temin etti ve bütün masraflarınızı da karşılayacak. Kimseyi utandırmayın ve zamanında hedefinize ulaşın."


	key[]: "intro_garage_1"
	val[]: "Burası şirketinizin merkezi."

	key[]: "intro_garage_2"
	val[]: "Sıradan bir garaj. Belki çok iyi değil, ama en azından şimdilik iş görür."

	key[]: "intro_garage_3"
	val[]: "Maalesef, oraya park edecek hiçbir aracınız yok. O yüzden şu anda boş gözüküyor."

	key[]: "intro_garage_4"
	val[]: "Yeteri kadar pazar kazanıp bir çekici satın aldığınızda oyun dünyasında serbestçe gezebilecek ve kendi şirketinizi buradan çekip çevirebileceksiniz."

	key[]: "intro_garage_5"
	val[]: "Kolay gelsin!"


	key[]: "desktop_tut_t"
	val[]: "ÖZELLİK AÇILDI"

	key[]: "desktop_tut_job"
	val[]: "Sıradaki işinizi seçin"

	key[]: "desktop_tut_cargo_market"
	val[]: "Yük Piyasasına erişip bol çeşitli yükleri hedeflerine teslim etmek için yepyeni dorsenizi kullanın." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Ne kadar ilerleme kaydettiğinizi buradan görebilirsiniz."

	key[]: "desktop_tut_company"
	val[]: "Buradan garajlarınızı takip edebilir, yeni şoförler istihdam edebilir ve şirketinizi yönetebilirsiniz."

	key[]: "desktop_tut_trailers"
	val[]: "Şu andan itibaren kendinize ait bir dorse satın alabilir, çekicinizle uyumlu olması için dorsenize parça takabilir veya dorsenizi boyayabilirsiniz.<br><br>Dorselerinizi dilediğiniz garajda muhafaza edebilirsiniz; kârları artırmak için şoförleriniz tarafından kullanılabilirler. Dorselerinizi düzenlemek için Dorse Yöneticisini kullanın."

	key[]: "desktop_tut_visit_directive"
	val[]: "$SCREEN_NAME$ kısmına geçin" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "HOŞ GELDİNİZ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Yeni Ana Ekrana hoş geldiniz<br>Buradan oyun içindeki tüm işlevlerle etkileşime girebilirsiniz."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Aşağıda yer alan Ana Menü, aşina olduğunuz tüm temel oyun işlevlerine doğrudan erişim sağlar."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "En üstte yer alan yeni Durum Çubuğu, yararlı oyuncu profili istatistikleri ve mevcut ülkenin mevzuatını görme imkânı sağlar."

	key[]: "desktop_tut_tour_home"
	val[]: "Ana ekran düğmesi sizi ana ekranınıza döndürmek için her zaman buradadır."

	key[]: "desktop_tut_tour_burger_menu"
