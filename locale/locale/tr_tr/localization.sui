#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Ağ katmanı kullanılabilir değil. Lütfen istemci yapılandırmasının doğru olduğundan emin olun."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Çevrim içi hizmet ile bağlantı kurulamıyor. Lütfen internet bağlantınızın çalıştığından emin olun."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Çevrim içi hizmet ile irtibat esnasında hatâ meydana geldi. Lütfen daha sonra tekrar deneyin."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Çevrim içi hizmetten yanlış veri geldi. HTTP vekil sunucusu kullanımdaysa, ayarlarını kontrol edin. Aksi takdirde daha sonra tekrar deneyin."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Çevrim içi hizmetten yanlış veri geldi. Lütfen daha sonra tekrar deneyin."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Hizmet oyunun hâlihazırdaki versiyonu ile uyumlu değildir. Oyun için yeni bir yama olup olmadığını bakın."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Hizmet hâlihazırda kullanılamıyor. Lütfen daha sonra tekrar deneyin."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Hizmet, bakım veya aşırı yoğunluk sebebiyle hâlihazırda kullanılamıyor. Lütfen daha sonra tekrar deneyin."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Doğrulama bilgileri geçerli değildir. Lütfen tekrar oturum açmaya çalışın."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Çevrim içi hesap çok fazla miktarda başarısız oturum açma teşebbüsü yüzünden hâlihazırda devre dışıdır. Lütfen yarım saat içinde tekrar deneyin."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Çevrim içi hesap şüpheli erişimler yüzünden hâlihazırda devre dışıdır. Lütfen 24 saat içinde tekrar deneyin."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Bu oyun mevcut çevrim içi hesabınıza kayıtlı değildir."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Hesap henüz etkinleştirilmedi. Lütfen gelen kutunuzda hesap etkinleştirme e-postasını arayın."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Bu hesap dondurulmuştur. Lütfen teknik desteğe başvurunuz."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Bu hesaba erişim engellenmiştir. Lütfen teknik desteğe başvurunuz."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Vekil sunucu doğrulaması bu oyun tarafından desteklenmemektedir. Lütfen farklı bir vekil sunucu veya doğrudan bağlantı kullanın."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Gereken nesne hâlihazırda müsait değil. Lütfen birkaç dakika içinde tekrar deneyin."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL hatası. Güvenli bir bağlantı kurulamıyor."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Çevrim içi iletişim esnasında oyun durduruldu. Lütfen daha sonra tekrar deneyin."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Bir iç hata oluştu. Daha fazla bilgi için lütfen net.log dosyasına bakın."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 bir sorunla karşılaştı ve bilgisayarınızda görüntü oluşturamıyor (geçerli bir grafik cihazı bulunamadı). Önerilen çözümler:\n\n1. Ekran kartınızın ve diğer donanımınızın oyunun asgari donanım ihtiyaçlarını karşıladığından emin olun.\n2. Bilgisayarınızda kurulu olan Microsoft DirectX sürümünü en güncel sürüme yükseltin.\n3. Ekran kartınızın üreticisinin sitesinden en güncel grafik sürücülerini indirin. Şu anki sürücüleriniz büyük ihtimalle güncel değil.\n4. Grafik işleme yöntemini OpenGL'den DirectX'e değiştirin veya tam tersini uygulayın.\n5. Oyunun yapılandırma dosyasını (config.cfg) 'Belgelerim' - 'Euro Truck Simulator 2' konumundan silin. Hasar görmüş olabilir. Sonrasında oyunu açtığınızda bu dosya varsayılan değerler kullanılarak tekrar oluşturulacaktır."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 bir sorunla karşılaştı ve bilgisayarınızda görüntü oluşturamıyor (geçerli bir grafik cihazı bulunamadı)."
#@}

