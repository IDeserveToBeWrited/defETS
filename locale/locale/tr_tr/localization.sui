	key[]: "select_gearbox_type"
	val[]: "ŞANZIMAN TÜRÜNÜ SEÇİN" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Özellikle klavye için geliştirilmiş ancak diğer kontrolcüler için de kullanılabilen en basit sürüş yöntemi budur. İLERİ tuşuna basarak ileri gidin ve GERİ tuşuna basarak yavaşlayın veya geri gidin. Şanzıman kalan her şeyi sizin için halledecektir: ileri gitme, durma, geri gitme, uygun viteslere geçme vs."

	key[]: "wiz_gb_automatic"
	val[]: "Pedallı direksiyonlar için idealdir. İleri gitmek, durmak (boşta) veya geri gitmek için düğmeleri kullanın. Akabinde gaz pedalına basın ve otomatik şanzıman kalan her şeyi halletsin."

	key[]: "wiz_gb_sequential"
	val[]: "İleri, geri ve boş viteslerden birine geçmek için vitesi manuel olarak yükseltin veya küçültün. Ustalaşmak biraz zordur ancak çeşitli durumlarda size mükemmel bir araç hâkimiyeti ve daha performanslı bir sürüş sunar."

	key[]: "wiz_gb_hshifter"
	val[]: "Doğrudan arzu ettiğiniz vitese geçin. Zorluk itibarıyla sıralı şanzımana benzerdir fakat daha gerçekçidir. G27 veya G25 gibi fiziksel bir H vites kolu tavsiye edilir. Debriyaj gerektirir."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Bu özellik bir direksiyon, oyun kumandası veya oyun çubuğu gerektirir."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "H-Vites içeren bir donanım bulunamadı; bu özellik kullanılamayabilir."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "H VİTES KOLU DİZİLİMİNİ SEÇİN"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Aktarmalı şanzıman en basit seçeneğiniz. İki vites serisi bulunur. İlk seride 1'den 6'ya kadar, ikinci seride ise 7'den 12'ye kadar vites bulunur. Bir mandal ile bu iki seri arasında geçiş yapılır ve vites kolu da serideki bir vitese geçer."

	key[]: "wiz_hs_splitter"
	val[]: "Takviyeli şanzıman basit alternatiflerden biridir. Vitesler bunda da iki seri hâlindedir. İlk seride tek sayılı vitesler (1, 3, 5, ...), ikinci seride de çift sayılı vitesler (2, 4, 6, ...) bulunur. Bir mandal ile bu iki seri arasında geçiş yapılır ve vites kolu da serideki bir vitese geçer."

	key[]: "wiz_hs_range_splitter"
	val[]: "Aktarmalı-takviyeli şanzıman gerçek manuel aktarmalı-takviyeli şanzımanların dizilimine dayanmaktadır. Vitesler, her H vites kolu pozisyonuna dört adet düşecek şekilde gruplanmıştır ve iki adet mandal bulunmaktadır. Bu yüzden yalnızca usta şoförlere tavsiye edilir."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Oyun aşağıda belirtilen varsayılan ayarlar kullanılarak ayarlandı. İleri seviye ayarları kullanarak değişiklik yapabilir veya oyuna direkt olarak devam edebilirsiniz."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "İleri seviye ayarlar"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Oyun artık yapılandırıldı ve devam edebilirsiniz. Daha sonra Seçenekler menüsünden Kontroller kısmını seçerek istediğiniz değişikliği yapabilirsiniz."

	key[]: "wiz_cfg_steam"
	val[]: "Steam istemcisini kullanarak bu kontrolcünün düğme ve eksen eşleşmesini kontrol edebilir ve yapılandırabilirsiniz. Steam oyun kumandası ayarları Steam > Kütüphane > Euro Truck Simulator 2 > Kontrolcü Yapılandırması kısmında mevcuttur."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Kontrolcü ayarlarını aç"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Direksiyon için @@imm_wiz_dsteerleft@@ ve @@imm_wiz_dsteerright@@ komutlarını kullanın."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Direksiyonu sağa veya sola çevirmek için fareyi aynı yönde hareket ettirin."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Direksiyon için @@ima_wiz_j_steer@@ komutunu kullanın."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "İleri gitmek için @@imm_wiz_dforward@@, geri gitmek için @@imm_wiz_dbackward@@ komutlarını kullanın."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "İleri gitmek için @@ima_wiz_j_throttle@@ kontrolünü ileri, geri gitmek için ise geri hareket ettirin."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "İleri gitmek için @@ima_wiz_j_throttle@@, geri gitmek için ise @@ima_wiz_j_brake@@ komutlarını kullanın."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Hızlanmak için @@imm_wiz_dforward@@, yavaşlamak için ise @@imm_wiz_dbackward@@ komutlarını kullanın."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "İleri gitmek için @@ima_wiz_j_throttle@@ kontrolünü ileri, yavaşlamak için ise geri hareket ettirin."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Hızlanmak için @@ima_wiz_j_throttle@@, yavaşlamak için ise @@ima_wiz_j_brake@@ komutlarını kullanın."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "İleri gitmek için @@imv_wiz_gearup@@ ve geri gitmek için @@imv_wiz_geardown@@ komutlarını kullanın."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Klavye veya kontrolcü düğmelerini kullanıyorsanız ileri gitmek için @@imv_wiz_gearup@@, geri gitmek için @@imv_wiz_geardown@@ komutlarını kullanabilirsiniz. H vites kolu kullanıyorsanız @@imv_wiz_drive@@ ve @@imv_wiz_reverse@@ komutlarını kullanarak ileri veya geri hareket seçimi yapabilirsiniz."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Arzu ettiğiniz vitese geçmek için @@imv_wiz_gearup@@ ve @@imv_wiz_geardown@@ komutlarını kullanın."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Arzu ettiğiniz vitese geçmek için H vites kolunuzu @@ima_wiz_j_clutch@@ ile kullanın."
