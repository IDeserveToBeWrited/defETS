#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Steam Envanterine ait içerik yüklenirken bir sorun meydana geldi.<br><br>$ERROR$<br><br>İçeriği açık tutmak için Devam et düğmesini seçin. Oyun, içeriği periyodik olarak arayacaktır.<br><br>Böyle hata mesajları görmek istemiyorsanız içeriği geçici olarak kapatabilirsiniz. Bir dahaki sefere oyunu çalıştırdığınızda içerik otomatik olarak tekrar açılacaktır." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Steam Envanterine ait ögeler indirilemiyor." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM ENVANTERİ" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Steam Envanterine ait ögeler yükleniyor..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
