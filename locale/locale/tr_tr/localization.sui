#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Gerekli $DEPENDENCY_NAME$ DLC'si (resmî oyun genişlemesi) eksik. Bu kaydın düzgün çalışabilmesi için bu DLC'nin bu bilgisayarda mevcut ve etkinleştirilmiş olması lazım. Bu kaydı yüklemeden önce bu sorunu gidermeniz gerekir." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "İsteğe bağlı $DEPENDENCY_NAME$ DLC'si (resmî oyun genişlemesi) eksik. Bu beklemediğiniz bir şeyse lütfen DLC'nin durumunu kontrol edin.<br><br>Aksi hâlde, kaydı yine de yükleyebilirsiniz fakat DLC tarafından sağlanan bazı işlevler kaybolabilir." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "$DEPENDENCY_NAME$ adlı mod eksik veya devre dışı. Bu beklemediğiniz bir şeyse lütfen modun durumunu kontrol edin. Kaydı yine de yüklemeye çalışabilirsiniz fakat modun yaptığı şeye bağlı olarak yüklenmeyebilir veya başka sorunlara sebep olabilir." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "$DEPENDENCY_NAME$ adlı mod oyununuzun versiyonu ile uyumlu değil yani bu modun sahibi, modu oyunun sadece belirli versiyonları ile uyumlu olacak şekilde işaretledi ve oyunun mevcut versiyonu bu aralıkta değil.<br><br>Çözümler:<br>- Modun, oyunun mevcut versiyonu ile çalışmak üzere tasarlanmış güncel bir versiyonunu bulmaya çalışın.<br>- Oyununuzu güncelleyin veya mod ile uyumlu bir versiyona düşürün.<br><br>Kaydı yine de yüklemeye çalışabilirsiniz fakat mod yüklenmeyecektir ve modun yaptığı şeye bağlı olarak kaydın yüklenmeme veya başka sorunlara sebebiyet verme ihtimali vardır." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "EKSİK GEREKLİ DOSYALAR" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETAYLAR" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Atölye sayfasını aç"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Bu kayıt hâlihazırda eksik olan DLC veya modlara ihtiyaç duyar. Bunlar aşağıda listelenmiştir. Listedeki bir maddeyi seçerek daha fazla bilgi alabilirsiniz." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Bu kayıt en azından bir tane gerekli DLC veya moda ihtiyaç duyar. Bu kaydı yüklemeden önce bu sorunu gidermeniz gerekir." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Yüklemeyi iptal et" #+ Abort loading button.

	key[]: "type"
	val[]: "Tür" #+ Type column.

	key[]: "dependency_name"
	val[]: "Gerekli dosyanın adı" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Yerel Mod" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Atölye Modu" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "İsteğe bağlı DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Gerekli DLC" #+ DLC that is required to load save that is depending on it.
#@}

