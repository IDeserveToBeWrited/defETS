	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Hangi hacim birimlerinin görüntüleneceğini seçin."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Hangi sarfiyat birimlerinin gösterileceğini seçin."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Açıldığında, \"Etkinleştir\" tuşunu (@@imv_nrm_activate@@) kullanmak Konvoy oturumları sırasında sohbeti açacaktır."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
