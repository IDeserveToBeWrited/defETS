#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS İLE BAĞLI İÇERİK" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Bağla" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Göz at" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "GENEL AYARLAR" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "İÇERİK BAĞLAMA" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Bağlan" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks yeni bir oyun içeriği tespit etti. Yeni içeriğe erişmek için World of Trucks hizmetlerine bağlanın." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Çevrim içi" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Çevrim içi tercihleri. World of Trucks ile alakalı bütün ayarları buradan ayarlayabilirsiniz." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Kayıt işlemini gerçekten ertelemek istiyor musunuz?<br><br>Bu diyaloğa daha sonra ana ekranda bulunan Çevrim içi tercihleri kısmından erişebilirsiniz." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "İÇERİK BAĞLAMA" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "İçerik bağlanıyor.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "$CONTENT_NAME$ isimli içeriğin bağlama işlemi sıraya alınamadı." #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Bu DLC'yi kaydetmek için kullandığınız Steam hesabı World of Trucks hesabını oluşturmak veya oyunu kaydetmek için kullanılan Steam hesabından farklı. Lütfen Steam hesabınıza geçip tekrar deneyin." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Bu DLC'yi kaydetmek için kullandığınız Steam hesabı zaten başka bir World of Trucks hesabına bağlanmış. DLC'yi mevcut hesaba kaydetmek için herhangi bir World of Trucks hesabına bağlanmamış bir Steam hesabı kullanmanız lazım." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam anahtarının süresi doldu. Lütfen daha sonra tekrar deneyin." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Bu DLC'yi devreye sokmak için kullandığınız seri numara geçerli değil. Yardım için lütfen support@scssoft.com adresi ile irtibat kurun." #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Oyunu kaydetme işlemi esnasında bir iç hata oluştu. Lütfen daha sonra tekrar deneyin." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "BAŞARILI" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "BİLGİ" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ÇEVRİM İÇİ" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "İÇERİK GEZGİNİ" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Tebrikler! Seçilen DLC'ler World of Trucks hesabınıza başarıyla bağlandı." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Mevcut Steam hesabı farklı bir World of Trucks hesabıyla ilişkilendirildiği için içerik bağlanamıyor." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Bazı DLC'ler bağlanamadı.<br>Detayları görmek için farenizi her DLC'nin yanındaki ünlem işaretinin üzerine sürükleyin." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "$CURRENT_CONTENT_NAME$ kaydediliyor" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Mevcut profil World of Trucks'a bağlı değil veya oyun çevrim dışı modda çalışıyor. Bağlanmak için profili düzenleyin." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Kapatmak için Tıklayın"

	key[]: "online_connect_content_info"
	val[]: "Hâlihazırda $TOTAL_CONTENT$ tane uyumlu DLC'nin <color value=@@clr_sel@@>$CONNECTED_CONTENT$<color value=@@clr_txt@@> tanesi bağlandı. Bazı DLC'ler World of Trucks'a bağlı değilse DLC'lere ait bazı özellikler çalışmayabilir." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Tebrikler! <color value=@@clr_txt@@>Bütün içeriğiniz World of Trucks'a bağlandı! Artık bütün özelliklerinden faydalanabilirsiniz." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Hâlihazırda kullanılan Steam hesabı World of Trucks profili tarafından kullanılan Steam hesabı ile eşleşmediği için yeni içerik World of Trucks'a bağlanamıyor." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Bağlı" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Bağlı değil" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Sahip olduğunuz içerik hakkındaki bilgiler alınamıyor." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Bağlı içerik hakkındaki bilgiler alınamıyor." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Hâlihazırda kullanılan hesap hakkındaki bilgiler alınamadı." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Daha sonra" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Bu DLC kaydedilemiyor. Muhtemelen Steam Aile Paylaşımı özellikleri yüzünden kalıcı lisans bulunamadı." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Kalıcı sahiplik yok" #+ The state of the content that cannot be connected due to invalid license.
