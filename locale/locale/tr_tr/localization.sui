#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banka" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Paraya ihtiyacınız olursa her zaman bankaya başvurabilirsiniz." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "KREDİ TEKLİFLERİ" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "günlük $MONEY$ karşılığında" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Aktif kredi sayısı: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Kredi limitiniz: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "AKTİF KREDİLERİN ÖZETİ"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Kredi tutarı" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Geri ödenecek<br>tutar" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Vade (gün)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Faiz oranı (yıllık)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Taksit" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Geri öde" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Toplam:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Hesap bakiyesi: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "YENİ KREDİ" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Talep ettiğiniz kredi tutarı: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Geri ödeme vadesi:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Faiz oranı (yıllık):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Günlük taksit:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Başvurunuzu onaylamak istediğinizden emin misiniz?"
#@}

