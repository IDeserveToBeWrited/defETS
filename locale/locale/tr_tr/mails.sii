SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "Sistem" #+ Message sender
		subject: "Test mesajı" #+ Message subject
		body: "Merhaba!<br><br>Bu, yöneticinizden gelen bir test mesajıdır ;-)<br><br>Teşekkürler" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "Banka" #+ Message sender
		subject: "Paraya mı ihtiyacınız var? Biz yardımcı olalım!" #+ Message subject
		body: "Sayın İlgili,<br><br>Yeni işletmelere uygun krediler sunduğumuzu bilmenizi istedik. İşletmeniz için finansmana mı ihtiyacınız var? Size yardımcı olmak için buradayız! Lütfen daha fazla bilgi için $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>yerel bankacılık merkezinizi ziyaret edin</link>.<br><br>Saygılarımızla,<br>Satış Müdürü<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "Banka" #+ Message sender
		subject: "Büyümenize yardımcı olabiliriz" #+ Message subject
		body: "Sayın İlgili,<br><br>İstikrarlı kazançlarınızı fark etmemek elde değil. Potansiyelinizi daha da büyütmenize yardımcı olmak istiyoruz. Kredi limitiniz $MONEY$ meblağına yükseltildi. Mevcut meblağı istediğiniz zaman $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>yerel banka merkezinizde</link> çekebilirsiniz.<br><br>Saygılarımızla,<br>Satış Müdürü<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "Banka" #+ Message sender
		subject: "Hesabınız eksi bakiye veriyor" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>Hesabınızda bulunan paradan daha fazlasını çektiniz. Sorunu halledebilmeniz için siz değerli müşterimize biraz zaman tanımış olmak amacıyla size kısa bir süreliğine masrafsız kredi verme kararı aldık. İyi niyetimizi göz önünde bulundurarak borcunuzu bir an önce ödeyeceğinizi umuyoruz.<br><br>En içten dileklerimizle,<br>Müşteri Temsilciniz<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "Banka" #+ Message sender
		subject: "Ödenmemiş borcunuz bulunmaktadır!" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>Hesap bakiyeniz ekside. Borcunuzu $DAYS$ içinde ödemeniz gerek yoksa varlıklarınıza el koymak zorunda kalacağız.<br><br>Saygılarımızla,<br>Müşteri Temsilciniz<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "Banka" #+ Message sender
		subject: "Son uyarı!" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>Bu size son uyarımız. Hesap bakiyeniz ekside. Yarına kadar borcunuzu ödemezseniz borcunuzu karşılamak için mülkünüzü haczedeceğiz.<br><br>Saygılarımızla,<br>Müşteri Temsilciniz<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "Banka" #+ Message sender
		subject: "Borç ödendi" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>Bize olan borcunuz kapandı. İleride yeniden sizinle çalışmaktan mutluluk duyarız.<br><br>İyi günler dileriz,<br>Müşteri Temsilciniz<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "Banka" #+ Message sender
		subject: "Şahsi çekiciniz satıldı" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>Şahsi $TRUCK_NAME$ çekicinizi $MONEY$ karşılığında sattığımızı üzülerek bildirmek durumundayız. Maalesef bize olan borcunuzu ödeyecek bir kaynağınız yoktu. Dolayısıyla biz de son çare olarak bu tedbiri aldık. Mali durumunuz düzelene ve bir çekici alana kadar tek seferlik işlerde çalışmanızı öneriyoruz.<br><br>Saygılarımızla,<br>Müşteri temsilciniz<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "Banka" #+ Message sender
		subject: "Şahsi dorseniz satıldı" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>$TRAILER_NAME$ isimli dorsenizi $MONEY$ karşılığında sattığımızı üzülerek bildirmek durumundayız. Maalesef bize olan borcunuzu ödeyecek bir kaynağınız yoktu. Dolayısıyla son çare olarak bu tedbiri aldık. Mali durumunuz düzelene kadar tek seferlik işlerde çalışmanızı öneriyoruz.<br><br>Saygılarımızla,<br>Müşteri temsilciniz<br>Banka" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "Banka" #+ Message sender
		subject: "Mülkünüz satıldı" #+ Message subject
		body: "Sayın Müşterimiz,<br><br>Ödenmemiş borcunuz bulunduğundan varlıklarınızı haczetmek zorunda kaldık. Satıştan elde edilen <br>$MONEY$ borçlarınıza mahsuben alındı. Ayrıca aşağıdaki varlıklarınıza da el konuldu:<br><br>$ITEM_LIST$<br>Bankanız olarak durumun bu noktaya gelmiş olmasına üzgünüz. Bu durumun ilerideki girişimlerinizi etkilememesini umarız.<br><br>En içten dileklerimizle,<br>Müşteri temsilciniz<br>Banka" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "Çekici galerisi - $CITY$" #+ Message sender
		subject: "Son model satılık $BRAND$ çekiciler!" #+ Message subject
		body: "Sayın Bay/Bayan,<br><br>$BRAND$ çekicilerin yetkili bir perakendecisiyiz. Farklı konfigürasyonların geniş bir yelpazesini sunuyoruz ve ayrıca her türlü özel isteği karşılamak için özelleştirmeler de yapabiliyoruz. Lütfen, $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>$CITY$ şehrindeki galerimize uğrayın</link>. Her zaman hayalini kurduğunuz çekici, kapının hemen arkasında sizi bekliyor olabilir.<br><br>Saygılarımızla,<br>$BRAND$ Çekici Bayii" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "İkinci El Çekici Galerisi" #+ Message sender
		subject: "Satılık ikinci el çekiciler!" #+ Message subject
		body: "Sayın Bay/Bayan,<br><br>Yüksek kaliteli ikinci el çekiciler için en yeni adresiniz olan İkinci El Çekiciler bayiliğimizin açılışını duyurmaktan heyecan duyuyoruz! İster güçlü bir makine ister güvenilir bir beygir arıyor olun tam size uygun çekici bizde var.<br><br>Lütfen $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>İkinci El Çekici tekliflerimize</link> göz atın. İhtiyaçlarınıza uygun mükemmel çekiciyi bulacağınıza inanıyoruz.<br><br>Saygılarımızla,<br><br>İkinci El Çekici Bayiliği Ekibi<br><br>Not: Sık sık kontrol etmeyi unutmayın! Envanterimiz sürekli değişiyor, bu sebeple ne tür bir fırsatla karşılaşabileceğinizi asla bilemezsiniz." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "Kendi aracına sahip şoförler aranıyor" #+ Message subject
		body: "İlgili Kişiye,<br><br>Çok sayıda teslimat için kendi çekicisine sahip usta şoförler arıyoruz. İş başına $MONEY$ meblağına kadar iddialı ücretler sunuyoruz. Kendinize ait bir araca sahipseniz $CITY$ şehrindeki ofisimize lütfen bizzat başvurun.<br><br>$COMPANY$,<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "$NAME$ adlı şoför" #+ Message sender
		subject: "Çalışmak için bir çekiciye ihtiyacım var" #+ Message subject
		body: "Selam Patron,<br><br>Galiba fark etmedin fakat $CITY$ şehrinde $DAYS$dür işsiz güçsüz oturuyorum. Artık dayanamıyorum. Burada boş boş duracaksam ben nasıl para kazanırım, nasıl öderim faturalarımı? Lütfen önümüzdeki $DAYS2$ içinde bana bir çekici bul ki ben de iş bulayım, yoksa yanından ayrılmak zorunda kalacağım.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "$NAME$ adlı şoför" #+ Message sender - written by female
		subject: "Çalışmak için bir çekiciye ihtiyacım var" #+ Message subject - written by female
		body: "Selam Patron,<br><br>Galiba fark etmedin fakat $CITY$ şehrinde $DAYS$dür işsiz güçsüz oturuyorum. Artık dayanamıyorum. Burada boş boş duracaksam ben nasıl para kazanırım, nasıl öderim faturalarımı? Lütfen önümüzdeki $DAYS2$ içinde bana bir çekici bul ki ben de iş bulayım, yoksa yanından ayrılmak zorunda kalacağım.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "$NAME$ adlı şoför" #+ Message sender
		subject: "Hoşça kal" #+ Message subject
		body: "Selam,<br><br>Kusura bakma, zamanımı daha fazla harcayamam. Sürecek bir çekicim olmadıktan sonra beklemenin de bir anlamı yok. Daha fazla fırsat kaçırmamak için şirketinden ayrılıp başka yerlerde şansımı deneyeceğim. Şirkete ait olan tüm ekipmanı $CITY$ şehrindeki garaja bıraktım.<br><br>Hoşça kal,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "$NAME$ adlı şoför" #+ Message sender - written by female
		subject: "Hoşça kal" #+ Message subject - written by female
		body: "Selam,<br><br>Kusura bakma, zamanımı daha fazla harcayamam. Sürecek bir çekicim olmadıktan sonra beklemenin de bir anlamı yok. Daha fazla fırsat kaçırmamak için şirketinden ayrılıp başka yerlerde şansımı deneyeceğim. Şirkete ait olan tüm ekipmanı $CITY$ şehrindeki garaja bıraktım.<br><br>Hoşça kal,<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "$NAME$ adlı şoför" #+ Message sender
		subject: "Çekicimin eksiksiz bir tamirata ihtiyacı var" #+ Message subject
		body: "Merhaba Patron,<br><br>Meşgul olduğunu biliyorum ama çekicimin eksiksiz bir tamirata ihtiyacı var. Artık güvenle sürülemeyecek kadar eski ve aşınmış bir hâlde. Son $DAYS$ iş alamadım ve açıkçası oldukça sinirliyim çünkü faturalarım birikti ve yola çıkmaya uygun bir aracım olmadan ödeyemiyorum. Lütfen bana ya yeni bir çekici al ya da elimdekini tamir et ki işime geri dönebileyim. Aksi takdirde ayrılmaktan başka çarem kalmayacak.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "$NAME$ adlı şoför" #+ Message sender - written by female
		subject: "Çekicimin eksiksiz bir tamirata ihtiyacı var" #+ Message subject - written by female
		body: "Merhaba Patron,<br><br>Meşgul olduğunu biliyorum ama çekicimin eksiksiz bir tamirata ihtiyacı var. Artık güvenle sürülemeyecek kadar eski ve aşınmış bir hâlde. Son $DAYS$ iş alamadım ve açıkçası oldukça sinirliyim çünkü faturalarım birikti ve yola çıkmaya uygun bir aracım olmadan ödeyemiyorum. Lütfen bana ya yeni bir çekici al ya da elimdekini tamir et ki işime geri dönebileyim. Aksi takdirde ayrılmaktan başka çarem kalmayacak.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "$NAME$ adlı şoför" #+ Message sender
		subject: "Hoşça kal" #+ Message subject
		body: "Selam,<br><br>Çekicim aşınma ve yıpranma yüzünden berbat bir hâlde ve vaktim tükendi. İş alamıyorum ve boğazıma kadar borca battım. Bu yüzden artık kendi yoluma bakmak zorundayım. Eğer bu çekiciyi başka bir çalışanına vermek gibi bir planın varsa eksiksiz tamir ettir de öyle ver. Şirkete ait olan tüm ekipmanı $CITY$ şehrindeki eski garajıma bıraktım.<br><br>Hadi hoşça kal.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "$NAME$ adlı şoför" #+ Message sender - written by female
		subject: "Hoşça kal" #+ Message subject - written by female
		body: "Selam,<br><br>Çekicim aşınma ve yıpranma yüzünden berbat bir hâlde ve vaktim tükendi. İş alamıyorum ve boğazıma kadar borca battım. Bu yüzden artık kendi yoluma bakmak zorundayım. Eğer bu çekiciyi başka bir çalışanına vermek gibi bir planın varsa eksiksiz tamir ettir de öyle ver. Şirkete ait olan tüm ekipmanı $CITY$ şehrindeki eski garajıma bıraktım.<br><br>Hadi hoşça kal.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "$NAME$ adlı şoför" #+ Message sender
		subject: "İşi bırakıyorum" #+ Message subject
		body: "Merhaba Patron,<br><br>$CITY$ şehrinde benim kaldığım garaj vardı ya hani, işte orası maalesef kapanıyor. Bugün bankadan birileri geldi, dediler ki burayı boşaltacaksın. Herhalde bizim şirket nalları dikecek. Ben de ayrılmaya karar verdim o yüzden. Zaten çekicim falan olmadan da şirkete bir faydam olmaz. Ekmeğimi başka yerde arayacağım.<br><br>Selametle patron, darılmaca gücenmece olmasın,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "$NAME$ adlı şoför" #+ Message sender - written by female
		subject: "İşi bırakıyorum" #+ Message subject - written by female
		body: "Merhaba Patron,<br><br>$CITY$ şehrinde benim kaldığım garaj vardı ya hani, işte orası maalesef kapanıyor. Bugün bankadan birileri geldi, dediler ki burayı boşaltacaksın. Herhalde bizim şirket nalları dikecek. Ben de ayrılmaya karar verdim o yüzden. Zaten çekicim falan olmadan da şirkete bir faydam olmaz. Ekmeğimi başka yerde arayacağım.<br><br>Selametle patron, darılmaca gücenmece olmasın,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "Sevk memuru" #+ Message sender
		subject: "Özel Nakliyeler" #+ Message subject
		body: "Merhaba patron.<br><br>Elimde tam sana göre bir iş var. Bağlantılarımız sayesinde sonunda dişimize göre zorlu işler bizi bekliyor. Tam bir usta tarafından çekilmesi gereken özel, çok büyük ve ağır yükler var. Kolay değil; ustalık, sabır, refakatçi araçlarla takım çalışması ve özen gerektiren işler. Ama sen zaten bunların altından kalkarsın, değil mi? Tabii ki büyük risk, büyük de bir kâr demek. <br><br>İlgilenirsen şu şehirlere bir uğra:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "Sevk memuru" #+ Message sender
		subject: "Yeni Özel Nakliyeler" #+ Message subject
		body: "Merhaba patron.<br><br>Birçok yeni firma, özel teslimatları için senin profesyonel sürüş kabiliyetlerinden faydalanmak istiyor. Bunlar önceki işler gibi kolay değil. Kabiliyet, sabır ve refakatçi araçlarla beraber çalışma gerektiriyor. Ama bu kabiliyetleri köreltmemişsindir, haksız mıyım? Sakın unutma, bu işlerde hâlâ büyük kâr var.<br><br>Hâlihazırda zaten Özel Nakliye işlerini yaptığımız şu şehirler var:<br><br>$OLD_CITIES$<br><br>Ancak artık bu yeni şehirlerden de <color value=@@clr_sel@@>yeni Özel Nakliye işi<color value=@@clr_txt@@> alabilirsin:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "Emlak Ofisi" #+ Message sender
		subject: "Şirketinizi büyütmek mi istiyorsunuz?" #+ Message subject
		body: "Sayın İlgili,<br><br>Şirketinizin yükselişinden dolayı sizi tebrik etmek istiyoruz. İşletmenizin başarısından etkilendik ve şirketinizin daha da büyümesine yardımcı olmak için size yeni bir yol sunmak istiyoruz. Bundan böyle hizmetlerimizi kullanarak ilave mülkleri neredeyse anında satın alabilirsiniz! Daha fazla bilgi için lütfen $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>Garaj Satın Alma arayüzünü ziyaret edin</link>.<br><br>Saygılarımızla,<br>Müşteri İlişkileri Müdürü<br>Emlak Ofisi" #+ Message body
	}
	
#@}
}