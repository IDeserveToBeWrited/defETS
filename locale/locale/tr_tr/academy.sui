#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Erkenci"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "Bu senaryoda, aşırı kalabalık bir yerde yolunuzu bulmanız gerekir. Alan son derece sınırlıdır, bu sebeple hareketlerinizi önceden planlamaya çalışın."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Park yerlerinin o kadar sınırlı olduğu zamanlar vardır ki diğer şoförler gece boyunca bulabildikleri her yere park ederler. Bu, sabahleyin onların etrafında manevra yapmayı oldukça zorlaştırabilir.<br><br>Alandan geçip son park yerine ulaşmak için elinizden geleni yapın."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Eğri Büğrü"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "Bu senaryoda, çok karmaşık bir eğitim pistinde sürüş göreviniz var. Yol boyunca bir dorse bulup bağlamalı, sonra da senaryo sonuna kadar taşımalısınız."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Bu senaryo mekân ve durum farkındalığınızı test edecektir. Önünüzdeki pist her zaman kolayca fark edemeyeceğiniz engellerle doludur."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Pistten geçerek dorseyi bulmaya çalışın. Dorseyi bulduğunuzda bağlayın ve son park yerine götürün."



