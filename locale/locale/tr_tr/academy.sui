	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Final sınavının ilk bölümüne hoş geldiniz. Burada, Akademi'de geçirdiğiniz süre boyunca çekici sürmeyi ne kadar iyi öğrendiğinizi göreceğiz."

	key[]: "aca_msg_book1_3_19_cutscene02"
