#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kamera Ayarları"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Bu senaryoda, kullanabileceğiniz çeşitli kamera türlerini ve bunların çekicinizi kontrol etmenize ve manevra yapmanıza nasıl yardımcı olabileceğini öğreneceğiz."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Oturma Pozisyonu"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Arkaya Bakış"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Ayna Kontrolü"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Dış Kameraya Geç"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Çekicinin Etrafına Bak"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Bu senaryoda, kullanımınıza sunulan çeşitli kameraları<br>inceleyeceğiz."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Tercih edebileceğiniz toplam yedi adet kamera vardır, hâlihazırda<br> birkaç tanesini inceleyeceğiz ve maksatlarını açıklayacağız."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Muhtelif kameralar ve bu kameraların açıları dar yerlerde manevra yaparken size yardımcı olabilir."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Nereye gittiğinize bakmak emniyetli ve profesyonel bir sürüşün temelidir. Hâlihazırdaki koltuk ayarı size uymuyorsa '@@adjust_link_t@@' kısmında (duraklatma menüsü vasıtasıyla ulaşabilirsiniz) değiştirebilirsiniz.<br><br><font face=/font/big_bold.font>Hazır olduğunuzda @@imv_nrm_activate@@ ile onaylayın. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Geri giderken aynalarınız her zaman net bir görüş sağlamaz. Daha iyi bir görüş elde etmek için arkanızdaki pencereden dışarı bakmanız gerekebilir.<br><br><font face=/font/big_bold.font>Kameranızı tamamen şoför tarafına doğru çevirin ve dorsenin arkasına doğru pencereden dışarı bakın.</font>@@aca_goal_tip@@ Aracın içinde olmanız gerekir."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Dorseyle geri manevralar sırasında dorseyi kontrol etmek için bu görüşü kullanın. Bu görüşü kullanabilmek için şoför tarafına doğru geri gitmek her zaman daha iyidir. Yolcu tarafına doğru geri giderken arkanızda neler olup bittiğine dair çok daha sınırlı bir görüşünüz olur.<br><br><font face=/font/big_bold.font>Yolcu tarafına doğru bakın. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Bu yüzden genellikle yolcu tarafına doğru geri gitmeniz tavsiye edilmez; görüş alanının oldukça sınırlı olduğunu görebilirsiniz. Neyse ki, kullanabileceğiniz yedi adet haricî kamera da mevcuttur. <br><br>@@imv_nrm_camcycle@@ tuşu sıradaki kameraya geçmek için kullanılabilir. Yedi kameranın hepsinden geçtikten sonra en başa dönersiniz. <br><br><font face=/font/big_bold.font>Sonraki kameraya geçmek için @@imv_nrm_camcycle@@ tuşuna basın. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Haricî kamera, çekicinin etrafında olup bitenlere dair en iyi görüşü sağlar.<br><br><font face=/font/big_bold.font>Çekicinin etrafına bakın.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Tekrar @@imv_nrm_camcycle@@ tuşuna basarak bir sonraki kameraya geçebilirsiniz. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Tepeden görüş, çekicinin etrafındaki durumun mükemmel bir genel görünümünü sağlayarak dar alanlarda park etmeyi ve sürüşü önemli ölçüde kolaylaştırır.<br><br><font face=/font/big_bold.font>Sonraki kameraya geçmek için @@imv_nrm_camcycle@@ tuşuna basın.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Tavan kamerası, çekicinin önündeki yolun çok fazla engele takılmadan net bir şekilde görülmesini sağlar.<br><br><font face=/font/big_bold.font>Şimdilik inceleyeceğimiz son kameraya geçmek için @@imv_nrm_camcycle@@ tuşuna basın.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Arka görüş, iç mekân kamerasını çevirerek daha önce elde ettiğiniz görüşe giden bir kısayoldur. Konuştuğumuz gibi, geri giderken veya park ederken faydalıdır.<br><br>Oyunda @@imv_nrm_camcycle@@ tuşuna tekrar tekrar basarak deneyebileceğiniz daha çok kameramız var.<br><br><font face=/font/big_bold.font>İçeriye dönmek için @@imv_nrm_cam1@@ tuşuna basın.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Gerçek bir ehliyet kursu deneyimi için her senaryoyu incelerken 'İç Mekân Kamerası'nda kalmanızı tavsiye ederiz.<br><br><font face=/font/big_bold.font>Onaylamak ve senaryoyu sonlandırmak için @@imv_nrm_activate@@ tuşuna basın.\n</font>@@aca_goal_tip@@ Etrafınızı daha iyi görebilmek için @@o_im_cam_zoom@@ özelliğini kullanabilirsiniz. Özellikle aynalardan bakarken çok faydalıdır. İlgili kontrolleri görmek ve/veya değiştirmek için Seçenekler Ekranı - 'Tuşlar ve Düğmeler'i kontrol edin."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "İlk Sürüş"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Bu senaryoda, çekiciyi sürülmeye nasıl hazırlayacağımızı ve ardından ilk kez ileri doğru sürmeyi öğreneceğiz."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Kontağı Açmak"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Motoru Çalıştırmak"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Çevreyi Kontrol Etmek"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Frene Basmak"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Vitese Atmak"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "El Frenini İndirmek"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "İleri Sürmek"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Durmak"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "El Frenini Çekmek"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Vitesi Boşa Atmak"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Motoru Kapatmak"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "İlk birkaç sürüşümüzde sadece çekici kullanacağız.<br>Bir aracın kendine ait bir yük gövdesi olmadığında ve bunun yerine mal ve malzemeleri nakletmek için bir dorse kullandığında ona çekici denir."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Çekiciler daha fazla çok yönlülüğe imkan sağladıkları için yaygındır: Boş bir dorseyi bırakıp beklemeden dolu bir dorse alabilirler veya tamamen farklı bir dorse türüne geçebilirler."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "İlk sürüşünüzde göreviniz ileri doğru sürmek ve kesik çizgiden sonra durmak olacak.<br>Motoru çalıştırın, çekiciyi hareket etmeye hazırlamak için talimatları takip edin. Hazır olduktan sonra düz bir şekilde ilerleyin."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Kesik çizgiyi geçin, durun, motoru kapatın ve çekiciyi emniyete alın."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Eğitiminizin bir sonraki adımında çekiciyi ilk defa hareket ettireceksiniz.<br><br>Tabii ki motor çalışmadan olmayacağı için öncelikle kontağı açmanız gerekecek.<br><br><font face=/font/big_bold.font>Kontağı açmak için $input engineelect$ tuşuna basın.</font>@@aca_goal_tip@@ Kariyer modunda varsayılan olarak motor kontakla beraber otomatik olarak çalışır. Kariyer modu için bu davranışı Seçenekler Ekranı - 'Oynanış' - @@auto_engine_start@@ seçeneğinden ayarlayabilirsiniz."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Kontak, çekicinin elektronik aksamını devreye sokar. Gösterge panelinde ikaz lambalarının yanıp söndüğünü fark etmiş olabilirsiniz, bu normaldir. Motor çalıştırıldıktan sonra yanık kalırlarsa bu muhtemelen çekicide bir arıza olduğunu gösterir. Bunun tek istisnası el frenini indirdiğimizde sönecek olan el freni lambasıdır.\n<br><br>Neyse ki, bu çekici iyi durumda ve yola çıkmaya hazırız.<br><br><font face=/font/big_bold.font>Motoru çalıştırmak için @@imv_nrm_engine@@ tuşuna basın. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Motoru çalıştırdıktan sonra herhangi bir harekete başlamadan önce çevrenizi kontrol etmeniz büyük önem arz eder.<br><br><font face=/font/big_bold.font>Çekicinin etrafına ve şoför ve yolcu tarafındaki aynalara bakarak etrafınızdaki alanın açık olduğundan emin olun.</font>@@aca_goal_tip@@ Aracın içinde olmanız gerekir."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Belki aşikârdır ama herhangi bir harekete başlamadan önce nasıl duracağınızı bilmelisiniz.<br><br><font face=/font/big_bold.font>$input backward$ ile servis (ayak) frenini devreye sokun. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Daha sonra seyir istikametinizi nasıl değiştireceğinizi öğreneceksiniz.<br><br>Basitleştirilmiş otomatik şanzıman sayesinde vites değiştirmenize gerek kalmaz, her şey sizin için otomatik olarak yapılır.<font face=/font/big_bold.font><br><br>$input forward$ ile ileri bir vitese geçin. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Daha sonra seyir istikametinizi nasıl değiştireceğinizi öğreneceksiniz.<br><br>Gerçekçi otomatik şanzıman, tıpkı gerçek otomatik şanzımanlarda olduğu gibi Sürüş, Boş ve Geri Vites modları arasında geçiş yapmanızı sağlar.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@ ile ileri bir vitese geçin. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Daha sonra seyir istikametinizi nasıl değiştireceğinizi öğreneceksiniz.<br><br>Sıralı şanzıman, gerçek sıralı şanzımanlarda olduğu gibi kademeli vites geçişine imkân sağlar.<br><br>Aynı şekilde ileri bir vitese geçtiğinizde de hızlanırken daha yüksek viteslere geçmeniz gerekecektir.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@ ile birinci vitese geçin.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Daha sonra seyir istikametinizi nasıl değiştireceğinizi öğreneceksiniz.<br><br>Vites kolu ve debriyaj sayesinde gerçek manuel şanzımanda olduğu gibi vites değiştirmenin fiziksel hissini yaşayacaksınız.<br><br>Debriyaj ve servis (ayak) frenine sonuna kadar basın. <font face=/font/big_bold.font>Birinci vitese geçmek için vites kolunu kullanın. <color value=@@clr_txt@@>Debriyaj ve servis (ayak) frenini sonuna kadar basılı tutun.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Hareket etmeye başlamak için öncelikle el frenini indirmeniz gerekiyor.<br><br><font face=/font/big_bold.font>El frenini indirmek için @@imv_nrm_parkingbrake@@ tuşuna basın.</font> @@aca_goal_tip@@ Kariyer modunda, el freni başlangıçta devre dışıdır. Bu davranışı Seçenekler Ekranı - 'Oynanış' - @@auto_park_brake@@ seçeneğinden ayarlayabilirsiniz."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Artık çekici ileriye doğru hareket etmeye hazır. Hareket etmeye başlayın ve kesik çizgiyi geçin.<br><br><font face=/font/big_bold.font>Gaz pedalını kullanarak hareket etmeye başlayın: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Artık çekici ileriye doğru hareket etmeye hazır. Hareket etmeye başlayın ve kesik çizgiyi geçin.<br><br><font face=/font/big_bold.font>Gaz pedalını kullanarak hareket etmeye başlayın: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Artık çekici ileriye doğru hareket etmeye hazır. Hareket etmeye başlayın ve kesik çizgiyi geçin.<br><br><font face=/font/big_bold.font>Gaz pedalını kullanarak hareket etmeye başlayın: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Artık çekici ileriye doğru hareket etmeye hazır. Hareket etmeye başlayın ve kesik çizgiyi geçin.<br><br><font face=/font/big_bold.font>Servis (ayak) frenini bırakın, debriyajı yavaş yavaş bırakın, aynı anda devrinizi yüksek tutmak için gaz pedalını kullanın, böylece çekici istop etmez. Debriyaj tamamen bırakıldığında, gerektiği şekilde hızlanabilir ve vites değiştirebilirsiniz. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Durmak için servis (ayak) frenini kullanın.<br><br><font face=/font/big_bold.font>$input backward$ ile çekiciyi durdurun. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Durmak için servis (ayak) frenini kullanın.<br><br><font face=/font/big_bold.font>$input backward$ ile çekiciyi durdurun. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Durmak için servis (ayak) frenini kullanın.<br><br><font face=/font/big_bold.font>$input backward$ ile çekiciyi durdurun. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Durma zamanı geldiğinde, debriyaja sonuna kadar basın <font face=/font/big_bold.font>ve ardından servis (ayak) frenini kullanarak çekiciyi durdurun.<color value=@@clr_txt@@> Vites kolunu kullanarak boşa alın ve ardından debriyajı bırakabilirsiniz.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Şimdi çekiciyi emniyete alın. El freni, park ettikten sonra çekicinin kazara hareket etmemesini sağlar.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ ile el frenini indirin.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Basitleştirilmiş otomatik şanzıman sayesinde vites değiştirmenize gerek kalmaz, her şey sizin için otomatik olarak yapılır.<br><br><font face=/font/big_bold.font>Onaylamak için @@imv_nrm_activate@@ tuşuna basın. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ tuşuna basarak boşa alın. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@ tuşuna basarak boşa alın. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Vites kolunu boşa alın, ardından debriyajı bırakın. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Artık kamyonu nasıl hareket ettireceğinizi ve güvenli bir şekilde nasıl durduracağınızı biliyorsunuz.<br><br><font face=/font/big_bold.font>Motoru kapatmak için $input engineelect$ tuşuna basın.</font>"
#@}

