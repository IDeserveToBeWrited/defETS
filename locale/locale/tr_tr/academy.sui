#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Yol Tutuş Pistinde Sürüş"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Bu senaryoda, çekiciyi farklı türdeki virajlarda ve dönemeçlerde kullanma becerinizi test etmek için tasarlanmış bir pistte sürüş yapacağız."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Piste Girmek"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Kademeli Bir Sol Dönüş Yapmak"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "S Virajlar Boyunca Sürmek"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Düzlük"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Kolay Dönüşler"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Eğitim Pistinden Çıkmak"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Park Yerine Yaklaşmak"
