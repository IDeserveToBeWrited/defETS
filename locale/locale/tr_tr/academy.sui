#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Bu bölümün son senaryosunda karmaşık bir yapılandırmayla beraber test pistinde sürüşe çıkacağız."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "İlk engel, bazı bariyerlerin arasından slalom yapmaktır. Etraflarından geçin ve aynalarınızı kullanmayı unutmayın."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Sırada keskin bir dönüş var. Dönüşünüzü geniş tuttuğunuz müddetçe başınıza bela olmayacaktır."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Burada 90 derecelik bir sol dönüş var. Çekicinin arkası iç bariyerleri geçecek şekilde derine girmeyi unutmayın."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Rampa engeli biraz zor olabilir. Üzerine çıkmadan önce kendinizi mümkün mertebe iyi hizalayın ve yönünüzü bulmak için ön ve yan aynalarınızı kullanın."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Bir sonraki bölüm tersten tamamlanmalıdır. Bunu aklınızda tutarak önünüzdeki bariyerlere yaklaşın."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Arka sağınızda bulunan yol işaretlerini takip edin."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Bariyerlere doğru geri gidin, sonra durun ve soldan ilerlemeye devam edin."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Refüjdeki aralıktan bir sonraki bölüme geçin."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Koniler arasındaki bu geçit çok dardır. Yavaş sürün ve yönünüzü bulmak için aynalarınızı kullanın."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "90 derecelik dönüşlerde derine inmeyi unutmayın."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Güzel ve açık bir yola giriyorsunuz. Biraz hızlanabilirsiniz, ancak ilerideki viraja gelince yavaşlamanız gerekeceğini unutmayın."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Yokuşun dibinde yolun karşısında bazı bariyerler var. Onlara doğru sürün, sonra soldaki park yerine geri geri girin."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Park yerine geri geri girin."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Park edin, ardından motoru kapatın ve çekiciyi emniyete alın."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Önünüzde bariyerlerden meydana gelen bir slalom var.<br><br><font face=/font/big_bold.font>Slalom yapın.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Çekicinin arkasının kaldırıma çıkmasını önlemek için virajın dış tarafına doğru ilerleyin.<br><br><font face=/font/big_bold.font>Dönüşü gerçekleştirin. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "90 derecelik bir sol dönüşe geliyorsunuz. Mevcut bütün alanınızı kullanmayı unutmayın.<br><br><font face=/font/big_bold.font>Dönüşü gerçekleştirin. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Rampaya hizalanın. Üzerine çıktığınızda düzeltme yapmak için pek fazla alan yoktur.<br><br><font face=/font/big_bold.font>Rampaya çıkın. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Soldaki yolu takip edin. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Sıradaki bölüm tersten tamamlanmalıdır. Daha sonra sağa geri gidebilmek için önünüzdeki bariyerlerde durun.<br><br><font face=/font/big_bold.font>Bariyerlerde durun.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Arka sağınızdaki alana doğru geri gidin. Yolda size yardımcı olacak oklar vardır.<br><br><font face=/font/big_bold.font>Bir sonraki bölüme doğru geri geri gidin. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Arkanızdaki bariyerlere doğru geri geri gitmeye devam edin.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Durun ve ileri vitese geçin, ardından sola doğru devam edin. <br><br><font face=/font/big_bold.font>İleriye doğru sürün. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Sol taraftaki refüjde bir aralık var. Oradan geçin.<br><br><font face=/font/big_bold.font>İleriye doğru devam edin. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Önünüzde bazı konilerin arasından geçen dar ve kıvrımlı bir yol var. Dikkatli sürün ve gerekirse aynalarınızı kullanın.<br><br><font face=/font/big_bold.font>Konilerin arasından geçin. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Yol boyunca devam edin.<br><br><font face=/font/big_bold.font>Sola dönün. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Kendinize mümkün mertebe yer açmak için dönüşten önce solda kalmayı unutmayın.<br><br><font face=/font/big_bold.font>Dönüşü gerçekleştirin. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Sürmeye devam edin. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Burada biraz hızlanabilirsiniz, ancak önünüzde bir viraj var.<br><br><font face=/font/big_bold.font>Yol boyunca devam edin. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Viraj ilerledikçe daha da keskinleşiyor.<br><br><font face=/font/big_bold.font>Hızınızı ayarlayın ve yolunuza devam edin.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Yokuşun dibine vardığınızda yolu kapatan bariyerleri göreceksiniz. <br><br><font face=/font/big_bold.font>Bariyerlerin yakınında durun. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Arka solunuzda bir park yeri var.<br><br><font face=/font/big_bold.font>Park yerine geri geri girin. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>İşaretli yerde durun. </font>"
