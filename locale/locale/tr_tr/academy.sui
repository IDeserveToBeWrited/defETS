#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Paralel park etme her çekici şoförünün bilmesi gereken önemli bir beceridir.<br>Yola çıkmaya hazır olun."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Park yerine doğru sürün.<br>Etrafınıza dikkat edin."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Park yerinizin önündeki çekiciye kendinizi hizalayın. Çok yakın durmayın, biraz mesafe bırakın ki manevra alanınız olsun."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Park yerine doğru keskin bir dönüş yapın ve geri geri gitmeye başlayın."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Şoför tarafındaki aynadan bakarken arkanızdaki çekicinin hemen önündeki kaldırıma bakın."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Ön tamponunuz önünüzdeki çekiciyi geçtikten sonra çekicinin ön kısmını park yerine doğru yönlendirerek çekiciyi park yerine hizalayabilirsiniz."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Direksiyonu toplayın ve çekiciyi park yerininin ortasına yerleştirin.<br>Çekiciyi park edin ve emniyete alın."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Önünüzde park etmiş çekiciler var. Park etmeniz için bir tane boş yer var. <br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Etrafınıza dikkat etmeyi unutmayın. Bu manevra boyunca aynalarınızı iyi kullanın. <br><br><font face=/font/big_bold.font>İleriye doğru sürün. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Park yerini geçip işaretli alana girin. Oradan geri geri gitme manevranıza başlayabilirsiniz.<br><br><font face=/font/big_bold.font>İşaretli yerde durun. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Etrafınızda engel olup olmadığını kontrol edin ve geri geri gidebileceğinizden emin olun.<br><br><font face=/font/big_bold.font>Yolcu tarafındaki aynaya bakın. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Direksiyonunuzu çevirin ve park yerine geri geri girin.<br><br><font face=/font/big_bold.font>Geri geri gitmeye başlayın. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Yeri geldiğinde direksiyonu toplamaya başlayın. Kaldırıma çıkmayın!<br><br><font face=/font/big_bold.font>Çekiciyi park yerine hizalayın. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

