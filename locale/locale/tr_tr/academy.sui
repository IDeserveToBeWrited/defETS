#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "İleri doğru sürerken park etmek veya 'burnu sokmak', park etme manevraları mevzubahis olduğunda oldukça kolaydır. <br>Yine de dorseyi takip etmeniz gerekecek."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Çekiciyi normalde döndüreceğiniz noktanın ötesine geçmeniz gerekecek. Bu, dorseyi daha etkili bir şekilde hizalamanıza imkân tanır."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Park yerine yaklaştığınızda çekiciyi dorsenin önüne getirmek için içeriye doğru dönün. Hizalanın ve park yerine doğru devam edin. <br>Durun, park edin, çekiciyi emniyete alın ve motoru kapatın."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Önünüzdeki park yerine park etmeniz gerekiyor.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Sürmeye başlayın ve park yerine doğru dönün.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Park yerini geçerek dorsenizi işaretli alana hizalayın, ardından çekiciyi park yerine sürün ve düz bir şekilde devam edin.<br><br><font face=/font/big_bold.font>Belirtilen yere park edin.</font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Belirtilen yerde durun.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Çekiciyi emniyete alın ve motoru kapatın.</font>"
#@}

