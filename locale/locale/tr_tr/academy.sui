#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Bu senaryoda, geri geri manevra yapıp bir kaldırım kenarına park edeceğiz."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Kaldırım kenarına doğru geri geri gelin.<br>Geri geri giderken etrafınızdakilere dikkat etmelisiniz bu sebeple aynalarınızı kullanın."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Yaklaştıkça aracınızı park yerine hizalamaya başlayabilirsiniz. Geri gittiğiniz esnada aracınızın her iki tarafını da takip edin."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Park yerinde durun ve aracınızı emniyete alın."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Park yeri arkanızda yolcu tarafındadır. Aynalarınızı kullanarak aracınızı söz konusu yere çekin.<br><br><font face=/font/big_bold.font>Başlamaya hazırlanın. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Çekiciyi hareket ettirmeden önce çevrenizi kontrol etmek için aynalarınızı kullanmayı unutmayın.<br><br><font face=/font/big_bold.font>Kaldırım kenarına doğru geri geri gitmeye başlayın. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Park yerine geri geri girerken çevrenizi takip etmeye devam edin.<br><br><font face=/font/big_bold.font>Belirtilen yerde durun. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

