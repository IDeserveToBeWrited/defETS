	key[]: "aca_msg_book1_3_20_park1"
	val[]: "İlk göreviniz, geri geri park etme manevrasını göstermektir. Dorseyle geri geri yanaşmanız gereken yer solunuzdadır.<br><br><font face=/font/big_bold.font>Geri geri park etme manevrası yapın.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Bir sonraki görev, hareketsiz çekicilerin olduğu bir sıraya geri geri girmektir. Diğer çekicilere çarpmamaya dikkat edin!<br><br><font face=/font/big_bold.font>Çapraz park etme manevrası yapın.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Otoparktan devam edin. Ani durumlara dikkat edin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Şimdi önünüzdeki kaldırım kenarının yanındaki iki çekicinin arasına paralel park etmeye çalışalım.<br><br><font face=/font/big_bold.font>Paralel park etme manevrası yapın.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Solunuzda son bir park etme manevrası var! Buna arzu ettiğiniz şekilde yanaşabilirsiniz.<br><br><font face=/font/big_bold.font>Belirtilen yere geri geri girin.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Bitti sayılır. Test alanından çıkın ve çekiciyi park edin.<br><br><font face=/font/big_bold.font>Sol taraftan çıkın.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Sağ tarafa diğer çekicilerin yanına park edebilirsiniz.<br><br>@@aca_msg_book1_2_01_stop@@"
