#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Konilerin Arasında Slalom"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "Bu senaryoda, aynaların yardımıyla çekiciyi bazı trafik konilerinin etrafında nasıl yönlendireceğimizi öğreneceğiz."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Talimatları Takip Etmek"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Aynaları Kontrol Etmek"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Başlangıç"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "Direksiyon Hâkimiyeti"



	key[]: "aca_goal_book1_2_01_check1"
	val[]: "Slaloma Girmek"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "Trafik Konilerinden Kaçınmak"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "Trafik Konileri Arasında Zikzak Yapmak"
