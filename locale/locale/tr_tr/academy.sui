#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Yan ayna, çekicinin güvenli bir şekilde manevra yapmasına yardımcı olan bir diğer alettir. Yolcu kapısının üst çerçevesinde bulunur."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "İleri doğru sürün ve yavaşça yolcu tarafınıza dönün."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Bu kalaslar bir kaldırım kenarını temsil etmektedir. Yanına park etmeniz gerekecek. <br>Çekiciyi park yerine uygun bir konuma getirmek için kaldırım kenarına doğru dönün."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Kaldırım kenarından çok önce yavaşlayın ve park yerine doğru dönün. Aracı düz duruma getirirken kaldırım kenarına olan mesafenizi ölçmek için yan aynayı kullanabilirsiniz."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Park yerinde durun ve çekiciyi emniyete alın."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Yolcu tarafındaki camdan bakın. Orada yan aynayı görebilirsiniz.</font>@@aca_goal_tip@@ Aracın içinde olmanız gerekir."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Yan ayna, yolcu tarafındaki şoförün göremediği alanı kapsar. Çekicideki en sorunlu kör noktalardan biridir. Aynanın açısı size uymuyorsa '@@adjust_link_t@@' kısmında ayarlayabilirsiniz.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Çekici hâlâ hareket etmeye hazır değil, belki bir şeyi unuttunuz.<br><br>Motor çalışıyor mu? El frenini indirdiniz mi?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Önünüzde bir kaldırım kenarını temsil eden ahşap tahtalar var. Kaldırım kenarının sonunda bir park yeri var. Oraya kadar sürmeniz gerekecek. <br><br><font face=/font/big_bold.font>Hazır olduğunuzda ilerleyin. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Kaldırım kenarına doğru dönün. Kaldırım kenarına göre konumunuzu kontrol etmek için ön ve yan aynaları kullanın, ancak herhangi bir trafik konisinin üzerinden geçmediğinizden emin olun.<br><br><font face=/font/big_bold.font>Kaldırım kenarına doğru ilerleyin ve park yerine girin.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Çekiciyi emniyete alın ve motoru kapatın.</font>@@aca_goal_tip@@ Aynalara bakmayı kolaylaştırmak için ön ayarları kullanabilirsiniz. İlgili kontrolleri görmek ve/veya değiştirmek için Seçenekler Ekranı - 'Tuşlar ve Düğmeler' kısmını kontrol edin."
#@}

