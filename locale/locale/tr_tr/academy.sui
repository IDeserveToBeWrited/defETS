	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Dönel kavşaklardan çift dorse ile geçmek, tek dorse ile geçmekten biraz daha karmaşıktır."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Her iki dorsenin de başarılı bir şekilde girebilmesi için yeterince içeriye doğru sürmeniz gerekiyor, ancak daha sonra dorseleri merkezden uzak tutmak için dışa doğru sürmelisiniz."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "İki dorsenin de tek şeride sığmaması normal; hatta iyimser bir şoförün sizi geçmeye çalışmaması için iki şeridi birden işgal etmeniz daha iyi bile olabilir."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Çıkış şeridinizin en uzak tarafına doğru ilerleyerek her iki dorsenin de muhtemel çarpışmalardan tamamen kurtulduğundan emin olun."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "İkinci dönel kavşağa doğru devam edin."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Bu dönel kavşağın sadece bir şeridi var, bu sebeple acele etmeyin ve dikkatli olun."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Elinizdeki alanın tamamını kullanın; burada kolayına kaçmak işleri daha da zorlaştıracaktır."

	key[]: "aca_msg_book3_3_11_cutscene8"
