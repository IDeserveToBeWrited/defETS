#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Bu senaryoda, kör noktada geri manevra yaparak dar bir alanda nasıl geri döneceğinize bakacağız. Bu beceri, U dönüşü yapamadığınızda veya şoför tarafına doğru geri geri giremediğinizde işe yarayacaktır."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Yol işaretleri eğitim pisti boyunca size yol gösterecektir."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Dorsenizin park hâlindeki çekicileri geçtiğinden emin olmak için geniş bir dönüş yapın."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Dönüşü bitirirken çekiciyi geri manevra için nasıl hazırlayacağınızı düşünün."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Çekiciyi, geri geri gireceğiniz yolcu tarafındaki boş park yerine doğru bir açıya getirmenize yardımcı olacaktır."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Fırsat oldukça kör noktaya doğru geri geri girmekten kaçınılmalıdır çünkü görüş sahası önemli ölçüde daha azdır. Maalesef, bunu yapmaktan başka seçeneğiniz olmadığı anlar vardır."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Geri geri gitmeden evvel direksiyon simidini çevirin. Bu, dorsenizin hemen istediğiniz yere yönelmesine yardımcı olur ki bu da dar alanlarda işe yarar."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Dorse iyice girdiğinde çekiciyi dorsenin önüne getirip toplayın."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Çekiciyi toplayıp tekrar ileri gidecek kadar yeriniz olduğunda durun. Geldiğiniz yoldan geri dönmeye başlayın."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Eğitim pistinden çıkana kadar yol işaretlerini takip edin."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Önünüzdeki virajı geçip belirtilen yere doğru devam edin."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Durdurma."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Çekiciyi emniyete alın ve motoru kapatın."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Önünüzdeki alanda bir nakliye şirketinin yerini temsil eden bir eğitim pisti var. Göreviniz oraya girmek ve çekiciyi geri dönmek üzere döndürmektir. Etrafınızdaki alanı iyi kullandığınızdan emin olun.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Eğitim pistine doğru devam edin.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Virajı dönün ve pistte seyretmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Pistin sonundaki bariyere kadar yol işaretlerini takip edin. Dorsenizi yolcu tarafındaki boş park yerine bakacak şekilde biraz açılı park edin.<br><br><font face=/font/big_bold.font>İleriye doğru devam edin.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Kör noktada olduğunuzda etrafınızda olup bitenleri iyi göremezsiniz. Yavaş gidin, aynalarınızı kullanın ve dikkatli olun.<br><br><font face=/font/big_bold.font>Geri geri gitmeye başlayın ve dorseyi boş park yerine doğru çevirin.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Bu mesafe yeterlidir. Artık ileriye doğru gidebilir ve geldiğiniz yönden çıkabilirsiniz.<br><br><font face=/font/big_bold.font>Çıkışa doğru ilerlemeye başlayın.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Eğitim pistinden çıkın.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Yol işaretlerini takip ederek son park yerine gidin.<br><br><font face=/font/big_bold.font>Belirtilen alana doğru devam edin.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

