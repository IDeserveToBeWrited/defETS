#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "Bu senaryoda, ilk defa bir dorseyi bağlamayı ve ayırmayı tecrübe edeceğiz. Çekiciyi hazırlayın, ardından arkanızdaki dorsenin altından geri geri girin."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Dorseyi bağlayın, sonra ileriye doğru sürün."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "İşaretli yerde durun."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Dorseyi ayırın, sonra ileri doğru sürün."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Park yerine park edin ve çekiciyi emniyete alın."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "Bu senaryoda, çekici ve dorseyi bağlama ve ayırma prosedürlerini ele alacağız. Bu, bir çekici şoförünün gerçek hayatta karşılaşacağına kıyasla basitleştirilmiş bir prosedürdür. <br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Çekicinin arkasında bir dorse var. Beşinci teker king pinine temas edene kadar dorsenin altından yavaşça geri gidin. Şu anda çekici doğru şekilde hizalanmış durumda, bu sebeple direksiyonu çevirmeye gerek yok, sadece düz geri gidin.<br><br><font face=/font/big_bold.font>Bağlantıyı hissedene kadar yavaşça geriye doğru gidin. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Beşinci teker king pinine bağlandı.<br><br><font face=/font/big_bold.font>El frenini çekerek çekiciyi emniyete alın. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Gerçek hayatta beşinci teker otomatik olarak king pinine kenetlenir, akabinde çekici şoförünün dorse ayaklarını toplamak, hava borusu ve elektrik hatlarını takmak için araçtan çıkması gerekir. <br><br><font face=/font/big_bold.font>Bizim için sadece @@imv_nrm_attach@@ tuşuna basmak dorseyi bağlayacaktır. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Artık çekici dorseye güvenli bir şekilde bağlandığına göre ilerlemeye hazırsınız. Aracınızın artık önemli ölçüde daha uzun ve ağır olduğunu ve sürmek için yeni beceriler gerektireceğini unutmayın. <br><br><font face=/font/big_bold.font>El freninizi indirin ve ileriye doğru sürmeye hazır olun. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "İleriye doğru sürün.<br><br><font face=/font/big_bold.font>İlerideki işaretli yerde durun. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>El frenini çekin. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>El frenini çekin. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Gerçek hayatta çekici şoförünün araçtan çıkması, dorse ayaklarını indirmesi, hava ve elektrik hatlarını sökmesi ve beşinci tekerin kilitleme mekanizmasını serbest bırakması gerekir. <br><br><font face=/font/big_bold.font>Bu işlemi sizin için kolaylaştırdık, @@imv_nrm_attach@@ tuşuna bastığınızda dorse ayrılacaktır. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>El freninizi indirin. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Çekiciyi dorsenin altından çıkarıp ileriye doğru hareket edin.<br><br><font face=/font/big_bold.font>İşaretli yerde durun. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>İşaretli yerde durun. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

