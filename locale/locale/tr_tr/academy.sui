#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Paralel Park Etmek"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Bu senaryoda, diğer iki çekicinin arasına paralel park etmeyi ele alacağız."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Park Yerinin Önünde Durmak"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Dikiz Aynasını Kontrol Etmek"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Park Yerine Geri Geri Girmek"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Çekicinin Park Yeri İçinde Hizalanması"
