#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Bu senaryoda, dorseyle sürüşe alışmanıza yardımcı olacak çeşitli farklı dönüşlerle karşılaşacaksınız. Odaklanın, hızınızı her duruma göre ayarlayın ve eğitim pistindeki mevcut alanı tamamen kullanın."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "İlk dönüş keskin bir dönüştür, tek seferde iki dönüş vardır. Sola dönüş için hazırlanmanız gerekecek, ancak manevranın ortasında sağa dönüşe geçmeniz gerekecek."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Bir sonraki dönüş sizi refüjün diğer tarafına geçirir. Zor değil ancak dorseniz için yeterli alan bıraktığınızdan emin olmanız gerekir."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Daha sonra beton bariyerlerin arasından keskin bir slalom yapmanız gerekecek. Yavaş gidin, aynalarınızı kullanın ve dorsenizin bariyerleri geçebileceği kadar geniş bir açıyla döndüğünüzden emin olun."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Bu noktada, her virajın ortasında fazladan konilerin bulunduğu başka bir slaloma gireceksiniz <br>Hiçbirine çarpmamaya dikkat edin!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Dönel kavşağa doğru giderken birkaç kolay viraj daha var."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Dönel kavşağa girmeye hazırlanmak için düzlüğü kullanın. Kavşağa girmeden önce dışta kalın."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Dönel kavşağa girin ve dorsenizin vaziyetini takip edin. Kavşağa girdiğinizde farklı bir yol izleyecektir."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Kavşaktan çıkın ve bir sonraki dönüşe doğru devam edin."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "BU ARA SAHNEYİ SİL"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Buradaki dönüş son derece keskin. Yavaş gidin ve etrafınızdaki alanı akıllıca kullanın. Dorsenizin kuyruk salınımına da dikkat edin."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Sonraki birkaç virajı geçerken virajdan çıktığınızda kendinizi bir sonraki viraja hazırlamayı unutmayın."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Son virajı aceleyle almayın. Kolay görünüyor, ancak göründüğünden daha az manevra alanı var."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Belirtilen yerde durun, çekiciyi emniyete alın ve motoru kapatın."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>İlk dönüşe doğru hızlanın. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "İlk dönüş kolay bir keskin dönüştür.<br><br><font face=/font/big_bold.font>Dönüşü gerçekleştirin. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "BU KONTROLÜ SİL"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Pist önününüzde refüjün solundan devam ediyor.<br><br><font face=/font/big_bold.font>Aralıktan devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Bariyerleri geçerken dorsenize dikkat etmeyi unutmayın.<br><br><font face=/font/big_bold.font>Slalom yaparak devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Bu slalom daha basittir, ancak trafik konileri onu önemli ölçüde daha keskin hâle getirir.<br><br><font face=/font/big_bold.font>Slalom yaparak devam edin ve herhangi bir koniye çarpmamaya çalışın.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Önünüzde birkaç kolay viraj var, yine de dorsenizi iç bariyerlerden uzak tutmak için doğru şekilde hizalanmanız gerekecek.<br><br><font face=/font/big_bold.font>Dönüşleri gerçekleştirin.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Bir dönel kavşağa yaklaşıyorsunuz. Sadece girerken ve çıkarken değil, aynı zamanda geçerken de dorseniz için yeterli alan bırakmayı unutmayın.<br><br><font face=/font/big_bold.font>Dönel kavşaktan geçin.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Önünüzde kısa bir düzlük var, arzu ederseniz biraz hızlanabilirsiniz.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Buradaki dönüş son derece keskindir. Yavaş gidin, elinizdeki bütün alanı kullanın ve dorsenizin kuyruk salınımını aklınızda bulundurun. <br><br><font face=/font/big_bold.font>Keskin dönüşten geçin.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Son birkaç dönüş kolaydır. Dorsenizi unutmayın.<br><br><font face=/font/big_bold.font>Devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Son park yerine doğru devam edin. </font>"
