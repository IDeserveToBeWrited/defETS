	key[]: "aca_goal_book1_2_01_end"
	val[]: "Aracı Emniyete Almak"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "Bu senaryoda, çekiciyi trafik konilerinden oluşan bir slalomda kısa bir sürüşe çıkaracağız."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Dikkatli sürün ve etrafınızdan haberiniz olsun. Çekicinin her iki tarafını da takip edin ve pistteki seyrinize yardımcı olması için aynaları kullanmayı unutmayın."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "Pist sonlara doğru daha daraldığı için hassasiyet çok önemlidir."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Belirtilen yere park edin ve çekiciyi emniyete alın."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "Bu senaryoyu tamamlamak için hiçbirine çarpmadan bütün konilerin etrafından dolaşmalısınız. <br><br><font face=/font/big_bold.font>Onaylamak için @@imv_nrm_activate@@ tuşuna basın. </font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Çekicinin her iki tarafını da görebilmeniz için aynalarınızı kullanın.<br><br>Yolcu tarafında ise ön ve yan aynalar yön bulmada oldukça yardımcı olabilir.<br><br><font face=/font/big_bold.font>Onaylamak için @@imv_nrm_activate@@ tuşuna basın.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Gerekirse aynalarınızı '@@adjust_link_t@@' (duraklatma menüsü vasıtasıyla ulaşabilirsiniz) kısmında ayarlayın.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "Çekici hâlâ hareket etmeye hazır değil, belki bir şeyi unuttunuz.<br><br>Motor çalışıyor mu? El frenini indirdiniz mi?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Yavaşça ilerleyin ve slalom yapın. </font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Konilerin etrafından dolaşmaya devam edin. Yolcu tarafına özellikle dikkat edin.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Slalomda konilere çarpmadan zikzaklar çizerek ilerlemeye devam edin. </font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Belirtilen yerde durun. </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Çekiciyi emniyete alın ve motoru kapatın. </font>"
#@}

