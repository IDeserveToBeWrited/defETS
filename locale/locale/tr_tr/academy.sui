#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Bu senaryoda, yeni edindiğiniz becerilerinizle çekiciyi nasıl kullandığınız görmek için kısa bir sürüş yapacağız."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Pistte çeşitli tipte ve kombinasyonda dönüşler vardır. Bu bir yarış değil ve zamanla ilgili de değil. Sabırlı olun ve sürüş hızınızı karşılaştığınız dönüşlere ve engellere göre ayarlayın."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Başlangıçta pist yumuşak ve kolaydır, ancak ilerledikçe dönüşler daha karmaşık hale gelecektir."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Hızınıza dikkat edin; çok hızlı hareket edip dönüşü yanlış değerlendirmek kolaydır."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Pistten çıkış çok keskin bir virajdır. Yavaş gidin ve size sunulan tüm alanı kullanın."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Bariyerlerin arasına park edin ve çekiciyi emniyete alın."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Bu senaryoyu başarıyla tamamlamak için kaza yapmamalı, pistten çıkmamalı veya trafik konilerine çarpmamalısınız.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Piste girmek için keskin sağ viraja doğru ilerleyin. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Virajı iyi ve sabit bir hızla geçin. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Daha dolambaçlı bir viraj bölümüne yaklaşıyorsunuz.<br><br><font face=/font/big_bold.font>Hızınızı ayarlayın ve devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Bir sonraki viraj setine doğru devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Kolay, yumuşak virajlar var. Hızınızı sabit tutun.<br><br><font face=/font/big_bold.font>Sürmeye devam edin. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Pistin çıkışı keskin bir virajdır. Yavaşlayın ve dönüşten önce dışarıda kalın. Aynalarınızı kullandığınızdan emin olun!<br><br><font face=/font/big_bold.font>Pistten çıkın. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Önünüzde bariyerlerin arasında bir park yeri var.<br><br><font face=/font/big_bold.font>Park yerine doğru ilerleyin. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
