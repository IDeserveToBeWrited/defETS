#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Geri Manevra Alanı"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Bu senaryoda, çift dorseyle geri manevra yapma alıştırması için boş bir otoparka yerleştirileceksiniz."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Başlangıç"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Deneme"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Halletmek"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Senaryoyu Sonlandırmak"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Çift dorseyle geri manevra yapmak, tek dorseyle yapılan manevraya göre çok daha fazla dikkat gerektirir. Arka dorsenin nereye gideceğini önceden planlamanız, aynı zamanda ön dorseyi ve kabini de kontrol altında tutmanız gerekir. <br><br>Şöyle düşünün: Arka dorseyi yönlendirmek için ön dorseyikullanmalısınız."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Bu durumda, arka dorseyi şoför tarafına çevirmek istiyoruz. Bunu yapmak için, arka dorsenin ön kısmını yolcu tarafına doğru getirmemiz gerekiyor. <br><br>Dikkat edin, bu esasen, arka dorseyi çevirmek istediğiniz yönün aksine ön dorseyi çevirmeniz gerektiği anlamına gelir."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Arka dorse dönmeye başladığında, öndeki dorseyle çekiciyi düzeltmek çok önemlidir. Çoğu insan ilk hatasını burada yapar."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Burada şoförün talimatlara uymadığını ve dorselerinin katlanmasına (jack-knifing) neden olmak üzere olduğunu görüyoruz."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "İki araç arasındaki açı yaklaşık 90 dereceye ulaştığında katlanma (jack-knifing) meydana gelir. Bu gerçekleştiğinde, kurtarma şansı yoktur. İleri doğru hareket edip tekrar denemeniz gerekir. <br><br>Tek bir dorseyi geri geri sürerken olduğu gibi, maksat her zaman dorselerin tüm tekerleklerinin hareket halinde olmasını sağlamaktır. Bir tekerlek durursa ve dorse yerinde dönmeye başlarsa devam edemezsiniz."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "En son doğru yaptığınız yere, yani aynı hataya tekrar düşmeden geriye doğru gitmeye devam edebileceğiniz bir konuma doğru ilerleyebilirsiniz. <br><br>Bu durumda, düz bir konuma doğru ilerleyip baştan tekrar deneyeceğiz."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Aynı şekilde, arka dorse dönmeye başlar başlamaz, çekiciyi öndeki dorsenin önüne geçirin ve arka dorsenin bir anlığına kendi kendine dönmesine müsaade edin."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Arka dorse istediğimiz yöne doğru dönmeye başladığına göre, şimdi ön dorseyi de onu takip edecek şekilde yönlendirme zamanı. Dönüşü kontrol etmek ve daha keskin veya daha geniş hale getirmek için ön ve arka dorse arasındaki açıyı ayarlayabilirsiniz."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Manevranın son safhası her şeyi düz hâle getirmektir. Ön dorseyi arka dorseyle hizalayın."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Öndeki dorseyi hareket ettirmenin ne kadar süreceğini aklınızda bulundurmalısınız; çok uzun süre beklerseniz arkadaki dorse geldiğiniz yere dönmeye çalışacaktır!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Burada dilediğiniz kadar zaman geçirebilir, dorseleri geri geri nasıl hareket ettireceğinize dair kabaca bir fikir edinene kadar farklı manevralar deneyebilirsiniz. <br><br>Ancak en önemlisi, eğlenmeyi unutmayın!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Yola çıkmaya hazır olun."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Bu otoparkı, dorseleri geri geri sürme konusunda fikir edinmek için kullanın. <br><br>@@aca_goal_tip@@ Genel olarak dorseleri geri geri sürme konusunda yeni misiniz? Çekici Şoförlüğünün Temelleri bölümünü oynamayı düşünebilirsiniz."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "İstediğiniz kadar alıştırma yapın. <br><br>İçinize sindiğinde, durup çekiciyi emniyete alarak senaryoyu sonlandırabilirsiniz."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Senaryoyu sonlandırmak için motoru kapatın."
#@}


