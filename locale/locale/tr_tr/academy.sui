#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Önümüzde çeşitli karmaşık virajlar ve engeller var.<br>Şimdiye kadar öğrendiklerinizi göz önünde bulundurduğunuzda çok da zor olmayacağını göreceksiniz."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Yol işaretleri, her bir engel setini nasıl aşacağınıza dair size fikir verebilir."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Çekiciyi virajın dış tarafında tutun. <br>Dorse daha kısa bir yol izleyeceği için genişçe girmeniz gerekecek."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Bir sonraki viraj 90 derecelik kolay bir dönüş. <br> Çekiciyi bir kez daha virajın dışında tutun ve elinizdeki bütün alanı kullanın."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Acele etmeyin. Pist açılıyor, ancak yine de dikkatli olmanız gerekecek."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Bariyerlerin etrafında geniş bir mesafe bırakın."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Bu dar bölüme girerken dikkatli olun. <br>Girmeden önce çekiciyi iyice genişe alın ve dorsenizi hazırlayın."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Son 90 derecelik dönüş ilkinden çok daha keskin, ancak alanı akıllıca kullanırsanız bolca yeriniz var."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Belirtilen yerde durun, çekiciyi emniyete alın ve motoru kapatın."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Pistte seyretmenize yardımcı olması için yol işaretlerini kullanmayı unutmayın.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Aynalarınızı kullanmak pistte güvenli bir şekilde seyretmenize de yardımcı olacaktır. Dorsenin arkanızda nasıl hareket ettiğinden her zaman haberdar olmalısınız.<br><br><font face=/font/big_bold.font>İlk virajdan geçin.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Virajdan çıkarken dorseyi takip edin ve bir sonraki viraja girmeye hazırlanın.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Bir sonraki viraja ilerleyin.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Çekiciyi döndürmeden önce etrafınızdaki engellerden uzak olduğunuzdan emin olmak için dorsenizi takip etmeyi unutmayın.<br><br><font face=/font/big_bold.font>Öndeki bariyerin etrafından devam edin.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Dorseniz bariyerden kurtulduğunda, dar geçide doğru kendinizi hizalamak için yolcu tarafına doğru sertçe dönün. <br><br><font face=/font/big_bold.font>Dar geçide doğru ilerleyin.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Bu bölüm çok hassas sürüş gerektirecektir. Acele etmeyin ve aynalarınızı kullanın.<br><br><font face=/font/big_bold.font>Her virajın dışına doğru ilerleyin.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Bu dönüş çok keskin, ancak önünüzdeki tüm alanı kullanarak kolayca halledebilirsiniz.<br><br><font face=/font/big_bold.font>Son dönüşü yapın.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

