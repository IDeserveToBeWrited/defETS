	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Bunun gibi çapraz park yerleri çok yaygındır. Bilhassa Avrupa otoyollarında bulunan birçok dinlenme tesisinde yaygındır. <br>Bir kez daha önümüzdeki park yerine 'burnumuzu sokmamız' gerekecek."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Sıranın sonundaki belirtilen park yerine doğru sürün."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Şeridin ortasına doğru veya hafifçe şoför tarafına doğru devam edin. Bariyerlere çok yakın sürmeyin, aksi takdirde dorsenin arkası dönüş esnasında bariyerlere çarpabilir."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Park yerinin epeyce yanından geçin ve sonra sert ve hızlı bir şekilde içeriye doğru dönün. Dorsenizin önünün yanınızdaki dorseye çarpmaması için şoför tarafı aynasına ve dorsenizin park yerine emniyetli bir şekilde girdiğini görmek için de yolcu tarafı aynasına bakmanız gerekecek."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Belirtilen yerde durun, çekiciyi emniyete alın ve motoru kapatın."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Çapraz park ederken konumunuzu doğru bir şekilde değerlendirmek önemlidir. Dönüşün ortasına geldiğinizde, geri gitmek ve güvenli bir şekilde yeniden konum almak zordur, bu sebeple ilk denemede yeterli alanınız olduğundan emin olmak idealdir.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazırlanın.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Park yerine doğru sürmeye başlayın. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Park yerini geçin, böylece dorseniz iç tarafta çekicinin etrafında dönebilecek kadar alana sahip olsun.<br><br><font face=/font/big_bold.font>Park yerine dönün.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Kör Noktadan Geri Geri Gitmek"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Bu senaryoda, çekiciyi park yerine kör noktadan geri geri sokmaya bakacağız. Pencereden dışarı bakmadan, gitmeniz gereken yere ulaşmak için yalnızca aynalarınıza güvenmek zorunda kalacaksınız."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
