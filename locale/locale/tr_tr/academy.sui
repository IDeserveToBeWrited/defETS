#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Bu sürüşte düz bir çizgide geri gideceğiz. Kesik çizgiyi geçip orada durmanız gerekecek."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Çekiciyle geri giderken sürekli etrafınıza bakmanız, bütün aynaları kontrol etmeniz, etrafınızda ve arkanızda boş alan olmasına dikkat etmeniz çok önemlidir."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Motoru çalıştırın, geri vitese takın ve hareket etmeye başlayın."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Kesik çizgiyi geçin, durun, motoru kapatın ve çekiciyi emniyete alın."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Önceki senaryoda öğrendiğiniz gibi çekiciyi hazırlayın.<br><br><font face=/font/big_bold.font>Hazır olduğunuzda motoru çalıştırın. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Etrafınızdaki alanın açık olduğundan emin olmak için aynalarınızı kontrol edin. Eğer pozisyonlarından memnun değilseniz '@@adjust_link_t@@' kısmında ayarlayabilirsiniz.<br><br><font face=/font/big_bold.font>Yolcu tarafındaki aynaya bakın.</font>@@aca_goal_tip@@ Aracın içinde olmanız gerekir."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Kesik çizgiyi geçeceksiniz. Şerit artık boş, ancak normal sürüş esnasında etrafa bakarak ve aynaları kullanarak çevrenizi sürekli olarak takip etmek önemlidir.<br><br><font face=/font/big_bold.font>Şoför tarafındaki aynayı kontrol edin.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>$input backward$ ile geri vitese geçin. </font>@@aca_goal_tip@@ Geri giderken çoğu çekicide geri vites ikazı otomatik olarak çalışır. Bunu Seçenekler Ekranı - 'Ses' - @@sound_of_reverse@@ seçeneğinden kapatabilirsiniz."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Geri vitese geçmek için @@imv_nrm_geardown@@ tuşuna basın. </font>@@aca_goal_tip@@ Geri giderken çoğu çekicide geri vites ikazı otomatik olarak çalışır. Bunu Seçenekler Ekranı - 'Ses' - @@sound_of_reverse@@ seçeneğinden kapatabilirsiniz."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Geri vitese geçmek için @@imv_nrm_geardown@@ tuşuna basın. </font>@@aca_goal_tip@@ Geri giderken çoğu çekicide geri vites ikazı otomatik olarak çalışır. Bunu Seçenekler Ekranı - 'Ses' - @@sound_of_reverse@@ seçeneğinden kapatabilirsiniz."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Debriyaj pedalına sonuna kadar basın ve vites kolunu geri vitese takın. </font>@@aca_goal_tip@@ Geri giderken çoğu çekicide geri vites ikazı otomatik olarak çalışır. Bunu Seçenekler Ekranı - 'Ses' - @@sound_of_reverse@@ seçeneğinden kapatabilirsiniz."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Artık geri vitese geçtiniz.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ ile el frenini indirin. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "$input backward$ ile hareket etmeye başlayın.<br><br><font face=/font/big_bold.font>Kesik çizgiyi geçin. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Gaz pedalını kullanarak hareket etmeye başlayın: $input forward$.<br><br><font face=/font/big_bold.font>Kesik çizgiyi geçin. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Gaz pedalını kullanarak hareket etmeye başlayın: $input forward$.<br><br><font face=/font/big_bold.font>Kesik çizgiyi geçin. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Gaz pedalını kullanarak motorun devrini korurken ayağınızı debriyajdan yavaş yavaş çekin. <br><br><font face=/font/big_bold.font>Kesik çizgiyi geçin. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Servis (ayak) freni ile çekiciyi durdurun: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Servis (ayak) freni ile çekiciyi durdurun: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Servis (ayak) freni ile çekiciyi durdurun: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Debriyaja sonuna kadar basın ve ardından servis frenlerinizi kullanarak çekiciyi durdurun. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@ ile el frenini devreye sokun. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Basitleştirilmiş otomatik şanzıman sayesinde vites değiştirmenize gerek kalmaz, zira gerçek hayattakinin aksine her şey sizin için otomatik olarak yapılır.<br><br><font face=/font/big_bold.font>Onaylamak için @@imv_nrm_activate@@ tuşuna basın. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_gearup@@ tuşuna basarak vitesi boşa alın.</font>@@aca_goal_tip@@ Modern çekiciler el freni indirildiğinde otomatik olarak boşa geçer. Ancak bunu her zaman sizin yapmanız iyi bir alışkanlıktır. Takip eden senaryolarda bu adım gerekmeyecektir."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_gearup@@ tuşuna basarak vitesi boşa alın.</font>@@aca_goal_tip@@  Modern çekiciler el freni indirildiğinde otomatik olarak boşa geçer. Ancak bunu her zaman sizin yapmanız iyi bir alışkanlıktır. Takip eden senaryolarda bu adım gerekmeyecektir."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Vites kolunu boşa alın, ardından ayağınızı debriyajdan çekin.</font>@@aca_goal_tip@@  Modern çekiciler el freni indirildiğinde otomatik olarak boşa geçer. Ancak bunu her zaman sizin yapmanız iyi bir alışkanlıktır. Takip eden senaryolarda bu adım gerekmeyecektir."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Bilhassa trafiğin çok olduğu işlek bölgelerde, geri giderken her zaman etrafınıza bakmayı unutmayın.<br><br><font face=/font/big_bold.font>$input engineelect$ tuşuna basarak motoru kapatın.</font>"
