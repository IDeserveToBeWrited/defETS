#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "@@driving_academy@@'sine tekrar hoş geldiniz!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Takip eden senaryolar, profesyonel çekici şoförlüğü yolculuğunuzdaki bir sonraki adımı temsil etmektedir."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Bu sefer her görevde size rehberlik etmeyeceğiz, dolayısıyla becerilerinizi ve tecrübenizi kullanmak sizin kararınızdır."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Bazı tanıdık manevralarla karşılaşabilirsiniz, ancak bu kez gerçek dünya senaryolarına daha çok benzeyen yeni ortamlar vardır."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "@@driving_academy@@ için yeni olan şey \"Geçme\" ve \"İkramiye\" şartlarının eklenmesidir."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Daha önce olduğu gibi yine her senaryoyu hiçbir şeye çarpmadan, başarılı bir şekilde park ederek ve çekiciyi emniyete alarak tamamlamalısınız..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...ama şimdi bunu da belirlenen zaman sınırı içinde ve ileri ve geri sürüş arasındaki istikamet değiştirme sayısında bir sınırlamayla yapmalısınız."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Her senaryoyu daha da zorlu şartlarla tamamlayarak ikramiye şartlarını karşılayabilirsiniz..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...mesela daha sıkı zaman sınırlamaları, daha az istikamet değişikliği ve yalnızca iç mekân kamerasının kullanılması gibi."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Bütün senaryoları tamamlayarak kendinizi ehil görebilir ve bir sonraki mücadeleye hazır hâle gelebilirsiniz.<br><br>Kendinizi daha fazla zorlamak için her senaryodaki bütün ikramiye şartlarını tamamlayın. İşte o zaman gerçek bir çekici şoförü olacaksınız!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Eğitim"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Bu eğitim senaryosunda, Çekici Şoförlüğünün Ustalığında bulunan yeni özelliklere aşina olmanıza yardımcı olacağız."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Her senaryonun başında bir <color value=@@clr_sel@@>\"Senaryo Bilgilendirmesi\"<color value=@@clr_txt@@> göreceksiniz. Bu size senaryonun yeni geçme ve ikramiye şartları hakkında bilgi verecektir. <br><br>Senaryoyu başarıyla tamamlamak için geçme şartlarının karşılanması gerekirken, ikramiye şartları tecrübeli ve becerikli oyuncular için isteğe bağlı bir ilave zorluktur. <br><br><font face=/font/big_bold.font>Devam etmek için kontağı açın.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "İkramiye şartlarından biri, <color value=@@clr_sel@@>İç Mekân Kamerasını<color value=@@clr_txt@@> kullanırken senaryoyu tamamlamanızı gerektirir. Etrafınızı kontrol etmek için haricî kameraları yalnızca çekici dururken kullanmaya devam edebilirsiniz.<br><br>Şimdi yönünüzü bulmak için etrafınıza bakabilir, akabinde iç mekân kamerasına geri dönebilirsiniz.<br><br><font face=/font/big_bold.font>Etrafınızı kontrol etmek için takip kamerasına geçin</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Yönünüzü bulun, akabinde iç mekân kamerasına geri dönün.<br><br><font face=/font/big_bold.font>Çekicinin etrafına bakın</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>İç mekân kamerasına dönün</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Süre<color value=@@clr_txt@@>, Çekici Şoförlüğünün Ustalığında bir etmendir. Bütün senaryolar geçme şartı olarak ayrı bir süre kısıtlamasına sahip olacak ve birçoğunun ikramiye şartı olarak daha katı bir kısıtlaması olacak.<br><br>Kronometre yalnızca çekici hareket ettikten sonra başlar.<br><br><font face=/font/big_bold.font>Devam etmek için motoru çalıştırın ve el frenini indirin.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Çekici Şoförlüğünün Ustalığındaki bir diğer yeni ilave ara noktalardır. Bir senaryoyu tamamlamadan önce bütün ara noktalara ulaşmalısınız. <br><br>Ayrıca, ara noktalarda hangi istikamete baktığınız mühimdir, bu nedenle kendinizi doğru şekilde yönlendirmek için yakındaki yer işaretlerine dikkat edin.<br><br><font face=/font/big_bold.font>Önünüzdeki ara noktaya doğru sürün.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Ara noktaya ulaştınız ve şimdi bir sonraki adıma geçebilirsiniz. <br><br>Arkanızda geri geri gitmeniz gereken başka bir ara nokta daha var. Ara noktaya ulaştığınızda çekicinin hangi istikamete bakması gerektiğini gösteren yerdeki oka dikkat edin. <br><br>Dikkat edilmesi gereken bir diğer geçme ve ikramiye şartı <color value=@@clr_sel@@>İstikamet Değişiklikleri<color value=@@clr_txt@@>dir. İleri ve geri sürüş arasında kaç defa istikamet değiştirdiğinizi sayarız. Şartı tamamlamak için sınırı aşmayın.<br><br><font face=/font/big_bold.font>Ara noktaya geri geri gidin ve durun.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Yani şimdiye kadar bir defa istikamet değiştirmiş olmalısınız. <br><br>Bir sonraki adıma geçmek için arkanızdaki dorseyi alın. <br><br><font face=/font/big_bold.font>Bağlamak için dorsenin altına geri geri girin.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Son park yeri sağınızdadır. Bazı senaryolarda yalnızca bir park yeri olabilirken, bazılarında seçebileceğiniz birden fazla yer olacaktır. Bu yerlerden herhangi birine doğru bir şekilde park etmek senaryoyu tamamlamanızı sağlayacaktır. <br><br><font face=/font/big_bold.font>Dorseyi bağlamak için @@imv_nrm_attach@@ tuşuna basın. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Park yerleri çekicinin hangi istikamete bakması gerektiğini de gösterir. Yanlış istikamete park ederseniz düzeltene kadar senaryoyu tamamlayamazsınız, bu da süre ve istikamet değişikliğine mal olur.<br><br><font face=/font/big_bold.font>Park yerlerinden birine gidin ve doğru bir şekilde park edin.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Çekici Şoförlüğünün Ustalığı"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Artık geçme şartları ve ikramiye hedefleri için yeni parametrelere aşinasınız ve Çekici Şoförlüğünün Ustalığındaki yeni senaryolarla baş etmeye hazırsınız!<br><br><font face=/font/big_bold.font>Senaryoyu tamamlamak için el frenini çekerek ve motoru durdurarak çekiciyi emniyete alın.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Kestirme"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "Bu senaryoda, maalesef sonu kapalı bir kestirmeyi kullanmayı deneyeceksiniz. Daha sonra geldiğiniz yoldan geri dönmelisiniz."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Tepedeki ara noktaya kadar sürün ve sonra aynı yoldan geri geri inin. <br><br>Yola geri döndüğünüzde son park yerine kadar sürün."



