#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Dorseyle paralel park etmek bütün şoförler için önemli bir beceridir.<br>İster büyük bir şehirde sokakta park etmek olsun ister kırsalda bir dinlenme tesisinde durmak olsun, her şoförün bilmesi gereken bir şeydir."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Park yerinden geçerken çekici ve dorsenin sığacağı kadar yer olduğundan emin olmak için dikkatlice bakın. Hâlihazırda bolca yeriniz olduğundan eminiz."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Park yerinin önündeki çekiciye kendinizi hizalayın. Çok yakın durmayın, biraz mesafe bırakın ki manevra alanınız olsun."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Park yerinden keskin bir şekilde dönün ve geri gitmeye başlayın. Maksadımız dorseyi hemen park yerine döndürmektir."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Dorse iyice döndüğünde sokmaya başlayabilirsiniz."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Şoför tarafındaki dorse tekerlekleri girmeden evvel dorseyi kaldırım kenarından uzaklaştırmaya başlayın."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Çekiciyi dorseyle aynı hizaya getirip park yerinin ortasına geçin.<br>Park edin, motoru kapatın ve çekiciyi emniyete alın."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Önünüzde diğer çekicilerin arasında park yerinizi görebilirsiniz. Park ederken aynalarınızı kontrol ettiğinizden ve çekici ile etrafınızdaki engeller arasında güvenli bir mesafe bıraktığınızdan emin olun.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Park yerinizi bulmak için otoparkta dolaşın.<br><br><font face=/font/big_bold.font>İleriye doğru sürün.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Arzu ettiğiniz park yerini geçip işaretli yere girin. Geri manevranıza başlayabilirsiniz.<br><br><font face=/font/big_bold.font>İşaretli yerde durun.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Dorseyi çevirmek için çekiciyi park yerinden uzaklaştırın. Çok keskin bir şekilde dönmeyin, yoksa kaldırıma çıkarsınız. <br><br><font face=/font/big_bold.font>Geri geri gitmeye başlayın. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Dorseyi park yeriyle aynı hizaya getirin. İcap ederse ileri veya geri manevralar yapabilirsiniz.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Hayırlı olsun, Çekici Şoförlüğünün Temelleri sınavlarını geçtiniz ve çekiciyle manevra yapmak için gereken bütün becerileri kazandınız."

	key[]: "aca_msg_book1_outro02"
	val[]: "Bu, usta bir çekici şoförü olma hayalinizi gerçekleştirme yolculuğunuzdaki ilk adımdır."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Artık Avrupa yollarına çıkmaya ve ilk zorluklarınızla yüzleşmeye hazırsınız..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...ama macera daha yeni başlıyor."
#@}


