	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Dar Bir Yerde Geri Geri Park Etmek"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Bu senaryoda, dorseyi işlek bir otoparktaki park yerine geri geri sokma görevini üstleneceksiniz."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Dorseyi Döndürmek"
