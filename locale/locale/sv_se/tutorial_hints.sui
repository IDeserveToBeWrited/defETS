
    key[]: "hint_engine_title"
	val[]: "Starta motorn"

    key[]: "hint_engine_text"
	val[]: "Använd $KEY_engine$ för att starta motorn."


    key[]: "hint_ignition_title"
	val[]: "Starta tändningen"

    key[]: "hint_ignition_text"
	val[]: "Använd $KEY_engineelect|KEY_engine$ för att starta tändningen."


    key[]: "hint_driv_arc_title"
	val[]: "Köra"

    key[]: "hint_driv_arc_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra."


    key[]: "hint_driv_auto_title"
	val[]: "Köra"

    key[]: "hint_driv_auto_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra.<br><offset vshift=8>Tryck $KEY_gearup$ och $KEY_geardown$ för val av växel."


    key[]: "hint_driv_seq_title"
	val[]: "Köra"

    key[]: "hint_driv_seq_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra.<br><offset vshift=8>Tryck $KEY_gearup$ och $KEY_geardown$ för att styra kopplingen."


    key[]: "hint_driv_hshift_title"
	val[]: "Köra"

    key[]: "hint_driv_hshift_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra.<br><offset vshift=8>Byt växel med <color value=@@clr_sel@@>växelspaken<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Kör mot destinationen"

    key[]: "hint_depot_deliv_text"
    val[]: "Stanna i det markerade området och välj svårighetsgrad för slutgiltig parkeringsplats och tjäna erfarenhetspoäng."


    key[]: "hint_fin_deliv_title"
    val[]: "Slutför leveransen"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkera på vald parkeringsplats. Du kan trycka $KEY_activate$ för att hoppa över när du är nära leveransplatsen."


    key[]: "hint_fin_deliv2_title"
    val[]: "Slutför leveransen"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkera på vald parkeringsplats. Du kan aktivera en widget i @@desktop_menu_category_options@@ för att tillåta att hoppa över att parkera."


    key[]: "hint_lights_title"
    val[]: "Slå på belysningen"

    key[]: "hint_lights_text"
    val[]: "Använd $KEY_light$ för slå på belysningen. Stega igenom olika lägen genom att trycka flera gånger."


    key[]: "hint_high_beam_title"
    val[]: "Slå på helljuset"

    key[]: "hint_high_beam_text"
    val[]: "Använd $KEY_hblight$ för att slå på helljuset."


    key[]: "hint_wipers_title"
    val[]: "Slå på vindrutetorkarna"

    key[]: "hint_wipers_text"
    val[]: "Använd $KEY_wipers$ för att slå på vindrutekorkarna och stega genom olika hastigheter."


    key[]: "hint_zoom_title"
    val[]: "Titta närmare"

    key[]: "hint_zoom_text"
    val[]: "Använd $KEY_camzoom$ för att zooma medans du är i ett fordon. Du kan sätta zoom-läge till håll inne eller växla i @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Se dig omkring"

    key[]: "hint_cam_int_text"
    val[]: "Use $KEY_cam1$ to change the camera to interior view."


    key[]: "hint_cam_ext_title"
    val[]: "Se dig omkring"

    key[]: "hint_cam_ext_text"
    val[]: "You can cycle through different camera angles by pressing $KEY_camcycle$.<br><offset vshift=8>Use $KEY_cam2$ to switch the camera to exterior view."


    key[]: "hint_indicators_title"
    val[]: "Blinkers"

    key[]: "hint_indicators_text"
    val[]: "Använd $KEY_lblinker$ och $KEY_rblinker$ för att slå på blinkers."


    key[]: "hint_tow_title"
    val[]: "Bärgningstjänst"

    key[]: "hint_tow_text"
    val[]: "Om du inte lyckas ta dig ur en besvärlig situation så kan du använda bärgningstjänsten. För att komma åt den, öppna @@quick_info_word@@ menyn med hjälp av $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Differential lock"

    key[]: "hint_diff_lock_text"
    val[]: "If you cannot start moving, maybe differential lock could help you. Use $KEY_diflock$ to activate it or turn on automatic differential lock in @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Differential lock engaged"

    key[]: "hint_diff_unlock_text"
    val[]: "You should unlock differential during regular driving or you risk its damage. Use $KEY_diflock$ to deactivate it or turn on automatic differential lock in @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Stäng av vindrutetorkarna"

    key[]: "hint_wipers_off_text"
    val[]: "Använd $KEY_wipers$ för att stänga av vindrutetorkarna och stega genom olika hastigheter."


    key[]: "hint_world_map_title"
    val[]: "Kartvy"

    key[]: "hint_world_map_text"
    val[]: "Använd $KEY_navmap$ för att öppna världskartan."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Use $KEY_advmouse$ to open @@quick_info_word@@ - overview of your status with convenient shortcuts."


    key[]: "hint_pause_border_title"
    val[]: "Lokala regler och föreskrifter"

    key[]: "hint_pause_border_text"
    val[]: "Använd $KEY_advmouse$ för att öppna @@quick_info_word@@ och se nuvarande regler och föreskrifter för regionen du har ankommit till."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Open @@quick_info_word@@ using $KEY_advmouse$ to enter @@photo_mode_word@@ and capture nearby @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ i närheten"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> är i närheten - hitta den och aktivera för att visa filmsekvensen."


    key[]: "hint_resting_title"
    val[]: "Rastplats i närheten"

    key[]: "hint_resting_text"
    val[]: "Rastplatser <img src=/material/ui/map/parking_ico.mat width=20 height=20> hjälper dig att återhämta dig från utmattning och säkert fortsätta din resa."


    key[]: "hint_gas_title"
