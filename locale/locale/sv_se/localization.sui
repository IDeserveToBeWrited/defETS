	key[]: "eye_extended_view"
	val[]: "Använde Utökad Vy" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Använd autocentrering" #+ Headtracking autocentring

	key[]: "eye_head_mode"
