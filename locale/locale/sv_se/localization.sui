#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Väljer kontrollersubtyp så att spelet hanterar inmatningsområden korrekt."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Välj växellådstyp:<br>- \"Enkel automatisk\" tillåter användning av gaspedal och broms för att styra rörelser framåt och bakåt.<br>- \"Riktig automatisk\" kräver en ingång för att växla mellan framåt- och backväxlar.<br>- \"Sekventiell\" kräver manuell växling av alla växlar med ingångar för upp-/nerväxling.<br>- \"H-Shifter\" kräver användning av en kontroller med växelreglage för att välja växlar manuellt."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Ändrar automatlådans växelsätt:<br>- \"Ekonomi\" läget växlar under låga varvtal i höjd med högst vridmoment.<br>- \"Kraft\" läget växlar vid högsta hästkrafter för bättre köregenskaper med tunglast eller backig terräng på bekostnad av bränsleekonomi."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Justera förhållandet mellan enhetens rotationsgrad och fordonets faktiska rattutslag."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Justerar linjäriteten mellan inmatning och fordonets styrning.<br><br>Ett högre värde gör styrningen mindre känslig när ratten är i mitten, och känsligheten ökar när ratten vrids mot fullt rattutslag. Detta kan vara användbart för att jämna ut styrningen vid rak körning."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Aktiverar kraftåterkoppling i handkontroller som stöder det."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Justerar den övergripande förstärkningen för alla kraftåterkopplingsinställningar mellan 0N och 10N.<br><br><color value=@@clr_txt_d@@>Var medveten om att en högre inställning på kraftfulla rattbaser kan orsaka skador på fingrar eller händer."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Justerar centreringskraften när du kör i hög hastighet, vilken når sitt maximum vid 90 km/h (56 mph) och däröver.<br><br>Den lägsta inställningen innebär att ingen centreringskraft appliceras på ratten."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Justerar centreringskraften när du kör i låg hastighet.<br><br>Den lägsta inställningen innebär att ingen centreringskraft appliceras på ratten."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the strength of artificial internal friction caused by mechanical steering components."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Justerar styrkan på artificiell motorresonans genom rattstången.<br><br><color value=@@clr_txt_d@@>Var medveten om att om detta värde ställs in över 15 % kan det orsaka kraftigt skakande och vibrationer i vissa rattar."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Justerar styrkan på resonans från vägen genom rattstången.<br><br><color value=@@clr_txt_d@@>Var medveten om att om detta värde ställs in över 20 % kan det orsaka kraftigt skakande och vibrationer i vissa rattar vid terrängkörning i hög hastighet."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Justerar styrkan av vägbulors känsla genom rattstången."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Justerar styrkan av kollisioner känsla genom rattstången."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Justerar intensiteten på växellådans skrapljudseffekter."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Justerar intensiteten för understyrningseffekt."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Justerar styrkan av assisterad styrning (när du använder körfältsassistenten mm.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Justerar intensiteten av markytans vibrationer, om handkontrollen stöder vibrationsåterkoppling."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Justerar intensiteten av väggupps vibrationer, om handkontrollen stöder vibrationsåterkoppling."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Justerar intensiteten av vibrationer från kollisioner, om handkontrollen stöder vibrationsåterkoppling."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Styrningskontroller."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justera styrningens dödzon; gradantal från centret som ignoreras.<br><br>Detta kan motverka problem med äldre handkontroller, såsom oprecision eller felaktig inmatning orsakad av slitage."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestämmer hur spelet hanterar styraxel­inmatningen:<br>- Centrerad är idealiskt för joysticks.<br>- Inverterad används för att korrigera en axel som har upptäckts felaktigt."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetens axel som ska användas för att accelerera."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerar accelerationsaxelns dödzon – mängden av hur långt du trycker där inmatning ignoreras.<br><br>Detta kan motverka problem med äldre handkontroller, såsom oprecision eller felaktig inmatning orsakad av slitage."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestämmer hur spelet hanterar handkontrollers inmatning:<br>- Centrerad är idealiskt för joystickar.<br>- Normal är idealt för triggers och pedaler.<br>- Inverterad kan kompenserra inmatning som var felaktigt upptäckta."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaxel för inbromsning."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerar bromssaxelns dödzon – mängden av hur långt du trycker där inmatning ignoreras.<br><br>Detta kan motverka problem med äldre handkontroller, såsom oprecision eller felaktig inmatning orsakad av slitage."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestämmer hur spelet hanterar handkontrollers inmatning:<br>- Centrerad är idealiskt för joystickar.<br>- Normal är idealt för triggers och pedaler.<br>- Inverterad kan kompenserra inmatning som var felaktigt upptäckta."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetens axel som ska användas för att koppla."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerar kopplingssaxelns dödzon – mängden av hur långt du trycker där inmatning ignoreras.<br><br>Detta kan motverka problem med äldre handkontroller, såsom oprecision eller felaktig inmatning orsakad av slitage."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestämmer hur spelet hanterar handkontrollers inmatning:<br>- Centrerad är idealiskt för joystickar.<br>- Normal är idealt för triggers och pedaler.<br>- Inverterad kan kompenserra inmatning som var felaktigt upptäckta."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Justera avståndet på kopplingen.<br><br>Ju längre från högersett, desto mer behöver du trycka på pedalen för att använda kopplingen."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaxeln för att luta kameran upp och ner."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerar axeln för att kolla upp-ner dödzonen; mängden av hur långt du trycker där inmatning ignoreras.<br><br>Detta kan motverka problem med äldre handkontroller, såsom oprecision eller felaktig inmatning orsakad av slitage."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestämmer hur spelet hanterar axel­inmatningen:<br>- Centrerad är idealiskt för joysticks.<br>- Inverterad används för att korrigera en axel som har upptäckts felaktigt."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Enhetsaxeln för att vrida på kameran höger och vänster."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Justerar styraxelns dödzon – mängden rotation från centrum där inmatning ignoreras.<br><br>Detta kan motverka problem med äldre handkontroller, såsom oprecision eller felaktig inmatning orsakad av slitage."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestämmer hur spelet hanterar axel­inmatningen:<br>- Centrerad är idealiskt för joysticks.<br>- Inverterad används för att korrigera en axel som har upptäckts felaktigt."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Väljer typ av växlingsutformning för H-växlning."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "\"Ändrar hur växelspaken beter sig:<br>- Med alternativet ”Enkel” kommer du aldrig att skrapa växlar när du växlar.<br>- Alternativet ”Enkel + varningsljud” låter dig också växla enkelt, men med skrapljud när du växlar fel.<br>- Alternativet ”Avancerad” låter dig inte byta växel om du växlar fel, och du kommer enbart att höra skrapljud. Alternativet ”Avancerad” gör det också möjligt att använda inställningen ”snabb växeldelning”."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Välj hur spelet ska hantera snabb delväxling:<br>- \"Aldrig\" kommer kräva att växelspaken flyttas till neutral mellan splittarna.<br>- \"Intryckt koppling\" kräver ett snabbt nertryck av kopplingspedalen utan förflyttelse av växelspaken.<br>- \"Släpp gas\" kräver bara föraren släpper på gaspedalen för att splitta växlarna utan någon förflyttning av växelspaken och \"koppling och gas\" är en kombination av de två senare alternativen."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Tilldela position av växelväljaren."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Tilldela position av växelväljaren."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
