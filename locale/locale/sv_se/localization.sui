	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Vehicle has significant mechanical issues affecting performance and reliability. You may need to consider a total restoration or replacement of multiple parts." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
