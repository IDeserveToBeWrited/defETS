#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Urval av teman som visas i bakgrunden när du bläddrar igenom menyn."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverar slumpmässigt val av bakgrundstema varje gång du startar spelet."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Sätter tiden för hur efter hur länge som element på skrivbordet tonar ut."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Om aktiverad så kommer du att uppleva effekten av trötthet över tid.<br><br>Om du inte vilar så kommer du göra överträdelser mot trafikreglerna."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "When enabled, you must obey traffic rules or risk getting traffic offences. The risk is increased near police vehicles, radar and traffic cameras."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Justera medellängden av jobb som erbjuds."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Select which speed limit to display on the navigation widget."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "The current speed on the navigation changes to red when the speed limit is exceeded."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "När du når ditt mål kommer en widget att visas som gör att du kan hoppa över parkeringen."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all widgets hidden."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Dölj båda HUD-backspeglarna."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Keeps all notifications hidden even when they are received."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Visar ett fönster där kapasiteten hos spelarens nuvarande lastbil visas innan ett tungt lastjobb accepteras."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Choose how the World Map is aligned."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Choose how the World Map is explored:<br>- \"Proximity exploration\" marks a larger area as explored.<br>- \"Precision exploration\" reveals only the areas immediately around the player."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Välj hur navigatorn ska visas."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar hur navigeringen dirigeras:<br>- Navigationsläget \"Bästa\" väljer det mest effektiva förhållandet mellan ruttens längd och tid, försöker undvika korsningar med trafikljus mm.<br>- Navigationsläget \"Kortast\" väljer alltid den kortaste möjliga rutten.<br>- Navigationsläget \"Små vägar\" väljer att undvika motorvägar där det är möjligt."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar din parkeringssvårighetsgrad:<br>- \"Välj alltid\" låter dig välja när du når din destination.<br>- \"Säker parkering\" kräver inte backmanövrar.<br>- \"Skicklig parkering\" kräver vanligtvis en mer utmanande backmanöver."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Justerar sannolikheten för att stöta på trafikfaror i din närhet, inklusive olyckor, trasiga fordon, vägskräp etc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Adjusts the probability of encountering a route changing detour while driving on a job."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Adjusts the probability of inclement weather."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Välj huruvida tidszoninformation ska visas utöver nuvarande tid."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Enables in-game cutscenes typically displayed after vehicle purchases, garage upgrades or during passenger loading."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Choose whether semi-transluscent blockers are displayed on roads that cannot be accessed."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverterar muses Y-axis när du kontrolerar kamera i spelet."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Välj växellådstyp:<br>- \"Enkel automatisk\" tillåter användning av gaspedal och broms för att styra rörelser framåt och bakåt.<br>- \"Riktig automatisk\" kräver en ingång för att växla mellan framåt- och backväxlar.<br>- \"Sekventiell\" kräver manuell växling av alla växlar med ingångar för upp-/nerväxling.<br>- \"H-Shifter\" kräver användning av en kontroller med växelreglage för att välja växlar manuellt."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Enabling this feature will allow \"skip shifting\" - skipping gears when necessary or practical to avoid shifting every gear in the transmission."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Brings the steering wheel back to the centre when a keyboard or controller is used.<br><br>Disabling this feature means you will have to manually steer back to centre after a turn."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Justera längden på rattens animation."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar bromsstyrkan."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar stabilitet för släpvagn genom sänkning av tyngdpunkten."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar styvheten av chassits fjädring."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar styvheten av hyttens fjädring."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Justerar intensiteten hos efterrgenererade gupp på ytan för att ge vägar och annan terräng en guppig känsla.<br><br>Beroende på andra fjädrings- och kamerainställningar kan den upplevda effekten vara mer eller mindre framträdande."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverar avancerad koppling som kräver högre precision för att linjera lastbilens vändskiva med släpets kingpin.<br><br>När detta är inaktiverat blir det mycket enklare att koppla ett släp, eftersom det inte finns någon kollision mellan kingpin och vändskiva."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Väljer om, och vilka, släpvagnskablar som animeras.<br><br><color value=@@clr_txt_d@@>Att aktivera kablar på fler fordon kan påverka prestandan på äldre system."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverar fordonets elektroniska hastighetsbegränsare till ett värde beroende på fordonstyp.<br><br><color value=@@clr_txt_d@@>World of Trucks-leveranser har alltid denna funktion aktiverad."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "När detta är aktiverat och vindrutetorkarna står i första läget, slås de på automatiskt och anpassar sin hastighet efter förhållandena."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverar automatisk inkoppling av retarder vid inbromsning."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "När detta är påslaget underlättar fordonet start i back genom att aktivera bromsarna, vilket ger en mjuk start."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverar automatisk inkoppling av motorbroms vid inbromsning."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the engine will start as soon as the throttle is pressed."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Sänker automatiskt axlar när det behövs beroende på fordonens bruttovikt."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "När detta är påslaget kommer fordonet att ge låg gas som standard. Efter att snabbt tryckt två gånger på gasknappen ges full gas tills att gasknappen släpps.<br><br>Påverkar bara tangentbord."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulerar verklig luftförlust från repeterande inbromsning.<br><br>När detta är aktivt, måste du hålla koll på lufttrycket medans du åker i nerförsbacke eller gör långsamma manövrar med flera inbromsningar."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "När detta är avstängt påverkas inte bränsleåtgången av körstil eller skick på vägen.<br><br>När detta är påslaget påverkas bränsleåtgången av en rad faktorer som körstil, godsets vikt, rullmotstånd och vägprofil. Det påverkas inte lägre av färdigheten @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Vid aktivering så förhindrar ABS att hjulen låser sig och ger bättre kontroll och förbättrad bromsmöjlighet."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes the increment of speed at which cruise control will increase or decrease when the appropriate button is pressed."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar farthållarens tolerans för att behålla inställd hastighet."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the cruise control will automatically adjust the speed to maintain a safe following distance to the vehicle ahead."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverar nödbromsen om systemet känner av en risk för kollision.<br>Välj om systemet reagerar på antingen bara fordon eller alla hinder."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras och strålkastarna är satta på positionsljus så aktiveras strålkastarna automatiskt vid mörker."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "When enabled and the headlights are turned on with the high beams engaged, the vehicle will automatically dim the high beams when it detects an oncoming vehicle or a vehicle close ahead."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Vid aktivering så stängs blinkersen av automatiskt efter en sväng när ratten är centrerad."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "När detta är aktiverat reagerar vissa interiöra tillbehör på fordonets rörelser (hängande dekorationer, nickedockor osv.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverar girrörelse på interiörkameran baserat på rattutslaget."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar hur reaktiv \"styrkamerarotationen\" motsvarar styyrningsinmatning."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar beteende för \"styrkamerarotation\" medans du backar."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the interior camera looks to the left or right based on indicator use."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "När detta aktiveras reagerar hyttkameran mot fordonets rörelse."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ändrar hur reaktiv hyttkameran är i förhållande mot fordonets rörelse."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes how much the interior camera is allowed to roll based on vehicle movement."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes how much the interior camera FOV is changed with vehicle movement speed."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Anger fördröjningen innan kameran automatiskt återcentreras.<br><br>Fordonet måste röra sig i en märkbar hastighet för att detta ska aktiveras. Gäller endast interiör- och jaktkameran när du kör framåt samt utkikar-kameran när du backar."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Sets the speed for camera movement. Used by auto camera centring and switching between interior camera presets."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determines how the interior zoom works: hold the button to zoom temporarily, or press once to toggle it." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Välj vilket språk som ska visas i spelet."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Ändrar förinställd valuta och enheter baserat på vald region."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras ändras städer och lands namn till valt språk."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras så visas båda namnen för länder och städer i valt språk och det landsspråk för det landet på kartan."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Välj valuta att använda."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Välj mellan 12-timmars klocka eller 24-timmars klocka."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Välj vilken avståndsenhet som ska visas."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Välj vilken viktenhet som ska visas."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Välj vilken temperaturenhet som ska visas."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Choose which pressure units are displayed."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Välj vilken volymenhet som ska visas."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Choose which consumption units are displayed."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras så öppnar \"Aktivera\" knappen (@@imv_nrm_activate@@) chatten för Convoy-sessioner."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras så visas alltid textchatten efter att ett meddelande är skickat."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras så tonar chattfönstret ut efter några sekunder efter varje meddelande."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Ändrar tidslängden för chattfönstret ska hållas kvar innan det tonas ut."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "När detta aktiveras så visas spelarnas namn ovanför dess lastbil i Convoy-sessionen."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Öppnar en avancerad meny för att konfigurera snabbsvar för chatten i Convoy-sessionen."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Kollar status för ditt \"World of Trucks\"-kopplade innehåll."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Enables downloading of online news for display on the Title Screen."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Aktiverar nerladdning av gemenskapsbilder valda från World of Trucks-hemsidan som visas på inladdningssidan."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Enables downloading of real advertisements for display on selected in-game billboards."
#@}

