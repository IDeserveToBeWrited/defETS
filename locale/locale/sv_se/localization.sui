#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Fortsätt ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Välkommen till Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Äntligen har du möjligheten att uppleva ditt drömjobb – köra lastbil!"

	key[]: "intro_3"
	val[]: "Ditt egna transportföretag är nu öppet, men tyvärr har du för lite pengar för att köpa en lastbil. Just nu får du jobba för andra företag som chaufför."

	key[]: "intro_4"
	val[]: "Ditt uppdrag är att leverera en last med $JOB_CARGO$ till $JOB_TARGET_COMPANY$s hamn i $JOB_TARGET_CITY$. Din arbetsgivare har gett dig tillgång till ett fordon och kommer täcka alla utgifter. Gör ingen besviken – kom i tid."


	key[]: "intro_garage_1"
	val[]: "Detta är ditt huvudkontor."

	key[]: "intro_garage_2"
	val[]: "Det är ett ganska enkelt garage. Det är kanske inte mycket, men i alla fall en början."

	key[]: "intro_garage_3"
	val[]: "Tyvärr har du ingenting att att parkera här än. Det är därför du inte ser några lastbilar."

	key[]: "intro_garage_4"
	val[]: "När du tjänat tillräckligt med pengar och köpt din egna lastbil kommer du att kunna röra dig fritt i världen och sköta ditt företag härifrån."

	key[]: "intro_garage_5"
	val[]: "Lycka till!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE UNLOCKED"

	key[]: "desktop_tut_job"
	val[]: "Välj ditt nästa jobb"

	key[]: "desktop_tut_cargo_market"
	val[]: "Använd ditt nya släp på Lastmarknaden och leverera ett stort antal olika typer av gods till dess destinationer." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Här kan du se dina framsteg."

	key[]: "desktop_tut_company"
	val[]: "Håll koll på dina garage, hyr nya chaufförer och hantera ditt företag härifrån."

	key[]: "desktop_tut_trailers"
	val[]: "Från och med nu så kan du köpa egna släp och uppgradera eller måla dem så de matchar din lastbil.<br><br>Dina släp sparas i valt garage och kan användas av dina anställda chaufförer för att nå ökad vinst. Du kan hantera dina släp via Släphanteraren."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visit $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Använd läges-knappen för att byta mellan olika skrivbordslägen och olika fordonstyper."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "WELCOME"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Welcome to the new Desktop.<br>From here you can interface with all functionality within the game."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Below, the Main Menu provides direct access to all of the core game functions that you are familiar with."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "At the top, the new Status Bar provides constant visibility to helpful player profile statistics and local travel regulations."

	key[]: "desktop_tut_tour_home"
	val[]: "The Desktop button is always there to return you to your Desktop."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "A permanent Quick Menu provides handy shortcut access to all game functions from any screen."

	key[]: "desktop_tut_tour_drive"
	val[]: "The updated Drive button remains your connection to the driving world, ready to place you back on the road."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL FINISHED"

	key[]: "desktop_tut_tour_finish"
	val[]: "Thanks for reviewing our Desktop update."


	key[]: "desktop_vehicle_mode_reenable_hints_t"
    val[]: "ENABLE HINTS"

    key[]: "desktop_vehicle_mode_reenable_hints"
    val[]: "You are entering a new game mode and contextual hints are currently disabled. Hints can help you learn how to play. Do you want to turn them back on?"
#@}


