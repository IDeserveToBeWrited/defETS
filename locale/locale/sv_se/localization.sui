#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Nätverkslagret är inte tillgängligt. Var god kontrollera att klientinställningen är korrekt."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Kunde ej ansluta till onlinetjänsten. Kontrollera att din internetanslutning fungerar."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Ett fel uppstod vid kommunikation med uppkopplad tjänst. Försök igen senare."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Felaktig data kom tillbaka från onlinetjänsten. Om du använder en HTTP-proxy, kontrollera dess konfiguration. Annars försök senare."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Fel uppstod vid kommunikation med onlinetjänsten. Försök igen senare."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Tjänsten är ej kompatibel med den här versionen av spelet. Kontrollera om det finns någon uppdatering för spelet."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Tjänsten är för närvarande inte tillgänglig. Försök igen senare."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Tjänsten är för närvarande inte tillgänglig p.g.a. underhåll eller överbelastning. Försök gärna igen senare."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Autentiseringsinformationen är inte korrekt.  Var god försök att logga in igen."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Kontot är tillfälligt stängt på grund av för många felaktiga inloggningsförsök. Prova igen om en halvtimme."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Onlinekontot är för närvarande låst på grund av misstänkta inloggningsförsök. Var god försök igen om 24 timmar."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Det här spelet är inte registrerat på det här kontot."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Kontot är inte aktiverat än. Kolla din inkorg efter ett mail om kontoaktivering."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Kontot är stängt. Var god kontakta teknisk support."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Kontot är avstängt. Var god kontakta support."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy-autentisering stöds inte av spelet. Använd en annan proxyserver eller en direktanslutning."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Objektet är inte tillgängligt just nu. Försök igen om ett par minuter."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL error. Unable to establish a secure connection."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "The game was suspended during the online communication. Please try again later."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Internt fel.  Filen net.log kan innehålla mer information."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 har råkat ut för problem och kan inte rita upp grafik på din dator (ingen giltig grafikenhet hittades).\nFöreslagna steg:\n\n1. Kontrollera att din dator och ditt grafikkort möter minimikraven.\n2. Uppdatera din dator med den senaste DirectX från Microsoft.\n3. Ladda ned och installera den senaste drivrutinen för ditt grafikkort från tillverkarens hemsida – drivrutinerna är troligen inaktuella.\n4. Prova att byta metod för att rendera grafik, från OpenGL till DirectX och tvärtom.\n5. Radera spelets konfigurationsfil, 'config.cfg', i mappen 'Dokument' - 'Euro Truck Simulator 2'.  Den kan ha blivit skadad.\nDenna fil kommer automatiskt att återskapas med giltiga förinställda värden vid nästa spelstart."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 har stött på ett problem och kan inte rita upp grafiken på din dator (ingen giltig grafikenhet hittades)."
#@}

