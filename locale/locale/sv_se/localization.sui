#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "SPELKONTROLLER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "KNAPPAR" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "AVANCERADE INSTÄLLNINGAR" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "Spelkontroller" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "INMATNINGSTYP" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "KONTROLL" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "KONTROLLFEEDBACK" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "KONTROLLAXLAR" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Endast tangentbord" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Tangentbord" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Styrning med mus" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Styrning med mus inklusive pedaler" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Ingen" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "Snabbinstallation av spelkontroll eller ratt"

#+ Selection of the controller subtype
#@{

	key[]: "controller_subtype"
	val[]: "Undertyp av styrenhet" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "Ratt" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
	val[]: "Spelkontroll, styrspak" #+ Gamepad like device. Value of the input controls speed of turning of the vehicle wheels.
#@}


	key[]: "steer_sens"
	val[]: "Styrkänslighet"

	key[]: "steer_nonlin"
	val[]: "Icke-linjär styrning"

#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "Force feedback" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "Återställ till ursprungsvärden" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Allmän styrka" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "Centrering vid hög hastiget" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "Centrering vid låg hastiget" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "Intern friktion" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "Motorresonans" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "Terrängyta" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "Gupp" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "Kollisioner" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "Växellådskärv" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "Understyrning" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "Assisterad styrning" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "Ytterängsvibrationer" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "Guppvibrationer" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Kollisionsvibrationer" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

	key[]: "ffb_lut_usage_hint"
	val[]: "The game uses custom force feedback LUT and no support is available for it. In case of problems with force feedback try to remove its file from your user profile folder!" #+ Hint telling player that the game is using custom force feedback LUT loaded from profile folder and to remove it in case of problems.
#@}

