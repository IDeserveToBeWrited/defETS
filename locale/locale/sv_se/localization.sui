#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "LADDA SPEL"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Ladda Spel" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.
	
	key[]: "load_game_failed"
	val[]: "Failed to load the saved game."

	key[]: "load_game_desc"
	val[]: "Ladda ett tidigare sparat spel. Nuvarande framsteg kommer försvinna!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Är du säker på att du vill ladda ett annat spel?<br><br>Ditt nuvarande spel förloras om du inte sparat tidigare."

	key[]: "load_progress_lost_mp"
	val[]: "Är du säker du vill ladda in en annan sparfil?<br>Görs detta i flerspelarläge kan resultera i eftergifter för dig, pausning, teleportering till närmaste verkstad eller otillgänglighet för det valda jobbet.<br><br>Dina nuvarande framsteg kommer att gå förlorade om du inte sparar dem tidigare."

	key[]: "load_game_mp_suspended_job"
	val[]: "Sparfil har laddats in utan problem men ditt aktiva World of Trucks-jobb var pausad och är otillgängligt under denna session."

	key[]: "autosave"
	val[]: "- Autospara -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Snabbspar -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Visa autospar" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Inga manuella sparningar hittades." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Ladda" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Inkompatibelt sparat spel!<br><color value=@@clr_txt@@>Försök att uppgradera spelet till den senaste tillgängliga versionen." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Misslyckades med att ladda och visa alla sparade spel för denna profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "VARNING" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Kunde ej ladda sparat spel.<color value=@@clr_txt@@><br><br>Det sparade spelet kunde ej laddas. Du kan försöka identifiera och möjligen fixa problemet med nedanstående information. Alternativt kan du försöka ladda att annat sparat spel.<br><br>Detta orsakas ofta av följande saker:<br><br>1. En eller flera installerade modifikationer är trasiga eller fungerar ej korrekt med nuvarande version av spelet.<br><br>2. Det sparade spelet innehåller information från modifikation(-er) som kanske är avstängda.<br><br>3. Det sparade spelet har korrumperats av en modifikation.<br><br>4. Om datorn kraschade vid eller strax efter spelet sparats kan detta ha korrumperat sparfilen."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Modifikation saknas.<color value=@@clr_txt@@><br><br>Det senaste sparade spelet innehåller referenser till saknad eller avstängd modifikation.<br><br>Om detta är oväntat, var god kontrollera dess tillstånd.<br><br>Annars kan du försöka att ladda spelet ändå. Var dock uppmärksam på att detta kan medföra problem, som att spelet inte laddas korrekt, beroende på vad som modifierats.<br><br>Alternativt kan du försöka att ladda ett annat sparat spel som inte är beroende av dessa modifikationer."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Ett frivilligt tilläggspaket saknas.<color value=@@clr_txt@@><br><br>Det senaste sparade spelet innehåller en officiell spelexpansion (DLC) som inte finns på datorn.<br><br>Om du inte förväntade detta, var god kontrollera status på berörd DLC.<br><br>Du kan även fortsätta med det sparade spelet. Tänk dock på att vissa funktioner från dessa DLC kan gå förlorade.<br><br>Annars kan du ladda ett annat sparat spel som inte är bundna till dessa DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Tilläggspaket (DLC) saknas.<color value=@@clr_txt@@><br><br>Det senaste sparade spelet innehåller referenser till en officiell spelexpansion som inte finns på datorn.<br><br>För att ladda detta sparade spel korrekt krävs det att denna DLC är installerad och aktiverad.<br><br>Alternativt så kan du försöka att ladda ett annat sparat spel som inte är beroende av saknad DLC."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Modden bygger på innehåll från en spelexpansion (DLC).<color value=@@clr_txt@@><br><br>Åtminstone en mod behöver tillgång till DLC (officiell expansion) som inte är installerad.<br><br>Du måste avaktivera modden/moddarna eller installera DLC-paketet/DLC-paketen som behövs."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Krasch upptäckt<color value=@@clr_txt@@><br><br>Det verkar som om spelet har kraschat när det senaste sparade spelet laddades.<br><br>Du kan försöka identifiera och möjligen fixa problemet med nedanstående information. Alternativt kan du försöka ladda att annat sparat spel.<br><br>Följande är vanliga orsaker:<br><br>1. En eller flera installerade modifikationer är trasiga eller fungerar ej korrekt med nuvarande version av spelet.<br><br>2. Det sparade spelet innehåller information från modifikation(-er) som kanske är avstängda.<br><br>3. Det sparade spelet har korrumperats av en modifikation.<br><br>4. Ibland kan hårdvara eller krånglande drivrutiner orsaka krascher."

	key[]: "mods_detected_warning"
	val[]: "Spelmodifiering upptäckt. Kom ihåg att trasiga, gamla eller inkompatibla moddar kan vara en källa till instabilitet. Se gärna över dina aktiverade moddar Modhanteraren." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

