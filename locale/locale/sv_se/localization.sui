#+ Options/Keyboard
#+
#+ Screen used to configure keyboard related options.
#@{

	key[]: "keyboard_t"
	val[]: "TANGENTER & KNAPPAR"  #+ Title of the screen. Please keep in upper case where possible.

	key[]: "keyboard_ico"
	val[]: "Tangenter & knappar" #+ Icon opening the keyboard options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "action"
	val[]: "Funktion" #+ Header of column containing name of the function (Throttle, Activate)

	key[]: "primary"
	val[]: "Primär" #+ Header of column containing a primary key/button.

	key[]: "secondary"
	val[]: "Sekundärt" #+ Header of column containing a secondary key/button.

	key[]: "na"
	val[]: "N / A" #+ Shown if no key is configured to this slot.


	key[]: "unassign"
	val[]: "Ta bort" #+ Button for cancelling the existing input assignent.

	key[]: "undo"
	val[]: "Ångra" #+ Button to undo the previous input assignment.

	key[]: "press_key_to_assign"
	val[]: "TRYCK PÅ knappen som du vill ange denna funktion till." #+ Key/button assignment hint.

	key[]: "press_or_hold_key_to_assign"
	val[]: "TRYCK PÅ eller HÅLL NER knappen som du vill ange denna funktion till." #+ Key/button assignment hint.

	key[]: "press_button_to_assign"
	val[]: "Tryck på den tangent du vill tilldela denna funktion."#+ Key/button/axis assignment hint.

	key[]: "select_input_to_unassign"
	val[]: "Välj den funktion från vilken du vill ta bort tilldelningen." #+ Hint shown when "unassign" button pressed.

	key[]: "lost_function_binding"
	val[]: "Förlorad tilldelning:" #+ Shown when key was rebound to a different function.

	key[]: "unavailable_assignment"
	val[]: "$INPUT$ cannot be used." #+ Shown when the player presses a key that cannot in input binding.

