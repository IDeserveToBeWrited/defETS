#@{
	key[]: "wotr_connected_content_header"
	val[]: "INNEHÅLL ANSLUTET TILL LÅNGTRADARVÄRLDEN" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Anslut" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Bläddra" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "ALLMÄNNA INSTÄLLNINGAR" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "ANSLUTET INNEHÅLL" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Anslut" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "Långtradarvärlden har upptäckt nytt spelinnehåll. Anslut det till Långtradarvärlden för att använda det." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Uppkopplad" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Onlineinställningar. Justera inställningar för Långtradarvärlden." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Önskar du verkligen skjuta upp registreringen?<br><br>Du kan komma åt dialogrutan Uppkopplat Innehåll senare från Onlineval, som du hittar på spelets huvudmeny." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "ANSLUTER INNEHÅLL" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Ansluter innehåll..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Kunde ej köa anslutning: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Det Steam-konto du använde för att registrera detta DLC är ej detsamma som använts för att skapa ditt konto i Långtradarvärlden eller spelet. Byt till korrekt Steam-konto och försök på nytt." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Det Steam-konto du använder för att registrera denna DLC är redan anslutet till ett annat konto på Långtradarvärlden. För att kunna registrera DLC:n till aktuellt konto måste du använda ett Steam-konto som ej är anslutet till ett konto i Långtradarvärlden." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam-tecknet har gått ut. Vad god försök igen senare." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Serienumret som använts för att aktivera DLC:n är ogiltigt. Var god kontakta support för hjälp: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Ett internt fel har uppstått vid registreringen av spelet. Vad god försök igen senare." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "LYCKADES" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "INNEHÅLLSKATALOG" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Grattis! Den valda DLC:n är nu anslutna till ditt konto i Långtradarvärlden." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Kunde ej ansluta innehåll då aktuellt Steam-konto är anslutet till ett annat konto i Långtradarvärlden." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Vissa DLC kunde ej anslutas.<br>Håll musen över utropstecknet för varje DLC för att se mer detaljer." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrerar $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Current profile is not connected to World of Trucks or the game is running in offline mode. Edit profile to connect." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Click to Dismiss"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ kompatibel DLC anslutet. Om något DLC inte är anslutet till Långtradarvärlden kan du eventuellt gå miste om en del funktioner." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Grattis! <color value=@@clr_txt@@>Allt innehåll är nu anslutet till Långtradarvärlden! Du har nu tillgång till dess samtliga funktioner." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Kan ej ansluta nytt innehåll till Långtradarvärlden då det Steamkonto som används inte är detsamma som används på Långtradarvärldens profil." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Ansluten" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Inte ansluten" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Kunde inte hämta information om ägt innehåll." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Kunde inte hämta information om anslutet innehåll." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Kunde inte hämta information om aktivt konto." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Senare" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Kunde inte registrera DLC. Ingen permanent licens funnen, förmodligen på grund av Steams familjedelning." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Inget permanent ägarskap" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Specialtransport avslutad!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "UPPDRAGET MISSLYCKADES!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Överge"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Ladda spartillfälle"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Du har skadat eskortbilen!<br> Du kan ladda ett tidigare spartillfälle eller avbryta leveransen mot en straffavgift på $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Eskortfordonet kolliderade med annan trafik på grund av felaktig körning.<br> Du kan ladda ett tidigare spartillfälle eller avbryta leveransen mot en straffavgift på $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Du förväntades följa rutten.<br> Du kan ladda en tidigare sparpunkt eller avbryta leveransen mot en straffavgift på $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Du förväntades stanna nära eskortfordonet.<br> Du kan ladda ett tidigare spartillfälle eller avbryta leveransen mot en straffavgift på $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Du har kört iväg från eskortfordonen!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Du har skadat eskortfordonet!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Eskortfordonet har kraschat!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Du har avvikit från rutten!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimensioner"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Leverans av specialtransport"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Se till att hålla lasten mellan eskortfordonen."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Specialleveranser"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimensioner"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Specialtransport"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Vänligen sakta ned för att undvika köra på eskortfordonet..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Vänligen vänta på den bakre eskorten..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Försiktigt, nu, en liten bit fram kommer en smal del av rutten..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Körfältsbyte om en stund. Anpassa hastighet för att undvika en att krascha..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Det främre eskortfordonet kommer att varna andra förare...<br> Anpassa din hastighet för att undvika att krascha..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Följebilen väntar på dig vid en närliggande korsning. Var god följ rutten."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Se upp!<br>Du är på väg farligt nära den bakre eskorten!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Se upp!<br>Du är farligt nära den bakre eskorten!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Tryck på följande tangent för att visa specialjobberbjudandet:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Erbjudande om specialjobb:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Du ska precis börja köra en specialtransport! Två följebilar kommer att guida dig. Ta det försiktigt och följ dem och de meddelanden som visas. Specialtransporter som den här stannar inte för rött ljus och har företräde i de flesta situationer. Under de här leveranserna skapas sparpunkter oftare för att spara dina framsteg."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Tag särskild hänsyn till följande:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Undvik alla konflikter med eskortfordonen och håll lasten mellan dem."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Kör inte iväg från den angivna rutten, inte ens till bensinstationer, rastplatser osv."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Följ hastighetsbegränsningarna som främre eskort håller."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Se upp för omkörande trafik och andra förare på vägarna."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manöver för byte av körfält:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Om du inte följer dessa regler kan din specialtransport misslyckas!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manövern påbörjas av det <color value=@@clr_sel@@>bakre<color value=@@clr_txt@@> eskortfordonet som byter och blockerar avsett körfält."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Det <color value=@@clr_sel@@>främre<color value=@@clr_txt@@> eskortfordonet väntar tills det avsedda körfältet är ledigt innan denna också byter körfält."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Det är då säkert för <color value=@@clr_sel@@>spelaren<color value=@@clr_txt@@> att byta till avsett körfält."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Lastbilen har tankats och arbetstimmarna nollställts."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Du kan ej kalla på assistans när du har specialtransport."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Du kan ej använda färja vid specialtransporter."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "You are getting some rest...<br>Truck's tanks are being refilled..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Approaching mandatory stop.<br>Follow the escort to the parking spot to rest!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Mandatory stop"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Press the following key to rest and refuel:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Ett fel uppstod då Steam Inventory-innehåll laddades.<br><br>$ERROR$<br><br>Välj Fortsätt för att fortsätta med innehållet aktiverat. Spelet kommer att söka efter det periodvis.<br><br>Du kan tillfälligt avaktivera innehållet för att förhindra att denna typ av felmeddelanden visas. Nästa gång du startar spelet kommer innehållet att aktiveras på nytt." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Kunde ej ladda ned innehåll från Steam Inventory." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTORY" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Laddar innehåll från Steam Inventory..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NYTT INNEHÅLL" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Nytt innehåll på Steam Inventory har upptäckts." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Fordonstillbehör" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Hyttillbehör" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Bakgrund på skrivbordet" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Lackering" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Avaktivera Steam Inventory" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Försök igen senare" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM INVENTORY" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "En del innehåll har tagits bort från ditt Steam Inventory. Du kan ej längre köpa dessa i Uppgraderingsshoppen.<br><br>Detta påverkar ej dina redan installerade objekt." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


