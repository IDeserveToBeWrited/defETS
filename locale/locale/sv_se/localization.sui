#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Filstorleken på skärmdumpen är för stor.  Var god minska skärmupplösningen." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Skärmdumpen är antingen skadad eller så stöds ej filformatet." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Upplösningen på skärmdumpen är för stor.  Var god minska skärmupplösningen." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Tjänsten avvisade skärmdumpen." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Det är inte tillåtet att ladda upp skärmdumpar på det här kontot." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Det görs en samtidig uppladdning till samma plats." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Uppladdning är tillfälligt avstängd. Var god försök igen senare." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Ett okänt fel inträffade vid uppladdning. Försök igen senare." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
