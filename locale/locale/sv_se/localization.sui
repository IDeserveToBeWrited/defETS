#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafik" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Justera grafikinställningarna med finjusterade förinställningar för att anpassa spelets visuella prestanda efter dina önskemål."

	key[]: "apply"
	val[]: "Tillämpa" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Skrivbordstema" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "SKÄRM" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "IMAGE QUALITY" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURES" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLECTIONS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SHADOWS" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "LIGHTING" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-PROCESSING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ENVIRONMENT" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Fullskärmsläge" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Brightness / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Setup" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Upplösning" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Uppdateringsfrekvens" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS-gräns" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS-gräns i bakgrunden" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Standard uppdateringsfrekvens" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikal synkronisering" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomisk (Sparar energi på bärbara datorer)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ENKLA GRAFIKINSTÄLLNINGAR" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "EGENDEFINIERADE INSTÄLLNINGAR ANVÄNDS" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "AVANCERADE GRAFIKINSTÄLLNINGAR" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Simpla/avancerade grafikinställningar" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Hide advanced settings" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Show advanced settings" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skalning" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Kantutjämning" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA-ljushets­skärpa" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA-justering" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptiv klarhet" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Alltid mjuk" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Alltid skarp" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Screen space ambient occlusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Högt dynamiskt omfång (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Djupskärpa (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Soldis" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Färgkorrigering" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Reflektionsskalning" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detaljer på reflektioner" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Växtlighetsdetaljer" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Gräsdensitet" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Skuggkvalitet"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Skuggstorlek" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Fjärrskuggor" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Interior shadows" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Kvalitet på väder"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Spegelkvalitet" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Spegelupplösning" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Spegelavstånd" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Kvalitet på textur" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anisotropisk filtrering" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normalmappning" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Strålkastare på trafik" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Fordonens andrahandsljus" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Avstånd för ljusets synlighet" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Fotgängare" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Skärminställningarna har ändrats.<br>Vill du behålla dessa inställningarna?"

	key[]: "reverting_in"
	val[]: "Återgår om" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekund(er)" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "När detta är aktiveras så visas spelet i fullskärm."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Justera generella ljusheten av spelet för din skärm. På HDR-kompatibla skärmar, HDR-kalibreringsalternativ kommer också vara tillgängliga under denna inställning."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Ändrar upplösningen på spelet."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Ändrar uppdateringsfrekvens för spelet."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Matchar bildfrekvenshastigheten med monitorns uppdateringsfrekvens för att motverka bildslitning. Ekonomiska inställningen halverar bildfrekvenen vilket medför lägre energiförbrukning."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Sätter maximalt tillåten bildfrekvens för spelet.<br><br>Sätts värdet på 0 stängs funktionen av."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Sätter maximalt tillåten bildfrekvens för spelet när det är minimerat.<br><br>Sätts värdet på 0 stängs funktionen av."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Ändrar mellan simpel grafikinställningar (förvalt) eller avancerade grafikinställningar (möjlighet att ändra individuella parametrar)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Förbättrar grafisk kvalitet genom att spelet renderas internt i en högre upplösning, vilket minskar taggiga kanter och ökar detaljnivån.<br>Till exempel ger ett högre skalningsalternativ en skarpare bild med mindre suddighet, vilket gör att spelet ser bättre ut totalt sett, men på bekostnad av prestanda.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar ofta prestandan kraftigt."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Val av högpresterande kantutjämningsmetoder som jämnar ut taggiga kanter i spelet:<br>- SMAA tar flera prover per pixel (beroende på valt kvalitetsläge) på olika platser inom ramen och genomsnittar proverna för att skapa den slutliga bilden.<br>- TAA tar endast ett prov per pixel per bildruta, men proverna tas på olika platser och i olika bildrutor.<br>- För bästa resultat kan du även välja en kombination av båda, på bekostnad av prestanda.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar vanligtvis prestandan måttligt."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Lägger till mjuka skuggor i sprickor och på objekt som står nära varandra, vilket förbättrar den upplevda grafiska kvaliteten i hela spelvärlden.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar vanligtvis prestandan måttligt."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Val av TAA-förinställningar:<br>- ”Alltid mjuk” ger mindre flimmer/mer oskärpa – lämpligt för PC-användare som aktiverar supersampling eller har skärmar med hög DPI, men även för 1080p-TV-användare som sitter längre från skärmen.<br>- ”Alltid skarpt” ger mer flimmer/mindre oskärpa – troligen det bästa alternativet för upplösningar under 1080p, såsom laptops eller Steam Deck.<br>- ”Adaptiv klarhet” inaktiverar TAA-jitter dynamiskt när kameran är stilla.<br><br><color value=@@clr_txt_d@@>Denna inställning kan endast användas när TAA är valt som kantutjämningsmetod."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar styrkan på TAA's luma-skarphet.<br><br><color value=@@clr_txt_d@@>Denna inställning kan endast användas när TAA är valt som kantutjämningsmetod."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "När detta aktivera kan avlägsna områden på kartan göras artificiellt suddiga för att skapa en realistisk fokusavtoning i bakgrunden."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "När detta aktiveras kan ljusstrålar bli synliga när du tittar mot solen, eller mot solen genom objekt som träd, byggnader eller fordon."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "När det är aktiverat justeras spelets färger dynamiskt av estetiska skäl. Scenerna anpassas bättre till tid på dygnet och väderförhållandena; färgerna på fordon och andra objekt kan bli mer livfulla osv."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Förbättrar reflektionerna genom att rendera dem i högre kvalitet internt, samt använda bättre antialiasing.<br><br><color value=@@clr_txt_d@@>Ändringar av den här inställningen träder endast i kraft efter en manuell omstart av spelet."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar reflektionsdetaljer på fordonets ytro, fönster och andra reflektiva ytor så som pölar, våta vägbanor och öppa vattenytor.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkan prestandan måttligt.<br><br>Ändringar av denna inställning kräver omstart för att appliceras."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar detaljerna och komplexiteten av plantor och träd.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar prestandan måttligt."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar tjockleken av gräs som är vid vägkanterna.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar prestandan måttligt."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar skuggkvalitén som ges av solen och månen.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar prestandan måttligt."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverar skuggor på objekt långt bort.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar oftast inställningarna måttligt."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar vädereffekternas kvalité så som reflektioner."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar reflektionskvalitén i fordonsspeglar (fristående från reflektionsinställningarna).<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar oftast prestandan måttligt."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar upplösningen på genererade bilden i fordonsspeglarna."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar avståndet där objekt börjar visas i speglarna.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar vanligtvis prestandan måttligt."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar kvalitén av vissa texturer på objekt och ytor i spelet."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Förbättrar skärpan i texturer, särskilt de som ses på avstånd eller i sned vinkel.<br><br><color value=@@clr_txt_d@@>Ändringar av denna inställning träder i kraft först efter en manuell omstart av spelet."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Ger geometriska detaljer till trottoarer, vägar och andra föremål.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar vanligtvis prestandan måttligt.<br><br>Ändringar av denna inställning träder i kraft först efter en manuell omstart av spelet."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverar belysning från strålkastare från andra traffikanter."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverar belysning från andra fordons sekundära ljus i trafiken, såsom blinkers, bromsljus osv."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Justerar avståndet från vilket artificiella ljuskällor kan ses.<br><br><color value=@@clr_txt_d@@>Denna inställning påverkar vanligtvis prestandan måttligt."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverar så gående syns i spelvärlden."
#@}

