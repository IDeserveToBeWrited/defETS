#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Det DLC (officiell spelexpansion) som krävs – $DEPENDENCY_NAME$ – saknas. För att kunna ladda det här sparade spel krävs det att denna DLC är aktiverat på datorn. Du måste fixa detta problem innan du kan fortsätta." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Den frivilliga DLC:n (officiell spelexpansion) $DEPENDENCY_NAME$ saknas. Om du inte förväntade dig detta, var god kontrollera detta DLC.<br><br>Du kan alltid välja att ladda det sparade spelet ändå, men kan komma gå miste om funktioner som medföljer detta DLC." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modifikationen $DEPENDENCY_NAME$ saknas eller är ej aktiv. Om du inte förväntat dig detta, var god kontrollera denna mod. Du kan även prova att ladda spelet ändå, men var beredd på att detta kan orsaka att spelet inte laddar eller att andra problem uppstår." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modden $DEPENDENCY_NAME$ är inte kompatibel med din version av spelet. Detta innebär att skaparen av denna modifikation har flaggat den som att den bara fungerar vissa versioner. Den nuvarande finns inte bland dem.<br><br>Lösning:<br>Försök hitta en uppdaterad version av modden som fungerar med den här versionen av spelet.<br>Uppdatera eller nedgradera spelet till en version som fungerar med modifikationen.<br><br>Du kan även prova att ladda spelet ändå, men var beredd på att modden inte laddas och, beroende på vad den skulle ha gjort, kan orsaka krascher eller andra problem." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "OBLIGATORISKT INNEHÅLL SAKNAS" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETALJER" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Öppna Workshop-sidan"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Detta sparade spel kräver vissa DLC:er eller moddar, som för närvarande saknas. De visas nedan. Genom att välja ett objekt i listan kan du få mer information om detta." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Det här sparade spelet kräver en viss DLC eller modd. Du måste lösa detta innan du kan ladda spelet." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Avbryt laddning" #+ Abort loading button.

	key[]: "type"
	val[]: "Typ" #+ Type column.

	key[]: "dependency_name"
	val[]: "Namn på innehåll som behövs" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokal modd" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Modd från Workshop" #+ Steam Workshop mod.

