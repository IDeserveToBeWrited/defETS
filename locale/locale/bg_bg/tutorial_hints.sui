
    key[]: "hint_engine_title"
	val[]: "Стартиране на двигателя"

    key[]: "hint_engine_text"
	val[]: "Натиснете $KEY_engine$, за да запалите двигателя."


    key[]: "hint_ignition_title"
	val[]: "Включи запалването"

    key[]: "hint_ignition_text"
	val[]: "Използвайте $KEY_engineelect|KEY_engine$, за да включите запалването."


    key[]: "hint_driv_arc_title"
	val[]: "Шофиране"

    key[]: "hint_driv_arc_text"
	val[]: "Използвайте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, за да се движите напред или на заден ход. <offset vshift=8> Използвайте $SPECIAL_steering$, за да завивате."


    key[]: "hint_driv_auto_title"
	val[]: "Шофиране"

    key[]: "hint_driv_auto_text"
	val[]: "Използвайте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, за да се движите напред или на заден ход. <offset vshift=8> Използвайте $SPECIAL_steering$, за да завивате.. Натиснете $KEY_gearup$ и $KEY_geardown$$KEY_geardown$ за да изберете предавка."


    key[]: "hint_driv_seq_title"
	val[]: "Шофиране"

    key[]: "hint_driv_seq_text"
	val[]: "Използвайте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, за да се движите напред или назад. <br><offset vshift=8>Използвайте $SPECIAL_steering$, за да управлявате посоката. <br><offset vshift=8>Натиснете $KEY_gearup$ и $KEY_geardown$ за управление на съединителя."


    key[]: "hint_driv_hshift_title"
	val[]: "Шофиране"

    key[]: "hint_driv_hshift_text"
	val[]: "Използвайте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, за да се движите напред или назад. <br><offset vshift=8>Използвайте $SPECIAL_steering$, за да управлявате посоката. <br><offset vshift=8>Сменяйте скоростите с <color value=@@clr_sel@@>скоростния лост<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Приближете се до дестинацията"

    key[]: "hint_depot_deliv_text"
    val[]: "Спрете в маркираната зона, за да изберете трудност на паркирането и да спечелите съответния опит."


    key[]: "hint_fin_deliv_title"
    val[]: "Завърши доставката"

    key[]: "hint_fin_deliv_text"
    val[]: "Паркирайте на избраното място. Можете да натиснете $KEY_activate$, за да го пропуснете, когато сте близо до мястото за доставка."


    key[]: "hint_fin_deliv2_title"
    val[]: "Завърши доставката"

    key[]: "hint_fin_deliv2_text"
    val[]: "Паркирайте на избраното място. Можете да активирате опция в @@desktop_menu_category_options@@, която да ви позволи да пропускате паркирането."


    key[]: "hint_lights_title"
    val[]: "Включи светлините"

    key[]: "hint_lights_text"
    val[]: "Използвайте $KEY_light$, за да включите светлините. Превключвайте различните режими, като го натискате многократно."


    key[]: "hint_high_beam_title"
    val[]: "Включи дългите светлини"

    key[]: "hint_high_beam_text"
    val[]: "Използвайте $KEY_hblight$, за да включите дългите светлини."


    key[]: "hint_wipers_title"
    val[]: "Включи чистачките"

    key[]: "hint_wipers_text"
    val[]: "Използвайте $KEY_wipers$, за да включите чистачките и да превключвате между различните степени на скорост."


    key[]: "hint_zoom_title"
    val[]: "Поглед отблизо"

    key[]: "hint_zoom_text"
    val[]: "Използвайте $KEY_camzoom$, за да приближите погледа, докато сте в кабината. Можете да настроите режима на приближаване на „задържане“ или „превключване“ в @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Поглед наоколо"

    key[]: "hint_cam_int_text"
    val[]: "Използвайте $KEY_cam1$, за да превключите камерата към изглед от кабината."


    key[]: "hint_cam_ext_title"
    val[]: "Поглед наоколо"

    key[]: "hint_cam_ext_text"
    val[]: "Можете да превключвате между различните изгледи на камерата, като натиснете $KEY_camcycle$.<offset vshift=8>Използвайте $KEY_cam2$, за да превключите камерата към външен изглед."


    key[]: "hint_indicators_title"
    val[]: "Индикатори"

    key[]: "hint_indicators_text"
    val[]: "Използвайте $KEY_lblinker$ и $KEY_rblinker$, за да включите мигачите."


    key[]: "hint_tow_title"
    val[]: "Пътна помощ"

    key[]: "hint_tow_text"
    val[]: "Ако не можете да се измъкнете от трудна ситуация, можете да използвате услугите на пътна помощ. За достъп до нея отворете менюто @@quick_info_word@@, като използвате $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Блокаж на диференциал"

    key[]: "hint_diff_lock_text"
    val[]: "Ако не можете да потеглите, блокировката на диференциала може да ви помогне. Използвайте $KEY_diflock$, за да я активирате, или включете автоматичната блокировка на диференциала в @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Блокировката на диференциала е включена"

    key[]: "hint_diff_unlock_text"
    val[]: "Трябва да изключвате блокировката на диференциала при нормално шофиране, в противен случай рискувате да я повредите. Използвайте $KEY_diflock$, за да я деактивирате, или включете автоматичната блокировка на диференциала в @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Изключи чистачките"

    key[]: "hint_wipers_off_text"
    val[]: "Използвайте $KEY_wipers$, за да изключите чистачките и да превключвате между различните степени на скорост."


    key[]: "hint_world_map_title"
    val[]: "Изглед на картата"

    key[]: "hint_world_map_text"
    val[]: "Използвайте $KEY_navmap$, за да отворите картата на света."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Използвайте $KEY_advmouse$, за да отворите @@quick_info_word@@ – общ преглед на вашето състояние с удобни преки пътища."


    key[]: "hint_pause_border_title"
    val[]: "Местни разпоредби"

    key[]: "hint_pause_border_text"
    val[]: "Използвайте $KEY_advmouse$, за да отворите @@quick_info_word@@ и да видите текущите разпоредби за региона, в който сте влезли."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Отворете @@quick_info_word@@, като използвате $KEY_advmouse$, за да влезете във @@photo_mode_word@@ и да заснемете намиращата се наблизо @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ В близост до гледна точка"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> е наблизо – намерете го и го активирайте, за да изгледате кратката сцена."


    key[]: "hint_resting_title"
    val[]: "Място за почивка наблизо"

    key[]: "hint_resting_text"
    val[]: "Местата за почивка <img src=/material/ui/map/parking_ico.mat width=20 height=20> ви помагат да се възстановите от умората и да продължите пътуването си безопасно."


    key[]: "hint_gas_title"
    val[]: "Бензиностанция наблизо"

    key[]: "hint_gas_text"
    val[]: "Бензиностанциите <img src=/material/ui/map/gas_ico.mat width=20 height=20> могат да бъдат използвани за презареждане на вашето превозно средство."
