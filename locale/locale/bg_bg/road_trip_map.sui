#+ Viewpoint descriptions for Tourist Jobs photo album
#@{
	
	key[]: "at_cut_grossglockner_desc"
	val[]: "Гросглокнер, най-високият връх в Австрия със своите 3798 метра, се извисява над Алпите. Известен е със своя 48-километров високоалпийски път с 36 остри завоя и с Пастерце – най-дългия глетчер в Австрия и Източните Алпи.<br><br>Сахарският пясък, пренесен на хиляди километри на север, понякога оцветява снега по алпийския път в яркожълто или оранжево."

	key[]: "at_cut_schonbrunn_desc"
	val[]: "Дворецът Шьонбрун, бивша лятна резиденция на Хабсбургите, е обект на световното наследство на ЮНЕСКО и един от най-изящните барокови комплекси в Европа.<br><br>Неговата зоологическа градина, основана през 1752 г., е най-старият постоянно действащ зоопарк в света."

	key[]: "at_cut_worthersee_desc"
	val[]: "Езерото Вьортерзее е тюркоазено бижу, оформено през последната ледникова епоха, известно със своите чисти, богати на минерали води.<br><br>Легендата гласи, че цял град и неговата църква са потънали под водите на езерото, а местните жители все още твърдят, че чуват камбаните му да бият под водата."

	key[]: "de_cut_ettal_desc"
	val[]: "Абатство Етал е бенедиктински манастир в Баварските Алпи, основан през 1330 г. от император Лудвиг IV Баварски.<br><br>Легендата гласи, че конят на Лудвиг е коленичил три пъти на това място, което той е приел като знак да построи манастира там."

	key[]: "de_cut_stuttgart_city_desc"
	val[]: "Щутгартският държавен театър, проектиран от архитекта Макс Литман, отваря врати през 1912 г. като кралски придворен театър на Кралство Вюртемберг.<br><br>Щутгарт се намира върху второто по големина находище на минерална вода в Европа, като някои извори са толкова естествено газирани, че къпането в тях се усеща като потапяне в шампанско."

	key[]: "de_cut_nurnberg_city_desc"
	val[]: "Нюрнберг е бил един от най-важните градове в Свещената Римска империя и все още е известен със своите изключително обширни средновековни укрепления.<br><br>През 1561 г. ужасените жители на Нюрнберг стават свидетели на масова „въздушна битка“ на разсъмване между светещи кълбета и кръстове, запечатана в ксилография, която днес се цитира като ранно наблюдение на НЛО."

	key[]: "de_cut_frankfurt_city_desc"
	val[]: "Финансовият квартал на Франкфурт „Банкенфиртел“, наричан с прякора „Майнхатън“, помещава централите на много важни банки.<br><br>Франкфурт е дом на един от най-старите панаири в света, датиращ от 12. век. Днес той е домакин на най-големия панаир на книгата в света всяка есен."

	key[]: "de_cut_rostock_desc"
	val[]: "Площад „Нойер Маркт“ в Росток, заобиколен от търговски къщи с фронтони в стил тухлена готика, е централният пазарен площад на града от 13. век.<br><br>Росток е дом на най-стария университет по балтийското крайбрежие, основан през 1419 г., преди повече от 600 години."

	key[]: "de_cut_duisburg_desc"
	val[]: "Кметството на Дуйсбург, завършено през 1902 г. в ранноренесансов историцистичен стил, се издига на място, някога заемано от средновековен кралски дворец.<br><br>Дуйсбург се намира там, където се срещат реките Рейн и Рур, което прави вътрешното му пристанище най-голямото речно пристанище в света."

	key[]: "de_cut_kassel_desc"
	val[]: "Първите исторически споменавания на Касел датират от 913 г., описващи укрепено място до мост над реката.<br><br>Самото име е много по-старо, произлизащо от германското племе хати."

	key[]: "de_cut_berlin_desc"
	val[]: "Колоната на победата в Берлин, завършена през 1873 г., отбелязва пруските военни победи от Xix век и се издига в парка „Тиргартен“.<br><br>Колоната е преместена с 1,5 километра на настоящото си място през 1938–1939 г. като част от голямо преустройство на града, при което получава четвърти сегмент, направил я още по-висока."

	key[]: "de_cut_dresden_desc"
	val[]: "Бароковата църкви Фрауенкирхе в Дрезден, завършена през 1743 г. на площад „Ноймаркт“ близо до река Елба, е една от архитектурните забележителности на града, наричан с прякора „Флоренция на Елба“ или „Немската Флоренция“.<br><br>През 2009 г. Дрезден става първият обект в Европа, лишен от статута си на световно наследство на ЮНЕСКО, губейки го заради изграждането на един-единствен мост."

	key[]: "ch_cut_geneve_desc"
	val[]: "Фонтанът „Же д'О“ в Женева изхвърля езерна вода на до 140 метра във въздуха близо до мястото, където река Рона изтича от Женевското езеро.<br><br>От 1818 г. Женева отбелязва идването на пролетта, като наблюдава официално дърво от див кестен. Държавен служител обявява настъпването на сезона, когато се разпука първото му листо – традиция, която се спазва и до днес."

	key[]: "ch_cut_zurichw_desc"
	val[]: "Цюрих Запад е бивш индустриален квартал, преобразен от 90-те години насам в модерен район, доминиран от стъклената кула „Прайм Тауър“.<br><br>Най-авангардният магазин в Цюрих Запад е изграден от 19 ръждясали транспортни контейнера, подредени на девет етажа височина върху бивша промишлена пустош."

	key[]: "ch_cut_furka_desc"
	val[]: "Проходът Фурка е високопланински проход на 2429 метра, свързващ кантоните Ури и Вале в Централна Швейцария.<br><br>Неговите остри завои участват в автомобилната гонитба във филма от 1964 г. „Голдфингър“, а един от завоите носи прякора „Джеймс Бонд Щрасе“."

	key[]: "nl_cut_devlieter_desc"
	val[]: "Де Флитер маркира участък от Афслаутдейк – 32-километровата дига, която прегражда Зьойдерзе, за да се образува Ейселмер.<br><br>Приливният канал и заобикалящите ги води на Ваденско море близо до Де Флитер са погълнали приблизително между 500 и 1000 кораба през историята."

	key[]: "nl_cut_eindhoven_desc"
	val[]: "Айндховен е нидерландски град в Северен Брабант, известен като родното място и дългогодишно седалище на гиганта в електрониката Philips.<br><br>Philips започва дейността си там през 1891 г. с производство на електрически крушки, с което Айндховен си спечелва прякора „Градът на светлината“."

	key[]: "nl_cut_groningen_desc"
	val[]: "Гронинген е оживен университетски град в Северна Нидерландия, доминиран от извисяващата се кула на църквата Мартиниторен.<br><br>Местните с обич наричат Мартиниторен „d’Olle Grieze“ или „Стария сив“; това е третата кула на това място, след като два нейни предшественика са унищожени след мълнии."

	key[]: "be_cut_ardennes_desc"
	val[]: "Ла Рош ан Арден е малък белгийски град, доминиран от руините на средновековен замък над завой на река Урт."

	key[]: "be_cut_antwerp_desc"
	val[]: "Антверпен е вторият по големина град в Белгия и историческо пристанище, известно като световната столица на търговията с диаманти от 1447 г.<br><br>Приблизително 80 до 90 процента от необработените диаманти в света преминават през Диамантения квартал на Антверпен всяка година."

	key[]: "fr_cut_brest_desc"
	val[]: "Яхтеното пристанище на Брест се намира в историческото пристанище, което кардинал Ришельо превръща във френска военноморска база през 1631 г.<br><br>Яхтените пристанища на Брест са основен център за океански ветроходни състезания, където се събират елитни ветроходци, преди да отплават през Атлантическия океан или да се опитат да подобрят някои от най-трудните световни рекорди във ветроходството."

	key[]: "fr_cut_marseille_desc"
	val[]: "Старото пристанище на Марсилия служи за естествено пристанище на града откакто гръцки заселници основават Масалия около 600 г. пр. н. е.<br><br>То е едно от най-старите постоянно действащи пристанища в Европа."

	key[]: "fr_cut_peyrat_desc"
	val[]: "Пейра-льо-Шато е малко село в департамента Горна Виен, построено край езеро на платото Милваш в Лимузен.<br><br>Платото Милваш получава необичайното си име или от „хиляда крави“, които някога са пасли там, или от стара дума за многото естествени извори, изпъстрящи платото – и никой не е съвсем сигурен кое от двете е!"

	key[]: "fr_cut_rousse_desc"
	val[]: "Лил Рус е крайбрежен град в региона Балан на северозападна Корсика, основан през 1758 г. от Паскал Паоли.<br><br>Паоли изгражда пристанището, за да могат корсиканците да търгуват, без да разчитат на съперническото пристанище в Калви, контролирано от генуезците."

	key[]: "fr_cut_serre_desc"
	val[]: "Езерото Сер-Понсон е обширен язовир в Горните Алпи, създаден между 1955 и 1960 г. чрез преграждане на река Дюранс.<br><br>Езерото Сер-Понсон е толкова голямо, че с площта си от близо 3000 хектара носи прякора „морето в планината“, а един-единствен самотен параклис на малък остров все още се подава едва над нивото на водата в язовира."

	key[]: "fr_cut_usse_desc"
	val[]: "Замъкът „Юсе“ е замък в приказен стил в долината на Лоара, построен между Xv и Xvii век върху бивша викингска крепост.<br><br>Смята се, че писателят Шарл Перо е черпил вдъхновение от белите му кули с кулички, докато е писал „Спящата красавица“ през Xvii век."

	key[]: "it_cut_bari_desc"
	val[]: "Пристанището на Бари се намира на адриатическото крайбрежие на Италия и отдавна служи като портал между Европа и Балканите.<br><br>Между 847 и 871 г. Бари е бил столица на свой собствен краткотраен ислямски емират – единствената такава държава, създадена в континенталната част на Италия."

	key[]: "it_cut_etna_desc"
	val[]: "Вулканът Етна, разположен на източното крайбрежие на Сицилия, е най-високият активен вулкан в Европа и един от най-активните вулкани на Земята.<br><br>Името му обикновено се произвежда от гръцкото Aitnē, произлизащо от думата aithō, означаваща „горя“."

	key[]: "it_cut_neapol_desc"
	val[]: "Пристанището на Неапол, основано на мястото на древногръцкото селище Неаполис, е едно от най-старите и най-натоварените пристанища в Италия.<br><br>По време на изкопни работи за метростанция край днешното пристанище на Неапол археолозите откриват древното пристанище и останките от седем кораба, датиращи от елинистическия и римския период."

	key[]: "it_cut_sassari_desc"
	val[]: "Църквата „Санта Мария ди Бетлем“ в Сасари, Сардиния, е францискански комплекс, чийто произход датира от XII век.<br><br>Всеки август гилдиите на Сасари носят до църквата високи дървени „свещи“, тежащи стотици килограми, по време на фестивала „Канделиери“, подновявайки древен обет, свързан с чумата."

	key[]: "it_cut_taranto_desc"
	val[]: "Таранто е южноиталиански град на Йонийско море, основан около 706 г. пр. н. е. от спартански колонисти като гръцкия град Тарас.<br><br>Индустриалният залив на Таранто е дом на процъфтяваща популация от делфини – включително раирани делфини с генетични белези, които не се срещат никъде другаде в Средиземно море."

	key[]: "it_cut_villa_san_giovanni_desc"
	val[]: "Вила Сан Джовани е калабрийски град в континентална Италия и основният фериботен терминал през Месинския проток до Сицилия.<br><br>Вила Сан Джовани е основан от копринения предприемач Роко Антонио Карачоло, който обединява пет съперничещи си селища. Крал Фердинанд IV Неаполитански официално наименува новия град през 1791 г."

	key[]: "balt_cut_castles_desc"
	val[]: "Замъкът „Херман“ е основан от датчаните през XIII век и по-късно е преустроен от Ливонския орден. Крепостта „Ивангород“ е основана от Иван III през 1492 г. за защита на западната граница на Московското княжество."

	key[]: "balt_cut_convent_desc"
	val[]: "Основан през 1447 г. на север от Псков от свети Ефросин, той се превръща в известен просветен център."

	key[]: "balt_cut_daugavpils_desc"
	val[]: "Вторият по големина град в Латвия се развива от замъка Динабург, основан на река Даугава през 1275 г. от Ливонския орден.<br><br>Градът е носил поне четири различни имена, включително Динабург, Борисоглебск и Двинск, преди да стане Даугавпилс през 1920 г."

	key[]: "balt_cut_klaipeda_desc"
	val[]: "Клайпеда, единственото голямо морско пристанище на Литва, е основан през 50-те години на XIII век от Ливонския орден – клон на Тевтонския орден.<br><br>В продължение на около 500 години градът никога не е бил управляван от литовска държава, като става част от Литва едва след въстание през 1923 г."

	key[]: "balt_cut_riga_power_plant_desc"
	val[]: "Построена на река Даугава между 1966 и 1975 г., стената му създава язовир, заливайки половината от остров Доле.<br><br>Горната част на стената служи и като обществен път, а железопътната линия от периода на строителството, която някога е преминавала по нея, по-късно е демонтирана."

	key[]: "balt_cut_valmiera_desc"
	val[]: "Олимпийският център „Видземе“ във Валмиера е многофункционална зала с площ от близо 2900 квадратни метра, използвана за баскетбол и флорбол.<br><br>Роденият във Валмиера състезател по спортно ходене Янис Далинш печели първия медал от летни олимпийски игри за независима Латвия – сребро в дисциплината 50 км спортно ходене на Игрите в Лос Анджелис през 1932 г., а градският стадион днес носи неговото име."

	key[]: "blke_cut_cerna_voda_desc"
	val[]: "Мостът „Ангел Салини“ при Черна вода, завършен през 1895 г., някога е бил най-дългият мост в Европа с дължина от над четири километра.<br><br>Отстъпващите румънски войски повреждат моста над Дунав и унищожават участъка му „Борча“ през 1916 г. И двата са възстановени, а нов мост ги заменя през 1987 г."

	key[]: "blke_cut_edirne_desc"
	val[]: "Одрин служи за столица на Османската империя в продължение на близо век, преди Константинопол да бъде завладян през 1453 г.<br><br>Фестивалът по мазни борби „Къркпънар“ в Одрин, който се провежда от XIV век насам, облива борците с близо две тона зехтин и държи рекорда на Гинес за най-старото спортно състезание."

	key[]: "blke_cut_orsova_desc"
	val[]: "Оршова е крайдунавски град в югозападна Румъния, разположен непосредствено над пролома Железни врата, близо до мястото, където река Черна се влива в Дунав.<br><br>Изграждането на язовирната стена „Железни врата I“ покачва нивото на река Дунав с приблизително 30 метра, потапяйки старата Оршова през 1970 г. Жителите ѝ са преселени в изцяло нов град, построен на по-високо място между 1966 и 1971 г."

	key[]: "blke_cut_pernik_desc"
	val[]: "Перник, въгледобивен град близо до София, дом e на голям стоманодобивен завод от 1953 г.<br><br>Заводът произвежда по-голямата част от стоманата си от рециклиран скрап, което го прави едно от най-ориентираните към кръговата икономика предприятия в региона."

	key[]: "blke_cut_poiana_viaduct_desc"
	val[]: "Виадуктът „Пояна Тейулуй“ е 634-метров пътен мост, пресичащ опашката на езерото Биказ в румънския окръг Няамц."

	key[]: "blke_cut_r73_desc"
	val[]: "Виадуктът „Пояна Тейулуй“ е 634-метров пътен мост, пресичащ опашката на езерото Биказ в румънския окръг Няамц."

	key[]: "ibe_cut_barcelona_desc"
	val[]: "Барселона води началото си от римското селище Барсино, чиито древни руини все още лежат под улиците на съвременния град.<br><br>Седем от деветте обекта на световното наследство на ЮНЕСКО в Барселона са самостоятелни творби на архитекта Антони Гауди, включително незавършената „Саграда Фамилия“."

	key[]: "ibe_cut_ejido_desc"
	val[]: "Ел Ехидо, в района Кампо де Далиас в Алмерия, е дом на една от най-големите концентрации на селскостопански оранжерии в света.<br><br>Оранжериите от „Пластмасовото море“ в Алмерия се простират на площ от 370 квадратни километра и отразяват толкова много слънчева светлина, че астронавтите могат да ги разграничат от орбита."

	key[]: "ibe_cut_guadiana_desc"
	val[]: "Международният мост „Гуадиана“ е вантов мост, свързващ Аямонте, Испания, и Кастро Марим, Португалия, при най-южното пресичане на границата.<br><br>Преминаването по моста означава и преминаване на граница между часови зони, така че пътуващите от Испания за Португалия могат да изживеят две отделни отброявания на Нова година."

	key[]: "ibe_cut_lisboa_desc"
	val[]: "Мостът „25 април“ пресича река Тежо, свързвайки Лисабон и Алмада, и се нарежда сред най-дългите висящи мостове в Европа."

	key[]: "ibe_cut_olhao_desc"
	val[]: "Оляо е варосано рибарско градче на португалското крайбрежие Алгарв, с пряк излаз към лагуната Риа Формоза.<br><br>Легендата гласи, че през 1808 г. седемнадесет рибари от Оляо отплават с открита лодка чак до Бразилия, само за да съобщят на краля на Португалия в изгнание, че страната му е свободна."

	key[]: "ibe_cut_reservoir_desc"
	val[]: "Язовирът „Бариос де Луна“ в провинция Леон е създаден през 1956 г., когато язовирна стена прегражда река Луна в тесен планински пролом.<br><br>При пълненето на язовира са потопени шестнадесет села и селища под води, които днес се простират на около 40 километра през долината."

	key[]: "ibe_cut_santander_desc"
	val[]: "Пристанището на Сантандер се намира на пешеходно разстояние от центъра на града.<br><br>Основано от римляните след Кантабрийските войни през 19 г. пр.н.е., защитеното пристанище на Сантандер започва като център за износ на минерали и се развива заедно с града, за чието създаване спомага."

	key[]: "ibe_cut_zaragoza_desc"
	val[]: "One of the largest shopping and leisure complexes in Europe, covering over 200,000 square metres.<br><br>Built around an artificial lake, the development combines a shopping centre with restaurants, cinemas, sports facilities and recreation areas."

	key[]: "sc_cut_mabodalen_desc"
	val[]: "Мободален е стръмна, издълбана от ледници долина близо до Ейдфьорд в Западна Норвегия, дом на водопада Вьорингсфосен.<br><br>Със спиращ дъха свободен пад от 145 метра в дълбините на Мободален, Вьорингсфосен е най-емблематичният водопад в Норвегия, привличащ посетители, за да станат свидетели на гръмотевичната му сила."

	key[]: "sc_cut_stockholm_desc"
	val[]: "Крайбрежието на Стокхолм се разкрива към архипелаг от около 30 000 острова, островчета и шкери, простиращ се в Балтийско море.<br><br>Небоядисаните вагони от метрото в Стокхолм „Silverpilen“, пуснати в експлоатация през 1965 г., вдъхновяват градска легенда за влак-призрак, който се появява в полунощ и кара всеки качил се пътник да изчезне."

	key[]: "sc_cut_kalmar_desc"
	val[]: "Калмар е исторически пристанищен град в югоизточна Швеция, споменат за първи път през XI век и дом на ренесансов замък.<br><br>Замъкът Калмар е устоял на 22 обсади през историята си, без никога да бъде превземан с щурм."

	key[]: "sc_cut_copenhagen_desc"
	val[]: "Копенхаген е столицата на Дания, построен около историческо пристанище, изпъстрено с канали, кули и пешеходни улици.<br><br>Градините „Тиволи“ в Копенхаген са дом на най-старото действащо увеселително влакче в Европа – Rutschebanen, което носи вълнение на посетителите си от 1914 г."

	key[]: "blkw_cut_durdevica_desc"
	val[]: "Националният парк „Дурмитор“ в Черна гора, обект на световното наследство на ЮНЕСКО, известен със своите скалисти планини, ледникови езера и каньона на река Тара, е дом на този бетонен мост с пет арки, завършен през 1940 г. и издигащ се на повече от 150 метра над реката.<br><br>Днес той е едно от най-популярните места за зиплайн на Балканите."

	key[]: "blkw_cut_durres_desc"
	val[]: "Дуръс, основан като гръцката колония Епидамнос през 627 г. пр. н. е., е най-старото и най-натовареното морско пристанище на Албания.<br><br>Римляните го превръщат в западната крайна точка на Виа Егнация – техния велик път, простиращ се чак до Солун."

	key[]: "blkw_cut_pristina_desc"
	val[]: "Прищина, столицата на Косово, се намира близо до руините на древната Улпиана и е населена още от неолита.<br><br>Към XIII век Прищина е важен кралски и търговски център в средновековната сръбска държава, преди османското владичество постепенно да се установи след 1389 г."

	key[]: "blkw_cut_split_desc"
	val[]: "Крайбрежната алея на Сплит се доминира от Двореца на Диоклециан и камбанарията на катедралата „Свети Домний“. Целият стар град е израснал в рамките на стените на двореца.<br><br>Римският император Диоклециан се оттегля в Сплит и се посвещава на отглеждането на зеле толкова сериозно, че отказва молбите да се върне на трона, заявявайки, че зеленчуците му са по-важни."

	key[]: "blkw_cut_bihac_desc"
	val[]: "Историческият център на Бихач включва запазената камбанария на „Свети Антоний“, Капитанската кула и каменния мавзолей „Турбе“. По-късно Капитанската кула е служила за австро-унгарски затвор. Църквата е до голяма степен разрушена от съюзническите бомбардировки през 1944 г.<br><br>И трите обекта се намират само на метри един от друг, отразявайки християнското, османското и австро-унгарското минало на Бихач."

	key[]: "blkw_cut_sarajevo_desc"
	val[]: "Това е най-старата и най-значима от историческа гледна точка част на Сараево. В сърцето ѝ се намира „Башчаршия“ – чаршийският квартал от османската епоха, основан през 1462 г. от управителя Иса-бег Исакович.<br><br>Кметството на Сараево, известно като „Виечница“, е емблематична сграда от австро-унгарската епоха, проектирана в неомавритански стил от чешкия архитект Карел Паржик."

	key[]: "blkw_cut_ljubljana_desc"
	val[]: "Любляна, столицата на Словения, се разраства покрай река Любляница на мястото на някогашното римско селище Емона.<br><br>Легендата гласи, че Ясон и аргонавтите убиват дракон на точното място, където днес се намира Любляна, и звярът все още властва върху герба на града."

	key[]: "blkw_cut_tirana_desc"
	val[]: "Тирана е основана през 1614 г. от османския владетел Сулейман Барджини. Тя става временна столица на Албания през 1920 г. и нейна постоянна столица през 1925 г.<br><br>„Ктеса е Камзъс“, един от основните западни транспортни възли на Тирана, свързва столицата с Камза и с пътищата, водещи на север и запад."

	key[]: "blkw_cut_prokuplje_desc"
	val[]: "Прокупле, административният център на Топлишкия окръг в Южна Сърбия, води произхода си от римското селище Хамеум.<br><br>Градът дава името си на „Прокупац“ – сорт червено грозде, който се отглежда в района още от Средновековието."

	key[]: "gr_cut_piraeus_desc"
	val[]: "Пирея е основното пристанище на Атина и едно от най-големите пътнически пристанища в Средиземно море.<br><br>Сградата на силоза първоначално е построена за съхранение на зърно. Днес тя се преустройва в Музей на подводните антики, който ще излага археологически находки, намерени в гръцките морета."

	key[]: "gr_cut_kavala_desc"
	val[]: "Кавала е исторически пристанищен град в Северна Гърция, основан в края на VII век пр. н. е. като Неаполис.<br><br>Хълмът е укрепен поне от V век пр. н. е. Днешната Крепост на Кавала е предимно османска, съградена отново през 1425 г. върху по-ранни византийски укрепления."

	key[]: "gr_cut_kalabaka_desc"
	val[]: "Метеора е манастирски комплекс, включен в списъка на световното наследство на ЮНЕСКО, кацнал върху пясъчникови скални стълбове близо до Калабака.<br><br>В продължение на векове монасите са изтегляли посетителите по 400-метровите скали в люлееща се въжена мрежа, шегувайки се, че тя се подменя едва когато се скъса."

	key[]: "gr_cut_beach_desc"
	val[]: "Фалираки е морски курорт на североизточното крайбрежие на Родос, на около 14 километра южно от град Родос, известен със своя дълъг пясъчен плаж.<br><br>Фалираки е един от най-популярните курорти на Родос за водни спортове – от каране на джет до парасейлинг високо над залива."

	key[]: "gr_cut_lixouri_desc"
	val[]: "Ликсури е вторият по големина град на Кефалония, построен на полуостров Палики близо до мястото на древния град Пале."

	key[]: "gr_cut_corinth_desc"
	val[]: "Коринтският канал прорязва Коринтския провлак, свързвайки Егейско море и Коринтския залив чрез 6,4-километров канал.<br><br>Римският император Нерон лично прави първата копка на канала през 67 г. сл. Хр., близо 1800 години преди той окончателно да бъде завършен през 1893 г."

	key[]: "gr_cut_souda_desc"
	val[]: "Заливът Суда близо до Ханя на остров Крит е едно от най-големите и най-дълбоките естествени пристанища в Средиземно море.<br><br>На входа на залива венецианците укрепват малкото островче Суда през Xvi век; крепостта му устоява на османските сили и остава венецианска до 1715 г., десетилетия след като останалата част от Крит пада през 1669 г."

	key[]: "gr_cut_polyfytos_desc"
	val[]: "Мостът „Полифитос“ пресича изкуственото езеро „Полифитос“ на река Алиакмонас, най-дългата река в Гърция, близо до Козани.<br><br>Завършен през 1975 г., 1372-метровият мост е проектиран от известния италиански инженер Рикардо Моранди."

	key[]: "poc_cut_alesund_desc"
	val[]: "Олесун е основен норвежки круизен пристанищен град.<br><br>Германският кайзер Вилхелм II, който преди това е посещавал града, изпраща военни кораби със строителни материали, за да помогне за възстановяването му, след като опустошителен пожар унищожава почти целия дървен град през 1904 г."

	key[]: "poc_cut_bodo_desc"
	val[]: "Бюдьо е крайбрежен град, разположен малко северно от Северния полярен кръг, който бе обявен за Европейска столица на културата през 2024 г."

	key[]: "poc_cut_nordkapp_desc"
	val[]: "Нордкап е 307-метрово скално плато на остров Магьорьой, рекламиран като най-северната точка на континентална Европа.<br><br>Всъщност Нордкап не е най-северната точка на Европа – близкият нос Кнившелроден се простира с около 1450 метра по-насевер."

	key[]: "poc_cut_santa_desc"
	val[]: "Селото на Дядо Коледа се намира точно на Северния полярен кръг, на около осем километра северно от Рованиеми, и работи целогодишно.<br><br>Посетителите могат да застанат върху изрисувана линия, маркираща Северния полярен кръг, и да получат официален сертификат, удостоверяващ, че са го преминали."

	key[]: "poc_cut_muotkatakka_desc"
	val[]: "Муоткатака, на около 12 километра южно от Килписярви, е най-високата точка от цялата пътна мрежа на Финландия със своите 565,8 метра.<br><br>Пътят през този проход свързва Финландия с Норвегия, а северните елени са честа гледка, бродещи точно покрай пътя близо до върха."

	key[]: "poc_cut_farm_desc"
	val[]: "Тохмаярви е малка община с гористи хълмове и езера в Северна Карелия, близо до източната граница на Финландия с Русия.<br><br>Гербът ѝ изобразява наковалня и пламък, напомняйки за някога важната за региона железодобивна промишленост."

	key[]: "poc_cut_viitasaari_desc"
	val[]: "Вийтасаари е изпъстрен с езера град в Централна Финландия, чиято общинска територия включва около 230 езера.<br><br>Летният музикален фестивал на Вийтасаари започва всяка година с парад на трактори, преминаващи през града преди концертите."

	key[]: "poc_cut_lalby_desc"
	val[]: "Лолбю е малко селце в състава на Кристинестад в област Остроботния на западното крайбрежие на Финландия."

	key[]: "poc_cut_kiruna_desc"
	val[]: "Кируна е най-северният град в Швеция, изграден около Кирунавара – най-голямата подземна мина за желязна руда в света.<br><br>Железнорудното тяло е изригнало от два километра под земята преди около 1,6 милиарда години, а днес мината осигурява около 80 процента от желязната руда в ЕС."

	key[]: "poc_cut_gavle_desc"
	val[]: "Йевле е пристанищен град на източното крайбрежие на Швеция при устието на река Гавлеон в област Йестрикланд.<br><br>Всеки Адвент от 1966 г. насам градът издига гигантски сламен коледен козел, който подпалвачи са изгаряли над 30 пъти."

	key[]: "poc_cut_lulea_desc"
	val[]: "Люлео, административният център на област Норботен, се намира на Ботническия залив и включва архипелаг от над 1300 острова.<br><br>Голяма технологична компания построи гигантски център за данни в Люлео именно защото суровият арктически студ служи като безплатен, естествен климатик за нейните сървъри."

	key[]: "poc_cut_heia_desc"
	val[]: "Живописна зона за отдих на автомагистрала E6 в Балсфьорд, Тромс, предлагаща планински гледки на около 240 метра надморска височина."

	key[]: "poc_cut_svolvaer_desc"
	val[]: "Сволвер, на остров Ауствагьоя, е най-големият град и неофициална столица на норвежкия архипелаг Лофотен."

	key[]: "poc_cut_bjornfjell_desc"
	val[]: "Бьорнфйел е планинска гара на железопътната линия „Офотен“, разположена точно на границата между Норвегия и Швеция близо до Нарвик.<br><br>Тъй като се намира толкова високо в планината, гара Бьорнфйел често е покрита със сняг през по-голямата част от годината, а железопътната линия тук се смята за едно от най-живописните пътувания с влак в Северна Европа."

	key[]: "poc_cut_trondheim_desc"
	val[]: "Тронхейм, основан около 997 г. под името Каупангър и известен по-късно като Нидарос, служи за столица на Норвегия през Епохата на викингите.<br><br>Катедралата му „Нидарос“, построена върху гроба на св. Олав, е най-северната средновековна готическа катедрала в света."

	key[]: "is_cut_thingvellir_desc"
	val[]: "Национален парк „Тингвелир“ се намира в рифтова долина между Северноамериканската и Евразийската тектонична плоча. През 2004 г. той става обект на световното наследство на ЮНЕСКО.<br><br>Парламентът на Исландия, Алтингът, се събира тук за първи път на открито през 930 г., което го прави един от най-старите парламенти в света."

	key[]: "is_cut_barthastran_desc"
	val[]: "Бардастрандарвегюр (път 62) следва крайбрежието Бардастранд в южните Вестфьорди, покрай северния бряг на широкия залив Брейдафьордур.<br><br>Викингът Храфна-Флоки Вилгердарсон прекарва една зима на това крайбрежие и след като вижда фьорд, пълен с плаващ лед от близката планина, дава името на цялата страна: Исландия."

	key[]: "is_cut_lagoon_desc"
	val[]: "Този геотермален Спа комплекс се намира в лавово поле на полуостров Рейкянес, където посетителите се отпускат в млечносиня вода със средна температура 37–39°C.<br><br>Лагуната е изкуствена: Спа центърът е основан, за да оползотворява топлата отпадна вода от близката геотермална електроцентрала, открита през 1976 г."

	key[]: "is_cut_selfoss_desc"
	val[]: "Селфос е най-големият град в Южна Исландия. Построен е на бреговете на река Йолфуса, която се сдобива с първия си висящ мост през 1891 г.<br><br>От 2011 г. Селфос е сред местата, които домакинстват на състезанието „Най-силният мъж на Исландия“, където гиганти в силата вдигат огромни камъни и теглят тежки камиони."

	key[]: "is_cut_seljaland_desc"
	val[]: "Селяландсфос е 60-метров водопад в Южна Исландия, захранван от река, която извира от ледниковия вулкан Ейяфялайокудъл.<br><br>Пешеходна пътека води точно зад падащата вода в малка пещера, така че посетителите могат да наблюдават водопада отвътре."

	key[]: "is_cut_geyser_desc"
	val[]: "Строкур, разположен в геотермалното поле Хаукадалур, е най-активният гейзер в Исландия, изригващ на всеки няколко минути.<br><br>Неговият съсед, Великият Гейсир, е дал името си на всички гейзери по света; то произлиза от исландския глагол geysa, означаващ „да се движа бързо напред“."

	key[]: "is_cut_gullfoss_desc"
	val[]: "Гулфос, известен още като „Златният водопад“, е водопад, разположен на река Хвита, който се спуска на две стъпала от 11 и 21 метра в дефиле с дълбочина 32 метра.<br><br>Когато чуждестранни инвеститори искали да използват водопада за производство на електроенергия, дъщерята на местен фермер, Сигридюр Томасдотир, повежда кампания за неговото опазване. Над водопада има каменен паметник в нейна чест."

	key[]: "is_cut_joekul_desc"
	val[]: "Йокулсарлон е ледникова лагуна в началото на Брейдамеркурьокудъл, изходящ ледник от обширната ледена шапка Ватнайокудъл.<br><br>Лагуната започва да се образува едва през 30-те години на Xx век с отстъпването на ледника, а с дълбочината си от над 280 метра днес е най-дълбокото езеро в Исландия."

	key[]: "is_cut_gothafoss_desc"
	val[]: "Годафос е водопад с височина 12 метра и ширина 30 метра на река Скяулфандафльот в Северна Исландия.<br><br>Името му обикновено се превежда като „водопад на боговете“, въпреки че може да произлиза от две скали при водопада, които приличат на езически идоли."

	key[]: "is_cut_canyon_desc"
	val[]: "Студлагил е каньон в долината Йокулдалур в Източна Исландия, обграден от високи шестоъгълни базалтови колони покрай река Йокла.<br><br>Каньонът е бил скрит под водата, докато язовирът „Карахнюкар“, завършен през 2009 г., не понижава нивото на реката, и става известен едва след като фотограф го споделя през 2016 г."
#@}

