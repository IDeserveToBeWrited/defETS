	key[]: "registered_game_list_fetch_failed"
	val[]: "Невъзможно зареждане на информация за свързаното съдържание." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Невъзможно зареждане на информация за използвания акаунт." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Отложи" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Невъзможно регистриране на допълнението. Моля, проверете настройките за Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

