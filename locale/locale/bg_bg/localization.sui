#@{

	key[]: "adjust_o_t"
	val[]: "НАСТРОЙКИ НА ПРЕВОЗНОТО СРЕДСТВО" #+ Title of the window. Please keep in upper case where possible.

	key[]: "adjust_link_t"
	val[]: "Настройки на превозното средство" #+ Icon opening the adjuster. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "lights"
	val[]: "Светлини" #+ Opens the light adjuster.

	key[]: "truck_light_help"
	val[]: "Настройте светлините, монтирани на вашия камион." #+ Help message associated with light adjuster icon.

	key[]: "mirrors"
	val[]: "Огледала" #+ Opens the mirror adjuster.

	key[]: "truck_mirror_help"
	val[]: "Настройте огледалата, за да подобрите видимостта." #+ Help message associated with mirror adjuster icon.

	key[]: "seat"
	val[]: "Седалки"  #+ Opens the seat adjuster.

	key[]: "truck_seat_help"
	val[]: "Настройте положението на шофьорската седалка и волана според вашите предпочитания." #+ Help message associated with seat adjuster icon.

	# trailer adjuster name string is in assistance section (it could be open from both screens)

	key[]: "trailer_adjust_help"
	val[]: "Настройте дължината и другите параметри на собственото ремарке, за да съответства на избрания товар. Отразява се върху офертите в Пазара за товари." #+ Help message associated with trailer adjuster icon.
#@}

#+ Mirrors Adjuster
#+
#+ Window for tweaking orientation of the mirrors.
#@{

	key[]: "mirror_adj_t"
	val[]: "НАСТРОЙКА НА ОГЛЕДАЛАТА" #+ Title of the window. Please keep in upper case where possible.

	key[]: "adj_left"
	val[]: "Ляво" #+ Checkbox selecting left mirror.

	key[]: "adj_hood"
	val[]: "Капак" #+ checkbox selecting one of the hood mirrors.

	key[]: "adj_right"
	val[]: "Дясно" #+ Checkbox selecting right mirror.

	key[]: "front"
	val[]: "Предно" #+ Checkbox selecting front mirror.

	key[]: "side"
	val[]: "Страничнo" #+ Checkbox selecting side mirror.

	key[]: "left_small"
	val[]: "Ляво изпъкнало" #+ Checkbox selecting small mirror on the left side.

	key[]: "right_small"
	val[]: "Десен изпъкнал" #+ Checkbox selecting small mirror on the right side.

	key[]: "mirror_camera_zoom"
	val[]: "Приближение"

	key[]: "mirror_camera_rotate"
	val[]: "Завъртете камерата"
#@}

#+ Light Adjuster
#+
#+ Window for tweaking state of various lights.
#@{

	key[]: "light_setting_t"
	val[]: "НАСТРОЙКА НА СВЕТЛИНИТЕ" #+ Title of the window. Please keep in upper case where possible.

	key[]: "park_lights"
	val[]: "Паркинг светлини" #+ Checkbox enabling the parking lights

	key[]: "low_beam"
	val[]: "Къси светлини" #+ Checkbox enabling the low beam lights

	key[]: "high_beam"
	val[]: "Дълги светлини" #+ Checkbox enabling the high beam lights

	key[]: "beacon"
	val[]: "Извънгабаритни светлини"  #+ Checkbox enabling the beacon

	key[]: "high_beam_set"
	val[]: "Допълнителни светлини" #+ Header of section for auxilliary ilumination

	key[]: "front_aux"
	val[]: "Предни помощни" #+ Checkbox enabling lights on additional front accessories.

	key[]: "roof_aux"
	val[]: "Покривни помощни" #+ Checkbox enabling lights on additional roof accessories.

	key[]: "dash_backlight"
	val[]: "Подсветка на таблото" #+ Label of slider controlling intensity of dashboard backlight.
#@}


#+ Seat Adjuster
#+
#+ Window for tweaking seat position.
#@{

	key[]: "seat_adj_t"
	val[]: "НАСТРОЙКА НА СЕДАЛКИТЕ" #+ Title of the window. Please keep in upper case where possible.

	key[]: "seat_tilt"
	val[]: "Накланяне" #+ Checkbox selecting head tilt.

	key[]: "seat_pan"
	val[]: "Фокусиране" #+ Checkbox selecting head pan.

	key[]: "seat_rotate"
	val[]: "Завъртане" #+ Checkbox selecting head rotation.

	key[]: "seat_position"
	val[]: "Позиция за сядане" #+ Checkbox selecting seat position.

	key[]: "seat_fov"
	val[]: "Поле на видимост" #+ Checkbox selecting fov.

	key[]: "steering_tilt"
	val[]: "Наклон на волана" #+ Checkbox selecting steering wheel tilt.

	key[]: "steering_telescope"
	val[]: "Настройка на волана" #+ Checkbox selecting steering wheel telescoping.
#@}

#+ Adjuster common
#+
#+ Common strings used in windows tweaking seat, mirror and lights.
#@{
	key[]: "reset_defaults_single"
	val[]: "Нулиране на избраното" #+ Button which applies the default configuration for only selected option controlled by screen.

	key[]: "reset_defaults_all"
	val[]: "Нулиране на всички" #+ Button which applies the default configuration to the state controlled by screen.
#@}

	key[]: "exit"
	val[]: "Затвори" #+ Label near button which will close the adjuster panel.


	key[]: "drive"
	val[]: "Шофиране" #+ Button switching from desktop to the game. Note that the space for this is limited so keep as short as possible.

	key[]: "drive_tooltip"
	val[]: "Обратно на мястото на шофьора." #+ Explanation of the button for switching to the desktop. There is more leniency in the translation character limit.

