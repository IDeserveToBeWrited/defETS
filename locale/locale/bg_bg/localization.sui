#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Възникна грешка при зареждане на съдържанието от Steam Инвентар.<br><br>$ERROR$<br><br>Натиснете 'Продължи', за да оставите включено съдържанието. Периодически играта ще го търси.<br><br>Можете временно да го изключите, за да избегнете подобни грешки като тази. То ще бъде включено автоматично при следващото стартиране на играта." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Невъзможно зареждане на предмети от Steam Инвентар." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM ИНВЕНТАР" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Зареждане на предмети от Steam Инвентар..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "НАМЕРЕНИ НОВИ ПРЕДМЕТИ В ИНВЕНТАРА" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
