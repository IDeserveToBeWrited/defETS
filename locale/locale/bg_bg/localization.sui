#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "ГРАФИКА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Графика" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Регулирайте графичните настройки с помощта на фино настроени предварително зададени настройки, за да приспособите визуалното представяне на вашата игра според вашите предпочитания."

	key[]: "apply"
	val[]: "Приложи" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Фон на работния плот" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ЕКРАН" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "КАЧЕСТВО НА ИЗОБРАЖЕНИЕТО" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "ТЕКСТУРИ" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "ОТРАЖЕНИЯ" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "СЕНКИ" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ОСВЕТЛЕНИЕ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "ПОСЛЕДВАЩА ОБРАБОТКА" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ОКОЛНА СРЕДА" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Режим на цял екран" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Яркост / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Настройки" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Резолюция" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Честота на опресняване" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Ограничение на кадрите в секунда" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Ограничение на кадрите в секунда във фонов режим" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "По подразбиране" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Вертикална синхронизация" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Икономичен режим (за лаптопи)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ОСНОВНИ ГРАФИЧНИ НАСТРОЙКИ" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ПОТРЕБИТЕЛСКИТЕ НАСТРОЙКИ СА ПРИЛОЖЕНИ" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "РАЗШИРЕНИ ПОТРЕБИТЕЛСКИ НАСТРОЙКИ" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Превключване между страницата с опростени и разширени графични настройки" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Скриване на разширените настройки" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Показване на разширени настройки" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Мащабиране" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Изглаждане (AA)" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Изостряне на Luma TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Настройка на TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Адаптивно качество на картината" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Винаги изгладено" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Винаги изострено" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Засенчване на пространствата около обектите (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Висок динамичен диапазон (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Дълбочина на рязкост (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Слънчеви лъчи" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Корекция на цветовете" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Мащаб на отраженията" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Качество на отраженията" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Качество на растителността" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Гъстота на тревата" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Качество на сенките"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Размер на текстурата за сянка" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Сенки в далечината" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Интериорни сенки" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Качество на времето"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Качество на огледалата" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Резолюция на огледалата" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Видимост в огледалата" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Качество на текстурите" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Анизотропна филтрирация" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Релефно текстуриране" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Светлини от трафика" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Допълнителни светлини от автомобилите" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Обсег на видимостта на светлините" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Изобразяване на пешеходци" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Графичните настройки бяха изменени.<br>Искате ли да запазите промените?"

	key[]: "reverting_in"
	val[]: "Възстановяване на предишните след" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "секунди" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "При включване, играта ще се показва на цял екран."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Регулира общата яркост на играта според вашия дисплей. На HDR-съвместими дисплеи в тази настройка ще бъде достъпна и опцията за HDR калибриране."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Настройка на разделителната способност на играта."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Настройка на честота на опресняване на играта."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Съпоставя честотата на кадрите с честотата на опресняване на монитора, за да предотврати накъсване на екрана. Икономичната настройка също така намалява наполовина честотата на кадрите, което води до по-ниска консумация на енергия."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Задава максималната позволена скорост на кадрите за играта.<br><br>Задаването на стойност на 0 ще изключи функцията."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Задава максималната позволена скорост на кадрите за играта.<br><br>Задаването на стойност на 0 ще изключи функцията."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Превключва между опростени графични настройки (профили с настройки) или разширени графични настройки (с възможност за промяна на индивидуални параметри)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Подобрява графичната прецизност, като рендира играта с по-висока вътрешна резолюция, което намалява назъбените ръбове и подобрява детайлите.<br>Например, избирането на опция за по-високо мащабиране води до по-ясна картина с по-малко размазване, което прави играта да изглежда по-добре като цяло, но за сметка на производителността.<br><br><color value=@@clr_txt_d@@>Тази настройка често има голямо влияние върху производителността."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Избор от високоскоростни методи за анти-алиасинг, които изглаждат появата на назъбени ръбове в играта:<br>- SMAA семплира всеки пиксел многократно (в зависимост от избраното качество) на различни места в кадъра и осреднява семплите, за да се получи крайната картина.<br>- TAA семплира всеки пиксел само веднъж на кадър, но ги семплира на различни места и в различни кадри.<br>- За най-добър резултат можете да изберете и комбинация от двете, за сметка на производителността.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено въздействие върху производителността."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Добавя меки сенки към пукнатини и обекти, които са в непосредствена близост един до друг, подобрявайки възприеманата графична прецизност на целия свят в играта.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено въздействие върху производителността."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Избор на предварително зададени настройки за TAA:<br>- „Винаги мек“ ще доведе до по-малко трептене/повече размазване - подходящо е за потребители на компютри, които активират суперсемплиране или имат монитор с висока DPI, но също така и за потребители на 1080p телевизори, които седят по-далеч от екрана си.<br>- „Винаги остър“ води до повече трептене/по-малко размазване - вероятно е най-добрият вариант за употреба с под 1080p, като например лаптопи или Steam Deck.<br>- „Адаптивна яснота“ динамично деактивира трептенето на TAA, когато камерата е статична.<br><br><color value=@@clr_txt_d@@>Тази настройка може да се използва само когато TAA е избрано като решение за анти-алиасинг."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира силата на изостряне на яркостта на TAA.<br><br><color value=@@clr_txt_d@@>Тази настройка може да се използва само когато TAA е избрано като решение за анти-алиасинг."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Когато е активирано, отдалечените зони на картата може да бъдат изкуствено замъглени, за да се създаде реалистично отпадане на фокуса на заден план."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Когато е активирано, светлинните лъчи може да се виждат, когато гледате слънцето или гледате слънцето през предмети като дървета, сгради или превозни средства."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Когато е активирано, цветовете на играта се коригират динамично по естетически причини. Сцените ще съответстват по-добре на времето от деня и метеорологичните условия, цветовете на превозните средства и други обекти може да са по-живи и т. н."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Подобрява отраженията, като ги рендира с по-високо качество вътрешно, както и използва по-добро антиалиасинг.<br><br><color value=@@clr_txt_d@@>Промените в тази настройка ще влязат в сила само след ръчно рестартиране на играта."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Настройва детайлите на отраженията, наблюдавани върху повърхностите на превозните средства, прозорците и други отразяващи повърхности, като локви, мокри пътища и открити водни басейни.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено влияние върху производителността.<br><br>Промените в тази настройка ще влязат в сила само след ръчно рестартиране на играта."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Настройва детайлите и сложността на растенията и дърветата.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено въздействие върху производителността."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира гъстотата на тревата, която се вижда отстрани на пътя.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено въздействие върху производителността."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира качеството на сенките, хвърляни от слънцето или луната.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено влияние върху производителността."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Позволява изобразяване на сенки дори от много отдалечени обекти.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено влияние върху производителността."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables night-time dynamic shadows in the vehicle interior.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира качеството на метеорологичните ефекти, като например отражения."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира качеството на отраженията, виждани в огледалата на превозното средство (независимо от настройките за отражение).<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено влияние върху производителността."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира разделителната способност на изображението, изобразено на огледалата на вашия автомобил."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира разстоянието, на което обектите започват да се рендират в огледалото.<br><br><color value=@@clr_txt_d@@>Тази настройка често има голямо влияние върху производителността."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Настройва качеството на някои текстури, приложени към обекти и повърхности в играта."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Подобрява остротата на текстурите, особено тези, гледани от разстояние или под наклон.<br><br><color value=@@clr_txt_d@@>Промените в тази настройка ще влязат в сила само след ръчно рестартиране на играта."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Добавя геометрични детайли към тротоари, пътища и други обекти, за да подобри външния им вид.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено влияние върху производителността.<br><br>Промените в тази настройка ще влязат в сила само след ръчно рестартиране на играта."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Позволява осветяване от фарове на други превозни средства в движението."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Позволява осветяване от вторични светлини на други превозни средства в трафика, като мигачи, спирачки и др."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Регулира разстоянието, от което могат да се видят изкуствените източници на светлина.<br><br><color value=@@clr_txt_d@@>Тази настройка обикновено има умерено влияние върху производителността."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Позволява пешеходци в света на играта."
