#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Избира подтипа на контролера за играта, за да обработва правилно диапазоните на въвеждане."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Избери вида на трансмисията:<br>- „Прост автоматик“ позволява използването на педала на газта и спирачката за управление на движенията напред и назад.<br>- „Истински автоматик“ изисква превключване между предавки напред и назад.<br>- „Последователна“ изисква ръчно превключване на всички предавки с въвеждане на предавка нагоре/надолу.<br>- „H-Shifter“ изисква използването на контролер с превключватели за превключване за избор предавки ръчно."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Променя логиката на превключване на предавките на автоматичната скоростна кутия.<br> -Режимът \"Икономичен\" предпочита по-ниски обороти, насочени към върховия въртящ момент.<br> -Режимът \"Мощност\" ще се насочи към върховите конски сили за по-добра управляемост при тежки товари или планински терен за сметка на икономията на гориво."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Регулира съотношението на степента на въртене на устройството към действителната степен на въртене на волана на автомобила."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Регулира линейността между входните данни и управлението на превозното средство.<br><br>Регулирането на тази стойност по-високо означава, че воланът ще бъде по-малко отзивчив, когато воланът е в центъра, и ще увеличи чувствителността си, когато воланът е завъртян към максимално заключване. Това може да е полезно за изглаждане на волана при движение направо."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Активира принудителна обратна връзка в контролери, които я поддържат."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Регулира общото усилване за всички настройки за силова обратна връзка между 0N и 10N.<br><br><color value=@@clr_txt_d@@>Имайте предвид, че регулирането на тази стойност на по-висока стойност при мощни междуосия може да причини нараняване на пръстите или ръцете."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на центриране при шофиране с висока скорост, която достига пикове при 90 км/ч (56 мили в час) и повече.<br><br> Минималната настройка няма да доведе до центрираща сила на волана."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на центриране при движение с ниска скорост.<br><br> Минималната настройка няма да доведе до центрираща сила на волана."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на изкуственото вътрешно триене, причинено от механичните компоненти на кормилното управление."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на изкуствения резонанс на двигателя през кормилната колона.<br><br><color value=@@clr_txt_d@@>Имайте предвид, че задаването на тази стойност над 15% може да причини прекомерно треперене и вибрации в някои колела."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на ефектите върху пътната настилка чрез кормилната колона.<br><br><color value=@@clr_txt_d@@>Имайте предвид, че задаването на тази стойност над 20% може да причини прекомерно треперене и вибрации в някои колела при шофиране по неравен терен с висока скорост."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на ефектите на неравностите на пътя през кормилната колона."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Регулира силата на ефектите от сблъсък през кормилната колона."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Регулира интензивността на ефектите на износване на скоростната кутия."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Регулира интензивността на ефектите на приплъзване при недозавиване."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Регулира интензивността на подпомаганото управление (напр. когато използвате функцията за асистент за лентата.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Регулира интензитета на вибрациите на повърхността на терена, ако контролерът поддържа вибрационна обратна връзка."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Регулира интензитета на вибрациите при удари, ако контролерът поддържа вибрационна обратна връзка."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Регулира интензитета на вибрациите при сблъсък, ако контролерът поддържа вибрационна обратна връзка."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Оста на устройството, която ще се използва за управление."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Регулира мъртвата зона на оста на управление; степента на завъртане от центъра, при което въвеждането се игнорира.<br><br> Това може да смекчи проблемите от по-стари контролери, като неточност или грешно въвеждане, причинено от износване."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Определя как играта обработва въвеждането на оста на управление.<br>- Центриран е идеален за колела или джойстици.<br>- Обърната се използва за коригиране на ос, която е била открита погрешно."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Оста на устройството, която ще се използва за ускоряване на превозното средство."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Регулира мъртвата зона на оста на ускорение; размерът на входния ход, при който не е регистриран вход.<br><br> Това може да смекчи проблемите от по-стари контролери, като неточност или грешно въвеждане, причинено от износване."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Определя как играта обработва въвеждането на контролера.<br>- Центриран е идеален за джойстици.<br>- Нормален е идеално за спусъци или педали.<br>- Обърнат може да компенсира входове, които са били открити неправилно."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Оста на устройството, която ще се използва за спиране."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Регулира мъртвата зона на спирачната ос; размерът на входния ход, при който не е регистриран вход.<br><br> Това може да смекчи проблемите от по-стари контролери, като неточност или грешно въвеждане, причинено от износване."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Определя как играта обработва въвеждането на контролера.<br>- Центриран е идеален за джойстици.<br>- Нормален е идеално за спусъци или педали.<br>- Обърнат може да компенсира входове, които са били открити неправилно."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Оста на устройството, която ще се използва за задействане на съединителя."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Регулира мъртвата зона на спирачната ос; размерът на входния ход, при който не е регистриран вход.<br><br> Това може да смекчи проблемите от по-стари контролери, като неточност или грешно въвеждане, причинено от износване."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Определя как играта обработва въвеждането на контролера.<br>- Центриран е идеален за джойстици.<br>- Нормален е идеално за спусъци или педали.<br>- Обърнат може да компенсира входове, които са били открити неправилно."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Регулира обхвата на съединителя.<br><br> Колкото по-надясно зададете обхвата, толкова по-далеч ще трябва да натиснете педала, за да включите съединителя."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Оста на устройството, която ще се използва за накланяне на камерата нагоре и надолу."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Коригира мъртвата зона на оста Поглед нагоре-надолу; размерът на входния ход, при който не е регистриран вход.<br><br> Това може да смекчи проблемите от по-стари контролери, като неточност или грешно въвеждане, причинено от износване."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Определя как играта обработва въвеждането на оста.<br>- Центриран е идеален за джойстици.<br>- Обърнат се използва за коригиране на ос, която е била открита погрешно."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Оста на устройството, която ще се използва за панорамиране на камерата наляво и надясно."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Коригира мъртвата зона на оста на поглед ляво-дясно; размерът на входния ход, при който не е регистриран вход.<br><br> Това може да смекчи проблемите от по-стари контролери, като неточност или грешно въвеждане, причинено от износване."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Определя как играта обработва въвеждането на оста.<br>- Центриран е идеален за джойстици.<br>- Обърнат се използва за коригиране на ос, която е била открита погрешно."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Избира оформлението на предавките, което да се използва с H-Shifter."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Променя поведението на скоростния лост.<br>- С опцията \"Прост\" никога няма да къртите предавките при превключване.<br>- Опцията „Прост + предупредителен звук“ също ще ви позволи да превключвате лесно, но със скърцане на зъбни колела, когато превключвате неправилно.<br>- Опцията \"Разширено\" няма да ви позволи да сменяте предавките, ако превключите неправилно, и ще бъдете посрещнати само със звуци от скърцане на предавките. Опцията „Разширени“ също ви позволява да използвате настройката „бързо разделяне на превключвателя“."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Изберете как играта да обработва бързото разделяне на предавките:<br>- „Никога“ ще изисква скоростният лост да бъде преместен в неутрално положение между разделянията.<br>- „Натискане на съединителя“ изисква моментно натискане на съединителя без движение на скоростния лост.<br>- „Освобождаване на газта“ изисква водачът да пусне газта само за разделяне на предавки без движение на скоростния лост и „съединител или дросел\" е комбинация от последните две."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Задава позицията на скоростния лост."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Задава входа, използван за превключване между диапазони въз основа на оформлението на превключвателя."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Засава бутон за превключване на разделителя на скоростния лост въз основа на оформлението на скоростния лост."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Активирайте, когато използвате превключватели вместо бутони за входове за обхват или разделител."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Задава бутон за превключване в режим Шофиране на автоматичната трансмисия."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Задава бутон за превключване на режим Задна предавка на автоматичната скоростна кутия."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Активира динамична RGB обратна връзка на съвместими устройства."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Активира и конфигурира функции за проследяване на очите за съвместими устройства."
#@}

#@}

#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "ПРОСЛЕДЯВАНЕ НА ПОГЛЕД" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Настройки за Еxtended View" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Профили за Extended View" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Име на профила" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Наистина ли искате да изтриете избрания профил?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Профил с това име вече съществува и ще бъде презаписан. Искате ли да продължите?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Настройки за проследяване на погледа" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Настройки за проследяване на главата" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Настройки на клавиатурата" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Включване на Еxtended View" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Автоматично връщане в центъра" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Режим на проследяване на главата" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Пряк" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Динамичен" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Отзивчивост при проследяването на погледа" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Отзивчивост при проследяването на главата" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Проследяване при наклон" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Проследяване на положения" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Фактор на завъртане (в кабината)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Фактор на накланяне (в кабината)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Фактор на завъртане (в режим свободен оглед)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Фактор на накланяне (в режим свободен оглед)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Максимален ъгъл на погледа" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Скорост на проследяване на погледа"

	key[]: "eye_gaze_exponent"
	val[]: "Степен на проследяване на погледа"

	key[]: "eye_gaze_inflection_point"
	val[]: "Модулационна точка на проследяване на погледа"

	key[]: "eye_gaze_start_point"
	val[]: "Начална точка на проследяване на погледа"

	key[]: "eye_gaze_end_point"
	val[]: "Крайна точка на проследяване на погледа"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Чувствителност на завъртане на главата (в кабината)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Чувствителност на накланяне на главата (в кабината)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Чувствителност на завъртане на главата (в режим свободен оглед)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Чувствителност на накланяне на главата (в режим свободен оглед)"

	key[]: "eye_head_exponent"
	val[]: "Степен на проследяване на главата"

	key[]: "eye_head_inflection_point"
	val[]: "Модулационна точка на проследяване на главата"

	key[]: "eye_head_start_point"
	val[]: "Начална точка на проследяване на главата"

	key[]: "eye_head_end_point"
	val[]: "Крайна точка на проследяване на главата"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Активира разширен изглед, който увеличава вашия ъгъл на видимост чрез използване на движение на главата и/или очите за управление на камерата в играта."

	key[]: "eye_preset_op_tooltip"
	val[]: "Избор на предварителни настройки за разширен изглед."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Избор на режими за проследяване на главата.<br>- В режим \"Директно\" въртенето на главата ви директно съответства на въртенето на камерата в играта. Препоръчва се в нормални ситуации в кокпита/каютата.<br>- В режим \"Динамичен\" вашият поглед ще засегне камерата ви в играта само когато наистина обърнете главата си. Препоръчително е, когато е важно изгледът ви да е абсолютно центриран."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Когато е активирана, камерата в играта непрекъснато бавно ще се центрира, докато променяте естествената позиция на главата си по време на игра."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Когато е активирано, позицията на главата ви влияе върху позицията на камерата в играта."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Когато е активирана, камерата в играта ще се наклони съответно, когато наклоните главата си на всяка страна."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Умножава комбинираното въртене на главата и погледа в хоризонтална посока (в кабината)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Умножава комбинираното въртене на главата и погледа във вертикална посока (в кабината)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Умножава комбинираното завъртане на главата и погледа в хоризонтална посока (в режим на ходене)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Умножава комбинираното въртене на главата и погледа във вертикална посока (в режим на ходене)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Регулира колко бързо камерата в играта ще реагира на движенията на погледа ви."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Регулира постепенното нарастване на скоростта."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Регулира разстоянието от центъра на екрана, където ускорението ще започне да се изравнява."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Регулира колко далеч от центъра на екрана ще трябва да погледнете, преди камерата в играта да започне да се движи."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Регулира колко далеч от центъра на екрана трябва да гледате, за да достигнете максимална скорост на камерата."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Определя колко далеч може да се завърти камерата, когато погледнете към краищата на екрана."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Регулира колко бързо камерата в играта ще реагира на движенията на главата ви."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Регулира доколко камерата в играта ще се завърти наляво или надясно в сравнение с това колко завъртате главата си (в кабината)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Регулира доколко камерата в играта ще се завърти нагоре или надолу в сравнение с това колко завъртате главата си (в кабината)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Регулира доколко камерата в играта ще се завърти наляво или надясно в сравнение с това колко завъртате главата си (в режим на ходене)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Регулира доколко камерата в играта ще се завърти нагоре или надолу в сравнение с това колко завъртате главата си (в режим на ходене)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Регулира постепенното нарастване на скоростта."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Регулира колко трябва да завъртите главата си, преди ускорението да започне да се изравнява."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Регулира колко трябва да завъртите главата си от централната позиция, преди камерата в играта да започне да се движи."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Регулира колко трябва да завъртите главата си от централната позиция, за да постигнете максимално завъртане на камерата."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Избор на режими на автопауза."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Регулира времето в милисекунди, преди играта автоматично да спре на пауза, когато не може да разпознае погледа ви."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Присвоява бутон, който задава текущата ви позиция на главата като нова позиция по подразбиране, като съответно центрира отново камерата в играта."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Присвоява клавиш, който превключва/изключва всички функции на разширен изглед на Tobii."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Присвоява клавиш, който отваря настройките за проследяване на очите."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Присвоява клавиш, който активира проследяването на главата."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Присвоява клавиш за прилагане на съответния предварително зададен разширен изглед."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Присвоява клавиш за прилагане на съответния предварително зададен разширен изглед."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Присвоява клавиш за прилагане на съответния предварително зададен разширен изглед."
