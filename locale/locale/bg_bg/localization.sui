	key[]: "td_msg_bought_sent"
	val[]: "Благодарим Ви за покупката. Ще доставим чисто новия Ви камион до Вашия гараж в $CITY$ веднага."

	key[]: "td_msg_bought_assigned2"
	val[]: "Благодарим Ви за покупката. Наслаждавайте се на новия си камион!"

	key[]: "td_msg_nospace"
