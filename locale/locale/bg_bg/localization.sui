#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Файловият размер на снимката е твърде голям. Моля, опитайте да намалите резолюцията в настройките на играта." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Несъвместим формат или повреден файл." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Резолюцията на снимката е твърде голяма. Моля, опитайте да намалите резолюцията в настройките на играта." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Отхвърлено качване на снимката от услугата." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Използваният профил не разполага с права за качване на снимки." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Имаше едновременно качване на изображение на това място." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
