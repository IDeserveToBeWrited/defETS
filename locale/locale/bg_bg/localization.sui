	key[]: "vehicle_accessory"
	val[]: "Автомобилни аксесоари" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Аксесоари в кабината" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Фон на работения плот" #+ Name of the inventory items category.

	key[]: "item_paint_job"
