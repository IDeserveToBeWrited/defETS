	key[]: "force_feedback_gain"
	val[]: "Обща сила на обратната връзка" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "Връщане на волана при висока скорост" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "Връщане на волана при ниска скорост" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "Вътрешно триене" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "Резонанс на двигателя" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "Повърхност под колелата" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "Неравности" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "Сблъсъци" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "Сила на скоростната кутия" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "Плъзгане при недозавиване" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "Асистирано управление" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "Вибрация от повърхности" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "Вибрация от неравности" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Вибрация от сблъсъци" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

