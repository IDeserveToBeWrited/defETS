	val[]: "Позволява звук на звуков сигнал при движение на заден ход с вашия камион. Силата на звука може да се регулира с помощта на плъзгача „Ефекти на камиона“.<br><br>Когато е вклчен, ще чувате и резервния звуков сигнал на други играчи, когато сте в конвойна сесия."

	key[]: "rumble_stripe_sound_op_tooltip" # - Audio, Advanced
	val[]: "Позволяване на звук от тътен на лентите при шофиране над тях."

	key[]: "noise_window_op_tooltip" # - Audio, Advanced
	val[]: "Активира допълнителен шум от въздушния поток през прозорците, когато те са отворени.<br><br><color value=@@clr_txt_d@@>Изисква „Шум от въздушния поток“ да бъде активирано, за да функционира."

	key[]: "noise_aero_op_tooltip" # - Audio, Advanced
	val[]: "Активира шума от въздушния поток около кабината на вашето превозно средство."

	key[]: "reverb_cabin_op_tooltip" # - Audio, Advanced
	val[]: "Enables reverb effect of your vehicle's cabin."

	key[]: "reverb_world_op_tooltip" # - Audio, Advanced
	val[]: "Позволяване на реверберационен ефект на звуците от околната среда."

	key[]: "inactive_app_sound_op_tooltip" # - Audio, Advanced
	val[]: "Когато е активирано, всички звуци от играта ще продължат да се чуват дори когато играта е минимизирана във фонов режим."

	key[]: "audio_driver_op_tooltip" # - Audio, Advanced
	val[]: "Избира от кой аудио устройсто да се възпроизвеждат звуците."
#@}

