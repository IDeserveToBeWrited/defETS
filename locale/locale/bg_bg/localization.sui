#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Продължи ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Добре дошли в Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Най-накрая имате възможността да се почувствате като шофьор на тежкотоварен камион!"

	key[]: "intro_3"
	val[]: "Макар вече да сте горд собственик на транспортна компания, все още нямате достатъчно пари, за да си купите собствен камион. Засега ще трябва да работите като наемен шофьор."

	key[]: "intro_4"
	val[]: "Вашата първа задача е да доставите товар от $JOB_CARGO$ до компания $JOB_TARGET_COMPANY$ в град $JOB_TARGET_CITY$. Работодателят ви е осигурил камион и ще поеме всички разходи. Постарайте се да го доставите навреме."


	key[]: "intro_garage_1"
	val[]: "Това е вашата щабквартира."

	key[]: "intro_garage_2"
	val[]: "Това е обикновен гараж. Може да не е нещо особено, но като за начало е добре."

	key[]: "intro_garage_3"
	val[]: "За съжаление, точно сега нямате какво да паркирате вътре."

	key[]: "intro_garage_4"
	val[]: "Когато заработите достатъчно пари и си купите камион, ще може да шофирате навсякъде по света и да развивате свой собствен бизнес."

	key[]: "intro_garage_5"
	val[]: "Успех!"


	key[]: "desktop_tut_t"
	val[]: "ОТКЛЮЧЕНИ ФУНКЦИЯТА"

	key[]: "desktop_tut_job"
	val[]: "Избрете следваща поръчка"

	key[]: "desktop_tut_cargo_market"
	val[]: "Използвайте новото си ремарке, за да изпълнявате доставки от Пазара за товари." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Тук може да видите вашите текущи резултати."

	key[]: "desktop_tut_company"
	val[]: "Наблюдавайте гаражите, наемайте нови шофьори и управлявайте вашата компания от тук."

	key[]: "desktop_tut_trailers"
	val[]: "Оттук насетне, можете да закупувате собствени ремаркета, да ги подобрявате и/или пребоядисвате.<br><br>Притежаваните ремаркета могат да бъдат паркирани в избран от вас гараж. Отделно, те могат да бъдат използвани от вашите шофьори, за да увеличите приходите си. За да управлявате вашите ремаркета, използвайте меню Моите ремаркета."

	key[]: "desktop_tut_visit_directive"
	val[]: "Посетете $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "ДОБРЕ ДОШЛИ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Добре дошли в новия начален екран<br>Оттук можете да работите с всички функции в играта."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Главното меню по-долу предоставя директен достъп до всички основни функции на играта, с които сте запознати."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "В горната част новата лента на състоянието осигурява постоянна видимост на полезна статистика за профила на играча и местните разпоредби за пътуване."

	key[]: "desktop_tut_tour_home"
	val[]: "Бутонът Начало е винаги там, за да ви върне на началния екран."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Постоянното бързо меню предоставя удобен бърз достъп до всички функции на играта от всеки екран."

	key[]: "desktop_tut_tour_drive"
	val[]: "Актуализираният бутон Шофиране остава вашата връзка със света на шофирането, готов да ви върне обратно на пътя."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "ВЪВЕДЕНИЕТО ВЗАВЪРШИ"

	key[]: "desktop_tut_tour_finish"
	val[]: "Благодарим ви, че прегледахте нашата актуализация на началния екран."
