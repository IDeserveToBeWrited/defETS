	key[]: "connect_selected_content"
	val[]: "Свързване" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "Засечено ново игрово съдържание от World of Trucks. За да получите достъп до съдържанието, трябва да се свържете с платформата World of Trucks." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Интернет" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Управление на настройките, свързани с платформата World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Наистина ли искате да отложите регистрацията?<br><br>Може да завършите процеса по-късно от раздел Интернет в настройките на играта." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "СВЪРЗВАНЕ НА СЪДЪРЖАНИЕ" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Свързване на съдържание..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Неуспешно свързване на съдържание: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Използваният при регистрацията на допълнението профил в Steam се отличава от този, който сте използвали за създаването на вашия профил в World of Trucks или регистрирането на играта. Моля, сменете своя Steam профил и опитайте пак." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Използваният при регистрацията на допълнението профил в Steam вече е свързан с друг World of Trucks профил. За да регистрирате допълнението към текущия профил, трябва да използвате Steam профил, който не е свързан с World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token идентификаторът е изтекъл. Моля, опитайте отново по-късно." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Използаният за активацията на допълнението сериен номер е неправилен. Моля, свържете се с отдела по поддръжка: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Възникна вътрешна грешка по време на регистрирането на играта. Моля, опитайте отново по-късно." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "ЗАВЪРШЕН ПРОЦЕС" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "ИНФОРМАЦИЯ" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ИНТЕРНЕТ" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "ПРЕГЛЕД НА СЪДЪРЖАНИЕ" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Поздравления! Избраните допълнения бяха успешно свързани с вашия профил в World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Невъзможно свързване на съдържание. Текущият Steam профил е свързан с друг World of Trucks профил." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Неуспешно свързване на някои допълнения.<br>Посочете удивителния знак срещу името на всяко допълнение, за да видите подробна информация." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Регистриране на съдържанието $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Текущият профил не е свързан със World of Trucks или играта работи в офлайн режим. Редактирайте профила, за да се свържете." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Кликнете, за да отхвърлите"

	key[]: "online_connect_content_info"
	val[]: "Свързани съвместими допълнения <color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ Ако някои допълнения не са свързани с World of Trucks, няма да може да се възползвате от част от предоставените от тях възможности." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Поздравления! <color value=@@clr_txt@@>Всички допълнения бяха свързани с World of Trucks." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Не е възможно свързването на новото съдържание с World of Trucks. Текущият Steam акаунт не отговаря на Steam акаунта, използван при регистрацията на Вашия акаунт в World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Свързано" #+ The state of the content that is connected.

