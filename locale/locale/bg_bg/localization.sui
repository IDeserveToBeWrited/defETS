	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Използвайте @@imm_wiz_dsteerleft@@ и @@imm_wiz_dsteerright@@, за да завивате."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Поместете мишката в съответната посока наляво или надясно, за да завъртите волана."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Използвайте @@ima_wiz_j_steer@@, за да завивате."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Използвайте @@imm_wiz_dforward@@, за да се движите напред и @@imm_wiz_dbackward@@, за да се движите назад."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Поместете @@ima_wiz_j_throttle@@ напред, за да се движите напред и назад, за да се движите назад и спрете."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Използвайте @@ima_wiz_j_throttle@@, за да се движите напред и @@ima_wiz_j_brake@@, за да се движите назад и спрете."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Използвайте @@imm_wiz_dforward@@, за да ускорите и @@imm_wiz_dbackward@@, за да спрете."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Поместете @@ima_wiz_j_throttle@@ напред, за да се ускорите и назад, за да спрете."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Използвайте @@ima_wiz_j_throttle@@, за да ускорите и @@ima_wiz_j_brake@@, за да спрете."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Използвайте @@imv_wiz_gearup@@, за да превключите предавка нагоре и @@imv_wiz_geardown@@, за да превключите предавка надолу."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Използвайте @@imv_wiz_gearup@@, за да превключите предавка нагоре и @@imv_wiz_geardown@@, за да превключите предавка надолу, ако използвате клавиатура или бутоните на контролер. Използвайте @@imv_wiz_drive@@ и @@imv_wiz_reverse@@, за да изберете посоката на движение, ако използвате превключване на предавките с делител."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Използвайте @@imv_wiz_gearup@@ и @@imv_wiz_geardown@@, за да изберете желаната предавка."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Използвайте превключвателя на скоростите и @@ima_wiz_j_clutch@@, за да изберете желаната предавка."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "НАСТРОЙКА НА ОСИТЕ НА КОНТРОЛЕРА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Визуализация на оси"

	key[]: "wiz_setup_axes_desc"
	val[]: "Визуализация на оси."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Настройка на осите"

	key[]: "wiz_setup_axes_desc2"
	val[]: "За да изберете ос, щракнете върху бутона до името на оста. Това ще ви превключи в режим на въвеждане. След това използвайте вашия контролер, за да свържете избраната ос, като преместите лоста, колелото или педала към избраната от вас ос."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Мъртви зони"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Мъртвата зона се отнася до зона на ос, умишлено проектирана да не предоставя вход. За да регулирате мъртвата зона на избрана ос, преместете съответния плъзгач. Увеличаването на плъзгача надясно ще увеличи мъртвата зона. Тази функция е особено полезна за по-стари контролери, тъй като определянето на по-голяма мъртва зона може да смекчи проблеми като неточност или грешно въвеждане, причинено от износване на хардуера."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Режими на осите"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Режимът на оста определя как се работи в играта. Обърнатата ос обръща отчетената си посока, което води до завиване наляво вместо надясно, например. Центрираната ос има позиция по подразбиране в средата на обхвата си, като например в джойстик. Този режим е полезен за коригиране на ос, която е била открита неправилно."

	key[]: "normal"
	val[]: "Нормална" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Обърната" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Центрирана" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Обърната и центрирана" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "НАСТРОЙКА НА АВТОМАТИЧНА СКОРОСТНА КУТИЯ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "При автоматичната скоростна кутия, трябва да превключвате между само три режима: напред, неутрална и назад. За целта, може да използвате предварително зададените клавиши и бутони на контролер. За да промените подредбата, щракнете върху бутон и натиснете клавиша или бутона на контролера, който да изпълнява действието."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ако сте свързали устройство с превключвател на предавки, може да го използвате като истински превключвател на скорости на автоматична скоростна кутия. Чрез включването на тази опция, може да определите положенията за режими напред и назад, докато всички останали положения ще се смятат за режим неутрална. За да промените предназначението, щракнете върху бутон, преместете скоростния лост в желаното положение, а след това върнете в неутрално. Тази настройка е създадена специално за устройства с превключвател на предавки и не работи с клавиши и бутони или друг тип такива."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "НАСТРОЙКА НА СЕКВЕНЦИАЛНА СКОРОСТНА КУТИЯ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Секвенциалната скоростна кутия позволява да сменяте предавките в последователен ред. Имате на разположение предварително зададени клавиши и бутони за превключване между високите и ниските предавки. За да промените предназначението, щракнете бутона и натиснете клавиш или бутон на контролер, който искате да изпълнява това действие."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "НАСТРОЙКА НА СКОРОСТНАТА КУТИЯ H-SHIFTER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Тук може да настроите начина на работа на ръчната скоростна кутия с делител и да я изпробвате. На изображението може да видите текущото положение на лоста, както и избраната предавка. Тъй като скоростна кутия има повече предавки от положенията на лоста, ще трябва да използвате бутоните на делителя и демултипликатора, за да сменяте поредиците и реда на предавките."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "На схемата може да видите текущото положение на лоста и превключвателя. За да промените зададената настройка, щракнете върху съответния бутон, преместете лоста в желаното положение, а след това го върнете в неутрално."
#@}

