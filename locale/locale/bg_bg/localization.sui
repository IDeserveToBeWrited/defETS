#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Мрежата е недостъпна. Моля, проверете дали настройките на клиента са зададени правилно."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Не може да бъде установена връзка с интернет услугата. Проверете дали вашата интернет връзка е наред."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Възникна грешка при свързването с интернет услугата. Моля, опитайте отново по-късно."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Интернет услугата върна неверни данни. Ако използвате HTTP прокси, проверете неговите настройките. В противен случай, опитайте отново по-късно."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Интернет услугата върна неверни данни. Моля, опитайте отново по-късно."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Услугата е несъвместима с текущата версия на играта. Моля, проверете за наличието на ново обновление на играта."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Услугата е недостъпна в момента. Моля, опитайте отново по-късно."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Услугата подлежи на обновяване или е претоварена в момента. Моля, опитайте отново по-късно."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Въведената информация за вход е невярна. Моля, опитайте отново."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Потребителският профил е заключен поради множество неправилни опити за вход. Моля, опитайте отново след половин час."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Потребителският профил е заключен поради подозрителни опити за вход. Моля, опитайте отново след 24 часа."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Играта не е регистрирана към потребителския профил."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Потребителският профил не е активиран. Моля, проверете вашата електронна поща за получено писмо с инструкции за активация."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Потребителският профил е преустановен. Моля, свържете се с техническа поддръжка."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Потребителският профил е блокиран. Моля, свържете се с техническа поддръжка."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Методът на удостоверяване през прокси не се поддържа. Моля, използвайте друг тип прокси или директна интернет връзка."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Необходимият обект е недостъпен към момента. Моля, опитайте отново след няколко минути."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL грешка. Неуспешно свързване чрез защитена връзка."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Играта беше прекъсната по време на онлайн връзката. Моля, опитайте отново по-късно."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Възникна вътрешна грешка. Подробна информация може да намерите в net.log файла."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 има проблем и не може да рисува графики на вашия компютър (не е намерено валидно графично устройство).\nПрепоръчителни стъпки:\n\n1. Уверете се, че вашият компютър отговаря на минималните изисквания на играта.\n2. Инсталирайте най-новата версия на Microsoft DirectX.\n3. Изтеглете и инсталирайте най-новите драйвери за вашата видео карта от страницата на производителя. Най-вероятно използвате остаряла версия.\n4. Опитайте да промените метода за изобразяване на графиката от OpenGL на DirectX или обратно.\n5. Изтрийте конфигурационния файл 'config.cfg', намиращ се в  'Documents' - 'Euro Truck Simulator 2', той може би е повреден.\n    Този файл ще бъде създаден автоматично с правилните стойности по подразбиране при следващото стартиране на играта."

	key[]: "sys_no_graphics_simple"
	val[]: "Играта Euro Truck Simulator 2 срещна проблем и не е в състояние да възпроизведе графичните елементи на Вашия компютър (не е намерено съвместим графично устройство)."
#@}

