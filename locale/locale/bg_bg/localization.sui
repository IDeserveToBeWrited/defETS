	key[]: "trailer_parking_diff_easy"
	val[]: "Безопасно паркиране" #+ Low difficulty parking option

	key[]: "trailer_parking_diff_hard"
	val[]: "Опитно паркиране" #+ High difficulty parking option

	key[]: "trailer_parking_diff_random"
	val[]: "Случайно паркиране" #+ Random difficulty parking options
#@}

#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Набор от динамични фонове, които се показват при превключването на менютата в играта."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Избиране на динамичен фон на случаен принцип при всяко стартиране на играта."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Определя забавянето, след което елементите на работния плот се скриват."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е включена, с течение на времето ще започнете да изпитвате ефекта на умората.<br><br>Избягването на почивка ще доведе до нарушения на пътя."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирана, трябва да спазвате правилата за движение, иначе рискувате да получите нарушения. Рискът се увеличава в близост до полицейски превозни средства, радари и пътни камери."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Определя средната продължителност на предлаганите доставки."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Изберете коя скоростна граница да се показва в навигацията."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Текущата скорост в навигацията става червена, когато ограничението е превишено."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато пристигнете в дестинацията си, ще се появи уиджет, който ви позволява да пропуснете паркирането."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Остави уиджетите скрити."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Оставя и двете HUD огледала скрити."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Запазва всички известия скрити, дори когато са получени."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Показва прозорец с характеристиките на текущия камион на играча преди започването на доставка на тежък товар."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Изберете как да бъде подравнена картата на света."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Изберете как да се открива картата на света:<br>„Откриване при приближаване“ отбелязва по-голяма зона като открита.<br>„Прецизно откриване“ разкрива само зоните непосредствено около играча."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Режим на показване на навигацията."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя начина, по който се изчислява пътя от навигацията:<br>- Навигационният режим „Най-добър“ избира най-ефективното съотношение между дължина и време на маршрута, опитва се да избягва кръстовища със светофари и т. н.<br>- Навигационният режим „Най-кратък“ винаги избира най-краткия възможен маршрут.<br>- Навигационният режим „Малки пътища“ избира да избягва магистрали, когато е възможно."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Промени вашата трудност при паркиране:<br>- „Винаги избирай“ ви позволява да изберете кога да стигнете до вашата дестинация.<br>- „Безопасно паркиране“ не изисква маневри за заден ход.<br>- „Умело паркиране“ обикновено изисква по-предизвикателна маневра за заден ход."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Коригира вероятността да срещнете опасности по пътя в близост до вас, включително злополуки, неработещи превозни средства, отломки по пътя и др."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Коригира вероятността да се сблъскате с промяна на маршрута, докато изпълнявате доставка."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Коригирайте вероятността от лошо време."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете дали информацията за часовата зона да се показва в допълнение към текущия час."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Активира анимациите в играта, които се появяват след покупка на камион, подобряване на гараж или при качване на пътници."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете дали полупрозрачните блокери да се показват на пътища, до които няма достъп."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Обръща оста Y на мишката при управление на камерата по време на игра."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Избери вида на трансмисията:<br>- „Прост автоматик“ позволява използването на педала на газта и спирачката за управление на движенията напред и назад.<br>- „Истински автоматик“ изисква превключване между предавки напред и назад.<br>- „Последователна“ изисква ръчно превключване на всички предавки с въвеждане на предавка нагоре/надолу.<br>- „H-Shifter“ изисква използването на контролер с превключватели за превключване за избор предавки ръчно."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Активирането на тази функция ще позволи \"пропускане на предавките\" - прескачане на предавки, когато е необходимо или практично, за да се избегне прецакването на всяка предавка в трансмисията."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Връща волана в центъра, когато се използва клавиатура или контролер.<br><br>Деактивирането на тази функция означава, че ще трябва ръчно да се върнете в центъра след завой."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Регулира обхвата на анимацията на волана. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя интензивността на спирачките."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes stability of the vehicle by lowering its centre of gravity."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя стабилността на ремаркето чрез понижаване на центъра на тежестта му."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Changes intensity of the torque generated from the driveline.<br><br>Raising this setting will increase the feeling of the vehicle \"twisting\" to the right."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя твърдостта на окачването на шасито."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя твърдостта на окачването на кабината/спалното място."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Регулира интензитета на процедурно генерираните повърхностни неравности, за да придаде на пътищата и другите терени усещане за несъвършенство.<br><br>В зависимост от другите настройки на окачването и камерата, възприеманият ефект може да бъде повече или по-малко забележим."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Позволява усъвършенствано свързване, което изисква по-голяма прецизност за подравняване на петото колело на камиона с щифта на ремаркето.<br><br> Когато е деактивирано, прикачването на ремарке става много по-лесно, тъй като няма сблъсък между щифта и петото колело."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Избира дали и кои кабели на ремаркето да се анимират.<br><br><color value=@@clr_txt_d@@>Активирането на кабели на повече превозни средства може да повлияе на производителността на по-стари системи."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Активира електронния ограничител на скоростта на камиона от 90 км/ч (56 мили/ч).<br><br><color value=@@clr_txt_d@@>За заданията в World of Trucks тази функция е постоянно включена."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирано и чистачките на предното стъкло са настроени на първа позиция, чистачките автоматично ще се включат и ще регулират скоростта си според условията."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Позволява автоматично включване на ретардер при спиране."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е активирана, системата подпомага потеглянето по наклон чрез задържане на спирачките, осигурявайки плавен старт."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Позволява автоматично задействане на спирачката на двигателя при спиране."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е разрешено, двигателят ще стартира веднага след натискане на педала на газта."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Автоматично спускане на повдигащи се оси, когато е необходимо в зависимост от теглото на автомобила."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е активирана, превозното средство ще поддържа по-ниска степен на газта по подразбиране. След бързо двукратно натискане на бутона за газ, превозното средство ще поддържа пълна газ, докато бутонът не бъде отпуснат."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Симулира реални загуби на въздух от прекомерни натискания на спирачките.<br><br> Когато е активирано, ще трябва да управлявате налягането на въздуха, когато се спускате по хълмове или правите бавни маневри с множество задействания на спирачката."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "При изключена опция разходът на гориво не се влияе от стила на шофиране или пътните условия.<br><br>При включена опция разходът на гориво се влияе от няколко фактора, сред които стил на шофиране, тегло на товара, съпротивление при търкаляне и релеф на терена. Той вече не зависи от умението @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е активиран, ABS ще предотврати блокиране на колелата, за да запази контрола и да подобри спирачната способност."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will lock the differential if wheels begin to slip to improve traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя стъпката на скоростта, с която круиз контролът ще се увеличи или намали, когато се натисне съответният бутон."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя толеранса на круиз контрола за поддържане на зададената скорост."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е активиран, круиз контролът автоматично ще регулира скоростта, за да поддържа безопасно разстояние до превозното средство отпред."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Активира аварийно спиране, ако системата усети неизбежен сблъсък.<br> Изберете дали системата ще реагира само на превозни средства или на всички препятствия."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selection of lane assistant modes:<br>- The \"Lane departure warning\" mode audibly warns you when you are about to leave the lane.<br>- In addition to the audible warning, the \"Lane keep support\" also automatically steers your vehicle to keep it from leaving the lane.<br><br>Both modes are only active at speeds above 55 km/h (~35 mph).<br>The Lane Assistant also considers your usage of the turn signals before engaging."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Enables the blind spot sensor functions, if your vehicle is equipped with it."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирана и фаровете са настроени на първа позиция, фаровете ще се включват автоматично при слабо осветление."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирано и фаровете са включени с включени дълги светлини, превозното средство автоматично ще затъмни дългите светлини, когато засече насрещно превозно средство или превозно средство близо отпред."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активиранa, индикаторите автоматично ще се отменят след завой, когато воланът се върне обратно в центъра."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Когато са активиранa, някои интериорни аксесоари реагират на физическото движение на автомобила (висящи декорации, глави и др.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Разрешава отклонение от посоката на посоката на вътрешната камера въз основа на въвеждане на волана."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя колко реактивна е функцията „завъртане на камерата за кормилно управление“ към входа на кормилното управление. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя поведението на функцията \"завъртане на камерата за управление\" при движение на заден ход."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е активирана, вътрешната камера гледа наляво или надясно въз основа на използването на индикатора."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Когато е активирана, вътрешната камера реагира на движението на автомобила."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя доколко вътрешната камера реагира на движението на автомобила."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Променя колко е позволено да се върти вътрешната камера въз основа на движението на превозното средство."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Задава закъснението, преди камерата да се центрира автоматично.<br><br> Превозното средство трябва да се движи с незначителна скорост, за да се активира това. Прилага се само за вътрешна и преследваща камера, докато се движите напред, и за наклонена навън камера, докато се движите назад."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Задава скоростта на движение на камерата. Използва се от автоматично центриране на камерата и превключване между предварително зададени настройки на вътрешна камера."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Определя начина на работа на вътрешното мащабиране: задръжте бутона за временно приближаване или натиснете веднъж, за да го превключите." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Избира езика, който да се показва в цялата игра."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Променя предварителните настройки на тока и единиците въз основа на избрания регион."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирано, градовете и държавите ще се показват на избрания от вас език."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирано, градовете и държавите ще се показват както на избрания от вас език, така и на родния език за този регион на картата."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете коя валута да използвате."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете между 12-часов или 24-часов режим на времето."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете кои единици за разстояние да се показват."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете кои единици за тегло да се показват."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете кои температурни единици да се показват."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете кои единици за налягане да се показват."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете кои единици за обем да се показват."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Изберете кои единици за разход на гориво да се показват."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирано, използването на клавиша „Активиране“ (@@imv_nrm_activate@@) ще отвори чата по време на сесии на Конвой."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирана, лентата за въвеждане на чат ще остане активна след изпращане на съобщение."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Когато е активирано, съобщенията в чата ще избледняват няколко секунди след всяко съобщение."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Променя продължителността на показване на съобщенията в чата, преди да се скрият."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
