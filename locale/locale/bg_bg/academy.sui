	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "В този сценарий ще разгледаме как да се обърнете в тясно пространство с маневра за заден ход от мъртва страна. Това умение ще ви бъде от полза, когато не можете да направите обратен завой или да влезете обратно от страната на шофьора."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Пътната маркировка ще ви помогне да се ориентирате в курса на обучение."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Направете широк завой, за да се уверите, че вашето ремарке ще освободи паркираните камиони."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Докато излизате от завоя, помислете как ще подготвите камиона за вашата маневра на заден ход."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Това ще помогне да поставите камиона под ъгъл, насочен към празното място за паркиране от страната на пътника, където ще се движите на заден ход."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Когато е възможно, трябва да се избягва заден ход през задната част, тъй като видимостта е значително намалена. За съжаление има моменти, когато няма да имате друг избор, освен да го направите."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Завъртете волана преди заден ход. Това ще ви помогне веднага да насочите трейлъра си там, където искате, което помага в много трудни ситуации."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "След като ремаркето е добре на мястото, поставете камиона пред ремаркето и го изправете."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Спрете, след като се изправите и имате достатъчно място да дръпнете отново напред. Започнете да се връщате по същия път, по който сте влезли."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Следвайте пътната маркировка извън тренировъчното трасе."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Карайте през завоя отпред и продължете до обозначената зона."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Спиране."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Обезопасете камиона и изключете двигателя."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Пред вас е зона, представляваща парцел на корабна компания. Вашата задача е да влезете и да обърнете камиона, за да излезете обратно. Не забравяйте да използвате добре пространството около вас.<br><br><font face=/font/big_bold.font>Подгответе се да потеглите </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Продължете към курса на обучение. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Завийте зад ъгъла и продължете през курса. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Следвайте пътната маркировка до бариерата в края на трасето. Паркирайте малко под ъгъл, така че ремаркето ви да е насочено към празното място за паркиране от страната на пътника ви.<br><br><font face=/font/big_bold.font>Продължете напред. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Имате много по-ограничен поглед върху това, което се случва около вас, когато сте слепи. Карайте бавно, използвайте огледалата си и бъдете внимателни.<br><br><font face=/font/big_bold.font>Започнете да карате на заден ход и завъртете ремаркето на празното място за паркиране. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Това е достатъчно далеч. Вече можете да продължите напред и да излезете от тренировъчната площадка от същата посока, от която сте дошли.<br><br><font face=/font/big_bold.font>Започнете да се насочвате към изхода. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Излезте от обучителния курс. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Следвайте пътната маркировка до последното място за паркиране.<br><br><font face=/font/big_bold.font>Продължете до обозначената зона. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
