	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Добре дошли на финалния изпит. Подготвили сме няколко реалистични ситуации, с които бихте могли да се сблъскате на пътя, за да проверим как ще се справите с тях. Както винаги – не бързайте и бъдете прецизни.<br><br>Успех!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Пътят напред е блокиран; обърнете в предвиденото за целта пространство."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Продължете да карате по пътя."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Достигнете скорост от поне 60 км/ч (37 мили в час), докато се спускате по наклона."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Подготовка за спиране."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Не успяхте да достигнете скорост от 60 км/ч (37 мили в час)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Продължете шофирането по трасето."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "На реда от камиони вдясно има място за вас. Влезте на заден ход и паркирайте."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Продължете напред, когато сте готови."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
