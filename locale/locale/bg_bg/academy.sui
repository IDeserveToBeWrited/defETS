#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Комбинирани маневри за шофиране"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "В този сценарий ние ще комбинираме вашите новоусвоени умения, за да преговаряте по кратък, но техничен курс, който ще включва завиване на заден ход и управление на тесен 90-градусов завой."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Заден ход от страната на водача"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "90 градусов завой"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Завършване на завоя"
