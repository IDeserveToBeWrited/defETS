#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Заобикаляне на бариерите"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Предстоят различни сложни завои и препятствия.<br>Вземете под внимание всичко, което сте научили досега и не би трябвало да е твърде трудно."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Пътната маркировка може да ви помогне да разберете как да преминете през всеки набор от препятствия."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Дръжте трактора от външната страна на ъгъла. <br>Ще трябва да се завъртите широко, тъй като ремаркето следва по-къс път."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Следващият завой е лесен завой на 90 градуса. <br> Още веднъж дръжте камиона от външната страна на завоя и използвайте цялото налично за вас пространство."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Отделете време тук. Курсът се отваря, но все пак ще трябва да сте прецизни."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Поддържайте широко легло около бариерите."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Внимавайте, когато влизате в този тесен участък. <br>Развъртете широко трактора, преди да влезете, за да подготвите ремаркето си за влизане."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Последният завой на 90 градуса е много по-остър от първия, но има достатъчно място, ако използвате пространството си разумно."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Спрете на определеното място, след това обезопасете камиона и изключете двигателя."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Не забравяйте да използвате пътната маркировка, за да ви помогне да се ориентирате по трасето.<br><br><font face=/font/big_bold.font>Пригответе се да потеглите. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Използването на вашите огледала също ще ви помогне да навигирате безопасно по трасето. Винаги трябва да сте наясно как трейлърът върви зад вас.<br><br><font face=/font/big_bold.font>Продължете през първия ъгъл. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Наблюдавайте ремаркето, докато излизате от завоя и се подгответе да влезете в следващия.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Продължете през следващия завой. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Не забравяйте да наблюдавате ремаркето си, за да сте сигурни, че сте далеч от препятствията около вас, преди да обърнете камиона.<br><br><font face=/font/big_bold.font>Продължете да заобиколите препятствието отпред. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Когато ремаркето ви излезе от бариерата, завийте силно към страната на пътника, за да се подредите за тесния проход. <br><br><font face=/font/big_bold.font>Продължете към тесния проход.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Този участък ще изисква много прецизно каране. Отделете време и използвайте огледалата си.<br><br><font face=/font/big_bold.font>Стойте към външната страна на всеки ъгъл. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Този завой е много остър, но можете да използвате цялото пространство пред вас, за да го изчистите лесно.<br><br><font face=/font/big_bold.font>Направете последния завой. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

