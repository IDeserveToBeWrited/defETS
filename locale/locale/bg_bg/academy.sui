	key[]: "aca_goal_book1_2_01_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
	key[]: "aca_goal_book1_2_01_end"
	val[]: "Обезопасяване на превозното средство"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "В този сценарий ще вземем влекача за кратко шофиране през слалом, направен от конуси."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Шофирайте внимателно и внимавайте за заобикалящата ви среда. Дръжте под око двете страни на камиона и не забравяйте да използвате огледалата, за да ви помогнат да се ориентирате по трасето."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "Трасето става по-стегнато към края, така че прецизността е ключова."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Паркирайте на определеното място и обезопасете камиона."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "За да завършите този сценарий, трябва да обиколите всички конуси, без да удряте нито един от тях. <br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_activate@@ за потвърждение. </font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Използвайте огледалата си, за да поддържате видимост от двете страни на камиона.<br><br>За страната на пътника предните и страничните огледала могат да бъдат много полезни, за да се ориентирате.<br><br><font face=/font /big_bold.font>Натиснете @@imv_nrm_activate@@ за потвърждение.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Регулирайте огледалата си, ако е необходимо, в '@@adjust_link_t@@' (достъп до него чрез менюто за пауза).<br><br><font face=/font/big_bold.font>Пригответе се да потеглите. </font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "Камионът все още не е готов за движение, може би сте забравили нещо?<br><br>Двигателят включен ли е? Освободихте ли ръчната спирачка?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Продължете бавно напред и карайте през слалома. </font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Продължете около конусите. Обърнете специално внимание на страната на пътника.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Продължете да се движите на зиг и заг през слалома, без да удряте конуси. </font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Спрете в обозначената зона. </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Обезопасете камиона и изключете двигателя. </font>"
#@}

