#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Добре дошли в Академията за шофиране@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Следващите сценарии представляват първата стъпка от вашето пътуване към професионалното шофиране на камион."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Тук ще научите всичко от основните системи и органи за управление на камиона..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...за сложни маневри със и без ремарке."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Ние ще ви помогнем да създадете навици, които ще ви помогнат да се справяте безопасно в различни ситуации,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "и ще ви научи да използвате разумно наличното пространство за ефективно маневриране на вашия камион."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Като изпълните всички сценарии и издържите финалните изпити,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "ще бъдете готови да тръгнете по пътищата на Европа и да намерите нови предизвикателства, пред които да се изправите."

#@}

