#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Заден ход с ремарке"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "В този сценарий ще опитате да карате на заден ход с ремарке за първи път. Това е доста проста маневра, но все пак ще трябва да управлявате правилно, за да поставите ремаркето в правилната позиция."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Заден ход към ремарке"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Свързване на ремарке"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Освобождаване на ръчната спирачка"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Заден ход с ремарке"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Продължете към мястото за паркиране"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Нека се пробваме на заден ход с ремарке. По-лесно е отколкото изглежда; просто трябва да сте търпеливи."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Започнете да се движите на заден ход и приведете камиона в една линия с ремаркето."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Уверете се, че сте подредени правилно, или няма да можете да направите връзката. Ако не е правилно, винаги можете да дръпнете напред и да опитате отново."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Петото колело на камиона ще се фиксира върху болта на ремаркето."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Поставете ръчната спирачка и свържете ремаркето. В реалния живот ще трябва да излезете от камиона, за да свържете въздушните и електрическите линии и да вдигнете колесника, но тук ние ще направим това вместо вас."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Ремаркето винаги ще завива <color value=@@clr_sel@@>срещу <color value=@@clr_txt@@>на камиона."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>За да завъртите ремаркето, ще трябва да насочите камиона в <color value=@@clr_sel@@> посоката, противоположна на <color value=@@clr_txt@@>, в която искате ремаркето върви към."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>За да изправите отново ремаркето, завъртете камуина <br><color value=@@clr_sel@@>към<color value=@@clr_txt@@> ремаркето."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Опитайте се да останете подравнени с ремаркето - ще трябва да правите постоянни дребни корекции, за да поддържате ремаркето насочено към маркираната зона."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Коригирайте отклоненията от пътя си с малки завъртания на волана веднага щом се случат. Ако го насочите прекалено много, можете да се окажете далеч извън желания от вас път."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Спрете на определеното място, след това обезопасете камиона и изключете двигателя."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Зад вас и от страната на пътника ще видите ремарке. Първата ви задача ще бъде да отидете на заден ход.<br><br><font face=/font/big_bold.font>Подгответе камиона за заден ход. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Започнете да карате на заден ход към ремаркето. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Подравнете се така, че да сте направо с ремаркето. Петото колело трябва да хване кралския болт. Издърпайте напред, за да коригирате, ако е необходимо.<br><br><font face=/font/big_bold.font>Продължете да се движите назад, докато усетите връзка. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Петото колело се е свързало с болта и сте готови да завършите скачването към ремаркето.<br><br><font face=/font/big_bold.font>Задействайте ръчната спирачка. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Натиснете @@imv_nrm_attach@@, за да свържете ремеркето. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Сега ремаркето е здраво свързано с камиона, въздушните и електрическите линии са свързани и подпорите са повдигнати.<br><br><font face=/font/big_bold.font>Освободете ръчната спирачка. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Трябва да дадете на заден ход на мястото за паркиране точно зад вас. Не забравяйте, че ремаркето ще се завърти в посока, обратна на посоката, в която управлявате трактора. Леко завъртане на волана може да доведе до значително движение на ремаркето.<br><br><font face=/font/big_bold.font>Започнете да движите ремаркето на заден ход. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Не прекалявайте, просто се опитайте да държите ремаркето подравнено с мястото. <br><br><font face=/font/big_bold.font>Продължете към мястото за паркиране. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

