	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Шофиране на писта за управление"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "В този сценарий ще караме на писта, предназначена да тества способността ви да управлявате камиона през различни видове завои и завои."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Влизане в курса"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Направете постепенен ляв завой"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Шофиране през С-образни завои"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Прав участък"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Лесни завои"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Излизане от курса на обучение"

	key[]: "aca_goal_book1_2_08_check7"
