#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Шофиране през трудни завои"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "В този сценарий ще изследваме маневрирането на ремаркето през кратка писта с препятствия с по-трудни завои."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Първи завои"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Шофиране през тесен проход"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Остър завой на 90 градуса"
