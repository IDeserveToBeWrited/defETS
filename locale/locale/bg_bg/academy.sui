	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Паркирайте на заден ход на мястото."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Спрете в обозначената зона."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Обезопасете камиона и изключете двигателя."
