#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Полигон за заден ход"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "В този сценарий ще се намирате на празен паркинг, за да упражнявате движение на заден ход с двойна композиция."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Първи стъпки"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Експериментиране"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Приключване"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Завършване на сценария"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Движението на заден ход с двойни ремаркета изисква много повече внимание, отколкото с едно ремарке. Трябва да планирате предварително накъде искате да отиде задното ремарке, като същевременно контролирате предното ремарке и влекача.<br><br>Представете си го така – трябва да използвате предното ремарке, за да насочвате задното."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "В този случай искаме да насочим задното ремарке към страната на шофьора. За да го насочим по този начин, трябва да избутаме предната част на задното ремарке към страната на пътника.<br><br>Обърнете внимание, че това на практика означава следното: трябва да завъртите предното ремарке в посока, обратна на желаната за задното ремарке."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Щом задното ремарке започне да завива, от съществено значение е да изправите влекача спрямо предното ремарке. Именно тук повечето хора допускат първата си грешка."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Тук виждаме, че шофьорът не е успял да последва предното ремарке и е на път да „сгъне“ ремаркетата си."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "„Сгъването“ се получава, когато ъгълът между кои да е две части от композицията достигне около 90 градуса. Случи ли се това, ситуацията не може да бъде спасена – трябва да потеглите напред и да опитате отново.<br><br>Както и при движение на заден ход с едно ремарке, целта винаги е да се уверите, че всички колела на ремаркетата се въртят. Щом колелата спрат и ремаркето започне да се върти на място, не можете да продължите."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Можете да потеглите напред до момента, в който за последно бяхте в правилна позиция, или по-скоро до място, откъдето можете да продължите маневрата на заден ход, без да допуснете същата грешка отново.<br><br>В този случай ще изтеглим композицията напред, докато се изправи, и ще опитаме отново отначало."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Отново, щом задното ремарке започне да завива, изправете влекача пред предното ремарке и оставете задното да завива само за момент."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Сега, след като задното ремарке завива накъдето искаме, е време да насочим предното ремарке да го последва. Можете да регулирате ъгъла между предното и задното ремарке, за да контролирате завоя и да го направите по-остър или по-широк."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Финалната част от маневрата е изправянето на цялата композиция. Подравнете предното ремарке със задното."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Трябва да имате предвид времето, необходимо за преместване на предното ремарке – ако чакате твърде дълго, задното ремарке ще тръгне обратно натам, откъдето току-що сте дошли!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Чувствайте се свободни да останете тук колкото искате; експериментирайте с различни маневри, докато добиете обща представа как да управлявате ремаркетата на заден ход.<br><br>Но най-важното – не забравяйте да се забавлявате!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Подгответе се за потегляне."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Използвайте този паркинг, за да добиете усет за управлението на ремаркетата на заден ход.<br><br>@@aca_goal_tip@@ Начинаещ сте в маневрите на заден ход? Препоръчваме ви да изиграете „Основи на шофирането на камион“."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Отделете си колкото време искате за практика.<br><br>Когато прецените, че сте готови, можете да спрете и да обезопасите камиона, за да приключите сценария."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Изключете двигателя, за да приключите сценария."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Паркиране в тясно пространство"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "В този сценарий задачата Ви е да паркирате двойна композиция в тясно пространство."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Първи стъпки"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Потегляне"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Продължете да шофирате"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Спиране"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Обезопасяване на превозното средство"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Шофирането с двойни ремаркета може да изглежда плашещо, но не се различава много от това с едно ремарке – просто трябва да съобразите и траекторията на задното ремарке!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Пред Вас има тясно паркомясто. Няма да имате достатъчно пространство, за да изправите напълно композицията преди влизане, така че трябва внимателно да прецените как да вкарате и двете ремаркета вътре."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Завийте веднага към далечната страна на паркомястото и подминете значително мястото, където обикновено бихте завили."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Сега, след като задното ремарке е в правилната траектория, можете да се насочите към паркомястото; само се уверете, че отново минавате през далечната страна, за да помогнете на предното ремарке да се завърти."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Продължете да влизате в паркомястото и двете ремаркета ще Ви последват и ще се изправят в движение."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Паркирайте на определеното място и обезопасете камиона."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Подгответе се за потегляне."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Продължете напред и влезте в тясното пространство."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Продължете да шофирате."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Спрете в обозначената зона."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Обезопасете камиона и изключете двигателя."
#@}


