	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Спиране близо до препятствие"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "В този сценарий ще говорим за предното огледало - неговото местоположение и как да го използвате ефективно, за да спрете близо до препятствие отпред."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Проверете предното огледало"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Разбиране на неговата функция"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Спиране близо до препятствието"
