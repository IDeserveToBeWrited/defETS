#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "За последния сценарий на тази глава ще караме на тестовата писта със сложна конфигурация."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Първото препятствие е слалом през бариери. Карайте през него и не забравяйте да използвате огледалата си."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Следва обратен завой. Дръжте завоя си широк и това не би трябвало да ви създава проблеми."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Тук има ляв завой на 90 градуса. Не забравяйте да карате дълбоко, така че задната част на камиона да изчисти вътрешните бариери."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Препятствието на рампата може да бъде малко сложно. Подредете се възможно най-добре, преди да шофирате върху него и използвайте предните и страничните огледала, за да се ориентирате."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Следващият раздел трябва да се направи в обратен ред. Подхождайте към бариерите пред себе си с това предвид."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Следвайте пътната маркировка назад и вдясно от вас."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Обърнете се към бариерите, след това спрете и продължете напред наляво."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Продължете през прекъсването в медианата към следващата секция."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Този проход през конусите е много тесен. Карайте бавно и използвайте огледалата си, за да се ориентирате в прохода."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Не забравяй да завиваш навътре при завои на 90 градуса."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Навлизате в хубав открит участък от пътя. Можете да увеличите малко скорост, но имайте предвид, че скоро ще трябва да намалите за кривата напред."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "В подножието на хълма има няколко бариери по пътя. Карайте до тях, след това на заден ход до мястото за паркиране вляво."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "На заден ход до мястото за паркиране."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Паркирайте, след това изключете двигателя и обезопасете камиона."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Пред вас е слалом, направен от бариери.<br><br><font face=/font/big_bold.font>Карайте през слалома.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Придържайте се към външната страна на завоя, за да сте сигурни, че задната част на трактора няма да премине през бордюра.<br><br><font face=/font/big_bold.font>Направете завоя. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Приближавате се до 90 градусов ляв завой. Не забравяйте да използвате цялото пространство, което имате.<br><br><font face=/font/big_bold.font>Направете завоя. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Подравнете се с рампата. Няма много място за корекции, след като сте на него.<br><br><font face=/font/big_bold.font>Карайте през рампата. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Следвайте курса вляво. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Следващият раздел трябва да бъде изпълнен в обратен ред. Спрете при бариерите отпред, за да можете да върнете на заден ход надясно след това.<br><br><font face=/font/big_bold.font>Спрете при бариерите.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Обърнете се към зоната зад вас и вдясно. На пътя има стрелки, които да ви помогнат.<br><br><font face=/font/big_bold.font>Върнете се на заден ход към следващата секция. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Продължавайте на заден ход към бариерите зад вас.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Спрете и превключете на предна скорост, след което продължете наляво. <br><br><font face=/font/big_bold.font>Карайте напред. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Има прекъсване на медианата вляво. Карайте през него.<br><br><font face=/font/big_bold.font>Продължете нататък. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Пред вас има тясна криволичеща пътека през няколко конуса. Шофирайте внимателно и използвайте огледалата си, ако е необходимо.<br><br><font face=/font/big_bold.font>Карайте през конусите. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Продължете през курса.<br><br><font face=/font/big_bold.font>Завийте наляво. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Не забравяйте да се придържате вляво преди завоя, за да си осигурите възможно най-много място.<br><br><font face=/font/big_bold.font>Направете завоя. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Продължете да шофирате. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Тук можете да изберете скорост нагоре, но отпред има завой.<br><br><font face=/font/big_bold.font>Продължете по трасето. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Кривата става по-остра, докато си проправяте път през нея.<br><br><font face=/font/big_bold.font>Коригирайте скоростта си съответно и продължете.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "В подножието на хълма ще видите бариери, блокиращи пътя. <br><br><font face=/font/big_bold.font>Спрете близо до бариерите. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Зад вас и вляво има място за паркиране.<br><br><font face=/font/big_bold.font>На заден ход към мястото за паркиране. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Спрете на маркираното място. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
