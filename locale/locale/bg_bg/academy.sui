#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Трасето пред вас ще ви помогне да свикнете с изпълнението на 90-градусови завои с двойна композиция при различна степен на трудност."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Първите няколко завоя са доста широки, с много налично пространство. Използвайте ги, за да усетите как се движат ремаркетата зад вас, докато завивате."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Оттук нататък завоите ще стават по-тесни и технични. Подхождайте към тях бавно и се уверете, че навлизате дълбоко в завоя, за да оставите място на ремаркетата да опишат своята траектория."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Това е един от най-тесните завои в трасето. Може да ви помогне, ако използвате малкото пространство вдясно, за да прекарате ремаркетата покрай онези досадни вътрешни конуси."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Следващият завой винаги трябва да бъде в съзнанието ви – докато излизате от единия завой, вече планирайте как ще се подготвите за следващия."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Винаги следете ремаркетата си до самия край, докато не се уверите, че са преминали всички препятствия."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Продължете напред към първия завой."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Следете огледалата си в движение, за да разберете как ремаркетата следват траекторията Ви."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Влизайте широко във всеки завой – това е от решаващо значение, за да си осигурите необходимото място за преминаване на ремаркетата през ъгъла."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Подготовката за следващите няколко завоя е от решаващо значение, тъй като след тях следва много остра крива. Грешка в началото може да Ви коства скъпо дори на по-късен етап.<br><br>Движете се бавно и прецизно и следете заобикалящата Ви среда."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Този завой е изключително остър и води директно към друг също толкова труден завой. Трябва да обмислите не само как да влезете в него, но и как да излезете, за да се подготвите за следващия."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Продължете през последните завои към обозначената зона."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Първа маневра на заден ход"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "В този сценарий за първи път ще извършим маневра на заден ход с двойна композиция."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Спокойно, няма място за притеснение"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Движението на заден ход с двойна композиция изисква изцяло нов начин на мислене. Вместо просто да управлявате едно ремарке, сега използвате предното ремарке, за да насочвате това зад него.<br><br>Използвайте този сценарий, за да добиете усет как работи всичко. Няма конкретна цел – просто отделете време и се опитайте да разберете процеса."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "От изправена позиция можете да завъртите влекача в същата посока, в която искате да отиде задното ремарке.<br><br>Не прекалявайте – трябва само да насочите задното ремарке в желаната посока, след което можете да изправите влекача спрямо предното ремарке и да оставите задното да следва траекторията си."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "След като задното ремарке вече се движи в желаната посока, можете да насочите предното ремарке да го последва.<br><br>Щом предното ремарке последва задното, използвайте влекача, за да регулирате ъгъла между тях – така можете да направите или по-остър завой, или по-широка и плавна маневра."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Няма точна формула за постигане на перфектен резултат – просто трябва да следите какво се случва, да се учите от грешките си и да продължавате да практикувате.<br><br>Когато прецените, че сте готови, можете да се насочите към обозначената зона и да обезопасите превозното средство.<br><br>Чувствайте се свободни да прекарате тук толкова време в експерименти, колкото смятате за необходимо."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Започнете да се движите бавно назад. Не забравяйте да правите само малки корекции с волана – няма нужда да „счупвате“ композицията рязко още от самото начало.<br><br>Опитайте се да се движите право назад или насочете ремаркетата към страната на водача."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Отделете си време и не се отчайвайте.<br><br>Всеки майстор някога е бил начинаещ."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

