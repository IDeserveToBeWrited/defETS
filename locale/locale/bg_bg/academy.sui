	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Паркиране до препятствие"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "В този сценарий ще се научим да паркираме до бордюр с помощта на страничното огледало."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Проверете огледалото за странично виждане"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Шофиране към бордюра"
