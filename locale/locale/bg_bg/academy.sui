#+ Books general.
#@{
	key[]: "aca_modded_book"
	val[]: "Модификация"

	key[]: "aca_book_inaccessible"
	val[]: "Очаквайте скоро ново съдържание. Останете на линия."

	key[]: "aca_book_inaccessible_t"
	val[]: "ОЧАКВАЙТЕ СКОРО"

	key[]: "aca_book_inaccessible_u"
	val[]: "Очаквайте скоро!"

	key[]: "aca_book_disclaimer_t"
	val[]: "ОТКАЗ ОТ ОТГОВОРНОСТ"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Това не е сертифицирана програма за обучение."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>Шофьорската академия не е предназначена да замести обучението за такси.</font><br><br><color value=@@clr_txt@ @>Силно препоръчваме да потърсите инструкции от акредитирана институция за обучение на камиони, преди да се опитате да управлявате камион в реалния живот.<br><br>Институциите за обучение, които се интересуват от използването на Академията за шофьори, като допълнение към обучението за шофьори на кабини, могат да се свържат с нас на academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Основи на шофирането на камиони"

	key[]: "aca_book_book1_desc"
	val[]: "Научете основите на управлението на камион, от основните функции и контрол до маневриране с ремарке."

	key[]: "aca_book_book2_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_book_book2_desc"
	val[]: "Усъвършенствайте уменията си за шофиране на камион с нови сценарии при по-предизвикателни условия."

	key[]: "aca_book_book3_title"
	val[]: "Управление на двойно ремарке"

	key[]: "aca_book_book3_desc"
	val[]: "Приемете любопитните предизвикателства на шофирането и маневрирането на заден ход с двойна композиция."

#@}

