#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Ti diamo il benvenuto alla prima parte dell'esame finale. Qui vedremo quanto bene hai imparato a guidare un camion dopo la tua permanenza nella Scuola Guida."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Come prima cosa, collegherai il rimorchio. Una volta accoppiato, guiderai il camion lungo l'intera area di prova."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "La prima sezione del circuito porta dal piccolo parcheggio al percorso a est."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Il circuito include passaggi impegnativi tra le barriere."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Una parte significativa del percorso passa per il tracciato di prova a est."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Metteremo alla prova la tua abilità di manovra del camion in situazioni differenti."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Manovrerai il camion attraverso alcune curve strette."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Guiderai lungo la sezione di strada che collega i percorsi."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "La parte finale riguarda la guida lungo il piccolo circuito."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Il circuito ha diversi passaggi intricati e curve strette."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Per completare il test, dovrai parcheggiare in modo accurato."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Non lasciarti prendere dal panico, hai già imparato tutto quello che serve per superare la prova.<br><br>Buona fortuna!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Davanti a te c'è il rimorchio.<br><br><font face=/font/big_bold.font>Guida verso il rimorchio. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Allinea il trattore al rimorchio.<br><br><font face=/font/big_bold.font>Fai retromarcia e collegati all'attacco. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Metti il camion in sicurezza.</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Premi @@imv_nrm_attach@@<font face=/font/big_bold.font> per collegare il rimorchio. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Il rimorchio è collegato e il camion è pronto a partire.<br><br><font face=/font/big_bold.font>Rilascia il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Inizia a guidare verso l'uscita del parcheggio. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Segui la segnaletica orizzontale e stai attento alle barriere.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Sta arrivando una sezione più difficile.<br><br><font face=/font/big_bold.font>Procedi con cautela tra le barriere. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Questa parte metterà alla prova le tue abilità di manovra di un rimorchio in diversi tipi di curve.<br><br><font face=/font/big_bold.font>Entra nel percorso. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Guida attraverso il passaggio. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Continua dritto. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Percorri la curva con cautela. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Stai entrando una sezione più complessa. Guida con cautela.<br><br><font face=/font/big_bold.font>Continua a guidare giù per la collina. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Percorri la curva stretta a sinistra. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Esci dal circuito. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Stai entrando in una sezione più facile.<br><br><font face=/font/big_bold.font>Continua a scendere per la collina. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Continua a percorrere la strada. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Davanti a te c'è la curva verso il prossimo percorso.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Gira a destra. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Continua a guidare lungo il percorso. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Davanti a te ci sono curve più strette.<br><br><font face=/font/big_bold.font>Regola la velocità di conseguenza. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Gira a sinistra. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Entra in curva, continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Per fare la curva, potresti avere bisogno di uscire leggermente dall'asfalto.<br><br><font face=/font/big_bold.font>Gira con cautela, usa lo spazio che ti serve. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Esci dal circuito e guida verso lo spazio di parcheggio.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

