#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Corso di guida avanzato"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "L'ultimo scenario in questo capitolo è una guida in un corso di addestramento avanzato. Metteremo alla prova le abilità che hai imparato con un trattore!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
