#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Retromarcia con un rimorchio"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "In questo scenario proverai per la prima volta a fare retromarcia con un rimorchio. La manovra è abbastanza semplice, ma avrai comunque bisogno di sterzare correttamente per posizionare al meglio il rimorchio."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Fare retromarcia verso il rimorchio"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Collegare il rimorchio"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Rilasciare il freno di stazionamento"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Fare retromarcia con il rimorchio"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Continuare verso lo spazio di parcheggio"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Proviamo a fare retromarcia con un rimorchio. È più facile di quanto sembri; devi solo essere paziente."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Inizia la retromarcia e allinea il trattore al rimorchio."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Assicurati di essere allineato correttamente o non riuscirai a collegare il rimorchio. Se la posizione non quella giusta, puoi sempre spostarti in avanti e ritentare."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "La ralla del trattore si bloccherà sull'attacco del rimorchio."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Inserisci il freno di stazionamento e collega il rimorchio. Nella vita reale dovresti scendere dal camion per collegare i cavi di aria ed elettricità e alzare i piedini, ma qui lo faremo noi per te."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Il rimorchio curverà sempre <color value=@@clr_sel@@>all'opposto <color value=@@clr_txt@@>del trattore."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Per girare il rimorchio, dovrai girare il trattore in direzione <color value=@@clr_sel@@>opposta <color value=@@clr_txt@@> a quella dove vuoi far andare il rimorchio."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Per raddrizzare di nuovo il rimorchio, gira il trattore <br><color value=@@clr_sel@@>verso<color value=@@clr_txt@@> il rimorchio."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Cerca di restare allineato con il rimorchio: dovrai fare delle continue e piccole correzioni per mantenere il rimorchio puntato verso l'area contrassegnata."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Correggi le deviazioni dal percorso girando leggermente il volante appena si verificano. Se sterzi troppo, potresti finire fuori dal percorso desiderato."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Fermati nell'area designata. Metti il camion in sicurezza e spegni il motore."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Dietro di te, dal lato del passeggero, vedrai un rimorchio. Il tuo primo compito sarà di fare retromarcia verso di esso.<br><br><font face=/font/big_bold.font>Prepara il camion per la retromarcia. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Inizia a fare retromarcia verso il rimorchio. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Allineati in modo da essere dritto con il rimorchio. La ralla deve agganciare il perno. Vai avanti per sistemarti se necessario.<br><br><font face=/font/big_bold.font>Continua la retromarcia finché non senti una connessione. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "La ralla si è agganciata all'attacco, e sei pronto a finire la connessione al rimorchio.<br><br><font face=/font/big_bold.font>Applica il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Premi @@imv_nrm_attach@@ per collegare il rimorchio. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Ora il rimorchio è collegato saldamente al trattore, i cavi per aria ed elettricità sono connessi e i piedini sono stati alzati.<br><br><font face=/font/big_bold.font>Rilascia il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Dovrai fare retromarcia nel parcheggio esattamente dietro di te. Ricorda che il rimorchio girerà nella direzione opposta a dove giri il trattore. Un leggero giro di volante può risultare in un movimento significativo del rimorchio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia con il rimorchio. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Non sterzare troppo, cerca di mantenere il rimorchio allineato con il punto. <br><br><font face=/font/big_bold.font>Continua verso il parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parcheggiare in uno spazio stretto"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "In questo scenario parcheggeremo in uno spazio stretto.<br><br>Dovrai manovrare il camion per allinearlo con uno spazio di parcheggio sfalsato."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manovrare in posizione"
#!{
	key[]: "aca_goal_book1_3_06_stop"
