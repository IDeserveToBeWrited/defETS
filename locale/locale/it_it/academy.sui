#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "In questo scenario, imparerai la manovra di retromarcia dal 'lato cieco'. In genere, l'operazione dovrebbe essere evitata a meno di non avere alternative, perché la visibilità è molto limitata. Prenditi il tuo tempo e scegli la strada della prudenza estrema."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Supera abbondantemente lo spazio di parcheggio per darti abbastanza spazio durante la retromarcia."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Fermati, controlla l'area circostante, poi inizia la retromarcia."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Gira il trattore fuori dal parcheggio per spostare in avanti l'avantreno del rimorchio e ruotare il retro verso lo spazio di parcheggio di destinazione. Fai attenzione a non esagerare o rischi di intraversare l'insieme."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Mentre il rimorchio entra nello spazio di parcheggio, inizia a raddrizzare il camion."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Fermati nell'area designata e metti il camion in sicurezza."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "La retromarcia verso il lato cieco richiede le stesse procedure di quello verso il lato visibile, ma sarai limitato dalla mancanza di visibilità da quel lato. Usa gli specchietti e il tuo giudizio per parcheggiare il camion.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "C'è un parcheggio di fronte, sul lato del passeggero. Avrai bisogno di andare molto più avanti, in modo da avere spazio di manovra durante la retromarcia.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Ricorda, sterzare il camion distante dal punto farà girare il rimorchio verso di esso. Usa gli specchietti al meglio delle tue abilità per aiutarti nel parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Guidare in una rotatoria"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "In questo scenario, vedremo come affrontare una rotatoria.<br><br>Dovrai prestare particolare attenzione al rimorchio perché la sua traiettoria, dietro di te, sarà diversa in immissione, percorrenza e uscita."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Immissione nella rotatoria"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Guidare nella rotatoria"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Guidare nella rotatoria"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Uscire dalla rotatoria"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Guidare verso l'Area Designata"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Le rotatorie sono molto comuni sulle strade europee, perciò è importante sapere come affrontarle."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Resta all'esterno della tua corsia mentre percorri la rotatoria. Questo aiuterà il rimorchio a superare l'interno della curva in immissione."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Dirigiti verso il centro della rotatoria mentre entri. Una volta immesso, punta verso l'uscita. Questa manovra mantiene il rimorchio distante dal centro della rotatoria."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Tieni d'occhio lo specchietto, per assicurarti che il rimorchio non si avvicini troppo alle barriere all'interno."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Uscire dalla rotatoria è abbastanza facile, perché il rimorchio è già posizionato lontano dal lato interno dell'uscita. Allarga la traiettoria in uscita e il rimorchio dovrebbe seguirti senza problemi."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parcheggia nell'area designata e ferma in sicurezza il camion."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Davanti a te c'è una rotatoria pronta per essere affrontata. <br><br><font face=/font/big_bold.font>Avvicinati lentamente alla rotatoria. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Effettua una curva ampia quando ti immetti nella rotatoria, così il rimorchio dietro di te ti seguirà senza problemi. <br><br><font face=/font/big_bold.font>Immettiti nella rotatoria. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Guida verso l'uscita della rotatoria. Dovrai mantenere il camion il più distante possibile dal centro della rotatoria per mantenere il rimorchio lontano dalle barriere centrali. <br><br><font face=/font/big_bold.font>Continua attraverso la rotatoria.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Resta vicino ai coni all'esterno. <br><br><font face=/font/big_bold.font>Continua a guidare.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Esci dalla rotatoria.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Procedi verso lo spazio di parcheggio più avanti.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Fermati nell'area designata.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Metti il camion in sicurezza e spegni il motore.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manovrare in uno spazio stretto"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Per l'ultimo scenario, ti verrà richiesto di girare il camion in uno spazio ristretto. Dovrai fare retromarcia sul lato cieco in un'area con uno spazio di manovra limitato, che richiederà attenzione ai dintorni e un uso intelligente dello spazio."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Guidare lungo il percorso"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Preparazione al lato cieco"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Retromarcia nel parcheggio"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Completare la manovra dal lato cieco"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Uscire dal percorso"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In questo scenario vedremo come girare in uno spazio stretto con una manovra di retromarcia dal lato cieco. Questa abilità ti sarà utile quando non potrai fare un'inversione a U o una manovra dal lato di guida."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "La segnaletica orizzontale ti aiuterà a orientarti lungo il percorso di addestramento."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Effettua una curva ampia per assicurarti che il rimorchio superi i camion parcheggiati."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Uscendo dalla curva, considera come impostare il camion per la manovra di retromarcia."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Sarà utile avere il camion con una certa angolazione e puntato verso lo spazio di parcheggio vuoto sul lato del passeggero, dove dovrai fare retromarcia."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Se possibile, dovresti evitare la retromarcia dal lato cieco, data la mancanza di visibilità. Sfortunatamente, ci sono occasioni in cui non avrai altra scelta."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Gira il volante prima della retromarcia. Questo ti aiuterà a dare immediatamente la giusta angolazione al rimorchio, un aiuto in spazi molto stretti."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Una volta che il rimorchio è ben posizionato, sposta il trattore davanti al rimorchio e raddrizzalo."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Fermati quando ti sei raddrizzato e hai abbastanza spazio per muoverti di nuovo in avanti. Inizia a tornare indietro allo stesso modo in cui sei arrivato."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Segui la segnaletica orizzontale fuori dal percorso di addestramento."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Percorri la curva davanti a te e procedi verso l'area designata."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Fermarsi."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Metti il camion in sicurezza e spegni il motore."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Davanti a te c'è un'area di addestramento che rappresenta il piazzale di un'azienda di spedizioni. Il tuo compito è di entrare e girare il camion per uscire. Assicurati di fare buon uso dello spazio intorno a te.<br><br><font face=/font/big_bold.font>Preparati a partire </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Procedi verso il percorso di addestramento. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Gira l'angolo e continua lungo il percorso. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Segui la segnaletica orizzontale verso la barriera alla fine del percorso. Parcheggia con un certo angolo in modo che il rimorchio punti verso l'area di parcheggio vuota sul lato del passeggero.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Quando parcheggi nel lato cieco, la visuale su ciò che accade intorno a te è molto limitata. Vai piano, usa gli specchietti e sii prudente.<br><br><font face=/font/big_bold.font>Inizia la retromarcia e gira il rimorchio verso il parcheggio vuoto. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Sei abbastanza avanti, ora puoi procedere in avanti ed esci dalla zona di addestramento nella stessa direzione da dove sei venuto.<br><br><font face=/font/big_bold.font>Inizia a procedere verso l'uscita. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Esci dall'area di addestramento. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Segui la segnaletica orizzontale per l'ultima area di parcheggio.<br><br><font face=/font/big_bold.font>Procedi verso l'area designata. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manovra di retromarcia sfalsata"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "In questo scenario ti verrà richiesto di fare retromarcia in un'area che non è direttamente dietro di te. C'è poco spazio per manovrare, perciò dovrai usarlo in modo intelligente."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "In questo scenario, il tuo compito sarà quello di parcheggiare nello spazio vicino a te. Non c'è molto spazio di manovra, perciò dovrai fare un po' di lavoro extra per posizionare il rimorchio dove vuoi."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Guida dritto fino alla barriera."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Fermati prima della barriera."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Prima di muoverti, gira rapidamente lo sterzo verso il lato di guida. In questo modo, farai girare il rimorchio verso il parcheggio fin dall'inizio della manovra, risparmiando spazio utile."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Una volta che il rimorchio punta nella direzione desiderata, porta il trattore davanti al rimorchio e inizia a girare verso lo spazio di parcheggio."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Da questo punto in poi, non è così diverso da una normale manovra di parcheggio."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continua la retromarcia e controlla entrambi i lati. Mantieni il trattore e il rimorchio allineati allo spazio di parcheggio."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Fermati nell'area designata, metti il camion in sicurezza e spegni il motore."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Sei già in un parcheggio, ma c'è un'altra area di parcheggio alla tua destra dove dovrai spostarti.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "C'è un'area contrassegnata davanti a te.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ricorda di iniziare immediatamente a sterzare, perché non c'è molto spazio.<br><br><font face=/font/big_bold.font>Fai retromarcia nell'area contrassegnata dietro di te. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Percorrere curve semplici"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "In questo scenario guiderai lungo un breve percorso di pratica in cui imparerai a manovrare il rimorchio in curve semplici a 90 gradi."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Affrontare la prima curva"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Seconda curva"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Ultima curva"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Davanti a te ci sono alcune curve strette con poco spazio a disposizione. Ti saranno di aiuto per imparare a manovrare efficacemente il rimorchio."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Segui la segnaletica orizzontale verso la barriera sul lato di guida per prepararti alla prima curva."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Resta vicino alla barriera esterna lungo la curva, e il rimorchio ti dovrebbe seguire lungo il percorso."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Continua a seguire la segnaletica orizzontale per impostare la seconda curva, una curva stretta a 90 gradi."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Dovrai allargare la curva per assicurarti che il rimorchio superi le barriere all'interno. Usa lo specchietto frontale per aiutarti ad andare più avanti che puoi nella curva senza urtare nulla."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continua lungo la barriera esterna."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Di nuovo, un'altra curva stretta a 90 gradi che richiederà l'uso di tutto lo spazio disponibile."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Fermati nell'area designata e metti il camion in sicurezza."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Ricordati di usare tutto lo spazio a disposizione per aiutarti ad affrontare ciascuna curva.<br><br><font face=/font/big_bold.font>Parti e segui la segnaletica orizzontale all'esterno. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Segui la barriera all'esterno, ma tieni d'occhio il rimorchio nello specchietto.<br><br><font face=/font/big_bold.font>Percorri la prima curva. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Segui la segnaletica orizzontale per impostare la prossima curva a 90 gradi.<br><br><font face=/font/big_bold.font>Percorri la curva a 90 gradi. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Tieniti largo con il camion dopo la curva, perché ti aspetta un'altra curva a 90 gradi ancora più stretta.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Procedi verso lo spazio di parcheggio più avanti. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Parcheggio diagonale in retromarcia"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "In questo scenario, vedremo come parcheggiare in diagonale in retromarcia. Questo può succedere in aree di servizio, aree di sosta e addirittura nelle aziende. Spesso, c'è poco spazio perché le aree sono affollate di camion, perciò il parcheggio è ancora più difficile per la mancanza di spazio."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Girare il rimorchio"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Il parcheggio in diagonale sembra facile al primo impatto, ma spesso è più difficoltoso delle tipiche manovre in retromarcia."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Fai retromarcia verso lo spazio di parcheggio. Mantieni dritti trattore e rimorchio per ora."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Man mano che ti avvicini, lascia che il rimorchio vada più vicino ai camion parcheggiati. Questo ti aiuterà a girarlo nel parcheggio quando lo raggiungerai."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Inizia a girare il rimorchio nello spazio di parcheggio. Mantieni il rimorchio vicino al camion dal lato di guida, perché ti servirà spazio dall'altro lato."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Una volta che il rimorchio è ben posizionato nello spazio di parcheggio, inizia a girare il trattore per seguire il rimorchio."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parcheggia nell'area designata, metti il camion in sicurezza e spegni il motore."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parcheggia il camion nello spazio dietro di te. Usa entrambi gli specchietti per orientarti mentre fai retromarcia.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Controlla i dintorni, poi dirigiti verso il parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Inizia a muovere il rimorchio verso i camion di fianco a te. Quando sei pronto, gira il rimorchio nel parcheggio. Ricordati di considerare l'ingombro posteriore del rimorchio.<br><br><font face=/font/big_bold.font>Gira nel parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Retromarcia in una curva"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "In questo scenario faremo retromarcia con un rimorchio in una curva per la prima volta. Esploreremo i principi di base della retromarcia e cosa guardare mentre si sterza in retromarcia."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Girare il rimorchio"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "In questo scenario dovrai fare retromarcia nello spazio di parcheggio dietro di te, dal lato di guida."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Ci sono alcuni suggerimenti da ricordare, che ti aiuteranno molto nella retromarcia con i rimorchi. <br>Il primo è che il rimorchio vorrà sempre girare nella direzione opposta rispetto a dove giri il trattore."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Il secondo è che si può intuire la direzione che il rimorchio seguirà guardando gli assi di camion e rimorchio."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Terzo, bastano piccoli movimenti per raggiungere la tua destinazione, non c'è bisogno di esagerare."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Inizia a dirigere il trattore un po' lontano dallo spazio di parcheggio, e il rimorchio inizierà a puntare verso di esso."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Segui il rimorchio, aggiustandolo in manovra per mantenerlo al posto giusto."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Guarda le ruote del rimorchio e le ruote posteriori del trattore. Ti diranno dove il rimorchio sta puntando, e dove il trattore lo sta portando."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Un quarto suggerimento è che è sempre più facile girare il rimorchio più marcatamente del dovuto rispetto al cercare di raddrizzarlo da un intraversamento. Punta all'uscita del parcheggio finché non sei più vicino, poi potrai girare un po' di più per allineare il rimorchio."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Mentre il rimorchio entra nel parcheggio, porta il trattore davanti al rimorchio. Cerca di evitare troppe correzioni nell'area."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Fai retromarcia tra le barriere, controlla entrambi i lati mentre vai."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Metti il camion in sicurezza e spegni il motore."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Ricorda questi suggerimenti mentre fai retromarcia in curva con un rimorchio:<br><br>- Il rimorchio gira nella direzione opposta a dove giri il trattore<br><br>- Controlla le ruote del rimorchio per vedere dove punta<br><br>- Controlla le ruote posteriori del trattore per vedere dove spinge il rimorchio<br><br>- Lascia che il rimorchio faccia il lavoro, non esagerare con lo sterzo<br><br>- È sempre più facile girare di netto il rimorchio che raddrizzarlo<br><br><font face=/font/big_bold.font>Preparati a partire.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Guarda dietro di te per vedere dove devi andare. Controlla sempre l'ambiente circostante prima di iniziare la retromarcia.<br><br><font face=/font/big_bold.font>Inizia la retromarcia verso lo spazio di parcheggio. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Inizia a girare il rimorchio verso lo spazio di parcheggio e seguilo.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Fermati nell'area designata. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Parcheggio in retromarcia in uno spazio stretto"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "In questo scenario ti verrà richiesto di posizionare il rimorchio in retromarcia in uno spazio di parcheggio dentro un'area affollata."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Girare il rimorchio"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Questo è un tipico parcheggio per camion. Si tratta di una situazione che gli autisti incontreranno più o meno ogni giorno nella loro carriera.<br>Parcheggiare qui richiede una manovra in retromarcia."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Questa manovra è simile a quella dello scenario precedente, ma avrai meno spazio per lavorare, per cui dovrai pianificare le tue mosse di conseguenza e fare attenzione a non urtare nulla."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Essendoci meno spazio, il tempismo è ancora più importante. Sterza il rimorchio al momento giusto, guardando le ruote di trattore e rimorchio per vedere dove stai andando. Tieni a mente l'ingombro posteriore e ricordati di non intraversare - continua a spingere il rimorchio."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Cerca di restare vicino al camion dal lato di guida, darà spazio di manovra al rimorchio e non dovrai preoccuparti del camion dal lato del passeggero."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Una volta che il rimorchio è nel parcheggio, porta il trattore davanti a esso. È meglio farlo un po' prima di quanto direbbe il tuo istinto. Puoi sempre apportare correzioni mentre fai retromarcia verso la posizione finale."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Raddrizza il trattore e il rimorchio, e fermati nell'area designata."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Metti il camion in sicurezza e spegni il motore."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Ora proveremo a girare un rimorchio in un'area più piccola con una manovra in retromarcia. <br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Controlla i dintorni e mira al parcheggio dietro di te. <br><br><font face=/font/big_bold.font>Inizia la retromarcia verso il parcheggio. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Gira il rimorchio nello spazio di parcheggio.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
