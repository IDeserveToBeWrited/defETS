#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Movimenti e Comandi di Base"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Impara i comandi di base del veicolo e come muovere il camion a marcia avanti e indietro."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 1: @@aca_chapter_book1_1_title@@.<br><br>Hai imparato a preparare il camion prima di guidare,<br>la guida a marcia avanti e indietro e come utilizzare luci e tergicristalli.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Manovre di Base"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Impara a guidare, manovrare e parcheggiare con un trattore stradale. Scopri l'utilità di ogni tipo di specchietto e impara come utilizzarlo."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 2: @@aca_chapter_book1_2_title@@.<br><br>Hai imparato come utilizzare ogni specchietto sul camion, controllare lo spazio intorno al camion prima di guidare, e le manovre di base e avanzate.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manovrare con un Rimorchio"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Impara a collegare un rimorchio e a manovrarlo in varie situazioni."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 3: @@aca_chapter_book1_3_title@@.<br><br>Hai imparato a collegare e scollegare un rimorchio,<br>la sensibilità per il peso e le dimensioni del camion con un rimorchio<br>e la guida su percorsi difficili con un rimorchio.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Retromarcia con un Rimorchio"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Impara nuove manovre per guidare efficacemente in retromarcia e riuscire a parcheggiare con un rimorchio."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 4: @@aca_chapter_book1_4_title@@.<br><br>Hai imparato a fare retromarcia con un rimorchio<br>e varie tecniche di parcheggio.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Esame Finale"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Metti alla prova le tue competenze e abilità, e dimostra quanti vali come camionista!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 5: @@aca_chapter_book1_5_title@@.<br><br>Hai dimostrato di avere tutte le abilità necessarie<br>per guidare, manovrare e parcheggiare un camion!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Scaldare il Motore"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Hai completato l'addestramento: @@aca_chapter_book2_0_title@@.<br><br>Hai imparato le regole e le caratteristiche delle Competenze di Guida.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Di nuovo in Marcia"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 2: @@aca_chapter_book2_1_title@@.<br><br>Hai scaldato il motore, provato le marce, fatto girare le ruote e controllato l'efficienza dei freni. I prossimi capitoli saranno più sfidanti.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Ruote in Movimento"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 3: @@aca_chapter_book2_2_title@@.<br><br>Hai dominato scenari difficili e variegati, dimostrando abilità e prestazioni.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Rettilineo Finale"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 4: @@aca_chapter_book2_3_title@@.<br><br>Hai gestito diverse situazioni difficili in manovra, parcheggio e retromarcia con un rimorchio. Ti sei dimostrato un autista abile, capace di gestire tutte le sfide alla guida di un camion."

	key[]: "aca_chapter_book3_1_title"
	val[]: "In Avanti"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Impara tutte le tecniche essenziali per manovrare un rimorchio doppio guidando in avanti."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 1: @@aca_chapter_book3_1_title@@.<br><br>Hai imparato a guidare e manovrare efficacemente i rimorchi doppi.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Controllo in Retromarcia"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Comprendere gli step necessari per gestire i rimorchi doppi in retromarcia."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 2: @@aca_chapter_book3_2_title@@.<br><br>Hai imparato l'incredibile abilità della retromarcia con i rimorchi doppi.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Preparazione al Mondo Reale"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Applica le tue nuove conoscenze in scenari più avanzati."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br>Hai completato il Capitolo 3: @@aca_chapter_book3_3_title@@.<br><br>Hai gestito diverse situazioni difficili in manovra, parcheggio e retromarcia con un rimorchio doppio. Ti sei fatto valere, è ora di viaggiare con i rimorchi doppi sulle strade di Euro Truck Simulator 2!</font><br><br>"


#@}

