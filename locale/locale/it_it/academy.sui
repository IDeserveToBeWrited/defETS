#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Prima di guidare"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Per il tuo primo scenario, ti spiegheremo le basi della cabina di guida. È importante regolare correttamente il sedile, il volante e gli specchietti laterali, perché avere una buona visibilità è importante per gestire situazioni stressanti o precarie.<br><br>Rivediamo i controlli per regolare questi componenti uno alla volta."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Regolazione sedile e specchietti"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Controllo specchietti e visibilità"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Ti diamo il benvenuto alla tua prima lezione!<br>Iniziamo imparando come preparare il camion per il suo viaggio in strada."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "È cruciale fare in modo che la guida sia sicura, professionale e sotto controllo in qualsiasi momento.<br>La regolazione corretta di sedile, volante e specchietti ti aiuterà in questo."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Su ogni lato del camion, ci sono alcuni veicoli.<br>Ti aiuteranno a regolare correttamente gli specchietti."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Prenditi il tempo necessario per regolare tutto secondo le tue esigenze<br>perché da queste impostazioni deriva la tua capacità di controllare il camion."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Regolazione sedile e volante"

	key[]: "adj_tut_title_1"
	val[]: "Regolazione specchietti principali"

	key[]: "adj_tut_title_2"
	val[]: "Regolazione specchietti convessi"

	key[]: "adj_tut_title_3"
	val[]: "Controllo visibilità e regolazioni finali specchietti"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "premi @@imv_nrm_adjuster@@ o accedi tramite le regolazioni del veicolo nel menu di pausa"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "accedi tramite le regolazioni del veicolo nel menu di pausa"

	key[]: "adj_tut_open_adj"
	val[]: "Per mostrare \"@@adjust_link_t@@\" durante il gioco, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Per prima cosa, regoliamo il sedile del guidatore e il volante.<br><br><font face=/font/big_bold.font>Apri '@@adj_seats@@' per continuare.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Apri @@adj_mirrors@@ per configurare le regolazioni degli specchietti.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Salendo su un camion per la prima volta, è importante regolare sedile, volante e specchietti a tuo piacimento.<br><br>La posizione corretta al volante è cruciale per la visibilità migliore. Tutti i controlli devono essere a portata, e il guidatore deve avere una visuale chiara di fronte, a lato e negli specchietti.<br><br><font face=/font/big_bold.font>Per mostrare il menu di configurazione,$OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Regola il sedile per avere una visuale chiara dell'ambiente circostante e degli specchietti, e poter raggiungere comodamente tutti i comandi.<br><br>Regola il volante in modo che sia in una posizione comoda e non ostacoli la visuale sulla strumentazione.<br><br><font face=/font/big_bold.font>Quando le regolazioni ti soddisfano, premi @@imv_nrm_back@@ per tornare al menu di configurazione.</font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>I camion hanno diversi e ampi angoli ciechi, perciò sono equipaggiati con numerosi specchietti esterni per aiutare l'autista a vedere il più possibile. <br><br>La corretta regolazione degli specchietti ti permette di avere la miglior visibilità possibile dell'ambiente circostante.<br><br><font face=/font/big_bold.font>Apri '@@adj_mirrors@@' per continuare.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Gli specchietti principali coprono lo spazio lungo i fianchi di camion e rimorchio.<br><br>Per regolare la posizione corretta degli specchietti principali, usa le automobili su entrambi i lati del veicolo come riferimento.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_selectfcs@@ per continuare.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Gli specchietti principali sono lo strumento principale per vedere cosa succede a fianco e dietro di te. Dovresti avere una buona visuale della vettura di fianco a te, ma fai in modo di mantenere anche una parte del rimorchio nello specchietto per aiutarti a valutare la posizione degli ostacoli intorno a te."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Quando sei soddisfatto della regolazione, passa allo specchietto lato passeggero."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Di nuovo, è bene avere una buona visuale dell'auto a fianco mantenendo comunque una parte del rimorchio visibile nello specchietto."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Quando sei soddisfatto della regolazione, passa allo specchietto convesso lato guida."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Gli specchietti convessi donano un campo visivo più ampio, permettendoti di vedere di più di quello che succede di fianco a te.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_selectfcs@@ per continuare. </font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Idealmente, dovresti vedere sia l'auto che il camion parcheggiati di fianco, più una piccola porzione del tuo camion."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Quando sei soddisfatto della regolazione, passa allo specchietto convesso lato passeggero."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Di nuovo, dovresti vedere sia l'auto che il camion parcheggiati di fianco, più una piccola porzione del tuo camion."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Quando sei soddisfatto con la regolazione degli specchietti, premi @@imv_nrm_back@@ per chiudere le impostazioni."

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Premi @@imv_nrm_back@@ per ritornare al menu di configurazione. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Eccellente, con il sedile e gli specchietti impostati a tuo piacimento sei più vicino a metterti in viaggio!<br><br><font face=/font/big_bold.font>Chiudi il menu di configurazione con @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Dai un'ultima occhiata attorno per assicurarti che la visuale dalla cabina ti soddisfi e che gli specchietti ti offrano una buona percezione di ciò che accade intorno al camion.<br><br>Se qualcosa non ti piace, puoi regolare di nuovo gli specchietti nel menu di configurazione \"@@adjust_link_t@@\". <br><br><font face=/font/big_bold.font>Premi @@imv_nrm_activate@@ per terminare il primo scenario.</font> @@aca_goal_tip@@ Per mostrare o nascondere gli specchietti su schermo, puoi andare in \"@@adjust_link_t@@\" — \"@@adj_ui_mirrors@@\" nel menu di pausa. Gli specchietti su schermo rendono più facile vedere il lato del passeggero."
#@}

# Book 1 Scenario 1_02 - strings not needing translation
