	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Parcheggio in Diagonale con rimorchi doppi"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "In questo scenario, dovrai parcheggiare la tua combinazione con rimorchio doppio in un parcheggio in diagonale in un'area affollata. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "I parcheggi in diagonale come questo sono molto comuni, specialmente nelle molteplici aree di sosta lungo le autostrade europee."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Guida verso lo spazio di parcheggio designato vicino al termine della fila."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Resta verso l'esterno della corsia, ma non troppo addosso alle barriere per non farle colpire dal rimorchio di coda durante la manovra."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Guida oltre il posteggio per lasciare spazio a entrambi i rimorchi, poi vai verso il lato opposto per portare il rimorchio di testa in posizione."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Raddrizzati, fermati nell'area designata e assicura il camion."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Procedi verso il termine della fila e trova il tuo parcheggio."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Guida oltre il parcheggio per assicurarti che il rimorchio di coda punti la direzione corretta, poi gira assicurandoti che la parte anteriore del rimorchio di testa non tocchi il camion di fianco al tuo."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Continua lentamente raddrizzando la combinazione, poi fermati nell'area designata."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
