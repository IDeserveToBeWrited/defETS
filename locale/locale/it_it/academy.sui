#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFO COMPETENZE DI GUIDA DEL CAMION" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Requisiti di completamento"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Gli scenari vengono completati soddisfacendo tutte le condizioni base"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Le stelle vengono ottenute completando le condizioni bonus"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Condizioni"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Numero massimo di cambi tra marcia avanti e indietro"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Tempo massimo consentito per completare uno scenario per una certa condizione"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Uso esclusivo della visuale interna (quelle esterne possono essere usate da fermo)"

	key[]: "aca_book_book2_completed_t"
	val[]: "COMPETENZE DI GUIDA DEL CAMION SUPERATO"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br><br>Hai soddisfatto tutte le condizioni Base del modulo Competenze di Guida del Camion, e hai ottenuto dei premi per il tuo profilo. Puoi comunque metterti alla prova e ottenere più premi completando tutte le condizioni bonus.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "COMPETENZE DI GUIDA DEL CAMION COMPLETATO"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulazioni!<br><br>Hai soddisfatto tutte le condizioni del modulo Competenze di Guida del Camion, e hai ottenuto dei premi per il tuo profilo.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Competenze di Guida del Camion"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Bentornato alla @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "I seguenti scenari rappresentano il prossimo passo del tuo viaggio verso una guida professionale del camion."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Stavolta non ti guideremo lungo ogni incarico, quindi starà a te mettere la tua abilità ed esperienza al lavoro."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Incontrerai alcune manovre familiari, ma stavolta lo farai in nuovi ambienti che assomigliano di più a scenari del mondo reale."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "La novità della @@driving_academy@@ è l'aggiunta delle condizioni \"Base\" e \"Bonus\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Come prima, dovrai completare ogni scenario senza urtare niente, parcheggiando correttamente e mettendo il camion in sicurezza..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "... ma ora lo dovrai anche fare nel tempo prestabilito e con un limite di cambi tra marcia avanti e indietro."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Le condizioni bonus possono essere soddisfatte completando ogni scenario con elementi di sfida più impegnativi..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "... come dei limiti di tempo più stretti, meno cambi di marcia, e usando solo la visuale interna."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Completando tutti gli scenari, potrai considerarti un camionista esperto, pronto per la prossima sfida su strada.<br><br>Per metterti ulteriormente alla prova, completa tutte le condizioni bonus per ogni scenario; così sarai veramente una stella del camion!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "In questo tutorial ti aiuteremo a familiarizzare con le nuove caratteristiche di Competenze di Guida del Camion."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "All'inizio di ogni scenario vedrai una finestra <color value=@@clr_sel@@>\"Riepilogo scenario\"<color value=@@clr_txt@@>, che ti darà tutte le informazioni sulle nuove condizioni base e bonus. <br><br>Le condizioni base vanno soddisfatte per completare lo scenario con successo, mentre le condizioni bonus sono una sfida extra opzionale per i giocatori più abili ed esperti. <br><br><font face=/font/big_bold.font>Per continuare, attiva l'ignizione.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Una delle condizioni bonus ti richiede di completare lo scenario usando la <color value=@@clr_sel@@>visuale interna<color value=@@clr_txt@@>. Puoi comunque usare quelle esterne per controllare l'area circostante, ma solo mentre il camion è fermo.<br><br>Guardati intorno per orientarti e poi torna alla visuale interna.<br><br><font face=/font/big_bold.font>Passa alla visuale a inseguimento per controllare cosa ti circonda</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Orientati, poi passa alla visuale interna.<br><br><font face=/font/big_bold.font>Guarda intorno al camion</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Ritorna alla visuale interna</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "Anche il <color value=@@clr_sel@@>tempo<color value=@@clr_txt@@> sarà un fattore determinante nelle Competenze di Guida del Camion. Tutti gli scenari, come condizione base, hanno un preciso limite di tempo entro il quale lo scenario va completato, e molti di loro presentano un ulteriore limite come condizione bonus.<br><br>Il timer partirà solo quando il camion si muoverà.<br><br><font face=/font/big_bold.font>Avvia il motore e rilascia il freno di stazionamento per continuare.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Un'altra aggiunta alle Competenze di Guida del Camion sono i punti di passaggio. Affinché uno scenario sia completato è necessario raggiungere tutti i punti di passaggio.<br><br>Inoltre, i punti devono essere oltrepassati in una determinata direzione, perciò fai attenzione alla segnaletica orizzontale per orientarti correttamente.<br><br><font face=/font/big_bold.font>Vai avanti verso il punto di passaggio di fronte a te.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Hai raggiunto il punto di passaggio, ora puoi passare al prossimo.<br><br>C'è un altro punto di passaggio dietro di te verso il quale dovrai fare retromarcia. Presta attenzione alla freccia a terra che indica quale direzione deve avere il camion rispetto al punto di passaggio.<br><br>Altre condizioni base e bonus da considerare sono i <color value=@@clr_sel@@>cambi di marcia<color value=@@clr_txt@@>. Conteremo quante volte cambierai tra marcia avanti e marcia indietro. Resta entro il limite per soddisfare la condizione.<br><br><font face=/font/big_bold.font>Fai retromarcia verso il punto di passaggio e fermati.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "A questo punto, dovresti aver accumulato un cambio di marcia. <br><br>Raccogli il rimorchio dietro di te per passare al prossimo punto. <br><br><font face=/font/big_bold.font>Fai retromarcia sotto al rimorchio per collegarlo.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "L'area di parcheggio finale è alla tua destra. Alcuni scenari avranno solo un parcheggio, mentre altri ne avranno alcuni tra cui scegliere. Parcheggiare correttamente in uno spazio qualsiasi ti permetterà di completare lo scenario. <br><br><font face=/font/big_bold.font> Premi @@imv_nrm_attach@@ per collegare il rimorchio. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "I parcheggi indicano inoltre la direzione che dovrà avere il camion nell'area. Se parcheggi nella direzione sbagliata, non riuscirai a completare lo scenario finché non risolverai il problema, sprecando tempo e cambi di marcia.<br><br><font face=/font/big_bold.font>Guida verso uno dei posteggi e parcheggiati correttamente.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Ora dovresti aver familiarizzato con i nuovi parametri delle condizioni base e bonus, e dovresti essere in grado di affrontare i nuovi scenari delle Competenze di Guida del Camion!<br><br><font face=/font/big_bold.font>Metti il camion in sicurezza azionando il freno di stazionamento e spegnendo il motore per completare lo scenario.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Scorciatoia"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "In questo scenario, cercherai di usare una scorciatoia che, purtroppo, sarà bloccata in fondo. Dovrai dunque tornare indietro da dove sei arrivato."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Guida fino al punto di passaggio in cima al pendio e torna indietro allo stesso modo.<br><br>Quando sarai di nuovo sulla strada, vai verso l'area di parcheggio finale."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Mattiniero"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "In questo scenario ti troverai a lavorare in un'area sovraffollata. Lo spazio è molto limitato, perciò cerca di pianificare le tue mosse con anticipo."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Ci sono alcuni casi in cui il parcheggio è così limitato che gli altri guidatori parcheggeranno dove capita durante la notte. Questo può rendere difficoltoso girargli intorno al mattino.<br><br> Fai del tuo meglio per ricavarti una via verso l'area di parcheggio finale."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Contorto"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "In questo scenario dovrai guidare in un percorso di addestramento molto complesso. Lungo il tragitto dovrai trovare e collegare un rimorchio da portare con te fino alla fine."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Questo scenario metterà alla prova la tua consapevolezza dello spazio e della situazionale. Il percorso è pieno di ostacoli non sempre facili da individuare."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Procedi lungo il percorso verso il rimorchio. Quando l'avrai localizzato, collegalo e portalo all'area di parcheggio finale."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Vertigine"

	key[]: "aca_scenario_book2_vertigo_desc"
