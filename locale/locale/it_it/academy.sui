#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Parcheggio diagonale"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "In questo scenario effettuerai un parcheggio diagonale in un luogo affollato.<br><br>Non c'è molto spazio per manovrare, perciò dovrai guidare in modo accurato e deciso."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Avvicinarsi allo spazio di parcheggio"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Parcheggi diagonali come questo sono molto comuni, specialmente nelle molteplici aree di sosta che popolano le autostrade europee. <br>Di nuovo, dovremo entrare 'di muso' nel parcheggio qui davanti."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Guida verso lo spazio di parcheggio designato vicino al termine della fila."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Resta al centro della corsia, o leggermente verso il lato guida. Non stare troppo vicino alle barriere, oppure il retro del rimorchio potrebbe urtarle in manovra."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Supera abbondantemente il parcheggio, poi gira bruscamente e rapidamente verso l'area. Dovrai controllare entrambi gli specchietti principali: Il lato guida per assicurarti che l'avantreno del rimorchio non colpisca il rimorchio dietro di te, e il lato passeggero per vedere che il rimorchio stia entrando nell'area di parcheggio."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Fermati nell'area designata, metti il camion in sicurezza e spegni il motore."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Parcheggiando in diagonale, è importante giudicare accuratamente la tua posizione. Quando sei ad un certo punto della curva, è difficile fare retromarcia e riposizionarsi in modo sicuro, perciò è bene fare in modo di avere abbastanza spazio al primo tentativo.<br><br><font face=/font/big_bold.font>Preparati a partire.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Inizia a guidare verso lo spazio di parcheggio. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Supera il parcheggio per dare al rimorchio lo spazio per ruotare intorno al camion al tuo interno.<br><br><font face=/font/big_bold.font>Gira nel parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Retromarcia dal lato cieco"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "In questo scenario vedremo come fare retromarcia in uno spazio di parcheggio sul \"lato cieco\". Senza poter guardare fuori dal finestrino per vedere dove stai andando, dovrai fare affidamento sugli specchietti per orientarti in modo appropriato."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

