#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Superare curve complesse"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In questo scenario esploreremo le manovre del rimorchio in un breve percorso a ostacoli con curve più complesse."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Prime curve"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Attraversare un passaggio stretto"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Curva stretta a 90 gradi"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Aggirare le barriere"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Qui davanti ci sono varie curve complesse e ostacoli.<br>Metti in pratica tutto quello che hai imparato finora e non dovrebbe essere troppo difficile."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "La segnaletica orizzontale può darti un'idea di come procedere lungo ogni serie di ostacoli."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Mantieni il trattore verso l'esterno della curva. <br>Dovrai girare largo poiché il rimorchio segue una traiettoria più corta."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "La prossima curva a 90 gradi è semplice. <br> Di nuovo, mantieni il camion all'esterno della curva e usa tutto lo spazio disponibile."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Qui prenditi il tempo necessario. Il percorso si allarga, ma dovrai comunque essere preciso."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Mantieni un angolo ampio intorno alle barriere."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Presta attenzione entrando in questa sezione stretta. <br> Allarga la traiettoria del trattore molto prima di entrare, per impostare il rimorchio per l'ingresso."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "L'ultima curva a 90 gradi è molto più accentuata della prima, ma c'è abbastanza spazio se lo usi saggiamente."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Fermati nell'area designata, poi metti il camion in sicurezza e spegni il motore."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Ricordati di utilizzare la segnaletica orizzontale per aiutarti a navigare nel percorso.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Utilizzare gli specchietti sarà un ulteriore aiuto per una navigazione sicura lungo il percorso. Devi essere sempre consapevole di dove sta andando il rimorchio dietro di te.<br><br><font face=/font/big_bold.font>Procedi verso la prima curva. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Osserva il rimorchio in uscita dalla curva e preparati a entrare nella prossima.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Procedi verso la prossima curva. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Ricordati di osservare il rimorchio per assicurarti di non avere ostacoli intorno a te, prima di girare il camion.<br><br><font face=/font/big_bold.font>Continua intorno alla barriera di fronte. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Quando il rimorchio ha superato la barriera, gira verso il lato del passeggero per allinearti per il passaggio stretto. <br><br><font face=/font/big_bold.font>Procedi verso il passaggio stretto.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Questa sezione richiederà una guida molto precisa. Prenditi il tuo tempo e usa gli specchietti.<br><br><font face=/font/big_bold.font>Resta verso l'esterno di ciascuna curva. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Questa curva è molto stretta, ma puoi utilizzare tutto lo spazio davanti a te per superarla agevolmente.<br><br><font face=/font/big_bold.font>Percorri l'ultima curva. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Corso di guida avanzato - rimorchio"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "Nello scenario finale del Capitolo 3 affronteremo un percorso più lungo con curve di vario tipo, per verificare quanto bene hai imparato a manovrare con un rimorchio."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Variante"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "RIMUOVI QUESTO OBIETTIVO"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Attraversamento mediano"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Primo slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Secondo slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Curve facili"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rotatoria"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Rettilineo"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Curva stretta"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Ultime curve"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Raggiungere lo spazio di parcheggio"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "In questo scenario affronterai una serie di curve diverse per abituarti a guidare con un rimorchio. Mantieni la concentrazione, regola la velocità per ogni situazione e sfrutta al massimo lo spazio disponibile nel tracciato di guida."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "La prima curva è una variante: due curve in una. Dovrai impostare una curva a sinistra, ma riportarti verso destra nel bel mezzo della manovra."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "La prossima curva ti farà attraversare verso l'altro lato della mediana. Non è particolarmente difficile, ma dovrai procurare di lasciare abbastanza spazio per il rimorchio."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Di seguito, dovrai affrontare uno slalom stretto tra le barriere di cemento. Vai piano e usa gli specchietti, e assicurati di girare abbastanza largo per far superare le barriere al rimorchio."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "A questo punto affronterai un altro slalom che presenta dei coni extra al punto di corda di ciascuna curva <br>Occhio a non urtarli!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Più avanti, sulla strada verso la rotatoria, c'è una coppia di curve facili."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Usa il rettilineo per prepararti a entrare nella rotatoria. Resta all'esterno prima di immetterti."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Immettiti nella rotatoria e controlla il posizionamento del rimorchio. La traiettoria sarà diversa, una volta dentro la rotatoria, rispetto a come sei entrato."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Esci dalla rotatoria e guida verso la prossima serie di curve."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "RIMUOVI QUESTO FILMATO"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Questa curva è molto stretta. Prendila lentamente e usa con saggezza lo spazio intorno a te. Presta attenzione anche all'ingombro posteriore del rimorchio."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Guidando nelle prossime curve, ricordati di cercare di impostare la curva successiva già mentre esci dalla precedente."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Non essere troppo frettoloso nell'ultima curva. Sembra facile, ma c'è meno spazio di manovra di quello che sembra."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Fermati nell'area designata, metti il camion in sicurezza e spegni il motore."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Accelera verso la prima curva. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "La prima curva è una semplice curva a gomito. <br><br><font face=/font/big_bold.font>Affronta la curva. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "RIMUOVI QUESTO CHECK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Più avanti, il percorso continua a sinistra della mediana.<br><br><font face=/font/big_bold.font>Supera l'attraversamento. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Fai manovra tra le barriere e ricordati di guardare il rimorchio.<br><br><font face=/font/big_bold.font>Percorri lo slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Questo slalom è molto semplice, ma i coni lo rendono decisamente più stretto.<br><br><font face=/font/big_bold.font>Percorri lo slalom senza colpire i coni. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Più avanti c'è un paio di curve facili, ma dovrai comunque impostarle a dovere per mantenere il rimorchio distante dalle barriere interne.<br><br><font face=/font/big_bold.font>Percorri le curve. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Ti stai avvicinando a una rotatoria. Ricordati di lasciare abbastanza spazio per il rimorchio non solo in entrata e uscita, ma anche in percorrenza.<br><br><font face=/font/big_bold.font>Immettiti nella rotatoria. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "C'è un breve rettilineo di fronte a te, puoi incrementare un po' la velocità se vuoi.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Questa curva è molto stretta. Vai piano, usa tutto lo spazio disponibile e tieni a mente l'ingombro posteriore del rimorchio. <br><br><font face=/font/big_bold.font>Percorri la curva stretta. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "L'ultima serie di curve è più semplice. Ricordati di tenere d'occhio il rimorchio.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Continua verso l'ultimo spazio di parcheggio. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

