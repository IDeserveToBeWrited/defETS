#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Retromarcia Diritta"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "In questo scenario, dovrai fare retromarcia con un insieme di rimorchi doppi in una linea retta."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Retromarcia"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "La retromarcia diritta sembra facile al primo sguardo, ma in realtà è molto più difficile. <br><br>Anziché semplicemente aumentare o diminuire l'angolo tra i rimorchi da un lato, ora devi gestire entrambi i lati per mantenere la combinazione diritta."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Inizia con correzioni relativamente leggere. Va bene anche se fai zig zag da entrambe le parti, ma tieni in mente che dovrai mantenere l'angolo tra camion e rimorchio di testa un po' più a lungo per cambiare quello tra testa e coda."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Avrai bisogno di fare manovre abbastanza ampie con il trattore per mantenere il rimorchio di coda puntato dove vuoi farlo andare, cerca solo di non esagerare all'inizio e non ti servirà farlo."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Puoi tornare in avanti per correggerti tutte le volte che ti serve. Finché finisci in maniera sicura nel parcheggio, il resto non conta."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Inizia a indietreggiare dolcemente."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Raddrizzati e fermati nell'area designata."

	key[]: "aca_msg_book3_straight_backing_end"
