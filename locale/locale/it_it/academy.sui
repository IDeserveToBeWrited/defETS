#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "In questo scenario proveremo ad agganciare e sganciare un rimorchio per la prima volta. Prepara il camion, poi fai retromarcia sotto al rimorchio dietro di te."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Aggancia il rimorchio, poi vai avanti."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Fermati nell'area contrassegnata."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Scollegare il rimorchio, vai avanti."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Fermati nello spazio di parcheggio e metti il camion in sicurezza."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "In questo scenario, discuteremo le procedure per collegare e scollegare rimorchio e trattore. Questa è una procedura semplificata rispetto a quella che un camionista seguirà nella vita reale. <br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "C'è un rimorchio posizionato dietro al trattore. Fai retromarcia lentamente sotto al rimorchio finché la ralla aggancia l'attacco. Il camion, in questo momento, è allineato correttamente perciò non c'è bisogno di sterzare, basta solo procedere dritti.<br><br><font face=/font/big_bold.font>Fai retromarcia lentamente finché non senti una connessione. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "La ralla si è agganciata all'attacco.<br><br><font face=/font/big_bold.font>Assicura il camion inserendo il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Nella vita reale, la ralla si aggancia automaticamente all'attacco, in seguito l'autista dovrà uscire dal veicolo per alzare i piedini e collegare i cavi di aria ed elettricità. <br><br><font face=/font/big_bold.font>Per noi, basterà premere @@imv_nrm_attach@@ per collegare il rimorchio. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Ora che il trattore è connesso in maniera sicura al rimorchio, sei pronto per andare avanti. Tieni a mente che ora il tuo veicolo è considerevolmente più lungo e pesante, e necessiterà di un nuovo set di abilità per operare. <br><br><font face=/font/big_bold.font>Rilascia il freno di stazionamento e preparati a muoverti in avanti. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Vai avanti.<br><br><font face=/font/big_bold.font>Fermati nell'area contrassegnata. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Inserisci il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aziona il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Di nuovo, nella realtà l'autista dovrebbe uscire dal veicolo, abbassare i piedini, scollegare aria ed elettricità, e rilasciare il meccanismo di blocco della ralla. <br><br><font face=/font/big_bold.font>Noi ti semplificheremo questo processo, perciò basterà premere @@imv_nrm_attach@@ per sganciare il rimorchio. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Rilascia il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Sposta il trattore da sotto il rimorchio e vai avanti.<br><br><font face=/font/big_bold.font>Fermati nell'area contrassegnata. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Fermati nell'area contrassegnata. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Frenare con un rimorchio"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "In questo scenario ti farai un'idea di come si guida e si frena con un rimorchio agganciato."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Partire"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Guidare lungo un pendio"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Raggiungere una velocità di 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Azionare i freni"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"



 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "In questo scenario guideremo il camion per un breve tragitto dove imparerai a padroneggiare la frenata con un rimorchio scendendo lungo il pendio più avanti. Prepara il camion e parti."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Raggiungi una velocità di almeno 60 km/h (37 mph). Tieniti pronto per la zona di frenata più avanti."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Inizia a frenare. Assicurati di non aspettare troppo o potresti urtare le barriere davanti a te!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parcheggia nell'area designata, poi metti il camion in sicurezza e spegni il motore."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Durante questa guida, ti farai un'idea dell'uso dei freni di servizio scendendo da una collina. Lo scopo di questa esercitazione è di diventare consapevole del peso dietro di te e di come influisce sullo spazio di frenata del veicolo.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Inizia a guidare, e tieni a mente che dovrai raggiungere una velocità di 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Percorri la curva. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Continua ad accelerare giù per il pendio. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Raggiungi una velocità di almeno 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Hai raggiunto la velocità richiesta.<br><br><font face=/font/big_bold.font>Fermati alle barriere più avanti. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

