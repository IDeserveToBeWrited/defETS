#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Correzione Retromarcia Diritta"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "In questo scenario, prenderai il volante dopo che qualcun altro ha già tentato una retromarcia diritta. Correggi il suo errore e parcheggia il camion nell'area designata."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Raddrizzarsi"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Retromarcia"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Qualcuno ha cercato di parcheggiare questa combinazione con una retromarcia dritta e ha avuto qualche problema. Ora tocca a te rimediare!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Il primo passo è quello di andare avanti e portarci in una situazione gestibile. È cruciale avere il rimorchio di coda puntato dove vuoi farlo andare."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "In questo caso, abbiamo scelto di andare più verso il lato di guida. Questo ci darà una visuale migliore di ciò che facciamo in retromarcia, lasciandoci concentrare su un lato. <br><br>Ricordati, stai sterzando il rimorchio di coda con la testa, quindi lascia perdere il trattore."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "La combinazione è più o meno dove vogliamo, ma andiamo di nuovo avanti per centrarla a dovere."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Da qui, faremo delicatamente retromarcia verso il posteggio, assicurandoci che il rimorchio di coda rimanga al suo posto."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Ora possiamo allineare il rimorchio di testa e il trattore."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Vai avanti e raddrizza tutto. <br><br>Quando sei soddisfatto, fai retromarcia nell'area designata."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Fai retromarcia verso l'area designata."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Posteggia il veicolo e spegni il motore."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Retromarcia a 90 gradi"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "In questo scenario, dovrai effettuare una manovra di retromarcia a 90 gradi per parcheggiare tra una fila di altri camion."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Inversione a U"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Partire"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Retromarcia"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Fare retromarcia di lato è più facile con i rimorchi doppi, poiché fuori dal finestrino avrai un punto di osservazione più chiaro di tutto ciò che accade."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Per iniziare, vai avanti e fai un'inversione a U alla fine della fila. Questo ti permetterà di prepararti dal lato giusto, e di vedere meglio le cose che restano fuori dal finestrino lato guida."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Puoi decidere di impostare i rimorchi come preferisci, possibilmente con il rimorchio di coda che già punta il parcheggio. In questo caso, partiremo da una posizione diritta. <br><br>Ricordati di non complicarti la vita - gira il rimorchio di coda con quello di testa."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Gira il rimorchio di testa leggermente all'opposto del parcheggio, e quello di coda inizierà a puntare nella direzione giusta. Da lì, regola l'angolo tra testa e coda per mantenere un arco bello e liscio fino al parcheggio."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Ricorda: se il rimorchio di coda entra troppo stretto, dovrai in qualche modo raddrizzare l'angolo della combinazione. Se va troppo largo, dovrai stringere l'angolo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Le correzioni che fai col trattore hanno un effetto dimezzato sul rimorchio di coda rispetto a quello di testa, perciò non avere paura di far lavorare il trattore."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "A questo punto, devi iniziare a pianificare. Devi far entrare nel parcheggio anche il rimorchio di testa, perciò escogita un piano per metterlo esattamente di fronte alla coda."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "È molto raro riuscire a far entrare i rimorchi al primo tentativo. In questo caso, abbiamo aspettato troppo a raddrizzare la testa, e ora la coda sta scappando fuori. <br><br>Nessun problema, vai avanti e riprova."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Fai lavorare quel volante, e porta quei rimorchi dove devi. Puoi andare avanti per tutte le volte che ti servono, finché non sei soddisfatto."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "E proprio così, abbiamo parcheggiato con successo i rimorchi doppi."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Vai avanti fino alla fine del parcheggio e girati."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Ricordati di fare una curva ampia."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Prosegui finché non credi di avere abbastanza spazio di manovra, poi inizia la retromarcia."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Fai retromarcia nel parcheggio se pensi di avere abbastanza spazio di manovra."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


