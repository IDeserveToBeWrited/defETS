#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Per lo scenario finale di questo capitolo guideremo sul tracciato di prova con una configurazione complessa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Il primo ostacolo è uno slalom attraverso delle barriere. Percorrilo e ricorda di usare gli specchietti."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Il prossimo è un tornante. Mantieniti largo e non dovresti avere problemi."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Ecco una curva a sinistra a 90 gradi. Ricordati di guidare di modo che la parte posteriore del camion superi le barriere all'interno."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "La rampa potrebbe essere un po' complicata. Allineati meglio che puoi prima di percorrerla, e usa gli specchietti frontali e laterali per orientarti."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "La prossima sezione deve essere affrontata in retromarcia. Avvicinati alle barriere tenendolo a mente."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Segui la segnaletica orizzontale dietro di te e alla tua destra."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Fai retromarcia verso le barriere, poi fermati e procedi in avanti verso sinistra."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Procedi verso lo spazio nella mediana per la prossima sezione."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Questo passaggio attraverso i coni è molto stretto. Guida lentamente e usa gli specchietti per orientarti nel passaggio."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Ricordati di tenerti largo nelle curve a 90 gradi."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Stai entrando in una sede stradale bella larga. Puoi incrementare un po' la velocità, ma ricordati che tra poco dovrai rallentare per la curva più avanti."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "In fondo alla collina ci sono alcune barriere in carreggiata. Raggiungile, poi fai retromarcia nel parcheggio sulla sinistra."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Prosegui in retromarcia fino al parcheggio."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parcheggia, poi spegni il motore e metti il camion in sicurezza."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Di fronte a te c'è uno slalom tra le barriere.<br><br><font face=/font/big_bold.font>Guida attraverso lo slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Mantieniti verso l'esterno della curva per assicurarti che il retrotreno del camion non scavalchi il cordolo.<br><br><font face=/font/big_bold.font>Percorri la curva. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Ti stai avvicinando ad una curva a sinistra di 90 gradi. Ricordati di usare tutto lo spazio a disposizione.<br><br><font face=/font/big_bold.font>Percorri la curva. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Allineati alla rampa. Non c'è molto spazio per le correzioni quando la starai percorrendo.<br><br><font face=/font/big_bold.font>Sali sulla rampa. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Segui il percorso a sinistra. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "La prossima sezione va completata in retromarcia. Fermati alle barriere di fronte a te così da poter poi fare retromarcia verso destra.<br><br><font face=/font/big_bold.font>Fermati alle barriere.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Fai retromarcia verso l'area dietro di te e a destra. Ci sono frecce sulla strada per darti assistenza.<br><br><font face=/font/big_bold.font>Fai retromarcia verso la prossima sezione. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continua la retromarcia verso le barriere dietro di te.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Fermati e inserisci una marcia avanti, poi continua a sinistra. <br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "C'è uno spazio nella mediana a sinistra. Vai verso di esso.<br><br><font face=/font/big_bold.font>Prosegui fino a lì. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Di fronte a te c'è un percorso stretto e tortuoso attraverso alcuni coni. Guida con prudenza e usa gli specchietti se necessario.<br><br><font face=/font/big_bold.font>Guida attraverso i coni. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Prosegui lungo il percorso.<br><br><font face=/font/big_bold.font>Svolta a sinistra. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Ricordati di tenere la sinistra prima della curva per darti più spazio possibile.<br><br><font face=/font/big_bold.font>Percorri la curva. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Qui puoi incrementare un po' la velocità, ma c'è una curva più avanti.<br><br><font face=/font/big_bold.font>Continua lungo il percorso. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "La curva si stringe man mano che la percorri.<br><br><font face=/font/big_bold.font>Regola la velocità di conseguenza e prosegui.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "In fondo alla collina vedrai alcune barriere in strada. <br><br><font face=/font/big_bold.font>Fermati vicino alle barriere. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Dietro di te, a sinistra, c'è un'area di parcheggio.<br><br><font face=/font/big_bold.font>Fai retromarcia verso il parcheggio. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Fermati nel punto contrassegnato. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Affrontare una pista di maneggevolezza"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In questo scenario faremo un giro su una pista progettata per testare la tua capacità di gestire il camion attraverso diversi tipi di curve e angoli."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entrare nel percorso"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Effettuare una curva sinistra graduale"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Guida attraverso le curve a S"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Rettilineo"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Curve facili"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Uscire dal percorso di addestramento"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Avvicinarsi allo spazio di parcheggio"
