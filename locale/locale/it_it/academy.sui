	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Per terminare lo scenario, metti il camion in sicurezza e spegni il motore.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Sei sul punto giusto, ma dal verso sbagliato.<br><br><font face=/font/big_bold.font>Gira il camion prima di completare lo scenario.</font>"
#@}

#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Ti diamo il benvenuto alla @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "I seguenti scenari rappresentano il primo passo del tuo viaggio professionale alla guida di un camion."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Qui imparerai tutto, dai sistemi e i comandi di base del camion..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "... alle manovre complesse con e senza un rimorchio."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Ti aiuteremo a sviluppare comportamenti utili ad affrontare varie situazioni in maniera sicura,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "e ti insegneremo a sfruttare lo spazio disponibile per manovrare efficacemente il tuo camion."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Completando tutti gli scenari e superando gli esami finali,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "sarai pronto a percorrere le strade d'Europa e affrontare nuove sfide."

#@}

