	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Prosegui in retromarcia fino al parcheggio."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Fermati nell'area designata."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Metti il camion in sicurezza e spegni il motore."
#@}




