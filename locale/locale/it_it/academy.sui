	key[]: "aca_msg_book3_justc_forward"
	val[]: "Non c'è via d'uscita da questo pasticcio. Vai avanti per avere una situazione gestibile."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Inizia la retromarcia."

#!{
	key[]: "aca_msg_book3_justc_stop"
