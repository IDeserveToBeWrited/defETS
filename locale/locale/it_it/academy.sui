	val[]: "IN ARRIVO"

	key[]: "aca_book_inaccessible_u"
	val[]: "In arrivo!"

	key[]: "aca_book_disclaimer_t"
	val[]: "DICHIARAZIONE DI NON RESPONSABILITÀ"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Questo non è un programma di addestramento certificato."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>La @@driving_academy@@ non è pensata per sostituire la pratica dal vivo.</font><br><br> <color value=@@clr_txt@@>Consigliamo vivamente di iscriversi a una scuola guida certificata prima di tentare di guidare un camion nella vita reale.<br><br>I centri di formazione interessati a utilizzare la @@driving_academy@@ per completare la formazione degli autisti possono contattarci all'indirizzo academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Fondamenti di Guida del Camion"

	key[]: "aca_book_book1_desc"
	val[]: "Impara i rudimenti della guida di un camion, dalle funzioni e i comandi di base alle manovre con un rimorchio."

	key[]: "aca_book_book2_title"
	val[]: "Competenze di Guida del Camion"

	key[]: "aca_book_book2_desc"
	val[]: "Affina le tue abilità di guida del camion con nuovi scenari in condizioni più impegnative."

	key[]: "aca_book_book3_title"
	val[]: "Gestione Rimorchio Doppio"

	key[]: "aca_book_book3_desc"
	val[]: "Affronta le curiose sfide di guida e retromarcia con una combinazione a rimorchio doppio."

#@}

