#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parcheggiare accanto a un ostacolo"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "In questo scenario impareremo a parcheggiare accanto a un cordolo utilizzando lo specchietto laterale."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Controlla lo specchietto laterale"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Guidare verso il cordolo"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Lo specchietto laterale è un altro strumento che ti aiuterà a manovrare il camion in maniera sicura. È posizionato sul montante superiore della portiera del passeggero."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Vai avanti e girati lentamente verso il lato del passeggero."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Queste assi di legno rappresentano un cordolo. Dovrai parcheggiarci accanto. <br>Gira verso il cordolo per posizionare bene il camion e allinearti allo spazio di parcheggio."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Rallenta molto prima del cordolo e gira verso lo spazio di parcheggio. Raddrizzandoti, puoi usare lo specchietto laterale per calcolare la distanza dal cordolo."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Fermati nel parcheggio e metti il camion in sicurezza."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Guarda dal finestrino del passeggero. Là potrai vedere lo specchietto laterale.</font>@@aca_goal_tip@@ Devi essere a bordo del veicolo."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Lo specchietto laterale copre l'area del lato del passeggero dove l'autista non può vedere. È uno degli angoli ciechi più problematici del camion. Se l'angolo dello specchietto non ti piace, puoi regolarlo in '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Il camion non è ancora pronto a muoversi, probabilmente hai dimenticato qualcosa?<br><br>Il motore è acceso? Hai rilasciato il freno di stazionamento?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Di fronte a te c'è una fila di assi che rappresentano un cordolo. Alla fine del cordolo c'è un parcheggio. Dovrai guidare verso di esso. <br><br><font face=/font/big_bold.font>Procedi quando sei pronto. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Svolta verso il marciapiede. Usa gli specchietti anteriori e laterali per controllare la tua posizione rispetto al marciapiede, ma assicurati anche di non urtare alcun cono stradale.<br><br><font face=/font/big_bold.font>Guida verso il marciapiede e parcheggia nel posto riservato.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Metti il camion in sicurezza e spegni il motore.</font>@@aca_goal_tip@@ Puoi usare i preset della visuale interna per guardare gli specchietti in modo più semplice. Controlla la schermata Opzioni - \"@@options_bindings_screen@@\" per vedere e/o modificare i comandi corrispondenti."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parcheggio in retromarcia vicino a un ostacolo"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "In questo scenario faremo retromarcia in un parcheggio vicino a un cordolo."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Istruzioni"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Retromarcia verso il cordolo"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parcheggiare il camion"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "In questo scenario faremo una manovra in retromarcia per parcheggiare vicino a un cordolo."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Fai retromarcia verso il cordolo.<br>Mentre fai manovra devi sempre sapere cosa accade intorno a te, perciò usa gli specchietti."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Avvicinandoti, puoi iniziare ad allineare il camion al parcheggio. Controlla entrambi i lati del camion mentre fai retromarcia."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Fermati nel parcheggio e metti il camion in sicurezza."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Il parcheggio è dietro di te verso il lato del passeggero. Usa gli specchietti per orientarti verso il posteggio.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Ricordati di usare gli specchietti per controllare i dintorni prima di muovere il camion.<br><br><font face=/font/big_bold.font>Inizia la retromarcia verso il cordolo. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continua a monitorare i dintorni mentre fai retromarcia verso il parcheggio.<br><br><font face=/font/big_bold.font>Fermati nell'area designata. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
