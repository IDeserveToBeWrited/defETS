#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In questo scenario porteremo il trattore in un breve viaggio per vedere come te la cavi con le nuove abilità acquisite."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Il percorso presenta vari tipi e combinazioni di curve. Non si tratta di una gara o di una prova a tempo. Sii paziente e regola la velocità alle curve e agli ostacoli che incontri."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "All'inizio il percorso è facile e tranquillo, ma le curve diventeranno più complicate man mano che procedi."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Fai attenzione alla velocità: è facile andare troppo veloce e giudicare male una curva."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "L'uscita dal percorso è un tornante molto stretto. Vai piano e usa tutto lo spazio a disposizione."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parcheggia tra le barriere e metti il camion in sicurezza."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Per completare questo scenario con successo non dovrai sbattere, uscire dal tracciato o colpire dei coni.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Vai avanti fino alla curva stretta a destra per iniziare il percorso. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Percorri la curva a velocità costante. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Ti stai avvicinando a una sezione più complessa e tortuosa.<br><br><font face=/font/big_bold.font>Regola la velocità di conseguenza e continua.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continua verso la prossima serie di curve.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Più avanti ci sono alcune curve più facili. Mantieni una velocità costante.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "La curva per uscire dal percorso è un tornante stretto. Rallenta e stai all'esterno prima della curva. Assicurati di usare gli specchietti!<br><br><font face=/font/big_bold.font>Esci dal percorso. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Di fronte a te c'è un parcheggio tra alcune barriere.<br><br><font face=/font/big_bold.font>Procedi verso il parcheggio.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parcheggio parallelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "In questo scenario daremo un'occhiata al parcheggio parallelo tra altri due camion."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Fermarsi davanti allo spazio di parcheggio"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Controllare lo specchietto retrovisore"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Retromarcia nel parcheggio"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Allineare il camion nello spazio di parcheggio"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Il parcheggio parallelo è un'abilità essenziale che ogni camionista dovrebbe possedere.<br>Preparati a partire."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Guida verso il parcheggio.<br>Presta attenzione all'ambiente circostante."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Allineati al camion di fronte al tuo spazio di parcheggio. Non stare troppo vicino, mantieni un po' di distanza per avere spazio di manovra."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Gira con decisione verso lo spazio e inizia la retromarcia."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Guardando dallo specchietto principale, punta il cordolo di fronte al camion dietro di te."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Quando il paraurti anteriore copre il camion davanti a te, puoi iniziare a girare l'avantreno nello spazio, allineando il camion al parcheggio."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Raddrizza il volante e centra il camion nello spazio di parcheggio.<br>Parcheggia e metti il camion in sicurezza."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Di fronte a te ci sono alcuni camion parcheggiati. C'è uno spazio aperto per lasciarti parcheggiare. <br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Ricordati di controllare i dintorni. Fai buon uso degli specchietti in questa manovra. <br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Supera il parcheggio nell'area contrassegnata. Da lì puoi iniziare la manovra di retromarcia.<br><br><font face=/font/big_bold.font>Fermati nel punto contrassegnato. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Controlla i dintorni per eventuali ostacoli e assicurarti di poter fare retromarcia.<br><br><font face=/font/big_bold.font>Guarda lo specchietto sul lato del passeggero. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Gira le ruote e fai retromarcia nel parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Inizia a raddrizzare il camion quando puoi. Non scavalcare il cordolo!<br><br><font face=/font/big_bold.font>Allinea il camion al parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

