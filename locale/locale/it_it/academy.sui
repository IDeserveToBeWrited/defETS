#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Fermarsi vicino a un ostacolo"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "In questo scenario parleremo dello specchietto frontale: la sua posizione e come utilizzarlo efficacemente per fermarsi vicino a un ostacolo di fronte."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Controlla lo specchietto frontale"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Comprenderne la funzione"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Fermarsi vicino all'ostacolo"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "I camion hanno un ampio angolo cieco nell'area davanti al trattore. È facile perdere di vista un pedone o addirittura un'auto in quest'area, perciò i camion sono equipaggiati con uno specchietto frontale che può essere visto dal parabrezza."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Lo specchietto frontale è progettato per migliorare la visuale dell'autista su questo angolo cieco.<br>È uno strumento essenziale per non farti entrare in collisione con degli ostacoli mentre fai manovra in spazi ristretti."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Inizia a guidare, procedi verso la barriera di fronte a te, poi rallenta quando sei in prossimità.<br>Tieni d'occhio lo specchietto frontale."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Fermati tra la linea e l'ostacolo."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "In questo scenario, impareremo a usare lo specchietto frontale mostrato nel diagramma.<br><br><font face=/font/big_bold.font>Guarda la porzione superiore del parabrezza per vederlo.</font>@@aca_goal_tip@@ Devi essere a bordo del veicolo."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Lo specchietto frontale ti permette di vedere nell'angolo cieco davanti al camion. Ti aiuterà ad essere sicuro e preciso alla guida.<br><br>Se non sei soddisfatto della regolazione, apri '@@adjust_link_t@@' (accedi dal menu di pausa) per regolarlo a tuo piacimento.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_activate@@ per continuare. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "C'è un punto contrassegnato giusto davanti al camion. Ti accorgerai che c'è un ostacolo dall'altra parte del punto; quando ti avvicini, guida molto lentamente e controlla la distanza dall'ostacolo nello specchietto frontale.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Il camion non è ancora pronto a muoversi, probabilmente hai dimenticato qualcosa?<br><br>Il motore è acceso? Hai rilasciato il freno di stazionamento?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Guida verso lo spazio di parcheggio. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Ferma la parte anteriore del camion tra l'ostacolo e la segnaletica orizzontale. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
