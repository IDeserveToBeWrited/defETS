#+ DLC manager
#+
#+ Messages for situations occurring due to management of DLCs.
#@{
	key[]: "dlc_acquire_timeout" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "L'acquisto dei DLC sta richiedendo più tempo del previsto, e continuerà in background."

	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "L'acquisto dei DLC sta richiedendo più tempo del previsto. Vuoi attendere ancora?<br><br>Se procedi, l'acquisto continuerà in background."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "L'accesso ad alcuni DLC è stato acquisito. Vuoi ritornare alla Schermata Iniziale per accedere al nuovo contenuto?<br><br>I tuoi progressi verranno salvati automaticamente."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "L'accesso ad alcuni DLC è stato perso. Ritornerai alla Schermata Iniziale per applicare i cambiamenti al contenuto.<br><br>I tuoi progressi verranno salvati automaticamente."
#@}
