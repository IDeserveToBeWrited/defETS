#+ Configuration of autopause.
#@{
	key[]: "eye_autopause_settings"
	val[]: "Autopausa" #+ Hader of the section.

	key[]: "eye_autopause_mode"
	val[]: "Modalità autopausa" #+ Type of the autopause

	key[]: "eye_autopause_mode_never"
	val[]: "Disabilitato" #+ Autopause is disabled

	key[]: "eye_autopause_mode_presence"
	val[]: "Presenza" #+ Autopause if user is not present

	key[]: "eye_autopause_mode_gaze"
	val[]: "Presenza + visore" #+ Autopause if user is not present or not looking at the game for at least eye_autopause_gaze

	key[]: "eye_autopause_gaze"
	val[]: "Soglia di assenza sguardo" #+ How long must be the gaze absent from the game before pausing it in eye_autopause_gaze mode
