#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Il file immagine è troppo grande. Prego prova a ridurre la risoluzione dello schermo." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Il file immagine è corrotto o non supportato." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "La risoluzione dell'immagine è troppo grande. Si prega di provare a ridurre la risoluzione dello schermo." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Il servizio ha respinto l'immagine." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "L'account non è autorizzato a caricare immagini." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "C'è stato un caricamento simultaneo allo stesso slot." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Il caricamento è attualmente disabilitato. Riprova più tardi." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Errore sconosciuto durante il caricamento. Riprova più tardi." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "L'immagine è più grande della dimensione massima consentita di $LIMIT$ ed è stata ridimensionata." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Il file immagine è più grande della dimensione massima consentita di $LIMIT$KB e sarà ridimensionata." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

