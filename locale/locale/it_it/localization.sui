#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANCA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banca" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Se ha bisogno di fondi, può sempre chiedere un prestito alla nostra banca." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "OFFERTE DI PRESTITO" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "per $MONEY$ al giorno" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Numero di prestiti attivi: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Puoi prendere in prestito: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "PANORAMICA PRESTITI ATTIVI "  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Prestito" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Somma da rimborsare" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Durata (in giorni)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Tasso d'interesse (annuale)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Rata" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Rimborsa subito" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Totale:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Saldo disponibile: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NUOVO PRESTITO" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Stai chiedendo un prestito di $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Periodo di ammortamento:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Tasso d'interesse (annuale):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Rata giornaliera:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Vuoi confermare la tua decisione?"
#@}

