#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continua ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Benvenuto su Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Finalmente ora potrai sperimentare il lavoro dei tuoi sogni...<br>essere un camionista !"

	key[]: "intro_3"
	val[]: "La tua azienda di trasporto è finalmente aperta e pronta al business, ma purtroppo ti mancano i soldi per comprare un camion. Per ora dovrai lavorare per le altre aziende, come un autotrasportatore dipendente."

	key[]: "intro_4"
	val[]: "Il tuo compito è quello di trasportare in modo sicuro un carico di $JOB_CARGO$ della $JOB_TARGET_COMPANY$ nei magazzini di $JOB_TARGET_CITY$. Il tuo datore di lavoro ti ha fornito un veicolo e coprirà tutte le spese. Non deludere nessuno e arriva in tempo."


	key[]: "intro_garage_1"
	val[]: "Questo è il tuo quartier generale."

	key[]: "intro_garage_2"
	val[]: "E' un garage piuttosto modesto.<br>Potrebbe non sembrare molto bello, ma è già un buon inizio.\n"

	key[]: "intro_garage_3"
	val[]: "Purtroppo, non hai ancora niente da parcheggiarci, perciò<br>per ora non ci sono camion in vista."

	key[]: "intro_garage_4"
	val[]: "Una volta che avrai guadagnato abbastanza soldi e avrai comprato un camion, sarai in grado di muoverti liberamente nel mondo e iniziare la tua carriera da qui."

	key[]: "intro_garage_5"
	val[]: "Buona fortuna!"


	key[]: "desktop_tut_t"
	val[]: "FEATURE SBLOCCATA"

	key[]: "desktop_tut_job"
	val[]: "Scegli il tuo prossimo lavoro"

	key[]: "desktop_tut_cargo_market"
	val[]: "Usa il tuo nuovo rimorchio per accedere al mercato dei carichi e consegnare un vasto assortimento di merci alle loro destinazioni." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Qui puoi osservare i tuoi progressi."

	key[]: "desktop_tut_company"
	val[]: "Da qui puoi gestire la tua azienda, amministrare i tuoi garage e assumere nuovi autisti."

	key[]: "desktop_tut_trailers"
	val[]: "Da adesso puoi comprare i tuoi rimorchi personali, aggiornarli e verniciarli per abbinarli al tuo camion<br><br>I tuoi rimorchi saranno conservati nei garage selezionati; possono essere utilizzati per incrementare i tuoi guadagni. Per gestire i rimorchi accedi al loro menù."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visita $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BENVENUTO"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Benvenuto nel nuovo Desktop.<br>Da qui puoi interfacciarti con tutte le funzionalità del gioco."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "In basso, il Menù principale fornisce accesso diretto a tutte le funzioni principali del gioco con cui hai familiarità."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "In alto, la nuova Barra di stato fornisce costante visibilità ad utili statistiche del profilo di gioco e regole locali sui viaggi."

	key[]: "desktop_tut_tour_home"
	val[]: "Il pulsante Desktop è sempre qui per permetterti di tornare al Desktop."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Un Menù rapido permanente fornisce l'accesso a comode scorciatoie verso tutte le funzioni di gioco da qualunque schermata."

	key[]: "desktop_tut_tour_drive"
	val[]: "Il nuovo pulsante Guida resta il tuo portale d'accesso al mondo della guida, pronto a riportarti in strada."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL COMPLETATO"

	key[]: "desktop_tut_tour_finish"
	val[]: "Grazie per aver esplorato il nostro Desktop aggiornato."
#@}


