#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Stato di rete non disponibile. Si prega di verificare che la configurazione del client sia corretta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Impossibile stabilire la connessione al servizio online. Si prega di verificare che la connessione ad Internet funzioni."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Errore durante la comunicazione con il servizio online. Prego riprova più tardi."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Dati errati restituiti dal servizio online. Se il proxy HTTP è in uso, controllare la configurazione. In caso contrario, riprovare più tardi."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Dati errati restituiti dal servizio online. Riprova più tardi."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Il servizio non è compatibile con la versione attuale del gioco. Si prega di verificare se è disponibile una nuova patch per il gioco."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Il servizio non è attualmente disponibile. Riprova più tardi."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Il servizio è attualmente chiuso per manutenzione o sovraccarico. Riprova più tardi."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Le informazioni di autenticazione non sono valide. Prova a registrarti nuovamente."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "L'account è attualmente bloccato a causa di un numero eccessivo di tentativi di accesso falliti. Prego riprova tra mezz'ora."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "L'account online è attualmente bloccato a causa di accessi sospetti. Prego riprova tra 24 ore."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Il presente gioco non è registrato a questo account online."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "L'account non è stato ancora attivato. Controlla la tua casella di posta per l' e-mail di attivazione account."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "L'account è stato sospeso. Prego contattare il supporto tecnico."

# The account was banned.
	key[]: "generic_banned"
	val[]: "L'account è stato bannato. Prego contattare il supporto tecnico."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "L'autenticazione proxy non è supportata da questo gioco. Si prega di utilizzare un proxy diverso o una connessione diretta."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "L'oggetto richiesto non è al momento disponibile. Prego riprova tra qualche minuto."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Errore SSL. Impossibile stabilire una connessione sicura."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Il gioco è stato interrotto durante la comunicazione online. Per favore, riprova più tardi."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Errore interno. Il file net.log potrebbe contenere più informazioni."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 ha avuto un problema e non è in grado di elaborare grafici sul computer (nessun dispositivo grafico valido è stato trovato).\nPassi suggeriti:\n\n1. Verifica che il computer e la scheda video soddisfino i requisiti hardware minimi.\n2. Aggiorna il tuo computer alla versione più recente di DirectX di Microsoft.\n3. Scarica e installa gli ultimi driver grafici per la scheda video dal sito Web del vendor - i driver grafici sono probabilmente obsoleti.\n4. Prova a cambiare il metodo di rendering da OpenGL a DirectX o vice versa.\n5. Elimina il file di configurazione del gioco 'config.cfg' nei tuoi 'Documenti' - nella cartella 'Euro Truck Simulator 2'. Potrebbe essere danneggiato.\nQuesto file verrà ricreato automaticamente con valori di default validi al successivo lancio del gioco."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 ha avuto un problema e non è in grado di elaborare grafici sul computer (nessun dispositivo grafico valido è stato trovato)."
#@}

