#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>La procedura guidata applicherà le impostazioni consigliate in base ai dispositivi collegati.<br><color value=@@clr_sel@@>Se utilizzi un gamepad compatibile con Steam, valuta la possibilità di abilitare il supporto della configurazione in < br><color value=@@clr_txt_d@@> \"Steam > Impostazioni > Controller > Impostazioni generali del controller\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Guida con la tastiera e guardati attorno con il mouse. E' la forma più semplice e meno precisa di controllo, ma a disposizione di chiunque."

	key[]: "wiz_control_mouse"
	val[]: "Usa il mouse per una guida più precisa. La tastiera viene utilizzata per altre azioni. Puoi utilizzare Il mouse per guardarti attorno se tieni premuto simultaneamente il tasto o il pulsante dedicato."

	key[]: "wiz_control_controller"
	val[]: "Usa il tuo volante, gamepad o joystick per un' esperienza di gioco più realistica. I tasti di scelta rapida della tastiera possono essere utilizzati per l'accesso a molte azioni, e ti è possibile cambiare angolazione della telecamera con il mouse (mouselook)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Non è stato trovato alcun controller. È necessario collegarne uno per abilitare questa scelta!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Rilevamento controller disponibili ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELEZIONA API CONTROLLER" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Mappatura In-game (raccomandata)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Mappatura Steam Client"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Controller classico"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepad come @@controller_ps5@@, @@controller_xbox_one@@ o @@controller_steam_deck@@ configurati dall'interfaccia Steam Input, che utilizzano un layout semplificato.<br><br>Supporta la configurazione completa in-game dei pulsanti."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepad configurati dall'interfaccia Steam Input che utilizzano layout indipendenti assegnati dal client Steam.<br><br>Supporto limitato per suggerimenti e nessuna configurazione in-game."

	key[]: "wiz_api_classical"
	val[]: "Controller, volante o joystick che usa DirectInput, XInput o interfacce simili."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELEZIONA IL TIPO DI CONTROLLER"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volante e pedaliera"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad o joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Il controller è un volante o si comporta come tale. La posizione del controller specifica direttamente la posizione delle ruote motrici nel gioco."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Il controller è un gamepad o un joystick. La posizione del controller specifica la velocità di rotazione delle ruote motrici nel gioco."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELEZIONA IL TIPO DI CAMBIO" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "È il metodo più semplice di guida, progettato principalmente (ma non solo) per il controllo con la tastiera. Premere avanti per guidare avanti e premere indietro per fare retromarcia. La trasmissione si occuperà di inserire i rapporti corretti e gestirà il passaggio tra la guida avanti e la retromarcia."

	key[]: "wiz_gb_automatic"
	val[]: "Ideale per un volante con pedali. Utilizza i pulsanti per selezionare quando vuoi procedere avanti, fermarti (neutro) o innestare la retromarcia. Quindi premi il pedale dell'acceleratore e lascia che il cambio automatico gestisca gli ingranaggi."

	key[]: "wiz_gb_sequential"
	val[]: "Cambia le marce manualmente tra tutti i rapporti avanti, folle e retromarcia. Questo è un po' più difficile da padroneggiare, ma puoi raggiungere prestazioni di guida migliori e avere il pieno controllo del veicolo in ogni situazione."

	key[]: "wiz_gb_hshifter"
	val[]: "Potrai selezionare la marcia desiderata. Simile in difficoltà al cambio sequenziale, ma molto più realistico. E' raccomandato un cambio ad H come G27 o G25. Richiede una pedaliera dotata di frizione."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Questa funzione richiede un volante, gamepad o joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nessun hardware per cambio ad H rilevato,<br>questa funzione potrebbe risultare inutilizzabile."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELEZIONA LAYOUT H-SHIFTER"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "La trasmissione di tipo Range è la scelta più semplice. Ha due gruppi di ingranaggi. Il primo set contiene gli ingranaggi dalla 1ª alla 6ª, il secondo insieme contiene marce dalla 7ª alla 12ª. Il pulsante alterna tra le due serie mentre il cambio seleziona una marcia specifica dal set."

	key[]: "wiz_hs_splitter"
	val[]: "La trasmissione Splitter è una semplice alternativa. Ha due gruppi di ingranaggi. Il primo set contiene le marce dispari numerate (1, 3, 5 ...) la seconda serie contiene le marce pari numerate (2, 4, 6 ...). Alternando il selettore alterni tra le due serie, mentre il cambio seleziona una marcia specifica dal set."

	key[]: "wiz_hs_range_splitter"
	val[]: "La trasmissione Range-Splitter è basata sullo schema dei range-splitter manuali reali. I rapporti sono raggruppati a quattro a quattro per ogni posizione del cambio ad H e utilizzano due alternative. Questa configurazione è raccomandata solo ai giocatori esperti."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Il gioco ora è configurato con le impostazioni di default per l'hardware descritto di seguito. Puoi modificarle usando le impostazioni avanzate oppure poi continuare direttamente nel gioco."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Configurazione avanzata"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Il gioco è ora configurato ed è possibile continuare.<br>Potrai modificare le configurazioni successivamente andando nelle Opzioni del Controlli."

	key[]: "wiz_cfg_steam"
	val[]: "Puoi controllare e configurare i tasti e gli assi per questo controller utilizzando Steam. Le impostazioni per il controller sono disponibili in Steam > Libreria > Euro Truck Simulator 2 > Configurazione controller."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Apri le impostazioni del controller"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Usa @@imm_wiz_dsteerleft@@ e @@imm_wiz_dsteerright@@ per sterzare."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Muovi il mouse a sinistra o a destra per sterzare le ruote motrici nella direzione corrispondente."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Usa @@ima_wiz_j_steer@@ per sterzare."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Usa @@imm_wiz_dforward@@ per guidare avanti e usa @@imm_wiz_dbackward@@ per fare retromarcia."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Muovi @@ima_wiz_j_throttle@@ avanti per guidare avanti e muovilo indietro per fare retromarcia."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Usa @@ima_wiz_j_throttle@@ per guidare avanti e usa @@ima_wiz_j_brake@@ per fare retromarcia."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Usa @@imm_wiz_dforward@@ per accelerare ed usa @@imm_wiz_dbackward@@ per frenare."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Muovi @@ima_wiz_j_throttle@@ avanti per accelerare e muovilo indietro per frenare."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Usa @@ima_wiz_j_throttle@@ per accelerare e usa @@ima_wiz_j_brake@@ per frenare."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Usa @@imv_wiz_gearup@@ per le marce avanti e @@imv_wiz_geardown@@ per la retromarcia."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Usa @@imv_wiz_gearup@@ per la marcia avanti e @@imv_wiz_geardown@@ per la marcia indietro se stai usando la tastiera o un pulsante del controller. Usa @@imv_wiz_drive@@ e @@imv_wiz_reverse@@ per selezionare la direzione di guida se stai utilizzando un cambio ad H."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Usa @@imv_wiz_gearup@@ e @@imv_wiz_geardown@@ per selezionare la marcia desiderata."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Usa il tuo cambio ad H insieme con @@ima_wiz_j_clutch@@ per selezionare la marcia desiderata."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "IMPOSTA GLI ASSI DEL CONTROLLER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualizzazione degli Assi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Puoi provare visivamente la funzione di tutti gli assi selezionati. Usa il controller e guarda le barre in movimento. Ti dirà i limiti, il centraggio, l'orientamento e il comportamento generale di ciascun asse utilizzato."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Configurazione dell'asse"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Per scegliere un asse, fare clic sul pulsante accanto al nome dell'asse. Questo ti farà passare alla modalità d'input. Quindi, usa il controllar per associare l'asse selezionato spostando la levetta, la ruota o il pedale sull'asse scelto."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Zona morta"

	key[]: "wiz_setup_axes_desc3"
	val[]: "La zona morta si riferisce a un'area dell'asse appositamente progettata per non fornire alcun input. Per regolare la zona morta di un asse scelto, spostare il cursore corrispondente. Aumentando il cursore verso destra, la zona morta verrà ingrandita. Questa funzione è particolarmente vantaggiosa per i controller più vecchi, poiché definire una zona morta più ampia può attenuare problemi come l'inesattezza o input errati causati dall'usura dell'hardware."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Modalità asse"

	key[]: "wiz_setup_axes_desc4"
	val[]: "La modalità dell'asse determina come viene gestito nel gioco. L'asse invertito inverte la sua direzione segnalata, risultando in una sterzata a sinistra invece che a destra, ad esempio. Un asse centrato ha la sua posizione predefinita nel mezzo del suo intervallo, come in un joystick. Questa modalità è utile per correggere un asse che è stato rilevato erroneamente."

	key[]: "normal"
	val[]: "Normale" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Invertito" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrato" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Invertito e Centrato" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "CONFIGURAZIONE CAMBIO AUTOMATICO" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Con la trasmissione automatica hai bisogno solo di cambiare tra avanti, indietro o neutro. Potrai farlo utilizzando i seguenti tasti della tastiera o pulsanti del controller. Per modificare le impostazioni, fai click sul pulsante dedicato e premi poi un tasto sulla tastiera o un pulsante del controller desiderato per l'azione."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Se è collegato un hardware per cambio ad H, è possibile utilizzarlo per simulare una leva del cambio automatico. Attivando questa opzione puoi impostare il cambio ad H nelle posizioni per guida avanti e retromarcia. Ogni altra posizione del cambio ad H è considerata come neutrale. Questa impostazione è stata appositamente creata per funzionare con un cambio ad H e non funzionerà con la tastiera o altro controller. Se desideri fare modifiche fai click su un pulsante quindi sposta il cambio ad H nella posizione desiderata poi riportalo di nuovo in posizione neutra."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "CONFIGURAZIONE CAMBIO SEQUENZIALE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Il cambio sequenziale cambia tra tutte le marce avanti, folle e retromarcia. Qui ci sono i tasti o i pulsanti del controller utilizzati per cambiare su e giù in questo ordine. È possibile impostare i propri facendo click sul pulsante e premendo poi un tasto o un pulsante del controller desiderato per l'azione."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "CONFIGURAZIONE CAMBIO H-SHIFTER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Qui è possibile scegliere lo schema per il cambio ad H e provare le sue funzioni. Nella rappresentazione qui a fianco puoi vedere la posizione attuale del cambio e la marcia selezionata. Siccome le trasmissioni contengono più marce delle posizioni del cambio è necessario utilizzare i selettori per passare tra le diverse serie di rapporti."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "La posizione selezionata del cambio e dei selettori è indicata anche qui di seguito, accanto al pulsante associato. Se vuoi effettuare modifiche, fai click sul pulsante appropriato quindi sposta la leva del cambio nella posizione desiderata e poi di nuovo al neutro."
#@}

