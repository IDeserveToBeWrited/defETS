	key[]: "o_im_throttle_op_tooltip"
	val[]: "Assegna il tasto per accelerare."

	key[]: "o_im_back_reverse_op_tooltip"
	val[]: "Assegna il tasto per frenare.<br><br>Se è selezionato il tipo di trasmissione \"Automatico semplice\", lo stesso tasto sarà usato anche per la retromarcia."

	key[]: "o_im_left_op_tooltip"
	val[]: "Assegna il tasto per sterzare a sinistra."

	key[]: "o_im_right_op_tooltip"
	val[]: "Assegna il tasto per sterzare a destra."

	key[]: "o_im_gear_up_op_tooltip"
	val[]: "Assegna il tasto per salire di marcia."

	key[]: "o_im_gear_down_op_tooltip"
	val[]: "Assegna il tasto per scendere di marcia."

	key[]: "o_im_gear_neutral_op_tooltip"
	val[]: "Assegna il tasto per inserire la folle."

	key[]: "o_im_gear_drive_op_tooltip"
	val[]: "Assegna il tasto per passare in Drive."

	key[]: "o_im_gear_reverse_op_tooltip"
	val[]: "Assegna il tasto per inserire la retromarcia."

	key[]: "o_im_gear_up_hint_op_tooltip"
	val[]: "Assegna il tasto che suggerisce alla trasmissione automatica di salire di marcia prima che lo faccia in autonomia."

	key[]: "o_im_gear_down_hint_op_tooltip"
	val[]: "Assegna il tasto che suggerisce alla trasmissione automatica di scendere di marcia prima che lo faccia in autonomia."

	key[]: "o_im_trans_semi_switch_op_tooltip"
	val[]: "Assegna il tasto per cambiare il tipo di trasmissione da \"Automatico Reale\" a \"Sequenziale\" e viceversa."

	key[]: "o_im_auto_transmission_mode_op_tooltip"
	val[]: "Assegna il tasto per cambiare la modalità della trasmissione automatica adattiva."

	key[]: "o_im_engine_op_tooltip"
	val[]: "Assegna il tasto per avviare o spegnere il motore."

	key[]: "o_im_engine_electricity_op_tooltip"
	val[]: "Assegna il tasto per azionare la corrente.<br><br>Se assegnato, dovrai attivare la corrente prima di avviare il motore. Il motore dovrà poi essere spento disattivando la corrente, anziché usare il tasto \"Avvia/Spegni Motore\" standard."

	key[]: "o_im_parkingbrake_op_tooltip"
	val[]: "Assegna il tasto per il freno di stazionamento."

	key[]: "o_im_motorbrake_op_tooltip"
	val[]: "Assegna il tasto per il freno motore.<br><br>Il freno motore sarà attivo finché tieni premuto il tasto."

	key[]: "o_im_engine_brake_tgl_op_tooltip"
	val[]: "Assegna il tasto per azionare il freno motore.<br><br>Dopo la pressione del tasto, il freno motore sarà attivo finché non premi di nuovo il tasto."

	key[]: "o_im_engine_brake_up_op_tooltip"
	val[]: "Assegna il tasto per incrementare il freno motore."

	key[]: "o_im_engine_brake_down_op_tooltip"
	val[]: "Assegna il tasto per decrementare il freno motore."

	key[]: "o_im_auto_engine_brake_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare il freno motore automatico."

	key[]: "o_im_trailer_brake_op_tooltip"
	val[]: "Assegna il tasto per il freno del rimorchio."

	key[]: "o_im_retarder_up_op_tooltip"
	val[]: "Assegna il tasto per incrementare il retarder."

	key[]: "o_im_retarder_down_op_tooltip"
	val[]: "Assegna il tasto per decrementare il retarder."

	key[]: "o_im_auto_retarder_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare il retarder automatico."

	key[]: "o_im_lift_axle_op_tooltip"
	val[]: "Assegna il tasto per alzare/abbassare gli assi, se il camion ha gli assi sollevabili."

	key[]: "o_im_lift_axle_trailer_op_tooltip"
	val[]: "Assegna il tasto per alzare/abbassare gli assi, se il rimorchio ha gli assi sollevabili."

	key[]: "o_im_slide_axle_manual_op_tooltip"
	val[]: "Assegna i tasti per alternare la regolazione manuale dell'asse/tandem, se il tuo rimorchio ha un asse/tandem scorrevole. La regolazione manuale frena le ruote del rimorchio e disaccoppia l'asse/tandem dal telaio, così che la posizione dell'asse/tandem può essere regolata spostando il camion.<br><br>Se non assegnato, gli assi si spostano automaticamente per adattarsi alla situazione attuale."

	key[]: "o_im_diff_lock_op_tooltip"
	val[]: "Assegna il tasto per bloccare/sbloccare il differenziale."

	key[]: "o_im_front_susp_up_op_tooltip"
	val[]: "Assegna il tasto per regolare in su l'altezza della sospensione anteriore."

	key[]: "o_im_front_susp_down_op_tooltip"
	val[]: "Assegna il tasto per regolare in giù l'altezza della sospensione anteriore."

	key[]: "o_im_rear_susp_up_op_tooltip"
	val[]: "Assegna il tasto per regolare in su l'altezza della sospensione posteriore."

	key[]: "o_im_rear_susp_down_op_tooltip"
	val[]: "Assegna il tasto per regolare in giù l'altezza della sospensione posteriore."

	key[]: "o_im_trailer_susp_up_op_tooltip"
	val[]: "Assegna il tasto per regolare in su l'altezza della sospensione del rimorchio."

	key[]: "o_im_trailer_susp_down_op_tooltip"
	val[]: "Assegna il tasto per regolare in giù l'altezza della sospensione del rimorchio."

	key[]: "o_im_susp_reset_op_tooltip"
	val[]: "Assegna il tasto per ripristinare l'altezza della sospensione."

	key[]: "o_im_lblinker_op_tooltip"
	val[]: "Assegna il tasto per la freccia sinistra."

	key[]: "o_im_rblinker_op_tooltip"
	val[]: "Assegna il tasto per la freccia destra."

	key[]: "o_im_4wflasher_op_tooltip"
	val[]: "Assegna il tasto per il segnalatore di emergenza."

	key[]: "o_im_lights_op_tooltip"
	val[]: "Assegna il tasto per cambiare modalità tra luci spente, luci di posizione e anabbaglianti."

	key[]: "o_im_hb_light_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare gli abbaglianti."

	key[]: "o_im_beacon_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare il lampeggiante, se il camion o il rimorchio ne sono provvisti."

	key[]: "o_im_horn_op_tooltip"
	val[]: "Assegna il tasto per suonare il clacson."

	key[]: "o_im_air_horn_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare le trombe, se il camion o il rimorchio ne sono provvisti."

	key[]: "o_im_light_horn_op_tooltip"
	val[]: "Assegna il tasto per azionare gli abbaglianti."

	key[]: "o_im_wipers_op_tooltip"
	val[]: "Assegna il tasto per cambiare la velocità dei tergicristalli."

	key[]: "o_im_wipers_back_op_tooltip"
	val[]: "Assegna il tasto per cambiare la velocità dei tergicristalli in ordine inverso.<br><br>Se assegnato, il tasto standard dei tergicristalli verrà usato per l'ordine opposto e non ciclerà più tra le posizioni."

	key[]: "o_im_cruise_ctrl_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare il cruise control."

	key[]: "o_im_cruise_ctrl_inc_op_tooltip"
	val[]: "Assegna il tasto per incrementare la velocità del cruise control."

	key[]: "o_im_cruise_ctrl_dec_op_tooltip"
	val[]: "Assegna il tasto per decrementare la velocità del cruise control."

	key[]: "o_im_cruise_ctrl_resume_op_tooltip"
	val[]: "Assegna il tasto per ripristinare l'ultima velocità del cruise control, ad es. dopo averlo disattivato frenando."

	key[]: "o_im_acc_mode_op_tooltip"
	val[]: "Assegna il tasto per cambiare la modalità del cruise control adattivo."

	key[]: "o_im_emergency_brake_op_tooltip"
	val[]: "Assegna il tasto per attivare o disattivare il freno di emergenza."

	key[]: "o_im_lane_keeping_assist_op_tooltip"
