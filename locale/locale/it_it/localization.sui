	key[]: "trip_land_len_estimate"
	val[]: "Distanza stimata dal terreno:"

	key[]: "set_navigation_to_portal"
	val[]: "Imposta il waypoint sul portale desiderato"

	key[]: "wanna_assistance_portal"
	val[]: "Il servizio di assistenza può portare te e il tuo camion gratuitamente a un portale casuale.<br offset=30>Sei d'accordo?"

	key[]: "wanna_assistance_portal_online"
	val[]: "Il soccorso stradale porterà te e il tuo camion gratuitamente a un portale casuale.<br offset=30>La consegna in corso verrà annullata.<br offset=30>Accetti?"

