#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "PANORAMICA DI STATO DEL CAMION" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "Condizione" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Il veicolo presenta guasti meccanici significativi che incidono su prestazioni ed affidabilità. Potresti considerare un restauro totale o la sostituzione di più componenti." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "Il veicolo presenta guasti meccanici che potrebbero compromettere prestazioni ed affidabilità. La manutenzione è necessaria." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Il veicolo è idoneo alla guida ma potrebbero verificarsi dei guasti. La manutenzione è raccomandata." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Il veicolo è in ottime condizioni e presenta solo usura e danni minori." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Il veicolo è in condizioni eccellenti e presenta un'usura minima." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Manutenzione" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "Rappresenta l'invecchiamento sistematico e l'aumento continuo dell'usura in tutto il veicolo. Riparabile con un restauro totale." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Usura delle parti" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "Chilometraggio ed incidenti comportano l'usura e il danneggiamento dei singoli componenti. Monitora le loro condizioni e sostituiscili se necessario." #+ Explanation unfixable wear.
#@}

