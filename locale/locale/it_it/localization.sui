#+ Allows to change color and image on the truck.
#@{

	key[]: "truck_paint_t"
	val[]: "VERNICIATURA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "truck_paint"
	val[]: "Verniciare" #+ Icon allowing player to apply a new paint to the truck. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "truck_paint_about"
	val[]: "Stufo della verniciatura del tuo camion? Aggiungi un po' di colore!" #+ Help message associated with paint shop icon.

	key[]: "paintjob_t"
	val[]: "COLORI DISPONIBILI" #+ Header of section containing all blueprints of the paintings. Please keep in upper case where possible.

	key[]: "paint_channel"
	val[]: "Slot Vernice" #+ Tooltip shown when mouse hovers over one from color slots available in the selected paint.

	key[]: "tooltip_save_ucolor"
	val[]: "Salva colore come predefinito" #+ Tooltip for a button which stores currently selected color in selected preset slot.

	key[]: "tooltip_save_preset_ucolor"
	val[]: "Salva tutti i colori come predefiniti" #+ Tooltip for a button which stores all paintjob colors in selected preset slot.

	key[]: "tooltip_apply_ucolor"
	val[]: "Applica colore predefinito" #+ Tooltip for a button which applies color from currently selected preset slot.
#@}

