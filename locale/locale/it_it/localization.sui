#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Seleziona il controller secondario per gestire correttamente gli intervalli di input in gioco."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Seleziona il tipo di trasmissione:<br>- \"Automatico semplice\" permette di usare acceleratore e freno per controllare i movimenti in avanti e in retromarcia.<br>- \"Automatico reale\" richiede un input per passare dalle marce avanti alle marce in retro.<br>- \"Sequenziale\" richiede la cambiata manuale di tutte le marce con input appositi per incrementare o scalare le marce.<br>- \"Cambio ad H\" richiede l'uso di un controller con cambio per selezionare manualmente le marce."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Modifica la logica di cambiata della trasmissione automatica:<br>- La modalità \"Economy\" preferisce giri più bassi alla coppia massima.<br>- La modalità \"Potenza\" preferirà un picco di potenza per una guidabilità migliore con carichi pesanti o terreni montagnosi, a discapito del risparmio di carburante."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Regola il rapporto tra il grado di rotazione del dispositivo e il grado effettivo di rotazione dello sterzo del veicolo."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Regola la linearità tra input e sterzata del veicolo.<br><br>Regolare questo valore più alto significa che lo sterzo sarà meno reattivo quando il volante è al centro, e aumenterà la sensibilità mentre il volante è girato verso un estremo. Questo può essere utile per attenuare gli input di sterzata procedendo dritti."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Abilita il force feedback nei controller che lo supportano."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Regola il guadagno complessivo per tutte le impostazioni di force feedback tra 0N e 10N.<br><br><color value=@@clr_txt_d@@>Attenzione: impostare un valore alto nelle wheel base più potenti potrebbe causare lesioni alle dita o alle mani."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Regola la forza di centraggio quando si guida ad alta velocità, che raggiunge i 90 km/h (56 mph) e oltre.<br><br>L'impostazione minima comporta l'assenza di forza di centraggio del volante."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Regola la forza di centraggio quando si guida a bassa velocità.<br><br>L'impostazione minima comporta l'assenza di forza di centraggio del volante."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Regola la forza della frizione interna artificiale causata dai componenti meccanici dello sterzo."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Regola la forza della risonanza artificiale del motore attraverso il piantone dello sterzo.<br><br><color value=@@clr_txt_d@@>Attenzione: l'impostazione di un valore superiore al 15% può causare eccessive vibrazioni in alcuni volanti."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Regola la forza degli effetti della superficie stradale attraverso il piantone dello sterzo.<br><br><color value=@@clr_txt_d@@>Attenzione: l'impostazione di un valore oltre il 20% può causare eccessive vibrazioni in alcuni volanti quando si guida su terreni accidentati."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità degli effetti degli avvallamenti attraverso il piantone dello sterzo."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità degli effetti delle collisioni attraverso il piantone dello sterzo."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità degli effetti di inceppamento del cambio."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità degli effetti dello scivolamento da sottosterzo."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità della sterzata assistita (quando è attivo l'assistente di corsia, ecc.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità delle vibrazioni della superficie del terreno, se il controller supporta il feedback a vibrazione."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità delle vibrazioni delle sconnessioni, se il controller supporta il feedback a vibrazione."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Regola l'intensità delle vibrazioni delle collisioni, se il controller supporta il feedback a vibrazione."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'asse del dispositivo da usare per la sterzata."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta dell'asse di sterzo; la quantità di rotazione dal centro per cui l'input è ignorato.<br><br>Ciò può attenuare i problemi dei controller più vecchi, come l'imprecisione o il falso input causato dall'usura."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina come il gioco gestisce l'input dell'asse di sterzo.<br>- Centrato è ideale per volanti o joystick.<br>- Invertito viene utilizzato per correggere un asse che non è stato rilevato correttamente."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'asse del dispositivo da usare per accelerare il camion."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta dell'asse di accelerazione; la quantità di corsa per cui non viene registrato alcun input.<br><br>Ciò può attenuare i problemi dei controller più vecchi, come l'imprecisione o il falso input causato dall'usura."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina come il gioco gestisce l'input del controller:<br>- Centrato è ideale per i joystick.<br>- Normale è ideale per i trigger o i pedali.<br>- Invertito può compensare input non rilevati correttamente."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'asse del dispositivo da usare per la frenata."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta dell'asse di frenata; la quantità di corsa per cui non viene registrato alcun input.<br><br>Ciò può attenuare i problemi dei controller più vecchi, come l'imprecisione o il falso input causato dall'usura."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina come il gioco gestisce l'input del controller:<br>- Centrato è ideale per i joystick.<br>- Normale è ideale per i trigger o i pedali.<br>- Invertito può compensare input non rilevati correttamente."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'asse del dispositivo da usare per innestare la frizione."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta dell'asse della frizione; la quantità di corsa per cui non viene registrato alcun input.<br><br>Ciò può attenuare i problemi dei controller più vecchi, come l'imprecisione o il falso input causato dall'usura."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina come il gioco gestisce l'input del controller:<br>- Centrato è ideale per i joystick.<br>- Normale è ideale per i trigger o i pedali.<br>- Invertito può compensare input non rilevati correttamente."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta della frizione.<br><br>Più a destra imposti il valore, più dovrai rilasciare il pedale per innestare la frizione."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'asse del dispositivo da usare per inclinare su e giù la visuale."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta dell'asse della visuale su-giù; la quantità di corsa per cui non viene registrato alcun input.<br><br>Ciò può attenuare i problemi dei controller più vecchi, come l'imprecisione o il falso input causato dall'usura."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina come il gioco gestisce l'input dell'asse:<br>- Centrato è ideale per volanti o joystick.<br>- Invertito viene utilizzato per correggere un asse che non è stato rilevato correttamente."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'asse del dispositivo da usare per ruotare la visuale a destra e sinistra."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Regola la zona morta dell'asse della visuale sinistra-destra; la quantità di corsa per cui non viene registrato alcun input.<br><br>Ciò può attenuare i problemi dei controller più vecchi, come l'imprecisione o il falso input causato dall'usura."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina come il gioco gestisce l'input dell'asse:<br>- Centrato è ideale per volanti o joystick.<br>- Invertito viene utilizzato per correggere un asse che non è stato rilevato correttamente."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Seleziona lo schema di cambiata da usare con il Cambio ad H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Modifica il comportamento del cambio:<br>- Con l'opzione \"Semplice\" le marce non si incepperanno mai in cambiata.<br>- L'opzione \"Semplice + suono di avviso\" ti permetterà di cambiare in modo semplice, ma con \"grattate\" quando cambi marcia in modo errato.<br>- L'opzione \"Avanzata\" non ti permetterà di cambiare marcia se lo fai in modo errato, e sentirai solo il cambio che \"gratta\". L'opzione \"Avanzata\" consente inoltre di utilizzare l'impostazione \"Splitter del cambio\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Seleziona come il gioco gestisce lo splitter:<br>- \"Mai\" richiederà che la leva del cambio venga messa in folle tra gli split.<br>- \"Azionamento frizione\" richiede un rilascio momentaneo della frizione senza movimento del cambio.<br>- \"Rilascio dell'acceleratore\" richiede al conducente di rilasciare solo l'acceleratore per azionare lo splitter senza movimento del cambio, e \"Frizione o acceleratore\" è una combinazione degli ultimi due."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Assegna la posizione della leva del cambio."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Assegna il pulsante utilizzato per passare da un intervallo all'altro, in base allo schema di cambiata."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Assegna il pulsante per azionare lo splitter in base allo schema di cambiata."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Abilita l'utilizzo di interruttori anziché pulsanti per trasmissioni Range o Splitter."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Assegna un pulsante per passare alla modalità Drive della trasmissione automatica."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Assegna un pulsante per passare alla modalità Reverse della trasmissione automatica."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Abilita la risposta RGB dinamica nei dispositivi compatibili."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Abilita e configura le opzioni di tracciamento dell'occhio nei dispositivi compatibili."
#@}

#@}

#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "TRACCIA VISTA" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Vista estesa" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Preset Vista Estesa" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Inserisci nome preset" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Sei sicuro di voler eliminare il preset selezionato?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Il preset esistente con lo stesso nome sarà sovrascritto. Vuoi continuare?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Imposta Tracciamento Sguardo" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Imposta Tracciamento Testa" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Controlli tastiera" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Attiva Vista Estesa" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Attiva autocentraggio" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Modalità tracciamento Testa" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Diretto" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinamico" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Monitoraggio reattività vista" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Monitoraggio reattività testa" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Abilita rotazione" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Abilita posizione" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Moltiplicatore Yaw (in cabina)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Moltiplicatore Pitch (in cabina)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Moltiplicatore Yaw (modalità cammino)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Moltiplicatore Pitch (modalità cammino)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Massimo angolo di visione" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Mantenere velocità di tracciamento"

	key[]: "eye_gaze_exponent"
	val[]: "Mantenere velocità esponenziale"

	key[]: "eye_gaze_inflection_point"
	val[]: "Rilevamento punto di svolta"

	key[]: "eye_gaze_start_point"
	val[]: "Rilevamento punto di partenza"

	key[]: "eye_gaze_end_point"
	val[]: "Rilevamento punto di fine"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Sensibilità imbardata in tracciamento testa (a bordo)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Sensibilità beccheggio in tracciamento testa (a bordo)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Sensibilità imbardata in tracciamento testa (modalità cammino)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Sensibilità beccheggio in tracciamento testa (modalità cammino)"

	key[]: "eye_head_exponent"
	val[]: "Punto massimo testa"

	key[]: "eye_head_inflection_point"
	val[]: "Punto di inflessione testa"

	key[]: "eye_head_start_point"
	val[]: "Punto di partenza testa"

	key[]: "eye_head_end_point"
	val[]: "Punto di fine testa"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Abilita la vista estesa, che incrementa l'angolo visivo utilizzando i movimenti di testa e/o occhi per controllare la visuale di gioco."

	key[]: "eye_preset_op_tooltip"
	val[]: "Selezione dei preset Vista Estesa."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Selezione delle modalità di tracciamento testa:<br>- In modalità \"Diretta\", la rotazione della testa corrisponde direttamente alla rotazione della visuale di gioco. È raccomandata nelle normali situazioni di abitacolo/cabina.<br>- In modalità \"Dinamica\", lo sguardo influirà sulla visuale di gioco solo all'effettivo movimento della testa. È raccomandata quando è necessario l'assoluto centraggio della visuale."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Se abilitato, la visuale di gioco andrà lentamente a ricentrarsi man mano che cambi la posizione naturale della testa."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Se abilitato, la posizione della tua testa influisce sulla posizione della visuale di gioco."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Se abilitato, la visuale di gioco si inclinerà conseguentemente all'inclinazione della testa da qualsiasi lato."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Moltiplica il movimento dello sguardo e della testa in orizzontale (a bordo)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Moltiplica il movimento dello sguardo e della testa in verticale (a bordo)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Moltiplica il movimento dello sguardo e della testa in orizzontale (modalità cammino)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Moltiplica il movimento dello sguardo e della testa in verticale (modalità cammino)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Regola quanto velocemente si muove la visuale di gioco rispetto ai movimenti del tuo sguardo."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Regola quanto gradualmente aumenta la velocità."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Regola la distanza dal centro dello schermo in cui l'accelerazione inizierà a livellarsi."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Regola quanto lontano dal centro dello schermo dovrai guardare prima che la visuale di gioco inizi a muoversi."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Regola quanto lontano dal centro dello schermo dovrai guardare per raggiungere la massima velocità della telecamera."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Determina quanto può girare la telecamera quando si guarda ai bordi dello schermo."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Regola quanto velocemente si muove la visuale di gioco rispetto ai movimenti della tua testa."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Regola di quanto l'inquadratura girerà a sinistra o destra rispetto a quanto giri la testa (a bordo)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Regola di quanto salirà o scenderà l'inquadratura rispetto a quanto giri la testa (a bordo)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Regola di quanto l'inquadratura girerà a sinistra o destra rispetto a quanto giri la testa (modalità cammino)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Regola di quanto salirà o scenderà l'inquadratura rispetto a quanto giri la testa (modalità cammino)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Regola quanto gradualmente aumenta la velocità."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Regola di quanto devi girare la testa prima che l'accelerazione inizi a livellarsi."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Regola di quanto devi ruotare la testa dalla posizione centrale prima che l'inquadratura inizi a muoversi."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Regola di quanto devi ruotare la testa dalla posizione centrale per raggiungere la massima rotazione della videocamera."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Selezione delle modalità di autopausa."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Regola la quantità di tempo in millisecondi prima che il gioco si interrompa automaticamente quando non riesce a rilevare lo sguardo."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Assegna il tasto per impostare la posizione attuale della testa come nuova posizione predefinita, ricentrando di conseguenza la visuale di gioco."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Assegna il tasto per attivare/disattivare tutte le opzioni Tobii Extended View."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Assegna il tasto per aprire le impostazioni di Tracciamento Visivo."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Assegna il tasto per abilitare il tracciamento della testa."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Assegna il tasto per applicare il rispettivo preset Vista Estesa."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Assegna il tasto per applicare il rispettivo preset Vista Estesa."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Assegna il tasto per applicare il rispettivo preset Vista Estesa."
#@}

