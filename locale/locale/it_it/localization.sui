#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS COLLEGATO" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Connetti" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Sfoglia" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "IMPOSTAZIONI GENERALI" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONNESSIONE AL CONTENUTO" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Connetti" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks ha rilevato nuovi contenuti di gioco. Collegati al servizio di World of Trucks per accedervi." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Preferenze Online. Regola tutti i relativi settaggi di World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Vuoi davvero rinviare la registrazione?<br><br>Puoi accedere al Contenuto Online più tardi dalle Opzioni Online, collocate sul desktop." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "COLLEGAMENTO AL CONTENUTO" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Collegamento al contenuto." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Fallita la coda di connessione per: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "L'account Steam con cui hai registrato questo DLC differisce da quello che hai usato per creare il tuo account di World Of Trucks o per registrare il gioco. Prego passa al tuo account Steam e riprova." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "L'account Steam che stai utilizzando per registrare questo DLC è già stato associato ad un differente account di World Of Trucks. Per registrare il DLC con l'account attuale hai bisogno di usare un account di Steam che non sia connesso ad alcun account di World Of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Il token Steam è scaduto. Per favore riprova più tardi." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "La serial key per l'attivazione del DLC non è valida. Prego contatta il supporto: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Si è verificato un errore interno durante la registrazione del gioco. Prego riprova più tardi." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCCESSO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMAZIONI" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "NAVIGAZIONE CONTENUTI" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Congratulazioni! La DLC selezionata è stata connessa con successo al tuo account World Of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Impossibile collegarsi al contenuto perché il corrente account steam è associato ad un differente account di World Of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Connessione fallita di alcune DLC.<br>Sposta il mouse sui punti esclamativi di ogni DLC per vedere ulteriori dettagli.\n" #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrazione $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Il profilo attuale non è collegato a World of Trucks oppure il gioco sta girando in modalità offline. Modifica il profilo per connetterti." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Clicca per chiudere"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLC compatibili connessi. Se alcuni DLC non sono collegati a World Of Trucks puoi perdere alcune loro funzionalità." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Congratulazioni!<color value=@@clr_txt@@>Tutti i tuoi contenuti sono collegati a World of Trucks! Adesso puoi utilizzare tutte le funzionalità." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Non è stato possibile collegare i nuovi contenuti a World of Trucks perché il profilo Steam attualmente utilizzato non corrisponde al profilo Steam impiegato in World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Connesso" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Non connesso" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Non è stato possibile recuperare informazioni sul contenuto di proprietà." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Non è stato possibile recuperare informazioni sul contenuto connesso." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Non è stato possibile recuperare informazioni circa l'account utente attuale." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Più tardi" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Impossibile registrare questo DLC. Nessuna licenza permanente trovata probabilmente a causa della condivisione di Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Nessuna proprietà permanente" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Missione trasporto speciale eseguita!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISSIONE FALLITA!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Abbandona"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Carica il Checkpoint"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Hai danneggiato il veicolo di scorta !<br>Puoi caricare un checkpoint o cancellare la consegna pagando una penale di $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Il veicolo di scorta ha incidentato con un altro veicolo a causa di una guida incorretta.<br>Puoi caricare un checkpoint o cancellare la consegna pagando una penale di $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Avresti dovuto seguire l'itinerario.<br> Puoi caricare un checkpoint oppure annullare la consegna pagando una penale di $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Devi restare con i veicoli di scorta.<br>Puoi caricare un checkpoint o cancellare la consegna pagando una penale di $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Ti sei allontanato dal veicolo di scorta!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Hai danneggiato il veicolo di scorta!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Il veicolo di scorta ha avuto un incidente!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Stai guidando fuori percorso!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimensioni"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Trasporti eccezionali"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Prego mantieni il carico tra i veicoli di scorta."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Consegne Speciali"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimensioni"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Trasporti Speciali"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Prego, rallenta per evitare di tamponare il veicolo di scorta..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Sei pregato di attendere il veicolo di scorta posteriore..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Attenzione adesso, stai arrivando in una strada molto stretta... "

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Ti stai avvicinando al cambio di corsia. Adatta la tua velocità per evitare un possibile incidente..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Il veicolo di scorta anteriore avviserà gli altri guidatori ... <br> Adatta la tua velocità per evitare un possibile incidente..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "I veicoli della scorta ti stanno aspettando all'incrocio. Per favore segui la strada."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Attenzione!<br> Ti stai avvicinando al veicolo di scorta posteriore!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Attento!<br>Ti stai avvicinando pericolosamente al veicolo di scorta posteriore!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Premi il tasto seguente per vedere le offerte di lavoro speciale:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Offerta di lavoro speciale:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Stai per affrontare un trasporto eccezionale! Ci saranno due veicoli che ti scorteranno. Fai attenzione e segui i loro comandi e suggerimenti. I trasporti eccezionali come questo non si fermano ai semafori rossi e hanno il diritto di precedenza nella maggior parte delle situazioni. Durante queste consegne i checkpoint sono creati più spesso per salvare i tuoi progressi."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Presta particolare attenzione a:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Evita ogni possibile incidente con i veicoli di scorta e mantieni il carico tra di loro."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Non abbandonare il percorso previsto, non fermarti in nessuna area di servizio e/o area di sosta."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Rispetta i limiti di velocità che saranno mantenuti dal veicolo di scorta anteriore."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Fai attenzione al traffico in sorpasso e agli altri conducenti sulle strade."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manovra cambio corsia:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Se non seguirai queste regole, la tua consegna trasporto speciale potrebbe fallire!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "La manovra viene avviata dalla <color value=@@clr_sel@@>scorta<color value=@@clr_txt@@> posteriore cambiando e bloccando la corsia designata."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "La <color value=@@clr_sel@@>scorta<color value=@@clr_txt@@> anteriore attende che si liberi la corsia designata, poi anche lei cambia corsia."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "A questo punto diventa sicuro per il  <color value=@@clr_sel@@>camionista<color value=@@clr_txt@@>manovrare nella corsia designata."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "I serbatoi del camion sono stati riempiti e le ore di guida sono state ripristinate."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Non puoi chiedere assistenza durante la consegna trasporto speciale."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Non è possibile utilizzare un traghetto durante la missione Trasporto Speciale."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Ti stai riposando un po'...<br>I serbatoi del camion si stanno rifornendo..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Sosta obbligatoria in avvicinamento.<br>Segui la scorta fino al parcheggio per riposare!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Sosta obbligatoria"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Premi il pulsante seguente per riposare e fare rifornimento:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Si è verificato un errore durante il caricamento dell'inventario di Steam.<br><br>$ERROR$<br><br>Seleziona continua per mantenere il contenuto abilitato. Il gioco lo cercherà periodicamente.<br><br>Puoi temporaneamente disabilitare il contenuto per non veder apparire più il messaggio di errore. Il gioco abiliterà il contenuto in automatico al prossimo riavvio." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Impossibile scaricare gli elementi dall'inventario di Steam." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "INVENTARIO STEAM" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Caricamento degli elementi dell'inventario di Steam..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NUOVI ELEMENTI DI INVENTARIO" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Sono state rilevate nuove voci dell'inventario di Steam." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Accessori veicolo" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Accessori cabina" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Sfondi desktop" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Verniciatura" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Disattiva inventario" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Riprova più tardi" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "INVENTARIO STEAM" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Alcuni oggetti sono stati rimossi dal tuo inventario di Steam. Non sarai in grado di acquistarli dallo shop.<br><br>Ciò non influisce sugli elementi attualmente installati." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


#+ Localized versions of the Steam operation results.
#@{
	key[]: "steam_result_genericerror"
	val[]: "Errore interno Steam" #+ The generic error message used when no specific message is defined for some result.

	key[]: "steam_result_ok"
	val[]: "Congratulazioni" #+ Success result message.

	key[]: "steam_result_serviceunavailable"
	val[]: "Impossibile stabilire la connessione a Steam. Prego controlla la tua connessione ad internet, se tutto va bene riprova più tardi." #+ The message showed when game fails to connect to Steam servers.

	key[]: "steam_result_timeout"
	val[]: "La connessione tra Steam e il gioco è scaduta. Riprova." #+ The message showed when connection between game and Steam services times out.
#@}

