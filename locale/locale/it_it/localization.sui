#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Il DLC richiesto (espansione ufficiale del gioco) $DEPENDENCY_NAME$ è mancante. Affinché questo salvataggio funzioni correttamente, questo DLC ha bisogno di essere presente e attivato su questo computer. E' necessario risolvere il problema prima di caricare questo salvataggio." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Il DLC opzionale (espansione ufficiale del gioco) $DEPENDENCY_NAME$ è mancante. Se non te lo aspettavi, controlla lo stato dei DLC.<br><br>Altrimenti puoi ugualmente caricare il salvataggio, tuttavia alcune funzionalità derivanti dal DLC potrebbero essere perse." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "La MOD $DEPENDENCY_NAME$ è mancante o disabilitata. Se non te lo aspettavo, controlla lo stato della MOD. Puoi caricare ugualmente il salvataggio. Tuttavia, a seconda dell'architettura della MOD, è possibile che fallisca il caricamento o che si crei un'altro problema." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "La MOD $DEPENDENCY_NAME$ è incompatibile con la tua versione del gioco. Ciò significa che l'autore ha segnato la MOD come compatibile soltanto con un numero limitato di versioni del gioco e la versione attuale del gioco non è tra queste.<br><br>La soluzione:<br>- Prova a cercare una versione della MOD che sia compatibile con la corrente versione del gioco.<br>- Installa la versione del gioco compatibile con la MOD.<br><br>Puoi provare ugualmente a caricare il salvataggio. Tuttavia la MOD non verrà caricata e a seconda dall'architettura della MOD è possibile che il caricamento possa fallire o causare altri problemi." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "DIPENDENZE MANCANTI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETTAGLI" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Apri la pagina workshop"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Questo salvataggio dipende dal DLC o MOD che è attualmente mancante, elencato di seguito. Selezionando una voce dalla lista è possibile avere maggiori informazioni su ogni elemento specifico." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Questo salvataggio dipende da almeno un DLC o MOD. È necessario risolvere il problema prima di poter caricare questo salvataggio." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Interrompi caricamento" #+ Abort loading button.

	key[]: "type"
	val[]: "Genere" #+ Type column.

	key[]: "dependency_name"
	val[]: "Nome dipendenza" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "MOD Locali" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Mod Workshop" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "DLC opzionale" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "DLC richiesta" #+ DLC that is required to load save that is depending on it.
#@}

