#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Selezione dei temi che sono mostrati sullo sfondo quando navighi nel menù."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Abilita la selezione casuale dello sfondo ogni volta che apri il gioco."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Imposta il ritardo della sfocatura degli elementi sul desktop."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, inizierai a sentire gli effetti dell'affaticamento nel tempo.<br><br>Evitare di riposare comporterà la comminazione di multe."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, dovrai rispettare il codice della strada o rischierai di essere multato. Il rischio aumenta in presenza di veicoli della polizia, autovelox e telecamere del traffico."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Regola la lunghezza media delle offerte di lavoro."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleziona quale limite di velocità mostrare sullo schermo del widget di navigazione."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "La velocità attuale sul navigatore diventa rossa quando viene superato il limite."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando arrivi a destinazione, un widget verrà mostrato per darti la possibilità di saltare il parcheggio."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Nascondi tutti i widget."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Tiene nascosti entrambi gli specchietti HUD."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantiene nascoste tutte le notifiche anche quando vengono ricevute."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Mostra una finestra che illustra le caratteristiche del camion attuale del giocatore prima di accettare un lavoro con carico pesante."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Scegli l'orientamento della mappa."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Scegli come mostrare la navigazione."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Cambia la modalità di scelta del percorso:<br>- La modalità \"Migliore\" ottimizza il rapporto tra lunghezza e durata del percorso, cerca di evitare incroci con semafori, ecc.<br>- La modalità \"Più breve\" sceglie sempre il percorso più corto.<br>- La modalità \"Strade secondarie\" evita le autostrade ove possibile."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la difficoltà del parcheggio:<br>- \"Scegli sempre\" ti permette di scegliere non appena arrivi a destinazione.<br>- \"Parcheggio assistito\" non richiede manovre.<br>- \"Parcheggio esperto\" solitamente richiederà una manovra più complessa."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Regola la probabilità di incontrare pericoli stradali nelle vicinanze tra cui incidenti, veicoli fermi, detriti, ecc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Regola la probabilità di incontrare delle deviazioni di percorso durante un lavoro."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Regola la probabilità di condizioni meteo avverse."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Scegli quali informazioni sul fuso orario mostrare insieme all'orario attuale."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Abilita le cutscene solitamente mostrate in gioco dopo l'acquisto di un camion o l'aggiornamento di un garage."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Scegli se mostrare le barriere traslucide sulle strade inaccessibili."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverte l'asse Y del mouse quando controlli la telecamera nel gioco."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleziona il tipo di trasmissione:<br>- \"Automatico semplice\" permette di usare acceleratore e freno per controllare i movimenti in avanti e in retromarcia.<br>- \"Automatico reale\" richiede un input per passare dalle marce avanti alle marce in retro.<br>- \"Sequenziale\" richiede la cambiata manuale di tutte le marce con input appositi per incrementare o scalare le marce.<br>- \"Cambio ad H\" richiede l'uso di un controller con cambio per selezionare manualmente le marce."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "La selezione di questa impostazione abiliterà il \"salto delle cambiate\" - saltando delle marce se necessario o per evitare di passare per ogni marcia della trasmissione."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Riporta il volante al centro quando si usa una tastiera o un controller.<br><br>Disabilitare questa funzione significa che dovrai riportare manualmente il volante al centro dopo aver curvato."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Regola l'intervallo dell'animazione del volante. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la forza della frenata."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la stabilità del camion abbassando il suo centro di gravità."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la stabilità del rimorchio abbassando il suo centro di gravità."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica l'intensità della coppia generata dalla trasmissione.<br><br>Incrementando questa impostazione, aumenterà la sensazione del camion che \"tira\" a destra."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la rigidità delle sospensioni del telaio."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la rigidità delle sospensioni della cabina/cuccetta."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Regola l'intensità delle sconnessioni generate proceduralmente per dare a strade e altri terreni una sensazione imperfetta.<br><br>A seconda delle altre impostazioni di sospensioni e visuale, l'effetto percepito può essere più o meno evidente."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Abilita l'aggancio avanzato che richiede una maggiore precisione per allineare la ralla del camion con il perno del rimorchio.<br><br>Se disattivato, agganciare un rimorchio diventa molto più facile in quanto non vi è alcuna collisione tra il perno e la ralla."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona se, e quali cavi del rimorchio sono animati.<br><br><color value=@@clr_txt_d@@>Abilitare l'animazione dei cavi su più veicoli potrebbe rallentare le prestazioni dei sistemi più datati."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Abilita il limitatore di velocità di 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>I lavori di World of Trucks hanno questa funzionalità sempre attiva."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, e i tergicristalli sono impostati alla prima posizione, essi si attiveranno automaticamente e regoleranno la velocità in base alle condizioni."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Abilita l'azionamento automatico del retarder in frenata."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, il veicolo assiste le partenze in salita azionando i freni e assicurando una partenza fluida."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Abilita l'azionamento automatico del freno motore in frenata."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, il motore si avvierà alla pressione dell'acceleratore."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, il freno a mano viene applicato di default (con un traghetto, un carro attrezzi, un viaggio rapido, ecc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Aziona automaticamente gli assi di sollevamento quando necessario, a seconda del peso del veicolo."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, il veicolo ridurrà di default l'acceleratore. Con una doppia pressione rapida, il veicolo aprirà l'acceleratore al massimo finché il tasto non verrà rilasciato.<br><br>Solo per l'input Tastiera."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simula la perdita d'aria che nella realtà si ha con una frenata eccessiva.<br><br>Se abilitato, dovrai gestire le pressioni dell'aria nelle discese o effettuando manovre lente con più frenate."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, l'ABS impedirà il bloccaggio delle ruote per mantenere il controllo e migliorare la capacità di frenata."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, il camion applicherà una frenata per singola ruota per impedire slittamenti, sottosterzo o sovrasterzo, e aiutare a mantenere il controllo."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, verrà inserito il blocco del differenziale per migliorare la trazione se le ruote iniziano a slittare."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica l'incremento di velocità con cui il cruise control aumenterà o diminuirà quando l'apposito tasto viene premuto."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la tolleranza del cruise control per mantenere la velocità impostata."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, il cruise control regolerà automaticamente la velocità per mantenere un'adeguata distanza di sicurezza dal veicolo che precede."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Attiva la frenata di emergenza se il sistema rileva una collisione imminente.<br>Sceglie se il sistema reagirà solo ai veicoli o a tutti gli ostacoli."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selezione della modalità dell'assistente di corsia:<br>- La modalità \"Avviso superamento di corsia\" ti avviserà acusticamente quando stai per oltrepassare la corsia.<br>- In aggiunta alla segnalazione acustica, il \"Supporto di mantenimento della corsia\" agirà automaticamente sullo sterzo per evitare che il camion oltrepassi la corsia.<br><br>Entrambe le modalità sono attive solamente a velocità sopra i 55 km/h (~35 mph).<br>L'assistente di corsia prende inoltre in considerazione l'azionamento delle frecce prima di attivarsi."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Abilita le funzionalità di sensore angolo cieco, se il camion ne è provvisto."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, e i fari sono impostati in prima posizione, i fari si accenderanno automaticamente in situazioni di luce scarsa."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, e gli abbaglianti sono accesi, essi verranno abbassati automaticamente dal camion qualora venga rilevato un veicolo in arrivo o davanti ad una distanza ridotta."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, le frecce verranno automaticamente tolte dopo una curva se il volante ritorna al centro."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, alcuni accessori della cabina reagiranno al movimento del camion (decorazioni appese, statuette, ecc.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Abilita l'imbardata nella visuale interna in base alla sterzata."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la reattività della \"rotazione in sterzata\" in base alla sterzata. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica il comportamento della \"rotazione in sterzata\" in retromarcia."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, la visuale interna guarda a sinistra o destra in base all'uso delle frecce."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Se abilitato, la visuale interna reagisce al movimento del camion."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica la reattività della visuale interna al movimento del camion."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifica quanto la visuale interna può ruotare in base al movimento del camion."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Imposta il ritardo prima che la telecamera si centri automaticamente.<br><br>Il veicolo deve muoversi ad una velocità rilevante per attivare la funzionalità. Si applica solamente alle visuali Interna e Inseguimento andando avanti, e alla visuale Sporgente in retromarcia."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Imposta la velocità del movimento della telecamera. Utilizzato dal centraggio automatico della visuale e passando tra i preset della visuale interna."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determina come funziona lo zoom interno: tieni premuto il pulsante per uno zoom temporaneo, oppure una pressione singola per azionarlo." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona la lingua da mostrare in gioco."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Modifica i preset di valuta e unità in base alla regione selezionata."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, città e nazioni verranno mostrate nella lingua selezionata."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, città e nazioni verranno mostrate sia nella lingua selezionata che nella lingua nativa per quella regione sulla mappa."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona la valuta da utilizzare."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona la notazione temporale tra 12 ore e 24 ore."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona quali unità di misura della distanza vengono mostrate."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona quali unità di misura della massa vengono mostrate."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona quali unità di misura della temperatura vengono mostrate."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona quali unità di misura della pressione vengono mostrate."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona quali unità di misura del volume vengono mostrate."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Seleziona quali unità di misura del consumo vengono mostrate."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, l'uso del tasto \"Attiva\" (@@imv_nrm_activate@@) aprirà la chat durante le sessioni Convoglio."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, la barra della chat resterà attiva dopo l'invio di un messaggio."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, i messaggi di chat si dissolveranno alcuni secondi dopo ciascun messaggio."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Modifica la durata con cui i messaggi di chat verranno mostrati prima di dissolversi."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Se abilitato, i nomi dei giocatori verranno mostrati sopra ai loro camion nelle sessioni Convoglio."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Apre un menu avanzato per configurare risposte veloci per chattare nelle sessioni Convoglio."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Controlla lo stato del contenuto connesso con World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Abilita lo scaricamento di notizie online da mostrare nella schermata iniziale."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Abilita lo scaricamento di istantanee della community selezionate da World of Trucks e mostrate nelle schermate di caricamento."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Abilita lo scaricamento di pubblicità reali da mostrare in alcuni tabelloni in gioco."
#@}

