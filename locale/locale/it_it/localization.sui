	key[]: "graphics_t"
	val[]: "GRAFICA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafica" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Regola le impostazioni grafiche usando preset ottimizzati per personalizzare le prestazioni grafiche del gioco secondo i tuoi gusti."

	key[]: "apply"
	val[]: "Applica" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Tema del desktop" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "SCHERMO" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "QUALITÀ DELL'IMMAGINE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURE" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "RIFLESSI" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "OMBRE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "LUMINOSITÀ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST PROCESSING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "AMBIENTE" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Schermo Intero" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Luminosità / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Setup" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Risoluzione" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Frequenza di aggiornamento" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limite FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limite di FPS in background" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Default" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Sincronia verticale" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Risparmio (Salva energia del notebook)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "IMPOSTAZIONI GRAFICHE SEMPLIFICATE" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "PERSONALIZZAZIONI APPLICATE" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "IMPOSTAZIONI GRAFICHE AVANZATE" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Opzioni grafiche semplici/avanzate" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Nascondi impostazioni avanzate" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Mostra impostazioni avanzate" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Scaling" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma sharpening" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Impostazioni TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Nitidezza adattiva" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Sempre dolce" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Sempre nitida" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Screen Space Ambient Occlusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Alta gamma dinamica (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Profondità di campo (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Dispersione della luce" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Correzione colore" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Scaling dei riflessi" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Dettaglio riflessi" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Dettaglio vegetazione" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densità vegetazione" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Qualità ombre"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Dimensioni texture ombre" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Ombre lontane" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Ombre degli interni" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Qualità meteo"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Qualità specchietti" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Risoluzione dagli specchietti" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Distanza sugli specchietti" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Qualità texture" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtro anisotropico" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normal mapping" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Illuminazione veicoli AI" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Luci secondarie" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Illuminazione paesaggio" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Pedoni" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Le impostazioni grafiche sono state cambiate.<br>Vuoi mantenere questa configurazione?"

	key[]: "reverting_in"
	val[]: "Ripristino in" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "secondi" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Se abilitato, il gioco verrà mostrato a schermo intero."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Regola la luminosità del gioco per adattarsi al tuo display. Nei display compatibili con l'HDR, verrà resa disponibile l'opzione Calibrazione HDR."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Modifica la risoluzione del gioco."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Modifica la frequenza di aggiornamento ideale del gioco."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Allinea il framerate con la frequenza di aggiornamento del monitor per prevenire dallo screen tearing. L'impostazione Economica inoltre dimezza il framerate, per un consumo inferiore."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Imposta il frame rate massimo per il gioco.<br><br>Impostare il valore a 0 disabilita la funzione."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Imposta il frame rate massimo per il gioco quando è ridotto a icona.<br><br>Impostare il valore a 0 disabilita la funzione."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Seleziona le impostazioni grafiche tra semplici (preset) e avanzate (possibilità di modificare singolarmente i parametri)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Migliora la fedeltà grafica processando internamente il gioco ad una maggiore risoluzione, che riduce i bordi frastagliati e migliora il dettaglio.<br>Ad esempio, selezionando un'opzione di scalatura più alta si ottiene un'immagine più chiara con meno sfocatura, rendendo il gioco complessivamente migliore a scapito delle prestazioni.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto notevole sulle prestazioni."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Selezione dei metodi di antialiasing ad alta velocità che leviga l'aspetto dei bordi frastagliati nel gioco:<br>- SMAA campiona ogni pixel più volte (a seconda della qualità selezionata) in punti differenti del frame e media i campioni per produrre l'immagine finale.<br>- TAA campiona ogni pixel solo una volta per frame, ma lo fa in punti e frame diversi.<br>- Per il miglior risultato, puoi anche selezionare una combinazione di entrambi, a discapito delle prestazioni.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Aggiunge ombre morbide a fessure e oggetti che si trovano in prossimità l'uno dell'altro, migliorando la fedeltà grafica percepita dell'intero mondo di gioco.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Selezione dei preset TAA:<br>- \"Sempre dolce\" si tradurrà in meno sfarfallio/più sfocatura - è appropriato per PC con il sovracampionamento abilitato o monitor con DPI alti, ma anche TV 1080p per cui gli utenti si trovano più lontani dallo schermo.<br>- \"Sempre nitida\" si traduce in più sfarfallio/meno sfocatura - è probabilmente l'opzione migliore per schermi con definizione inferiore a 1080p, come laptop o Steam Deck.<br>- \"Nitidezza adattiva\" disabilita dinamicamente il jitter TAA se la visuale è statica.<br><br><color value=@@clr_txt_d@@>Questa opzione può essere utilizzata solo quando l'anti-aliasing è impostato come TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Regola l'intensità del luma sharpening TAA.<br><br><color value=@@clr_txt_d@@>Questa opzione può essere utilizzata solo quando l'anti-aliasing è impostato come TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Se abilitato, le aree più distanti della mappa verranno sfocate artificialmente per creare una profondità di campo realistica sullo sfondo."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Se abilitato, i raggi di luce risulteranno visibili guardando verso il sole, sia normalmente che attraverso oggetti come alberi, edifici o veicoli."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Se abilitato, i colori in gioco verranno regolati dinamicamente per motivi estetici. Le scene saranno più adatte all'ora del giorno e alle condizioni meteo, i colori di veicoli ed altri oggetti risulteranno più vivaci, ecc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Migliora i riflessi renderizzandoli internamente ad una qualità più alta, usando inoltre un antialiasing migliore.<br><br><color value=@@clr_txt_d@@>Le modifiche a questa opzione avranno effetto solo dopo il riavvio del gioco."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Regola il dettaglio dei riflessi sulle superfici di veicoli, finestre e altre superfici riflettenti come pozzanghere, strade bagnate e specchi d'acqua.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni.<br><br>Le modifiche a questa opzione avranno effetto solo dopo il riavvio del gioco."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Regola il dettaglio e la complessità di piante e alberi.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la densità dell'erba a bordo strada.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la qualità delle ombre proiettate dal sole o dalla Luna.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Abilita la renderizzazione delle ombre anche da oggetti molto lontani.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Abilita le ombre dinamiche notturne nella cabina del camion.<br><br><color value=@@clr_txt_d@@>Questa opzione ha solitamente un discreto impatto sulle performance."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la qualità degli effetti meteo, come pure i riflessi."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la qualità dei riflessi visti sugli specchietti (indipendentemente dalle impostazioni dei riflessi).<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la risoluzione dell'immagine riprodotta sugli specchietti del camion."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la distanza dalla quale gli oggetti vengono renderizzati nello specchietto.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto elevato sulle prestazioni."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la qualità di alcune texture applicate agli oggetti e alle superfici in gioco."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Migliora la nitidezza delle texture, specialmente quelle visualizzate a distanza o in diagonale.<br><br><color value=@@clr_txt_d@@>Le modifiche a questa opzione avranno effetto solo dopo il riavvio del gioco."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Aggiunge un'apparenza di dettaglio geometrico a marciapiedi, strade e altri oggetti per migliorarne l'aspetto.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni.<br><br>Le modifiche a questa opzione avranno effetto solo dopo il riavvio del gioco."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Abilita l'illuminazione dai fari di altri veicoli nel traffico."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Abilita l'illuminazione da luci secondarie di altri veicoli nel traffico, come frecce, freni, ecc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Regola la distanza dalla quale le sorgenti di luce artificiale sono visibili.<br><br><color value=@@clr_txt_d@@>Questa opzione ha spesso un impatto moderato sulle prestazioni."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Abilita i pedoni nell'area di gioco."
