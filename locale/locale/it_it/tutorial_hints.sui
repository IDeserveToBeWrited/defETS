
    key[]: "hint_engine_title"
	val[]: "Avvia il motore"

    key[]: "hint_engine_text"
	val[]: "Premi $KEY_engine$ per avviare il motore."


    key[]: "hint_ignition_title"
	val[]: "Attiva l'ignizione"

    key[]: "hint_ignition_text"
	val[]: "Premi $KEY_engineelect per avviare l'ignizione."


    key[]: "hint_driv_arc_title"
	val[]: "Guida"

    key[]: "hint_driv_arc_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per muoverti avanti o indietro.<br><offset vshift=8>Usa $SPECIAL_steering$ per sterzare."


    key[]: "hint_driv_auto_title"
	val[]: "Guida"

    key[]: "hint_driv_auto_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per muoverti avanti o indietro.<br><offset vshift=8>Usa $SPECIAL_steering$ per sterzare.<br><offset vshift=8>Premi $KEY_gearup$ e $KEY_geardown$ per selezionare le marce."


    key[]: "hint_driv_seq_title"
	val[]: "Guida"

    key[]: "hint_driv_seq_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per muoverti avanti o indietro.<br><offset vshift=8>Usa $SPECIAL_steering$ per sterzare.<br><offset vshift=8>Premi $KEY_gearup$ e $KEY_geardown$ per controllare la frizione."


    key[]: "hint_driv_hshift_title"
	val[]: "Guida"

    key[]: "hint_driv_hshift_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per muoverti avanti o indietro.<br><offset vshift=8>Usa $SPECIAL_steering$ per sterzare.<br><offset vshift=8>Cambia le marce con la <color value=@@clr_sel@@>leva del cambio<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Avvicinati a destinazione"

    key[]: "hint_depot_deliv_text"
    val[]: "Fermati nell'area contrassegnata per selezionare la difficoltà dell'ultimo parcheggio e ottenere i rispettivi punti esperienza."


    key[]: "hint_fin_deliv_title"
    val[]: "Termina la consegna"

    key[]: "hint_fin_deliv_text"
    val[]: "Parcheggia nell'area selezionata. Puoi premere $KEY_activate$ per saltare la manovra quando sei vicino al punto di consegna."


    key[]: "hint_fin_deliv2_title"
    val[]: "Termina la consegna"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parcheggia nell'area selezionata. Puoi abilitare un widget nel @@desktop_menu_category_options@@ per poter saltare la manovra."


    key[]: "hint_lights_title"
    val[]: "Accendi le luci"

    key[]: "hint_lights_text"
    val[]: "Usa $KEY_light$ per attivare le luci. Puoi ciclare tra modalità differenti premendo ripetutamente il tasto."


    key[]: "hint_high_beam_title"
    val[]: "Attiva gli abbaglianti"

    key[]: "hint_high_beam_text"
    val[]: "Usa $KEY_hblight$ per accendere gli abbaglianti."


    key[]: "hint_wipers_title"
    val[]: "Attiva i tergicristalli"

    key[]: "hint_wipers_text"
    val[]: "Usa $KEY_wipers$ per attivare i tergicristalli e ciclare tra le varie velocità."


    key[]: "hint_zoom_title"
    val[]: "Un'occhiata più da vicino"

    key[]: "hint_zoom_text"
    val[]: "Usa $KEY_camzoom$ per aumentare lo zoom in una visuale interna. In @@desktop_menu_category_options@@ puoi impostare lo zoom come pressione continua o azionamento."


    key[]: "hint_cam_int_title"
    val[]: "Un'occhiata intorno"

    key[]: "hint_cam_int_text"
    val[]: "Usa $KEY_cam1$ per selezionare la visuale interna."


    key[]: "hint_cam_ext_title"
    val[]: "Un'occhiata intorno"

    key[]: "hint_cam_ext_text"
    val[]: "Puoi ciclare tra le varie visuali premendo $KEY_camcycle$.<br><offset vshift=8>Usa $KEY_cam2$ per selezionare la visuale esterna."


    key[]: "hint_indicators_title"
    val[]: "Indicatori di direzione"

    key[]: "hint_indicators_text"
    val[]: "Usa $KEY_lblinker$ e $KEY_rblinker$ per azionare le frecce."


    key[]: "hint_tow_title"
    val[]: "Carro attrezzi"

    key[]: "hint_tow_text"
    val[]: "Se non riesci a uscire da una situazione difficile, puoi chiedere aiuto al carro attrezzi. Per accedere al servizio, apri il menu @@quick_info_word@@ con $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Blocco differenziale"

    key[]: "hint_diff_lock_text"
    val[]: "Se non riesci a metterti in movimento, il blocco del differenziale può aiutarti. Usa $KEY_diflock$ per attivarlo, o abilita il blocco automatico in @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Blocco differenziale attivo"

    key[]: "hint_diff_unlock_text"
    val[]: "Dovresti sbloccare il differenziale nella guida normale, o rischi di danneggiarlo. Usa $KEY_diflock$ per disattivarlo, o abilita il blocco automatico in @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Disattiva i tergicristalli"

    key[]: "hint_wipers_off_text"
    val[]: "Usa $KEY_wipers$ per disattivare i tergicristalli e ciclare tra le varie velocità."


    key[]: "hint_world_map_title"
    val[]: "Vista Mappa"

    key[]: "hint_world_map_text"
    val[]: "Premi $KEY_navmap$ per aprire la mappa."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Premi $KEY_advmouse$ per aprire le @@quick_info_word@@ - panoramica del tuo stato con comode scorciatoie."


    key[]: "hint_pause_border_title"
    val[]: "Regole locali"

    key[]: "hint_pause_border_text"
    val[]: "Usa $KEY_advmouse$ per aprire le @@quick_info_word@@ e vedere le regole della regione in cui sei attualmente."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Apri le @@quick_info_word@@ con $KEY_advmouse$ per entrare nella @@photo_mode_word@@ e immortalare un @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20> vicino."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ vicino"

    key[]: "hint_viewpoint_text"
    val[]: "Un @@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> è qui vicino - trovalo e attivalo per vedere il filmato."


    key[]: "hint_resting_title"
    val[]: "Area di sosta vicina"

    key[]: "hint_resting_text"
    val[]: "Le aree di sosta <img src=/material/ui/map/parking_ico.mat width=20 height=20> ti aiuteranno a recuperare dalla fatica ed effettuare la sosta obbligatoria per continuare il tuo viaggio in sicurezza."


    key[]: "hint_gas_title"
    val[]: "Stazione di servizio vicina"

    key[]: "hint_gas_text"
    val[]: "Le stazioni di servizio <img src=/material/ui/map/gas_ico.mat width=20 height=20> possono essere usate per rifornire il tuo veicolo."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Puoi abilitare il controllo intelligente dell'acceleratore in @@desktop_menu_category_options@@. Se abilitato, il veicolo manterrà di default un'accelerazione ridotta. Con una doppia pressione rapida, il veicolo accelererà al massimo finché il pulsante non verrà rilasciato."
