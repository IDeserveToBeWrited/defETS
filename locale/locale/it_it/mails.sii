SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "Sistema" #+ Message sender
		subject: "Messaggio di prova" #+ Message subject
		body: "Ciao!<br><br>Questo è un messaggio di prova dal tuo collega amministratore ;-)<br><br>Stammi bene" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "Banca" #+ Message sender
		subject: "Hai bisogno di denaro? Noi possiamo aiutarti!" #+ Message subject
		body: "Gentile Signore/a,<br><br>forse ti farà piacere sapere che offriamo prestiti agevolati alle nuove imprese. Ti servono dei finanziamenti per far funzionare il tuo business? Noi siamo qui per aiutarti! $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>Visita la tua filiale di riferimento</link> per maggiori informazioni. <br><br>Cordiali saluti,<br>Il tuo consulente finanziario<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "Banca" #+ Message sender
		subject: "Siamo in grado di aiutarti a crescere" #+ Message subject
		body: "Gentile Signore/a,<br><br>i tuoi guadagni costanti non sono passati inosservati e, per questo, vorremmo aiutarti a sviluppare ulteriormente il tuo potenziale. Il limite di credito è stato aumentato a $MONEY$. Potrai attingere alla somma disponibile in qualsiasi momento dalla tua $SHORTCUT1$<link url=screen.bank color=@@clr_link@@> filiale di riferimento</link>.<br><br>Cordiali saluti,<br>Il tuo consulente finanziario<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "Banca" #+ Message sender
		subject: "Il tuo conto in banca è scoperto" #+ Message subject
		body: "Gentile Cliente,<br><br> Ha ritirato più soldi dal suo conto di quanto ne avesse a disposizione. Le abbiamo fornito un credito a breve termine per i prossimi giorni, senza alcun interesse, quindi può risolvere la situazione. Per favore, la preghiamo di pagare lo scoperto al più presto possibile.<br><br> Cordiali saluti,<br>Responsabile prestiti<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "Banca" #+ Message sender
		subject: "Hai uno debito da saldare!" #+ Message subject
		body: "Gentile Cliente,<br><br>Il suo conto in banca è in negativo! La invitiamo pertanto a pagare il suo debito nei prossimi $DAYS$ o saremo costretti a sequestrare la sua proprietà.<br><br> Cordiali saluti,<br>Il suo consulente<br>Banca " #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "Banca" #+ Message sender
		subject: "Ultimo avvertimento!" #+ Message subject
		body: "Gentile Cliente,<br><br>Questo è il nostro ultimo avvertimento. Il suo conto in banca è scoperto. Per favore, ci rimborsi entro domani o ritireremo le sue proprietà per coprire il debito.<br><br>Cordiali saluti,<br>Il suo responsabile prestiti<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "Banca" #+ Message sender
		subject: "Scoperto pagato" #+ Message subject
		body: "Gentile Cliente,<br><br>Lo scoperto del suo conto è stato risolto. Saremo felici di poterla aiutare se in futuro avrà ancora bisogno dei nostri servizi.<br><br>Buona giornata, <br>Il suo responsabile prestiti<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "Banca" #+ Message sender
		subject: "Il tuo camion è stato venduto" #+ Message subject
		body: "Gentile Cliente,<br><br>siamo spiacenti di informarti che abbiamo dovuto vendere il tuo camion personale - $TRUCK_NAME$ - per $MONEY$. Sfortunatamente non possedevi altre proprietà per coprire il debito da tempo maturato nei nostri confronti. Purtroppo, questa era l'unica misura possibile. Ti consigliamo di accettare qualche offerta di lavoro come dipendente fino a quando la situazione finanziaria personale non migliorerà.<br><br>Cordiali saluti,<br>Il tuo consulente finanziario<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "Banca" #+ Message sender
		subject: "Il tuo rimorchio è stato venduto" #+ Message subject
		body: "Gentile cliente,<br><br>Siamo spiacenti di informarla che abbiamo dovuto vendere il suo rimorchio - $TRAILER_NAME$ - per $MONEY$. Il suo vecchio debito non è stato saldato e non c'era il denaro per coprirlo. Purtroppo questa soluzione estrema era l'unica disponibile. Le consigliamo di iniziare a lavorare come dipendente fino a quando la sua situazione bancaria non sarà migliorata.<br><br>Cordiali saluti,<br>Il suo responsabile prestiti.<br>Banca" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "Banca" #+ Message sender
		subject: "La tua proprietà è stata venduta" #+ Message subject
		body: "Gentile Cliente,<br><br>a causa del considerevole debito persistente sul tuo conto, abbiamo dovuto confiscare e vendere le tue proprietà. I fondi recuperati, per un importo totale di $MONEY$, sono stati utilizzati per saldare le tue obbligazioni. In particolare, sono stati confiscati i seguenti beni:<br><br>$ITEM_LIST$<br><br>Ci dispiace che la situazione sia precipitata fino a questo punto e speriamo che le conseguenze non compromettano troppo gravemente le tue attività future.<br><br>Con i migliori auguri,<br>Il tuo consulente finanziario<br>Banca" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "Concessionario - $CITY$" #+ Message sender
		subject: "Nuovissimi camion $BRAND$ in vendita!" #+ Message subject
		body: "Gentile Signore/a,<br><br>siamo i rivenditori certificati $BRAND$. Offriamo una vasta gamma di configurazioni e siamo in grado di soddisfare i tuoi desideri con incredibili personalizzazioni. Ti invitiamo a $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>visitare il nostro showroom a $CITY$</link>. Il camion che hai sempre sognato ti attende nei nostri concessionari.<br><br>Cordiali saluti,<br>Il tuo rivenditore $BRAND$" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "Concessionario di camion usati" #+ Message sender
		subject: "Camion usati in vendita!" #+ Message subject
		body: "Gentile Signore/a,<br><br>siamo felici di annunciare l'apertura del nostro Concessionario di camion usati, la tua nuova destinazione per camion usati di alta qualità! Che sia in cerca di un mezzo potente o semplicemente di un mulo affidabile, abbiamo il camion perfetto per te.<br><br>Ti invitiamo a visitare le nostre $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>offerte di camion usati</link>. Siamo certi che troverai il camion perfetto per le tue esigenze.<br><br>Cordiali saluti,<br><br>Il team del Concessionario di camion usati<br><br>P.S. Non scordare di tornare spesso a trovarci per scoprire i nuovi arrivi! Il nostro inventario è in costante aggiornamento, potresti trovare un'offerta eccezionale." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "Cercasi autotrasportatori autonomi" #+ Message subject
		body: "A chiunque possa interessare,<br><br>Siamo alla ricerca di autotrasportatori esperti con mezzi propri per una vasta gamma di consegne. Offriamo prezzi competitivi fino a $MONEY$ per trasporto. Prego, se disponete di mezzi propri, rivolgetevi direttamente al nostro magazzino a $CITY$.<br><br> $COMPANY$,<br> $CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "Autista $NAME$" #+ Message sender
		subject: "Ho bisogno di un camion per lavorare" #+ Message subject
		body: "Buongiorno capo, <br><br>non so se l'ha notato, ma sono fermo a $CITY$ senza lavoro da oltre $DAYS$ ormai. È una situazione frustrante perché anche io ho bisogno di soldi per pagare le bollette e non posso fare altro se sto qui a bighellonare senza alcun lavoro in vista. Per favore, procurami un camion nei prossimi $DAYS2$ in modo da poter iniziare a lavorare altrimenti non avrò altra scelta che rassegnare le mie dimissioni.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "Autista $NAME$" #+ Message sender - written by female
		subject: "Ho bisogno di un camion per lavorare" #+ Message subject - written by female
		body: "Buon giorno capo, <br><br>non so se l' ha notato, ma sono ferma a $CITY$ senza lavoro da oltre $DAYS$ ormai. È una situazione frustrante perché anche io ho bisogno di soldi per pagare le bollette e non posso fare altro se sto qui a bighellonare senza alcun lavoro in vista. Per favore, procurami un camion nei prossimi $DAYS2$ in modo da poter iniziare a lavorare altrimenti non avrò altra scelta che rassegnare le mie dimissioni.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "Autista $NAME$" #+ Message sender
		subject: "Addio" #+ Message subject
		body: "Buongiorno,<br><br>Non posso più permettermi di sprecare il mio tempo. Sono un autotrasportatore, non posso lavorare senza un camion e non voglio più aspettare. Ho già perso una buona opportunità quindi me ne vado dalla tua azienda per cercare fortuna altrove. Puoi ritrovare tutte le attrezzature assegnatemi, le ho lasciate nel mio ex garage a $CITY$.<br><br>Addio,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "Autista $NAME$" #+ Message sender - written by female
		subject: "Addio" #+ Message subject - written by female
		body: "Buongiorno,<br><br>Non posso più permettermi di sprecare il mio tempo. Sono un' autotrasportatrice, non posso lavorare senza un camion e non voglio più aspettare. Ho già perso una buona opportunità quindi me ne vado dalla tua azienda per cercare fortuna altrove. Puoi ritrovare tutte le attrezzature assegnatemi, le ho lasciate nel mio ex garage a $CITY$.<br><br>Addio,<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "Autista $NAME$" #+ Message sender
		subject: "Il mio camion necessita di un ripristino completo" #+ Message subject
		body: "Salve boss,<br><br>so che hai da fare, ma il mio mezzo ha bisogno di un ripristino completo. È troppo vecchio e malconcio per guidare ancora in sicurezza. Ormai sono senza lavoro da $DAYS$, e francamente è frustrante perché devo pagare le bollette, ma non posso farlo senza un mezzo idoneo alla circolazione. Per favore, assegnami un camion nuovo o fai riparare questo, in modo che possa tornare a lavorare, altrimenti dovrò andarmene..<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "Autista $NAME$" #+ Message sender - written by female
		subject: "Il mio camion necessita di un ripristino completo" #+ Message subject - written by female
		body: "Salve boss,<br><br>so che hai da fare, ma il mio mezzo ha bisogno di un ripristino completo. È troppo vecchio e malconcio per guidare ancora in sicurezza. Ormai sono senza lavoro da $DAYS$, e francamente è frustrante perché devo pagare le bollette, ma non posso farlo senza un mezzo idoneo alla circolazione. Per favore, assegnami un camion nuovo o fai riparare questo, in modo che possa tornare a lavorare, altrimenti dovrò andarmene..<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "Autista $NAME$" #+ Message sender
		subject: "Addio" #+ Message subject
		body: "Ciao,<br><br>Mi spiace dirlo ma il mio camion sta cadendo a pezzi a causa dell'usura e dei danni subiti e non ho tempo. Non ho alcun lavoro e le mie spese si stanno accumulando, per cui devo muovermi. Consiglio un restauro totale del convoglio per il prossimo autista. Puoi trovare tutte le attrezzature a disposizione nel mio vecchio garage a $CITY$.<br><br>Saluti.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "Autista $NAME$" #+ Message sender - written by female
		subject: "Addio" #+ Message subject - written by female
		body: "Ciao,<br><br>Mi spiace dirlo ma il mio camion sta cadendo a pezzi a causa dell'usura e dei danni subiti e non ho tempo. Non ho alcun lavoro e le mie spese si stanno accumulando, per cui devo muovermi. Consiglio un restauro totale del convoglio per il prossimo autista. Puoi trovare tutte le attrezzature a disposizione nel mio vecchio garage a $CITY$.<br><br>Saluti.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "Autista $NAME$" #+ Message sender
		subject: "Me ne vado!" #+ Message subject
		body: "Buongiorno capo,<br><br>il garage di $CITY$, a cui mi avevi assegnato, è stato pignorato. Oggi sono venuti dei rappresentanti della banca dicendo che devo andarmene. A quanto pare l'azienda non naviga in buone acque, quindi, ho deciso di licenziarmi. D'altro canto, non potrei fare molto senza camion e attrezzature. Tenterò da qualche altra parte.<br><br>Un saluto, senza rancori,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "Autista $NAME$" #+ Message sender - written by female
		subject: "Me ne vado!" #+ Message subject - written by female
		body: "Buongiorno capo,<br><br>il garage di $CITY$, a cui mi avevi assegnato, è stato pignorato. Oggi sono venuti dei rappresentanti della banca dicendo che devo andarmene. A quanto pare l'azienda non naviga in buone acque, quindi, ho deciso di licenziarmi. D'altro canto, non potrei fare molto senza camion e attrezzature. Tenterò da qualche altra parte.<br><br>Un saluto, senza rancori,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "Coordinatore" #+ Message sender
		subject: "Trasporti eccezionali" #+ Message subject
		body: "Ciao capo.<br><br>Ho qualcosa di speciale per te. Grazie alle nostre conoscenze, ora siamo in grado di affrontare una vera sfida. Alcuni carichi speciali, extra grandi e pesanti, devono essere trasportati da un vero professionista. Non sarà facile e richiederà abilità, pazienza, collaborazione con i veicoli di scorta e molta attenzione, niente che tu non possa affrontare, giusto? Inoltre, un rischio maggiore porta a un profitto maggiore.<br> <br>Se sei interessato, puoi visitare queste città:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "Coordinatore" #+ Message sender
		subject: "Nuovi trasporti eccezionali" #+ Message subject
		body: "Ciao capo.<br><br>Altre aziende vorrebbero impiegare la tua abilità al volante per alcune consegne speciali. Proprio come l'ultima volta, non sarà facile e richiederà abilità, pazienza, collaborazione con veicoli di scorta e molta attenzione, insomma, niente che tu non possa affrontare, giusto? E ricorda: per questi carichi il profitto è perfino maggiore.<br><br>Oltre ai lavori di trasporto speciale attualmente disponibili a:<br><br>$OLD_CITIES$<br><br>Ora puoi prendere anche <color value=@@clr_sel@@>nuovi lavori<color value=@@clr_txt@@> a:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "Agenzia immobiliare" #+ Message sender
		subject: "Sta valutando di espandere la Sua azienda?" #+ Message subject
		body: "Gentile Signore/a,<br><br>vogliamo congratularci per la tua azienda. Siamo impressionati dal successo della tua attività e vorremmo offrirti un nuovo metodo per sostenerne la crescita. Da questo momento puoi utilizzare i nostri servizi per acquistare nuove proprietà velocemente! Per maggior informazioni ti invitiamo a $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>visitare la nostra pagina Immobili</link>.<br><br>Cordiali saluti,<br>Relations Manager<br>Agenzia immobiliare" #+ Message body
	}
	
#@}
}