#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "대각선 후진 주차"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "이 시나리오에서는 후진할 때 대각선으로 주차하는 것을 살펴보겠습니다. 이는 휴게소, 트럭 정류장, 심지어 운송업체에서도 발생할 수 있습니다. 종종 주차장이 트럭으로 붐비기 때문에 공간이 거의 없으므로 공간이 부족하여 주차가 더욱 어렵습니다."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "트레일러 돌리기"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "대각선 주차는 언뜻 보기에 더 쉬운 것처럼 보이지만, 일반적인 '골목 후진' 주차보다 더 어려울 수 있는 경우가 많습니다."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "주차 장소를 향해 후진합니다. 지금은 트랙터와 트레일러를 똑바로 유지하십시오."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "가까워지면 트레일러가 주차된 트럭에 더 가까이 다가가도록 하십시오. 이렇게 하면 도달했을 때 해당 위치로 바꾸는 데 도움이 됩니다."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "트레일러를 주차 공간으로 돌리기 시작하세요. 트레일러를 운전석 쪽 트럭에 가깝게 두십시오, 반대쪽에 공간이 필요합니다."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "트레일러가 주차 공간에 잘 들어가면 트랙터를 돌려 트레일러를 따라가십시오."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "지정된 구역에 주차한 후, 트럭을 고정하고 엔진을 끄십시오."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "트럭을 뒤쪽 공간에 주차합니다. 두 개의 거울을 사용하여 후진할 때 길을 찾으세요.<br><br><font face=/font/big_bold.font>출발을 준비하십시오. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "주변을 확인한 후 주차 장소로 향하세요.<br><br><font face=/font/big_bold.font>후진을 시작하십시오.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "트레일러를 옆에 있는 트럭 쪽으로 옮기기 시작합니다. 준비가 되면 트레일러를 주차 공간으로 돌립니다. 트레일러의 꼬리 회전을 고려하는 것을 잊지 마세요.<br><br><font face=/font/big_bold.font>주차 공간으로 돌립니다. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
