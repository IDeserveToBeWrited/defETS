	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "당신 앞에 장벽이 있습니다. 거기까지 운전해서 멈추십시오."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "트럭 운전석 쪽 뒤에 또 다른 장벽이 있습니다. 커브를 따라 후진하여 그곳으로 가십시오. 도로 표시를 가이드로 사용할 수 있습니다."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "바로 앞에는 90도 급커브가 있습니다. 그곳으로 운전하십시오."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "뒷바퀴가 코너 안쪽에 있는 트래픽콘을 통과할 수 있도록 코너 깊은 곳까지 운전해야 합니다.<br>거울을 사용하십시오!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "앞바퀴를 정렬 하고, 마지막 장벽을 향해 운전한 후 멈춰서 트럭을 고정하십시오."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>출발을 준비하십시오. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "트럭이 아직 움직일 준비가 안 됐는데, 뭔가 잊은 게 있나요?<br><br>엔진은 켜져 있나요? 주차 브레이크는 풀었나요?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "장벽 바로 앞에 표시된 지점이 있습니다.<br><br><font face=/font/big_bold.font>앞으로 운전하여 표시된 지점에서 멈추십시오. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "운전석 쪽 뒤를 돌아보세요. 거기에 또 다른 표시된 지점이 보일 겁니다. 후진과 회전을 동시에 병행해야 합니다.<br><br><font face=/font/big_bold.font>커브를 돌면서 후진하고 표시된 지점에서 멈추십시오. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "코스는 90도 회전을 통해 앞으로 계속됩니다.<br><br>회전하기 전에 운전석 쪽으로 유지하고, 코너 깊게 운전하고 빠르고 날카롭게 회전합니다. 안쪽 트래픽콘에 부딪히지 않도록 주의해야 됩니다.<br><br><font face=/font/big_bold.font>앞으로 운전하고 회전하십시오. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "전방 미러와 사이드 미러를 이용해 아무것도 부딪히지 않도록 주의합니다.<br><br><font face=/font/big_bold.font>회전을 마치고 지정된 구역에서 멈추십시오. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>엔진을 끄고 트럭을 고정하십시오.</font>"
#@}

