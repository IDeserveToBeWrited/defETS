	key[]: "aca_cutscene_quit_info_paused"
	val[]: "<color value=@@clr_txt@@>계속합니다 (@@imv_nrm_selectfcs@@<color value=@@clr_txt@@>)   건너뛰기 ($KEY$<color value=@@clr_txt@@>)" #+ Info text showing how to control cutscene when is paused.

