#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "후진 샌드박스"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "이 시나리오에서는 빈 주차장에 배치되어 더블로 후진 연습을 하게 됩니다."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "시작하기"

	key[]: "aca_goal_book3_urf_move"
	val[]: "실험 중"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "마무리하기"

	key[]: "aca_goal_book3_urf_end"
	val[]: "시나리오 종료"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "더블로 후진하는 것은 단일 트레일러보다 훨씬 더 많은 주의가 필요합니다. 앞쪽 트레일러와 캡을 조작하면서 뒤쪽 트레일러가 어디로 향할지 미리 계획해야 합니다. <br><br>이렇게 생각해 보세요 - 뒤쪽 트레일러를 조종하려면 앞쪽 트레일러를 사용해야 합니다."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "이 경우, 우리는 뒤쪽 트레일러를 운전석 쪽으로 돌리고 싶습니다. 이렇게 하려면 뒤쪽 트레일러의 앞부분을 조수석 쪽으로 밀어야 합니다. <br><br>즉, 앞쪽 트레일러는 뒤쪽 트레일러를 돌리려는 방향과 반대 방향으로 돌려야 한다는 점에 유의하십시오."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "뒤쪽 트레일러가 회전하기 시작하면 앞쪽 트레일러와 함께 트랙터를 똑바로 정렬하는 것이 필수적입니다. 대부분의 사람들이 여기서 첫 번째 실수를 저지릅니다."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "여기서 우리는 운전자가 선두를 따라가지 못하고 트레일러를 잭나이프하려고 하는 것을 볼 수 있습니다."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "잭나이핑은 연결된 차량 두 대 사이의 각도가 약 90도가 될 때 발생합니다. 일단 이런 상황이 발생하면 되돌릴 수 없으므로 앞으로 이동하여 다시 시도해야 합니다. <br><br> 트레일러를 후진시킬 때와 마찬가지로, 트레일러의 모든 바퀴가 움직이는지 항상 확인해야 합니다. 바퀴 하나라도 멈추고 트레일러가 제자리에서 회전하는 경우, 더 이상 진행할 수 없습니다."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "마지막으로 정확하게 작업했던 지점, 즉 같은 실수를 반복하지 않고 역순으로 작업을 계속할 수 있는 위치로 되돌릴 수 있습니다. <br><br>이 경우에는 직선 위치로 되돌린 후 처음부터 다시 시도하겠습니다."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "다시 한번, 뒤쪽 트레일러가 회전하기 시작하면 트랙터를 선두 차량 앞으로 이동시키고 뒤쪽 트레일러가 잠시 스스로 회전하도록 두십시오."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "이제 뒤쪽 트레일러가 원하는 방향으로 회전했으니, 앞쪽 트레일러를 조종하여 따라가도록 해야 합니다. 앞쪽 트레일러와 뒤쪽 트레일러 사이의 각도를 조절하여 회전을 제어하고 더 날카롭거나 넓게 회전시킬 수 있습니다."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "조작의 마지막 부분은 모든 것을 바로잡는 것입니다. 선두를 뒤쪽으로 정렬합니다."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "앞쪽 트레일러를 이동시키는 데 걸리는 시간을 염두에 두어야 합니다. 너무 오래 기다리면 뒤쪽 트레일러가 방금 왔던 길로 되돌아가려고 할 것입니다!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "여기서 원하는 만큼 시간을 보내시고, 트레일러를 후진으로 조작하는 방법을 대략적으로 익힐 때까지 다양한 조작법을 시도해 보세요. <br><br>하지만 무엇보다 중요한 것은 즐기는 것입니다!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "출발을 준비하십시오."

	key[]: "aca_msg_book3_urf_move"
	val[]: "이 주차장을 이용하여 트레일러 후진 조작법을 익히세요. <br><br>@@aca_goal_tip@@ 트레일러 후진이 처음이신가요? 트럭 운전 기초 게임을 플레이해 보십시오."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "연습하고 싶은 만큼 시간을 내세요. <br><br>만족하면 멈춰서 트럭을 고정하여 시나리오를 끝낼 수 있습니다."

	key[]: "aca_msg_book3_urf_end"
	val[]: "시나리오를 끝내기 위해 엔진을 끄십시오."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "좁은 공간에 주차하기"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "이 시나리오에서는 좁은 공간에 더블 트레일러 두 대를 주차해야 합니다."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "시작하기"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "출발"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "계속 운전"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "정지"

	key[]: "aca_goal_book3_sup_end"
	val[]: "차량 안전"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "더블을 운전하는 것은 어려워 보일 수 있지만, 사실 한 대의 트레일러를 운전하는 것과 크게 다르지 않습니다. 다만 뒤쪽 트레일러의 진행 방향도 고려해야 한다는 점만 다릅니다!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "앞에는 좁은 주차 공간이 있습니다. 진입하기 전에 완벽하게 똑바로 서기에는 공간이 부족하므로 두 대의 트레일러를 모두 어떻게 주차할지 신중하게 고려해야 합니다."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "주차 공간의 가장 안쪽으로 즉시 방향을 틀어 평소에 차를 돌리는 지점을 훨씬 지나쳐 가십시오."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "이제 뒤쪽 트레일러가 제자리에 들어왔으니 목적지로 향할 수 있습니다. 다만, 첫 번째 트레일러가 돌아올 수 있도록 반대편으로 다시 한번 이동해야 합니다."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "계속 그 자리로 들어가시면 두 대의 트레일러도 따라 들어와서 차선을 바로잡을 겁니다."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "지정된 구역에 주차하고 트럭을 고정하십시오."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "출발을 준비하십시오."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "앞으로 나아가 좁은 공간으로 들어가십시오."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "계속 운전."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "지정된 구역에 정차하십시오."

	key[]: "aca_msg_book3_sup_end"
	val[]: "트럭을 고정하고 엔진을 끄십시오."
#@}


