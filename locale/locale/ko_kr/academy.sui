	key[]: "aca_goal_book1_3_19_connect"
	val[]: "트레일러 연결"

	key[]: "aca_goal_book1_3_19_park_br_off"
	val[]: "주차 브레이크 해제"

	key[]: "aca_goal_book1_3_19_b_trailer"
	val[]: "주차장에서 운전하기"

	key[]: "aca_goal_book1_3_19_check01"
	val[]: "도로에서 운전하기"

	key[]: "aca_goal_book1_3_19_check02"
	val[]: "좁은 통로"

	key[]: "aca_goal_book1_3_19_check02b"
	val[]: "도로에서 운전하기"

	key[]: "aca_goal_book1_3_19_check03"
	val[]: "코스 진입"

	key[]: "aca_goal_book1_3_19_check04"
	val[]: "복잡한 조작"

	key[]: "aca_goal_book1_3_19_check05"
	val[]: "직선 구간"

	key[]: "aca_goal_book1_3_19_check06"
	val[]: "스위핑 회전"

	key[]: "aca_goal_book1_3_19_check07"
