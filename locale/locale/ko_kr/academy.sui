	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "이 시나리오에서는 좁은 공간에서 사각지대 후진 조작으로 방향을 바꾸는 방법을 살펴보겠습니다. 이 기술은 유턴을 하거나 운전석 쪽으로 후진할 수 없을 때 유용합니다."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "도로 표시는 훈련 과정을 탐색하는 데 도움이 됩니다."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "트레일러가 주차된 트럭을 통과할 수 있도록 넓게 회전하십시오."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "코너를 빠져나갈 때 후진 조작을 위해 트럭을 어떻게 설정할지 고려하십시오."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "트럭이 후진할 조수석 쪽의 빈 주차 공간을 향하도록 비스듬히 세우는 것이 도움이 됩니다."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "가능하다면 사각지대 후진은 피해야 합니다. 가시성이 상당히 낮기 때문입니다. 안타깝게도, 어쩔 수 없이 후진해야 할 때가 있습니다."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "후진하기 전에 핸들을 돌리세요. 이렇게 하면 트레일러를 원하는 곳으로 즉시 향하게 하는 데 도움이 되며, 매우 좁은 상황에서 도움이 됩니다."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "트레일러가 해당 위치에 잘 고정되면, 트랙터를 트레일러 앞에 위치시키고 정렬하십시오."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "앞바퀴를 정렬 하고 다시 앞으로 당길 수 있는 충분한 공간이 생기면 멈추세요. 들어온 길로 돌아가기 시작하십시오."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "교육 과정에서 도로 표시를 따르십시오."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "전방 커브를 통과하여 지정된 구역으로 이동합니다."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "정지."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "트럭을 고정하고 엔진을 끄십시오."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "앞에 있는 구역에는 운송 회사의 부지를 나타내는 훈련 코스가 있습니다. 당신의 임무는 그곳으로 향하고 트럭을 돌려서 다시 나오는 것입니다. 주변의 공간을 잘 활용하세요.<br><br><font face=/font/big_bold.font>출발을 준비하십시오 </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>교육과정으로 진행합니다. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>코너를 돌아 코스를 계속 진행하십시오. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "도로 표시를 따라 코스 끝에 있는 장벽까지 가세요. 트레일러가 조수석 쪽의 빈 주차 공간을 향하도록 약간 각도를 맞춰 주차합니다.<br><br><font face=/font/big_bold.font>앞으로 계속 가십시오. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "사각지대에 있을 때는 주변 상황을 훨씬 제한적으로 볼 수 있습니다. 천천히 운전하고, 거울을 사용하고, 조심하는 쪽으로 갑니다.<br><br><font face=/font/big_bold.font>후진을 시작하고 트레일러를 빈 주차 공간으로 돌리십시오. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "이제 충분히 멀리 있습니다. 이제 앞으로 나아가서 온 방향과 같은 방향에서 훈련장을 나갈 수 있습니다.<br><br><font face=/font/big_bold.font>출구로 향하기 시작하세요. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>교육 과정 종료. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "도로 표시를 따라 마지막 주차 장소까지 가세요.<br><br><font face=/font/big_bold.font>지정된 구역으로 가십시오. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

