ont><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/time.mat width=22 height=22><offset vshift=2>@@aca_goal_time_limit@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_time_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/camera.mat width=22 height=22><offset vshift=2>@@aca_goal_exterior_drive@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_camera_desc@@</font></margin></align><br><offset vshift=15>"
#!}

#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "트럭 운전 능력 정보" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "완료 요구 사항"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "모든 통과 조건을 충족하면 시나리오가 완료됩니다"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "보너스 조건을 완료하면 별을 획득합니다"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "상태"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "전진과 후진 사이의 최대 변경 횟수"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "주어진 조건에 대한 시나리오를 완료하는 데 허용되는 최대 시간"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "내부 카메라만 사용 가능 - 외부 카메라는 정지된 상태에서도 계속 사용할 수 있습니다"

	key[]: "aca_book_book2_completed_t"
	val[]: "트럭 운전 능력 통과"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>축하합니다!<br><br>트럭 운전 숙련도 Module의 모든 합격 조건을 완료하고 경력 프로필에 대한 보상을 획득했습니다. 모든 보너스 조건을 완료하면 더 많은 보상을 획득할 수 있는 도전에 참여할 수 있습니다.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "트럭 운전 능력 완료"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>축하합니다!<br><br>트럭 운전 능력 Module의 모든 합격 및 보너스 조건을 완료했으며 경력 프로필에 대한 보상을 받았습니다.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "트럭 운전 능력"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "@@driving_academy@@에 다시 오신 것을 환영합니다!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "다음 시나리오는 전문적인 트럭 운전을 위한 여정의 다음 단계를 보여줍니다."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "이번에는 모든 작업을 하나하나 안내해드리지 않으므로, 여러분의 기술과 경험을 활용하여 업무를 수행하는 것은 여러분의 몫입니다."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "익숙한 조작을 경험할 수도 있지만, 이번에는 현실 세계 상황과 더 비슷하게 만들어진 새로운 환경에서 진행됩니다."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "@@driving_academy@@에 \"합격\" 및 \"보너스\" 조건이 새로 추가되었습니다."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "이전과 마찬가지로, 아무것에도 부딪히지 않고, 성공적으로 주차하고, 트럭을 고정하여 각 시나리오를 완료해야 합니다..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...하지만 이제는 할당된 시간 제한 내에 운전해야 하며, 전진과 후진 주행 사이의 방향 전환 횟수에도 제한이 있습니다."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "더욱 어려운 조건의 각 시나리오를 완료하면 보너스 조건을 충족할 수 있습니다..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...더 엄격한 시간 제한, 더 적은 방향 전환, 그리고 오로지 내부 카메라만 사용하는 것과 같은 것들입니다."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "모든 시나리오를 완료하면, 당신은 능숙한 트럭 운전사가 되어 앞으로의 도전에 대비할 수 있습니다.<br><br>더욱 도전하고 싶다면, 각 시나리오의 모든 보너스 조건을 완료하세요. 그러면 당신은 진정한 트럭 운전 스타가 될 것입니다!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "튜토리얼"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "이 튜토리얼 시나리오에서는 트럭 운전 능력의 새로운 기능에 대해 알아보는 데 도움을 드리겠습니다."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "각 시나리오가 시작될 때 <color value=@@clr_sel@@>\"시나리오 브리핑\"<color value=@@clr_txt@@> 창이 나타납니다. 이 창에서 해당 시나리오의 새로운 패스 및 보너스 조건에 대한 정보를 확인할 수 있습니다. <br><br>패스 조건은 시나리오를 성공적으로 완료하는 데 필수이며, 보너스 조건은 숙련되고 숙련된 플레이어를 위한 선택적인 추가 도전 과제입니다. <br><br><font face=/font/big_bold.font>계속하려면 시동을 켜십시오.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "보너스 조건 중 하나는 <color value=@@clr_sel@@>내부 카메라<color value=@@clr_txt@@>를 사용하는 동안 시나리오를 완료하는 것입니다. 외부 카메라를 사용하여 주변을 확인할 수는 있지만, 트럭이 정차한 상태에서만 가능합니다.<br><br>이제 주변을 둘러보고 방향을 확인한 후, 내부 카메라로 다시 전환할 수 있습니다.<br><br><font face=/font/big_bold.font>주변을 확인하려면 추격 카메라로 전환하십시오.</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "방향을 파악한 후 내부 카메라로 다시 전환하세요.<br><br><font face=/font/big_bold.font>트럭 주변을 둘러보십오.</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>내부 카메라로 돌아가기</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>시간<color value=@@clr_txt@@> 또한 트럭 운전 숙련도에 영향을 미칩니다. 모든 시나리오에는 개별 시간 제한이 있으며, 해당 시나리오를 통과 조건으로 완료해야 합니다. 또한, 많은 시나리오에는 보너스 조건으로 더욱 엄격한 시간 제한이 적용됩니다.<br><br>타이머는 트럭이 이동한 후에만 시작됩니다.<br><br><font face=/font/big_bold.font>계속하려면 엔진을 시동하고 주차 브레이크를 해제하십시오.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "트럭 운전 숙련도에 새롭게 추가된 기능 중 하나는 웨이포인트입니다. 시나리오를 완료하려면 모든 웨이포인트에 도달해야 합니다. <br><br>또한, 웨이포인트는 웨이포인트에 도달했을 때 트럭이 향하는 방향에 따라 달라지므로, 웨이포인트 근처의 지면 표시를 주의 깊게 확인하여 올바른 방향을 잡으십시오.<br><br><font face=/font/big_bold.font>앞에 있는 웨이포인트를 향해 앞으로 주행하십시오.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "경유지에 도착했으므로 이제 다음 단계로 넘어갈 수 있습니다.<br><br>뒤에 후진해야 할 또 다른 경유지가 있습니다. 경유지에 도달했을 때 트럭이 어느 방향을 향해야 하는지 나타내는 지면의 화살표를 확인하세요.<br><br>고려해야 할 또 다른 합격 및 보너스 조건은 <color value=@@clr_sel@@>방향 변경<color value=@@clr_txt@@>입니다. 전진과 후진 사이에 방향을 변경하는 횟수를 계산합니다. 제한 속도 이하로 유지하여 조건을 완료하세요.<br><br><font face=/font/big_bold.font>경유지로 후진하여 정지하십시오.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "이제 방향 전환을 한 번 했을 겁니다.<br><br>뒤에 있는 트레일러를 집어 들고 다음 단계로 넘어가세요.<br><br><font face=/font/big_bold.font>트레일러 아래로 후진하여 연결하십시오.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "마지막 주차 공간은 오른쪽에 있습니다. 시나리오에 따라 주차 공간이 하나뿐일 수도 있고, 여러 개일 수도 있습니다. 어느 주차 공간에든 정확하게 주차하면 시나리오를 완료할 수 있습니다. <br><br><font face=/font/big_bold.font> @@imv_nrm_attach@@를 눌러 트레일러를 연결하십시오. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "주차 위치는 해당 위치에서 트럭이 어느 방향으로 주차해야 하는지를 나타냅니다. 잘못된 방향으로 주차하면 방향을 수정하기 전까지는 시나리오를 완료할 수 없으며, 이로 인해 시간과 방향 변경이 낭비됩니다.<br><br><font face=/font/big_bold.font>주차 위치 중 한 곳으로 이동하여 올바르게 주차하십시오.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "트럭 운전 능력"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "이제 합격 조건과 보너스 목표에 대한 새로운 매개변수를 알게 되었으니, 트럭 운전 숙련도의 새로운 시나리오에 도전할 준비가 되었습니다!<br><br><font face=/font/big_bold.font>주차 브레이크를 걸고 엔진을 꺼서 트럭을 고정하고 시나리오를 완료하십시오.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "지름길"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "이 경우, 지름길을 이용하려고 하는데, 안타깝게도 끝부분이 막혀 있습니다. 그런 다음 왔던 길을 따라 다시 내려가야 합니다."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "언덕 꼭대기에 있는 경로지점까지 운전한 다음 같은 방향으로 되돌아 내려옵니다. <br><br>다시 도로로 나오면 마지막 주차장까지 운전하십시오."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "일찍 일어나는 새"

	key[]: "aca_scenario_book2_early_bird_desc"
