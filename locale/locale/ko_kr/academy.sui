#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "대각선 주차"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "이 시나리오에서는, 여러분은 붐비는 주차장의 대각선 공간에 차를 주차하게 될 것입니다.<br><br>조종할 공간이 많지 않으므로, 운전할 때는 매우 정확하고 신중해야 할 것입니다."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "주차 공간 접근"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "이런 대각선 주차 공간은 매우 흔합니다. 특히 유럽 고속도로를 따라 늘어선 많은 휴게소에서 흔합니다. <br>다시 한번 우리는 앞의 주차 공간에 '코로 진입(뱀머리 주행)' 합니다."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "줄 끝 근처에 있는 지정된 주차 장소를 향해 운전하십시오."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "차선 중앙이나 운전석 쪽으로 약간 유지합니다. 장벽에 너무 가까이 운전하지 마십시오. 아니면 트레일러 뒤쪽이 회전할 때 장벽에 부딪힐 수 있습니다."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "주차 공간을 상당히 지나서 운전한 다음, 그 자리를 향해 빠르고 강하게 방향을 바꿉니다. 사이드 미러를 모두 확인해야 합니다. 운전석 사이드 미러는 트레일러 앞부분이 옆 트레일러에 부딪히지 않도록 하고, 조수석 사이드 미러는 트레일러가 안전하게 주차 공간에 들어가는지 확인합니다."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "지정된 구역에 멈추고, 트럭을 고정하고 엔진을 끄십시오."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "대각선으로 주차할 때는 자신의 위치를 정확하게 판단하는 것이 중요합니다. 회전의 중간쯤 되면 후진하고 안전하게 위치를 바꾸기 어렵기 때문에 첫 번째 시도에서 충분한 공간을 확보하는 것이 이상적입니다.<br><br><font face=/font/big_bold.font>출발을 준비하십시오.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>운전을 시작하고 주차 공간 쪽으로 가십시오.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "트레일러가 내부의 트럭 주위를 돌 수 있는 공간을 확보하기 위해 주차 공간을 지나 운전하세요.<br><br><font face=/font/big_bold.font>주차 공간으로 방향을 바꾸십시오. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "사각지대 후진"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "이 시나리오에서는 트럭을 주차 공간으로 후진시키는 '사각지대'를 살펴보겠습니다. 창밖을 내다보며 어디로 가는지 볼 수 있는 능력이 없다면, 거울에만 의지해서 가야 할 곳으로 가야 합니다."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "이 시나리오에서는 '사각지대' 후진 조작을 배우게 됩니다. 시야가 심각하게 제한되어 있으므로 대안이 없는 경우가 아니면 일반적으로 사각지대는 피해야 합니다. 시간을 갖고 극도의 주의를 기울이십시오."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "후진을 시작하면 주차 공간을 충분히 지나서 작업할 공간을 확보하십시오."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "차를 멈추고 주변을 확인한 후 후진을 시작하십시오."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "트랙터를 그 자리에서 돌리세요. 그러면 트레일러 앞부분이 밀려나고, 그러면 트레일러 뒷부분이 들어가고 싶은 주차 지점을 향하게 됩니다. 과하지 않도록 주의하십시오. 그렇지 않으면 조합이 '잭나이프'될 위험이 있습니다."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "트레일러가 주차 장소에 들어가면 트럭을 정렬하기 시작합니다."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "지정된 구역에 멈추고 트럭을 고정하십시오."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "사각지대 후진은 시야측 후진과 동일한 절차가 필요하지만, 그 쪽은 시야가 부족하여 불리할 것입니다. 거울과 최선의 판단을 사용하여 트럭을 주차합니다.<br><br><font face=/font/big_bold.font>출발 준비를 하십시오. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "앞쪽과 조수석 쪽에 주차 공간이 있습니다. 후진할 때 조작할 공간을 확보하기 위해 주차 공간을 충분히 지나야 합니다.<br><br><font face=/font/big_bold.font>앞으로 운전하십시오. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "기억하세요, 트럭을 그 지점에서 돌리면 트레일러도 그 지점으로 돌아갑니다. 거울을 최대한 활용하여 주차 지점으로 들어가세요.<br><br><font face=/font/big_bold.font>후진을 시작 하십시오. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "회전교차로에서 운전하기"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "이 시나리오에서는 회전교차로를 통과하는 방법을 살펴보겠습니다.<br><br>회전교차로에 진입할 때, 통과할 때, 나갈 때 트레일러의 뒤에서 움직이는 방향이 다르므로 특별히 트레일러에 주의해야 합니다."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
