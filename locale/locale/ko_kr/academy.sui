	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "카메라 컨트롤"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "이 시나리오에서는 여러분이 사용할 수 있는 다양한 유형의 카메라에 대해 알아보고, 이를 사용하여 트럭을 제어하고 조종하는 데 어떻게 도움이 될 수 있는지 알아보겠습니다."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "시트 위치"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "후면보기"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "거울 확인"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "외부 카메라로 전환"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "트럭 둘러보기"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "이 시나리오를 통해 사용할 수 있는<br>다양한 카메라를 살펴봅니다."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "총 7개의 카메라를 선택할 수 있으며,<br>지금 몇 가지 카메라를 살펴보고 그 기능에 대해 설명하겠습니다."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "서로 다른 각도를 가진 다양한 카메라를 활용하면 좁은 장소에서 조작할 때 도움이 됩니다."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "가고 있는 곳을 보는 것은 안전하고 전문적인 운전의 핵심 기반입니다. 현재 시트 위치가 마음에 들지 않으면 '@@adjust_link_t@@'에서 변경할 수 있습니다(일시 중지 메뉴를 통해 액세스).<br><br><font face=/font/big_bold.font>준비가 되면 @@imv_nrm_activate@@(으)로 확인하십시오. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "후진할 때 거울이 항상 깨끗한 시야를 제공하지는 않습니다. 더 나은 시야를 확보하기 위해 뒤의 창밖을 내다볼 필요가 있을 수 있습니다.<br><br><font face=/font/big_bold.font>카메라를 운전석 쪽으로 완전히 돌려 트레일러 뒤쪽을 향해 창밖을 보세요.</font>@@aca_goal_tip@@ 차량 안에 있어야 합니다."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "이 뷰를 사용하여 트레일러로 후진 조작하는 동안 트레일러를 확인합니다. 이 뷰를 활용할 수 있도록 항상 운전석 쪽으로 후진하는 것이 좋습니다. 조수석 쪽으로 후진할 때 뒤에서 무슨 일이 일어나고 있는지 훨씬 더 제한적으로 볼 수 있습니다.<br><br><font face=/font/big_bold.font>조수석 쪽을 바라보십시오. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "이것이 일반적으로 조수석 쪽으로 후진하는 것이 권장되지 않는 이유입니다. 가시성이 매우 제한되어 있음을 알 수 있습니다. 다행히도 7개의 외부 카메라도 사용할 수 있습니다. <br><br>@@imv_nrm_camcycle@@ 버튼을 사용하여 순서대로 다음 카메라로 전환할 수 있습니다. 7개 카메라를 모두 순환한 후 사이클의 시작 부분으로 돌아갑니다. <br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@을 눌러 다음 카메라로 전환합니다. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "외부 카메라는 트럭 주변에서 무슨 일이 일어나고 있는지에 대한 최상의 관점을 제공합니다.<br><br><font face=/font/big_bold.font>트럭 주변을 둘러보십시오. </font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_camcycle@@을(를) 다시 누르면 다음 카메라로 전환할 수 있습니다. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "탑-다운 카메라 기능은 트럭 주변 상황을 훌륭한 개요를 보여주어 좁은 공간에서 주차하고 운전하는 것을 크게 간소화합니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@을(를) 눌러 다음 카메라로 전환하십시오.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "지붕 카메라는 트럭 바로 앞 도로를 큰 방해 없이 선명하게 보여줍니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_camcycle@@을(를) 눌러 지금 살펴볼 마지막 카메라로 전환하십시오.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "후방 보기는 내부 카메라를 돌려서 이전에 얻은 보기로 바로 가는 단축키입니다. 앞서 논의했듯이 후진이나 주차할 때 유용합니다.<br><br>게임에는 @@imv_nrm_camcycle@@를 반복해서 눌러서 시도할 수 있는 카메라가 더 있습니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_cam1@@을(를) 눌러 내부로 돌아갑니다.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "진정한 드라이빙 스쿨 경험을 위해 각 시나리오를 진행하는 동안 '인테리어 카메라' 보기를 유지하는 것이 좋습니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_activate@@를 눌러 시나리오를 확인하고 종료합니다.</font>@@aca_goal_tip@@ 주변을 더 잘 보려면 @@o_im_cam_zoom@@ 기능을 사용할 수 있습니다. 특히 거울을 통해 볼 때 유용합니다. 옵션 화면 - '@@options_bindings_screen@@'을 확인하여 해당 키 바인딩을 확인 또는 변경합니다."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "첫 번째 드라이브"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "이 시나리오에서는 트럭을 운전할 준비를 하는 방법과 처음으로 앞으로 운전하는 방법을 알아보겠습니다."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "점화장치 켜기"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "엔진 시동"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "주변 환경 확인"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "풋 브레이크 작동"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "기어 변속"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "주차 브레이크 해제"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "앞으로 나아가기"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "정지"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "주차 브레이크 작동"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "중립으로 전환"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "엔진 끄기"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "처음 몇 번의 운전에서는 트랙터 유닛만 사용하게 됩니다.<br>트럭 자체의 화물 운반 수단이 없고 대신 트레일러를 사용하여 물품과 자재를 운반하는 경우를 트랙터라고 합니다."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "트랙터가 널리 쓰이는 이유는 다양성이 크기 때문입니다. 빈 트레일러를 내려놓고 화물을 실은 트레일러를 들어올릴 때 기다릴 필요 없이 트레일러를 내릴 수 있고, 완전히 다른 종류의 트레일러로 바꿀 수도 있습니다."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "첫 번째 운전에서는 앞으로 운전하고 점선 이후에 정지하는 것이 과제입니다.<br>엔진을 시동하고 지시에 따라 트럭을 움직일 준비를 합니다. 준비가 되면 직진합니다."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "점선을 지나 운전하여 정지하고, 엔진을 끄고 트럭을 고정하십시오."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "훈련의 다음 단계에서는 처음으로 트럭을 움직여보겠습니다.<br><br>물론 엔진이 켜지지 않으면 작동하지 않으므로 먼저 점화를 켜야 합니다.<br><br><font face=/font/big_bold.font>$input engineelect$를 눌러 점화를 켭니다.</font>@@aca_goal_tip@@ 커리어에서는 기본적으로 엔진이 전기와 함께 자동으로 켜집니다. 커리어의 경우 옵션 화면 - '게임 플레이' - @@auto_engine_start@@에서 이 동작을 조정할 수 있습니다."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "점화는 트럭의 전자 장치를 작동시킵니다. 대시보드에서 경고등이 깜빡이는 것을 보셨을 것입니다. 이는 정상적인 현상입니다. 엔진을 시동한 후에도 계속 켜져 있다면 트럭에 문제가 있다는 신호일 가능성이 큽니다. 예외는 주차 브레이크 램프로, 주차 브레이크를 풀면 꺼집니다.<br><br>다행히도 이 트럭은 상태가 양호하고 진행할 준비가 되었습니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_engine@@을(를) 눌러 엔진을 시동하십시오. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "이제 엔진을 시동했으므로 움직이기 전에 주변을 확인하는 것이 중요합니다.<br><br><font face=/font/big_bold.font>트럭 주변과 운전석과 조수석 사이드 미러를 둘러보아 트럭 주변이 안전한지 확인하세요.</font>@@aca_goal_tip@@ 차량 내부에 있어야 합니다."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "당연한 것처럼 보일 수 있지만 움직이기 전에 멈추는 방법을 알아야 합니다.<br><br><font face=/font/big_bold.font>$input backward$를 사용하여 풋 브레이크를 활성화합니다. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "다음으로, 주행 방향을 바꾸는 방법을 알아보겠습니다.<br><br>단순화된 자동 변속기를 사용하면 기어를 바꿀 필요가 없으며 모든 것이 자동으로 처리됩니다.<font face=/font/big_bold.font><br><br>$input forward$를 사용하여 전진 기어를 활성화합니다. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "다음으로, 주행 방향을 바꾸는 방법을 알아보겠습니다.<br><br>현실적인 자동 변속기를 사용하면 실제 자동 변속기처럼 주행, 중립, 후진 사이를 전환할 수 있습니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@을 눌러 전진 기어를 활성화합니다. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "다음으로, 주행 방향을 바꾸는 방법을 알아보겠습니다.<br><br>순차 변속은 실제 순차 변속과 마찬가지로 단계적 변속이 가능합니다.<br><br>앞 기어를 넣는 것과 같은 방식으로 가속하는 동안 더 높은 기어로 변속해야 합니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_gearup@@을 눌러 1단 기어를 넣으십시오.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "다음으로, 주행 방향을 바꾸는 방법을 알아보겠습니다.<br><br>기어 스틱과 클러치를 사용하면 실제 수동 변속기와 같은 물리적 기어 변속 느낌을 경험할 수 있습니다.<br><br>클러치와 풋 브레이크를 완전히 밟습니다. <font face=/font/big_bold.font>기어 스틱을 사용하여 1단 기어를 넣습니다. <color value=@@clr_txt@@>클러치와 풋 브레이크를 완전히 밟습니다.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "이동을 시작하려면 먼저 주차 브레이크를 풀어야 합니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@를 사용하여 주차 브레이크를 풀어야 합니다.</font> @@aca_goal_tip@@ 커리어에서는 주차 브레이크가 처음에는 비활성화되어 있습니다. 옵션 화면 - '게임 플레이' - @@auto_park_brake@@에서 이 동작을 조정할 수 있습니다."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "이제 트럭은 앞으로 나아갈 준비가 되었습니다. 이동을 시작하고 점선을 건넙니다.<br><br><font face=/font/big_bold.font>가속 페달을 사용하여 이동을 시작하십시오: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "이제 트럭은 앞으로 나아갈 준비가 되었습니다. 이동을 시작하고 점선을 건넙니다.<br><br><font face=/font/big_bold.font>가속 페달을 사용하여 이동을 시작하십시오: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "이제 트럭은 앞으로 나아갈 준비가 되었습니다. 이동을 시작하고 점선을 건넙니다.<br><br><font face=/font/big_bold.font>가속 페달을 사용하여 이동을 시작하십시오: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "이제 트럭은 앞으로 나아갈 준비가 되었습니다. 이동을 시작하고 점선을 건넙니다.<br><br><font face=/font/big_bold.font>풋 브레이크를 놓고, 클러치를 서서히 놓아서 작동시키면서 동시에 가속 페달을 사용하여 RPM을 높여 트럭이 멈추지 않도록 합니다. 클러치가 완전히 풀리면 필요에 따라 가속하고 변속할 수 있습니다. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "풋 브레이크를 사용하여 멈춥니다.<br><br><font face=/font/big_bold.font>$input backward$를 사용하여 트럭을 멈추 십시오. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "풋 브레이크를 사용하여 멈춥니다.<br><br><font face=/font/big_bold.font>$input backward$를 사용하여 트럭을 멈추 십시오. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "풋 브레이크를 사용하여 멈춥니다.<br><br><font face=/font/big_bold.font>$input backward$를 사용하여 트럭을 멈추 십시오. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "멈출 때가 되면 클러치를 완전히 밟은 다음 <font face=/font/big_bold.font>풋 브레이크를 사용하여 트럭을 멈추십시오.<color value=@@clr_txt@@> 기어 스틱을 사용하여 기어를 중립으로 바꾼 다음 클러치를 놓아도 됩니다. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "이제 트럭을 고정합니다. 주차 브레이크는 주차한 후 트럭이 의도치 않게 움직이지 않도록 합니다.<br><br><font face=/font/big_bold.font>@@imv_nrm_parkingbrake@@를 사용하여 주차 브레이크를 활성화 하십시오.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "간소화된 자동 변속기를 사용하면 기어를 바꿀 필요가 없으며 모든 것이 자동으로 처리됩니다.<br><br><font face=/font/big_bold.font>확인하려면 @@imv_nrm_activate@@를 누르십시오. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@을 눌러 중립으로 전환하십시오. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>@@imv_nrm_geardown@@을 눌러 중립으로 전환하십시오. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>기어 스틱을 중립으로 옮기고 클러치를 놓으십시오. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "이제 트럭을 움직이는 방법과 안전하게 멈추는 방법을 알게 되었습니다.<br><br><font face=/font/big_bold.font>$input engineelect$를 눌러 엔진을 끄십시오. </font>"
#@}

