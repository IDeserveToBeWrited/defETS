	key[]: "trip_ferry_len"
	val[]: "페리 이동 거리" #+ Shown in the route info box in the line indicating length of the ferry route. For example "Ferry distance&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100 km"

