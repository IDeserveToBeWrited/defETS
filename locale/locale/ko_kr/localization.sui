#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "계속 ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Euro Truck Simulator 2 에 오신 것을 환영합니다!"

	key[]: "intro_2"
	val[]: "트럭 운전 - 당신이 꿈꾸는 직업을 체험할 수 있는 기회입니다!"

	key[]: "intro_3"
	val[]: "현재 당신은 운송회사를 경영하고 있지만, 안타깝게도 트럭을 구매할 자금이 부족합니다. 당신은 당분간 다른 회사에서 직원으로 일해야 합니다."

	key[]: "intro_4"
	val[]: "당신의 임무는 $JOB_CARGO$ 화물을 $JOB_TARGET_CITY$에 있는 $JOB_TARGET_COMPANY$까지 안전하게 운반하는 것입니다. 당신의 고용주가 차량을 포함한 모든 비용을 부담할 것입니다. 절대로 모두를 실망하게 하는 짓을 하지 마십시오."


	key[]: "intro_garage_1"
	val[]: "이곳은 당신의 본사입니다."

	key[]: "intro_garage_2"
	val[]: "이는 지극히 일반적인 차고입니다. 대단하지는 않지만 이제 시작일 뿐입니다."

	key[]: "intro_garage_3"
	val[]: "불행하게도 아직 이곳에 주차할 수 있는 트럭이 없기 때문에 트럭이 보이지 않을 것입니다."

	key[]: "intro_garage_4"
	val[]: "당신이 충분한 돈을 벌고 트럭을 구매하면 세계 곳곳을 자유롭게 이동하고 이곳에서 당신의 사업을 꾸려나갈 수 있을 것입니다."

	key[]: "intro_garage_5"
	val[]: "행운을 빕니다!"


	key[]: "desktop_tut_t"
	val[]: "기능 잠금 해제"

	key[]: "desktop_tut_job"
	val[]: "다음 일을 선택하십시오"

	key[]: "desktop_tut_cargo_market"
	val[]: "당신의 새로운 트레일러를 이용해 화물 시장의 다양한 화물을 목적지까지 운송하십시오." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "이곳에서 진행 상황을 볼 수 있습니다."

	key[]: "desktop_tut_company"
	val[]: "이곳에서 소유 중인 차고에 대한 정보를 확인하거나 새로운 드라이버를 고용하는 등 회사의 전반적인 부분을 관리할 수 있습니다."

	key[]: "desktop_tut_trailers"
	val[]: "이제 당신은 트레일러를 구매한 후 소유한 트럭과 잘 어울리도록 업그레이드하거나 도색할 수 있습니다.<br><br>트레일러는 선택한 차고에 보관할 수 있으며 보관한 트레일러는 당신의 드라이버들이 본인의 수익을 높이기 위해 사용할 수 있습니다. 트레일러를 관리하려면 트레일러 관리자를 이용하십시오."

