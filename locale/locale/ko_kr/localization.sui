	val[]: "등록을 미루시겠습니까?<br><br>바탕화면의 온라인 옵션을 통해 온라인 연결 콘텐츠 다이얼로그에 접근할 수 있습니다." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "콘텐츠 연결" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "콘텐츠 연결 중.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "다음 콘텐츠를 연결 작업 대기열에 넣지 못했습니다: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "DLC를 등록하는데 사용한 스팀 계정이 World of Trucks 계정에 연결한 스팀 계정과 다릅니다. 스팀 계정을 변경하고 다시 시도하십시오." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "이 DLC를 등록하는데 사용하려는 스팀 계정이 이미 다른 World of Trucks 계정에 연결되어 있습니다. 현재 스팀 계정에 DLC를 등록하려면 World of Trucks 계정에 연결되어 있지 않은 스팀 계정을 사용해야 합니다." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "스팀 토큰이 만료되었습니다. 나중에 다시 시도 해주십시오." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "DLC 활성화에 사용 된 제품 키가 유효하지 않습니다. 도움을 받으려면 지원부에 문의하십시오 : support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "게임을 등록하는 도중 내부 오류가 발생했습니다. 나중에 다시 시도하십시오." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "성공" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "정보" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "온라인" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "콘텐츠 브라우저" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "축하합니다! 선택한 DLC가 World of Trucks 계정에 성공적으로 연결되었습니다." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "현재 스팀 계정이 다른 World of Trucks 계정과 연결되어있어 콘텐츠를 연결할 수 없습니다." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "일부 DLC와의 연결에 실패했습니다.<br>해당 DLC의 느낌표 위로 마우스 커서를 가져가면 자세한 내용을 볼 수 있습니다." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "$CURRENT_CONTENT_NAME$ 등록 중" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "현재 프로필이 World of Trucks에 연결되어 있지 않거나 게임이 오프라인 모드에서 실행 중입니다. 연결하려면 프로필을 수정하십시오." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "클릭하여 숨기기"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ 중 현재 호환되는 DLC만 연결됩니다. 일부 DLC가 World of Trucks에 연결되어 있지 않으면 일부 기능이 누락될 수 있습니다." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>축하합니다!<color value=@@clr_txt@@> 모든 콘텐츠가 World of Trucks에 연결되었습니다! 이제 모든 기능을 사용할 수 있습니다." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "현재 사용 중인 스팀 계정이 World of Trucks 프로필에서 사용하는 스팀 계정과 일치하지 않으므로, 새로운 콘텐츠를 World of Trucks에 연결할 수 없습니다." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "연결됨" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "연결되지 않음" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "소유 중인 콘텐츠에 대한 정보를 가져올 수 없습니다." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "연결된 콘텐츠에 대한 정보를 가져올 수 없습니다." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "사용 중인 계정에 대한 정보를 가져올 수 없습니다." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "나중에" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "이 DLC를 등록할 수 없습니다. 스팀 가족 라이브러리 공유로 인해 영구 라이선스를 찾지 못했습니다." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "영구 소유권이 존재하지 않음" #+ The state of the content that cannot be connected due to invalid license.
#@}


