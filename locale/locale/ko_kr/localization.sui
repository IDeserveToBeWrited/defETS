	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "제한 속도를 초과하면 내비게이션의 현재 속도가 빨간색으로 변경됩니다."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "목적지에 도착하면 주차를 건너뛸 수 있는 위젯이 표시됩니다."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "모든 위젯을 숨기기."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "HUD 미러 두 개를 모두 숨깁니다."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "모든 알림이 수신되더라도 숨겨둡니다."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "중량화물 작업을 수락하기 전에 플레이어의 현재 트럭 성능을 보여주는 창을 표시합니다."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "지도 정렬 방식을 선택합니다."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "세계 지도를 탐색하는 방법을 선택하세요:<br>- \"근접 탐색\"은 탐색할 때 더 넓은 영역을 표시합니다.<br>- \"정밀 탐색\"은 플레이어 주변의 영역만 표시합니다."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "내비게이션 표시 방법을 선택합니다."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "경로 탐색 방식을 선택합니다:<br>- \"최적 경로\"는 주행 거리와 주행 시간을 분석하고 가급적 신호를 대기할 필요가 없는 가장 효율적인 경로를 탐색합니다.<br>- \"최단 거리\"는 주행 거리가 가장 짧은 경로를 탐색합니다.<br>- \"좁은 길 우선\"은 고속도로 주행을 최소화하여 경로를 탐색합니다."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "주차 난이도를 변경합니다:<br>- \"매번 선택\"은 목적지에 도착할 때마다 주차 난이도를 선택할 수 있습니다.<br>- \"안전 주차\"는 후진할 필요가 없는 주차 공간을 배정받습니다.<br>- \"숙련된 주차\"는 일반적으로 조금 더 어려운 후진 조작이 필요한 주차 공간을 배정받습니다."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "사고, 고장난 차량, 도로 잔해 등 주행 중인 도로에 위험 요소가 등장할 확률을 조정합니다."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "운행 도중 도로 폐쇄로 인한 경로변경 상황 발생 빈도를 조정합니다."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "악천후 발생 빈도를 조정합니다."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "현재 시간 외에 시간대 정보를 표시할지 여부를 선택합니다."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "트럭 구매, 차고 업그레이드 또는 승객 탑승 중에 표시되는 게임 내 컷신을 활성화합니다."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "접근할 수 없는 도로에 반투명 차단 표지를 표현할지 선택합니다."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "게임 내에서 카메라를 제어할 때 마우스 Y축을 반전시킵니다."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "변속기 유형을 선택합니다:<br>- \"심플 오토매틱\"을 사용하면 가속 페달과 브레이크를 사용하여 전진 및 후진 동작을 제어할 수 있습니다.<br>- \"리얼 오토매틱\"은 전진 기어와 후진 기어 사이를 전환하기 위한 입력이 필요합니다.<br>- \"시퀸설\"은 기어 올리기/내리기 입력을 통해 모든 기어를 수동으로 변속해야 합니다.<br>- \"H-시프터\"는 기어를 수동으로 선택하기 위해 변속 게이트가 있는 컨트롤러를 사용해야 합니다."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "\"변속 건너뛰기\" 기능을 활성화합니다. 이는 속도에 맞는 기어를 바로 체결하여 모든 기어를 순차적으로 올려야 하는 번거로움을 방지합니다."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "키보드나 컨트롤러를 사용할 때 스티어링 휠을 중앙으로 되돌립니다.<br><br>이 기능을 비활성화하면 회전 후 수동으로 중앙으로 다시 방향을 조정해야 합니다."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "스티어링 휠 애니메이션의 범위를 조정합니다. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "브레이크의 강도를 변경합니다."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "무게 중심을 낮춰 차량의 안정성을 변경합니다."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "무게 중심을 낮춰 트레일러의 안정성을 변경합니다."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "구동라인에서 생성되는 토크의 강도를 변경합니다.<br><br>이 설정을 높이면 차량이 오른쪽으로 \"뒤틀리는\" 느낌이 증가합니다."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "샤시 서스펜션의 강도를 변경합니다."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "캐빈/슬리퍼 서스펜션의 강도를 변경합니다."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "절차적으로 생성된 표면 요철의 강도를 조정하여 도로 및 기타 지형에 불완전한 느낌을 줍니다<br> <br>다른 서스펜션 및 카메라 설정에 따라 인지된 효과가 다소 두드러질 수 있습니다."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "트럭의 커플러를 트레일러의 킹핀과 정렬하기 위해 더 높은 정밀도가 요구되는 고급 커플링을 가능하게 합니다.<br><br>비활성화되면 킹핀과 커플러 사이에 충돌이 없기 때문에 트레일러 연결이 훨씬 쉬워집니다."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "애니메이션화된 트레일러 케이블의 경우 및 해당 트레일러 케이블을 선택합니다.<br><br><color value=@@clr_txt_d@@>구형 시스템의 경우 다수의 차량에서 케이블을 활성화하면 성능이 떨어질 수 있습니다."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "활성화하면 전자식 속도 제한장치를 이용해 트럭의 속도를 90km/h (56mph)로 제한합니다.<br><br><color value=@@clr_txt_d@@>World of Trucks 작업에서는 기본적으로 적용되며 끌 수 없습니다."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "활성화 후 윈드실드 와이퍼를 첫 번째 위치로 설정하면 와이퍼가 자동으로 켜지고 조건에 따라 속도가 조정됩니다."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "제동 시 리타더가 자동으로 작동되도록 활성화합니다."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 차량이 경사로에서 출발할 때 브레이크를 유지하여 부드러운 출발을 도와줍니다."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "제동 시 엔진 브레이크가 자동으로 작동되도록 활성화합니다."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 가속 페달을 밟았을 때 엔진 시동이 걸립니다."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 차량의 주차 브레이크가 기본적으로 작동됩니다 (페리 이용 후, 견인 서비스, 빠른 여행 등)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "차량 중량에 따라 필요한 경우 리프트 액슬을 자동으로 작동합니다."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 차량은 기본적으로 낮은 가속상태를 유지합니다. 가속버튼을 빠르게 두 번 누르면 버튼에서 손을 뗄 때까지 차량은 최대 가속상태를 유지합니다.<br><br>키보드 입력에만 영향을 미칩니다."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "과도한 브레이크 작동으로 인한 실제 공기 손실을 시물레이션합니다.<br><br>이 옵션을 활성화하면 언덕을 내려갈 때나 서행 중 브레이크를 자주 밟을 때에는 공기압에 더욱 신경써야 합니다."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "비활성화 시 연료 소비는 주행 스타일이나 도로 상태에 영향을 받지 않습니다.<br><br>활성화 시 연료 소비는 주행 스타일, 화물 무게, 롤링 저항, 지형 프로필 등 여러 요인에 의해 영향을 받습니다. 더 이상 @@skill_mechanical_title@ 스킬의 영향을 받지 않습니다."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 ABS가 휠 잠김을 방지하여 제어력을 유지하고 제동 능력을 향상시킵니다."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 차량은 바퀴 당 제동을 적용하여 휠 스핀, 언더스티어 또는 오버스티어를 방지하고 제어력을 유지하는 데 도움을 줍니다."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 바퀴가 미끄러질 때 견인력을 향상시키기 위해 차량이 차동 장치를 잠급니다."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "해당 버튼을 누를 때 크루즈 컨트롤 목표 속도가 일정량 만큼 증가하거나 감소합니다."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "목표 속도를 유지하기 위한 크루즈 컨트롤 허용 오차를 변경합니다."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 크루즈 컨트롤이 앞차와의 안전거리를 유지하기 위해 자동으로 속도를 조절합니다."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "시스템이 임박한 충돌을 감지하면 비상제동장치를 활성화합니다.<br>시스템이 차량에만 반응할지 아니면 모든 장애물에 반응할지 선택합니다."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "차선 어시스턴트 모드를 선택합니다:<br>- \"차선 이탈 경고\" 모드는 차선을 벗어나려고 할 때 소리로 경고합니다.<br>- 청각적 경고 외에도 \"차선 유지 지원\"은 차량이 차선을 벗어나지 않도록 자동으로 조종합니다.<br><br>두 모드 모두 55km/h (~35mph) 이상의 속도에서만 활성화됩니다.<br>차선 어시스턴트는 작동하기 전에 방향지시등 사용도 고려합니다."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "차량에 사각지대 센서가 장착된 경우, 사각지대 센서 기능을 활성화합니다."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "이 옵션을 활성화하고 전조등을 첫 번째 위치로 설정하면 주변이 어두운 상황에서 전조등이 자동으로 켜집니다."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "이 옵션을 활성화하고 상향등을 켜면 맞은편에서 차량이 다가오거나 전방에 주행 중인 차량을 감지했을 때 자동으로 상향등이 꺼집니다."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "활성화하면 스티어링 휠이 중앙으로 되돌아올 때 방향지시등이 자동으로 꺼집니다."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "이 옵션을 활성화하면 일부 실내 액세서리가 차량의 물리적인 움직임에 반응합니다 (걸이 장식, 보블 헤드 등)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "스티어링 입력을 기반으로 인테리어 카메라의 Yaw를 활성화합니다."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "\"스티어링 카메라 회전\" 기능이 조향 입력에 반응하는 방식을 변경합니다. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "후진할 때 \"스티어링 카메라 회전\" 기능의 동작을 변경합니다."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 방향지시등 사용 방향에 따라 인테리어 카메라가 왼쪽 또는 오른쪽을 봅니다."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "활성화하면 인테리어 카메라가 차량 움직임에 반응합니다."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "인테리어 카메라가 차량 움직임에 반응하는 방식을 변경합니다."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "차량 움직임에 따라 내부 카메라의 롤링 허용량을 변경합니다."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "카메라가 자동으로 중앙으로 돌아오기 전 지연 시간을 설정합니다.<br><br>이 기능을 활성화하려면 차량이 무시할 수 없는 속도로 움직여야 합니다. 앞으로 움직일 때는 내부 및 추격 카메라에만 적용되고, 뒤로 움직일 때는 카메라를 기울이는 데만 적용됩니다."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "카메라 이동 속도를 설정합니다. 자동 카메라 센터링 및 내부 카메라 사전 설정 간 전환에 사용됩니다."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "내부 줌 작동 방식을 결정합니다: 버튼을 눌러 일시적으로 줌하거나 한 번 누르면 전환됩니다." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "게임 전반에 걸쳐 표시될 언어를 선택합니다."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "선택한 지역에 따라 화폐단위 및 측정단위의 사전 설정을 변경합니다."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "활성화하면 도시와 국가가 선택한 언어로 표시됩니다."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "활성화하면 도시와 국가가 선택한 언어와 해당 지역의 언어로 지도에 표시됩니다."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "어떤 화폐단위를 사용할지 선택하십시오."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "12 시간제 또는 24 시간제 표기 중에서 선택하십시오."

