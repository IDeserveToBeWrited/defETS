#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "은행" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "은행" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "돈이 필요하면 언제든지 은행에 대출을 요청할 수 있습니다." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "대출 상품" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "매일 $MONEY$ 상환" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "활성화된 대출: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "대출 가능한 금액: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "대출 내용"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "대출 금액" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "잔금" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "기간 (일)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "이율 (%)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "분할금" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "대출 갚기" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "합계:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "현재 잔고: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
