#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "그래픽" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "그래픽" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "세밀하게 조정된 그래픽 사전 설정을 수정하여 게임의 시각적 성능을 원하는 대로 조정하십시오."

	key[]: "apply"
	val[]: "적용" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "바탕화면 테마" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "화면 설정" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "이미지 품질" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "텍스쳐" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "반사" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "그림자" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "빛" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "후처리" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "환경" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "전체화면 모드" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "밝기 / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "설정" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "해상도" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "화면 재생률" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS 제한" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "백그라운드에서 FPS 제한" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "기본 재생률" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "수직 동기화" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "이코노미 (노트북 사용 시 배터리 절약)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "간단한 그래픽 설정" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "사용자 지정 설정이 적용됨" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "고급 그래픽 설정" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "간단한/고급 그래픽 설정" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "고급 설정 숨기기" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "고급 설정 보이기" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "스케일링" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "안티앨리어싱" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA 루마 샤프닝" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA 튜닝" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "어댑티브 선명도" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "항상 부드러움" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "항상 날카로움" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "화면 영역 주변 폐색 (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "높은 동적 범위 (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "피사계 심도 (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "썬샤프트" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "색 보정" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "반사 스케일링" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "반사 디테일" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "초목 디테일" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "잔디 밀도" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "그림자 품질"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "그림자 텍스쳐 크기" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "먼 그림자" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "실내 그림자" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "날씨 품질"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "미러 품질" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "미러 해상도" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "미러 표현 거리" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "텍스쳐 품질" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "이방성 필터링" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "노멀맵" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "트래픽 전조등" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "차량 보조 라이트" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "라이트 가시 범위" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "보행자" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "디스플레이 설정이 변경되었습니다. <br>이 설정 상태를 유지할까요?"

	key[]: "reverting_in"
	val[]: "되돌리기" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "초" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
