#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "레인지 변속기는 가장 간단한 레이아웃입니다. 이 변속기는 두 세트의 기어를 가지고 있습니다. 첫 번째 세트에는 1단부터 6단 기어가, 두 번째 세트에는 7단부터 12단 기어가 들어있습니다. 시프터로 특정 기어 단을 선택한 상태에서 토글 버튼을 누르면 다른 세트의 기어 단으로 전환됩니다."

	key[]: "wiz_hs_splitter"
	val[]: "스플리터 변속기는 레인지 변속기를 대체하는 간단한 레이아웃입니다. 이 변속기 역시 두 세트의 기어를 가지고 있습니다. 첫 번째 세트에는 홀수 단 기어(1, 3, 5...)가, 두 번째 세트에는 짝수 단 기어(2, 4, 6...)가 들어있습니다. 시프터로 특정 기어 단을 선택한 상태에서 토글 버튼을 누르면 다른 세트의 기어 단으로 전환됩니다."

	key[]: "wiz_hs_range_splitter"
	val[]: "레인지-스플리터 변속기는 실제 차량의 레인지-스플리터 레이아웃을 기반으로 합니다. 각 그룹은 H-시프터의 기어 단을 네 개씩 사용하며 두 개의 토글 버튼을 사용합니다. 이 레이아웃은 숙련된 운전자에게만 권장합니다."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "이제 게임은 아래 설명된 설정을 기본 구성으로 사용합니다. 당신은 고급 설정을 통해 설정을 조정하거나 바로 게임을 진행할 수 있습니다."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "고급 설정"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "이제 게임이 구성되었으며 계속 진행할 수 있습니다. 나중에 옵션에서 구성을 변경할 수 있습니다."

	key[]: "wiz_cfg_steam"
	val[]: "스팀 클라이언트를 사용하여 이 컨트롤러에 대한 버튼과 축 매핑을 확인하거나 구성할 수 있습니다. 스팀 게임패드 설정은 Steam > Library > Euro Truck Simulator 2 > Controller Configuration에서 할 수 있습니다."

	key[]: "wiz_cfg_open_overlay"
	val[]: "컨트롤러 설정 열기"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>@@imm_wiz_dsteerleft@@와(과) @@imm_wiz_dsteerright@@을(를) 스티어링으로 사용합니다."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>해당 방향으로 스티어링 휠을 회전하려면 마우스를 왼쪽 또는 오른쪽으로 이동합니다."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>@@ima_wiz_j_steer@@을(를) 스티어링으로 사용합니다."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "@@imm_wiz_dforward@@을(를) 사용하여 전진하고 @@imm_wiz_dbackward@@을(를) 사용하여 후진합니다."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "@@ima_wiz_j_throttle@@을(를) 앞으로 밀면 전진하고 뒤로 당기면 후진합니다."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "@@ima_wiz_j_throttle@@을(를) 사용하여 전진하고 @@ima_wiz_j_brake@@을(를) 사용하여 후진합니다."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "@@imm_wiz_dforward@@을(를) 사용하여 가속하고 @@imm_wiz_dbackward@@을(를) 사용하여 감속합니다."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "@@ima_wiz_j_throttle@@을(를) 앞으로 밀면 가속하고 뒤로 당기면 감속합니다."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "@@ima_wiz_j_throttle@@을(를) 사용하여 가속하고 @@ima_wiz_j_brake@@을(를) 사용하여 감속합니다."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "@@imv_wiz_gearup@@을(를) 사용하여 전진하고 @@imv_wiz_geardown@@을(를) 사용하여 후진합니다."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "만약 당신이 키보드 혹은 컨트롤러를 사용한다면 @@imv_wiz_gearup@@을(를) 사용하여 전진하고 @@imv_wiz_geardown@@을(를) 사용하여 후진합니다. 만약 H-시프터를 사용한다면 @@imv_wiz_drive@@와(과) @@imv_wiz_reverse@@(으)로 주행 방향을 선택할 수 있습니다."

	key[]: "wiz_cfg_gb_manual"
	val[]: "@@imv_wiz_gearup@@와(과) @@imv_wiz_geardown@@을(를) 이용해 원하는 기어를 선택합니다."

	key[]: "wiz_cfg_gb_direct"
	val[]: "기어 단을 변경하려면 @@ima_wiz_j_clutch@@와(과) 함께 H-시프터를 조작합니다."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "컨트롤러 축 설정" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "축의 시각화"

	key[]: "wiz_setup_axes_desc"
	val[]: "선택한 모든 축의 움직임이 시각적으로 표현됩니다. 컨트롤러를 작동할 때 바가 움직이는지 확인하십시오. 작동 중인 축의 한계, 중심, 방향 등 축과 관련된 모든 동작을 보여줍니다."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "축 설정"

	key[]: "wiz_setup_axes_desc2"
	val[]: "축을 선택하려면 축 이름 옆에 있는 버튼을 클릭합니다. 그러면 입력 모드로 전환됩니다. 그런 다음 컨트롤러를 사용하여 스틱, 휠 또는 페달을 선택한 축으로 이동하여 선택한 축을 바인딩합니다."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "데드존"

	key[]: "wiz_setup_axes_desc3"
	val[]: "데드존은 의도적으로 입력을 제공하지 않도록 설계된 축 영역을 말합니다. 선택한 축의 데드존을 조정하려면 해당 슬라이더를 이동합니다. 슬라이더를 오른쪽으로 높이면 데드존이 확대됩니다. 이 기능은 더 큰 데드존을 정의하면 하드웨어 마모로 인한 부정확성 또는 잘못된 입력과 같은 문제를 완화할 수 있으므로 구형 컨트롤러에 특히 유용합니다."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "축 모드"

	key[]: "wiz_setup_axes_desc4"
	val[]: "축 모드는 게임에서 처리되는 방식을 결정합니다. 반전된 축은 보고된 방향을 뒤집어 예를 들어 오른쪽이 아닌 왼쪽으로 조향 합니다. 중앙 축은 조이스틱과 같이 해당 범위의 중간에 기본 위치가 있습니다. 이 모드는 잘못 감지된 축을 수정하는 데 유용합니다."

	key[]: "normal"
	val[]: "일반" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "반전" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "중심" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "반전, 중심" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "자동 기어 박스 설정" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "자동 기어 박스를 사용하면 전진, 중립 그리고 후진 모드로만 조작할 수 있습니다. 다음 키와 컨트롤러 버튼을 사용해 이 작업을 수행할 수 있습니다. 설정을 변경하려면 버튼을 클릭한 후 새로 사용할 키 또는 컨트롤러 버튼을 누릅니다."

	key[]: "automatic_gb_setup_desc2"
	val[]: "H-시프터 하드웨어를 연결한 경우 이를 실제 자동 기어를 시물레이션하는데 사용할 수 있습니다. 이 옵션을 사용하면 전진과 후진 위치를 H-시프터에 지정할 수 있습니다. 지정되지 않은 다른 위치는 전부 중립으로 처리됩니다. 이 설정은 H-시프터를 위해 제작된 만큼 단축키나 컨트롤러 버튼으로는 작동할 수 없습니다. 설정을 변경하려면 버튼을 클릭한 후 원하는 위치로 H-시프터를 이동한 다음 다시 중립 위치로 이동하십시오."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "시퀸설 기어 박스 설정" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "시퀸설 기어 박스를 이용해 전진 또는 후진 기어의 모든 단, 그리고 중립 위치로 변속할 수 있습니다. 언급한 대로 단 수를 올리고 내리는데 사용하는 키 또는 버튼이 있습니다. 설정을 변경하려면 버튼을 클릭한 후 새로 사용할 키 또는 컨트롤러 버튼을 누릅니다."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-시프터 기어 박스 설정" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "이곳에서 H-시프터의 기본 레이아웃을 선택하고 해당 기능을 사용할 수 있습니다. 그림을 통해 시프터의 기어봉이 어느 기어 단에 들어가 있는지 확인할 수 있습니다. 기어 박스는 시프터의 전체 기어 단 수보다 더 많은 기어 수를 가지고 있으므로 토글 버튼을 이용해 기어 세트를 전환해야 합니다."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "현재 선택된 시프터 위치와 토글 버튼은 관련 컨트롤 옆 하단에 표시됩니다. 설정을 변경하려면 해당 버튼을 클릭한 후 원하는 위치로 시프터를 이동한 다음 다시 중립 위치로 이동하십시오."
#@}

