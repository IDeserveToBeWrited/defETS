	val[]: "페리 운임" #+ Shown in the route info box in the line indicating price of the ferry route. For example "Ferry price&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;€100.-"

	key[]: "trip_land_len"
	val[]: "도로 운행 거리" #+ Shown in the route info box in the line indicating length of the land route. For example "Land distance&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100 km"

	key[]: "no_route"
	val[]: "화물을 선택하면 경로 정보를 볼 수 있습니다" #+ Text shown centred in the route info box when no job is selected.

	key[]: "incomplete_route"
	val[]: "불완전" #+ Shown instead of distance or time on the world map if only partial route was found.

