#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "스크린샷 파일이 너무 큽니다. 화면 해상도를 낮춰보십시오." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "스크린샷 파일이 손상되었거나 지원하지 않는 형식입니다." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "스크린샷 해상도가 너무 높습니다. 화면 해상도를 낮춰보십시오." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "서비스가 스크린샷을 거부했습니다." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "계정에 스크린샷을 업로드할 수 없습니다." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "동일 슬롯에 동시 업로드하였습니다." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "지금은 업로드를 할 수 없습니다. 나중에 다시 시도해주십시오." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "업로드 도중 알 수 없는 오류가 발생했습니다. 나중에 다시 시도해주십시오." #+ Error message shown when no more specific message applies.
#@}

