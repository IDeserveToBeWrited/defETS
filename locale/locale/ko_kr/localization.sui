#@}

#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "아이 트래킹" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Extended View" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Extended View 사전 설정" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "사전 설정 이름 입력" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "선택한 사전 설정을 삭제하시겠습니까?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "동일한 이름을 가진 기존의 사전 설정에 덮어씌웁니다. 계속하시겠습니까?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "시선 트래킹 설정" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "헤드 트래킹 설정" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "키보드 컨트롤" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Extended View 활성화" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "자동 중앙 맞추기" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "헤드 트래킹 모드" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "직접적" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "다이나믹" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "시선 트래킹 민감도" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "헤드 트래킹 민감도" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "롤 활성화" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "위치 활성화" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "좌우 회전 증폭 (캐빈)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Pitch 증폭 (캐빈)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Yaw 증폭 (보행 모드)" #+ Multiplier applied to resulting yaw value (in walk mode)

