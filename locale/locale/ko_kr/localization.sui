	key[]: "bank_nl_confirm_duration"
	val[]: "상환 기간:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "이율 (연이율):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "일일 상환금:" #+ Appended by sum in euros.

