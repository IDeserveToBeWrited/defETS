	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "디스플레이에 맞게 게임의 전체 밝기를 조정합니다. HDR 호환 디스플레이에서는 이 설정에서도 HDR 보정 옵션을 사용할 수 있습니다."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "게임의 해상도가 변경됩니다."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "게임의 목표 화면 재생률을 변경합니다."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "화면 찢김 현상을 방지하기 위해 프레임 속도를 모니터 주사율과 맞춥니다. 경제 설정은 프레임 속도를 절반으로 줄여 전력 소비를 줄입니다."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "게임에 허용되는 최대 프레임 속도를 설정합니다.<br><br>값을 0으로 설정하면 해당 기능이 비활성화됩니다."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "게임이 백그라운드에서 최소화될 때 허용되는 최대 프레임 속도를 설정합니다.<br><br>값을 0으로 설정하면 해당 기능이 비활성화됩니다."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "간단한 그래픽 설정(사전 설정) 또는 고급 그래픽 설정(개별 매개변수 변경 가능성) 간 변경이 가능합니다."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "내부적으로 더 높은 해상도로 게임을 렌더링하여 그래픽 충실도를 향상시켜 들쭉날쭉한 가장자리를 줄이고 디테일을 향상시킵니다.<br>예를 들어, 더 높은 배율 옵션을 선택하면 흐릿함이 덜하고 더 선명한 그림이 제공되므로 성능이 저하되는 대신 게임이 전반적으로 더 좋아 보입니다.<br><br><color value=@@clr_txt_d@@>이 설정은 성능에 큰 영향을 미치는 경우가 많습니다."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "게임에서 들쭉날쭉한 가장자리의 모양을 부드럽게 하는 고속 앤티앨리어싱 방법을 선택하세요:<br>- SMAA는 프레임 내의 다른 위치에서 각 픽셀을 여러 번 샘플링하고(선택한 품질에 따라 다름) 샘플의 평균을 내어 최종 그림을 생성합니다.<br>- TAA는 프레임당 각 픽셀을 한 번만 샘플링하지만, 다른 위치와 다른 프레임에서 샘플링합니다.<br>- 최상의 결과를 얻으려면 성능을 희생하고 두 가지를 조합하여 선택할 수도 있습니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "틈새와 서로 가까이 있는 물체에 부드러운 그림자를 추가하여 게임 내 전체 세계의 그래픽 충실도를 향상시킵니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "TAA 사전 설정 선택:<br>- \"항상 부드러움\"을 선택하면 깜빡임이 줄고 흐릿함이 증가합니다. 슈퍼 샘플링을 활성화하거나 높은 DPI 모니터를 사용하는 PC 사용자는 물론, 화면에서 멀리 떨어져 앉아 있는 1080p TV 사용자에게도 적합합니다.<br>- \"항상 날카로움\"를 선택하면 깜빡임이 늘어나고 흐릿함이 감소합니다. 노트북이나 스팀덱과 같이 1080p 미만 해상도를 사용하는 경우에 가장 적합한 옵션입니다.<br>- \"어댑티브 선명도\"를 선택하면 카메라가 정지 상태일 때 TAA 지터를 동적으로 비활성화합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 TAA가 앤티앨리어싱 솔루션으로 선택된 경우에만 사용할 수 있습니다."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "TAA의 루마 선명도 강도를 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 TAA가 앤티앨리어싱 솔루션으로 선택된 경우에만 사용할 수 있습니다."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "활성화하면 지도에서 먼 영역을 인위적으로 흐리게 하여 배경에 사실적인 초점 감소를 만들 수 있습니다."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "활성화하면 태양을 볼 때나 나무, 건물, 차량과 같은 물체를 통해 태양을 볼 때 광선이 보일 수 있습니다."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "활성화하면 게임의 색상이 미적 이유로 동적으로 조정됩니다. 장면은 시간 및 기상 조건과 더 잘 일치하며 차량 및 기타 물체의 색상은 더욱 생생해질 수 있습니다."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "더 나은 안티앨리어싱을 사용하는 것과 동시에 내부적으로 더 높은 품질로 반사를 렌더링하여 반사를 개선합니다.<br><br><color value=@@clr_txt_d@@>이 설정에 대한 변경 사항은 게임을 수동으로 다시 시작한 후에만 적용됩니다."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "차량 표면, 창문 및 웅덩이, 젖은 도로, 열린 수역과 같은 기타 반사 표면에 나타나는 반사의 세부 사항을 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다.<br><br>이 설정에 대한 변경 사항은 게임을 수동으로 다시 시작한 후에만 적용됩니다."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "식물과 나무의 디테일과 복잡성을 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "도로 가장자리에 보이는 잔디의 밀도를 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "태양이나 달이 드리우는 그림자의 품질을 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "아주 멀리 있는 물체에서도 그림자를 렌더링할 수 있습니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "차량 내부에 야간 동적 그림자를 적용합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "반사 등 날씨 효과의 품질을 조정합니다."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "차량 거울에 보이는 반사의 품질을 조정합니다(반사 설정과 무관).<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "차량 거울에 렌더링되는 이미지의 해상도를 조정합니다."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "거울에서 객체가 렌더링되기 시작하는 거리를 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 성능에 큰 영향을 미치는 경우가 많습니다."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "게임 내의 객체와 표면에 적용되는 일부 텍스처의 품질을 조정합니다."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "특히 멀리 있거나 비스듬한 각도에서 본 텍스처의 선명도를 향상시킵니다.<br><br><color value=@@clr_txt_d@@>이 설정을 변경하면 게임을 수동으로 다시 시작한 후에만 적용됩니다."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "포장, 도로 및 기타 개체에 기하학적 세부 사항 모양을 추가하여 모양을 향상시킵니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다.<br><br>이 설정에 대한 변경 사항은 게임을 수동으로 다시 시작한 후에만 적용됩니다."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "트래픽에 있는 차량의 전조등을 사용합니다."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "방향지시등, 브레이크 등 트래픽 차량의 보조 조명을 활성화합니다."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "인공 광원을 볼 수 있는 거리를 조정합니다.<br><br><color value=@@clr_txt_d@@>이 설정은 일반적으로 성능에 적당한 영향을 미칩니다."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "게임 세계에서 보행자를 활성화합니다."
