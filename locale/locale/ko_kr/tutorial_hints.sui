
    key[]: "hint_engine_title"
	val[]: "엔진 시동"

    key[]: "hint_engine_text"
	val[]: "엔진을 작동하려면 $KEY_engine$을(를) 사용하십시오."


    key[]: "hint_ignition_title"
	val[]: "점화장치 시작"

    key[]: "hint_ignition_text"
	val[]: "점화장치를 작동시키려면 $KEY_engineelect|KEY_engine$을(를) 누르십시오."


    key[]: "hint_driv_arc_title"
	val[]: "주행"

    key[]: "hint_driv_arc_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$와 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$을(를) 사용하여 전진 또는 후진하십시오.<br><offset vshift=8>$SPECIAL_steering$을(를) 사용하여 조향 하십시오."


    key[]: "hint_driv_auto_title"
	val[]: "주행"

    key[]: "hint_driv_auto_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$와 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$을(를) 사용하여 전진 또는 후진하십시오.<br><offset vshift=8>$SPECIAL_steering$을(를) 사용하여 조향 하십시오.<br><offset vshift=8>기어를 선택하려면 $KEY_gearup$ 키와 $KEY_geardown$ 키를 누르십시오."


    key[]: "hint_driv_seq_title"
	val[]: "주행"

    key[]: "hint_driv_seq_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$와 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$을(를) 사용하여 전진 또는 후진하십시오.<br><offset vshift=8>$SPECIAL_steering$을(를) 사용하여 조향 하십시오.<br><offset vshift=8>클러치 조작을 위해 $KEY_gearup$ 키와 $KEY_geardown$ 키를 누르십시오."


    key[]: "hint_driv_hshift_title"
	val[]: "주행"

    key[]: "hint_driv_hshift_text"
	val[]: "$KEY_aforward+ALIAS_j_throttle+KEY_dforward$와 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$을(를) 사용하여 전진 또는 후진하십시오.<br><offset vshift=8>$SPECIAL_steering$을(를) 사용하여 조향 하십시오.<br><offset vshift=8>기어를 <color value=@@clr_sel@@>시프터<color value=@clr_txt@@>로 변경하십시오."


    key[]: "hint_depot_deliv_title"
    val[]: "목적지에 접근하기"

    key[]: "hint_depot_deliv_text"
    val[]: "표시된 구역에 정차하여 최종 주차 구역의 난이도를 선택하고 해당 경험을 쌓으십시오."


    key[]: "hint_fin_deliv_title"
    val[]: "배송 완료"

    key[]: "hint_fin_deliv_text"
    val[]: "선택한 주차 공간에 주차하세요. 배송 지점 근처에서 $KEY_activate$을(를) 눌러 건너뛸 수 있습니다."


    key[]: "hint_fin_deliv2_title"
    val[]: "배송 완료"

    key[]: "hint_fin_deliv2_text"
    val[]: "선택한 주차 공간에 주차하세요. 주차 단계를 건너뛰려면 @@desktop_menu_category_options@@에서 위젯을 활성화할 수 있습니다."


    key[]: "hint_lights_title"
    val[]: "라이트 켜기"

    key[]: "hint_lights_text"
    val[]: "$KEY_light$ 키를 눌러 조명을 켜세요. 키를 반복해서 누르면 다양한 모드로 전환됩니다."


    key[]: "hint_high_beam_title"
    val[]: "상향등 켜기"

    key[]: "hint_high_beam_text"
    val[]: "$KEY_hblight$을(를) 사용하여 상향등 켜십시오."


    key[]: "hint_wipers_title"
    val[]: "와이퍼 켜기"

    key[]: "hint_wipers_text"
    val[]: "와이퍼를 켜고 다양한 속도 설정을 반복하려면 $KEY_wipers$을(를) 사용하십시오."


    key[]: "hint_zoom_title"
    val[]: "자세히 보기"

    key[]: "hint_zoom_text"
    val[]: "운전석에서 확대하려면 $KEY_camzoom$키를 사용하세요. 줌 모드를 유지 또는 전환하도록 @@desktop_menu_category_options@@에서 설정할 수 있습니다."


    key[]: "hint_cam_int_title"
    val[]: "둘러보기"

    key[]: "hint_cam_int_text"
    val[]: "$KEY_cam1$을(를) 사용하여 카메라를 인테리어 시점으로 변경하십시오."


    key[]: "hint_cam_ext_title"
    val[]: "둘러보기"

    key[]: "hint_cam_ext_text"
    val[]: "$KEY_camcycle$ 키를 눌러 다양한 카메라 각도를 순환할 수 있습니다.<br><offset vshift=8>$KEY_cam2$ 키를 눌러 외부 시점으로 전환하십시오."


    key[]: "hint_indicators_title"
    val[]: "계기"

    key[]: "hint_indicators_text"
    val[]: "방향지시등을 켜려면 $KEY_lblinker$와 $KEY_rblinker$을(를) 사용하십시오."


    key[]: "hint_tow_title"
    val[]: "견인 서비스"

    key[]: "hint_tow_text"
    val[]: "어려운 상황에서 벗어나지 못하면 견인 서비스를 이용할 수 있습니다. 접근하려면 $KEY_advmouse$을(를) 사용하여 @@quick_info_word@ 메뉴를 엽니다."


    key[]: "hint_diff_lock_title"
    val[]: "차동기어 잠금"

    key[]: "hint_diff_lock_text"
    val[]: "이동할 수 없다면 차동기어 잠금이 도움이 될 수 있습니다. $KEY_diflock$을(를) 사용하여 켜거나 @@desktop_menu_category_options@에서 차동기어 잠금을 켜십시오."


    key[]: "hint_diff_unlock_title"
    val[]: "차동기어 잠금 작동"

    key[]: "hint_diff_unlock_text"
    val[]: "일반 운전 중에 차동기어 잠금을 해제하지 않으면 손상될 위험이 있습니다. $KEY_diflock$을(를) 사용하여 끄거나 @@desktop_menu_category_options@에서 자동 차동기어 잠금을 켜십시오."


    key[]: "hint_wipers_off_title"
    val[]: "와이퍼 끄기"

    key[]: "hint_wipers_off_text"
    val[]: "와이퍼를 끄고 다양한 속도 설정을 반복하려면 $KEY_wipers$을(를) 사용하십시오."


    key[]: "hint_world_map_title"
    val[]: "맵 뷰"

    key[]: "hint_world_map_text"
    val[]: "월드 맵을 열려면 $KEY_navmap$을(를) 사용하십시오."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "$KEY_advmouse$ 키를 눌러 @@quick_info_word@@를 열면 편리한 단축키로 현재 상태를 한눈에 볼 수 있습니다."


    key[]: "hint_pause_border_title"
    val[]: "현지 규정"

    key[]: "hint_pause_border_text"
    val[]: "$KEY_advmouse$을(를) 사용하여 @@quick_info_word@를 열고 접속한 지역에 대한 현지 규정을 확인하십시오."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "$KEY_advmouse$를 사용하여 @@quick_info_word@@를 열고 @@photo_mode_word@@로 들어가 근처의 @@landmark_word@@를 캡처하십시오. <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ 근처"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> 근처에 있으니 찾아서 활성화하면 컷신을 볼 수 있습니다."


    key[]: "hint_resting_title"
    val[]: "근처 휴식 공간"

    key[]: "hint_resting_text"
    val[]: "휴식 공간 <img src=/material/ui/map/parking_ico.mat width=20 height=20>은 피로를 회복하고 의무 휴식을 취하여 안전하게 여정을 계속할 수 있도록 도와줍니다."


    key[]: "hint_gas_title"
    val[]: "근처 주유소"

    key[]: "hint_gas_text"
    val[]: "주유소 <img src=/material/ui/map/gas_ico.mat width=20 height=20> 차량에 주유하는 데 사용할 수 있습니다."
