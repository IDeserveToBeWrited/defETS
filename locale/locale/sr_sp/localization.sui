	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Podešava postepeno povećanje brzine."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Podešava koliko morate da okrećete glavu pre nego što ubrzanje počne da se smanjuje."

	key[]: "eye_head_start_point_op_tooltip"
