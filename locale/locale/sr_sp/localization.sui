#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Bira podtip kontrolera za igru da bi pravilno upravljao opsegom unosa."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Bira tip menjača:<br>- „Jednostavan automatski“ vam omogućava da koristite gas i kočnicu za kontrolu kretanja napred i nazad.<br>- „Pravi automatik“ zahteva unos za prebacivanje između napred i nazad.<br>- „Sekvencijalni“ zahteva ručno prebacivanje svih brzina pomoću tastera za pomeranje gore / dole.<br>- „H-Prebacivač“ zahteva upotrebu kontrolera sa menjačima za ručni izbor brzina."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Menja logiku promene stepena prenosa u automatskom menjaču:<br>-Režim „Ekonomija“ preferira niže obrtaje u minuti u pravcu maksimalnog obrtnog momenta.<br>- Režim „Snaga“ će biti usmeren ka vršnoj konjskoj snazi za bolje performanse vožnje sa teškim teretom ili planinskim terenom na račun uštede goriva."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Podešava odnos stepena rotacije uređaja prema stvarnom stepenu rotacije upravljača vozila."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Podešava linearnost između ulaza i upravljanja vozilom.<br><br>Podešavanje ove vrednosti više znači da će upravljanje manje reagovati kada je točak u sredini, i povećaće osetljivost kako se točak okreće ka maksimalnom zaključavanju. Ovo može biti od pomoći za izglađivanje uticaja upravljača kada vozite pravo."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Omogućava prinudnu povratnu informaciju u kontrolerima koji to podržavaju."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Podešava ukupni dobitak za sve postavke povratne sprege između 0N i 10N.<br><br><color value=@@clr_txt_d@@>Imajte na umu da podešavanje na veću postavku u snažnim međuosovinskim razmacima može dovesti do povrede prstiju ili šaka."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Podešava silu centriranja kada vozite velikom brzinom, koja dostiže vrhunac od 90 km/h (56 mph) i više.<br><br>Minimalno podešavanje će dovesti do toga da nema sile centriranja točka."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Podešava silu centriranja kada vozite malom brzinom.<br><br>Minimalna postavka neće rezultirati silom centriranja točka."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Podešava jačinu veštačkog unutrašnjeg trenja izazvanog mehaničkim komponentama upravljača."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Podešava jačinu veštačke rezonancije motora kroz stub upravljača.<br><br><color value=@@clr_txt_d@@>Imajte na umu da podešavanje ove vrednosti preko 15% može izazvati preterano podrhtavanje i vibracije na nekim volanima."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Podešava jačinu efekata površine puta preko stuba upravljača.<br><br><color value=@@clr_txt_d@@>Imajte na umu da podešavanje ove vrednosti preko 20% može izazvati preterano podrhtavanje i vibracije na nekim volanima kada vozite po neravnom terenu velikom brzinom."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Podešava jačinu efekata neravnina na putu kroz stub upravljača."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Podešava jačinu efekata sudara kroz stub upravljača."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Podešava intenzitet efekata oštrenja menjača."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Podešava intenzitet efekata podupravljanja."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Podešava intenzitet potpomognutog upravljanja (kada koristite funkciju pomoćnika u traci itd.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Podešava intenzitet vibracija površine terena, ako kontroler podržava povratne informacije vibracijama."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Podešava intenzitet udarnih vibracija, ako kontroler podržava povratne informacije vibracijama."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Podešava intenzitet vibracija prilikom sudara, ako kontroler podržava povratne informacije vibracijama."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa uređaja koja se koristi za upravljanje."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Podešava mrtvu zonu ose upravljača; količina rotacije od centra pri čemu se unos ignoriše.<br><br>Ovo može ublažiti probleme starijih kontrolera, kao što su nepreciznost ili lažni unos uzrokovan habanjem."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Određuje kako igra upravlja unosom ose upravljača:<br>- Centrirano je idealno za volane ili džojstike.<br>- Obrnuto se koristi za ispravljanje ose koja je pogrešno otkrivena."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa uređaja koja se koristi za ubrzanje vozila."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Podešava mrtvu zonu ose ubrzanja; iznos ulaznog putovanja pri čemu nije registrovan unos.<br><br>Ovo može ublažiti probleme starijih kontrolera, kao što su nepreciznost ili lažni unos prouzrukovan habanjem."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Određuje kako igra upravlja unosom kontrolera.<br>- Centrirano je idealno za džojstike.<br>- Normal je idealan za okidače ili pedale.<br>- Obrnuto može kompenzovati ulaze koji su pogrešno detektovani."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa uređaja koja se koristi za kočenje."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Podešava mrtvu zonu ose kočnice; iznos ulaznog putovanja pri čemu nije registrovan unos.<br><br>Ovo može ublažiti probleme starijih kontrolera, kao što su nepreciznost ili lažni unos prouzrukovan habanjem."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Određuje kako igra upravlja unosom kontrolera.<br>- Centrirano je idealno za džojstike.<br>- Normal je idealan za okidače ili pedale.<br>- Obrnuto može kompenzovati ulaze koji su pogrešno detektovani."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa uređaja koja se koristi za aktiviranje kvačila."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Podešava mrtvu zonu osovine kvačila; iznos ulaznog putovanja pri čemu nije registrovan unos.<br><br>Ovo može ublažiti probleme starijih kontrolera, kao što su nepreciznost ili lažni unos uzrokovan habanjem."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Određuje kako igra upravlja unosom kontrolera:<br>- Centrirano je idealno za džojstike.<br>- Normal je idealan za okidače ili pedale.<br>- Obrnuto može kompenzovati ulaze koji su pogrešno detektovani."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Podešava opseg kvačila.<br><br>Što dalje udesno podešen opseg, to ćete više morati da pritiskate pedalu da biste uključili kvačilo."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa uređaja koja se koristi za naginjanje kamere gore i dole."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Podešava mrtvu zonu ose Pogled gore-dole; iznos ulaznog putovanja pri čemu nije registrovan unos.<br><br>Ovo može ublažiti probleme starijih kontrolera, kao što su nepreciznost ili lažni unos prouzrukovan habanjem."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Određuje kako igra rukuje unosom osovine:<br>- Centrirano je idealno za džojstike.<br>- Obrnuto se koristi za ispravljanje ose koja je pogrešno otkrivena."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa uređaja koja se koristi za pomeranje kamere levo i desno."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Podešava mrtvu zonu Pogleda levo-desno; iznos ulaznog putovanja pri čemu nije registrovan unos.<br><br>Ovo može ublažiti probleme starijih kontrolera, kao što su nepreciznost ili lažni unos prouzrukovan habanjem."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Određuje kako igra rukuje unosom osovine:<br>- Centrirano je idealno za džojstike.<br>- Obrnuto se koristi za ispravljanje ose koja je pogrešno otkrivena."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Bira raspored stepena prenosa koji će se koristiti sa H-Menjač."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Menja ponašanje menjača:<br>- Sa opcijom „Jednostavno“ nikada nećete brusiti zupčanike pri menjanju brzina.<br>- Opcija „Jednostavan + zvuk upozorenja“ će vam omogućiti da menjate jednostavno, ali uz zvuke brušenja zupčanika kada menjate pogrešno.<br>- Opcija \"Napredno\" vam neće dozvoliti da menjate brzine ako pogrešno menjate, a dočekaće vas samo zvuci brušenja zupčanika. Opcija \"Napredno\" vam takođe omogućava da koristite postavku \"brzo prebacivanje brzina\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Odaberite način na koji igra upravlja brzim deljenjem brzina:<br>- „Nikad“ neće zahtevati da se ručica menjača pomeri u neutralni položaj između podela.<br>- „Pritisak kvačila“ zahteva trenutno pritiskanje kvačila bez pomeranja ručice menjača.<br>- „Opuštanje gasa“ zahteva od vozača da samo otpusti ručicu gasa da bi podelio brzine bez kretanje ručice menjača, i „kvačilo ili gas“ je kombinacija poslednja dva."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje položaj menjača."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje položaj menjača."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje položaj menjača."

