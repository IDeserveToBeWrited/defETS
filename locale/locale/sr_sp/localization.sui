#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "WORLD OF TRUCKS SPOJENI SADRŽAJ" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Poveži se" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Izlistaj" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "GENERALNA PODEŠAVANjA" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "SPOJ SADRŽAJE" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Poveži se" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks je primetio nove sadržaje. Povežite se sa World of Trucks servisom da to iskoristite." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Onlajn" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Onlajn podešavanja. Podesite World of Trucks do detalja." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Da li zaista želite da odložite registraciju?<br><br>Kasnije koristite Online Connect Content dijalog iz Online Options, lociranim na desktopu." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "SPAJANjE SADRŽAJA" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Spajanje sadržaja.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Nije uspela operacija povezivanja sa: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam nalog koji ste koristili da registrujete ovaj DLC je različit od onog koji je korišćen da se načini World Of Trucks nalog ili registruje igra. Molimo zamenite nalog i pokušajte ponovo." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam nalog koji ste koristili da registrujete ovaj DLC je već povezan sa drugim World Of Trucks nalogom. Dabiste registrovali DLC na trenutni nalog morate da da imate steam nalog koji nije povezan sa World Of Trucks nalogom." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token je istekao. Molimo, probajte ponovo kasnije." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Serijski broj koji koristite za aktivaciju DLC-a je nevažeći. Kontaktirajte podršku na: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Interna greška se pojavila tokom registracije igre. Molimo, pokušajte kasnije opet." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "USPEŠNO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLAJN" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "PREGLED SADRŽAJA" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Čestitamo! Izabrani DLC-ovi su uspešno povezani sa vašim World Of Trucks nalogom." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Ne mogu da povežem sadržaje jer je trenutni Steam nalog povezan sa drugim World Of Trucks nalogom." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Neki DLC-ovi se nisu povezali.<br>Pređite mišem preko uskličnika da vidite više detalja." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrujem $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Trenutni profil nije povezan sa Svet Кmiona ili igra radi u oflajn režimu. Uredite profil da biste se povezali." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Kliknite za odbacivanje"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ trenutno povezani kompatibilni DLC-ovi. Ako neki DLC nije povezan na World Of Trucks, nedostajaće mnogo toga što je u njemu." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Čestitamo! <color value=@@clr_txt@@>Sav vaš sadržaj je povezan sa World of Trucks! Sad navalite na pogodnosti." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Ne mogu da povežem sadržaje sa World Of Trucks jer se trenutni Steam nalog ne slaže sa onim koji koristi World Of Trucks nalog." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Povezan" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nepovezan" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Ne mogu da dobavim informaciju o posedovanom sadržaju." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Ne mogu da dobavim informaciju o povezanom sadržaju." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Ne mogu da dobavim informaciju o trenutno korišćenom nalogu." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Kasnije" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Ne mogu da registrujem ovaj DLC. Nije pronađena stalna licenca moguće zbog deljenja Steam naloga." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Nije stalno vlasništvo" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Misija Specijalni Transport je završena!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISIJA NIJE USPELA!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Odustani"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Učitaj kontrolnu tačku"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Oštetio si vozilo pratnje!<br> Možete učitati kontrolnu tačku ili otkazati isporuku kaznom od $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Vozilo pratnje je sudareno od strane drugih zbog neispravne vožnje. <br> Možete učitati kontrolnu tačku ili otkazati isporuku kaznom od $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Trebali ste da pratite rutu. <br> Možete učitati kontrolnu tačku ili otkazati isporuku kaznom od $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Trebali ste da ostanete sa pratećim vozilom. <br> Možete učitati kontrolnu tačku ili otkazati isporuku kaznom od $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Odvezli ste se od vozila pratnje!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Oštetili ste vozilo za pratnju!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Vozilo pratnje je sudareno!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Odvezli ste se sa rute!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimenzije"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Posebna Transportna Isporuka"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Molimo držite teret između vozila pratnje."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Posebna isporuka"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimenzije"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Poseban transport"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Molim vas, usporite kako ne biste udarili u prateće vozilo..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Molimo pričekajte zadnje vozilo pratnje..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Pažljivo molimo, dolazi veoma uzak deo rute..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Dolazi promena manevra u traci. Prilagodite brzinu kako biste izbegli mogućnost sudara..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Prednje vozilo pratnje ide upozoriti druge vozače... <br> Prilagodite brzinu kako biste izbjegli mogući sudar..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Vozila za pratnju čekaju vas na raskrsnici u blizini. Molimo sledite rutu."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Pazi!<br>Voziš unazad prema zadnjem vozilu pratnje!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Pazi! <br> Voziš veoma blizu prema zadnjem vozilu pratnje!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Molimo pritisnite taster da pogledate Posebnu ponudu poslova:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Posebne ponude posla:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Upravo ćete prevesti teret Specijalnog transporta! Postoje dva vozila za pratnju koja će vas voditi. Molimo vas da budete oprezni i pratite njihova uputstva i obaveštenja o predlozima. Specijalni transporti poput ovog se ne zaustavljaju na crvenom semaforu i imaju prvenstvo prolaza u većini situacija. Tokom ovih isporuka, kontrolne tačke se postavljaju češće kako bi se sačuvao vaš trenutni napredak."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Obrati dodatnu pažnju na sledeće:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Izbegavajte bilo kakav konflikt sa vozilima pratnje i držite rastojanje između njih."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ne vozite se od procenjene rute, ni do benzinskih stanica, ni ti stanica za odmor i sl."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Poštuj ograničenja brzine koje će osigurati prednje vozilo pratnje."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Pazite na saobraćaj koji pretiče i ostale vožače na putu."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Promijeni manevar trake:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Ako nebudete pratili ova pravila, vaša misija Poseban Transport može propasti!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manevar počinje kada<color value=@@clr_sel@@>zadnje<color value=@@clr_txt@@>vozilo pratnje počne sa promenom & blokiranjem određene trake."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>prednje<color value=@@clr_txt@@>vozilo pratnje čeka sve dok određena traka nije čista, a zatim menja traku."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Sada je sigurno za <color value=@@clr_sel@@>igrača<color value=@@clr_txt@@> da se prebaci u označenu traku."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Rezervoar kamiona je napunjen i časovi vožnje su vraćeni."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Ne možete pozvati pomoć tokom Posebne Transportne misije."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Ne možete koristiti trajekt u toku Posebne Transportne misije."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Odmarate se...<br>Rezervoari kamiona se pune..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Približava se obaveznom zaustavljanju.<br>Pratite pratnju do parking mesta da se odmorite!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Obavezno zaustavljanje"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Pritisnite sledeći taster da se odmorite i dopunite gorivo:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Greška je nastala pri učitavanju sadržaja Steam inventara.<br><br>$ERROR$<br><br>Select nastavite da bi zadržali sadržaj uključenim. Igra će nastaviti tražiti sadržaj povremeno..<br><br>Isključite trenutno sadržaj da bi poruke kao ove zadržali od ponovnog pojavljivanja. Igra će ponovno uključiti sadražaj sledeći put kad je pokrenete." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Ne mogu da preuzmem stavke sa Steam inventara." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTAR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Učitavanje stavki Steam inventara..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOVI DELOVI INVENTARA" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Primećen novi sadržaj Steam inventara." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Dodaci za vozilo" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Kabinski pribor" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Desktop pozadina" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Farba" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Onemogući Inventar" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Pokušaj ponovo kasnije" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
