#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Neophodni DLC (zvanično proširenje igre) $DEPENDENCY_NAME$ nedostaje. Da bi ovaj snimak radio korektno, ovaj DLC mora biti prisutan i aktiviran na ovom računaru. Morate to da popravite pre nego učitate ovaj snimak." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Opcioni DLC (zvanično proširenje igre) $DEPENDENCY_NAME$ nedostaje. Ako je ovo neočekivano, proverite stanje tog DLC.<br><br>U suprotnom, probajte da učitate igru, ali očekujte da mnogo toga neće raditi, a što je dosada radilo." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Mod $DEPENDENCY_NAME$ nedostaje ili je isključen. Ako ovo ne očekujete, proverite stanje tog moda. Probajte da učitate snimak svejedno. Ipak, očekujte da, u zavisnosti šta je mod radio, igra odbije da se učita ili izazove druge probleme." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Mod $DEPENDENCY_NAME$ je nekompatibilan sa ovom verzijom igre. To znači da je autor moda označio taj mod kao kompatibilan samo sa određenom verzijom igre, a to nije ova.<br><br>Rešenja:<br>- Pokušajte da nađete noviju verziju moda koja radi sa ovom verzijom igre.<br>- Nađite verziju igre koja je kompatibilna sa tim modom.<br><br>Možete probati da učitate ovaj snimak, naravno. Kakogod, mod neće biti učitan i u zavisnosti šta je mod radio, moguće je da učitavanje ne uspe ili imate drugih problema u igri." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "NEDOSTAJUĆE ZAVISNOSTI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETALjI" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Otvori stranicu workshop"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Ovaj snimak zavisi od DLC ili moda koji trenutno nedostaju. Izlistani su ispod. Ako izaberete stavku na listi, dobićete više informacija o problemu." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Ovaj snimak zavisi od najmanje jednog zahtevanog DLC ili moda. Morate da to popravite pre nego što učitate ovaj snimak." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Prekini učitavanje" #+ Abort loading button.

	key[]: "type"
	val[]: "Tip" #+ Type column.

	key[]: "dependency_name"
	val[]: "Ime zavisnosti" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokalni mod" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Mod iz Workshopa" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Opcioni DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Zahtevani DLC" #+ DLC that is required to load save that is depending on it.
