#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafika" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Prilagodite podešavanja grafike koristeći fino podešena unapred podešena podešavanja da biste prilagodili vizuelne performanse igre po svom ukusu."

	key[]: "apply"
	val[]: "Primeniti" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Desktop tema" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "PRIKAZ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "KVALITET SLIKE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEKSTURE" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKSIJE" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SENKE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "OSVETLJENJE" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "NAKNADNA OBRADA" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "OKRUŽENJE" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Preko celog ekrana" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Osvetljenost / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Podesi" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Rezolucija" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Frekvencija osveženja" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS limit" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS limit pozadine" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Fabrička vrednost" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Herc" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikalna sinhronizacija" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomično (čuva baterije na laptopovima)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "JEDNOSTAVNA GRAFIČKA PODEŠAVANJA" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "LIČNA PODEŠAVANJA PRIMENJENA" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "NAPREDNA GRAFIČKA PODEŠAVANJA" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Jednostavna/napredna grafička podešavanja" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Sakrijte napredne postavke" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Prikaži napredne postavke" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Razmera" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma izoštravanja" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA podešavanje" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Prilagodljiva jasnoća" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Uvek mekana" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Uvek oštar" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Ekransko apsorbovanje okolnog prostora (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Izražene boje i kontrast (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Dubina oblasti (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Sunčevi zraci" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Popravka boja" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Skaliranje refleksije" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detalji odbljesaka" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detaljnost vegetacije" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Gustina trave" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Kvalitet senki"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Veličina teksture senki" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Daleke senke" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Unutrašnje senke" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Kvalitet vremenskih uslova"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Kvalitet ogledala" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Rezolucija ogledala" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Domet ogledala" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Kvalitet tekstura" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropsko filtriranje" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Obično mapiranje" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Svetla saobraćaja" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Pomoćna svetla na vozilu" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Domet svetala" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Pešaci" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Podešavanja prikaza su promenjena.<br>Da li želite da ostanu ovakva?"

	key[]: "reverting_in"
	val[]: "Vraćanje za" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekunde" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Kada je omogućena, igra će biti prikazana na celom ekranu."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Podesite ukupnu osvetljenost igre tako da odgovara vašem ekranu. Na HDR-kompatibilnim ekranima, opcija HDR kalibracije će takođe biti dostupna u ovom podešavanju."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Menja rezoluciju igre."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Menja ciljnu brzinu osvežavanja igre."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Usklađuje brzinu kadrova sa brzinom osvežavanja monitora kako bi se sprečilo cepanje slike. Ekonomsko podešavanje takođe prepolovljuje brzinu kadrova, što rezultira manjom potrošnjom energije."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Postavlja maksimalnu dozvoljenu brzinu kadrova za igru.<br><br>Postavljanje vrednosti na 0 će onemogućiti funkciju."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Postavlja maksimalnu dozvoljenu brzinu kadrova za igru kada je minimizirana u pozadini.<br><br>Postavljanje vrednosti na 0 će onemogućiti funkciju."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Promene između jednostavnih grafičkih podešavanja (preset) ili naprednih grafičkih podešavanja (mogućnost promene pojedinačnih parametara)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Poboljšava grafičku vernost renderovanjem igre u višoj rezoluciji interno, što smanjuje nazubljene ivice i poboljšava detalje.<br>Na primer, izbor veće opcije skaliranja rezultira jasnijom slikom sa manje zamućenja, što čini da igra izgleda bolje u celini, ali na štetu performansi.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje često ima veliki uticaj na performanse."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Izbor metoda za brzo antialijasing koje uglađuju izgled nazubljenih ivica u igri:<br>- SMAA uzorkuje svaki piksel više puta (u zavisnosti od izabranog kvaliteta) na različitim lokacijama u okviru i usredsređuje uzorke da bi proizveo konačnu sliku.<br>- TAA uzorkuje svaki piksel samo jednom po kadru, ali ih uzorkuje na različitim lokacijama i različitim kadrovima.<br>- Za najbolji rezultat takođe možete odabrati kombinaciju oba nauštrb performansi.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje meke senke pukotinama i objektima koji su u neposrednoj blizini jedan drugog, poboljšavajući percipiranu grafičku vernost celog sveta u igri.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Izbor TAA podešavanja:<br>- „Uvek meko“ će rezultirati manjim treperenjem/većim zamućenjem – pogodno je za korisnike računara koji omogućavaju supersampliranje ili imaju monitor sa visokom DPI rezolucijom, ali i za korisnike 1080p televizora koji sede dalje od ekrana.<br>-„Uvek oštar“ dovodi do više treperenja/manje zamućenja – verovatno je najbolja opcija za upotrebu ispod 1080p, kao što su laptopovi ili Steam Deck.<br>- „Adaptivna jasnoća“ dinamički onemogućava podrhtavanje TAA kada je kamera statična.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje se može koristiti samo kada je TAA izabran kao rešenje za anti-aliasing."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava jačinu TAA oštrinu luma.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje se može koristiti samo kada je TAA izabran kao rešenje za anti-aliasing."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Kada je omogućeno, udaljene oblasti na mapi mogu biti veštački zamagljene da bi se stvorio realističan pad fokusa u pozadini."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Kada je omogućeno, zraci svetlosti mogu biti vidljivi kada gledate u sunce ili gledate u sunce kroz objekte kao što su drveće, zgrade ili vozila."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Kada je omogućeno, boje igre se dinamički prilagođavaju iz estetskih razloga. Scene će bolje odgovarati dobu dana i vremenskim uslovima, boje vozila i drugih objekata mogu biti življe itd."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Poboljšava refleksije tako što ih interno prikazuje višeg kvaliteta, kao i korišćenjem boljeg antialiasinga.<br><br><color value=@@clr_txt_d@@>Promene ovog podešavanja će stupiti na snagu tek nakon ručnog ponovnog pokretanja igre."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava detalje refleksija koje se vide na površinama vozila, prozorima i drugim reflektujućim površinama kao što su lokve, mokri putevi i otvorene vodene površine.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse.<br><br>Promene ovog podešavanja će stupiti na snagu tek nakon ručnog ponovnog pokretanja igre."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagođava detalje i složenost biljaka i drveća.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava gustinu trave koja se vidi sa strane puta.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava kvalitet senki od sunca ili meseca.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućava prikaz senki čak i sa veoma udaljenih objekata.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućuje noćne dinamičke senke u unutrašnjosti kamiona.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava kvalitet vremenskih efekata, kao što su refleksije."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava kvalitet refleksije u retrovizorima vozila (nezavisno od podešavanja refleksije).<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava rezoluciju slike prikazane na retrovizorima vašeg vozila."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava rastojanje na kojem objekti počinju da se prikazuju u retrovizoru.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje često ima veliki uticaj na performanse."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava kvalitet nekih tekstura primenjenih na objekte i površine u igri."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Poboljšava oštrinu tekstura, posebno onih koje se gledaju na daljinu ili pod kosim uglom.<br><br><color value=@@clr_txt_d@@>Promene ovog podešavanja će stupiti na snagu tek nakon ručnog ponovnog pokretanja igre."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Dodaje izgled geometrijskih detalja trotoarima, putevima i drugim objektima kako bi poboljšao njihov izgled.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse.<br><br>Promene ovog podešavanja će stupiti na snagu tek nakon ručnog ponovnog pokretanja igre."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućava osvetljenje od farova drugih vozila u saobraćaju."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućava osvetljenje od sekundarnih svetala drugih vozila u saobraćaju kao što su pokazivači, kočnice itd."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Podešava udaljenost sa koje se mogu videti izvori veštačkog svetla.<br><br><color value=@@clr_txt_d@@>Ovo podešavanje obično ima umeren uticaj na performanse."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Omogućava pešake u svetu igre."
