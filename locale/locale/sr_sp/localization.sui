	val[]: "Vozilo ima značajne mehaničke probleme koji utiču na performanse i pouzdanost. Možda ćete morati da razmotrite potpunu restauraciju ili zamenu više delova." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "Vozilo pokazuje mehaničke probleme koji bi mogli da ugroze njegove performanse ili pouzdanost. Potreban je servis." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
