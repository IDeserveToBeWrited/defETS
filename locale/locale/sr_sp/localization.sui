#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "UČITAJ IGRU"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Učitaj igru" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Učitaj prethodno snimljenu igru. Trenutni napredak će biti izgubljen!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Jeste li sigurni da to želite?<br><br>Ako ga niste prethodno sačuvali, vaš trenutni napredak će biti izgubljen."

	key[]: "load_progress_lost_mp"
	val[]: "Da li ste sigurni da želite da učitate drugu igru?<br>Ako to uradite u igri za više igrača, može doći do otkazivanja ili suspenzije posla, teleportacije do najbliže službe ili nedostupnosti izabranog posla.<br><br>Vaš trenutni napredak će biti izgubljen osim ako se ranije ne sačuva."

	key[]: "load_game_mp_suspended_job"
	val[]: "Sačuvano je uspešno učitano, ali vaš aktivni posao Svet Kamiona je suspendovan i nedostupan dok ste u ovoj sesiji."

	key[]: "autosave"
	val[]: "- Automatski snimi-" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Brzo snimanje -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Prikaži automatska čuvanja" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Nije pronađen ručno sačuvan." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Učitaj" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Nekompatibilan snimak!<br><color value=@@clr_txt@@>Pokušajte da ažurirate igru na najnoviju verziju." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nije uspelo učitavanje i prikazivanje svih sačuvanih datoteka za ovaj profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "PAŽNJA" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problem sa učitavanjem snimka.<color value=@@clr_txt@@><br><br>Ovaj snimak nije učitan. Možete pokušati da utvrdite problem koristeći informaciju ispod, ili učitati neki drugi snimak.<br><br>Sledeći razlozi najčešće uzrokuju probleme:<br><br>1. Snimak je nekompatibilan sa nekom od instaliranih MOD(a).<br><br>2. Snimak sadrži informacije iz MOD(a) koje nedostaju ili su isključene.<br><br>3. Snimak je uništen zbog korišćenja loše MOD.<br><br>4. Pad sistema tokom ili kratko nakon snimanja može uništiti snimak."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Nedostaje MOD.<color value=@@clr_txt@@><br><br>Poslednji snimak sadrži referencu ka nedostajućem ili isključenom MOD(a).<br><br>Ako je ovo neočekivano, proverite stanje MOD(a).<br><br>Svejedno, možete probati da učitate snimak. U zavisnosti šta je MOD(a) radio, moguće je da neće uspeti da se učita ili izazove druge probleme.<br><br>Ili probajte da učitate drugi snimak, koji ne zavisi od nedostajućih MOD(a)."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Nedostaje vam DLC.<color value=@@clr_txt@@><br><br>Posljednji snimak sadrži DLC (zvanično proširenje igre).<br><br>Ako ovo niste očekivali, molimo proverite stanje DLC(a).<br><br>Iako možete učitati snimak, neke opcije koje su u DLC(u) će biti izgubljene.<br><br>Ili učitajte snimak koji ne zavisi od DLC(a)."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Nedostaje DLC!<color value=@@clr_txt@@><br><br>Poslednji snimak sadrži reference ka DLC-u (zvaničnom proširenju igre).<br><br>Da bi ovaj snimak bio upotrebljiv, DLC mora biti prisutan i aktiviran.<br><br>Ili učitajte drugi snimak, koji ne zavisi od nedostajućeg DLC-a."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MOD zavisi od DLC sadržaja.<color value=@@clr_txt@@><br><br>Najmanje jedan MOD zavisi od DLC (zvanične ekspanzije) koji trenutno nije instaliran.<br><br>Isključite MOD(ove) ili instalirajte DLC(ove) od kojih zavise."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Pad igre<color value=@@clr_txt@@><br><br>Izgleda da je igra pala prilikom prethodnog učitavanja.<br><br>Možete pokušati da utvrdite problem koristeći informaciju ispod ili učitati neki drugi snimak.<br><br>Sledeći razlozi najčešće uzrokuju probleme:<br><br>1. Jedna ili više MOD su oštećene ili nekompatiabilne sa ovom verzijom igre.<br><br>2. Snimak sadrži informacije iz MOD(a) koje nedostaju ili su isključene.<br><br>3. Snimak je uništen zbog korišćenja lošeg MOD.<br><br>4. U nekim slučajevima, greške u drajverima i/ili hardveru mogu oboriti igru."

	key[]: "mods_detected_warning"
	val[]: "Primećeno prisustvo modova. Nadamo se da već znate da su loši, zastareli ili nekompatibilni modovi izvor nestabilnosti. Pregledajte ponovo vaše aktivne modove u menadžeru." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

