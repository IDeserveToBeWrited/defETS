	val[]: "Dodeljuje položaj menjača."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje položaj menjača."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje položaj menjača."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje ulaz koji se koristi za prebacivanje između opsega na osnovu rasporeda menjača."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Dodeljuje dugme za prebacivanje razdelnika menjača na osnovu rasporeda menjača."

