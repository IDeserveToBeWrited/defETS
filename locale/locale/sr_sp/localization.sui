#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Nastavi ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Dobrodošli u Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Najzad imate priliku da ostvarite vaš životni san - vožnju kamiona!"

	key[]: "intro_3"
	val[]: "Vaše prevozničko preduzeće je spremno za posao, ali nemate para da kupite kamion. Za sada ćete morati da radite za druge, kao unajmljeni vozač."

	key[]: "intro_4"
	val[]: "Vaš zadatak je da isporučite teret $JOB_CARGO$ na $JOB_TARGET_COMPANY$ stovarište u $JOB_TARGET_CITY$. Vaš poslodavac vam je obezbedio vozilo i pokriva sve troškove. Ispunite očekivanja i stignite na vreme."


	key[]: "intro_garage_1"
	val[]: "Ovo su vaše kancelarije."

	key[]: "intro_garage_2"
	val[]: "Ovo je vrlo mala garaža. Nije ništa posebno, ali je dobra za početak."

	key[]: "intro_garage_3"
	val[]: "Nažalost, nemate ništa što bi parkirali tu, pa nema ni kamiona na vidiku."

	key[]: "intro_garage_4"
	val[]: "Jednom kada zaradite dovoljno para i kupite kamion, moći ćete da se slobodno krećete po svetu i vodite sopstveni posao."

	key[]: "intro_garage_5"
	val[]: "Srećno!"


	key[]: "desktop_tut_t"
	val[]: "FUNKCIJA OTKLJUČANA"

	key[]: "desktop_tut_job"
	val[]: "Preuzmite vaš sledeći posao"

	key[]: "desktop_tut_cargo_market"
	val[]: "Koristite svoju potpuno novu prikolicu kako biste pristupili Berzi Tereta da isporučite širok asortiman tereta do njihovih destinacija." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Ovde možete videti vaš napredak."

	key[]: "desktop_tut_company"
	val[]: "Pazite na vaše garaže, unajmljujte vozače i upravljajte vašim preduzećem."

	key[]: "desktop_tut_trailers"
	val[]: "Od sada pa nadalje možete kupiti sopstvene prikolice i nadograditi ih ili ih ofarbati te prilagoditi vašem kamionu.<br><br>Vaše prikolice mogu biti uskladištene u izabranoj garaži(e); te mogu ih koristiti vaši vozači da povećaju profit. Da biste upravljali svojim prikolicama, koristite Menadzer prikolica."

	key[]: "desktop_tut_visit_directive"
	val[]: "Posetite $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "DOBRODOŠLI"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Dobrodošli na novi početni ekran<br>Odavde možete komunicirati sa svim funkcijama igre."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "U nastavku, Glavni meni pruža direktan pristup svim osnovnim funkcijama igre koje su vam poznate."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Na vrhu, nova statusna traka pruža stalnu vidljivost korisnih statistika profila igrača i lokalnih putnih propisa."

	key[]: "desktop_tut_tour_home"
	val[]: "Dugme Početna je uvek tu da vas vrati na početni ekran."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Stalni brzi meni pruža zgodan pristup prečicama svim funkcijama igre sa bilo kog ekrana."

	key[]: "desktop_tut_tour_drive"
	val[]: "Ažurirano dugme za vožnju ostaje vaša veza sa svetom vožnje, spremno da vas vrati na put."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "VODIČ ZAVRŠEN"

	key[]: "desktop_tut_tour_finish"
	val[]: "Hvala vam što ste pregledali naše ažuriranje početnog ekrana."
#@}


	key[]: "show_help"
	val[]: "Uključite/isključite pomoć"

