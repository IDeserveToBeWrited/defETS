	key[]: "screenshot_resized_file_size"
	val[]: "Datoteka slike je veća od maksimalno dozvoljenih $LIMIT$KB i smanjena je." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

