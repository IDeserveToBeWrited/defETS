#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Datoteka slike je prevelike rezolucije. Molimo, smanjite rezoluciju ekrana." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Datoteka slike je neispravna ili nepodržana." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Rezolucija ekrana je prevelika. Molimo, smanjite rezoluciju ekrana." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Sajt je odbacio vašu sliku." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Ovaj nalog ne omogućuje slanje slika." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Šaljete sliku u isto mesto." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Slanje je trenutno onemogućeno. Molimo, probajte ponovo kasnije." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Nepoznata greška se javila tokom slanja. Molimo, probajte slanje kasnije." #+ Error message shown when no more specific message applies.
#@}

