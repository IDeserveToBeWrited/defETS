#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Mrežni sloj nije dostupan. Molimo proveri da je konfiguracija klijenta u redu."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Nije moguće uspostaviti vezu sa uslugom na internetu. Proverite da li ste uopšte povezani na internet."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Pojavila se greška pri komunikaciji sa servisom na internetu. Molimo pokušaj kasnije."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Vraćeni su neispravni podaci. Ako koristite 'HTTP proxy', proverite njegova podešavanja. U suprotnom, pokušajte ponovo kasnije."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Pojavila se greška pri komunikaciji sa servisom na internetu. Molimo pokušaj kasnije."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Servis nije kompatibilan sa trenutnom verzijim igre. Proveri da li je dostupna nova zakrpa/patch/ za igru."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Usluga je trenutno nedostupna. Molimo pokušaj kasnije."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Usluga je trenutno nedostupna zbog održavanja ili preopterećenja. Molimo, pokušaj kasnije."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Informacija o autentifikaciji nije ispravna. Molimo da ponovo pokušaš pristup."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Mrežni nalog je trenutno zaključan zbog mnogo neuspelih pokušaja pristupa. Probajte ponovo za pola sata."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Mrežni nalog je trenutno zaključan zbog sumnjivih pristupanja. Probajte opet za 24 časa."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Igra nije registrovana na ovaj mrežni nalog."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Nalog još uvek nije aktiviran. Molimo, proverite vašu poštu za aktivacioni i-mejl."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Nalog je suspendovan. Molimo, kontaktirajte tehničku podršku."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Nalog je obrisan. Molimo, kontaktirajte tehničku podršku."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy autentifikacija nije podržana u ovoj igri. Molimo da koristiš drugi Proxy ili direktnu konekciju."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Zahtevani objekat je trenutno nedostupan. Molimo, probajte ponovo za nekoliko minuta."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL greška. Nije moguće uspostaviti bezbednu vezu."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Igra je bila obustavljena tokom onlajn komunikacije. Molimo pokušajte ponovo kasnije."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Interna greška. Datoteka net.log možda sadrži više informacija."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 ima problem i nije u mogućnosti da nacrta grafiku na vašem računaru (nije pronađena podržana grafička jedinica).\nPreporučeni koraci:\n1. Proverite da li vaš računar i video karta odgovaraju minimumu hardverskih zahteva.\n2. Instalirajte najnoviju verziju Microsoftovih DirectX drajvera.\n3. Instalirajte najnoviju verziju drajvera za vašu grafičku kartu sa proizvođačevog sajta.\n4. Prebacite metod renderovanja sa OpenGL u DirectX i obrnuto.\n5. Obrišite konfiguracioni fajl igre 'config.cfg' u vašem 'Documents' - 'Euro Truck Simulator 2' foldera. Možda je oštećen.\nOvaj fajl će biti automatski kreiran sa ispravnim početnim vrednostima prilikom sledećeg starta igre."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 ima problema da prikaže grafiku na vašem računaru (nije pronađena odgovarajuća grafička karta)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "'ČAROBNJAK' ZA KONTROLER" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Dalje"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Završi 'čarobnjaka'"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Preskoči 'čarobnjaka'"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "'Čarobnjak' za kontrole"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Da li želite da prekinete 'čarobnjaka' za kontrole?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "IZABERITE NAČIN UPRAVLJANJA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Kontroleri"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Čarobnjak će primeniti preporučena podešavanja na osnovu povezanih uređaja.<br><color value=@@clr_sel@@>Ako koristite Steam kompatibilni gejmpad, razmislite o omogućavanju podrške za konfiguraciju u <br><color value=@@clr_txt_d@@>\"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Vozite koristeći tastaturu a gledaj unaokolo koristeći miša. To je najjednostavniji, ali i najmanje precizan način kontrole dostupan svima."

	key[]: "wiz_control_mouse"
	val[]: "Koristite miša za daleko preciznije upravljanje. Sve ostalo i dalje ostaje na tastaturi. Miša možete i dalje koristiti da gledate unaokolo, ali samo ako uz to držite poseban taster ili dugme za kontrolu kamere."

	key[]: "wiz_control_controller"
	val[]: "Koristite volan, gejmped ili džojstik da osetite svu realnost igre. Tastatura se tada koristi za razne funkcije i akcije, a mišem kontrolišete pogled."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nije pronađen nijedan kontroler. Morate da priključite jedan da omogućite ovaj izbor!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Tražim dostupne kontrolere..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "IZABERITE API KONTROLER" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam unos - režim mapiranja u igri (preporučuje se)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam unos - Režim mapiranja Steam klijenta"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klasični kontroler"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gejmpadovi kao @@controller_ps5@@, @@controller_xbox_one@@ ili @@controller_steam_deck@@ uključeni su u interfejs Steam Input i koristi jednostavan izgled.<br><br>Podržava potpune konfiguracije vezivanja tastera u igri."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gejmpadovi su se uključili u interfejs Steam Input i koriste samostalne rasporede konfigurisane preko Steam klijenta.<br><br>Ograničena podrška za nagoveštaje dugmadi u igri i bez konfiguracija vezivanja u igri."

	key[]: "wiz_api_classical"
	val[]: "Kontroler, volan ili dzojstik koristiće DirectInput, XInput ili sličan interfejs."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "IZABERITE TIP KONTROLERA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Upravljački volan"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gejmped ili džojstik"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Kontroler je volan ili se tako ponaša. Pozicija kontrolera direktno određuje poziciju volana u igri."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Kontroler je gejmped ili džojstik. Pozicija kontrolera određuje brzinu okretanja volana u igri."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "IZABERITE TIP MENJAČA" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Najjednostavniji metod vožnje posebno namenjen (ali ne i samo) tastaturi. Pritisnite NAPRED da vozite unapred i pritisnite NAZAD da vozite unazad. Menjač će brinuti o svemu ostalom umesto vas: prebacivanje između gasa, kočnice i vožnje unatrag, ubacivanje u potrebne brzine i tome slično."

	key[]: "wiz_gb_automatic"
	val[]: "Idealno za volan sa pedalama. Koristite dugmad da prebacujete između vožnje unapred, stajanja u mestu i vožnje unatrag. Onda pritisnite pedalu gasa i prepustite automatici da kontroliše menjač."

	key[]: "wiz_gb_sequential"
	val[]: "Ručno menjajte brzine nagore i nadole da izaberete brzine unapred, ler i rikverc. Ovo je malo teže da se savlada, ali ćete mnogo bolje voziti tako i imati punu kontrou nad vozilom u mnogim situacijama."

	key[]: "wiz_gb_hshifter"
	val[]: "Direktno birate željenu brzinu. Sličan po težini sekvencijalnom menjaču, ali realniji. Fizički H-menjači, kao što su G27 i G25, se preporučuju. Zahteva i kvačilo."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ova mogućnost zahteva volan, gejmpad ili džojstik."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nije priključen nikakav kontroler za H-menjač, pa ova funkcija neće raditi."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "IZABERITE NAČIN H-MENJAČA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Prenos raspona je najjednostavniji izbor. Ima dva kompleta brzina. Prvi komplet koristi brzine od 1 do 6, a drugi od 7 do 12. Prekidač prebacuje između ta dva, dok menjač bira brzinu iz kompleta."

	key[]: "wiz_hs_splitter"
	val[]: "Razdelni prenos je jednostavan izbor. Ima dva kompleta brzina. Prvi komplet koristi neparne brzine (1, 3, 5...) a drugi komplet parne (2, 4, 6 ...). Prekidač prebacuje između ta dva, dok menjač bira brzinu iz kompleta."

	key[]: "wiz_hs_range_splitter"
	val[]: "Ova vrsta menjača je zasnovana na izgledu pravog ručnog range-splitter menjača. Brzine su uparene po 4 za svaku poziciju H-menjača i koristi dva prekidača. Savetuje se samo iskusnim vozačima."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Igra je sada konfigurisana preko početnog podešavanja opisanog ispod. Možete to još čačkati preko naprednog podešavanja ili nastaviti u igru."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Napredna podešavanja"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Igra je sada podešena i možete nastaviti. Kasnije možete izmeniti podešavanja pod Opcijama: Kontroleri."

	key[]: "wiz_cfg_steam"
	val[]: "Možete da proverite i konfigurišete mapiranje dugmadi i osa za ovaj kontroler pomoću Steam klijenta. Podešavanja Steam gejmpada za igru dostupna su u Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Otvori podešavanja kontrolera"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Koristi @@imm_wiz_dsteerleft@@ i @@imm_wiz_dsteerright@@ za upravljanje."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Pomerajte miša levo ili desno da okrećete volan u odgovarajućem smeru."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Koristi @@ima_wiz_j_steer@@ za upravljanje."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Koristite @@imm_wiz_dforward@@ da vozite unapred, a @@imm_wiz_dbackward@@ za vožnju unatrag."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Pomerite @@ima_wiz_j_throttle@@ kontrolu napred da vozite unapred, а za vožnju unatrag је pomerite natrag."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Koristite @@ima_wiz_j_throttle@@ da vozite unapred, a @@ima_wiz_j_brake@@ da vozite unatrag."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Koristite @@imm_wiz_dforward@@ da ubrzate, a @@imm_wiz_dbackward@@ da kočite."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Pomerite @@ima_wiz_j_throttle@@ kontrolu napred da ubrzate, a unatrag da usporite."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Koristite @@ima_wiz_j_throttle@@ da ubrzate, a @@ima_wiz_j_brake@@ da kočite."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Koristi @@imv_wiz_gearup@@ za vožnju napred a @@imv_wiz_geardown@@ za vožnju unazad."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Koristite @@imv_wiz_gearup@@ za vožnju napred a @@imv_wiz_geardown@@ za vožnju unazad ako koristite tastaturu ili kontroler. Koristite @@imv_wiz_drive@@ i @@imv_wiz_reverse@@ da izaberete smer vožnje ako koristite H-menjač."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Koristite @@imv_wiz_gearup@@ i @@imv_wiz_geardown@@ da izaberete željenu brzinu."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Koristite vaš H-menjač zajedno sa @@ima_wiz_j_clutch@@ da izaberete željenu brzinu."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "PODESITE OSE KONTROLERA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Vizualizacija osi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Možete i vizuelno isprobati sve funkcije izabrane ose. Koristite kontroler i gledajte u pokretne stubiće. Pokazaće vam granice, centriranje, orijentaciju i ukupno ponašanje korišćenih osa."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Podešavanje osi"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Da biste izabrali osu, pritisnite dugme pored imena ose. Tako ćete preći u input mod. Nakon toga, koristite svoj kontroler kako biste povezali izabranu osu pomeranjem džojstika, volana ili pedale izabrane ose."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Mrtve zone"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Mrtva zona se odnosi na zonu ose namerno osmišljenu da nema unosa. Kako biste podesili mrtvu zonu, pomerite odgovarajući slajder. Pomeranjem slajdera nadesno, povećaćete mrtvu zonu. Ova osobina je naročito korisna za starije kontrolere, jer podešavanje veće mrtve zone može da umanji probleme, poput nepreciznosti ili neispravnog unosa, prouzrokovanog od strane hardvera."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Režim osi"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Režim ose određuje kako se njime rukuje u igri. Obrnuta osa preokreće svoj prijavljeni pravac, što dovodi do toga da se, na primer, upravlja levo umesto desno. Centrirana osa ima svoju podrazumevanu poziciju u sredini svog opsega, kao što je džojstik. Ovaj režim je koristan za ispravljanje ose koja je pogrešno otkrivena."

	key[]: "normal"
	val[]: "Normalno" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Obrnuto" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrirano" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Obrnut i centriran" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "PODEŠAVANJE AUTOMATSKOG MENJAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Sa automatskim menjačem birate samo vožnju unapred, ler i unazad. To ćete postići koristeći sledeće tastere i dugmad na kontroleru. Da promenite raspored, kliknite na dugme i pritisnite taster ili dugme, koje želite za tu akciju."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ako imate 'H-menjač' kontroler, možete ga lepo iskoristiti da simulirate pravi automatski menjač. Omogućite ovu opciju i dodelite pozicije H-menjaču za vožnju unapred i unazad. Sve druge pozicije će se računati kao ler. Ovo podešavanje je smišljeno posebno za H-kontroler, i tako da neće raditi sa običnim tasterima ili dugmadima. Da promenite dodeljene funkcije, kliknite na dugme i pomerite menjač u željenu poziciju, pa onda nazad u ler."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "PODEŠAVANJE SEKVENCIJALNOG MENJAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvencijalni menjač prolazi kroz sve brzine unapred, ler i unatrag. Ovo su tasteri i dugmad kontrolera koja se koriste za promenu nagore i nadole u spomenutom redu. Da promenite raspored, kliknite na dugme i pritisnite taster ili dugme, koje želite."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "PODEŠAVANJE H-MENJAČA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Ovde možete izabrati raspored za H-menjač i probate ga. Na slici možete videti trenutne funkcije menjača kao i koja je brzina izabrana. Pošto menjaš ima više brzina od prikazanih pozicija, moraćete da koristite dugmad za prebacivanje između različitih kompleta brzina."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Trenutno izabrana pozicija menjača i aktivni prekidači su takođe prikazani ispod, pored dodeljene kontrole. Da promenite dodeljenu kontrolu, kliknite na odgovarajuće dugme i pomerite menjač u željenu poziciju, a onda nazad u ler."
#@}

