	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Vozilo je u solidnom stanju sa samo manjim habanjem." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Vozilo je u odličnom stanju sa minimalnim habanjem." #+ Explanation of 5-star state.

