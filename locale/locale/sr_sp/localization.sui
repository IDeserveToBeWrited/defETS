	val[]: "Krajnja tačka snimanja glave"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Omogućava prošireni prikaz koji povećava vaš ugao gledanja korišćenjem pokreta glave i/ili očiju za kontrolu kamere u igri."

	key[]: "eye_preset_op_tooltip"
	val[]: "Izbor unapred podešenih postavki proširenog prikaza."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Izbor režima praćenja glave:<br>- U „Direktnom“ režimu vaša rotacija glave direktno odgovara rotaciji kamere u igri. Preporučuje se u normalnim situacijama u kokpitu/kabini.<br>- U „Dinamičnom“ režimu vaš pogled će uticati na kameru u igri samo kada zapravo okrenete glavu. Preporučuje se kada je važno da vaš pogled bude apsolutno centriran."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Кada je omogućena, kamera u igri će se neprekidno polako usmeravati dok menjate prirodni položaj glave tokom igre."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Кada je omogućeno, položaj vaše glave utiče na položaj kamere u igri."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Кada je omogućena, kamera u igri će se naginjati u skladu sa tim kada nagnete glavu na bilo koju stranu."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Umnožava kombinovanu rotaciju glave i pogleda u horizontalnom pravcu (u kabini)."

	key[]: "eye_pitch_scale_op_tooltip"
