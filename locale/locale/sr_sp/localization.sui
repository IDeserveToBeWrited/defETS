	key[]: "load_save_t"
	val[]: "SNIMI ILI UČITAJ IGRU" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "Sačuvaj / Učitaj" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Otkrivena promena igre! Da biste izbegli probleme sa kompatibilnošću sačuvanih igara zbog promena u svetu igara, sve nedovršene isporuke su otkazane bez kazne za vas." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Otkrivena promena igre!<br><br>Da bismo sprečili probleme sa kompatibilnošću sačuvane igre, sve nedovršene isporuke su otkazane bez kazne za vas. Potrebno je ponovo parkirati kamion na sigurnom mestu.<br><br>Izaberite destinaciju za brzo putovanje da biste nastavili." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Snimanje..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Pritisnite $KEY$ da preskočite međuscene." #+ Shown when any key was pressed during viewpoint cutscene.

