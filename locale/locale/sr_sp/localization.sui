#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Izbor tema koje se prikazuju u pozadini kada pretražujete kroz meni."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Omogućava nasumičan izbor teme pozadine svaki put kada pokrenete igru."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Postavlja kašnjenje nakon kojeg elementi na desktopu nestaju."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, vremenom ćete početi da doživljavate efekte umora.<br><br>Izbegavanje odmora rezultiraće saobraćajnim prekršajima."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, morate poštovati saobraćajna pravila ili rizikovati da dobijete saobraćajne prekršaje. Rizik je povećan u blizini policijskih vozila, radara i saobraćajnih kamera."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Prilagođava prosečnu dužinu poslova koji se nudi."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Izaberite koje ograničenje brzine će se prikazivati na vidžetu za navigaciju."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Trenutna brzina na navigaciji se menja u crveno kada se prekorači ograničenje brzine."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada stignete na odredište, prikazaće se vidžet koji vam omogućava da preskočite parkiranje."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Skriva sve vidžete."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Zadrži oba HUD retrovzora skrivena."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Skriva sva obaveštenja čak i kada su primljena."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Prikazuje prozor koji pokazuje mogućnosti trenutnog kamiona igrača pre nego što prihvati posao sa teškim teretom."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Odaberite na koji način će mapa sveta biti poravnata."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Izaberite kako treba da se prikazuje navigacija"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja način na koji se navigacija usmerava:<br>- „Najbolji“ režim navigacije bira najefikasniji odnos između dužine i vremena rute, pokušava da izbegne raskrsnice sa semaforima itd.<br>- „Najkraći\" režim navigacije uvek bira najkraću moguću rutu.<br>- Režim navigacije „Mali putevi“ bira da izbegava autoputeve gde god je to moguće."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Promenite težinu parkiranja.<br>- „Uvek izaberi“ vam omogućava da izaberete kada stignete na odredište.<br>- „Bezbedno parkiranje” ne zahteva manevre unazad.<br>- „Vešto parkiranje“ će obično zahtevati izazovniji manevar pri kretanju unazad."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Podešava verovatnoću da naiđete na opasnosti na putu u vašoj blizini, uključujući nesreće, onesposobljena vozila, krhotine na putu itd."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Podesite verovatnoću da naiđete na obilaznicu koja menja rutu tokom vožnje na poslu."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Podesite verovatnoću lošeg vremena."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Odaberite da li se informacije o vremenskoj zoni prikazuju pored trenutnog vremena."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Omogućava međuscene u igri koji se obično prikazuju nakon velikih kupovina ili nadogradnje garaže."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Odaberite da li će se poluprozirni blokatori prikazivati na putevima kojima nema pristupa."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Invertuje Y-osu miša kada kontrolišete kameru u igri."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Bira tip menjača:<br>- „Jednostavan automatski“ vam omogućava da koristite gas i kočnicu za kontrolu kretanja napred i nazad.<br>- „Pravi automatik“ zahteva unos za prebacivanje između napred i nazad.<br>- „Sekvencijalni“ zahteva ručno prebacivanje svih brzina pomoću tastera za pomeranje gore / dole.<br>- „H-Prebacivač“ zahteva upotrebu kontrolera sa menjačima za ručni izbor brzina."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Izbor ove funkcije će omogućiti „preskakanje menjanja“ – preskakanje brzina kada je to neophodno ili praktično kako bi se izbeglo menjanje svakog stepena prenosa u menjaču."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Vraća volan u centar kada se koristi tastatura ili kontroler.<br><br>Onemogućavanje ove funkcije znači da ćete morati ručno da se vratite u centar nakon skretanja."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Podešava opseg animacije na volanu. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja intenzitet kočnica."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja stabilnost kamiona spuštanjem njegovog centra gravitacije."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja stabilnost prikolice spuštanjem njenog centra gravitacije."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja intenzitet obrtnog momenta koji se generiše iz pogonske linije.<br><br>Podizanjem ove postavke pojačaće se osećaj da se kamion „uvija“ udesno."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja krutost vešanja šasije."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja krutost vešanja kabine/spavaća."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Podešava intenzitet proceduralno generisanih neravnina na površini da bi putevima i drugim terenima dao nesavršen osećaj.<br><br>U zavisnosti od drugih podešavanja vešanja i kamere, uočeni efekat može biti manje ili više izražen."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućava napredno spajanje koje zahteva veću preciznost da bi se sedlo kamiona poravnao sa glavnim klinom prikolice.<br><br>Kada je onemogućeno, spajanje prikolice postaje mnogo lakše jer nema sudara između klina i sedla."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Bira da li i koji kablovi prikolice su animirani.<br><br><color value=@@clr_txt_d@@>Omogućavanje kablova na više vozila može uticati na performanse na starijim sistemima."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Omogućava elektronski limitator brzine kamiona na 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>Poslovi u Svet Kamiona imaju ovu funkciju trajno uključenu."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno i brisači su postavljeni na prvu poziciju, brisači će se automatski uključiti i prilagoditi svoju brzinu u skladu sa uslovima."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućava automatsko aktiviranje retardera pri kočenju."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, vozilo pomaže pri kretanju na uzbrdici držeći kočnice, obezbeđujući glatko pokretanje."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućava automatsko aktiviranje motorne kočnice prilikom kočenja."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada se izabere, motor će se pokrenuti čim se pritisne gas."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućena, parkirna kočnica kamiona se podrazumevano aktivira (nakon korišćenja trajekta, vuče na servis, brzog putovanja, itd.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Automatski pokreće podizne osovine kada je potrebno u zavisnosti od težine vozila."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, vozilo će podrazumevano držati niži gas. Nakon što dva puta brzo pritisnete dugme gasa, vozilo će držati pun gas dok se dugme gasa ne otpusti.<br><br>Utiče samo na unos sa tastature."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulira gubitak vazduha u stvarnom životu usled prekomernog korišćenja kočnica.<br><br>Kada je omogućeno, moraćete da upravljate svojim vazdušnim pritiskom kada se spuštate nizbrdo ili pravite spore manevre sa višestrukim primenama kočnica."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućen, ABS će sprečiti blokiranje točkova kako bi održao kontrolu i poboljšao sposobnost kočenja."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, kamion će primeniti kočenje po točku kako bi sprečio proklizavanje točkova, nedovoljno upravljanje ili prekomerno upravljanje kako bi pomogao u održavanju kontrole."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, kamion će zaključati diferencijal ako točkovi počnu da klize, kakobi se poboljšalo trenje."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja povećanje brzine pri kojoj će se tempomat povećavati ili smanjivati kada se pritisne odgovarajuće dugme."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja toleranciju tempomata za održavanje ciljne brzine."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, tempomat će automatski prilagoditi brzinu, kako bi održao bezbedno rastojanje u odnosu na vozilo ispred."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktivira kočenje u slučaju nužde ako sistem oseti neposredan sudar.<br>Izaberite da li će sistem reagovati samo na vozila ili na sve prepreke."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Izbor režima pomoćnika trake:<br>- Režim „Upozorenje o napuštanju trake“ vas zvučno upozorava kada se spremate da napustite traku.<br>- Pored zvučnog upozorenja, „Podrška za zadržavanje trake“ takođe automatski upravlja vašim kamionom kako ne bi napuštao traku.<br><br>Oba režima su aktivna samo pri brzinama iznad 55 km/h (~35 mph).<br>Pomoćnik Trake takođe uzima u obzir vašu upotrebu pokazivača pravca pre nego što se uključi."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućava funkcije senzora mrtvog ugla, ako je vaš kamion njime opremljen."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno i farovi su postavljeni na prvu poziciju, farovi će se automatski uključiti u situacijama slabog osvetljenja."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, a prednja svetla su uključena sa uključenim dugim svetlima, vozilo će automatski prigušiti duga svetla kada detektuje nadolazeće vozilo ili vozilo ispred njega."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Kada su omogućeni, indikatori će se automatski poništiti nakon okretanja dok se volan vrati u sredinu."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Kada je omogućeno, neki unutrašnji dodaci reaguju na fizičko kretanje vozila (viseće dekoracije, bobbleheads, itd.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogućava skretanje unutrašnje kamere na osnovu ulaza upravljača."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja koliko je funkcija „rotacije kamere za upravljanje“ reaktivna na ulaz upravljanja. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja ponašanje funkcije „rotacije kamere za upravljanje“ pri vožnji unazad."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućeno, unutrašnja kamera gleda levo ili desno na osnovu upotrebe migavaca."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Kada je omogućena, unutrašnja kamera reaguje na kretanje vozila."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja koliko je unutrašnja kamera reaktivna na kretanje vozila."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Menja koliko unutrašnja kamera može da se pomera,, u odnosu na pokrete vozila."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Podešava kašnjenje pre nego što kamera automatski centrira.<br><br>Vozilo mora da se kreće brzinom koja nije zanemarljiva da bi se ovo aktiviralo. Odnosi se samo na unutrašnju kameru i kameru za jurenje dok se krećete napred i na kameru koja se naginje van dok se kreće unazad."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Podešava brzinu kretanja kamere. Koristi se za automatsko centriranje kamere i prebacivanje između unapred podešenih kamere za unutrašnjost."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
