#+ DLC manager
#+
#+ Messages for situations occurring due to management of DLCs.
#@{
	key[]: "dlc_acquire_timeout" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Acquiring DLCs takes longer than expected. It will now continue in the background."

	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Acquiring DLCs takes longer than expected. Would you like to keep waiting?<br><br>If you proceed further, the acquiring will continue in the background."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Access to some DLCs has been acquired. Would you like to leave to Title Screen now to get access to the new content?<br><br>Your progress will be saved automatically."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "Access to some DLCs has been lost. You will now leave to Title Screen to reflect the changes in the content.<br><br>Your progress will be saved automatically."
#@}
