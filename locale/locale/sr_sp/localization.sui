	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Podešava koliko će brzo kamera u igri reagovati na pokrete vašeg pogleda."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Podešava postepeno povećanje brzine."

