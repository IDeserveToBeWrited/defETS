	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Hajde da se okušamo u vožnji unazad sa prikolicom. Lakše je nego što izgleda; samo treba biti strpljiv."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Počnite da vozite unazad i postavite tegljač u liniju sa prikolicom."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Uverite se da ste pravilno postavljeni, inače nećete moći da uspostavite vezu. Ako nije u redu, uvek možete povući napred i pokušati ponovo."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Sedlo tegljača će se zabraviti za osovinu prikolice."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Povucite parkirnu kočnicu i povežite prikolicu. U stvarnom životu, morali biste da izađete iz kamiona da povežete vazdušne i električne vodove i podignete stajni trap, ali evo, mi ćemo to učiniti za vas."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Prikolica će se uvek okretati <color value=@@clr_sel@@>suprotno <color value=@@clr_txt@@>do tegljača."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Da biste okrenuli prikolicu, moraćete da upravljate tegljačem<color value=@@clr_sel@@> suprotno <color value=@@clr_txt@@> od pravaca u kome želite da prikolica ide."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Da biste ponovo ispravili prikolicu, okrenite tegljač <br><color value=@@clr_sel@@>prema<color value=@@clr_txt@@> prikolici."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Pokušajte da ostanete u ravni sa prikolicom - moraćete da pravite stalne manje ispravke da biste držali prikolicu usmerenu ka označenom području."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Ispravite odstupanja od putanje malim okretima volana čim se dogode. Ako ga preterate, možete završiti daleko izvan željenog puta."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Zaustavite se na određenom području. Obezbedite kamion i ugasite motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Iza vas i sa strane suvozača videćete prikolicu. Vaš prvi zadatak će biti da vozite unazad.<br><br><font face=/font/big_bold.font>Pripremite kamion za vožnju unazad. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Započnite vožnju unazad prema prikolici. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Poravnajte se tako da budete ravno sa prikolicom. Sedlo treba da uhvati osovinu. Povucite napred da biste podesili ako je potrebno.<br><br><font face=/font/big_bold.font>Nastavite da vozite unazad dok ne osetite vezu. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Sedlo je spojeno sa osovinom i spremni ste da završite spajanje sa prikolicom.<br><br><font face=/font/big_bold.font>Primenite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Press @@imv_nrm_attach@@ da povežete prikolicu. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Sada je prikolica bezbedno povezana sa tegljačem, vazdušni i električni vodovi su povezani, a stajni trap je podignut.<br><br><font face=/font/big_bold.font>Otpustite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Morate voziti unazad na parking mesto direktno iza vas. Zapamtite da će se prikolica okrenuti u suprotnom smeru od načina na koji upravljate tegljačem. Malo okretanje volana može dovesti do značajnog pomeranja prikolice.<br><br><font face=/font/big_bold.font>Počnite vožnju unazad sa prikolicom. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Nemojte preupravljati, samo pokušajte da prikolica bude u liniji sa mestom. <br><br><font face=/font/big_bold.font>Nastavite prema parking mestu. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

