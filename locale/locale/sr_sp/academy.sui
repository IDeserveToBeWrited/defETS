#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "U ovom scenariju, suočićete se sa različitim skretanjima koja će vam pomoći da se naviknete na vožnju sa prikolicom. Ostanite fokusirani, prilagodite svoju brzinu svakoj situaciji i u potpunosti iskoristite raspoloživi prostor na kursu obuke."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Prvo skretanje je zaokret sa dogleg - dva okreta u jednom. Moraćete da se pripremite za skretanje levo, ali pređite na desno skretanje usred manevara."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Ovo sledeće skretanje vas prelazi na drugu stranu sredine. Nije posebno teško, ali moraćete da pazite da ostavite dovoljno prostora za svoju prikolicu."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Sledeće što morate da pregovarate o uskom slalomu kroz betonske prepreke. Idite polako i koristite svoje retrovizore i pobrinite se da zaokrenete dovoljno široko da vaša prikolica može da očisti barijere."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "U ovom trenutku, ući ćete u još jedan slalom upotpunjen dodatnim čunjevima na vrhu svake krivine <br>Pazite da ne udarite nijednu od njih!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Sledi nekoliko lakih uglova na putu do kružnog toka."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Koristite pravi deo da biste se pripremili za ulazak u kružni tok. Ostanite spolja pre nego što uđete u njega."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Uđite u kružni tok i pogledajte kako se vaša prikolica nalazi. To će vas drugačije pratiti kada uđete u kružni tok u odnosu na način na koji ste ušli."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Izađite iz kružnog toka i vozite do sledećeg seta skretanja."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "UKLONITE OVU SEKVENCU"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Zaokret je ovde izuzetno oštar. Polako i pametno koristite prostor oko sebe. Imajte na umu i zaokret repa prikolice."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Dok vozite kroz sledećih nekoliko skretanja, ne zaboravite da pokušate da se pripremite za sledeće skretanje dok izlazite iz prethodnog."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Ne žurite sa poslednjim uglom. Izgleda lako, ali ima manje prostora za manevrisanje nego što se čini."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Zaustavite se na predviđenom mestu, obezbedite kamion i ugasite motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Ubrzajte prema prvom skretanju. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Prvo skretanje je lagano skretanje.<br><br><font face=/font/big_bold.font>Napravi skretanje. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "UKLONITE OVU PROVERU"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Napred se kurs nastavlja levo od sredine.<br><br><font face=/font/big_bold.font>Napravite svoj put kroz raskrsnicu. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Prođite kroz barijere i zapamtite da gledate svoju prikolicu.<br><br><font face=/font/big_bold.font>Vozite kroz slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Ovaj slalom je jednostavniji, ali ga saobraćajni čunjevi čine znatno čvršćim.<br><br><font face=/font/big_bold.font>Vozite kroz slalom i izbegavajte da udarite čunjeve. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Pred vama je nekoliko lakih uglova, i dalje ćete morati da pravilno postavite da biste držali prikolicu dalje od unutrašnjih barijera.<br><br><font face=/font/big_bold.font>Napravite skretanja. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Približavate se kružnom toku. Ne zaboravite da ostavite dovoljno prostora za svoju prikolicu ne samo kada ulazite i izlazite, već i dok se vozite kroz nju.<br><br><font face=/font/big_bold.font>Vozite kroz kružni tok. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Pred vama je kratka prava deonica, možete malo povećati brzinu ako želite.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Zaokret je ovde izuzetno oštar. Idite polako, iskoristite sav raspoloživi prostor i imajte na umu znošenje prikolice. <br><br><font face=/font/big_bold.font>Vozite kroz oštro skretanje. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Poslednjih nekoliko skretanja su pravo napred. Prisetite se na prikolicu držite je na umu.<br><br><font face=/font/big_bold.font>Nastavite dalje. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Nastavite ka finalnom parking mestu. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

