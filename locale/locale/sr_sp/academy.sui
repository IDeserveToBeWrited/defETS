#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Dobrodošli na prvi deo završnog ispita. Evo, videćemo koliko ste dobro naučili da vozite kamion nakon provedenog na Akademiji."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Prvo ćete prikačiti prikolicu. Kada ste spojeni, vozićete kamion po celoj testnoj oblasti."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Prva deonica staze vodi od malog parkinga do istočne probne staze."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Krug uključuje izazovne prolaze između barijera."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Značajan deo rute prolazi kroz istočnu probnu stazu."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Mi ćemo testirati vašu sposobnost manevrisanja kamionom u različitim situacijama."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Vi ćete manevrisati sa kamionom kroz neka oštra skretanja."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Proći ćete kroz deonicu puta koja povezuje staze."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Završni deo uključuje vožnju kroz mali krug."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Krug ima mnogo zamršenih prolaza i oštrih skretanja."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Da biste završili test, moraćete precizno da parkirate."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nema potrebe da se nervirate, već ste naučili sve što je potrebno da prođete.<br><br>Srećno!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Pred vama je prikolica.<br><br><font face=/font/big_bold.font>Vozite ka prikolici. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Poravnajte tegljač sa prikolicom.<br><br><font face=/font/big_bold.font>Vozite unazad i povežite se sa osovinom. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Obezbedite kamion. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Pritisnite @@imv_nrm_attach@@<font face=/font/big_bold.font> da povežete prikolicu. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Prikolica je povezana, a kamion je spreman za vožnju.<br><br><font face=/font/big_bold.font>Otpustite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Počnite da vozite prema izlazu sa parkinga. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Pratite oznake na putu i pazite na barijere.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Predstoji još izazovniji deo.<br><br><font face=/font/big_bold.font>Pažljivo se krećite između barijera. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Ovaj deo će testirati vaše veštine u manevrisanju prikolicom oko različitih vrsta uglova.<br><br><font face=/font/big_bold.font>Skrenite na poligon </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Vozite kroz prolaz. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Vozite pravo. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Pažljivo se krećite u skretanju. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Ulazite u kompleksniji deo. Vozite pažljivo.<br><br><font face=/font/big_bold.font>Nastavite vožnju nizbrdo. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Napravite oštro levo skretanje. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Izađite iz kružnog puta. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Ulazite u lakšu oblast.<br><br><font face=/font/big_bold.font>Nastavite da vozite niz brdo. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Nastavite da vozite na putu. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Pred vama je skretanje na sledeći poligon.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Skreni desno. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju na stazi. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Napred su oštrija skretanja.<br><br><font face=/font/big_bold.font>Podesite svoju brzinu u skladu sa tim. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Napravite levo skretanje. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Uđite u skretanje, nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Da biste skrenuli, možda ćete morati malo da siđete sa asfalta.<br><br><font face=/font/big_bold.font>Pažljivo skrenite, koristite onoliko prostora koliko vam je potrebno. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Izađite iz kružnog puta i vozite do parking mesta. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Završni ispit (2. deo)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Očekuje vas poslednji deo završnog ispita, gde će se proceniti veštine parkiranja koje ste naučili u prethodnim scenarijima. Parkirajte pažljivo i precizno i bićete spremni da krenete putevima Evrope kao vešt kamiondžija!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Ofset manevar"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Dijagonalno parkiranje"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Vožnja kroz parkiralište"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Paralelno parkiranje"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Finalno parkiranje"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Dobrodošli u drugi deo završnog ispita. Preći ćemo na obližnji parking i testirati vaše veštine u vožnji unazad i manevrisanju na parking mestima."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Očekuje vas nekoliko uzastopnih izazova za parkiranje da biste procenili svoje sposobnosti."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Ovde je prostor ograničen, zato budite oprezni i odvojite vreme."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Ne zaboravite da budete oprezni i da ne žurite. U redu je ako ne možete da ga smestite iz prvog pokušaja, važno je da ne oštetite kamion ili one oko vas. <font face=/font/big_bold.font><br><br>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Vozite se napred do prvog dela ispita.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Vaš prvi zadatak je da demonstrirate manevar ofset parkinga. Mesto gde treba da napravite rezervnu kopiju sa prikolicom je na vašoj levoj strani.<br><br><font face=/font/big_bold.font>Izvršite manevar za ofset parkiranje.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Sledeći zadatak je da se vratite u niz nepomičnih kamiona. Pazite da ne udarite druge kamione!<br><br><font face=/font/big_bold.font>Izvršite dijagonalni manevar parkiranja.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Nastavite kroz parking. Pazite na neočekivane situacije.<br><br><font face=/font/big_bold.font>Nastavite vožnju.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Hajde sada da pokušamo paralelno parkiranje između dva kamiona pored ivičnjaka ispred vas.<br><br><font face=/font/big_bold.font>Izvršite manevar paralelnog parkiranja.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Jedan poslednji manevar parkiranja sa vaše leve strane! Možete izabrati da pristupite ovome kako god želite.<br><br><font face=/font/big_bold.font>Vozite unazad u naznačeno područje.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Skoro gotovo. Napustite prostor za testiranje i parkirajte kamion.<br><br><font face=/font/big_bold.font>Izađite iz testne oblasti sa vaše leve strane.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Kamion možete parkirati na desnoj strani sa ostalima.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Paralelno parkiranje sa prikolicom"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "U ovom scenariju, pogledaćemo paralelno parkiranje sa povezanom prikolicom."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Zaustavljanje u označenom području"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Paralelno parkiranje sa prikolicom je relevantna veština za sve kamiondžije.<br>Bilo da se parkirate na ulici u velikom gradu ili da se zaustavite na odmorištu na selu, to je nešto što svaki kamiondžija treba da zna kako da uradi."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Dok prolazite pored parking mesta, pažljivo pogledajte da biste bili sigurni da ima dovoljno prostora za tegljač i prikolicu da stanu. Ovde smo obezbedili da imate dovoljno prostora."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Poravnajte se s kamionom ispred parking mesta. Nemojte mu biti previše blizu, držite se na malom odstojanju od njega da biste imali prostora za rad."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Skrenite naglo sa parking mesta i počnite da vozite unazad. Ideja je da se prikolica odmah okrene na parking mesto."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Kada prikolica bude dobro usmerena na mesto, možete početi da je pratite."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Počnite da upravljate prikolicom dalje od ivičnjaka pre nego što točkovi prikolice na strani vozača uđu na mesto."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Ispravite tegljač sa prikolicom, a zatim se centrirajte unutar parking mesta.<br> Parkirajte, ugasite motor i obezbedite kamion."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Vidite parking ispred vas, između ostalih kamiona. Dok parkirate, obavezno proverite retrovizore i držite bezbednu udaljenost između kamiona i prepreka oko vas.<br><br><font face=/font/big_bold.font>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Krećite se kroz parcelu da pronađete svoje parking mesto.<br><br><font face=/font/big_bold.font>Vozite napred. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Prođite pored željenog parking mesta do označenog područja. Odavde možete započeti svoj manevar vožnje unazad.<br><br><font face=/font/big_bold.font>Stanite na označenom mestu. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Okrenite tegljač dalje od mesta da biste počeli da okrećete prikolicu u njega. Nemojte skretati previše oštro, inače ćete krenuti ka ivičnjaku. <br><br><font face=/font/big_bold.font>Počnite vožnju unazad. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Poravnajte prikolicu sa mestom. Ako je potrebno, pomerite se napred ili nazad dok vršite neophodne unose upravljača da biste podesili svoj položaj.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Čestitamo, uspešno ste završili ispite za Osnove vožnje kamiona i naučili sve veštine neophodne za pravilno manevrisanje kamionom."

	key[]: "aca_msg_book1_outro02"
	val[]: "Ovo je prvi korak na vašem putu ka ostvarenju vašeg sna da postanete profesionalni vozač kamiona."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Sada ste spremni da krenete putevima Evrope i suočite se sa svojim prvim izazovima..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...ali avantura je tek počela."
#@}


# Book 2 formatting
