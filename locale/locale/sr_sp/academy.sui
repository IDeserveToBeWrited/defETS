#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Korekcija kretanja unazad pravo"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "U ovom scenariju, preuzećete volan nakon što je neko drugi već pokušao da se kreće pravo unazad. Ispravite njihovu grešku i parkirajte kamion na određeno mesto."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Ispravljanje"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Vožnja unazad"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Neko je pokušao da uđe u rikverc sa ovom kombinacijom na parking mesto i imao je malih problema. Sada je na vama da to popravite!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Prvi korak je da krenemo napred i sredimo sve u nešto sa čime možemo da radimo. Ključno je da zadnja prikolica bude usmerena tamo gde želite da ide."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "U ovom slučaju, odlučili smo se da idemo više ka strani vozača. Ovo će nam dati bolji pogled na ono što radimo dok se krećemo unazad i omogućiti nam da radimo sa jedne strane. <br><br>Zapamtite, upravljate zadnjom prikolicom pomoću vođstva, zato se ne fokusirajte toliko na tegljač."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Kombinacija je manje više tamo gde nam je potrebna, ali hajde da se ponovo povučemo napred da bismo je pravilno centrirali."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Odavde ćemo se veoma nežno vratiti unazad, vodeći računa da zadnja prikolica ostane savršeno na putanji."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Sada možemo poravnati vodeću prikolicu i sam tegljač."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Povucite napred i ispravite sve. <br><br>Kada ste zadovoljni, vratite se unazad u određeno područje."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Vozite se unazad prema određenom području."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Obezbedite vozilo i ugasite motor."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Unazad od 90°"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "U ovom scenariju, koristićete manevar vožnje unazad od 90° da biste parkirali u red drugih kamiona."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Polukružno skretanje"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Krenite"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Vožnja unazad"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Vožnja unazad u stranu je lakša sa duplim prikolicama, jer ćete imati jasniji pogled kroz bočni prozor na sve što se dešava."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Prvo, vozite napred i napravite polukružni okret na kraju reda. Ovo će vam omogućiti da se smestite sa strane sa koje imate dobar pogled, što će vam omogućiti da bolje vidite stvari kroz prozor sa strane vozača."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Možete postaviti prikolice kako god želite, možda sa zadnjom prikolicom već okrenutom ka mestu. U ovom slučaju, počećemo iz pravog položaja. <br><br>Zapamtite da bude jednostavno - upravljajte zadnjom prikolicom pomoću vođstva."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Udaljite vodeću prikolicu malo od parking mesta, a zadnja prikolica će početi da se okreće ka tom mestu. Odatle, podesite ugao između vodeće i zadnje prikolice kako biste održali lep, glatki luk u parking mestu."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Zapamtite, ako se zadnja prikolica previše usko dolazi, onda morate malo ispraviti ugao kombinacije. Ako ide preširoko, onda oštriji ugao."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Podešavanja koja pravite na tegljaču imaju upola manji uticaj na zadnju prikolicu nego na vodeću, zato se ne bojte da zaista radite na vašem kamionu."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "U ovom trenutku, morate početi sa planiranjem unapred. Takođe morate dovesti i vodeću prikolicu na to mesto, pa počnite da planirate kako da je postavite direktno ispred zadnjeg dela."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Veoma je retko da se prikolice ubace iz prvog pokušaja. U ovom slučaju, predugo smo čekali da ispravimo vođstvo, i sada zadnji deo skreće sa putanje. <br><br>Nema problema, povucite napred i pokušajte ponovo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Zaista radi na tom volanu i dovezi te prikolice gde želiš. Možeš da vučeš napred koliko god puta treba dok ne budeš zadovoljan."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "I tako, uspešno smo parkirali duple prikolice."

#### backing_90_tight Driving Instructions

