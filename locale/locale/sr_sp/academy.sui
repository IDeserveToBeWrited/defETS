#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Osnovne kontrole i kretanje"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Naučite osnovne kontrole vozila i kako da pomerite kamion napred i nazad."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste 1. poglavlje: @@aca_chapter_book1_1_title@@.<br><br>Naučili ste kako da pripremite kamion pre vožnje,<br>vožnja unapred i unazad i kako se koriste svetla i brisači</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Osnovni manevri"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Naučite da vozite, manevrirate i parkirate sa tegljačem. Istražite svrhu svake vrste retrovizora i kako da ga koristite."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 2. poglavlje: @@aca_chapter_book1_2_title@@.<br><br>Naučili ste kako da koristite svaki retrovizor na kamionu, proverite prostor oko kamiona pre nego što krenete i izvršite osnovne i napredne manevre.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manevrisanje sa prikolicom"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Naučite da se povežete sa prikolicom i da manevrirate sa prikolicom kroz različite situacije."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste Poglavlje 3: @@aca_chapter_book1_3_title@@.<br><br>Naučili ste da povezujete i otkačinjete prikolicu,<br>osećaj za težinu i dimenzije kamiona sa prikolicom<br>i vožnju po izazovnim stazama sa prikolicom.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Vožnja unazad sa prikolicom"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Naučite nove manevre za efikasno kretanje unazad i parkiranje sa prikolicom."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 4. poglavlje: @@aca_chapter_book1_4_title@@.<br><br>Naučili ste da vozite unazad sa prikolicom<br>i razne tehnike parkiranja.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Završni ispit"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Pokažite svoje znanje i veštinu da dokažete svoju vrednost kao kamiondžija!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 5. poglavlje: @@aca_chapter_book1_5_title@@.<br><br>Dokazali ste da posedujete sve potrebne veštine<br>za vožnju, manevrisanje i parkiranje kamiona!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Zagrevanje motora"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Završili ste obuku: @@aca_chapter_book2_0_title@@.<br><br>Naučili ste pravila i karakteristike vozačke vičnosti.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Nazad u brzini"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste poglavlje 2: @@aca_chapter_book2_1_title@@.<br><br>Zagrejali ste motor, testirali brzine, pravilno okretali točkove i proverili efikasnost kočnica. Sledeća poglavlja će biti izazovnija.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Točkovi u pokretu"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste poglavlje 3: @@aca_chapter_book2_2_title@@.<br><br>Savladali ste teške i raznovrsne scenarije. Pokazali ste veštinu i performanse.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Konačna deonica"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste poglavlje 4:@@aca_chapter_book2_3_title@@.<br><br>Rešili ste mnoge teške situacije prilikom manevrisanja, parkiranja i vožnje unazad sa prikolicom. Dokazali ste da ste vešt vozač, sposoban da se nosite sa svim izazovnim situacijama u vožnji kamiona."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Idite napred"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Naučite sve osnovne tehnike za rukovanje duplim prikolicama prilikom vožnje napred."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste 1. poglavlje: @@aca_chapter_book3_1_title@@.<br><br>Iskusili ste kako efikasno da vozite i manevrišete sa duplim prikolicama.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Kontrola vožnje unazad"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Razumeti neophodne korake za manevrisanje sa duplim prikolicama prilikom vožnje unazad."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste 2. poglavlje: @@aca_chapter_book3_2_title@@.<br><br>Naučili ste impresivnu veštinu vožnje unazad sa duplim prikolicama.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Priprema za stvarni svet"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Primenite svoje novo znanje u naprednijim scenarijima."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste 3. poglavlje: @@aca_chapter_book3_3_title@@.<br><br>Rešili ste mnoge teške situacije pri manevrisanju, parkiranju i vožnji unazad sa duplim prikolicama. Ovde ste se dokazali, sada je vreme da vučete neke duple prikolice na putevima Evropskog Kamionskog Simulatora 2!</font><br><br>"


