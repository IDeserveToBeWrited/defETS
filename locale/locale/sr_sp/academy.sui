	key[]: "aca_book_disclaimer_topbar"
	val[]: "Ovo nije sertifikovani program obuke."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ nije namenjen za zamenu u obuci u taksiju.</font><br><br><color value=@@clr_txt@@>Preporučujemo vam da potražite uputstva od akreditovane institucije za obuku kamiona pre nego što pokušate da upravljate kamionom u stvarnom životu.<br><br>Ustanove za obuku zainteresovane za korišćenje @@driving_academy@@ za dopunu obuke taksista možete da nas kontaktirate u akademiji@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Osnove vožnje kamiona"

	key[]: "aca_book_book1_desc"
	val[]: "Naučite osnove vožnje kamiona, od osnovnih funkcija i kontrola do manevrisanja sa prikolicom."

	key[]: "aca_book_book2_title"
	val[]: "Vičnost za vožnju kamiona"

	key[]: "aca_book_book2_desc"
	val[]: "Usavršite svoje veštine vožnje kamiona novim scenarijima u izazovnijim uslovima."

	key[]: "aca_book_book3_title"
	val[]: "Rukovanje dvostrukom prikolicom"

	key[]: "aca_book_book3_desc"
	val[]: "Prihvatite neobične izazove vožnje i vožnje unazad sa setom duplih prikolica."

