	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Ups! Neko se malo iznervirao dok je vozio unazad i ostavio kamion na sredini parkinga."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Neizbežno će biti trenutaka kada ćete potpuno zabrljati. Ne brinite, samo povlačite napred iz preklapanja dok ne budete imali nešto sa čime možete da radite. <br><br>Ako niste sigurni, pokušajte da sve razjasnite kako biste imali čist početak."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Ovo je pristojna pozicija za početak. Zadnja prikolica je i dalje usmerena ka mestu koje želimo da ide, a možemo brzo da postavimo tegljač ispred vodećeg dela kako bismo počeli da upravljamo celom kombinacijom u željenom pravcu."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Idite do određenog mesta i obezbedite kamion. <br><br>Još jednom, možete vežbati sa ovim scenarijem dok se ne osećate udobno u manevrisanju prikolicama."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Nema izlaza iz ove zbrke. Povuci se napred da imaš nešto sa čime ćeš raditi."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Započnite unazad."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


