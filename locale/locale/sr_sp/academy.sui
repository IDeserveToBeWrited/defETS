	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkiranje u uskom prostoru"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "U ovom scenariju, parkiraćemo na uskom prostoru.<br><br>Moraćete da manevrišete prikolicom da biste se postavili pravo sa ofsetom parking mesta."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manevrisanje u mestu"
