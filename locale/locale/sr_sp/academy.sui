#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parking sledeći pored prepreke"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "U ovom scenariju, naučićemo da parkiramo pored ivičnjaka koristeći bočni retrovizor."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Proverite bočni retrovizor"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Vožnja ka ivičnjaku"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Bočni retrovizor je još jedan alat koji će vam pomoći da bezbedno manevrirate kamionom. Nalazi se na gornjem okviru suvozačevih vrata."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Vozite napred i polako se okrenite na stranu suvozača."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Ove drvene daske predstavljaju ivičnjak. Moraćete da parkirate pored. <br>Okrenite se prema ivičnjaku da kamion dovedete u dobar položaj da se poravna sa parking mestom."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Usporite pre ivičnjaka i skrenite ka parking mestu. Dok se ispravljate, možete da koristite bočni retrovizor da procenite udaljenost od ivičnjaka."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Zaustavite se na parking mestu i osigurajte kamion."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Pogledajte kroz prozor sa suvozačeve strane. Tamo možete videti bočni retrovizor.</font>@@aca_goal_tip@@ Morate biti u vozilu."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Bočni retrovizor pokriva područje na suvozačevoj strani gde vozač ne može da vidi. To je jedna od najproblematičnijih mrtvih tačaka na kamionu. Ako vam ugao ogledala ne odgovara, možete ga podesiti '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Kamion još uvek nije spreman za pokret, možda ste nešto zaboravili?<br><br>Je li motor upaljen? Da li ste otpustili parkirnu kočnicu?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Ispred vas je niz dasaka koje predstavljaju ivičnjak. Na kraju ivičnjaka je mesto za parkiranje. Moraćete da vozite na tamo. <br><br><font face=/font/big_bold.font>Nastavite kada budete spremni. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Skrenite prema ivičnjaku. Koristite prednje i bočne retrovizore da proverite svoj položaj u odnosu na ivičnjak, ali takođe pazite da ne pređete preko saobraćajnih čunjeva.<br><br><font face=/font/big_bold.font>Vozite prema ivičnjaku i do parking mesta.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Secure the truck and shut down the engine.</font>@@aca_goal_tip@@ You can use Interior Look presets to make looking at mirrors easier. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parkiranje unazad pored prepreke"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "U ovom scenariju, preokrenućemo kamion na parking mesto pored ivičnjaka."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Uputstva"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Vožnja unazad ka ivičnjaku"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parkiranje kamiona"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "U ovom scenariju, izvršićemo manevar unazad da bismo se parkirali pored ivičnjaka."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Unazad prema ivičnjaku.<br>Morate biti svesni svog okruženja kada vozite unazad, pa koristite svoje retrovizore."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Kako se približavate, možete početi da poravnavate kamion sa parking mestom. Gledajte obe strane kamiona dok se krećete unazad."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Zaustavite se na parking mestu i osigurajte kamion."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Parking mesto je iza vas prema suvozačevoj strani. Koristite svoje retrovizore da se krećete prema mestu.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Ne zaboravite da koristite retrovizore da biste proverili okolinu pre nego što pomerite kamion.<br><br><font face=/font/big_bold.font>Započnite vožnju unazad prema ivičnjaku. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Nastavite da nadgledate svoje okruženje dok skrećete unazad na parking mesto.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom mestu. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Napredni kurs za obuku"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Poslednji scenario u ovom poglavlju je vožnja na kursu napredne obuke. Stavićemo na test veštine koje ste naučili sa tegljačem!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_check1"
