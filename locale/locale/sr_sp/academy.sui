#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Dobrodošli u @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Sledeći scenariji predstavljaju prvi korak na vašem putu ka profesionalnoj vožnji kamiona."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Ovde ćete naučiti sve iz osnovnih sistema i kontrola kamiona..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...za složene manevre sa i bez prikolice."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Pomoći ćemo vam da steknete navike koje će vam pomoći da se bezbedno krećete u raznim situacijama,"

	key[]: "aca_msg_book1_intro_cutscene06"
