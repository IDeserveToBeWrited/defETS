	key[]: "aca_msg_book3_train_check1"
	val[]: "Pred vama je deonica nizbrdo, možete je iskoristiti da brzo osetite kombinaciju duplih prikolica."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Pripremite se da kočite za skretanje koje je pred vama."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Pređite kroz srednju traku skretanjem desno, a zatim odmah levo."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Pređite još jednom kroz sredinu."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Postoje trenuci kada nećete imati drugog izbora nego da preklopite celu kombinaciju. <br><br>Uradi šta moraš da prođeš kroz ovo izuzetno oštro skretanje."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Nastavite vožnju kroz stazu."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Pažljivo savladajte slalom, vodeći računa ne samo da vaše prikolice prođu svaku barijeru, već i da ste spremni da zaobiđete sledeću."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Nastavite levo i prođite pravo kroz raskrsnice."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Pratite asfalt desno."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Poslednje skretanje je obmanjujuće; ima puno prostora, ali budite spremni da parkirate uz krajnji ivičnjak."

