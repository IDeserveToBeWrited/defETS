	key[]: "aca_msg_book3_correcting_90_cutscene2"
	val[]: "Sada kada ste već parkirali nekoliko prikolica, trebalo bi da imate dobru predstavu o tome kako da nastavite dalje."

	key[]: "aca_msg_book3_correcting_90_cutscene3"
	val[]: "Počnite tako što ćete povući napred dok ne budete imali nešto sa čime ćete raditi."

	key[]: "aca_msg_book3_correcting_90_cutscene4"
	val[]: "Odavde, sada možete upravljati zadnjom prikolicom u mesto koristeći vođstvo. Pokušajte da održite lep luk kroz kombinaciju kako bi se sve nastavilo kretati."

	key[]: "aca_msg_book3_correcting_90_cutscene5"
	val[]: "Potrebno je onoliko vremena i onoliko korekcija koliko vam je potrebno."

	key[]: "aca_msg_book3_correcting_90_cutscene6"
	val[]: "Ispravite sve, zaustavite se na određenom mestu i obezbedite vozilo."

