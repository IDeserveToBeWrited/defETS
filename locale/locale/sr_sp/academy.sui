	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "Nastavite iza ugla i izađite na put. Tamo ćete naći otvoreno mesto za sebe."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "Zaustavite se na parking mestu i prođite kroz njega; ovo će vam pomoći da prikolice budu bliže mestu gde treba da budete."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "Nastavite sa izlaska sa parking mesta i pomerite se dovoljno napred da imate prostora za manevrisanje."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "Koristeći vodeću prikolicu za upravljanje, gurnite zadnju prikolicu na mesto. Zaista ćete morati unapred da planirate kako biste bili sigurni da svaka prikolica završi tamo gde želite."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "Možda ćete morati da povučete napred i nazad nekoliko puta da biste sve doveli tamo gde želite."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "Kada se uverite da ste poravnati sa ivicom puta, centrirajte kombinaciju na parking mestu i obezbedite vozilo."

