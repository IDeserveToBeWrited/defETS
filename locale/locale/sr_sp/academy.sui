#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Vožnja kroz složena skretanja"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "U ovom scenariju ćemo istražiti manevrisanje prikolicom kroz kratku stazu sa preprekama sa složenijim skretanjima."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Prva skretanja"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Vožnja kroz uzak prolaz"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Usko okretanje od 90°"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Vožnja oko barijera"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Ispred su razni složeni uglovi i prepreke.<br>Uzmite u obzir sve što ste do sada naučili i to ne bi trebalo da bude teško."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Oznake na putu mogu vam pomoći da dobijete ideju o tome kako da nastavite kroz svaki skup prepreka."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Držite tegljač na spoljnoj strani ugla. <br>Moraćete da zaokrenete široko dok prikolica prati kraću putanju."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Sledeći ugao je lako okretanje od 90°. <br> Još jednom, držite kamion izvan skretanja i iskoristite sav raspoloživi prostor."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Uzmite svoje vreme ovde. Kurs se otvara, ali i dalje morate biti precizni."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Držite široki ležaj oko barijera."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Pazite dok ulazite u ovu usku oblast. <br>Dobro zaokrenite tegljač pre nego što uđete kako biste svoju prikolicu postavili za ulazak."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Poslednji zaokret od 90° je mnogo oštriji od prvog, ali ima dovoljno prostora ako svoj prostor koristite mudro."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Zaustavite se na predviđenom mestu, zatim obezbedite kamion i ugasite motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Ne zaboravite da koristite oznake na putu da vam pomognu u navigaciji kursom.<br><br><font face=/font/big_bold.font>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Korišćenje retrovizora će vam takođe pomoći da se bezbedno krećete stazom. Uvek morate biti svesni kako prikolica prati iza vas.<br><br><font face=/font/big_bold.font>Prođite kroz prvi ugao. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Posmatrajte prikolicu dok izlazite iz skretanja i pripremite se da uđete u sledeće.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Nastavite kroz sledeće skretanje. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Ne zaboravite da posmatrate svoju prikolicu da biste bili sigurni da ste podalje od prepreka oko vas pre nego što okrenete kamion.<br><br><font face=/font/big_bold.font>Nastavite da zaobiđete prepreku ispred vas. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Kada se vaša prikolica udalji od barijere, naglo se okrenite na stranu suvozača da biste se ispravili za uski prolaz. <br><br><font face=/font/big_bold.font>Nastavite prema uskom prolazu.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Ovaj deo će zahtevati veoma preciznu vožnju. Uzmite si vremena i koristite svoje retrovizore.<br><br><font face=/font/big_bold.font>Držite se prema spoljašnjem delu svakog ugla. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ovo skretanje je veoma oštro, ali možete da iskoristite sav prostor ispred sebe da ga lako očistite.<br><br><font face=/font/big_bold.font>Napravite poslednje skretanje. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Kurs napredne obuke - Prikolica"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "U završnom scenariju 3 poglavlja, provozaćemo se dužom obukom sa raznim skretanjima da bismo videli koliko ste dobro naučili da manevrišete sa prikolicom."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Dogleg Skretanje"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "UKLONI OVAJ CILJ"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Srednje ukrštanje"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Prvi slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Drugi slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Lako skretanje"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Kružni tok"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Prava oblast"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Usko okretanje"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Finalna skretanja"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Vožnja do parking mesta"
