#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Vožnja unazad sa prikolicom"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "U ovom scenariju, prvi put ćete se okušati u vožnji unazad sa prikolicom. To je prilično jednostavan manevar, ali ćete i dalje morati pravilno da upravljate da biste postavili prikolicu u ispravan položaj."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Vožnja unazad prema prikolici"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Povezivanje prikolice"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Vožnja unazad sa prikolicom"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Nastavite prema parking mestu"
