#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Oslonac za kutiju"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "U ovom scenariju, bićete smešteni na prazan parking da vežbate vožnju unazad sa duplim prikolicama."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Započnite"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentisanje"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Završava se"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Kraj scenarija"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Vožnja unazad sa duplim prikolicama zahteva mnogo više pažnje nego sa jednom prikolicom. Morate unapred planirati gde želite da se postavi zadnja prikolica, a da pritom zadržite kontrolu na prednjoj prikolici i kabini. <br><br>Razmislite o tome na ovaj način - morate koristiti vodeću prikolicu da biste upravljali zadnjom prikolicom."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "U ovom slučaju, želimo da okrenemo zadnju prikolicu na stranu vozača. Da bismo je upravljali na ovaj način, potrebno je da gurnemo prednji deo zadnje prikolice na stranu suvozača. <br><br>Obratite pažnju da to u suštini znači da morate okrenuti vodeću prikolicu u suprotnom smeru od onoga u kom želite da upravljate zadnjom prikolicom."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Kada zadnja prikolica počne da okreće, neophodno je ispraviti tegljač sa vodećom prikolicom. Tu većina ljudi često pravi svoju prvu grešku."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Ovde vidimo da vozač nije uspeo da prati vođstvo i da će preklopiti svoje prikolice."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Do savijanja vozila u kombinaciji dolazi kada ugao između bilo koja dva vozila u kombinaciji postane oko 90°. Kada se to desi, nema spasa - morate krenuti napred i pokušati ponovo. <br><br> Kao i kod vožnje jedne prikolice unazad, cilj treba da bude da se svi točkovi na prikolicama okreću. Ako se jedan točak zaustavi i prikolica se okreće u mestu, ne možete nastaviti."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Možete se pomeriti napred do mesta gde ste poslednji put bili ispravni, odnosno do položaja gde možete nastaviti da radite unazad, a da ponovo ne napravite istu grešku. <br><br>U ovom slučaju, povući ćemo se napred u ravni položaj i pokušati ponovo ispočetka."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Još jednom, kada zadnja prikolica počne da se okreće, postavite tegljač ispred vodećeg dela i pustite da se zadnja prikolica sama okrene na trenutak."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Sada kada se zadnja prikolica okreće tamo gde želimo, vreme je da usmerimo vodeći deo da je prati. Možete podesiti ugao između vodećeg i zadnjeg dela da biste kontrolisali skretanje i učinili ga oštrijim ili širim."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Poslednji deo manevra je ispravljanje svega. Poravnajte vođstvo sa zadnjim delom."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Trebalo bi da imate na umu koliko će vremena biti potrebno da se pomeri vodeća prikolica, ako čekate predugo, zadnja prikolica će na kraju pokušati da se vrati tamo odakle ste upravo došli!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Slobodno provedite ovde koliko god vremena želite, eksperimentišite sa različitim manevrima dok ne pomislite da imate otprilike predstavu o tome kako da manipulišete prikolicama unazad. <br><br>Ali najvažnije od svega, zapamtite da se zabavite!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Pripremite se za polazak."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Koristite ovaj parking da biste stekli osećaj za rukovanje prikolicama unazad. <br><br>@@aca_goal_tip@@ Novi ste u praćenju prikolica uopšte? Razmislite o igranju igre Osnove vožnje kamiona."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Vežbajte koliko god želite. <br><br>Kada ste zadovoljni, možete zaustaviti i obezbediti kamion kako biste okončali scenario."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Ugasite motor da biste završili scenario."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkiranje u uskom prostoru"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "U ovom scenariju, zadatak vam je da parkirate set duplih prikolica u uskom prostoru."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Započnite"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Krenite"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Nastavite vožnju"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zaustavljanje"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Obezbedite vozilo"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Vožnja sa duplim prikolicama može delovati zastrašujuće, ali nema mnogo više od vožnje sa jednom prikolicom - samo morate uzeti u obzir i putanju zadnje prikolice!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Ispred vas je usko parking mesto. Nećete imati dovoljno prostora da se potpuno ispravite pre ulaska, pa ćete morati pažljivo razmisliti kako ćete se uvući sa obe prikolice."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Odmah skrenite ka suprotnoj strani parking mesta i vozite daleko dalje od mesta gde biste obično skrenuli."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Sada kada je vaša zadnja prikolica na pravom putu, možete krenuti ka tom mestu; samo se pobrinite da ponovo krenete prema suprotnoj strani kako biste pomogli da dođete sa prvom prikolicom."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Nastavite do mesta, a obe prikolice će vas pratiti i ispravljati se dok idete."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parkirajte na određenom području i obezbedite kamion."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Pripremite se za polazak."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Nastavite napred i uđite u uski prostor."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Nastavite vožnju."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Zaustavite se na određenom području."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Obezbedite kamion i ugasite motor."
#@}


