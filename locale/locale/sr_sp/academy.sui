#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Kombinovani manevri vožnje"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "U ovom scenariju, kombinovaćemo vaše novonaučene veštine da bismo pregovarali o kratkom, ali tehničkom kursu koji će uključivati preokret u skretanje i upravljanje uskim uglom od 90°."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Vožnja unazad na vozačevu stranu"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Skretanje od 90 stepeni"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Završavanje skretanja"
#!{
	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Pred vama je barijera. Dovezite se do nje i stanite."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Iza kamiona na strani vozača nalazi se još jedna barijera. Okrenite se oko krivine do njega. Oznake na putu se mogu koristiti kao vodič."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Direktno ispred nas je oštro skretanje od 90°. Vozite ka njemu."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Moraćemo da zađemo duboko u ugao kako bi zadnji točkovi očistili saobraćajni čunj na unutrašnjem uglu.<br>Koristite svoje retrovizore!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Ispravite se, vozite prema poslednjim barijerama, a zatim stanite i osigurajte kamion."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Kamion još uvek nije spreman za pokret, možda ste nešto zaboravili?<br><br>Je li motor upaljen? Da li ste otpustili parkirnu kočnicu?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Pravo ispred vas je obeleženo mesto neposredno pre barijere.<br><br><font face=/font/big_bold.font>Vozite napred i stanite na označenom mestu. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Pogledajte iza sebe na strani vozača; Tamo ćete videti još jedno obeleženo mesto. Moraćete da kombinujete vožnju unazad sa okretanjem u isto vreme.<br><br><font face=/font/big_bold.font>Okrenite se unazad oko krivine i stanite na označenom mestu. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Staza se nastavlja ispred vas kroz zaokret od 90 stepeni.<br><br>Ostanite na strani vozača pre skretanja, uđite duboko u ugao i skrenite brzo i oštro. Pazite da ne udarite u unutrašnji saobraćajni čunjak.<br><br><font face=/font/big_bold.font>Vozite napred i skrenite. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Koristite svoje prednje i bočne retrovizore kako biste bili sigurni da ništa ne udarite.<br><br><font face=/font/big_bold.font>Završite skretanje i zaustavite se u predviđenom području. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Ugasite motor i osigurajte kamion.</font>"
#@}

