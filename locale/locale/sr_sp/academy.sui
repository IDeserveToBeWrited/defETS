#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Za konačni scenario ovog poglavlja, vozićemo se na probnoj stazi sa složenom konfiguracijom."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Prva prepreka je slalom kroz neke barijere. Vozite se kroz njih i ne zaboravite da koristite svoje retrovizore."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Sledeće je okretanje ukosnice. Držite skretanje širokim i ne bi trebalo da vam predstavlja probleme."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Ovde je skretanje levo od 90°. Ne zaboravite da vozite duboko tako da zadnji deo kamiona očisti unutrašnje prepreke."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Prepreka na rampi može biti malo nezgodna. Poravnajte se najbolje što možete pre nego što krenete na njega i koristite prednje i bočne retrovizore da biste se lakše orijentisali."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Sledeći odeljak mora da se uradi obrnuto. Imajući to na umu, pristupite barijerama ispred vas."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Pratite oznake na putu nazad i desno od vas."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Vratite se unazad do barijera, zatim se zaustavite i nastavite napred levo."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Nastavite kroz odmorište u sredini do sledećeg odeljka."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Ovaj prolaz kroz čunjeve je veoma uzak. Vozite polako i koristite retrovizore da biste se orijentisali u prolazu."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Ne zaboravite da vozite duboko na skretanjima od 90°."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Ulazite na lep otvoren deo puta. Možete povećati brzinu, ali imajte na umu da ćete uskoro morati da usporite za krivinu koja je napred."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "U podnožju brda ima barijera preko puta. Vozite do njih, a zatim krenite unazad do parking mesta sa leve strane."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Nazad do parking mesta."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parkirajte, zatim ugasite motor i osigurajte kamion."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Pred vama je slalom napravljen od barijera.<br><br><font face=/font/big_bold.font>Vozite kroz slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Držite se prema spoljašnjoj strani skretanja kako zadnji deo tegljača ne bi prešao preko ivičnjaka.<br><br><font face=/font/big_bold.font>Napravi skretanje. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Dolazite do skretanja od 90° levo. Ne zaboravite da iskoristite sav raspoloživi prostor.<br><br><font face=/font/big_bold.font>Napravi skretanje. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Poravnajte se sa rampom. Nema puno prostora za ispravke kada ste na njemu.<br><br><font face=/font/big_bold.font>Vozite preko rampe. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Pratite kurs levo. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Sledeća oblast se mora popuniti obrnuto. Zaustavite se na barijerama ispred vas da biste posle toga mogli da skrenete udesno.<br><br><font face=/font/big_bold.font>Zaustavite se kod barijera.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Okrenite se unazad prema području iza vas i udesno. Na putu se nalaze strelice koje vam mogu pomoći.<br><br><font face=/font/big_bold.font>Okrenite se prema sledećem odeljku. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Nastavite da se krećete unazad prema preprekama iza vas.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zaustavite se i prebacite u brzinu za napred, a zatim nastavite levo. <br><br><font face=/font/big_bold.font>Vozite napred. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Postoji prekid u sredini levo. Vozite se kroz njega.<br><br><font face=/font/big_bold.font>Nastavite napred. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Pred vama je uska vijugava staza kroz neke čunjeve. Vozite pažljivo i koristite svoje retrovizore ako je potrebno.<br><br><font face=/font/big_bold.font>Vozite kroz čunjeve. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Nastavite putem smera.<br><br><font face=/font/big_bold.font>Skrenite levo. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Ne zaboravite da držite levo pre skretanja da biste sebi dali što više prostora.<br><br><font face=/font/big_bold.font>Napravi skretanje. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Ovde možete da povećate brzinu, ali pred vama dolazi krivina.<br><br><font face=/font/big_bold.font>Nastavite duž smera. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Krivina postaje oštrija dok se probijate kroz nju.<br><br><font face=/font/big_bold.font>Prilagodite svoju brzinu u skladu sa tim i nastavite.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "U podnožju brda videćete prepreke koje blokiraju put. <br><br><font face=/font/big_bold.font>Zaustavite se blizu barijera. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Iza vas i sa leve strane nalazi se parking mesto.<br><br><font face=/font/big_bold.font>Pređite unazad na parking mesto. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Stanite na označenom mestu. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Vožnja na stazi za rukovanje"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "U ovom scenariju, provozaćemo se stazom dizajniranom da testira vašu sposobnost da upravljate kamionom kroz različite vrste krivina i uglova."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Ulazak na poligon"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Pravljenje postepenog levog skretanja"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Vožnja kroz S-krivine"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Prava oblast"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Lako skretanje"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Izlazak sa kursa obuke"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Približavanje parking mestu"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "U ovom scenariju, odvešćemo tegljač na kratku vožnju da vidimo kako se nosite sa njim sa svojim novostečenim veštinama."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Na stazi postoje razne vrste i kombinacije skretanja. To nije trka i nije vreme. Budite strpljivi i prilagodite brzinu vožnje skretanjima i preprekama na koje nailazite."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Na početku staza je blaga i laka, ali sve više skretanja će postajati složeniji kako idete."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Vodite računa o svojoj brzini; lako je krenuti prebrzo i onda pogrešno proceniti skretanje."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Izlaz sa staze je vrlo usko skretanje. Idite polako i iskoristite sav raspoloživi prostor."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parkirajte između barijera i obezbedite kamion."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Da biste uspešno završili ovaj scenario, ne smete se sudariti, sleteti sa staze ili udariti u saobraćajne čunjeve.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Nastavite napred do oštrog desnog skretanja da biste ušli na kurs. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Vozite kroz skretanje lepom stalnom brzinom. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Približavate se složenijem delu zavoja.<br><br><font face=/font/big_bold.font>U skladu sa tim prilagodite brzinu i nastavite.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Nastavite ka sledećem nizu skretanja.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Predstoje neki laki, blagi zaokreti. Održavajte brzinu.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Skretanje sa kursa je oštar okret. Usporite i ostanite prema spolja pre skretanja. Obavezno koristite svoje retrovizore!<br><br><font face=/font/big_bold.font>Skrenite van od kursa. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Ispred vas je parking mesto između nekoliko barijera.<br><br><font face=/font/big_bold.font>Nastavite prema parking mestu. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Paralelno parkiranje"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "U ovom scenariju, pogledaćemo paralelno parkiranje između dva druga kamiona."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zaustavljanje ispred parking mesta"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Provera pozadi pogled na retrovizor"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Vožnjom unazad na parking mesto"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Poravnavanje kamiona unutar parking mesta"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Paralelno parkiranje je ključna veština koju treba da zna svaki kamiondžija.<br>Pripremite se za polazak."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Vozite ka parking mestu.<br>Obratite pažnju na okolinu."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Poravnajte se s kamionom ispred vašeg parking mesta. Nemojte mu biti previše blizu, držite se na malom odstojanju od njega da biste imali prostora za rad."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Okrenite oštro prema prostoru i počnite da vozite unazad."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Kada gledate u retrovizor sa strane vozača, ciljajte na ivičnjak odmah ispred kamiona iza vas."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Kada vaš prednji branik oslobodi kamion ispred vas, možete početi da upravljate prednjim krajem kamiona na mesto, poravnavajući kamion sa parking mestom."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ispravite točak i centrirajte kamion u okviru parking mesta.<br>Parkirajte i obezbedite kamion."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Ispred vas su parkirani kamioni. Ostalo vam je jedno otvoreno mesto na kome možete da parkirate. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Zapamtite da budete svesni svog okruženja. Iskoristite dobro retrovizore tokom ovog manevra. <br><br><font face=/font/big_bold.font>Vozite napred. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Vozite pored parking mesta i uđite u obeleženo područje. Odatle možete započeti svoj manevar vožnjom unazad.<br><br><font face=/font/big_bold.font>Stanite na označenom mestu. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Proverite da li se u vašem okruženju nalaze prepreke i da se uverite da ste slobodni za vožnju unazad.<br><br><font face=/font/big_bold.font>Pogledajte kroz suvozačev retrovizor. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Okrenite točkove i krenite unazad do parking mesta.<br><br><font face=/font/big_bold.font>Počnite da vozite unazad. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Počnite da ispravljate kamion kada je to potrebno. Ne vozite preko ivičnjaka!<br><br><font face=/font/big_bold.font>Poravnajte kamion sa mestom. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
