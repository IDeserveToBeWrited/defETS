#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Zaustavljanje blizu prepreke"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "U ovom scenariju, razgovaraćemo o prednjem retrovizoru - njegovoj lokaciji i kako ga efikasno iskoristiti da se zaustavi blizu prepreke ispred."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Proverite prednji retrovizor"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Shvatanje njegove funkcije"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Zaustavljanje u blizini prepreke"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Kamioni imaju veliku mrtvu tačku u prostoru ispred tegljača. Lako je izgubiti iz vida pešaka ili čak automobil u ovoj oblasti, pa su kamioni opremljeni prednjim retrovizorom koji se vidi kroz vetrobran."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Prednji retrovizor je dizajniran da omogući vozaču pogled u ovu mrtvu tačku.<br>To je suštinski alat koji osigurava da se ne sudarite ni sa kakvim preprekama prilikom manevrisanja u uskim prostorima."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Počnite da vozite, nastavite ka barijeri ispred vas, a zatim usporite dok joj se približavate.<br>Zadržite oči na prednjem retrovizoru."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Stanite između linije i prepreke."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "U ovom scenariju, naučićemo da koristimo prednji retrovizor prikazano na dijagramu.<br><br><font face=/font/big_bold.font>Pogledajte kroz gornji deo vetrobrana da ga vidite.</font>@@aca_goal_tip@@ Morate biti u vozilu."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Prednji retrovizor vam omogućava da vidite slepu tačku ispred kamiona. Može vam pomoći da budete sigurni i precizni u vožnji.<br><br>Ako niste zadovoljni podešavanjem, otvorite '@@adjust_link_t@@' (može se pristupiti preko menija za pauzu) da biste ga prilagodili svom ukusu.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ da se nastavi. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Pravo ispred kamiona je obeleženo mesto. Primetićete da postoji prepreka na drugoj strani mesta; kada ste blizu njega, vozite veoma sporo i proverite rastojanje do prepreke u prednjem retrovizoru.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Kamion još uvek nije spreman za pokret, možda ste nešto zaboravili?<br><br>Je li motor upaljen? Da li ste otpustili parkirnu kočnicu?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Vozite ka parking mestu. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Zaustavite prednji deo kamiona između prepreke i ofarbane oznake na putu. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

