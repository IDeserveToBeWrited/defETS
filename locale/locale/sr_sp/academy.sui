#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Dijagonalno parkiranje"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "U ovom scenariju, parkiraćete na dijagonalnom parking mestu na prometnom mestu. <br><br>Nema puno prostora za manevrisanje, tako da ćete morati da budete veoma precizni i promišljeni u vožnji."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Približavanje parking mestu"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Ovakva dijagonalna parking mesta su veoma česta. Posebno su česti u mnogim odmorištima koja se nalaze pored evropskih autoputeva. <br>Još jednom ćemo morati da se „provučemo“ na parking mesto ispred nas."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Vozite prema naznačenom parking mestu blizu kraja reda."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Ostanite prema sredini trake, ili blago na strani vozača. Ne vozite preblizu barijera ili bi zadnji deo prikolice mogao da ih udari tokom skretanja."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Poprilično vozite pored parking mesta, a zatim snažno i brzo skrenite ka tom mestu. Moraćete da pazite na oba bočna retrovizora: vozačev bočni retrovizor kako biste bili sigurni da prednji deo vaše prikolice ne udari u prikolicu pored vas, i suvozačev retrovizor da biste videli da vaša prikolica bezbedno ulazi na parking mesto."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Zaustavite se na predviđenom mestu, obezbedite kamion i ugasite motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Kada parkirate dijagonalno, važno je da tačno procenite svoju poziciju. Kada uđete u skretanje, teško je bezbedno preokrenuti i promeniti poziciju, tako da je idealno da se u prvom pokušaju uverite da imate dovoljno prostora.<br><br><font face=/font/big_bold.font>Pripremite se za polazak.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Počnite da vozite prema parking mestu. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Prođite pored parking mesta tako da vaša prikolica ima prostora da se okrene oko kamiona iznutra.<br><br><font face=/font/big_bold.font>Skrenite na parking mesto. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Slepa strana unazad"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "U ovom scenariju, posmatraćemo „slepu stranu“ koja preokreće kamion u parking mesto. Bez mogućnosti da pogledate kroz prozor da vidite kuda idete, moraćete da se oslonite samo na svoje retrovizore da biste bili tamo gde treba da idete."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "U ovom scenariju, naučićete manevar „slepe strane“ unazad. Uopšteno treba izbegavati slepljenje, osim ako nema alternative, pošto je vaša vidljivost ozbiljno ograničena. Uzmite si vremena i budite krajnje oprezni."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Vozite daleko pored parking mesta da biste sebi dali prostora za posao kada krenete voziti unazad."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Zaustavite se, proverite okolinu, a zatim počnite da vozite unazad."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Okrenite tegljač dalje od mesta. Ovo će gurnuti prednji deo prikolice i zauzvrat usmeriti zadnji deo prikolice ka parking mestu na koje želite da uđete. Pazite da ne preterujete ili možete da rizikujete da kombinujete."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Kada prikolica uđe na mesto za parkiranje, počnite da ispravljate kamion."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Zaustavite se na određenom mestu i obezbedite kamion."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Slepo kretanje unazad zahteva iste procedure kao i okretanje unazad, ali ćete biti hendikepirani nedostatkom vidljivosti na toj strani. Koristite svoje retrovizore i svoju najbolju procenu da parkirate kamion.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Ispred i na strani suvozača je parking mesto. Moraćete dobro da prođete pored njega da biste imali prostora za manevrisanje dok se krećete unazad.<br><br><font face=/font/big_bold.font>Vozite napred. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Zapamtite, okretanje kamiona dalje od mesta će okrenuti prikolicu prema njemu. Koristite svoje retrovizore koliko god možete da vam pomognu da uđete na parking mesto.<br><br><font face=/font/big_bold.font>Počnite da vozite unazad. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Vožnja na kružnom toku"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "U ovom scenariju, pogledaćemo kako da pregovaramo o kružnom toku.<br><br>Moraćete da obratite posebnu pažnju na svoju prikolicu jer će se ona kretati iza vas drugačije dok ulazite, vozite kroz kružni tok i kada izlazite."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Ulazak u kružni tok"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Vožnja u kružnom toku"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Vožnja u kružnom toku"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Izlazak iz kružnog toka"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Vožnja do označenog područja"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Kružni tokovi su veoma česti na ulicama Evrope, tako da je važno znati kako da pregovarate sa njima."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Držite se van svoje trake dok se približavate kružnom toku. Ovo će pomoći vašoj prikolici da očisti unutrašnjost od početnog skretanja."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Vozite ka centru kružnog toka dok ulazite. Kada uđete, moraćete da se uputite prema spolja. Ovo je da vaša prikolica bude udaljena od centra kružnog toka."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Zadržite svoje oči na retrovizore kako biste bili sigurni da se prikolica ne približava unutrašnjim preprekama."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Napuštanje kružnog toka je prilično lako jer je vaša prikolica već postavljena dalje od unutrašnjeg dela izlaza. Široko zaokrenite na izlazu i prikolica treba da ide lepo."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parkirajte na određenom području i obezbedite kamion."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Ispred vas je postavljen kružni tok na kojem možete da vozite. <br><br><font face=/font/big_bold.font>Polako se približavajte kružnom toku. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Skrenite široko kada ulazite u kružni tok tako da će vaša prikolica ući iza vas bez problema. <br><br><font face=/font/big_bold.font>Uđite u kružni tok. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Vozite prema spoljašnjoj strani kružnog toka. Kamion ćete morati da držite što dalje od centra kružnog toka kako biste držali prikolicu dalje od središnjih barijera. <br><br><font face=/font/big_bold.font>Nastavite kroz kružni tok.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Ostanite blizu spoljnih čunjeva. <br><br><font face=/font/big_bold.font>Zadržite vožnju.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Izađite iz kružnog toka.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Nastavite do parking mesta ispred.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se na određenom području.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Obezbedite kamion i ugasite motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manevrisanje u uskom prostoru"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Za konačni scenario, imaćete zadatak da okrenete kamion u uskom prostoru. To će zahtevati od vas da pređete na slepu stranu u oblasti sa ograničenim prostorom za manevrisanje, što će zahtevati pažnju na vaše okruženje i pametno korišćenje prostora."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Vožnja do poligona"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Podešavanje za slepu stranu"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Vožnja unazad u mesto"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Dovršavanje slepe strane"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Izlazak sa poligona"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "U ovom scenariju, preći ćemo na to kako da se okrenemo u uskom prostoru sa manevrom za slepu stranu unazad. Ova veština će vam biti od koristi kada ne možete da se okrenete ili vratite na stranu vozača."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Oznake na putu pomoći će vam da se krećete kroz kurs obuke."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Napravite široki okret kako biste bili sigurni da će prikolica izbeći parkirane kamione."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Dok izlazite iz skretanja, razmislite o tome kako ćete podesiti kamion za svoj manevar unazad."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Pomaže vam da kamion bude pod uglom usmeren ka praznom parking mestu na strani vašeg suvozača, gde ćete kretati unazad."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Kada je to moguće, treba izbegavati slepo kretanje unazad jer je vidljivost znatno manja. Nažalost, postoje trenuci kada nećete imati drugog izbora osim da to uradite."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Okrenite volan pre kretanja unazad. Ovo će pomoći da se vaša prikolica odmah usmeri tamo gde želite, što pomaže u veoma tesnim situacijama."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Kada je prikolica dobro postavljena, postavite tegljač ispred prikolice i ispravite je."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Zaustavite se kada se ispravite i imajte dovoljno prostora da se ponovo povučete napred. Počnite da se vraćate istim putem kojim ste ušli."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Pratite oznake puta van kursa za obuke."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Vozite kroz krivinu ispred i nastavite do označenog područja."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Zaustavljanje."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Obezbedite kamion i ugasite motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "U oblasti ispred vas nalazi se kurs obuke koji predstavlja parcelu brodarske kompanije. Vaš zadatak je da uđete unutra i okrenete kamion da se vrati. Obavezno dobro iskoristite prostor oko sebe.<br><br><font face=/font/big_bold.font>Pripremite se za polazak </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Nastavite prema kursu obuke. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Skrenite na uglu i nastavite kroz kurs. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Pratite oznake na putu do barijere na kraju staze. Parkirajte malo pod uglom tako da vaša prikolica bude usmerena ka praznom parking mestu na strani vašeg suvozača.<br><br><font face=/font/big_bold.font>Nastavite napred. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Imate mnogo ograničeniji pogled na ono što se dešava oko vas kada ste slepi. Idite polako, koristite retrovizore i budite oprezni.<br><br><font face=/font/big_bold.font>Započnite vožnju unazad i okrenite prikolicu na prazno mesto za parkiranje. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "To je dovoljno daleko. Sada možete nastaviti napred i krenuti sa terena za obuku iz istog pravca iz kojeg ste došli.<br><br><font face=/font/big_bold.font>Počnite pravo da idete prema izlazu. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Izađite iz kursa obuke. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Pratite oznake na putu do finalnog parking mesta.<br><br><font face=/font/big_bold.font>Nastavite do odredišnog područja. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Ofsetni manevar unazad"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "U ovom scenariju, imaćete zadatak da se vratite na parking mesto koje nije direktno iza vas. Postoji ograničen prostor za manevrisanje, tako da morate mudro koristiti svoj prostor."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "U ovom scenariju, vaš zadatak će biti da parkirate u prostoru koji se nalazi pored vas. Nema mnogo prostora za manevrisanje, tako da ćete morati da uradite malo dodatnog posla da biste dovezli prikolicu tamo gde želite."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Vozite pravo do barijere."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Stanite pre barijere."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Okrenite volan oštro na stranu vozača pre nego što krenete. Na ovaj način ćete početi da okrećete prikolicu ka parking mestu čim počnete da se krećete unazad, štedeći dragoceni prostor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Kada usmerite prikolicu tamo gde želite, postavite tegljač ispred prikolice i počnite da je upravljate na parking mesto."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Od ovog trenutka pa nadalje, ne razlikuje se toliko od običnog manevara parkiranja."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Zadržite vožnju unazad i posmatrajte obe strane. Držite tegljač i prikolicu u liniji sa parking mestom."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zaustavite se na predviđenom mestu, obezbedite kamion, i ugasite motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Nalazite se na parking mestu, ali sa vaše desne strane postoji drugo parking mesto na koje morate da se pomerite.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Ispred vas je obeleženo područje.<br><br><font face=/font/big_bold.font>Vozite napred. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ne zaboravite da odmah počnete da upravljate, jer nema mnogo prostora.<br><br><font face=/font/big_bold.font>Vozite unazad do označenog mesta iza vas. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Vožnja kroz jednostavna skretanja"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "U ovom scenariju, proći ćete kratku vožnju kroz kurs obuke koji će vam pomoći da naučite da manevrirate prikolicom oko jednostavnih uglova od 90°."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Pravljenje prvog skretanje"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Drugo skretanje"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Finalno skretanje"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Pred vama su uska skretanja sa malo prostora. Ovo će vam pomoći da naučite da efikasno upravljate prikolicom."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Pratite oznake na putu prema barijeri na strani vozača da biste se pripremili za prvo skretanje."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Ostanite blizu spoljne barijere kroz skretanje i prikolica bi trebalo da vas lepo prati na stazi."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Nastavite da pratite oznake na putu da biste se postavili za drugo skretanje, uski ugao od 90°."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Moraćete da se odvezete duboko u ugao kako biste bili sigurni da će vaša prikolica očistiti unutrašnje prepreke. Koristite prednje retrovizore da vam pomogne da odete što dalje u ugao, a da ne udarite ništa."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Nastavite duž spoljne barijere."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Još jednom, još jedan uski ugao od 90° zahtevaće da koristite sav prostor koji vam je na raspolaganju."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Zaustavite se na određenom mestu i obezbedite kamion."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Ne zaboravite da koristite sav prostor koji vam je na raspolaganju da vam pomogne da pregovarate o svakom skretanju.<br><br><font face=/font/big_bold.font>Krenite i pratite oznake na putu ka spolja. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Pratite spoljnu barijeru unaokolo, ali držite na oku svoju prikolicu u retrovizoru.<br><br><font face=/font/big_bold.font>Napravite prvo skretanje. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Pratite oznake na putu da biste se podesili za skretanje od 90°.<br><br><font face=/font/big_bold.font>Napravite skretanje od 90°. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Držite kamion širokim nakon skretanja, jer pred vama je još uže skretanje od 90°.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Nastavite do parking mesta ispred. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Dijagonalno parkiranje u vožnji unazad"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "U ovom scenariju, istražićemo parkiranje dijagonalno pri kretanju unazad. Ovo se može desiti na odmorištima, stajalištima kamiona, pa čak i kod pošiljalaca. Često je malo prostora jer su parcele krcate kamionima, pa je parkiranje utoliko teže zbog nedostatka prostora."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Dijagonalno parkiranje se na prvi pogled čini lakšim, ali često može biti izazovnije od tipičnih manevara „ulicom unazad“."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Vozite unazad prema parking mestu. Za sada držite tegljač i prikolicu ravno."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Dok se približavate, pustite prikolicu da se približi parkiranim kamionima. Ovo će vam pomoći skrenete u mesto kada stignete do njega."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Počnite da okrećete prikolicu u parking mestu. Držite prikolicu blizu kamiona na strani vozača, jer će vam trebati prostor na drugoj strani."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Kada je prikolica dobro na mestu za parkiranje, počnite da okrećete tegljač kako biste pratili prikolicu."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parkirajte na za to predviđenom mestu, obezbedite kamion i ugasite motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parkirajte kamion u prostor iza vas. Koristite oba vaša retrovizora za navigaciju u vašoj vožnji unazad.<br><br><font face=/font/big_bold.font>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Proverite svoje okruženje, a zatim idite ka parking mestu.<br><br><font face=/font/big_bold.font>Počnite vožnju unazad.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Počnite da pomerate prikolicu prema kamionima pored vas. Kada budete spremni, okrenite prikolicu na parking mesto. Ne zaboravite da uzmete u obzir zamah repa prikolice.<br><br><font face=/font/big_bold.font>Skrenite na parking mesto. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Vozite unazad u skretanju"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "U ovom scenariju, prvi put ćemo se kretati unazad sa prikolicom u skretanje. Istražićemo osnovne principe vožnje unazad i na šta treba obratiti pažnju kada se skreće unazad."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "U ovom scenariju, moraćete da se vratite unazad do parking mesta koje je iza vas na strani vašeg vozača."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Treba zapamtiti nekoliko saveta koji će vam mnogo pomoći vožnjom sa prikolicama unazad. <br>Prvi je taj što će prikolica uvek želeti da se okrene u suprotnom smeru od načina na koji upravljate tegljačem."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Drugi je da možete dobiti dobar osećaj kuda se prikolica kreće posmatrajući osovine kamiona i prikolice."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Treće, mali unosi će vas odvesti tamo gde treba da idete, bez potrebe da se previše opterećujete."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Počnite lagano da okrećete tegljač od parking mesta, a prikolica će početi da pokazuje ka njemu."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Pratite prikolicu, prilagođavajući se dok idete da biste je držali na pravom putu."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Gledajte svoje točkove prikolice i zadnji točak tegljača. Oni će vam reći gde je prikolica usmerena, a gde tegljač gura."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Četvrti savet je da je uvek lakše okrenuti prikolicu oštrije nego pokušati da je ispravite nožem. Ciljajte ka spoljašnjoj strani mesta dok joj se ne približite, a zatim možete da skrenete malo oštrije da poravnate svoju prikolicu."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Dok prikolica ulazi na parking mesto, stavite tegljač ispred prikolice. Pokušajte da izbegnete previše podešavanja unutar mesta."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Vozite između barijera unazad, proverite obe strane dok idete."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Obezbedite kamion i ugasite motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Zapamtite ove savete kada prelazite u vožnju unazad sa prikolicom:<br><br>— Prikolica se okreće suprotno od načina na koji upravljate tegljačem<br><br>— Gledajte točkove prikolice da vidite kuda cilja<br><br>— Gledajte zadnji točak tegljača da vidite gde gura prikolicu<br><br>— Pustite prikolicu da odradi posao, nemojte je preupravljati<br><br>— Uvek je lakše okrenuti prikolicu oštrije nego je ispraviti<br><br><font face=/font/big_bold.font>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Pogledajte iza sebe da biste pronašli gde treba da idete. Uvek proverite svoje okruženje pre nego što počnete da vozite unazad.<br><br><font face=/font/big_bold.font>Počnite da vozite unazad ka parking mestu. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Počnite da okrećete prikolicu ka parking mestu i pratite je.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se u označeno mesto. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Parkiranje unazad na uskoj parceli"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "U ovom scenariju, imaćete zadatak da vozite unazad prikolicu na mesto za parkiranje na prometnom mestu."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Ovo je tipičan parking za kamione. Kamiondžije će se susresti sa ovakvom situacijom parkiranja skoro svakodnevno u svojoj karijeri.<br>Parkiranje ovde zahteva manevar „parkiranje u uličici“."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Ovo je sličan manevar prethodnom scenariju, ali ćete imati manje prostora za rad, tako da ćete morati da planirate svoje poteze u skladu sa tim i pazite da ništa ne udarite."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Pošto ima manje prostora, vaš tajming je važniji. Okrenite prikolicu u pravo vreme i posmatrajte tegljač i točkove prikolice da vidite kuda će ići. Imajte na umu zamah repa i zapamtite da ne udarate nožem - nastavite da gurate prikolicu."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Pokušajte da se držite blizu kamiona na strani vozača, ovo daje vašoj prikolici prostor da se zamahne i manje ćete brinuti o kamionu na strani suvozača."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Kada je vaša prikolica na mestu, stavite tegljač ispred nje. Bolje je to učiniti malo ranije nego što bi vas instinkt u početku mogao navesti. Uvek ga možete ispraviti kao naličje na svoju konačnu poziciju."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Ispravite tegljač i prikolicu i zaustavite se na predviđenom mestu."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Obezbedite kamion i ugasite motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Sada ćemo pokušati da okrenemo prikolicu na mnogo manjoj površini sa manevrom „ulicom unazad“. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Proverite svoju okolinu i potražite mesto za parkiranje iza sebe. <br><br><font face=/font/big_bold.font>Počnite da vozite unazad ka parking mestu. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Okrenite prikolicu na parking mesto. </font>"
