#!}
#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "IZABERITE REŽIM MAPIRANJA STEAM ULAZA" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Predstavljamo novi <color value=@@clr_sel@@>Režim mapiranja u igri<color value=@@clr_txt@@>, koji podržava potpune konfiguracije vezivanja tastera u igri i bolje savete za dugmad. Ovo je preporučeni režim.<br><br>Keep <color value=@@clr_sel@@>Režim mapiranja Steam klijenta<color value=@@clr_txt@@> ako ste prilagodili izgled svog gejmpada preko Steam klijenta.<br><br>Možete promeniti režim bilo kada u opcijama pomoću čarobnjaka za unos." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Zadržite Steam klijentski režim" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Otvori Čarobnjaka za unos" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Režim mapiranja ulaza za Steam" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Mapiranje u igri" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Mapiranje Steam klijenta" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bira režim za gejmpade kao što je @@controller_ps5@@, @@controller_xbox_one@@ ili @@controller_steam_deck@@ se uključio u interfejs za unos Steam-a.<br>Mapiranje Steam klijenta - Korišćenje samostalnih izgleda konfigurisanih preko Steam klijenta. Ograničena podrška za nagoveštaje dugmadi u igri i bez konfiguracija vezivanja u igri.<br>Mapiranje u igri - Korišćenje univerzalnog jednostavnog rasporeda. Podržava pune konfiguracije vezivanja tastera u igri i bolje savete za dugmad. Preporučljivo je da pokrenete čarobnjak za unos kada prelazite na ovaj režim. Ovo je preporučeni režim."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Steam Kontroler"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Steam Ulazni Kontroler"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Sinhronizacija u 'Steam' oblaku:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Koristite stariju verziju igre.<br>Steam će automatski ažurirati igru ako automatska ažuriranja nisu onemogućena."
#@}

	key[]: "steam_demo"
	val[]: "Ako vam se dopao Evro Kamion Simulator 2 demo, molimo kupite punu verziju na <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Evro Kamion Simulator 2 ne može da pristupi Steam klijentu. Preporučujemo:\n\n1. Proverite da li je klijent pokrenut.\n2. Proverite da li imate ažuriranu verziju klijenta.\n3. Proverite da li je uključeno automatsko ažuriranje i da li je igra poslednja verzija."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Deo trenutno instaliranog sadržaja za preuzimanje nije kompatibilan sa trenutnom verzijom igre i biće onemogućen. Molimo vas da proverite integritet keš memorije igre na Stemu.<br><br>Sledeći sadržaj je nekompatibilan:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Nije moguće da se kreira Steam profil sa datim imenom, jer već postoji profil sa tim imenom." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Ne možete migrirati profil, drugi profil sa istim imenom već postoji." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Migracija profila nije uspela." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Sinhronizacija sa Steam oblakom" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "Vaš Steam oblak ima dovoljno prostora da vaše datoteke sačuva." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Ponestaje vam prostora na Steam oblaku!<color value=@@clr_txt@@><br><br>Molimo vas da uklonite neke sačuvane datoteke da biste nastavili. Evo nekih informacija koje će vam pomoći:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Prekoračeni prostor: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Prekoračeni fajlovi:<color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Iskorišćen prostor na Steam oblaku: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Fajlovi na Steam oblaku: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "Izabrano čuvanje <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> ima <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>u <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> fajlovima." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Ponestalo vam je prostora na Steam oblaku. Uklonite neke sačuvane fajlove da biste nastavili.<br><br>Molimo vas da pročitate detaljne informacije na desnoj tabli." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Prelaskom na tip lokalnog profila, ovaj profil će biti dostupan od sada samo na ovom računaru, bez obzira na prijavljeni Steam nalog. " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Migracija profila nije uspela. Podaci nisu preneti, a sistem je sačuvao originalni profil. Molimo pokušajte ponovo." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

