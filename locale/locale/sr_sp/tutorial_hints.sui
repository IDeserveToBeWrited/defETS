
    key[]: "hint_engine_title"
	val[]: "Pokrenite motor"

    key[]: "hint_engine_text"
	val[]: "Koristite $KEY_engine$ da upalite motor."


    key[]: "hint_ignition_title"
	val[]: "Pokrenite paljenje"

    key[]: "hint_ignition_text"
	val[]: "Koristite $KEY_engineelect|KEY_engine$ da pokrenete paljenje."


    key[]: "hint_driv_arc_title"
	val[]: "Vožnja"

    key[]: "hint_driv_arc_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ da se krećete napred ili nazad.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje."


    key[]: "hint_driv_auto_title"
	val[]: "Vožnja"

    key[]: "hint_driv_auto_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ da se krećete napred ili nazad.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje.<br><offset vshift=8>Pritisnite $KEY_gearup$ i $KEY_geardown$ za izbor brzine."


    key[]: "hint_driv_seq_title"
	val[]: "Vožnja"

    key[]: "hint_driv_seq_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ da se krećete napred ili nazad.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje.<br><offset vshift=8>Pritisnite $KEY_gearup$ i $KEY_geardown$ za kontrolu kvačila."


    key[]: "hint_driv_hshift_title"
	val[]: "Vožnja"

    key[]: "hint_driv_hshift_text"
	val[]: "Koristite $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ da se krećete napred ili nazad.<br><offset vshift=8>Koristite $SPECIAL_steering$ za upravljanje.<br><offset vshift=8>Promenite brzine sa <color value=@@clr_sel@@>menjač<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Približite se odredištu"

    key[]: "hint_depot_deliv_text"
    val[]: "Zaustavite se u označenom području da biste izabrali poslednju težinu parking mesta i zaradili odgovarajuće iskustvo."


    key[]: "hint_fin_deliv_title"
    val[]: "Završite isporuku"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkirajte na izabranom parking mestu. Možete pritisnuti $KEY_activate$ da ga preskočite kada ste blizu mesta isporuke."


    key[]: "hint_fin_deliv2_title"
    val[]: "Završite isporuku"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkirajte na izabranom parking mestu. Možete omogućiti vidžet u @@desktop_menu_category_options@@ da biste mogli da preskočite parkiranje."


    key[]: "hint_lights_title"
    val[]: "Upalite svetla"

    key[]: "hint_lights_text"
    val[]: "Koristite $KEY_light$ da aktivirate svetla. Prelazite kroz različite režime tako što ćete ga više puta pritisnuti."


    key[]: "hint_high_beam_title"
    val[]: "Aktivirajte duga svetla"

    key[]: "hint_high_beam_text"
    val[]: "Koristite $KEY_hblight$ da uključi duga svetla."


    key[]: "hint_wipers_title"
    val[]: "Aktivirajte brisače"

    key[]: "hint_wipers_text"
    val[]: "Koristite $KEY_wipers$ da biste aktivirali brisače i menjali različita podešavanja brzine."


    key[]: "hint_zoom_title"
    val[]: "Posmatrajući bliže"

    key[]: "hint_zoom_text"
    val[]: "Koristite $KEY_camzoom$ da zumirate dok ste u unutrašnjosti. Možete podesiti režim zumiranja da zadrži ili da se prebaci na @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Gledanje okolo"

    key[]: "hint_cam_int_text"
    val[]: "Koristite $KEY_cam1$ da biste promenili kameru na unutrašnji prikaz."


    key[]: "hint_cam_ext_title"
    val[]: "Gledanje okolo"

    key[]: "hint_cam_ext_text"
    val[]: "Možete menjati različite uglove kamere pritiskom $KEY_camcycle$.<br><offset vshift=8>Koristite $KEY_cam2$ da biste prebacili kameru na spoljašnji prikaz."


    key[]: "hint_indicators_title"
    val[]: "Indikatori"

    key[]: "hint_indicators_text"
    val[]: "Koristite $KEY_lblinker$ i $KEY_rblinker$ da uključite indikatore."


    key[]: "hint_tow_title"
    val[]: "Šlep služba"

    key[]: "hint_tow_text"
    val[]: "Ako ne možete da se izvučete iz teške situacije, možete koristiti šlep službu. Da biste joj pristupili, otvorite @@quick_info_word@@ meni koristeći $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Blokada diferencijala"

    key[]: "hint_diff_lock_text"
    val[]: "Ako ne možete da počnete, možda bi vam mogla pomoći blokada diferencijala. Koristite $KEY_diflock$ da biste ga aktivirali ili uključili automatsku blokadu diferencijala u @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Blokada diferencijala uključena"

    key[]: "hint_diff_unlock_text"
    val[]: "Trebalo bi da otključate diferencijal tokom redovne vožnje ili rizikujete njegovo oštećenje. Koristite $KEY_diflock$ da biste ga deaktivirali ili uključili automatsku blokadu diferencijala u @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Deaktivirajte brisače"

    key[]: "hint_wipers_off_text"
    val[]: "Koristite $KEY_wipers$ da deaktivirate brisače i prelazite kroz različita podešavanja brzine."


    key[]: "hint_world_map_title"
    val[]: "Prikaz mape"

    key[]: "hint_world_map_text"
    val[]: "Koristite $KEY_navmap$ da otvorite mapu sveta."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Koristite $KEY_advmouse$ da otvorite @@quick_info_word@@ - pregled vašeg statusa pomoću praktičnih prečica."


    key[]: "hint_pause_border_title"
    val[]: "Lokalna regulativa"

    key[]: "hint_pause_border_text"
    val[]: "Koristite $KEY_advmouse$ da otvorite @@quick_info_word@@ i pogledate važeće propise za region u koji ste ušli."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Otvorite @@quick_info_word@@ koristeći $KEY_advmouse$ da uđete @@photo_mode_word@@ i snimite u blizini @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ obližnji"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> je u blizini - pronađite ga i aktivirajte ga da biste videli međuscenu."


    key[]: "hint_resting_title"
    val[]: "Mesto za odmor u blizini"

    key[]: "hint_resting_text"
    val[]: "Mesta za odmor <img src=/material/ui/map/parking_ico.mat width=20 height=20> pomoći će vam da se oporavite od umora i bezbedno nastavite putovanje."


    key[]: "hint_gas_title"
    val[]: "Benzinska pumpa u blizini"

    key[]: "hint_gas_text"
    val[]: "Benzinske stanice <img src=/material/ui/map/gas_ico.mat width=20 height=20>može se koristiti za punjenje goriva u vašem vozilu."
