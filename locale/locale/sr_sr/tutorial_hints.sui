
    key[]: "hint_engine_title"
	val[]: "Покрените мотор"

    key[]: "hint_engine_text"
	val[]: "Користите $KEY_engine$ да упалите мотор."


    key[]: "hint_ignition_title"
	val[]: "Покрените паљење"

    key[]: "hint_ignition_text"
	val[]: "Користите $KEY_engineelect|KEY_engine$ да покренете паљење."


    key[]: "hint_driv_arc_title"
	val[]: "Вожња"

    key[]: "hint_driv_arc_text"
	val[]: "Користите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ да се крећете напред или назад.<br><offset vshift=8>Користите $SPECIAL_steering$ за управљање."


    key[]: "hint_driv_auto_title"
	val[]: "Вожња"

    key[]: "hint_driv_auto_text"
	val[]: "Користите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ да се крећете напред или назад.<br><offset vshift=8>Користите $SPECIAL_steering$ за управљање.<br><offset vshift=8>Притисните $KEY_gearup$ и $KEY_geardown$ за избор брзине."


    key[]: "hint_driv_seq_title"
	val[]: "Вожња"

    key[]: "hint_driv_seq_text"
	val[]: "Користите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ да се крећете напред или назад.<br><offset vshift=8>Користите $SPECIAL_steering$ за управљање.<br><offset vshift=8>Притисните $KEY_gearup$ и $KEY_geardown$ за контролу квачила."


    key[]: "hint_driv_hshift_title"
	val[]: "Вожња"

    key[]: "hint_driv_hshift_text"
	val[]: "Користите $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ и $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ да се крећете напред или назад.<br><offset vshift=8>Користите $SPECIAL_steering$ за управљање.<br><offset vshift=8>Промените брзине са <color value=@@clr_sel@@>мењач<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Приближите се одредишту"

    key[]: "hint_depot_deliv_text"
    val[]: "Зауставите се у означеном подручју да бисте изабрали последњу тежину паркинг места и зарадили одговарајуће искуство."


    key[]: "hint_fin_deliv_title"
    val[]: "Завршите испоруку"

    key[]: "hint_fin_deliv_text"
    val[]: "Паркирајте на изабраном паркинг месту. Можете притиснути $KEY_activate$ да га прескочите када сте близу места испоруке."


    key[]: "hint_fin_deliv2_title"
    val[]: "Завршите испоруку"

    key[]: "hint_fin_deliv2_text"
    val[]: "Паркирајте на изабраном паркинг месту. Можете омогућити виџет у @@desktop_menu_category_options@@ да бисте могли да прескочите паркирање."


    key[]: "hint_lights_title"
    val[]: "Упалите светла"

    key[]: "hint_lights_text"
    val[]: "Користите $KEY_light$ да активирате светла. Прелазите кроз различите режиме тако што ћете га више пута притиснути."


    key[]: "hint_high_beam_title"
    val[]: "Активирајте дуга светла"

    key[]: "hint_high_beam_text"
    val[]: "Користите $KEY_hblight$ да укључи дуга светла."


    key[]: "hint_wipers_title"
    val[]: "Активирајте брисаче"

    key[]: "hint_wipers_text"
    val[]: "Користите $KEY_wipers$ да бисте активирали брисаче и мењали различита подешавања брзине."


    key[]: "hint_zoom_title"
    val[]: "Посматрајући ближе"

    key[]: "hint_zoom_text"
    val[]: "Користите $KEY_camzoom$ да зумирате док сте у унутрашњости. Можете подесити режим зумирања да задржи или да се пребаци на @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Гледање около"

    key[]: "hint_cam_int_text"
    val[]: "Користите $KEY_cam1$ да бисте променили камеру на унутрашњи приказ."


    key[]: "hint_cam_ext_title"
    val[]: "Гледање около"

    key[]: "hint_cam_ext_text"
    val[]: "Можете мењати различите углове камере притиском $KEY_camcycle$.<br><offset vshift=8>Користите $KEY_cam2$ да бисте пребацили камеру на спољашњи приказ."


    key[]: "hint_indicators_title"
    val[]: "Индикатори"

    key[]: "hint_indicators_text"
    val[]: "Користите $KEY_lblinker$ и $KEY_rblinker$ да укључите индикаторе."


    key[]: "hint_tow_title"
    val[]: "Шлеп служба"

    key[]: "hint_tow_text"
    val[]: "Ако не можете да се извучете из тешке ситуације, можете користити шлеп службу. Да бисте јој приступили, отворите @@quick_info_word@@ мени користећи $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Блокада диференцијала"

    key[]: "hint_diff_lock_text"
    val[]: "Ако не можете да почнете, можда би вам могла помоћи блокада диференцијала. Користите $KEY_diflock$ да бисте га активирали или укључили аутоматску блокаду диференцијала у @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Блокада диференцијала укључена"

    key[]: "hint_diff_unlock_text"
    val[]: "Требало би да откључате диференцијал током редовне вожње или ризикујете његово оштећење. Користите $KEY_diflock$ да бисте га деактивирали или укључили аутоматску блокаду диференцијала у @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Деактивирајте брисаче"

    key[]: "hint_wipers_off_text"
    val[]: "Користите $KEY_wipers$ да деактивирате брисаче и прелазите кроз различита подешавања брзине."


    key[]: "hint_world_map_title"
    val[]: "Приказ мапе"

    key[]: "hint_world_map_text"
    val[]: "Користите $KEY_navmap$ да отворите мапу света."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Користите $KEY_advmouse$ да отворите @@quick_info_word@@ - преглед вашег статуса помоћу практичних пречица."


    key[]: "hint_pause_border_title"
    val[]: "Локална регулатива"

    key[]: "hint_pause_border_text"
    val[]: "Користите $KEY_advmouse$ да отворите @@quick_info_word@@ и погледате важеће прописе за регион у који сте ушли."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Отворите @@quick_info_word@@ користећи $KEY_advmouse$ да уђете @@photo_mode_word@@ и снимите у близини @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ оближњи"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> је у близини - пронађите га и активирајте га да бисте видели међусцену."


    key[]: "hint_resting_title"
    val[]: "Место за одмор у близини"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Бензинска пумпа у близини"

    key[]: "hint_gas_text"
    val[]: "Бензинске станице <img src=/material/ui/map/gas_ico.mat width=20 height=20>може се користити за пуњење горива у вашем возилу."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "You can enable smart throttle control in @@desktop_menu_category_options@@. By enabling it, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the button is released."
