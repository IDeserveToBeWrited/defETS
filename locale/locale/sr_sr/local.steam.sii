#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "ИЗАБЕРИТЕ РЕЖИМ МАПИРАЊА СТЕАМ УЛАЗА" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Представљамо нови <color value=@@clr_sel@@>Режим мапирања у игри<color value=@@clr_txt@@>, који подржава потпуне конфигурације везивања тастера у игри и боље савете за дугмад. Ово је препоручени режим.<br><br>Keep <color value=@@clr_sel@@>Режим мапирања Стеам клијента.<color value=@@clr_txt@@> ако сте прилагодили изглед свог гејмпада преко Стеам клијента.<br><br>Можете променити режим било када у опцијама помоћу чаробњака за унос." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Задржите Стеам клијентски режим" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Отвори Чаробњака за унос" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Режим мапирања улаза за Стеам" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Мапирање у игри" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Мапирање Стеам клијента" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Бира режим за гејмпаде као што је @@controller_ps5@@, @@controller_xbox_one@@ или @@controller_steam_deck@@ се укључио у интерфејс за унос Стеам-а.<br>Мапирање Стеам клијента - Kоришћење самосталних изгледа конфигурисаних преко Стеам клијента. Ограничена подршка за наговештаје дугмади у игри и без конфигурација везивања у игри.<br>Мапирање у игри - Kоришћење универзалног једноставног распореда. Подржава пуне конфигурације везивања тастера у игри и боље савете за дугмад. Препоручљиво је да покренете чаробњак за унос када прелазите на овај режим. Ово је препоручени режим."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Стеам Контролер"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Стеам Улазни Kонтролер"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Синхронизација у Стеам облаку:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Користите старију верзију игре.<br>Стеам ће аутоматски ажурирати игру ако аутоматска ажурирања нису онемогућена."
#@}

	key[]: "steam_demo"
	val[]: "Ако вам се допао Евро Камион Симулатор 2 демо, молимо купите пуну верзију на <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Евро Камион Симулатор 2 не може да приступи Стеам клијенту. Препоручујемо:\n\n1. Проверите да ли је клијент покренут.\n2. Проверите да ли имате ажурирану верзију клијента.\n3. Проверите да ли је укључено аутоматско ажурирање и да ли је игра последња верзија."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Део тренутно инсталираног садржаја за преузимање није компатибилан са тренутном верзијом игре и биће онемогућен. Молимо вас да проверите интегритет кеш меморије игре на Стему.<br><br>Следећи садржај је некомпатибилан:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Није могуће да се креира Стеам профил са датим именом, јер већ постоји профил са тим именом." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Не можете мигрирати профил, други профил са истим именом већ постоји." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Премештај профила није успела." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Синхронизација са Стеам облаком" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "Ваш Стеам облак има довољно простора да ваше датотеке сачува." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Понестаје вам простора на Стеам облаку!<color value=@@clr_txt@@><br><br>Молимо вас да уклоните неке сачуване датотеке да бисте наставили. Ево неких информација које ће вам помоћи:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Прекорачени простор: <color value=@@clr_red@@>$BYTES$ МБ<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Прекорачени фајлови:<color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Искоришћен простор на Стеам облаку: <color value=@@clr_sel@@>$BYTES$ МБ<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Фајлови на Стеам облаку: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "Изабрано чување <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> има <color value=@@clr_sel@@>$BYTES$ МБ<color value=@@clr_txt@@> у <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> фајловима." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Понестало вам је простора на Стеам облаку. Уклоните неке сачуване фајлове да бисте наставили.<br><br>Молимо вас да прочитате детаљне информације на десној табли." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Преласком на тип локалног профила, овај профил ће бити доступан од сада само на овом рачунару, без обзира на пријављени Стеам налог. " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Миграција профила није успела. Подаци нису пренети, а систем је сачувао оригинални профил. Молимо покушајте поново." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

