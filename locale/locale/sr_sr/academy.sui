	key[]: "aca_msg_book3_intro_cutscene06"
	val[]: "...и исправљање његових најчешћих грешака."

	key[]: "aca_msg_book3_intro_cutscene07"
	val[]: "Вожња широким путевима."

	key[]: "aca_msg_book3_intro_cutscene08"
	val[]: "Скретање на уским местима."

	key[]: "aca_msg_book3_intro_cutscene09"
	val[]: "И чак се мало забавити на крају.<br><br> Срећно!"
#@}


#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Ослонац за кутију"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "У овом сценарију, бићете смештени на празан паркинг да вежбате вожњу уназад са дуплим приколицама."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Започните"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Експериментисање"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Завршава се"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Крај сценарија"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Вожња уназад са дуплим приколицама захтева много више пажње него са једном приколицом. Морате унапред планирати где желите да се постави задња приколица, а да притом задржите контролу на предњој приколици и кабини. <br><br>Размислите о томе на овај начин - морате користити водећу приколицу да бисте управљали задњом приколицом."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "У овом случају, желимо да окренемо задњу приколицу на страну возача. Да бисмо је управљали на овај начин, потребно је да гурнемо предњи део задње приколице на страну сувозача. <br><br>Обратите пажњу да то у суштини значи да морате окренути водећу приколицу у супротном смеру од онога у ком желите да управљате задњом приколицом."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Када задња приколица почне да окреће, неопходно је исправити тегљач са водећом приколицом. Ту већина људи често прави своју прву грешку."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Овде видимо да возач није успео да прати вођство и да ће преклопити своје приколице."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "До савијања возила у комбинацији долази када угао између било која два возила у комбинацији постане око 90°. Када се то деси, нема спаса - морате кренути напред и покушати поново. <br><br> Као и код вожње једне приколице уназад, циљ треба да буде да се сви точкови на приколицама окрећу. Ако се један точак заустави и приколица се окреће у месту, не можете наставити."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Можете се померити напред до места где сте последњи пут били исправни, односно до положаја где можете наставити да радите уназад, а да поново не направите исту грешку. <br><br>У овом случају, повући ћемо се напред у равни положај и покушати поново испочетка."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Још једном, када задња приколица почне да се окреће, поставите тегљач испред водећег дела и пустите да се задња приколица сама окрене на тренутак."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Сада када се задња приколица окреће тамо где желимо, време је да усмеримо водећи део да је прати. Можете подесити угао између водећег и задњег дела да бисте контролисали скретање и учинили га оштријим или ширим."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Последњи део маневра је исправљање свега. Поравнајте вођство са задњим делом."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Требало би да имате на уму колико ће времена бити потребно да се помери водећа приколица, ако чекате предуго, задња приколица ће на крају покушати да се врати тамо одакле сте управо дошли!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Слободно проведите овде колико год времена желите, експериментишите са различитим маневрима док не помислите да имате отприлике представу о томе како да манипулишете приколицама уназад. <br><br>Али најважније од свега, запамтите да се забавите!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Припремите се за полазак."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Користите овај паркинг да бисте стекли осећај за руковање приколицама уназад. <br><br>@@aca_goal_tip@@ Нови сте у праћењу приколица уопште? Размислите о игрању игре Основе вожње камиона."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Вежбајте колико год желите. <br><br>Када сте задовољни, можете зауставити и обезбедити камион како бисте окончали сценарио."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Угасите мотор да бисте завршили сценарио."
#@}


