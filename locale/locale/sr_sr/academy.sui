#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "У овом сценарију, суочићете се са различитим скретањима која ће вам помоћи да се навикнете на вожњу са приколицом. Останите фокусирани, прилагодите своју брзину свакој ситуацији и у потпуности искористите расположиви простор на курсу обуке."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Прво скретање је заокрет са доглег - два окрета у једном. Мораћете да се припремите за скретање лево, али пређите на десно скретање усред маневара."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Ово следеће скретање вас прелази на другу страну средине. Није посебно тешко, али мораћете да пазите да оставите довољно простора за своју приколицу."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Следеће што морате да преговарате о уском слалому кроз бетонске препреке. Идите полако и користите своје ретровизоре и побрините се да заокренете довољно широко да ваша приколица може да очисти баријере."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "У овом тренутку, ући ћете у још један слалом употпуњен додатним чуњевима на врху сваке кривине <br>Пазите да не ударите ниједну од њих!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Следи неколико лаких углова на путу до кружног тока."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Користите прави део да бисте се припремили за улазак у кружни ток. Останите споља пре него што уђете у њега."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Уђите у кружни ток и погледајте како се ваша приколица налази. То ће вас другачије пратити када уђете у кружни ток у односу на начин на који сте ушли."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Изађите из кружног тока и возите до следећег сета скретања."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "УКЛОНИТЕ ОВУ СЕКВЕНЦУ"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Заокрет је овде изузетно оштар. Полако и паметно користите простор око себе. Имајте на уму и заокрет репа приколице."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Док возите кроз следећих неколико скретања, не заборавите да покушате да се припремите за следеће скретање док излазите из претходног."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Не журите са последњим углом. Изгледа лако, али има мање простора за маневрисање него што се чини."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Зауставите се на предвиђеном месту, обезбедите камион и угасите мотор."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Убрзајте према првом скретању. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Прво скретање је лагано скретање.<br><br><font face=/font/big_bold.font>Направи скретање. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "УКЛОНИТЕ ОВУ ПРОВЕРУ"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Напред се курс наставља лево од средине.<br><br><font face=/font/big_bold.font>Направите свој пут кроз раскрсницу. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Прођите кроз баријере и запамтите да гледате своју приколицу.<br><br><font face=/font/big_bold.font>Возите кроз слалом. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Овај слалом је једноставнији, али га саобраћајни чуњеви чине знатно чвршћим.<br><br><font face=/font/big_bold.font>Возите кроз слалом и избегавајте да ударите чуњеве. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Пред вама је неколико лаких углова, и даље ћете морати да правилно поставите да бисте држали приколицу даље од унутрашњих баријера.<br><br><font face=/font/big_bold.font>Направите скретања. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Приближавате се кружном току. Не заборавите да оставите довољно простора за своју приколицу не само када улазите и излазите, већ и док се возите кроз њу.<br><br><font face=/font/big_bold.font>Возите кроз кружни ток. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Пред вама је кратка права деоница, можете мало повећати брзину ако желите.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Заокрет је овде изузетно оштар. Идите полако, искористите сав расположиви простор и имајте на уму заношење приколице. <br><br><font face=/font/big_bold.font>Возите кроз оштро скретање. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Последњих неколико скретања су право напред. Присетите се на приколицу држите је на уму.<br><br><font face=/font/big_bold.font>Наставите даље. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Наставите ка финалном паркинг месту. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

