#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Дијагонално паркирање"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "У овом сценарију, паркираћете на дијагоналном паркинг месту на прометном месту. <br><br>Нема пуно простора за маневрисање, тако да ћете морати да будете веома прецизни и промишљени у вожњи."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Приближавање паркинг месту"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Оваква дијагонална паркинг места су веома честа. Посебно су чести у многим одмориштима која се налазе поред европских аутопутева. <br>Још једном ћемо морати да се „провучемо“ на паркинг место испред нас."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Возите према назначеном паркинг месту близу краја реда."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Останите према средини траке, или благо на страни возача. Не возите преблизу баријера или би задњи део приколице могао да их удари током скретања."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Поприлично возите поред паркинг места, а затим снажно и брзо скрените ка том месту. Мораћете да пазите на оба бочна ретровизора: возачев бочни ретровизор како бисте били сигурни да предњи део ваше приколице не удари у приколицу поред вас, и сувозачев ретровизор да бисте видели да ваша приколица безбедно улази на паркинг место."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Зауставите се на предвиђеном месту, обезбедите камион и угасите мотор."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Када паркирате дијагонално, важно је да тачно процените своју позицију. Када уђете у скретање, тешко је безбедно преокренути и променити позицију, тако да је идеално да се у првом покушају уверите да имате довољно простора.<br><br><font face=/font/big_bold.font>Припремите се за полазак.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Почните да возите према паркинг месту. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Прођите поред паркинг места тако да ваша приколица има простора да се окрене око камиона изнутра.<br><br><font face=/font/big_bold.font>Скрените на паркинг место. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Слепа страна уназад"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "У овом сценарију, посматраћемо „слепу страну“ која преокреће камион у паркинг место. Без могућности да погледате кроз прозор да видите куда идете, мораћете да се ослоните само на своје ретровизоре да бисте били тамо где треба да идете."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "У овом сценарију, научићете маневар „слепе стране“ уназад. Уопштено треба избегавати слепљење, осим ако нема алтернативе, пошто је ваша видљивост озбиљно ограничена. Узмите си времена и будите крајње опрезни."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Возите далеко поред паркинг места да бисте себи дали простора за посао када кренете возити уназад."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Зауставите се, проверите околину, а затим почните да возите уназад."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Окрените тегљач даље од места. Ово ће гурнути предњи део приколице и заузврат усмерити задњи део приколице ка паркинг месту на које желите да уђете. Пазите да не претерујете или можете да ризикујете да комбинујете."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Када приколица уђе на место за паркирање, почните да исправљате камион."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Зауставите се на одређеном месту и обезбедите камион."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Слепо кретање уназад захтева исте процедуре као и окретање уназад, али ћете бити хендикепирани недостатком видљивости на тој страни. Користите своје ретровизоре и своју најбољу процену да паркирате камион.<br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Испред и на страни сувозача је паркинг место. Мораћете добро да прођете поред њега да бисте имали простора за маневрисање док се крећете уназад.<br><br><font face=/font/big_bold.font>Возите напред. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Запамтите, окретање камиона даље од места ће окренути приколицу према њему. Користите своје ретровизоре колико год можете да вам помогну да уђете на паркинг место.<br><br><font face=/font/big_bold.font>Почните да возите уназад. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Вожња на кружном току"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "У овом сценарију, погледаћемо како да преговарамо о кружном току.<br><br>Мораћете да обратите посебну пажњу на своју приколицу јер ће се она кретати иза вас другачије док улазите, возите кроз кружни ток и када излазите."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Улазак у кружни ток"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Вожња у кружном току"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Вожња у кружном току"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Излазак из кружног тока"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Вожња до означеног подручја"
#!{
	key[]: "aca_goal_book1_3_11_stop"
