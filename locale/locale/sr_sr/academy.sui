#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Добродошли на први део завршног испита. Ево, видећемо колико сте добро научили да возите камион након проведеног на Академији."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Прво ћете прикачити приколицу. Када сте спојени, возићете камион по целој тестној области."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Прва деоница стазе води од малог паркинга до источне пробне стазе."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Круг укључује изазовне пролазе између баријера."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Значајан део руте пролази кроз источну пробну стазу."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Ми ћемо тестирати вашу способност маневрисања камионом у различитим ситуацијама."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Ви ћете маневрисати са камионом кроз нека оштра скретања."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Проћи ћете кроз деоницу пута која повезује стазе."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Завршни део укључује вожњу кроз мали круг."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Круг има много замршених пролаза и оштрих скретања."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Да бисте завршили тест, мораћете прецизно да паркирате."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Нема потребе да се нервирате, већ сте научили све што је потребно да прођете.<br><br>Срећно!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Пред вама је приколица.<br><br><font face=/font/big_bold.font>Возите ка приколици. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Поравнајте тегљач са приколицом.<br><br><font face=/font/big_bold.font>Возите уназад и повежите се са осовином. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Обезбедите камион. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Притисните @@imv_nrm_attach@@<font face=/font/big_bold.font> да повежете приколицу. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Приколица је повезана, а камион је спреман за вожњу.<br><br><font face=/font/big_bold.font>Отпустите паркирну кочницу. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Почните да возите према излазу са паркинга. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Пратите ознаке на путу и пазите на баријере.<br><br><font face=/font/big_bold.font>Наставите вожњу </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Предстоји још изазовнији део.<br><br><font face=/font/big_bold.font>Пажљиво се крећите између баријера. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Овај део ће тестирати ваше вештине у маневрисању приколицом око различитих врста углова.<br><br><font face=/font/big_bold.font>Скрените на полигон </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Возите кроз пролаз. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Возите право. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Пажљиво се крећите у скретању. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Улазите у комплекснији део. Возите пажљиво.<br><br><font face=/font/big_bold.font>Наставите вожњу низбрдо. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Направите оштро лево скретање. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Изађите из кружног пута. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Улазите у лакшу област.<br><br><font face=/font/big_bold.font>Наставите да возите низ брдо. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Наставите да возите на путу. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Пред вама је скретање на следећи полигон.<br><br><font face=/font/big_bold.font>Наставите вожњу </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Скрени десно. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Наставите вожњу на стази. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Напред су оштрија скретања.<br><br><font face=/font/big_bold.font>Подесите своју брзину у складу са тим. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Направите лево скретање. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Уђите у скретање, наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Да бисте скренули, можда ћете морати мало да сиђете са асфалта.<br><br><font face=/font/big_bold.font>Пажљиво скрените, користите онолико простора колико вам је потребно. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Изађите из кружног пута и возите до паркинг места. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

