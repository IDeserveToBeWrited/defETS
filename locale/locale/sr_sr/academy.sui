	key[]: "aca_msg_book3_train_check1"
	val[]: "Пред вама је деоница низбрдо, можете је искористити да брзо осетите комбинацију дуплих приколица."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Припремите се да кочите за скретање које је пред вама."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Пређите кроз средњу траку скретањем десно, а затим одмах лево."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Пређите још једном кроз средину."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Постоје тренуци када нећете имати другог избора него да преклопите целу комбинацију. <br><br>Уради шта мораш да прођеш кроз ово изузетно оштро скретање."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Наставите вожњу кроз стазу."

	key[]: "aca_msg_book3_train_check7"
