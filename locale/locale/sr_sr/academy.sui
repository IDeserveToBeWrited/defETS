#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "У овом сценарију, одвешћемо тегљач на кратку вожњу да видимо како се носите са њим са својим новостеченим вештинама."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "На стази постоје разне врсте и комбинације скретања. То није трка и није време. Будите стрпљиви и прилагодите брзину вожње скретањима и препрекама на које наилазите."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "На почетку стаза је блага и лака, али све више скретања ће постајати сложенији како идете."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Водите рачуна о својој брзини; лако је кренути пребрзо и онда погрешно проценити скретање."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Излаз са стазе је врло уско скретање. Идите полако и искористите сав расположиви простор."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Паркирајте између баријера и обезбедите камион."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Да бисте успешно завршили овај сценарио, не смете се сударити, слетети са стазе или ударити у саобраћајне чуњеве.<br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Наставите напред до оштрог десног скретања да бисте ушли на курс. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Возите кроз скретање лепом сталном брзином. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Приближавате се сложенијем делу завоја.<br><br><font face=/font/big_bold.font>У складу са тим прилагодите брзину и наставите.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Наставите ка следећем низу скретања.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Предстоје неки лаки, благи заокрети. Одржавајте брзину.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Скретање са курса је оштар окрет. Успорите и останите према споља пре скретања. Обавезно користите своје ретровизоре!<br><br><font face=/font/big_bold.font>Скрените ван од курса. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Испред вас је паркинг место између неколико баријера.<br><br><font face=/font/big_bold.font>Наставите према паркинг месту. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Паралелно паркирање"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "У овом сценарију, погледаћемо паралелно паркирање између два друга камиона."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Заустављање испред паркинг места"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Провера позади поглед на ретровизор"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Вожњом уназад на паркинг место"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Поравнавање камиона унутар паркинг места"
