	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "У овом сценарију, ваш задатак ће бити да паркирате у простору који се налази поред вас. Нема много простора за маневрисање, тако да ћете морати да урадите мало додатног посла да бисте довезли приколицу тамо где желите."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Возите право до баријере."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Станите пре баријере."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Окрените волан оштро на страну возача пре него што кренете. На овај начин ћете почети да окрећете приколицу ка паркинг месту чим почнете да се крећете уназад, штедећи драгоцени простор."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Када усмерите приколицу тамо где желите, поставите тегљач испред приколице и почните да је управљате на паркинг место."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Од овог тренутка па надаље, не разликује се толико од обичног маневара паркирања."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Задржите вожњу уназад и посматрајте обе стране. Држите тегљач и приколицу у линији са паркинг местом."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Зауставите се на предвиђеном месту, обезбедите камион, и угасите мотор."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Налазите се на паркинг месту, али са ваше десне стране постоји друго паркинг место на које морате да се померите.<br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Испред вас је обележено подручје.<br><br><font face=/font/big_bold.font>Возите напред. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Не заборавите да одмах почнете да управљате, јер нема много простора.<br><br><font face=/font/big_bold.font>Возите уназад до означеног места иза вас. </font>"


#@}

#+ Book 1 Scenario 3_15
