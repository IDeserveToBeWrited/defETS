	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Вожња на стази за руковање"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "У овом сценарију, провозаћемо се стазом дизајнираном да тестира вашу способност да управљате камионом кроз различите врсте кривина и углова."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Улазак на полигон"

	key[]: "aca_goal_book1_2_08_check1"
