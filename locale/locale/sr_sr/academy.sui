#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Паркирање у уском простору"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "У овом сценарију, задатак вам је да паркирате сет дуплих приколица у уском простору."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Започните"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Крените"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Наставите вожњу"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Заустављање"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Обезбедите возило"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Вожња са дуплим приколицама може деловати застрашујуће, али нема много више од вожње са једном приколицом - само морате узети у обзир и путању задње приколице!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Испред вас је уско паркинг место. Нећете имати довољно простора да се потпуно исправите пре уласка, па ћете морати пажљиво размислити како ћете се увући са обе приколице."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Одмах скрените ка супротној страни паркинг места и возите далеко даље од места где бисте обично скренули."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Сада када је ваша задња приколица на правом путу, можете кренути ка том месту; само се побрините да поново кренете према супротној страни како бисте помогли да дођете са првом приколицом."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Наставите до места, а обе приколице ће вас пратити и исправљати се док идете."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Паркирајте на одређеном подручју и обезбедите камион."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Припремите се за полазак."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Наставите напред и уђите у уски простор."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Наставите вожњу."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Зауставите се на одређеном подручју."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Обезбедите камион и угасите мотор."
