#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Вожња уназад са приколицом"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "У овом сценарију, први пут ћете се окушати у вожњи уназад са приколицом. То је прилично једноставан маневар, али ћете и даље морати правилно да управљате да бисте поставили приколицу у исправан положај."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Вожња уназад према приколици"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Повезивање приколице"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Отпуштање паркирне кочнице"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Вожња уназад са приколицом"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Наставите према паркинг месту"
