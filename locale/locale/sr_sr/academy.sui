#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "За коначни сценарио овог поглавља, возићемо се на пробној стази са сложеном конфигурацијом."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Прва препрека је слалом кроз неке баријере. Возите се кроз њих и не заборавите да користите своје ретровизоре."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Следеће је окретање укоснице. Држите скретање широким и не би требало да вам представља проблеме."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Овде је скретање лево од 90°. Не заборавите да возите дубоко тако да задњи део камиона очисти унутрашње препреке."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Препрека на рампи може бити мало незгодна. Поравнајте се најбоље што можете пре него што кренете на њега и користите предње и бочне ретровизоре да бисте се лакше оријентисали."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Следећи одељак мора да се уради обрнуто. Имајући то на уму, приступите баријерама испред вас."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Пратите ознаке на путу назад и десно од вас."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Вратите се уназад до баријера, затим се зауставите и наставите напред лево."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Наставите кроз одмориште у средини до следећег одељка."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Овај пролаз кроз чуњеве је веома узак. Возите полако и користите ретровизоре да бисте се оријентисали у пролазу."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Не заборавите да возите дубоко на скретањима од 90°."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Улазите на леп отворен део пута. Можете повећати брзину, али имајте на уму да ћете ускоро морати да успорите за кривину која је напред."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "У подножју брда има баријера преко пута. Возите до њих, а затим крените уназад до паркинг места са леве стране."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Назад до паркинг места."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Паркирајте, затим угасите мотор и осигурајте камион."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Пред вама је слалом направљен од баријера.<br><br><font face=/font/big_bold.font>Возите кроз слалом.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Држите се према спољашњој страни скретања како задњи део тегљача не би прешао преко ивичњака.<br><br><font face=/font/big_bold.font>Направи скретање. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Долазите до скретања од 90° лево. Не заборавите да искористите сав расположиви простор.<br><br><font face=/font/big_bold.font>Направи скретање. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Поравнајте се са рампом. Нема пуно простора за исправке када сте на њему.<br><br><font face=/font/big_bold.font>Возите преко рампе. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Пратите курс лево. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Следећа област се мора попунити обрнуто. Зауставите се на баријерама испред вас да бисте после тога могли да скренете удесно.<br><br><font face=/font/big_bold.font>Зауставите се код баријера.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Окрените се уназад према подручју иза вас и удесно. На путу се налазе стрелице које вам могу помоћи.<br><br><font face=/font/big_bold.font>Окрените се према следећем одељку. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Наставите да се крећете уназад према препрекама иза вас.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Зауставите се и пребаците у брзину за напред, а затим наставите лево. <br><br><font face=/font/big_bold.font>Возите напред. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Постоји прекид у средини лево. Возите се кроз њега.<br><br><font face=/font/big_bold.font>Наставите напред. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Пред вама је уска вијугава стаза кроз неке чуњеве. Возите пажљиво и користите своје ретровизоре ако је потребно.<br><br><font face=/font/big_bold.font>Возите кроз чуњеве. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Наставите путем смера.<br><br><font face=/font/big_bold.font>Скрените лево. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Не заборавите да држите лево пре скретања да бисте себи дали што више простора.<br><br><font face=/font/big_bold.font>Направи скретање. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Овде можете да повећате брзину, али пред вама долази кривина.<br><br><font face=/font/big_bold.font>Наставите дуж смера. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Кривина постаје оштрија док се пробијате кроз њу.<br><br><font face=/font/big_bold.font>Прилагодите своју брзину у складу са тим и наставите.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "У подножју брда видећете препреке које блокирају пут. <br><br><font face=/font/big_bold.font>Зауставите се близу баријера. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Иза вас и са леве стране налази се паркинг место.<br><br><font face=/font/big_bold.font>Пређите уназад на паркинг место. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Станите на означеном месту. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

