#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "У овом сценарију, прећи ћемо на то како да се окренемо у уском простору са маневром за слепу страну уназад. Ова вештина ће вам бити од користи када не можете да се окренете или вратите на страну возача."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Ознаке на путу помоћи ће вам да се крећете кроз курс обуке."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Направите широки окрет како бисте били сигурни да ће приколица избећи паркиране камионе."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Док излазите из скретања, размислите о томе како ћете подесити камион за свој маневар уназад."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Помаже вам да камион буде под углом усмерен ка празном паркинг месту на страни вашег сувозача, где ћете кретати уназад."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Када је то могуће, треба избегавати слепо кретање уназад јер је видљивост знатно мања. Нажалост, постоје тренуци када нећете имати другог избора осим да то урадите."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Окрените волан пре кретања уназад. Ово ће помоћи да се ваша приколица одмах усмери тамо где желите, што помаже у веома тесним ситуацијама."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Када је приколица добро постављена, поставите тегљач испред приколице и исправите је."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Зауставите се када се исправите и имајте довољно простора да се поново повучете напред. Почните да се враћате истим путем којим сте ушли."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Пратите ознаке пута ван курса за обуке."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Возите кроз кривину испред и наставите до означеног подручја."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Заустављање."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Обезбедите камион и угасите мотор."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "У области испред вас налази се курс обуке који представља парцелу бродарске компаније. Ваш задатак је да уђете унутра и окренете камион да се врати. Обавезно добро искористите простор око себе.<br><br><font face=/font/big_bold.font>Припремите се за полазак </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Наставите према курсу обуке. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Скрените на углу и наставите кроз курс. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Пратите ознаке на путу до баријере на крају стазе. Паркирајте мало под углом тако да ваша приколица буде усмерена ка празном паркинг месту на страни вашег сувозача.<br><br><font face=/font/big_bold.font>Наставите напред. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Имате много ограниченији поглед на оно што се дешава око вас када сте слепи. Идите полако, користите ретровизоре и будите опрезни.<br><br><font face=/font/big_bold.font>Започните вожњу уназад и окрените приколицу на празно место за паркирање. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "То је довољно далеко. Сада можете наставити напред и кренути са терена за обуку из истог правца из којег сте дошли.<br><br><font face=/font/big_bold.font>Почните право да идете према излазу. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Изађите из курса обуке. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Пратите ознаке на путу до финалног паркинг места.<br><br><font face=/font/big_bold.font>Наставите до одредишног подручја. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Офсетни маневар уназад"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "У овом сценарију, имаћете задатак да се вратите на паркинг место које није директно иза вас. Постоји ограничен простор за маневрисање, тако да морате мудро користити свој простор."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

