	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Вожња око баријера"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Испред су разни сложени углови и препреке.<br>Узмите у обзир све што сте до сада научили и то не би требало да буде тешко."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Ознаке на путу могу вам помоћи да добијете идеју о томе како да наставите кроз сваки скуп препрека."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Држите тегљач на спољној страни угла. <br>Мораћете да заокренете широко док приколица прати краћу путању."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Следећи угао је лако окретање од 90°. <br> Још једном, држите камион изван скретања и искористите сав расположиви простор."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Узмите своје време овде. Курс се отвара, али и даље морате бити прецизни."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Држите широки лежај око баријера."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Пазите док улазите у ову уску област. <br>Добро заокрените тегљач пре него што уђете како бисте своју приколицу поставили за улазак."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Последњи заокрет од 90° је много оштрији од првог, али има довољно простора ако свој простор користите мудро."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Зауставите се на предвиђеном месту, затим обезбедите камион и угасите мотор."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Не заборавите да користите ознаке на путу да вам помогну у навигацији курсом.<br><br><font face=/font/big_bold.font>Припремите се да кренете. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Коришћење ретровизора ће вам такође помоћи да се безбедно крећете стазом. Увек морате бити свесни како приколица прати иза вас.<br><br><font face=/font/big_bold.font>Прођите кроз први угао. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Посматрајте приколицу док излазите из скретања и припремите се да уђете у следеће.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Наставите кроз следеће скретање. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Не заборавите да посматрате своју приколицу да бисте били сигурни да сте подаље од препрека око вас пре него што окренете камион.<br><br><font face=/font/big_bold.font>Наставите да заобиђете препреку испред вас. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Када се ваша приколица удаљи од баријере, нагло се окрените на страну сувозача да бисте се исправили за уски пролаз. <br><br><font face=/font/big_bold.font>Наставите према уском пролазу.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Овај део ће захтевати веома прецизну вожњу. Узмите си времена и користите своје ретровизоре.<br><br><font face=/font/big_bold.font>Држите се према спољашњем делу сваког угла. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ово скретање је веома оштро, али можете да искористите сав простор испред себе да га лако очистите.<br><br><font face=/font/big_bold.font>Направите последње скретање. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

