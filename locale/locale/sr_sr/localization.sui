	key[]: "eye_extended_view_op_tooltip"
	val[]: "Омогућава проширени приказ који повећава ваш угао гледања коришћењем покрета главе и/или очију за контролу камере у игри."

	key[]: "eye_preset_op_tooltip"
	val[]: "Избор унапред подешених поставки проширеног приказа."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Избор режима праћења главе:<br>- У „Директном“ режиму ваша ротација главе директно одговара ротацији камере у игри. Препоручује се у нормалним ситуацијама у кокпиту/кабини.<br>- У „Динамичном“ режиму ваш поглед ће утицати на камеру у игри само када заправо окренете главу. Препоручује се када је важно да ваш поглед буде апсолутно центриран."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Када је омогућена, камера у игри ће се непрекидно полако усмеравати док мењате природни положај главе током игре."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Када је омогућено, положај ваше главе утиче на положај камере у игри."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Када је омогућена, камера у игри ће се нагињати у складу са тим када нагнете главу на било коју страну."

	key[]: "eye_yaw_scale_op_tooltip"
