	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења стабилност камиона спуштањем његовог центра гравитације."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења стабилност приколице спуштањем њеног центра гравитације."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења интензитет обртног момента који се генерише из погонске линије.<br><br>Подизањем ове поставке појачаће се осећај да се камион „увија“ удесно."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења крутост вешања шасије."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
