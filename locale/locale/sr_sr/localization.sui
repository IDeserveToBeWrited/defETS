#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Настави ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Добродошли у 'Euro Truck Simulator 2'!"

	key[]: "intro_2"
	val[]: "Најзад имате прилику да остварите ваш животни сан - вожњу камиона!"

	key[]: "intro_3"
	val[]: "Ваше превозничко предузеће је спремно за посао, али немате пара да купите камион. Засада ћете морати да радите за друге, као унајмљени возач."

	key[]: "intro_4"
	val[]: "Ваш задатак је да испоручите терет $JOB_CARGO$ на $JOB_TARGET_COMPANY$ стовариште у $JOB_TARGET_CITY$. Ваш послодавац вам је обезбедио возило и покрива све трошкове. Испуните очекивања и стигните на време."


	key[]: "intro_garage_1"
	val[]: "Ово су ваше канцеларије."

	key[]: "intro_garage_2"
	val[]: "Ово је врло мала гаража. Није ништа посебно, али је добра за почетак."

	key[]: "intro_garage_3"
	val[]: "Нажалост, немате ништа за паркирање, па нема ни камиона на видику."

	key[]: "intro_garage_4"
	val[]: "Једном када зарадите довољно пара и купите камион, моћи ћете да се слободно крећете по свету и водите сопствени посао."

	key[]: "intro_garage_5"
	val[]: "Срећно!"


	key[]: "desktop_tut_t"
	val[]: "ФУНКЦИЈА ОТКЉУЧАНА"

	key[]: "desktop_tut_job"
	val[]: "Преузмите ваш следећи посао"

	key[]: "desktop_tut_cargo_market"
	val[]: "Користите своју брендирану нову приколицу како бисте приступили Карго Маркету да испоручите широк асортиман терета до њихових дестинација." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Овде можете видети ваш напредак."

	key[]: "desktop_tut_company"
	val[]: "Пазите на ваше гараже, унајмљујте возаче и управљајте вашим предузећем."

	key[]: "desktop_tut_trailers"
	val[]: "Од сада можете купити своје приколице, надоградити или их обојити и прилагодити вашем камиону.<br><br>Ваше приколице биће постављене у изабраној гаражу(и); оне могу да се користе од стране ваших возача, да повећају профит. Да бисте управљали својим приколицама, користите управљање приколицама."

	key[]: "desktop_tut_visit_directive"
	val[]: "Посетите $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "ДОБРОДОШЛИ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Добродошли на нови почетни екран<br>Одавде можете комуницирати са свим функцијама игре."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "У наставку, Главни мени пружа директан приступ свим основним функцијама игре које су вам познате."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "На врху, нова статусна трака пружа сталну видљивост корисних статистика профила играча и локалних путних прописа."

	key[]: "desktop_tut_tour_home"
	val[]: "Дугме Почетна је увек ту да вас врати на почетни екран."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Стални брзи мени пружа згодан приступ пречицама свим функцијама игре са било ког екрана."

	key[]: "desktop_tut_tour_drive"
	val[]: "Ажурирано дугме за вожњу остаје ваша веза са светом вожње, спремно да вас врати на пут."

