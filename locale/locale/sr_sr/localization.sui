#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Мрежни сегмент није доступан. Молимо вас да проверите да ли је конфигурација клијента исправна."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Није могуће успоставити везу са услугом на Интернету. Проверите да ли сте уопште повезани на Интернет."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Појавила се грешка при комуникацији са услугом на Интернету. Молимо вас да покушате поново касније."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Враћени су неисправни подаци. Ако користите 'HTTP proxy', проверите његова подешавања. У супротном, покушајте поново касније."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Враћени су неисправни подаци. Молимо вас да касније покушате поново."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Услуга није компатибилна са тренутном верзијом игре. Проверите да ли је доступна нова закрпа/patch/ игре."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Услуга је тренутно недоступна. Молимо покушајте касније."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Услуга је тренутно недоступна због одржавања или преоптерећења. Молимо, покушајте касније."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Информација о аутентикацији није исправна. Молимо вас да поново покушате приступ налогу."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Мрежни налог је тренутно закључан због много неуспелих покушаја приступа. Пробајте поново за пола сата."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Мрежни налог је тренутно закључан због сумњивих приступања. Пробајте опет за 24 часа."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Игра није регистрована на овај мрежни налог."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Налог још увек није активиран. Молимо, проверите вашу пошту за активациони и-мејл."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Налог је суспендован. Молимо, контактирајте техничку подршку."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Налог је обрисан. Молимо, контактирајте техничку подршку."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "'Proxy'-aутентикација није подржана у овој игри. Молимо вас да користите други 'Proxy' или директну конекцију."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Захтевани објекат је тренутно недоступан. Молимо, пробајте поново за неколико минута."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "ССЛ грешка. Није могуће успоставити безбедну везу."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Игра је била обустављена током онлајн комуникације. Молимо покушајте поново касније."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Интерна грешка. Датотека 'net.log' можда садржи више информација о њој."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 има проблем и није у могућности да нацрта графику на вашем рачунару (није пронађена подржана графичка јединица).\nПрепоручени кораци:\n\n1. Проверите да ли ваш рачунар и видео карта одговарају минимуму гхардверских захтева.\n2. Инсталирајте најновију верзију Микрософтових DirectX драјвера.\n3. Инсталирајте најновију верзију драјвера за вашу графичку карту са произвођачевог сајта.\n4. Пребаците метод рендеровања са OpenGL у DirectX и обрнуто.\n5. Обришите конфигурациони фајл игре 'config.cfg' у вашем 'Documents' - 'Euro Truck Simulator 2' фолдеру. Можда је оштећен.\nОвај фајл ће бити аутоматски креиран са исправним почетним вредностима приликом следећег старта игре."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 има проблема да прикаже графику на вашем рачунару (није пронађена одговарајућа графичка карта)."
#@}

