	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења начин на који се навигација усмерава:<br>- „Најбољи“ режим навигације бира најефикаснији однос између дужине и времена руте, покушава да избегне раскрснице са семафорима итд.<br>- „Најкраћи\" режим навигације увек бира најкраћу могућу руту.<br>- Режим навигације „Мали путеви“ бира да избегава аутопутеве где год је то могуће."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Промените тежину паркирања:<br>- „Увек изабери“ вам омогућава да изаберете када стигнете на одредиште.<br>- „Безбедно паркирање” не захтева маневре уназад.<br>- „Вешто паркирање“ ће обично захтевати изазовнији маневар при кретању уназад."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Подешава вероватноћу да наиђете на опасности на путу у вашој близини, укључујући несреће, онеспособљена возила, крхотине на путу, итд."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
