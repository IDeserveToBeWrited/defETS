	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Тренутно испоручујете компанији која није активна у овој сесији.<br>>Ако желите да се повежете, прво испоручите свој посао или ће он бити отказан.<br><br>Желите ли да наставите?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Предузеће у близини вашег камиона или приколице ће морати да се активира да бисте се придружили овој сесији.<br>Да бисте избегли било какве проблеме, померите камион и приколицу даље од компаније или ће ваш тренутни посао бити суспендован и недоступан у ове сесије и бићете телепортовани у најближи сервис.<br><br>Желите ли да наставите?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Предузеће у близини вашег камиона или приколице ће морати да се активира да бисте се придружили овој сесији.<br>Да бисте избегли било какве проблеме, померите камион и приколицу даље од компаније или ће ваш тренутни посао бити отказан и ви ћете бити телепортован у најближи сервис.<br><br>Желите ли да наставите?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Предузеће у близини места где сте оставили камион или приколицу пре него што прихватите свој брзи посао мораће да буде активирано да бисте се придружили овој сесији.<br>Да бисте избегли проблеме када се вратите у свој камион, ваш брзи посао треба да буде отказан и бићете телепортовани у најближи сервис.<br><br>Желите ли да наставите?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Ваш изабрани посао се испоручује од или до компаније која није активна у овој сесији и неће бити доступна када се повежете.<br><br>Да ли желите да наставите?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Ваш терет се налази у компанији која је неактивна у овој сесији.<br>Ако желите да се повежете, учитајте свој терет или ће ваш тренутни посао бити суспендован и недоступан у овој сесији.<br><br>Да ли желите да наставите?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Ваш посао је отказан јер се испоручује компанији која није активна у овој сесији."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Your job was canceled as spacial jobs are not supported in convoy."

