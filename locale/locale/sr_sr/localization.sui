#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "БАНКА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Банка" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Ако вам требају паре, увек можете питати банку за позајмицу." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "ПОНУДЕ ПОЗАЈМИЦА" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "за $MONEY$ дневно" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Број активних позајмица: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Можете позајмити: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "ПРЕГЛЕД АКТИВНИХ ПОЗАЈМИЦА"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Свота" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Остало за исплату" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Трајање (у данима)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Каматна стопа (год.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Рата" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Исплати дуг" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Укупно:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Стање на рачуну: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

