#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "Да бисте приступили брзим пословима, морате да завршите тренутни водич."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Да бисте приступили тржишту терета, морате купити свој први камион."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Да бисте приступили тржишту терета, морате купити своју прву приколицу."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Да бисте приступили спољним уговорима, потребно је да купите свој први камион и да имате профил повезан са `World of Trucks`."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Да бисте приступили спољном тржишту, потребно је да купите своју прву приколицу и да имате профил повезан са `World of Trucks`."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Погледајте мапу света, њене истражене области и ваше тренутне навигационе контролне тачке или поставите нове. "

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Брзо путовање до раније откривеног града, уз трошак."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Претражујте, претражујте и филтрирајте сесије конвоја на мрежи да бисте се придружили или креирали за друге и угостили друге."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Ваше пријемно сандуче за поруке из света бизниса, банака и нових запослених у компанијама."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "Е-маилови ће почети да стижу када напредујете даље у каријери."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Пронађите и купите доступне гараже на мапи света."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Прегледајте и погледајте доступне половне камионе за куповину."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Још нисте открили ниједног дилера камиона."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Прегледајте, погледајте и поново конфигуришите доступне приколице за куповину."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Уживајте у својој омиљеној радио станици на мрежи или учитајте своју музику."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Радио је недоступан."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Конфигуришите графику, звук, игру, контроле и опције на мрежи."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Прегледајте напредовање у каријери, статистику и недавно завршене послове."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Да приступите активном конвоју, прво морате да уђете у сесију конвоја."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Health warning"

	key[]: "health_warning_description"
	val[]: "A small number of users may be susceptible to epileptic seizures or loss of consciousness when exposed to certain flashing lights or light patterns. Such individuals may experience a seizure while watching certain images or playing a video game. If you or anyone in your family has ever had symptoms related to epilepsy (seizures or loss of consciousness) when exposed to flashing lights, please consult a medical professional and take all necessary precautions prior to playing the game.<br offset=20>If you or your child experience any of the following symptoms while playing any video game: dizziness, altered vision, eye or muscle twitches, loss of consciousness, disorientation, convulsions, involuntary movements, discontinue use of the video game immediately and consult a medical professional."

	key[]: "trademark"
	val[]: "All brand names, trademarks, registered marks, logos, and symbols on vehicles in the game are property of their rightful owners. Used with kind permission. The MAN® trademarks and designs are registered rights of MAN Truck & Bus AG and are used under license to SCS Software s.r.o. \"Mercedes-Benz\" and \"Three pointed star in a ring\" are trademarks of Daimler AG and used under license by SCS Software s.r.o. The RENAULT trademarks and designs are registered rights of or licensed to the AB Volvo Group and are used pursuant to a license. The VOLVO trademarks and designs are registered rights of or licensed to the AB Volvo Group and are used pursuant to a license."
#@}

