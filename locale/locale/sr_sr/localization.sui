	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Управо ћете превести терет Специјалног транспорта! Постоје два возила за пратњу која ће вас водити. Молимо вас да будете опрезни и пратите њихова упутства и обавештења о предлозима. Специјални транспорти попут овог се не заустављају на црвеном семафору и имају првенство пролаза у већини ситуација. Током ових испорука, контролне тачке се постављају чешће како би се сачувао ваш тренутни напредак."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
