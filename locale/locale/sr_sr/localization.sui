	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Подешава интензитет процедурално генерисаних неравнина на површини да би путевима и другим теренима дао несавршен осећај.<br><br>У зависности од других подешавања вешања и камере, уочени ефекат може бити мање или више изражен."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Омогућава напредно спајање које захтева већу прецизност да би се седло камиона поравнао са главним клином приколице.<br><br>Када је онемогућено, спајање приколице постаје много лакше јер нема судара између клина и седла."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Бира да ли и који каблови приколице су анимирани.<br><br><color value=@@clr_txt_d@@>Омогућавање каблова на више возила може утицати на перформансе на старијим системима."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Омогућава електронски лимитатор брзине камиона на 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>Послови у Свет Камиона имају ову функцију трајно укључену."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Када је омогућено и брисачи су постављени на прву позицију, брисачи ће се аутоматски укључити и прилагодити своју брзину у складу са условима."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Омогућава аутоматско активирање ретардера при кочењу."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућено, возило помаже при кретању на узбрдици држећи кочнице, обезбеђујући глатко покретање."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Омогућава аутоматско активирање моторне кочнице приликом кочења."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Када се изабере, мотор ће се покренути чим се притисне гас."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућена, паркирна кочница камиона се подразумевано активира (након коришћења трајекта, вуче на сервис, брзог путовања, итд.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Аутоматски покреће подизне осовине када је потребно у зависности од тежине возила."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућено, возило ће подразумевано држати нижи гас. Након што два пута брзо притиснете дугме гаса, возило ће држати пун гас док се дугме гаса не отпусти.<br><br>Утиче само на унос са тастатуре."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Симулира губитак ваздуха у стварном животу услед прекомерног коришћења кочница.<br><br>Када је омогућено, мораћете да управљате својим ваздушним притиском када се спуштате низбрдо или правите споре маневре са вишеструким применама кочница."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "When disabled, fuel consumption is not affected by driving style or road conditions.<br><br>When enabled, fuel consumption is affected by several factors including driving style, cargo weight, rolling resistance, and terrain profiles. It is no longer affected by the @@skill_mechanical_title@@ skill."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућен, АБС ће спречити блокирање точкова како би одржао контролу и побољшао способност кочења."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућено, камион ће применити кочење по точку како би спречио проклизавање точкова, недовољно управљање или прекомерно управљање како би помогао у одржавању контроле."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућено, камион ће закључати диференцијал ако точкови почну да клизе, како би се побољшало трење."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења повећање брзине при којој ће се темпомат повећавати или смањивати када се притисне одговарајуће дугме."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења толеранцију темпомата за одржавање циљне брзине."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућено, темпомат ће аутоматски прилагодити брзину, како би одржао безбедно растојање у односу на возило испред."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Активира кочење у случају нужде ако систем осети непосредан судар.<br>Изаберите да ли ће систем реаговати само на возила или на све препреке."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Избор режима помоћника траке:<br>- Режим „Упозорење о напуштању траке“ вас звучно упозорава када се спремате да напустите траку.<br>- Поред звучног упозорења, „Подршка за задржавање траке“ такође аутоматски управља вашим камионом како не би напуштао траку.<br><br>Оба режима су активна само при брзинама изнад 55 км/х (~35 мпх).<br>Помоћник Траке такође узима у обзир вашу употребу показивача правца пре него што се укључи."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Омогућава функције сензора мртвог угла, ако је ваш камион њиме опремљен."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Када је омогућено и фарови су постављени на прву позицију, фарови ће се аутоматски укључити у ситуацијама слабог осветљења."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Када је омогућено, а предња светла су укључена са укљученим дугим светлима, возило ће аутоматски пригушити дуга светла када детектује надолазеће возило или возило испред њега."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Када су омогућени, индикатори ће се аутоматски поништити након окретања док се волан врати у средину."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Када је омогућено, неки унутрашњи додаци реагују на физичко кретање возила (висеће декорације, бобблехеадс, итд.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Омогућава скретање унутрашње камере на основу улаза управљача."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења колико је функција „ротације камере за управљање“ реактивна на улаз управљања. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења понашање функције „ротације камере за управљање“ при вожњи уназад."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућено, унутрашња камера гледа лево или десно на основу употребе мигаваца."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Када је омогућена, унутрашња камера реагује на кретање возила."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења колико је унутрашња камера реактивна на кретање возила."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Мења колико унутрашња камера може да се помера, у односу на покрете возила."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Подешава кашњење пре него што камера аутоматски центрира.<br><br>Возило мора да се креће брзином која није занемарљива да би се ово активирало. Односи се само на унутрашњу камеру и камеру за јурење док се крећете напред и на камеру која се нагиње ван док се креће уназад."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Подешава брзину кретања камере. Користи се за аутоматско центрирање камере и пребацивање између унапред подешених камере за унутрашњост."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Одређује како функционише унутрашње зумирање: држите дугме за привремено зумирање или притисните једном да бисте га укључили/искључили." #+ Tooltip explaining the zoom mode options.

