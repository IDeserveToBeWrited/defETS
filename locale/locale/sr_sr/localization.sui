	key[]: "connect_content_leave_confirmation"
	val[]: "Да ли заиста желите да одложите регистрацију?<br><br>Касније користите 'Online Connect Content' дијалог из 'Online Options', лоцираним на десктопу." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "СПАЈАЊЕ САДРЖАЈА" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Спајање садржаја.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Није успела операција повезивања са: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "'Steam' налог који сте користили за регистрацију овог ДЛЦ разликује се од оног који је коришћен за креирање налога Свет Камиона или за регистрацију игре. Промените свој 'Steam' налог и покушајте поново." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "'Steam' налог који користите за регистрацију овог ДЛЦ је већ повезан са другим налогом Свет Камиона. Да бисте регистровали ДЛЦ на тренутни налог, потребно је да користите 'Steam' налог који није повезан ни са једним налогом Свет Камиона." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam token је истекао. Молимо, пробајте поново касније." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Серијски број који користите за активацију ДЛЦ-а је неважећи. Контактирајте подршку на: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Интерна грешка се појавила током регистрације игре. Молимо, покушајте касније опет." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "УСПЕШНО" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "ИНФО" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ОНЛАЈН" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "ПРЕГЛЕД САДРЖАЈА" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Честитамо! Изабрани ДЛЦ су успешно повезани са вашим Свет Камиона налогом." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Не могу да повежем садржаје јер је тренутни Steam налог повезан са другим Свет Камиона налогом." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Неки ДЛЦ се нису повезали.<br>Пређите мишем преко ускличника да видите више детаља." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Региструјем $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Тренутни профил није повезан са Свет Кмиона или игра ради у офлајн режиму. Уредите профил да бисте се повезали." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Кликните за одбацивање"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ повезани тренутно компатибилни ДЛЦ. Ако неки ДЛЦ није повезан на Свет Камиона, недостајаће много тога што је у њему." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Честитамо! <color value=@@clr_txt@@>Сав ваш садржај је повезан са Свет Камиона! Сад навалите на погодности." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Не могу да повежем садржаје са Свет Камиона јер се тренутни Steam налог не слаже са оним који користи Свет Камиона налог." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
