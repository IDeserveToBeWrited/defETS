	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Подешава мртву зону осе управљача; количина ротације од центра при чему се унос игнорише.<br><br>Ово може ублажити проблеме старијих контролера, као што су непрецизност или лажни унос узрокован хабањем."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Одређује како игра управља уносом осе управљача:<br>- Центрирано је идеално за волане или џојстике.<br>- Обрнуто се користи за исправљање осе која је погрешно откривена."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
