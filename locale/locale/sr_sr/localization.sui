	val[]: "Инвертује Y-осу миша када контролишете камеру у игри."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Бира тип мењача:<br>- „Једноставан аутоматски\" вам омогућава да користите гас и кочницу за контролу кретања напред и назад.<br>- „Прави аутоматик\" захтева унос за пребацивање између напред и назад.<br>- „Секвенцијални\" захтева ручно пребацивање свих брзина помоћу тастера за померање горе / доле.<br>- „Х-Пребацивач\" захтева употребу контролера са мењачима за ручни избор брзина."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Избор ове функције ће омогућити „прескакање мењања“ - прескакање брзина када је то неопходно или практично како би се избегло мењање сваког степена преноса у мењачу."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Враћа волан у центар када се користи тастатура или контролер.<br><br>Онемогућавање ове функције значи да ћете морати ручно да се вратите у центар након скретања."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
