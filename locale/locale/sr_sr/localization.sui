#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Датотека слике је превелике резолуције. Молимо, смањите резолуцију екрана." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Датотека слике је неисправна или неподржана." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Резолуција екрана је превелика. Молимо, смањите резолуцију екрана." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Сајт је одбацио вашу слику." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Овај налог не омогућује слање слика." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Шаљете слику у исто место." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Слање је тренутно онемогућено. Молимо, пробајте поново касније." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Непозната грешка се јавила током слања. Молимо, пробајте слање касније." #+ Error message shown when no more specific message applies.
#@}

