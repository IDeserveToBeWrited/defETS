#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Неопходни ДЛЦ (званично проширење игре) $DEPENDENCY_NAME$ недостаје. Да би овај снимак радио коректно, овај ДЛЦ мора бити присутан и активиран на овом рачунару. Морате то да поправите пре него учитате овај снимак." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Опциони ДЛЦ (званично проширење игре) $DEPENDENCY_NAME$ недостаје. Ако је ово неочекивано, проверите стање тог ДЛЦ.<br><br>У супротном, пробајте да учитате игру, али очекујте да много тога неће радити, а што је досада радило." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Мод $DEPENDENCY_NAME$ недостаје или је искључен. Ако ово не очекујете, проверите стање тог мода. Пробајте да учитате снимак свеједно. Ипак, очекујте да, у зависности шта је мод радио, игра одбије да се учита или изазове друге проблеме." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Мод $DEPENDENCY_NAME$ је некомпатибилан са овом верзијом игре. То значи да је аутор мода означио тај мод као компатибилан само са одређеном верзијом игре, а то није ова.<br><br>Решења:<br>- Покушајте да нађете новију верзију мода која ради са овом верзијом игре.<br>- Нађите верзију игре која је компатибилна са тим модом.<br><br>Можете пробати да учитате овај снимак, наравно. Какогод, мод неће бити учитан и у зависности шта је мод радио, могуће је да учитавање не успе или имате других проблема у игри." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "НЕДОСТАЈУЋЕ ЗАВИСНОСТИ" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "ДЕТАЉИ" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Отвори страницу радионице"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Овај снимак зависи од ДЛЦ или МОД-а који тренутно недостају. Излистани су испод. Ако изаберете ставку на листи, добићете више информација о проблему." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Овај снимак зависи од најмање једног захтеваног ДЛЦ или мода. Морате да то поправите пре него што учитате овај снимак." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Прекини учитавање" #+ Abort loading button.

	key[]: "type"
	val[]: "Тип" #+ Type column.

	key[]: "dependency_name"
	val[]: "Име зависности" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Локални мод" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Мод из Радионице" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Опциони ДЛЦ" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Захтевани ДЛЦ" #+ DLC that is required to load save that is depending on it.
