#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Бира подтип контролера за игру да би правилно управљао опсегом уноса."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Бира тип мењача:<br>- „Једноставан аутоматски\" вам омогућава да користите гас и кочницу за контролу кретања напред и назад.<br>- „Прави аутоматик\" захтева унос за пребацивање између напред и назад.<br>- „Секвенцијални\" захтева ручно пребацивање свих брзина помоћу тастера за померање горе / доле.<br>- „Х-Пребацивач\" захтева употребу контролера са мењачима за ручни избор брзина."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Мења логику промене степена преноса у аутоматском мењачу:<br>-Режим „Економија“ преферира ниже обртаје у минути у правцу максималног обртног момента.<br>- Режим „Снага“ ће бити усмерен ка вршној коњској снази за боље перформансе вожње са тешким теретом или планинским тереном на рачун уштеде горива."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Подешава однос степена ротације уређаја према стварном степену ротације управљача возила."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Подешава линеарност између улаза и управљања возилом.<br><br>Подешавање ове вредности више значи да ће управљање мање реаговати када је точак у средини, и повећаће осетљивост како се точак окреће ка максималном закључавању. Ово може бити од помоћи за изглађивање утицаја управљача када возите право."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Омогућава принудну повратну информацију у контролерима који га подржавају."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Подешава укупни добитак за све поставке повратне спреге између 0Н и 10Н.<br><br><color value=@@clr_txt_d@@>Имајте на уму да подешавање на већу поставку у снажним међуосовинским размацима може довести до повреде прстију или шака."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Подешава силу центрирања када возите великом брзином, која достиже врхунац од 90 км/х (56 мпх) и више.<br><br>Минимално подешавање ће довести до тога да нема силе центрирања точка."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Подешава силу центрирања када возите малом брзином.<br><br>Минимална поставка неће резултирати силом центрирања точка."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Подешава јачину вештачког унутрашњег трења изазваног механичким компонентама управљача."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Подешава јачину вештачке резонанције мотора кроз стуб управљача.<br><br><color value=@@clr_txt_d@@>Имајте на уму да подешавање ове вредности преко 15% може изазвати претерано подрхтавање и вибрације на неким воланима."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Подешава јачину ефеката површине пута преко стуба управљача.<br><br><color value=@@clr_txt_d@@>Имајте на уму да подешавање ове вредности преко 20% може изазвати претерано подрхтавање и вибрације на неким воланима када возите по неравном терену великом брзином."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Подешава јачину ефеката неравнина на путу кроз стуб управљача."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
