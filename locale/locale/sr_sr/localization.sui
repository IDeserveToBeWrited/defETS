	key[]: "online_connection_notification"
	val[]: "Игра ће покушати да успостави везу са серверима SCS-а током провере кључа." #+ Text shown at bottom of the activation screen

	key[]: "verification"
	val[]: "ПРОВЕРА КЉУЧА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "verifying"
	val[]: "Проверавам кључ. Молим, сачекајте." #+ Shown in message box while the verification operation is in progress.

	key[]: "verification_required"
	val[]: "Игра мора да провери ваш кључ. Провера ће покушати да користи вашу мрежну конекцију.<br><br>Ако овај рачунар није повезан на Интернет, искористите ванмрежну активацију описану на <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK>."

	key[]: "unable_to_verify"
	val[]: "Игра није успела да потврди ваш кључ. Засад можете наставити.<br><br>Провера ће бити поновљена приликом следећег покретања. Ако се проблем понови, молимо проверите да ли сте повезани на Интернет или искористите ванмрежну активацију описану на <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK>"

	key[]: "unable_to_verify_version"
	val[]: "Игра није успела да потврди ваш кључ, ажурирајте игру што пре.<br><br>Провера ће бити поновљена приликом следећег покретања. Ако се проблем понови, молимо проверите да ли сте повезани на Интернет или искористите ванмрежну активацију описану на <LINK URL=@@offline_activation_url@@ COLOR=@@clr_link@@>@@offline_activation_url@@</LINK>"

