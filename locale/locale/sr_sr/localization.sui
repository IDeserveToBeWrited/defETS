	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Омогућава међусцене у игри који се обично приказују након великих куповина или надоградње гараже."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Одаберите да ли ће се полупрозирни блокатори приказивати на путевима којима нема приступа."

