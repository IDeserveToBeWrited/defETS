	key[]: "show_autosaves"
	val[]: "Прикажи аутоматска чувања" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Није пронађен ручно сачуван." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Учитај" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Некомпатибилан снимак!<br><color value=@@clr_txt@@>Покушајте да ажурирате игру на најновију верзију." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Није успело учитавање и приказивање свих сачуваних датотека за овај профил." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "ПАЖЊА" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Проблем са учитавањем снимка.<color value=@@clr_txt@@><br><br>Овај снимак није учитан! Можете покушати да утврдите проблем користећи информацију испод или учитати неки други снимак.<br><br>Следећи разлози најчешће узрокују проблеме:<br><br>1. Снимак је некомпатибилан са неком од инсталираних МОД(а).<br><br>2. Снимак садржи информације из МОД(а) које недостају или су искључене.<br><br>3. Снимак је уништен због коришћења лошег МОД.<br><br>4. Пад система током или кратко након снимања може уништити снимак."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Недостаје МОД.<color value=@@clr_txt@@><br><br>Последњи снимак садржи референцу ка недостајућем или искљученом МОД(а).<br><br>Ако је ово неочекивано, проверите стање МОД(а).<br><br>Свеједно можете пробати да учитате снимак. Међутим, у зависности од тога шта је МОД(а) радио, могуће је да неће успети да учита или да изазове друге проблеме.<br><br>. Или пробајте да учитате други снимак, који не зависи од недостајућих МОД(а)."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Недостаје вам ДЛЦ.<color value=@@clr_txt@@><br><br>Последњи снимак садржи ДЛЦ (званично проширење игре).<br><br>Ако ово нисте очекивали, молимо проверите стање ДЛЦ(а).<br><br>Иако можете учитати снимак, неке опције које су у ДЛЦ(у) ће бити изгубљене.<br><br>Или учитајте снимак који не зависи од ДЛЦ(а)."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>НедостајеДЛЦ!<color value=@@clr_txt@@><br><br>Последњи снимак садржи референце ка ДЛЦ (званичном проширењу игре).<br><br>Да би овај снимак био употребљив, ДЛЦ мора бити присутан и активиран.<br><br>Или учитајте други снимак, који не зависи од недостајућег ДЛЦ."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>МОД зависи од ДЛЦ садржаја.<color value=@@clr_txt@@><br><br>Најмање један МОД зависи од ДЛЦ (званичне експанзије) који тренутно није инсталиран.<br><br>Искључите МОД(е) или инсталирајте ДЛЦ(е) од којих зависе."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Пад игре<color value=@@clr_txt@@><br><br>Изгледа да је игра пала приликом претходног учитавања.<br><br>Можете покушати да утврдите проблем користећи информацију испод, или учитати неки други снимак.<br><br>Следећи разлози најчешће узрокују проблеме:<br><br>1. Једна или више МОД су оштећени или некомпатибилни са овом верзијом игре.<br><br>2. Снимак садржи информације из МОД(а) које недостају или су искључене.<br><br>3. Снимак је уништен због коришћења лоше МОД.<br><br>4. У неким случајевима, грешке у драјверима и/или хардверу могу оборити игру."

	key[]: "mods_detected_warning"
	val[]: "Примећено присуство модова. Надамо се да већ знате да су лоши, застарели или некомпатибилни модови извор нестабилности. Прегледајте поново ваше активне модове у менаџеру." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

