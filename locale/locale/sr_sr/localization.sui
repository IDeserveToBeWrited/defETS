#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "ИЗАБЕРИТЕ ТИП МЕЊАЧА" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Најједноставнији метод вожње посебно намењен (али не и само) тастатури. Притисните НАПРЕД да возите унапред и притисните НАЗАД да возите уназад. Мењач ће бринути о свему осталом уместо вас: пребацивање између гаса, кочнице и вожње унатраг, убацивање у потребне брзине и томе слично."

	key[]: "wiz_gb_automatic"
	val[]: "Идеално за волан са педалама. Користите дугмад да пребацујете између вожње унапред, стајања у месту и вожње унатраг. Онда притисните педалу гаса и препустите аутоматици да контролише мењач."

	key[]: "wiz_gb_sequential"
	val[]: "Ручно мењајте брзине навише и наниже да изаберете брзине унапред, лер и рикверц. Ово је мало теже да се савлада, али ћете много боље возити тако и имати пуну контролу над возилом у многим ситуацијама."

	key[]: "wiz_gb_hshifter"
	val[]: "Директно бирате жељену брзину. Сличан по тежини секвенцијалном мењачу, али реалнији. Физички H-мењачи, као што су G27 и G25, се препоручују. Захтева и квачило."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ова могућност захтева волан, гејмпед или џојстик."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Није прикључен никакав контролер за H-мењач, па ова функција неће радити."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "ИЗАБЕРИТЕ НАЧИН Х-МЕЊАЧА"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Пренос распона је најједноставнији избор. Има два комплета брзина. Први комплет користи брзине од 1 до 6, а други од 7 до 12. Прекидач пребацује између та два, док мењач бира брзину из комплета."

	key[]: "wiz_hs_splitter"
	val[]: "Разделни пренос је једноставна алтернатива. Има два комплета брзина. Први комплет користи непарне брзине (1, 3, 5... ), а други комплет парне (2, 4, 6 ...). Прекидач пребацује између та два, док мењач бира брзину из комплета."

	key[]: "wiz_hs_range_splitter"
	val[]: "Ова врста мењача је заснована на изгледу правог ручног range-splitter мењача. Брзине су упарене по 4 за сваку позицију H-мењача и користи два прекидача. Саветује се само искусним возачима."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Игра је сада конфигурисана преко почетног подешавања описаног испод. Можете то још чачкати преко напредног подешавања или ући у игру."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Напредно подешавање"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Игра је сада подешена и можете наставити. Касније можете изменити подешавања под Опцијама: Контроле."

	key[]: "wiz_cfg_steam"
	val[]: "Можете да проверите и конфигуришете мапирање дугмади и оса за овај контролер помоћу Стеам клијента. Подешавања Стеам гејмпада за игру доступна су у Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Отвори подешавања контролера"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Користи @@imm_wiz_dsteerleft@@ и @@imm_wiz_dsteerright@@ за управљање."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Померајте миша лево или десно да окрећете волан у одговарајућем смеру."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Користи @@ima_wiz_j_steer@@ за управљање."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Користите @@imm_wiz_dforward@@ да возите унапред, а @@imm_wiz_dbackward@@ за вожњу унатраг."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Померите @@ima_wiz_j_throttle@@ контролу напред да возите унапред, а за вожњу унатраг је померите натраг."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Користите @@ima_wiz_j_throttle@@ да возите унапред, а @@ima_wiz_j_brake@@ да возите унатраг."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Користите @@imm_wiz_dforward@@ да убрзате, а @@imm_wiz_dbackward@@ да кочите."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Померите @@ima_wiz_j_throttle@@ контролу напред да убрзате, а унатраг да успорите."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Користите @@ima_wiz_j_throttle@@ да убрзате, а @@ima_wiz_j_brake@@ да кочите."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Користите @@imv_wiz_gearup@@ за вожњу напред а @@imv_wiz_geardown@@ за вожњу уназад."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Користите @@imv_wiz_gearup@@ за вожњу напред а @@imv_wiz_geardown@@ за вожњу уназад ако користите тастауру или контролер. Користите @@imv_wiz_drive@@ и @@imv_wiz_reverse@@ да изаберете смер вожње ако користите H-мењач."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Користите @@imv_wiz_gearup@@ и @@imv_wiz_geardown@@ да изаберете жељену брзину."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Користите ваш H-мењач заједно са @@ima_wiz_j_clutch@@ да изаберете жељену брзину."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "ПОДЕСИТЕ ОСЕ КОНТРОЛЕРА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Визуализација оси"

	key[]: "wiz_setup_axes_desc"
	val[]: "Можете и визуелно испробати све функције изабране осе. Користите контролер и гледајте у покретне стубиће. Показаће вам границе, центрирање, оријентацију и укупно понашање коришћених оса."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Подешавање оси"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Да бисте изабрали осу, притисните дугме поред имена осе. Тако ћете прећи у инпут мод. Након тога, користите свој контролер како бисте повезали изабрану осу померањем џојстика, волана или педале изабране осе."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Мртве зоне"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Мртва зона се односи на зону осе намерно осмишљену да нема уноса. Како бисте подесили мртву зону, померите одговарајући слајдер. Померањем слајдера надесно, повећавате мртву зону. Ова особина је нарочито корисна за старије контролере, јер подешавање веће мртве зоне може да умањи проблеме, попут непрецизности или неисправног уноса, проузрокованог од стране хардвера."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Режим оси"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Режим осе одређује како се њиме рукује у игри. Обрнута оса преокреће свој пријављени правац, што доводи до тога да се, на пример, управља лево уместо десно. Центрирана оса има своју подразумевану позицију у средини свог опсега, као што је џојстик. Овај режим је користан за исправљање осе која је погрешно откривена."

	key[]: "normal"
	val[]: "Нормално" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Обрнуто" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Центрирано" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Обрнут и центриран" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "ПОДЕШАВАЊЕ АУТОМАТСКОГ МЕЊАЧА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Са аутоматским мењачем бирате само вожњу унапред, лер и уназад. То ћете постићи користећи следеће тастере и дугмад на контролеру. Да промените распоред, кликните на дугме и притисните тастер или дугме, које желите за ту акцију."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Ако имате 'H-мењач' контролер, можете га лепо искористити да симулирате прави аутоматски мењач. Омогућите ову опцију и доделите позиције H-мењачу за вожњу унапред и уназад. Све друге позиције ће се рачунати као лер. Ово подешавање је смишљено посебно за H-контролер, тако да неће радити са обичном тастерима или дугмадима. Да промените додељене функције, кликните на дугме и померите мењач у жељену позицију, па онда назад у лер."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "ПОДЕШАВАЊЕ СЕКВЕНЦИЈАЛНОГ МЕЊАЧА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Секвенцијални мењач пролази кроз све брзине унапред, корз лер и унатраг. Ово су тастери и дугмад контролера која се користе за промену нагоре и надоле у споменутом реду. Да промените распоред, кликните на дугме и притисните тастер или дугме, које желите."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "ПОДЕШАВАЊЕ Х-МЕЊАЧА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Овде можете изабрати распоред за H-мењач и пробате га. На слици можете видети тренутне функције мењача као и која је брзина изабрана. Пошто мењач има више брзина од приказаних позиција, мораћете да користите дугмад за пребацивање између различитих комплета брзина."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Тренутно изабрана позиција мењача и активни прекидачи су такође приказани испод, поред додељене контроле. Да промените додељену контролу, кликните на одговарајуће дугме и померите мењач у жељену позицију, а онда назад у лер."
#@}

