#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "ГРАФИКА" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Графика" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Прилагодите подешавања графике користећи фино подешена унапред подешена подешавања да бисте прилагодили визуелне перформансе игре по свом укусу."

	key[]: "apply"
	val[]: "Примени" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Десктоп тема" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ПРИКАЗ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "КВАЛИТЕТ СЛИКЕ" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "ТЕКСТУРЕ" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "РЕФЛЕКСИЈЕ" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "СЕНКЕ" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ОСВЕТЉЕЊЕ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "НАКНАДНА ОБРАДА" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ОКРУЖЕЊЕ" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Преко целог екрана" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Осветљеност / ХДР" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Подеси" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Резолуција" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Освежавање" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "ФПС лимит" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "ФПС лимит позадине" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Фабричка вредност" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Херц" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Вертикална синхронизација" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Економично (чува батерије на лаптоповима)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ЈЕДНОСТАВНА ГРАФИЧКА ПОДЕШАВАЊА" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "ЛИЧНА ПОДЕШАВАЊА ПРИМЕЊЕНА" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "НАПРЕДНА ГРАФИЧКА ПОДЕШАВАЊА" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Једноставна/напредна графичка подешавања" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Сакријте напредне поставке" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Прикажи напредне поставке" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Размера" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Анти-алиасинг" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "ТАА лума изоштравање" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "ТАА подешавање" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Прилагодљива јасноћа" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Увек мекана" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Увек оштар" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Екранско апсорбовање околног простора (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Изражене боје и контраст (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Дубина области (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Пресијавање Сунца" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Поправка боја" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Скалирање рефлексије" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Детаљи одбљесака" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Детаљност вегетације" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Густина траве" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Квалитет сенчења"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Величина текстура сенки" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Далеке сенке" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Унутрашње сенке" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Квалитет временских прилика"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Квалитет огледала" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Резолуција огледала" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Домет огледала" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Квалитет текстура" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Анизотропско филтрирање" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Обично мапирање" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Светла саобраћаја" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Помоћна светла на возилу" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Домет светала" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Пешаци" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Подешавања приказа су промењена.<br>Да ли желите да остану оваква?"

	key[]: "reverting_in"
	val[]: "Повратак на старо за" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "секунди" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Када је омогућена, игра ће бити приказана на целом екрану."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Подесите укупну осветљеност игре тако да одговара вашем екрану. На ХДР-компатибилним екранима, опција ХДР калибрације ће такође бити доступна у овом подешавању."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Мења резолуцију игре."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Мења циљну брзину освежавања игре."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Усклађује брзину кадрова са брзином освежавања монитора како би се спречило цепање слике. Економско подешавање такође преполовљује брзину кадрова, што резултира мањом потрошњом енергије."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Поставља максималну дозвољену брзину кадрова за игру.<br><br>Постављање вредности на 0 ће онемогућити функцију."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Поставља максималну дозвољену брзину кадрова за игру када је минимизирана у позадини.<br><br>Постављање вредности на 0 ће онемогућити функцију."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Промене између једноставних графичких подешавања (пресет) или напредних графичких подешавања (могућност промене појединачних параметара)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Побољшава графичку верност рендеровањем игре у вишој резолуцији интерно, што смањује назубљене ивице и побољшава детаље.<br>На пример, избор веће опције скалирања резултира јаснијом сликом са мање замућења, што чини да игра изгледа боље у целини, али на штету перформанси.<br><br><color value=@@clr_txt_d@@>Ово подешавање често има велики утицај на перформансе."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Избор метода за брзо антиалијасинг које углађују изглед назубљених ивица у игри:<br>- СМАА узоркује сваки пиксел више пута (у зависности од изабраног квалитета) на различитим локацијама у оквиру и усредсређује узорке да би произвео коначну слику.<br>- TAA узоркује сваки пиксел само једном по кадру, али их узоркује на различитим локацијама и различитим кадровима.<br>- За најбољи резултат такође можете одабрати комбинацију оба науштрб перформанси.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Додаје меке сенке пукотинама и објектима који су у непосредној близини један другог, побољшавајући перципирану графичку верност целог света у игри.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Избор ТАА подешавања:<br>- „Увек меко“ ће резултирати мањим треперењем/већим замућењем – погодно је за кориснике рачунара који омогућавају суперсамплирање или имају монитор са високом DPI резолуцијом, али и за кориснике 1080p телевизора који седе даље од екрана.<br>-„Увек оштар“ доводи до више треперења/мање замућења – вероватно је најбоља опција за употребу испод 1080п, као што су лаптопови или Стеам Децк.<br>- „Адаптивна јасноћа“ динамички онемогућава подрхтавање TAA када је камера статична.<br><br><color value=@@clr_txt_d@@>Ово подешавање се може користити само када је TAA изабран као решење за анти-алиасинг."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава јачину ТАА оштрину лума.<br><br><color value=@@clr_txt_d@@>Ово подешавање се може користити само када је TAA изабран као решење за анти-алиасинг."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Када је омогућено, удаљене области на мапи могу бити вештачки замагљене да би се створио реалистичан пад фокуса у позадини."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Када је омогућено, зраци светлости могу бити видљиви када гледате у сунце или гледате у сунце кроз објекте као што су дрвеће, зграде или возила."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Када је омогућено, боје игре се динамички прилагођавају из естетских разлога. Сцене ће боље одговарати добу дана и временским условима, боје возила и других објеката могу бити живље итд."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Побољшава рефлексије тако што их интерно приказује вишег квалитета, као и коришћењем бољег антиалиасинга.<br><br><color value=@@clr_txt_d@@>Промене овог подешавања ће ступити на снагу тек након ручног поновног покретања игре."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава детаље рефлексија које се виде на површинама возила, прозорима и другим рефлектујућим површинама као што су локве, мокри путеви и отворене водене површине.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе.<br><br>Промене овог подешавања ће ступити на снагу тек након ручног поновног покретања игре."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Прилагођава детаље и сложеност биљака и дрвећа.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава густину траве која се види са стране пута.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава квалитет сенки од сунца или месеца.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Омогућава приказ сенки чак и са веома удаљених објеката.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Омогућује ноћне динамичке сенке у унутрашњости камиона.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава квалитет временских ефеката, као што су рефлексије."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава квалитет рефлексије у ретровизорима возила (независно од подешавања рефлексије).<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава резолуцију слике приказане на ретровизорима вашег возила."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава растојање на којем објекти почињу да се приказују у ретровизору.<br><br><color value=@@clr_txt_d@@>Ово подешавање често има велики утицај на перформансе."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава квалитет неких текстура примењених на објекте и површине у игри."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Побољшава оштрину текстура, посебно оних које се гледају на даљину или под косим углом.<br><br><color value=@@clr_txt_d@@>Промене овог подешавања ће ступити на снагу тек након ручног поновног покретања игре."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Додаје изглед геометријских детаља тротоарима, путевима и другим објектима како би побољшао њихов изглед.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе.<br><br>Промене овог подешавања ће ступити на снагу тек након ручног поновног покретања игре."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Омогућава осветљење од фарова других возила у саобраћају."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Омогућава осветљавање од секундарних светала других возила у саобраћају као што су показивачи, кочнице итд."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Подешава удаљеност са које се могу видети извори вештачког светла.<br><br><color value=@@clr_txt_d@@>Ово подешавање обично има умерен утицај на перформансе."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Омогућава пешаке у свету игре."
