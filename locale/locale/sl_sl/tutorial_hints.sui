
    key[]: "hint_engine_title"
	val[]: "Zaženi motor"

    key[]: "hint_engine_text"
	val[]: "Uporabi $KEY_engine$ za zagon motorja."


    key[]: "hint_ignition_title"
	val[]: "Vklop kontakta"

    key[]: "hint_ignition_text"
	val[]: "Uporabi $KEY_engineelect|KEY_engine$ za vklop kontakta."


    key[]: "hint_driv_arc_title"
	val[]: "Vožnja"

    key[]: "hint_driv_arc_text"
	val[]: "Uporabi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ in $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za premikanje naprej ali nazaj.<br><offset vshift=8>Uporabi $SPECIAL_steering$ za zavijanje."


    key[]: "hint_driv_auto_title"
	val[]: "Vožnja"

    key[]: "hint_driv_auto_text"
	val[]: "Uporabi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ in $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za premik naprej ali nazaj.<br><offset vshift=8>Uporabi $SPECIAL_steering$ za zavijanje.<br><offset vshift=8>Pritisni $KEY_gearup$ in $KEY_geardown$ za izbiro prestave."


    key[]: "hint_driv_seq_title"
	val[]: "Vožnja"

    key[]: "hint_driv_seq_text"
	val[]: "Uporabi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ in $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za premik naprej ali nazaj.<br><offset vshift=8>Uporabi $SPECIAL_steering$ za zavijanje.<br><offset vshift=8>Pritisni $KEY_gearup$ in $KEY_geardown$ za kontrolo sklopke."


    key[]: "hint_driv_hshift_title"
	val[]: "Vožnja"

    key[]: "hint_driv_hshift_text"
	val[]: "Uporabi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ in $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ za premik naprej ali nazaj.<br><offset vshift=8>Uporabi $SPECIAL_steering$ za zavijanje.<br><offset vshift=8>Zamenjaj prestave z <color value=@@clr_sel@@>menjalnikom<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Približaj se cilju"

    key[]: "hint_depot_deliv_text"
    val[]: "Ustavi se na označenem območju za izbiro končne težavnosti parkirnega mesta in pridobitev ustreznih izkušenj."


    key[]: "hint_fin_deliv_title"
    val[]: "Zaključi dostavo"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkiraj na izbranem parkirnem mestu. Ko si dovolj blizu dostavnega mesta, lahko za preskok parkiranja pritisneš $KEY_activate$."


    key[]: "hint_fin_deliv2_title"
    val[]: "Zaključi dostavo"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkiraj na izbranem parkirnem mestu. V @@desktop_menu_category_options@@ lahko omogočiš pripomoček, ki ti bo omogočil parkiranje preskočiti."


    key[]: "hint_lights_title"
    val[]: "Prižgi luči"

    key[]: "hint_lights_text"
    val[]: "Uporabi $KEY_light$ za prižig luči. S ponavljajočim pritiskanjem, lahko preklapljaš med različnimi načini."


    key[]: "hint_high_beam_title"
    val[]: "Prižgi dolge luči"

    key[]: "hint_high_beam_text"
    val[]: "Uporabi $KEY_hblight$ za prižig dolgih luči."


    key[]: "hint_wipers_title"
    val[]: "Prižgi brisalce"

    key[]: "hint_wipers_text"
    val[]: "Uporabi $KEY_wipers$ za prižig brisalcev in preklapljaj med različnimi nastavitvami hitrosti."


    key[]: "hint_zoom_title"
    val[]: "Pogled od blizu"

    key[]: "hint_zoom_text"
    val[]: "Uporabi $KEY_camzoom$ za povečavo pogleda v notranjosti. Izbor načina povečave med pridrži oz. preklopi se lahko izvede v @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Poglej naokoli"

    key[]: "hint_cam_int_text"
    val[]: "Uporabi $KEY_cam1$ za preklop kamere na notranji pogled."


    key[]: "hint_cam_ext_title"
    val[]: "Poglej naokoli"

    key[]: "hint_cam_ext_text"
    val[]: "Med različnimi pogledi kamere lahko preklapljaš s pritiskom $KEY_camcycle$.<br><offset vshift=8>Uporabi $KEY_cam2$ za preklop kamere na pogled iz zunanjosti."


    key[]: "hint_indicators_title"
    val[]: "Smerokazi"

    key[]: "hint_indicators_text"
    val[]: "Uporabi $KEY_lblinker$ in $KEY_rblinker$ za prižig smerokazov."


    key[]: "hint_tow_title"
    val[]: "Vlečna služba"

    key[]: "hint_tow_text"
    val[]: "Če ne moreš iz težavne pozicije, lahko uporabiš vlečno službo. Za dostop do vlečne službe odpri @@quick_info_word@@ meni z uporabo $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Zapora diferenciala"

    key[]: "hint_diff_lock_text"
    val[]: "Če se ne moreš začeti premikati, ti morda lahko pomaga zapora diferenciala. Uporabi $KEY_diflock$ za aktivacijo ali pa vključi avtomatsko zaporo diferenciala v @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Vključena zapora diferenciala"

    key[]: "hint_diff_unlock_text"
    val[]: "Med normalno vožnjo je priporočljiv izklop zapore diferenciala, saj lahko tvegaš poškodbe zapore. Uporabi $KEY_diflock$ za izklop zapore ali pa vklopi avtomatsko zaporo diferenciala v @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Ugasni brisalce"

    key[]: "hint_wipers_off_text"
    val[]: "Uporabi $KEY_wipers$ za ugašanje brisalcev in preklapljanje skozi različne hitrosti."


    key[]: "hint_world_map_title"
    val[]: "Pogled zemljevida"

    key[]: "hint_world_map_text"
    val[]: "Uporabi $KEY_navmap$ za odpiranje pogleda z zemljevidom."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Uporabi $KEY_advmouse$ za odpiranje @@quick_info_word@@ - pregled tvojega statusa z uporabnimi bližnjicami."


    key[]: "hint_pause_border_title"
    val[]: "Lokalni predpisi"

    key[]: "hint_pause_border_text"
    val[]: "Uporabi $KEY_advmouse$ za odpiranje @@quick_info_word@@ in si oglej trenutne predpise za regijo, v katero si vstopil."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Odpri @@quick_info_word@@ z uporabo $KEY_advmouse$ za vstop v @@photo_mode_word@@ in posnami bližnji @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ v bližini"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> je v bližini - poišči in aktiviraj jo za ogled izrezanega posnetka."


    key[]: "hint_resting_title"
    val[]: "Počivališče v bližini"

    key[]: "hint_resting_text"
    val[]: "Počivališča <img src=/material/ui/map/parking_ico.mat width=20 height=20> ti pomagajo, da si opomoreš od utrujenosti in opraviš obvezni odmor ter varno nadaljuješ potovanje."


    key[]: "hint_gas_title"
    val[]: "Bencinska črpalka v bližini"

    key[]: "hint_gas_text"
    val[]: "Bencinska črpalke <img src=/material/ui/map/gas_ico.mat width=20 height=20> lahko uporabiš za točenje goriva v tvoje vozilo."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "V meniju @@desktop_menu_category_options@@ lahko omogočiš pametno dodajanje plina. Z omogočanjem te funkcije, bo vozilo privzeto dodajalo manj plina. Po hitrem dvakratnem pritisku na gumb za plin, pa bo vozilo pospeševalo s polnim plinom, dokler ne sprostiš gumba za plin."
