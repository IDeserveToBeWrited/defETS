#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "POVEZANE VSEBINE S PORTALOM WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Poveži" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Prebrskaj" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "SPLOŠNE NASTAVITVE" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "POVEŽI VSEBINE" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Poveži" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "Portal World of Trucks je zaznal nove vsebine igre. Poveži se s storitvami portala World of Trucks za dostop do novih vsebin." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Splet" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Spletne nastavitve. Spreminjaj vse nastavitve povezane s portalom World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Res želiš počakati z registracijo?<br><br>Do okna za povezovanje vsebin lahko dostopaš kasneje preko Spletnih Nastavitev, ki jih najdeš v glavnem meniju igre." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "POVEZOVANJE VSEBIN" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Povezavanje vsebin..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Neuspešna vzpostavitev povezave za operacijo: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam račun uporabljen za registracijo tega DLC dodatka ni enak tistemu, ki je bil uporabljen za ustvarjanje tvojega računa na portalu World of Trucks ali za registracijo igre. Prosimo, zamenjaj Steam račun in poskusi ponovno." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam račun, ki ga uporabljaš za registracijo tega DLC dodatka, je že povezan z drugim računom na portalu World of Trucks. Za registracijo DLC dodatka s trenutnim računom, moraš uporabiti drug Steam račun, ki še ni povezan z nobenim računom na portalu World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam žeton je potekel. Prosimo, poskusi znova kasneje." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Serijski ključ uporabljen za aktivacijo DLC dodatka ni veljaven. Prosimo, kontaktiraj podporo: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Prišlo je do notranje napake med registracijo igre. Prosimo, poskusi znova kasneje." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "USPEŠNO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMACIJE" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "SPLET" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "BRSKALNIK VSEBIN" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Čestitamo! Izbrani DLC dodatki so bili uspešno povezani s tvojim računom na portalu World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Ni mogoče povezati vsebin, ker je trenutni Steam račun povezan z drugim računom na portalu World of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Povezava na nekatere DLC dodatke ni uspela.<br>Ze več informacij preletite z miško nad ikono klicaja, ki se nahaja ob DLC dodatku." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registriram $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Trenutni profil ni povezan s portalom World of Trucks ali pa je igra zagnana v brez-omrežnem načinu. Uredi profil za ponovno povezavo." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Klikni za opustitev"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ trenutno povezanih kompatibilnih DLC dodatkov. V primeru, da nekateri DLC dodatki niso povezani s portalom World of Trucks, lahko nekatere funkcionalnosti igre povezane z njimi manjkajo." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Čestitamo! <color value=@@clr_txt@@>Vse vsebine so uspešno povezane s portalom World of Trucks! Sedaj lahko uporabljaš vse funkcionalnosti igre." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Ni mogoče povezati novih vsebin s portalom World Of Trucks, ker se trenutno uporabljen Steam račun ne ujema s Steam računom uporabljenim v profilu portala World Of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Povezan" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nepovezano" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Neuspešno pridobivanje informacij o zakupljenih vsebinah." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Pridobivanje informacij o trenutno povezanih vsebinah neuspešno." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Pridobivanje informacij o trenutno uporabljenih vsebinah neuspešno." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Pozneje" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Neuspešna registracija DLC dodatka. Ni bilo najdene trajne licence, verjetno zaradi uporabe funkcionalnosti 'Steam Family Sharing'." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Brez trajnega lastnišva" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Misija izrednega prevoza končana!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISIJA NEUSPEŠNA!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Opusti"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Naloži kontrolno točko"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Poškodoval si spremno vozilo!<br>Ponovno lahko naložiš zadnjo kontrolno točko ali pa prekličeš dostavo z denarno kaznijo $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Spremno vozilo je bilo poškodovano z drugimi udeleženci prometa zaradi napačne vožnje.<br>Ponovno lahko naložiš kontrolno točko ali pa prekličeš dostavo z denarno kaznijo $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Moral bi slediti poti.<br>Ponovno lahko naložiš zadnjo kontrolno točko ali pa prekličeš dostavo z denarno kaznijo $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Mora bi ostani z spremnima voziloma.<br>Ponovno lahko naložiš kontrolno točko ali pa prekličeš dostavo z denarno kaznijo $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Zapeljal si stran od spremnih vozil!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Poškodoval si spremno vozilo!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Spremno vozilo se je zaletelo!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Zapeljal si s poti!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimenzije"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Dostave izrednega prevoza"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Prosimo zadržuj tovor med spremnimi vozili."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Izredne dostave"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimenzije"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Izredni Prevozi"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Prosimo, upočasni vožnjo za preprečitev trčenja s spremnim vozilom..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Prosimo, da počakaš na zadnje spremno vozilo..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Sedaj pa pazi, prihaja resnično tesen del poti..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Približuje se manever menjave voznega pasu. Prilagodi hitrost za preprečitev možnega trčenja..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Prednje spremno vozilo bo opozarjalo ostale voznike...<br>Prilagodi svojo hitrost, da se izogneš morebitnim nesrečam..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Spremna vozila te čakajo na bližnjem križišču. Prosimo, sledi poti do tja."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Pazi!<br>Približuješ se zadnjemu spremnemu vozilu!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Pazi!<br>Nevarno se približuješ zadnjemu spremnemu vozilu!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Prosimo, pritisni naslednjo tipko za pregled ponudb izrednega prevoza:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Ponudba izrednega prevoza:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Začenjaš izredni prevoz! S tabo sta dve spremni vozili, ki te bosta vodili. Prosimo, bodi previden in sledi njunim navodilom ter napotkom v obvestilih. Izredni prevozi kot je ta, se ne ustavijo na rdeči luči in imajo prednost v večini situacijah. Med temi dostavami so kontrolne točke shranjevanja igre bolj pogoste."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Posebej bodi pozoren na sledeče:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Izogibaj se kakršnemkoli konfliktu s spremni vozili in obdrži tovor med njima."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ne zavijaj s začrtane poti, prav tako ne zavijaj na bencinske črpalke, počivališča itd."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Drži se omejitev hitrosti, ki jih bo narekovalo prednje spremno vozilo."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Bodi pozoren na prehitevajoča vozila in ostale voznike na cesti."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manever menjave voznega pasu:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Če ne boš sledil tem navodilom, ti misija izrednega prevoza lahko spodleti!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manever se začne z <color value=@@clr_sel@@>zadnjim<color value=@@clr_txt@@> spremnim vozilom, ki bo zapeljalo v označen vozni pas in ga blokiralo."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "<color value=@@clr_sel@@>Prednje<color value=@@clr_txt@@> spremno vozilo počaka dokler se označen vozni pas ne izprazni, nato se tudi sam postavi na ta pas."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Potem lahko <color value=@@clr_sel@@>igralec<color value=@@clr_txt@@> varno zamenja v označeni vozni pas."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Rezervoarji v tovornjaku so bili napolnjeni in voznikove ure vožnje izbrisane."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Pomoč na cesti med izredno dostavo ni mogoča."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Ne moreš uporabljani trajekta med misijo izrednega prevoza."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Šel si na krajši počitek...<br>Dopolnjuje se gorivo v tovornjaku..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Približuješ se obveznemu postanku.<br>Sledi spremnemu vozilu na parkirno mesto za počitek!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Obvezni postanek"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Pritisni naslednjo tipko za počitek in dolivanje goriva:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Prišlo je do napake med nalaganjem vsebin Steam inventarja.<br><br>$ERROR$<br><br>Za nadaljnjo uporabo vsebine izberi Nadaljuj. Igra bo te vsebine vseeno redno iskala.<br><br>Če želiš ta sporočila odstraniti, lahko začasno onemogočiš uporabo teh vsebin. Vsebine bodo samodejno omogočene ob naslednjem zagonu igre." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Neuspešen prenos vsebin iz Steam inventarja." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM INVENTAR" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Nalaganje predmetov iz Steam inventarja..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOVI PREDMETI INVENTARJA" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Zaznani novi predmeti v Steam invetoriju" #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Dodatki vozila" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Dodatki kabine" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Ozadje Namizja" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Poslikave" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Onemogoči inventar" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Poskusi znova kasneje" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM INVENTAR" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Nekatere vsebine so bile odstranjene iz Steam inventarja. Teh vsebin ne bo več mogoče kupiti v Trgovini nadgradenj.<br><br>Kljub temu pa to ne vpliva na trenutno nameščene komponente." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
