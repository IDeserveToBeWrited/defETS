	val[]: "Odzivnost na smer glave" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Omogoči prevoj" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Omogoči položaj" #+ Enables use of head position

	key[]: "eye_yaw_scale"
