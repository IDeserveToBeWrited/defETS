	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Faktor naklona (v načinu hoje)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Maksimalni kot pogleda" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Hitrost sledenja pogleda"

	key[]: "eye_gaze_exponent"
	val[]: "Eksponent sledenja pogleda"

	key[]: "eye_gaze_inflection_point"
	val[]: "Prevojna točka sledenja pogleda"

