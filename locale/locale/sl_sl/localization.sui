#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banka" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Če potrebuješ denar, lahko vedno prosiš banko za kredit." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "PONUDBE KREDITOV" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "za $MONEY$ na dan" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Število aktivnih kreditov: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Lahko si sposodiš: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "PREGLED AKTIVNIH POSOJIL"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Posojilo" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Ostanek za plačilo" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Trajanje (v dneh)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Obrestna mera (na leto)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Obrok" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Poplačaj" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Skupno:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Denar na računu: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

	key[]: "bank_loan_unlock_requirement"
	val[]: "Za odklepanje posojil, najprej napreduj v svoji karieri v načinu tovornjaka."

	key[]: "bank_loan_locked_wrong_mode"
	val[]: "Za odklepanje posojil, najprej napreduj v svoji karieri v načinu $MODE$."

    key[]: "bank_loan_in_debt"
	val[]: "Imaš preveč dolga za pridobitev tega posojila."

