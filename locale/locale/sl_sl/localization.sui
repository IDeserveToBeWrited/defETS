#+ DLC manager
#+
#+ Messages for situations occurring due to management of DLCs.
#@{
	key[]: "dlc_acquire_timeout" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Pridobivanje DLC dodatkov traja dlje kot pričakovano. Pridobivanje se bo nadaljevalo v ozadju."

	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Pridobivanje DLC dodatkov traja dlje kot pričakovano. Želiš še naprej čakati?<br><br>Če boš nadaljeval, se bo pridobivanje nadaljevalo v ozadju."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Dostop do nekaterih DLC dodatkov je pridobljen. Ali bi sedaj želel oditi na začetni zaslon, da pridobiš dostop do novih vsebin?<br><br>Napredek bo samodejno shranjen."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "Dostop do nekaterih DLC dodatkov je bil izgubljen. Sedaj boš preusmerjen na začetni zaslon, da se bodo uveljavile spremembe vsebin.<br><br>Tvoj napredek bo shranjen samodejno."
#@}

