	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Nastavi krivuljo naraščanja hitrosti."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Nastavi razdaljo od sredine ekrana, kjer bo pospeševanje začelo pojenjati."

	key[]: "eye_gaze_start_point_op_tooltip"
