#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Nadaljuj ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Dobrodošli v Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Končno imaš možnost okusiti svojo sanjsko službo - voziti tovornjak!"

	key[]: "intro_3"
	val[]: "Tvoje lastno transportno podjetje je odprlo svoja vrata, ampak nimaš denarja za  nakup tovornjaka. Za sedaj boš moral delati za druga podjetja kot voznik."

	key[]: "intro_4"
	val[]: "Tvoja naloga je, da varno dostaviš vrsto tovora $JOB_CARGO$ v nakladališče $JOB_TARGET_COMPANY$ v $JOB_TARGET_CITY$. Tvoj delodajalec ti je priskrbel vozilo in bo kril vse nastale stroške. Ne razočaraj nikogar in glej, da prispeš pravočasno."


	key[]: "intro_garage_1"
	val[]: "To je tvoj sedež podjetja."

	key[]: "intro_garage_2"
	val[]: "Je le osnovna garaža. Ni veliko, ampak za začetek bo."

	key[]: "intro_garage_3"
	val[]: "Na žalosti nimaš kaj parkirati tukaj, zato ne vidiš nobenih tovornjakov."

	key[]: "intro_garage_4"
	val[]: "Enkrat, ko boš zaslužil dovolj denarja in si kupil tovornjak, se boš lahko prosto vozil po svetu in vodil posel od tu."

	key[]: "intro_garage_5"
	val[]: "Vso srečo!"


	key[]: "desktop_tut_t"
	val[]: "ODKLENJENA FUNKCIONALNOST"

	key[]: "desktop_tut_job"
	val[]: "Izberi naslednje delo"

	key[]: "desktop_tut_cargo_market"
	val[]: "Uporabi svojo čisto novo prikolico za dostop do Trga tovorov in dostavljaj širok asortiment blaga na svoj cilj." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Tukaj lahko vidiš svoj napredek."

	key[]: "desktop_tut_company"
	val[]: "Sledi dogajanju v garažah, najami nove voznike in urejaj druge stvari v tvojem podjetju od tukaj."

	key[]: "desktop_tut_trailers"
	val[]: "Od tega trenutka naprej lahko kupiš lastne prikolice in jih po želji nadgradiš in barvaš, da se bodo ujemale s tvojim tovornjakom.<br><br>Tvoje prikolice se lahko parkirajo v izbrane garaže, iz katere jih lahko prosto uporabljajo tudi tvoji vozniki za povečanje dobička. Za upravljanje tvojih prikolic uporabi Upravitelja Prikolic."

	key[]: "desktop_tut_visit_directive"
	val[]: "Pojdi na $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Uporabi gumb Način za preklapljanje med različnimi načini namizja in različnimi tipi vozil."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "DOBRODOŠLI"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Dobrodošli v novem začetnem zaslonu<br>Od tu se lahko povežete z vsemi funkcionalnostmi v igri."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Spodaj se nahaja glavni meni, ki omogoča neposredni dostop do vseh glavnih in že poznanih funkcij igre."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Nova statusna vrstica na vrhu omogoča stalni vpogled v uporabne igralčeve statistike in lokalne predpise."

	key[]: "desktop_tut_tour_home"
	val[]: "Gumb domov je vedno tukaj za vrnitev na domači zaslon."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Stalni hitri meni omogoča priročen dostop do bližnjic vseh funkcionalnosti igre iz kateregakoli zaslona."

	key[]: "desktop_tut_tour_drive"
	val[]: "Prenovljen gumb Pelji ostaja tvoja povezava z svetom vožnje in je pripravljen, da te vrne na cesto."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "VODIČ KONČAN"

	key[]: "desktop_tut_tour_finish"
	val[]: "Zahvaljujemo se ti za pregled naše posodobitve začetnega zaslona."


	key[]: "desktop_vehicle_mode_reenable_hints_t"
    val[]: "OMOGOČI NAMIGE"

    key[]: "desktop_vehicle_mode_reenable_hints"
    val[]: "Vstopaš v nov način igre, kontekstualni namigi pa so trenutno onemogočeni. Namigi ti lahko pomagajo pri učenju igre. Ali jih želiš ponovno vklopiti?"
#@}


