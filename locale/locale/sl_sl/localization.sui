#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafika" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Spremeni grafične nastavitve z uporabo fino nastavljenih prednastavitev, da bo vizualni izgled igre kar najbolj ustrezal tvojim željam."

	key[]: "apply"
	val[]: "Uporabi" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Tema Namizja" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ZASLON" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "KVALITETA SLIKE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEKSTURE" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "ODSEVI" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SENCE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "OSVETLITEV" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-PROCESIRANJE" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "SVET" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Celozaslonski način" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Svetlost / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Nastavi" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Resolucija" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Osveževanje" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS limit" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS limit v ozadju" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Privzeto osveževanje" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Navpična sinhronizacija" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomično (Prihrani energijo na prenosnikih)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ENOSTAVNE GRAFIČNE NASTAVITVE" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "NASTAVITVE PO MERI UPORABLJENE" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "NAPREDNE GRAFIČNE NASTAVITVE" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Enostave/napredne grafične nastavitve" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Skrij napredne nastavitve" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Prikaži napredne nastavitve" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skaliranje" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Glajenje robov" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma izostritev" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA tuning" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Prilagodljiva jasnost" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Vedno zglajeno" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Vedno ostro" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Okluzija okolice v zaslonskem prostoru (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Visok dinamični doseg (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Globinska ostrina (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Sončni efekti" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Barvna korekcija" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Skaliranje odsevov" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Kvaliteta odsevov" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Podrobnosti vegetacije" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Gostota trave" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Kvaliteta senc"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Velikost teksture sence" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Oddaljene sence" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Sence v notranjosti" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Kvaliteta vremena"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Kvaliteta ogledal" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Resolucija ogledal" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Razdalja ogledal" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Kvaliteta tekstur" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtriranje oddaljenih tekstur" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Mapiranje normal" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Prednje luči v prometu" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Ostale luči vozil" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Dolžina vidnosti luči" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Ljudje na ulici" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Zaslonske nastavitve so bile spremenjene.<br>Želite ohraniti te nastavitve?"

	key[]: "reverting_in"
	val[]: "Vračam v" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekunde" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Ko je funkcija omogočena, se bo igra izrisovala v celozaslonskem načinu."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Prilagodite splošno svetlost igre, da bo ustrezala vašemu zaslonu. Na zaslonih, združljivih s HDR, bo v tej nastavitvi na voljo tudi možnost kalibracije HDR."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Spremeni resolucijo igre."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Spremeni ciljno hitrost osveževanja v igri."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Uskladi hitrost izrisa s hitrostjo osveževanja monitorja za preprečitev trganja slike. Ekonomski način prepolovi osveževanje, kar posledično vpliva na manjšo porabo energije."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavi maksimalno dovoljeno osveževanje igre.<br><br>Če nastaviš vrednost na 0, bo celotna funkcionalnost izklopljena."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavi maksimalno dovoljeno osveževanje igre med izvajanjem v ozadju.<br><br>Če nastaviš vrednost na 0, bo celotna funkcionalnost izklopljena."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Preklopi način grafičnih nastavitev med prednastavitvami in razširjenimi grafičnimi nastavitvami."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Izboljša grafično natančnost z izrisom igre v višje notranje resolucije, ki zmanjšajo nazobčanost robov in izboljša podrobnosti.<br>Na primer, izbira večje resolucije bo izrisala jasnejšo in manj zamegljeno sliko, kar bo izboljšalo kvaliteto izgleda igre na račun zmogljivosti.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima pogosto velik vpliv na zmogljivost."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Izbor hitrih metod za ravnanje robov, ki zgladijo zobate robove v igri:<br>- SMAA večkrat vzorči vsak piksel (odvisno od izbrane kvalitete) iz različnih lokacij na istem posnetku in izračuna njihovo povprečje za končno sliko.<br>- TAA vzorči vsak piksel samo enkrat na posnetek, vendar jih vzorči iz različnih lokacij med večimi posnetki.<br>- Za kar najboljši rezultat lahko izbereš kombinacijo obeh metod v zameno za zmogljivost.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Razpokam in objektom, ki so si v neposredni bližini, doda mehke sence, kar izboljša verodostojnost grafičnega izgleda sveta kot celote.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Izbira TAA prednastavitev:<br>- \"Vedno mehko\" bo pomenilo manj utripanja in več zameglitve, kar je primerno za uporabnike nadvzorčenja ali pa uporabnike, ki imajo monitor z visoko DPI ločljivostjo. Hkrati je ta nastavitev primerna za uporabnike 1080p TV sprejemnikov, ki sedijo daleč od zaslona.<br>- \"Vedno ostro\" bo pomenilo več utripanja in manj zameglitve, kar je verjetno naboljša izbira za uporabnike zaslonov z ločljivostjo manjšo od 1090p, kot so npr. prenosniki ali pa Steam Deck naprave.<br>- \"Prilagodljiva jasnost\" dinamično onemogoči tresljaje TAA medtem, ko je kamera statična.<br><br><color value=@@clr_txt_d@@>Ta nastavitev je lahko uporabljena samo, ko je izbrani način glajenja robov TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavi moč luma ostrenja TAA.<br><br><color value=@@clr_txt_d@@>Ta nastavitev je lahko uporabljena samo, ko je za način glajenja robov uporabljena metoda TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Ko je funkcija vključena, bodo oddaljena območja na zemljevidu morda umetno zamegljena, da se ustvari realističen padec ostrine v ozadju."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Ko je ta funkcija vključena, bodo morda vidni svetlobni žarki ob pogledu v sonce ali pa ob pogledu v sonce skozi različne objekte, kot so drevesa, stavbe ali vozila."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Ko je ta funkcija vključena, so barve v igri dinamično prilagojene zaradi estetskih razlogov. Prizori bodo bolje prilagojeni času v dnevu in vremenskim razmeram. Barve vozil in drugih objektov bodo morda bolj živahne itn."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Izboljša izris odsevov s pomočjo risanja v večji notranji ločljivosti in uporabo boljšega glajenja robov.<br><br><color value=@@clr_txt_d@@>Spremembe te nastavitve bodo začele veljati šele po ročnem ponovnem zagonu igre."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi podrobnosti odsevov na površini vozila, oknih in drugih odsevnih površinah, kot so: luže, mokre ceste in ostale vodne površine.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost.<br><br>Spremembe te nastavitve bodo začele veljati šele po ročnem ponovnem zagonu igre."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi podrobnosti in kompleksnost rastlin in dreves.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi gostoto trave, ki je prikazana ob cesti.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi kvaliteto senc, ki jih mečeta sonce ali luna.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Omogoči izris sence tudi za zelo oddaljene objekte.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Omogoči dinamične sence v notranjosti vozila v nočnem času.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi kvaliteto vremenskih efektov, kot so odsevi."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi kvaliteto odsevov v ogledalih (nastavitev je neodvisna od ostalih nastavitev odsevov).<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi ločljivost slike izrisane na ogledalih tvojega vozila."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavi razdaljo, pri kateri se objekti začnejo izrisovati v ogledalu.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima pogosto velik vpliv na zmogljivost."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Prilagodi kvaliteto nekaterih tekstur uporabljenih na objektih in površinah v igri."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Izboljša ostrino tekstur, zlasti tistih, ki so gledane z velike razdalje oz. pod ostrim kotom.<br><br><color value=@@clr_txt_d@@>Spremembe te nastavitve bodo začele veljati šele po ročnem ponovnem zagonu igre."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Pločnikom, cestam in ostalim objektom so dodane geometrijske podrobnosti z namenom boljšega izgleda.<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost.<br><br>Spremembe te nastavitve bodo začele veljati šele po ročnem ponovnem zagonu igre."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Omogoči osvetlitev sveta s sprednjimi lučmi ostalih vozil v prometu."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Omogoči osvetlitev sveta z drugimi lučmi ostalih vozil v prometu, kot so: smerniki, zavorne luči itn."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavi razdaljo, pri kateri se začnejo videvati umetni svetlobni viri<br><br><color value=@@clr_txt_d@@>Ta nastavitev ima običajno zmerni vpliv na zmogljivost."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Omogoči peščce v igri."
