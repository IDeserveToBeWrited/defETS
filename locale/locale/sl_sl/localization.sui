	key[]: "eye_head_mode_direct"
	val[]: "Direktno" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinamično" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Odzivnost na smer oči" #+ How fast the view reacts to gaze changes

