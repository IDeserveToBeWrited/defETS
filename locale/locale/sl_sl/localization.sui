	key[]: "load_save_t"
	val[]: "SHRANI ALI NALOŽI IGRO" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "Shrani in naloži" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Zaznana sprememba v igri! Da bi se izognili problemom pri shranjevanju igre zaradi sprememb v igralnem svetu, so se vse nedokončane dostave prekinile brez kazni." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Zaznana sprememba v igri!<br><br>Da bi se izognili problemom pri shranjevanju igre, so se vse nedokončane dostave prekinile brez kazni. Potrebno je najti varno mesto za parkiranje tovornjaka.<br><br>Prosimo izberi ciljno mesto hitrega potovanja." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Shranjevanje..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Pritisni $KEY$ za preskok prizora." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
#@{

	key[]: "no_drive_t"
	val[]: "BREZ VOZILA" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "Ne moreš se prosto gibati po svetu, ker trenutno nimaš svojega vozila! Lahko ga kupiš ali vzameš enega iz svoje flote.<br><br>Želiš namesto tega opraviti hitro dostavo?"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "Naloži igro"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Naloži igro" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.
	
	key[]: "load_game_failed"
	val[]: "Nalaganje shranjene igre je spodletelo."

	key[]: "load_game_desc"
	val[]: "Naloži prej shranjeno igro. Trenutni napredek se bo izgubil!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Ali želiš naložiti drugo igro?<br><br> Tvoj trenutni napredek bo izgubljen, če ga predhodno nisi shranil."

	key[]: "load_progress_lost_mp"
	val[]: "Ali želite naložiti drugo igro?<br>V kolikor opravljaš dostavo v večigralskem načinu, lahko nalaganje druge igre privede do preklica dostave, premestitve do najbližjega servisa ali pa nedostopnosti izbrane dostave.<br><br>V kolikor trenutni napredek ni bil shranjen, bo le ta izgubljen."

	key[]: "load_game_mp_suspended_job"
	val[]: "Shranjena igra je bila uspešno naložena, vendar je bila tvoja trenutna dostava s portala World of Trucks odložena in je ni na voljo med igranjem v tej seji."

	key[]: "autosave"
	val[]: "- Avtomatsko shranjena igra -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "-HitroShranjevanje-" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Prikaži avtomatsko shranjene igre" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Ni najdenih nobenih ročnih shranjevanj." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Naloži" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Nekompatibilna shranjena igra!<br><color value=@@clr_txt@@>Poskusi nadgraditi igro na zadnjo razpoložljivo verzijo." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Spodletel je poskus nalaganja in prikaza vseh shranjenih iger za ta profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "POZOR" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problen nalaganja shranjene igre.<color value=@@clr_txt@@><br><br>Shranjena igra se ni mogla naložiti. Lahko poskusiš najti in odstraniti problem s pomočjo spodnjih informacij. Lahko pa poskusiš naložiti drugo shranjeno igro.<br><br>Probleme pogosto povzročijo naslednji razlogi:<br><br>1. Shranjena igra je nekompatibilna z nekaj izmed trenutno nameščenih MODOV.<br><br>2. Shranjena igra vsebuje informacije iz MODA(OV), ki je odstranjen ali onemogočen.<br><br>3. Shranjena igra je bila pokvarjena z uporabo slabo narejenega MODA.<br><br>4. Shranjeno igro lahko pokvari tudi zrušitev PC-ja med ali takoj po procesu shranjevanja igre."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Zaznan manjkajoči MOD.<color value=@@clr_txt@@><br><br>Zadnja shranjena igra je odvisna od manjkajočih oz. onemogočenih MODOV.<br><br>Če tega nisi pričkaoval, prosimo preveri stanje MODOV.<br><br>Vseeno pa lahko poskusiš naložiti igro, čeprav je vse odvisno od tega, kaj je MOD(I) spremenil. Lahko se zgodi, da se igra ne bo naložila ali se pojavijo drugi problemi.<br><br>Lahko pa naložiš drugo shranjeno igro, ki ni odvisna od manjkajočega MODA(OV)."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Zaznan manjkajoči opcijski DLC dodatek.<color value=@@clr_txt@@><br><br>Zadnja shranjenja igra je odvisna od enega ali več manjkajočih DLC dodatkov.<br><br>Če tega nisi pričakoval, prosimo, preveri stanje DLC-jev<br><br>V nasprotnem primeru nadaljuj igro, vendar je lahko nekaj funkcionalnosti, ki jih pirnašajo manjkajoči DLC dodatki, izgubljenih.<br><br>Lahko pa naložiš tudi drugo shranjeno igro, ki ni odvisna od manjkajočih DLC-jev."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Zaznan manjkajoči DLC dodatek.<color value=@@clr_txt@@><br><br>Zadnja shranjena igra je odvisna od manjkajočih DLC dodatkov (uradnih razširitev igre).<br><br>Za pravilno delovanje shranjene igre, mora biti ta DLC dodatek prisoten in aktiviran na tem računalniku.<br><br>Lahko pa naložiš drugo shranjeno igro, ki ni odvisna od manjkajočega DLC dodatka."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MOD bazira na DLC vsebini.<color value=@@clr_txt@@><br><br>Vsaj eden izmed MOD-ov bazira na DLC(originalni razširitvi igre), ki trenutno ni nameščen.<br><br>Onemogoči te MOD-e ali namesti DLC-je, katerih vsebina je potrebna za konfliktne MOD-e."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Zaznana zrušitev igre<color value=@@clr_txt@@><br><br>Zgleda, da se je igra zrušila med prejšnjim nalaganjem igre.<br><br>Lahko poskusiš najti in popraviti problem s pomočjo spodnjih informacij. Lahko pa poskusiš naložiti drugo shranjeno igro.<br><br>Probleme pogosto povzročijo naslednji razlogi:<br><br>1. En ali več nameščenih MODOV so pokvarjeni ali nekompatibilni s trenutno verzijo igre.<br><br>2. Shranjena igra vsebuje informacije iz MODA(OV), ki so bili odstranjeni ali onemogočeni.<br><br>3. Shranjena igra je bila pokvarjena z uporabo slabo narejenega MODA.<br><br>4. Včasih lahko zrušitev igre povzroči tudi napaka v delovanju strojne opreme ali gonilnikov.."

	key[]: "mods_detected_warning"
	val[]: "Zaznane modifikacije igre. Prosimo zavedaj se, da so pokvarjene, zastarele ali nekompatibilne modifikacije lahko razlog nestabilne igre. Prosimo, preveri aktivne modifikacije v Upravitelju Modifikacij." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

