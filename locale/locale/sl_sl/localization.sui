	val[]: "Želi odpreti internetni brskalnik in navigirati na izbrano spletno stran?"

#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Mrežni dostop nemogoč. Prosimo, preverite nastavitve odjemalca."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Ni mogoče vzpostaviti povezave do omrežnih storitev. Prosimo, preverite svojo internetno povezavo."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Napaka pri komunikaciji s spletno storitvijo. Prosimo, poskusite znova kasneje."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Napačni podatki iz smeri spletne storitve. Če je HTTP proxy v uporabi, preverite njegove nastavitve. V nasprotnem primeru poskusite kasneje."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Napačni podatki iz smeri spletne storitve. Prosimo, poskusite znova kasneje."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Storitev ni kompatibilna z vašo trenutno verzijo igre. Prosimo, preverite ali je na voljo posodobitev za igro."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Storitev trenutno ni na voljo. Prosimo, poskusite znova kasneje."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Storitev trenutno ni na voljo zaradi vzdrževanja ali preobremenjenosti. Prosimo, poskusite znova kasneje."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Avtentikacijski podatki niso veljavni. Prosimo, poskusite se prijaviti znova."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Spletni račun je trenutno zaklenjen zaradi preveliko napačnih prijav. Prosimo, poskusite znova čez pol ure."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Spletni račun je trenutno zaklenjen zaradi sumljivih dostopov. Prosimo, poskusi znova v 24 urah."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Ta kopija igre ni registrirana na ta spletni račun."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Račun še ni bil aktiviran. Prosimo, preverite nabiralnik e-pošte, kjer bi moram biti aktivacijska e-pošta."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Račun je suspendiran. Prosimo, kontaktirajte tehnično podporo."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Ta račun je prepovedan. Prosimo, kontaktirajte tehnično podporo."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy preverjanje pristnosti ni navoljo v igri. Prosimo uporabite drugi proxy ali direktno povezavo."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Zahtevan objekt trenutno ni na voljo. Prosimo, poskusi znova v nekaj minutah."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL napaka. Ni mogoče vzpostaviti varne povezave."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Igra je bila prekinjena med spletno komunikacijo. Prosimo, poskusi znova kasneje."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Notranja napaka. Datoteka net.log mogoče vsebuje več informacij."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 ima težave in ni zmožen izrisovati grafike na tvoj računalnik (ni veljavne grafične kartice).\nPredlagani koraki:\n\n1. Preveri, če računalnik in grafična kartica zadoščata minimalnim zahtevam strojene opreme.\n2. Posodobi tvoj računalnik na najnovejšo verzijo Microsoft DirectX-a.\n3. Prenesi in namesti zadnje grafične gonilnike iz proizvajalčeve spletne strani - po vsej vrjetnosti so gonilniki zastareli.\n4. Poskusi zamenjati metodo izrisovanja iz OpenGL-a na DirectX ali obratno.\n5. Izbriši konfiguracijsko datoteko igre 'config.cfg' v tvoji 'Dokumentih' - 'Euro Truck Simulator 2' mapi. Mogoče je datoteka poškodovana. Ta datoteka bo avtomatsko ustvarjena z veljavnimi privzetimi vrednostmi ob naslednjem zagonu igre."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 ima eno težavo in ne more dobiti dovolj grafične podpore na vašem računalniku (ni našel nobene grafične naprave)"
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "ČAROVNIK VHODA" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Naprej"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Zaključi čarovnika"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Preskoči čarovnika"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Čarovnik vhoda"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Želiš priklicati čarovnika vhoda?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "IZBERI NAČIN KONTROLE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Kontrolerji"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Na podlagi priključenih naprav bo čarovnik nastavil priporočene nastavitve.<br><color value=@@clr_sel@@>Če uporabljaš igralni plošček kompatibilen s Steam-om, lahko v Steam podpori omogočiš njihovo konfiguracijo preko <br><color value=@@clr_txt_d@@> \"Steam > Settings > Controller > General Controller Settings\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Vozi s pomočjo tipkovnice in se razglej naokoli s pomočjo miške. Najenostavnjša ampak najmanj natančna oblika kontroliranja, ki je dostopna vsakomur."

	key[]: "wiz_control_mouse"
	val[]: "Uporabi miško za bolj občutljivo zavijanje. Vse ostale akcije se še vedno izvedejo preko tipkovnice. Miško lahko za pogled okoli uporabiš samo, če hkrati držiš tudi posebno kontrolno tipko kamere."

	key[]: "wiz_control_controller"
	val[]: "Uporabi volan, igralni plošček ali igralno palico za bolj realistično doživetje igre. Bližnjice s tipkovnice so prav tako lahko uporabljene za doseganje marsikaterih funkcij. Poleg tega pa se lahko prosto ogleduješ okoli z miško (miškin pogled)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Ni bilo najdenga nobenega igralnega kontrolerja. Priključi enega sedaj, da lahko omogočiš to izbiro!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Odkrivanje razpoložljivih kontrolerjev ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "IZBERI API KONTROLERJA" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Mapiranje v igri (priporočeno)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Mapiranje Steam Client"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klasični kontroler"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Kontrolni ploščki @@controller_ps5@@, @@controller_xbox_one@@ ali @@controller_steam_deck@@ so dodeljeni Steam Input vhodu in uporabljajo enostavno postavitev.<br><br>Podprto je nastavljanje gumbov v igri."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Igralni ploščki so dodeljeni vmesniku Steam Input in uporabljajo samostojne postavitve konfiguriranje preko Steam vmesnika.<br><br>Podpora za prikaz napovedi gumbov je omejena, hkrati pa ni mogoče nastavljati gumbov v igri."

	key[]: "wiz_api_classical"
	val[]: "Kontroler, volan ali igralna palica preko DirectInput, XInput ali podobnega vmesnika."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "IZBERI TIP KONTROLERJA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volan"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Igralni plošček ali palica"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Kontroler je volan ali pa se bonaša kot volan. Pozicija kontrolerja direktno določi pozicijo volana v igir."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Kontroler je igralni plošček ali palica. Pozicija kontrolerja v igri določa hitrost obračanja volana."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "IZBERI TIP MENJALNIKA" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Pritisni NAPREJ za vožnjo naprej in pritisni NAZAJ za zaviranje oz. vzvratno vožnjo. Menjalnik bo avtomatsko naredil vse namesto tebe: prestavil med vožnjo naprej, zaviranjem ali vzvratno vožnjo, prestavil v primerno prestavo."

	key[]: "wiz_gb_automatic"
	val[]: "Uporabi gumbe za preklaplanje med vožnjo naprej, stoječe (nevtralno) ali vzvratno vožnjo. Potem pritisni gumb za pospeševanje in prepusti prestavljanje med prestavami avtomatskemu menjalniku."

	key[]: "wiz_gb_sequential"
	val[]: "Ročno pretikaj navzgor in navzdol za izbiro prestave menjalnika. Ta konfiguracija prinaša popolno kontrolo nad menalnikom vozila."

	key[]: "wiz_gb_hshifter"
	val[]: "Direktno izberi željeno prestavo. Ta način omogoča najbolj realno konfiguracijo. Priporočen je fizični H-menjalnik, ki zahteva uporabo sklopke."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Ta funkcionalnost zahteva volan, igralni plošček ali palico."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Ni zaznanega H-menjalnika. Zaznan je bil HW kontroler, zato bo ta funkcionalnost mogoče neuporabna."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "IZBERI VZOREC H-MENJALNIKA"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Nivojsko prestavljanje je najenostavnejša izbira. Ima dva nabora prestav. Prvi nabor vsebuje prestave od 1 do 6, drugi nabor pa prestave od 7 do 12. Gumb stikala prestavi med tema dvema setoma, medtem ko prestavna ročica izbere prestavo iz nabora."

	key[]: "wiz_hs_splitter"
	val[]: "Prestavljanje z razdelilnikom je enostavna alternativa. Prav tako vključije dva seta prestav. Pri set  vsebuje lihe številke prestav (1, 3, 5 ...) in drugi set, ki vsebuje sode številke prestav (2, 4, 6, ...). Gumb stikala prestavi med tema dvema setoma, medtem ko prestavna ročica izbere specifično prestavo iz seta."

	key[]: "wiz_hs_range_splitter"
	val[]: "Nivojski-razdelilnik menjalnika je osnovan na razporeditvi pravega ročnega nivojskega-razdelilnika. Na posamezno prestavo mesto H-menjalnika so vezane štiri prestave. Uporaba je priporočena le naprednim voznikom."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Igra je sedaj konfigurirana s privzetimi nastavitvami opisanimi spodaj. Lahko jih spremeniš z uporabo naprednih nastavitev ali pa direktno nadaljuješ v igro."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Napredne nastavitve"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Igra je sedaj konfigurirana in lahko nadaljuješ. Konfiguracijo lahko spremeniš kasneje v nastavitvah."

	key[]: "wiz_cfg_steam"
	val[]: "Za nastavljanje in kontrolo gumbov in osi za ta kontroler lahko uporabiš Steam-ov vmesnik. Steam nastavitve za igralne ploščke so na voljo v Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Odpri nastavitve kontrolerja"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Uporabi @@imm_wiz_dsteerleft@@ in @@imm_wiz_dsteerright@@ za zavijanje."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Premakni miško na levo ali desno za zavijanje volana v ustrezno smer."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Uporabi @@ima_wiz_j_steer@@ za zavijanje."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Uporabi @@imm_wiz_dforward@@ za vožnjo naprej in uporabi @@imm_wiz_dbackward@@ za vzvratno vožnjo."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Premakni @@ima_wiz_j_throttle@@ kontrolo naprej za vožnjo naprej in premakni nazaj za vzvratno vožnjo."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Uporabi @@ima_wiz_j_throttle@@ za vožnjo naprej in uporabi @@ima_wiz_j_brake@@ za vzvratno vožnjo."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Uporabi @@imm_wiz_dforward@@ za pospeševanje in uporabi @@imm_wiz_dbackward@@ za zaviranje."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Premakni @@ima_wiz_j_throttle@@ kontrolo naprej za pospeševanje in premakni nazaj za zaviranje."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Uporabi @@ima_wiz_j_throttle@@ za pospeševanje in uporabi @@ima_wiz_j_brake@@ za zaviranje."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Uporabi @@imv_wiz_gearup@@ za prestavljanje naprej in @@imv_wiz_geardown@@ za prestavljanje v vzratno."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Uporabi @@imv_wiz_gearup@@ za prestavljanje naprej in @@imv_wiz_geardown@@ za prestavljanje v vzratno, če uporabljaš tipkovnico ali gumbe kontrolerja. Uporabi @@imv_wiz_drive@@ in @@imv_wiz_reverse@@ za izbiro smeri vožnje, če uporabljaš H-menjalnik."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Uporabi @@imv_wiz_gearup@@ in @@imv_wiz_geardown@@ za izbiro željene prestave."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Uporabi H-menjalnik skupaj z @@ima_wiz_j_clutch@@ za izbiro željene prestave."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "NASTAVI OSI KONTROLERJA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Vizualizacija osi"

	key[]: "wiz_setup_axes_desc"
	val[]: "Vidno lahko preizkusiš funkcije vseh izbranih osi. Uporabi kontroler in glej premikajoče vrstice oz. stolpce. Izvedel boš, kje imajo limit, kako so centirrane, njihove orentacije in splošno obnašanje vsake izmed uporabljenih osi."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Nastavitev osi"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Za izbiro osi pritisni gumb poleg njenega imena. To te bo preklopilo v način vnosa, v katerem boš s premikom palice, volana ali pedala le-tega zvezal z izbrano osjo."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Mrtvo območje"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Mrtvo območje se sklicuje na del osi, ki je namerno uporabljen za nični vnos. Za spreminjanje mrvtega območjo izbrane osi premakni ustrezni drsnik. Pomikanje drsnika v desno bo povečalo mrtvo območje. Ta funkcionalnost je še posebej dobrodošla pri starejših kontrolerjih, saj lahko večje mrtvo območje pomaga premostiti težave v nenatančnosti ali lažnemu vnosu, ki je lahko posledica obrabe komponent kontrolerja."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Načini osi"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Način osi določi, kako je os obravnavana v igir. Obrnjena os zamenja njene smeri npr. zavijanje desno lahko postane zavijanje levo. Centrirana os ima privzeto pozicijo v sredini razpona (npr. igralna palica). Ta nastavitev je lahko uporabna, ko je os zaznana napačno."

	key[]: "normal"
	val[]: "Normalna" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Obrnjeno" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrirano" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Obrnjeno in centirrano" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "NASTAVITEV AVTOMATSKEGA MENJALNIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Z avtomatskim menjalnikom je potrebno prestavljati samo med načini: vožnja naprej, nevtralno in vzvratna vožnjo. To dosežeš z uporabo naslednjih tipk in gumbov kontrolerja. Za spremembo nastavitev, pritisni na gum in pritisni tipko (ali gumb kontrolerja), ki jo želiš uporabiti za to akcijo."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Če imaš priključeno strojno opremo H-menjalnika, ga lahko uporabiš za simulacijo pravega avtomatskega menjalnika. Omogoči to opcijo, tako boš lahko določil pozicije H-menjalnika za načine naprej in nazaj. Vse ostale pozicije H-menjalnika so prepoznane kot nevtralno. Ta nastavitev je ustvarjena posebej za H-menjalnike, torej nastavitev ne bo delovala z tipkami ali gumbi kontrolerja. Za spremembo dodelitve pritisni na gumb in premakni prestavno ročico v željeno pozicijo in nato nazaj v nevtralno."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "NASTAVITEV SEKVENČNEGA MENJALNIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvenčni menjalnik prestavlja med vsemi prestavami naprej, nevtralno in vzvratno. Tukaj so tipke in gumbi kontrolerja uporabljeni za prestavljanje gor in dol v omenjenem vrstnem redu. Za spremembo dodelitve, klikni na gumb in pritisni tipko (ali gumb kontrolerja), ki ga želiš uporabiti za to akcijo."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "NASTAVITEV H-MENJALNIKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Tukaj lahko izbereš glavni pogled H-menjalnika in preizkusiš njegove funkcije. Na spodnji sliki lahko vidiš trenutno pozicijo prestavne ročice, prav tako tudi katera prestava je uporabljena. Ker menjalnik uporablja več predstav, kot je pozicij na prestavni ročici, moraš uporabljati gumbe stikala za menjavo različnih setov prestav."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Trenutno izbrana pozicija prestave in aktivno stikalo sta tudi označena spodaj, zraven povezane kontrole. Za zamenjavo nastavljene kontrole, klikni primeren gumb in premakni ročico v želeno pozicijo in nato nazaj v nevtralno."
#@}

