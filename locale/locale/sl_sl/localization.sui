#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Izbira teme namizja, ki je prikazana v ozadju med brskanjem po menijih."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Omogoči naključno izbiro teme ozadja ob vsakem zagonu igre."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Nastavi zamik postopnega bledenja elementov namizja."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bo voznik med igro kazal znake postopne utrujenosti.<br><br>Izmikanje spancu bo povzročilo tudi prejemanje kazni."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, boš moral upoštevati prometne predpise ali pa boš tvegal, da boš dobil kazen za kršenje prometnih predpisov. Tveganje za pridobitev kazni je povečano ob navzočnosti policijskih vozil, radarjev in kamer za nadzor prometa."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavi povprečno dolžino dostav, ki so ti na voljo."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Izbira priakazane omejitve hitrosti na pripomočku navigacije."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Trenutna hitrost v pripomočku navigacije se ob prekoračitvi omejitve hitrosti spremeni v rdeče."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko boš prispel na cilj, se bo prikazal pripomoček, ki ti bo omogočil preskočiti parkiranje."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Ohrani vse pripomočke skrite."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Ohrani obe HUD ogledali skriti."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Ohrani vsa sporočila skrita tudi ob prejetju."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Prikaže okno zmogljivosti igralčevega trenutnega tovornjaka pred prevzemom dostave težkega tovora."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Izberi način poravnave zemljevida."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Izberi tip odkrivanja zemljevida:<br>- \"Bližinsko raziskovanje\" odkrije večje območje.<br>- \"Precizno raziskovanje\" odkrije samo področja v skrajni bližini igralca."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Izberi kako naj bo prikazana navigacija."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni način iskanja poti v navigaciji.<br>- \"Najboljše\" izbere najbolj efektivno razmerje med dolžino in trajanjem poti, hkrati pa se poskusi izogniti križiščem s semaforji itd.<br>- \"Najkrajše\" zmeraj izbere najkrajšo možno pot.<br>- \"Navadne ceste\" pa se zkuša izogniti avtocesti, kjerkoli je to mogoče."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni težavnost parkiranja:<br>-\"Zmeraj izberi\" omogoči izbiro načina, ko prispeš na cilj.<br>- \"Varno parkiranje\" ne uporablja vzvratnih manevrov.<br>- \"Izkušeno parkiranje\" bo v večini primerov zahtevalo uporabo izzivalnega vzvratnega manevriranja."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Spremeni verjetnost pojava nevarnosti na cesti v tvoji bližini, vključujoč: nesreče, pokvarjena vozila, cestne delce ipd."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Spremeni verjetnost pojava obvozov med opravljanjem dostave."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Spremeni verjetnost neugodnih vremenskih razmer."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi ali je informacija o časovnem pasu prikazana poleg trenutnega časa."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Omogoči prikaz video izsekov tipično prikazanih ob nakupu tovornjakov, nadgradnjah garaže ali pa med vkrcanjem potnikov."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi ali so prikazane delno prozorne blokade na nedostopnih cestah."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Invertira miškino Y-os ob kontroliranju kamere v igri."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Izberi tip menjalnika.<br>- \"Enostavni avtomatski menjalnik\" omogoča uporabo poseševanja in zaviranja za kontroliranje gibanja naprej in nazaj.<br>- \"Resnični avtomatski menjalnik\" zahteva vnos za pretikanje med pozicijo za vožnjo naprej in med pozicijo za vožnjo nazaj.<br>- \"Sekvenčni menjalnik\" zahteva ročno menjevanje vseh prestav z vnosom prestava navzgor/navzdol.<br>- \"H-Menjalnik\" zahteva uporabo kontrolerja s prestavno ročico za ročno izbiranje prestav."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Izbira te funkcionalnosti bo omogočala \"preskakovanje prestav\" - preskoči prestave po potrebi oz. praktičnosti, da se izogne prestavljanju med vsako prestavo."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Samodejno odvijanje volana na sredino, če je za kontrolo uporabljena tipkovnica ali igralni plošček.<br><br>Ob izklopu te funkcije boš moral sam poravnati volan na sredino po zavijanju."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavi doseg animacije zavijanja volana. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni moč zavor."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni stabilnost vozila z znižanjem težišča."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni stabilnost prikolice z znižanjem težišča."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Sprememba intenzivnosti generianega navora pogonskega sklopa.<br><br>Večanje te nastavitve bo povečalo občutek \"zvijanja\" vozila v desno."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni trdoto vzmetenja šasije."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni trdoto vzmetenja kabine."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni intenziteto proceduralno generiranih udarcev, ki dajejo občutek nepopolne podlage oz. luknjastih cest.<br><br>Glede na ostale nastavitve podvozja in kamere je lahko zaznava tega efekta bolj ali manj izrazita."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogoči napredno priklapljanje prikolice, ki zahteva večjo natačnost pri poravnavi tovornjakovega sedla s priklopom prikolice.<br><br>Če je funkcionalnost izklopljena, je priklapljanje prikolice veliko lažje, saj so trki med sedlom in priklopom izlkopljeni."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Izbere če in katere prikolice imajo animirane kable.<br><br><color value=@@clr_txt_d@@>Omogočanje kablov na več vozilih lahko vpliva na delovanje igre, predvsem na starejših sistemih."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Omogoči elektronski omejevalnik vozila, ki je odvisen od modela vozila.<br><br><color value=@@clr_txt_d@@>Delo s portala World of Trucks imajo to funkcijo zmeraj vključeno."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena in vključeni brisalci na prvi poziciji, bodo brisalci delovali avtomatsko, njihova hitrost pa se bo prilagajala glede na razmere."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogoči avtomatsko vklapljanje retarder zavore ob zaviranju."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija omogočena, vozilo pomaga pri speljevanju na klancu tako, da zadrži zavore in tako zagotovi gladko speljevanje."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogoči avtomatsko vklapljanje motorne zavore ob zaviranju."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija omogočena, se bo motor avtomatsko zagnal ob pritisku pedala za plin."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija omogočena, se parkirna zavora vozila uporabi samodejno (po uporabi trajetka, vleki na servis, hitrem potovanju itd.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Avtomatsko sproži spuščanje osi, ko je to potrebno zaradi teže vozila."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija omogočena, bo vozilo privzeto dodajalo manj plina. Po hitrem dvakratnem pritisku na gumb za plin, bo vozilo pospeševalo s polnim plinom, dokler ne sprostiš gumba za plin.<br><br>Vpliva samo na vhode s tipkovnice."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulira dejansko izgubo zraka zaradi pretirane uporabe zavor.<br><br>V kolikor je funkcionalnost vključena, boš moral upravljati z zavorami in njenimi tlaki med spuščanjem po hribih navzdol oz. pri počasnih manevrih z večkratnimi pritiski na zavore."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija izključena, stil vožnje oz. razmere na cesti ne vplivajo na porabo goriva.<br><br>Ko pa je funkcija vključena, na porabo goriva vpliva več faktorjev vključno s stilom vožnje, težo tovora, kotalni upor in tip terena. Nanjo pa več ne vpliva veščina @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija vključena, bo ABS preprečil blokiranje koles in obdržal kontrolo nad vozilo in tako pripomogel k boljšemu zaviranju."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija vključena, bo vozilo uporabljalo posamezne zavore koles za preprečevanje zdrsa pogonskih koles, podkrmarjenja ali prekrmarjena in s tem ohranjalo nadzor nad vozilom."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija vključena, bo vozilo za boljši oprijem takoj vključilo zaporo diferenciala, ko bo zaznal zdrs pogonkih koles."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni višino hitrosti za katero bo tempomat povečal ali pomanjaš hitrost, ob pritisku ustreznega gumba."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni toleranco tempomata za ohranjanje ciljne hitrosti."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija vključena, bi tempomat avtomatsko prilagodil vzdrževano hitrost in razdaljo do vozila pred sabo."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktivira zaviranje v sili, v kolikor sistem zazna skorajšnje trčenje.<br>Izberi ali bo sistem reagiral na vozila oz. na vse ovire."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Izbira načina asistenta za ohranjanje voznega pasu:<br>- Način \"Opozorilo pri zapuščanju voznega pasu\" uporablja zvočna opozorila tik preden bi vozilo zapustilo vozni pas.<br>- Poleg zvočnega signala, bo način \"Podpora pri zapušanju voznega pasu\" avtomatsko zavil s tvojim vozilom, zato da bo preprečil zapuščanje voznega pasu.<br><br>Oba načina sta aktiva samo pri hitrostih nad 55 km/h (~35 mph).<br>Dodatno pa asistent za ohranjanje pasu pred intervecijo upošteva uporabo smernikov."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogoči funkcionalnost senzorjev mrtvega kota, v kolikor je vozilo opremljeno z njimi."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija omogočena in luči vključene na prvo raven, se bodo luči avtomatsko vklapljale med vožnjo v sitacijah z malo svetlobe."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija omogočena in so hkrati vključene še dolge luči, bo vozilo avtomatsko zatemnilo dolge luči ob zaznavi nasproti vozečega vozila oz. drugega vozila pred sabo."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bodo smerniki avtomatsko izklopljeni po zavoju, ko se volan vrača v sredinski položaj."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena bodo nekateri notranji dodatki v vozilu reagirali na fizično premikanje vozila (obeski, zibajoče glave itn.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Omogoči zasuk notranje kamere glede na pozicijo volana."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni intenzivnost funkcije \"Samodejni zasuk kamere ob zavijanju\" glede na pozicijo volana."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni obnašanje funkcije \"Samodejni zasuk kamere ob zavijanju\" med vzvratno vožnjo."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija omogočena, bo notranja kamera usmerila pogled na levo oz. desno na podlagi uporabe smernikov."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Ko je funkcija omogočena, bo notranja kamera reagirala na premike vozila."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni intenzivnost premika notranje kamere glede na premike vozila."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni količino premika notranje kamere pri sledenju horizonta glede na premike vozila."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Spremeni za koliko se lahko spremeni kot vidnega polja (FOV) s hitrostjo."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavi zamik po katerem se kamera avtomatično centrira.<br><br>Za aktivacijo se mora vozilo premikati z dovolj veliko hitrostjo. Ta nastavitev velja samo za pogled kamere v notranjosti, pogled kamere v zunaj in med vzvratno vožnjo pogleda kamere skozi okno."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavi hitrost premikanja kamere. Ta nastavitev je uporabljena med centriranjem kamere in med prestavljanjem v različne prednastavljene poglede v notranjosti."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Določi kako deluje povečava notranje kamere: pritisni in pridrži gumb za začasno povečavo ali pa pritisni enkrat za preklapljanje." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Izbere jezik uporabljen za prikaz v igri."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Spremeni nastavitve denarne valute in enot glede na izbrano regijo."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bodo imena mest in držav prikazana v tvojem izbranem jeziku."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bodo imena mest in držav na zemljevidu prikazana v tvojem izbranem jeziku in domačem jeziku te regije."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi vrsto denarne valute."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi med 12 urnim oz. 24 urnim časovnim zapisom."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi vrsto dolžinskih enot."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi vrsto enot za maso."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi temperaturno enoto."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Izbere uporabljene enote za prikaz pritiska."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Izberi uporabljene zvočne enote."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Izbere uporabljene enote za prikaz porabe."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bo uporaba gumba \"Aktiviraj\" (@@imv_nrm_activate@@) odprla pogovorno okno sobe s konvojem."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bo pogovorno okno po pošiljanju sporočila ostalo odprto in aktivo."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bodo pogovorna sporočila izginila nekaj sekund po vsakem prejetem sporočilu."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Spremeni čas za katerega bodo pogovorna sporočila prikazana preden izginejo."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Ko je funkcija vključena, bodo imena igralcev med vožnjo v sobah s konvojem prikazana nad njihovimi vozili."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Odpre napredni meni za nastavljanje hitrih odgovorov za pogovore v sobah s konvojem."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Preveri status vsebine povezane s portalom World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
