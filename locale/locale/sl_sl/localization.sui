#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Datoteka zaslonskega posnetka je prevelika. Prosimo, poskusite zmanjšati ločljivost zaslona." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Datoteka zaslonskega posnetka je pokvarjena ali pa je zapisana v nepodprtem formatu." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Ločljivost zaslonskega posnetka je prevelika. Prosimo, poskusi zmanjšati ločlljivost zaslona." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Servis je zavrnil zaslonski posnetek." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "S tem računom nalaganje zaslonskih posnetkov ni dovoljeno." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "V isto okno se je že nalagal posnetek." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Nalaganje je trenutno onemogočeno. Prosimo, poskusi znova kasneje." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Med nalaganjem se je zgodila neznana napaka. Prosimo, poskusi znova kasneje." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Velikost datoteke zaslonskega posnetak je presegla maksimalno velikost, ki je $LIMIT$." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Velikost datoteke zaslonskega posnetak je presegla maksimalno velikost, ki je $LIMIT$fKB." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

