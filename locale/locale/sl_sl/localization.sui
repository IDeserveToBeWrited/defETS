	key[]: "mp_warning_on_job"
	val[]: "Trenutno že opravljaš dostavo. Za prevzem nove dostave, najprej zaključi ali prekliči trenutno dostavo."

	key[]: "mp_warning_trailer"
	val[]: "Tvoja trenutna prikolica ni združljiva s tem tovorom. Zamenjaj prikolico ali pa uporabi priskrbljeno opremo."

	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "Trenutno dostavljaš do podjetja, ki v tej seji ni aktivno.<br>Če se želiš povezati, najprej opravi svoje delo ali pa se bo to delo odložilo in ne bo na voljo med to sejo.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Trenutno dostavljaš do podjetja, ki v tej seji ni aktivno.<br>Če se želiš povezati, najprej opravi svoje delo ali pa bo preklicano.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Podjetje blizu tvojega tovornjaka ali prikolice bo moralo biti ponovno aktivirano, da se boš lahko pridružil seji.<br>Da se izogneš problemom lahko premakneš tovornjak in prikolico stran od tega podjetja ali pa bo tvoje trenutno delo odloženo in ne bo na voljo v tej seji. Hkrati boš teleportiran na najbližji servis.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Podjetje blizu tvojega tovornjaka ali prikolice bo moralo biti ponovno aktivirano, da se boš lahko pridružil seji.<br>Da se izogneš problemom lahko premakneš tovornjak in prikolico stran od tega podjetja ali pa bo tvoje trenutno delo preklicano. Hkrati boš teleportiran na najbližji servis.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_vehicle_close_cancel_teleport"
	val[]: "Podjetje, blizu katerga si pustil svoj tovornjak ali prikolico preden si prevzel hitro dostavo, bo moralo biti ponovno aktivirano, da se boš lahko pridružil seji.<br>Da se izogneš problemom pri vrnitvi v svoj tovornjak, se mora hitra dostava preklicati in izvesti teleportiranje na najbližji servis.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Tvoje izbrano delo vsebuje dostavo ali prevzem s podjetja, ki ni aktivno v tej seji in ne bo dostopno, ko se boš povezal.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Tvoj tovor je lociran v podjetju, ki ni aktivno v tej seji.<br>Če se želiš povezati, najprej naloži tovor ali pa bo tvoje trenutno delo odloženo in nedostopno v tej seji.<br><br>Želiš nadaljevati?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Tvoje delo je bilo preklicano, ker je vsebovalo dostavo do podjetja, ki ni aktivno v tej seji."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Tvoje delo je bilo preklicano, ker izredne dostave niso na voljo v konvojih."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Tvoje izbrano delo ni več na voljo, saj je izviralo s podjetja, ki ni aktivno v tej seji."

	key[]: "mp_warning_load_teleport"
	val[]: "Tvoj tovornjak je bil teleportiran do najbližjega servisa, ker je shranjena lokacija bila preblizu podjetja, ki je bilo aktivirano za ujemanje s to sejo."

	key[]: "mp_warning_load_cancel_teleport"
	val[]: "Tvoje delo je bilo preklicano, ker je vsebovalo dostavo do podjetja, ki ni aktivno v tej seji.<br>Hkrati je tvoj tovornjak bil teleportiran do najbližjega servisa, ker je shranjena lokacija bila preblizu drugega podjetja, ki je bilo aktivirano za ujemanje s to sejo."

