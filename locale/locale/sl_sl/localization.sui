	val[]: "Omogoči, če uporabljaš stikala namesto gumbov za vhode prestavnih območij in polovičk."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Določi gumb za prestavljanje v način vožnje pri avtomatskem menjalniku."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
