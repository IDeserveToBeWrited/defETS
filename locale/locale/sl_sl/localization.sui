	key[]: "eye_gaze_settings"
	val[]: "Nastavitve sledenja oči" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Nastavitve sledenja glave" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Kontrole tipkovnice" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Omogoči razširjen pogled" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Omogoči avtomatsko centriranje" #+ Headtracking autocentring

	key[]: "eye_head_mode"
