#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Izberi podtip kontrolerja uporabljenega v igri za pravilno zaznavno območja njegovih vhodov."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Izberi tip menjalnika.<br>- \"Enostavni avtomatski menjalnik\" omogoča uporabo poseševanja in zaviranja za kontroliranje gibanja naprej in nazaj.<br>- \"Resnični avtomatski menjalnik\" zahteva vnos za pretikanje med pozicijo za vožnjo naprej in med pozicijo za vožnjo nazaj.<br>- \"Sekvenčni menjalnik\" zahteva ročno menjevanje vseh prestav z vnosom prestava navzgor/navzdol.<br>- \"H-Menjalnik\" zahteva uporabo kontrolerja s prestavno ročico za ročno izbiranje prestav."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Spremeni logiko avtomatskega menjalnika:<br>- \"Ekonomski način\" preferira nižje obrate motorja usmerjene proti vrhu navora.<br>- \"Zmogljiv način\" preferira najvišje konjske moči za boljše vozne lastnosti med prevažanjem težkega tovora oz. med vožnjo v goratem terenu na račun slabše porabe goriva."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi razmerje med vhodom zavijanja in dejanskim zavijanjem vozila."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi linearnost med uprabniškim vnosom in zavijanjem vozila.<br><br>Višja vrednost pomeni, da bo zavijanje vozila manj odzivno blizu sredinske pozicije volana, v skrajni poziciji volana pa bo občutljivost zavijanja povečana. Takšna nastavitev bo omogočala gladko vožnjo naravnost."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Omogoči povratne sile na kontrolerjih, ki to omogočajo."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi skupno moč vseh povratnih sil, ki so lahko med 0N in 10N.<br><br><color value=@@clr_txt_d@@>Bodi pozoren, da lahko višja vrednost te nastavitve med uporabo z volanskimi napravami, ki so zelo zmogljive, povzroči poškodbe prstov ali rok."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi silo za centriranje pri velikih hitrostih. Ta sila doseže svoj vrh pri 90 km/h (56 mph) in višje.<br><br>Minimalna nastavitev te sile bo centriranje izničila."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi silo za centriranje pri nizkih hitrostih.<br><br>Minimalna nastavitev te sile bo centriranje izničila."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi moč sile notranjega trenja mehanskih komponent volanskega sklopa vozila."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi moč sile povzročene s prenosom resonance motorja v volanski sklop vozila.<br><br><color value=@@clr_txt_d@@>Bodi pozoren, da lahko nastavitev te sile nad 15% povzroči prekomerno tresenje in vibracije na nekaterih volanskih napravah."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi moč sile povzročene zaradi neravnega terena, ki se prenese v volanski sklop vozila.<br><br><color value=@@clr_txt_d@@>Bodi pozoren, da lahko nastavitev te sile nad 20% med vožnjo po neravnem terenu povzroči prekomerno tresenje in vibracije na nekaterih volanskih napravah."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi moč sile, ki jo povzročajo grbine na cestišču in se prenesejo v volanski sklop vozila."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi moč sile povzročene s trki, ki se prenesejo preko volanskega sklopa vozila."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi intezivnost efekta preskakovanja zobnikov menjalnika."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi intenzivnost efektov podkrmarjenja."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi intezivnost asistiranega zavijanja (med uporabo asistenta za ohranjanje voznega pasu ipd.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Prilagodi intenzivnost vibracij, ki jih povzroča površina terena, v kolikor kontroler podpira povratne vibracijske sile."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Prilagodi intenzivnost vibracij, ki dajejo občutek nepopolne podlage oz. luknjastih cest, v kolikor kontroler podpira povratne vibracijske sile."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Prilagodi intenzivnost vibracij, ki so posledica trkov vozila, v kolikor kontroler podpira povratne vibracijske sile."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os naprave, ki bo uporabljena za zavijanje."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi mrtvo območje osi za zavijanje; obseg vrtenja iz sredinskega položaja, ki bo ignoriran.<br><br>Ta nastavitev lahko premosti težave s starejšimi kontrolerji, kjer se lahko izogneš napačnemu vhodu, ki je povzročen zaradi obrabljenosti strojne opreme kontrolerja."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Določi način obravnave osi zavijanja:<br>- Centrirano je idealno za volane in igralne palice.<br>- Invertirano se uporabi v primeru napačne zaznave osi."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os naprave, ki bo uporabljena za pospeševanje vozila."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi mrtvo območje osi za pospeševanje oz. količino vhoda, ki bo ignorirana.<br><br>Ta nastavitev lahko premosti težave s starejšimi kontrolerji, kjer se lahko izogneš napačnemu vhodu, ki je povzročen zaradi obrabljenosti strojne opreme kontrolerja."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Določi način obravnave vhoda kontrolerja:<br>- Centrirano je idealno za igralne palice.<br>- Normalno je primerno za sprožilce na igralnem ploščku ali pedala.<br>- Invertirano se uporabi za kompenzacijo napačne zaznave smeri osi."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os naprave, ki bo uporabljena za zaviranje."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi mrtvo območje osi za zaviranje oz. količino vhoda, ki bo ignorirana.<br><br>Ta nastavitev lahko premosti težave s starejšimi kontrolerji, kjer se lahko izogneš napačnemu vhodu, ki je povzročen zaradi obrabljenosti strojne opreme kontrolerja."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Določi način obravnave vhoda kontrolerja:<br>- Centrirano je idealno za igralne palice.<br>- Normalno je primerno za sprožilce na igralnem ploščku ali pedala.<br>- Invertirano se uporabi za kompenzacijo napačne zaznave smeri osi."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os naprave, ki bo uporabljena za sklopko."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi mrtvo območje osi sklopke oz. količino vhoda, ki bo ignorirana.<br><br>Ta nastavitev lahko premosti težave s starejšimi kontrolerji, kjer se lahko izogneš napačnemu vhodu, ki je povzročen zaradi obrabljenosti strojne opreme kontrolerja."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Določi način obravnave vhoda kontrolerja:<br>- Centrirano je idealno za igralne palice.<br>- Normalno je primerno za sprožilce na igralnem ploščku ali pedala.<br>- Invertirano se uporabi za kompenzacijo napačne zaznave smeri osi."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi razpon sklopke.<br><br>Bolj kot je nastavitev nastavljena desno, bolj bo potrebno pritisniti pedal sklopke."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os naprave, ki bo uporabljena za naklon kamere navzgor in navzdol."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi mrtvo območje osi pogleda navzgor-navzdol oz. količino vhoda, ki bo ignorirana.<br><br>Ta nastavitev lahko premosti težave s starejšimi kontrolerji, kjer se lahko izogneš napačnemu vhodu, ki je povzročen zaradi obrabljenosti strojne opreme kontrolerja."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Določi način obravnave osi:<br>- Centrirano je idealno za igralne palice.<br>- Invertirano se uporabi v primeru napačne zaznave osi."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Os naprave, ki bo uporabljena za premik kamere levo in desno."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavi mrtvo območje osi pogleda levo-desno oz. količino vhoda, ki bo ignorirana.<br><br>Ta nastavitev lahko premosti težave s starejšimi kontrolerji, kjer se lahko izogneš napačnemu vhodu, ki je povzročen zaradi obrabljenosti strojne opreme kontrolerja."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Določi način obravnave osi:<br>- Centrirano je idealno za igralne palice.<br>- Invertirano se uporabi v primeru napačne zaznave osi."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Izbere razporeditev prestav, ki bodo uporabljene z H-Menjalnikom."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Spremeni način delovanja menjalnika:<br>- Z uporabo načina \"Enostavno\" se preskakovanje zobnikov med predstavljanjem ne bo nikoli zgodilo.<br>- Z uporabo nastavitve \"Enostavo + opozorilni zvoki\" se bo menjava prestav zgodila brez problemov, vendar se bo ob neprimernem prestavljanju predvajal zvok preskakovanja zobnikov.<br>- Način \"Napredno\" pa ti ne bo dovolil prestaviti v prestavo, če boš prestavljal napačno, hkrati pa se bo predvajal zvok preskakovanja zobnikov. Še več, omogočil ti bo tudi uporabo nastavitve \"Menjalnik hitra polovička\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Izberi način uporabe nastavitve menjalnika s hitrimi polovičkami:<br>- Način \"Nikoli\" bo zahteval prestavljanje ročice v prosti tek med prestavljanjem polovičk.<br>- Način \"Pritisk sklopke\" bo zahteval kratek pritisk sklopke brez menjave pozicije prestavne ročice.<br>- Način \"Sprostitev pedala za plin\" pa bo zahteval od voznika samo sprostitev pedala za plin pri menjavi polovičk. Zadnji način \"Sklopka ali pedal za plin\" pa je kombinacija obojega."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Določi položaj prestavne ročice."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Določi vhod, ki se uporabi za prestavljanje med prestavnimi območji."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Določi vhod, ki se uporabi za prestavljanje med polovičkami prestav."

