#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Obvezen DLC dodatek $DEPENDENCY_NAME$ manjka. Za pravilno delovanje shranjevanja igre, mora ta DLC dodatek biti prisoten in aktiviran. Za nadaljevanje je potrebno problem manjkajočega DLC dodatka rešiti." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Opcijski DLC dodatek $DEPENDENCY_NAME$ manjka. Če tega nisi pričakoval, prosimo, da preveriš stanje DLC dodatka.<br><br>Kljub temu lahko shranjeno igro naložiš, ampak vedi, da bodo funkcionalnosti manjkajočega DLC dodatka verjetno izgubljene." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modifikacija $DEPENDENCY_NAME$ manjka ali pa je onemogočena. Če tega nisi pričakoval, prosimo, preveri stanje modifikacije. Ne glede na to, lahko igro vseeno naložiš, vendar vedi, da lahko manjkajoča modifikacija povzroči padanje igre ali druge težave." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modifikacija $DEPENDENCY_NAME$ je nezdružljiva s tvojo verzijo igre. Avtor je modifikacijo označil združljivo le z določenimi verzijami igre in tvoja trenutna verzija igre ni med njimi.<br><br>Rešitve:<br>- Poizkusi najti verijo modifikacije, ki je zasnovana za delovanje s tvojo verzijo igre.<br>- Spremeni verzijo igre, ki bo združljiva z modifikacijo.<br><br>Ne glede na vse, lahko igro vseeno naložiš, omenjena modifikacija pa ne bo uporabljena. Prav tako vedi, da lahko manjkajoča modifikacija povzroči padanje igre ali druge težave." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "MANJKAJOČE ODVISNOSTI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "PODROBNOSTI" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Odpri Steam Workshop stran"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Shranjena igra je odvisna od manjkajočih DLC dodatkov ali modifikacij, ki so navedene spodaj. Z označevanjem posameznega vnosa lahko pridobiš podrobne informacije o vsakem izmed njih." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Shranjena igra je odvisna od vsaj enega DLC dodatka ali modifikacije. Pred  nadaljevanjem igre je to težavo potrebno odpraviti." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Prekliči nalaganje" #+ Abort loading button.

	key[]: "type"
	val[]: "Tip" #+ Type column.

	key[]: "dependency_name"
	val[]: "Ime odvisnega" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokalna modifikacija" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop modifikacija" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Opcijski DLC dodatek" #+ DLC that can be removed or disabled.

