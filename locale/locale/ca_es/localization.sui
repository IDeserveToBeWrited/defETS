#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "CONTINGUT CONNECTAT DE WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Connectar" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Cercar" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "OPCIONS GENERALS" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONNECTAR CONTINGUT" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Connectar" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks ha detectat nou contingut. Connecta't als serveis de World of Trucks per accedir al nou contingut." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "En línia" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Preferències en línia. Ajusta tot allò relacionat amb World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Vols posposar el registre?<br><br>Pots accedir al registre més tard des de les opcions en línia, situat a l'escriptori." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "CONNECTANT CONTINGUT" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Connectant contingut.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "No s'ha pogut posar a la cua l'operació de connexió per a: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "El compte de Steam que has utilitzat per registrar aquest DLC es diferent del compte que has utilitzat per crear el teu compte de World of Trucks o per registrar el joc. Si us plau, canvia el compte de Steam i torna a intentar-ho." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "El compte de Steam que has utilitzat per registrar aquest DLC està associat amb un compte diferent de World of Trucks. Per registrar el DLC al compte actual, necessites utilitzar un compte de Steam que no es trobi connectat a cap compte de World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "El testimoni d'autenticació de Steam ha caducat. Si us plau, intenta-ho més tard." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "El número de sèrie utilitzat per activar el DLC no és vàlid. Si us plau, contacta amb el suport: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "S'ha produït un error intern durant el registre del joc. Si us plau, intenta-ho més tard." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "AMB ÈXIT" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMACIÓ" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "EN LÍNIA" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "CERCADOR DE CONTINGUT" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Felicitats! Els DLC seleccionats s'han connectat satisfactòriament al teu compte de World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "No és possible connectar el contingut perquè el compte de Steam en ús està associat a un compte diferent de World of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Alguns DLCs han fallat al connectar.<br>Passa el ratolí sobre l'exclamació de cada DLC per veure'n més detalls." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrant $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "El perfil actual no està connectat a World of Trucks o el joc està funcionant en mode fora de línia. Edita el perfil per connectar-lo." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Clica per descartar"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLCs compatibles connectats en aquests moments. Si alguns DLCs no estan connectats a World of Trucks, podries perdre algunes de les seves característiques." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Enhorabona! <color value=@@clr_txt@@>Tot el teu contingut està connectat a World of Trucks! Ara pots utilitzar totes les seves característiques." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Impossible connectar nou contingut a World of Trucks perquè el compte actual de Steam no correspon amb el compte utilitzat per al perfil de World Of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Connectat" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "No connectat" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "No es pot obtenir la informació sobre el contingut comprat." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "No es pot obtenir la informació sobre el contingut connectat." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "No es pot obtenir la informació sobre el compte en ús." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Més tard" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "No s'ha pogut registrar aquest DLC. No s'ha trobat cap llicència permanent degut a la compartició de Steam Family." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Sense propietat permanent" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
