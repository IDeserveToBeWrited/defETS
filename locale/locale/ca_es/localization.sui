#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Tria el tipus de controlador per gestionar correctament els senyals d'entrada."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Selecciona el tipus de transmissió:<br>- \"Automàtica simple\" et permet usar l'accelerador i el fre per controlar la marxa endavant o enrere.<br>- \"Automàtica real\" necessita una pulsació per canviar entre marxa endavant o enrere.<br>- \"Seqüencial\" requereix canviar manualment per totes les velocitats i marxes.<br>- \"Caixa de canvis en H\" requereix un controlador de caixa de canvis en H per seleccionar la marxa manualment."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Canvia la lògica de la transmissió automàtica:<br>- El \"mode d'estalvi\" prioritza les revolucions baixes buscant el parell màxim.<br>- El \"mode de potència\" s'inclina per la potència màxima per un rendiment superior de conducció amb càrregues pesades o per terreny muntanyós, a canvi d'un consum de combustible més elevat."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la relació entre el grau de gir del dispositiu i el grau de gir de la direcció del vehicle."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la linealitat entre el controlador d'entrada i la direcció del vehicle.<br><br>Amb un valor alt, la direcció serà menys sensible quan el volant estigui centrat i incrementarà la sensibilitat en acostar el volant al seu gir màxim. Això et pot ajudar a suavitzar les ordres de gir del controlador quan condueixis en línia recta."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Habilita el force feedback en els controladors compatibles."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta el guany general per totes les configuracions del force feedback entre 0N i 10N.<br><br><color value=@@clr_txt_d@@>Tingues en compte que ajustant això amb valors alts en volants potents, et pot causar lesions als dits o a les mans."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força de centrat quan es condueix a alta velocitat, a 90 km/h (56 mph) o més.<br><br>Amb el valor mínim, el volant no farà força per centrar-se."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força de centrat quan es condueix a baixa velocitat.<br><br>Amb el valor mínim, el volant no farà força per centrar-se."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força de la fricció interna causada pels components mecànics de la direcció."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força de la ressonància del motor a través de la columna de direcció.<br><br><color value=@@clr_txt_d@@>Tingues en compte que amb valors per sobre del 15% pot causar sacsejades i vibracions excessives en alguns volants."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força dels efectes de la superfície de la carretera a través de la columna de direcció.<br><br><color value=@@clr_txt_d@@>Tingues en compte que amb valors per sobre del 20% pot causar sacsejades i vibracions excessives en alguns volants en conduir a gran velocitat per terrenys irregulars."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força dels efectes dels sots de la carretera a través de la columna de direcció."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la força dels efectes de les col·lisions a través de la columna de direcció."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensitat del fregament de la caixa de canvis."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensitat dels efectes del subviratge."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensitat de la direcció assistida, per exemple quan s'utilitza l'assistència al carril."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensitat de les vibracions causades per la superfície del terreny, si el controlador és compatible."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensitat de les vibracions causades pels sots de la carretera, si el controlador és compatible."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la intensitat de les vibracions causades per les col·lisions, si el controlador és compatible."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'eix del dispositiu que s'utilitzarà per la direcció."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona morta de l'eix de direcció: Fins a on s'ignora l'ordre de gir des del centre.<br><br>Això pot ajudar a mitigar problemes en controladors antics, com la inexactitud o falsos girs causats pel desgast."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina com gestiona el joc l'eix de direcció del controlador d'entrada:<br>- Centrat és ideal per volants o joysticks.<br>- Invertit s'utilitza per corregir una detecció errònia de l'eix."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'eix del dispositiu que s'utilitzarà per accelerar el vehicle."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona morta de l'eix d'acceleració: Fins a on s'ignora l'ordre d'acceleració en prémer l'accelerador.<br><br>Això pot ajudar a mitigar problemes en controladors antics, com la inexactitud o falses acceleracions causades pel desgast."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina com gestiona el joc el controlador d'entrada:<br>- Centrat és ideal per joysticks.<br>- Normal és ideal per gallets o pedals.<br>- Invertit s'utilitza per compensar una detecció errònia del controlador d'entrada."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'eix del dispositiu que s'utilitzarà per frenar."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona morta de l'eix de frenat: Fins a on s'ignora l'ordre de frenar en prémer el fre.<br><br>Això pot ajudar a mitigar problemes en controladors antics, com la inexactitud o falsos frenats causats pel desgast."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina com gestiona el joc el controlador d'entrada:<br>- Centrat és ideal per joysticks.<br>- Normal és ideal per gallets o pedals.<br>- Invertit s'utilitza per compensar una detecció errònia del controlador d'entrada."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'eix del dispositiu que s'utilitzarà per accionar l'embragatge."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona morta de l'eix d'embragatge: Fins a on s'ignora l'ordre d'embragar en prémer l'embragatge.<br><br>Això pot ajudar a mitigar problemes en controladors antics, com la inexactitud o falsos embragats causats pel desgast."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina com gestiona el joc el controlador d'entrada:<br>- Centrat és ideal per joysticks.<br>- Normal és ideal per gallets o pedals.<br>- Invertit s'utilitza per compensar una detecció errònia del controlador d'entrada."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta l'abast del l'embragatge.<br><br>Com més a la dreta estigui l'abast, més hauràs de prémer el pedal per embragar."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'eix del dispositiu que s'utilitzarà per inclinar la càmera amunt o avall."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona morta de l'eix per mirar amunt o avall: Fins a on s'ignora l'ordre en mirar amunt o avall.<br><br>Això pot ajudar a mitigar problemes en controladors antics, com la inexactitud o falses accions causades pel desgast."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina com gestiona el joc l'eix del controlador d'entrada:<br>- Centrat és ideal per joysticks.<br>- Invertit s'utilitza per corregir una detecció errònia de l'eix."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'eix del dispositiu que s'utilitzarà per desplaçar la càmera a dreta o a esquerra."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta la zona morta de l'eix per mirar a dreta o a esquerra: Fins a on s'ignora l'ordre en mirar a dreta o a esquerra.<br><br>Això pot ajudar a mitigar problemes en controladors antics, com la inexactitud o falses accions causades pel desgast."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina com gestiona el joc l'eix del controlador d'entrada:<br>- Centrat és ideal per joysticks.<br>- Invertit s'utilitza per corregir una detecció errònia de l'eix."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Selecciona la disposició del canvi de marxes per usar-lo amb la palanca de canvis en H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta el comportament del canvi de marxes:<br>- Amb l'opció \"Simple\" mai podràs fer carrisquejar les marxes en canviar.<br>- L'opció \"Simple + sorolls d'advertència\" et permetrà canviar, però faràs carrisquejar les marxes en canviar incorrectament.<br>- L'opció \"Avançat\" no et permetrà canviar si ho fas incorrectament i només faràs carrisquejar les marxes. Aquesta última opció també et deixarà utilitzar l'ajust de \"Divisor ràpid del canvi\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Tria el comportament del divisor ràpid del canvi:<br>- Amb \"Mai\" hauràs de moure la palanca de canvis a la posició neutral entre divisions.<br>- Amb \"Prémer embragatge\" hauràs d'accionar breument l'embragatge, sense moure la palanca de canvis.<br>- Amb \"Alliberar l'accelerador\" només hauràs d'alliberar l'accelerador, sense moure la palanca de canvis, per dividir les marxes. Per últim, \"Embragatge o accelerador\" és una combinació dels dos últims comportaments."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Assigna la posició de la palanca de canvis."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Assigna l'entrada usada per canviar entre rangs en funció del tipus de palanca de canvis."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Assigna el botó per canviar el divisor del canvi en funció del tipus de palanca de canvis."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Activa-ho quan utilitzis interruptors en comptes de botons per les entrades de rang o divisor."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Assigna el botó per passar al mode \"Conducció\" (D) de la transmissió automàtica."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Assigna el botó per passar al mode \"Marxa enrere\" (R) de la transmissió automàtica."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
