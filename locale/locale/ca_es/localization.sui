#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuar ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Benvingut/da a Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Per fi tens l'oportunitat d'experimentar la feina dels teus somnis: Conduir un camió!"

	key[]: "intro_3"
	val[]: "La teva pròpia empresa de transports està oberta, però no tens els diners per comprar un camió. Per ara hauràs de treballar per a altres companyies com a conductor contractat."

	key[]: "intro_4"
	val[]: "La teva tasca és entregar amb seguretat un carregament de $JOB_CARGO$ al moll de càrrega de $JOB_TARGET_COMPANY$ a $JOB_TARGET_CITY$. El teu ocupador t'ha facilitat un vehicle i cobrirà totes les teves despeses. No decebis a ningú i arriba a temps."


	key[]: "intro_garage_1"
	val[]: "Aquesta és la teva seu."

	key[]: "intro_garage_2"
	val[]: "És un garatge bastant bàsic. No és gran cosa, però és un començament."

	key[]: "intro_garage_3"
	val[]: "Malauradament encara no tens res per aparcar aquí, així que encara no hi ha camions a la vista."

	key[]: "intro_garage_4"
	val[]: "Un cop hagis guanyat prou diners i hagis comprat un camió, podràs moure't pel món lliurement i començar el teu propi negoci des d'aquí."

	key[]: "intro_garage_5"
	val[]: "Bona sort!"


	key[]: "desktop_tut_t"
	val[]: "CARACTERÍSTICA DESBLOQUEJADA"

	key[]: "desktop_tut_job"
	val[]: "Selecciona la teva propera feina"

	key[]: "desktop_tut_cargo_market"
	val[]: "Utilitza el teu remolc nou per accedir a les Càrregues i lliura una àmplia varietat de càrregues a les seves destinacions." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Aquí pots veure el teu progrés."

	key[]: "desktop_tut_company"
	val[]: "Fes un cop d'ull als teus garatges, contracta conductors nous i gestiona la teva empresa des d'aquí."

	key[]: "desktop_tut_trailers"
	val[]: "D'ara endavant, pots comprar els teus propis remolcs i millorar-los o pintar-los per combinar-los amb el teu camió.<br><br>Els teus remolcs es guarden al garatge que triïs; els teus conductors els poden usar per a incrementar els beneficis. Administra els teus remolcs al Gestor de remolcs."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visitar $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BENVINGUT/DA"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Benvingut/da al nou escriptori.<br>Des d'aquí pots interactuar amb totes les característiques del joc."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "A sota, el Menú Principal et dóna accés directe a totes les funcions del joc que ja coneixes."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "A dalt, la nova Barra d'Estat mostra constantment informació útil del jugador i les normatives de trànsit locals."

	key[]: "desktop_tut_tour_home"
	val[]: "El botó de l'escriptori està sempre aquí per tornar-te al teu escriptori."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "El Menú Ràpid t'ofereix dreceres a totes les característiques del joc des de qualsevol pantalla."

	key[]: "desktop_tut_tour_drive"
	val[]: "El remodelat botó Conduir segueix connectant-te amb tot un món per gaudir, a punt per tornar-te a situar a la carretera."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL FINALITZAT"

