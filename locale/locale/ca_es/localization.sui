	val[]: "Aquesta feina requereix un remolc en propietat. Tanmateix, actualment no tens cap remolc propi acoblat." #+ Message shown when player tries to continue external market job however they have no compatible trailer attached.

	key[]: "error_no_compatible_trailer_owned"
	val[]: "No tens cap remolc compatible amb aquesta feina." #+ Message shown if player does not own any trailer that would be compatible with the job but there is at least one available in trailer dealer.

	key[]: "required_trailer_external_header"
	val[]: "Paràmetres del remolc requerit:" #+ Header of the section describing what trailer is needed to finish the job.

	key[]: "error_no_compatible_trailer_available"
	val[]: "No hi ha cap remolc compatible en el joc; és possible que això passi per haver eliminat algun MOD o DLC. Reinstal·la aquest contingut o abandona aquesta feina." #+ Message shown if player does not own any trailer that would be compatible with the job and there is no compatible trailer available in game, probably due to removal od MOD or DLC.

	key[]: "error_incompatible_trailer_in_use"
	val[]: "El remolc acoblat actualment no és compatible amb la feina." #+ Message shown if player tries to resume external market job however currently attached trailer is not compatible with the job.

	key[]: "error_you_own_compatible_trailers"
	val[]: "Tens algun remolc compatible amb la feina en algun dels teus garatges." #+ Message shown if player owns at least one trailer compatible with the current external market.

	key[]: "browse_compatible_trailers"
	val[]: "Cercar remolcs compatibles" #+ Button opening compatible trailers browser where user can select trailer to continue delivering external market job from his own trailers.

	key[]: "open_trailer_dealer"
	val[]: "Comprar remolc" #+ Button opening trailer dealer external market job.

	key[]: "trailer_selector_t"
	val[]: "SELECCIÓ DEL REMOLC"

	key[]: "trailer_brand"
	val[]: "Marca"

	key[]: "expired"
	val[]: "Ha caducat" #+ Text shown on job offer instead of the time till expiration if job is expired.
