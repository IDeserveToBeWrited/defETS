	key[]: "mirrors"
	val[]: "Ajustar miralls" #+ Opens the mirror adjuster.

	key[]: "truck_mirror_help"
	val[]: "Configura els retrovisors per controlar millor el teu voltant." #+ Help message associated with mirror adjuster icon.

	key[]: "seat"
	val[]: "Ajustar seient"  #+ Opens the seat adjuster.

	key[]: "truck_seat_help"
	val[]: "Recol·loca el seient del conductor i el volant per a la màxima comoditat." #+ Help message associated with seat adjuster icon.

