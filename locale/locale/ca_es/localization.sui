	key[]: "next"
	val[]: "Següent"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Finalitzar assistent"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Ometre assistent"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Assistent de controls"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Vols cancel·lar l'assistent de controls?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SELECCIONA EL MÈTODE DE CONTROL" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Controladors"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>L'assistent aplicarà la configuració recomanada basant-se en els dispositius connectats.<br><color value=@@clr_sel@@>Si estàs utilitzant un comandament compatible amb Steam, considera activar el suport a la configuració a <br><color value=@@clr_txt_d@@>\"Steam > Configuració > Controlador > Configuració general del controlador\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Condueix fent servir el teclat i fes un cop d'ull al món amb el ratolí. És la manera més simple però menys precisa de controlar el joc, disponible per a tothom."

	key[]: "wiz_control_mouse"
	val[]: "Fes servir el ratolí per a una direcció més precisa. Pots fer servir el teclat per altres opcions. El ratolí permet mirar al voltant només si prems alhora el botó de control de càmera."

	key[]: "wiz_control_controller"
	val[]: "Fes servir un volant, un comandament o un joystick per tenir una experiència molt més realista a l'hora de jugar. Pots seguir fent servir les tecles d'accés ràpid del teclat per accedir a determinades funcions i pots mirar lliurement amb el ratolí."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "No s'ha detectat cap controlador. N'has de connectar un per habilitar aquesta opció!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Detectant controladors disponibles..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECCIONA L'API DEL CONTROLADOR" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Mode Mapejat en el joc (recomanat)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Mode Mapejat del client de Steam"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Controlador clàssic"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Comandaments com @@controller_ps5@@, @@controller_xbox_one@@ o @@controller_steam_deck@@ admesos a la interfície de Steam Input i usant una disposició simple.<br><br>Amb suport complet de configuracions d'associació de tecles en el joc."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Comandaments admesos a la interfície de Steam Input i usant disposicions independents configurades a través del client de Steam.<br><br>Suport limitat per indicacions dels botons en el joc i sense configuracions d'associació de tecles en el joc."

	key[]: "wiz_api_classical"
	val[]: "Controlador, volant o joystick utilitzant DirectInput, XInput o una interfície semblant."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELECCIONA EL TIPUS DE CONTROLADOR"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volant"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Comandament o joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "El controlador és un volant o es comporta com si ho fos. La posició del controlador especifica directament la posició del volant al joc."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "El controlador és un comandament o un joystick. La posició del controlador especifica la velocitat de rotació del volant al joc."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECCIONA EL TIPUS DE CANVI DE MARXES" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "El mètode de conducció més simple dissenyat especialment (però no exclusivament) per a fer servir el teclat. Prem ENDAVANT per conduir endavant i ENRERE per frenar o fer marxa enrere. La caixa de canvis es farà càrrec de tota la resta: canviarà de marxes de manera òptima segons vulguis anar endavant, frenar o fer marxa enrere."

	key[]: "wiz_gb_automatic"
	val[]: "Ideal per a un volant amb pedals. Fes servir els botons per canviar entre conducció cap a endavant, punt mort o marxa enrere. Després prem el pedal de l'accelerador i deixa que la caixa de canvis controli les marxes."

	key[]: "wiz_gb_sequential"
	val[]: "Puja i baixa de marxa, posa punt mort i marxa enrere manualment. És una mica més difícil de controlar, però pots aconseguir un millor rendiment de la conducció i tenir control total sobre el vehicle en diverses situacions."

	key[]: "wiz_gb_hshifter"
	val[]: "Selecciona directament la marxa desitjada. La dificultat és similar a la caixa de canvis seqüencial però és més realista. Es recomana tenir una palanca de canvis en H física, com la dels volants G27 o G25. Requereix embragatge."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Aquesta característica requereix un volant, un comandament o un joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "No s'ha detectat cap controlador extern de palanca de canvis en H, aquesta característica podria no estar disponible."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECCIONA LA COMPOSICIÓ DEL CANVI EN H"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "La transmissió amb rangs és l'elecció més senzilla. Té dos grups de marxes. El primer grup inclou les marxes de la 1 a la 6 i el segon de la 7 a la 12. Un botó selector alterna els dos grups mentre que la palanca de canvis selecciona una marxa específica de cada grup."

	key[]: "wiz_hs_splitter"
	val[]: "Les transmissions amb 'splitter' són una alternativa simple. Tenen dos grups de marxes. El primer conté les imparells (1, 3, 5...) i el segon les parells (2, 4, 6...). Un botó selector canvia entre aquests dos grups mentre el shifter selecciona una marxa del mateix."

	key[]: "wiz_hs_range_splitter"
	val[]: "La transmissió \"rang-divisor\" està basada en la disposició dels canvis manuals \"rang-divisor\" reals. Les marxes s'agrupen de quatre en quatre per cada posició de la caixa de canvis en H, usant dos commutadors. Aquest tipus de transmissió està recomanada només per a conductors avançats."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "El joc ara està configurat fent servir els ajustos per defecte descrits a continuació. Pots regular-los mitjançant la configuració avançada o pots continuar directament al joc."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Configuració avançada"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Ara el joc està configurat i pots continuar. Més endavant pots canviar la configuració a l'apartat de Controls al menú d'Opcions."

	key[]: "wiz_cfg_steam"
	val[]: "Pots comprovar i configurar l'assignació dels botons i dels eixos per aquest controlador a l'aplicació de Steam. Els ajustos del comandament de Steam estan disponibles a Steam > Biblioteca > Euro Truck Simulator 2 > Configuració del controlador."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Obrir la configuració del controlador"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Fes servir @@imm_wiz_dsteerleft@@ i @@imm_wiz_dsteerright@@ per a girar."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Mou el ratolí a l'esquerra o a la dreta per fer girar el volant en la direcció corresponent."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Fes servir @@ima_wiz_j_steer@@ per a girar."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Fes servir @@imm_wiz_dforward@@ per a conduir endavant i @@imm_wiz_dbackward@@ per a fer marxa enrere."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Mou el controlador @@ima_wiz_j_throttle@@ cap endavant per a conduir endavant i mou-lo cap enrere per a fer marxa enrere."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Fes servir @@ima_wiz_j_throttle@@ per a conduir endavant i @@ima_wiz_j_brake@@ per a fer marxa enrere."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Fes servir @@imm_wiz_dforward@@ per a accelerar i @@imm_wiz_dbackward@@ per a frenar."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Mou @@ima_wiz_j_throttle@@ cap endavant per a accelerar i mou-lo cap enrere per a frenar."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Fes servir @@ima_wiz_j_throttle@@ per a accelerar i @@ima_wiz_j_brake@@ per a frenar."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Fes servir @@imv_wiz_gearup@@ per conduir endavant i @@imv_wiz_geardown@@ per fer marxa enrere."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Fes servir @@imv_wiz_gearup@@ per conduir endavant i @@imv_wiz_geardown@@ per fer marxa enrere si estàs utilitzant el teclat o els botons del controlador. Fes servir @@imv_wiz_drive@@ i @@imv_wiz_reverse@@ per seleccionar el sentit de la marxa si estàs utilitzant una palanca en H."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Fes servir @@imv_wiz_gearup@@ i @@imv_wiz_geardown@@ per a seleccionar la marxa desitjada."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Fes servir el teu canvi en H juntament amb el @@ima_wiz_j_clutch@@ per seleccionar la marxa desitjada."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "CONFIGURACIÓ DELS EIXOS DEL CONTROLADOR" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualització dels eixos"

	key[]: "wiz_setup_axes_desc"
	val[]: "Pots obtenir una visualització prèvia de la funció de tots els eixos seleccionats. Fes servir el controlador i mira les barres que es mouen. Et dirà els límits, el punt central, l'orientació i el comportament general de cada eix utilitzat."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Configuració dels eixos"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Per triar un eix, clica en el botó al costat del nom de l'eix. Això et canviarà al mode d'entrada. Llavors utilitza el teu controlador per assignar l'eix seleccionat, movent el stick, el volant o el pedal."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Zones mortes"

	key[]: "wiz_setup_axes_desc3"
	val[]: "La zona morta es refereix a l'àrea de l'eix que, intencionadament, no proporciona cap entrada. Per ajustar la zona morta d'un eix, mou el control lliscant corresponent. Incrementant el control lliscant cap a la dreta, engrandiràs la zona morta. Aquesta característica és particularment beneficiosa per a controladors vells, ja que al definir una zona morta àmplia es poden mitigar problemes com la inexactitud o les falses entrades causades pel desgast del maquinari."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Modes dels eixos"

	key[]: "wiz_setup_axes_desc4"
	val[]: "El mode d'un eix determina com es controla l'eix en el joc. Un eix invertit inverteix la direcció de l'ordre: per exemple, si gires a la dreta, al joc girarà cap a l'esquerra. Un eix centrat té la seva posició per defecte al mig del seu abast (per exemple, un joystick). Aquesta configuració s'hauria de canviar quan no es detecta correctament un eix."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Invertit" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrat" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Invertit i centrat" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "CONFIGURACIÓ DEL CANVI DE MARXES AUTOMÀTIC" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Amb la caixa de canvis automàtica només has d'escollir entre anar endavant, posar punt mort o fer marxa enrere. Ho podràs fer mitjançant les tecles i els botons del controlador següents. Per a canviar la configuració, fes clic a un botó i prem la tecla o el botó del controlador al qual vulguis assignar l'acció."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Si tens connectat un controlador extern per a la caixa de canvis en H, el pots fer servir per simular una palanca de canvis automàtica real. Habilita aquesta opció i podràs assignar les posicions als modes de marxa endavant i endarrere. Qualsevol altra posició de la caixa de canvis en H es considerarà com si fos punt mort. Aquesta configuració està creada específicament pels controladors per a caixes de canvis en H, de manera que no funcionarà amb tecles o controladors normals. Per a canviar les assignacions, fes clic a un botó i a continuació mou la palanca de canvis a la posició desitjada; finalment torna a posar punt mort."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "CONFIGURACIÓ DEL CANVI DE MARXES SEQÜENCIAL" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "La caixa de canvis seqüencial alterna entre totes les marxes, el punt mort i la marxa enrere. A continuació hi ha les tecles i els controladors que es fan servir per pujar o baixar de marxa en l'ordre mencionat. Per canviar l'assignació, fes clic a un botó i després prem la tecla o el botó del controlador al qual vulguis assignar la funció."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "CONFIGURACIÓ DEL CANVI DE MARXES EN H" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Aquí pots escollir la configuració del canvi de marxes i provar les seves funcions. A la foto pots veure la posició actual de la palanca, i quina marxa hi ha posada. Com que la caixa de canvis del camió té més marxes que posicions la palanca, hauràs de fer servir els botons de selecció per a canviar entre els grups de marxes."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "La posició de la palanca de canvis i el grup seleccionats actualment estan indicats a continuació, al costat de la tecla o control associats. Per a canviar un control assignat, fes clic al botó apropiat, després mou la palanca de canvis cap a la marxa desitjada i finalment torna a posar punt mort."
#@}

