#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "SEGUIMENT DELS ULLS" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Vista ampliada" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Valors predefinits de la vista ampliada" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Introdueix el nom dels valors predefinits" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Segur que vols eliminar els valors predefinits seleccionats?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Els valors predefinits existents amb el mateix nom es sobreescriuran. Vols continuar?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Ajustos del seguiment de la mirada" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Ajustos del seguiment del cap" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Controls del teclat" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Activar la vista ampliada" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Activar autocentrat" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Mode del seguiment del cap" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Directe" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinàmic" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Sensibilitat de la vista a la mirada" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Sensibilitat de la vista al cap" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Usar capcineig" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Usar la posició" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Multiplicador de la guinyada (a la cabina)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Multiplicador del capcineig (a la cabina)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Multiplicador de la guinyada (mentre camines)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Multiplicador del capcineig (mentre camines)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Angle màxim de la mirada" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Velocitat del seguiment de la mirada"

	key[]: "eye_gaze_exponent"
	val[]: "Exponent del seguiment de la mirada"

	key[]: "eye_gaze_inflection_point"
	val[]: "Punt d'inflexió del seguiment de la mirada"

	key[]: "eye_gaze_start_point"
	val[]: "Punt d'inici del seguiment de la mirada"

	key[]: "eye_gaze_end_point"
	val[]: "Punt final del seguiment de la mirada"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Sensibilitat de la guinyada del seguiment del cap (a la cabina)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Sensibilitat del capcineig del seguiment del cap (a la cabina)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Sensibilitat de la guinyada del seguiment del cap (mentre camines)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Sensibilitat del capcineig del seguiment del cap (mentre camines)"

	key[]: "eye_head_exponent"
	val[]: "Exponent del seguiment del cap"

	key[]: "eye_head_inflection_point"
	val[]: "Punt d'inflexió del seguiment del cap"

	key[]: "eye_head_start_point"
	val[]: "Punt d'inici del seguiment del cap"

	key[]: "eye_head_end_point"
	val[]: "Punt final del seguiment del cap"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Activa la Vista Ampliada, incrementant el teu angle de visió en utilitzar el moviment del cap o dels ulls per controlar la càmera del joc."

	key[]: "eye_preset_op_tooltip"
	val[]: "Selecció de les preconfiguracions de la Vista Ampliada."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Selecció del mode de seguiment del cap:<br>- En el mode \"Directe\", la rotació del teu cap correspon directament a la rotació de la càmera del joc. Es recomana en situacions normals dins la cabina.<br>- En el mode \"Dinàmic\", la teva mirada només afectarà la càmera quan giris el cap. Es recomana quan és important que la teva vista estigui absolutament centrada."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Si s'activa, la càmera del joc se centrarà lentament a mesura que canviïs a la posició natural del cap mentre jugues."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Si s'activa, la posició del cap afecta la posició de la càmera del joc."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Si s'activa, la càmera del joc s'inclinarà de la mateixa manera quan inclinis el teu cap a banda i banda."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multiplica la rotació combinada del cap i la mirada en la direcció horitzontal (a la cabina)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multiplica la rotació combinada del cap i la mirada en la direcció vertical (a la cabina)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multiplica la rotació combinada del cap i la mirada en la direcció horitzontal (mentre camines)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multiplica la rotació combinada del cap i la mirada en la direcció vertical (mentre camines)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Ajusta la rapidesa de la càmera del joc en respondre als moviments de la teva mirada."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Controla l'augment gradual de la velocitat."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Ajusta la distància des del centre de la pantalla on es començarà a anivellar l'acceleració."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Ajusta a quina distància del centre de la pantalla hauràs de mirar abans que la càmera del joc es comenci a moure."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Ajusta a quina distància del centre de la pantalla hauràs de mirar per assolir la màxima velocitat de la càmera."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Determina fins a quin punt la càmera pot girar quan mires als costats de la pantalla."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Ajusta la rapidesa de la càmera del joc en respondre als moviments del teu cap."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Ajusta quant girarà a dreta o esquerra la càmera del joc en comparació amb el que giris el cap (a la cabina)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Ajusta quant pujarà o baixarà la càmera del joc en comparació amb el que giris el cap (a la cabina)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Ajusta quant girarà a dreta o esquerra la càmera del joc en comparació amb el que giris el cap (en mode caminar)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Ajusta quant pujarà o baixarà la càmera del joc en comparació amb el que giris el cap (en mode caminar)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Controla l'augment gradual de la velocitat."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Ajusta quant hauràs d'inclinar el cap perquè l'acceleració comenci a estabilitzar-se."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Ajusta quant has de girar el cap des de la posició central abans que la càmera del joc es comenci a moure."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Ajusta fins a on has de girar el cap des de la posició central per arribar al màxim de la rotació de la càmera."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Selecció del mode d'autopausa."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Ajusta la quantitat de temps en mil·lisegons abans que el joc es posi en pausa automàticament quan no es detecti la mirada."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Assigna un botó per definir la posició actual del cap com a la nova posició per defecte, centrant novament la càmera del joc en conseqüència."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Assigna un botó per activar/desactivar totes les funcions de la Vista Ampliada de Tobii."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Assigna un botó per obrir els ajustos del seguiment dels ulls."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Assigna un botó per habilitar el seguiment del cap."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Assigna un botó per aplicar la preconfiguració corresponent de la Vista Ampliada."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Assigna un botó per aplicar la preconfiguració corresponent de la Vista Ampliada."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Assigna un botó per aplicar la preconfiguració corresponent de la Vista Ampliada."
