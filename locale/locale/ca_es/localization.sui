	key[]: "wotr_connected_content"
	val[]: "Contingut de World of Trucks connectat" #+ Information and buttons for connecting World of Trucks content.

	key[]: "online_news"
	val[]: "Notícies en línia" #+ Checkbox enabling display of online news and informations about game updates.

