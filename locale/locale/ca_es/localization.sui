#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "El fitxer de la captura és massa gran. Si us plau, intenta reduir la resolució de pantalla." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "La captura de pantalla està malmesa o no és compatible." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "La resolució de la captura és massa gran. Si us plau, intenta reduir la resolució de la pantalla." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "El servidor ha rebutjat la captura." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "No està permès pujar captures amb aquest compte." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Hi ha una pujada simultània al mateix espai." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "La pujada està actualment desactivada. Si us plau, intenta-ho més tard." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Hi ha hagut un error desconegut durant la pujada. Si us plau, intenta-ho més tard." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "La captura de pantalla és més gran que la mida màxima de $LIMIT$ i s'ha redimensionat." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "La mida de la captura de pantalla és més gran que la mida màxima de $LIMIT$KB i s'ha redimensionat." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
