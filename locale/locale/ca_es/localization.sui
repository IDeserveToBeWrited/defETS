	key[]: "upload_profile_screenshot"
	val[]: "Vols pujar la captura de pantalla per a què sigui el camió del teu perfil de World of Trucks?<br><br>La imatge del perfil prèvia se sobreescriurà!"

	key[]: "wotr_upload_title"
	val[]: "AVÍS DE PUJADA"

	key[]: "new_screenshot"
