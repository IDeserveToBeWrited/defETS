	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Si us plau, redueix la velocitat per evitar xocar amb el vehicle escorta..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Si us plau, espera al vehicle escorta del darrere..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Vés amb cura ara, una part molt estreta de la ruta s'està aproximant..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "La maniobra de canvi de carril començarà. Adapta la teva velocitat per evitar un possible xoc..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "El vehicle escorta davanter alertarà als altres conductors... <br> Adapta la teva velocitat per evitar un possible xoc..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Els vehicles escorta t'estan esperant en una intersecció propera. Si us plau, segueix la ruta."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Vés amb compte!<br>T'estàs apropant al vehicle escorta posterior!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Vés amb compte!<br>T'estàs apropant perillosament al vehicle escorta posterior!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Si us plau, prem aquesta tecla per a veure l'oferta de feina especial:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Oferta de treball especial:"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Estàs a punt d'acceptar un carregament de transport especial! Hi ha dos vehicles d'escorta que t'acompanyaran. Si us plau, vés amb compte i segueix les seves notificacions amb indicacions i suggeriments. Un transport especial com aquest no s'atura als semàfors en vermell i té preferència de pas en la majoria d'ocasions. Durant aquestes entregues, el teu progrés es guardarà més sovint."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Posa atenció al següent:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Evita qualsevol conflicte amb els vehicles escorta i mantén la càrrega entre ells."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "No condueixis fora de la ruta estimada, ni a gasolineres, ni a àrees de descans, etc."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Obeeix els límits de velocitat que et marcarà el vehicle escorta davanter."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Vés en compte amb els avançaments i amb els altres conductors de la carretera."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Maniobra per canviar de carril:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Si no segueixes les normes, la teva missió de Transport Especial podria fallar!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "La maniobra la inicia l'escorta <color value=@@clr_sel@@>posterior<color value=@@clr_txt@@> canviant i bloquejant el carril designat."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "El vehicle escorta <color value=@@clr_sel@@>frontal<color value=@@clr_txt@@> espera fins que el carril designat no estigui ocupat, després canvia de carril."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Llavors és segur pel <color value=@@clr_sel@@>jugador<color value=@@clr_txt@@> moure's cap al carril designat."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Els dipòsits del camió s'han omplert i les hores de conducció s'han restablert."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "No pots trucar a l'assistència durant les missions de Transport Especial."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "No pots utilitzar el ferri durant una missió de Transport Especial."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Estàs descansant una mica...<br>S'estan omplint els dipòsits del camió..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Aproximació a la parada obligatòria.<br>Seguiu l'acompanyant fins a l'aparcament per descansar!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Parada obligatòria"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Prem aquesta tecla per descansar i posar carburant:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "S'ha produït un error al carregar contingut de l'Inventari de Steam.<br><br>$ERROR$<br><br>Selecciona continuar per mantenir el contingut habilitat. El joc els buscarà periòdicament.<br><br>Pots desactivar temporalment el contingut per evitar que missatges d'error com aquest reapareguin. El joc reactivarà el contingut automàticament la propera vegada que l'iniciïs." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "No es poden descarregar els articles de l'inventari de Steam." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "INVENTARI DE STEAM" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Carregant objectes de l'inventari de Steam..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOUS OBJECTES DE L'INVENTARI" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "S'han detectat nous objectes a l'inventari de Steam." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Accessori del vehicle" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Accessori de la cabina" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Fons d'escriptori" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Taller de pintura" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Desactivar inventari" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Intentar-ho més tard" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "INVENTARI DE STEAM" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Alguns articles s'han eliminat del teu inventari de Steam. Ja no podràs comprar-los a la botiga de millores.<br><br>Això no afecta els teus articles instal·lats actualment." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


