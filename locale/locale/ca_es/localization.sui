#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona quin fons d'escriptori es mostrarà quan naveguis pel menú."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Activa la selecció aleatòria del fons d'escriptori cada vegada que inicies el joc."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Estableix el retard en començar a desaparèixer dels elements de l'escriptori."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, experimentaràs els efectes de la fatiga en conduir molta estona.<br><br>Et podran sancionar per no descansar."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, hauràs de respectar les normes de circulació o arriscar-te a ser sancionat. Aquest risc s'incrementa en estar a prop de vehicles de policia, radars o càmeres de trànsit."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta la distància mitjana de les feines que se t'ofereixen."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona el límit de velocitat que es mostrarà al Giny de Ruta."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "L'indicador de la velocitat actual a la Navegació es torna vermell quan s'excedeix el límit de velocitat."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan arribes a la teva destinació, se't mostrarà un giny amb l'opció de saltar-te l'aparcament del camió."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantenir tots els ginys ocults."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantén ocults els dos miralls del HUD (Indicador en Pantalla)."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantén totes les notificacions ocultes fins i tot en rebre-les."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Mostra una pantalla amb les capacitats del camió del jugador abans d'acceptar una feina de carregament pesat."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Tria com s'alinea el mapa del món."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona com s'ha de mostrar la navegació."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia com s'encamina la navegació:<br>- El mode de navegació \"Millor\" escull la relació més eficient entre llargada i temps de la ruta, intentant evitar encreuaments amb semàfors, per exemple.<br>- El mode \"La més curta\" tria sempre la ruta més curta possible.<br>- El mode \"Carreteres petites\" evita les autopistes i autovies sempre que sigui possible."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Escull la dificultat per aparcar:<br>- \"Seleccionar sempre\" et permet escollir-ho sempre en arribar a la destinació.<br>- \"Aparcament segur\" no requereix maniobres fent marxa enrere.<br>- \"Aparcament expert\" requereix maniobres fent marxa enrere més desafiants."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta la probabilitat de trobar-te perills a la carretera, com ara accidents, vehicles avariats, deixalles, etc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta la probabilitat de trobar-te desviaments de ruta obligatoris mentre treballes."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta la probabilitat de trobar-te inclemències meteorològiques."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Escull si es mostra la informació de la zona horària a més de l'hora actual."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Activa les escenes que es mostren en comprar un camió o millorar un garatge."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Tria si es mostren les barreres semitranslúcides a les carreteres inaccessibles."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverteix l'eix Y del ratolí quan es controla la càmera del joc."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecciona el tipus de transmissió:<br>- \"Automàtica simple\" et permet usar l'accelerador i el fre per controlar la marxa endavant o enrere.<br>- \"Automàtica real\" necessita una pulsació per canviar entre marxa endavant o enrere.<br>- \"Seqüencial\" requereix canviar manualment per totes les velocitats i marxes.<br>- \"Caixa de canvis en H\" requereix un controlador de caixa de canvis en H per seleccionar la marxa manualment."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Activar aquesta funció et permetrà \"saltar-te marxes\"; ometre marxes quan sigui necessari o pràctic per evitar passar per totes les marxes de la transmissió."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Retorna automàticament el volant al centre quan utilitzes el teclat o un comandament.<br><br>Desactivant-ho hauràs de tornar a centrar manualment el volant després d'un gir."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta el rang de l'animació del volant."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la intensitat dels frens."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia l'estabilitat del camió abaixant el seu centre de gravetat."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia l'estabilitat del remolc abaixant el seu centre de gravetat."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la intensitat del parell generat des del sistema de transmissió.<br><br>Apujant aquest ajustament, s'incrementarà la sensació que el camió \"gira\" cap a la dreta."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la rigidesa de la suspensió del xassís."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la rigidesa de la suspensió de la cabina."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta la intensitat dels cops ocasionats pels clots de la carretera per donar-li una percepció de superfície imperfecta.<br><br>Depenent d'altres ajustos de la suspensió o de la càmera, aquesta percepció pot ser més o menys prominent."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Habilita l'acoblament avançat, que necessita més precisió per alinear la cinquena roda del camió amb el pern d'acoblament.<br><br>Quan està desactivat, la maniobra d'acoblament resulta més senzilla, ja que no hi ha col·lisió possible entre el pern d'acoblament i la cinquena roda."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona en quins remolcs vols que els cables estiguin animats.<br><br><color value=@@clr_txt_d@@>Activar aquesta animació en molts vehicles pot afectar el rendiment."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Activa el limitador de velocitat del camió a 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>A les feines de World of Trucks, el limitador està sempre activat."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat i el neteja parabrises està a la primera posició, aquest es posarà en funcionament o ajustarà la seva velocitat depenent de les condicions meteorològiques."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa el funcionament automàtic del retardador quan es frena."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Si està activat, el vehicle assisteix l'arrencada en una superfície inclinada utilitzant els frens, assegurant una arrencada suau."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa el funcionament automàtic del fre motor quan es frena."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan està activat, el motor del camió s'engega en prémer l'accelerador."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan està activat, el fre d'estacionament del camió s'activa després d'utilitzar un ferri, ser remolcat a un taller, fer un viatge ràpid, etc."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Aixeca automàticament els eixos quan sigui necessari segons el pes del vehicle."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Si està activat, el vehicle mantindrà una baixa acceleració per defecte. Després de prémer ràpidament dues vegades el botó d'acceleració, el vehicle mantindrà l'acceleració al màxim fins que s'alliberi el botó d'acceleració.<br><br>Només afecta l'entrada amb teclat."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simula la pèrdua real d'aire causada per l'excessiva utilització dels frens.<br><br>Si ho actives, hauràs de controlar les pressions d'aire en descensos pronunciats o en fer maniobres lentes amb múltiples aplicacions del fre."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan està desactivat, el consum de combustible no es veu afectat per l'estil de conducció o per l'estat de la carretera.<br><br>Quan està activat, el consum de combustible es veu afectat per factors com l'estil de conducció, el pes total del camió, la resistència al rodament o per l'estat de la carretera. No està afectat per les habilitats de la @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan està activat, l'ABS evitarà el bloqueig de les rodes per mantenir el control i millorar la capacitat de frenada."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan està activat, el camió aplicarà una frenada diferent a cada roda per evitar que patinin, el subviratge o el sobreviratge per ajudar a mantenir el control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan està activat, el camió bloquejarà el diferencial quan les rodes comencin a patinar per millorar la tracció."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la velocitat que incrementarà o disminuirà el control de creuer en prémer el botó apropiat."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la tolerància del control de creuer per mantenir la velocitat seleccionada."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Quan estigui activat, el control de creuer ajustarà automàticament la velocitat per mantenir la distància de seguretat amb el vehicle del davant."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa el fre d'emergència si el sistema detecta una col·lisió imminent.<br>Escull si el sistema reaccionarà només amb vehicles o amb tots els obstacles."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecció del mode d'assistència al carril:<br>- El mode \"Avís de sortida de carril\" avisa amb un senyal acústic quan estàs a punt de sortir del teu carril.<br>- A més del senyal acústic, el mode \"Suport de permanència de carril\" corregeix la direcció automàticament per mantenir el camió en el carril.<br><br>Els dos modes només estan actius a velocitats superiors a 55 km/h (~35 mph).<br>L'assistent al carril té en compte l'ús dels intermitents abans d'actuar."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa les funcions del sensor d'angles morts, sempre que el teu camió el tingui equipat."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat i el selector dels llums davanters està a la primera posició, els llums davanters s'encendran automàticament en situacions de poca llum."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, amb els llums davanters i les llums llargues encesos, el camió atenuarà automàticament les llums llargues quan detecti un vehicle al carril contrari o al davant."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, l'intermitent es pararà automàticament després d'un gir i en tornar a centrar el volant."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, alguns accessoris de l'interior del camió reaccionen al moviment (decoracions penjant, figuretes, etc)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Activa la inclinació de la càmera interior en girar el volant."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta el comportament de l'opció \"Moure la càmera al girar\" en moure el volant."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta el comportament de l'opció \"Moure la càmera al girar\" en moure el volant fent marxa enrere."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Si està activat, la càmera interior mira a dreta o esquerra segons l'ús de l'intermitent."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Si està activat, la càmera interior reacciona al moviment del vehicle."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia la sensibilitat de la càmera interior al moviment del vehicle."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Canvia fins a on es pot inclinar la càmera interior segons el moviment del vehicle."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Estableix el retard abans que la càmera torni al centre automàticament.<br><br>El vehicle ha d'estar movent-se a una certa velocitat perquè tingui efecte. S'aplica només a la càmera interior i a la càmera de persecució mentre vas endavant i a la càmera de treure el cap mentre recules."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Estableix la velocitat del moviment de la càmera. Utilitzat pel centrat automàtic de la càmera i per canviar entre les diferents vistes predefinides de la càmera interior."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determina el funcionament del zoom de la càmera interior. Prem i aguanta el botó per fer zoom temporalment o prem i deixa'l anar per alternar-lo." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Tria l'idioma del joc."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Canvia els ajustos de moneda i unitats basant-se en la regió seleccionada."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Si està activat, les ciutats i els països es mostraran en l'idioma seleccionat."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Si està activat, les ciutats i els països es mostraran en l'idioma seleccionat, però també en l'idioma nadiu de la regió del mapa."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Tria quina moneda vols utilitzar."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Selecciona entre la notació horària de 12 hores i la de 24 hores."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Tria les unitats de distància que vols utilitzar."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Tria les unitats de pes que vols utilitzar."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Tria les unitats de temperatura que vols utilitzar."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Tria les unitats de pressió que vols utilitzar."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Tria les unitats de volum que vols utilitzar."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Tria les unitats de consum que vols utilitzar."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Si està habilitat, quan premis la tecla \"Activar\" (@@imv_nrm_activate@@) s'obrirà el xat de la sessió de comboi."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, la barra de xat restarà activa després d'enviar un missatge."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, els missatges del xat desapareixeran al cap de pocs segons."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Canvia quant de temps es mostraran els missatges del xat abans de desaparèixer."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Quan està activat, es mostraran els noms dels jugadors a sobre dels seus vehicles a les sessions de comboi."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Obre el menú avançat per configurar les respostes ràpides del xat a les sessions de comboi."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Comprova l'estat del teu contingut connectat a World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Permet la baixada de notícies en línia, que es mostraran al llançador."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Permet la baixada de captures de pantalla seleccionades de la comunitat de World of Trucks, que es mostraran a les pantalles de càrrega."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Permet la baixada d'anuncis reals, que es mostraran als panells publicitaris del joc."
#@}

