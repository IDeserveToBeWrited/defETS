#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANC" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banc" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Si necessites diners, sempre pots demanar un préstec al banc." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "OFERTES DE PRÉSTECS" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "per $MONEY$ al dia" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Nombre de préstecs actius: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Pots demanar prestats: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "VISTA DE PRÉSTECS ACTIUS"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Préstec" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Encara per pagar" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Durada (en dies)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Taxa d'interès (anual)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Quota" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Tornar" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Total:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Saldo de compte: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NOU PRÉSTEC" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Estàs demanant un préstec de $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Termini de devolució:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Taxa d'interès (anual):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Quota diària:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Vols confirmar la teva sol·licitud?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "TORNAR PRÉSTEC" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Segur que vols gastar $MONEY$ per saldar el deute?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


