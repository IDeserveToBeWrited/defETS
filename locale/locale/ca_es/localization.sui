#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRÀFICS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Gràfics" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Tria els paràmetres gràfics utilitzant preconfiguracions per adaptar el rendiment visual del joc al teu gust."

	key[]: "apply"
	val[]: "Aplicar" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Fons d'escriptori" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "PANTALLA" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "QUALITAT D'IMATGE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURES" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEXOS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "OMBRES" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "IL·LUMINACIÓ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POSTPROCESSAT" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ENTORN" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Mode de pantalla completa" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Brillantor / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Configurar" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Resolució" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Freqüència de refresc" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Límit de FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Límit de FPS en segon pla" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Refresc per defecte" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Sincronització vertical" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Econòmic (estalvia energia en portàtils)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "AJUSTOS GRÀFICS SENZILLS" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "CONFIGURACIÓ PERSONALITZADA APLICADA" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "AJUSTOS GRÀFICS AVANÇATS" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Configuració gràfica simple / avançada" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Amagar la configuració avançada" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Mostrar la configuració avançada" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Escalat" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Antialiàsing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Nitidesa de luma TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Ajust TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Claredat adaptativa" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Sempre suau" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Sempre nítid" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Oclusió ambiental de l'espai de pantalla (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Rang dinàmic alt (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Profunditat de camp (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Rajos de sol" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Correcció de color" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Qualitat dels reflexos" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detall de la reflexió" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detall de la vegetació" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densitat de l'herba" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Qualitat de les ombres"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Mida de les textures de les ombres" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Ombres llunyanes" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Ombres interiors" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Qualitat del temps"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Qualitat dels miralls" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Resolució del mirall" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Distància dels retrovisors" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Qualitat de la textura" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtrat anisòtrop" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Mapa normal" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Llums del trànsit" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Llums secundaris del vehicle" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Abast de la visibilitat dels llums" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Vianants" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "La configuració de la pantalla ha estat canviada.<br>Vols mantenir aquests ajustos?"

	key[]: "reverting_in"
	val[]: "Restaurant en" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "segons" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Si està activat, el joc es mostrarà a pantalla completa."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Ajusta la brillantor general del joc per a adaptar-la a la teva pantalla. En pantalles compatibles, la calibració de HDR estarà disponible en aquest ajust."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Canvia la resolució del joc."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Canvia la freqüència de refresc desitjada pel joc."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Iguala la velocitat dels fotogrames amb la velocitat de refresc del monitor per prevenir l'esquinçament de pantalla (o screen tearing). L'ajust econòmic també redueix a la meitat la velocitat dels fotogrames, resultant en un menor consum d'energia."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Estableix la taxa de fotogrames màxima permesa pel joc.<br><br>Per deshabilitar aquesta característica, posa-la a 0."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Estableix la taxa de fotogrames màxima permesa pel joc quan està minimitzat.<br><br>Per deshabilitar aquesta característica, posa-la a 0."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Canvia entre uns ajustos gràfics simples (amb preconfiguracions) i uns ajustos gràfics avançats (amb la possibilitat de modificar els paràmetres individualment)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Millora la fidelitat gràfica renderitzant el joc internament a una resolució més alta, reduint les vores dentades i millorant els detalls.<br>Triar un escalat major produirà unes imatges més netes i menys borroses, fent que el joc es vegi més bé en general però a costa del rendiment.<br><br><color value=@@clr_txt_d@@>Tot sovint, aquest ajust té un gran impacte en el rendiment."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Selecció dels mètodes d'antialiàsing (o suavitzat) d'alta velocitat per a suavitzar l'aparença de les vores dentades en el joc:<br>- SMAA pren una mostra de cada píxel múltiples vegades (en funció de la qualitat seleccionada) a diferents localitzacions del fotograma i estableix una mitjana de les mostres per produir la imatge final.<br>- TAA pren una mostra de cada píxel només una vegada per fotograma, però ho fa a diferents localitzacions i a diferents fotogrames.<br>- Per obtenir els millors resultats es pot seleccionar una combinació dels dos mètodes, a costa del rendiment.<br><br><color value=@@clr_txt_d@@>Usualment, aquest ajust té un impacte moderat en el rendiment."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Afegeix ombres suaus a escletxes i objectes que es troben molt a prop els uns dels altres, millorant la fidelitat gràfica de tot el món del joc.<br><br><color value=@@clr_txt_d@@>Usualment, aquest ajust té un impacte moderat en el rendiment."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Tria la preconfiguració de TAA:<br>- \"Sempre suau\" resultarà en una imatge amb menys parpelleig/més difuminada; apropiada per usuaris de PC que activin el supermostratge o tinguin un monitor amb un PPP (DPI) alt, però també per usuaris de TV a 1080p que seuen lluny de la pantalla.<br>- Amb \"Sempre nítid\" obtindràs una imatge amb més parpelleig/menys difuminada; probablement la millor opció per un ús per sota de 1080p, com ara en portàtils o en Steam Deck.<br>- Quan es selecciona \"Claredat adaptativa\", el TAA es desactiva dinàmicament quan la càmera està estàtica.<br><br><color value=@@clr_txt_d@@>Aquest ajust només està disponible quan es selecciona TAA com a mètode d'antialiàsing (o suavitzat)."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la nitidesa de la luma del TAA.<br><br><color value=@@clr_txt_d@@>Aquest ajust només està disponible quan es selecciona TAA com a mètode d'antialiàsing (o suavitzat)."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Quan s'activa, les àrees llunyanes es difuminen artificialment per crear un efecte versemblant de pèrdua d'enfocament del fons."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Quan s'activa, es fan visibles els rajos del sol en mirar-lo directament o a través d'objectes com arbres, edificis o vehicles."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Quan s'activa, els colors del joc s'ajusten dinàmicament per raons d'estètica. Les escenes encaixaran més bé amb l'hora del dia i la meteorologia, els colors dels vehicles i d'altres objectes podran ser més vius, etc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Millora els reflexos renderitzant-los internament amb més qualitat, així com millora l'antialiàsing.<br><br><color value=@@clr_txt_d@@>Els canvis d'aquest ajust només tindran efecte després de reiniciar manualment el joc."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta el detall dels reflexos en vehicles, finestres i en altres superfícies reflectants com poden ser bassals, carreteres molles o masses d'aigua.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment.<br><br>Els canvis d'aquest ajust només tindran efecte després de reiniciar manualment el joc."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta el detall i la complexitat de plantes i arbres.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta el detall de l'herba de les vores de la carretera.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la qualitat de les ombres produïdes pel sol o per la lluna.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Activa el renderitzat de les ombres pels objectes llunyans.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Habilita les ombres dinàmiques nocturnes a l'interior del camió.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la qualitat dels efectes meteorològics, com els reflexos."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la qualitat de les imatges reflectides en els miralls del vehicle (és independent de la configuració dels reflexos).<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la resolució de les imatges renderitzades en els miralls del teu vehicle."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a quina distància començaran a aparèixer els objectes en els miralls.<br><br><color value=@@clr_txt_d@@>Tot sovint, aquest ajust té un gran impacte en el rendiment."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta la qualitat d'algunes textures aplicades als objectes i superfícies del joc."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Millora la nitidesa de les textures, especialment les que es veuen a certa distància o en un angle oblic.<br><br><color value=@@clr_txt_d@@>Els canvis d'aquest ajust només tindran efecte després de reiniciar manualment el joc."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Afegeix un matís geomètric a paviments, carreteres i a altres objectes per millorar-ne l'aparença.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment.<br><br>Els canvis d'aquest ajust només tindran efecte després de reiniciar manualment el joc."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Activa la il·luminació dels llums dels altres vehicles del trànsit."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Activa la il·luminació dels llums secundaris dels altres vehicles del trànsit com ara intermitents, frens, etc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Ajusta a quina distància es començaran a veure les fonts lluminoses artificials.<br><br><color value=@@clr_txt_d@@>Usualment, aquest paràmetre té un impacte moderat en el rendiment."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Habilita els vianants en el món del joc."
#@}

