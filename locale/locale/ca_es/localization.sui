#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Capa de xarxa no disponible. Si us plau, comprova que la connexió de client sigui correcta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "No ha estat possible establir connexió amb el servei online. Si us plau, comprova que la teva connexió d'Internet funciona."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Error durant la comunicació amb el servei online. Si us plau, torna-ho a intentar més tard."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "S'ha rebut informació incorrecta del servei en línia. Si estàs fent servir un servidor intermediari (proxy) HTTP, revisa'n la configuració. D'altra manera torna-ho a intentar més tard."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "S'ha rebut informació incorrecta del servei en línia. Si us plau, torna-ho a intentar més tard."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "El servei no és compatible amb la versió actual del joc. Si us plau, comprova si hi ha alguna actualització disponible per al joc."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "El servei no està disponible actualment. Si us plau intenta-ho de nou més tard."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "El servei està desactivat per manteniment o sobrecarregat. Si us plau, intenta-ho més tard."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "La informació d'autenticació no és vàlida. Si us plau, torna a iniciar sessió."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "El compte online està actualment bloquejat per haver assolit el número màxim d'intents d'inici de sessió. Si us plau, torna-ho a provar d'aquí mitja hora."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "El compte online està actualment bloquejat degut a intents d'accés sospitosos. Si us plau, torna-ho a provar d'aquí 24 hores."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "El joc no està registrat a aquest compte online."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "El compte encara no s'ha activat. Mira la teva safata d'entrada per si hi ha el correu d'activació del compte."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "El compte està suspès. Si us plau, contacta amb el servei tècnic."

# The account was banned.
	key[]: "generic_banned"
	val[]: "El compte està bandejat. Si us plau, contacta amb el servei tècnic."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Aquest joc no admet l'autentificació mitjançant proxy. Si us plau, utilitza un proxy diferent o una connexió directa."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "L'objecte requerit no està disponible. Si us plau torna-ho a intentar d'aquí uns minuts."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Error SSL. No s'ha pogut establir una connexió segura."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "El joc no ha funcionat correctament mentre es produïa una comunicació en línia. Si us plau, torna-ho a provar més tard."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Error intern. És probable que el fitxer net.log contingui més informació."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 està tenint un problema i no pot dibuixar gràfics al teu ordinador (no s'ha trobat un dispositiu gràfic vàlid).\nPassos recomanats:\n\n1. Comprova que el teu ordinador i la teva targeta de vídeo compleixen els requisits mínims de hardware.\n2. Actualitza el teu ordinador amb la versió més recent de DirectX de Microsoft.\n3. Descarrega i instal·la els drivers gràfics més recents per a la teva targeta de vídeo des del web del teu proveïdor. Els drivers dels teus dispositius gràfics podrien estar desfasats.\n4. Intenta canviar el mètode de renderització d'OpenGL a DirectX, o viceversa.\n5. Elimina l'arxiu de configuració del joc 'config.cfg' a la carpeta de \"Documents / Euro Truck Simulator 2\". Pot ser que s'hagi corromput. Aquest arxiu serà automàticament re-creat amb els valors per defecte quan tornis a obrir el joc."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 està tenint un problema i no pot dibuixar gràfics al teu ordinador (no s'ha trobat cap dispositiu gràfic vàlid)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "ASSISTENT DE CONTROLS" #+ Title of the screen. Please keep in upper case where possible.

