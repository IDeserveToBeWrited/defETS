
    key[]: "hint_engine_title"
	val[]: "Engega el motor"

    key[]: "hint_engine_text"
	val[]: "Usa $KEY_engine$ per engegar el motor."


    key[]: "hint_ignition_title"
	val[]: "Activa el contacte"

    key[]: "hint_ignition_text"
	val[]: "Usa $KEY_engineelect|KEY_engine$ per activar el contacte."


    key[]: "hint_driv_arc_title"
	val[]: "Conducció"

    key[]: "hint_driv_arc_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per moure't endavant o endarrere.<br><offset vshift=8>Usa $SPECIAL_steering$ per girar."


    key[]: "hint_driv_auto_title"
	val[]: "Conducció"

    key[]: "hint_driv_auto_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per moure't endavant o endarrere.<br><offset vshift=8>Usa $SPECIAL_steering$ per girar.<br><offset vshift=8>Prem $KEY_gearup$ i $KEY_geardown$ per triar les marxes."


    key[]: "hint_driv_seq_title"
	val[]: "Conducció"

    key[]: "hint_driv_seq_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per moure't endavant o endarrere.<br><offset vshift=8>Usa $SPECIAL_steering$ per girar.<br><offset vshift=8>Prem $KEY_gearup$ i $KEY_geardown$ per controlar l'embragatge."


    key[]: "hint_driv_hshift_title"
	val[]: "Conducció"

    key[]: "hint_driv_hshift_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ i $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ per moure't endavant o endarrere.<br><offset vshift=8>Usa $SPECIAL_steering$ per girar.<br><offset vshift=8>Canvia les marxes amb <color value=@@clr_sel@@>la palanca de canvis<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Aproximació a la destinació"

    key[]: "hint_depot_deliv_text"
    val[]: "Para't a l'àrea indicada per seleccionar la dificultat d'aparcament a l'empresa i guanyar els punts d'experiència que pertoquin."


    key[]: "hint_fin_deliv_title"
    val[]: "Acaba l'entrega"

    key[]: "hint_fin_deliv_text"
    val[]: "Aparca al lloc escollit. Pots ometre l'aparcament prement $KEY_activate$ quan estiguis a prop del punt d'entrega."


    key[]: "hint_fin_deliv2_title"
    val[]: "Acaba l'entrega"

    key[]: "hint_fin_deliv2_text"
    val[]: "Aparca al lloc indicat. Pots habilitar un giny a les @@desktop_menu_category_options@@ que et permetrà ometre l'aparcament."


    key[]: "hint_lights_title"
    val[]: "Encén els llums"

    key[]: "hint_lights_text"
    val[]: "Usa $KEY_light$ per encendre els llums. Pressiona repetidament aquest botó per alternar els diferents modes de llums."


    key[]: "hint_high_beam_title"
    val[]: "Encén les llums llargues"

    key[]: "hint_high_beam_text"
    val[]: "Usa $KEY_hblight$ per encendre les llums llargues."


    key[]: "hint_wipers_title"
    val[]: "Activa l'eixugaparabrises"

    key[]: "hint_wipers_text"
    val[]: "Usa $KEY_wipers$ per activar l'eixugaparabrises i per alternar la seva velocitat."


    key[]: "hint_zoom_title"
    val[]: "Mira de prop"

    key[]: "hint_zoom_text"
    val[]: "Usa $KEY_camzoom$ per fer zoom mentre estàs a l'interior. Pots definir el mode zoom a \"Mantén\" o a \"Commuta\" a les @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Mira al voltant"

    key[]: "hint_cam_int_text"
    val[]: "Usa $KEY_cam1$ per canviar la càmera a la vista interior."


    key[]: "hint_cam_ext_title"
    val[]: "Mira al voltant"

    key[]: "hint_cam_ext_text"
    val[]: "Pots alternar entre diferents càmeres prement $KEY_camcycle$.<br><offset vshift=8>Usa $KEY_cam2$ per canviar la càmera a la vista exterior."


    key[]: "hint_indicators_title"
    val[]: "Llums intermitents"

    key[]: "hint_indicators_text"
    val[]: "Usa $KEY_lblinker$ i $KEY_rblinker$ per activar els intermitents."


    key[]: "hint_tow_title"
    val[]: "Servei d'assistència"

    key[]: "hint_tow_text"
    val[]: "Si no pots sortir d'una situació complicada, pots utilitzar el servei d'assistència. Per accedir-hi, obre el menú de la @@quick_info_word@@ usant $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Bloqueig del diferencial"

    key[]: "hint_diff_lock_text"
    val[]: "Si no pots començar a moure't, et podria ajudar el bloqueig del diferencial. Usa $KEY_diflock$ per activar-lo. Estableix-lo en automàtic a @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Bloqueig del diferencial activat"

    key[]: "hint_diff_unlock_text"
    val[]: "Hauries de desbloquejar el diferencial durant la conducció normalitzada o t'arrisques a danyar-lo. Usa $KEY_diflock$ per desbloquejar-lo o pots activar el bloqueig del diferencial automàtic a @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Desactiva l'eixugaparabrises"

    key[]: "hint_wipers_off_text"
    val[]: "Usa $KEY_wipers$ per desactivar l'eixugaparabrises i per alternar la seva velocitat."


    key[]: "hint_world_map_title"
    val[]: "Consulta el mapa"

    key[]: "hint_world_map_text"
    val[]: "Usa $KEY_navmap$ per obrir el mapa."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Usa $KEY_advmouse$ per obrir la @@quick_info_word@@. Hi trobaràs una descripció general del teu estat amb enllaços d'utilitat."


    key[]: "hint_pause_border_title"
    val[]: "Normatives locals"

    key[]: "hint_pause_border_text"
    val[]: "Usa $KEY_advmouse$ per obrir la @@quick_info_word@@ i veure les normatives de la regió a on acabes d'entrar."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Obre la @@quick_info_word@@ usant $KEY_advmouse$ per entrar al @@photo_mode_word@@ i capturar el @@landmark_word@@ proper <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ proper"

    key[]: "hint_viewpoint_text"
    val[]: "Hi ha un @@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> a prop. Busca'l i activa'l per veure la cinemàtica."


    key[]: "hint_resting_title"
    val[]: "Àrea de descans propera"

    key[]: "hint_resting_text"
    val[]: "Les àrees de descans <img src=/material/ui/map/parking_ico.mat width=20 height=20> et permeten reposar, complir amb els descansos obligatoris i continuar el teu viatge amb seguretat."


    key[]: "hint_gas_title"
    val[]: "Estació de servei propera"

    key[]: "hint_gas_text"
    val[]: "A les estacions de servei <img src=/material/ui/map/gas_ico.mat width=20 height=20> podràs proveir-te de carburant."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "You can enable smart throttle control in @@desktop_menu_category_options@@. By enabling it, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the button is released."
