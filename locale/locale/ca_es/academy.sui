	val[]: "Retrocedeix i aparca a l'àrea indicada."

	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Punt de pas assolit"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Continuar amb l'escenari."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Aparcament"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Per acabar l'escenari, assegura el camió i para el motor.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Estàs en el lloc idoni, però amb el camió en sentit contrari.<br><br><font face=/font/big_bold.font>Fes mitja volta per completar l'escenari.</font>"
#@}

#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Benvingut/da a la @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Aquests escenaris representen les primeres passes en el teu camí cap a la conducció professional de camions."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Aquí, aprendràs des dels sistemes bàsics i els controls del camió..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "... fins a les maniobres complexes, amb remolc i sense."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "T'ajudarem a adquirir uns hàbits que faran la teva conducció més segura en moltes situacions,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "i t'ensenyarem a fer un ús intel·ligent de l'espai disponible per maniobrar eficaçment el teu camió."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Completant tots els escenaris i aprovant els exàmens finals,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "ja estaràs a punt per trepitjar les carreteres d'Europa i enfrontar-te a nous reptes."

#@}

