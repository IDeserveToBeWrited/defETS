	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "En aquest escenari, veurem com fer mitja volta en una zona ajustada maniobrant enrere cap al costat del passatger. Aquesta habilitat et serà útil quan no puguis fer un gir en U o retrocedir cap al costat del conductor."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Les marques de la carretera et guiaran per la pista de proves."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Fes una girada oberta per evitar que el remolc xoqui amb els camions estacionats."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "En superar el revolt, situa el camió en previsió de la maniobra marxa enrere."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Això t'ajudarà a tenir el camió més o menys orientat cap a la plaça d'aparcament lliure que hi ha al costat del passatger i a on hauràs d'entrar fent marxa enrere."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "S'ha d'evitar tant com sigui possible retrocedir cap al costat del passatger, per la poca visibilitat durant la maniobra. Desafortunadament, hi ha ocasions on no tindràs opció."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Gira el volant abans de retrocedir. Això farà que el remolc comenci a girar immediatament, cosa molt útil en llocs amb poc espai."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Un cop el remolc estigui ben situat a l'aparcament, adreça la tractora i alinea remolc i tractora."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Para't quan estiguis alineat i tinguis prou espai per tornar a anar endavant. Torna pel mateix camí per on has vingut."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Segueix les marques de la carretera per sortir de la pista de proves."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Circula pel gir que tens davant per arribar a l'àrea marcada."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Para."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Assegura el camió i para el motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "A l'àrea situada davant teu, hi ha una pista d'entrenament que representa l'aparcament d'una empresa. La teva tasca és anar-hi, fer mitja volta i sortir-ne. Assegura't de fer un bon ús de l'espai disponible.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Procedeix cap a la zona de la prova. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Fes la corba i continua la prova. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Segueix les fletxes pintades a terra cap a la barrera del final del camí. Para't amb una mica d'inclinació per deixar el remolc encarat cap a la plaça d'aparcament lliure que hi ha al costat del passatger.<br><br><font face=/font/big_bold.font>Continua endavant. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Tens una visibilitat molt més limitada del que hi ha al teu voltant quan gires cap al costat del passatger. Vés a poc a poc, fes servir els miralls i vigila especialment el costat problemàtic.<br><br><font face=/font/big_bold.font>Retrocedeix i guia el remolc a l'aparcament. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "És més que suficient. Ara ja pots anar cap endavant i sortir de la zona d'entrenament pel mateix camí que has fet per entrar-hi.<br><br><font face=/font/big_bold.font>Comença a anar cap a la sortida. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Surt de l'àrea d'entrenament. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Segueix les fletxes pintades a terra cap a l'aparcament.<br><br><font face=/font/big_bold.font>Procedeix cap a l'àrea indicada. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
