#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Controls bàsics i moviment"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Aprèn els controls bàsics del vehicle i com moure el camió cap endavant i cap enrere."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 1: @@aca_chapter_book1_1_title@@.<br><br>Has après com preparar el camió abans de la conducció,<br>conduir cap endavant i cap enrere i com utilitzar els llums i l'eixugaparabrises.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Maniobres bàsiques"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Aprèn a conduir, maniobrar i aparcar amb el camió. Descobreix el propòsit de cada tipus de miralls i com utilitzar-los."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 2: @@aca_chapter_book1_2_title@@.<br><br>Has après com utilitzar cada mirall del camió, a comprovar l'espai que l'envolta abans de moure't i a fer maniobres bàsiques i avançades.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Maniobrar amb un remolc"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Aprèn a acoblar i maniobrar amb un remolc en situacions diferents."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 3: @@aca_chapter_book1_3_title@@.<br><br>Has après a acoblar i desacoblar un remolc,<br>has experimentat el pes i les dimensions del camió amb un remolc<br>i has conduït per trams estimulants amb un remolc.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Fer marxa enrere amb un remolc"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Aprèn noves maniobres per anar cap enrere i aparcar amb un remolc de manera eficaç."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 4: @@aca_chapter_book1_4_title@@.<br><br>Has après a fer marxa enrere amb un remolc<br>i diverses tècniques d'aparcament.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Examen final"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Demostra els teus coneixements i habilitats per provar la teva vàlua com a camioner!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 5: @@aca_chapter_book1_5_title@@.<br><br>Has demostrat que tens tot el que cal<br>per conduir, maniobrar i aparcar un camió!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Escalfant el motor"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Has completat l'entrenament: @@aca_chapter_book2_0_title@@.<br><br>Has après les normes i les particularitats del \"Domini de la conducció del camió\".</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Tornem a estar en marxa"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 2: @@aca_chapter_book2_1_title@@.<br><br>Has escalfat el motor, has provat les marxes, has fet girar les rodes i has comprovat l'eficiència dels frens. Els capítols següents seran més complicats.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Rodes en moviment"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 3: @@aca_chapter_book2_2_title@@.<br><br>Has dominat escenaris difícils i variats. Has demostrat tenir habilitats i rendiment.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "La recta final"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 4: @@aca_chapter_book2_3_title@@.<br><br>Has tractat unes quantes situacions complicades, maniobrant, aparcant i retrocedint amb un remolc. Has demostrat que ets un hàbil conductor, capaç d'afrontar tots els reptes i situacions de la conducció d'un camió."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Sempre endavant"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Aprèn totes les tècniques essencials per manejar els remolcs dobles en conduir cap endavant."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 1: @@aca_chapter_book3_1_title@@.<br><br>Has experimentat com conduir i maniobrar amb remolcs dobles de manera efectiva.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Retrocés controlat"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Coneix els passos necessaris per maniobrar cap enrere amb remolcs dobles."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 2: @@aca_chapter_book3_2_title@@.<br><br>Has après la formidable habilitat de fer marxa enrere portant remolcs dobles.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Preparació pel món real"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Aplica els teus nous coneixements en escenaris més avançats."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br>Has completat el capítol 3: @@aca_chapter_book3_3_title@@.<br><br>Has superat unes quantes situacions complicades en maniobrar, aparcar i retrocedir portant remolcs dobles. Aquí t'has posat a prova, però ara és hora d'estirar els remolcs dobles per les carreteres de l'Euro Truck Simulator 2!</font><br><br>"


#@}

