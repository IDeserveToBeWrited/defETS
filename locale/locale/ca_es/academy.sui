	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Aparca"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

