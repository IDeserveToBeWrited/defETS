#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Conduir per revolts complicats"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "En aquest escenari, maniobrarem el camió a través d'una pista d'obstacles curta, però amb girs complicats."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primeres corbes"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Conduir pel pas estret"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Revolt estret de 90 graus"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Conduir a prop de les barreres"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Aquí davant hi ha una varietat de girs i obstacles complexos.<br>Posa en pràctica tot el que has après fins ara i no t'hauria de resultar massa difícil."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Les marques a la carretera et poden donar una idea de per on passar en cada tipus d'obstacle."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Mantén la tractora per l'exterior de la corba. <br>Necessitaràs fer un gir ampli, ja que el remolc et segueix per un camí més curt."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "El proper gir és un revolt fàcil de 90 graus. <br>Un cop més, mantén el camió a l'exterior del revolt i utilitza tot l'espai disponible."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Pren-te el teu temps aquí. La pista s'eixampla, però encara necessites ser precís."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Mantén un marge espaiós en passar a prop de les barreres."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Vés amb compte en entrar en aquest sector estret. <br>Passa-hi amb la tractora deixant espai suficient per preparar l'entrada del remolc."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "El gir final de 90 graus és més difícil que el primer, però aquí hi ha lloc de sobres si saps aprofitar-lo."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Aparca a l'àrea indicada, llavors assegura el camió i apaga el motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Recorda de guiar-te amb les marques de la carretera per superar la prova.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Usar els miralls t'ajudarà a fer el recorregut amb seguretat. Sempre has d'estar pendent de la trajectòria del remolc que portes darrere.<br><br><font face=/font/big_bold.font>Passa per la primera corba. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Vigila que el remolc completi el revolt i prepara't per entrar al proper gir.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Segueix pel següent revolt. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Recorda't de vigilar el remolc per comprovar que no hi ha obstacles al teu voltant abans de girar amb el camió.<br><br><font face=/font/big_bold.font>Procedeix evitant els obstacles que tens davant. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Quan el teu remolc hagi superat les barreres, gira cap al costat del passatger per alinear-te amb l'entrada al sector estret. <br><br><font face=/font/big_bold.font>Continua cap al sector estret.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Aquesta secció requereix una conducció molt precisa. Pren-t'ho amb calma i fes servir els miralls.<br><br><font face=/font/big_bold.font>Passa per l'exterior de cada corba. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Aquest gir és bastant tancat, però pots aprofitar tot l'espai que tens davant i superar-lo fàcilment.<br><br><font face=/font/big_bold.font>Completa l'últim revolt. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Prova d'entrenament avançat - Remolc"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "A l'escenari final del capítol 3, conduirem per una pista d'entrenament més llarga amb diversos girs i comprovarem què has après de maniobrar amb un remolc."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Gir doble"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "ESBORRAR AQUESTA FITA"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Travessar la mitjana"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Primer eslàlom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Segon eslàlom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Revolts senzills"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rotonda"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Sector recte"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Revolt estret"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Últimes corbes"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Conduir cap a l'aparcament"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "En aquest escenari, t'enfrontaràs a diferents tipus de revolts i t'ajudarà a acumular experiència en conduir amb remolc. Estigues concentrat, adapta la teva velocitat a cada situació i utilitza tot l'espai disponible de la pista d'entrenament."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "El primer gir és en realitat dos revolts en un. Hauràs de preparar-te per un gir a l'esquerra, però a mitja maniobra hauràs de reposicionar-te pel gir a la dreta."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Aquest gir et permet travessar cap a l'altre costat de la mitjana. No és particularment difícil, però has de recordar de deixar prou espai pel teu remolc."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "En el següent obstacle hauràs de passar per un eslàlom bastant tancat. Vés a poc a poc i usa els miralls, assegura't de fer un gir suficientment ampli perquè el remolc eviti les barreres de formigó."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "En aquest punt, entraràs en un altre eslàlom amb cons extra al vèrtex de cada gir. <br>Vigila de no tocar cap con!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Ara trobaràs uns quants girs fàcils de camí cap a la rotonda."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Aprofita aquest tram recte i situa't per entrar a la rotonda. Queda't a l'exterior abans d'entrar-hi."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Entra a la rotonda i vigila la posició del remolc. El seu recorregut un cop dins la rotonda serà diferent del de la tractora."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Surt de la rotonda i segueix cap al proper tram."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "ESBORRAR AQUEST VÍDEO"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Aquest revolt és extremadament tancat. Agafa'l a poc a poc i usa l'espai disponible de manera eficient. Estigues alerta a la part posterior del remolc."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Mentre passes per les properes corbes, recorda de situar-te pel proper gir tan bon punt surtis de l'anterior."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "No et precipitis al revolt final. Sembla fàcil, però hi ha menys espai per maniobrar del que sembla."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Aparca a l'àrea indicada, assegura el camió i apaga el motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Accelera per arribar al primer revolt. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "El primer revolt és un gir fàcil doble.<br><br><font face=/font/big_bold.font>Passa pel revolt. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "ESBORRAR AQUEST CONTROL"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Més endavant la pista segueix per la banda esquerra de la mitjana.<br><br><font face=/font/big_bold.font>Segueix la prova travessant el pas. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Maniobra per esquivar les barreres i recorda de vigilar el remolc.<br><br><font face=/font/big_bold.font>Condueix per l'eslàlom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Aquest eslàlom és més senzill, però els cons el fan significativament més ajustat.<br><br><font face=/font/big_bold.font>Passa per l'eslàlom i evita tocar els cons. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Al davant hi ha uns quants revolts simples, tot i això hauràs d'anar amb cura i mantenir el remolc lluny de les barreres.<br><br><font face=/font/big_bold.font>Completa els revolts. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "T'estàs aproximant a una rotonda. Recorda de deixar prou espai pel teu remolc a l'entrada, a la sortida i mentre estiguis a la rotonda.<br><br><font face=/font/big_bold.font>Condueix per la rotonda. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Ara ve un petit sector recte. Si ho desitges pots augmentar una mica la velocitat.<br><br><font face=/font/big_bold.font>Segueix endavant. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Aquest gir és extremadament tancat. Vés lentament, aprofita tot l'espai disponible i estigues al cas de la cua del remolc. <br><br><font face=/font/big_bold.font>Continua pel revolt tancat. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Els últims revolts són simples. Recorda que segueixes estirant un remolc.<br><br><font face=/font/big_bold.font>Continua endavant. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Vés endavant fins a la zona d'aparcament. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

