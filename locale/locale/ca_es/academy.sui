#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Per l'escenari final d'aquest capítol, conduirem per una pista de proves variada."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "El primer obstacle és un eslàlom amb barreres. Condueix per aquest eslàlom i recorda d'usar els miralls."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "El següent obstacle, una paella. Fes un gir per l'exterior i no et donarà maldecaps."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Aquí hi ha un gir a esquerres de 90 graus. Recorda de fer una traçada oberta per aconseguir que la part posterior del camió superi les barreres."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "La rampa pot ser un obstacle complicat. Alinea't el millor que puguis abans d'entrar-hi i utilitza els miralls frontal i laterals per ajudar-te a orientar-te."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "En aquesta secció hauràs de fer marxa enrere. Tingue-ho en compte en aproximar-te a les barreres del davant."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Segueix les marques cap enrere i a la teva dreta."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Vés enrere fins a les barreres, llavors para't i procedeix endavant, per l'esquerra."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Segueix pel pas que hi ha a la mitjana cap a la propera secció."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Aquest tram a través dels cons és molt estret. Condueix a poc a poc i fes servir els miralls per orientar-te mentre hi passes."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Recorda passar per l'exterior en els revolts de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Estàs entrant en un sector ample de la carretera. Pots guanyar velocitat, però tingues present que hauràs de reduir-la aviat per passar pel proper revolt."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Al final de la baixada hi ha unes barreres al mig de la carretera. Un cop hi hagis arribat, fes marxa enrere cap a l'aparcament de l'esquerra."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Fes marxa enrere cap a l'aparcament."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Aparca, apaga el motor i assegura el camió."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Davant teu hi ha un eslàlom fet amb barreres.<br><br><font face=/font/big_bold.font>Condueix per l'eslàlom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Passa per l'exterior del revolt i assegura't que la part posterior de la tractora no trepitja la vorada.<br><br><font face=/font/big_bold.font>Fes el revolt. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "T'estàs aproximant a un revolt a esquerres de 90 graus. Recorda't d'aprofitar tot l'espai al teu abast.<br><br><font face=/font/big_bold.font>Fes el revolt. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Alinea't amb la rampa. No hi ha gaire espai per maniobrar un cop estiguis a la passarel·la.<br><br><font face=/font/big_bold.font>Vés cap a la rampa. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Segueix per la pista cap a l'esquerra. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "El proper tram s'ha de recórrer fent marxa enrere. Para a les barreres del davant, per tot seguit retrocedir per la dreta.<br><br><font face=/font/big_bold.font>Para't a les barreres.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Ves enrere cap a la zona que tens a la dreta. Hi ha unes fletxes pintades a terra per indicar-te el camí.<br><br><font face=/font/big_bold.font>Ves enrere cap a la secció següent. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continua enrere cap a les barreres.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Para't i vés cap endavant, llavors segueix per l'esquerra. <br><br><font face=/font/big_bold.font>Vés endavant. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "A l'esquerra hi ha un pas a la mitjana. Travessa'l.<br><br><font face=/font/big_bold.font>Segueix per la pista. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Davant teu hi ha un tram estret en ziga-zaga. Condueix amb compte i fes servir els miralls si ho necessites.<br><br><font face=/font/big_bold.font>Segueix el camí marcat amb cons. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continua per la pista.<br><br><font face=/font/big_bold.font>Gira a l'esquerra. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Recorda de mantenir-te a l'esquerra abans del revolt per deixar-te el màxim d'espai possible.<br><br><font face=/font/big_bold.font>Passa pel revolt. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Aquí pots agafar més velocitat, però a pocs metres trobaràs un revolt.<br><br><font face=/font/big_bold.font>Segueix endavant per la pista. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "El revolt es tanca a mesura que vas avançant per la carretera.<br><br><font face=/font/big_bold.font>Ajusta la velocitat en conseqüència i segueix.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Al final de la baixada veuràs unes barreres bloquejant la carretera. <br><br><font face=/font/big_bold.font>Para a prop de les barreres. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Darrere teu a l'esquerra, hi ha una plaça d'aparcament.<br><br><font face=/font/big_bold.font>Retrocedeix cap a l'aparcament. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Para't a la zona indicada. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Conduint per la pista d'entrenament"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "En aquest escenari, conduirem per una pista dissenyada per provar les teves habilitats al volant, passant per diversos tipus de revolts."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entra a la pista"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Passa per un revolt obert"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Conduir per les corbes enllaçades"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Sector recte"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Revolts senzills"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Finalitzar la pista de proves"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Aproximació a la zona d'aparcament"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "En aquest escenari, agafarem la tractora i farem un recorregut curt per veure com condueixes amb les habilitats que has après."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Hi ha diversos tipus i combinacions de revolts a la pista. Això no és una cursa i no hi ha temps. Sigues pacient i adapta la teva velocitat als revolts i obstacles que et trobis."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "El començament de la pista és suau i fàcil, però a mesura que avancis s'anirà complicant."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Sigues cautelós amb la teva velocitat. És fàcil anar massa ràpid i no calcular bé un revolt."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "El final de la pista és una paella bastant estreta. Vés a poc a poc i utilitza tot l'espai al teu abast."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Aparca entre les barreres i assegura el camió."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Per completar aquest escenari satisfactòriament no has de xocar, sortir-te de la pista o tocar cap con.<br><br><font face=/font/big_bold.font>Prepara't per sortir. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Vés endavant per la corba tancada de la dreta i entra a la pista. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Passa per la corba a una velocitat estable. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "T'estàs aproximant a una secció de revolts més complicada.<br><br><font face=/font/big_bold.font>Adequa la teva velocitat i segueix endavant.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continua cap a la següent secció de revolts.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Ara vénen alguns girs fàcils. Mantén la teva velocitat estable.<br><br><font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "El gir per acabar la prova és una paella tancada. Redueix la velocitat i situa't a l'exterior abans del revolt. Fes servir els miralls!<br><br><font face=/font/big_bold.font>Passa per la paella. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Davant teu hi ha una plaça d'aparcament delimitat amb barreres.<br><br><font face=/font/big_bold.font>Vés cap a l'aparcament. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Aparcament en paral·lel"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "En aquest escenari, donarem una ullada a l'aparcament en paral·lel entre dos altres camions."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Para a davant de la plaça d'aparcament"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Comprova la part del darrere amb els miralls"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Fes marxa enrere cap a l'aparcament"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Alinea el camió dins de l'aparcament"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "L'aparcament en paral·lel és una habilitat essencial que qualsevol camioner ha de conèixer.<br>Prepara't per començar."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Condueix cap a l'aparcament.<br>Posa atenció al teu voltant."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Alinea't amb el camió del davant de la teva plaça d'aparcament. No t'hi acostis massa, deixa una mica d'espai per maniobrar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Gira considerablement cap a l'aparcament i fes marxa enrere."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Quan miris al mirall del costat del conductor, apunta cap a la vorada que hi ha al davant del camió posterior."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Un cop el teu para-xocs davanter esquivi el camió del davant, pots començar a situar la part davantera del camió a l'aparcament, alineant el camió amb la vorada."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Adreça la direcció i centra el camió a la plaça d'aparcament.<br>Llavors para't i assegura el camió."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Aquí al davant hi ha uns camions estacionats. Hauràs d'aparcar a l'espai lliure que hi ha. <br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Recorda't d'estar a l'aguait de què hi ha al teu voltant. Fes un bon ús dels miralls mentre maniobris. <br><br><font face=/font/big_bold.font>Condueix endavant. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Vés més enllà de la plaça d'aparcament, a la zona marcada. Des d'allà podràs començar la maniobra marxa enrere.<br><br><font face=/font/big_bold.font>Para't a la zona marcada. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Comprova el teu entorn localitzant obstacles i per estar segur que pots anar enrere.<br><br><font face=/font/big_bold.font>Mira el mirall del costat del passatger. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Gira les rodes i vés enrere cap a l'aparcament.<br><br><font face=/font/big_bold.font>Comença a fer marxa enrere. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Comença a adreçar el camió quan sigui apropiat. No pugis a sobre de la vorada!<br><br><font face=/font/big_bold.font>Alinea el camió amb l'aparcament. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Enganxar un remolc"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "En aquest escenari, explicarem els conceptes bàsics per acoblar i desacoblar la tractora i un remolc."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Marxa enrere cap al remolc"



	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Connectar el remolc"

	key[]: "aca_goal_book1_3_01_park_br_off"
