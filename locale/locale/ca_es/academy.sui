#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Marxa enrere a la zona de proves"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "En aquest escenari, hauràs d'entrar a la plaça d'aparcament lliure per practicar la marxa enrere amb remolc doble."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Per començar"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Experimenta"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Finalitza"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Acaba l'escenari"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Retrocedir amb remolcs dobles demana molta més atenció que amb remolcs normals. Necessites planejar prèviament per on vols que passi el remolc de darrere, sense perdre de vista el remolc davanter i la cabina.<br><br>Mira't-ho d'aquesta manera: Has d'utilitzar el remolc davanter per dirigir el remolc posterior."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "En aquest cas, volem fer girar el remolc del darrere cap al costat del conductor. Per fer-ho, hem d'empènyer la part davantera del remolc posterior cap al costat del passatger.<br><br>Bàsicament vol dir que has de fer girar el remolc davanter en el sentit oposat en què vols fer girar el remolc posterior."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Quan el remolc de darrere comença a girar, és essencial adreçar la tractora amb el remolc davanter. En aquest punt, és on molta gent sol cometre el seu primer error."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Aquí es veu com no s'ha alineat correctament la tractora amb el remolc davanter, resultant en l'efecte tisora dels remolcs."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "La tisora apareix quan l'angle entre dos vehicles de la combinació s'aproxima als 90 graus. Arribat el cas, ja no hi ha rectificació possible. Has d'anar endavant i tornar-ho a provar.<br><br>Com quan retrocedeixes amb un sol remolc, hauries d'assegurar-te que totes les rodes dels remolcs giren. Si alguna roda ha deixat de girar i un dels remolcs gira sobre si mateix, ja no podràs continuar."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Pots anar endavant fins a on estaves en bona posició, o més ben dit, a una posició on puguis tornar a fer marxa enrere sense caure altre cop en el mateix error.<br><br>En aquest cas, anirem endavant fins a posar en línia la composició i ho tornarem a provar des del principi."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Altre cop, a la que el remolc de darrere comenci a girar, alinea la tractora amb el remolc de davant i deixa que el remolc de darrere giri uns instants més."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Ara que el remolc posterior està anant cap a on volem que vagi, és hora de fer girar el remolc davanter i fer-lo anar pel mateix camí. Pots ajustar l'angle entre el remolc líder i el de cua per controlar el gir, per fer-lo més obert o més tancat."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "La part final de la maniobra consisteix a posar tota la combinació en línia recta. Alinea els dos remolcs."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Has de tenir en compte el temps que tardarà a moure's el remolc davanter, si esperes massa el remolc posterior acabarà anant per on no vols!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Pren-te el temps que necessitis, practica aquestes maniobres fins que tinguis una idea aproximada de com manipular els remolcs fent marxa enrere.<br><br>El més important però, recorda que tot això és per diversió!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Prepara't per començar."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Fes servir aquest aparcament per adquirir experiència retrocedint amb remolcs.<br><br>@@aca_goal_tip@@ Ets nou en això de fer marxa enrere? Sospesa jugar a la \"Conducció bàsica del camió\"."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Agafa't tant temps com vulguis per practicar.<br><br>Quan estiguis content amb els teus resultats, pots parar i assegurar el camió per finalitzar l'escenari."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Para el motor per finalitzar l'escenari."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Aparcar en un espai ajustat"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "En aquest escenari, t'encomanem aparcar aquesta combinació doble en un espai ajustat."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Per començar"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Mou-te"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Segueix conduint"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Para"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Assegura el vehicle"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Conduir amb doble remolc pot semblar intimidatori, però no ho és gaire més que conduir amb un sol remolc. Només has de pensar, també, en la trajectòria del remolc posterior!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Davant teu tens una plaça d'aparcament estreta. No hi ha prou espai per posar la combinació perfectament alineada abans d'entrar-hi, així que hauràs de ser meticulós en maniobrar els dos remolcs."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Gira immediatament cap al teu objectiu, segueix conduint fins a sobrepassar el punt on normalment giraries."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Ara que el teu remolc posterior va per bon camí, et pots dirigir cap dins de l'aparcament. Assegura't de passar per la traçada més oberta per permetre que el remolc davanter pugui girar."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Segueix per la plaça d'aparcament, els remolcs et seguiran i s'aniran alineant a mesura que avances."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Aparca a l'àrea indicada i assegura el camió."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Prepara't per començar."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Vés endavant i entra a la zona estreta."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Segueix conduint."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Para't a l'àrea indicada."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Assegura el camió i para el motor."
#@}


