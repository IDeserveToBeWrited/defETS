	key[]: "aca_scenario_book2_reverse_slalom_nt_cutscene2"
	val[]: "Retrocedeix per cada una de les seccions, fent camí cap a l'àrea d'aparcament."

#@}


#+ Book 2 reverse_slalom_nt
#@{
