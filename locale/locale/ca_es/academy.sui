#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Aparcar en semibateria"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "En aquest escenari, practicarem l'aparcament en semibateria, o en diagonal. <br><br>No hi ha massa espai per maniobrar, així que hauràs de conduir essent acurat i prudent."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Aproximació a la zona d'aparcament"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Els aparcaments en semibateria com aquest són molt comuns. Són especialment comuns en moltes àrees de servei d'arreu d'Europa. <br>Una vegada més, haurem d'aparcar de cara."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Condueix cap a la plaça d'aparcament reservada per a tu, gairebé a l'extrem de la fila."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Queda't al mig del carril, o una mica cap al costat del conductor. No t'acostis massa a les barreres o la part del darrere del remolc podria xocar-hi durant la maniobra."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Passa't una mica de la plaça d'aparcament, llavors gira força i de pressa cap al teu objectiu. Hauràs d'estar pendent dels dos retrovisors laterals: Del mirall del costat del conductor per assegurar-te que la part frontal del remolc no toca el remolc del costat, i el mirall del costat del passatger per controlar que el teu remolc entra amb seguretat a l'aparcament."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Para't a l'àrea designada, assegura el camió i apaga el motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Quan aparques en semibateria, és important calcular acuradament la teva posició. Un cop ja has començat la maniobra, és complicat fer marxa enrere i rectificar. Per això, és important estar segur que tens prou espai al primer intent.<br><br><font face=/font/big_bold.font>Prepara't per començar.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Comença a moure't cap a l'aparcament.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Vés una mica més enllà de l'aparcament per deixar espai al remolc per pivotar al voltant del camió que tens al costat.<br><br><font face=/font/big_bold.font>Entra a l'aparcament. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Recular cap al costat del passatger"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "En aquest escenari, aprendrem a fer marxa enrere cap al \"costat cec\" o costat del passatger per aparcar el camió. Sense poder treure el cap per la finestra per veure a on va el remolc, hauràs de refiar-te dels miralls per guiar-lo."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "En aquest escenari, aprendrem a maniobrar marxa enrere cap al costat del passatger. Aquest tipus de maniobra generalment s'hauria d'evitar a menys que no hi hagi alternativa, ja que la visibilitat està molt limitada. Vés amb calma i extrema les precaucions."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Condueix més enllà de l'aparcament per donar-te prou espai per maniobrar un cop comencis a retrocedir."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Arriba a les barreres, comprova el teu voltant i comença a fer marxa enrere."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Inicia el gir de la tractora abans d'arribar a l'aparcament. Això farà que el cul del remolc s'orienti cap a la plaça a on el vols entrar. Vés amb compte de no girar massa o t'arrisques a fer la tisora."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Tan bon punt el remolc comenci a entrar a l'aparcament, comença a adreçar el camió."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Para a l'àrea indicada i assegura el camió."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Fer marxa enrere cap al costat del passatger segueix les mateixes pautes que fer-ho pel costat del conductor, però té més dificultat per la falta de visibilitat. Fes servir els miralls i calcula bé les distàncies per aparcar el remolc.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Davant teu hi ha una plaça d'aparcament al costat del passatger. Necessitaràs passar-te de llarg per tenir espai per maniobrar quan reculis.<br><br><font face=/font/big_bold.font>Vés endavant. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Recorda, girar el camió lluny de l'aparcament encaminarà el remolc cap al teu objectiu. Usa els miralls per facilitar-te la feina.<br><br><font face=/font/big_bold.font>Comença a retrocedir. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Conduir per una rotonda"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "En aquest escenari, veurem com negociar una rotonda.<br><br>Hauràs de posar especial atenció al teu remolc, ja que et seguirà per una traçada diferent en entrar, en passar i en sortir de la rotonda."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entra a la rotonda"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Conduir per la rotonda"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Conduir per la rotonda"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Surt de la rotonda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Conduir cap a l'àrea designada"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Les rotondes estan molt esteses a les carreteres europees, així que és important saber com circular-hi."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Vés per l'exterior del teu carril en aproximar-te a la rotonda. Això ajudarà al teu remolc a superar la part interior del gir inicial."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "En entrar, passa pel centre del carril. Un cop dins, hauràs d'anar per l'exterior per mantenir el remolc apartat del centre de la rotonda."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Dóna una ullada al teu retrovisor i vigila que el remolc no s'apropi massa a les barreres de l'interior de la rotonda."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Sortir de la rotonda és bastant senzill sempre que el teu remolc estigui situat lluny de la part interior. Fes un gir obert a la sortida i el remolc et seguirà fàcilment."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Aparca a l'àrea indicada i assegura el camió."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Davant teu hi ha una rotonda creada per aquesta prova. <br><br><font face=/font/big_bold.font>Aproxima't lentament a la rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Fes un revolt obert en entrar a la rotonda per tal que el remolc entri rere teu sense problemes. <br><br><font face=/font/big_bold.font>Entra a la rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Condueix per l'exterior del carril. Has de mantenir el camió el més lluny possible del centre de la rotonda per mantenir el teu remolc apartat de les barreres de la part interior. <br><br><font face=/font/big_bold.font>Segueix per la rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Roman a prop dels cons de l'exterior. <br><br><font face=/font/big_bold.font>Segueix conduint.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Surt de la rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Procedeix cap a l'aparcament.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Para't a l'àrea indicada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Assegura el camió i para el motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Maniobrar en espais estrets"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "A l'escenari final, la nostra tasca consistirà a maniobrar el camió en un espai ajustat. Se't demanarà fer marxa enrere cap al costat del passatger en una zona amb poc espai per maniobrar. Hauràs de posar atenció al teu entorn i aprofitar l'espai disponible."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Condueix per la prova"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Prepara't per la maniobra"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Retrocedir cap a l'aparcament"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Completar la maniobra"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Sortir de la zona de proves"
#!{
	key[]: "aca_goal_book1_3_12_check6"
