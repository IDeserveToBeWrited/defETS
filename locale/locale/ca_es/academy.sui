	val[]: "BEN AVIAT"

	key[]: "aca_book_inaccessible_u"
	val[]: "Ben aviat!"

	key[]: "aca_book_disclaimer_t"
	val[]: "EXEMPCIÓ DE RESPONSABILITAT"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Això no és un programa d'entrenament certificat."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>Aquesta @@driving_academy@@ no pretén substituir la formació en una autoescola.</font><br><br><color value=@@clr_txt@@>Et recomanem emfàticament que cerquis formació en una autoescola acreditada abans d'intentar conduir un camió a la vida real.<br><br>Les autoescoles interessades en utilitzar la nostra @@driving_academy@@ per complementar l'entrenament en cabina, poden contactar-nos a academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Conducció bàsica del camió"

	key[]: "aca_book_book1_desc"
	val[]: "Aprèn els conceptes bàsics per conduir un camió, des de les funcions i controls bàsics a maniobrar amb un remolc."

	key[]: "aca_book_book2_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_book_book2_desc"
	val[]: "Perfecciona les teves habilitats al volant amb nous escenaris més exigents."

	key[]: "aca_book_book3_title"
	val[]: "Conducció amb doble remolc"

	key[]: "aca_book_book3_desc"
	val[]: "Enfronta't als desafiaments de conduir, cap endavant o cap enrere, amb diversos remolcs dobles."

#@}

