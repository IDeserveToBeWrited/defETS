#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "En aquest escenari, maniobrarem marxa enrere per aparcar al costat d'una vorada."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Vés marxa enrere cap a la vorada.<br>Has d'estar pendent del teu entorn quan fas marxa enrere, per tant fes servir els miralls."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "A mesura que t'acostis a la vorada hauràs d'anar alineant el camió amb la zona d'aparcament. En fer marxa enrere, mira a banda i banda del camió."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Para a la zona d'aparcament i assegura el camió."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "L'àrea d'aparcament està darrere teu i pel costat del passatger. Utilitza els miralls per anar-hi.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Recorda d'utilitzar els miralls per verificar el teu entorn abans de moure el camió.<br><br><font face=/font/big_bold.font>Comença a fer marxa enrere cap a la vorada. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continua vigilant el teu voltant mentre vas enrere cap a l'aparcament.<br><br><font face=/font/big_bold.font>Para't a la zona indicada. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Prova d'entrenament avançat"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "L'últim escenari d'aquest capítol consisteix a conduir per una pista d'entrenament avançat. Hauràs de fer servir les habilitats que has après!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Eslàlom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Eslàlom"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Paella"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "Revolt de 90 graus"

	key[]: "aca_goal_book1_2_06_check3"
	val[]: "Passarel·la elevada"

	key[]: "aca_goal_book1_2_06_check4"
	val[]: "Revolt senzill de 90 graus"

	key[]: "aca_goal_book1_2_06_check5"
	val[]: "Aproximació a la barrera"

	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Canviant de direcció"




	key[]: "aca_goal_book1_2_06_check8"
	val[]: "Travessar la mitjana"

	key[]: "aca_goal_book1_2_06_check9"
	val[]: "Ziga-zaga estreta"

	key[]: "aca_goal_book1_2_06_check10"
	val[]: "Revolt senzill de 90 graus"

	key[]: "aca_goal_book1_2_06_check11"
	val[]: "Revolt difícil de 90 graus"

	key[]: "aca_goal_book1_2_06_check12"
	val[]: "Sector recte"

	key[]: "aca_goal_book1_2_06_check13"
	val[]: "Revolt obert"

	key[]: "aca_goal_book1_2_06_check14"
	val[]: "Revolt amb radi decreixent"

	key[]: "aca_goal_book1_2_06_check15"
	val[]: "Frenada en baixada"

	key[]: "aca_goal_book1_2_06_check17"
	val[]: "Aparca"
