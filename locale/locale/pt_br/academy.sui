#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Para o cenário final deste capítulo, dirigiremos na pista de testes com desafios complexos."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "O primeiro desafio é andar em zigue-zague através de algumas barreiras. Não se esqueça de usar os retrovisores."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "O próximo é uma curva fechada. Abra bastante antes de fazê-la e isso não será um problema para você."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Há uma curva de 90 graus à esquerda. Lembre-se de dirigir por dentro da curva para que a traseira do caminhão ultrapasse os obstáculos internos."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "O obstáculo da rampa pode ser um pouco complicado. Alinhe o caminhão o melhor que puder antes de subir nela e use os retrovisores frontal e lateral para se orientar."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "O próximo desafio deve ser realizado em marcha ré. Leve em conta as barreiras à sua frente."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Siga as marcações da estrada para trás em direção a sua direita."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Dê marcha ré em direção às barreiras, pare e siga em frente para a esquerda."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Prossiga pela abertura no canteiro central até o próximo desafio."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Esta passagem pelos cones é muito estreita. Dirija devagar e use seus retrovisores para se orientar nela."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Lembre-se de abrir bastante nas curvas de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Você está entrando em um belo trecho de estrada aberta. Aqui você pode acelerar um pouco mais, mas tenha em mente que precisará diminuir a velocidade para passar na curva à frente."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Na base da colina há algumas barreiras na estrada. Dirija até elas e depois dê ré na vaga de estacionamento à esquerda."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Dê marcha ré até a vaga de estacionamento."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Estacione, então desligue o motor e estacione o caminhão com segurança."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "À sua frente há um zigue-zague feito de barreiras.<br><br><font face=/font/big_bold.font>Passe pelo zigue-zague.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Abra bastante antes de fazer a curva para garantir que a parte traseira do cavalo mecânico não ultrapasse o meio-fio.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Você está chegando a uma curva de 90 graus para a esquerda. Lembre-se de usar todo o espaço que você tem disponível.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Alinhe o caminhão com a rampa. Não há muito espaço para fazer correções depois que você já está nela.<br><br><font face=/font/big_bold.font>Passe pela rampa.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Siga o percurso à esquerda. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "O desafio a seguir deve ser realizado em marcha ré. Pare nas barreiras à frente para poder dar ré em direção à direita.<br><br><font face=/font/big_bold.font>Pare nas barreiras.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Dê ré em direção à área atrás de você e à direita. Há setas na estrada para te orientar.<br><br><font face=/font/big_bold.font>Vá de ré até o próximo desafio.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continue dando marcha ré em direção às barreiras atrás de você.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Pare e mude de marcha para continuar a frente e depois para a esquerda.<br><br><font face=/font/big_bold.font>Dirija para frente.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Há uma abertura no canteiro central à esquerda. Passe por ela.<br><br><font face=/font/big_bold.font>Continue em frente.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "À sua frente há uma passagem estreita e sinuosa através de alguns cones. Dirija com cuidado e use os retrovisores se necessário.<br><br><font face=/font/big_bold.font>Passe pelos cones.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continue o percurso.<br><br><font face=/font/big_bold.font>Vire à esquerda.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Lembre-se de abrir bastante antes de fazer curva para ter o máximo de espaço possível.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continue dirigindo. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Você pode pegar mais velocidade aqui, mas há uma curva à frente.<br><br><font face=/font/big_bold.font>Continue pelo percurso.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "A curva fica mais fechada à medida que você avança.<br><br><font face=/font/big_bold.font>Ajuste sua velocidade e continue.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na base da colina você verá barreiras bloqueando a estrada.<br><br><font face=/font/big_bold.font>Pare perto das barreiras.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Atrás de você e à esquerda, há uma vaga de estacionamento.<br><br><font face=/font/big_bold.font>Dê marcha ré para entrar na vaga de estacionamento.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Pare no local marcado.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
