	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Alguém tentou dar marcha à ré com esta combinação para a vaga de estacionamento e teve um pequeno problema. Agora é sua vez de corrigir!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "O primeiro passo é avançar e endireitar tudo para uma posição com a qual possamos trabalhar. É crucial que o reboque traseiro esteja apontando para onde você quer que ele vá."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "Neste caso, optamos por ir mais para o lado do motorista. Isso nos dará uma melhor visão do que estamos fazendo ao dar marcha à ré e permitirá trabalhar de um lado. <br><br>Lembre-se, você está guiando o reboque traseiro com o da frente, então não concentre tanto no caminhão."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "A combinação está mais ou menos onde precisamos, mas vamos avançar de novo para centralizá-lo."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "A partir daqui, vamos fazer a marcha à ré com muita minúcia, garantindo que o reboque traseiro permaneça perfeitamente no caminho."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Agora podemos alinhar o reboque da frente e o cavalo mecânico."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Avance e alinhe tudo. <br><br>Quando estiver satisfeito, dê marcha à ré para a área indicada."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Dê marcha à ré em direção à área indicada."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Acione o freio de estacionamento e desligue o motor."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Marcha à ré a 90 graus"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "Neste cenário, você fará uma manobra de marcha à ré de 90 graus para estacionar em uma fileira de outros caminhões."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Retorno"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Partindo"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Dando marcha à ré"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Dar marcha à ré para o lado é mais fácil com reboques duplos, pois você tem uma visão mais clara de tudo o que acontece pela janela."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Primeiro, siga adiante e faça um retorno ao final da fileira. Isso permitirá que você se posicione pelo lado que proporciona melhor visão pela janela do lado do motorista."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Você pode escolher posicionar os reboques como achar melhor, talvez com o reboque traseiro já apontando para a vaga. Neste caso, começaremos de uma posição alinhada. <br><br>Lembre-se de manter simples — guie o reboque traseiro com o da frente."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Aponte o reboque da frente um pouco para longe da vaga, e o reboque traseiro começará a apontar para ela. A partir daí, ajuste o ângulo entre os reboques da frente e traseiro para manter um arco suave e contínuo até entrar na vaga."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Lembre-se: se o reboque traseiro estiver entrando em um ângulo muito fechado, corrija um pouco o ângulo da combinação. Se estiver num ângulo muito aberto, feche-o."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Os ajustes que você faz com o cavalo mecânico têm metade do efeito no reboque traseiro em comparação com o da frente, então não tenha medo de manobrar bastante."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "Neste ponto, você deve começar a planejar o percurso. Você também precisa posicionar o reboque da frente na vaga, então comece a planejar como deixá-lo alinhado à frente do reboque traseiro."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "É muito raro conseguir posicionar os reboques na primeira tentativa. Neste caso, esperamos tempo demais para alinhar o reboque da frente, e agora o traseiro está saindo do caminho. <br><br>Sem problemas, avance e tente novamente."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Vire bastante o volante e coloque os reboques onde quer. Você pode avançar quantas vezes precisar."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "E assim, conseguimos estacionar os reboques duplos."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Siga adiante até o final do pátio e faça um retorno."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Lembre-se de fazer uma curva aberta."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Siga adiante até sentir que há espaço suficiente para manobrar, então comece a dar marcha à ré."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Estacione de ré se acreditar que tem espaço suficiente para manobrar."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


