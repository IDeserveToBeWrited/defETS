	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ não substitui o treinamento num veículo real.</font><br><br><color value=@@clr_txt@@>Recomendamos fortemente que você procure uma autoescola credenciada antes de tentar dirigir um caminhão na vida real.<br><br>As autoescolas interessadas em usar a @@driving_academy@@ como um complemento de treinamento podem entrar em contato conosco pelo e-mail academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Noções básicas de direção de caminhão"

	key[]: "aca_book_book1_desc"
	val[]: "Aprenda o básico da condução de um caminhão, desde as funções e controles básicos até manobras com um reboque."

	key[]: "aca_book_book2_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_book_book2_desc"
	val[]: "Aperfeiçoe suas habilidades de direção de caminhão com novos cenários em condições mais desafiadoras."

	key[]: "aca_book_book3_title"
	val[]: "Condução com reboque duplo"

	key[]: "aca_book_book3_desc"
	val[]: "Enfrente os curiosos desafios de dirigir e manobrar em marcha à ré com um conjunto de duplo reboque."

#@}

