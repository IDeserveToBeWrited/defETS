#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Neste cenário, faremos uma curta viagem com o cavalo mecânico para ver como você o conduz com as suas novas habilidades aprendidas."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Existem vários tipos e combinações de curvas na pista. Não é uma corrida e não se trata de tempo. Tenha paciência e ajuste a sua velocidade de acordo com as curvas e os obstáculos que encontrar."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "No início o percurso é tranquilo e fácil, mas as curvas vão ficando mais complexas à medida que você avança."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Tenha cuidado com a sua velocidade; é fácil andar rápido demais e calcular mal uma curva."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "A saída da pista é uma curva fechada. Vá devagar e use todo o espaço disponível."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Estacione entre as barreiras e estacione o caminhão com segurança."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Para concluir este cenário com sucesso, você não deve bater, sair da pista ou atropelar os cones de trânsito.<br><br><font face=/font/big_bold.font>Prepare-se para partir. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Siga pela curva fechada à direita para entrar no percurso."

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Passe pela curva mantendo uma velocidade constante e segura. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Você está se aproximando de uma seção mais complexa de curvas sinuosas.<br><br><font face=/font/big_bold.font>Ajuste sua velocidade e continue.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continue em direção ao próximo conjunto de curvas.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Há algumas curvas fáceis e suaves chegando. Mantenha sua velocidade constante.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "A saída do percurso é uma curva fechada. Diminua a velocidade a abra bastante antes de fazer a curva. Não se esqueça de usar seus retrovisores!<br><br><font face=/font/big_bold.font>Saia do percurso.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "À sua frente há um local de estacionamento entre algumas barreiras.<br><br><font face=/font/big_bold.font>Siga em direção à vaga de estacionamento.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

