	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Vamos tentar dar marcha à ré com um reboque. É mais fácil do que parece; você só precisa ter paciência."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Comece a dar marcha à ré e alinhe o cavalo mecânico com o reboque."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Confirme o alinhamento correto, ou não vai conseguir o engate. Se o alinhamento não estiver bom, você pode sempre andar para a frente e tentar novamente."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "A quinta roda do cavalo mecânico vai se encaixar no pino rei do reboque."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Aplique o freio de estacionamento e conecte o reboque. Na vida real, você teria que sair do caminhão para conectar as linhas de ar e elétrica e levantar o pé de apoio, mas aqui, faremos isso para você."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>O reboque sempre vai virar na <color value=@@clr_sel@@>direção oposta <color value=@@clr_txt@@>do cavalo mecânico."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Para virar o reboque, você precisa esterçar o cavalo mecânico na<color value=@@clr_sel@@> direção oposta <color value=@@clr_txt@@> na qual quer que o reboque vá."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Para endireitar o reboque novamente, gire o cavalo mecânico <br><color value=@@clr_sel@@>na direção<color value=@@clr_txt@@> do reboque."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Tente manter o alinhamento com o reboque - você precisará fazer pequenas correções constantes para mantê-lo apontado para a área marcada."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corrija os desvios do seu trajeto com pequenos movimentos no volante, assim que eles acontecerem. Se você virar demais, pode acabar muito fora do caminho desejado."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Pare na área indicada. Acione o freio de estacionamento e desligue o motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Atrás de você, no lado do passageiro, há um reboque. Sua primeira tarefa será dar marcha à ré até ele.<br><br><font face=/font/big_bold.font>Prepare o caminhão para dar ré. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Comece a dar marcha à ré em direção ao reboque. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Alinhe-se em linha reta em relação ao reboque. A quinta roda precisa encaixar no pino rei. Mova-se para a frente se for necessário reajustar. <br><br><font face=/font/big_bold.font>Continue dando marcha à ré até sentir um tranco. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "A quinta roda se acoplou ao pino rei e você está pronto para finalizar o acoplamento ao reboque.\n<br><br><font face=/font/big_bold.font>Acione o freio de estacionamento. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Pressione @@imv_nrm_attach@@ para engatar o reboque. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Agora o reboque está engatado com segurança ao cavalo mecânico, as linhas pneumáticas e elétricas estão conectadas, e as pernas de apoio foram levantadas.<br><br><font face=/font/big_bold.font>Solte o freio de estacionamento. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Você deve dar ré para entrar na vaga atrás de você. Lembre-se de que o reboque gira na direção oposta do cavalo mecânico. Um pequeno movimento no volante pode resultar em um deslocamento significativo do reboque.<br><br><font face=/font/big_bold.font>Comece a dar ré com o reboque.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Não vire demais, apenas tente manter o reboque alinhado com a vaga. <br><br><font face=/font/big_bold.font>Continue em direção à vaga. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
