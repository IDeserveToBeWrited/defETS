	val[]: "Siga adiante até o final do estacionamento e faça um retorno."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Lembre-se de fazer uma curva aberta."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Siga adiante até sentir que há espaço suficiente para manobrar, e então comece a dar marcha à ré."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Estacione de ré se acreditar que tem espaço suficiente para manobrar."

