#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Controles básicos e movimentação"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Aprenda os controles básicos do veículo e como dirigir o caminhão para a frente e para trás."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você completou o capítulo 1: @@aca_chapter_book1_1_title@@.<br><br>Você aprendeu como preparar o caminhão antes de dirigir,<br>dirigir para a frente, para trás, como usar as luzes e os limpadores.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Manobras básicas"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Aprenda a dirigir, manobrar e estacionar com o cavalo mecânico. Explore o propósito de cada tipo de retrovisor e como usá-los da melhor forma."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 2: @@aca_chapter_book1_2_title@@.<br><br>Você aprendeu a usar corretamente os retrovisores do caminhão, verificar os arredores antes de se movimentar e realizar manobras básicas e avançadas.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manobras com reboque"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Aprenda a engatar e manobrar com um reboque em diferentes situações."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Você completou o Capítulo 3: @@aca_chapter_book1_3_title@@.<br><br>Você aprendeu a engatar e desengatar um reboque,<br>perceber o peso e as dimensões do caminhão com um reboque<br>e a dirigir em trajetos desafiadores com um reboque.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Ré com um reboque"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Aprende novas habilidade para manobrar de ré e estacionar com o reboque."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 4: @@aca_chapter_book1_4_title@@.<br><br>Você aprendeu a dar ré com um reboque<br>e várias técnicas de estacionamento.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Teste final"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Demonstre seu conhecimento e habilidade para provar que você é um bom caminhoneiro!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Parabéns!<br>Você completou o Capítulo 5: @@aca_chapter_book1_5_title@@.<br><br>Você provou que possui todas as habilidades necessárias<br>para dirigir, manobrar e estacionar um caminhão!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Aquecendo o motor"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Você concluiu o treinamento: @@aca_chapter_book2_0_title@@.<br><br>Você aprendeu as regras e os fundamentos da Proficiência na Condução.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "De volta à ativa"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 2: @@aca_chapter_book2_1_title@@.<br><br>Você aqueceu o motor, testou as marchas, esterçou o volante corretamente e verificou a eficiência dos freios. Os próximos capítulos vão ser mais desafiadores.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Rodas em movimento"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 3: @@aca_chapter_book2_2_title@@.<br><br>Você dominou cenários difíceis e variados. Você demonstrou habilidade e desempenho.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Reta final"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o capítulo 4: @@aca_chapter_book2_3_title@@.<br><br>Você lidou com muitas situações difíceis ao manobrar, estacionar e dar ré com um reboque. Você provou ser um motorista habilidoso, capaz de lidar com todas as situações desafiadoras de direção de caminhão."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Seguindo em frente"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Aprenda todas as técnicas essenciais na condução de reboques duplos, dirigindo para a frente."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você completou o Capítulo 1: @@aca_chapter_book3_1_title@@.<br><br>Agora você tem experiência de como conduzir e manobrar com reboques duplos eficientemente.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Controle em marcha à ré"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Entenda os passos necessários para manobrar reboques duplos em marcha à ré."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você completou o capítulo 2: @@aca_chapter_book3_1_title@@.<br><br>Agora você aprendeu a formidável habilidade de conduzir em marcha à ré com reboques duplos.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Preparação para o mundo real"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Aplique seus novos conhecimentos em cenários mais avançados."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br>Você concluiu o Capítulo 3: @@aca_chapter_book2_3_title@@.<br><br>Você lidou com muitas situações difíceis ao manobrar, estacionar e dar ré com um reboque duplo. Você se provou aqui, agora é hora puxar reboques duplos pelas estradas do Euro Truck Simulator 2!</font><br><br>"


#@}

