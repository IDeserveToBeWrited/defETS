#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Para o cenário final deste capítulo, vamos dirigir na configuração complexa da pista de testes."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "O primeiro desafio é um slalom através de algumas barreiras. Não se esqueça de usar os retrovisores."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "A seguir, um grampo. Abra bem a curva e você não terá problema."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Há uma curva de 90 graus à esquerda. Vire tarde na curva para que a traseira do caminhão ultrapasse os obstáculos internos."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "O obstáculo da rampa pode ser um pouco difícil. Alinhe o caminhão o melhor que puder antes de subir nela e use os retrovisores frontal e laterais para se orientar."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "O próximo desafio é em marcha à ré. Aproxime-se das barreiras à sua frente com isso em mente."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Siga as marcações da via atrás à sua direita."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Dê marcha à ré em direção às barreiras, pare e siga em frente para a esquerda."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Prossiga pela abertura no canteiro central até o próximo desafio."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Esta passagem pelos cones é muito estreita. Dirija devagar e use os retrovisores para se orientar."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Lembre-se de virar tarde em curvas de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Você está entrando em um belo trecho aberto. Aqui você pode acelerar um pouco mais, mas tenha em mente que precisará diminuir a velocidade para fazer a curva à frente."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Na base do morro, há algumas barreiras na via. Dirija até elas e depois dê ré na vaga à esquerda."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Dê marcha à ré até a vaga."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Estacione, desligue o motor e acione o freio de estacionamento."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "À sua frente, há um slalom feito de barreiras.<br><br><font face=/font/big_bold.font>Passe pelo slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Abra bastante a curva para que a parte traseira do cavalo mecânico não suba no meio-fio.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Você está chegando a uma curva de 90 graus para a esquerda. Lembre-se de usar todo o espaço disponível.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Alinhe o caminhão com a rampa. Não há muito espaço para fazer correções depois que você já estiver nela.<br><br><font face=/font/big_bold.font>Passe pela rampa.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Siga o percurso à esquerda. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "O desafio a seguir deve ser realizado em marcha à ré. Pare nas barreiras à frente para poder entrar de ré à direita.<br><br><font face=/font/big_bold.font>Pare nas barreiras.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Dê ré em direção à área atrás de você e à direita. Há setas na via para ajudar.<br><br><font face=/font/big_bold.font>Vá de ré até o próximo trecho.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continue dando marcha à ré em direção às barreiras atrás de você.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Pare, engate uma marcha de avanço e continue à esquerda.<br><br><font face=/font/big_bold.font>Dirija para a frente.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Há uma abertura no canteiro central à esquerda. Passe por ela.<br><br><font face=/font/big_bold.font>Continue em frente.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "À sua frente, há uma passagem estreita e sinuosa através de alguns cones. Dirija com cuidado e use os retrovisores se necessário.<br><br><font face=/font/big_bold.font>Passe pelos cones.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continue o percurso.<br><br><font face=/font/big_bold.font>Vire à esquerda.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Mantenha-se à esquerda antes de fazer curva para ter o máximo de espaço possível.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continue dirigindo. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Você pode ir mais rápido aqui, mas há uma curva à frente.<br><br><font face=/font/big_bold.font>Continue pelo percurso.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "A curva fica mais fechada à medida que você avança.<br><br><font face=/font/big_bold.font>Ajuste a velocidade e continue.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na base do morro, você vai ver barreiras bloqueando a via.<br><br><font face=/font/big_bold.font>Pare perto das barreiras.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Atrás de você e à esquerda, há uma vaga.<br><br><font face=/font/big_bold.font>Dê marcha à ré para entrar na vaga.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Pare no local marcado.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

