#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Bem-vindo(a) à primeira parte do exame final. Aqui, vamos ver o quanto você aprendeu a dirigir um caminhão depois do seu tempo na autoescola."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Primeiro, você vai engatar o reboque. Uma vez engatado, você vai dirigir o caminhão por toda a área de teste."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "A primeira seção da pista vai do pequeno estacionamento até a pista de testes a leste."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "O circuito inclui desafios de passagem entre barreira."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Uma parte significativa da rota passa pelo percurso de teste a leste."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Testaremos sua capacidade de manobrar o caminhão em diferentes situações."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Você manobrará o caminhão em algumas curvas fechadas."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Você passará pela seção da estrada que conecta os percursos."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "A parte final envolve dirigir pelo pequeno circuito."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "O circuito tem muitas passagens intrincadas e curvas fechadas."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Para completar o teste, você precisará estacionar com precisão."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Não precisa ficar nervoso, você já aprendeu tudo o que é necessário para passar.<br><br> Boa sorte!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "À sua frente está o reboque.<br><br><font face=/font/big_bold.font>Dirija em direção ao reboque.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Alinhe o cavalo mecânico com o reboque.<br><br><font face=/font/big_bold.font> Dê marcha ré até se conectar com o pino rei.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Estacione o caminhão com segurança. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Pressione @@imv_nrm_attach@@<font face=/font/big_bold.font> para conectar o reboque. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "O reboque está conectado e o caminhão está pronto para dirigir.<br><br><font face=/font/big_bold.font> Libere o freio de estacionamento.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Comece a dirigir em direção à saída do estacionamento.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Siga as marcações da estrada e tome cuidado com as barreiras.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Uma seção mais desafiadora está chegando.<br><br><font face=/font/big_bold.font>Conduza com cuidado entre as barreiras.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Continue dirigindo. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Esta parte testará suas habilidades em manobrar um reboque em diferentes tipos de curvas.<br><br><font face=/font/big_bold.font> Entre no percurso.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Dirija pela passagem.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Dirija em linha reta. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Manobre pela curva com cuidado.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Você está entrando em uma seção mais complexa. Dirija com cuidado.<br><br><font face=/font/big_bold.font>Continue dirigindo ladeira abaixo.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Faça uma curva fechada para a esquerda.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Saia do percurso. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Você está entrando em uma seção mais fácil.<br><br><font face=/font/big_bold.font>Continue descendo a colina.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Mantenha-se na estrada.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "À frente está a curva para o próximo percurso.<br><br><font face=/font/big_bold.font>Continue dirigindo. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Vire à direita. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Continue dirigindo no percurso. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "À frente há mais curvas fechadas.<br><br><font face=/font/big_bold.font>Ajuste sua velocidade adequadamente. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Faça uma curva para a esquerda. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continuar dirigindo. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Entre na curva e continue dirigindo. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Para fazer a curva, talvez seja necessário sair um pouco do asfalto.<br><br><font face=/font/big_bold.font> Vire com cuidado, use o máximo de espaço que precisar. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Saia do circuito e dirija até a vaga de estacionamento. </font>"
