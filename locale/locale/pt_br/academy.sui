#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_mirror_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img_uk"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_gb.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
#!}

#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Estacionando próximo a um obstáculo"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Neste cenário, aprenderemos a estacionar próximo ao meio-fio usando o retrovisor lateral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Verifique o retrovisor lateral"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Dirigindo em direção ao meio-fio"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "O retrovisor lateral é outra ferramenta que ajudará você a manobrar o caminhão com segurança. Ele fica localizado na estrutura superior da porta do passageiro."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Dirija para frente e vire lentamente para o lado do passageiro."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Essas tábuas de madeira representam um meio-fio. Você precisará estacionar próximo a ela. <br>Vire em direção ao meio-fio para colocar o caminhão em uma boa posição para alinhar com a vaga de estacionamento."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Diminua a velocidade antes do meio-fio e vire em direção à vaga de estacionamento. À medida que você se endireita, pode usar o retrovisor lateral para avaliar a distância em relação ao meio-fio."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Pare na vaga de estacionamento e estacione o caminhão com segurança."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Olhe pela janela do lado do passageiro. Você pode ver o retrovisor lateral lá.</font>@@aca_goal_tip@@ Você precisa estar usando a câmera interna."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "O retrovisor lateral cobre a área do lado do passageiro que o motorista não consegue ver. É um dos pontos cegos mais problemáticos do caminhão. Se o ângulo do espelho não estiver bom, você pode ajustá-lo em '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "O caminhão ainda não está pronto para se mover, talvez você tenha esquecido de algo?<br><br>O motor está ligado? Você soltou o freio de estacionamento?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "À sua frente, há uma linha de tábuas representando um meio-fio. No final do meio-fio, há uma vaga de estacionamento. Você precisará dirigir até lá. <br><br><font face=/font/big_bold.font>Prossiga quando estiver pronto.</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Vire em direção ao meio-fio. Use os retrovisores frontal e lateral para verificar sua posição em relação ao meio-fio, mas também certifique-se de não passar por cima de nenhum cone de trânsito.<br><br><font face=/font/big_bold.font>Dirija em direção ao meio-fio e entre na vaga de estacionamento.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Pare o caminhão em segurança e desligue o motor.</font>@@aca_goal_tip@@ Você pode usar as predefinições de visão interna para facilitar a visualização dos retrovisores. Verifique o menu Opções - 'Teclas e botões' - para ver e/ou alterar os controles correspondentes."
#@}

