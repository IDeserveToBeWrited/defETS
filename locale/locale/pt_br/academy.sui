#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Ré com um reboque"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Neste cenário, você tentará dar ré com um reboque pela primeira vez. É uma manobra bem simples, mas você ainda precisará dirigir corretamente para colocar o reboque na posição correta."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Dando ré em direção ao reboque"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Engatando o reboque"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Liberando o freio de estacionamento"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Ré com um reboque"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Continuando em direção ao espaço de estacionamento"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Vamos tentar dar marcha ré com um reboque. É mais fácil do que parece; você só precisa ter paciência."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Comece a dar marcha ré e alinhe o cavalo mecânico com o reboque."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Certifique-se de que está alinhado corretamente, ou não conseguirá engatar. Se não estiver certo, você pode sempre andar para a frente e tentar novamente."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "A quinta roda do cavalo mecânico vai se encaixar no pino rei do reboque."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Aplique o freio de estacionamento e conecte o reboque. Na vida real, você teria que sair do caminhão para conectar as linhas de ar e elétrica e levantar o pé de apoio, mas aqui, faremos isso para você."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>O reboque sempre vai virar na <color value=@@clr_sel@@>direção oposta <color value=@@clr_txt@@>do cavalo mecânico."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Para virar o reboque, você precisará girar o cavalo mecânico na<color value=@@clr_sel@@> direção oposta <color value=@@clr_txt@@> em que deseja que o reboque vá."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Para alinhar o reboque novamente, gire o cavalo mecânico <br><color value=@@clr_sel@@>na direção<color value=@@clr_txt@@> do reboque."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Tente manter-se alinhado com o reboque – você precisará fazer pequenas correções constantes para mantê-lo apontado para a área demarcada."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corrija os desvios do seu trajeto com pequenos movimentos no volante, assim que eles acontecerem. Se você virar demais, pode acabar muito fora do caminho desejado."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Pare na área indicada. Estacione o caminhão com segurança e desligue o motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Atrás de você, no lado do passageiro, há um reboque. Sua primeira tarefa será dar marcha ré até ele."

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Comece a dar marcha ré em direção ao reboque. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Alinhe-se de forma que fique reto em relação ao reboque. A quinta roda precisa encaixar no pino rei. Mova-se para frente se for necessário reajustar. <br><br><font face=/font/big_bold.font>Continue dando marcha ré até sentir um tranco. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "A quinta roda se acoplou ao pino rei e você está pronto para finalizar o acoplamento ao reboque.\n<br><br><font face=/font/big_bold.font>Acione o freio de estacionamento. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Pressione @@imv_nrm_attach@@ para conectar o reboque. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Agora o reboque está conectado com segurança ao cavalo mecânico, as linhas de ar e elétricas estão conectadas, e as pernas de apoio foram levantadas.<br><br><font face=/font/big_bold.font>Libere o freio de estacionamento. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Você deve dar ré para entrar na vaga de estacionamento atrás de você. Lembre-se de que o reboque irá girar na direção oposta do cavalo mecânico. Um pequeno movimento no volante pode resultar em um deslocamento significativo do reboque.<br><br><font face=/font/big_bold.font>Comece a dar ré com o reboque.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Não vire demais, apenas tente manter o reboque alinhado com o espaço. <br><br><font face=/font/big_bold.font>Continue em direção a vaga de estacionamento. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Estacionando em um espaço estreito"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "Neste cenário, vamos estacionar em um espaço estreito.<br><br>Você precisará manobrar o reboque para alinhá-lo corretamente com uma vaga de estacionamento deslocada."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manobrando para a posição"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Estacionar dirigindo para frente, ou \"entrando de frente\", é relativamente fácil quando se trata de manobras de estacionamento. <br>Ainda assim, você precisará compensar o deslocamento do reboque."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Você precisará passar do ponto onde normalmente viraria o cavalo mecânico sozinho. Isso permitirá alinhar o reboque de forma mais eficaz."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Ao se aproximar da vaga, vire para posicionar o cavalo mecânico à frente do reboque. Alinhe o conjunto e avance para dentro da vaga. <br>Pare, estacione o caminhão com segurança e desligue o motor."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "À sua frente, há uma vaga de estacionamento para onde você precisará dirigir e estacionar.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Comece a dirigir e vire em direção à vaga de estacionamento.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Passe pela vaga para alinhar o reboque com a área marcada e, em seguida, leve o cavalo mecânico para dentro da vaga e endireite o conjunto.<br><br><font face=/font/big_bold.font>Estacione na área indicada.</font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Pare na área indicada.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Estacione o caminhão de forma segura e desligue o motor.</font>"
#@}

