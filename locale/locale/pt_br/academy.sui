	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Estacionamento paralelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Neste cenário, veremos o estacionamento paralelo entre dois caminhões."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Parando em frente ao local de estacionamento"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Verificando o espelho retrovisor"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Dando ré na vaga de estacionamento"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Alinhando o caminhão na vaga de estacionamento"
