#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Neste cenário, faremos uma curta viagem com o caminhão. Você poderá sentir como é frear com um reboque enquanto descemos a colina à frente. Prepare o caminhão e siga."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Atinja uma velocidade de pelo menos 60 km/h (37 mph) e se prepare para frear logo a frente."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Comece a frear até parar. Só não demore muito para iniciar a frenagem, pois certamente você baterá nas barreiras à sua frente!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Estacione na área indicada, estacione o caminhão com segurança e desligue o motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Durante esta viagem, você terá uma noção de como usar os freios de serviço ao descer um declive. O objetivo deste exercício é conscientizá-lo sobre o peso atrás de você e como ele afeta a distância de frenagem do veículo.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Comece a dirigir e lembre-se de que será necessário atingir uma velocidade de 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Dirija pela curva. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Continue acelerando colina abaixo.</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Atinja uma velocidade de pelo menos 60 km/h (37 mph).</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Você atingiu a velocidade necessária.<br><br><font face=/font/big_bold.font>Pare nas barreiras à frente.</font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

