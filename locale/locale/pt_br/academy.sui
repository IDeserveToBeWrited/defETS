#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Parando perto de um obstáculo"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Neste cenário, vamos falar sobre o retrovisor frontal, sua localização e como usá-lo da melhor forma para parar próximo a um obstáculo à frente."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Verifique o retrovisor frontal"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Entendendo sua função"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Parando perto do obstáculo"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Os caminhões têm um grande ponto cego na área à frente da cabine. É fácil perder de vista um pedestre ou até mesmo um carro nessa área, por isso os caminhões são equipados com um retrovisor frontal que pode ser visto através do para-brisa."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "O retrovisor frontal é projetado para proporcionar ao motorista uma visão desse ponto cego.<br>É uma ferramenta essencial para garantir que você não colida com nenhum obstáculo ao manobrar em espaços apertados."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Comece a dirigir, prossiga em direção à barreira à sua frente e, em seguida, reduza a velocidade à medida que se aproxima dela.<br>Fique de olho no retrovisor frontal."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Pare entre a linha e o obstáculo."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "Neste cenário, vamos aprender a usar o retrovisor frontal mostrado no diagrama.<br><br><font face=/font/big_bold.font>Olhe através da parte superior do para-brisa para vê-lo.</font>@@aca_goal_tip@@ Você deve estar usando a câmera interna."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "O retrovisor frontal permite que você veja o ponto cego à frente do caminhão. Ele pode ajudá-lo a dirigir com segurança e precisão.<br><br>Se você não estiver satisfeito com o ajuste, abra '@@adjust_link_t@@' (acessível pelo menu de pausa) para ajustá-lo conforme sua preferência.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_activate@@ para continuar.</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "À sua frente, há uma vaga marcada. Você notará que há um obstáculo do outro lado da vaga; quando estiver perto dele, dirija bem devagar e verifique a distância em relação ao obstáculo pelo retrovisor frontal.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "O caminhão ainda não está pronto para se mover, talvez você tenha esquecido de algo?<br><br>O motor está ligado? Você soltou o freio de estacionamento?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Dirija em direção ao local de estacionamento.</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Pare a frente do caminhão entre o obstáculo e a marcação pintada na estrada.</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

