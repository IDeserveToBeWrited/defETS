#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Nossas boas-vindas ao exame final. Preparamos algumas situações realistas que você pode encontrar na estrada para avaliar como você as encara. Como sempre, vá com calma e dirija com precisão. <br><br>Boa sorte!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "O caminho à frente está bloqueado, faça um retorno no espaço disponível."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Continue pelo percurso."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Alcance uma velocidade de pelo menos 60 km/h (37 mph) enquanto desce a ladeira."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Prepare-se para frear."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Você não conseguiu atingir a velocidade de 60 km/h (37 mph)."

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Continue dirigindo através do circuito."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Há uma vaga de estacionamento para você na fileira de caminhões à direita. Dê marcha à ré e estacione."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Siga adiante quando puder."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

