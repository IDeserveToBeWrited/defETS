	key[]: "aca_msg_book3_train_check1"
	val[]: "Há um trecho em descida à frente, você pode usá-lo para sentir como o conjunto de duplos se comporta em velocidade."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Prepare-se para frear na curva à frente."

	key[]: "aca_msg_book3_train_check3"
