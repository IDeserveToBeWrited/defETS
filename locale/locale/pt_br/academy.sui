#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFORMAÇÕES SOBRE PROFICIÊNCIA NA CONDUÇÃO DE CAMINHÕES" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Requisitos para conclusão"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Os cenários são concluídos ao atender a todas as condições de aprovação"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "As estrelas são ganhas ao completar condições de bônus"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Condições"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Número máximo de mudanças entre movimento para frente e para trás"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Tempo máximo permitido para concluir um cenário sob uma determinada condição"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Uso exclusivo da câmera interna - câmeras externas ainda podem ser utilizadas enquanto estiver parado"

	key[]: "aca_book_book2_completed_t"
	val[]: "PROFICIÊNCIA EM CONDUÇÃO DE CAMINHÕES APROVADA"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br><br>Você concluiu todas as condições de aprovação no módulo de Proficiência na Condução de Caminhões e ganhou recompensas para o seu perfil de carreira. Você ainda pode se desafiar para obter mais recompensas concluindo todas as condições bônus.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "PROFICIÊNCIA EM CONDUÇÃO DE CAMINHÕES CONCLUÍDA"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Parabéns!<br><br>Você concluiu todas as condições de aprovação e bônus no módulo Proficiência na Condução de Caminhões e ganhou recompensas para seu perfil de carreira.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Proficiência na Condução de Caminhões"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Bem-vindo de volta à @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Os cenários a seguir representam o próximo passo em sua jornada para se tornar um motorista profissional de caminhão."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Desta vez, não orientaremos você em cada tarefa, então cabe a você colocar suas habilidades e experiência em prática."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Você pode encontrar algumas manobras familiares, mas desta vez em novos ambientes feitos para parecer mais com cenários reais."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Uma novidade para @@driving_academy@@ é a adição das condições \"Aprovação\" e \"Bônus\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Assim como antes, você ainda deve completar cada cenário sem bater em nada, estacione o caminhão com sucesso e o deixe em segurança..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "... mas agora você também deve fazer isso no limite de tempo estipulado e com um limite no número de mudanças de direção para frente e para trás."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Condições de bônus podem ser cumpridas completando cada cenário com condições ainda mais desafiadoras..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "... como limites de tempo mais rigorosos, menos mudanças de direção e uso exclusivo da câmera interna."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Ao completar todos os cenários, você pode se considerar um caminhoneiro proficiente e pronto para o próximo desafio.<br><br>Para se desafiar ainda mais, complete todas as condições de bônus para cada cenário; então você realmente será uma estrela na direção de caminhões!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Neste cenário de tutorial, ajudaremos você a se familiarizar com os novos recursos encontrados na Proficiência na Condução de Caminhões."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "No início de cada cenário, você verá uma janela com <color value=@@clr_sel@@>\"Informações do Cenário\"<color value=@@clr_txt@@>. Ela fornecerá informações sobre as novas condições de Aprovação e Bônus para o cenário. <br><br>As condições de Aprovação devem ser cumpridas para concluir o cenário com sucesso, enquanto as condições de Bônus são um desafio extra opcional para jogadores experientes e habilidosos. <br><br><font face=/font/big_bold.font>Para continuar, ligue a ignição.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Uma das condições de bônus exige que você conclua o cenário usando a <color value=@@clr_sel@@>Câmera Interna<color value=@@clr_txt@@>. Você ainda pode usar as câmeras externas para verificar os arredores, mas apenas com o caminhão parado.<br><br>Agora você pode olhar ao redor para se orientar e, em seguida, voltar para a câmera interna.<br><br><font face=/font/big_bold.font>Alterne para a câmera externa para verificar os arredores</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Oriente-se e depois volte para a câmera interna.<br><br><font face=/font/big_bold.font>Olhe ao redor do caminhão</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Mude de volta para a câmera interior</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Tempo<color value=@@clr_txt@@> também será um fator na Proficiência na Condução de Caminhões. Todos os cenários terão um limite de tempo individual, no qual o cenário deverá ser concluído como condição de Aprovação, e muitos também terão um limite adicional mais rigoroso como condição de Bônus.<br><br>O cronômetro só começa a contar após você mover o caminhão.<br><br><font face=/font/big_bold.font>Ligue o motor e solte o freio estacionário para continuar.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Outra novidade para a Proficiência na Condução de Caminhões são os pontos de checagem. Todos os pontos de checagem devem ser alcançados antes que um cenário possa ser concluído. <br><br>Além disso, os pontos de checagem são sensíveis à direção para qual o caminhão está voltado ao chegar até ele, portanto, preste atenção nas marcações no solo próximas ao ponto de referência para se orientar corretamente. <br><br><font face=/font/big_bold.font>Siga a diante até o ponto de checagem à sua frente.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Você atingiu o ponto de checagem e agora pode prosseguir para a próxima etapa. <br><br>Há outro ponto de checagem atrás de você para o qual você deve dar ré. Observe a seta no chão indicando para qual direção o caminhão deve estar voltado ao chegar ao ponto de checagem. <br><br>Outra condição de Aprovação e Bônus que deve ser considerada são as <color value=@@clr_sel@@>Mudanças de Direção<color value=@@clr_txt@@>. Contaremos quantas vezes você muda de direção entre dirigir para frente e para trás. Mantenha-se abaixo do limite para completar a condição. <br><br><font face=/font/big_bold.font>Dê ré para o ponto de checagem e pare.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Então, agora, você deve ter acumulado uma mudança de direção. <br><br>Pegue o reboque atrás de você para continuar para a próxima etapa. <br><br><font face=/font/big_bold.font>Dê marcha ré até ao reboque para conectá-lo.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "A última área de estacionamento fica à sua direita. Alguns cenários podem ter apenas uma vaga de estacionamento, enquanto outros terão várias para escolher. Estacionar corretamente em qualquer uma das vagas permitirá que você conclua o cenário. <br><br><font face=/font/big_bold.font> Pressione @@imv_nrm_attach@@ para conectar o reboque. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "As vagas de estacionamento também indicam a direção que o caminhão deve seguir. Estacione na direção errada e você não conseguirá completar o cenário até se corrigir, o que lhe custará tempo e mudanças de direção.<br><br><font face=/font/big_bold.font>Dirija até uma das vagas de estacionamento e estacione corretamente.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Proficiência na condução de caminhões"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Agora você deve estar familiarizado com os novos parâmetros para condições de Aprovação e metas de Bônus e estar pronto para encarar os novos cenários em Proficiência na Condução de Caminhões!<br><br><font face=/font/big_bold.font>Estacione o caminhão com segurança e desligue o motor para finalizar o cenário.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Atalho"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "Neste cenário, você tentará usar um atalho que, infelizmente, está bloqueado no final. Você deverá então voltar pelo mesmo caminho de onde veio."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
