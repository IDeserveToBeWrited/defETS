	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Rotatórias são muito comuns nas estradas da Europa, por isso é importante saber como contorná-las."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Fique do lado de fora da sua faixa ao se aproximar da rotatória. Isso ajudará seu reboque a passar pelo lado de dentro da curva inicial."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Dirija em direção a rotatória. Uma vez lá dentro, você terá que ir em direção ao lado de fora. Isso é para manter seu reboque numa distância segura da guia da rotatória."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Fique de olho no espelho retrovisor para garantir que o reboque não esteja chegando muito perto das guias internas."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Sair da rotatória é bem fácil, já que seu reboque já está numa boa posição. Dirija até a saída e o reboque deve seguir sem percalços."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Estacione o caminhão na área designada e deixe o caminhão em segurança."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "À sua frente, há uma rotatória preparada para você dirigir.<br><br><font face=/font/big_bold.font> Aproxime-se lentamente da rotatória. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Faça uma curva ampla ao entrar na rotatória para que seu reboque entre atrás de você sem problemas.<br><br><font face=/font/big_bold.font> Entre na rotatória. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Dirija em direção ao lado de fora da rotatória. Você precisará manter o caminhão o mais longe possível do centro da rotatória para manter seu reboque longe das barreiras centrais. <br><br><font face=/font/big_bold.font>Continue pela rotatória.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Fique perto dos cones externos. <br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Saia da rotatória.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Siga para o local de estacionamento à frente.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Pare na área indicada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Estacione o caminhão de forma segura e desligue o motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manobrando em um espaço apertado"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Para o cenário final, você terá que virar o caminhão em um espaço apertado. Isso exigirá que você dê ré pelo \"lado cego\" em uma área com espaço limitado para manobrar, o que requer atenção ao seu entorno e uso inteligente do espaço."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Dirija para o percurso"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Preparando-se para uma manobra no \"lado cego\""

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Dando ré na vaga de estacionamento"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Finalizando a manobra no \"lado cego\""

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Saindo do percurso"
