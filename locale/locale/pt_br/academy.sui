	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Neste cenário, vamos ver como é dar ré pelo \"lado cego\" para estacionar em uma vaga. Sem a capacidade de olhar pela janela para ver para onde você está indo, você terá de confiar apenas nos retrovisores para chegar onde precisa ir."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Siga bem além da vaga para ter espaço para manobrar quando começar a dar ré."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Pare, verifique o entorno e então dê marcha à ré."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Vire o cavalo mecânico para a direção oposta. Isso moverá a frente do reboque para um lado e apontará a traseira do reboque em direção à vaga. Cuidado para não exagerar e provocar um entesouramento."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Conforme o reboque entra na vaga, comece a endireitar o caminhão."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Pare na área indicada e acione o freio de estacionamento."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Manobrar de ré pelo \"lado cego\" requer os mesmos procedimentos que dar ré pelo lado do motorista, mas você estará em desvantagem devido à falta de visibilidade. Use os retrovisores e sua intuição para estacionar o caminhão.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Há uma vaga à frente e do lado do passageiro. Você vai precisar passar bem além dela para ter espaço para manobrar ao dar ré.<br><br><font face=/font/big_bold.font>Dirija para a frente.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Lembre-se, ao virar o caminhão para longe da vaga, o reboque se moverá em direção a ela. Use os retrovisores o máximo possível para ajudar a entrar na vaga.<br><br><font face=/font/big_bold.font>Comece a dar ré.</font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Dirigindo em uma rotatória"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Neste cenário, vamos ver como contornar uma rotatória.<br><br>Você terá de prestar atenção especial ao seu reboque, pois ele estará seguindo você de forma diferente quando você entrar, passar por ela e quando sair."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entrando na rotatória"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Dirigindo pela rotatória"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Dirigindo pela rotatória"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Saindo da rotatória"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Dirigindo para a área indicada"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Rotatórias são muito comuns nas estradas da Europa, por isso é importante saber como contorná-las."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Fique na parte de fora da sua faixa ao se aproximar da rotatória. Isso vai ajudar o reboque a passar pelo lado de dentro da curva inicial."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Dirija em direção a rotatória. Uma vez lá dentro, você terá de ir em direção à parte de fora. Isso é para manter seu reboque a uma distância segura do centro da rotatória."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Fique de olho no retrovisor para garantir que o reboque não esteja chegando muito perto das guias internas."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Sair da rotatória é bem fácil, já que seu reboque está numa boa posição. Dirija até a saída e o reboque deve seguir sem percalços."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Estacione o caminhão na área indicada e acione o freio de estacionamento."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "À sua frente, há uma rotatória preparada para você dirigir.<br><br><font face=/font/big_bold.font> Aproxime-se lentamente da rotatória. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Faça uma curva aberta ao entrar na rotatória para que seu reboque entre atrás de você sem problemas.<br><br><font face=/font/big_bold.font> Entre na rotatória. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Dirija em direção à parte de fora da rotatória. Você vai precisar manter o caminhão o mais longe possível do centro da rotatória para que o reboque não atinja as barreiras centrais. <br><br><font face=/font/big_bold.font>Continue pela rotatória.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Fique perto dos cones externos. <br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Saia da rotatória.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Siga para a vaga à frente.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Pare na área indicada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Acione o freio de estacionamento e desligue o motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manobrando em um espaço apertado"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Para o cenário final, você terá de virar o caminhão em um espaço apertado. Isso vai exigir que você dê ré pelo \"lado cego\" em uma área com espaço limitado para manobrar, o que requer atenção ao seu entorno e uso inteligente do espaço."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Dirigindo até o circuito"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Preparando-se para uma manobra no \"lado cego\""

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Dando ré na vaga de estacionamento"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Finalizando a manobra no \"lado cego\""

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Saindo do circuito"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Neste cenário, vamos ver como fazer a volta em um espaço apertado com uma manobra de ré pelo \"lado cego\". Essa habilidade vai ser útil quando você não puder fazer uma conversão em U ou dar ré pelo lado do motorista."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "As marcações na via vão ajudar você a percorrer o circuito de treinamento."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Faça uma curva aberta para que seu reboque fique longe dos caminhões estacionados."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Ao sair da curva, pense em como você vai preparar o caminhão para a manobra de ré."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Posicionar o caminhão em um ângulo apontado para a vaga de estacionamento vazia ao lado do passageiro ajudará na manobra de ré."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Dar ré pelo \"lado cego\" deve ser evitado sempre que possível, pois há significativamente menos visibilidade. Infelizmente, nem sempre você terá uma escolha."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Gire o volante antes de dar marcha à ré. Isso vai ajudar a direcionar o reboque para onde você quer imediatamente, o que é útil em situações bem apertadas."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Quando o reboque estiver bem posicionado, posicione o cavalo mecânico na frente do reboque e o endireite."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Pare assim que endireitar o caminhão e tiver espaço suficiente para avançar novamente. Comece a retornar pelo mesmo caminho por onde entrou."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Siga as marcações da via ao sair do circuito de treinamento."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Faça a curva à frente e prossiga para a área indicada."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Parando."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Acione o freio de estacionamento e desligue o motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Na área à sua frente, há um percurso de treinamento representando o pátio de uma empresa de transporte. Sua tarefa é entrar lá, manobrar o caminhão e sair. Faça bom uso do espaço ao seu redor.<br><br><font face=/font/big_bold.font>Prepare-se para partir</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Prossiga para o circuito de treinamento.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Vire a esquina e continue o circuito. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Siga as marcações da via até a barreira no final do circuito. Estacione com um pouco de ângulo para que seu reboque fique apontado para a vaga vazia do lado do passageiro.<br><br><font face=/font/big_bold.font>Continue em frente. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Sua visão do que está acontecendo ao redor é muito mais limitada quando você manobra pelo \"lado cego\". Vá devagar, use os retrovisores e tenha cautela.<br><br><font face=/font/big_bold.font>Comece a dar ré e vire o reboque em direção a vaga vazia.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Isso já é o suficiente. Agora você pode prosseguir e sair do campo de treinamento pela mesma direção de onde veio.<br><br><font face=/font/big_bold.font>Dirija-se à saída.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Saia do circuito de treinamento. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Siga as marcações da via até a vaga final.<br><br><font face=/font/big_bold.font>Prossiga até a área indicada.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manobra de ré deslocada"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Neste cenário, sua tarefa será dar marcha à ré em uma vaga de estacionamento que não esteja diretamente atrás de você. Há espaço limitado para manobrar, então você deve usar seu espaço com sabedoria."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Neste cenário, sua tarefa será estacionar na vaga ao seu lado. Não há muito espaço para manobrar, então você terá trabalho extra para posicionar o reboque onde quer."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Dirija em direção à barreira."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Pare antes da barreira."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Gire o volante energicamente para o lado do motorista antes de se mover. Dessa forma, você começará a virar o reboque em direção ao local de estacionamento assim que começar a dar ré, economizando espaço valioso."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Após apontar o reboque para onde você quer, alinhe o cavalo mecânico na frente do reboque e comece a entrar na vaga."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Deste ponto em diante, não é muito diferente de uma manobra de estacionamento normal."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continue dando marcha à ré e observe ambos os lados. Mantenha o cavalo mecânico e o reboque alinhados com a vaga de estacionamento."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Pare na área indicada, acione o freio de estacionamento e desligue o motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Você está em uma vaga de estacionamento, mas há uma segunda vaga à sua direita para a qual você deve se deslocar.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Há uma área marcada à sua frente.<br><br><font face=/font/big_bold.font>Avance.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Não se esqueça de virar o volante imediatamente, pois o espaço é limitado.<br><br><font face=/font/big_bold.font>Dê marcha à ré no local indicado atrás de você. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Dirigindo por curvas simples"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Neste cenário, você vai fazer um breve passeio em um circuito de treinamento para aprender a manobrar o reboque em curvas simples de 90 graus."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Fazendo a primeira curva"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Segunda curva"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Curva final"
#!{
	key[]: "aca_goal_book1_3_15_check5"
