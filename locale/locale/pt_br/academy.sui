#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Dirigindo por curvas complexas"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Neste cenário, vamos manobrar um reboque por um circuito de obstáculos curto com curvas mais complexas."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primeiras curvas"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Dirigindo por uma passagem estreita"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Curva fechada de 90 graus"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Contornando as barreiras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "À frente, há uma variedade de curvas e obstáculos complexos.<br>Considere tudo o que você aprendeu até agora e não deverá ser muito difícil."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "As marcações na estrada podem dar uma ideia de como prosseguir por cada conjunto de obstáculos."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Mantenha o cavalo mecânico na parte de fora da curva. <br>Você precisará abrir na curva, pois o reboque seguirá um caminho mais curto."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "A próxima é uma curva fácil de 90 graus. <br> Mais uma vez, mantenha o caminhão na parte de fora da curva e use todo o espaço disponível."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Não tenha pressa aqui. O circuito se abre, mas você ainda precisará dirigir de forma precisa."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Mantenha uma boa distância das barreiras."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Tenha cuidado ao entrar nesta seção estreita. <br>Abra bem com o cavalo mecânico antes de virar para posicionar o reboque corretamente na trajetória."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "A última curva de 90 graus é muito mais acentuada do que a primeira, mas há bastante espaço se você usar o espaço de forma inteligente."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Pare na área indicada, então acione o freio de estacionamento e desligue o motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Lembre-se de usar as marcações na via como ajuda para percorrer o circuito.<br><br><font face=/font/big_bold.font>Prepare-se para partir. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Usar os retrovisores também ajudará a navegar o circuito com segurança. Você precisa ter atenção constante em como o reboque está seguindo atrás de você.<br><br><font face=/font/big_bold.font>Prossiga para primeira curva.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Observe o reboque ao sair da curva e prepare-se para entrar na próxima. <br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Prossiga para a próxima curva.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Observe o seu reboque para confirmar que ele está livre de obstáculos ao redor dele antes de virar com o caminhão.<br><br><font face=/font/big_bold.font>Continue contornando a barreira de obstáculos à frente.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Quando o seu reboque passar da barreira, vire acentuadamente para o lado do passageiro para se alinhar à passagem estreita. <br><br><font face=/font/big_bold.font>Prossiga em direção à passagem estreita.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Esta seção vai exigir uma direção mais precisa. Não tenha pressa e use os retrovisores.<br><br><font face=/font/big_bold.font>Fique mais na parte de fora de cada curva.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Esta curva é bem fechada, mas você pode usar todo o espaço à sua frente para passá-la com facilidade. <br><br><font face=/font/big_bold.font>Faça a última curva.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Curso de formação avançado - Reboque"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "No cenário final do Capítulo 3, vamos fazer um circuito de treinamento mais longo com uma variedade de curvas diferentes para ver o quanto você aprendeu a manobrar com o reboque."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Curva em Z"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVER ESTE OBJETIVO"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Cruzando o canteiro central"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Primeiro slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Segundo slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Curvas fáceis"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rotatória"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Trecho em linha reta"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Curva fechada"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Curvas finais"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Dirigindo até a vaga"
