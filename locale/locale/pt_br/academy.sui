#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Neste cenário, sua tarefa será estacionar na vaga ao seu lado. Não há muito espaço para manobrar, então você terá trabalho extra para posicionar o reboque onde deseja."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Dirija em direção à barreira."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Pare antes da barreira."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Gire o volante energicamente para o lado do motorista antes de se mover. Dessa forma, você começará a virar o reboque em direção ao local de estacionamento assim que começar a dar ré, economizando espaço valioso."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Após apontar o reboque para onde você quer, coloque o cavalo mecânico alinhado ao reboque e comece a conduzi-lo para a vaga de estacionamento."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Deste ponto em diante, não é muito diferente de uma manobra de estacionamento normal."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continue dando marcha ré e observe ambos os lados. Mantenha o cavalo mecânico e o reboque alinhados com a vaga de estacionamento."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Pare na área indicada, estacione o caminhão com segurança e desligue o motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Você está em uma vaga de estacionamento, mas há uma segunda vaga à sua direita para a qual você deve se deslocar.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Há uma área marcada à sua frente.<br><br><font face=/font/big_bold.font>Siga em frente.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Não se esqueça de virar o volante assim que possível, pois o espaço é limitado.<br><br><font face=/font/big_bold.font>Dê marcha ré no local indicado atrás de você. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Dirigindo por curvas simples"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Neste cenário, você fará um breve passeio em um curso de treinamento que o ajudará a aprender a manobrar o reboque em curvas simples de 90 graus."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Fazendo a primeira curva"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Segunda curva"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Curva final"
