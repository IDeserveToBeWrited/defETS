	val[]: "Freando com um reboque"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "Neste cenário, você terá uma ideia de como dirigir e frear com um reboque engatado."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Partindo"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Descendo uma ladeira"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Atingindo uma velocidade de 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Aplicando os freios"
