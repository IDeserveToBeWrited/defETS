	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Ponto de navegação alcançado"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Prossiga pelo cenário."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Vaga de estacionamento"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Para finalizar o cenário, acione o freio de estacionamento e desligue o motor.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Você está no lugar certo, mas na direção errada.<br><br><font face=/font/big_bold.font>Vire o caminhão antes de completar o cenário.</font>"
