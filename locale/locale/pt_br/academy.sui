#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Estacionar em paralelo é uma habilidade crucial que todo caminhoneiro deve saber.<br>Prepare-se para partir."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Dirija em direção ao local de estacionamento.<br>Preste atenção nos seus arredores."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Alinhe-se com o caminhão à frente da sua vaga de estacionamento. Não fique muito perto dele, mantenha uma certa distância para ter espaço para manobrar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Vire rapidamente em direção a vaga e comece a dar ré."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Ao olhar pelo retrovisor do lado do motorista, mire no meio-fio logo à frente do caminhão atrás de você."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Assim que o para-choque dianteiro passar pelo caminhão à sua frente, você pode começar a girar a frente do caminhão em direção à vaga, alinhando o veículo com a vaga de estacionamento."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Endireite o volante e centralize o caminhão na vaga de estacionamento.<br>Estacione o caminhão com segurança."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "À sua frente há alguns caminhões estacionados. Ainda há uma vaga disponível para você estacionar. <br><br><font face=/font/big_bold.font>Prepare-se para partir. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Lembre-se de estar atento ao que acontece ao seu redor. Faça bom uso dos seus retrovisores durante esta manobra. <br><br><font face=/font/big_bold.font>Dirija para frente. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Passe pelo local de estacionamento e entre na área demarcada. A partir daí você pode começar sua manobra de ré.<br><br><font face=/font/big_bold.font>Pare no local marcado. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Verifique se há obstáculos ao redor e certifique-se de que você tem espaço para dar ré.<br><br><font face=/font/big_bold.font>Olhe pelo espelho do lado do passageiro. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Manobre e dê ré para entrar na vaga de estacionamento.<br><br><font face=/font/big_bold.font>Comece a dar ré.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Comece a endireitar o caminhão quando for possível. Não passe por cima do meio-fio!<br><br><font face=/font/big_bold.font>Alinhe o caminhão com a vaga. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

