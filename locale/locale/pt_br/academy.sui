	key[]: "aca_msg_book3_train_check8"
	val[]: "Siga para a esquerda e atravesse as interseções em linha reta."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Siga pelo asfalto para a direita."

	key[]: "aca_msg_book3_train_check10"
