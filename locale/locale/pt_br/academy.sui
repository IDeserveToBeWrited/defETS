#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Controles de câmera"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Neste cenário, vamos aprender sobre os vários tipos de câmeras disponíveis e como elas podem ajudar a controlar e manobrar o caminhão."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Posição do assento"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Visão traseira"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Verificação dos retrovisores"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Mudar para a câmera externa"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Olhar ao redor do caminhão"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Neste cenário, alternaremos entre as diferentes câmeras<br>disponíveis."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Existem sete câmeras para escolher no total, vamos passar por<br> algumas delas agora e explicar suas funções."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "As várias câmeras e seus diferentes ângulos podem ajudar você a manobrar em lugares apertados."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Olhar para onde está indo é fundamental para uma condução segura e profissional. Se a posição atual do assento não for adequada, ajuste-a em '@@adjust_link_t@@' (Acesse pelo menu de pausa).<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_activate@@ para começar.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Ao dar ré, os espelhos retrovisores nem sempre oferecem uma visão clara. Pode ser necessário olhar pela janela para ter uma melhor visão.<br><br><font face=/font/big_bold.font>Vire a câmera completamente para o lado do motorista para olhar pela janela em direção à parte traseira do reboque.</font>@@aca_goal_tip@@ Você precisa estar dentro do veículo."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Use esta visão para verificar o reboque durante manobras de ré. Sempre é melhor dar ré pelo lado do motorista para poder utilizar esta visão. Ao dar ré pelo lado do passageiro, a visão do que está acontecendo atrás fica muito mais limitada.<br><br><font face=/font/big_bold.font>Olhe para o lado do passageiro.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "É por isso que geralmente não é recomendado dar ré para o lado do passageiro; como você pode ver, a visibilidade é bastante limitada. Felizmente, há sete câmeras externas disponíveis.<br><br>O botão @@imv_nrm_camcycle@@ pode ser usado para alternar para a próxima câmera em sequência. Após passar por todas as sete câmeras, você voltará ao início do ciclo.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_camcycle@@ para alternar para a próxima câmera. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "A câmera externa oferece a melhor perspectiva do que está acontecendo ao redor do caminhão.<br><br><font face=/font/big_bold.font>Olhe ao redor do caminhão.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Pressione @@imv_nrm_camcycle@@ novamente para alternar para a próxima câmera. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "A visão de cima para baixo oferece uma excelente perspectiva geral da situação ao redor do caminhão, facilitando bastante o estacionamento e a condução em espaços apertados.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_camcycle@@ para alternar para a próxima câmera. </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "A câmera do teto proporciona uma visão clara da via à frente do caminhão, sem muitas obstruções.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_camcycle@@ para alternar para a última câmera que vamos ver por enquanto. </font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "A visão traseira é um atalho para a visão que você obteve anteriormente ao girar a câmera interna. Como mencionamos, ela é útil ao dar ré ou estacionar.<br><br>No jogo, temos outras câmeras que você pode testar pressionando @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_cam1@@ para voltar à câmera interna.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Para uma experiência autêntica de autoescola, recomendamos que você mantenha a visualização da \"Câmera Interna\" ao realizar cada um dos cenários.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_activate@@ para confirmar e encerrar o cenário.</font>@@aca_goal_tip@@ Você pode usar o recurso @@o_im_cam_zoom@@ para uma melhor visualização do ambiente ao seu redor. É especialmente útil ao olhar pelos espelhos. Verifique a menu de Opções - '@@options_bindings_screen@@' - para visualizar e/ou alterar os controles correspondentes."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Primeira direção"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Neste cenário, vamos aprender como preparar o caminhão e, em seguida, dirigir para a frente pela primeira vez."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Ligando a ignição"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Ligando o motor"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Verificando os arredores"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Acionando o freio de serviço"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Engatando a marcha"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Liberando o freio de estacionamento"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Dirigindo para a frente"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Parando"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Acionando o freio de estacionamento"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Mudando para neutro"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Desligando o motor"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Para suas primeiras viagens, usaremos apenas o cavalo mecânico.<br>Um caminhão é chamado de cavalo mecânico ou cavalinho quando não possui uma carroceria própria e, em vez disso, depende do uso de um reboque para transportar mercadorias e materiais."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Os cavalos mecânicos são comuns pela sua maior versatilidade, pois podem deixar um reboque vazio e pegar um carregado sem precisar esperar, ou até mesmo alternar entre tipos diferentes de reboques."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Para a primeira condução, sua tarefa será avançar e parar após a linha tracejada.<br>Ligue o motor e siga as instruções para deixar o caminhão pronto para se deslocar. Uma vez preparado, dirija em linha reta."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Dirija além da linha tracejada, pare, desligue o motor e acione o freio de estacionamento."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Para a próxima etapa do seu treinamento, você vai dirigir o caminhão pela primeira vez.<br><br>É claro que isso só será possível com o motor funcionando, então primeiro você precisa ligar a ignição.<br><br><font face=/font/big_bold.font>Pressione $input engineelect$ para ligar a ignição.</font>@@aca_goal_tip@@ No Modo Carreira, o motor é ligado automaticamente junto com a ignição por padrão. Para o Modo Carreira, você pode ajustar esse comportamento em Menu de Opções - 'Jogo' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "A ignição ativa a eletrônica do caminhão. Você deve ter visto as luzes de aviso piscando no painel - isso é normal. Se elas permanecerem acesas após o motor ser ligado, pode haver um problema com o caminhão. A exceção é a luz do freio de estacionamento, que se apaga quando ele é liberado.<br><br>Felizmente, este caminhão está em boas condições e estamos prontos para prosseguir.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_engine@@ para dar partida no motor.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Agora que o motor está ligado, é crucial verificar seus arredores antes de iniciar qualquer movimento.<br><br><font face=/font/big_bold.font>Olhe ao redor do caminhão e nos espelhos retrovisores laterais do motorista e do passageiro para confirmar que a área ao redor do caminhão está livre.</font>@@aca_goal_tip@@ Você precisa estar na câmera interna."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Pode parecer óbvio, mas você deve saber como parar antes de iniciar qualquer movimento.<br><br><font face=/font/big_bold.font> Acione o freio de serviço pressionando $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Em seguida, você vai aprender como mudar o sentido de deslocamento.<br><br>Com uma transmissão automática simplificada, não há necessidade de passar marchas, tudo é feito automaticamente para você.<font face=/font/big_bold.font><br><br>Use $input forward$ para ativar uma marcha de avanço. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Em seguida, você vai aprender como mudar o sentido de deslocamento.<br><br>A transmissão automática realista permite que você mude entre Drive, Neutral e Reverse, assim como em transmissões automáticas reais.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_gearup@@ para ativar uma marcha para a frente. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Em seguida, você vai aprender como mudar o sentido de deslocamento.<br><br>A transmissão sequencial permite mudanças de marcha em etapas, assim como em transmissões sequenciais reais.<br><br>Da mesma forma que você engata uma marcha para a frente, ao acelerar, será necessário mudar para marchas mais altas.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_gearup@@ para engatar a primeira marcha.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Em seguida, você vai aprender como mudar o sentido de deslocamento.<br><br>Com a alavanca de câmbio e o pedal de embreagem, você terá a mesma sensação de mudar as marchas fisicamente, como em uma transmissão manual real.<br><br>Pressione o pedal de embreagem e o freio de serviço até o fim. <font face=/font/big_bold.font>Use a alavanca de câmbio para engatar a primeira marcha. <color value=@@clr_txt@@>Mantenha a embreagem e o freio de serviço totalmente pressionados.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Para começar a se mover, primeiro você precisa soltar o freio de estacionamento.<br><br><font face=/font/big_bold.font>Use @@imv_nrm_parkingbrake@@ para liberar o freio de estacionamento.</font> @@aca_goal_tip@@ No Modo Carreira, o freio de estacionamento vem inicialmente desativado. Você pode ajustar esse comportamento em Menu de Opções - 'Jogo' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Agora o caminhão está pronto para se mover para a frente. Comece a se mover e cruze a linha tracejada.<br><br><font face=/font/big_bold.font>Inicie o movimento usando o acelerador: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Agora o caminhão está pronto para se mover para a frente. Comece a se mover e cruze a linha tracejada.<br><br><font face=/font/big_bold.font>Inicie o movimento usando o acelerador: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Agora o caminhão está pronto para se mover para a frente. Comece a se mover e cruze a linha tracejada.<br><br><font face=/font/big_bold.font>Inicie o movimento usando o acelerador: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Agora o caminhão está pronto para se mover para a frente. Comece a se mover e cruze a linha tracejada.<br><br><font face=/font/big_bold.font>Tire o pé do freio de serviço, solte gradualmente a embreagem para acioná-la enquanto usa o acelerador para manter o RPM, evitando que o caminhão morra. Assim que a embreagem estiver totalmente liberada, você pode acelerar e trocar de marcha conforme necessário.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Use o freio de serviço para parar.<br><br><font face=/font/big_bold.font>Use $input backward$ para parar o caminhão.</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Use o freio de serviço para parar.<br><br><font face=/font/big_bold.font>Use $input backward$ para parar o caminhão.</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Use o freio de serviço para parar.<br><br><font face=/font/big_bold.font>Use $input backward$ para parar o caminhão.</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Quando for hora de parar, pressione a embreagem até o fim <font face=/font/big_bold.font>e pare o caminhão usando o freio de serviço.<color value=@@clr_txt@@> Mude para neutro usando a alavanca de marcha para poder soltar a embreagem.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Agora, acione o freio de estacionamento para que o caminhão não se mova acidentalmente após estacionado.<br><br><font face=/font/big_bold.font>Use @@imv_nrm_parkingbrake@@ para acionar o freio de estacionamento.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Com uma transmissão automática simplificada, não há necessidade de trocar de marcha, tudo é feito automaticamente para você.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_activate@@ para confirmar.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Troque para neutro pressionando @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Troque para neutro pressionando @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Coloque a alavanca de câmbio em neutro e depois solte o pedal da embreagem.</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Agora você sabe como fazer o caminhão se mover e como pará-lo com segurança.<br><br><font face=/font/big_bold.font>Pressione $input engineelect$ para desligar o motor. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Dando marcha à ré"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Neste cenário, vamos tentar dar ré pela primeira vez. Também vamos falar sobre como usar os retrovisores para ver o que está atrás e como se preparar para essa manobra."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Ligando o motor"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Verificando o retrovisor do lado do passageiro"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Verificando o retrovisor do lado do motorista"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Engatando a marcha"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Liberando o freio de estacionamento"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Mudando para neutro"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Desligando o motor"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Agora, vamos fazer essa ré em linha reta até passar da linha tracejada e então parar."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Ao dar ré com o caminhão, é essencial olhar ao redor sempre, checar todos os retrovisores e confirmar que o espaço ao seu redor e atrás de você está livre."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Ligue o motor, engate a ré e comece a se deslocar."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Dê ré até passar da linha tracejada, então pare, desligue o motor e acione o freio de estacionamento."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Prepare o caminhão como você aprendeu no cenário anterior.<br><br><font face=/font/big_bold.font>Quando estiver pronto, ligue o motor.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Verifique os retrovisores para garantir que a área ao seu redor está livre. Se a posição deles não estiver satisfatória, você pode ajustá-los em '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Olhe para os retrovisores do lado do passageiro.</font>@@aca_goal_tip@@ Para isso, você precisa estar dentro do veículo."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Você vai passar pela linha tracejada. A pista está livre agora, mas durante a condução normal, é essencial monitorar constantemente seus arredores usando os espelhos retrovisores.<br><br><font face=/font/big_bold.font>Verifique o espelho do lado do motorista.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Use $input backward$ para engatar a ré. </font>@@aca_goal_tip@@ Ao dar ré, o alarme de ré é ativado automaticamente na maioria dos caminhões. Você pode desativá-lo no Menu de Opções - 'Som' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Pressione @@imv_nrm_geardown@@ para engatar a ré. </font>@@aca_goal_tip@@ Ao dar ré, o alarme de ré é ativado automaticamente na maioria dos caminhões. Você pode desativá-lo na tela de Opções - 'Áudio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Pressione @@imv_nrm_geardown@@ para engatar a ré. </font>@@aca_goal_tip@@ Ao dar ré, o alarme de ré é ativado automaticamente na maioria dos caminhões. Você pode desativá-lo na tela de Opções - 'Áudio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Pressione o pedal de embreagem até o fim e coloque a alavanca de câmbio na marcha à ré. </font>@@aca_goal_tip@@ Ao dar ré, o alarme de ré é ativado automaticamente na maioria dos caminhões. Você pode desativá-lo na tela de Opções - 'Áudio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Você está com a ré engatada.<br><br><font face=/font/big_bold.font>Solte o freio de estacionamento usando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Comece a se mover usando $input backward$. <br><br><font face=/font/big_bold.font>Dê ré até passar da linha tracejada. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Inicie o deslocamento usando o acelerador: $input forward$.<br><br><font face=/font/big_bold.font>Dê ré até passar da linha tracejada.</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Inicie o deslocamento usando o acelerador: $input forward$.<br><br><font face=/font/big_bold.font>Dê ré até passar da linha tracejada.</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Solte a embreagem lentamente, mantendo a RPM com o acelerador. <br><br><font face=/font/big_bold.font>Dê ré até passar da linha tracejada. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Pare o caminhão usando o freio de serviço: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Pare o caminhão usando o freio de serviço: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Pare o caminhão usando o freio de serviço: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Pressione a embreagem até o fim e, em seguida, pare o caminhão usando os freios de serviço.</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Ative o freio de estacionamento usando @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Com uma transmissão automática simplificada, não há necessidade de mudar as marchas, pois tudo é feito automaticamente para você, diferentemente da vida real.<br><br><font face=/font/big_bold.font>Pressione @@imv_nrm_activate@@ para confirmar.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Engate o neutro pressionando @@imv_nrm_gearup@@.</font> @@aca_goal_tip@@ Caminhões modernos mudam automaticamente para o neutro quando o freio de estacionamento é acionado. No entanto, é um bom hábito sempre fazer isso você mesmo. Nos próximos cenários, essa etapa não será necessária."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Engate o neutro pressionando @@imv_nrm_gearup@@.</font> @@aca_goal_tip@@ Caminhões modernos mudam automaticamente para o neutro quando o freio de estacionamento é acionado. No entanto, é um bom hábito sempre fazer isso você mesmo. Nas próximas situações, não precisaremos dessa etapa."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Coloque a alavanca de câmbio em neutro e, em seguida, solte a embreagem.</font> @@aca_goal_tip@@ Caminhões modernos mudam automaticamente para o neutro quando o freio de estacionamento é acionado. No entanto, é um bom hábito sempre fazer isso você mesmo. Nas próximas situações, não precisaremos dessa etapa."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Lembre-se de estar sempre atento ao seu redor ao dar ré especialmente em áreas movimentadas com muito tráfego.<br><br><font face=/font/big_bold.font>Desligue o motor pressionando $input engineelect$. </font>"
#@}

