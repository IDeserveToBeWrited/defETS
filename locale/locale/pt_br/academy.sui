	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "À sua frente, há algumas curvas apertadas com pouco espaço. Elas ajudarão você a aprender a manobrar o reboque de forma eficaz."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Siga as marcações da estrada em direção à barreira do lado do motorista para se preparar para a primeira curva."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Fique perto da barreira externa durante a curva e o reboque deverá segui-lo tranquilamente pelo percurso."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Continue seguindo as marcações da estrada para se preparar para a segunda curva, uma curva fechada de 90 graus."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Você terá que dirigir até o final da curva para garantir que seu reboque passe pelas barreiras internas. Use o espelho frontal para ajudá-lo a ir o mais longe que puder na curva sem bater em nada."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continue ao longo da barreira externa."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Mais uma vez, outra curva apertada de 90 graus exigirá que você use todo o espaço disponível."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Pare no local indicado e estacione o caminhão com segurança."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Lembre-se de usar todo o espaço disponível para ajudá-lo a contornar cada curva.<br><br><font face=/font/big_bold.font>Saia e siga as marcações da estrada até o lado de fora.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Siga a barreira externa, mas fique de olho no seu reboque no espelho retrovisor.<br><br><font face=/font/big_bold.font>Faça a primeira curva. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Siga as marcações da estrada para se preparar para a curva de 90 graus à frente.<br><br><font face=/font/big_bold.font>Faça a curva de 90 graus. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Mantenha o caminhão mais aberto após a curva, pois você terá uma curva de 90 graus ainda mais apertada à frente.<br><br><font face=/font/big_bold.font>Continue dirigindo. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Prossiga até a vaga de estacionamento à frente. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
