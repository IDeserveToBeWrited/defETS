#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Dirigindo em uma pista de manobras"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Neste cenário, daremos uma volta em uma pista projetada para testar sua capacidade de manobrar o caminhão em diferentes tipos de curvas e esquinas."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entrando no percurso"

	key[]: "aca_goal_book1_2_08_check1"
