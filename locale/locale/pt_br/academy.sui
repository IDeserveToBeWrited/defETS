#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Estacionando próximo a um obstáculo"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "Neste cenário, vamos aprender a estacionar próximo ao meio-fio usando o retrovisor lateral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Verifique o retrovisor lateral"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Dirigindo em direção ao meio-fio"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "O retrovisor lateral é outra ferramenta que ajuda você a manobrar o caminhão com segurança. Ele fica localizado na parte de cima da porta do passageiro."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Dirija para a frente e vire lentamente para o lado do passageiro."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Essas tábuas de madeira representam um meio-fio. Você precisará estacionar próximo a elas. <br>Vire em direção ao meio-fio para colocar o caminhão em uma boa posição para alinhar com a vaga."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Diminua a velocidade antes do meio-fio e vire em direção à vaga. À medida que você se endireita, pode usar o retrovisor lateral para avaliar a distância em relação ao meio-fio."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Pare na vaga e acione o freio de estacionamento."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Olhe pela janela do lado do passageiro. Você pode ver o retrovisor lateral ali.</font>@@aca_goal_tip@@ Para isso, você precisa estar dentro do veículo."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "O retrovisor lateral cobre a área do lado do passageiro que o motorista não consegue ver. É um dos pontos cegos mais problemáticos do caminhão. Se o ângulo do retrovisor não estiver bom, você pode ajustá-lo em '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "O caminhão ainda não está pronto para sair, talvez você tenha esquecido de algo?<br><br>O motor está ligado? Você soltou o freio de estacionamento?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "À sua frente, há uma linha de tábuas representando um meio-fio. No final do meio-fio, há uma vaga. Você precisará dirigir até lá. <br><br><font face=/font/big_bold.font>Prossiga quando puder.</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Vire em direção ao meio-fio. Use os retrovisores frontal e laterais para checar sua posição em relação ao meio-fio, mas também tome cuidado para não passar por cima de algum cone de trânsito.<br><br><font face=/font/big_bold.font>Dirija em direção ao meio-fio e entre na vaga.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Acione o freio de estacionamento e desligue o motor.</font>@@aca_goal_tip@@ Você pode usar as predefinições de visão interna para facilitar a visualização dos retrovisores. Verifique o menu de Opções para ver e/ou alterar os controles correspondentes."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Estacionando de ré próximo a um obstáculo"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "Neste cenário, vamos estacionar o caminhão de ré em uma vaga próxima ao meio-fio."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instruções"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Dando ré em direção ao meio-fio"

