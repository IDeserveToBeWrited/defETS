#!}
#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "ESCOLHER O MODO DE MAPEAMENTO DE ENTRADA DO STEAM" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Apresentando o novo <color value=@@clr_sel@@>Modo de Mapeamento no Jogo<color value=@@clr_txt@@>, que oferece suporte total para configurações de teclas no jogo e melhores dicas de botões. Este é o modo recomendado.<br><br>Mantenha o <color value=@@clr_sel@@>Modo de Mapeamento do Cliente Steam<color value=@@clr_txt@@> se você personalizou o layout do seu controle através do Cliente Steam.<br><br>Você pode alterar o modo a qualquer momento nas opções usando o Assistente de Entrada." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Manter o modo do Cliente Steam" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Abrir Assistente de Entrada" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Modo de mapeamento de entrada do Steam" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Mapeamento no jogo" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Mapeamento pelo cliente Steam" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Seleciona o modo para controles, como @@controller_ps5@@, @@controller_xbox_one@@ ou @@controller_steam_deck@@, ativados na interface de entrada do Steam.<br>- \"Mapeamento pelo cliente Steam\": Usa layouts independentes configurados no cliente Steam. Suporte limitado para dicas de botões no jogo e sem configurações de mapeamento internas.<br>\"Mapeamento no jogo\": Usa um layout simples e universal. Suporta configurações completas de mapeamento de botões no jogo e melhores dicas de botões. Recomenda-se executar o Assistente de Entrada ao trocar para este modo (o preferido)."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Steam Controller"

	key[]: "controller_steam_deck"
	val[]: "Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Controle do Steam Input"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Sincronização com a Nuvem Steam:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Você está usando uma versão mais antiga do jogo.<br>O Steam vai atualizar automaticamente o jogo a menos que as atualizações automáticas estejam desativadas."
#@}

	key[]: "steam_demo"
	val[]: "Se você gostou da versão demonstrativa do Euro Truck Simulator 2, compre a versão completa na <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>!" #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 não pode acessar o cliente Steam. Passos sugeridos:\n\n1. Verifique se o cliente Steam está em execução.\n2. Verifique se você tem a versão mais recente do cliente Steam.\n3. Verifique se as atualizações automáticas estão ativadas e o jogo está atualizado para a versão mais recente."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Parte do conteúdo para download atualmente instalado não é compatível com a versão atual do jogo e será desativado. Verifique a integridade do cache do jogo no Steam.<br><br>O seguinte conteúdo é incompatível:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "Não é possível criar um perfil da Steam com o nome informado porque já existe um perfil da Steam com esse nome." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "Não foi possível migrar o perfil, outro perfil com este nome já existe." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Falha de migração do perfil." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Sincronização com a nuvem Steam" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "Sua Nuvem Steam possui espaço suficiente para seus arquivos de salvamento." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Você está ficando sem espaço na Nuvem Steam!<color value=@@clr_txt@@><br><br>Remova alguns arquivos de salvamento para prosseguir. Confira estas informações úteis:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Espaço excedido em: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Arquivos excedidos em: <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Espaço usado na Nuvem Steam: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Arquivos usados na Nuvem Steam: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "O jogo salvo <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> contém <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@> distribuídos em <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> arquivos." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Você ficou sem espaço no Steam Cloud. Remova alguns arquivos para prosseguir.<br><br>Consulte as informações detalhadas no painel à direita." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Ao migrar para o tipo de perfil local, este perfil ficará disponível apenas neste computador a partir de agora, independentemente da conta da Steam. " #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Falha na migração do perfil. Nenhum dado foi transferido e o sistema manteve o perfil original intacto. Tente novamente." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

