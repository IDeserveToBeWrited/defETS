#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Visão Estendida" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Predefinições de visão estendida" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Inserir nome da predefinição" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Confirma que quer excluir a predefinição selecionada?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "A predefinição existente com o mesmo nome será substituída. Quer continuar?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Ajustes do rastreio ocular" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Ajustes do rastreio da cabeça" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Controles do teclado" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Ativar visão estendida" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Ativar centralização automática" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Modo do rastreio da cabeça" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Direto" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinâmico" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Resposta da visão ocular" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Resposta da vista da cabeça" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Ativar rolagem" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Ativar posição" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Multiplicador de rotação horizontal (na cabine)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Multiplicador de inclinação (na cabine)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Multiplicador de rotação horizontal (no modo caminhada)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Multiplicador da rotação vertical (no modo caminhada)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Ângulo de visão máximo" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
