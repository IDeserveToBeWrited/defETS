	key[]: "missing_deps_rdlc_cont"
	val[]: "Você quer continuar assim mesmo?<br>Algumas funcionalidades podem ser perdidas!" #+ missing dlc warning if the save depends only on functionality from removable DLCs (e.g. paintjob)

