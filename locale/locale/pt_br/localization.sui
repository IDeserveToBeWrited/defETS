#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Permite selecionar o tema de fundo exibido ao navegar pelo menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Permite a seleção aleatória de um tema de fundo sempre que você inicia o jogo."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Define o atraso até que os elementos do menu desapareçam."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, você sentirá os efeitos da fadiga ao longo do tempo.<br><br>Não descansar resultará em infrações de trânsito."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, você deve obedecer às regras de trânsito ou corre o risco de levar multa, que aumenta perto de veículos policiais, radares e câmeras de trânsito."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta a distância média dos trabalhos oferecidos."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecione qual o limite de velocidade será exibido no widget do navegador."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "A velocidade atual no navegador muda para vermelho quando o limite da via é excedido."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando você chegar ao seu destino, um widget será exibido permitindo que você ignore o estacionamento."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantém todos os widgets escondidos."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantém ambos retrovisores virtuais escondidos."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Mantém todas as notificações ocultas, mesmo quando forem recebidas."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Exibe uma janela mostrando as capacidades do caminhão atual do jogador antes de aceitar um trabalho de carga pesada."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Escolha como o mapa é alinhado."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Escolha como o mapa-múndi será explorado:<br>- \"Descoberta por aproximação\" marca uma área maior como explorada.<br>- \"Descoberta precisa\" revela apenas as áreas imediatamente ao redor do jogador."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecione como a navegação deve ser exibida"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a forma como a navegação é roteada:<br>- O modo de navegação \"Melhor\" escolhe a proporção mais eficiente entre comprimento e tempo da rota, tentando evitar cruzamentos com semáforos, etc.<br>- O modo de navegação \"Mais curto\" escolhe sempre a rota mais curta possível.<br>- O modo de navegação \"Estradas menores\" evita rodovias sempre que possível."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a dificuldade do estacionamento:<br>- - \"Sempre escolher\" permitirá que você escolha quando chegar ao seu destino.<br>- \"Estacionar com segurança\" não vai exigir manobras de ré.<br>- - \"Estacionar com habilidade\" geralmente exigirá uma manobra de ré mais desafiadora."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta a probabilidade de encontrar perigos na estrada e nas suas proximidades, incluindo acidentes, veículos danificados, detritos, entre outros."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta a probabilidade de se deparar com um desvio que obriga mudar de rota durante a entrega de uma carga."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Ajusta a probabilidade de ocorrer chuvas e temporais."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Escolha se as informações de fuso horário serão exibidas além da hora atual."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Ativa ou desativa cenas normalmente exibidas após comprar um caminhão, melhorar uma garagem ou durante o embarque de passageiros."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Escolha se bloqueios semitranslúcidos são exibidos em vias inacessíveis."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inverte o eixo Y do mouse ao controlar a câmera do jogo."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleciona o tipo de transmissão.<br>- \"Automática simples\" permite o uso do acelerador para andar para a frente e passar marchas e do freio para freio e andar de ré.<br>- \"Automática real\" requer uma entrada para alternar entre marchas de avanço e de ré.<br>- \"Sequencial\" requer mudança manual de todas as marchas com entradas de subida/descida de marcha.<br>- \"H-Shifter\" requer o uso de um controle com portas de mudança para selecionar as marchas manualmente."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativar esse recurso permitirá \"pular marchas\", quando necessário ou prático, para não precisar passar todas as marchas na transmissão."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Retorna o volante de volta ao centro quando um teclado ou controle é usado.<br><br>Quando desativado, você precisará voltar o volante manualmente ao centro após uma curva."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta o alcance da animação do volante."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a intensidade dos freios."

	key[]: "vehicle_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a estabilidade do veículo abaixando seu centro de gravidade."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a estabilidade do reboque abaixando seu centro de gravidade."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a intensidade do torque gerado pela transmissão.<br><br>Aumentar esta configuração produzi a sensação de caminhão \"torcendo\" para a direita."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a rigidez da suspensão do chassi."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a rigidez da suspensão da cabine."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajusta a intensidade das irregularidades de superfície geradas processualmente para dar às estradas e a outros terrenos uma sensação de imperfeição.<br><br>Dependendo de como as configurações de suspensão e câmera são definidas, o efeito percebido pode ser mais ou menos acentuado."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativa o engate avançado, exigindo maior precisão para alinhar a quinta roda do caminhão com o pino mestre do reboque.<br><br>Quando desativado, o engate de um reboque se torna muito mais fácil, pois não há colisão entre o pino mestre e a quinta roda."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Selecione se, e quais, cabos de reboques serão animados.<br><br><color value=@@clr_txt_d@@>Permitir a animação de cabos em mais veículos pode afetar o desempenho em sistemas mais antigos."

	key[]: "vehicle_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Ativa o limitador eletrônico de velocidade do veículo em um valor que depende do modelo.<br><br><color value=@@clr_txt_d@@>Os trabalhos do World of Trucks têm essa função ativada de forma permanente."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado e os limpadores de para-brisa estiverem acionados na primeira posição, eles serão ativados automaticamente e ajustarão a velocidade conforme as condições climáticas."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite o acionamento automático do retarder ao frear."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o assistente de partida em aclive do veículo acionará os freios, garantindo uma saída suave."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite o acionamento automático do freio motor ao frear."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o motor dará partida assim que o acelerador for pressionado."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o freio de estacionamento do veículo é acionado por padrão, como, por exemplo, após usar uma balsa, ser rebocado até uma oficina, realizar uma viagem rápida, etc."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Abaixa automaticamente os eixos eleváveis quando necessário, dependendo do peso do veículo."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo manterá a aceleração em baixa rotação por padrão. Após pressionar rapidamente o botão do acelerador duas vezes, o veículo manterá a aceleração em rotação máxima até o botão do acelerador ser solto.<br><br>Afeta apenas a entrada do teclado."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simula a perda de ar do compressor pelo pressionamento dos freios de forma excessiva.<br><br>Quando ativado, você deve gerenciar a pressão do ar em declives ou ao realizar manobras lentas que requerem muitos acionamentos do freio."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando desativado, o consumo de combustível não é afetado pela forma de condução ou pelas condições da estrada.<br><br>Quando ativado, o consumo é afetado por vários fatores, incluindo o modo como você dirige, o peso da carga, a resistência ao rolamento e o terreno. Não é mais afetado pela habilidade @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o sistema de freio antibloqueio (ABS) evitará o travamento das rodas para manter o controle e melhorar a capacidade de frenagem."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo aplica o freio em rodas independentes para evitar patinagem e saídas de frente e traseira, ajudando a manter o controle."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o veículo bloqueia o diferencial automaticamente se as rodas começam a patinar, melhorando a tração."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera o incremento de velocidade que aumentará ou diminuirá o controle de cruzeiro quando a tecla atribuída for pressionada."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a tolerância do controle de cruzeiro para manter a velocidade alvo."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, o controle de cruzeiro ajusta automaticamente a velocidade para manter uma distância segura do veículo à frente."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativa o freio de emergência se o sistema detectar uma colisão iminente.<br>Escolha se o sistema reagirá apenas a veículos ou a todos os obstáculos."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Seleção de modos do assistente de faixa.<br>- O modo \"Aviso de saída de faixa\" emite um aviso sonoro quando você está prestes a sair da faixa.<br>Além do aviso, o \"Assistente de permanência em faixa\" também esterça automaticamente o volante para que o veículo não saia da faixa.<br><br>Ambos os modos só são ativados em velocidades superiores a 55 km/h (~35 mph).<br>O assistente de faixa também considera o uso das luzes de seta antes de atuar."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativa as funções do sensor de ponto cego caso o seu veículo esteja equipado com um."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado e os faróis estiverem na primeira posição, o farol baixo acenderá automaticamente sob pouca luminosidade."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado e os faróis são acionados com os faróis altos, o sistema diminui automaticamente os faróis altos ao detectar um veículo em sentido contrário ou à frente."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, as setas são desligadas automaticamente quando o volante retorna ao centro após uma curva."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, alguns acessórios de interior reagem ao movimento físico do veículo (enfeites pendurados, bonecos etc.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Ativa a rotação horizontal na câmera interna com base na operação do volante."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a reatividade do recurso \"Rotação da câmera interna baseada no volante\" ao virar o volante."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera o comportamento da função \"Rotação da câmera interna baseada no volante\" ao andar de ré."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, a câmera interna virará para a esquerda ou com base na luz de seta."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, a câmera interna reage ao movimento do veículo."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Quando ativado, a câmera interna reage ao movimento do veículo."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera a quantidade de rolagem da câmera interna com base no movimento do veículo."

	key[]: "cam_fov_speed_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Altera quanto o campo de visão da câmera interna varia com a velocidade de deslocamento do veículo."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Define o atraso antes que a câmera seja recentralizada automaticamente.<br><br>O veículo deve estar se movendo a uma velocidade não negligenciável para que isso seja ativado. Aplica-se apenas à câmera interna e a cinematográfica enquanto o veículo está em movimento para a frente e à câmera de inclinação enquanto o veículo está em marcha à ré."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Define a velocidade do movimento da câmera. Usada para centralização automática da câmera e troca entre predefinições da câmera interna."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determina como o zoom interno funciona: segure o botão para aplicar zoom temporariamente ou pressione uma vez para alternar." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Seleciona o idioma de exibição do jogo."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Altera as predefinições de moeda e unidades com base na região selecionada."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, os nomes de cidades e países são exibidos no idioma selecionado."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, os nomes de cidades e países são exibidos no mapa tanto no idioma selecionado quanto no idioma nativo daquela região."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Escolha qual moeda usar."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Define a notação de tempo entre 12 ou 24 horas."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Define a unidade de comprimento exibida."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Define a unidade de peso exibida."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Define a unidade de temperatura exibida."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolha quais unidades de pressão são exibidas."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Define a unidade de volume exibida."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Escolha quais unidades de consumo são exibidas."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, pressionar a tecla de ativação, que por padrão é o @@imv_nrm_activate@@, abrirá o bate-papo durante as sessões de comboio."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, a barra de entrada de chat permanecerá ativa após o envio de uma mensagem."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Quando ativado, as mensagens do bate-papo desaparecem alguns segundos após cada envio."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Altera quanto tempo as mensagens do bate-papo ficam exibidas antes de desaparecerem."

