	key[]: "job_log_desc"
	val[]: "Acompanhe o seu progresso no jogo. Lembre-se das entregas feitas e as recompensas que já recebeu." #+ Help message associated the progress history icon.


	key[]: "stats_t"
	val[]: "Suas estatísticas" #+ Header of section with statistics info.

	key[]: "stats_dist_total"
	val[]: "Distância total percorrida:"

	key[]: "stats_dist_onjob"
	val[]: "Distância percorrida em serviço:"

