#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "Para acessar os trabalhos rápidos, você precisa completar o tutorial atual."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Para acessar o mercado de fretes, primeiro você precisa ter um caminhão selecionado."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Para acessar o mercado de carga, primeiro você precisa ter um reboque selecionado."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Para acessar os contratos externos, primeiro você precisa ter um caminhão selecionado e ter um perfil conectado ao World of Trucks."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Para acessar o mercado externo, primeiro você precisa ter um reboque selecionado e ter um perfil conectado ao World of Trucks."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Visualize o mapa, suas áreas exploradas e seus pontos de controle de navegação atuais ou defina novos."

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Viaje rapidamente para uma cidade previamente descoberta, mediante um custo."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Navegue, pesquise e filtre sessões de comboio online para participar ou crie e hospede a sua própria para outros jogadores."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Sua caixa de entrada para mensagens do mundo dos negócios, bancos e de novas contratações."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "Os e-mails começarão a chegar assim que você progredir mais na sua carreira."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Localize e compre garagens disponíveis no mapa."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Procure e avalie caminhões usados à venda."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Você ainda não descobriu uma concessionária."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Procure, avalie e reconfigure reboques à venda."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Melhore sua experiência ao dirigir com música."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "O rádio está indisponível."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Ajuste as configurações de gráficos, áudio, jogo, controles e opções online."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Veja o progresso da sua carreira, suas estatísticas e trabalhos recentemente concluídos."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Para acessar o comboio ativo, primeiro você precisa entrar em uma sessão de comboio."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Aviso de fotossensibilidade"

	key[]: "health_warning_description"
	val[]: "Um pequeno número de pessoas pode sofrer ataques epiléticos ou perda de consciência quando exposto a determinadas luzes, padrões ou imagens. Esses indivíduos podem sofrer convulsões quando visualizam certas imagens ou jogam videogame. Se você ou algum familiar já teve sintomas relacionados à epilepsia (convulsões ou perda de consciência) quando exposto a luzes intermitentes, consulte um profissional da saúde e tome todas as devidas precauções antes de jogar.<br offset=20>Se você ou alguém da sua família apresentar tontura, visão turva ou embaçada, contrações oculares ou musculares, perda de consciência, desorientação, convulsões, movimentos involuntários enquanto estiver jogando, interrompa imediatamente a sessão de jogo e consulte um profissional da saúde."

	key[]: "trademark"
	val[]: "Todas as marcas, logotipos e símbolos presentes nos veículos do jogo são propriedade de seus respectivos proprietários. Utilizados com a devida permissão. As marcas e designs MAN® são direitos registrados da MAN Truck & Bus AG e são utilizados sob licença da SCS Software s.r.o. \"Mercedes-Benz\" e \"Three pointed star in a ring\" são marcas registradas da Daimler AG e utilizadas sob licença da SCS Software s.r.o. As marcas e designs RENAULT são direitos registrados ou licenciados para o AB Volvo Group e são utilizados mediante licença. As marcas e designs VOLVO são direitos registrados ou licenciados para o AB Volvo Group e são utilizados mediante licença."
#@}

