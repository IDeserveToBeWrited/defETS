#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Serviço de rede indisponível. Verifique se as suas configurações estão corretas."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Não foi possível estabelecer conexão com o serviço online. Verifique sua conexão com a internet."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Erro durante a comunicação com o serviço online. Tente novamente mais tarde."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Dados incorretos retornados do serviço online. Se um proxy HTTP está em uso, verifique a configuração. Caso contrário, tente novamente mais tarde."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Dados incorretos foram retornados do serviço online. Tente novamente mais tarde."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "O serviço não é compatível com a versão atual do jogo. Verifique se uma nova atualização para o jogo está disponível."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "O serviço não está disponível no momento. Tente novamente mais tarde."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "O serviço está em manutenção ou sobrecarregado. Tente novamente mais tarde."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "A informação de autenticação não é válida. Tente entrar novamente."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Esta conta online está atualmente bloqueada devido a muitas tentativas de login mal sucedidas. Tente novamente em meia hora."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "A conta online está atualmente bloqueada devido a acessos suspeitos. Tente novamente em 24 horas."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Este jogo não foi registrado para essa conta online."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Esta conta ainda não foi ativada. Verifique se há um e-mail de ativação na sua caixa de entrada."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Esta conta foi suspensa. Entre em contato com o suporte técnico."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Esta conta foi banida. Entre em contato com o suporte técnico."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Autenticação de proxy não é suportada por este jogo. Por favor, use um proxy diferente ou conexão direta."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "O objeto desejado não está disponível. Tente novamente em alguns minutos."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Erro de SSL. Não foi possível estabelecer uma conexão segura."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "O jogo foi suspenso durante a comunicação online. Tente novamente mais tarde."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Erro interno. O arquivo net.log pode conter mais informações."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 está tendo um problema e é incapaz de renderizar gráficos em seu computador (nenhum dispositivo gráfico válido foi encontrado).\nSugestões:\n\n1. Verifique se o seu computador e placa de vídeo atendem os requisitos mínimos de hardware.\n2. Atualize seu computador com a última versão do DirectX da Microsoft.\n3. Faça o download e instale os drivers mais recentes para sua placa de vídeo no site do seu fornecedor - os seus drivers gráficos estão provavelmente desatualizados.\n4. Tente alterar o método de renderização de OpenGL para DirectX ou vice-versa.\n5. Elimine arquivo de configuração 'config.cfg' em 'Documentos/'Euro Truck Simulator 2 '. Ele pode ter sido corrompido.\nEste arquivo será automaticamente recriado com os valores padrão válidos."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 está tendo um problema e não pode renderizar gráficos no seu computador (nenhum dispositivo gráfico válido foi encontrado)."
#@}

