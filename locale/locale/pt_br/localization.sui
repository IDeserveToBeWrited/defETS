	val[]: "CONFIGURAÇÕES GERAIS" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONECTAR CONTEÚDO" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Conectar" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "O World of Trucks detectou novo conteúdo no jogo. Conecte-se aos serviços do World of Trucks para acessar o novo conteúdo." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Preferências online. Ajuste todas as configurações relacionadas ao World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Quer realmente adiar o registro?<br><br>Você pode acessar depois o diálogo para Conectar Conteúdo Online pelas Opções Online, localizadas na área de trabalho." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "CONECTANDO CONTEÚDO" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Conectando conteúdo..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Falha ao processar a operação de conexão para: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "A conta Steam que você usou para registrar esta DLC difere da que foi usada para criar sua conta no World of Trucks ou para registrar o jogo. Por favor, troque de conta Steam e tente novamente." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "A conta Steam que você usou para registrar esta DLC já está associada a outra conta do World of Trucks. Para registrar a DLC à conta atual, você precisa usar uma conta Steam que não está conectada a uma conta do World Of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "O token da Steam expirou. Tente novamente mais tarde." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "A chave serial usada para ativar a DLC não é válida. Para obter ajuda, entre em contato com o suporte: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Ocorreu um erro interno durante o registro do jogo. Tente novamente mais tarde." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCESSO" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFORMAÇÃO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "NAVEGADOR DE CONTEÚDO" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Parabéns! As DLCs selecionadas foram conectadas à sua conta do World of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Não foi possível conectar o conteúdo porque a conta Steam atual está associada a outra conta do World of Trucks." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Falha na conexão de algumas DLCs.<br>Passe o mouse sobre os pontos de exclamação para ver mais informações." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrando $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "O perfil atual não está conectado ao World of Trucks ou o jogo está sendo executado no modo offline. Edite o perfil para conectar." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Dispensar"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLCs compatíveis atualmente conectadas. Se algumas das DLCs não estiverem conectados ao World Of Trucks, você poderá perder alguns dos seus recursos." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Parabéns! <color value=@@clr_txt@@>Todo o seu conteúdo está conectado ao World of Trucks! Você agora pode usar todos os seus recursos." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Não foi possível conectar o novo conteúdo ao World of Trucks porque a conta Steam usada atualmente não é a mesma usada pelo perfil do World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Conectado" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Não conectado" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
