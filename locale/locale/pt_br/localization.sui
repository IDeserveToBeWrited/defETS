#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "O arquivo da captura é muito grande. Tente diminuir a resolução do monitor." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "O arquivo da captura está corrompido ou não é suportado." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "A resolução da captura é muito grande. Tente reduzir a resolução do monitor." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "O serviço rejeitou a captura." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Esta conta não tem permissão para enviar capturas." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Houve um envio simultâneo para o mesmo espaço." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "O envio está atualmente desabilitado. Tente novamente mais tarde." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Erro desconhecido encontrado durante o envio. Tente novamente mais tarde." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "A foto é maior que o tamanho máximo permitido de $LIMIT$ e foi redimensionada." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "O arquivo da foto é maior que o tamanho máximo permitido de $LIMIT$KB e foi redimensionada." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

	key[]: "mods_t"
	val[]: "MODS ATIVOS" #+ Mod selection title

	key[]: "missing_deps"
