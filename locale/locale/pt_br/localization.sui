	key[]: "advanced"
	val[]: "Configuração avançada"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "O jogo agora está configurado e você pode continuar. Você poderá alterar a configuração posteriormente no menu Opções."

	key[]: "wiz_cfg_steam"
	val[]: "Você pode verificar e configurar o mapeamento de botões e eixos para este controle usando o cliente Steam. As configurações do controle Steam para o jogo estão disponíveis em Steam > Biblioteca > Euro Truck Simulator 2 > Configuração do Controle."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Abrir configurações do controle"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Use @@imm_wiz_dsteerleft@@ e @@imm_wiz_dsteerright@@ para esterçar."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Mova o mouse para a esquerda ou direita para girar o volante na direção correspondente."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Use @@ima_wiz_j_steer@@ para esterçar."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Use @@imm_wiz_dforward@@ para dirigir para a frente e @@imm_wiz_dbackward@@ para dirigir para trás."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Mova @@ima_wiz_j_throttle@@ para a frente para avançar e para trás para dar marcha à ré."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Use @@ima_wiz_j_throttle@@ para acelerar e use @@ima_wiz_j_brake@@ para dar marcha à ré."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Use @@imm_wiz_dforward@@ para acelerar e use @@imm_wiz_dbackward@@ para frear."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Mova @@ima_wiz_j_throttle@@ para a frente para acelerar e para trás para frear."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Use @@ima_wiz_j_throttle@@ para acelerar e @@ima_wiz_j_brake@@ para frear."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Use @@imv_wiz_gearup@@ para engatar a marcha para a frente e @@imv_wiz_geardown@@ para engatar a marcha à ré."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Use @@imv_wiz_gearup@@ para engatar a marcha para a frente e @@imv_wiz_geardown@@ para engatar a marcha à ré se você estiver usando os botões do teclado ou controle. Use @@imv_wiz_drive@@ e @@imv_wiz_reverse@@ para selecionar a direção de condução se você estiver usando um câmbio com H-shifter."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Use @@imv_wiz_gearup@@ e @@imv_wiz_geardown@@ para selecionar a marcha desejada."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Use seu câmbio em H, com @@ima_wiz_j_clutch@@ para selecionar a marcha desejada."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "CONFIGURAR EIXOS DO CONTROLE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualização dos eixos"

	key[]: "wiz_setup_axes_desc"
	val[]: "Você pode testar o funcionamento de todos os eixos selecionados visualmente. Use o controle e olhe para as barras móveis. Elas vão mostrar os limites, a centragem, a orientação e o comportamento geral de cada eixo utilizado."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Configuração dos eixos"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Para escolher um eixo, clique no botão próximo ao nome do mesmo. Isso mudará você para o modo de entrada. Em seguida, use o seu controle para vincular o eixo selecionado movendo o stick, volante ou pedal para o eixo escolhido."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Zonas mortas"

	key[]: "wiz_setup_axes_desc3"
	val[]: "A zona morta é a uma área de eixo projetada intencionalmente para não fornecer entrada. Para ajustar a zona morta de um eixo escolhido, mova o controle deslizante correspondente. Aumentar o controle deslizante para a direita amplia a zona morta. Essa função é especialmente benéfica para controladores mais antigos, pois uma zona morta maior pode mitigar problemas como imprecisão ou entradas falsas causadas pelo desgaste do hardware."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Modos de eixos"

	key[]: "wiz_setup_axes_desc4"
	val[]: "O modo de eixo determina como ele é tratado no jogo. O eixo invertido inverte sua direção relatada, resultando em virar à esquerda em vez de à direita, por exemplo. Um eixo centralizado tem sua posição padrão no meio da sua faixa, como em um joystick. Este modo é útil para corrigir um eixo que foi detectado incorretamente."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Invertido" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centralizado" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Invertido e centralizado" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "CONFIGURAÇÃO DA TRANSMISSÃO AUTOMÁTICA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Com a caixa de marchas automática, você só precisa alternar entre os modos de avanço, neutro e ré. Para isso, use as seguintes teclas e botões do controle. Para mudar as configurações, clique em um botão e pressione a tecla ou o botão do controle que quer usar para a ação."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Se você tem um câmbio com H-shifter conectado, você pode usá-lo para a simulação de um de câmbio real. Ative essa opção e defina as posições para cada marcha. Quaisquer outras posições são contados como neutro. Esta configuração foi feita para controles com H-shifter e não irá trabalhar com teclas ou botões de controle. Se você quiser alterar qualquer um deles clique em um botão e depois mova a alavanca para a posição desejada e depois volte para a posição neutra."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "CONFIGURAÇÃO DA TRANSMISSÃO SEQUENCIAL" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "A caixa de marchas sequencial troca entre todas as marchas de avanço, neutro e ré. Aqui estão as teclas ou os botões do controle usados para subir e descer marchas na ordem mencionada. Para alterar a atribuição, clique em um botão e pressione a tecla ou o botão do controle que quer usar para a ação."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "CONFIGURAÇÃO DO CÂMBIO EM H" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Aqui você pode escolher a disposição para o câmbio em H e testar suas funções. Na imagem, você pode ver a posição atual do câmbio, bem como qual marcha está selecionada. Como a caixa de marchas contém mais marchas do que posições na alavanca, você precisa usar botões para alternar entre diferentes conjuntos de marchas."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "A posição da marcha atualmente selecionada e do alternador ativo também estão indicados abaixo, ao lado do controle associado. Para alterar uma atribuição, clique no botão apropriado e depois mova a alavanca para a posição desejada e então volte para o neutro."
#@}

