	key[]: "bank_nl_confirm_title"
	val[]: "NOVO EMPRÉSTIMO" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Você está pedindo um empréstimo de $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Prazo de pagamento:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
