	val[]: "Espaço vazio" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Erro" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Enviar para o espaço selecionado" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Usar como meu caminhão do perfil" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Você quer apagar permanentemente a seguinte foto?"

	key[]: "upload_screenshot"
	val[]: "Você quer fazer o envio da seguinte imagem para o espaço selecionado?<br><br>A imagem armazenada neste espaço será apagada!"

	key[]: "upload_profile_screenshot"
	val[]: "Você quer enviar essa captura para ela ser o seu caminhão de perfil no World of Trucks?<br><br>A imagem atual do perfil será substituída!"

	key[]: "wotr_upload_title"
	val[]: "AVISO DE ENVIO"

	key[]: "new_screenshot"
	val[]: "Novas imagens estão disponíveis para envio!" #+ New screenshot notification

	key[]: "uploading_screenshot"
