#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuar ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Boas-vindas ao Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Finalmente você tem a oportunidade de experimentar o seu emprego dos sonhos: dirigir um caminhão!"

	key[]: "intro_3"
	val[]: "A sua empresa de transporte está aberta para negócios, mas, infelizmente, falta dinheiro para comprar um caminhão. Por enquanto, você vai ter que trabalhar para outras empresas como motorista contratado."

	key[]: "intro_4"
	val[]: "Sua tarefa é entregar com segurança uma carga de $JOB_CARGO$ para $JOB_TARGET_COMPANY$ em $JOB_TARGET_CITY$. O seu empregador providenciou um veículo e vai cobrir todas as despesas. Não desaponte ninguém e chegue no horário."


	key[]: "intro_garage_1"
	val[]: "Esta é a sua sede."

	key[]: "intro_garage_2"
	val[]: "Essa é uma garagem bem simples. Pode não ser muito, mas é um começo."

	key[]: "intro_garage_3"
	val[]: "Infelizmente, você ainda não tem o quê estacionar lá, então ela está vazia."

	key[]: "intro_garage_4"
	val[]: "Quando você ganhar dinheiro suficiente e comprar um caminhão, vai poder transitar livremente no mundo e administrar o seu próprio negócio."

	key[]: "intro_garage_5"
	val[]: "Boa sorte!"


	key[]: "desktop_tut_t"
	val[]: "RECURSO DESBLOQUEADO"

	key[]: "desktop_tut_job"
	val[]: "Escolha seu próximo trabalho"

	key[]: "desktop_tut_cargo_market"
	val[]: "Use o seu novo reboque para acessar o Mercado de Cargas e entregar uma grande variedade de cargas aos seus destinos." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Aqui você pode ver o seu progresso."

	key[]: "desktop_tut_company"
	val[]: "Mantenha o controle das suas garagens, contrate novos motoristas e gerencie a sua empresa aqui."

	key[]: "desktop_tut_trailers"
	val[]: "De agora em diante, você pode comprar seu próprios reboques e personalizar ou pintá-los para combinar com seu caminhão.<br><br>Seus reboques podem ser armazenados nas suas garagens à sua escolha e usados por seus motoristas para aumentar seus lucros. Para gerenciar seus reboques, use o Gerenciador de Reboques."

	key[]: "desktop_tut_visit_directive"
	val[]: "Visite $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "Use o botão Modo para alternar entre diferentes modos da área de trabalho e tipos de veículos."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BOAS-VINDAS"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Bem-vindo(a) à nossa nova tela inicial<br>A partir daqui você poderá interagir com todas as funcionalidades do jogo."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Abaixo, o menu principal permite acesso direto a todas as funções principais do jogo com as quais você já está familiarizado."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Na parte superior, a nova barra de status oferece visibilidade constante de estatísticas úteis sobre o perfil do jogador e mostra também as regulamentações locais."

	key[]: "desktop_tut_tour_home"
	val[]: "O botão da Tela Inicial está sempre disponível para retornar à tela inicial."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Um menu rápido permanente que fornece atalhos para acesso prático a todas as funções do jogo em qualquer tela."

	key[]: "desktop_tut_tour_drive"
	val[]: "O novo botão de dirigir continua sendo sua conexão com o mundo da direção, pronto para colocar você de volta à estrada."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL CONCLUÍDO"

	key[]: "desktop_tut_tour_finish"
	val[]: "Obrigado por assistir a nossa atualização da tela inicial."


	key[]: "desktop_vehicle_mode_reenable_hints_t"
    val[]: "ATIVAR DICAS"

    key[]: "desktop_vehicle_mode_reenable_hints"
    val[]: "Você está entrando em um novo modo de jogo e as dicas contextuais estão desativadas. Elas podem ajudar você no aprendizado do jogo. Deseja reativá-las?"
#@}


	key[]: "show_help"
	val[]: "Ligar ou desligar dicas de ajuda"

