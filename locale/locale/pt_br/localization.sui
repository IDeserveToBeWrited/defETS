#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Seleciona o subtipo de controle para que o jogo lide corretamente com as faixas de entrada."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Seleciona o tipo de transmissão.<br>- \"Automática simples\" permite usar o acelerador e o freio para andar para frente e para trás.<br>- \"Automática real\" requer uma entrada para alternar entre marchas de avanço e de ré.<br>- \"Sequencial\" requer mudança manual de todas as marchas com entradas de subida/descida de marcha.<br>- \"Câmbio em H\" requer o uso de um controle com portas de mudança para selecionar as marchas manualmente."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Altera a lógica de mudança de marcha da transmissão automática.<br>- O \"Modo econômico\" prefere rotações mais baixas para máximo torque.<br>- \"Modo alta potência\" busca atingir a mais alta potência para melhor desempenho com cargas pesadas ou em terrenos montanhosos ao custo de maior consumo de combustível."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a relação entre o grau de rotação do dispositivo e o grau real de rotação da direção do veículo."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a linearidade entre a entrada e a direção do veículo.<br><br>Ajustar este valor para mais alto significa que a direção responderá menos quando o volante estiver no centro, e aumentará a sensibilidade conforme o volante é girado em direção ao limite máximo. Isso pode ser útil para suavizar as entradas de direção ao dirigir em linha reta."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Ativa o force feedback em controles compatíveis com esse recurso."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta o ganho geral para todas as configurações de force feedback entre 0N e 10N.<br><br><color value=@@clr_txt_d@@>Uma configuração mais alta em volantes mais potentes pode causar lesões nos dedos ou nas mãos."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força de centralização ao dirigir em alta velocidade, alcançando o ponto máximo a partir de 90 km/h (ou 56 mph).<br><br>A configuração mínima resulta em nenhuma força de centralização do volante."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força de centralização ao dirigir em baixa velocidade.<br><br>A configuração mínima resulta em nenhuma força de centralização do volante."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a força da fricção interna artificial causada pelos componentes mecânicos de direção."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade da ressonância artificial do motor através da coluna de direção.<br><br><color value=@@clr_txt_d@@>Configurar este valor acima de 15% pode causar trepidação e vibração excessivas em alguns volantes."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos da superfície da via através da coluna de direção.<br><br><color value=@@clr_txt_d@@>Configurar este valor acima de 20% pode causar trepidação e vibração excessivas em alguns volantes ao dirigir em terrenos irregulares em alta velocidade."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de solavancos na estrada através da coluna de direção."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de colisão através da coluna de direção."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de rangido da caixa de engrenagens."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade dos efeitos de deslizamento ao sair de frente."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade da direção assistida (por exemplo, ao usar o recurso de assistência de faixa)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade das vibrações da superfície do terreno, se o controle suportar feedback de vibração."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade das vibrações de solavancos, se o controle suportar feedback de vibração."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a intensidade das vibrações de colisão, se o controle suportar feedback de vibração."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para direção."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de direção; a quantidade de rotação a partir do centro na qual a entrada é ignorada.<br><br>Isso pode mitigar problemas com controles mais antigos, como imprecisão ou entradas falsas causadas por desgaste."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do eixo de direção.<br>- \"Centralizado\" é ideal para volantes.<br>- \"Invertido\" é usado para corrigir um eixo que foi detectado incorretamente."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para acelerar o veículo."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de aceleração; a quantidade de movimento de entrada na qual nenhuma entrada é registrada.<br><br>Isso pode mitigar problemas com controles mais antigos, como imprecisão ou entradas falsas causadas por desgaste."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do controle.<br>- \"Normal\" é ideal para gatilhos ou pedais.<br>- \"Invertido\" pode compensar entradas que foram detectadas incorretamente."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para frear."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de freio; a quantidade de movimento de entrada na qual nenhuma entrada é registrada.<br><br>Isso pode mitigar problemas com controles mais antigos, como imprecisão ou entradas falsas causadas por desgaste."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do controle.<br>- \"Normal\" é ideal para gatilhos ou pedais.<br>- \"Invertido\" pode compensar entradas que foram detectadas incorretamente."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para acionar a embreagem."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de embreagem; a quantidade de movimento de entrada na qual nenhuma entrada é registrada.<br><br>Isso pode mitigar problemas com controles mais antigos, como imprecisão ou entradas falsas causadas por desgaste."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do controle.<br>- \"Normal\" é ideal para gatilhos ou pedais.<br>- \"Invertido\" pode compensar entradas que foram detectadas incorretamente."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a faixa da embreagem.<br><br>Quanto mais à direita você definir a faixa, mais longe precisará pressionar o pedal para acionar a embreagem."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para inclinar a câmera para cima e para baixo."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo usado para olhar para cima e para baixo; a quantidade de movimento de entrada na qual nenhuma entrada é registrada.<br><br>Isso pode mitigar problemas em controles mais antigos, como imprecisão ou entradas falsas causadas por desgaste."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do eixo.<br>- \"Invertido\" é usado para corrigir um eixo que foi detectado incorretamente."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "O eixo do dispositivo a ser usado para movimentar a câmera para a esquerda e para a direita."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajusta a zona morta do eixo de olhar para a esquerda e para a direita; a quantidade de deslocamento de entrada em que nenhuma entrada é registrada.<br><br>Isso pode mitigar problemas de controladores mais antigos, como imprecisão ou entradas falsas causadas pelo desgaste."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determina como o jogo lida com a entrada do eixo.<br>- \"Centralizado\" é ideal para joysticks.<br>- \"Invertido\" é usado para corrigir um eixo que foi detectado incorretamente."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Seleciona o layout de marchas a ser usado com o câmbio em H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Muda o comportamento do câmbio:<br>- Com a opção \"Simples\", você nunca vai arranhar engrenagens ao mudar de marcha.<br>- A opção \"Simples + som de aviso\" também permite mudar de marcha de maneira simples, mas com sons de \"arranhão\" quando você muda de marcha incorretamente.<br>- A opção \"Avançado\" não permite mudar de marcha se ela for mudada incorretamente e você ouvirá apenas sons de \"arranhão\". A opção \"Avançado\" também permite usar a configuração \"Divisão rápida do câmbio\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Escolha como o jogo lida com divisões rápidas de marcha.<br>- \"Nunca\" exige que a alavanca de câmbio seja movida para neutro entre as divisões.<br>- \"Pressionar a embreagem\" requer um acionamento momentâneo da embreagem, sem mover a alavanca de câmbio.<br>- \"Soltar acelerador\" exige que o motorista apenas solte o acelerador para dividir as marchas, sem mover a alavanca de câmbio, e \"Embreagem ou acelerador\" combina as duas opções anteriores."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Atribui a posição da alavanca."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Atribui o comando usado para alternar entre reduzida e normal com base no layout da alavanca de câmbio."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Atribui botão para alternar o divisor conforme o layout do câmbio."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Ative ao usar alternadores em vez de botões para comandos de reduzida ou divisor."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Atribui um botão para mudar para o modo direção (drive) da transmissão automática."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Atribui um botão para mudar para o modo ré (reverse) da transmissão automática."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Ativa efeitos de feedback com RGB dinâmico em dispositivos compatíveis."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Ativa e configura recursos de rastreio ocular para dispositivos compatíveis."
