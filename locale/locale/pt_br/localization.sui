	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "A aquisição de DLCs está levando mais tempo do que o esperado. Quer continuar aguardando?<br><br>Se você prosseguir, a aquisição continuará em segundo plano."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Você obteve acesso a alguns DLCs. Deseja retornar agora ao menu inicial para acessar o novo conteúdo?<br><br>Seu progresso será salvo automaticamente."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "O acesso a alguns DLCs foi perdido. Você será redirecionado para o menu principal para verificar as alterações no conteúdo.<br><br>Seu progresso será salvo automaticamente."
#@}

