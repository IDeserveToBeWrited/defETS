	val[]: "Você quer cancelar o assistente de configuração?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SELECIONAR MÉTODO DE CONTROLE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Controles"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>O assistente aplicará as configurações recomendadas com base nos dispositivos conectados.<br><color value=@@clr_sel@@>Se você estiver usando um controle compatível com o Steam, considere ativar o suporte de configuração em <br><color value=@@clr_txt_d@@> \"Steam > Configurações > Controle > Configurações Gerais de Controle\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Dirigir usando o teclado e olhar ao redor do mundo com o mouse. A mais simples e menos precisa forma de controle, mas disponível para qualquer um."

	key[]: "wiz_control_mouse"
	val[]: "Use o mouse para a direção de alta precisão. O teclado é usado para outras ações. O mouse é usado para olhar em volta somente se você usar simultaneamente a tecla de controle da câmera."

	key[]: "wiz_control_controller"
	val[]: "Use o seu volante ou controle para uma experiência de jogo mais realista. Atalhos de teclado podem ser usados para acesso a muitas ações, e você pode mudar o ângulo da câmera com o mouse."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nenhum controle foi encontrado. Você precisa conectar um agora para permitir esta escolha!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Detectando controles disponíveis…"

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECIONAR API DO CONTROLE" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Modo de mapeamento no jogo (recomendado)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Modo de mapeamento pelo cliente Steam"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Controle clássico"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Controles, como @@controller_ps5@@, @@controller_xbox_one@@ ou @@controller_steam_deck@@ conectados pela interface do Steam Input e que usam um layout simples.<br><br>Compatível com configurações completas de mapeamento de botões no jogo."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Controles ativados na interface do Steam Input e que usam layouts independentes configurados no cliente Steam.<br><br>Suporte limitado para dicas de botões no jogo e sem configurações de mapeamento internas."

	key[]: "wiz_api_classical"
	val[]: "Controlador, volante ou joystick usando DirectInput, XInput ou interface similar."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELECIONAR TIPO DE CONTROLE"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volante"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad ou joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "O controle é um volante ou se comporta como um. No jogo, a posição do controle afeta diretamente a das rodas dianteiras do caminhão."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "O controle é um gamepad ou joystick. A posição do controle especifica a velocidade de rotação da roda de tração no jogo."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECIONAR TIPO DE TRANSMISSÃO" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Pressione AVANÇAR para acelerar e pressione PARA TRÁS para frear ou dar ré. A caixa de câmbio gerencia automaticamente o resto, controlando as transições entre dirigir, frear e dar ré, além de selecionar as marchas apropriadas."

	key[]: "wiz_gb_automatic"
	val[]: "Use os botões para alternar entre dirigir para a frente, neutro ou marcha à ré. Em seguida, pressione o acelerador e deixe a transmissão automática cuidar das mudanças de marcha."

	key[]: "wiz_gb_sequential"
	val[]: "A troca manual de marchas para cima e para baixo permite selecionar cada marcha individualmente dentro da transmissão. Essa configuração proporciona controle total sobre a caixa de câmbio do veículo."

	key[]: "wiz_gb_hshifter"
	val[]: "Selecione a marcha desejada diretamente. Esta opção oferece a configuração mais realista. É recomendado o uso de uma alavanca de câmbio física com padrão H, que requer o uso da embreagem."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Este recurso requer um volante, gamepad ou joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nenhum controle de câmbio em H detectado, este recurso pode ser inutilizável."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECIONAR LAYOUT DO CÂMBIO EM H"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "A transmissão reduzida é a escolha mais simples. Ela tem dois conjuntos de marchas. O primeiro contém marchas da 1ª a 6ª; o segundo, da 7ª a 12ª. Um seletor alterna entre estes dois conjuntos, enquanto o câmbio seleciona a marcha específica do conjunto."

	key[]: "wiz_hs_splitter"
	val[]: "A transmissão de caixas alta/baixa é uma alternativa simples. Ela tem dois conjuntos de engrenagens. O primeiro conjunto contém marchas ímpares (1, 3, 5...); o segundo, marchas pares (2, 4, 6...). Um seletor alterna entre estes dois conjuntos, enquanto o câmbio seleciona a marcha específica do conjunto."

	key[]: "wiz_hs_range_splitter"
	val[]: "A transmissão com caixas alta, normal e reduzida é baseada na disposição real das caixas manuais. As marchas ficam separadas em quatro grupos, um para cada posição do câmbio em H. Porém ela é recomendada apenas para motoristas avançados."
#@}

#@}

