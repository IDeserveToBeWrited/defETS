#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANCO" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banco" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Se você precisar de dinheiro, pode pedir um empréstimo para o banco." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "OFERTAS DE EMPRÉSTIMO" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "por $MONEY$ o dia" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Número de empréstimos ativos: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Você pode pegar emprestado: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "VISÃO GERAL DOS EMPRÉSTIMOS ATIVOS"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Empréstimo" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Resta pagar" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Duração (em dias)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Taxa de juros (anual)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Parcela" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Pagar" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Total:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Saldo da conta: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

	key[]: "bank_loan_unlock_requirement"
	val[]: "Avance na sua carreira para desbloquear o empréstimo."

	key[]: "bank_loan_locked_wrong_mode"
	val[]: "Avance na sua carreira em $MODE$ para desbloquear o empréstimo."

    key[]: "bank_loan_in_debt"
	val[]: "Você tem muitos débitos para contratar um novo empréstimo."

