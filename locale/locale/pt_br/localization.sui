	key[]: "steam_info_fetch_failed"
	val[]: "Não foi possível reunir informações sobre a conta usada atualmente." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Depois" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Não foi possível registrar esta DLC. Nenhuma licença permanente foi encontrada, provavelmente devido ao Compartilhamento Familiar da Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Sem propriedade permanente" #+ The state of the content that cannot be connected due to invalid license.
