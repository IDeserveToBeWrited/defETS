#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Mersul cu Spatele cu o Remorcă"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "În acest scenariu, veţi încerca să daţi cu spatele cu remorca pentru prima dată. Este o manevră destul de simplă, dar tot va trebui să viraţi corespunzător pentru a duce remorca în poziţia corectă."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Mersul cu Spatele spre Remorcă"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Conectarea Remorcii"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Eliberarea Frânei de Staţionare"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Mersul cu Spatele cu Remorca"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Continuând spre Locul de Parcare"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Să încercăm să dăm cu spatele cu o remorcă ataşată. Este mai uşor decât pare; trebuie doar să aveţi răbdare."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Începeţi mersul cu spatele şi aduceţi capul tractor în linie cu remorca."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Asiguraţi-vă că alinierea este corectă sau conectarea nu poate fi realizată. Dacă nu este în regulă, puteţi întotdeauna să mergeţi înainte şi să încercaţi din nou."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "A cincea roată a capului tractor se va cupla cu pivotul remorcii."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Aplicaţi frâna de staţionare şi conectaţi remorca. În lumea reală, ar trebui să ieşiţi din camion, să conectaţi liniile de aer şi electrice şi să ridicaţi suporturile remorcii, dar aici vom face asta pentru dvs."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>remorca va vira întotdeauna în direcţia <color value=@@clr_sel@@>opusă <color value=@@clr_txt@@> celei a capului tractor."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Pentru a vira remorca, va trebui să viraţi capul tractor în direcţia<color value=@@clr_sel@@> opusă <color value=@@clr_txt@@> celei în care vreţi remorca să ajungă."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Pentru a îndrepta remorca, viraţi camionul <br><color value=@@clr_sel@@>spre<color value=@@clr_txt@@> remorcă."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Încercaţi să menţineţi alinierea cu remorca - va trebui să faceţi constant mici corecţii pentru a menţine remorca îndreptată spre zona marcată."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Cu mici rotiri ale volanului corectaţi abateri de la traiectorie imediat ce acestea apar. Dacă viraţi prea mult, puteţi ajunge departe de traiectoria dorită."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Opriţi în zona desemnată. Securizaţi camionul şi opriţi motorul."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "În spate şi pe partea pasagerului, veţi vedea o remorcă. Prima sarcină va fi să mergeţi cu spatele până la ea.<br><br><font face=/font/big_bold.font>Pregătiţi camionul pentru a da cu spatele. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Începeţi mersul cu spatele spre remorcă. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Aliniaţi-vă în aşa fel încât să fiţi în linie cu remorca. A cincea roată trebuie să prindă pivotul remorcii. Mergeţi în faţă pentru ajustări dacă este necesar.<br><br><font face=/font/big_bold.font>Continuaţi mersul cu spatele până când simţiţi o conexiune cu remorca. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "A cincea roată s-a cuplat la pivotul remorcii şi sunteţi gata pentru a termina cuplarea remorcii.<br><br><font face=/font/big_bold.font>Aplicaţi frâna de staţionare. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Apăsaţi @@imv_nrm_attach@@ pentru a conecta remorca. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Acum remorca este conectată în siguranţă la capul tractor, liniile de aer şi electrice sunt conectate şi suporturile remorcii au fost ridicate.<br><br><font face=/font/big_bold.font>Eliberaţi frâna de staţionare. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Trebuie să daţi cu spatele în locul de parcare din spatele dvs. Nu uitaţi că remorca se va roti în direcţia opusă celei în care viraţi capul tractor. O mică rotire a volanului poate duce la o mişcare semnificativă a remorcii.<br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele al remorcii. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Nu supra-viraţi, încercaţi doar să menţineţi remorca aliniată cu locul de parcare. <br><br><font face=/font/big_bold.font>Continuaţi spre locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
