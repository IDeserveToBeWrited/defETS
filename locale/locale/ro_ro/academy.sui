	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Frânarea cu o Remorcă"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "În acest scenariu, vă veţi familiariza cu condusul şi frânarea cu o remorcă ataşată."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Pornire"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Condusul în Josul Dealului"

	key[]: "aca_goal_book1_3_02_check2"
