	key[]: "aca_book_disclaimer_topbar"
	val[]: "Acesta nu este un program de instruire certificat."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ nu este destinată să înlocuiască instruirea în cabină.</font><br><br><color value=@@clr_txt@@>Recomandăm cu insistenţă solicitarea unui instructaj de la o instituţie acreditată de formare în domeniul camioanelor înainte de a încerca să conduceţi un camion în viaţa reală.<br><br>Instituţiile de formare interesate să utilizeze @@driving_academy@@ pentru a suplimenta instruirea în cabină a şoferilor ne pot contacta la academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Bazele Condusului Camionului"

	key[]: "aca_book_book1_desc"
	val[]: "Învăţaţi elementele de bază ale condusului unui camion, de la funcţiile şi comenzile de bază, la manevrarea cu o remorcă."

	key[]: "aca_book_book2_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_book_book2_desc"
	val[]: "Perfecţionaţi-vă abilităţile de şofer de camion cu noi scenarii în condiţii mai dificile."

	key[]: "aca_book_book3_title"
	val[]: "Manevrarea Remorcilor Duble"

	key[]: "aca_book_book3_desc"
	val[]: "Înfruntaţi provocările interesante oferite de condusul şi mersul cu spatele cu un set de remorci duble."

#@}

