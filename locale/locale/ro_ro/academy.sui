	val[]: "<align vstyle=top hstyle=left><img src=/material/ui/academy/book/book1/illustration/diagonal.mat bottom=p204 right=p204 color=FFFFFFFF></align><offset vshift=204>"

	key[]: "aca_msg_book1_3_09_start_img_uk"
	val[]: "<align vstyle=top hstyle=left><img src=/material/ui/academy/book/book1/illustration/diagonal_gb.mat bottom=p204 right=p204 color=FFFFFFFF></align><offset vshift=204>"
#!}

#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Parcare în Diagonală"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "În acest scenariu, veţi parca într-un loc de parcare în diagonală dintr-o parcare aglomerată. <br><br>Nu este prea mult spaţiu de manevră, aşa că va trebui să conduceţi foarte precis şi deliberat."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Apropierea de Locul de Parcare"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Astfel de locuri de parcare în diagonală sunt destul de frecvente. Acestea sunt în special frecvente în numeroasele zone de odihnă de pe drumurile europene. <br>Încă o dată, va trebui să „băgăm nasul” în locul de parcare din faţă."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Conduceţi spre locul de parcare desemnat aproape de capătul rândului."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Rămâneţi spre mijlocul benzii sau puţin spre partea şoferului. Nu conduceţi prea aproape de bariere sau partea din spate a remorcii le poate lovi în timpul virajului."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Treceţi la ceva distanţă de locul de parcare, apoi viraţi puternic şi rapid spre acesta. Va trebui să urmăriţi ambele oglinzi principale: Oglinda de pe partea şoferului pentru a vă asigura că partea din faţă a remorcii dvs. nu loveşte cealaltă remorcă şi oglinda de pe partea pasagerului pentru a vedea dacă remorca dvs. intră în siguranţă în locul de parcare."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Opriţi în zona desemnată, securizaţi camionul şi opriţi motorul."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "Atunci când parcaţi în diagonală, este important să evaluaţi poziţia cu exactitate. Odată ce aţi intrat în viraj, este dificil să daţi cu spatele şi să vă repoziţionaţi în siguranţă, aşa că este ideal să vă asiguraţi că aveţi suficient spaţiu de la prima încercare.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Începeţi să conduceţi spre locul de parcare. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Treceţi pe lângă locul de parcare, astfel încât remorca să aibă loc să pivoteze în jurul camionului de pe interior.<br><br><font face=/font/big_bold.font>Viraţi către locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Mers cu Spatele „În Orb”"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "În acest scenariu vom vedea cum se dă cu spatele „în orb” într-un loc de parcare. Fără posibilitatea de a privi afară prin geam pentru a vedea încotro vă îndreptaţi, va trebui să vă bazaţi doar pe oglinzi pentru a ajunge unde trebuie."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "În acest scenariu veţi învăţa manevra de mers cu spatele „în orb”. Mersul în orb trebuie evitat în general, cu excepţia cazului în care nu există alternativă, deoarece vizibilitatea este sever limitată. Nu vă grăbiţi şi fiţi extrem de precauţi."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Treceţi dincolo de locul de parcare pentru a vă oferi spaţiu de manevră atunci când începeţi mersul cu spatele."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Opriţi, verificaţi împrejurimile, apoi începeţi mersul cu spatele."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Îndepărtaţi capul tractor de locul de parcare. Această mişcare va împinge partea frontală a remorcii roată şi în schimb spatele remorcii va fi îndreptat spre locul de parcare în care vreţi să intraţi. Aveţi grijă să nu exageraţi sau riscaţi să vă confruntaţi cu o „înţepenire” a combinaţiei (jack-kniffing)."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Pe măsură ce remorca intră în locul de parcare, începeţi să îndreptaţi camionul."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Opriţi în zona desemnată şi securizaţi camionul."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Mersul cu spatele „în orb” necesită aceleaşi proceduri ca şi mersul înapoi pe partea cu vizibilitate, dar veţi fi în dezavantaj în lipsa acesteia pe acea parte. Utilizaţi oglinzile şi cel mai bun raţionament pentru a parca autocamionul.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Înainte şi pe partea pasagerului se află un loc de parcare. Va trebui să treceţi mult dincolo de acesta, astfel încât să aveţi spaţiu de manevră pe măsură ce daţi cu spatele.<br><br><font face=/font/big_bold.font>Mergeţi înainte. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Nu uitaţi, virând camionul departe de locul de parcare, remorca va vira spre acesta. Folosiţi oglinzile cât mai bine posibil pentru a vă ajuta să ajungeţi în locul de parcare.<br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Condusul pe un Sens Giratoriu"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "În acest scenariu, vom vedea cum se negociază un sens giratoriu.<br><br>Va trebui să acordaţi o atenţie sporită remorcii, deoarece aceasta va urma o direcţie diferită în spatele dvs. la intrarea, la parcurgerea sensului giratoriu şi la ieşire."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Intrarea în Sensul Giratoriu"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Condusul în Sensul Giratoriu"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Condusul în Sensul Giratoriu"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Părăsirea Sensului Giratoriu"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Condusul spre Zona Desemnată"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Sensurile giratorii sunt foarte frecvente pe drumurile din Europa, aşa că este important să ştiţi cum să le negociaţi."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Rămâneţi pe exteriorul benzii în timp ce vă apropiaţi de sensul giratoriu. Acest lucru va ajuta remorca să depăşească interiorul virajului iniţial."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Conduceţi spre centrul sensului giratoriu când intraţi. Odată înăuntru, va trebui să vă îndreptaţi spre exterior. Aceasta este pentru a ţine remorca departe de centrul sensului giratoriu."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Ţineţi un ochi în oglindă pentru a vă asigura că remorca nu se apropie prea mult de barierele de pe interior."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Părăsirea sensului giratoriu este destul de uşoară, întrucât remorca este deja poziţionată departe de interiorul ieşirii. Viraţi larg la ieşire şi remorca ar trebui să vă urmeze cu bine."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parcaţi în zona desemnată şi securizaţi camionul."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "În faţă, aveţi un sens giratoriu configurat pentru a fi condus pe el. <br><br><font face=/font/big_bold.font>Apropiaţi-vă încet de sensul giratoriu. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Efectuaţi un viraj larg la intrarea în sensul giratoriu, pentru ca remorca să urmeze camionul fără probleme. <br><br><font face=/font/big_bold.font>Intraţi în sensul giratoriu. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Conduceţi spre exteriorul sensului giratoriu. Va trebui să ţineţi camionul cât mai departe posibil de centrul sensului giratoriu pentru a ţine remorca departe de barierele centrale. <br><br><font face=/font/big_bold.font>Continuaţi prin sensul giratoriu.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Ţineţi aproape de conurile de pe exterior. <br><br><font face=/font/big_bold.font>Continuaţi să conduceţi.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Părăsiţi sensul giratoriu.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Continuaţi spre locul de parcare din faţă.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Opriţi în zona desemnată.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Securizaţi camionul şi opriţi motorul.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manevrarea într-un Spaţiu Îngust"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Pentru ultimul scenariu, veţi avea sarcina de a întoarce camionul într-un spaţiu îngust. Va trebuie să daţi cu spatele pe partea „în orb” într-o zonă cu spaţiu limitat de manevră, ceea ce va necesita atenţie la împrejurimi şi utilizarea inteligentă a spaţiului."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Condusul spre Traseu"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Pregătirea pentru un Unghi Mort"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Mersul cu Spatele în Locul de Parcare"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Finalizarea unui Unghi Mort"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Părăsirea Traseului"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "În acest scenariu, vă vom prezenta cum să întoarceţi într-un spaţiu strâns cu o manevră de mers înapoi „în orb”. Această aptitudine va fi utilă atunci când nu puteţi face o întoarcere în „U” sau să daţi cu spatele pe partea şoferului."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Marcajele de pe drum vă vor ajuta la navigarea prin traseul de instruire."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Efectuaţi un viraj larg pentru a vă asigura că remorca va evita camioanele parcate."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "La ieşirea din viraj, gândiţi-vă cum veţi poziţiona camionul pentru manevra de mers cu spatele."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Va fi de ajutor să aveţi camionul poziţionat la un unghi spre locul de parcare gol de pe partea pasagerului, în care veţi da cu spatele."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Mers cu spatele „în orb” ar trebui evitat atunci când este posibil, deoarece vizibilitatea este mult mai redusă. Din păcate, se întâmplă să nu aveţi de ales decât să o faceţi."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Trageţi de volan înainte de a da cu spatele. Acest lucru va ajuta la orientarea imediată a remorcii în direcţia dorită, ceea ce este util în situaţii foarte dificile."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Odată ce remorca este bine poziţionată în locul de parcare, aduceţi capul tractor în faţa remorcii şi îndreptaţi-vă."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Opriţi după ce v-aţi îndreptat şi aveţi suficient spaţiu pentru a merge din nou înainte. Puteţi ieşi în acelaşi mod în care aţi venit."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Urmaţi marcajele de pe drum în afara traseului de instruire."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Parcurgeţi virajul din faţă şi continuaţi spre zona desemnată."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Oprire."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Securizaţi camionul şi opriţi motorul."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "În zona din faţă este prezent un traseu de instruire ce reprezintă parcarea unei companii de transport. Sarcina dvs. este să intraţi acolo şi să întoarceţi camionul pentru a ieşi de acolo. Asiguraţi-vă că utilizaţi eficient spaţiul disponibil.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Continuaţi spre traseul de instruire. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Efectuaţi virajul şi continuaţi prin traseu. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Urmaţi marcajele de pe drum până la bariera de la sfârşitul traseului. Parcaţi la un unghi redus pentru ca remorca să fie îndreptată spre locul de parcare liber de pe partea pasagerului.<br><br><font face=/font/big_bold.font>Mergeţi înainte. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Aveţi o vedere mult mai limitată a ceea ce se întâmplă în jurul dvs. atunci când mergeţi „în orb”. Conduceţi încet, cu prudenţă şi folosiţi oglinzile.<br><br><font face=/font/big_bold.font>Daţi cu spatele şi viraţi remorca în locul liber de parcare. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Este suficient de mult. Acum puteţi continua şi ieşiţi din terenul de antrenament în aceeaşi direcţie din care aţi venit.<br><br><font face=/font/big_bold.font>Începeţi să vă îndreptaţi spre ieşire. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Părăsiţi traseul de instruire. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Urmaţi marcajele de pe drum până la locul de parcare final.<br><br><font face=/font/big_bold.font>Continuaţi spre zona desemnată. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manevră de Mers cu Spatele Decalată"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "În acest scenariu, veţi avea sarcina de a da cu spatele într-un loc de parcare ce nu se află direct în spatele dvs. Spaţiul de manevră este limitat, aşa că trebuie să folosiţi spaţiul disponibil inteligent."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "În acest scenariu, obiectivul va fi parcarea în spaţiul situat lângă dvs. Nu există prea mult spaţiu de manevră, aşa că va trebui să munciţi puţin în plus pentru a duce remorca acolo unde doriţi."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Conduceţi până la barieră."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Opriţi înainte de barieră."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Rotiţi volanul strâns spre partea şoferului înainte de a vă deplasa. În acest fel, veţi începe să îndreptaţi remorca spre locul de parcare imediat ce începeţi să daţi cu spatele, economisind spaţiu util."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Odată ce aveţi remorca îndreptată spre direcţia dorită, aduceţi capul tractor în faţa remorcii şi începeţi virarea acesteia în locul de parcare."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "De-acum înainte, nu este aşa de diferit faţă de o manevră obişnuită de parcare."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continuaţi să daţi cu spatele şi fiţi atenţi la ambele părţi. Menţineţi capul tractor şi remorca aliniate cu locul de parcare."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Opriţi în zona desemnată, securizaţi camionul şi opriţi motorul."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Sunteţi într-un loc de parcare, dar la dreapta, mai este un alt loc de parcare spre care trebuie să vă mutaţi.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "În faţă este o zonă marcată.<br><br><font face=/font/big_bold.font>Mergeţi înainte. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Nu uitaţi să începeţi să viraţi imediat, fiindcă nu aveţi prea mult spaţiu.<br><br><font face=/font/big_bold.font>Mergeţi cu spatele până la locul parcat din spate. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Condusul prin Viraje Simple"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "În acest scenariu, veţi parcurge un scurt traseu de instruire ce vă va ajuta să învăţaţi manevrarea remorcii la efectuarea de viraje simple la 90 de grade."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Efectuarea Primului Viraj"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Al Doilea Viraj"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Ultimul Viraj"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Înainte sunt câteva viraje strânse cu puţin spaţiu la dispoziţie. Aceste viraje vă vor ajuta să învăţaţi manevrarea remorcii în mod eficient."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Urmaţi marcajele de pe drum către bariera de pe partea şoferului pentru pregătirea primului viraj."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Ţineţi aproape de bariera de pe exterior de-a lungul virajului şi remorca ar trebui să vă urmeze cu bine în traseu."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Continuaţi să urmaţi marcajele de pe drum pentru a vă pregăti pentru al doilea viraj, unul strâns la 90 de grade."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Va trebui să intraţi adânc în viraj pentru a vă asigura că remorca trece de barierele de pe interior. Folosiţi oglinda frontală pentru a vă ajuta să intraţi cât de mult puteţi în viraj fără a lovi nimic."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continuaţi de-a lungul barierei de pe exterior."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Încă o dată, un alt viraj strâns la 90 de grade va necesita folosirea întregului spaţiu disponibil."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Opriţi în zona desemnată şi securizaţi camionul."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Nu uitaţi să folosiţi tot spaţiul disponibil pentru a vă ajuta să negociaţi fiecare viraj.<br><br><font face=/font/big_bold.font>Începeţi şi urmaţi marcajele de pe drum spre exterior. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Urmaţi bariera de pe exterior, dar ţineţi un ochi şi în oglindă la remorcă.<br><br><font face=/font/big_bold.font>Efectuaţi primul viraj. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Urmaţi marcajele de pe drum pentru a vă pregăti pentru virajul la 90 de grade din faţă.<br><br><font face=/font/big_bold.font>Efectuaţi virajul la 90 de grade. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Ţineţi camionul larg după viraj, deoarece urmează un alt viraj şi mai strâns la 90 de grade.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Continuaţi spre locul de parcare din faţă. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Parcare în Diagonală la Mersul cu Spatele"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "În acest scenariu, vom explora parcarea în diagonală în timp ce daţi cu spatele. Această manevră poate fi întâlnită în zonele de odihnă, în parcările de camioane şi chiar la transportatori. Adesea există puţin spaţiu deoarece parcările sunt aglomerate de camioane, astfel încât parcarea este cu atât mai dificilă din cauza lipsei de spaţiu."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Întoarcerea Remorcii"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Parcarea în diagonală pare mai facilă la prima vedere, dar poate fi adesea mai dificilă decât manevra standard „mersul cu spatele din alee”."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Daţi cu spatele spre locul de parcare. Menţineţi capul tractor şi remorca drepte pentru moment."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Pe măsură ce o dirijaţi, lăsaţi remorca să se apropie de camioanele parcate. Acest fapt va ajuta la virarea acesteia în locul de parcare atunci când ajungeţi la el."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Începeţi să viraţi remorca în locul de parcare. Ţineţi remorca aproape de camionul de pe partea şoferului, deoarece veţi avea nevoie de spaţiu pe cealaltă parte."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Odată ce remorca este bine orientată în locul de parcare, începeţi să viraţi capul tractor pentru a urmări remorca."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parcaţi în zona desemnată, securizaţi camionul şi opriţi motorul."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parcaţi camionul în spaţiul din spatele dvs. Folosiţi ambele oglinzi pentru a naviga în timp ce mergeţi cu spatele.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Verificaţi împrejurimile, apoi îndreptaţi-vă spre locul de parcare.<br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Începeţi să mişcaţi remorca spre camioanele de lângă dvs. Când sunteţi gata, viraţi remorca în locul de parcare. Nu uitaţi să ţineţi cont de pendularea remorcii.<br><br><font face=/font/big_bold.font>Viraţi în locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Mersul cu Spatele într-un Viraj"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "În acest scenariu, veţi merge cu spatele cu o remorcă într-un viraj pentru prima dată. Veţi explora principiile de bază ale mersului cu spatele şi la ce trebuie să fiţi atenţi atunci când efectuaţi un viraj în marşarier."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Întoarcerea Remorcii"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "În acest scenariu, va trebui să daţi cu spatele spre locul de parcare din spatele dvs. de pe partea şoferului."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Sunt câteva sfaturi de reţinut ce vă vor ajuta foarte mult la mersul cu spatele al remorcilor. <br>Primul este că remorca va vira întotdeauna în direcţia opusă celei în care viraţi capul tractor."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Al doilea este că vă puteţi face o idee bună despre direcţia în care se îndreaptă remorca urmărind axele camionului şi ale remorcii."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Al treilea, corecţii minore vă vor duce acolo unde trebuie să ajungeţi, nu este nevoie să exageraţi."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Începeţi să îndepărtaţi uşor capul tractor de locul de parcare, iar remorca va începe să fie îndreptată spre acesta."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Urmaţi remorca, făcând ajustări pe parcurs pentru a o menţine pe direcţia corectă."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Urmăriţi roţile remorcii şi roata din spate a capului tractor. Acestea vă vor indica unde este îndreptată remorca şi unde o împinge capul tractor."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Un al patrulea sfat este că mereu este mai uşor să viraţi remorca strâns decât să o îndreptaţi din poziţia de jackknife. Vizaţi exteriorul locului de parcare până când sunteţi aproape de acesta, apoi puteţi vira puţin mai strâns pentru a alinia remorca."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Când remorca intră în locul de parcare, aduceţi capul tractor în faţa remorcii. Încercaţi să nu faceţi prea multe ajustări în locul de parcare."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Daţi cu spatele printre bariere, verificând ambele părţi pe parcurs."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Securizaţi camionul şi opriţi motorul."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Ţineţi minte aceste sfaturi atunci când daţi cu spatele o remorcă printr-un viraj:<br><br>— Remorca va lua o direcţie inversă faţă de cea pe care o aplicaţi capului tractor<br><br>— Urmăriţi roţile remorcii pentru a vedea spre unde sunt îndreptate<br><br>— Urmăriţi roata din spate a capului tractor pentru a vedea unde împinge remorca<br><br>—Lăsaţi remorca să îşi continue mişcarea, nu o dirijaţi prea mult<br><br>— Mereu este mai uşor să viraţi remorca strâns decât să o îndreptaţi<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Uitaţi-vă în spatele dvs. pentru a şti unde trebuie să mergeţi. Verificaţi întotdeauna împrejurimile înainte de a merge cu spatele.<br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele spre locul de parcare. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Îndreptaţi remorca spre locul de parcare şi continuaţi manevra.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Opriţi în locul desemnat. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Parcare cu Spatele Într-un Spaţiu Strâns"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "În acest scenariu, veţi avea sarcina de a da cu spatele remorca într-un loc de parcare dintr-o parcare aglomerată."

#### 3_18 goal


	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Întoarcerea Remorcii"
#!{
	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Aceasta este o parcare tipică de camioane. Camionagii vor întâlni acest tip de manevră de parcare aproape zilnic în cariera lor.<br>Parcarea aici necesită manevra „parcare pe alee”."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Aceasta este o manevră similară cu scenariul anterior, dar veţi avea mai puţin spaţiu de manevră, aşa că va trebui să vă planificaţi mişcările în consecinţă şi să aveţi grijă să nu loviţi nimic."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Deoarece spaţiul este redus, sincronizarea este mai importantă. Întoarceţi remorca la momentul potrivit şi urmăriţi roţile capului tractor şi ale remorcii pentru a vedea unde vor merge. Ţineţi cont de pendularea remorcii şi să nu ajungeţi în poziţia de jackknife - continuaţi să împingeţi remorca."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Încercaţi să ţineţi aproape de camionul de pe partea şoferului, aceasta oferă remorcii spaţiu de manevră şi veţi avea mai puţine griji în privinţa camionului de pe partea pasagerului."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Odată ce remorca este pe poziţie, aduceţi capul tractor în faţa ei. Este bine să faceţi acest lucru mai devreme decât instinctul v-ar putea face să credeţi în mod iniţial. Puteţi oricând corecta în timp ce mergeţi cu spatele spre poziţia finală."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Aduceţi capul tractor şi remorca în linie dreaptă şi opriţi în zona desemnată."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Securizaţi camionul şi opriţi motorul."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Acum vom încerca întoarcerea remorcii într-o zonă mai redusă cu manevra „mersul cu spatele din alee”. <br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Verificaţi împrejurimile şi căutaţi locul de parcare din spatele dvs. <br><br><font face=/font/big_bold.font>Începeţi să daţi cu spatele spre locul de parcare. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Viraţi remorca în locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Ultimul Examen (Partea a 1-a)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Urmează examenul final, unde toate abilităţile pe care le-aţi învăţat din scenariile anterioare vor fi puse la încercare. Vom face un tur al întregului centru de formare pentru a vedea cât de bine aţi învăţat situaţiile pe care le-aţi întâlnit până acum.<br><br>După ce aţi finalizat toate manevrele şi secţiunile, veţi fi cu un pas mai aproape de a vă numi un camionagiu calificat!"

