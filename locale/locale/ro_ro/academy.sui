#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Bine aţi venit la prima parte a examenului final. Aici, vom vedea cât de bine aţi învăţat să conduceţi camionul după timpul petrecut la Academie."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Mai întâi veţi ataşa remorca. Odată cuplată, veţi conduce camionul pe întreaga zonă de testare."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Prima secţiune a traseului duce din mica parcare la traseul de testare estic."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Circuitul include treceri provocante printre bariere."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "O parte semnificativă a traseului trece prin traseul de testare estic."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Vă vom testa abilitatea de manevrare a camionului prin diferite situaţii."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Veţi manevra camionul prin câteva viraje strânse."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Veţi conduce prin secţiunea de drum ce conectează traseele."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Ultima parte prevede condusul prin circuitul mic."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Circuitul are multiple pasaje complicate şi viraje ascuţite."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Pentru a finaliza testul va trebuie să parcaţi cu acurateţe."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nu trebuie să aveţi emoţii, aţi învăţat deja tot ceea ce va fi necesar pentru a trece.<br><br>Mult noroc!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "În faţă este remorca.<br><br><font face=/font/big_bold.font>Conduceţi spre remorcă. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Aliniaţi capul tractor cu remorca.<br><br><font face=/font/big_bold.font>Daţi cu spatele şi conectaţi-vă cu pivotul. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Securizaţi camionul. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Apăsaţi @@imv_nrm_attach@@<font face=/font/big_bold.font> pentru a conecta remorca. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Remorca este conectată şi camionul este gata de condus.<br><br><font face=/font/big_bold.font>Eliberaţi frâna de staţionare. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Începeţi să conduceţi spre ieşirea din parcare. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Urmaţi marcajele de pe drum şi fiţi atenţi la bariere.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Urmează o secţiune mai dificilă.<br><br><font face=/font/big_bold.font>Navigaţi cu atenţie printre bariere. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Această parte vă va testa abilităţile de manevrare a remorcii în diferite tipuri de viraje.<br><br><font face=/font/big_bold.font>Viraţi către traseu. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Conduceţi prin pasaj. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Ţineţi drept. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Negociaţi cu atenţie virajul. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Intraţi într-o secţiune mai complexă. Conduceţi cu atenţie.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi în pantă. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Efectuaţi un viraj strâns la stânga. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Părăsiţi circuitul. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Intraţi într-o secţiune mai uşoară.<br><br><font face=/font/big_bold.font>Continuaţi să coborâţi dealul. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Continuaţi să conduceţi pe drum. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Înainte este virajul spre următorul traseu.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Viraţi la dreapta. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Continuaţi să conduceţi prin traseu. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Înainte sunt încă alte viraje strânse.<br><br><font face=/font/big_bold.font>Adaptaţi-vă viteza în consecinţă. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Efectuaţi un viraj la stânga. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Intraţi în viraj, continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Pentru a efectua virajul, este posibil să fie necesar să ieşiţi uşor de pe carosabil.<br><br><font face=/font/big_bold.font>Viraţi cu grijă, folosiţi-vă de cât spaţiu este nevoie. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Ieşiţi din circuit şi conduceţi în locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Ultimul Examen (Partea a 2-a)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Ultima parte a examenului final vă aşteaptă, unde abilităţile de parcare pe care le-aţi învăţat în scenariile anterioare vor fi evaluate. Parcaţi atent şi precis şi veţi fi pregătiţi să porniţi pe drumurile din Europa ca un camionagiu priceput!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manevra Decalată"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Parcarea în Diagonală"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Condusul prin Parcare"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parcarea Paralelă"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Parcarea Finală"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Bine aţi venit la a doua parte a examenului final. Ne vom deplasa spre o parcare din apropiere, unde vă vor fi testate abilităţile de mers cu spatele şi de manevrare în locurile de parcare."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Câteva provocări de parcare consecutive vă aşteaptă pentru a vă evalua abilităţile."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Spaţiul este limitat aici, aşa că aveţi grijă şi nu vă grăbiţi."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Nu uitaţi să fiţi atenţi şi să nu vă grăbiţi. Este în regulă dacă nu reuşiţi din prima încercare, important este să nu avariaţi camionul sau pe celelalte din jur. <font face=/font/big_bold.font><br><br>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Mergeţi înainte spre prima parte a examenului.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Prima sarcină este demonstrarea unei manevre de parcare decalată. Locul în care trebuie să daţi cu spatele cu remorca este pe stânga.<br><br><font face=/font/big_bold.font>Efectuaţi o manevră de parcare decalată.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Următoarea sarcină este să daţi cu spatele într-un rând de camioane staţionate. Aveţi grijă să nu loviţi celelalte camioane!<br><br><font face=/font/big_bold.font>Efectuaţi o manevră de parcare în diagonală.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Continuaţi prin parcare. Atenţie la situaţii neprevăzute.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Acum, veţi încerca o parcare paralelă între cele două camioane de lângă bordura din faţa dvs.<br><br><font face=/font/big_bold.font>Efectuaţi o manevră de parcare paralelă.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "O ultimă manevră de parcare în stânga! Aceasta poate fi abordată după cum preferaţi.<br><br><font face=/font/big_bold.font>Daţi cu spatele în zona desemnată.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Aproape gata. Părăsiţi zona de testare şi parcaţi camionul.<br><br><font face=/font/big_bold.font>Ieşiţi din zona de testare prin stânga.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Camionul poate fi parcat pe dreapta lângă celelalte.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parcarea Paralelă cu o Remorcă"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "În acest scenariu, vom analiza parcarea paralelă cu remorca ataşată."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Oprirea în Zona Marcată"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parcarea paralelă cu o remorcă este o aptitudine relevantă pentru toţi camionagiii.<br>Fie că parcaţi pe o stradă dintr-un oraş mare sau opriţi la o zonă de odihnă rurală, este ceva ce fiecare camionagiu ar trebui să ştie cum se face."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Când treceţi pe lângă locul de parcare, priviţi cu atenţie pentru a vă asigura că aveţi spaţiu suficient pentru capul tractor şi remorcă. Aici traseul oferă suficient spaţiu."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Aliniaţi-vă cu camionul din faţa locului de parcare. Nu vă poziţionaţi prea aproape de el, păstraţi ceva distanţă ca să aveţi spaţiu de manevră."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Viraţi brusc departe de locul de parcare şi începeţi mersul cu spatele. Ideea este ca remorca să intre imediat în locul de parcare."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Odată ce remorca este bine orientată în locul de parcare, puteţi continua manevra."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Începeţi să viraţi remorca departe de bordură înainte ca roţile remorcii de pe partea şoferului să fi intrat în locul de parcare."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Îndreptaţi capul tractor în raport cu remorca şi poziţionaţi-le către mijlocul locului de parcare.<br>Parcaţi, opriţi motorul şi securizaţi camionul."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Puteţi vedea locul de parcare din faţă, dintre celelalte camioane. În timpul manevrei de parcare, folosiţi-vă de oglinzi şi menţineţi o distanţă de siguranţă între camion şi obstacolele din jur.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Conduceţi prin parcare pentru a vă găsi locul de parcare.<br><br><font face=/font/big_bold.font>Mergeţi înainte. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Treceţi de locul de parcare dorit şi opriţi în zona marcată. De aici, puteţi începe manevra de mers cu spatele.<br><br><font face=/font/big_bold.font>Opriţi în locul marcat. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Îndepărtaţi capul tractor de acel loc pentru a da cu spatele cu remorca în el. Nu viraţi prea brusc, sau vă veţi îndrepta spre bordură. <br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Aliniaţi remorca în raport cu acel loc. Dacă este necesar, deplasaţi-vă înainte sau înapoi în timp ce efectuaţi manevrele de virare necesare pentru a vă ajusta poziţia.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Felicitări, aţi finalizat cu succes examenele pentru Bazele Condusului Camionului şi aţi învăţat toate abilităţile necesare pentru manevrarea adecvată a camionului."

	key[]: "aca_msg_book1_outro02"
	val[]: "Acesta este primul pas în călătoria dumneavoastră către realizarea visului de a deveni şofer profesionist de camion."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Acum sunteţi gata să porniţi pe drumurile din Europa şi să înfruntaţi primele provocări..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...dar aventura de-abia acum începe."
#@}


