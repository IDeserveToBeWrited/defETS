#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Bine aţi venit la examenul final. Vi s-au pregătit câteva situaţii realiste pe care le-aţi putea întâlni pe şosea pentru a observa modul în care le puteţi gestiona. Ca întotdeauna, nu vă grăbiţi şi fiţi precişi. <br><br>Mult noroc!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Drumul din faţă este blocat, întorceţi-vă în spaţiul prevăzut."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Continuaţi pe traseu."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Atingeţi o viteză de cel puţin 60 km/h (37 mph) pe măsură ce vă îndreptaţi spre centrul oraşului."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Pregătire pentru frânare."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Nu aţi reuşit să atingeţi o viteză de 60 km/h (37 mph)."

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Continuaţi să conduceţi prin traseu."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Este rezervat un loc de parcare pentru dvs. în rândul de camioane din dreapta. Mergeţi cu spatele şi parcaţi."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Continuaţi înainte când sunteţi gata."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

