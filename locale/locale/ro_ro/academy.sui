#### double_90 common

	key[]: "aca_scenario_book3_double_90_title"
	val[]: "Viraje la 90 de Grade"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "În acest scenariu, veţi avea sarcina de a conduce printr-un traseu cu viraje la 90 de grade cu dificultate variabilă."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Pornire"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "În Continuare"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Utilizaţi Oglinzile"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Aveţi Spaţiu Îndeajuns"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Pregătire"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Planificare din Timp"

#!{
