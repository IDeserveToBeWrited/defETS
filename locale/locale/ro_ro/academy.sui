#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Competenţele Condusului Camionului"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Bine aţi revenit la @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Următoarele scenarii reprezintă următorul pas în călătoria dvs. către şofatul profesionist de camioane."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "De data aceasta, nu veţi fi ghidaţi prin fiecare sarcină, aşa că depinde de dvs. să vă puneţi la lucru abilităţile şi experienţa."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Este posibil să întâlniţi manevre familiare, dar de data aceasta în medii noi create pentru a semăna mai mult cu scenariile din lumea reală."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "O noutate pentru @@driving_academy@@ este adăugarea de condiţii „de Trecere” şi „Bonus”."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Ca şi înainte, va trebuie să finalizaţi fiecare scenariu fără a lovi nimic, parcând cu succes şi securizând camionul..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...dar acum va trebui să faceţi acest lucru în limita de timp alocată şi cu o limită în ceea ce priveşte numărul schimbărilor de direcţie între mersul înainte şi mersul cu spatele."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Condiţiile bonus pot fi îndeplinite prin finalizarea fiecărui scenariu în condiţii şi mai dificile..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...cum ar fi limite de timp mai stricte, mai puţine schimbări de direcţie şi utilizarea exclusivă a camerei de interior."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Prin finalizarea tuturor scenariilor, chiar vă puteţi considera un camionagiu competent şi gata de orice încercare de pe drum.<br><br>Pentru a vă provoca şi mai mult, îndepliniţi toate condiţiile bonus pentru fiecare scenariu; atunci veţi fi cu adevărat o vedetă a şofatului de camioane!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "În acest scenariu tutorial vă vom ajuta să vă familiarizaţi cu noile caracteristici din Competenţele Condusului Camionului."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "La startul fiecărui scenariu, veţi vedea o fereastră de <color value=@@clr_sel@@>„Scenariu Informativ”<color value=@@clr_txt@@>. Aceasta vă va oferi informaţii despre noile condiţii „de Trecere” şi „Bonus” pentru scenariu. <br><br>Condiţiile „de Trecere” trebuiesc îndeplinite pentru a finaliza scenariul cu succes, în timp ce condiţiile „Bonus” sunt o provocare opţională suplimentară pentru jucătorii experimentaţi şi pricepuţi. <br><br><font face=/font/big_bold.font>Pentru a continua, porniţi contactul.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Una dintre condiţiile bonus necesită finalizarea scenariului doar utilizând <color value=@@clr_sel@@>Camera de Interior<color value=@@clr_txt@@>. Încă veţi putea să utilizaţi camerele de exterior pentru a verifica împrejurimile, dar doar atunci când camionul este oprit.<br><br>\nPuteţi să vă uitaţi acum în jur pentru a vă orienta, apoi să comutaţi înapoi la camera din interior.<br><br><font face=/font/big_bold.font>Comutaţi la camera de urmărire pentru a verifica împrejurimile</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Orientaţi-vă, apoi comutaţi înapoi la camera din interior.<br><br><font face=/font/big_bold.font>Priviţi în jurul camionului</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Comutaţi înapoi la camera din interior</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Timpul<color value=@@clr_txt@@> va fi, de asemenea, un factor în Competenţele Condusului Camionului. Toate scenariile vor avea o limită de timp individuală în care fiecare va trebui finalizat drept condiţie „de Trecere”, iar multe vor avea şi o limită suplimentară, mai strictă, drept condiţie „Bonus”.<br><br>Cronometrul porneşte numai după ce camionul se pune în mişcare.<br><br><font face=/font/big_bold.font>Porniţi motorul şi eliberaţi frâna de staţionare pentru a continua.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "O altă noutate pentru Competenţele Condusului Camionului o reprezintă reperele. Toate reperele vor trebui atinse înainte ca scenariul să poată fi finalizat. <br><br>În plus, reperele sunt influenţate de direcţia în care camionul este îndreptat în momentul atingerii reperului, aşa că va trebui să fiţi atenţi la orice marcaj rutier din apropierea reperului pentru a vă orienta corect.<br><br><font face=/font/big_bold.font>Conduceţi înainte spre reperul din faţă.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Aţi ajuns la reper şi puteţi trece acum la pasul următor. <br><br>În spatele dvs. este un alt reper, în care va trebui să intraţi cu spatele. Observaţi săgeata de pe sol ce indică direcţia în care ar trebui să fie orientat camionul când ajungeţi la reper. <br><br>O altă condiţie „de Trecere” şi „Bonus” ce trebuie luată în considerare este <color value=@@clr_sel@@>Schimbări de Direcţie<color value=@@clr_txt@@>. \nSe va număra de câte ori schimbaţi direcţia între mersul înainte şi mersul cu spatele. Rămâneţi sub limită pentru a îndeplini condiţia.<br><br><font face=/font/big_bold.font>Mergeţi cu spatele spre reper şi opriţi.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Deci, până acum, ar fi trebuit să acumulaţi una schimbare de direcţie. <br><br>Ataşaţi remorca din spatele dvs. pentru a continua către pasul următor. <br><br><font face=/font/big_bold.font>Daţi cu spatele sub remorcă pentru a o ataşa.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Ultima zonă de parcare este în dreapta. Anumite scenarii pot avea doar un singur loc de parcare, în timp ce altele vor avea multiple din care veţi putea alege. Parcând corect în oricare dintre aceste locuri vă va permite finalizarea scenariului. <br><br><font face=/font/big_bold.font> Apăsaţi @@imv_nrm_attach@@ pentru a conecta remorca. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Locurile de parcare indică şi direcţia în care camionul ar trebui să fie orientat la acel moment. Parcaţi în direcţia greşită şi nu veţi mai putea finaliza scenariul înainte de a vă corecta, costând timp şi schimbări de direcţie.<br><br><font face=/font/big_bold.font>Conduceţi către unul dintre locurile de parcare şi parcaţi corect.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Competenţele Condusului Camionului"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Ar trebui să fiţi familiarizaţi cu noii parametri de Condiţii de Trecere şi Obiective Bonus şi să fiţi pregătiţi să abordaţi noile scenarii din Competenţele Condusului Camionului!<br><br><font face=/font/big_bold.font>Securizaţi camionul prin aplicarea frânei de staţionare şi oprirea motorului pentru a finaliza scenariul.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Scurtătură"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "În acest scenariu veţi încerca să folosiţi o scurtătură ce, din păcate, este blocată la capăt. Va trebui apoi să mergeţi cu spatele pe drumul pe care aţi venit."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Conduceţi până la reperul din vârful dealului şi apoi mergeţi cu spatele înapoi jos. <br><br>Odată reveniţi pe drum, conduceţi până la zona de parcare finală."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Persoană Matinală"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "În acest scenariu va trebui să vă croiţi drum printr-o parcare supraaglomerată. Spaţiul este extrem de limitat, aşa că încercaţi să vă planificaţi mişcările în avans."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Există momente în care parcarea este atât de limitată, încât alţi şoferi vor parca pe unde pot pe parcursul nopţii. Acest lucru poate face destul de dificilă manevrarea în jurul lor dimineaţa.<br><br> Faceţi tot ce puteţi ca să vă croiţi drum prin parcare până la ultimul loc de parcare."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Întortocheat"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "În acest scenariu aveţi sarcina să conduceţi printr-un traseu de instruire foarte complex. De-a lungul drumului, va trebui să găsiţi şi să conectaţi o remorcă, apoi să o aduceţi cu dvs. până la final."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Acest scenariu vă va testa vigilenţa spaţială şi situaţională. Traseul din faţă este plin de obstacole pe care nu le veţi putea descoperi întotdeauna cu uşurinţă."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Faceţi-vă drum prin traseu până la remorcă. După ce aţi localizat-o, conectaţi-vă la ea şi transportaţi-o până la locul de parcare final."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Vertij"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "În acest scenariu vă vom pune la încercare abilităţile de manevrare. Conduceţi roată şi roată până când ajungeţi la final!"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "Este timpul să vă puneţi la încercare abilităţile de manevrare a camionului; acest traseu a fost conceput pentru a vedea cât de bine vă cunoaşteţi camionul!"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "Elementul central este o spirală lungă, ce vă va testa capacitatea de a manevra camionul de-a lungul unor curbe ample."

#@}




#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Parcare cu Spatele După un Viraj"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "În acest scenariu va trebui să mergeţi cu spatele de-a lungul unui viraj pe partea „în orb” şi într-un loc de parcare."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Zonele de descărcare nu sunt mereu într-un loc optim. În acest caz, aceasta este ascunsă vederii de clădirea de lângă dvs."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Mergeţi cu spatele în jurul clădirii şi în locul de parcare."

#@}



#+ Book 2 depot_options
#@{
#### common
	key[]: "aca_scenario_book2_depot_options_title"
	val[]: "Parcare la Punctul de Lucru"

	key[]: "aca_scenario_book2_depot_options_desc"
	val[]: "În acest scenariu aveţi sarcina să parcaţi camionul într-unul din cele trei locuri de parcare diferite, fiecare necesitând manevre unice."

#### intro text

	key[]: "aca_scenario_book2_depot_options_cutscene1"
	val[]: "Sunt disponibile trei locuri de parcare diferite, ce variază în dificultate. Alegeţi unul, conduceţi până la acesta şi daţi cu spatele înăuntru după cum consideraţi."


#@}

#+ Book 2 night_parallel
#@{
#### common
	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Parcarea Paralelă Noaptea"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "În acest scenariu va trebui să parcaţi în paralel lângă o bordură. Este noapte, deci vizibilitatea va fi limitată."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Timpul şi vremea nu sunt întotdeauna ideale atunci când, în sfârşit trebuie să parcaţi pentru noapte, aşa că va trebui să acordaţi o atenţie sporită împrejurimilor.<br><br>Nu uitaţi să aprindeţi farurile!"

#@}

#+ Book 2 slalom_nt
#@{
#### common
	key[]: "aca_scenario_book2_reverse_slalom_nt_title"
	val[]: "Slalom cu Spatele"

	key[]: "aca_scenario_book2_reverse_slalom_nt_desc"
	val[]: "În acest scenariu aveţi sarcina de a negocia o serie de slalomuri interconectate în marşarier."

#### intro text

	key[]: "aca_scenario_book2_reverse_slalom_nt_cutscene1"
	val[]: "În spatele dvs. este un traseu alcătuit din câteva secţiuni de slalom."

	key[]: "aca_scenario_book2_reverse_slalom_nt_cutscene2"
	val[]: "Mergeţi cu spatele prin fiecare secţiune până la zona finală de parcare."

#@}


#+ Book 2 reverse_slalom_nt
#@{
#### 3_21 common
	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Slalom Dublu"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "În acest scenariu va trebui să negociaţi un scurt traseu compus din două slalomuri conectate."

#### slalom_nt intro text

	key[]: "aca_scenario_book2_slalom_nt_cutscene1"
	val[]: "Acest scenariu este compus din două slalomuri conectate. Conduceţi prin primul slalom fără a lovi vreun con şi, la final, efectuaţi o întoarcere în „U”."

	key[]: "aca_scenario_book2_slalom_nt_cutscene2"
	val[]: "De acolo, continuaţi prin al doilea slalom către zona finală de parcare.<br><br>Veţi fi contra-timp, deci conduceţi cu hotărâre şi cu prudenţă!"

#@}


