#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parcare Aproape de un Obstacol"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "În acest scenariu, veţi învăţa să parcaţi aproape de o bordură folosind oglinda laterală."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Verificarea Oglinzii Laterale"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Condusul Spre Bordură"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Oglinda laterală este un alt dispozitiv ce vă va ajuta să manevraţi camionul în siguranţă. Aceasta este amplasată pe rama de sus a uşii pasagerului."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Conduceţi înainte şi viraţi încet spre partea pasagerului."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Aceste scânduri de lemn reprezintă o bordură. Va trebuie să parcaţi lângă ea. <br>Viraţi spre bordură pentru a aduce camionul într-o poziţie bună pentru alinierea cu locul de parcare."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Încetiniţi cu mult înainte de bordură şi viraţi spre locul de parcare. Pe măsură ce îndreptaţi direcţia, puteţi utiliza oglinda laterală pentru a evalua distanţa faţă de bordură."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Opriţi în locul de parcare şi securizaţi camionul."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Uitaţi-vă prin geamul pasagerului. Puteţi privi astfel în oglinda laterală.</font>@@aca_goal_tip@@ Trebuie să fiţi în interiorul vehiculului."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Oglinda laterală reflectă zona de pe partea pasagerului pe care şoferul nu o poate vedea. Este unul dintre cele mai problematice unghiuri moarte ale camionului. Dacă unghiul oglinzii nu este adecvat, poate fi reglat din '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Camionul nu este gata de drum, poate aţi uitat ceva?<br><br>Este motorul pornit? Aţi eliberat frâna de staţionare?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "În faţă, aveţi o linie de scânduri reprezentând o bordură. La capătul bordurii este un loc de parcare. Va trebui să conduceţi până acolo. <br><br><font face=/font/big_bold.font>Continuaţi când sunteţi gata. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Viraţi spre bordură. Folosiţi oglinda frontală şi laterală pentru a verifica poziţia faţă de bordură, dar asiguraţi-vă şi că nu loviţi vreun con de trafic.<br><br><font face=/font/big_bold.font>Înaintaţi spre bordură şi în locul de parcare.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Securizaţi camionul şi opriţi motorul.</font>@@aca_goal_tip@@ Puteţi utiliza comenzile prestabilite Privire Interior pentru a vedea oglinzile mai bine. Consultaţi Opţiunile - „@@options_bindings_screen@@” - pentru a vedea şi/sau schimba comenzile respective."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parcarea cu Spatele Aproape de un Obstacol"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "În acest scenariu, veţi merge cu spatele, cu camionul, într-un loc de parcare aproape de o bordură."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instrucţiuni"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Mersul cu Spatele spre Bordură"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parcarea Camionului"
#!{
	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"


 #!}
#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "În acest scenariu, veţi efectua o manevră de parcare cu spatele, aproape de o bordură."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Mergeţi cu spatele spre bordură.<br>Trebuie să fiţi atenţi la împrejurimi atunci când daţi înapoi, aşa că folosiţi oglinzile."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Pe măsură ce vă apropiaţi puteţi începe să aliniaţi camionul cu locul de parcare. Fiţi atenţi la ambele părţi ale camionului în timp ce daţi cu spatele."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Opriţi în locul de parcare şi securizaţi camionul."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Locul de parcare este în spatele dvs. spre partea pasagerului. Folosiţi-vă de oglinzi pentru a naviga spre locul de parcare.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Nu uitaţi să folosiţi oglinzile pentru a verifica împrejurimile înainte de a vă deplasa cu camionul.<br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele spre bordură. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continuaţi să monitorizaţi împrejurimile în timp ce mergeţi cu spatele în locul de parcare.<br><br><font face=/font/big_bold.font>Opriţi la locul desemnat. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Traseu Avansat de Instruire"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Ultimul scenariu din acest capitol implică un condus pe un traseu avansat de instruire. Vă vom pune la încercare aptitudinile pe care le-aţi deprins cu un cap tractor!"

#### 2_06 goal



	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_check1"
