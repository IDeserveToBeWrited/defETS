	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Parcarea în Diagonală cu remorci duble"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "În acest scenariu, veţi parca o combinaţie de remorci duble pe un loc de parcare în diagonală dintr-o parcare aglomerată. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Astfel de locuri de parcare în diagonală sunt destul de frecvente. Acestea sunt în special frecvente în numeroasele zone de odihnă de pe drumurile europene."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Conduceţi spre locul de parcare desemnat aproape de capătul rândului."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Rămâneţi pe exteriorul benzii, dar nu foarte aproape de bariere, deoarece partea din spate a remorcii le poate lovi în timpul virajului."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Treceţi pe lângă locul de parcare pentru a face loc ambelor remorci să vă urmeze. Apoi trageţi repede spre partea îndepărtată a locului de parcare pentru a aduce prima remorcă în poziţie."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Îndreptaţi-vă, apoi opriţi în zona desemnată şi securizaţi camionul."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Continuaţi spre capătul rândului şi căutaţi-vă locul de parcare."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Treceţi pe lângă locul de parcare pentru a vă asigura că remorca din spate va intra corect în acel spaţiu, apoi viraţi strâns în timp ce vă asiguraţi că partea frontală a remorcii principale nu intră în coliziune cu camionul de lângă dvs."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Continuaţi încet în timp ce îndreptaţi combinaţia, apoi opriţi în zona desemnată."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


