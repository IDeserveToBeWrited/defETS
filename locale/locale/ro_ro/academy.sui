	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Daţi cu spatele în locul de parcare."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Opriţi în zona desemnată."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Securizaţi camionul şi opriţi motorul."
