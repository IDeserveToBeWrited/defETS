#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parcarea Paralelă"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "În acest scenariu, vom analiza parcarea paralelă între alte două camioane."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Oprirea în Faţa Locului de Parcare"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Verificarea Oglinzii Retrovizoare"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Mersul cu Spatele în Locul de Parcare"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Alinierea Camionului în Interiorul Locului de Parcare"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parcarea paralelă este o aptitudine esenţială pe care orice camionagiu ar trebui să o deprindă.<br>Pregătiţi-vă să începeţi."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Conduceţi spre locul de parcare.<br>Acordaţi atenţie împrejurimilor."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Aliniaţi-vă cu camionul din faţa locului dvs. de parcare. Nu vă poziţionaţi prea aproape de el, păstraţi ceva distanţă ca să aveţi spaţiu de manevră."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Viraţi strâns spre acel loc şi începeţi mersul cu spatele."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Atunci când vă uitaţi în oglinda de pe partea şoferului, orientaţi-vă spre bordura din faţa celuilalt camion."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Odată ce bara frontală trece de camionul din faţă, puteţi începe să viraţi partea din faţă a camionului în locul de parcare, aliniind camionul cu locul de parcare."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Îndreptaţi roata şi poziţionaţi camionul spre centrul locului de parcare.<br>Parcaţi şi securizaţi camionul."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Înainte sunt câteva camioane parcate. Este liber un singur loc unde puteţi parca. <br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Nu uitaţi să fiţi atenţi la împrejurimi. Utilizaţi cu atenţie oglinzile pe perioada acestei manevre. <br><br><font face=/font/big_bold.font>Mergeţi înainte. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Treceţi de locul de parcare şi continuaţi în zona marcată. De acolo, puteţi începe manevra de mers cu spatele.<br><br><font face=/font/big_bold.font>Opriţi în locul marcat. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Verificaţi împrejurimile de obstacole şi pentru a vă asigura că aveţi cale liberă să daţi cu spatele.<br><br><font face=/font/big_bold.font>Priviţi la oglinda laterală de pe partea pasagerului. </font>"


	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Viraţi roţile şi daţi cu spatele în locul de parcare.<br><br><font face=/font/big_bold.font>Începeţi mersul cu spatele. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Începeţi să îndreptaţi camionul atunci când este cazul. Nu treceţi peste bordură!<br><br><font face=/font/big_bold.font>Aliniaţi camionul cu locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_01
