#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Pentru ultimul scenariu din acest capitol, veţi conduce pe un traseu de testare cu o configuraţie complexă."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Primul obstacol este un slalom printre câteva bariere. Conduceţi prin acesta şi nu uitaţi să folosiţi oglinzile."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Urmează un viraj în „ac de păr”. Ţineţi virajul larg şi nu ar trebui să aveţi vreo problemă."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Urmează un viraj de stânga la 90 de grade. Nu uitaţi să intraţi adânc în viraj pentru ca spatele camionului să evite barierele de pe interior."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Obstacolul din rampă poate fi cam dificil. Aliniaţi-vă cât de bine puteţi înainte de a conduce pe aceasta şi folosiţi oglinda frontală şi laterală pentru a ajuta la orientare."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Următoarea secţiune trebuie efectuată cu mersul cu spatele. Apropiaţi-vă de barierele din faţă ţinând cont de acest lucru."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Urmaţi marcajele de pe drum din înapoi şi spre dreapta."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Mergeţi cu spatele până la bariere, apoi opriţi şi continuaţi înainte spre stânga."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Continuaţi, prin deschiderea din zona mediană, spre următoarea secţiune."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Acest pasaj printre conuri este foarte îngust. Conduceţi încet şi folosiţi oglinzile pentru a vă orienta în interiorul pasajului."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Nu uitaţi să intraţi adânc în virajele la 90 de grade."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Intraţi pe un tronson de drum în linie dreaptă. Puteţi prinde ceva viteză, dar nu uitaţi că, în curând, va trebui să încetiniţi pentru virajul din faţă."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "La baza dealului sunt câteva bariere de-a latul drumului. Conduceţi până la ele, apoi mergeţi cu spatele în locul de parcare din stânga."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Daţi cu spatele spre locul de parcare."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parcaţi, apoi opriţi motorul şi securizaţi camionul."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "În faţă, aveţi un slalom realizat din bariere.<br><br><font face=/font/big_bold.font>Conduceţi prin slalom.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Rămâneţi pe exteriorul virajului pentru a vă asigura că spatele capului tractor nu trece peste bordură.<br><br><font face=/font/big_bold.font>Efectuaţi virajul. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Vă apropiaţi de un viraj de stânga la 90 de grade. Nu uitaţi să folosiţi tot spaţiul disponibil.<br><br><font face=/font/big_bold.font>Efectuaţi virajul. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Aliniaţi-vă cu rampa. Nu veţi avea prea mult spaţiu să faceţi corecţii o dată ce aţi ajuns pe ea.<br><br><font face=/font/big_bold.font>Conduceţi peste rampă. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Urmaţi traseul spre stânga. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Secţiunea următoare trebuie finalizată doar în marşarier. Opriţi la barierele din faţă ca să puteţi apoi da cu spatele către dreapta.<br><br><font face=/font/big_bold.font>Opriţi la bariere. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Daţi înapoi spre zona din spate şi spre dreapta. Sunt săgeţi pe drum pentru a vă ajuta.<br><br><font face=/font/big_bold.font>Mergeţi cu spatele spre următoarea secţiune. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Continuaţi mersul înapoi spre barierele din spate.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Opriţi şi treceţi într-o treaptă înainte, apoi continuaţi spre stânga. <br><br><font face=/font/big_bold.font>Mergeţi înainte. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Există o deschidere, spre stânga, în zona mediană. Treceţi prin ea.<br><br><font face=/font/big_bold.font>Continuaţi înainte. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "În faţă este un tronson îngust şi sinuos printre nişte conuri. Conduceţi cu atenţie şi folosiţi oglinzile dacă este necesar.<br><br><font face=/font/big_bold.font>Conduceţi printre conuri. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Continuaţi prin traseu.<br><br><font face=/font/big_bold.font>Viraţi la stânga. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Nu uitaţi să ţineţi stânga înainte de viraj pentru a avea cât mai mult spaţiu posibil.<br><br><font face=/font/big_bold.font>Efectuaţi virajul. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Puteţi accelera puţin aici, dar în faţă urmează un viraj.<br><br><font face=/font/big_bold.font>Continuaţi de-a lungul traseului. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Virajul devine din ce în ce mai strâns pe măsură ce înaintaţi.<br><br><font face=/font/big_bold.font>Adaptaţi viteza în consecinţă şi continuaţi.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "La baza dealului veţi vedea bariere ce blochează drumul. <br><br><font face=/font/big_bold.font>Opriţi aproape de bariere. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "În spate şi spre stânga, se află un loc de parcare.<br><br><font face=/font/big_bold.font>Daţi cu spatele în locul de parcare. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Opriţi în locul marcat. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Condusul pe Pista de Manevre"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "În acest scenariu, veţi conduce pe un traseu conceput pentru a vă testa abilitatea de manevrare a camionului prin diferite tipuri de curbe şi viraje."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Intrarea în Traseu"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Efectuarea Treptată a Virajului la Stânga"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Condusul Prin Viraje în S"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Tronson în Linie Dreaptă"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Viraje Uşoare"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Părăsirea Traseului de Instruire"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Apropierea de Locul de Parcare"
#!{
	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
#!}

#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "În acest scenariu, veţi efectua un scurt drum cu capul tractor pentru a vedea cum puneţi în practică aptitudinile nou dobândite."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Pe traseu veţi întâlni diferite tipuri şi combinaţii de viraje. Scenariul nu este o cursă şi nu este contratimp. Aveţi răbdare şi adaptaţi viteza de deplasare la virajele şi obstacolele pe care le întâlniţi."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "La început, traseul este lin şi uşor, dar virajele vor deveni din ce în ce mai complexe."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Fiţi atenţi la viteză; este uşor să mergeţi prea repede şi apoi să abordaţi greşit o curbă."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Ieşirea de pe traseu este printr-un viraj „ac de păr” strâns. Conduceţi încet şi folosiţi tot spaţiul disponibil."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parcaţi între bariere şi securizaţi camionul."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Pentru a finaliza cu succes acest scenariu va trebui să nu aveţi avarii, să nu ieşiţi de pe traseu şi să nu loviţi vreun con de trafic.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Continuaţi înainte cu virajul strâns de dreapta pentru a intra pe traseu. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Parcurgeţi virajul la o viteză constantă. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Vă apropiaţi de o secţiune mai complexă de viraje sinuoase.<br><br><font face=/font/big_bold.font>Adaptaţi viteza în consecinţă şi continuaţi.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continuaţi spre următoarea înşiruire de viraje.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Urmează câteva viraje uşoare, blânde. Menţineţi viteza constantă.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Ieşirea de pe traseu se face printr-un viraj „ac de păr” brusc. Încetiniţi şi rămâneţi pe exterior înainte de viraj. Nu uitaţi să vă folosiţi de oglinzi!<br><br><font face=/font/big_bold.font>Ieşiţi din traseu. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "În faţă aveţi un loc de parcare între câteva bariere.<br><br><font face=/font/big_bold.font>Continuaţi spre locul de parcare. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

