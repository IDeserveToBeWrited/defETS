#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Manevre Combinate de Condus"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "În acest scenariu, vom combina abilităţile nou dobândite pentru a negocia un traseu scurt, dar tehnic, ce va implica mersul cu spatele într-un viraj şi gestionarea unui viraj strâns la 90 de grade."

#### 2_02 goal



	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Mersul cu Spatele pe Partea Şoferului"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Viraj la 90 de Grade"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Finalizarea Virajului"
