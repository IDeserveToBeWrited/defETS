#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parcând în timp ce mergeţi înainte, aşa numita „cu nasul înainte” este destul de uşor în ceea ce priveşte manevrele de parcare. <br>Va trebui în continuare să compensaţi pentru deplasarea decalată a remorcii."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Va trebui să continuaţi dincolo de punctul în care, în mod normal, aţi vira doar cu capul tractor. Acest lucru vă va permite alinierea mai eficientă a remorcii."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Pe măsură ce vă apropiaţi de locul de parcare, viraţi pentru a plasa tractorul în faţa remorcii. Aliniaţi-vă şi intraţi în locul de parcare. <br>Opriţi, parcaţi, securizaţi camionul şi opriţi motorul."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "În faţă, este un loc de parcare spre care va trebuie să conduceţi şi în care va trebui să parcaţi.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Începeţi să conduceţi şi viraţi spre locul de parcare.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Treceţi de locul de parcare pentru ca remorca să fie aliniată cu zona marcată, apoi aduceţi capul tractor la locul respectiv şi îndreptaţi-vă.<br><br><font face=/font/big_bold.font>Parcaţi în zona desemnată.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Opriţi în zona desemnată.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Securizaţi camionul şi opriţi motorul.</font>"
#@}

