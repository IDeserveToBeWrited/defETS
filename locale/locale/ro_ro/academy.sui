	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}

#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "În faţă este o barieră. Conduceţi până la ea şi apoi opriţi."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "În spatele camionului, pe partea şoferului, se află o altă barieră. Daţi cu spatele prin curbă până la ea. Marcajele de pe drum pot fi folosite drept ghid."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Drept înainte, veţi întâlni un viraj brusc la 90 de grade. Continuaţi spre acesta."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Va trebui să intraţi adânc în viraj, astfel încât roţile din spate să treacă de conul de trafic de pe interior.<br>Utilizaţi oglinzile!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Îndreptaţi-vă, conduceţi spre ultimele bariere, apoi opriţi şi securizaţi camionul."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Camionul nu este gata de drum, poate aţi uitat ceva?<br><br>Este motorul pornit? Aţi eliberat frâna de staţionare?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Drept în faţă, este un loc marcat chiar înainte de barieră.<br><br><font face=/font/big_bold.font>Continuaţi şi opriţi-vă în locul marcat. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Priviţi în spate, pe partea şoferului; Acolo veţi vedea un alt loc marcat. Va trebui să combinaţi mersul cu spatele cu virarea în acelaşi timp.<br><br><font face=/font/big_bold.font>Daţi cu spatele prin viraj şi opriţi în locul marcat. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Traseul continuă în faţa dvs. printr-o curbă la 90 de grade.<br><br>Staţi pe partea şoferului înainte de viraj, intraţi adânc în acesta şi viraţi rapid şi strâns. Asiguraţi-vă să nu loviţi conul de trafic de pe interior.<br><br><font face=/font/big_bold.font>Mergeţi înainte şi efectuaţi virajul. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Folosiţi-vă de oglinda frontală şi laterală pentru a vă asigura că nu loviţi nimic.<br><br><font face=/font/big_bold.font>Efectuaţi virajul şi opriţi în zona desemnată. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Opriţi motorul şi securizaţi camionul.</font>"
#@}

