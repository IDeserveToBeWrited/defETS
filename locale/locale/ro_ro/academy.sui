	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Utilizarea exclusivă a camerei de interior - camerele exterioare pot fi încă utilizate în timpul staţionării"

	key[]: "aca_book_book2_completed_t"
	val[]: "PROMOVAT COMPETENŢELE CONDUSULUI CAMIONULUI"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Felicitări!<br><br>Aţi îndeplinit toate condiţiile de trecere din modulul Competenţele Condusului Camionului şi aţi obţinut recompense pentru profilul carieră. Încă vă mai puteţi provoca să primiţi mai multe recompense prin îndeplinirea tuturor condiţiilor bonus.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "FINALIZATE COMPETENŢELE CONDUSULUI CAMIONULUI"

