#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "În acest scenariu, veţi conduce camionul pentru o scurtă distanţă. Vă veţi familiariza cu frânarea cu o remorcă pe măsură ce coborâţi dealul din faţă. Pregătiţi camionul şi porniţi."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Atingeţi o viteză de cel puţin 60 km/h (37 mph). Pregătiţi-vă pentru zona de frânare din faţă."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Începeţi să frânaţi până la oprire. Aveţi grijă să nu aşteptaţi prea mult, pentru că aţi putea lovi barierele din faţă!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parcaţi în zona desemnată, apoi securizaţi camionul şi opriţi motorul."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "În cadrul acestei deplasări, vă veţi familiariza cu utilizarea frânei de serviciu la abordarea unei pante. Obiectivul acestui exerciţiu este conştientizarea greutăţii din spatele dvs. şi modul în care aceasta afectează distanţa de frânare a vehiculului.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Începeţi să conduceţi acum şi nu uitaţi că va trebui să atingeţi o viteză de 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Parcurgeţi virajul. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "<font face=/font/big_bold.font>Continuaţi să acceleraţi în josul dealului. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Atingeţi o viteză de cel puţin 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Aţi atins viteza necesară.<br><br><font face=/font/big_bold.font>Opriţi la bariera din faţă. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

