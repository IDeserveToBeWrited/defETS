#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Condusul prin Viraje Complexe"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "În acest scenariu, vom explora manevrarea remorcii printr-un traseu scurt cu obstacole cu viraje mai complexe."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primele Viraje"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Condusul Printr-un Pasaj Îngust"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Viraj Strâns la 90 de Grade"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

