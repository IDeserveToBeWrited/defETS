	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Condusul În Jurul Barierelor"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "În faţă aveţi o varietate de viraje complexe şi de obstacole.<br>Luaţi în considerare tot ce aţi învăţat până acum şi nu ar trebui să fie prea dificil."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Marcajele de pe drum vă pot ajuta să vă faceţi o idee despre cum să treceţi prin fiecare set de obstacole."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Menţineţi capul tractor spre exteriorul virajului. <br>Va trebui să viraţi larg, deoarece remorca urmează o traiectorie mai scurtă."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Următorul viraj este unul uşor la 90 de grade. <br> Încă o dată, ţineţi camionul pe exteriorul virajului şi folosiţi tot spaţiul disponibil."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Nu vă grăbiţi aici. Traseul devine mai deschis, dar tot va trebui să fiţi precişi."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Păstraţi distanţa în jurul barierelor."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Aveţi grijă la intrarea în această secţiune îngustă. <br>Viraţi larg capul tractor, cu mult înainte de abordare, pentru a pregăti remorca pentru intrare."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Ultimul viraj la 90 de grade este mult mai strâns decât primul, dar aveţi destul loc dacă folosiţi spaţiul inteligent."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Opriţi în zona desemnată, apoi securizaţi camionul şi opriţi motorul."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Nu uitaţi să folosiţi marcajele de pe drum pentru a vă ajuta să navigaţi traseul.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Totodată, utilizarea oglinzilor vă ajută la parcurgerea traseului în siguranţă. Trebuie să fiţi mereu conştienţi de modul în care se deplasează remorca în spatele dvs.<br><br><font face=/font/big_bold.font>Continuaţi prin primul viraj. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Fiţi atenţi la remorcă în timp ce ieşiţi din viraj şi vă pregătiţi să intraţi în următorul.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Continuaţi prin următorul viraj. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Nu uitaţi să fiţi atenţi la remorcă înainte de a vira camionul, pentru a vă asigura că nu aveţi obstacole în jur.<br><br><font face=/font/big_bold.font>Continuaţi în jurul barierei obstacol din faţă. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "După ce remorca a trecut de barieră, viraţi puternic spre partea pasagerului pentru a vă alinia pentru pasajul îngust. <br><br><font face=/font/big_bold.font>Continuaţi spre pasajul îngust.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Această secţiune necesită un condus foarte precis. Nu vă grăbiţi şi folosiţi oglinzile.<br><br><font face=/font/big_bold.font>Rămâneţi spre exteriorul fiecărui viraj. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Acest viraj este foarte strâns, dar puteţi utiliza tot spaţiul din faţă pentru a-l parcurge cu uşurinţă.<br><br><font face=/font/big_bold.font>Efectuaţi virajul final. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Traseu Avansat de Instruire - Remorcă"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "În scenariul final din Capitolul 3, veţi parcurge un traseu de instruire mai lung, cu o varietate de viraje diferite, pentru a vedea cât de bine aţi deprins manevrarea unei remorci."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Viraj tip „Şicană”"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "ELIMINAŢI ACEST OBIECTIV"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Zonă de Legătură Mediană"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Primul Slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Al Doilea Slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Viraje Uşoare"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Sens Giratoriu"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Tronson în Linie Dreaptă"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Viraj Strâns"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Ultimele Viraje"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Condusul spre Locul de Parcare"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "În acest scenariu, vă veţi confrunta cu o varietate de viraje diferite cu scopul de a vă ajuta să vă obişnuiţi să conduceţi cu o remorcă. Rămâneţi concentrat, adaptaţi viteza la fiecare situaţie şi utilizaţi la maximum spaţiul disponibil pe traseul de instruire."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Primul viraj este un viraj tip „şicană” - două viraje în unul. Va trebui să vă orientaţi pentru un viraj la stânga, dar să treceţi la un viraj la dreapta la jumătatea manevrei."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Următorul viraj vă duce pe cealaltă parte a zonei mediane. Nu este prea dificil, dar va trebui să aveţi grijă să lăsaţi spaţiu suficient pentru remorcă."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Mai departe va trebuie să abordaţi un slalom strâns printre bariere de beton. Conduceţi încet şi folosiţi oglinzile, asigurându-vă că viraţi destul de larg pentru ca remorca să poată evita barierele."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "În acest punct, veţi intra într-un alt slalom prevăzut cu conuri suplimentare la apexul fiecărui viraj.<br>Aveţi grijă să nu loviţi niciunul dintre ele!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Urmează câteva viraje uşoare în drumul spre sensul giratoriu."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Folosiţi porţiunea în linie dreaptă pentru pregăti intrarea în sensul giratoriu. Rămâneţi pe exterior înainte de a intra în acesta."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Intraţi în sensul giratoriu şi observaţi poziţia remorcii. Odată ce vă aflaţi în sensul giratoriu, aceasta va urma diferit capul tractor faţă de direcţia de la intrare."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Ieşiţi din sensul giratoriu şi continuaţi până la următorul set de viraje."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "ELIMINAŢI ACEASTĂ SECVENŢĂ"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Virajul acesta este extrem de strâns. Conduceţi încet şi folosiţi inteligent spaţiul disponibil. Ţineţi cont şi de pendularea remorcii."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Pe măsură ce parcurgeţi următoarele câteva viraje, nu uitaţi să vă pregătiţi pentru următorul viraj la ieşirea din cel anterior."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Nu vă grăbiţi în ultimul viraj. Pare uşor, dar aveţi mai puţin spaţiu de manevră decât pare."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Opriţi în zona desemnată, securizaţi camionul şi opriţi motorul."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Acceleraţi spre primul viraj. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Primul viraj este un viraj uşor în şicană.<br><br><font face=/font/big_bold.font>Efectuaţi virajul. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "ELIMINAŢI ACEASTĂ VERIFICARE"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "În faţă, traseul continuă pe partea stângă a medianei.<br><br><font face=/font/big_bold.font>Continuaţi-vă drumul prin zona de legătură. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manevraţi printre bariere şi nu uitaţi să supravegheaţi remorca.<br><br><font face=/font/big_bold.font>Conduceţi prin slalom. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Acest slalom este mai simplu, dar conurile de trafic îl fac semnificativ mai strâns.<br><br><font face=/font/big_bold.font>Conduceţi prin slalom şi evitaţi lovirea vreunui con. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Înainte sunt câteva viraje uşoare, dar va trebui să le abordaţi corespunzător pentru a ţine remorca departe de barierele de pe interior.<br><br><font face=/font/big_bold.font>Efectuaţi virajele. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Vă apropiaţi de un sens giratoriu. Nu uitaţi să lăsaţi suficient spaţiu pentru remorcă, atât la intrare şi la ieşire, cât şi în timpul deplasării prin acesta.<br><br><font face=/font/big_bold.font>Conduceţi prin sensul giratoriu. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Aveţi în faţă o scurtă porţiune în linie dreaptă, puteţi prinde ceva viteză dacă doriţi.<br><br><font face=/font/big_bold.font>Continuaţi să conduceţi. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Virajul acesta este extrem de strâns. Mergeţi încet, folosiţi tot spaţiul disponibil şi ţineţi cont de pendularea remorcii. <br><br><font face=/font/big_bold.font>Conduceţi prin virajul strâns. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Ultimele câteva viraje sunt destul de simple. Nu uitaţi să ţineţi cont de remorcă.<br><br><font face=/font/big_bold.font>Continuaţi. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Continuaţi spre locul de parcare final. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

