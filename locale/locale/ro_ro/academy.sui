#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Exersarea Mersului cu Spatele"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "În acest scenariu, veţi avea la dispoziţie o parcare goală pentru a exersa mersul cu spatele cu remorci duble."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Pentru a Începe"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Experimentând"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "În Încheiere"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Finalizarea Scenariului"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Mersul cu spatele cu remorci duble necesită mai multă atenţie decât în cazul unei singure remorci. Va trebui să planificaţi din timp unde doriţi să se îndrepte remorca din spate, păstrând în acelaşi timp controlul asupra remorcii principale şi a cabinei. <br><br>Gândiţi-vă astfel - trebuie să folosiţi remorca principală pentru a dirija remorca din spate."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "În acest caz, se doreşte întoarcerea remorcii din spate către partea şoferului. Pentru a o vira în această direcţie, va trebui ca partea din faţă a remorcii din spate să fie împinsă către partea pasagerului. <br><br>Observaţi că, în esenţă, aceasta înseamnă că va trebui să viraţi remorca principală în direcţia opusă celei în care doriţi să viraţi remorca din spate."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Odată ce remorca din spate începe să vireze, este esenţial să îndreptaţi capul tractor în raport cu remorca principală. Acesta este momentul în care majoritatea persoanelor fac prima lor greşeală."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Aici vedem că şoferul nu a reuşit să urmeze remorca principală şi este pe punctul de a-şi duce remorcile în poziţia de jackknife."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Poziţia de jackknife apare atunci când unghiul dintre oricare două vehicule din combinaţie se apropie de 90 de grade. Odată ce acest lucru se întâmplă, nu mai există nicio metodă salvare - va trebui să conduceţi înainte şi să faceţi o nouă încercare. <br><br> Ca şi în cazul mersului cu spatele cu o remorcă, ţelul trebuie să fie asigurarea că toate roţile remorcii sunt mereu în mişcare. Odată ce roţile se opresc şi remorca virează pe loc, nu veţi puteţi continua."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Puteţi înainta până la ultima poziţie corectă sau, mai degrabă, până la o poziţie în care puteţi continua să mergeţi cu spatele, fără a repeta aceeaşi eroare. <br><br>În acest caz, veţi înainta până într-o poziţie rectilinie şi veţi încerca din nou de la început."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Încă o dată, atunci când remorca din spate începe să vireze, aduceţi capul tractor în faţa remorcii principale şi lăsaţi remorca din spate să vireze singură pentru o clipă."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Acum, că remorca din spate virează spre locul dorit, este timpul ca să viraţi remorca principală pentru a o urma. Puteţi ajusta unghiul dintre remorca principală şi cea din spate pentru a controla virajul şi a-l face mai strâns sau mai larg."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Ultima parte a manevrei este îndreptarea tuturor elementelor. Aliniaţi remorca principală cu cea din spate."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Trebuie să ţineţi cont de timpul necesar pentru a mişca remorca principală, dacă durează prea mult, remorca din spate va ajunge să încerce să vireze spre locul de unde tocmai aţi venit!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Puteţi petrece aici cât timp doriţi, experimentând diferite manevre până atunci când credeţi că aveţi o idee generală despre cum să manevraţi remorcile la mersul cu spatele. <br><br>Dar, cel mai important, nu uitaţi să vă distraţi exersând!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Pregătiţi-vă să începeţi."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Folosiţi această parcare pentru a vă familiariza cu manevrarea remorcilor la mersul cu spatele. <br><br>@@aca_goal_tip@@ Sunteţi nefamiliarizat cu mersul cu spatele cu o remorcă? Luaţi în considerare Bazele Condusului Camionului pentru a deprinde noi aptitudini."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Luaţi-vă cât timp doriţi pentru a exersa. <br><br>Odată confortabili, puteţi opri şi securiza camionul pentru a încheia scenariul."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Opriţi motorul pentru a încheia scenariul."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parcare în Spaţiu Îngust"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "În acest scenariu aveţi sarcina de a parca un set de remorci duble într-un spaţiu îngust."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Pentru a Începe"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Pornire"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Continuaţi să Conduceţi"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Oprirea"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Securizarea Vehiculului"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Condusul cu remorci duble poate părea intimidant, dar nu este mult mai complicat decât condusul cu o singură remorcă - doar va trebui să luaţi în considerare şi traiectoria remorcii din spate!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "În faţa dvs. este un loc de parcare îngust. Nu veţi avea suficient spaţiu pentru a vă alinia perfect înainte de a începe, aşa că va trebui să vă gândiţi cu atenţie cum veţi reuşi să intraţi cu ambele remorci."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Viraţi imediat spre partea îndepărtată a locului de parcare şi conduceţi dincolo de locul în care aţi vira în mod normal."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Acum, că remorca din spate este în poziţia potrivită, vă puteţi îndrepta spre locul de parcare; asiguraţi-vă că vă îndreptaţi din nou spre partea îndepărtată pentru a ajuta la aducerea primei remorci în poziţie."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Continuaţi spre locul de parcare, iar ambele remorci vă vor urma şi se vor alinia pe măsură ce înaintaţi."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parcaţi în zona desemnată şi securizaţi camionul."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Pregătiţi-vă să începeţi."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Continuaţi înainte şi în locul îngust."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Continuaţi să conduceţi."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Opriţi în zona desemnată."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Securizaţi camionul şi opriţi motorul."
#@}


