#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Oprire Aproape de un Obstacol"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "În acest scenariu, vom analiza oglinda frontală - amplasarea acesteia şi cum să o utilizaţi eficient pentru a opri aproape de un obstacol din faţă."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Verificarea Oglinzii Frontale"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Înţelegerea Funcţiei Sale"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Oprirea Aproape de Obstacol"
#!{
	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Camioanele au un mare unghi mort în zona din faţa capului tractor. Este uşor să pierdeţi din vedere un pieton sau chiar o maşină în această zonă, astfel încât camioanele sunt echipate cu o oglindă frontală care poate fi văzută prin parbriz."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Oglinda frontală este concepută pentru a oferi şoferului o vedere în acest unghi mort.<br>Este un instrument esenţial pentru a vă asigura că nu vă loviţi de niciun obstacol atunci când manevraţi în spaţii înguste."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Începeţi să conduceţi, continuaţi spre bariera din faţă, apoi încetiniţi pe măsură ce vă apropriaţi de ea.<br>Ţineţi un ochi şi la oglinda frontală."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Opriţi între linie şi obstacol."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "În acest scenariu, veţi învăţa să folosiţi oglinda frontală prezentată în diagramă.<br><br><font face=/font/big_bold.font>Uitaţi-vă prin partea de sus a parbrizului pentru a o vedea.</font>@@aca_goal_tip@@ Trebuie să fiţi în interiorul vehiculului."

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "Oglinda frontală vă permite să vedeţi în unghiul mort din faţa camionului. Aceasta vă poate ajuta să aveţi un condus sigur şi mai precis.<br><br>Dacă poziţia acesteia nu este mulţumitoare, deschideţi '@@adjust_link_t@@' (se accesează din meniul de pauză) pentru a o ajusta.<br><br><font face=/font/big_bold.font>Apăsaţi @@imv_nrm_activate@@ pentru a continua. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Drept în faţa camionului este un loc marcat. Veţi observa şi existenţa unui obstacol de pe partea cealaltă a locului; când sunteţi aproape de el, conduceţi foarte încet şi verificaţi distanţa până la obstacol în oglinda frontală.<br><br><font face=/font/big_bold.font>Pregătiţi-vă să începeţi. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Camionul nu este gata de drum, poate aţi uitat ceva?<br><br>Este motorul pornit? Aţi eliberat frâna de staţionare?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Conduceţi spre locul de parcare. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Opriţi cu partea frontală a camionului între obstacol şi marcajul vopsit de pe drum. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

# Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

