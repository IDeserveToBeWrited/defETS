#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Ultimul Examen"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "În acest scenariu, vă veţi pune noile abilităţi dobândite la încercare într-un traseu conceput pentru a vă testa precizia şi înţelegerea condusului cu remorci duble."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Mersul cu Spatele"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Intrarea în Traseu"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Atingere Viteză Necesară"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Pregătire pentru Frânare"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Viteză Insuficientă"

