
    key[]: "hint_engine_title"
	val[]: "Porniţi motorul"

    key[]: "hint_engine_text"
	val[]: "Apăsaţi $KEY_engine$ pentru a porni motorul."


    key[]: "hint_ignition_title"
	val[]: "Porniţi contactul"

    key[]: "hint_ignition_text"
	val[]: "Apăsaţi $KEY_engineelect|KEY_engine$ pentru a porni contactul."


    key[]: "hint_driv_arc_title"
	val[]: "Condus"

    key[]: "hint_driv_arc_text"
	val[]: "Utilizaţi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ şi $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pentru a vă deplasa înainte sau înapoi. <br><offset vshift=8> Utilizaţi $SPECIAL_steering$ pentru a vira."


    key[]: "hint_driv_auto_title"
	val[]: "Condus"

    key[]: "hint_driv_auto_text"
	val[]: "Utilizaţi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ şi $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pentru a vă deplasa înainte sau înapoi. <br><offset vshift=8> Utilizaţi $SPECIAL_steering$ pentru a vira.<br><offset vshift=8>Apăsaţi $KEY_gearup$ şi $KEY_geardown$ pentru selectarea treptelor de viteză."


    key[]: "hint_driv_seq_title"
	val[]: "Condus"

    key[]: "hint_driv_seq_text"
	val[]: "Utilizaţi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ şi $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pentru a vă deplasa înainte sau înapoi. <br><offset vshift=8> Utilizaţi $SPECIAL_steering$ pentru a vira.<br><offset vshift=8>Apăsaţi $KEY_gearup$ şi $KEY_geardown$ pentru controlul ambreiajului."


    key[]: "hint_driv_hshift_title"
	val[]: "Condus"

    key[]: "hint_driv_hshift_text"
	val[]: "Utilizaţi $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ şi $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pentru a vă deplasa înainte sau înapoi. <br><offset vshift=8> Utilizaţi $SPECIAL_steering$ pentru a vira.<br><offset vshift=8>Schimbaţi treptele de viteză cu <color value=@@clr_sel@@>schimbătorul<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Apropierea de destinaţie"

    key[]: "hint_depot_deliv_text"
    val[]: "Opriţi în zona marcată pentru a selecta dificultatea locului de parcare final şi a obţine punctele de experienţă (XP) corespunzătoare."


    key[]: "hint_fin_deliv_title"
    val[]: "Finalizaţi livrarea"

    key[]: "hint_fin_deliv_text"
    val[]: "Parcaţi în locul de parcare selectat. Puteţi apăsa $KEY_activate$ pentru a omite parcarea atunci când sunteţi aproape de punctul de livrare."


    key[]: "hint_fin_deliv2_title"
    val[]: "Finalizaţi livrarea"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parcaţi în locul de parcare selectat. Puteţi activa un widget în meniul @@desktop_menu_category_options@@ pentru a vă permite omiterea parcării."


    key[]: "hint_lights_title"
    val[]: "Aprindeţi farurile"

    key[]: "hint_lights_text"
    val[]: "Utilizaţi $KEY_light$ pentru a activa farurile. Treceţi prin diferite moduri apăsându-l în mod repetat."


    key[]: "hint_high_beam_title"
    val[]: "Activaţi faza lungă"

    key[]: "hint_high_beam_text"
    val[]: "Utilizaţi $KEY_hblight$ pentru a porni farurile de fază lungă."


    key[]: "hint_wipers_title"
    val[]: "Activaţi ştergătoarele"

    key[]: "hint_wipers_text"
    val[]: "Utilizaţi $KEY_wipers$ pentru a activa ştergătoarele şi a trece prin diferite setări de viteză ale acestora."


    key[]: "hint_zoom_title"
    val[]: "Privind mai de aproape"

    key[]: "hint_zoom_text"
    val[]: "Utilizaţi $KEY_camzoom$ pentru a face zoom în timp ce sunteţi în interior. Puteţi seta cum funcţionează modul de zoom, să ţineţi apăsat sau să comutaţi, în meniul @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Privind împrejur"

    key[]: "hint_cam_int_text"
    val[]: "Utilizaţi $KEY_cam1$ pentru a comuta camera la vederea din interior."


    key[]: "hint_cam_ext_title"
    val[]: "Privind împrejur"

    key[]: "hint_cam_ext_text"
    val[]: "Puteţi comuta prin diferite unghiuri ale camerei apăsând $KEY_camcycle$.<br><offset vshift=8>Utilizaţi $KEY_cam2$ pentru a comuta camera la o vedere exterioară."


    key[]: "hint_indicators_title"
    val[]: "Semnalizatoare"

    key[]: "hint_indicators_text"
    val[]: "Utilizaţi $KEY_lblinker$ şi $KEY_rblinker$ pentru a activa semnalizatoarele."


    key[]: "hint_tow_title"
    val[]: "Serviciu de tractare"

    key[]: "hint_tow_text"
    val[]: "Dacă nu puteţi ieşi dintr-o situaţie dificilă, puteţi apela serviciul de tractare. Pentru a-l accesa, deschideţi meniul @@quick_info_word@@ utilizând $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Blocare diferenţial"

    key[]: "hint_diff_lock_text"
    val[]: "Dacă nu puteţi începe să vă deplasaţi, poate blocarea diferenţialului vă poate ajuta. Utilizaţi $KEY_diflock$ pentru a-l activa sau porniţi blocarea automată diferenţial din meniul @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Blocare diferenţial activată"

    key[]: "hint_diff_unlock_text"
    val[]: "Ar trebui să deblocaţi diferenţialul în timpul condusului obişnuit sau riscaţi avarierea acestuia. Utilizaţi $KEY_diflock$ pentru a-l dezactiva sau porniţi blocarea automată diferenţial din meniul @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Dezactivaţi ştergătoarele"

    key[]: "hint_wipers_off_text"
    val[]: "Utilizaţi $KEY_wipers$ pentru a dezactiva ştergătoarele şi a trece prin diferite setări de viteză ale acestora."


    key[]: "hint_world_map_title"
    val[]: "Afişare hartă"

    key[]: "hint_world_map_text"
    val[]: "Utilizaţi $KEY_navmap$ pentru a deschide harta lumii."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Utilizaţi $KEY_advmouse$ pentru a deschide @@quick_info_word@@ - o imagine de ansamblu a situaţiei dvs. cu ajutorul unor scurtături convenabile."


    key[]: "hint_pause_border_title"
    val[]: "Reglementări locale"

    key[]: "hint_pause_border_text"
    val[]: "Utilizaţi $KEY_advmouse$ pentru a deschide @@quick_info_word@@ şi a vedea reglementările curente pentru regiunea în care tocmai aţi intrat."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Deschideţi @@quick_info_word@@ folosind $KEY_advmouse$ pentru a intra în meniul @@photo_mode_word@@ şi a surprinde @@landmark_word@@ din apropiere <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ din apropiere"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> este în apropiere - găsiţi-l şi activaţi-l pentru a vedea filmuleţul."


    key[]: "hint_resting_title"
    val[]: "Loc de odihnă în apropiere"

    key[]: "hint_resting_text"
    val[]: "Locurile de odihnă <img src=/material/ui/map/parking_ico.mat width=20 height=20> vă ajută să vă reveniţi din starea de oboseală şi să vă luaţi pauza obligatorie pentru a vă continua călătoria în siguranţă."


    key[]: "hint_gas_title"
    val[]: "Staţii de alimentare în apropiere"

    key[]: "hint_gas_text"
    val[]: "Staţiile de alimentare <img src=/material/ui/map/gas_ico.mat width=20 height=20> pot fi folosite pentru a vă realimenta vehiculul."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Puteţi activa controlul inteligent al acceleraţiei în meniul @@desktop_menu_category_options@@. Prin activarea acestuia, vehiculul va menţine o acceleraţie scăzută în mod implicit. După ce apăsaţi rapid de două ori butonul acceleraţiei, vehiculul va menţine acceleraţia la maxim până când butonul este eliberat."

    key[]: "hint_bus_job_title"
	val[]: "Prima cursă de autocar"

    key[]: "hint_bus_job_text"
    val[]: "Transportaţi pasagerii către diverse destinaţii - sosiţi la timp şi asiguraţi-le o călătorie lină, confortabilă şi sigură pentru a-i menţine mulţumiţi.<br><br>Fiţi atenţi la widget-ul de forţe G pentru a vedea cât de lin conduceţi."


    key[]: "hint_satis_dec_title"
	val[]: "Gestionare satisfacţie pasageri"

    key[]: "hint_satis_dec_text"
    val[]: "Puteţi îmbunătăţi satisfacţia pasagerilor prin asigurarea constantă a unei călătorii line şi lipsită de daune, fără nicio încălcare a regulilor de circulaţie de ceva vreme.<br><br>Priviţi la widget-ul de forţe G pentru a vedea cât de lin conduceţi."


    key[]: "hint_low_satis_title"
	val[]: "Creştere satisfacţie pasageri"

    key[]: "hint_low_satis_text"
    val[]: "Pasagerii sunt nemulţumiţi de modul în care conduceţi. Le puteţi îmbunătăţi satisfacţia prin oferirea unei călătorii confortabile.<br><br>Dacă este echipat, utilizaţi retarder-ul pentru o frânare constantă - apăsaţi $KEY_retarderup$ pentru a-i creşte puterea şi $KEY_retarderdown$ pentru a o descreşte."


    key[]: "hint_bus_late_title"
	val[]: "Sosire târzie"

    key[]: "hint_bus_late_text"
    val[]: "Sunteţi în întârziere faţă de orar, ceea ce ar putea afecta satisfacţia pasagerilor la sosire. Puteţi recupera din timpul pierdut acolo unde este posibil, dar conduceţi întotdeauna cu prudenţă."


    key[]: "hint_bus_stop_title"
	val[]: "Apropriaţi-vă de staţia de autobuz"

    key[]: "hint_bus_stop_text"
    val[]: "Opriţi în zona marcată pentru a permite îmbarcarea şi debarcarea pasagerilor. Pasagerii ce se vor îmbarca apreciază un autocar curat şi neavariat."


    key[]: "hint_bus_stop_fin_title"
	val[]: "Apropriaţi-vă de staţia de autobuz"

    key[]: "hint_bus_stop_fin_text"
    val[]: "Opriţi în zona marcată pentru a încheia călătoria."