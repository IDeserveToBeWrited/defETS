	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Accesul la anumite DLC-uri a fost obţinut. Doriţi să ieşiţi imediat la Ecranul de Lansare pentru a avea acces la noul conţinut?<br><br>Progresul dvs. va fi salvat în mod automat."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
