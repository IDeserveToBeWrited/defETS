#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "COMENZI" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "CONFIGURĂRI" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "CONFIGURARE AVANSATĂ" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "Comenzi" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "TIP COMANDĂ" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "CONTROLER" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "FEEDBACK CONTROLER" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "AXE CONTROLER" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Doar tastatură" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Tastatură" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Virare cu mouse-ul" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Virare cu mouse inclusiv pedale" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Lipsă" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
