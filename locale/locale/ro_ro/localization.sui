#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Reţea indisponibilă. Vă rugăm să verificaţi dacă configuraţia dumneavoastră este corectă."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Nu se poate stabili o conexiune online. Verificaţi funcţionarea conexiunii internet."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Eroare de comunicare cu serviciul online. Reveniţi ulterior."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Date incorecte returnate de serviciul online. Dacă serverul proxy HTTP este în uz, verificaţi configuraţia sa. În caz contrar, încercaţi din nou mai târziu."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Eroare de comunicare cu serviciul online. Reveniţi ulterior."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Serviciul nu este compatibil cu versiunea jocului. Verificaţi disponibilitatea unui nou 'patch'."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Serviciu momentan indisponibil. Reveniţi ulterior."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Serviciu oprit temporar pentru întreţinere sau suprasolicitare. Reveniţi ulterior."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Informaţiile de autentificare sunt nevalide. Încercaţi din nou."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Contul online este curent restricţionat din cauza multiplelor tentative de conectare eşuate. Vă rugăm reîncercaţi peste o jumătate de oră."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Contul online este momentan restricţionat în urma unor activităţi suspecte. Reveniţi în 24 ore."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Acest joc nu este asociat acestui cont online."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Contul nu a fost, încă, activat. Verificaţi e-mail-ul pentru instrucţiuni de activare."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Cont suspendat. Contactaţi serviciul suport."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Cont blocat. Contactaţi serviciul suport."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Autentificarea printr-un server proxy nu este acceptată de acest joc. Vă rugăm să încercaţi un proxy diferit sau o conexiune directă."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Obiect solicitat momentan indisponibil. Vă rugăm reveniţi."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Eroare SSL. Nu s-a putut stabili o conexiune securizată."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Jocul a fost suspendat în timpul comunicaţiei online. Vă rugăm, încercaţi mai târziu."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Eroare internă. Fişierul 'net.log' ar putea conţine mai multe detalii."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 nu este capabil să afişeze grafica pe acest computer (accelerator grafic compatibil inexistent).\nPaşi sugeraţi:\n\n1. Verificaţi satisfacerea cerinţelor tehnice minime pentru sistem şi placă video.\n2. Actualizaţi sistemul cu ultima versiune DirectX, furnizată de Microsoft.\n3. Descărcaţi de pe site-ul producătorului plăcii video şi instalaţi cele mai noi drivere - probabil cele curente sunt depăşite.\n4. Încercaţi metode diferite de afişare a graficii, din OpenGL în DirectX sau viceversa.\n5. Ştergeţi fişierul de configurare al jocului \\'config.cfg\\', din directorul \\'Documents\\' - \\'Euro Truck Simulator 2\\', acesta putând fi corupt.\n Acest fişier va fi recreeat automat, cu valori implicite valide, la următoarea pornire a jocului."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 a întâlnit o problemă şi nu poate afişa imagini pe acest calculator (accelerator grafic incompatibil)."
#@}

