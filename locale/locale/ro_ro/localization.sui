#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuare ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Bun venit la Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "În sfârşit aveţi şansa de a trăi meseria visurilor dvs. - condusul unui camion!"

	key[]: "intro_3"
	val[]: "Propria companie este acum pregătită pentru activitate, dar, din păcate, bugetul nu vă permite achiziţionarea unui autovehicul. Pentru moment va trebui să munciţi ca şofer angajat la alte companii."

	key[]: "intro_4"
	val[]: "Sarcina constă în livrarea în siguranţă a unei încărcături de $JOB_CARGO$ către $JOB_TARGET_COMPANY$ în $JOB_TARGET_CITY$. Angajatorul dvs. v-a pus la dispoziţie un vehicul şi va acoperi toate cheltuielile. Nu dezamăgiţi pe nimeni şi ajungeţi la timp."


	key[]: "intro_garage_1"
	val[]: "Acesta este sediul dumneavoastră."

	key[]: "intro_garage_2"
	val[]: "E un garaj destul de rudimentar, dar e un început."

	key[]: "intro_garage_3"
	val[]: "Din nefericire, nu aveţi nimic de parcat, încă, aşa că nu veţi vedea vreun camion aici."

	key[]: "intro_garage_4"
	val[]: "După ce veţi acumula suficient capital, veţi putea achiziţiona un camion pentru a vă deplasa liber în lume şi administra afacerea de la acest sediu."

	key[]: "intro_garage_5"
	val[]: "Mult succes!"


	key[]: "desktop_tut_t"
	val[]: "FUNCŢIE DEBLOCATĂ"

	key[]: "desktop_tut_job"
	val[]: "Alegeţi sarcina următoare"

	key[]: "desktop_tut_cargo_market"
	val[]: "Utilizaţi noua dumneavoastă remorcă pentru a livra o gamă largă de mărfuri către destinaţiile lor." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Aici puteţi studia progresele făcute."

	key[]: "desktop_tut_company"
	val[]: "Ţineţi-vă garajele sub control, angajaţi noi şoferi şi administraţi-vă compania de aici."

	key[]: "desktop_tut_trailers"
	val[]: "De acum înainte, puteţi achiziţiona remorci proprii, ce pot fi îmbunătăţite sau vopsite pentru a se potrivi cu camionul dvs.<br><br>Remorcile dvs. pot fi stocate în orice garaj deţinut; acestea pot fi folosite de către şoferii angajaţi pentru creşterea profiturilor. Pentru a gestiona remorcile, folosiţi Managerul de Remorci."

	key[]: "desktop_tut_visit_directive"
	val[]: "Vizitaţi $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BINE AŢI VENIT"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Bine aţi venit la noul Ecran Principal<br>De aici puteţi interacţiona cu toate funcţiile jocului."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Mai jos, Meniul Principal vă oferă acces direct la toate funcţiile de bază ale jocului cu care sunteţi familiarizaţi."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "În partea de sus, noua Bară de Stare asigură o vizualizare constantă a statisticilor utile din profilul jucătorilor şi a reglementărilor locale de transport."

	key[]: "desktop_tut_tour_home"
	val[]: "Butonul Home este mereu prezent pentru întoarcerea la Ecranul Principal."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Un Meniu Rapid permanent oferă scurtături directe spre toate funcţiile jocului de pe orice ecran."

	key[]: "desktop_tut_tour_drive"
	val[]: "Butonul actualizat Condu asigură conexiunea cu lumea jocului, mereu gata să vă repună din nou pe drum."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL FINALIZAT"

	key[]: "desktop_tut_tour_finish"
	val[]: "Vă mulţumim pentru revizuirea noului Ecran Principal."
#@}


	key[]: "show_help"
	val[]: "Ascundere sau afişare indicii ajutătoare"

