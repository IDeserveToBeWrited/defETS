#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "Pentru a accesa Curse Rapide trebuie să terminaţi acest tutorial."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Pentru a accesa bursa de transporturi trebuie să vă achiziţionaţi primul camion."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Pentru a accesa piaţa de mărfuri trebuie să vă achiziţionaţi prima remorcă."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Pentru a accesa contractele externe trebuie să vă achiziţionaţi primul camion şi să aveţi un profil conectat la World of Trucks."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Pentru a accesa piaţa externă trebuie să vă achiziţionaţi prima remorcă şi să aveţi un profil conectat la World of Trucks."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Vedeţi harta lumii, zonele explorate şi punctele de pe traseu curente sau setaţi altele noi."

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Călătoriţi rapid către un oraş deja descoperit, contra cost."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Navigaţi, căutaţi şi filtraţi sesiunile online de Convoi pentru a vă alătura sau a crea şi găzdui propria sesiune pentru alţii."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Căsuţa poştală pentru mesaje din lumea afacerilor, de la bănci şi de la noii angajaţi."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "E-mailurile vor începe a fi livrate după ce aţi mai progresat în cariera dumneavoastră."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Localizare şi achiziţionare garaje de pe harta lumii."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Navigare şi revizuire camioane rulate disponibile pentru achiziţionare."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Încă nu aţi descoperit niciun distribuitor autorizat de camioane."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Navigare, revizuire şi reconfigurare remorci disponibile pentru achiziţionare."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Îmbunătăţiţi-vă experienţa la volan cu puţină muzică."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Radioul nu este disponibil."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Configurare opţiuni grafice, audio, preferinţe joc, comenzi şi online."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Revizuire progres carieră, statistici şi contracte recent finalizate."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Pentru a accesa Convoi Activ trebuie să vă alăturaţi unei sesiuni convoi."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Avertizare medicală"

	key[]: "health_warning_description"
	val[]: "Un număr redus de persoane pot fi susceptibile la crize epileptice sau pierderea stării de conştienţă atunci când sunt expuse anumitor lumini intermitente sau tipare de lumină. Aceste persoane pot experimenta o criză în timp ce privesc anumite imagini sau jucându-se un joc video. Dacă dvs. sau oricine din familia dvs. aţi prezentat simptome asociate epilepsiei (convulsii sau pierderea stării de conştienţă) sub expunerea la lumini intermitente, consultaţi un medic specialist şi luaţi toate precauţiile necesare înainte de a începe jocul.<br offset=20>Dacă dvs. sau copilul dvs. prezentaţi oricare dintre următoarele simptome în timp ce vă jucaţi orice joc video: ameţeli, tulburări de vedere, spasme musculare sau ale ochilor, pierderea stării de conştienţă, dezorientare, convulsii, mişcări involuntare, întrerupeţi imediat sesiunea de joc şi consultaţi un medic specialist."

	key[]: "trademark"
	val[]: "Toate numele de brand, mărcile comerciale, mărcile înregistrate, logourile şi simbolurile de pe vehiculele din joc sunt proprietăţi aparţinând proprietarilor de drept ale acestora. Folosite cu amabilul acord al proprietarilor de drept. Mărcile comerciale şi designul MAN® sunt drepturi înregistrate ale MAN Truck & Bus AG şi sunt utilizate sub licenţă către SCS Software s.r.o. „Mercedes-Benz” şi „Three pointed star in a ring” sunt mărci comerciale ale Daimler AG şi sunt utilizate sub licenţă de către SCS Software s.r.o. Mărcile comerciale şi designul RENAULT sunt drepturi înregistrate ale sau licenţiate către AB Volvo Group şi sunt utilizate în baza unei licenţe. Mărcile comerciale şi designul VOLVO sunt drepturi înregistrate ale sau licenţiate către AB Volvo Group şi sunt utilizate în baza unei licenţe."
#@}

