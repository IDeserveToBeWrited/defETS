	key[]: "cancel_wizard"
	val[]: "Doriţi să opriţi asistenţa configurării intrărilor?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SELECTARE METODĂ DE CONTROL" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Controlere"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Ghidul va aplica setări recomandate bazate pe dispozitivele conectate.<br><color value=@@clr_sel@@>Dacă utilizaţi un gamepad compatibil cu Steam, luaţi în considerare activarea suportului pentru configurare din <br><color value=@@clr_txt_d@@> „Steam > Setări > Controler > Setări Generale Controler”."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Manevraţi autovehiculul prin intermediul tastaturii şi utilizaţi mouse-ul pentru a privi în jur. Este cea mai simplă, dar, totodată, şi cea mai imprecisă metodă de controlare a jocului, disponibilă oricui."

	key[]: "wiz_control_mouse"
	val[]: "Utilizaţi mouse-ul pentru a controla direcţia. Tastatura va controla celelalte funcţii rămase. Puteţi utiliza mouse-ul pentru a privi în jur, doar dacă ţineţi apăsată tasta sau butonul pentru controlarea camerei."

	key[]: "wiz_control_controller"
	val[]: "Utilizaţi un volan, gamepad sau joystick pentru cea mai realistă experienţă a jocului. Scurtăturile rapide de pe tastatură pot fi utilizate în continuare pentru a accesa multiple acţiuni şi puteţi naviga liber cu mouse-ul (mouselook)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Nu s-a detectat niciun controler de joc. Trebuie să conectaţi acum unul, pentru a activa această opţiune!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Detectare controlere disponibile ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SELECTARE API CONTROLER" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Modul de Mapare în Joc (recomandat)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Modul de Mapare al Clientului Steam"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Controler clasic"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepad-uri precum @@controller_ps5@@, @@controller_xbox_one@@ sau @@controller_steam_deck@@ optate în interfaţa Steam Input şi ce folosesc layoutul simplu.<br><br>Oferă suport complet în joc pentru configurarea butoanelor."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepad-urile optate în interfaţa Steam Input şi ce folosesc layouturi separate configurate prin Clientul Steam.<br><br>Suport limitat pentru sugestii de butoane şi fără vreo configuraţie de alegere a butoanelor în joc."

	key[]: "wiz_api_classical"
	val[]: "Controler, volan sau joystick ce folosesc DirectInput, Xinput sau interfeţe similare."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SELECTARE TIP CONTROLER"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volan"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad sau joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Controlerul este un volan sau se comportă ca unul. Poziţia controlerului determină în mod direct poziţia volanului în joc."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Controlerul este un gamepad sau joystick. Poziţia controlerului determină viteza de rotaţie a roţii motoare din joc."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "SELECTARE TIP CUTIE DE VITEZĂ" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Apăsaţi butonul ÎNAINTE pentru a avansa şi butonul „ÎNAPOI” pentru a frâna sau a merge cu spatele. Cutia de viteze se ocupă automat de restul, gestionând tranziţiile dintre mersul înainte, frânare şi mersul cu spatele, precum şi selectarea treptelor de viteză adecvate."

	key[]: "wiz_gb_automatic"
	val[]: "Utilizaţi butoanele pentru a schimba între mersul înainte, poziţia neutră sau mersul cu spatele. Apoi apăsaţi acceleraţia şi lăsaţi transmisia automată să se ocupe de schimbarea treptelor de viteză."

	key[]: "wiz_gb_sequential"
	val[]: "Schimbaţi manual treptele de viteză în sus şi în jos pentru a selecta fiecare treaptă de viteză din transmisie. Această configuraţie oferă control deplin asupra cutiei de viteze a vehiculului."

	key[]: "wiz_gb_hshifter"
	val[]: "Selectaţi direct treapta de viteză dorită. Aceasta oferă cea mai realistă configuraţie. Se recomandă utilizarea unui schimbător de viteze fizic H-Shifter şi necesită folosirea ambreiajului."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Această funcţie necesită un volan, gamepad sau joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Nu s-a detectat niciun dispozitiv H-Shifter, această funcţie ar putea fi inutilizabilă."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "SELECTARE DISPUNERE SCHIMBĂTOR-H"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Transmisia de tip gamă este opţiunea cea mai simplă. Este compusă din două seturi de trepte de viteză. Primul conţine treptele de la 1 la 6, cel de-al doilea - pe cele de la 7 la 12. Butonul efectuează trecerea de la un set la celălalt, în vreme ce schimbătorul selectează o anumită treaptă, din setul respectiv."

	key[]: "wiz_hs_splitter"
	val[]: "Transmisia de tip splitter este o alternativă simplă, constituită din două seturi de trepte de viteză. Primul conţine trepte impare (1,3,5...), al doilea pe cele pare (2,4,6...). Comutatorul face trecerea de la un set la celălalt, iar schimbătorul determină treapta din setul respectiv."

	key[]: "wiz_hs_range_splitter"
	val[]: "Transmisie cu gamă bazată pe schimbătorul real H-Shifter. Utilizează două comutatoare, grupând treptele de viteză câte patru, fiind recomandat utilizatorilor mai experimentaţi."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Jocul este acum configurat folosind setările implicite descrise mai jos. Puteţi personaliza jocul folosind setările avansate sau puteţi trece direct la joc."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Configuraţie avansată"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Jocul este acum configurat şi puteţi continua. Puteţi schimba configuraţia mai târziu din meniul Opţiuni."

	key[]: "wiz_cfg_steam"
	val[]: "Puteţi verifica şi accesa mapările pentru butoane şi axel ale acestui controler folosind clientul Steam. Setările Steam pentru gamepad ale jocului sunt disponibile în Steam > Librărie > Euro Truck Simulator 2 > Configurarea Controlerului."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Deschidere setări controler"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Utilizaţi @@imm_wiz_dsteerleft@@ şi @@imm_wiz_dsteerright@@ pentru direcţie."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Deplasaţi mouse-ul spre stânga sau dreapta, pentru rotirea volanului în poziţia corespunzătoare."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Utilizaţi @@ima_wiz_j_steer@@ pentru direcţie."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Utilizaţi @@imm_wiz_dforward@@ pentru deplasarea înainte şi @@imm_wiz_dbackward@@ pentru marşarier."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Deplasaţi comanda @@ima_wiz_j_throttle@@ în faţă pentru mersul înainte şi mişcaţi-o înapoi pentru a merge cu spatele."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Utilizaţi @@ima_wiz_j_throttle@@ pentru înainte şi @@ima_wiz_j_brake@@ pentru marşarier."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Apăsaţi @@imm_wiz_dforward@@ pentru a accelera şi @@imm_wiz_dbackward@@ pentru a frâna."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Deplasaţi @@ima_wiz_j_throttle@@ în faţă, pentru a accelera sau înapoi, pentru a frâna."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Utilizaţi @@ima_wiz_j_throttle@@ pentru a accelera şi @@ima_wiz_j_brake@@ pentru a frâna."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Utilizaţi @@imv_wiz_gearup@@ pentru deplasarea înainte şi @@imv_wiz_geardown@@pentru înapoi."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Utilizaţi @@imv_wiz_gearup@@ pentru treapta înainte şi @@imv_wiz_geardown@@ pentru treapta înapoi dacă folosiţi butoanele tastaturii sau controlerului. Utilizaţi @@imv_wiz_drive@@ şi @@imv_wiz_reverse@@ pentru selectarea direcţiei de deplasare dacă utilizaţi un H-shifter."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Utilizaţi @@imv_wiz_gearup@@ şi @@imv_wiz_geardown@@ pentru selectarea treptei de viteză."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Utilizaţi schimbătorul  H-shifter împreună cu @@ima_wiz_j_clutch@@ pentru selectarea treptei dorite."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "SETARE AXE CONTROLER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Vizualizarea Axelor"

	key[]: "wiz_setup_axes_desc"
	val[]: "Puteţi testa funcţionarea tuturor axelor selectate în mod vizual. Acţionaţi controlerul şi observaţi mişcarea barelor. Vă vor fi arătate limitele, centrul, orientarea şi comportamentul general pentru fiecare axă selectată."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Setarea Axei"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Pentru a alege o axă, apăsaţi pe butonul de lângă numele axei. Astfel veţi trece în modul operare. Apoi, folosiţi controlerul pentru a seta axa selectată prin mişcarea stick-ului, volanului sau pedalei către axa dorită."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Zone moarte"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Zona moartă se referă la un spaţiu al axei proiectat intenţionat ce oferă niciun semnal. Pentru a ajusta zona moartă a axei selectate mişcaţi glisiera aferentă. Mărirea glisierei către dreapta va mări zona moartă. Această funcţie este benefică în special pentru controlerele mai vechi, deoarece definind o zonă moartă mai mare se pot atenua probleme precum imprecizia sau semnalul fals cauzate de uzura dispozitivelor."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Moduri Axă"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Modul unei axe determină cum este gestionată de joc. O axă inversată schimbă direcţia raportată, rezultând, de exemplu, într-o virare la stânga în loc de la dreapta. O axă centrată are poziţia implicită în mijlocul zonei de acţionare, ca în cazul unui joystick. Acest mod este util pentru a corecta o axă ce a fost detectată incorect."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Inversată" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrată" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Inversată + centrată" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "SETARE CUTIE DE VITEZĂ AUTOMATĂ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Cu cutia de viteze automată va trebui să comutaţi doar între poziţiile înainte, neutru şi înapoi. Veţi putea face acest lucru prin utilizarea următoarelor taste şi butoane ale controlerului. Pentru a modifica setările, click pe un buton şi apăsaţi tasta sau butonul controlerului pe care doriţi să le utilizaţi pentru funcţia respectivă."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Dacă aveţi un dispozitiv H-Shifter conectat, îl puteţi utiliza pentru simularea unui schimbător de viteze automat real. Activaţi această opţiune şi puteţi atribui poziţii H-Shifter pentru modurile înainte şi marşarier. Orice alte poziţii ale H-Shifter sunt considerate drept neutre. Această setare este creată special pentru controlerul H-shifter, astfel încât nu va funcţiona nici cu tastele obişnuite, nici cu butoanele controlerului. Pentru a schimba alocarea, click pe un buton şi apoi mutaţi schimbătorul în poziţia dorită şi apoi înapoi în poziţia neutră."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SETARE CUTIE DE VITEZĂ SECVENŢIALĂ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Transmisia secvenţială schimbă între treptele de mers înainte, neutră şi marşarier. Acestea sunt tastele sau butoanele controlerului utilizate pentru a trece într-o treaptă din sus sau din jos, în ordinea menţionată. Pentru a schimba alocarea, click pe un buton şi apăsaţi tasta sau butonul controlerului pe care doriţi să îl utilizaţi pentru acţiunea respectivă."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "SETARE CUTIE DE VITEZĂ SCHIMBĂTOR-H" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Aici puteţi alege configuraţia generală a schimbătorului şi testa funcţiile asociate. Imaginea vă prezintă poziţia actuală a schimbătorului, precum şi treapta curent selectată. Dat fiind că transmisia este compusă din mai multe trepte decât poziţiile disponibile ale schimbătorului, va trebui să comutaţi între diferitele seturi de trepte de viteză, cu ajutorul comutatoarelor de pe schimbător."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Poziţia curentă a schimbătorului, precum şi comutatoarele active sunt afişate mai jos. Pentru a modifica alocarea unei funcţii, selectaţi butonul respectiv, cu mouse-ul, şi deplasaţi schimbătorul în poziţia dorită şi apoi pe poziţia neutră."
#@}

