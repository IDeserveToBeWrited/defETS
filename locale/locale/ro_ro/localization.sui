#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "O selecţie de teme ce pot fi afişate în fundal atunci când navigaţi prin meniu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Permite selectarea aleatorie a temei de fundal de fiecare dată când lansaţi jocul."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Setează întârzierea după care elementele de pe desktop sunt estompate."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "După activare, veţi începe să resimţiţi efectele stării de oboseală în timp.<br><br>Evitarea repausului se va solda cu infracţiuni rutiere."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "După activare, va trebui să respectaţi regulile de circulaţie sau riscaţi obţinerea infracţiunilor rutiere. Riscul este sporit în apropierea maşinilor de poliţie, radarelor şi camerelor de trafic."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajustează distanţa medie a contractelor oferite."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Selectează ce limită de viteză va fi afişată pe widget-ul sistemului de navigaţie."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Viteza curentă de pe sistemul de navigaţie se va schimba în roşu atunci când limita de viteză este depăşită."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Atunci când ajungeţi la destinaţie, un widget va fi afişat ce vă va permite omiterea parcării."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Menţinere toate Widget-urile ascunse."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Menţinere ambele oglinzi virtuale ascunse."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Menţinere toate Notificările ascunse chiar şi când sunt primite."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Afişează o fereastră evidenţiind capabilităţile camionului utilizat înainte de a accepta un contract agabaritic."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Alegeţi alinierea Hărţii Lumii."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Alegeţi modul în care Harta este explorată:<br>- „Explorare proximă” marchează o zonă mai extinsă ca fiind explorată.<br>- „Explorare precisă” marchează doar zonele din imediata apropiere a jucătorului."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Selectaţi cum va fi afişată navigaţia"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică modul în care este calculată navigaţia:<br>- modul „Optim” alege cel mai eficient raport dintre lungimea şi durata traseului, încearcă să evite intersecţiile semaforizate, etc.<br>- modul „Cel mai scurt” alege întotdeauna cea mai scurtă rută posibilă.<br>- modul „Drumuri secundare” alege evitarea autostrăzilor oriunde este posibil."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică dificultatea parcării:<br>- „Selectare întotdeauna” vă va permite să alegeţi la finalul cursei.<br>- „Parcare facilă” nu necesită manevre în marşarier.<br>- „Parcare profesionistă” va necesita, de obicei, manevre mai dificile de executat în marşarier."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Ajustează probabilitatea întâlnirii de pericole pe drum în imediata apropiere incluzând accidente, vehicule staţionare, resturi pe drum, etc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Ajustează probabilitatea întâlnirii unei devieri a traficului atunci când sunteţi într-o cursă."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Ajustează probabilitatea vremii nefavorabile."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Alegeţi dacă vor fi afişate informaţii despre fusul orar alături de ora curentă."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Activează scene introductive redate de obicei după achiziţia unui camion sau modernizarea garajului sau în timpul îmbarcării pasagerilor."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Alegeţi dacă semnele semi-transparente de blocare sunt afişate pe drumuri ce nu pot fi accesate."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Inversează axa Y a mouse-ului atunci când controlaţi camera din joc."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Selectează tipul transmisiei:<br>- „Automată simplificată” permite folosirea acceleraţiei şi a frânei pentru a controla mişcarea de înainte şi înapoi.<br>- „Automată” necesită un input pentru a schimba între vitezele de înainte şi înapoi.<br>- „Secvenţială” necesită schimbarea manuală a tuturor vitezelor prin comenzi de urcare/coborâre a treptelor.<br>- „H-Shifter” necesită utilizarea unui controler cu porţi de comutare pentru a selecta vitezele manual."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Activarea acestei opţiuni permite „trecerea prin viteze” - saltul peste viteze atunci când este necesar sau pentru a evita practic trecerea prin fiecare treaptă a transmisiei."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Aduce automat volanul înapoi la centru atunci când se utilizează o tastatură sau un controler.<br><br>Dezactivarea opţiunii conduce la necesitatea aducerii manuale a volanului la centru după fiecare viraj."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajustează intervalul de animaţie al volanului. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică intensitatea frânelor."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică stabilitatea vehiculului prin coborârea centrului de greutate al acestuia."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică stabilitatea remorcii prin coborârea centrului de greutate al acesteia."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică intensitatea efectului cuplului motor generat de transmisie.<br><br>Creşterea acestei setări amplifică efectul de „răsucire” spre dreapta al vehiculului."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică rigiditatea suspensiei şasiului."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică rigiditatea suspensiei cabinei."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ajustează intensitatea denivelărilor de suprafaţă generate procedural pentru a da drumurilor şi altor terenuri o senzaţie de imperfecţiune.<br><br>În funcţie de setările suspensiei şi ale camerei efectul perceput poate fi mai mult sau mai puţin intens."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite cuplarea avansată ce necesită o precizie ridicată pentru alinierea roţii a cincea a camionului cu pivotul remorcii.<br><br>Dezactivarea opţiunii permite o cuplare a remorcii mai facilă prin înlăturarea coliziunii dintre pivot şi a cincea roată."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Selectează dacă, şi ce cabluri ale remorcii vor fi animate.<br><br><color value=@@clr_txt_d@@>Animarea cablurilor mai multor vehicule poate afecta performanţa PC-urilor mai vechi."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Activează limitatorul electronic de viteză al camionului de 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>Contractele World of Trucks au această opţiune mereu activată."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "După activare şi dacă ştergătoarele de parbriz sunt setate pe prima poziţie, acestea vor porni automat şi îşi vor ajusta viteza în funcţie de condiţiile meteo."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite cuplarea automată a retardului atunci când se frânează."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, vehiculul este asistat la demararea în pantă prin menţinerea frânelor, asigurând o pornire lină."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Permite activarea automată a frânei de motor atunci când se frânează."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, motorul va porni de îndată ce acceleraţia este apăsată."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, frâna de staţionare a vehiculului este aplicată implicit (după folosirea feribotului, tractarea la un service, o călătorie rapidă, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Coborârea automată a osiilor ridicătoare, necesară în funcţie de greutatea vehiculului."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, vehiculul va menţine implicit o acceleraţie redusă. După apăsarea rapidă de două ori a butonului de acceleraţie, vehiculul va menţine acceleraţia la podea până când butonul de acceleraţie este eliberat.<br><br>Se aplică doar la utilizarea unei tastaturi."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulează pierderea de aer prin aplicarea excesivă a frânei.<br><br>După activare, va fi necesară o gestionare a presiunii aerului la coborârea dealurilor sau la efectuarea de mici manevre cu aplicări multiple ale frânelor."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "După dezactivare, consumul de carburant nu este influenţat de stilul de condus sau condiţiile de drum.<br><br>Odată activată, consumul de carburant este afectat de factori precum stilul de condus, masa încărcăturii, rezistenţa la înaintare şi profilul traseului. Nu mai este influenţat de abilitatea @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, ABS-ul va preveni blocarea roţilor pentru a menţine controlul şi a îmbunătăţi capacitatea de frânare."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, vehiculul va aplica frânarea pe fiecare roată pentru a preveni rotirea în gol a acestora, subvirarea sau supravirarea pentru a ajuta la menţinerea controlului."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, vehiculul va bloca diferenţialul dacă roţile încep să patineze pentru îmbunătăţirea tracţiunii."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică incrementul vitezei atunci când controlul de croazieră va creşte sau descreşte în funcţie de apăsarea butonului corespunzător."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică toleranţa controlului de croazieră pentru menţinerea vitezei ţintă."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, controlul de croazieră va ajusta automat viteza pentru a menţine o distanţă de siguranţă faţă de vehiculul din faţă."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Activează frânarea de urgenţă dacă sistemul detectează o coliziune iminentă.<br>Alegeţi dacă sistemul va reacţiona doar la vehicule sau la toate obstacolele."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Selecţia modurilor de păstrare a benzii:<br>- modul „Avertizare părăsire bandă” atenţionează sonor atunci când părăsiţi banda de circulaţie.<br>- în plus faţă de atenţionarea sonoră, modul „Suport menţinere bandă” va vira automat vehiculul pentru a preveni părăsirea benzii.<br><br>Ambele moduri vor fi active doar la viteze de peste 55 km/h (~35 mph).<br>Menţinerea Benzii ia în considerare şi utilizarea semnalizării înainte de activare."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Activează funcţiile senzorului de unghi mort, în cazul în care vehiculul dvs. este echipat cu acesta."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "După activare şi dacă farurile sunt setate pe prima poziţie, acestea vor porni automat în condiţii de luminozitate scăzută."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "După activare şi dacă farurile sunt pornite pe faza lungă, vehiculul va diminua automat faza lungă atunci când detectează un vehicul ce se apropie sau un vehicul aflat în faţă."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "După activare, semnalizarea se va anula automat după un viraj în timp ce volanul este adus înapoi la centru."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "După activare, unele accesorii de interior reacţionează la mişcările fizice ale vehiculului (decoraţiuni agăţate, bobbleheads, etc.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Activează giraţia camerei interioare în funcţie de comanda direcţiei."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică sensibilitatea funcţiei „Rotire cameră la virare” faţă de comanda direcţiei. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Schimbă comportamentul funcţiei „Rotire cameră la virare” la mersul cu spatele."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, camera de interior se va roti către stânga sau către dreapta în funcţie de utilizarea semnalizării."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "După activare, camera interioară răspunde la mişcările vehiculului."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică dinamica mişcării camerei interioare în raport cu mişcarea vehiculului."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Modifică cât de mult se permite camerei interioare să se rotească raportat la mişcările vehiculului."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Setează întârzierea cu care camera se va recentra automat.<br><br>Vehiculul trebuie să se deplaseze cu o viteză non-neglijabilă pentru activarea acestei funcţii. Se aplică numai la camera de urmărire şi la cea de interior în timpul deplasării înainte şi la camera geamului şoferului în timpul mersului cu spatele."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Setează viteza pentru mişcarea camerei. Utilizată de centrarea automată a camerei şi la comutarea între presetările camerei de interior."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Determină cum funcţionează zoomul de interior: ţineţi apăsat pentru a da zoom temporar sau apăsaţi o dată pentru a-l comuta." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Selectează limba în care jocul va fi afişat."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Modifică tipul valutei şi unităţilor de măsură în funcţie de regiunea selectată."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "După activare, oraşele şi ţările vor fi afişate în limba selectată."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "După activare, oraşele şi ţările vor fi afişate în limba selectată, precum şi în limba naţională a acelei regiuni de pe hartă."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Alegeţi ce valută utilizaţi."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Alegeţi între ceasul afişat în 12 ore sau în 24 de ore."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
