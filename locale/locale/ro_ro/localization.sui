#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "URMĂRIREA OCHILOR" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Extended View" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Setări Extended View" #+ Label of combo box with list of presets for the extended view

	key[]: "eye_preset_name_hint"
	val[]: "Introduceţi numele setării" #+ Hint shown within empty text input box used to enter name of new extended view preset

	key[]: "eye_preset_delete_confirmation"
	val[]: "Doriţi cu siguranţă ştergerea presetării selectate?" #+ Confirmation dialog shown when user requests deletion of extended view preset

	key[]: "eye_preset_overwrite_confirmation"
	val[]: "Setarea existentă cu acelaşi nume va fi suprascrisă. Doriţi să continuaţi?" #+ Confirmation dialog shown when user tries to create preset with already existing names

	key[]: "eye_gaze_settings"
	val[]: "Setări de Urmărire a Privirii" #+ Header of the gaze settings

	key[]: "eye_headtracking_settings"
	val[]: "Setări de Urmărire a Capului" #+ Header of headtracking settings

	key[]: "eye_controls_settings"
	val[]: "Comenzi Tastatură" #+ Header of keyboard controls

	key[]: "eye_extended_view"
	val[]: "Activare Extended View" #+ Extended View enable checkbox.

	key[]: "eye_autocenter"
	val[]: "Activare auto-centrare" #+ Headtracking autocentring

	key[]: "eye_head_mode"
	val[]: "Mod de urmărire a capului" #+ Mode to use for head tracking (https://help.tobii.com/hc/en-us/articles/115000011125-Customization-in-Tobii-Game-Hub)

	key[]: "eye_head_mode_direct"
	val[]: "Direct" #+ Type of head tracking mode

	key[]: "eye_head_mode_dynamic"
	val[]: "Dinamic" #+ Type of head tracking mode

	key[]: "eye_gaze_view_responsiveness"
	val[]: "Sensibilitatea vizibilităţii privirii" #+ How fast the view reacts to gaze changes

	key[]: "eye_head_view_responsiveness"
	val[]: "Sensibilitatea vizibilităţii capului" #+ How fast the view reacts to head position/orientation changes

	key[]: "eye_head_roll"
	val[]: "Activare rotaţie" #+ Enables the roll component of head orientation

	key[]: "eye_head_position"
	val[]: "Activare poziţie" #+ Enables use of head position

	key[]: "eye_yaw_scale"
	val[]: "Coeficient giraţie (în cabină)" #+ Multiplier applied to resulting yaw value (in cabin)

	key[]: "eye_pitch_scale"
	val[]: "Coeficient tangaj (în cabină)" #+ Multiplier applied to resulting pitch value (in cabin)

	key[]: "eye_walk_mode_yaw_scale"
	val[]: "Coeficient giraţie (în modul Mers)" #+ Multiplier applied to resulting yaw value (in walk mode)

	key[]: "eye_walk_mode_pitch_scale"
	val[]: "Coeficient tangaj (în modul Mers)" #+ Multiplier applied to resulting pitch value (in walk mode)

	key[]: "eye_gaze_max_angle"
	val[]: "Unghiul maxim de privire" #+ Maximal angle change generated by gaze tracking.

	key[]: "eye_gaze_scale"
	val[]: "Viteza de urmărire a privirii"

	key[]: "eye_gaze_exponent"
	val[]: "Exponentul de urmărire a privirii"

	key[]: "eye_gaze_inflection_point"
	val[]: "Punctul de inflexiune de urmărire a privirii"

	key[]: "eye_gaze_start_point"
	val[]: "Punctul de începere a urmăririi privirii"

	key[]: "eye_gaze_end_point"
	val[]: "Punctul terminus de urmărire a privirii"

	key[]: "eye_head_drive_yaw_scale"
	val[]: "Sensibilitate giraţie pentru urmărirea capului (în cabină)"

	key[]: "eye_head_drive_pitch_scale"
	val[]: "Sensibilitate tangaj pentru urmărirea capului (în cabină)"

	key[]: "eye_head_walk_yaw_scale"
	val[]: "Sensibilitate giraţie pentru urmărirea capului (în modul mers)"

	key[]: "eye_head_walk_pitch_scale"
	val[]: "Sensibilitate tangaj pentru urmărirea capului (în modul mers)"

	key[]: "eye_head_exponent"
	val[]: "Exponentul de urmărire a capului"

	key[]: "eye_head_inflection_point"
	val[]: "Punctul de inflexiune de urmărire a capului"

	key[]: "eye_head_start_point"
	val[]: "Punctul de început pentru urmărirea capului"

	key[]: "eye_head_end_point"
	val[]: "Punctul terminus de urmărire a capului"

	key[]: "eye_extended_view_op_tooltip"
	val[]: "Activează Extended View ce măreşte unghiul de vizualizare prin utilizarea mişcării capului şi/sau a ochilor pentru a controla camera jocului."

	key[]: "eye_preset_op_tooltip"
	val[]: "Selectarea setărilor Extended View."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Selectarea modurilor de urmărire a capului:<br>- În modul „Direct” rotaţia capului corespunde direct cu o rotaţie a camerei din joc. Este recomandat pentru situaţiile normale din cockpit/cabină.<br>- În modul „Dinamic” privirea va avea efect asupra camerei din joc doar atunci când întoarceţi capul. Este recomandat atunci când este important ca imaginea să fie absolut centrată."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Odată activată, camera din joc se va recentra uşor şi continuu în timp ce vă schimbaţi poziţia naturală a capului în timpul jocului."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Odată activată, poziţia capului va influenţa poziţia camerei din joc."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Odată activată, camera din joc se va înclina corespunzător cu înclinarea capului spre lateral."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multiplică rotaţia combinată a capului şi a vederii în direcţia orizontală (în cabină)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multiplică rotaţia combinată a capului şi a vederii în direcţia verticală (în cabină)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multiplică rotaţia combinată a capului şi a vederii în direcţia orizontală (în modul mers)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multiplică rotaţia combinată a capului şi a vederii în direcţia verticală (în modul mers)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Ajustează cât de rapid va răspunde camera din joc mişcărilor privirii voastre."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Ajustează cât de gradual se va intensifica viteza."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Ajustează distanţa de la centrul ecranului de unde accelerarea va începe să fie plafonată."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Ajustează cât de mult de la centrul ecranului va trebui să priviţi înainte de începerea mişcării camerei din joc."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Ajustează cât de mult de la centrul ecranului va trebui să priviţi pentru a atinge viteza maximă a camerei."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Determină cât de departe se poate roti camera atunci când vă uitaţi înspre marginile ecranului."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Ajustează cât de rapid va răspunde camera din joc mişcărilor capului dumneavoastră."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Ajustează cât de mult se va mişca, stânga sau dreapta, camera din joc comparativ cu cât de mult vă mişcaţi capul (în cabină)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Ajustează cât de mult se va mişca, în sus sau în jos, camera din joc comparativ cu cât de mult vă mişcaţi capul (în cabină)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Ajustează cât de mult se va mişca, stânga sau dreapta, camera din joc comparativ cu cât de mult vă mişcaţi capul (în modul mers)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Ajustează cât de mult se va mişca, în sus sau în jos, camera din joc comparativ cu cât de mult vă mişcaţi capul (în modul mers)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Ajustează cât de gradual se va intensifica viteza."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Ajustează cât de mult va trebui să vă rotiţi capul înainte ca accelerarea va începe să fie plafonată."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Ajustează cât de mult trebuie să vă rotiţi capul de la poziţia centrală înainte de începerea mişcării camerei din joc."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Ajustează cât de mult trebuie să vă rotiţi capul de la poziţia centrală pentru a atinge rotaţia maximă a camerei."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Selecţia modurilor de auto-pauză."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Ajustează perioada de timp în milisecunde înainte ca jocul să intre automat în pauză atunci când nu vă poate detecta privirea."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Atribuie un buton ce setează poziţia curentă a capului ca noua poziţie implicită, recentrând în consecinţă camera din joc."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Atribuie un buton ce porneşte/opreşte toate funcţiile Tobii Extended View."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Atribuie un buton ce deschide setările de Urmărirea Ochilor."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Atribuie un buton ce activează Urmărirea Capului."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Atribuie un buton pentru aplicarea Setărilor Extended View respective."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Atribuie un buton pentru aplicarea Setărilor Extended View respective."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Atribuie un buton pentru aplicarea Setărilor Extended View respective."
#@}

