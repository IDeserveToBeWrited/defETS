	val[]: "Cuplare:<br><br>A cincea roată blocată. Se ridică suporturile şi se ataşează cablurile..."

	key[]: "trailer_decoupling"
	val[]: "Se decuplează:<br><br>Se resetează suspensia, se coboară picioarele, se detaşează cablurile şi se deblochează a cincea roată..."

#@}

#+ Mod dependencies related strings
#@{
	key[]: "dependencies"
	val[]: "Dependenţe" #+ Title of the section in mod details window displaying list of the dependencies the mod has.

	key[]: "missing_mod_dependencies_detected"
	val[]: "Acest mod necesită anumite pachete DLC. Asiguraţi-vă că acestea există şi sunt activate." #+ The message showed when user has one of MOD dependencies missing.
#@}

#+ Version change detected message box.
#@{
	key[]: "version_change_detected_t"
	val[]: "NECONCORDANŢĂ VERSIUNE" #+ Title of the infomational message box when version change has been detected.

	key[]: "version_upgrade_detected"
	val[]: "Jocul a fost actualizat la o nouă versiune" #+ The message showed when upgrade of the game to the newer version has been detected.

	key[]: "version_downgrade_detected"
	val[]: "Versiunea jocului a fost modificată la un nivel anterior" #+ The message showed when downgrade of the game to the older version has been detected.

	key[]: "version_change_detected_common"
	val[]: "<br><br>Schimbările de versiune ale jocului pot defecta modurile, rezultând în blocări ale jocului sau instabilităţi; autorii modurilor sunt responsabili pentru menţinerea compatibilităţii acestora. Asiguraţi-vă că modurile activate sunt compatibile. <br><br>Sfat pentru depanare: Dacă versiunea actuală a modului este incompatibilă, încercaţi să-l dezactivaţi în Administrarea Modurilor. <br><br> Versiunea jocului: $GAME_VERSION$" #+ Common message (showed for both downgrade and upgrade) in the version change dialog.
#@}

#+ Strings related to accessory filtering feature.
