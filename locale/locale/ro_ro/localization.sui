	key[]: "demo_quit"
	val[]: "Confirmaţi ieşirea?" #+ The quit confirmation message
#@}

#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "CONŢINUT WORLD OF TRUCKS CONECTAT" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Conectare" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Accesează" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "PREFERINŢE GENERALE" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONECTARE" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Conectare" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks a detectat conţinut nou, în joc. Puteţi să-l conectaţi la serviciile World of Trucks pentru a beneficia de toate avantajele." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Preferinţe online. Ajustaţi parametrii World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Confirmaţi amânarea înregistrării conţinutului?<br><br>Puteţi reveni ulterior la conţinutul online, din secţiunea Preferinţe Online, de pe Desktop." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "CONECTARE" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Conectare..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Eroare în plasarea la coadă a operaţiunii de conectare pentru: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Contul Steam utilizat pentru înregistrarea acestui pachet DLC nu corespunde contului folosit pentru crearea contului World of Trucks curent sau pentru activarea jocului. Vă rugăm să vă autentificaţi cu acel cont Steam şi sp încercaţi din nou." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Contul Steam utilizat pentru înregistrarea acestui pachet DLC nu corespunde contului World of Trucks curent. Pentru înregistrarea acestui pachet pentru contul current, este nevoie să utilizaţi un cont Steam diferit." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Autorizarea Steam a expirat. Vă rugăm reveniţi." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Cheia de activare pentru acest DLC nu este validă. Vă rugăm să contactaţi SCS Software pentru asistenţă la adresa: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "A apărut o eroare în timpul înregistrării jocului. Vă rugăm să reveniţi ulterior." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCCES" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "CATALOG DE CONŢINUT" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Felicitări! Pachetele DLC au fost conectate la contul World Of Trucks." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nu se poate realiza conectarea - contul Steam curent este asociat unui cont World of Trucks diferit." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Unele pachete DLC nu s-au conectat.<br>Treceţi cu mouse-ul peste semnele de exclamare ale fiecărui pachet DLC pentru mai multe detalii." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Accesare $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Profilul curent nu este conectat la World of Trucks sau jocul este în modul off-line. Editaţi profilul pentru conectare." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Click pentru Respingere"

	key[]: "online_connect_content_info"
	val[]: "Pachete DLC compatibile conectate <color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ . Dacă unele dintre pachetele DLC nu sunt conectate la World of Trucks, unele caracteristici ar putea fi indisponibile.." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Felicitări! <color value=@@clr_txt@@>Tot conţinutul deţinut este conectat la World of Trucks! Acum puteţi utiliza toate funcţiile acesteia." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Imposibil de realizat conectarea conţinutului la World of Trucks - contul de Steam nu este cel asociat profilului World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Conectat" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Neconectat!" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Descărcarea listei de conţinut eşuată." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Descărcarea informaţiilor despre acest conţinut a eşuat." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Descărcarea informaţiilor contului eşuată." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Mai târziu" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Nu se poate înregistra acest DLC. Probabil, din cauze legate de Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Lipsă Licenţă Permanentă" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Transport Specializat livrat cu succes!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISIUNE EŞUATĂ!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Abandonează"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Încărcare Punct de Referinţă"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Aţi avariat un vehicul escortă!<br> Puteţi încărca un punct de referinţă anterior sau renunţa la livrare contra unei penalităţi de $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Vehiculul escortă a fost avariat de un alt participant la trafic.<br> Puteţi încărca un punct de referinţă anterior sau renunţa la livrare contra unei penalităţi de $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Nu aţi urmat ruta prestabilită.<br> Puteţi încărca un punct de referinţă anterior sau renunţa la livrare contra unei penalităţi de $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Nu aţi reuşit să rămâneţi între vehiculele escortă.<br> Puteţi încărca un punct de referinţă anterior sau renunţa la livrare contra unei penalităţi de $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "V-aţi separat de vehiculul escortă!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Aţi avariat vehiculul escortă!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Vehiculul escortă a fost avariat!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Aţi părăsit ruta prestabilită!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimensiuni"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Livrare Specială"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Menţineţi încărcătura între vehiculele escortă."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Livrări Speciale"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimensiuni"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Transport Special"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Reduceţi viteza pentru a evita acroşarea vehiculului escortă din faţă."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Aşteptaţi vehiculul escortă spate..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Cu grijă, se apropie o zonă strâmtă..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Vă apropiaţi de o zonă de schimbare a benzii. Adaptaţi viteza, pentru evitarea oricărui incident."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Vehiculul escortă antemergător va avertiza ceilalţi participanţi la trafic... <br> Adaptaţi viteza pentru evitarea oricăror incidente..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Vehicule de escortă vă aşteaptă la o intersecţie din apropiere. Vă rugăm respectaţi ruta."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Atenţie!<br>Vă apropiaţi de vehiculul escortă din spate!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Atenţie!<br>V-aţi apropiat prea mult de vehiculul escortă din spate!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Apăsaţi următoarea tastă pentru a vedea detaliile livrării speciale:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Ofertă Livrare Specială"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Sunteţi pe cale să transportaţi o încărcătură de tip Transport Agabaritic! Sunt prezente două vehicule escortă ce vă vor ghida. Vă rugăm să fiţi atenţi şi urmaţi indicaţiile acestora şi notificările sugerate. Transporturile speciale ca acesta nu opresc la culoarea roşie a semaforului şi au prioritate de trecere în majoritatea situaţiilor. Pe parcursul acestor livrări, progresul realizat va fi salvat în mod frecvent în anumite puncte de referinţă."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Atenţie la următoarele aspecte:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Evitaţi orice conflict cu vehiculele escortă şi menţineţi încărcătura între acestea."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Nu părăsiţi ruta prestabilită, nu intraţi în staţii de carburanţi, locuri de odihnă etc."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Respectaţi limitele de viteză impuse de vehiculul escortă antemergător."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Atenţie la traficul care vă depăşeşte şi la ceilalţi participanţi din trafic."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Schimbarea benzii de circulaţie."

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Dacă nu urmaţi aceste reguli, livrarea specială va eşua!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manevra este declanşată de vehiculul escorta <color value=@@clr_sel@@>spate<color value=@@clr_txt@@> prin blocarea benzi de circulaţie necesare."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Vehiculul escortă din <color value=@@clr_sel@@>faţă<color value=@@clr_txt@@> va aştepta până banda se eliberează şi va schimba banda, deasemenea."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Apoi va fi momentul pentru ca <color value=@@clr_sel@@>vehiculul agabaritic<color value=@@clr_txt@@> să înceapă manevra de schimbare a benzii eliberate de vehiculele escortă."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Rezervoarele de carburant ale camionului au fost umplute şi orele de condus au fost restabilite."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Nu puteţi apela asistenţa rutieră, in timpul unei Livrări Speciale."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Nu puteţi folosi feribotul în timpul unui Transport Special"

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Vă odihniţi...<br>Între timp, camionul este realimentat..."

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Pauza obligatorie se aproprie.<br>Urmaţi escorta până la locul de parcare pentru a vă odihni!"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Pauză obligatorie"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Apăsaţi următoarea tastă pentru odihnă şi realimentare:"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "O eroare a apărut la încărcarea inventarului Steam.<br><br>$ERROR$<br><br>Selectaţi 'Continuă' pentru a menţine elementul activat. Jocul va reîncerca periodic încărcarea.<br><br>Pentru a evita apariţia acestui mesaj, din nou, puteţi dezactiva temporar elementul. La următoarea pornire a jocului acest conţinut va fi reactivat automat." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Eroare descărcare inventar Steam" #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "INVENTAR STEAM" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Se încarcă Inventarul Steam" #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "ELEMENTE NOI INVENTAR" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "S-au detectat elemente noi în inventarul Steam." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Accesorii Vehicul" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Accesorii Cabină" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Fundal Desktop" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Schemă de Vopsire" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Dezactivare Inventar" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Reîncercaţi mai târziu" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "Inventar Steam" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Unele elemente au fost eliminate din inventarul dvs. Steam. Nu veţi mai putea să le achiziţionaţi din Configuratorul de Camioane.<br><br>Acest lucru nu afectează elementele instalate în prezent." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


