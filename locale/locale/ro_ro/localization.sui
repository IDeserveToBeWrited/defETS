	key[]: "bank_link_title"
	val[]: "Unitate Bancară" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Pentru fonduri suplimentare, puteţi, oricând, contacta banca." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "OFERTE ÎMPRUMUT" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "pentru suma zilnică de $MONEY$" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

