#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Pachetul obligatoriu DLC $DEPENDENCY_NAME$ lipseşte. Pentru a putea încărca această salvare, acest pachet trebuie încărcat şi activat pe acest computer. Va trebui să rezolvaţi această problemă înainte de a continua încărcarea." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Pachetul DLC opţional $DEPENDENCY_NAME$ lipseşte. Dacă aceaastă situaţie este în neregulă, vă rugăm să verificaţi starea acestuia.<br><br>În caz contrar, puteţi continua încărcarea acestei salvări, cu riscul de a nu beneficia de unele funcţionalităţi oferite de acest pachet." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Următorul MOD $DEPENDENCY_NAME$ lipseşte sau este dezactivat. Dacă această situaţie este neaşteptată, vă rugăm să verificaţi starea acestuia. Puteţi totuşi continua încărcarea salvării, cu riscul ca procesul să eşueze sau să apară alte probleme." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Următorul MOD $DEPENDENCY_NAME$ este incompatibil cu versiunea curentă a jocului. Autorul acestuia a decis să limiteze numărul de versiuni cu care acesta este compatibil .<br><br>Soluţii:<br>- Încercaţi să găsiţi o versiune a mod-ului compatibilă cu versiunea jocului.<br>- Aduceţi jocul la versiunea compatibilă cu mod-ul, prin upgrade sau downgrade.<br><br>Puteţi, totuşi, încerca încărcarea salvării, dar acest mod nu va fi luat în considerare şi, în funcţie de funcţionalităţile acestuia, este posibil ca încprcarea să eşueze sau să genereze alte probleme." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "DEPENDENŢE LIPSĂ" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETALII" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Deschideţi pagina Workshop"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Această salvare depinde de pachete DLC sau mod-uri ce lipsesc, prezentate mai jos. Obţineţi mai multe informaţii selectând elementele din listă." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Această salvare depinde de un pachet obligatoriu DLC sau un mod. Este necesar să rezolvaţi această situaţie, înainte de a continua încărcarea." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Anulaţi descărcarea" #+ Abort loading button.

