#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Selectează subtipul controlerului pentru ca jocul să gestioneze corect intervalele de input."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Selectează tipul transmisiei:<br>- „Automată simplificată” permite folosirea acceleraţiei şi a frânei pentru a controla mişcarea de înainte şi înapoi.<br>- „Automată” necesită un input pentru a schimba între vitezele de înainte şi înapoi.<br>- „Secvenţială” necesită schimbarea manuală a tuturor vitezelor prin comenzi de urcare/coborâre a treptelor.<br>- „H-Shifter” necesită utilizarea unui controller cu porţi de comutare pentru a selecta vitezele manual."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Modifică logica schimbării vitezelor a transmisiei automate:<br>- modul „Economic” preferă turaţii mai scăzute, orientat spre cuplul maxim.<br>- modul „Putere” se orientează spre maxim de putere pentru o mai bună performanţă la condus în zonele montane sau în cazul încărcăturilor agabaritice, în detrimentul consumului de carburant."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează raportul dintre gradul de rotaţie al dispozitivului şi gradul real de rotaţie al volanului vehiculului."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează linearitatea dintre comenzi şi virarea vehiculului.<br><br>O valoare ridicată înseamnă că virarea va fi mai puţin sensibilă cu volanul la centru şi că va creşte în sensibilitate pe măsură ce volanul este rotit spre unghiul de bracare maxim. Acest lucru poate fi util pentru a limita comenzile virării atunci când conduceţi în linie dreaptă."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Activează force feedbackul pentru controlerele acceptate."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează avansul general pentru toate setările force feedbackului între 0N şi 1N.<br><br><color value=@@clr_txt_d@@>Ţineţi cont că în cazul volanelor mai puternice o valoare mai mare poate provoca vătămarea degetelor sau mâinilor."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează forţa de centrare la viteze ridicate, ce îşi atinge maxima la 90 km/h (56 mph) sau mai mult.<br><br>Setarea la minim va avea ca rezultat lipsa forţei de centrare a volanului."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează forţa de centrare la viteze mici.<br><br>Setarea la minim va avea ca rezultat lipsa forţei de centrare a volanului."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea frecării interne artificiale cauzate de componentele mecanice ale volanului."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea vibraţiilor artificiale ale motorului camionului prin coloana de direcţie.<br><br><color value=@@clr_txt_d@@>Reţineţi că setarea acestei valori peste 15% poate provoca zguduieli şi vibraţii excesive ale unor volane."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea efectelor suprafeţei drumului prin coloana de direcţie.<br><br><color value=@@clr_txt_d@@>Reţineţi că setarea acestei valori peste 20% poate provoca zguduieli şi vibraţii excesive ale unor volane atunci când conduceţi cu viteză pe teren accidentat."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea efectelor denivelărilor drumului prin coloana de direcţie."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea efectelor coliziunilor prin coloana de direcţie."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea efectelor de frecare a cutiei de viteze."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea efectelor de alunecare la subvirare."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea direcţiei asistate (când se utilizează funcţia de asistent bandă, etc.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea vibraţiilor pentru suprafaţa terenului, în cazul în care controlerul acceptă feedbackul vibraţiilor."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea vibraţiilor denivelărilor, în cazul în care controlerul acceptă feedbackul vibraţiilor."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează intensitatea vibraţiilor de coliziune, în cazul în care controlerul acceptă feedbackul vibraţiilor."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Axa dispozitivului folosită pentru virare."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează unghiul mort al axei de virare; valoarea rotaţiei de la centru în care comanda este ignorată.<br><br>Aceasta poate atenua problemele controlerelor mai vechi, cum ar fi inexactitatea sau mişcările false cauzate de uzură."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determină modul în care jocul gestionează comanda axei de virare:<br>- Centrată este ideal pentru volane sau joystickuri.<br>- Inversată este folosit pentru a corecta o axă care a fost detectată incorect."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Axa dispozitivului folosită pentru a accelera vehiculul."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează unghiul mort al axei de accelerare; valoarea cursei comenzii prin care nu se înregistrează nicio comandă.<br><br>Aceasta poate atenua problemele controlerelor mai vechi, cum ar fi inexactitatea sau mişcările false cauzate de uzură."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determină modul în care jocul gestionează comanda controlerului:<br>- Centrată este ideal pentru joystickuri.<br>- Normală este ideal pentru manete şi pedale.<br>- Inversată poate compensa pentru mişcările detectate incorect."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Axa dispozitivului folosită pentru frânare."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează unghiul mort al axei de frânare; valoarea cursei comenzii prin care nu se înregistrează nicio comandă.<br><br>Aceasta poate atenua problemele controlerelor mai vechi, cum ar fi inexactitatea sau mişcările false cauzate de uzură."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determină modul în care jocul gestionează comanda controlerului:<br>- Centrată este ideal pentru joystickuri.<br>- Normală este ideal pentru manete şi pedale.<br>- Inversată poate compensa pentru mişcările detectate incorect."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Axa dispozitivului folosită pentru a cupla ambreiajul."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează unghiul mort al axei ambreiajului; valoarea cursei comenzii prin care nu se înregistrează nicio comandă.<br><br>Aceasta poate atenua problemele controlerelor mai vechi, cum ar fi inexactitatea sau mişcările false cauzate de uzură."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determină modul în care jocul gestionează comanda controlerului:<br>- Centrată este ideal pentru joystickuri.<br>- Normală este ideal pentru manete şi pedale.<br>- Inversată poate compensa pentru mişcările detectate incorect."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează plaja ambreiajului.<br><br>Cu cât intervalul este setat mai spre dreapta, cu atât va trebui să apăsaţi mai mult pedala pentru a cupla ambreiajul."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Axa dispozitivului folosită pentru a înclina camera în sus şi în jos."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează unghiul mort al axei vizuale verticale; valoarea cursei comenzii prin care nu se înregistrează nicio comandă.<br><br>Aceasta poate atenua problemele controlerelor mai vechi, cum ar fi inexactitatea sau mişcările false cauzate de uzură."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determină modul în care jocul gestionează comanda axei:<br>- Centrată este ideal pentru joystickuri.<br>- Inversată este folosit pentru a corecta o axă care a fost detectată incorect."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Axa dispozitivului folosită pentru a panorama camera la stânga şi la dreapta."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Ajustează unghiul mort al axei vizuale orizontale; valoarea cursei comenzii prin care nu se înregistrează nicio comandă.<br><br>Aceasta poate atenua problemele controlerelor mai vechi, cum ar fi inexactitatea sau mişcările false cauzate de uzură."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Determină modul în care jocul gestionează comanda axei:<br>- Centrată este ideal pentru joystickuri.<br>- Inversată este folosit pentru a corecta o axă care a fost detectată incorect."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Selectează dispunerea vitezelor pentru a fi folosite cu un H-Shifter."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Schimbă comportamentul schimbătorului:<br>- Cu opţiunea „Simplificat”, la schimbarea vitezelor, acestea nu vor freca niciodată.<br>- Opţiunea „Simplificat + Sunete avertizare” permite schimbarea vitezele la fel de simplu, dar cu sunete de frecare corespunzătoare cu schimbările incorecte.<br>- Opţiunea „Avansat” nu va permite schimbările incorecte ale vitezelor şi vor fi doar sunetele de frecare. În plus, opţiunea „Avansat” permite folosirea setării „divizare rapidă schimbător”."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Alege modul în care jocul gestionează divizarea rapidă a vitezelor:<br>- „Niciodată” va necesita mutarea schimbătorului în poziţia neutru între schimbări.<br>- „Acţionare ambreiaj” necesită o apăsare de un moment a ambreiajului fără o mişcare a schimbătorului.<br>- „Eliberare acceleraţie” necesită lipsa aplicării acceleraţiei pentru a diviza vitezele fără o mişcare a schimbătorului, şi „Ambreiaj sau acceleraţie” este o combinaţie a celor două din urmă."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Atribuie poziţia schimbătorului."

