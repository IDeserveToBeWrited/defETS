#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "VALORI GRAFICE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Valori Grafice" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Ajustaţi setările grafice folosind presetări fin-reglate pentru a vă personaliza performanţa vizuală după bunul plac."

	key[]: "apply"
	val[]: "Confirmare" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Temă Desktop" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ECRAN" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "CALITATEA IMAGINII" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURI" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEXII" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "UMBRE" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ILUMINARE" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POSTPROCESARE" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "MEDIU AMBIANT" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Pe tot ecranul" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Luminozitate / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Configurare" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Rezoluţie" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Rată refresh" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limită FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limită FPS în fundal" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Implicit" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Sincronizare verticală" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Economic (Economiseşte energie pe notebook-uri)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "OPŢIUNI GRAFICE SIMPLE" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "VALORI PERSONALIZATE APLICATE" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "OPŢIUNI GRAFICE AVANSATE" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Opţiuni grafice simple/avansate" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Ascundere opţiuni avansate" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Afişare opţiuni avansate" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Raport mărime" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Accentuare luma TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Reglare TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Claritate adaptivă" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Mereu delicat" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Mereu amplificat" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Screen space ambient occlusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Gamă dinamică extinsă (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Perspectivă (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Raze solare" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Corecţie culoare" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Intensitate Reflexii" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Calitate reflexiilor" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Detalii vegetaţie" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densitate vegetaţie" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Calitate umbre"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Dimensiune textură umbre" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Umbre îndepărtate" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Umbre de interior" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Calitate condiţii meteo"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Calitate oglinzi" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Rezoluţie oglinzi" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Vizibilitate oglinzi" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Calitate textură" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtru anisotropic" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Mapping grafic normal" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Lumini participanţi trafic" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Lumini secundare vehicul" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Iluminare ambientală" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Pietoni" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Configuraţia grafică a fost modificată.<br>Confirmaţi păstrarea acestor valori?"

	key[]: "reverting_in"
	val[]: "Revenire în" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "secunde" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "După activare, jocul va fi afişat pe tot ecranul."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Ajustează luminozitatea generală a jocului pentru a se alinia ecranului dvs. Pe ecranele compatibile HDR, opţiunea de calibrare HDR va fi de asemenea disponibilă în această setare."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Modifică rezoluţia jocului."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Modifică ţinta ratei de refresh a jocului."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Sincronizează rata cadrelor cu rata de refresh a monitorului pentru a preveni efectul de rupere al imaginii. Setarea Economic înjumătăţeşte rata cadrelor, rezultând un consum mai mic de energie."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Setează rata maximă de cadre permisă pentru joc.<br><br>Setarea valorii la 0 va dezactiva funcţia."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Setează rata maximă de cadre permisă pentru joc atunci când este minimizat în fundal.<br><br>Setarea valorii la 0 va dezactiva funcţia."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Schimbă între opţiunile grafice simple (presetate) şi opţiunile grafice avansate (cu posibilitatea modificării individuale a parametrilor)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Îmbunătăţeşte calitatea grafică prin redarea jocului la o rezoluţie internă mai mare, ceea ce reduce marginile neregulate şi îmbunătăţeşte detaliile.<br>De exemplu, selectarea unei opţiuni de scalare mai mare duce la o imagine mai clară, cu mai puţine neclarităţi, ceea ce face ca jocul să arate mai bine în detrimentul performanţei.<br><br><color value=@@clr_txt_d@@>Această setare are adesea un impact mare asupra performanţei."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Selectarea metodelor anti-aliasing de mare viteză ce netezesc aspectul marginilor neregulate din joc:<br>- SMAA eşantionează fiecare pixel de multiple ori (în funcţie de calitatea selectată) în diferite locaţii ale cadrului şi calculează media eşantioanelor pentru a realiza imaginea finală.<br>- TAA eşantionează fiecare pixel o singură dată pe cadru, dar eşantionarea lor se produce în locaţii şi cadre diferite.<br>- Pentru cel mai bun rezultat puteţi selecta şi o combinaţie a metodelor, dar cu un cost asupra performanţei.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Adaugă umbre blânde crăpăturilor şi obiectelor apropiate una faţă de cealaltă, îmbunătăţind calitatea grafică percepută a întregii lumi din joc.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Selectarea presetărilor TAA:<br>- „Mereu delicat” va duce la mai puţin tremur/mai multă blurare - este adecvat pentru utilizatorii de PC ce activează supersampling-ul sau au monitoare cu un DPI mare, dar şi pentru utilizatorii de TV-uri 1080p ce stau mai departe de ecran.<br>- „Mereu amplificat” duce la mai mult tremur/mai puţină blurare - probabil, cea mai bună opţiune pentru utilizarea la sub 1080p, ca în cazul laptopurilor sau a unui Steam Deck.<br>- „Claritate adaptivă” dezactivează dinamic distorsiunea TAA atunci când camera este statică.<br><br><color value=@@clr_txt_d@@>Această setare poate fi utilizată doar atunci când TAA este selectată ca metodă de anti-aliasing."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează intensitatea dată de accentuarea luma TAA.<br><br><color value=@@clr_txt_d@@>Această setare poate fi utilizată doar atunci când TAA este selectată ca metodă de anti-aliasing."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "După activare, anumite zone din depărtare vor fi blurate artificial pentru a crea o diminuare realistă a focalizării imaginii."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "După activare, anumite raze de lumină devin vizibile la privirea soarelui sau la privirea soarelui printre lucruri precum copaci, clădiri sau vehicule."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "După activare, culorile jocului sunt ajustate dinamic din motive estetice. Scenele vor potrivi mai bine momentele zilei şi condiţiile meteo, culorile vehiculelor şi ale obiectelor pot fi mai vibrante, etc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Îmbunătăţeşte reflexiile prin redarea lor la o calitate internă mai mare, precum şi utilizând un mai bun anti-aliasing.<br><br><color value=@@clr_txt_d@@>Modificările aduse acestei setări vor avea efect numai după repornirea manuală a jocului."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează detaliul reflexiilor vizibile de pe suprafeţele vehiculelor, geamurilor sau altor suprafeţe reflectante precum băltoace, drumuri ude sau întinderi de apă.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei.<br><br>Modificările aduse acestei setări vor avea efect numai după repornirea manuală a jocului."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează detaliul şi complexitatea plantelor şi copacilor.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează densitatea ierbii de pe marginile drumului.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează calitatea umbrelor produse de soare sau de lună.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Permite redarea umbrelor şi de la obiecte foarte îndepărtate.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Activează umbre dinamice nocturne în interiorul vehiculului.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează calitatea efectelor meteorologice, precum reflexiile."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează calitatea reflexiilor văzute în oglinzile vehiculului (independent de setările reflexiilor).<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează rezoluţia imaginii redate pe oglinzile vehiculului utilizat."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează distanţa la care obiectele încep să fie văzute în oglinzi.<br><br><color value=@@clr_txt_d@@>Această setare are adesea un impact mare asupra performanţei."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează calitatea unor texturi aplicate obiectelor şi suprafeţelor din joc."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Îmbunătăţeşte claritatea texturilor, în special a celor privite de la distanţă sau sub un unghi oblic.<br><br><color value=@@clr_txt_d@@>Modificările aduse acestei setări vor avea efect numai după repornirea manuală a jocului."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Adaugă apariţia unor detalii geometrice pe trotuare, drumuri şi pe alte obiecte pentru a le îmbunătăţi aspectul.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei.<br><br>Modificările aduse acestei setări vor avea efect numai după repornirea manuală a jocului."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Permite iluminarea provenită de la farurile celorlalte vehicule din trafic."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Permite iluminarea provenită de la luminile secundare ale celorlalte vehicule din trafic, precum semnalizarea, frânarea, etc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Ajustează distanţa de la care pot fi văzute sursele artificiale de lumină.<br><br><color value=@@clr_txt_d@@>Această setare are de obicei un impact moderat asupra performanţei."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Activează apariţia pietonilor în joc."
#@}

