#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "Force feedback" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "Resetare la valori Implicite" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Intensitate totală" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "Centrare la viteză ridicată" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "Centrare la viteză joasă" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "Frecare internă" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "Vibraţii motor" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "Suprafaţă teren" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "Denivelări" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "Coliziuni" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "Frecare cutie de viteze" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "Alunecare la subvirare" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "Direcţie asistată" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "Vibraţii suprafaţă teren" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "Vibraţii denivelări" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "Vibraţii coliziuni" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

	key[]: "ffb_lut_usage_hint"
	val[]: "Jocul utilizează un LUT personalizat pentru force feedback şi nu este disponibil niciun suport pentru acesta. În caz de probleme cu force feedback-ul încercaţi să eliminaţi fişierul acestuia din dosarul profilului de utilizator!" #+ Hint telling player that the game is using custom force feedback LUT loaded from profile folder and to remove it in case of problems.
#@}

