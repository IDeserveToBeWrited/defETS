#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Fişierul este prea mare. Încercaţi reducerea dimensiunilor fotografiei." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Fişierul de captură de ecran este corupt sau într-un format neacceptat." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Rezoluţia capturii de ecran este prea mare. Încercaţi reducerea rezoluţiei ecranului." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
