#+ Configuration of autopause.
#@{
	key[]: "eye_autopause_settings"
	val[]: "Autopauză" #+ Hader of the section.

	key[]: "eye_autopause_mode"
	val[]: "Modul Autopauză" #+ Type of the autopause

	key[]: "eye_autopause_mode_never"
	val[]: "Dezactivat" #+ Autopause is disabled

	key[]: "eye_autopause_mode_presence"
	val[]: "Prezenţă" #+ Autopause if user is not present

	key[]: "eye_autopause_mode_gaze"
	val[]: "Prezenţă + Privire" #+ Autopause if user is not present or not looking at the game for at least eye_autopause_gaze

	key[]: "eye_autopause_gaze"
	val[]: "Prag pentru lipsă contact vizual" #+ How long must be the gaze absent from the game before pausing it in eye_autopause_gaze mode
