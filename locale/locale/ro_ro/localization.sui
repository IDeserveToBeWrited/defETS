	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "Livrarea curentă este către o companie ce este inactivă în această sesiune.<br>Dacă doriţi să vă conectaţi, finalizaţi livrarea sau aceasta va fi suspendată şi indisponibilă în cadrul acestei sesiuni.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Livrarea curentă este către o companie ce este inactivă în această sesiune.<br>Dacă doriţi să vă conectaţi, finalizaţi livrarea sau aceasta va fi anulată.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "O companie din apropierea camionului sau a remorcii va trebui activată pentru a vă putea alătura acestei sesiuni.<br>Pentru a evita orice probleme, vă rugăm mutaţi camionul şi remorca mai departe de companie sau cursa curentă va fi suspendată şi indisponibilă în această sesiune şi veţi fi teleportat la cel mai apropiat service.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "O companie din apropierea camionului sau a remorcii va trebui activată pentru a vă putea alătura acestei sesiuni.<br>Pentru a evita orice probleme, vă rugăm mutaţi camionul şi remorca mai departe de companie sau cursa curentă va fi anulată şi veţi fi teleportat la cel mai apropiat service.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "O companie aflată aproape de locul în care v-aţi lăsat camionul sau remorca înainte de a accepta cursa rapidă va trebui activată pentru a vă putea alătura acestei sesiuni.<br>Pentru a evita orice probleme atunci când vă veţi întoarce la camionul deţinut, cursa rapidă trebuie anulată şi veţi fi teleportat la cel mai apropiat service.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Cursa selectată este livrată de la sau către o companie ce este inactivă în această sesiune şi nu va fi disponibilă odată ce vă conectaţi.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Marfa este prezentă într-o companie ce este inactivă în această sesiune.<br>Dacă doriţi să vă conectaţi, încărcaţi marfa sau cursa curentă va fi suspendată şi indisponibilă în această sesiune.<br><br>Doriţi să continuaţi?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Cursa a fost anulată fiindcă ar fi fost livrată către o companie ce este inactivă în această sesiune."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Livrarea dvs. a fost anulată deoarece livrările speciale nu sunt acceptate în modul Convoi."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Cursa selectată nu mai este valabilă fiindcă a fost doar disponibilă de la o companie ce este inactivă în această sesiune."

	key[]: "mp_warning_load_teleport"
