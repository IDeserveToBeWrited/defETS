	val[]: "Ştergere termeni căutare" #+ Button clearing search input line.

	key[]: "filter_accessories"
	val[]: "Filtrare Conţinut" #+ Button opening truck customization content filters dialog.

	key[]: "no_accessory_found"
	val[]: "Nu s-au găsit elemente ce corespund filtrelor" #+ Text shown when there are no accessories found by filters.

	key[]: "no_truck_found"
	val[]: "Nu s-au găsit vehicule ce corespund filtrelor" #+ Text shown when there are no trucks found by filters.
#@}

#+ Strings related to job filtering feature
