	val[]: "Déchargement de la remorque"

	key[]: "dynamic_cargo_unload_progress" #+ This text is shown in the adviser during dynamic cargo unloading. Example: Unloading progress:<br> 86 %. <br offset> To skip unloading the trailer, press Enter or Num Enter.
	val[]: "Déchargement en cours :<br><color value=@@clr_sel@@><font face=/font/normal.font>$PERCENT$</font><color value=@@clr_txt@@><br offset=10>Pour passer le déchargement de la remorque, appuyez sur :<br>"

