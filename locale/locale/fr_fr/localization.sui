#@}
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "CONTRÔLEURS" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "BINDINGS" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "ADVANCED SETUP" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "Contrôleurs" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "TYPE D'ENTRÉE" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "CONTRÔLEUR" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "RETOUR DE FORCE DU CONTRÔLEUR" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "AXES DU CONTRÔLEUR" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Clavier uniquement" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Clavier" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Conduite avec la souris" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Conduite avec la souris incluant des pédales" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Aucun" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "Configuration rapide de la manette ou du volant"

#+ Selection of the controller subtype
#@{

	key[]: "controller_subtype"
	val[]: "Sous-type de contrôleur" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "Volant" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
	val[]: "Manette, joystick" #+ Gamepad like device. Value of the input controls speed of turning of the vehicle wheels.
#@}


	key[]: "steer_sens"
	val[]: "Sensibilité de la direction"

	key[]: "steer_nonlin"
	val[]: "Direction non-linéaire"

#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "Retour de force" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "Réinitialiser" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "Gain général" #+ Slider controlling global strength of the force feedback.

