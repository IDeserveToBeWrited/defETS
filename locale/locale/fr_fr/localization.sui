#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Permet de sélectionner le sous-type de contrôleur pour que le jeu gère correctement les plages d'entrée."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Permet de sélectionner le type de transmission :<br>- \"Automatique simple\" permet d'utiliser l'accélérateur et le frein pour contrôler les mouvements de marche avant et de marche arrière.<br>- La transmission \"automatique réelle\" nécessite une entrée pour passer de la marche avant à la marche arrière.<br>- La transmission \"séquentielle\" nécessite le passage manuel de toutes les vitesses avec des entrées pour monter ou descendre les rapports.<br>- La \"Boîte en H\" nécessite l'utilisation d'un contrôleur avec des grilles de changement de vitesse pour sélectionner les vitesses manuellement."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Permet de modifier la logique de changement de vitesse de la transmission automatique :<br>- Le mode \"Économique\" privilégie les bas régimes et le couple maximal.<br>- Le mode \"Performance\" privilégie la puissance maximale pour une meilleure conduite avec de lourdes charges ou en terrain montagneux, au détriment de l'économie de carburant."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster le rapport entre le degré de rotation du dispositif et le degré réel de rotation de la direction du véhicule."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la linéarité entre l'entrée et la direction du véhicule.<br><br>En augmentant cette valeur, la direction sera moins réactive lorsque le volant est au centre, et sa sensibilité augmentera lorsque le volant sera tourné vers le point maximal. Cela peut être utile pour adoucir les commandes de direction lors de la conduite en ligne droite."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'activer le retour de force des dispositifs qui le prennent en charge."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster le gain général de tous les réglages de retours de force entre 0N et 10N.<br><br><color value=@@clr_txt_d@@>Veuillez noter qu'un réglage plus élevé pour les volants puissants peut entraîner des blessures aux doigts ou aux mains."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la force de centrage lors de la conduite à grande vitesse, qui atteint son maximum à 90 km/h (56 mph) et plus.<br><br>Le réglage minimum n'entraîne aucune force de centrage du volant."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la force de centrage lors de la conduite à faible vitesse.<br><br>Le réglage minimum n'entraîne aucune force de centrage du volant."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Permet d’ajuster la force de friction interne artificielle causée par les composants mécaniques de la direction."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité de la résonance artificielle du moteur à travers la colonne de direction.<br><br><color value=@@clr_txt_d@@>Sachez qu'une valeur supérieure à 15 % peut provoquer des secousses et des vibrations excessives dans certains volants."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des effets de la surface de la route par l'intermédiaire de la colonne de direction.<br><br><color value=@@clr_txt_d@@>Sachez qu'une valeur supérieure à 20 % peut provoquer des secousses et des vibrations excessives dans certains volants lorsque vous roulez à grande vitesse sur un terrain accidenté."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des effets des bosses de la route par l'intermédiaire de la colonne de direction."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des effets de collision par l'intermédiaire de la colonne de direction."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des effets de résistance de la boîte de vitesses."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des effets de sous-virage."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité de la direction assistée (lors de l'utilisation de l'assistant au maintien de la trajectoire etc.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des vibrations de la surface du terrain, si le contrôleur prend en charge le retour d'information sur les vibrations."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des vibrations des bosses, si le contrôleur prend en charge le retour d'information sur les vibrations."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster l'intensité des vibrations des collisions, si le contrôleur prend en charge le retour d'information sur les vibrations."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'axe du dispositif à utiliser pour la direction."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la zone morte de l'axe de direction, c'est-à-dire la quantité de rotation à partir du centre pour laquelle l'entrée est ignorée.<br><br>Cela permet d'atténuer les problèmes liés aux anciens contrôleurs, tels que l'imprécision ou les fausses entrées dues à l'usure."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet de déterminer la manière dont le jeu gère l'entrée de l'axe de direction :<br>- Centré est idéal pour les volants ou les joysticks.<br>- Inversé est utilisé pour corriger un axe qui a été mal détecté."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'axe du dispositif à utiliser pour l'accélération."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la zone morte de l'axe d'accélération, c'est-à-dire la longueur de course d'entrée pour laquelle aucune entrée n'est enregistrée.<br><br>Cela permet d'atténuer les problèmes liés aux anciens contrôleurs, tels que l'imprécision ou les fausses entrées dues à l'usure."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet de déterminer la façon dont le jeu gère les entrées du contrôleur :<br>- Centré est idéal pour les joysticks.<br>- Normal est idéal pour les gâchettes ou les pédales.<br>- Inversé peut compenser les entrées qui ont été détectées de manière incorrecte."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'axe du dispositif à utiliser pour le freinage."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la zone morte de l'axe de freinage, c'est-à-dire la longueur de course d'entrée pour laquelle aucune entrée n'est enregistrée.<br><br>Cela permet d'atténuer les problèmes liés aux anciens contrôleurs, tels que l'imprécision ou les fausses entrées dues à l'usure."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet de déterminer la façon dont le jeu gère les entrées du contrôleur :<br>- Centré est idéal pour les joysticks.<br>- Normal est idéal pour les gâchettes ou les pédales.<br>- Inversé peut compenser les entrées qui ont été détectées de manière incorrecte."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'axe du dispositif à utiliser pour actionner l'embrayage."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la zone morte de l'axe d'embrayage, c'est-à-dire la longueur de course d'entrée pour laquelle aucune entrée n'est enregistrée.<br><br>Cela permet d'atténuer les problèmes liés aux contrôleurs plus anciens, tels que l'imprécision ou les fausses entrées dues à l'usure."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet de déterminer la façon dont le jeu gère les entrées du contrôleur :<br>- Centré est idéal pour les joysticks.<br>- Normal est idéal pour les gâchettes ou les pédales.<br>- Inversé peut compenser les entrées qui ont été détectées de manière incorrecte."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la portée de l'embrayage.<br><br>Plus vous réglez la plage vers la droite, plus vous devrez appuyer sur la pédale pour débrayer."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'axe du dispositif à utiliser pour incliner la caméra vers le haut et vers le bas."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la zone morte de l'axe pour regarder de haut en bas, c'est-à-dire la longueur de course d'entrée pour laquelle aucune entrée n'est enregistrée.<br><br>Cela permet d'atténuer les problèmes liés aux anciens contrôleurs, tels que l'imprécision ou les fausses entrées dues à l'usure."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet de déterminer la manière dont le jeu gère l'entrée de l'axe :<br>- Centré est idéal pour les joysticks.<br>- Inversé est utilisé pour corriger un axe qui a été mal détecté."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "L'axe du dispositif à utiliser pour faire pivoter la caméra vers la gauche et la droite."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'ajuster la zone morte de l'axe permettant de regarder de gauche à droite, c'est-à-dire la longueur de course d'entrée pour laquelle aucune entrée n'est enregistrée.<br><br>Cela permet d'atténuer les problèmes liés aux anciens contrôleurs, tels que l'imprécision ou les fausses entrées dues à l'usure."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet de déterminer la manière dont le jeu gère l'entrée de l'axe :<br>- Centré est idéal pour les joysticks.<br>- Inversé est utilisé pour corriger un axe qui a été mal détecté."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Permet de sélectionner la disposition des vitesses à utiliser avec la boîte en H."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Permet de modifier le comportement du levier de vitesse :<br>- Avec l'option \"Simplifié\", vous ne ferez jamais grincer les vitesses lorsque vous changez de vitesse.<br>- L'option \"Simplifié + sons mécaniques\" vous permettra également de changer de vitesse simplement, mais avec un son de grincement de boîte lorsque vous changez de vitesse de manière incorrecte.<br>- L'option \"Avancé\" ne vous autorise pas à changer de vitesse si vous changez de vitesse de manière incorrecte, et vous n'entendrez que des bruits de grincement de boîte. L'option \"Avancé\" vous permet également d'utiliser le réglage de \"changement d'étage et de relais\"."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Permet de sélectionner le mode de changements d'étage et de relais :<br>- L'option \"Jamais\" exige que le levier de vitesse soit mis au point mort entre les changements de vitesse.<br>- L'option \"Débrayage\" exige une pression momentanée sur l'embrayage sans mouvement du levier de vitesse.<br>- L'option \"Relâcher l'accélérateur\" exige que le conducteur relâche uniquement l'accélérateur pour changer d'étage ou de relais sans mouvement du levier de vitesse, et l'option \"débrayage ou relâcher l'accélérateur\" est une combinaison de ces deux dernières options."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer la position du levier de vitesse."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'attribuer l'entrée utilisée pour basculer entre les étages en fonction de la disposition du levier."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'assigner un bouton pour basculer le relais du levier en fonction de la disposition du levier."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'activer l'utilisation de commutateurs au lieu de boutons pour les étages ou les relais."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'assigner un bouton pour passer en mode conduite avec une transmission automatique."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'assigner un bouton permettant de passer en mode marche arrière avec une transmission automatique."

	key[]: "color_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'activer le rétro-éclairage dynamique sur les appareils compatibles."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Permet d'activer et de configurer les fonctions de suivi oculaire pour les appareils compatibles."
#@}

