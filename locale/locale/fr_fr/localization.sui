	key[]: "error_no_own_trailer_attached"
	val[]: "La mission requiert une remorque personnelle. Cependant, vous n'avez actuellement aucune remorque de ce type attelée." #+ Message shown when player tries to continue external market job however they have no compatible trailer attached.

	key[]: "error_no_compatible_trailer_owned"
