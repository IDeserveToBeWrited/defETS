#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "SÉLECTION DE LA MÉTHODE DE CONTRÔLE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Contrôleurs"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>L’assistant appliquera les paramètres recommandés en fonction des périphériques connectés.<br><color value=@@clr_sel@@>Si vous utilisez une manette compatible sur Steam, pensez à activer l’aide à la configuration dans <br><color value=@@clr_txt_d@@>« Steam > Paramètres > Manette > Paramètres généraux de la manette »."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Conduisez en utilisant le clavier pour contrôler et voir l'environnement avec la souris. La plus simple et la moins précise des méthodes de contrôle mais disponible pour tout le monde."

	key[]: "wiz_control_mouse"
	val[]: "Utilisez la souris pour tourner avec une grande précision. Le clavier est tout de même utilisé pour les autres fonctions. La souris est utilisée pour regarder autour de vous seulement si vous maintenez simultanément la touche de contrôle de la caméra enfoncée."

	key[]: "wiz_control_controller"
	val[]: "Utilisez votre volant, manette ou joystick pour une expérience de jeu plus réaliste. Les touches du clavier peuvent être utilisées pour accéder aux différentes fonctions et vous pouvez changer l'angle de la caméra avec la souris."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Aucun contrôleur de jeu n'a été détecté. Vous devez en connecter un maintenant pour activer ce mode !"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Détection des contrôleurs disponibles en cours..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "SÉLECTION DE L’API DU DISPOSITIF DE COMMANDE" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Mode de mappage dans le jeu (recommandé)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Mode de mappage du client Steam"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Contrôleur classique"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Les manettes de jeu comme @@controller_ps5@@, @@controller_xbox_one@@ ou @@controller_steam_deck@@ ont été intégrées à l'interface Steam Input et utilisent une disposition simple.<br><br>Prise en charge complète des configurations de liaison des touches dans le jeu."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Manettes de jeu choisies dans l'interface Steam Input et utilisant des dispositions autonomes configurées via le client Steam.<br><br>Prise en charge limitée des indications de boutons dans le jeu et aucune configuration de liaison dans le jeu."

	key[]: "wiz_api_classical"
	val[]: "Manette, volant ou joystick utilisant DirectInput, XInput ou une interface similaire."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "SÉLECTION DU TYPE DE DISPOSITIF DE COMMANDE"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volant"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Manette ou joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Le contrôleur est un volant ou y ressemble. La position du contrôleur spécifie directement la position du volant dans le jeu."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Le contrôleur est une manette ou un joystick. La position du contrôleur spécifie la vitesse de rotation du volant dans le jeu."
