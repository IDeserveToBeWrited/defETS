#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "CHARGER UNE PARTIE"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Charger une partie" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Charger une partie sauvegardée précédemment. Vous perdrez la progression actuelle !" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Voulez-vous vraiment charger une autre partie ?<br><br>Vous perdrez la progression depuis la dernière sauvegarde."

	key[]: "load_progress_lost_mp"
	val[]: "Voulez-vous vraiment charger une autre partie ?<br>En multijoueur, cela peut engendrer l’annulation ou la suspension d’une mission, la téléportation vers le service le plus proche ou l’indisponibilité de la mission sélectionnée.<br><br>Vous perdrez la progression actuelle si celle-ci n’a pas été sauvegardée précédemment."

	key[]: "load_game_mp_suspended_job"
	val[]: "La sauvegarde a été chargée avec succès, mais votre mission World of Trucks en cours a été suspendue et n’est pas disponible pendant cette session."

	key[]: "autosave"
	val[]: "- Sauvegarde automatique -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Sauvegarde rapide -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Liste des sauvegardes auto." #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Aucune sauvegarde manuelle n’a été trouvée." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Charger" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Sauvegarde incompatible !<br><color value=@@clr_txt@@>Essayez de mettre le jeu à jour vers la dernière version disponible." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Le chargement et l'affichage de tous les fichiers de sauvegarde de ce profil ont échoué." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "ATTENTION" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Un problème est survenu pendant le chargement de votre sauvegarde.<color value=@@clr_txt@@><br><br>Le chargement de votre sauvegarde a échoué. Vous pourriez peut être essayer d'identifier et corriger le problème en utilisant les informations ci-dessous. Sinon, essayez de charger une autre sauvegarde.<br><br>Les raisons suivantes sont souvent la cause du problème :<br><br>1. La sauvegarde est incompatible avec certains MOD(s) actuellement installé(s).<br><br>2. La sauvegarde contient des informations d'un ou plusieurs MOD(s) manquant(s) ou désactivé(s).<br><br>3. La sauvegarde a été corrompue suite à l'utilisation d'un MOD mal conçu.<br><br>4. L'arrêt de votre PC pendant ou peu après le processus de sauvegarde a pu corrompre celle-ci."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Un MOD manquant a été détecté.<color value=@@clr_txt@@><br><br>La dernière sauvegarde contient des informations concernant des MODs manquants ou désactivés.<br><br>Si ceci n'est pas volontaire, veuillez vérifier la liste des MODs.<br><br>Vous pouvez tout de même essayer de charger la sauvegarde. Cependant, avec certains MODs, il est possible que le chargement échoue ou cause d'autres problèmes.<br><br>Sinon, vous pouvez essayer de charger une autre sauvegarde qui n'utilise pas les MODs manquants."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>DLC(s) facultatif(s) manquant(s) détecté(s).<color value=@@clr_txt@@><br><br>La dernière sauvegarde contient des dépendances avec un ou des DLC(s) manquant(s) (extension officielle du jeu).<br><br>Si vous ne vous y attendiez pas, veuillez vérifier l'état du ou des DLC(s).<br><br>Sinon, vous pouvez tout de même charger la sauvegarde, cependant certaines fonctionnalités fournies par le(s) DLC(s) pourraient être perdues.<br><br>Vous pouvez tout aussi bien charger une autre sauvegarde, qui ne dépend pas du ou des DLC(s) manquant(s)."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Un DLC manquant a été détecté.<color value=@@clr_txt@@><br><br>La dernière sauvegarde contient des informations concernant un DLC (extension officielle du jeu) manquant.<br><br>Pour que cette sauvegarde fonctionne correctement, ce DLC doit être installé et activé sur cet ordinateur.<br><br>Sinon, vous pouvez essayer de charger une autre sauvegarde qui n'utilise pas le DLC manquant."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MOD dépendant du contenu du DLC.<color value=@@clr_txt@@><br><br>Au moins un MOD est dépendant du DLC (extension officielle du jeu) qui n'est pas installé actuellement.<br><br>Vous devez désactiver le(s) MOD(s) ou installer le(s) DLC(s) dont il(s) dépend(ent)."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Une interruption a été constatée<color value=@@clr_txt@@><br><br>Il semblerait que le jeu se soit interrompu pendant le chargement précédent.<br><br>Vous pourriez peut être essayer d'identifier et résoudre le problème en utilisant les informations ci-dessous. Sinon, essayez de charger une autre sauvegarde.<br><br>Les raisons suivantes sont souvent la cause du problème :<br><br>1. Un ou plusieurs mod(s) sont corrompus ou incompatibles avec la version actuelle du jeu.<br><br>2. La sauvegarde contient des informations d'un mod manquant ou désactivé.<br><br>3. La sauvegarde a été corrompue suite à l'utilisation d'un mod mal conçu.<br><br>4. Un dysfonctionnement répétitif d'un matériel ou d'un pilote peut créer une interruption du jeu."

	key[]: "mods_detected_warning"
	val[]: "Présence de mods détectée. Soyez conscient que tout mod endommagé, obsolète ou incompatible peut être une source d'instabilité. Veuillez passer en revue vos mods actifs dans le Gestionnaire de mods." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

