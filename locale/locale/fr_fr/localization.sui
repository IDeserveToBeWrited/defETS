#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Continuer ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Bienvenue dans Euro Truck Simulator 2 !"

	key[]: "intro_2"
	val[]: "Enfin vous avez la chance d'exercer le métier de vos rêves : conduire un camion !"

	key[]: "intro_3"
	val[]: "Votre propre entreprise de transport est désormais lancée, mais vous n'avez malheureusement pas assez d'argent pour acheter un camion. Pour le moment, vous devez vous contenter de travailler comme chauffeur pour d'autres compagnies."

	key[]: "intro_4"
	val[]: "Votre mission est de livrer en toute sécurité un chargement de $JOB_CARGO$ vers le dépôt $JOB_TARGET_COMPANY$ à $JOB_TARGET_CITY$. Votre employeur vous a confié un véhicule et couvrira toutes les dépenses. Ne le décevez pas et livrez à temps."


	key[]: "intro_garage_1"
	val[]: "Voici votre siège social."

	key[]: "intro_garage_2"
	val[]: "C'est un garage plutôt basique. Cela peut paraître dérisoire, mais c'est un début."

	key[]: "intro_garage_3"
	val[]: "Malheureusement, vous n'avez pas encore de véhicule pour vous garer ici, il n'y a donc aucun camion à votre disposition."

	key[]: "intro_garage_4"
	val[]: "Une fois que vous aurez gagné assez d'argent et acheté un camion, vous serez en mesure de vous déplacer librement et de commencer vos affaires."

	key[]: "intro_garage_5"
	val[]: "Bonne chance !"


	key[]: "desktop_tut_t"
	val[]: "FONCTIONNALITÉ DÉVERROUILLÉE"

	key[]: "desktop_tut_job"
	val[]: "Choisissez votre prochaine mission"

	key[]: "desktop_tut_cargo_market"
	val[]: "Utilisez votre nouvelle remorque pour accéder aux offres de fret afin de livrer un large assortiment de cargaisons à leurs destinataires." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Ici vous pouvez observer votre progression."

	key[]: "desktop_tut_company"
	val[]: "Restez en contact avec vos garages, embauchez de nouveaux chauffeurs ou alors gérez votre société d'ici."

	key[]: "desktop_tut_trailers"
	val[]: "A partir de maintenant, vous pouvez acheter vos propres remorques, les améliorer ou les peindre pour les assortir à votre camion.<br><br>Vos remorques seront entreposées dans le(s) garage(s) de votre choix. Elles peuvent être utilisées par vos chauffeurs pour augmenter vos bénéfices. Pour les gérer, utilisez le gestionnaire de remorques."

	key[]: "desktop_tut_visit_directive"
	val[]: "Consulter $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "BIENVENUE"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Bienvenue sur le nouvel écran d'accueil<br>À partir de cette page, vous pouvez accéder à toutes les fonctionnalités du jeu."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Ci-dessous, le menu principal permet d’accéder directement à toutes les fonctions de base du jeu que vous connaissez bien."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "En haut, la nouvelle barre d’état permet d’accéder en permanence à des statistiques utiles sur le profil des joueurs et aux réglementations locales en matière de circulation."

	key[]: "desktop_tut_tour_home"
	val[]: "Le bouton Bureau est toujours là pour vous ramener à l’écran d’accueil."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Un menu rapide permanent permet d’accéder à toutes les fonctions du jeu à partir de n’importe quel écran."

	key[]: "desktop_tut_tour_drive"
	val[]: "Le bouton Conduire mis à jour reste votre lien avec le mode de conduite, prêt à vous faire reprendre la route."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIEL TERMINÉ"

	key[]: "desktop_tut_tour_finish"
	val[]: "Merci d'avoir consulté notre mise à jour de l'écran d'accueil."
#@}


