#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Le DLC requis (extension officielle du jeu) $DEPENDENCY_NAME$ est manquant. Afin que cette sauvegarde fonctionne correctement, ce DLC doit être présent et activé sur cet ordinateur. Vous devez corriger le problème avant de pouvoir charger cette sauvegarde." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Le DLC facultatif (extension officielle du jeu) $DEPENDENCY_NAME$ est manquant. Si vous ne vous attendiez pas à cela, veuillez vérifier l'état du DLC.<br><br>Vous pouvez tout de même charger cette sauvegarde, cependant certaines fonctionnalités fournies par ce DLC pourraient être perdues." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Le mod $DEPENDENCY_NAME$ est manquant ou désactivé. Si vous ne vous attendiez pas à cela, veuillez vérifier l'état du mod. Vous pouvez tout de même essayer de charger cette sauvegarde. Toutefois, selon l'apport de fonctionnalités du mod, il est possible que le chargement échoue ou cause d'autres problèmes." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Le mod $DEPENDENCY_NAME$ est incompatible avec votre version du jeu. Cela signifie que l'auteur de ce mod l'a édité comme étant compatible avec un ensemble limité de versions et la votre n'en fait pas partie.<br><br>Les solutions :<br>- Essayer de trouver une mise à jour du mod conçue pour fonctionner avec la version actuelle du jeu.<br>- Mettre à jour ou rétrograder le jeu vers une version compatible avec le mod.<br><br>Vous pouvez tout de même essayer de charger la sauvegarde. Toutefois, le mod ne sera pas chargé et, selon l'apport de fonctionnalités du mod, il est possible que le chargement échoue ou cause d'autres problèmes." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "DÉPENDANCES MANQUANTES" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DÉTAILS" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Ouvrir la page du Workshop"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Cette sauvegarde dépend de DLC ou de mods actuellement manquants. Ceux-ci sont énumérés ci-dessous. En sélectionnant une entrée dans la liste, vous pouvez obtenir davantage d'informations pour chaque élément spécifique." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Cette sauvegarde dépend d'au moins un DLC ou mod requis. Vous devez corriger le problème avant de pouvoir charger cette sauvegarde." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Abandonner le chargement" #+ Abort loading button.

	key[]: "type"
	val[]: "Provenance" #+ Type column.

	key[]: "dependency_name"
	val[]: "Nom des dépendances" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Mod local" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Mod du Workshop" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "DLC facultatif" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "DLC requis" #+ DLC that is required to load save that is depending on it.
#@}

