#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Réseau indisponible. Vérifier que votre configuration réseau est correcte."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Impossible d'établir la connexion au service en ligne. Veuillez vérifier que votre connexion Internet fonctionne."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Erreur lors de la communication avec le service en ligne. Veuillez réessayer ultérieurement."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Données incorrectes renvoyées par le service en ligne. Si le proxy HTTP est en cours d'utilisation, vérifiez sa configuration. Sinon, réessayez ultérieurement."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Données incorrectes renvoyées par le service en ligne. Veuillez réessayer ultérieurement."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Le service n'est pas compatible avec la version actuelle du jeu. Veuillez vérifier si un nouveau patch est disponible pour le jeu."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Le service est actuellement indisponible. Veuillez réessayer ultérieurement."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Le service est actuellement en maintenance ou surchargé. Veuillez réessayer ultérieurement."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Les informations d'authentification ne sont pas valides. Veuillez essayer de vous connecter à nouveau."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Le compte en ligne est actuellement bloqué en raison d'un trop grand nombre de tentatives de connexions. Veuillez essayer de nouveau dans une demi-heure."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Ce compte en ligne est actuellement bloqué en raison d'accès suspects. Veuillez réessayer dans 24 heures."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Ce jeu n'est pas associé à ce compte en ligne."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Le compte n'a pas encore été activé. Veuillez vérifier votre boîte E-mail afin d'activer votre compte."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Ce compte est suspendu. Veuillez contacter le support technique."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Ce compte est banni. Veuillez contacter le support technique."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "L'authentification du proxy n'est pas supportée par ce jeu. Veuillez utiliser un proxy différent ou une connexion directe."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "L'objet demandé n'est pas disponible actuellement. Veuillez réessayer dans quelques minutes."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Erreur SSL. Impossible d’établir une connexion sécurisée."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Le jeu a été mis en pause pendant la communication en ligne. Veuillez réessayer ultérieurement."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Erreur interne. Le fichier net.log pourrait contenir plus d'informations."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 a rencontré un problème et est incapable d'afficher les graphismes sur votre ordinateur (aucune carte graphique valide n'a été détectée).\nEtapes suggérées :\n\n1. Vérifiez que votre ordinateur et votre carte vidéo répondent aux configurations minimales requises.\n2. Installez la dernière version de Microsoft DirectX sur votre ordinateur.\n3. Téléchargez et installez les derniers pilotes graphiques pour votre carte vidéo sur le site de votre vendeur (vos pilotes graphiques sont peut-être trop anciens).\n4. Essayez de changer la méthode de rendu d'OpenGL à DirectX ou vice versa.\n5. Supprimez le fichier de configuration du jeu dans le dossier 'Documents' - 'Euro Truck Simulator 2'. Il est peut-être corrompu.\n Ce fichier sera automatiquement recréé avec les valeurs par défaut lors du prochain lancement du jeu."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 a rencontré un problème et est incapable d'afficher les graphismes sur votre ordinateur (aucune carte graphique valide n'a été trouvée)."
#@}

