#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "CONTENU WORLD OF TRUCKS CONNECTÉ" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Connecter" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Parcourir" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "PARAMÈTRES GÉNÉRAUX" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "CONNECTER LE CONTENU" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Connecter" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks a détecté du nouveau contenu. Connectez-le au service World of Trucks pour en profiter." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "En ligne" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Préférences en ligne. Réglez tous les paramètres relatifs à World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Voulez-vous vraiment reporter l’enregistrement ?<br><br>Vous pourrez accéder à la boîte de dialogue du contenu en ligne connecté plus tard à partir des options en ligne, situées sur le bureau." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "CONNEXION DU CONTENU" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Connexion du contenu..." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Impossible de mettre en file d'attente la connexion pour : $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Le compte Steam que vous avez utilisé pour enregistrer ce DLC est différent de celui utilisé pour créer le compte World of Trucks ou pour enregistrer le jeu. Veuillez changer de compte Steam et réessayer." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Le compte Steam utilisé pour enregistrer ce DLC est déjà associé à un autre compte World of Trucks. Pour enregistrer ce DLC sur le compte actuel, vous devez utiliser un compte Steam qui n'est connecté à aucun compte World of Trucks." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Le jeton d'authentification Steam a expiré. Veuillez réessayer plus tard." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "La clé de produit utilisée pour l'activation du DLC n'est pas valide. Pour toute demande veuillez contacter le support : support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Une erreur interne est survenue pendant l'enregistrement du jeu. Veuillez réessayer ultérieurement." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCCÈS" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "EN LIGNE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "GESTIONNAIRE DE CONTENUS" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Félicitations ! Les DLC sélectionnés ont été connectés à votre compte World of Trucks avec succès." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Impossible de connecter le contenu du fait que le compte Steam actuel est associé à un compte World of Trucks différent." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Échec de la connexion de certains DLC.<br>Passez la souris sur les points d'exclamation de chaque DLC pour obtenir plus de détails." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Enregistrement du contenu $CURRENT_CONTENT_NAME$ en cours" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Le profil actuel n’est pas connecté à World of Trucks ou le jeu est lancé en mode hors-ligne. Modifiez votre profil pour vous connecter." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Cliquer pour annuler"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ DLC connecté(s) actuellement compatible(s). Si certains DLC ne sont pas connectés à World of Trucks, certaines de leurs fonctionnalités pourraient ne pas être disponibles." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Félicitations ! <color value=@@clr_txt@@>Tout votre contenu est connecté à World of Trucks ! Vous pouvez désormais utiliser toutes ses fonctionnalités." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Impossible de connecter le nouveau contenu à World of Trucks du fait que le compte Steam actuellement utilisé ne correspond pas au compte Steam lié au profil World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Connecté" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Non connecté" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Impossible de récupérer les informations à propos du contenu possédé." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Impossible de récupérer les informations à propos du contenu connecté." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Impossible de récupérer les informations à propos du compte actuellement utilisé." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Plus tard" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Impossible d'enregistrer ce DLC. Aucune licence permanente n'a été trouvée, probablement lié au partage familial Steam." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Aucune propriété permanente" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Mission de convoi exceptionnel terminée !"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISSION ÉCHOUÉE !"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Abandonner"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Charger le checkpoint"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Vous avez endommagé le véhicule pilote !<br>Vous pouvez charger un point de passage ou annuler la livraison entraînant une pénalité de $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Le véhicule pilote a été endommagé par un véhicule du trafic en raison d'une conduite incorrecte.<br>Vous pouvez charger un point de passage ou annuler la livraison entraînant une pénalité de $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Vous étiez censé suivre l'itinéraire.<br>Vous pouvez charger un point de passage ou annuler la livraison entraînant une pénalité de $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Vous étiez censé rester avec les véhicules pilotes.<br>Vous pouvez charger un point de passage ou annuler la livraison entraînant une pénalité de $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Vous avez semé les véhicules pilotes !"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Vous avez endommagé le véhicule pilote !"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Véhicule pilote accidenté !"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Vous avez quitté l'itinéraire !"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimensions"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Livraison de transport exceptionnel"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Veuillez maintenir la cargaison entre les véhicules pilotes."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Livraisons exceptionnelles"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimensions"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Transport exceptionnel"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Veuillez ralentir afin d'éviter de heurter le véhicule pilote..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Veuillez attendre le véhicule pilote arrière..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "A présent faites attention, une partie plus étroite du trajet arrive..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Manœuvre de changement de voie en approche. Adaptez votre vitesse pour éviter toute collision possible..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Le véhicule pilote avant prévient les autres véhicules...<br>Adaptez votre vitesse pour éviter un éventuel accrochage..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Les véhicules pilotes vous attendent à une intersection à proximité. Veuillez suivre l'itinéraire."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Attention !<br>Vous reculez vers le véhicule pilote arrière !"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Attention !<br>Vous reculez dangereusement vers le véhicule pilote arrière !"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Appuyez sur la touche suivante pour voir les offres de transport exceptionnel :"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Offre de transport exceptionnel :"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Vous êtes sur le point de transporter un chargement exceptionnel ! Il y a deux véhicules pilotes pour vous guider. Veuillez faire preuve de prudence et suivre leurs indications et suggestions. Les convois exceptionnels comme celui-ci ne s'arrêtent pas aux feux rouges et ont la priorité dans la plupart des situations. Lors de ces livraisons, des points de passage seront créés plus souvent pour sauvegarder votre progression actuelle."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Portez une attention particulière à :"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Éviter tout conflit éventuel avec les véhicules pilotes et restez au milieu."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Ne pas conduire en dehors du trajet défini, ainsi que dans les stations service, aires de repos etc."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Respecter les limitations de vitesse imposées par le véhicule pilote avant."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Faire attention au trafic lorsque vous dépassez les autres conducteurs présents sur la route."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Manœuvre de changement de voie :"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Si vous ne suivez pas ces règles, votre mission de transport exceptionnel peut échouer !"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "La manœuvre est initiée par le véhicule pilote <color value=@@clr_sel@@>arrière<color value=@@clr_txt@@> qui change & bloque la voie désignée."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Le véhicule pilote <color value=@@clr_sel@@>avant<color value=@@clr_txt@@> attend jusqu'à ce que la voie désignée soit libre, puis change également de voie."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Ensuite, il est plus prudent pour le <color value=@@clr_sel@@>joueur<color value=@@clr_txt@@> de se décaler dans la voie désignée."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Le réservoir a été rempli et vos heures de conduites disponibles ont été restaurées."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Vous ne pouvez pas appeler l'assistance pendant une mission de transport exceptionnel."

	#+ Warning when player want to use ferry transport during oversize mission.
	key[]: "oversize_ferry_reason"
	val[]: "Vous ne pouvez pas prendre le ferry lors d'une mission de convoi exceptionnel."

	#+ Message when player is resting and refueling during the special transport job
	key[]: "oversize_mission_sleep_fading"
	val[]: "Vous vous reposez…<br>Les réservoirs du camion sont en train d’être remplis…"

	#+ Message in advisor when player is approaching mandatory stop
	key[]: "adviser_compulsory_stop"
	val[]: "Arrêt obligatoire en approche.<br>Suivez le véhicule pilote jusqu’à l’aire de stationnement pour vous reposer !"

	#+ Adviser title for mandatory stop activation point
	key[]: "special_job_sleep_title"
	val[]: "Arrêt obligatoire"

	#+ Adviser message for mandatory stop activation
	key[]: "special_job_sleep"
	val[]: "Appuyez sur la touche suivante pour vous reposer et faire le plein :"
#@}

#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Une erreur est survenue lors du chargement du contenu de l'inventaire Steam.<br><br>$ERROR$<br><br>Sélectionnez continuer pour maintenir le contenu activé. Le jeu le recherchera périodiquement.<br><br>Vous pouvez temporairement désactiver le contenu pour que les messages d'erreur comme celui-ci ne réapparaissent pas. Le jeu réactivera le contenu automatiquement la prochaine fois que vous lancerez celui-ci." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Impossible de télécharger les objets de l'inventaire Steam." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "INVENTAIRE STEAM" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Chargement des objets de l'inventaire Steam..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NOUVEAUX OBJETS DE L'INVENTAIRE" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "De nouveaux objets de l'inventaire Steam ont été détectés." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Accessoires de véhicules" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Accessoires de cabine" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Thème du bureau" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Peintures" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Désactiver l'inventaire" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Réessayer plus tard" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "INVENTAIRE STEAM" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Certains objets ont été retirés de votre inventaire Steam. Vous ne pourrez plus les acheter chez le concessionnaire.<br><br>Ceci n'affectera pas vos objets actuellement installés." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


