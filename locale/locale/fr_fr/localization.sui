#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "Pour accéder aux missions rapides vous devez terminer le tutoriel en cours."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Pour accéder aux offres de traction, vous devez acheter votre premier camion."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Pour accéder aux offres de fret, vous devez acheter votre première remorque."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Pour accéder aux contrats externes, vous devez acheter votre premier camion et posséder un profil connecté à World of Trucks."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Pour accéder aux offres externes, vous devez acheter votre première remorque et posséder un profil connecté à World of Trucks."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Affichez la carte du monde, ses zones explorées et vos points de passage actuels ou définissez-en de nouveaux. "

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Voyage rapide dans une ville déjà découverte, moyennant un coût."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Parcourez, recherchez et filtrez les sessions de convoi en ligne auxquelles vous pouvez participer ou créez et hébergez la vôtre pour les autres."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Votre boîte de réception pour les messages du monde des affaires, des banques et de nouvelles embauches."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "Les e-mails commenceront à arriver lorsque vous aurez progressé dans votre carrière."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Localisez et achetez les garages disponibles sur la carte du monde."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Parcourez et examinez les camions d'occasion disponibles à l'achat."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Vous devez d'abord découvrir un concessionnaire."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Parcourez, examinez et reconfigurez les remorques disponibles à l'achat."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Améliorez votre expérience de conduite en écoutant de la musique."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "La radio n'est pas disponible."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Configurez les graphismes, l'audio, la jouabilité, les commandes et les options en ligne."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Examinez la progression de votre carrière, vos statistiques et les contrats que vous avez récemment terminés."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Pour accéder au convoi actif, vous devez d'abord entrer dans une session convoi."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Avertissement médical"

	key[]: "health_warning_description"
	val[]: "Un faible pourcentage d’utilisateurs peut être sujet à des crises d’épilepsie ou à une perte de connaissance lorsqu’ils s’exposent à certaines lumières clignotantes ou à certains motifs lumineux. Ces personnes peuvent subir des crises d’épilepsie en regardant certaines images ou en jouant à un jeu vidéo. Si vous ou un membre de votre famille avez déjà souffert de symptômes liés à l’épilepsie (crises ou perte de connaissance) après une exposition à des lumières clignotantes, veuillez consulter un médecin et prendre toutes les précautions nécessaires avant de jouer à ce jeu.<br offset=20>Si vous ou votre enfant présentez l’un des symptômes suivants en jouant à n’importe quel jeu vidéo : vertiges, vision altérée, contraction oculaire ou musculaire, perte de connaissance, désorientation, crise de convulsions, mouvements involontaires, cessez de jouer immédiatement et consultez un médecin."

	key[]: "trademark"
	val[]: "Tous les noms de marque, marques commerciales, marques déposées, logos et symboles figurant sur les véhicules du jeu sont la propriété de leurs détenteurs respectifs. Utilisés avec leur aimable autorisation. Les marques et designs MAN® sont des droits enregistrés de MAN Truck & Bus AG et sont utilisés sous licence par SCS Software s.r.o. \"Mercedes-Benz\" et \"l'Étoile à trois branches dans un cercle\" sont des marques de Daimler AG et sont utilisées sous licence par SCS Software s.r.o. Les marques et designs RENAULT sont des droits enregistrés ou concédés sous licence au groupe AB Volvo et sont utilisés conformément à une licence. Les marques et designs VOLVO sont des droits enregistrés ou concédés sous licence par le groupe AB Volvo et sont utilisés conformément à une licence."
#@}

