#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAPHISMES" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Graphismes" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Ajustez les paramètres graphiques à l'aide de préréglages précis pour adapter les performances visuelles de votre jeu à vos goûts."

	key[]: "apply"
	val[]: "Appliquer" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Thème du bureau" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "AFFICHAGE" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "QUALITÉ DE L’IMAGE" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURES" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLETS" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "OMBRES" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "ÉCLAIRAGE" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POST-TRAITEMENT" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "ENVIRONNEMENT" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Mode plein écran" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Luminosité / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Configurer" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Résolution" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Fréquence de rafraichissement" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Limite de FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Limite de FPS en arrière-plan" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Rafraîchissement par défaut" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Synchronisation verticale" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Éco (économie d'énergie pour les portables)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "RÉGLAGES GRAPHIQUES SIMPLIFIÉS" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "RÉGLAGES PERSONNALISÉS APPLIQUÉS" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "RÉGLAGES GRAPHIQUES AVANCÉS" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Paramètres graphiques simples/avancés" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Masquer les paramètres avancés" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Afficher les paramètres avancés" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Mise à l'échelle" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anticrénelage" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "Luma sharp TAA" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "Réglage du TAA" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Clarté adaptative" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Toujours doux" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Toujours net" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "SSAO" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Haut rendu dynamique (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Profondeur de champ (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Rayons du soleil" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Correction des couleurs" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Échelle des reflets" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Détails du reflet" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Détails de la végétation" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Densité de l'herbe" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Qualité des ombres"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Qualité de la texture d'ombre" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Ombres lointaines" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Ombres intérieures" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Qualité de la météo"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Qualité des rétroviseurs" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Résolution des rétroviseurs" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Distance des rétroviseurs" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Qualité des textures" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Filtrage anisotrope" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Carte de normales" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Phares du trafic" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Lumières secondaires du véhicule" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Niveau de visibilité des lumières" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Piétons" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Les paramètres d'affichage ont été modifiés.<br>Voulez-vous conserver ces paramètres ?"

	key[]: "reverting_in"
	val[]: "Retour dans" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "secondes" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Lorsque cette option est activée, le jeu s'affiche en plein écran."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Permet de régler la luminosité générale du jeu en fonction de votre écran. Sur les écrans compatibles HDR, l'option de calibrage HDR sera également disponible dans ce paramètre."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Permet de modifier la résolution du jeu."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de modifier la fréquence de rafraîchissement du jeu."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'adapter le taux de rafraîchissement au taux de rafraîchissement du moniteur afin d'éviter le déchirement de l'écran. Le réglage économique réduit également de moitié le taux de rafraîchissement, ce qui permet de réduire la consommation d'énergie."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de définir la fréquence d'images maximale autorisée pour le jeu.<br><br>La valeur 0 désactive la fonctionnalité."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de définir la fréquence d'images maximale autorisée pour le jeu lorsqu'il est réduit en arrière-plan.<br><br>La valeur 0 désactive la fonctionnalité."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Permet de permuter entre les réglages graphiques simples (préréglages) et les réglages graphiques avancés (possibilité de modifier les paramètres individuellement)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'améliorer la fidélité graphique en rendant le jeu à une résolution interne plus élevée, ce qui réduit les bords irréguliers et améliore les détails.<br>Par exemple, la sélection d'une option de mise à l'échelle plus élevée permet d'obtenir une image plus claire et moins floue, ce qui améliore l'aspect général du jeu au détriment des performances.<br><br><color value=@@clr_txt_d@@>Ce paramètre a souvent un impact important sur les performances."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Sélection de méthodes d'anticrénelage à grande vitesse atténuant l'apparence des bords irréguliers dans le jeu :<br>- Le SMAA échantillonne chaque pixel plusieurs fois (en fonction de la qualité sélectionnée) à différents endroits de l'image et calcule la moyenne des échantillons pour produire l'image finale.<br>- Le TAA n'échantillonne chaque pixel qu'une seule fois par image, mais il les échantillonne à différents endroits et dans différentes images.<br>- Pour obtenir le meilleur résultat, vous pouvez également choisir une combinaison des deux, au détriment des performances.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajouter des ombres douces aux crevasses et aux objets proches les uns des autres, améliorant ainsi la fidélité graphique perçue de l'ensemble du monde du jeu.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de sélectionner les préréglages TAA :<br>- L'option \"Toujours doux\" entraîne moins de scintillement/plus de flou - elle convient aux utilisateurs de PC qui activent le suréchantillonnage ou disposent d'un moniteur à DPI élevé, mais aussi aux utilisateurs de téléviseurs 1080p qui s'assoient plus loin de leur écran.<br>- L'option \"Toujours net\" produit plus de scintillement/moins de flou - c'est probablement la meilleure option pour une utilisation inférieure à 1080p, comme les ordinateurs portables ou les Steam Deck.<br>- La \"clarté adaptative\" désactive dynamiquement la gigue TAA lorsque la caméra est statique.<br><br><color value=@@clr_txt_d@@>Ce paramètre ne peut être utilisé que lorsque le TAA est sélectionné comme solution d'anticrénelage."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de régler l'intensité de l'accentuation luma du TAA.<br><br><color value=@@clr_txt_d@@>Ce paramètre ne peut être utilisé que lorsque le TAA est sélectionné comme solution d'anticrénelage."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Lorsque cette option est activée, les zones éloignées de la carte peuvent être rendues artificiellement floues afin de créer une perte de netteté réaliste à l'arrière-plan."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Lorsque cette option est activée, les rayons de lumière peuvent être visibles en regardant le soleil ou en regardant le soleil à travers des objets tels que des arbres, des bâtiments ou des véhicules."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Lorsque cette option est activée, les couleurs du jeu sont ajustées dynamiquement pour des raisons esthétiques. Les scènes correspondront mieux à l'heure du jour et aux conditions météorologiques, les couleurs des véhicules et des autres objets seront plus vives, etc."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'améliorer les reflets en les rendant de meilleure qualité en interne, ainsi qu'en utilisant un meilleur anticrénelage.<br><br><color value=@@clr_txt_d@@>Les modifications apportées à ce paramètre ne prendront effet qu'après un redémarrage manuel du jeu."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajuster le détail des reflets observés sur les surfaces des véhicules, les fenêtres et d'autres surfaces miroitantes telles que les flaques d'eau, les routes mouillées et les étendues d'eau.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances.<br><br>Les modifications apportées à ce paramètre ne prendront effet qu'après un redémarrage manuel du jeu."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajuster le niveau de détail et la complexité des plantes et des arbres.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajuster la densité de l'herbe sur les bas-côtés de la route.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de régler la qualité des ombres projetées par le soleil ou la lune.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Permet aux ombres d'être rendues même à partir d'objets très éloignés.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d’activer les ombres dynamiques nocturnes à l’intérieur du véhicule.<br><br><color value=@@clr_txt_d@@>En général, ce paramètre a un impact modéré sur les performances."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajuster la qualité des effets météorologiques, tels que les reflets."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de régler la qualité des reflets observés dans les rétroviseurs des véhicules (indépendamment des paramètres de réflexion).<br><br><color value=@@clr_txt_d@@>Ce réglage a généralement un impact modéré sur les performances."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajuster la résolution de l'image restituée dans les rétroviseurs de votre véhicule."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de régler la distance à laquelle les objets commencent à être rendus dans les rétroviseurs.<br><br><color value=@@clr_txt_d@@>Ce paramètre a souvent un impact important sur les performances."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajuster la qualité de certaines textures appliquées aux objets et surfaces du jeu."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'améliorer la netteté des textures, en particulier celles qui sont observées à distance ou sous un angle oblique.<br><br><color value=@@clr_txt_d@@>Les modifications apportées à ce paramètre ne prendront effet qu'après un redémarrage manuel du jeu."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'ajouter l'apparence de détails géométriques aux chaussées, routes et autres objets afin d'améliorer leur aspect.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances.<br><br>Les modifications apportées à ce paramètre ne prendront effet qu'après un redémarrage manuel du jeu."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'activer l'éclairage des phares des autres véhicules de la circulation."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'activer l'éclairage des lumières secondaires des autres véhicules en circulation, tels que les clignotants, les feux stop, etc."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Permet de régler la distance à laquelle les sources de lumière artificielle peuvent être vues.<br><br><color value=@@clr_txt_d@@>Ce paramètre a généralement un impact modéré sur les performances."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Permet d'activer les piétons dans le monde du jeu."
#@}

