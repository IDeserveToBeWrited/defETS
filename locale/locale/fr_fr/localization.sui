#+ Options/Eye tracking
#+
#+ Screen used to configure eye tracking related options
#@{
	key[]: "eye_t"
	val[]: "SUIVI OCULAIRE" #+ Header of the section.

#+ Configuration of extended view options.
#@{
	key[]: "eye_extended_view_settings"
	val[]: "Vue étendue" #+ Header of the section.

	key[]: "eye_preset"
	val[]: "Présélection de la vue étendue" #+ Label of combo box with list of presets for the extended view

