#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Le fichier photo est trop volumineux. Veuillez essayer de réduire la résolution d'affichage." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Le fichier photo est endommagé ou non supporté." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "La résolution de la photo est trop grande. Veuillez essayer de réduire la résolution d'affichage." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Le service a rejeté la photo." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Le compte n'est pas autorisé à transférer des photos." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Il y a eu un transfert simultané sur le même emplacement." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Le transfert est actuellement désactivé. Veuillez réessayer ultérieurement." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
