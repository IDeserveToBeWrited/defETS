#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner les thèmes affichés en arrière-plan lorsque vous naviguez dans le menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d'activer la sélection aléatoire du thème du bureau à chaque démarrage du jeu."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de définir le délai avant la disparition des éléments du bureau."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, vous commencerez à ressentir les effets de la fatigue au fil du temps.<br><br>Le fait d'ignorer les coupures entraînera des infractions au code de la route."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, vous devez respecter les règles de circulation, et les infractions au Code de la route risquent d’être sanctionnées. Ce risque est accru à proximité des véhicules de police, des radars et des caméras de circulation."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'ajuster la longueur moyenne des contrats proposés."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de sélectionner la limite de vitesse à afficher sur le widget de navigation."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "La vitesse actuelle sur la navigation devient rouge lorsque vous dépassez la limite de vitesse."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque vous atteignez votre destination, un widget s'affichera pour vous permettre d'éviter le stationnement."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de conserver tous les widgets masqués."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de conserver les deux rétroviseurs HUD masqués."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de conserver toutes les notifications masquées même lors de leur réception."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'afficher une fenêtre indiquant les capacités du camion actuel du joueur avant d'accepter un contrat de transport de marchandises lourdes."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de choisir la façon dont la carte du monde est alignée."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de choisir le mode d'exploration de la carte du monde :<br>- \"Exploration de proximité\" marque une zone plus vaste comme étant explorée.<br>- \"Exploration de précision\" révèle uniquement les zones situées à proximité immédiate du joueur."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de sélectionner le mode d'affichage de la navigation."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de sélectionner la façon dont l'itinéraire est calculé :<br> - Le mode de navigation \"Le plus rapide\" choisit le rapport le plus efficace entre la longueur et la durée de l'itinéraire, essaie d'éviter les carrefours avec feux de circulation, etc.<br>- Le mode de navigation \"Le plus court\" choisit toujours l'itinéraire le plus court possible.<br>- Le mode de navigation \"Éviter les autoroutes\" permet d'éviter les autoroutes dans la mesure du possible."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier votre difficulté de stationnement :<br>- La fonction \"Toujours sélectionner\" vous permet de choisir au moment où vous atteignez votre destination.<br>- Le \"stationnement aisé\" ne nécessite pas de manœuvres de recul.<br>- Le \"stationnement expert\" nécessite généralement une manœuvre de marche arrière plus difficile."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d'ajuster la probabilité de rencontrer des perturbations routières dans votre périmètre, notamment des accidents, des véhicules en panne, des débris sur la route, etc."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d’ajuster la probabilité de rencontrer une déviation lors d’une mission."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d’ajuster la probabilité de mauvais temps."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de choisir si les informations sur le fuseau horaire sont affichées en plus de l'heure actuelle."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d’activer les cinématiques du jeu qui s’affichent généralement après l’achat d’un camion ou l’amélioration d’un garage ou lors de l'embarquement des passagers."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de choisir d’afficher ou non les bloqueurs semi-translucides sur les routes non accessibles."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d'inverser l'axe Y de la souris lors du contrôle de la caméra dans le jeu."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de sélectionner le type de transmission :<br>- \"Automatique simple\" permet d'utiliser l'accélérateur et le frein pour contrôler les mouvements de marche avant et de marche arrière.<br>- La transmission \"automatique réelle\" nécessite une entrée pour passer de la marche avant à la marche arrière.<br>- La transmission \"séquentielle\" nécessite le passage manuel de toutes les vitesses avec des entrées pour monter ou descendre les rapports.<br>- La \"Boîte en H\" nécessite l'utilisation d'un contrôleur avec des grilles de changement de vitesse pour sélectionner les vitesses manuellement."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "L'activation de cette fonction permet de \"sauter un rapport\", c'est-à-dire de sauter des vitesses lorsque cela est nécessaire ou pratique pour éviter de passer toutes les vitesses de la boîte de vitesses."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de ramener le volant au centre lorsque vous utilisez une manette ou un autre dispositif de commande.<br><br>Si vous désactivez cette fonction, vous devrez ramener manuellement le volant au centre après un virage."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de régler la plage d'animation du volant."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier l'intensité de freinage."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la stabilité du véhicule en abaissant son centre de gravité."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la stabilité de la remorque en abaissant son centre de gravité."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier l’intensité du couple généré par la chaîne cinématique.<br><br>En augmentant ce paramètre, vous augmentez la sensation de \"torsion\" du véhicule vers la droite."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la rigidité de la suspension du châssis."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la rigidité de la suspension de la cabine et de la couchette."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'ajuster l'intensité des bosses générées de manière procédurale pour donner aux routes et autres terrains une impression d'imperfection.<br><br>En fonction des autres réglages de la suspension et de la caméra, l'effet perçu peut être plus ou moins prononcé."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet un attelage avancé qui nécessite une plus grande précision pour aligner la sellette du camion avec la cheville ouvrière de la remorque.<br><br>Lorsque cette option est désactivée, l'attelage d'une remorque devient beaucoup plus facile car il n'y a pas de collision entre la cheville ouvrière et la sellette."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de déterminer si les flexibles de la remorque sont animés et lesquels.<br><br><color value=@@clr_txt_d@@>L'activation des flexibles sur un plus grand nombre de véhicules peut affecter les performances des systèmes plus anciens."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Permet d'activer le limiteur de vitesse électronique sur le camion à 90 km/h (56 mph).<br><br><color value=@@clr_txt_d@@>Cette fonctionnalité est activée de façon permanente lors des contrats World of Trucks."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette fonction est activée et que les essuie-glaces sont en première position, ceux-ci se mettent automatiquement en marche et ajustent leur vitesse de balayage en fonction des conditions."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'enclencher automatiquement le ralentisseur hydraulique lors du freinage."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette fonction est activée, le véhicule facilite le démarrage en côte en maintenant les freins enfoncés, garantissant ainsi un démarrage en douceur."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'enclencher automatiquement le frein moteur lors du freinage."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est sélectionnée, le moteur démarre dès que l’on appuie sur l’accélérateur."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est sélectionnée, le frein de stationnement du véhicule est actionné par défaut (après l’utilisation d’un ferry, le remorquage vers un atelier de réparation, un déplacement rapide, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'abaisser automatiquement les essieux relevables lorsque cela est nécessaire en fonction du poids du véhicule."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsqu’elle est activée, cette option applique par défaut une accélération réduite. Un double appui rapide sur la touche d’accélération permet de maintenir l’accélération maximale jusqu’au relâchement de la touche.<br><br>Affecte uniquement les commandes au clavier."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de simuler la perte d'air réelle due à des freinages excessifs.<br><br>Lorsque cette fonction est activée, vous devrez gérer vos pressions d'air dans les descentes ou lors de manœuvres lentes avec des freinages multiples."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est désactivée, la consommation de carburant n’est pas affectée par le style de conduite ou l’état de la route.<br><br>Lorsqu’elle est activée, la consommation de carburant est affectée par plusieurs facteurs, notamment le style de conduite, le poids du chargement, la résistance au roulement et le profil du terrain. Elle n'est plus influencée par la compétence @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est activée, l'ABS empêche le blocage des roues afin de maintenir le contrôle et d'améliorer la capacité de freinage."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est activée, le véhicule applique un freinage par roue pour éviter le patinage, le sous-virage ou le survirage afin d’aider à garder le contrôle."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est activée, le véhicule bloque le différentiel si les roues commencent à patiner afin d’améliorer la traction."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier l’incrémentation ou la décrémentation de la vitesse sur le régulateur de vitesse lorsque vous appuyez sur la touche appropriée."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la tolérance du régulateur de vitesse pour le maintien de la vitesse cible."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est activée, le régulateur de vitesse ajuste automatiquement la vitesse pour maintenir une distance de sécurité avec le véhicule devant vous."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'activer le freinage d'urgence si le système détecte une collision imminente.<br>Choisissez si le système réagit uniquement aux véhicules ou à tous les obstacles."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de sélectionner les modes d’assistance au maintien de la trajectoire :<br>- Le mode \"Alerte de franchissement de ligne\" vous avertit de manière sonore lorsque vous êtes sur le point de quitter la voie.<br>- En plus de l’avertissement sonore, le mode \"Aide au maintien de la trajectoire\" dirige automatiquement votre véhicule pour l’empêcher de quitter la voie.<br><br>Les deux modes ne sont actifs qu’à des vitesses supérieures à 55 km/h (~35 mph).<br>L’assistant au maintien de la trajectoire prend également en compte l’utilisation des clignotants avant de s’activer."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d’activer la fonctionnalité de détecteur d’angle mort, si votre véhicule en est équipé."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée et que les phares sont en première position, ceux-ci s'allument automatiquement en cas de faible luminosité."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée et que les feux de route sont allumés, le véhicule repasse automatiquement aux feux de croisement lorsqu’il détecte un véhicule venant en sens inverse ou un véhicule situé à proximité."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, les clignotants se désactivent automatiquement après un virage lorsque le volant est remis au centre."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, certains accessoires intérieurs réagissent aux mouvements physiques du véhicule (décorations suspendues, figurines, etc.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet d'activer la rotation de la caméra intérieure en fonction de l'angle de direction."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la réactivité de la fonction \"rotation de la caméra avec le volant\" en fonction de l'angle de direction. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier le comportement de la fonction \"rotation de la caméra avec le volant\" en marche arrière."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est activée, la caméra intérieure s’oriente vers la gauche ou la droite en fonction du clignotant activé."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Lorsque cette option est activée, la caméra intérieure réagit aux mouvements du véhicule."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier la réactivité de la caméra intérieure en fonction des mouvements du véhicule."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de modifier l’oscillation de la caméra intérieure en fonction des mouvements du véhicule."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de définir le délai avant que la caméra ne se recentre automatiquement.<br><br>Le véhicule doit se déplacer à une vitesse non négligeable pour que cette fonction s'active. S'applique uniquement à la caméra intérieure et à la caméra de poursuite lors d'une marche avant et à la caméra en vue par la fenêtre en marche arrière."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Permet de définir la vitesse de déplacement de la caméra pour le centrage automatique de la caméra et la permutation entre les préréglages de la caméra intérieure."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Permet de déterminer le fonctionnement du zoom intérieur : maintenez la touche enfoncée pour zoomer temporairement ou appuyez une fois pour l’activer ou le désactiver." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner la langue à afficher dans le jeu."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de modifier les préréglages de la devise et des unités en fonction de la région sélectionnée."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, les villes et les pays s'affichent dans la langue sélectionnée."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, les villes et les pays sont affichés sur la carte à la fois dans la langue sélectionnée et dans la langue officielle de la région concernée."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner la devise à utiliser."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner la notation de l'heure sur 12 heures ou 24 heures."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner l'unité de distance à afficher."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner l'unité de masse à afficher."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner l'unité de température à afficher."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner l’unité de pression à afficher."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner l'unité de volume à afficher."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Permet de sélectionner l’unité de consommation à afficher."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, la touche \"Activer\" (@@imv_nrm_activate@@) permet d'ouvrir le chat pendant les sessions de convoi."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, la barre de saisie du chat reste active après l'envoi d'un message."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Lorsque cette option est activée, les messages du chat s'effacent plusieurs secondes après chaque message."

