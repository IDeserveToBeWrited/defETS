	val[]: "Utilisez le Mode photo ou la touche @@imv_nrm_screenshot@@ pour faire des captures d'écran. Vous pouvez les transférer sur le portail World of Trucks.<br>Sélectionnez une photo, puis un emplacement vide et appuyez sur le bouton <color value=@@clr_sel@@>Transférer sur l'emplacement sélectionné<color value=@@clr_txt@@>." #+ description

	key[]: "screenshotman_slot"
	val[]: "Emplacements des captures d’écran dans la galerie World of Trucks." #+ Slots title

	key[]: "screenshotman_empty"
	val[]: "Prenez une capture d'écran pour la visualiser ici." #+ Empty screenshot position

	key[]: "screenshotman_offline"
	val[]: "LE PROFIL N'EST PAS CONNECTÉ !<br><br>Pour envoyer une photo, votre profil doit être connecté à votre compte en ligne.<br><br>Voulez-vous modifier votre profil ?" #+ Offline profile warning

	key[]: "sm_empty_slot"
	val[]: "Emplacement vide" #+ Empty screenshot slot

	key[]: "sm_error"
	val[]: "Erreur" #+ Shown in screenshot slot when there is error while retrieving its content.

	key[]: "upload_to_slot"
	val[]: "Transférer sur l'emplacement sélectionné" #+ Upload button

	key[]: "upload_as_profile_screenshot"
	val[]: "Utiliser pour mon profile truck" #+ Upload button

	key[]: "delete_screenshot"
	val[]: "Do you want to permanently delete the following screenshot?"

	key[]: "upload_screenshot"
	val[]: "Voulez-vous envoyer la photo sur l’emplacement sélectionné ?<br><br>Le contenu actuel de l’emplacement sera écrasé !"

	key[]: "upload_profile_screenshot"
	val[]: "Voulez-vous envoyer la photo pour qu’elle devienne votre camion du profil World of Trucks ?<br><br>L’image précédente de votre camion du profil sera écrasée !"

	key[]: "wotr_upload_title"
	val[]: "NOTE D'ENVOI"

	key[]: "new_screenshot"
	val[]: "Nouvelles photos disponibles pour envoi !" #+ New screenshot notification

	key[]: "uploading_screenshot"
