	key[]: "steer_cam_rotation_reverse"
	val[]: "Rotation de la caméra avec le volant en marche arrière" #+ Droplist for steering based camera rotation modes when reversing.

	key[]: "blinker_cam_rotation"
	val[]: "Rotation de la caméra avec les clignotants" #+ Checkbox enabling camera rotation based on blinker activation.

	key[]: "phys_cam_move"
	val[]: "Mouvements physiques de la caméra" #+ Checkbox enabling camera movement based on driver physics.

	key[]: "phys_cam_move_factor"
