	key[]: "load_save"
	val[]: "Sauvegarder & charger" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Changements dans le jeu détectés ! Pour éviter des problèmes de compatibilité de sauvegarde dus aux changements dans l’environnement du jeu, les livraisons inachevées ont été annulées sans pénalité pour vous." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Changements dans le jeu détectés !<br><br>Pour éviter des problèmes de compatibilité de sauvegarde, toutes les livraisons inachevées ont été annulées sans pénalité pour vous. Vous devrez garer votre camion dans un lieu sûr.<br><br>Veuillez sélectionner une destination de voyage rapide pour continuer." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Sauvegarde…" #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Appuyez sur $KEY$ pour passer la cinématique." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
