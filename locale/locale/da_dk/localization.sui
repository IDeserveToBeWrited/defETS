#+ Error messages
#@{
	key[]: "imgup_too_big_file"
	val[]: "Skærmbillede er for stort. Prøv venligst at reducere billedstørrelsen." #+ Error message shown if the size of the image file exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_unsupported"
	val[]: "Skærmbilledfilen er enten i stykker eller ikke understøttet." #+ Error message shown if the screenshot file is corrupted or has format which is not supported by the service.

	key[]: "imgup_too_big_resolution"
	val[]: "Skærmbilledet er for stort. Prøv venligst at reducere billedstørrelsen." #+ Error message shown if at least one dimension of the image exceeds upload limits and the automatic resize is unable to meet the requirements.

	key[]: "imgup_blocked"
	val[]: "Denne service vil ikke godkende dit skærmbillede." #+ Error message shown when the service rejects the upload for some non-technical reason.

	key[]: "imgup_no_rights"
	val[]: "Denne konto har ikke tilladelse til at sende skærmbilleder." #+ Error message shown if the account does not have rights to upload to the service.

	key[]: "imgup_conflicting_upload"
	val[]: "Der blev sendt 2 billeder til samme plads samtidig." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "Du kan ikke sende skærmbilleder i øjeblikket. Prøv igen senere." #+ Error message shown if the service currently can not accept new screenshots.

	key[]: "imgup_unknown_error"
	val[]: "Der skete en fejl ved sending. Prøv igen senere." #+ Error message shown when no more specific message applies.
#@}

	key[]: "screenshot_resized_dimensions"
	val[]: "Skærmbilledet er større end den tilladte størrelse på $LIMIT$ og er derfor skaleret ned." # Warning message shown after upload which triggered automatic resize because of its dimensions. $LIMIT$ is a string like "1920x1200".

	key[]: "screenshot_resized_file_size"
	val[]: "Skærmbilledfilen er større end den tilladte størrelse på $LIMIT$KB og er derfor skaleret ned." # Warning message shown after upload which triggered automatic resize because of its file size.  $LIMIT$ is a string like "3000".
#@}

