	key[]: "mp_warning_trailer"
	val[]: "Din nuværende trailer er ikke kompatibel med denne last. Skift traileren eller brug det leverede udstyr."

	key[]: "mp_warning_target_company_sleeping_suspend"
	val[]: "Du leverer i øjeblikket til en virksomhed, der er inaktiv i denne session.<br>Hvis du ønsker at oprette forbindelse, skal du levere dit job først, ellers vil det blive suspenderet og utilgængeligt, mens du er i denne session.<br><br>Vil du fortsætte?"

	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Du leverer i øjeblikket til en virksomhed, der er inaktiv i denne session.<br>Hvis du ønsker at oprette forbindelse, skal du levere dit job først, ellers vil det blive annulleret.<br><br>Vil du fortsætte?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "En virksomhed i nærheden af din lastbil eller trailer skal aktiveres, for at du kan deltage i denne session.<br>For at undgå problemer skal du flytte din lastbil og trailer længere væk fra virksomheden, ellers vil dit nuværende job blive suspenderet og utilgængeligt i denne session, og du vil blive teleporteret til den nærmeste tjeneste.<br><br>Ønsker du at fortsætte?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Et firma i nærheden af din lastbil eller trailer skal aktiveres for at du kan deltage i denne session.<br>For at undgå problemer skal du flytte din lastbil og trailer længere væk fra virksomheden, ellers vil dit nuværende job blive annulleret, og du vil blive teleporteret til den nærmeste tjeneste.<br><br>Ønsker du at fortsætte?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Et firma i nærheden af, hvor du efterlod din lastbil eller trailer, før du accepterede dit hurtige job, skal aktiveres, for at du kan deltage i denne session.<br>For at undgå problemer, når du vender tilbage til din lastbil, skal dit hurtige job annulleres og du vil blive teleporteret til den nærmeste tjeneste.<br><br>Ønsker du at fortsætte?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Dit valgte job leverer fra eller til et firma, der er inaktivt i denne session og vil ikke være tilgængeligt, når du har oprettet forbindelse.<br><br>Ønsker du at fortsætte?"

	key[]: "mp_warning_source_sleeping_cargo_not_loaded_suspend"
	val[]: "Dette valgte job leverer fra eller til et firma, der er inaktivt i denne session og vil ikke være tilgængeligt, når du har oprettet forbindelse.<br><br>Ønsker du at fortsætte?"

	key[]: "mp_warning_load_job_canceled"
	val[]: "Dit job blev annulleret, da det leverede til en virksomhed, der er inaktiv i denne session."

	key[]: "mp_warning_load_job_canceled_special"
	val[]: "Your job was canceled as spacial jobs are not supported in convoy."

	key[]: "mp_warning_load_job_unavailable"
	val[]: "Dit valgte job er ikke længere tilgængeligt, da det var fra en virksomhed, der er inaktiv i denne session."

	key[]: "mp_warning_load_teleport"
	val[]: "Din lastbil blev teleporteret til den nærmeste tjeneste, da den gemte placering var for tæt på et firma, der var aktiveret til at matche denne session."

	key[]: "mp_warning_load_cancel_teleport"
	val[]: "Dit job blev annulleret, da det leverede til et firma, der er inaktivt i denne session.<br>Derudover blev din lastbil teleporteret til den nærmeste tjeneste, fordi den gemte placering var for tæt på et firma, der var aktiveret til at matche denne session."

	key[]: "mp_warning_load_unavailable_teleport"
