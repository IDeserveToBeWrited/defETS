	key[]: "sm_save_failed_not_enough_space"
	val[]: "Der er ikke nok lagerplads til at gemme spillet eller oprette en ny gemt fil. Frigør plads, og prøv igen." #+ message box when saving fails due to insufficient space

	key[]: "sm_save_system_init_failed"
	val[]: "Initialisering af lagringsadministrator mislykkedes. Du vil ikke kunne få adgang til eller gemme dine fremskridt." #+ message when save manager initialization fails, preventing progress
#@}

