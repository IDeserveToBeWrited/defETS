#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKEN" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banken" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Hvis du mangler penge, kan du altid bede banken om et lån." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "LÅNETILBUD" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "for $MONEY$ pr. dag" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Antal aktive lån: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Du kan låne: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "OVERSIGT OVER AKTIVE LÅN"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Lån" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Restgæld" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Varighed (i dage)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Rente (p.a.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Afdrag" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Afbetal" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Total:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Saldo: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

#+ New loan confirmation window
#@{

	key[]: "bank_nl_confirm_title"
	val[]: "NYT LÅN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_nl_confirm_info"
	val[]: "Du har ønsket et lån på $MONEY$" #+ The $MONEY$ is replaced with the real amount of money you will get.

	key[]: "bank_nl_confirm_duration"
	val[]: "Tilbagebetalingsperiode:" #+ Appended by number of days.

	key[]: "bank_nl_confirm_intrate"
	val[]: "Rentesats (pr. år.):" #+ Appended by interest rate percents.

	key[]: "bank_nl_confirm_installment"
	val[]: "Dagligt afdrag:" #+ Appended by sum in euros.

	key[]: "bank_nl_confirm_makesure"
	val[]: "Ønsker du at bekræfte din låneansøgning?"
#@}

#+ Loan repayment confirmation window
#@{

	key[]: "bank_rl_confirm_title"
	val[]: "AFBETAL LÅN" #+ Title of the window. Please keep in upper case where possible.

	key[]: "bank_rl_confirm_msg"
	val[]: "Ønsker du virkelig at bruge $MONEY$ på at tilbagebetale lånet?" #+ The $MONEY$ is replaced with the real amount the player will be paying.
#@}

#@}


