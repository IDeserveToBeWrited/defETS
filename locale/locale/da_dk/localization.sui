	key[]: "load_save"
	val[]: "Gem & Hent" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "En Spilændring er opdaget! For at undgå kompatibilitets-problemer ved gemte spil som følge af ændringer i spillets verden, blev eventuelt nuværende leverancer annulleret uden straf for dig." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "En Spilændring er opdaget!<br><br> For at undgå kompatibilitets-problemer ved gemte spil, blev eventuelt nuværende leverancer annulleret uden straf for dig. Det er nødvendigt at parkere lastbilen et sikkert sted.<br><br>Vælg venligst et hurtigrejse-mål for at fortsætte." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Gemmer..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Tryk $KEY$ for at fortsætte." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
