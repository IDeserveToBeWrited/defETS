	val[]: "Tildeler knap til acceleration."

	key[]: "o_im_back_reverse_op_tooltip"
	val[]: "Tildeler knap til bremsning.<br><br>Hvis \"Simpel automatisk\" transmissionstype er valgt, vil den samme knap også blive brugt til baglænskørsel."

	key[]: "o_im_left_op_tooltip"
	val[]: "Tildeler knap til at styre til venstre."

	key[]: "o_im_right_op_tooltip"
	val[]: "Tildeler knap til at styre til højre."

	key[]: "o_im_gear_up_op_tooltip"
	val[]: "Tildeler knap til at skifte op."

	key[]: "o_im_gear_down_op_tooltip"
	val[]: "Tildeler knap til at skifte ned."

	key[]: "o_im_gear_neutral_op_tooltip"
	val[]: "Tildeler knap til at skifte til neutral."

	key[]: "o_im_gear_drive_op_tooltip"
	val[]: "Tildeler knap til at skifte til kørsel."

	key[]: "o_im_gear_reverse_op_tooltip"
	val[]: "Tildeler knap til at skifte til bakgear."

	key[]: "o_im_gear_up_hint_op_tooltip"
	val[]: "Tildeler knap, der antyder, at automatgearet skal skifte op, før det gør det af sig selv."

	key[]: "o_im_gear_down_hint_op_tooltip"
	val[]: "Tildeler knap, der antyder, at automatgearet skal skifte ned, før det gør det af sig selv."

	key[]: "o_im_trans_semi_switch_op_tooltip"
	val[]: "Tildeler knap til at skifte mellem \"rigtig automatisk\" og \"sekventiel\" transmissionstyper."

	key[]: "o_im_auto_transmission_mode_op_tooltip"
	val[]: "Tildeler knap til at skifte tilstande for den adaptive automatiske gearkasse."

	key[]: "o_im_engine_op_tooltip"
	val[]: "Tildeler knap til at starte eller stoppe motoren."

	key[]: "o_im_engine_electricity_op_tooltip"
	val[]: "Tildeler knap for at slå elektriciteten til/fra.<br><br>Hvis tildelt vil du skulle slå elektriciteten til, inden du tænder motoren. Motoren vil så skulle slukkes ved at slå elektriciteten fra i stedet for at benytte den normale start/stop motor-knap."

	key[]: "o_im_parkingbrake_op_tooltip"
	val[]: "Tildeler knap til parkeringsbremsen."

	key[]: "o_im_motorbrake_op_tooltip"
	val[]: "Tildeler knap til motorbremsen.<br><br>Motorbremsen vil være aktiv, så længe du holder knappen nede."

	key[]: "o_im_engine_brake_tgl_op_tooltip"
	val[]: "Tildeler knap til at skifte motorbremsen.<br><br>Efter tryk på knappen vil motorbremsen være aktiv, indtil du trykker på knappen igen."

	key[]: "o_im_engine_brake_up_op_tooltip"
	val[]: "Tildeler knap til at øge motorbremsen."

	key[]: "o_im_engine_brake_down_op_tooltip"
	val[]: "Tildeler knap til at sænke motorbremsen."

	key[]: "o_im_auto_engine_brake_op_tooltip"
	val[]: "Tildeler knap til at tænde/slukke for den automatiske motorbremse."

	key[]: "o_im_trailer_brake_op_tooltip"
	val[]: "Tildeler knap til trailerbremse."

	key[]: "o_im_retarder_up_op_tooltip"
	val[]: "Tildeler knap til at øge retarderen."

	key[]: "o_im_retarder_down_op_tooltip"
	val[]: "Tildeler knap til at reducere retarderen."

	key[]: "o_im_auto_retarder_op_tooltip"
	val[]: "Tildeler knap til at tænde/slukke for den automatiske retarder."

	key[]: "o_im_lift_axle_op_tooltip"
	val[]: "Tildeler knap til at løfte/sænke akslen, hvis dit køretøj har en løftbar aksel."

	key[]: "o_im_lift_axle_trailer_op_tooltip"
	val[]: "Tildeler knap til at løfte/sænke akslen, hvis din trailer har en løftbar aksel."

	key[]: "o_im_slide_axle_manual_op_tooltip"
	val[]: "Tildeler en knap til at vælge manuel aksel-/tandemjustering, hvis din trailer har aksel/tandem. Manuel instilling bremser trailerens hjul og frakobler akslen/tandemen fra chassiet, så positionen kan justreres ved at bevæge lastbilen.<br><br>Hvis utildelt vil akslernes position automatisk tilpasses den aktuelle situation."

	key[]: "o_im_diff_lock_op_tooltip"
	val[]: "Tildeler knap til låsning/oplåsning af differentialet."

	key[]: "o_im_front_susp_up_op_tooltip"
	val[]: "Tildeler knap til at justere højden af forhjulsophænget op."

	key[]: "o_im_front_susp_down_op_tooltip"
	val[]: "Tildeler knap til nedjustering af forhjulsophængets højde."

	key[]: "o_im_rear_susp_up_op_tooltip"
	val[]: "Tildeler knap til at justere højden på baghjulsophænget op."

	key[]: "o_im_rear_susp_down_op_tooltip"
