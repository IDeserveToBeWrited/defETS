#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "For at tilgå hurtige jobs er du nødt til at fuldføre den nuværende tutorial."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "For at tilgå fragtmarkedet er du nødt til at købe din første lastbil."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "For at tilgå lastmarkedet er du nødt til at købe din første trailer."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "For at tilgå de eksterne kontrakter er du nødt til at købe din første lastbil og have en World of Trucks-forbundet profil."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "For at tilgå det eksterne marked er du nødt til at købe din første trailer og have en World of Trucks-forbundet profil."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Se verdenskortet, dets udforskede områder og dine nuværende navigations-checkpoints, eller placer nye."

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Rejs mod betaling hurtigt til en tidligere opdaget by."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Gennemse, søg og filtrer online konvoj-sessioner for at tilslutte dig eller skabe dine egne for andre."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Din indbakke for beskeder fra forretningsverdenen, banker og nye ansættelser."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "Du vil begynde at modtage emails, når du er kommet længere i din karriere."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Find og køb tilgængelige garager på verdenskortet."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Gennemse og bedøm tilgængelige brugte lastbiler til salg."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Du har endnu ikke fundet nogen lastbilforhandlere."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Gennemse, bedøm og omkonfigurer tilgængelige trailere til salg."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Udvid din køreoplevelse med lidt musik."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Radioen er ikke tilgængelig."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Konfigurer grafik, lyd, gameplay, styring og online-indstillinger."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Se dine karrierefremskridt, statistikker og nyligt fuldførte jobs."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "For at tilgå en aktiv konvoj er du først nødt til at tilslutte dig en konvoj-session."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Sundhedsadvarsel"

	key[]: "health_warning_description"
	val[]: "Et lille antal brugere kan være modtagelige for epileptiske anfald eller tab af bevidsthed, når de udsættes for visse blinkende lys eller lysmønstre. Sådanne personer kan opleve et anfald, mens de ser bestemte billeder eller spiller et videospil. Hvis du eller nogen i din familie nogensinde har haft symptomer relateret til epilepsi (anfald eller bevidsthedstab), når de er udsat for blinkende lys, skal du kontakte en læge og tage alle nødvendige forholdsregler, før du spiller spillet.<br offset=20>Hvis du eller dit barn oplever et eller flere af følgende symptomer, mens du spiller et videospil: svimmelhed, ændret syn, øjen- eller muskeltrækninger, bevidsthedstab, desorientering, kramper, ufrivillige bevægelser, stop med at bruge videospillet med det samme og kontakt en læge."

	key[]: "trademark"
	val[]: "Alle mærker, trademarks, registrerede mærker, logoer og symboler på køretøjer i spillet er deres retmæssige ejeres ejendom og bruges med tilladelse. MAN®-trademarks og designs er registreret ejendom af MAN Truck & Bus AG og bruges under licens til SCS Software s.r.o. \"Mercedes-Benz\" og \"Tretakket stjerne i en ring\" er trademarks ved Daimler AG og bruges under licens af SCS Software s.r.o. RENAULT-trademarks og designs er registerede rettigheder af eller licenseret til AB Volvo Group og bruges i henhold til licens. VOLVO-trademarks og designs er registrerede rettigheder af eller er licenseret til AB Volvo Group og bruges i henhold til licens."
#@}

#+ Save manager errors
