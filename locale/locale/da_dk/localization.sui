#+ Online options and content connecting related strings.
#@{
	key[]: "wotr_connected_content_header"
	val[]: "INDHOLD TILSLUTTET WORLD OF TRUCKS" #+ The separator text in the online options screen.

	key[]: "connect_content"
	val[]: "Tilslut" #+ The button which opens the connect content screen.

	key[]: "browse_connected_content"
	val[]: "Gennemse" #+ The button which opens the connected content browser screen.

	key[]: "general_settings"
	val[]: "GENERELLE INDSTILLINGER" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "TILSLUT INDHOLD" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Tilslut" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World Of Trucks har fundet nyt spilindhold. Tilslut til World of Trucks-tjenesten for at drage fordel af det." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online-indstillinger. Juster alle World of Trucks-relaterede indstillinger." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Ønsker du virkelig at udskyde registreringen?<br><br>Du kan få adgang til Online Connect Content-dialog senere fra online-indstillingerne, som ligger på skrivebordet." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "TILSLUTTER INDHOLD" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Tilslutter indhold.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Det lykkedes ikke at opretholde forbindelse for: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam-kontoen du brugte til at registrere denne DLC, adskiller sig fra den, der blev brugt til at oprette din World Of Trucks-konto eller registrering af spillet. Skift venligst din Steam-konto og prøv igen." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Den Steam-konto, du bruger til at registrere denne DLC er allerede tilknyttet en anden World Of Trucks-konto. For at registrere denne DLC til aktuelle konto, skal du bruge en Steam-konto, der ikke allerede er forbundet til en World Of Trucks-konto." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Steam-token er udløbet. Prøv igen senere." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Seriel-nøglen, du bruger til at aktivere denne DLC er ikke gyldig. Kontakt support for at få hjælp: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Der er opstået en intern fejl under registrering af spillet. Prøv igen senere." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "SUCCES" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "INDHOLDSBROWSER" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Tillykke! Valgte DLC er nu forbundet til din World Of Trucks-konto." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Kan ikke forbinde indholdet, fordi den aktuelle Steam-konto er forbundet med en anden World Of Trucks-konto." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Nogle DLC'er kunne ikke forbindes.<br>Hold musen hen over udråbstegn for at se flere detaljer." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registrerer $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Den aktuelle profil er ikke forbundet til World of Trucks, eller spillet kører i offlinetilstand. Rediger profil for at oprette forbindelse." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Klik for at afvise"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ kompatible DLC'er er i øjeblikket tilsluttet. Hvis nogle DLC'er ikke er tilsluttet til WOTR kan du gå glip af nogle af disse funktioner." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Tillykke! <color value=@@clr_txt@@>Alt dit indhold er forbundet til World of Trucks! Du kan nu bruge alle funktioner." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Kan ikke forbinde til nyt indhold på World Of Trucks, fordi den nuværende Steam-konto passer ikke overens med den Steam-konto som anvendes på World Of Trucks-profilen." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Tilsluttet" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Ikke tilsluttet" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Kan ikke hente oplysninger om det indhold du ejer." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
	val[]: "Kan ikke hente oplysninger om tilsluttet indhold." #+ Error displayed when connected DLCs fetch fails.

	key[]: "steam_info_fetch_failed"
	val[]: "Kan ikke hente oplysninger om den aktuelle anvendte konto." #+ Error displayed when fetching of the currently used account fails.

	key[]: "later_button"
	val[]: "Senere" #+ The button postponing DLC registration for the later time.

	key[]: "dlc_registration_blocked_no_permanent_ownership"
	val[]: "Kan ikke registrere denne DLC. Ingen permanent licens er fundet, sandsynligvis på grund af Steam Family Sharing." #+ The error displayed when DLC registration is blocked because the package is not permanently owned by player (for example due to family sharing).

	key[]: "dlc_no_permanent_ownership"
	val[]: "Intet permanent ejerskab" #+ The state of the content that cannot be connected due to invalid license.
#@}


#+ Strings related to special missions and the whole project of ovs.
#@{
	#+ The name of the pop-up window for oversize mission when it's succesfully delivered.
	key[]: "oversize_job_done_desc"
	val[]: "Særtransport-mission er fuldført!"

	#+ The name of the pop-up window for oversize mission failing. Must be UPPER CASE.
	key[]: "ovesize_failure_dialog_title"
	val[]: "MISSION FEJLET!"

	#+ Text on the button for giving up on the oversized cargo delivery.
	key[]: "abandon_job"
	val[]: "Afbryd"

	#+ Text on the button for loading the last made checkpoint.
	key[]: "load_last_checkpoint"
	val[]: "Hent checkpunkt"

	#+ Text showed when player will hit the escort vehicle and oversized cargo delivery is over because of that.
	key[]: "oversize_escort_crash_player_failure_dialog_text"
	val[]: "Du har beskadiget følgekøretøjet!<br>Du kan indlæse et GPS punkt eller annullere leveringen mod et gebyr på $MONEY$."

	#+ Text showed when player lead the escort vehicle to crash with another traffic ai.
	key[]: "oversize_escort_crash_ai_failure_dialog_text"
	val[]: "Følgekøretøjet kørte galt på grund af en anden bilist i trafikken.<br> Du kan indlæse et checkpunkt eller annullere leveringen mod et gebyr på $MONEY$."

	#+ Text showed when player will drive off the route and Special Transport is over because of that.
	key[]: "oversize_off_route_failure_dialog_text"
	val[]: "Du skulle følge ruten.<br>Du kan indlæse et GPS-punkt eller annullere leveringen mod et gebyr på $MONEY$."

	#+ Text showed when player will drive away from the escort vehicles and Special Transport is over because of that.
	key[]: "oversize_not_following_failure_dialog_text"
	val[]: "Du skulle blive ved følgekøretøjerne.<br>Du kan indlæse et GPS punkt eller annullere leveringen mod et gebyr på $MONEY$."

	#+ Text showed when fading after player will drive away from escort vehicles and the Special Transport is over.
	key[]: "oversize_not_following_failure_fade_text"
	val[]: "Du har kørt væk fra følgekøretøjerne!"

	#+ Text showed when fading after player will crash the escort vehicles and the Special Transport is over.
	key[]: "oversize_escort_crash_player_failure_fade_text"
	val[]: "Du har beskadiget følgekøretøjet!"

	#+ Text showed when fading after player will lead the escort vehicles into crash with another ai and hence the Special Transport job is over.
	key[]: "oversize_escort_crash_ai_failure_fade_text"
	val[]: "Følgekøretøjet kørte galt!"

	#+ Text showed when fading after player will leave the route and hence the Special Transport job is over.
	key[]: "oversize_off_route_failure_fade_text"
	val[]: "Du er kørt væk fra ruten!"

	#+ Text in description of the special deliveries / jobs offers.
	key[]: "cargo_dimensions"
	val[]: "Dimensioner"

	#+ Text in the upper left corner while job is active, that small window/menu of active job.
	key[]: "special_job_resumed"
	val[]: "Levering af særtransport"

	#+ Text GPS Advisor when player will leave the space between escorting vehicles.
	key[]: "wrong_lane_warning"
	val[]: "Hold venligst din last mellem følgekøretøjerne."

	#+ Text under the small icon in the Job Market menu.
	key[]: "job_special"
	val[]: "Særlig Leveringer"

	#+ Dimensions on the loading screen and at the F6 menu in the GPS advisor.
	key[]: "dimensions"
	val[]: "Dimensioner"

	#+ Text on the loading screen which refers to the what you're about to deliver.
	key[]: "current_oversize_job_title"
	val[]: "Særtransport"

	#+ Text on gps advisor which suggest slowing down for players.
	key[]: "adviser_slow_down"
	val[]: "Sænk venligst farten for at undgå<br>at ramme følgekøretøjet..."

	#+ Text on gps advisor which suggest to wait for the rear escort vehicle.
	key[]: "adviser_wait_back"
	val[]: "Vent venligst på det bageste følgekøretøj..."

	#+ Text on gps advisor which suggest careful behavior because of tight route coming.
	key[]: "adviser_tight_route"
	val[]: "Vær forsigtigt nu, ruten længere fremme bliver mere smal..."

	#+ Text on gps advisor which suggest careful behavior because of changing the lines.
	key[]: "adviser_change_maneuver"
	val[]: "Ændring af bane længere fremme. Tilpas eventuelt din hastighed efter forholdene..."

	#+ Text on gps advisor which suggest careful behavior because the front escort vehicel is going forward to make a path for player.
	key[]: "adviser_path_for_you"
	val[]: "Forreste følgekøretøj vil advare andre chauffører... <br> Tilpas din hastighed for at undgå mulige uheld..."

	#+ Text on gps advisor which informs player that the escort vehicles are waiting for him at some intersection nearby.
	key[]: "adviser_escorts_nearby"
	val[]: "Følgekøretøjer venter på dig ved et nærliggende kryds. Følg venligst ruten."

	#+ Text on gps advisor when player will be moving with a reverse to the rear escort to warn of a possible crash.
	key[]: "close_to_the_back_escort_big_dist"
	val[]: "Pas på!<br>Du nærmere dig det bageste følgekøretøj!"

	#+ Text on gps advisor when player will be moving really close with a reverse to the rear escort to warn of possible crash.
	key[]: "close_to_the_back_escort_small_dist"
	val[]: "Pas på!<br>Du kommer faretruende tæt på det bageste følgekøretøj!"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup.
	key[]: "special_job_offer"
	val[]: "Tryk på denne tast for at se det særlige jobtilbud:"

	#+ Text on gps advisor that is showed when player drive on the trigger for special mission pickup, this is the name of the trigger, the name of the menu.
	key[]: "special_job_offer_title"
	val[]: "Særligt Job Tilbud"

	#+ Oversize tutorial intro text.
	key[]: "oversize_tutorial_intro"
	val[]: "Du skal til at køre med en Særlig Transport! Der er to følge køretøjer, som vil vise dig vej. Vær forsigtig og følg deres ledelse og forslag. Særlige transporter som denne stopper ikke ved et rødt signal og har forkørselsret i de fleste situationer. Under disse leverancer bliver der lavet kontrolpoints oftere for at gemme din nuværende fremgang."

	#+ Oversize tutorial warnings sub-title.
	key[]: "oversize_tutorial_warnings_subtitle"
	val[]: "Vær særligt opmærksom på følgende:"

	key[]: "oversize_tutorial_warning_conflict"
	val[]: "Undgå enhver mulig konflikt med følgekøretøjerne og hold fragten mellem dem."

	key[]: "oversize_tutorial_warning_offroad"
	val[]: "Kør ikke uden for den anslåede rute, heller ikke til tankstationer, rastepladser osv."

	key[]: "oversize_tutorial_warnings_speed"
	val[]: "Overhold hastighedsbegrænsninger, som sikres af det forreste følgekøretøj."

	key[]: "oversize_tutorial_warnings_traffic"
	val[]: "Hold øje med den overhalende trafik og andre bilister på vejene."

	key[]: "oversize_tutorial_warnings_change_lane"
	val[]: "Skift bane således:"

	#+ Oversize tutorial outro text.
	key[]: "oversize_tutorial_outro"
	val[]: "Hvis du ikke følger disse regler, kan din særtransport mislykkes!"

	#+ First changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_1"
	val[]: "Manøvren startes ved at det <color value=@@clr_sel@@>bageste<color value=@@clr_txt@@> følgekøretøj skifter og blokerer den valgte bane."

	#+ Second changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_2"
	val[]: "Det <color value=@@clr_sel@@>forreste<color value=@@clr_txt@@> følgekøretøj venter, indtil den udpegede bane er ledig, derefter skifter det også til den bane."

	#+ Third changle lane maneuver popup text.
	key[]: "oversize_tutorial_popup_3"
	val[]: "Det er nu sikkert for en <color value=@@clr_sel@@>spiller<color value=@@clr_txt@@> at skifte ind i den udpegede vognbane."

	#+ Message for fade_in screen when taking OVS mission with your own truck.
	key[]: "oversize_preparing_cargo"
	val[]: "Lastbilens tank blev genopfyldt, og kørselstiderne blev genoprettet."

	#+ Warning when player want to use assistance call during oversize mission.
	key[]: "oversize_assistance_reason"
	val[]: "Du kan ikke ringe efter hjælp under en særtransport-mission."

	#+ Warning when player want to use ferry transport during oversize mission.
