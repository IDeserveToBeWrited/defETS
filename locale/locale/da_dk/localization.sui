#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "HENT SPIL"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Hent spil" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Hent et gemt spil. Dit nuværende spil bliver ikke gemt først!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Er du sikker på, at du vil hente et andet spil?<br><br>Dit nuværende spil går tabt, med mindre du har gemt det tidligere."

	key[]: "load_progress_lost_mp"
	val[]: "Er du sikker på, at du vil indlæse et andet spil?<br>Hvis du gør det i multiplayer, kan det resultere i jobannullering eller suspendering, teleportering til den nærmeste tjeneste eller utilgængelighed af det valgte job.<br><br>Din nuværende fremgang vil gå tabt. medmindre gemt tidligere."

	key[]: "load_game_mp_suspended_job"
	val[]: "Gem spil blev indlæst, men dit aktive World of Trucks-job blev suspenderet og er ikke tilgængeligt i denne session."

	key[]: "autosave"
	val[]: "- Automatisk gemt spil -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Hurtig gem -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Vis automatisk gemte spil" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Ingen manuelle saves fundet." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Indlæs" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Ikke kompatibel save-fil!<br><color value=@@clr_txt@@>Prøv at opdatere til den nyeste tilgængelige version." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Kunne ikke indlæse og vise alle gemte filer for denne profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "OPMÆRKSOMHED" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problem med indlæsning af gemt spil.<color value=@@clr_txt@@><br><br>Det gemte spil kunne ikke indlæses. Du kan prøve at finde fejlen og muligvis løse den ved hjælp af nedenstående oplysninger. Alternativt kan du prøve at indlæse et andet gemt spil<br><br>Følgende grunde er ofte årsag til dette problem:<br><br>1. Det gemte spil virker ikke med nuværende MOD(s).<br><br>2. Det gemte spil mangler MOD(s) som er deaktiveret.<br><br>3. Det gemte spil virker ikke på grund af et MOD, der kan indeholde fejl.<br><br>4. Et PC-nedbrud under eller kort efter der blev gemt et spil automatisk, kan ødelægge det gemte spil."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Der mangler et MOD.<color value=@@clr_txt@@><br><br>Det sidst gemte spil bruger et eller flere manglende eller deaktiverede MODS.<br><br>Hvis dette er imod dine forventninger, bør du se din MOD-mappe igennem.<br><br>Du kan prøve at hente det gemte spil alligevel. Der kan dog ske det, at dit gemte spil ikke virker eller vil give andre problemer.<br><br>Du kan også prøve at hente et af de gemte spil som ikke skal bruge det manglende MOD."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Manglende DLC opdaget.<color value=@@clr_txt@@><br><br>Det seneste gemte spil er afhængigt af en manglende DLC (officiel spiludvidelse).<br><br>Hvis du ikke forventer dette, skal du tjekke tilstanden af din(e) DLC(er).<br><br>Ellers kan du indlæse det gemte spil alligevel, men nogle af de manglende funktioner fra DLC(en/erne) kan gå tabt.<br><br>Alternativt kan du prøve at indlæse et anden gemt spil, som ikke afhænger af den manglende DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Manglende DLC opdaget.<color value=@@clr_txt@@><br><br>Det seneste gemte spil er afhængigt af en manglende DLC (officiel spiludvidelse).<br><br>For at dit gemte spil skal kunne virke korrekt, skal den manglende DLC være til stede og aktiveret.<br><br>Alternativt kan du prøve at indlæse et andet af dine gemte spil, som ikke er afhængige af den manglende DLC."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>MOD er afhængigt af indhold fra en DLC.<color value=@@clr_txt@@><br><br>Mindst et MOD er afhængig af en DLC (officiel spiludvidelse), som på nuværende tidspunkt ikke er installeret.<br><br>Du kan enten deaktivere valgte MOD(s) eller installere den DLC der skal bruges af valgte MOD(s)."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Nedbrud opdaget<color value=@@clr_txt@@><br><br>Det ser ud som om at spillet gik ned i løbet af forrige indlæsning.<br><br>Du kan forsøge at identificere og muligvis løse dette problem ved hjælp af nedenstående oplysninger. Alternativt kan du prøve at indlæse et andet gemt spil.<br><br>De følgende grunde ofte årsag til problemet:<br><br>1. En eller flere af de installerede MODs er i stykker eller virker ikke med din version af spillet.<br><br>2. Det gemte spil indeholder MOD(s) som enten mangler eller er deaktiveret.<br><br>3. Det gemte spil er ødelagt ved brug af et MOD der ikke virker.<br><br>4. I nogle tilfælde kan hardware eller en driverfejl få spillet til at gå ned."

	key[]: "mods_detected_warning"
	val[]: "Tilstedeværelse af MODs er opdaget. Vær opmærksom på at fejlbehæftede, forældede eller inkompatible mods kan være årsag til ustabilitet. Gennemgå dine aktive MODs i mod-manageren." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

