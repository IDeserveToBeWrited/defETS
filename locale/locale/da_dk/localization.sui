#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Vælger undertyper for controlleren, så spillet kan håndtere inputområder korrekt."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Vælger gearkassetype:<br>- \"Simpelt automatgear\" tillader brugen af speeder og bremse for at kontrollere bevægelse fremad og bagud.<br>- \"Ægte automatgear\" kræver et input for at skifte mellem fremadgående gear og bakgear.<br>- \"Sekventiel\" kræver manuelt skifte af alle gear med gear op/ned-input.<br>- \"H-skifter\" kræver brugen af en controller med skifteporte for at skifte gear manuelt."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Ændrer den automatgearets opførsel:<br>- \"Økonomitilstand\" foretrækker lavere omdrejningshastigheder sigtende mod optimalt drejningsmoment.<br>- \"Effekttilstand\" sigter mod optimale hestekræfter på bekostning af brændstofsøkonomien for lettere navigering med tung last eller i bjergrigt terræn."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Ændrer forholdet mellem enhedens drejningsgrad og køretøjets faktiske drejningsgrad ved styring."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser sammenhængen mellem input og styring af køretøjet.<br><br>Hvis en højere værdi vælges, betyder det, at styringen vil være mindre responsiv, når rattet er i midterposition, men vil stige i følsomhed, jo mere rattet drejes. Dette kan hjælpe med at mildne styringsinput, når der køres ligeud."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Aktiverer force feedback på controllere, som understøtter dette."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser den overordnede styrke for alle force feedback-indtillinger mellem 0N og 10N.<br><br><color value=@@clr_txt_d@@>Vær opmærksom på, at hvis der vælges en højere indstilling, kan det forårsage skade på fingre og hænder ved kraftfulde rat."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser centreringskraften når der køres ved høj hastighed, hvilket topper ved 90 km/t (56 mph) og over.<br><br>Minimumsindstillingen vil resultere i ingen hjulcentreringskraft."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser centreringskraften når der køres ved lav hastighed.<br><br>Minimumsindstillingen vil resultere i ingen hjulcentreringskraft."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Justerer styrken af kunstig intern friktion forårsaget af mekaniske styrekomponenter."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af kunstig motorresonans gennem ratstammen.<br><br><color value=@@clr_txt_d@@>Vær opmærksom på, at hvis værdier over 15% vælges, kan det forårsage overdreven rysten og vibrationer i nogle rat."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af vejoverflade-effekter gennem ratstammen.<br><br><color value=@@clr_txt_d@@>Vær opmærksom på, at hvis værdier over 20% vælges, kan det forårsage overdreven rysten og vibrationer i nogle rat, når man kører hurtigt på ujævnt terræn."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af vejbump gennem ratstammen."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af kollisionseffekter gennem ratstammen."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af effekterne, hvis gearkassen skurrer."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af glideeffekter ved understyring."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken på assisteret styring (når vognbaneassistenten benyttes osv.)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af terrænvibrationer, hvis controlleren understøtter dette."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af vibrationer ved bump, hvis controlleren understøtter dette."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styrken af vibrationer ved kollisioner, hvis controlleren understøtter dette."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Hvilken enhedsakse som skal bruges ved styring."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser styreaksens dødzone, dvs. hvor langt fra midterpositionen input ignoreres.<br><br>Dette kan mildne problemer ved ældre controllere såsom manglende præcision eller falske input forårsaget af slid."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer styringsakse-input:<br>- Centreret er ideel for rat og joysticks.<br>- Spejlet bruges til at rette en akse, som er blevet registreret forkert."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Hvilken enhedsakse som skal bruges for at accelerere køretøjet."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser accelerationsaksens dødzone, dvs. ved hvilket tryk input ignoreres.<br><br>Dette kan mildne problemer ved ældre controllere såsom manglende præcision eller falske input forårsaget af slid."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer controllerinput<br>- Centreret er ideel for joysticks.<br>- Normal er ideel for triggere eller pedaler.<br>- Spejlet kan kompensere for input som er registreret forkert."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Hvilken enhedsakse som skal bruges ved bremsning."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser bremseaksens dødzone, dvs. ved hvilket tryk input ignoreres.<br><br>Dette kan mildne problemer ved ældre controllere såsom manglende præcision eller falske input forårsaget af slid."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer controllerinput<br>- Centreret er ideel for joysticks.<br>- Normal er ideel for triggere eller pedaler.<br>- Spejlet kan kompensere for input som er registreret forkert."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Hvilken enhedsakse som skal bruges for at aktivere koblingen."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser koblingsaksens dødzone, dvs. ved hvilket tryk input ignoreres.<br><br>Dette kan mildne problemer ved ældre controllere såsom manglende præcision eller falske input forårsaget af slid."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer controllerinput<br>- Centreret er ideel for joysticks.<br>- Normal er ideel for triggere eller pedaler.<br>- Spejlet kan kompensere for input som er registreret forkert."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser koblingens virkeområde<br><br>Jo længere til højre, du sætter det, desto mere vil du skulle trykke pedalen for at aktivere koblingen."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Hvilken enhedsakse som skal bruges for at vippe kameraet op og ned."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser se op/ned-aksens dødzone, dvs. ved hvilket tryk input ignoreres.<br><br>Dette kan mildne problemer ved ældre controllere såsom manglende præcision eller falske input forårsaget af slid."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer akse-input:<br>- Centreret er ideel for joysticks.<br>- Spejlet bruges til at rette en akse, som er blevet registreret forkert."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Hvilken enhedsakse som skal bruges for at dreje kameraet mod venstre og højre."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Tilpasser se til venstre/højre-aksens dødzone, dvs. ved hvilket tryk input ignoreres.<br><br>Dette kan mildne problemer ved ældre controllere såsom manglende præcision eller falske input forårsaget af slid."

	key[]: "look_leftright_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Bestemmer hvordan spillet håndterer akse-input:<br>- Centreret er ideel for joysticks.<br>- Spejlet bruges til at rette en akse, som er blevet registreret forkert."

	key[]: "hshift_layout_op_tooltip" # - Controls, Advanced
	val[]: "Vælger hvilket gearlayout som skal bruges med H-skifteren."

	key[]: "hshift_behavior_op_tooltip" # - Controls, Advanced
	val[]: "Ændrer gearskifterens opførsel:<br>- Ved indstillingen \"Simpel\" vil du aldrig skade gearene, når der skiftes.<br>- Ved \"Simpel + advarselslyd\" vil du fortsat kunne skifte gear, men du vil høre gearene skurre, når du skifter forkert. \"Avanceret\" tillader ikke, at du skifter gear, hvis du gør det forkert, og du vil kun høre gearene skurre.<br>- \"Avanceret\" giver dig også mulighed for at benytte \"Gearskifter hurtig split\"-indstillingen."

	key[]: "hshift_fast_split_op_tooltip" # - Controls, Advanced
	val[]: "Vælg hvordan spillet håndterer hurtige gear splits:<br>- \"Aldrig\" kræver, at gearskifteren flyttes til neutral mellem splits.<br>- \"Kobling tryk\" kræver et kort tryk på koblingen uden bevægelse af gearskifteren.<br>- \"Speeder frigivet\" kræver, at køreren kun løfter foden fra speederen for at splitte gear uden bevægelse af gearskifteren, mens \"Kobling eller speeder\" er en kombination af de sidste to."

	key[]: "hshift_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_1_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_2_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_3_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_4_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_5_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_6_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler gearskifterens position."

	key[]: "hshift_toggle_1_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler inputtet som skal bruges for at skifte mellem ranges baseret på gearskifterens layout."

	key[]: "hshift_toggle_2_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler knap for at vælge gearskifter-splitteren baseret på gearskifterens layout."

	key[]: "hshift_toggle_mode_op_tooltip" # - Controls, Advanced
	val[]: "Aktiver når der bruges kontakter i stedet for knapper til range- eller splitter-input."

	key[]: "hshift_auto_drive_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler knap for at skifte til køretilstand for automatgearet."

	key[]: "hshift_auto_reverse_op_tooltip" # - Controls, Advanced
	val[]: "Tildeler knap for at skifte til bakketilstand for automatgearet."

