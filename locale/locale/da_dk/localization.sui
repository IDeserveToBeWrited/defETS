	key[]: "dlc_acquire_timeout" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Det tager længere end forventet at hente DLC'er. Processen fortsætter nu i baggrunden."

	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Det tager længere end forventet at hente DLC'er. Vil du gerne vente?<br><br>Hvis du går videre, vil processen fortsætte i baggrunden."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Adgang til nogle DLC'er er opnået. Ønsker du at forlade titelskærmen nu for at se det nye indhold?<br><br>Dine fremskridt vil blive gemt automatisk."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "Adgang til nogle DLC'er er tabt. Du forlader nu titelskærmen for at se ændringerne i indholdet.<br><br>Dine fremskridt vil blive gemt automatisk."
#@}

