#+ Cabin adjuster
#+
#+ Window allowing user to launch one from the adjusters.
#@{

	key[]: "adjust_o_t"
	val[]: "KØRETØJS JUSTERINGER" #+ Title of the window. Please keep in upper case where possible.

	key[]: "adjust_link_t"
	val[]: "Køretøjs-<br>justeringer" #+ Icon opening the adjuster. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "lights"
	val[]: "Juster lygter" #+ Opens the light adjuster.

	key[]: "truck_light_help"
	val[]: "Juster lyset på din lastbil.<br>Tænd eller sluk for brugen af påsat lysudstyr." #+ Help message associated with light adjuster icon.

	key[]: "mirrors"
	val[]: "Juster spejle" #+ Opens the mirror adjuster.

	key[]: "truck_mirror_help"
	val[]: "Indstil dine spejle til at spore dine omgivelser bedre.<br>Alle spejle kan justeres her." #+ Help message associated with mirror adjuster icon.

	key[]: "seat"
	val[]: "Juster sæde"  #+ Opens the seat adjuster.

	key[]: "truck_seat_help"
	val[]: "Flyt dit førersæde og rat for maksimal komfort.<br>Justere rat, sæde og synsvinkel i alle retninger." #+ Help message associated with seat adjuster icon.

	# trailer adjuster name string is in assistance section (it could be open from both screens)

	key[]: "trailer_adjust_help"
	val[]: "Juster længden eller andre dele på din egen trailer for at tilpasse den til en bestemt last. Justeringen vil afgøre hvilken fragt, du kan se i dit lastcenter." #+ Help message associated with trailer adjuster icon.
#@}

