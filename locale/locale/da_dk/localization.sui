	val[]: "Aktiverer dynamisk RGB-feedback på kompatible enheder."

	key[]: "eye_tracking_enable_op_tooltip" # - Controls, Advanced
	val[]: "Aktiverer og konfigurerer eye tracking-funktioner på kompatible enheder."
