#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Den nødvendige DLC (officielle spiludvidelse) $DEPENDENCY_NAME$ mangler. For at dit gemte spil kan fungere korrekt, skal dette DLC skal være til stede og aktiveret på denne computer. Du skal løse problemet, før du kan indlæse dit gemte spil." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Den valgfrie DLC (officielle spiludvidelse) $DEPENDENCY_NAME$ mangler. Hvis du ikke forventede dette, skal du tjekke tilstanden af DLC.<br><br>Ellers kan du indlæse det gemte spil alligevel, men nogle funktioner, som denne DLC indeholder, vil gå tabt." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Dette MOD $DEPENDENCY_NAME$ mangler eller er deaktiveret. Hvis du ikke forventer det, skal du tjekke tilstanden af dette MOD. Du kan prøve at indlæse dit gemte spil alligevel. Afhængigt af hvad dette MOD gjorde, er det muligt, at spillet ikke kan indlæses, eller andre problemer kan opstå." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Dette MOD $DEPENDENCY_NAME$ passer ikke med din version af spillet. Det betyder, at forfatteren til dette MOD har gjort således at det kun er kompatibelt med en begrænset version af spillet, og den aktuelle version af spillet er ikke blandt dem<br><br>Løsningen:<br>- Prøv at finde en opdateret version af dette MOD, som er lavet til at arbejde sammen med den aktuelle version af spillet.<br>- opdater eller nedgrader spillet til den version, som MOD kræver.<br><br>Du kan prøve at indlæse dit gemte spil alligevel, men dit MOD vil ikke blive indlæst, og det er muligt, at dit gemte spil kan svigte eller forårsage andre problemer." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "MANGLENDE AFHÆNGIGHEDER" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETALJER" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Åben Workshop-side"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Dette gemte spil er afhængig af en DLC eller et MOD, som i øjeblikket mangler. De er angivet nedenfor. Ved at vælge i listen, kan du få mere information om hvert enkelt element." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Dette gemte spil er afhængig af mindst én DLC eller MOD. Du er nødt til at fikse problemet, før du kan loade dette gemte spil." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Fortryd" #+ Abort loading button.

	key[]: "type"
	val[]: "Type" #+ Type column.

	key[]: "dependency_name"
	val[]: "Afhængigheds navn" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokalt MOD" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop MOD" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Valgfri DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Påkrævet DLC" #+ DLC that is required to load save that is depending on it.
#@}

