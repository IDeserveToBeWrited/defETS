	val[]: "Automatisk slukning af blinklys" #+ Checkbox for enabling of automatic blinker turning off.

	key[]: "road_events"
	val[]: "Tilfældige vejbegivenheder" #+ Slider for player modification of road event probability and placement.

	key[]: "rain_factor"
	val[]: "Sandsynlighed for regn" #+ Slider for player modification of rain probability and duration.

	key[]: "wotr_connected_content"
	val[]: "World of Trucks-forbundet indhold" #+ Information and buttons for connecting World of Trucks content.

	key[]: "online_news"
	val[]: "Onlinenyheder" #+ Checkbox enabling display of online news and informations about game updates.

	key[]: "online_loading_screens"
	val[]: "Billedfremviser" #+ Checkbox enabling use of online loading screens.

	key[]: "online_billboards"
	val[]: "Dynamiske reklametavler" #+ Checkbox enabling use of online data for ingame billboards

	key[]: "mouse_invert"
	val[]: "Omvendt mus" #+ Checkbox enabling inversion of the mouse.

	key[]: "show_cutscenes"
	val[]: "Vis filmsekvenser" #+ Checkbox for enabling/disabling game cutscenes (e.g. garage/truck purchase/upgrade)

	key[]: "show_blockers"
	val[]: "Vis blokeringsvæg (vær forsigtig med at deaktivere dette)" #+ Checkbox for enabling/disabling game blockers rendering (e.g. dead road ends, or DLC blockers)

	key[]: "steer_cam_rotation"
	val[]: "Brug ratkamera" #+ Checkbox enabling camera rotation based on steering angle.

	key[]: "steer_cam_rotation_factor"
	val[]: "Rotationsgrad for ratkamera" #+ Slider for steering based camera rotation multiplier.

	key[]: "steer_cam_rotation_reverse"
	val[]: "Brug ratkamera i bakgear" #+ Droplist for steering based camera rotation modes when reversing.

	key[]: "blinker_cam_rotation"
	val[]: "Brug blinklyskamera" #+ Checkbox enabling camera rotation based on blinker activation.

	key[]: "phys_cam_move"
	val[]: "Fysisk kamerabevægelse" #+ Checkbox enabling camera movement based on driver physics.

	key[]: "phys_cam_move_factor"
	val[]: "Fysisk kamerabevægelsesfaktor" #+ Slider for physics based camera movement multiplier.

	key[]: "toy_phys_move"
