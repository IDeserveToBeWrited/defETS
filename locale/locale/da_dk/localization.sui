#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "GRAFIK" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Grafik" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Tilpas grafikindstillingerne ved hjælp af præcise forudindstillinger for at skræddersy dit spils visuelle ydeevne efter egen smag."

	key[]: "apply"
	val[]: "Anvend" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Skrivebordstema" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "SKÆRM" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "BILLEDKVALITET" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEKSTURER" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "REFLEKTIONER" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "SKYGGER" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "BELYSNING" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "EFTERBEHANDLING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "MILJØ" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Fuldskærmstilstand" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Lysstyrke / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Opsætning" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Opløsning" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Opdateringshastighed" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "FPS-grænse" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "FPS-grænse i baggrunden" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Standardopdatering" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikal synkronisering" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Strømbesparende (Velegnet til bærbare computere)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "SIMPLE GRAFIK-INDSTILLINGER" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "BRUGERDEFINEREDE INDSTILLINGER ANVENDT" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "AVANCEREDE GRAFIK-INDSTILLINGER" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Enkle/avancerede grafikindstillinger" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Skjul avancerede indstillinger" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Vis avancerede indstillinger" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Skalering" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Anti-aliasing" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA luma-skærpning" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA-tuning" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Fleksibel klarhed" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Altid blød" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Altid skarp" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Kvalitet af skærmens okklusion (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "High dynamic range (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Skarphedsdybde (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Solstråler" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Farvekorrektion" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Reflektions-skalering" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Refleksioners detaljegrad" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Vegetationens detaljegrad" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Græs-tæthed" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Skyggekvalitet"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Skygger - teksturstørrelse" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Fjerne skygger" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Indvendige skygger" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Vejrkvalitet"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Spejlkvalitet" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Spejlopløsning" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Syns-afstand i spejl" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Teksturkvalitet" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anisotropisk filtrering" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normale kort" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Trafikforlygter" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Sekundære lys på køretøjer" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Lys synlighedslængde" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Fodgængere" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Skærmindstillingerne er blevet ændret.<br>Ønsker du at beholde disse indstillinger?"

	key[]: "reverting_in"
	val[]: "Gendanner i" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "sekunder" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Når aktiveret vil spillet vises i fuld skærm."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Tilpas spillets generelle lysstyrke efter dit display. På HDR-kompatilble displays vil muligheden for at kalibrere HDR også være tilgængelig her."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Ændrer spillets opløsning."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Ændrer målets opdateringshastighed i spillet."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Matcher billedhastigheden med skærmens opdateringshastighed for at forhindre skærmrivning. Den økonomiske indstilling halverer også billedhastigheden, hvilket resulterer i et lavere strømforbrug."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Indstiller den maksimalt tilladte frame rate for spillet.<br><br>Sættes værdien til 0, bliver funktionen deaktiveret."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Indstiller den maksimalt tilladte frame rate for spillet, når det er minimeret i baggrunden.<br><br>Sættes værdien til 0, bliver funktionen deaktiveret."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Skifter mellem simple grafikindstillinger (forudindstillinger) og avancerede grafikindstillinger (med mulighed for at ændre individuelle parametre)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Forbedrer den grafiske nøjagtighed ved at beregne spillets grafik ved højere opløsning internt, hvilket reducerer hakkede kanter og forbedrer detaljer.<br>For eksempel resulterer det i et tydeligere og mindre udvisket billede, hvis en højere skalering vælges. Dette giver spillet et bedre udseende på bekostning af ydeevnen.<br><br><color value=@@clr_txt_d@@>Denne indstilling påvirker ofte ydeevnen markant."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Udvalg af antialiasing-metoder med høj hastighed, der udjævner udseendet af takkede kanter i spillet:<br>- SMAA sampler hver pixel flere gange (afhængigt af den valgte kvalitet) på forskellige steder inden for rammen og tager gennemsnittet af prøverne for at producere det endelige billede.<br>- TAA sampler hver pixel kun én gang pr. frame, men den sampler dem på forskellige steder og forskellige frames.<br>- For det bedste resultat kan du også vælge en kombination af begge på bekostning af ydeevnen.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt moderat indvirkning på ydeevnen."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Tilføjer bløde skygger til sprækker og objekter, der er i nærheden af hinanden, hvilket forbedrer den opfattede grafiske nøjagtighed i hele spillets verden.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Valg af TAA forudindstillinger:<br>- \"Altid blød\" vil resultere i mindre flimren/mere udglatning - denne indstilling er passende for PC-brugere, som benytter supersampling eller har en monitor med høj DPI, men også for 1080p fjernsynsbrugere, som sidder længere væk fra skærmen.<br>- \"Altid skarp\" resulterer i mere flimren/mindre udglatning - det er nok den bedste valgmulighed for brug under 1080p såsom laptops eller steam decks.<br>- \"Fleksibel klarhed\" deaktiverer dynamisk TAA-rysten, når kameraet er statisk.<br><br><color value=@@clr_txt_d@@>Denne indstilling kan kun benyttes, hvis TAA er valgt som anti-aliasing."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer styrken af TAA's luma-skarphed.<br><br><color value=@@clr_txt_d@@>Denne indstilling kan kun bruges, når TAA er valgt som en anti-aliasing-løsning."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Når aktiveret kan fjerne områder på kortet blive kunstigt udtonet for at skabe et realistisk tab af fokus i baggrunden."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Når aktiveret vil solstråler kunne ses, når man ser mod solen eller på den gennem objekter såsom træer, bygninger eller køretøjer."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Når aktiveret vil spillets farver blive dynamisk tilpasset ud fra æstetiske hensyn. Scener vil passe bedre til tidspunktet på dagen og vejrforholdene, farverne på køretøjer og andre objekter kan være mere levende osv."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Forbedrer refleksioner ved at gengive dem i en højere kvalitet internt, samt ved at bruge bedre antialiasing.<br><br><color value=@@clr_txt_d@@>Ændringer af denne indstilling træder først i kraft efter en manuel genstart af spillet."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer detaljerne i refleksioner set på køretøjers overflader, vinduer og andre reflekterende overflader såsom vandpytter, våde veje og åbne vandmasser.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen.<br><br>Ændringer af denne indstilling træder først i kraft efter en manuel genstart af spillet."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer detaljerne og kompleksiteten af planter og træer.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer tætheden af græsset, der ses i vejkanterne.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer kvaliteten af skygger kastet af solen eller månen.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Gør det muligt at gengive skygger, selv fra meget fjerne objekter.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer dynamiske skygger i køretøjets interiør om natten.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Tilpasser kvaliteten af vejreffekter såsom spejlinger."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer kvaliteten af refleksioner set i bilens spejle (uafhængigt af refleksionsindstillinger).<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Tilpasser opløsningen af billedet, som vises i dit køretøjs spejle."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer den afstand, hvor objekter begynder at gengives i spejlet.<br><br><color value=@@clr_txt_d@@>Denne indstilling har ofte stor indflydelse på ydeevnen."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Tilpasser kvaliteten af nogle teksturer på objekter og overflader i spillet."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Forbedrer skarpheden af teksturer, især dem set på afstand eller i en skrå vinkel.<br><br><color value=@@clr_txt_d@@>Ændringer af denne indstilling træder først i kraft efter en manuel genstart af spillet."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Tilføjer geometriske detaljer til fortove, veje og andre objekter for at forbedre deres udseende.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen.<br><br>Ændringer af denne indstilling træder først i kraft efter en manuel genstart af spillet."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer oplysning fra forlygter på andre køretøjer i trafikken."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Aktiverer oplysning fra sekundære lyskilder på andre køretøjer i trafikken, såsom fra blinklys, bremselys osv."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Justerer afstanden, hvorfra kunstige lyskilder kan ses.<br><br><color value=@@clr_txt_d@@>Denne indstilling har normalt en moderat indflydelse på ydeevnen."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Viser fodgængere i spillet."
#@}

