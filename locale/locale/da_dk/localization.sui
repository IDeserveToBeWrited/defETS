#+ Strings related to Steam inventory feature.
#@{
	key[]: "inventory_loading_failed_content"
	val[]: "Der opstod en fejl ved indlæsning af indholdet fra Steam.<br><br>$ERROR$<br><br>Vælg fortsæt for at beholde indholdet aktivt. Spillet vil søge efter indholdet med jævne mellemrum.<br><br>Du kan midlertidigt deaktivere indholdet for at holde fjerne fejlmeddelelser som denne. Spillet genaktiverer indholdet automatisk næste gang du kører det." #+ The error message showed in truck configurator screen when Steam inventory content is not present due to loading error. The $ERROR$ must be keeped untranslated.

	key[]: "inventory_loading_request_failed_content"
	val[]: "Kunne ikke hente Steam-indhold." #+ The error message showed in truck configurator screen when game fails to send Steam inventory request.

	key[]: "inventory_wait_t"
	val[]: "STEAM-INDHOLD" #+ Title of the inventory wait dialog.

	key[]: "inventory_wait_msg"
	val[]: "Indlæser Steam-indhold..." #+ Message describing why player has to wait for inventory items to be loaded.

	key[]: "new_inventory_items_t"
	val[]: "NYT INDHOLD" #+ Title of the window displaying list of the new inventory items.

	key[]: "new_inventory_items_help"
	val[]: "Der er blevet registreret nyt Steam-indhold." #+ The help text for new inventory items dialog.

	key[]: "vehicle_accessory"
	val[]: "Lastbiltilbehør" #+ Name of the inventory items category.

	key[]: "cabin_accessory"
	val[]: "Kabinetilbehør" #+ Name of the inventory items category.

	key[]: "desktop_background"
	val[]: "Skrivebord baggrund" #+ Name of the inventory items category.

	key[]: "item_paint_job"
	val[]: "Maling" #+ Name of the inventory items category.

	key[]: "disable_broken_inventory"
	val[]: "Deaktiver indhold" #+ The button disabling inventory due to an error.

	key[]: "try_again_later_btn"
	val[]: "Prøv igen senere" #+ The button continuing the flow of the game even if inventory failed to load - it will be loaded again when game will need it's data.

	key[]: "inventory_items_sold_t"
	val[]: "STEAM-INDHOLD" #+ The title of the dialog showed when user sells or trades some inventory item.

	key[]: "inventory_items_sold_text"
	val[]: "Nogle ting er blevet fjernet fra dit Steam-indhold. Du vil ikke længere kunne købe dem på værkstedet.<br><br>Dette påvirker ikke dine installerede dele." #+ The text showed in the dialog displayed when user sells or trades some inventory item.
#@}


