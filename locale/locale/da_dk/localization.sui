#+ Used truck dealer wear explanation
#@{
	key[]: "used_truck_dealer_explanation_t"
	val[]: "OVERBLIK OVER LASTBILS-TILSTAND" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "used_truck_dealer_explanation_state"
	val[]: "Tilstand" #+ Caption of state section.

	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Køretøjet har alvorlige mekaniske problemer, som påvirker dets ydeevne og stabilitet. Du kan være nødt til at overveje en komplet restaurering eller udskiftning af flere dele." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "Køretøjet har mekaniske problemer, som kan påvirke dets ydeevne og stabilitet. Reparation er nødvendig." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Køretøjet kan bruges, men kan have mindre problemer. Det anbefales at reparere." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Køretøjet er i solid stand med kun mindre slid." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
	val[]: "Køretøjet er i fremragende stand med minimalt slid." #+ Explanation of 5-star state.

	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Vedligeholdelse" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "Viser systemisk ældning og tiltagende slid på hele køretøjet. Dette ordnes ved en komplet restaurering." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Slid på dele" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
	val[]: "Kørsel og uheld fører til slid på forskellige dele. Overvåg deres tilstand og udskift dem hvis nødvendigt." #+ Explanation unfixable wear.
#@}

