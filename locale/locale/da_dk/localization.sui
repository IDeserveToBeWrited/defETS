	key[]: "cargo_market_t"
	val[]: "LASTCENTER"

	key[]: "cargo_market"
	val[]: "Lastcenter"

	key[]: "cargo_market_desc"
	val[]: "Lever et bredt udvalg af fragt til deres destinationer. Du behøver en lastbil og en trailer. Du behøver ikke være online." #+ The description of an Cargo Planner icon, used to open a window for selecting cargo with owned trailer.

	key[]: "trailerman_title"
	val[]: "MINE TRAILERE"

	key[]: "trailerman_link_title"
	val[]: "Trailer manager"

	key[]: "trailerman_notice_t"
	val[]: "TRAILERMANAGER"

	key[]: "trailerman_help"
	val[]: "Administrer dine firmatrailere, tildel dem til dine chauffører, køb dem, byt dem og meget mere."

	key[]: "trailerman_summary_hint"
	val[]: "Vælg en trailer fra højre side for at se flere detaljer"

	key[]: "trailerman_tut_utilization"
	val[]: "Procent af daglige trailerudnyttelse i den nuværende økonomistatistik. Det er baseret på antal timer om dagen traileren er brugt af dine chauffører. Grafen opdateres i starten på en ny dag. Højere % -værdier indikerer en større efterspørgsel efter en bestemt trailertype i dens garage." #+ The utilization graph hint text.

	key[]: "trailerman_tut_overview"
	val[]: "Alle dine købte trailere er listet og bliver styret herfra - Trailer manager grænsefladen.<br><br>Dine chauffører tildeles automatisk trailere, som er gemt i samme garage, og vil begynde at udnytte alle tilgængelige trailere til deres leverancer.<br><br>Sæt en traileranvendelse til Privat for at begrænse brugen til dig selv og sæt den Offentlig for at gøre traileren tilgængelig for alle dine chauffører for yderligere at øge din garages økonomi." #+ The text shown in trailer manager overview tutorial box.

	key[]: "trailer_config"
