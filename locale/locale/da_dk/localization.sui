#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Udvalg af temaer som vises i baggrunden, når du bladrer gennem menuen."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverer valg af tilfældigt baggrundstema hver gang du starter spillet."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Indstiller forsinkelsen på, hvornår elementer på skrivebordet fader ud."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret vil du opleve effekterne af udmattelse over tid.<br><br>Hvis du ikke holder pauser, resulterer det i trafikforseelser."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Når det er aktiveret, skal du overholde færdselsreglerne, ellers risikerer du at få færdselsforseelser. Risikoen er forhøjet i nærheden af politibiler, radar og trafikkameraer."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Tilpasser den gennemsnitlige længde på tilbudte jobs."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Vælg hvilken hastighedsgrænse som vises på navigations-widgeten."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Den nuværende hastighed på navigationen skifter til rød, når hastighedsgrænsen overskrides."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Når du når din destination, vises en widget med dialog, hvor du vil kunne springe parkering over."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Hold alle widgets skjult."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Hold begge HUD-spejle skjulte."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Hold alle notifikationer skjult, selv når de modtages."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Viser et vindue med specifikationerne for spillerens nuværende lastbil, inden et job med tung last accepteres."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Vælg, hvordan verdenskortet er justeret."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Vælg hvordan kortet udforskes:<br>- \"Nærhedsudforskning\" markerer et større område som udforsket.<br>- \"Præcisionsudforskning\" afslører kun områderne i spillerens umiddelbare nærhed."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Vælg hvordan navigationen skal vises"

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer, hvordan navigationen rutes:<br>- \"Bedste\" navigationstilstand vælger det mest effektive forhold mellem rutens længde og tid, forsøger at undgå kryds med trafiklys osv.<br>- \"Korteste\" navigationstilstand vælger altid den kortest mulige rute.<br>- Navigationstilstanden \"Små veje\" vælger at undgå motorveje, hvor det er muligt."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Skift sværhedsgraden for din parkering:<br>- \"Vælg altid\" giver dig mulighed for at vælge, når du når destinationen.<br>- \"Sikker parkering\" kræver ikke, at man bakker.<br>- \"Øvet parkering\" kræver oftest en mere udfordrende manøvre, som involverer, at du bakker."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Tilpasser sandsynligheden for at møde forhindringer på vejen, heriblandt ulykker, havarerede køretøjer, affald på vejen osv."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Tilpasser sandsynligheden for at møde en forhindring, som kræver ændring af den planlagte rute, når et job udføres."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Tilpasser sandsynligheden for barskt vejr."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg om information om tidszone skal vises sammen med aktuel tid."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Slå mellemsekvenser, som typisk vises efter større køb, forbedringer, eller når passagerer står på eller af, til eller fra."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg om halvgennemsigtige blokeringer skal vises ved veje, som ikke kan tilgås."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Spejler musens Y-akse, når kameraet benyttes i spillet."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Vælger gearkassetype:<br>- \"Simpelt automatgear\" tillader brugen af speeder og bremse for at kontrollere bevægelse fremad og bagud.<br>- \"Ægte automatgear\" kræver et input for at skifte mellem fremadgående gear og bakgear.<br>- \"Sekventiel\" kræver manuelt skifte af alle gear med gear op/ned-input.<br>- \"H-skifter\" kræver brugen af en controller med skifteporte for at skifte gear manuelt."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Vælges denne valgmulighed tillades \"springende gearskifte\" - at springe gear over, når det er nødvendigt eller praktisk at undgå at skifte gennem hvert gear i gearkassen."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Bringer rattet tilbage til midten, når et tastatur eller en controller bruges.<br><br>Hvis du deaktiverer denne funktion, skal du manuelt styre tilbage til midten efter et sving."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Tilpasser rækkevidden af rat-animationen. "

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer bremsernes styrke."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer køretøjets stabilitet ved at sænke dets tyngdepunkt."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer trailerens stabilitet ved at sænke dens tyngdepunkt."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer drejningsmomentets styrke genereret af drivlinjen.<br><br>Hæves denne indstilling, gøres følelsen af, at køretøjet trækker til højre, stærkere."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer stivheden af chassisets affjedring."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer stivheden af kabinens/sleeperens affjedring."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Tilpasser styrken af proceduremæssigt genererede overfladeujævnheder for at give veje og andet terræn en ufuldkommen følelse.<br><br>Alt efter anden affjedring og kameraindstillinger kan den opfattede effekt være mere eller mindre tydelig."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer avanceret kobling, som kræver større præcision for at flugte lastbilens femte hjul med trailerens king pin.<br><br>Hvis slået fra bliver det meget lettere at tilkoble en trailer, da der ikke vil være nogen kollision mellem king pin'en og det femte hjul."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Vælger om og hvilke trailerkabler er animerede.<br><br><color value=@@clr_txt_d@@>Aktivering af kabler på flere køretøjer kan påvirke ydeevnen på ældre systemer."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Aktiverer lastbilens elektroniske hastighedsbegrænser på 90 km/t (56 mph).<br><br><color value=@@clr_txt_d@@>World of Trucks-job har denne funktion permanent slået til."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Hvis aktiveret og vinduesviskerne er sat i første position, vil viskerne automatisk slås til og tilpasse deres hastighed efter omstændighederne."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Muliggør automatisk aktivering af retarder, når der bremses."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis slået til, vil køretøjet hjælpe med starten på en stigning ved at holde bremserne og sikre en blød start."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Muliggør automatisk aktivering af motorbremse, når der bremses."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis valgt, starter motoren, så snart speederen aktiveres."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis valgt, vil køretøjets håndbremse være trukket som standard (efter at have benyttet en færge, være trukket til en servicestation, hurtig-rejser osv.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer automatisk løftaksler når nødvendigt ud fra køretøjets vægt."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis slået til, vil køretøjet som standard give mindre gas. Efter hurtigt at trykke på gasknappen to gange, vil køretøjet give fuld gas, indtil knappen løsnes.<br><br>Dette berører kun tastatur-input."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simulerer lufttab i det virkelige liv fra overdrevne bremseanvendelser.<br><br>Når det er aktiveret, bliver du nødt til at styre dit lufttryk, når du går ned ad bakker eller laver langsomme manøvrer med flere bremseanvendelser."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis fravalgt vil brændstofforbruget ikke påvirkes af kørestil eller vejenes tilstand.<br><br>Hvis valgt vil brændstofforbruget være påvirket af mange faktorer såsom kørestil, fragtvægt, rullemodstand og terræn. Det vil ikke længere være påvirket af @@skill_mechanical_title@@-evnen."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis slået til, vil ABS forhindre, at hjulene låses, så kontrollen med lastbilen bevares og bremsninger forbedres."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Hvis slået til, vil køretøjet benytte individuel bremsning for de enkelte hjul for at forhindre hjulspin samt understyring/overstyring, så kontrollen bevares."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Når den er aktiveret, låser køretøjet differentialet, for at forbedre trækkraften hvis hjulene begynder at glide."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer den hastighed, hvormed fartpiloten øges eller mindskes, når den relevante knap trykkes på."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer fartpilotens tolerance, når det kommer til at fastholde målhastigheden."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Fartpiloten vil automatisk tilpasse hastigheden for at fastholde en sikker afstand til forankørende køretøjer."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer nødbremsning hvis systemet registrerer en nært forestående kollision.<br>Vælg om systemet kun skal reagere på køretøjer eller på alle forhindringer."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Udvalg af indstillinger for vognbaneassistenten:<br>- \"Advarsel ved forladelse af vognbane\" advarer dig med lyd, hvis du er ved at forlade vognbanen.<br>- Ud over lyden, vil \"Vognbane-understøttelse\" også automatisk styre dit køretøj, så det holder vognbanen.<br><br>Begge valg er kun aktive ved hastigheder over 55 km/t (~35 mph).<br>Vognbaneassistenten tager også hensyn til din brug af blinklys, inden den aktiverer."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer blindvinkelsensorens funktioner, hvis dit køretøj er udstyret med det."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret og forlygterne er sat i første position, vil de automatisk tændes i situationer med svagt lys."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Hvis slået til, og forlygterne er sat til langt lys, vil de automatisk dæmpes, når køretøjet registrerer modkørende eller køretøjer tæt på."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret vil blinklysene automatisk slukke efter et sving, når rattet drejes tilbage til midterposition."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret vil nogle kabinedekorationer (hængende dekorationer, bobbleheads osv.) reagere på lastbilens fysiske bevægelser."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktiverer yaw på kabinekameraet baseret på styringsinput."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer hvor meget \"Brug ratkamera\"-funktionen reagerer på styringsinput. "

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer hvordan \"Brug ratkamera\"-funktionen opfører sig, når der bakkes."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Kabinekameraet ser til venstre eller højre når man bruger blinklysene."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Når aktiveret vil kabinekameraet reagere på lastbilens bevægelser."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Ændrer hvor meget kabinekameraet reagerer på lastbilens bevægelser."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Når aktiveret har kabinekameraet lov til at følge lastbilens bevægelser."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Indstiller forsinkelsen før kameraet automatisk centreret.<br><br>Køretøjet må bevæge sig ved en ikke ubetydelig hastighed for at dette aktiveres. Gælder kun internt samt følgekamera ved normal kørsel og kameraet når man læner sig ud ved baglænskørsel."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Indstiller hastigheden for kameraets bevægelser. Bruges ved automatisk centrering af kameraet, samt når der skiftes mellem forudindstillinger for kabinekameraet."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Bestemmer, hvordan den indvendige zoom fungerer: hold knappen nede for at zoome midlertidigt, eller tryk én gang for at slå den til/fra." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Vælger hvilket sprog som skal benyttes i spillet."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Ændrer forvalg af mønt- og måleenheder baseret på den valgte region."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Hvis valgt, vil by- og landenavne vises på dit valgte sprog."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Hvis valgt, vil by- og landenavne vises på både dit valgte sprog samt det lokale sprog for den region af kortet."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg hvilken møntenhed, som skal bruges."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg mellem 12- og 24-timers ur."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg hvilken afstandsenhed, som vises."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg hvilken enhed for masse, som vises."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Ændrer hvilken temperaturenhed, som vises."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg hvilke trykenheder der skal vises."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Ændrer hvilken rumfangsenhed, som vises."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vælg hvilke forbrugsenheder der skal vises."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret vil brug af \"Aktiver\"-knappen (@@imv_nrm_activate@@) åbne chatten i konvoj-sessioner."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret vil chattens inputbjælke forblive aktiv efter, at en besked er sendt."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Nar aktiveret vil chatbeskeder fade ud adskillige sekunder efter hver besked."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Ændrer hvor lang tid chatbeskeder vises, inden de fader ud."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Når aktiveret vil spillernes navne blive vist over deres køretøjer i konvoj-sessioner."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Åbner en avanceret menu, hvor hurtigsvar kan konfigureres til brug i chatten i konvoj-sessioner."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Tjek status for dit World of Trucks-forbundne indhold."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Muliggør download af onlinenyheder til visning på startskærmen."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Muliggør download af fællesskabets skærmbilleder fra World of Trucks-websiden til brug som loadingskærme."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Muliggør download af virkelige reklamer til brug på spillets reklametavler."
#@}

