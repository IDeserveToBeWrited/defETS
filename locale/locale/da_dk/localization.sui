#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Fortsæt ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Velkommen til Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Endelig har du mulighed for at prøve dit drømmejob - at køre lastbil!"

	key[]: "intro_3"
	val[]: "Dit transportfirma er nu oppe at køre, men desværre har du ikke råd til købe din egen lastbil. Foreløbigt bliver du nødt at søge arbejde hos andre firmaer."

	key[]: "intro_4"
	val[]: "Din opgave er at sikkert levere en ladning $JOB_CARGO$ til $JOB_TARGET_COMPANY$ varelevering i $JOB_TARGET_CITY$. Din arbejdsgiver har stillet et køretøj til rådighed og betaler alle udgifter. Sørg for ikke at skuffe nogen og lever til tiden."


	key[]: "intro_garage_1"
	val[]: "Dette er dit hovedkvarter."

	key[]: "intro_garage_2"
	val[]: "Det er en ret enkel garage. Den ser ikke ud af meget, men vi skal alle begynde et sted."

	key[]: "intro_garage_3"
	val[]: "Desværre har du ikke noget du kan parkere der endnu, så der er ingen lastbil at se."

	key[]: "intro_garage_4"
	val[]: "Når du har tjent penge nok og har købt en lastbil, kan du bevæge dig frit rundt og styre dit eget firma herfra."

	key[]: "intro_garage_5"
	val[]: "Held og lykke!"


	key[]: "desktop_tut_t"
	val[]: "FUNKTION LÅST OP"

	key[]: "desktop_tut_job"
	val[]: "Vælg dit næste job"

	key[]: "desktop_tut_cargo_market"
	val[]: "Brug din helt nye trailer til at få adgang til Last Markedet, hvor du kan levere et bredt udvalg af gods til deres destinationer." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Her kan du følge dine fremskridt."

	key[]: "desktop_tut_company"
	val[]: "Hold styr på dine garager, hyr nye chauffører og kør dit firma herfra."

	key[]: "desktop_tut_trailers"
	val[]: "Fra nu af kan du købe dine egne trailere og opgradere samt male dem, så de matcher din lastbil.<br><br>Dine trailere kan opbevares i din(e) valgte garage(r). De kan bruges af dine ansatte chauffører til at øge overskuddet. For at administrere dine trailere skal du bruge trailer manageren."

	key[]: "desktop_tut_visit_directive"
	val[]: "Besøg $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "VELKOMMEN"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Velkommen til den nye startskærm<br>Herfra kan du tilgå alle funktioner i spillet."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Nedenfor giver hovedmenuen direkte adgang til alle spillets grundfunktioner, som du kender dem."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Øverst giver den nye statusbjælke konstant synlighed for nyttige statistikker fra spillerprofilen samt info om lokale rejseforhold."

	key[]: "desktop_tut_tour_home"
	val[]: "Hjem-knappen er der altid, så du kan vende tilbage til startskærmen."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "En permanent hurtigmenu giver handy genveje til alle spillets funktioner fra enhver skærm."

	key[]: "desktop_tut_tour_drive"
	val[]: "Den opdaterede Kør-knap forbliver din forbindelse til spillets verden og er klar til at føre dig af sted til vejene."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "TUTORIAL AFSLUTTET"

	key[]: "desktop_tut_tour_finish"
	val[]: "Tak for at gennemse vores startskærms-opdatering."
#@}


	key[]: "show_help"
	val[]: "Slå hjælp til eller fra"

