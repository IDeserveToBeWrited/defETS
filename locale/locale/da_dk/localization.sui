	val[]: "Du har ingen ulæste beskeder" #+ Shown in message preview panel if no message is selected and no unread message exists.

	key[]: "mail_new_mail"
	val[]: "Du har $COUNT$ ulæst(e) besked(er)" #+ Shown in message preview panel if there are unread messages. The $COUNT$ is replaced with number of messages. For example "You have 1 unread message(s)"
#@}


