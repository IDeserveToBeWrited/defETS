	key[]: "eye_extended_view_op_tooltip"
	val[]: "Aktiverer den udvidede visning, som øger din synsvinkel ved at bruge hoved- og/eller øjenbevægelser til at styre kameraet i spillet."

	key[]: "eye_preset_op_tooltip"
	val[]: "Valg af forudindstillingerne for udvidet visning."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Valg af hovedsporingstilstande:<br>- I \"Direkte\"-tilstanden svarer dit hovedrotation direkte til en kamerarotation i spillet. Det anbefales i normale cockpit-/kabinesituationer.<br>- I tilstanden \"Dynamisk\" vil dit blik kun påvirke dit kamera i spillet, når du faktisk drejer dit hoved. Det anbefales, når det er vigtigt for dit syn at være absolut centreret."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Når det er aktiveret, vil in-game-kameraet løbende langsomt opdateres, når du ændrer dit hoveds naturlige position under leg."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Når det er aktiveret, påvirker dit hoveds position kamerapositionen i spillet."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Når det er aktiveret, vil kameraet i spillet vippe tilsvarende, når du vipper dit hoved til begge sider."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Multiplicerer den kombinerede hoved- og stirre rotation i vandret retning (i kabinen)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Multiplicerer den kombinerede hoved- og stirre rotation i lodret retning (i kabinen)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Multiplicerer den kombinerede hoved- og stirre rotation i vandret retning (i gå mode)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Multiplicerer den kombinerede hoved- og stirre rotation i lodret retning (i gå mode)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Justerer, hvor hurtigt kameraet i spillet vil reagere på dine blikbevægelser."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Justerer, hvor gradvist hastigheden stiger."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Justerer afstanden fra midten af skærmen, hvor accelerationen begynder at udjævnes."

	key[]: "eye_gaze_start_point_op_tooltip"
	val[]: "Justerer, hvor langt fra midten af skærmen, du skal se, før kameraet i spillet begynder at bevæge sig."

	key[]: "eye_gaze_end_point_op_tooltip"
	val[]: "Justerer, hvor langt fra midten af skærmen du skal kigge for at nå maksimal kamerahastighed."

	key[]: "eye_gaze_max_angle_op_tooltip"
	val[]: "Bestemmer, hvor langt kameraet kan dreje, når du ser til kanterne af skærmen."

	key[]: "eye_head_view_responsiveness_op_tooltip"
	val[]: "Justerer, hvor hurtigt kameraet i spillet vil reagere på dine hovedbevægelser."

	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Justerer, hvor meget kameraet i spillet vil dreje til venstre eller højre sammenlignet med, hvor meget du drejer dit hoved (i kabinen)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Justerer, hvor meget kameraet i spillet vil skrue op eller ned i forhold til, hvor meget du drejer hovedet (i kabinen)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
	val[]: "Justerer, hvor meget in-game-kameraet vil dreje til venstre eller højre sammenlignet med, hvor meget du drejer dit hoved (i gå-tilstand)."

	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Justerer, hvor meget kameraet i spillet vil skrue op eller ned i forhold til, hvor meget du drejer dit hoved (i gangtilstand)."

	key[]: "eye_head_exponent_op_tooltip"
	val[]: "Justerer, hvor gradvist hastigheden stiger."

	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Justerer, hvor meget du skal dreje hovedet, før accelerationen begynder at udjævne sig."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Justerer, hvor meget du skal dreje dit hoved fra midterpositionen, før kameraet i spillet begynder at bevæge sig."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Justerer, hvor meget du skal dreje dit hoved fra midterpositionen for at nå maksimal kamerarotation."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Valg af autopause-tilstande."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Justerer mængden af tid i millisekunder, før spillet automatisk stopper, når det ikke kan registrere dit blik."

	key[]: "o_im_head_reset_op_tooltip"
	val[]: "Tildeler knap, der indstiller din nuværende hovedposition som den nye standardposition, og centrerer kameraet i spillet i overensstemmelse hermed."

	key[]: "o_im_eye_pause_op_tooltip"
	val[]: "Tildeler knap, der slår alle Tobii Extended View-funktionerne til/fra."

	key[]: "o_im_eye_config_op_tooltip"
	val[]: "Tildeler knap, der åbner indstillingerne for øjensporing."

	key[]: "o_im_headtrack_enable_op_tooltip"
	val[]: "Tildeler knap, der aktiverer hovedsporing."

	key[]: "o_im_eye_preset_1_op_tooltip"
	val[]: "Tildeler knap til at anvende den respektive forudindstilling for udvidet visning."

	key[]: "o_im_eye_preset_2_op_tooltip"
	val[]: "Tildeler knap til at anvende den respektive forudindstilling for udvidet visning."

	key[]: "o_im_eye_preset_3_op_tooltip"
	val[]: "Tildeler knap til at anvende den respektive forudindstilling for udvidet visning."
