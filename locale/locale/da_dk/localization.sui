	key[]: "cam_horizon_lock_factor"
	val[]: "Horisont-låsefaktor for kabinekamera" #+ Slider for interior camera horizon locking.

	key[]: "cam_auto_center_delay"
	val[]: "Forsinkelse på automatisk kameracentrering" #+ Dropdown for camera auto centering delay.

	key[]: "cam_auto_move_speed"
