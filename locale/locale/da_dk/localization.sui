	val[]: "FÆLLESSKAB"

	key[]: "weblinks_but"
	val[]: "Fællesskab"

	key[]: "weblink_game"
	val[]: "Euro Truck Simulator 2 på nettet"

	key[]: "weblink_scs"
	val[]: "SCS Software hjemmeside"

	key[]: "weblink_blog"
	val[]: "Blog SCS Software"

	key[]: "weblink_facebook"
	val[]: "Facebook Euro Truck Simulator 2"

	key[]: "weblink_wotr"
	val[]: "World of Trucks"

	key[]: "weblink_forum"
	val[]: "Forum SCS Software"

	key[]: "weblink_instagram"
	val[]: "Instagram SCS Software"

	key[]: "weblink_twitter"
	val[]: "X SCS Software"

	key[]: "weblink_tiktok"
	val[]: "TikTok SCS Software"

	key[]: "weblink_confirm"
	val[]: "Ønsker du at åbne en internetbrowser og besøge den valgte hjemmeside?"

#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Netværk ikke tilgængeligt. Tjek venligst at klientkonfigurationen er korrekt."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Kunne ikke etablere forbindelse til online-tjenesten.  Kontroller, at din internetforbindelse virker."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Fejl under kommunikation med online-tjenesten. Prøv venligst igen senere."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Ukorrekte oplysninger kom tilbage fra online-tjenesten. Hvis HTTP-proxy er i brug, skal du kontrollere dens konfiguration. Ellers prøv igen senere."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Ukorrekte oplysninger kom tilbage fra online-tjenesten. Prøv venligst igen senere."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Denne service er ikke kompatibel med den nuværende version af spillet. Kontroller venligst om der findes en ny patch til spillet."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Servicen er ikke tilgængelig i øjeblikket. Prøv venligst igen senere."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Servicen er i øjeblikket nede pga. vedligeholdelse. Prøv venligst igen senere."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Din information er ikke godkendt. Prøv at logge ind igen."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Denne onlinekonto er spærret på grund af for mange forkerte forsøg på at logge ind. Prøv igen om en halv time."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Denne onlinekonto er lukket på grund af mistanke om misbrug. Prøv igen om 24 timer."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Dette spil er ikke registreret til denne onlinekonto."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Din konto er ikke aktiveret endnu. Se i din indbakke om du har modtaget en aktiveringsmail."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Kontoen er spærret. Kontakt venligst vores tekniske support."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Kontoen er spærret. Kontakt venligst vores tekniske support."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Proxy-godkendelse er ikke understøttet af spillet. Brug venligst en anden proxy eller direkte tilslutning."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Objektet er ikke tilgængeligt på nuværende tidspunkt. Prøv venligst igen om et par minutter. "

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "SSL-fejl. Der kunne ikke oprettes en sikker forbindelse."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Spillet blev afbrudt under onlinekommunikationen. Prøv igen senere."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Intern fejl. Du kan læse om fejlen i net.log filen."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 er stødt på et problem. Spillet kunne ikke finde en gyldig grafikenhed på din computer.\nForeslåede løsningstrin:\n1. Tjek om din computer og dit grafikkort lever op til spillets minimumskrav.\n2. Opdatér din udgave af Microsoft DirectX til den nyeste version.\n3. Hent og indstallér de nyeste drivere til dit grafikkort fra udbyderens hjemmeside - en eller flere af dine gamle drivere er måske forældede.\n4. Prøv at skifte visningsmetode fra OpenGL til DirectX eller omvendt.\n5. Slet spillets konfigurationsfil 'config.cfg', der ligger under 'Dokumenter' i mappen 'Euro Truck Simulator 2'. Den kan muligvis være beskadiget.\nFilen vil automatisk gendanne sig selv med korrekte standardværdier næste gang, du starter spillet."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 har problemer med at rendere grafikken på din computer (Intet gyldigt grafikkort fundet)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "INPUTGUIDE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Næste"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Slut denne guide"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Skip guide"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Inputguide"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Vil du afbryde inputguiden?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "VÆLG STYREMETODE" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Styreenheder"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Guiden vil vælge anbefalede instillinger ud fra de forbundne enheder.<br><color value=@@clr_sel@@>Hvis du bruger et Steam-kompatibelt gamepad, bør du overveje at slå konfigurationssupport til i <br><color value=@@clr_txt_d@@> \"Steam > Indstillinger > Controller > Generelle Controller-indstillinger\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Kør ved hjælp tastaturet og kig dig omkring med musen. Den mest simple og mindst præcise måde at styre på, men tilgængelig for alle."

	key[]: "wiz_control_mouse"
	val[]: "Brug musen til mere nøjagtig styring. Tastaturet bliver brugt til andre handlinger. Musen bliver også brugt til at se dig omkring hvis du samtidig holder knappen til kamerakontrol nede."

	key[]: "wiz_control_controller"
	val[]: "Brug rat, gamepad eller joystick hvis du vil have den mest realistiske oplevelse. Tastaturgenveje kan fortsat bruges til mange handlinger, og du kan se dig omkring med musen. (musekik)."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Der blev ikke fundet nogen styreenheder. Du er nødt til at tilslutte en for at kunne vælge dette!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Søger efter styreenheder ..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "VÆLG CONTROLLER API" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - In-game Mapping Mode (anbefalet)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Steam Client Mapping Mode"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Klassisk controller"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepads som @@controller_ps5@@, @@controller_xbox_one@@ eller @@controller_steam_deck@@ valgt til Steam Input-interfacet og bruger enkelt layout.<br><br>Understøtter konfigurationer for tastevalg i spillet."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepads valgt til Steam Input-interfacet og bruger enkeltstående layouts konfigureret via Stream-klienten.<br><br>Begrænset understøttelse af tips for knapper samt ingen understøttelse af konfigurationer for tastevalg i spillet."

	key[]: "wiz_api_classical"
	val[]: "Controller, rat eller joystick med DirectInput, XInput eller lignende interface."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "VÆLG CONTROLLER-TYPE"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Rat"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad eller joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Du styrer med et rat eller en lignende controller. Positionen på dit fysiske rat styrer positionen på det virtuelle rat i spillet direkte."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Din styreenhed er en gamepad eller et joystick. Positionen på din styrenhed bestemmer rotationshastigheden på rattet i spillet."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "VÆLG GEARKASSE-TYPE" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Tryk FREMAD for at køre frem og tryk TILBAGE for at bremse eller bakke. Gearkassen styrer automatisk alt andet og håndterer overgange mellem kørsel, bremsning og at bakke såvel som at vælge de passende gear."

	key[]: "wiz_gb_automatic"
	val[]: "Brug knapperne til at skifte mellem at køre frem, tomgang eller at bakke. Tryk så på speederen og lad automatgearet klare gearskiftene."

	key[]: "wiz_gb_sequential"
	val[]: "Skift manuelt gear op og ned for at vælge hvert gear i gearkassen. Denne indstilling giver fuld kontrol over køretøjets gearkasse."

	key[]: "wiz_gb_hshifter"
	val[]: "Vælg det ønskede gear direkte. Dette er den mest realistiske indstilling. En fysisk H-mønster-skifter er anbefalet og kræver signal fra en kobling."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Denne funktion fungerer kun med rat, gamepad eller joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Din hardware understøtter ikke H-gear. Funktionen kan formentlig ikke anvendes."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "VÆLG H-SHIFTER LAYOUT"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Dual-range transmission er det simple valg. Her er gearkassen delt ind i to sæt. Første sæt indeholder 1. til 6. gear, og andet sæt indeholder 7. til 12. gear. Skifte-knappen bruges til at vælge mellem de to sæt, og med gearskifteren vælges et specifikt gear."

	key[]: "wiz_hs_splitter"
	val[]: "Split transmission er et simpelt alternativ. Her er gearkassen også delt ind i to sæt. Første sæt indeholder ulige gear (1, 3, 5 ...), og andet sæt indeholder lige gear (2, 4, 6 ...). Skifte-knappen bruges til at vælge mellem de to sæt, og med gearskifteren vælges et specifikt gear."

	key[]: "wiz_hs_range_splitter"
	val[]: "Range-split transmission er baseret på det rigtige manual range-split system. Gear er grupperet efter fire gear pr hver H-skifter-position og bruger to skifter. Det anbefales således kun for avancerede kørere."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Spillet er nu konfigureret til at bruge standardkonfiguration ud fra din hardware beskrevet herunder. Du kan justere på den ved at vælge avancerede indstillinger eller du kan fortsætte med at spille nu."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Avancerede indstillinger"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Spillet er nu konfigureret, og du kan fortsætte. Du kan ændre konfigurationen senere under Indstillinger."

	key[]: "wiz_cfg_steam"
	val[]: "Du kan kontrollere og konfigurere knapper og akser for denne controller i Steam-klienten. Steams gamepad-indstillinger for spillet finder du i Steam > Bibliotek > Euro Truck Simulator 2 > Egenskaber > Controller."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Åbn controller-indstillinger"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Brug @@imm_wiz_dsteerleft@@ og @@imm_wiz_dsteerright@@ til at styre med."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Flyt musen til venstre eller højre for at dreje rettet i den tilsvarende retning."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Brug @@ima_wiz_j_steer@@ til at styre med."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Brug @@imm_wiz_dforward@@ til at køre fremad og brug @@imm_wiz_dbackward@@ til at bakke."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Bevæg @@ima_wiz_j_throttle@@ frem for at køre fremad og bevæg den tilbage for at bakke."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Brug @@ima_wiz_j_throttle@@ for at køre fremad og brug @@ima_wiz_j_brake@@ for at bakke."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Brug @@imm_wiz_dforward@@ til at accelerere og brug @@imm_wiz_dbackward@@ til at bremse."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Bevæg @@ima_wiz_j_throttle@@ frem for at accelerere og bevæg den tilbage for at bremse."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Brug @@ima_wiz_j_throttle@@ til at accelerere og brug @@ima_wiz_j_brake@@ til at bremse."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Brug @@imv_wiz_gearup@@ til at køre frem og @@imv_wiz_geardown@@ til at køre tilbage."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Brug @@imv_wiz_gearup@@ til at skifte op og @@imv_wiz_geardown@@ til at skifte ned, hvis du bruger tastaturet eller gamepad-knapper. Brug @@imv_wiz_drive@@ og @@imv_wiz_reverse@@ til at vælge kørselsretningen hvis du bruger H-skifter."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Brug @@imv_wiz_gearup@@ og @@imv_wiz_geardown@@ til at vælge det ønskede gear."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Brug din H-skifter sammen med @@ima_wiz_j_clutch@@, når du skal vælge gear."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "INDSTIL CONTROLLER-AKSER" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Visualisering af akser"

	key[]: "wiz_setup_axes_desc"
	val[]: "Du kan afprøve alle din akser og se det. Brug din kontroller og se hvordan en akse flytter sig. Dette viser dig hvor grænserne samt center er på hver akse."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Akse-indstilling"

	key[]: "wiz_setup_axes_desc2"
	val[]: "For at vælge en akse skal du klikke på knappen ved siden af aksenavnet. Dette vil skifte til inputtilstand. Brug derefter din controller til at binde den valgte akse ved at flytte pinden, hjulet eller pedalen til din valgte akse."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Dødzoner"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Dødzonen refererer til et akseområde, der er designet til ikke at give input. Flyt den tilsvarende skyder for at justere dødzonen for en valgt akse. Forøgelse af skyderen til højre vil forstørre dødzonen. Denne funktion er især fordelagtig for ældre controllere, da definering af en større dødzone kan afbøde problemer såsom unøjagtighed eller falsk input forårsaget af hardwareslid."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Aksetilstande"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Aksetilstanden bestemmer, hvordan den håndteres i spillet. Omvendt akse vender sin rapporterede retning, hvilket resulterer i f.eks. at styre venstre i stedet for højre. En centreret akse har sin standardposition i midten af sit område, f.eks. i et joystick. Denne tilstand er nyttig til at korrigere en akse, der er blevet detekteret forkert."

	key[]: "normal"
	val[]: "Normal" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Spejlet" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centreret" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Spejlet og centreret" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "AUTOMATISK GEARKASSE OPSÆTNING" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "Med den automatiske gearkasse har du kun brug for at skifte mellem fremad, frigear og bak. Du kan gøre dette ved at bruge følgende taster og joystick-knapper. For at ændre indstillingerne, klik på en knap og tryk på den tast eller tilhørende joystick-knap som du vil bruge til den pågældende funktion."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Hvis du har tilsluttet hardware, der understøtter H-skifte, kan du simulere en rigtig automatgearkasse. Aktivér denne indstilling og H-skifteren kan sættes til fremad eller bakgear. Alle andre positioner regnes umiddelbart for frigear. Indstillingen fungerer kun med H-skifter og altså ikke med almindelige taster eller gamepad-knapper. Hvis du vil ændre en af dem, skal du klikke på en knap og derefter flytte gearskifteren til den ønskede position og tilbage igen."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "SEKVENTIEL GEARKASSE OPSÆTNING" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Vælger du sekventiel gearkasse, ligger alle gear inklusiv frigear og bakgear i lige rækkefølge. Her bruger du ét sæt taster eller knapper til at skifte hele vejen op eller ned. Du kan selv vælge hvilke ved at trykke på den relevante indstilling og herefter den tast eller knap, du ønsker at bruge."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "H-SHIFTER GEARKASSE OPSÆTNING" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Her kan du konfigurere layoutet for din H-skifter og samtidig afprøve det. På billedet kan du se H-skifterens nuværende position samt hvilket gear, du er i. Siden gearkassen indeholder flere gear, end du har tilgængelig på din H-skifter, skal du trykke på skifte-knappen for at skifte frem og tilbage mellem de forskellige gearsæt."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Den nuværende valgte gearskifterposition og hvilke knapper, der er aktive, vises ved siden af den tilknyttede kontrol. For at udskifte en kontrol skal du klikke på den relevante knap og flytte gearskifteren til den ønskede position og tilbage til neutral."
#@}

