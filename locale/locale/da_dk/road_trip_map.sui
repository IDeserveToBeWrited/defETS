#+ Viewpoint descriptions for Tourist Jobs photo album
#@{
	
	key[]: "at_cut_grossglockner_desc"
	val[]: "Grossglockner, Østrigs højeste bjergtop på 3.798 meter, tårner sig op over Alperne. Bjerget er berømt for sin 48 km lange højalpine vej med 36 hårnålesving samt Pasterze, den længste gletsjer i Østrig og de østlige Alper.<br><br>Sand fra Sahara, der blæses tusindvis af kilometer mod nord, kan til tider farve sneen langs den alpine vej klar gul eller orange."

	key[]: "at_cut_schonbrunn_desc"
	val[]: "Slottet Schönbrunn, en tidligere sommerresidens for habsburgerne, er optaget på UNESCOs verdensarvsliste og er et af Europas fineste barokanlæg.<br><br>Dets zoologiske have, der blev grundlagt i 1752, er verdens ældste zoologiske have i uafbrudt drift."

	key[]: "at_cut_worthersee_desc"
	val[]: "Wörthersee er en turkisblå perle, formet af den sidste istid og kendt for sit klare, mineralrige vand.<br><br>Ifølge sagnet sank en hel by med tilhørende kirke ned i søen, og de lokale fortæller stadig, at man kan høre kirkeklokkerne ringe under vandet."

	key[]: "de_cut_ettal_desc"
	val[]: "Ettal-klosteret er et benediktinerkloster i de bayerske alper, grundlagt i 1330 af kejser Ludvig 4. af Bayern.<br><br>Ifølge sagnet knælede Ludvigs hest tre gange på stedet, hvilket han tolkede som et tegn på, at han skulle opføre klosteret netop dér."

	key[]: "de_cut_stuttgart_city_desc"
	val[]: "Stuttgarts Staatstheater, der er tegnet af arkitekten Max Littmann, åbnede i 1912 som det kongelige hofteater i Kongeriget Württemberg.<br><br>Stuttgart ligger oven på Europas næststørste forekomst af mineralvand, og visse kilder har et så højt naturligt indhold af kulsyre, at et bad i dem føles, som om man ligger i champagne."

	key[]: "de_cut_nurnberg_city_desc"
	val[]: "Nürnberg var en af Det Tysk-romerske Riges vigtigste byer og er stadig berømt for sine usædvanligt omfattende middelalderlige fæstningsværker.<br><br>I 1561 blev skrækslagne indbyggere vidner til et omfattende \"luftslag\" med lysende kugler og kors på himlen, en begivenhed, der blev foreviget i et træsnit, og som i dag betragtes som en tidlig UFO-observation."

	key[]: "de_cut_frankfurt_city_desc"
	val[]: "Frankfurts finansdistrikt, Bankenviertel med tilnavnet \"Mainhattan\" huser hovedkvartererne for mange vigtige banker.<br><br>Frankfurt er hjemsted for en af verdens ældste handelsmesser med rødder tilbage til det 12. århundrede. I dag lægger byen hvert efterår hus til verdens største bogmesse."

	key[]: "de_cut_rostock_desc"
	val[]: "Rostocks plads Neuer Markt, der er omkranset af købmandshuse med gavle i teglstensgotik, har været byens centrale markedsplads siden det 13. århundrede.<br><br>Rostock huser det ældste universitet ved Østersøkysten, som blev grundlagt for mere end 600 år siden, i 1419."

	key[]: "de_cut_duisburg_desc"
	val[]: "Duisburgs rådhus, der stod færdigt i 1902 i en historiserende stil inspireret af den tidlige renæssance, ligger på et sted, hvor der i middelalderen lå et kongeligt palads.<br><br>Duisburg ligger, hvor floderne Rhinen og Ruhr mødes, hvilket gør byens indlandshavn til verdens største flodhavn."

	key[]: "de_cut_kassel_desc"
	val[]: "De første historiske omtaler af Kassel stammer fra år 913 og beskriver et befæstet sted ved en bro over floden.<br><br>Selve navnet er langt ældre og stammer fra den germanske stamme chatterne."

	key[]: "de_cut_berlin_desc"
	val[]: "Berlins Sejrssøjle, der stod færdig i 1873, mindes preussiske militære sejre fra det 19. århundrede og står i parken Tiergarten.<br><br>Søjlen blev i 1938-39 flyttet 1,5 kilometer til sin nuværende placering som led i en omfattende ombygning af byen og fik tilføjet et fjerde led, der gjorde den endnu højere."

	key[]: "de_cut_dresden_desc"
	val[]: "Dresdens barokke Frauenkirche, der stod færdig i 1743 på Neumarkt nær floden Elben, er et af de arkitektoniske vartegn i en by, der kaldes \"Firenze ved Elben\" eller \"det tyske Firenze\".<br><br>I 2009 blev Dresden det første sted i Europa, der fik frataget sin status som UNESCO-verdensarv – en status, byen mistede på grund af opførelsen af en enkelt bro."

	key[]: "ch_cut_geneve_desc"
	val[]: "Springvandet Jet d'Eau i Genève sender søvand op til 140 meter op i luften, tæt på det sted, hvor Rhône-floden løber ud af Genevesøen.<br><br>Siden 1818 har Genève markeret forårets komme ved at holde øje med et bestemt hestekastanjetræ. En embedsmand erklærer sæsonen for indtruffet, når træets første blad folder sig ud – en tradition, der stadig følges i dag."

	key[]: "ch_cut_zurichw_desc"
	val[]: "Zurich West er et tidligere industriområde, der siden 1990'erne er blevet forvandlet til et trendy kvarter med det glasbeklædte Prime Tower som et centralt vartegn.<br><br>Zurich Wests mest markante butik er opført af 19 rustne skibscontainere, der er stablet i ni etagers højde på et tidligere industriareal."

	key[]: "ch_cut_furka_desc"
	val[]: "Furkapasset er et højt bjergpas i 2.429 meters højde, der forbinder kantonerne Uri og Valais i det centrale Schweiz.<br><br>Dets hårnålesving spillede en central rolle i biljagten i filmen Goldfinger fra 1964, og et af svingene har fået tilnavnet \"James Bond Strasse\"."

	key[]: "nl_cut_devlieter_desc"
	val[]: "De Vlieter markerer en del af Afsluitdijk, den 32 kilometer lange dæmning, der afspærrede Zuiderzee og skabte IJsselmeer.<br><br>Tidevandsrenden og de omkringliggende vadehavsområder nær De Vlieter har gennem historien opslugt anslået 500 til 1.000 skibe."

	key[]: "nl_cut_eindhoven_desc"
	val[]: "Eindhoven er en hollandsk by i Nordbrabant, der er kendt som fødestedet og det mangeårige hovedsæde for elektronikgiganten Philips.<br><br>Her begyndte Philips i 1891 at fremstille elpærer, hvilket gav Eindhoven tilnavnet \"Lysets by\"."

	key[]: "nl_cut_groningen_desc"
	val[]: "Groningen er en livlig universitetsby i det nordlige Holland, domineret af det tårnhøje kirketårn Martinitoren.<br><br>De lokale kalder kærligt Martinitoren for \"d’Olle Grieze\", \"Den gamle Grå\". Det er det tredje tårn på stedet, efter at to forgængere gik tabt som følge af lynnedslag."

	key[]: "be_cut_ardennes_desc"
	val[]: "La Roche-en-Ardenne er en lille belgisk by, der domineres af ruinerne af en middelalderborg, som ligger over et sving i floden Ourthe."

	key[]: "be_cut_antwerp_desc"
	val[]: "Antwerpen er Belgiens næststørste by og en historisk havneby, der siden 1447 har været kendt som verdens centrum for diamanthandel.<br><br>Omkring 80 til 90 procent af verdens rådiamanter passerer årligt gennem Antwerpens diamantkvarter."

	key[]: "fr_cut_brest_desc"
	val[]: "Brests lystbådehavn ligger i den historiske havn, som kardinal Richelieu i 1631 omdannede til en fransk flådebase.<br><br>Lystbådehavnene i Brest udgør et centralt knudepunkt for havsejlads. Her samles elitesejlere, inden de sætter kurs over Atlanten eller forsøger sig med nogle af sejlsportens mest krævende verdensrekorder."

	key[]: "fr_cut_marseille_desc"
	val[]: "Den gamle havn i Marseille har fungeret som byens naturlige havn, lige siden græske nybyggere grundlagde Massalia omkring 600 f.Kr.<br><br>Det er en af de ældste havne i Europa i uafbrudt drift."

	key[]: "fr_cut_peyrat_desc"
	val[]: "Peyrat-le-Château er en lille landsby i departementet Haute-Vienne, anlagt ved en dam på Plateau de Millevaches i Limousin.<br><br>Plateau de Millevaches har fået sit usædvanlige navn enten fra \"tusind køer\", der engang græssede der, eller fra et gammelt ord for de mange naturlige kilder, der findes rundt omkring på plateauet. Ingen ved med sikkerhed, hvilken forklaring der er den rette!"

	key[]: "fr_cut_rousse_desc"
	val[]: "L'Île-Rousse er en kystby i Balagne-regionen i det nordvestlige Korsika, grundlagt i 1758 af Pasquale Paoli.<br><br>Paoli anlagde havnen, så korsikanerne kunne handle uden at være afhængige af den rivaliserende, genovesisk kontrollerede havn i Calvi."

	key[]: "fr_cut_serre_desc"
	val[]: "Lac de Serre-Ponçon er et enormt reservoir i Hautes-Alpes, der blev skabt mellem 1955 og 1960 ved opdæmning af floden Durance.<br><br>Med næsten 3.000 hektar er Lac de Serre-Ponçon så stort, at det har fået tilnavnet \"havet i bjergene\", og et enkelt, ensomt kapel på en lille ø stikker stadig lige akkurat op over reservoirets vandoverflade."

	key[]: "fr_cut_usse_desc"
	val[]: "Château d'Ussé er et eventyrslot i Loire-dalen, opført mellem det 15. og 17. århundrede hvor en tidligere vikingefæstning lå.<br><br>Forfatteren Charles Perrault skulle angiveligt have hentet inspiration fra slottets hvide tårne, da han i det 17. århundrede skrev eventyret om Tornerose."

	key[]: "it_cut_bari_desc"
	val[]: "Bari Havn ligger ved Italiens adriaterhavskyst og har længe fungeret som en port mellem Europa og Balkan-landene.<br><br>Mellem 847 og 871 e.Kr. var Bari hovedstad i sit eget kortlivede islamiske emirat, den eneste sådan stat på det italienske fastland."

	key[]: "it_cut_etna_desc"
	val[]: "Etna på Siciliens østkyst er Europas højeste aktive vulkan og en af de mest aktive vulkaner på Jorden.<br><br>Navnet føres almindeligvis tilbage til det græske Aitnē, der stammer fra ordet aithō, som betyder \"jeg brænder\"."

	key[]: "it_cut_neapol_desc"
	val[]: "Napoli Havn, der blev grundlagt i den antikke græske bosættelse Neapolis, er en af Italiens ældste og travleste havne.<br><br>Under udgravningen til en metrostation ved siden af den nuværende Napoli Havn fandt arkæologer den antikke havn samt syv skibsvrag, der stammer fra den hellenistiske og romerske periode."

	key[]: "it_cut_sassari_desc"
	val[]: "Kirken Santa Maria di Betlem i Sassari på Sardinien er et franciskansk kompleks, hvis oprindelse går tilbage til det 12. århundrede.<br><br>Hvert år under Candelieri-festivalen i august bærer lav fra Sassari tårnhøje, trækonstruerede \"lys\", der vejer hundredvis af kilo, til kirken. Dermed fornyr de et gammelt løfte, der knytter sig til pesten."

	key[]: "it_cut_taranto_desc"
	val[]: "Taranto er en syditaliensk by ved Det Joniske Hav, grundlagt omkring 706 f.Kr. af spartanske kolonister som den græske by Taras.<br><br>I Tarantos industrielle bugt lever en blomstrende bestand af delfiner, herunder stribede delfiner med genetiske træk, som ikke findes andre steder i Middelhavet."

	key[]: "it_cut_villa_san_giovanni_desc"
	val[]: "Villa San Giovanni er en by i Calabrien på det italienske fastland og fungerer som den primære færgeterminal over Messinastrædet til Sicilien.<br><br>Villa San Giovanni blev grundlagt af silkeentreprenøren Rocco Antonio Caracciolo, der forenede fem rivaliserende landsbyer. Kong Ferdinand IV af Napoli navngav officielt den nye by i 1791."

	key[]: "balt_cut_castles_desc"
	val[]: "Hermannsborg blev grundlagt af danskerne i det 13. århundrede og senere genopbygget af Den Liviske Orden. Ivangorod-fæstningen blev grundlagt af Ivan III i 1492 for at forsvare Storfyrstendømmet Moskvas vestgrænse."

	key[]: "balt_cut_convent_desc"
	val[]: "Grundlagt i 1447 nord for Pskov af Sankt Eufrosynos udviklede det sig til et anerkendt uddannelsescenter."

	key[]: "balt_cut_daugavpils_desc"
	val[]: "Letlands næststørste by voksede frem omkring borgen Dinaburg, der blev grundlagt ved floden Daugava i 1275 af Den Liviske Orden.<br><br>Byen har båret mindst fire forskellige navne – herunder Dinaburg, Borisoglebsk og Dvinsk – før den i 1920 fik navnet Daugavpils."

	key[]: "balt_cut_klaipeda_desc"
	val[]: "Klaipėda, Litauens eneste større havneby, blev grundlagt i 1250'erne af Den Liviske Orden, en gren af Den Tyske Orden.<br><br>I omkring 500 år var byen aldrig under litauisk styre; den blev først en del af Litauen efter et oprør i 1923."

	key[]: "balt_cut_riga_power_plant_desc"
	val[]: "Dæmningen, der blev opført ved floden Daugava mellem 1966 og 1975, skabte et reservoir ved at oversvømme halvdelen af øen Doles sala.<br><br>Toppen af dæmningen fungerer som offentlig vej, og en jernbane fra anlægsperioden, der engang krydsede den, er siden blevet fjernet."

	key[]: "balt_cut_valmiera_desc"
	val[]: "Vidzeme Olympiske Center i Valmiera er en multifunktionel hal på næsten 2.900 kvadratmeter, der bruges til basketball og floorball.<br><br>Byens stadion er opkaldt efter kapgængeren Jānis Daliņš, der var født i Valmiera, og som vandt det selvstændige Letlands første medalje ved sommer-OL; en sølvmedalje i 50 km gang ved legene i Los Angeles i 1932."

	key[]: "blke_cut_cerna_voda_desc"
	val[]: "Anghel Saligny-broen ved Cernavodă, der stod færdig i 1895, var med sine over fire kilometer engang Europas længste bro.<br><br>Under tilbagetoget i 1916 beskadigede rumænske tropper Donau-broen og ødelagde dens Borcea-sektion. Begge dele blev genopbygget, og i 1987 blev de erstattet af en ny broforbindelse."

	key[]: "blke_cut_edirne_desc"
	val[]: "Edirne fungerede som hovedstad i Det Osmanniske Rige i næsten et århundrede, inden Konstantinopel blev erobret i 1453.<br><br>Oliebrydningsfestivalen Kırkpınar i Edirne har fundet sted siden det 14. århundrede og har en plads i Guinness Rekordbog som den ældste sportskonkurrence. Under festivalen overøses bryderne med næsten to tons olivenolie."

	key[]: "blke_cut_orsova_desc"
	val[]: "Orșova er en by ved Donau i det sydvestlige Rumænien, beliggende lige oven for \"jernport-kløften\", tæt på det sted, hvor floden Cerna løber ud i Donau.<br><br>Opførelsen af Jernport-dæmningen fik vandstanden i Donau til at stige med omkring 30 meter, hvilket betød, at det gamle Orșova blev oversvømmet i 1970. Indbyggerne blev genhuset i en helt ny by, der blev opført på et højere liggende område mellem 1966 og 1971."

	key[]: "blke_cut_pernik_desc"
	val[]: "Pernik, en kulmineby nær Sofia, har siden 1953 rummet et stort stålværk.<br><br>Værket fremstiller størstedelen af sit stål af genanvendt skrot, hvilket gør det til en af de virksomheder i regionen, der i højest grad indgår i en cirkulær økonomi."

	key[]: "blke_cut_poiana_viaduct_desc"
	val[]: "Poiana Teiului-viadukten er en 634 meter lang vejbro, der krydser halen af Bicaz-søen i Rumæniens Neamț-amt."

	key[]: "blke_cut_r73_desc"
	val[]: "Piatra Craiului er en 25 kilometer lang kalkstensryg i de rumænske Karpater, der har været beskyttet som nationalpark siden 1990.<br><br>Navnet betyder \"Kongens Klippe\", og parken huser adskillige hjemmehørende arter af hvirvelløse dyr."

	key[]: "ibe_cut_barcelona_desc"
	val[]: "Barcelona begyndte som den romerske bosættelse Barcino, hvis antikke ruiner stadig ligger under den moderne bys gader.<br><br>Syv af Barcelonas ni UNESCO-verdensarvssteder er værker af arkitekten Antoni Gaudí, herunder den imponerende katolske basilika Sagrada Família."

	key[]: "ibe_cut_ejido_desc"
	val[]: "El Ejido i Campo de Dalías i Almería huser en af verdens største koncentrationer af landbrugsdrivhuse.<br><br>Almerías \"hav af plastik\"-drivhuse strækker sig over 370 kvadratkilometer og reflekterer så meget sollys, at astronauter kan se dem fra kredsløb."

	key[]: "ibe_cut_guadiana_desc"
	val[]: "Den internationale Guadiana-bro er en skråstagsbro, der forbinder Ayamonte i Spanien med Castro Marim i Portugal ved grænsens sydligste overgang.<br><br>Når man krydser broen, passerer man også en tidszonegrænse, hvilket betyder, at rejsende fra Spanien til Portugal kan opleve to separate nytårsnedtællinger."

	key[]: "ibe_cut_lisboa_desc"
	val[]: "Broen af 25. april spænder over floden Tejo og forbinder Lissabon med Almada. Den er en af Europas længste hængebroer."

	key[]: "ibe_cut_olhao_desc"
	val[]: "Olhão er en hvidkalket fiskerby på den portugisiske Algarve-kyst, der ligger direkte ud til lagunen Ria Formosa.<br><br>Ifølge sagnet sejlede sytten fiskere fra Olhão i 1808 i en åben båd hele vejen til Brasilien for at fortælle Portugals landflygtige konge, at hans land var frit."

	key[]: "ibe_cut_reservoir_desc"
	val[]: "Reservoiret Barrios de Luna i provinsen León blev skabt i 1956, da en dæmning spærrede floden Luna i en snæver bjergkløft.<br><br>Da reservoiret blev fyldt op, blev seksten landsbyer og bebyggelser oversvømmet af vandmasserne, der nu strækker sig omkring 40 kilometer gennem dalen."

	key[]: "ibe_cut_santander_desc"
	val[]: "Havnen i Santander ligger i gåafstand fra byens centrum.<br><br>Santanders beskyttede havn, der blev grundlagt af romerne efter de kantabriske krige i 19 f.Kr., startede som et knudepunkt for eksport af mineraler og voksede i takt med den by, den var med til at skabe."

	key[]: "ibe_cut_zaragoza_desc"
	val[]: "Et af Europas største shopping- og fritidskomplekser, der strækker sig over mere end 200.000 kvadratmeter.<br><br>Komplekset er bygget op omkring en kunstig sø og kombinerer et indkøbscenter med restauranter, biografer, sportsfaciliteter og rekreative områder."

	key[]: "sc_cut_mabodalen_desc"
	val[]: "Måbødalen er en stejl, gletsjerformet dal nær Eidfjord i det vestlige Norge, hvor vandfaldet Vøringsfossen ligger.<br><br>Med et betagende frit fald på 145 meter ned i Måbødalens dyb er Vøringsfossen Norges mest ikoniske vandfald, der tiltrækker besøgende, som ønsker at opleve dets tordnende kraft."

	key[]: "sc_cut_stockholm_desc"
	val[]: "Stockholms kystlinje åbner sig mod en skærgård med omkring 30.000 øer, holme og skær, der strækker sig ud i Østersøen.<br><br>Stockholms umalede metrovogne af typen \"Silverpilen\", der blev indsat i 1965, gav ophav til en vandrehistorie om et spøgelsestog, som dukker op ved midnat og får enhver passager, som stiger ombord, til at forsvinde."

	key[]: "sc_cut_kalmar_desc"
	val[]: "Kalmar er en historisk havneby i det sydøstlige Sverige, der første gang omtales i det 11. århundrede, og som huser et renæssanceslot.<br><br>Kalmar Slot har gennem sin historie modstået 22 belejringer uden nogensinde at være blevet indtaget ved storm."

	key[]: "sc_cut_copenhagen_desc"
	val[]: "København er Danmarks hovedstad, bygget op omkring en historisk havn med kanaler, spir og gågader.<br><br>I Tivoli finder man Europas ældste fungerende rutsjebane, som har begejstret passagerer siden 1914."

	key[]: "blkw_cut_durdevica_desc"
	val[]: "Nationalparken Durmitor i Montenegro er et UNESCO-verdensarvsområde, der er kendt for sine barske bjerge, gletsjersøer og kløften ved floden Tara, og som huser denne betonbro med fem buer. Broen stod færdig i 1940 og rejser sig mere end 150 meter over floden.<br><br>I dag er det et af de mest populære steder på Balkan til ziplining."

	key[]: "blkw_cut_durres_desc"
	val[]: "Durrës, der blev grundlagt som den græske koloni Epidamnus i 627 f.Kr., er Albaniens ældste og travleste havneby.<br><br>Romerne gjorde den til det vestlige endepunkt for Via Egnatia, deres store vej, der strakte sig helt til Thessaloniki."

	key[]: "blkw_cut_pristina_desc"
	val[]: "Pristina, Kosovos hovedstad, ligger nær ruinerne af det antikke Ulpiana og har været beboet siden yngre stenalder.<br><br>I 1200-tallet var Pristina et vigtigt kongeligt og kommercielt centrum i den middelalderlige serbiske stat, før det osmanniske herredømme gradvist overtog efter 1389."

	key[]: "blkw_cut_split_desc"
	val[]: "Splits havnefront domineres af Diocletians palads og klokketårnet ved Sankt Domnius-katedralen. Hele den gamle bydel voksede frem inden for paladsets mure.<br><br>Den romerske kejser Diocletian trak sig tilbage til Split og kastede sig over kåldyrkning med så stor iver, at han afviste opfordringer til at genindtage tronen med den begrundelse, at hans grøntsager var vigtigere."

	key[]: "blkw_cut_bihac_desc"
	val[]: "I Bihaćs historiske centrum finder man det bevarede klokketårn fra Sankt Antonius-kirken, Kaptajntårnet og det murede mausoleum, en såkaldt \"turbe\". Kaptajntårnet fungerede senere som østrig-ungarsk fængsel. Kirken blev næsten ødelagt under allierede bombardementer i 1944.<br><br>De tre bygningsværker ligger blot få meter fra hinanden og afspejler Bihaćs kristne, osmanniske og østrig-ungarske fortid."

	key[]: "blkw_cut_sarajevo_desc"
	val[]: "Det er den ældste og historisk set mest betydningsfulde del af Sarajevo. I dens hjerte ligger Baščaršija - Sarajevos basarkvarter fra den osmanniske tid, grundlagt i 1462 af guvernør Isa-beg Isaković.<br><br>Sarajevos rådhus, kendt som Vijećnica, er en markant bygning fra den østrig-ungarske periode, tegnet i nymaurisk stil af den tjekkiske arkitekt Karel Pařík."

	key[]: "blkw_cut_ljubljana_desc"
	val[]: "Sloveniens hovedstad, Ljubljana, voksede frem langs floden Ljubljanica på stedet, hvor den tidligere romerske bosættelse Emona lå.<br><br>Ifølge sagnet dræbte Jason og argonauterne en drage netop dér, hvor Ljubljana ligger i dag, og uhyret pryder stadig byens våbenskjold."

	key[]: "blkw_cut_tirana_desc"
	val[]: "Tirana blev grundlagt i 1614 af den osmanniske herremand Sulejman Bargjini. Byen blev Albaniens midlertidige hovedstad i 1920 og permanent hovedstad i 1925.<br><br>Kthesa e Kamzës, en af Tiranas vigtigste trafikale indfaldsveje mod vest, forbinder hovedstaden med Kamëz samt ruter, der fører mod nord og vest."

	key[]: "blkw_cut_prokuplje_desc"
	val[]: "Prokuplje, hovedbyen i distriktet Toplica i det sydlige Serbien, har sine rødder i den romertidige bosættelse Hammeum.<br><br>Byen har lagt navn til Prokupac; en rødvinsdrue, der er blevet dyrket i området siden middelalderen."

	key[]: "gr_cut_piraeus_desc"
	val[]: "Piræus er Athens hovedhavn og en af de største passagerhavne i Middelhavet.<br><br>Silo-bygningen blev oprindeligt opført til opbevaring af korn. I dag er den ved at blive omdannet til Museum for Undervandsantikviteter, som skal udstille arkæologiske fund, der er bjærget fra de græske have."

	key[]: "gr_cut_kavala_desc"
	val[]: "Kavala er en historisk havneby i det nordlige Grækenland, grundlagt i slutningen af det 7. århundrede f.Kr. under navnet Neapolis.<br><br>Højen har været befæstet siden mindst det 5. århundrede f.Kr. Den nuværende fæstning i Kavala er hovedsageligt osmannisk og blev genopbygget i 1425 oven på tidligere byzantinske forsvarsværker."

	key[]: "gr_cut_kalabaka_desc"
	val[]: "Meteora er en gruppe klostre på toppen af sandstenssøjler nær Kalabaka og optaget på UNESCOs verdensarvsliste.<br><br>I århundreder hejste munke besøgende op ad 400 meter høje klippesider i et svingende rebnet, idet de spøgefuldt bemærkede, at nettet først blev udskiftet, når det gik i stykker."

	key[]: "gr_cut_beach_desc"
	val[]: "Faliraki er en badeby på Rhodos' nordøstkyst, cirka 14 kilometer syd for Rhodos by, og er kendt for sin lange sandstrand.<br><br>Faliraki er et af de mest populære feriesteder på Rhodos til vandsport, lige fra jetski til parasailing højt over bugten."

	key[]: "gr_cut_lixouri_desc"
	val[]: "Lixouri er Kefalonias næststørste by, anlagt på Paliki-halvøen nær stedet, hvor den antikke by Pale lå."

	key[]: "gr_cut_corinth_desc"
	val[]: "Korinthkanalen skærer sig gennem Korinthtangen og forbinder Det Ægæiske Hav med Den Korinthiske Bugt via en 6,4 kilometer lang kanal.<br><br>Den romerske kejser Nero tog i år 67 e.Kr. personligt det første spadestik til kanalen – næsten 1.800 år før den endelig stod færdig i 1893."

	key[]: "gr_cut_souda_desc"
	val[]: "Souda-bugten nær Chania på Kreta er en af de største og dybeste naturlige havne i Middelhavet.<br><br>Ved indsejlingen til bugten befæstede venetianerne i det 16. århundrede den lille ø Souda; dens fæstning holdt stand mod de osmanniske styrker og forblev på venetianske hænder helt frem til 1715, årtier efter at resten af Kreta var faldet i 1669."

	key[]: "gr_cut_polyfytos_desc"
	val[]: "Polyfytos-broen spænder over den kunstige sø Polyfytos på floden Aliakmon, Grækenlands længste flod, nær Kozani.<br><br>Den 1.372 meter lange bro stod færdig i 1975 og er tegnet af den anerkendte italienske ingeniør Riccardo Morandi."

	key[]: "poc_cut_alesund_desc"
	val[]: "Ålesund er en betydelig norsk krydstogthavn.<br><br>Den tyske kejser Wilhelm II, der tidligere havde besøgt byen, sendte flådefartøjer med byggematerialer for at hjælpe med genopbygningen, efter at en ødelæggende brand i 1904 havde lagt næsten hele træbyen i ruiner."

	key[]: "poc_cut_bodo_desc"
	val[]: "Bodø er en kystby lige nord for polarcirklen, der blev udpeget til europæisk kulturhovedstad i 2024."

	key[]: "poc_cut_nordkapp_desc"
	val[]: "Nordkap er et 307 meter højt klippeplateau på øen Magerøya, der ofte markedsføres som det europæiske fastlands nordligste punkt.<br><br>Nordkap er dog ikke i virkeligheden Europas nordligste punkt – det nærliggende næs Knivskjellodden strækker sig omkring 1.450 meter længere nordpå."

	key[]: "poc_cut_santa_desc"
	val[]: "Julemandens landsby ligger præcis på polarcirklen, cirka otte kilometer nord for Rovaniemi, og har åbent året rundt.<br><br>Besøgende kan stå på en malet linje, der markerer polarcirklen, og få et officielt certifikat som bevis på, at de har krydset den."

	key[]: "poc_cut_muotkatakka_desc"
	val[]: "Muotkatakka, omkring 12 kilometer syd for Kilpisjärvi, er med sine 565,8 meter det højeste punkt i hele det finske offentlige vejnet.<br><br>Vejen over dette pas forbinder Finland med Norge, og det er ikke usædvanligt at se rensdyr vandre langs vejkanten nær passets højeste punkt."

	key[]: "poc_cut_farm_desc"
	val[]: "Tohmajärvi er en lille kommune med skovklædte bakker og søer i Nordkarelen, tæt på Finlands østgrænse mod Rusland.<br><br>Dens våbenskjold forestiller en ambolt og en flamme, hvilket henviser til den jernindustri, der engang var af stor betydning for egnen."

	key[]: "poc_cut_viitasaari_desc"
	val[]: "Viitasaari er en by i det centrale Finland, der er rig på søer; kommunen rummer omkring 230 af slagsen.<br><br>Viitasaaris sommermusikfestival skydes hvert år i gang med en traktor-kortege, der kører gennem byen forud for koncerterne."

	key[]: "poc_cut_lalby_desc"
	val[]: "Lålby er en lille landsby i Kristinestad i regionen Österbotten på Finlands vestkyst."

	key[]: "poc_cut_kiruna_desc"
	val[]: "Kiruna er Sveriges nordligste by, anlagt omkring Kirunavaara, verdens største underjordiske jernmalmmine.<br><br>Jernmalmforekomsten brød frem fra to kilometers dybde for cirka 1,6 milliarder år siden, og i dag leverer minen omkring 80 procent af EU's jernmalm."

	key[]: "poc_cut_gavle_desc"
	val[]: "Gävle er en havneby på Sveriges østkyst ved floden Gavleåens udmunding i Gästrikland.<br><br>Hvert år i adventstiden siden 1966 har byen opstillet en kæmpestor julebuk af halm, som er blevet brændt ned af påsatte brande mere end 30 gange."

	key[]: "poc_cut_lulea_desc"
	val[]: "Luleå, hovedbyen i Norrbottens län, ligger ved Den Botniske Bugt og omfatter en skærgård med over 1.300 øer.<br><br>En stor teknologivirksomhed opførte et gigantisk datacenter i Luleå, netop fordi den barske arktiske kulde fungerer som gratis, naturlig aircondition til virksomhedens servere."

	key[]: "poc_cut_heia_desc"
	val[]: "Et naturskønt rasteområde ved E6 i Balsfjord, Troms, med udsigt over bjergene i en højde af cirka 240 meter."

	key[]: "poc_cut_svolvaer_desc"
	val[]: "Svolvær på øen Austvågøya er den største by og uofficielle hovedstad i den norske øgruppe Lofoten."

	key[]: "poc_cut_bjornfjell_desc"
	val[]: "Bjørnfjell er en fjeldstation på Ofotbanen, der ligger lige på grænsen mellem Norge og Sverige, tæt på Narvik.<br><br>Da den ligger så højt oppe i fjeldene, er Bjørnfjell station ofte dækket af sne i store dele af året, og jernbanestrækningen her regnes for en af de smukkeste togrejser i Nordeuropa."

	key[]: "poc_cut_trondheim_desc"
	val[]: "Trondheim, der blev grundlagt omkring 997 som Kaupangr og senere kendt som Nidaros, fungerede som Norges hovedstad i vikingetiden.<br><br>Nidarosdomen, der er opført over Sankt Olavs grav, er verdens nordligste gotiske middelalderkatedral."

	key[]: "is_cut_thingvellir_desc"
	val[]: "Þingvellir Nationalpark ligger i en sprækkedal mellem de nordamerikanske og eurasiske tektoniske plader. Området blev optaget på UNESCOs verdensarvsliste i 2004.<br><br>Islands parlament, Altinget, mødtes her for første gang under åben himmel i år 930, hvilket gør det til et af verdens ældste parlamenter."

	key[]: "is_cut_barthastran_desc"
	val[]: "Barðastrandarvegur (rute 62) følger kyststrækningen Barðaströnd i de sydlige Vestfjorde, langs den nordlige bred af den brede bugt Breiðafjörður.<br><br>Vikingen Hrafna-Flóki Vilgerðarson tilbragte en vinter på denne kyst, og efter at have set en fjord fyldt med drivis fra et nærliggende bjerg, gav han hele landet dets navn: Island."

	key[]: "is_cut_lagoon_desc"
	val[]: "Dette geotermiske lagunespa ligger i et lavafelt på Reykjanes-halvøen, hvor de badende kan slappe af i mælkeblåt vand med en gennemsnitstemperatur på 37–39 °C.<br><br>Lagunen er menneskeskabt; spaen blev etableret for at udnytte varmt overskudsvand fra det nærliggende geotermiske kraftværk, der åbnede i 1976."

	key[]: "is_cut_selfoss_desc"
	val[]: "Selfoss er den største by i Sydisland. Den er anlagt ved bredden af floden Ölfusá, som fik sin første hængebro i 1891.<br><br>Siden 2011 har Selfoss været et af de steder, der lægger hus til konkurrencen om at blive Islands stærkeste mand, en begivenhed, hvor stærke kæmper løfter store sten og trækker tunge lastbiler."

	key[]: "is_cut_seljaland_desc"
	val[]: "Seljalandsfoss er et 60 meter højt vandfald i Sydisland, der får sit vand fra en elv, som udspringer ved gletsjervulkanen Eyjafjallajökull.<br><br>En sti fører ind bag det faldende vand til en lille grotte, så besøgende kan opleve vandfaldet indefra."

	key[]: "is_cut_geyser_desc"
	val[]: "Strokkur, der ligger i det geotermiske område Haukadalur, er Islands mest aktive gejser og går i udbrud med få minutters mellemrum.<br><br>Dens nabo, den store Geysir, har lagt navn til alle gejsere i verden; navnet stammer fra det islandske verbum \"geysa\", der betyder \"at bevæge sig hurtigt fremad\"."

	key[]: "is_cut_gullfoss_desc"
	val[]: "Gullfoss, også kendt som \"De Gyldne Vandfald\", ligger i floden Hvítá og styrter i to trin på henholdsvis 11 og 21 meter ned i en 32 meter dyb kløft.<br><br>Da udenlandske investorer ønskede at udnytte vandfaldet til elproduktion, kæmpede Sigríður Tómasdóttir, datter af en lokal landmand, for at bevare det. Ovenfor vandfaldet står et mindesmærke i sten til ære for hende."

	key[]: "is_cut_joekul_desc"
	val[]: "Jökulsárlón er en gletsjersø ved enden af Breiðamerkurjökull, en gletsjertunge fra den enorme iskappe Vatnajökull.<br><br>Søen begyndte først at dannes i 1930'erne, i takt med at gletsjeren trak sig tilbage, og med en dybde på over 280 meter er den i dag Islands dybeste sø."

	key[]: "is_cut_gothafoss_desc"
	val[]: "Goðafoss er et 12 meter højt og 30 meter bredt vandfald på floden Skjálfandafljót i Nordisland.<br><br>Navnet oversættes normalt som \"gudernes vandfald\", men det kan tænkes at stamme fra to klipper ved vandfaldet, der ligner hedenske afgudsbilleder."

	key[]: "is_cut_canyon_desc"
	val[]: "Stuðlagil er en kløft i dalen Jökuldalur i det østlige Island, hvor høje, sekskantede basaltsøjler står langs floden Jökla.<br><br>Kløften lå skjult under vand, indtil Kárahnjúkar-dæmningen, der stod færdig i 2009, fik vandstanden i floden til at falde. Den blev først kendt, efter at en fotograf delte billeder af den i 2016."
#@}

