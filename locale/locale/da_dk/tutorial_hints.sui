
    key[]: "hint_engine_title"
	val[]: "Tænd motoren"

    key[]: "hint_engine_text"
	val[]: "Brug $KEY_engine$ for at tænde motoren."


    key[]: "hint_ignition_title"
	val[]: "Slå tændingen til"

    key[]: "hint_ignition_text"
	val[]: "Brug $KEY_engineelect|KEY_engine$ for at slå tændingen til."


    key[]: "hint_driv_arc_title"
	val[]: "Kørsel"

    key[]: "hint_driv_arc_text"
	val[]: "Brug $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for at køre frem eller tilbage.<br><offset vshift=8>Brug $SPECIAL_steering$ for at styre."


    key[]: "hint_driv_auto_title"
	val[]: "Kørsel"

    key[]: "hint_driv_auto_text"
	val[]: "Brug $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for at køre frem eller tilbage.<br><offset vshift=8>Brug $SPECIAL_steering$ for at styre.<br><offset vshift=8>Tryk $KEY_gearup$ og $KEY_geardown$ for gearvalg."


    key[]: "hint_driv_seq_title"
	val[]: "Kørsel"

    key[]: "hint_driv_seq_text"
	val[]: "Brug $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for at køre frem eller tilbage.<br><offset vshift=8>Brug $SPECIAL_steering$ for at styre.<br><offset vshift=8>Tryk $KEY_gearup$ og $KEY_geardown$ for koblingskontrol."


    key[]: "hint_driv_hshift_title"
	val[]: "Kørsel"

    key[]: "hint_driv_hshift_text"
	val[]: "Brug $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for at køre frem og tilbage.<br><offset vshift=8>Brug $SPECIAL_steering$ for at styre.<br><offset vshift=8>Skift gear med <color value=@@clr_sel@@>skifter<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Nærm dig destinationen"

    key[]: "hint_depot_deliv_text"
    val[]: "Stands i det markerede område for at vælge endelig sværhedsgrad for parkeringen og optjene tilsvarende erfaring."


    key[]: "hint_fin_deliv_title"
    val[]: "Afslut leveringen"

    key[]: "hint_fin_deliv_text"
    val[]: "Parker på det valgte område. Du kan trykke $KEY_activate$ for at springe over, hvis du er tæt på leveringspunktet."


    key[]: "hint_fin_deliv2_title"
    val[]: "Afslut leveringen"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parker på det valgte område. Du kan slå en widget til under @@desktop_menu_category_options@@, som vil gøre det muligt for dig at springe parkering over."


    key[]: "hint_lights_title"
    val[]: "Tænd lysene"

    key[]: "hint_lights_text"
    val[]: "Brug $KEY_light$ for at tænde lysene. Du kan rotere gennem de forskellige lysindstillinger ved at trykke gentagne gange."


    key[]: "hint_high_beam_title"
    val[]: "Slå fjernlyset til"

    key[]: "hint_high_beam_text"
    val[]: "Brug $KEY_hblight$ for at slå fjernlyset til."


    key[]: "hint_wipers_title"
    val[]: "Tænd vinduesviskerne"

    key[]: "hint_wipers_text"
    val[]: "Brug $KEY_wipers$ for at tænde vinduesviskerne og rotere gennem de forskellige hastigheder."


    key[]: "hint_zoom_title"
    val[]: "Et nærmere kig"

    key[]: "hint_zoom_text"
    val[]: "Brug $KEY_camzoom$ for at zoome, når du er indenfor. Du kan vælge, om zoomet holdes med knappen eller slås til og fra med et tryk under @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Et kig omkring"

    key[]: "hint_cam_int_text"
    val[]: "Brug $KEY_cam1$ for at skifte kameraet til indendørs."


    key[]: "hint_cam_ext_title"
    val[]: "Et kig omkring"

    key[]: "hint_cam_ext_text"
    val[]: "Du kan rotere gennem forskellige kameravinkler ved at trykke $KEY_camcycle$.<br><offset vshift=8>Brug $KEY_cam2$ for at skifte kameraet til udendørs."


    key[]: "hint_indicators_title"
    val[]: "Blinklys"

    key[]: "hint_indicators_text"
    val[]: "Brug $KEY_lblinker$ og $KEY_rblinker$ for at slå blinklysene til."


    key[]: "hint_tow_title"
    val[]: "Vejhjælp"

    key[]: "hint_tow_text"
    val[]: "Hvis du ikke kan komme ud af en vanskelig situation, kan du bruge vejhjælpen. For at gøre det, skal du åbne @@quick_info_word@@-menuen ved hjælp af $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Differentialespærre"

    key[]: "hint_diff_lock_text"
    val[]: "Hvis du har svært ved at få lastbilen i bevægelse, kan differentialespærren måske hjælpe dig. Brug $KEY_diflock$ for at aktivere den eller slå automatisk differentialespærre til under @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Differentialespærre slået til"

    key[]: "hint_diff_unlock_text"
    val[]: "Du bør slå differentialespærren fra under normal kørsel for at undgå at skade den. Brug $KEY_diflock$ for at slå den fra eller slå automatisk differentialespærre til under @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Sluk vinduesviskerne"

    key[]: "hint_wipers_off_text"
    val[]: "Brug $KEY_wipers$ for at slukke vinduesviskerne samt rotere gennem de forskellige hastigheder."


    key[]: "hint_world_map_title"
    val[]: "Kort"

    key[]: "hint_world_map_text"
    val[]: "Brug $KEY_navmap$ for at åbne kortet."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Brug $KEY_advmouse$ for at åbne @@quick_info_word@@ - overblik over din status med belejlige genveje."


    key[]: "hint_pause_border_title"
    val[]: "Lokale regler"

    key[]: "hint_pause_border_text"
    val[]: "Brug $KEY_advmouse$ for at åbne @@quick_info_word@@ og se aktuelle lokale regler for det område, du er i."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Åbn @@quick_info_word@@ ved hjælp af $KEY_advmouse$ for at aktivere @@photo_mode_word@@ og tage billeder af @@landmark_word@@ i nærheden <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ i nærheden"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> er i nærheden - find og aktiver for at se filmsekvensen."


    key[]: "hint_resting_title"
    val[]: "Hvilested i nærheden"

    key[]: "hint_resting_text"
    val[]: "Hvilesteder <img src=/material/ui/map/parking_ico.mat width=20 height=20> hjælper dig til at komme dig over træthed, så du kan fortsætte din rejse sikkert."


    key[]: "hint_gas_title"
    val[]: "Tankstation i nærheden"

    key[]: "hint_gas_text"
    val[]: "Tankstationer <img src=/material/ui/map/gas_ico.mat width=20 height=20> kan bruges til at tanke dit køretøj op."
