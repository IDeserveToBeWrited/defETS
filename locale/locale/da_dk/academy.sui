	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Vejpunkt nået"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Fortsæt med scenariet."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Parkeringsplads"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>For at afslutte scenariet skal du sikre lastbilen og slukke motoren.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Du er det rigtige sted, men vender den forkerte vej.<br><br><font face=/font/big_bold.font>Vend lastbilen om, før du fuldfører scenariet.</font>"
