#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "I dette scenarie vil vi udføre en bakkemanøvre for at parkere ved siden af en kantsten."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Bak mod kantstenen.<br>Vær opmærksom på dine omgivelser når du bakker, så brug spejlene."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Når du kommer nærmere, kan du begynde at få lastbilen til at flugte med parkeringspladsen. Hold øje med begge sider af lastbilen mens du bakker."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Stands på parkeringspladsen og sikr lastbilen."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Parkeringspladsen er bag dig på passagersiden. Brug dine spejle for at manøvrere mod pladsen.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Husk at bruge dine spejle for at undersøge dine omgivelser, inden du kører.<br><br><font face=/font/big_bold.font>Begynd at bakke mod kantstenen. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Bliv ved med at holde øje med dine omgivelser mens du bakker ind på parkeringspladsen.<br><br><font face=/font/big_bold.font>Stands på det angivne sted. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

