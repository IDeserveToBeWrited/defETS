#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "I dette scenarie tager vi trækkeren på en kort køretur for at se, hvordan du håndterer den med, hvad du lige har lært."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Der er forskellige typer og kombinationer af sving på banen. Det er ikke et kapløb og handler ikke om tid. Vær tålmodig og tilpas din hastighed efter de sving og forhindringer, du møder."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "I begyndelsen er banen rolig og let, men svingene vil blive mere komplekse, efterhånden som du kommer længere frem."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Vær opmærksom på din hastighed; det er let at komme til at køre for hurtigt og så fejlbedømme et sving."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Banens udkørsel er et meget skarpt hårnålesving. Kør langsomt og brug al den plads du har til rådighed."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Parker mellem barriererne og sikr lastbilen."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "For at fuldføre dette scenarie må du ikke køre galt, køre af banen eller ramme trafikkeglerne.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Fortsæt frem ind i det skarpe højresving for at komme ind på banen. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Kør gennem svinget med en god, jævn hastighed. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Du nærmer dig en mere kompleks sektion af bugtende sving.<br><br><font face=/font/big_bold.font>Tilpas din hastighed og fortsæt.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Fortsæt mod den næste serie sving.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Nu kommer nogle lette, rolige sving. Hold din hastighed jævn.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Svinget ud af banen er et skarpt hårnålesving. Sæt farten ned og hold dig til ydersiden inden svinget. Husk at benytte spejlene!<br><br><font face=/font/big_bold.font>Forlad banen. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Foran dig er en parkeringsplads mellem nogle barrierer.<br><br><font face=/font/big_bold.font>Fortsæt mod parkeringspladsen. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parallelparkering"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "I dette scenarie tager vi et kig på parallelparkering mellem to andre lastbiler."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Stands foran parkeringspladsen"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Tjek bakspejlet"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Bak ind på parkeringspladsen"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Ret lastbilen til i parkeringspladsen"
#!{
	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_09_start"
