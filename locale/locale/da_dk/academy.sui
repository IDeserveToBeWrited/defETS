#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Baglænskørsel med en trailer"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "I dette scenarie vil du prøve at bakke med en trailer for første gang. Det er en forholdsvis simpel manøvre, men du vil skulle styre rigtigt for at guide traileren det rette sted hen."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Baglænskørsel mod traileren"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Tilkobl traileren"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Løsn håndbremsen"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Baglænskørsel med traileren"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Fortsæt mod parkeringspladsen"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Lad os prøve at bakke med en trailer. Det er lettere end det ser ud - du skal bare være tålmodig."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Sæt i bakgear og få trækkeren til at flugte med traileren."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Vær sikker på, at du står rigtigt, for ellers vil du ikke kunne koble til. Hvis det ikke helt stemmer, kan du altid køre lidt frem og prøve igen."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Trækkerens femte hjul vil låse med trailerens king pin."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Aktivere parkeringsbremsen og tilslut anhængeren. I det virkelige liv ville du skulle forlade lastbilen for at forbinde luft- og elektriske ledninger og hæve støtteben, men her gør vi det for dig."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Traileren vil altid dreje <color value=@@clr_sel@@>modsat <color value=@@clr_txt@@>trækkeren."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>For at dreje traileren er du nødt til at dreje trækkeren i den<color value=@@clr_sel@@> modsatte <color value=@@clr_txt@@> retning af, hvad du ønsker traileren skal bevæge sig."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>For at rette traileren op igen skal du dreje trækkeren <br><color value=@@clr_sel@@>mod<color value=@@clr_txt@@> traileren."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Forsøg at holde den rette vinkel i forhold til traileren - du vil hele tiden skulle lave små korrektioner for, at traileren peger mod det markerede område."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Ret afvigelser fra din rute med små drej på rattet, så snart de dukker op. Hvis du overstyrer, kan du ende langt uden for ruten."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Stands i det anviste område, sikr lastbilen og sluk motoren."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Bag dig til højre vil du se en trailer. Din første opgave bliver at bakke hen til den.<br><br><font face=/font/big_bold.font>Forbered lastbilen til at bakke. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Begynd at bakke mod traileren. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Styr sådan, at du flugter med traileren. Det femte hjul skal fange kingpin'en. Kør lidt frem for at korrigere, hvis det bliver nødvendigt..<br><br><font face=/font/big_bold.font>Bak videre indtil du mærker forbindelsen. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Det femte hjul er koblet til kingpin'en, og du er klar til at afslutte tilkoblingen af traileren.<br><br><font face=/font/big_bold.font>Træk håndbremsen. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Tryk @@imv_nrm_attach@@ for at tilkoble traileren. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Nu da traileren er sikkert forbundet til trækkeren, bliver slangerne for luft og elektricitet forbundet, og støttebenet hæves.<br><br><font face=/font/big_bold.font>Løs håndbremsen. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Du skal bakke ind på parkeringspladsen lige bag dig. Husk at traileren vil dreje i den modsatte retning af trækkeren. Et lille drej på rattet kan resultere i et stort drej ved traileren.<br><br><font face=/font/big_bold.font>Begynd at bakke traileren. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Undgå at overstyre, men forsøg blot at holde traileren korrekt i forhold til pladsen. <br><br><font face=/font/big_bold.font>Fortsæt mod parkeringspladsen. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkering med lidt plads"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "I dette scenarie vil vi parkere på en trang plads.<br><br>Du vil skulle manøvrere traileren så den rammer en forskudt parkeringsplads."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manøvrering på plads"
#!{
	key[]: "aca_goal_book1_3_06_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_06_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "At parkere, når man kører fremad, eller \"stikke snuden ind\", er ret let, når det kommer til parkeringsmanøvrer. <br>Du vil stadig skulle kompensere for den forskudte bevægelse af traileren."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Du skal køre forbi det punkt, du normalt ville dreje med trækkeren. Det gør det muligt for dig lettere at orientere traileren rigtigt."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Drej ind for at få trækkeren foran traileren, når du nærmer dig parkeringspladsen. Sørg for, at du er placeret rigtigt, og fortsæt til pladsen.<br>Stands, parker, sikr køretøjet og sluk motoren."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Foran dig er der en parkeringsplads, som du skal køre hen til og parkere på.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Begynd at køre og drej mod parkeringspladsen. </font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Kør forbi parkeringspladsen for at få din trailer orienteret rigtigt i forhold til det markerede område. Bring så trækkeren ind på pladsen og ret op.<br><br><font face=/font/big_bold.font>Parker i det anviste område.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Stands i det anviste område. </font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Sikr lastbilen og sluk motoren. </font>"
#@}

