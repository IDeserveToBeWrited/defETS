	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Foran dig er nogle skarpe sving med begrænset plads. De vil hjælpe dig med at lære at manøvrere traileren effektivt."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Følg vejmarkeringerne mod barrieren på førersiden for at gøre klar til første sving."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Hold dig tæt på den ydre barriere gennem svinget, og traileren skulle følge dig fint ind på banen."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Fortsæt med at følge markeringerne på vejen for at gøre klar til andet sving, et skarpt 90 graders-sving."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Du vil skulle køre dybt ind i svinget for at sikre dig, at din trailer kommer fri af de indre barrierer. Brug dit frontspejl til at sikre dig, at du kommer så langt ind som muligt uden at ramme noget."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Fortsæt langs den ydre barriere."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Igen, endnu et skarpt 90 graders-sving vil kræve, at du bruger al den plads, du har til rådighed."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Stands i det angivne område og sikr lastbilen."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Husk at bruge alt den plads, du har, for at komme gennem hvert sving.<br><br><font face=/font/big_bold.font>Begynd at køre og følg vejmarkeringerne på ydersiden. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Følg den ydre barriere rundt, men hold øje med din trailer i spejlet.<br><br><font face=/font/big_bold.font>Kør gennem første sving. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Følg markeringerne på vejen for at gøre klar til 90 graders-svinget længere fremme.<br><br><font face=/font/big_bold.font>Gennemfør 90 graders-svinget. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Hold lastbilen langt ude efter svinget, da der kommer et endnu skarpere 90 graders-sving længere fremme.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Fortsæt til parkeringspladsen længere fremme. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
