#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Velkommen til den første del af den afsluttende eksamen. Her vil vi finde ud af, hvor godt du har lært at føre en lastbil efter din tid i køreskolen."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Først skal du koble traileren til. Når den er tilkoblet, vil du køre lastbilen rundt i hele testområdet."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Banens første sektion fører fra den smalle parkeringsplads til den østre testbane."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Banen omfatter udfordrende passager mellem barrierer."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "En stor del af ruten går gennem den østre træningsbane."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Vi vil teste din evne til at manøvrere lastbilen gennem forskellige situationer."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Du vil manøvrere lastbilen gennem nogle skarpe sving."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Du vil kører gennem vejsektionen som forbinder banerne."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Den sidste del involverer at køre gennem den lille bane."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Banen har mange fine passager og skarpe sving."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "For at gennemføre testen skal du parkere nøjagtigt."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Du behøver ikke være nervøs - du har allerede lært alt, du får brug for for at bestå.<br><br>Held og lykke!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Traileren er foran dig.<br><br><font face=/font/big_bold.font>Kør hen mod den. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Flugt trækkeren med traileren.<br><br><font face=/font/big_bold.font>Bak og forbind med king pin'en. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Sikr lastbilen. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Tryk @@imv_nrm_attach@@<font face=/font/big_bold.font> for at tilkoble traileren. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Traileren er tilkoblet, og lastbilen er klar til at køre.<br><br><font face=/font/big_bold.font>Løsn håndbremsen. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Begynd at køre mod parkeringspladsens udkørsel. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Følg vejmarkeringerne og hold øje med barriererne.<br><br><font face=/font/big_bold.font>Kør videre. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Nu kommer en mere udfordrende sektion.<br><br><font face=/font/big_bold.font>Kør forsigtigt mellem barriererne. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Kør videre. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Denne del tester din evne til at manøvrere en trailer gennem forskellige typer sving.<br><br><font face=/font/big_bold.font>Drej ind på banen. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Kør gennem passagen. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Kør lige frem.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Kør forsigtigt gennem svinget. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Du har nået en mere kompleks sektion. Kør forsigtigt.<br><br><font face=/font/big_bold.font>Fortsæt med at køre ned ad bakke. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Gennemfør det skarpe venstresving. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Forlad banen. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Du har nået en lettere sektion.<br><br><font face=/font/big_bold.font>Fortsæt med at køre ned ad bakken. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Bliv ved med at køre på vejen. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Længere fremme er svinget ind på næste bane.<br><br><font face=/font/big_bold.font>Fortsæt med at køre. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Drej til højre. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Fortsæt kørslen på banen. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Længere fremme er der skarpere sving.<br><br><font face=/font/big_bold.font>Tilpas din hastighed derefter. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Lav et venstresving. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Kør videre. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Kør ind i svinget og fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "For at gennemføre svinget vil du muligvis skulle køre en anelse af asfalten.<br><br><font face=/font/big_bold.font>Drej forsigtigt og brug så megen plads, som du har brug for. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Forlad banen og kør ind på parkeringspladsen. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

