#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Kør gennem komplicerede sving"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "I dette scenarie vil vi prøve at manøvrere traileren gennem en kort forhindringsbane med mere komplekse sving."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Første sving"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Kør gennem en snæver passage"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Snævert 90 graders-sving"
#!{
	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Kør uden om barriererne"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Længere fremme er forskellige komplekse sving og forhindringer.<br>Hvis du husker alt, du har lært indtil nu, bør det ikke være for svært."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Vejmarkeringerne kan hjælpe dig med at få en idé om, hvordan du skal fortsætte gennem hver gruppe forhindringer."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Hold trækkeren ved ydersiden af hjørnet.<br>Du er nødt til at dreje bredt, da traileren vil følge en tættere kurve."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Det næste hjørne er et let 90 graders-sving. <br> Igen, hold lastbilen på ydersiden af svinget og brug al den plads du har til rådighed."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Giv dig god tid her. Banen bliver bredere, men du vil stadig skulle køre præcist."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Hold god afstand til barriererne."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Vær forsigtig, når du når denne smalle sektion.<br>Drej trækkeren bredt i god tid, inden du gør din trailer klar til indkørsel."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Det sidste 90 graders-sving er meget skarpere end det første, men der er masser af plads, hvis du bruger den klogt."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Stands i det anviste område, sikr lastbilen og sluk motoren."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Husk at bruge vejmarkeringerne, når du navigerer gennem banen.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "At bruge spejlene vil også hjælpe dig med at komme sikkert gennem banen. Du skal altid være opmærksom på, hvis traileren befinder sig bag dig.<br><br><font face=/font/big_bold.font>Fortsæt gennem første sving. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Hold øje med traileren når du forlader svinget og gør klar til at køre ind i næste.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fortsæt gennem næste sving. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Husk at holde øje med din trailer, så du er sikker på, at du er kommet fri af forhindringerne omkring dig, inden du drejer.<br><br><font face=/font/big_bold.font>Fortsæt gennem barriere-forhindringen længere fremme. </font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Når din trailer er fri af barrieren, skal du dreje hårdt mod passagersiden for at komme i den rette position i forhold til den snævre passage. <br><br><font face=/font/big_bold.font>Fortsæt mod den snævre passage.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Denne sektion vil kræve meget præcis kørsel. Tag dig god tid og brug dine spejle.<br><br><font face=/font/big_bold.font>Hold til ydersiden af hvert hjørne. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Dette sving er meget skarpt, men du kan benytte al pladsen foran dig for let at klare det.<br><br><font face=/font/big_bold.font>Kør gennem det sidste sving. </font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Avanceret træningsbane - Med trailer"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "I det sidste scenarie i kapitel 3 tager vi en køretur på en længere træningsbane med flere forskellige sving, så vi kan se, hvor godt du har lært at manøvrere med en trailer."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Kombineret sving"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "FJERN DETTE MÅL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Kryds midterrabatten"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Første slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Anden slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Lette sving"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Rundkørsel"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Lige stykke"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Skarpt sving"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Afsluttende sving"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Kør til parkeringspladsen"
#!{
	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "I dette scenarie vil du møde en mængde forskellige sving, som vil hjælpe dig med at blive vant til at køre med trailer. Hold fokus, tilpas din hastighed efter situationen og gør brug af pladsen, du har til rådighed på træningsbanen."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Det første sving er et kombineret sving - to sving i ét. Du vil skulle gøre klar til et venstresving, men skifte til et højresving midt i manøvren."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Det næste sving får dig til at krydse til den anden side af midterrabatten. Det er ikke specielt svært, men du vil skulle holde øje med, at du har plads nok til din trailer."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Som det næste vil du skulle gennem en snæver slalombane af betonbarrierer. Kør langsomt, brug dine spejle og vær sikker på at svinge bredt nok til, at traileren ikke rammer barriererne."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Nu vil du nå endnu en slalombane, denne med ekstra kegler ved spidsen af hver kurve. <br>Vær sikker på ikke at ramme dem!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Nu kommer et par lette sving på din vej mod rundkørslen."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Brug den lige del til at forberede dig på at køre ind i rundkørslen. Hold mod ydersiden inden du kører ind i den."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Kør ind i rundkørslen og hold øje med din trailers placering. Den vil følge dig anderledes i rundkørslen sammenlignet med, hvordan du kørte ind."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Forlad rundkørslen og kør videre til den næste gruppe sving."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "FJERN DENNE FILMSEKVENS"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Dette sving er ekstremt skarpt. Tag den med ro og brug pladsen omkring dig klogt. Hav i baghovedet hvordan trailerens ende svinger."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Når du kører gennem de næste sving, skal du prøve at huske at gøre klar til næste sving, når du forlader svinget, du er i."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Forhast dig ikke i det sidste sving. Det ser let ud, men der er mindre plads, end der ser ud til."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Stands i det anviste område, sikr lastbilen og sluk motoren."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Sæt farten op mod første sving. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Det første sving er et let kombineret sving.<br><br><font face=/font/big_bold.font>Gennemfør svinget. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "FJERN DETTE TJEK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Længere fremme fortsætter banen på venstre side af midterrabatten.<br><br><font face=/font/big_bold.font>Gennemfør krydsningen. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manøvrer mellem barriererne og husk at holde øje med din trailer.<br><br><font face=/font/big_bold.font>Kør gennem slalombanen. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Denne slalombane er mere ligetil, men trafikkeglerne gør den markant mere snæver.<br><br><font face=/font/big_bold.font>Kør gennem slalombanen og undgå at ramme keglerne. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Længere fremme er der et par lette sving. Du vil stadig skulle forberede dig, så du holder din trailer fra barriererne på indersiden.<br><br><font face=/font/big_bold.font>Fuldfør svingene. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Du nærmer dig en rundkørsel. Husk at have plads nok til din trailer, både når du kører ind i og forlader, men også når du befinder dig i selve rundkørslen.<br><br><font face=/font/big_bold.font>Kør gennem rundkørslen. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Foran dig er en kort, lige sektion, hvor du kan sætte hastigheden lidt op, hvis du vil.<br><br><font face=/font/big_bold.font>Kør videre. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Dette sving er ekstremt skarpt. Kør langsomt, brug den plads du har til rådighed og husk, hvordan trailerens bagende svinger. <br><br><font face=/font/big_bold.font>Kør gennem det skarpe sving. </font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "De sidste sving er ligetil, bare husk, at du kører med trailer..<br><br><font face=/font/big_bold.font>Fortsæt. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Fortsæt mod den sidste parkeringsplads. </font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

