#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "LASTBILKØRSELS-FÆRDIGHEDSINFO" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Krav for at bestå"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Scenarier fuldføres ved at opfylde alle beståelsesbetingelser"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Stjerner optjenes ved at gennemføre bonusbetingelser"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Betingelser"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maksimalt antal skift mellem fremadgående og bagudgående bevægelse"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maksimal tid tilladt for at fuldføre et scenarie for en given betingelse"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Eksklusiv brug af indvendigt kamera - udvendige kameraer kan stadig anvendes, mens bilen holder stille"

	key[]: "aca_book_book2_completed_t"
	val[]: "LASTBILKØRSELS-FÆRDIGHEDER BESTÅET"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br><br>Du har klaret alle betingelserne for at bestå modulet for lastbilkørsel-færdigheder og har opnået belønninger til din karriereprofil. Du kan stadig udfordre dig selv for at få endnu flere belønninger ved at fuldføre alle bonus-betingelser.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "LASTBILKØRSELS-FÆRDIGHEDER FULDFØRT"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br><br>Du har klaret alle betingelser for at bestå modulet for lastbilkørsel-færdigheder samt alle bonusbetingelser og har opnået belønninger til din karriereprofil.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Lastbilkørsels-færdigheder"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Velkommen tilbage til @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "De følgende scenarier udgør de næste trin på din vej mod professionel lastbilkørsel."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Vi vil ikke guide dig gennem hver opgave denne gang, så det er op til dig at bruge dine færdigheder og erfaring."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Du støder måske på nogle velkendte manøvrer, men denne gang i nye miljøer, der er lavet til at ligne mere virkelige scenarier."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Nyt for @@driving_academy@@ er tilføjelsen af betingelserne \"Bestået\" og \"Bonus\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Ligesom før skal du stadig gennemføre hvert scenarie uden at ramme noget, ved at parkere korrekt og sikre lastbilen..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...men nu skal du også gøre det inden for den tildelte tidsfrist, og med en begrænsning i antallet af retningsskift mellem kørsel fremad og bagud."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bonusbetingelser kan opfyldes ved at gennemføre hvert scenarie med endnu mere udfordrende betingelser..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...såsom strengere tidsbegrænsninger, færre retningsskift og udelukkende brug af kabinekameraet."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Ved at gennemføre alle scenarier kan du betragte dig selv som en dygtig lastbilchauffør og klar til den næste udfordring på vejen.<br><br>For at udfordre dig selv yderligere skal du gennemføre alle bonusbetingelserne for hvert scenarie; så vil du virkelig blive en lastbilchaufførstjerne!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "I dette vejledningsscenarie hjælper vi dig med at blive fortrolig med de nye funktioner i lastbil-kørefærdigheder."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "I starten af hvert scenarie vil du se et <color value=@@clr_sel@@>\"Scenario Briefing\"<color value=@@clr_txt@@> vindue. Dette giver dig information om de nye beståelses- og bonusbetingelser for scenariet. <br><br>Beståelsesbetingelserne skal opfyldes for at gennemføre scenariet, mens bonusbetingelser er en valgfri ekstra udfordring for erfarne og dygtige spillere. <br><br><font face=/font/big_bold.font>For at fortsætte skal du tilslutte tænding.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "En af bonusbetingelserne kræver, at du gennemfører scenariet, mens du bruger <color value=@@clr_sel@@>Interiørkameraet<color value=@@clr_txt@@>. Du kan stadig bruge de udvendige kameraer til at tjekke dine omgivelser, men kun mens lastbilen holder stille.<br><br>Du kan nu se dig omkring for at orientere dig og derefter skifte tilbage til det indvendige kamera.<br><br><font face=/font/big_bold.font>Skift til følgekamera for at tjekke omgivelserne</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Find din retning, og skift derefter tilbage til kabinekameraet.<br><br><font face=/font/big_bold.font>Se dig omkring i lastbilen</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Skift tilbage til indvendigt kamera</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Tid<color value=@@clr_txt@@> vil også være en faktor i lastbilkørselsfærdigheder. Alle scenarier vil have en individuel tidsgrænse, hvor scenariet skal gennemføres som en bestået betingelse, og mange vil også have en yderligere, strengere grænse som en bonusbetingelse.<br><br>Timeren starter først, når lastbilen er flyttet.<br><br><font face=/font/big_bold.font>Start motoren, og slip parkeringsbremsen for at fortsætte.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "En anden ny tilføjelse til lastbilkørselsfærdigheder er vejpunkter. Alle vejpunkter skal nås, før et scenarie kan gennemføres. <br><br>Derudover er vejpunkter følsomme over for, hvilken retning lastbilen vender i, når vejpunktet nås, så vær opmærksom på eventuelle markeringer på jorden i nærheden af vejpunktet for at orientere dig korrekt.<br><br><font face=/font/big_bold.font>Kør fremad til vejpunktet foran dig.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Du har nået vejpunktet og kan nu gå videre til næste trin. <br><br>Der er endnu et vejpunkt bag dig, som du skal bakke ind i. Bemærk pilen på jorden, der angiver, hvilken vej lastbilen skal vende, når du når vejpunktet. <br><br>En anden betingelse for bestået og bonus, der skal tages i betragtning, er <color value=@@clr_sel@@>Retningsændringer<color value=@@clr_txt@@>. Vi tæller, hvor mange gange du ændrer retning mellem at køre fremad og bak. Hold dig under grænsen for at fuldføre betingelsen.<br><br><font face=/font/big_bold.font>Bak til vejpunktet og stop.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Så nu burde du have samlet ét retningsskift. <br><br>Saml traileren bag dig op for at fortsætte til næste trin. <br><br><font face=/font/big_bold.font>Bak ind under traileren for at koble den til.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Det sidste parkeringsområde er til højre for dig. Nogle scenarier har muligvis kun én parkeringsplads, mens andre har flere at vælge imellem. Ved at parkere korrekt på en af pladserne kan du fuldføre scenariet. <br><br><font face=/font/big_bold.font> Tryk på @@imv_nrm_attach@@ for at tilkoble traileren. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Parkeringsbåsene angiver også, hvilken vej lastbilen skal vende på stedet. Parkerer du i den forkerte retning, kan du ikke gennemføre scenariet, før du retter dig selv, hvilket vil koste dig tid og retningsskift.<br><br><font face=/font/big_bold.font>Kør til en af parkeringsbåsene, og parker korrekt.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Du burde nu være bekendt med de nye parametre for Beståelsesbetingelser og Bonusmål og være klar til at tackle de nye scenarier i Lastbilkørselsfærdigheder!<br><br><font face=/font/big_bold.font>Sikr lastbilen ved at aktivere parkeringsbremsen og slukke motoren for at fuldføre scenariet.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Genvej"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "I dette scenarie vil du forsøge at bruge en genvej, som desværre er blokeret til sidst. Du skal derefter bakke tilbage ad den vej, du kom fra."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Kør til vejpunktet oppe på toppen af bakken, og kør derefter i bakken samme vej ned igen. <br><br>Når du er tilbage på vejen, kør til den sidste parkeringsplads."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Tidligt ude"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "I dette scenarie skal du manøvrere gennem en overfyldt plads. Der er meget lidt plads, så prøv at planlægge din rute på forhånd."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Nogle gange er der så lidt plads, at andre chauffører parkerer, hvor de kan, hen over natten. Det kan gøre det ret besværligt at manøvrere forbi dem om morgenen.<br><br> Gør dit bedste for at komme gennem pladsen til din parkeringsplads."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Snoet"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "I dette scenarie har du til opgave at køre gennem et meget komplekst træningsforløb. Undervejs skal du finde og koble til en trailer, og derefter tage den med dig til enden."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Dette scenarie vil teste din rumlige og situationsfornemmelse. Den forudestående rute er fuld af forhindringer, som du ikke altid let vil kunne få øje på."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Find vej gennem ruten til traileren. Når du har fundet den, skal du koble den til og trække den til den sidste parkeringsplads."



#@}

#+ Book 2 vertigo
#@{
