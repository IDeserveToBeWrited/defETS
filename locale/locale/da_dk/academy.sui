#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "I det sidste scenarie i dette kapitel vil vi køre på en testbane med en kompleks konfiguration."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Den første forhindring er en slalom mellem nogle barrierer. Kør gennem den og husk at bruge dine spejle."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Nu kommer et hårnålesving. Hold dit sving bredt og du burde ikke få problemer."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Her er der er et 90 graders venstresving. Husk at køre dybt, så bagenden af lastbilen kommer fri af de indre barrierer."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Rampeforhindringen kan være lidt lusket. Prøv at flugte så godt du kan, før du kører ind på den, og brug dine front- og sidespejle til at orientere dig efter."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Den næste sektion skal gennemføres i bakgear. Hav det i baghovedet når du nærmer dig barriererne længere fremme."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Følg vejmarkeringerne bagved og til din højre side."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Bak hen til barrierne, stands så og fortsæt frem til venstre."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Fortsæt gennem hullet i midterrabatten til næste sektion."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Denne passage mellem keglerne er meget snæver. Kør langsomt og brug dine spejle til at orientere dig efter i passagen."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Husk at køre dybt ved 90 graders-sving."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Du kommer til en behageligt åben del af vejen. Du kan køre lidt hurtigere, men husk at du snart vil skulle sætte farten ned ved den kommende kurve."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Ved foden af bakken er nogle barrierer over vejen. Kør op til dem og bak så ind på parkeringspladsen til venstre."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Bak til parkeringspladsen."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Parker, sluk motoren og sikr lastbilen."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Foran dig er en slalombane af barrierer.<br><br><font face=/font/big_bold.font>Kør gennem banen.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Hold dig mod ydersiden af svinget for at sikre dig at bagenden af trækkeren ikke kører over kantstenen.<br><br><font face=/font/big_bold.font>Lav svinget. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Du nærmer dig et 90 graders venstresving. Hus at bruge al den plads du har til rådighed.<br><br><font face=/font/big_bold.font>Gennemfør svinget. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Flugt lastbilen med rampen. Der er ikke megen plads til korrektioner, når du først er på den.<br><br><font face=/font/big_bold.font>Kør over rampen. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Følg banen til venstre. </font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Den følgende sektion skal gennemføres i bakgear. Stands ved barriererne længere fremme, så du kan bakke til højre efterfølgende.<br><br><font face=/font/big_bold.font>Stands ved barriererne.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Bak mod området bag dig til højre. Pilene på vejen vil hjælpe dig.<br><br><font face=/font/big_bold.font>Bak mod den næste sektion. </font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Bliv ved med at bakke mod barriererne bag dig.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stands and skift til et fremadrettet gear. Fortsæt så mod venstre. <br><br><font face=/font/big_bold.font>Kør frem. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Der er et hul i midterrabatten til venstre. Kør gennem det.<br><br><font face=/font/big_bold.font>Fortsæt fremad. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Foran dig er en smal, bugtende rute mellem nogle kegler. Kør forsigtigt og brug dine spejle hvis nødvendigt.<br><br><font face=/font/big_bold.font>Kør mellem keglerne. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Fortsæt gennem banen.<br><br><font face=/font/big_bold.font>Drej til venstre. </font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Husk at holde til venstre inden svinget for at give dig selv så megen plads som muligt.<br><br><font face=/font/big_bold.font>Gennemfør svinget. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Kør videre. </font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Du kan sætte farten op her, men der kommer en kurve længere fremme.<br><br><font face=/font/big_bold.font>Fortsæt gennem banen. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Kurven bliver skarpere efterhånden som du kører gennem den.<br><br><font face=/font/big_bold.font>Tilpas farten og fortsæt.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "For foden af bakken vil du se nogle barrierer, som blokerer vejen. <br><br><font face=/font/big_bold.font>Stands i nærheden af barrierne. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Bag dig til venstre er der en parkeringsplads.<br><br><font face=/font/big_bold.font>Bak ind på parkeringspladsen. </font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Stands på det markerede sted. </font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Kørsel på testbane"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "I dette scenarie vil vi køre på en bane, som er designet til at teste din evne til at styre lastbilen gennem forskellige typer kurver og sving."

#### 2_08 goal



	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Kør ind på banen"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Lav et gradvist venstresving"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Kør gennem S-kurver"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Lige stykke"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Lette sving"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Forlad træningsbanen"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Nærm dig parkeringspladsen"
