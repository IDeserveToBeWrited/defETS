#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Træningsbanen vil give dig en beskyttet forsmag på kørsel i den virkelige verden. Tag nogle af dine nye evner i brug og husk at være opmærksom på dine omgivelser og at bruge al den plads, du har til rådighed.<br><br>Det er også altid en god idé at tænke fremad!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Kør fremad og ind på banen."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Længere fremme kommer en sektion, som går ned ad bakke. Du kan bruge den til at få en følelse for, hvordan dobbelttrailere opfører sig ved højere hastigheder."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Gør klar til at bremse inden det kommende sving."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Kryds midterrabatten ved at dreje til højre og straks herefter til venstre."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Kryds igen midterrabatten."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Der er tidspunkter, hvor du ikke har andet valg end at sammenfolde hele kombinationen. <br><br>Gør, hvad du er nødt til for at komme gennem dette ekstremt skarpe sving."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Fortsæt kørslen på banen."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Kør forsigtigt gennem slalombanen, mens du ikke kun sikrer dig, at dine trailere kommer helskindede forbi barriererne, men også, at du nærmer dig de efterfølgende barrierer korrekt."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Fortsæt til venstre og kør ligeud gennem krydsene."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Følg det asfalterede område til højre."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Det sidste sving snyder lidt. Der er masser af plads, men vær forberedt på at parkere op mod den fjerne kantsten."

#!{
	key[]: "aca_msg_book3_train_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_train_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ double_90
#@{

#### double_90 common

	key[]: "aca_scenario_book3_double_90_title"
	val[]: "90 graders-sving"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "I dette scenarie skal du køre gennem en bane med 90 graders sving af forskellig sværhedsgrad."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Kom i gang"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Fremad"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Brug dine spejle"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Der er plads nok"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Sæt brikkerne på plads"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Tænk fremad"

#!{
	key[]: "aca_goal_book3_double_90_check5"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_goal_book3_double_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Banen længere fremme vil hjælpe dig med at lære, hvordan du styrer dobbelttrailere gennem 90 graders sving af forskellig sværhedsgrad."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "De første hjørner er ret brede med masser af plads. Brug dem til at få en føling med trailerne bag dig, når du drejer."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Fra nu af bliver svingene skarpere og mere krævende. Nærm dig langsomt og husk at køre langt ind i svingene, så dine trailere har plads nok til at følge dig."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Dette er et af banens skarpeste sving. Det kan være en hjælp at bruge den lille smule plads til højre for at få dine trailere forbi de drilagtige kegler på indersiden."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Du skal altid have næste sving i tankerne - når du forlader et sving, skal du straks lægge en plan for, hvordan du vil nærme dig det næste."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Hold altid øje med dine trailere, helt indtil de er fri af alle forhindringer."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Fortsæt frem mod første sving."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Hold øje med spejlene, mens du kører, så du lærer, hvordan trailerne følger dig."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Kør mod ydersiden inden hvert sving. Dette er essentielt for at give dig den plads, du får brug for, når trailerne skal rundt om hjørnet."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Den rigtige fremgangsmåde er essentiel ved de næste sving, da de følges af en meget skarp kurve. Hvis du laver en fejl i begyndelsen, kan du betale dyrt senere. <br><br>Arbejd langsomt og grundigt og hold øje med dine omgivelser."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Dette sving er ekstremt skarpt og fører direkte ind i endnu et skarpt sving. Du skal ikke kun overveje, hvordan du kører ind i svinget, men også hvordan du forlader det og forbereder dig på næste."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Kør videre gennem de sidste sving mod det angivne område."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Første bak"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "I dette scenarie vil vi for første gang bakke med en dobbeltkombination."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Ingen stress"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "At bakke med dobbelttrailere kræver en helt ny måde at tænke på, hvad du gør. I stedet for bare at styre en enkelt trailer, er du nu nødt til at bruge din forreste trailer til at styre den bagerste. <br><br> Brug dette scenrarie til at få en føling med, hvordan det hele fungerer. Der er ikke noget særligt mål; bare giv dig tid og forsøg at finde ud af, hvad der foregår."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Når du starter fra en lige position, kan du dreje trækkeren i samme retning, som du vil have, at den bagerste trailer skal bevæge sig. <br><br>Vær ikke for ivrig - det er nok at få traileren til at pege i den retning, du vil have den, og så kan du rette trækkeren op, så den flugter med den forreste trailer, og lade den bagerste klare ærterne."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Når din bagerste trailer har den retning, du vil have den til at bevæge sig i, kan du styre den forreste trailer ind, så den følger samme retning. <br><br>Så snart den forreste følger den bagerste, kan du bruge trækkeren til at justere vinklen mellem de to trailere, alt efter om du vil dreje skarpere eller mere glidende."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Der findes ikke nogen præcis opskrift for at få det til at lykkes - du er bare nødt til at holde øje med, hvad der sker, lære af dine fejl og blive ved med at øve dig. <br><br>Når du er tilfreds, kan du køre til det markerede område og sikre køretøjet. <br><br>Bare brug så meget tid på at eksperimentere her, som du har lyst til."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Begynd langsomt at bakke. Husk at starte med små korrektioner - der er ingen grund til at folde hele trækket sammen med det samme.<br><br>Prøv at køre lige bagud eller bring trailerne mod førersiden."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Giv dig god tid og bliv ikke frustreret. <br><br>Enhver mester var engang en begynder."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Første korrektion når du bakker"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "I dette scenarie skal vi fortsætte, hvor en anden gav op."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Baglænskørsel"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Åh nej! Nogen blev vist lidt frustreret, mens de bakkede, og har efterladt deres lastbil midt på pladsen."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Det kan ikke undgås, at der vil være tidspunkter, hvor det går helt i kludder. Det gør ikke noget - kør bare fremad, indtil trailerne er rettet så meget op, at du har noget, du kan arbejde videre med. <br><br>Hvis du er i tvivl, kan du altid sigte mod at rette helt op, så du kan starte på en frisk."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Dette er en forholdsvis god position at starte fra. Den bagerste trailer peger stadig i den retning, vi vil have den i, og vi kan hurtigt få trækkeren ind foran den forreste trailer, så vi kan få hele kombinationen styret i den retning, vi vil have den."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Fortsæt til det anviste område og sikr lastbilen. <br><br>Du kan frit øve dette scenarie, indtil du føler dig tryg ved at manøvrere med trailerne."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Den her kan ikke reddes. Kør fremad, så du får noget at arbejde med."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Begynd at bakke."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Baglænskørsel ligeud"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "I dette scenarie skal du bakke et sæt dobbelttrailere i en lige linje."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Baglænskørsel"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Ved første blik kan det at bakke lige bagud synes lettere, men det er faktisk meget mere besværligt. <br><br>I stedet for bare at ændre på vinklen mellem de to trailere er du nu nødt til at holde øje med begge sider for at holde kombinationen lige."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Læg ud med forholdsvis små korrektioner. Det er i orden, hvis du ender med at slingre lidt til hver side, bare husk, at du skal holde vinklen mellem trækkeren og den forreste trailer lidt længere for at ændre vinklen mellem den forreste og den bagerste trailer."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Du kan være nødt til at slå nogle ret kraftige sving med trækkeren for at holde den bagerste trailer peget i den rigtige retning, men hvis du forsøger ikke at overdrive i første omgang, bliver det slet ikke nødvendigt."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Du kan køre frem for at rette op så mange gange, du har brug for. Så længe du ender sikkert på parkeringsstedet, er resten ikke så vigtig."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Begynd langsomt at bakke."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Ret op og stands i det anviste område."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Sikr køretøjet og sluk motoren."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Korrigering ved lige baglænskørsel"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "I dette scenarie vil du overtage styringen efter, at en anden allerede har forsøgt at bakke lige. Ret deres fejl og parker lastbilen i det anviste område."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "At rette op"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Baglænskørsel"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Nogen har forsøgt at bakke denne kombination in på parkeringsstedet, men fik lidt problemer. Nu er det op til dig at redde dagen!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Første trin er at køre frem, så alt bliver rettet op, og vi har noget at arbejde med. Det er vigtigt at få den bagerste trailer peget i den retning, du vil have den til at bevæge sig i."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "I dette tilfælde har vi valt at bevæge os mere i retning af førersiden. Dette vil give os bedre udsyn til, hvad vi laver, når vi bakker, og tillade os at arbejde fra én side. <br><br>Husk at du styrer den bagerste trailer ved hjælp af den forreste, så fokuser ikke for meget på selve trækkeren."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Kombinationen er mere eller mindre, hvor vi vil have den, men lad os alligevel køre lidt frem for at centrere den bedre."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Herfra vil vi meget forsigtigt bakke ind på plads, mens vi sikrer os, at den bagerste trailer holder retningen perfekt."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Nu kan vi rette trækkeren og den forreste trailer op i forhold til hinanden."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Kør frem og ret alt op. <br><br>Når du er tilfreds, kan du bakke ind på det anviste område."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Bak mod det angivne område."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Sikr køretøjet og sluk motoren."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Baglænskørsel i 90 graders-sving"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "I dette scenarie skal du bruge en 90 graders bakkemanøvre for at parkere i en række af andre lastbiler."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "U-sving"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Klargøring"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Bakning"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "At bakke til en side er lettere med dobbelttrailere, da du vil have bedre udsyn ud ad sidevinduet."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Kør først frem og lav et U-sving for enden af rækken. Dette gør det muligt for dig at starte fra en position med bedst udsyn ud ad vinduet på førersiden."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Du kan vælge at placere trailerne, lige som du har lyst til - måske med den bagerste trailer, så den allerede peger i den rigtige retning. I dette eksempel vil vi starte med en helt lige position. <br><br>Husk at holde det enkelt - styr den bagerste trailer ved hjælp af den forreste."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Styr den forreste trailer en anelse væk fra parkeringsstedet, og den bagerste vil begynde at pege mod stedet. Derfra kan du justere vinklen mellem de to trailere for at køre i en rar, blød kurve ind til parkeringen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Husk, hvis den bagerste trailer kommer for skarpt ind, vil du skulle gøre vinklen mellem de to trailere blødere. Hvis den bagerste trailer ikke drejer nok, skal du gøre vinklen skarpere."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "De rettelser, du laver med trækkeren, har halvt så stor effekt på den bagerste trailer, som de har på den forreste, så være ikke bange for virkelig at bruge trækkeren."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "Nu er du nødt til at tænke fremad. Du skal også have den forreste trailer ind på pladsen, så find en plan for, hvordan du får den rettet op foran den bagerste."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Det er meget sjældent at det lykkes at få trailerne ind i første forsøg. I dette tilfælde ventede vi for længe, inden vi rettede den forreste trailer op, og nu bevæger den bagerste sig i den forkerte retning. <br><br>Ikke noget problem - kør blot frem og prøv igen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Bare brug rattet og få de trailere derhen, de skal. Du kan køre frem igen, lige så mange gange, du har brug for, indtil du er tilfreds."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Og sådan! Vi har succesfuldt parkeret med dobbelttrailere."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Kør frem til enden af pladsen og drej rundt."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Husk at dreje bredt."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Fortsæt fremad til du føler, du har plads nok til at manøvrere, og begynd så at bakke."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Bak ind på parkeringspladsen, hvis du føler, du har plads nok til at manøvrere."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


