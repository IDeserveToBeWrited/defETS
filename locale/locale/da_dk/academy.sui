#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Velkommen til @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "De følgende scenarier udgør de første trin på din vej mod professionel lastbilkørsel."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Her vil du lære alt fra de grundlæggende systemer og styring af lastbilen..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...til komplekse manøvrer både med og uden trailer."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Vi hjælper dig med at få vaner, som vil hjælpe dig til sikkert at navigere forskellige situationer,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "og vi lærer dig at udnytte den ledige plads til at manøvrere din lastbil effektivt."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Ved at gennemføre alle scenarierne og bestå de afsluttende eksamener,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "vil du blive klar til Europas veje på jagten efter nye udfordringer."

#@}

