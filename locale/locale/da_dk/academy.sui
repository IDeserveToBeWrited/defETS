	key[]: "aca_msg_book3_night_slalom_double_forward"
	val[]: "Fortsæt når du er klar. <br><br>Husk at tænde lysene!"

	key[]: "aca_msg_book3_night_slalom_double_check0"
	val[]: "Kør gennem slalommen."

	key[]: "aca_msg_book3_night_slalom_double_stop"
	val[]: "Stands i det anviste område."

	key[]: "aca_msg_book3_night_slalom_double_end"
	val[]: "Sikr køretøjet og sluk motoren."



#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Parkering langs en kurve"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "I dette scenarie skal du køre gennem en travl plads fuld af ubelejligt parkerede lastbiler for til sidst at parkere langs en kurve."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Det er ikke unormalt at ankomme til en plads, som er næsten helt fyldt op med lastbiler, så du selv har meget få valgmuligheder, når du skal parkere."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "I dette tilfælde er der kun en fri plads, hvor en dobbeltkombination kan passe ind. <br><br>Kør gennem pladsen og parker i kurven tæt på udkørslen."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Find en vej gennem pladsen og parker langs kurven. <br><br>Fortsæt, når du er klar."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Der er ikke helt plads til dig gennem dette sving, så du vil være nødt til at bakke og finde en anden vej gennem."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Parker i kurven længere fremme."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Stands i det anviste område."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Sikr lastbilen og sluk motoren."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Afsluttende eksamen"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "I dette scenarie vil du få afprøvet dine nye evner på en bane designet til at teste din præcision og forståelse for, hvordan man kører med dobbelttrailere."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Baglænskørsel"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Kør ind på banen"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Få hastigheden op"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Gør klar til at bremse"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "For lav hastighed"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Parkering"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Velkommen til den afsluttende eksamen. Vi har forberedt nogle realistiske situationer, som du kunne støde på, for at se, hvordan du vil håndtere dem. Giv dig som altid god tid og være præcis. <br><br>Held og lykke!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Vejen frem er blokeret, så vend i den tilgængelige plads."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Fortsæt ind på banen."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Nå en hastighed på mindst 60 km/t (37 mph) mens du fortsætter ned ad bakken."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Gør klar til at bremse."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Du nåede ikke en hastighed på 60 km/t (37 mph.)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Fortsæt kørslen på banen."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Der er en plads til dig i rækken af lastbiler til højre. Bak ind og parker."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Fortsæt fremad, når du er klar."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

