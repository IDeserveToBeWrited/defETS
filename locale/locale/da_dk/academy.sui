#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Afsluttende eksamen (del 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Den sidste del af den afsluttende eksamen venter dig. Her vil de parkeringsfærdigheder, du har lært i de tidligere scenarier, blive evalueret. Parker forsigtigt og præcist, og du vil være klar til at køre ud på de europæiske veje som en erfaren trucker!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Forskudt manøvre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Diagonal parkering"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Kør gennem parkeringspladsen"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parallelparkering"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Sidste parkering"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Velkommen til anden del af den afsluttende eksamen. Vi vil begive os til en nærliggende parkeringsplads og teste dine evner, når det kommer til baglænskørsel og manøvrering i forbindelse med parkering."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Flere på hinanden følgende parkeringsudfordringer venter dig for at teste dine evner."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Der er begrænset plads her, så vær forsigtig og giv dig god tid."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Husk at være forsigtig og ikke forhaste dig. Det er okay, hvis du ikke kan få den ind i første forsøg - det vigtigste er ikke at skade lastbilen eller dem, der befinder sig omkring dig. <font face=/font/big_bold.font><br><br>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Kør frem til den første del af eksamenen.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Din første opgave er at udføre den forskudte parkeringsmanøvre. Pladsen, du skal bakke traileren mod, ligger på din venstre side.<br><br><font face=/font/big_bold.font>Udfør en forskudt parkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Næste opgave er at bakke ind ved en række af parkerede lastbiler. Vær opmærksom på ikke at ramme de andre lastbiler!<br><br><font face=/font/big_bold.font>Foretag en diagonal parkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Fortsæt gennem parkeringspladsen. Hold øjnene åbne efter uventede situationer.<br><br><font face=/font/big_bold.font>Kør videre.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Lad os nu prøve parallelparkering mellem de to lastbiler ved kantstenen længere fremme.<br><br><font face=/font/big_bold.font>Foretag en parallelparkering.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Én sidste parkeringsmanøvre til venstre for dig! Du kan vælge at nærme dig den præcis, som du har lyst til.<br><br><font face=/font/big_bold.font>Bak ind på det angivne område.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Vi er næsten færdige. Forlad testområdet og parker lastbilen.<br><br><font face=/font/big_bold.font>Forlad testområdet på din venstre side.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Du kan parkere lastbilen til højre sammen med de andre.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parallelparkering med trailer"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "I dette scenarie tager vi et kig på parallelparkering med traileren tilkoblet."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Stands i det markerede område"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parallelparkering med en trailer er en relevant færdighed for alle lastbilchauffører.<br>Hvad end det er parkering på gader i storbyer eller et stop på en rasteplads ude i landet, er det noget enhver chauffør bør mestre."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Hold godt øje når du passerer parkeringspladsen for at være sikker på, at der er plads nok til både trækker og trailer. I dette eksempel har vi sikret os, at du har masser af plads."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Flugt med lastbilen foran parkeringspladsen. Kør ikke for tæt på den, men hold lidt afstand, så du har plads til at manøvrere."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Drej skarpt væk fra parkeringspladsen og begynd at bakke. Idéen er at få traileren til straks at dreje ind på parkeringspladsen."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Når traileren peger godt ind på pladsen, kan du begynde at følge den."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Begynd at styre traileren væk fra kantstenen før dens hjul på førersiden har nået pladsen."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Ret trækkeren op i forhold til traileren og centrer dig herefter i parkeringsområdet.<br> Parker, sluk motoren og sikr køretøjet."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Du kan se parkeringsområdet mellem de andre lastbiler foran dig. Vær sikker på at holde øje med dine spejle og hold sikker afstand mellem lastbilen og forhindringerne omkring dig, når du parkerer.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Kør gennem pladsen for at finde din parkeringsplads.<br><br><font face=/font/big_bold.font>Kør fremad. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Kør forbi din ønskede parkeringsplads ind på det markerede område. Herfra kan du begynde din bakkemanøvre.<br><br><font face=/font/big_bold.font>Stands på det markerede sted. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Drej trækkeren væk fra punktet for at begynde at dreje traileren mod det. Drej ikke for kraftigt, ellers rammer du kantstenen. <br><br><font face=/font/big_bold.font>Begynd at bakke. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Juster traileren med stedet. Gå om nødvendigt frem eller tilbage, mens du foretager de nødvendige styreinput for at justere din position.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "Tillykke. Du har gennemført eksamenerne i Grundlæggende lastbilkørsel og har lært alle de færdigheder, som er nødvendige for at kunne manøvrere din lastbil succesfuldt."

	key[]: "aca_msg_book1_outro02"
	val[]: "Dette er første trin på din rejse mod at gøre din drøm om at blive professionel lastbilchauffør til virkelighed."

	key[]:	"aca_msg_book1_outro03"
	val[]: "Du er nu klar til at køre ud på de europæiske veje og møde dine første udfordringer..."

	key[]: "aca_msg_book1_outro04"
	val[]: "... men eventyret er kun lige begyndt."
#@}


