#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Rundkørsler er lidt mere komplicerede med dobbelttrailere end med en enkelt trailer."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Du skal køre så langt ind, at begge trailere vil nå ind, men du vil skulle holde mod ydersiden for at holde trailerne væk fra midten."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "Det er okay, hvis begge trailere ikke holder sig til én kørebane - faktisk kan det næsten være bedre at fylde to baner, så en optimistisk traffikant ikke forsøger at køre forbi dig."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Kør til den fjerne ende af din frakørsel for igen at sikre dig, at begge trailere ikke kolliderer med genstande i vejsiden."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Fortsæt til næste rundkørsel."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Denne rundkørsel har kun ét spor, så tag dig god tid og vær præcis."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Brug al den plads, du har - at småsnyde her gør bare det hele mere besværligt."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Benyt frakørslen og fortsæt til parkeringsområdet."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Parker og sikr lastbilen."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Du er på en bane, som vil lære dig at køre gennem rundkørsler. Fortsæt fremad, når du er klar."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Kør godt ind i rundkørslen, inden du kører udad mod de ydre kegler for at sikre dig, at begge trailere når helskindet ind."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Det er bedst at køre til den fjerne ende af frakørslen for at forhindre dine trailere i at ramme keglerne. <br><br>Det kan være en hjælp at køre ind mod midten af rundkørslen, lige inden du forlader den."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Du bør være i stand til at køre gennem denne på egen hånd. Tag dig god tid og brug den plads, du har."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Kør forsigtigt ud af rundkørslen."

#!{
	key[]: "aca_msg_book3_3_11_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_3_11_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


