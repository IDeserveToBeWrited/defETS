#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Bakke-sandkasse"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "I dette scenarie bliver du placeret på en tom parkeringsplads, så du kan øve at bakke med dobbelttrailere."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Kom i gang"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentering"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Færdiggøre"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Afslutte scenariet"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Man skal være meget mere opmærksom, når man bakker med dobbelttrailere, end med en enkelt trailer. Du er nødt til at planlægge, hvor du vil have den bagerste trailer hen, samtidig med at du har styr på både den forreste trailer og trækkeren. <br><br>Tænk på det på denne måde: Du skal bruge den forreste trailer til at styre den bagerste."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "I dette tilfælde vil vi styre den bagerste trailer mod førersiden. For at styre den vej, er vi nødt til at skubbe den forreste trailer mod passagersiden. <br><br>Bemærk, at det grundlæggende betyder, at du skal dreje den forreste trailer i den modsatte retning af, hvor du vil have den bagerste trailer hen."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Når den bagerste trailer begynder at dreje, er det vigtigt at rette op og flugte trækkeren med den forreste trailer. Det er her, de fleste ofte laver deres første fejl."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Her ser vi, at føreren ikke har flugtet med den forreste trailer og er ved at få trailerne til at \"folde sammen\"."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Sammenfoldning sker, når vinklen mellem to sammenkoblede køretøjer bliver omtrent 90 grader. Når det først sker, er der ingen udvej - du er nødt til at køre frem og prøve igen. <br><br> Ligesom når du bakker med en enkelt trailer, skal målet altid være, at alle hjul på traileren bevæger sig. Når først ét hjul står stille, og traileren drejer på stedet, kan du ikke fortsætte."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Du kan køre fremad til det sted, du sidst stod korrekt, eller rettere til en position, hvor du kan arbejde videre i bakgear uden at ende i samme situation igen. <br><br>I dette tilfælde vil vi køre frem til en lige position og prøve igen fra begyndelsen."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Som før, når den bagerste trailer begynder at dreje, skal du få trækkeren foran den forreste trailer og lade den bagerste dreje for sig selv et øjeblik."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nu da den bagerste trailer drejer derhen, hvor vi vil have den, er det tid til at få den forreste trailer til at følge efter. Du kan justere vinklen mellem de to trailere for at gøre, hvor meget de drejer, større eller mindre."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Den sidste del af manøvren er at rette det hele op. Få den forreste trailer til at flugte med den bagerste."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Du skal være opmærksom på, hvor lang tid det vil tage at flytte den forreste trailer. Hvis du venter for længe, vil den bagerste trailer begynde at søge tilbage mod det sted, du lige kom fra!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Bare brug så lang tid, du har lyst til her, og eksperimenter med forskellige manøvrer, indtil du synes, du har en idé om, hvordan man håndterer trailerne i bakgear.<br><br>Men vigtigst af alt: Husk at have det sjovt!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Gør klar til start."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Brug denne parkeringsplads til at få en føling med, hvordan man håndterer trailerne i bakgear. <br><br>@@aca_goal_tip@@ Er du ny til at bakke med trailere generelt? Overvej at prøve kurset Grundlæggende lastbilkørsel."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Bare brug så lang tid, som du har lyst, til at øve. <br><br>Når du er tilfreds, kan du stoppe og sikre lastbilen for at afslutte scenariet."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Sluk motoren for at afslutte scenariet."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkering med lidt plads"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "I dette scenarie skal du parkere et sæt dobbelttrailere et smalt sted."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Kom i gang"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Kom i gang"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Kør videre"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Standsning"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Sikring af køretøjet"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Det kan virke lidt skræmmende at køre med dobbelttrailere, men det er ikke så anderledes end at køre med en enkelt trailer - du skal blot også være opmærksom på hvilken vej, den bagerste trailer bevæger sig!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Foran dig ser du et smalt parkeringssted. Du vil ikke have plads nok til at rette helt op, inden du kører ind, så du vil skulle overveje nøje, hvordan du vil få begge trailere på plads."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Drej med det samme mod den fjerne side af parkeringsstedet og kør et godt stykke forbi det sted, du normalt ville dreje ind."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Nu da den bagerste trailer er på plads, kan du bevæge sig mod parkeringsstedet, men husk igen at sigte mod den fjerne side for at få den forreste trailer med rundt."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Fortsæt ind på parkeringsstedet, og begge trailere vil følge dig og rette op, efterhånden som du kører."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parker i det angivne område og sikr lastbilen."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Gør klar til start."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Fortsæt fremad ind i det smalle rum."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Kør videre."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Stands i det anviste område."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Sikr lastbilen og sluk motoren."
#@}


#+ Book 3 Scenario infinite Fun
#@{

#### 3_11 common

	key[]: "aca_scenario_book3_3_11_title"
	val[]: "Masser af sjov"

	key[]: "aca_scenario_book3_3_11_desc"
	val[]: "I dette scenarie vil vi køre gennem to forskellige rundkørsler med dobbelttrailerne."

#### 3_11 goal

#!{
