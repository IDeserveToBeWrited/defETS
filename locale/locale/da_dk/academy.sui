#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkering ved siden af en forhindring"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "I dette scenarie lærer vi at parkere ved kantstenen ved hjælp af sidespejlet."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Tjek sidespejlet"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Kør hen mod kantstenen"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Sidespejlet er endnu et værktøj, som vil hjælpe dig med at manøvrere lastbilen sikkert. Det er placeret på den øvre del af døren på passagersiden."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "Kør frem og drej langsomt mod din passagerside."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Disse træplanker gør det ud for en kantsten. Du vil skulle parkere ved siden af den. <br>Drej mod kantstenen for at få lastbilen i en god position i forhold til parkeringspladsen."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Sæt farten ned inden kantstenen og drej mod parkeringspladsen. Mens du retter op, kan du bruge sidespejlet til at bedømme afstanden til kantstenen."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Stands på parkeringspladsen og sikr lastbilen."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Se gennem vinduet på passagersiden. Du kan se sidespejlet.</font>@@aca_goal_tip@@ Du er nødt til at være inden i køretøjet."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "Sidespejlet dækker området på passagersiden, som chaufføren ikke kan se. Det er en af de mest problematiske blinde vinkler på lastbilen. Hvis spejlets vinkel ikke passer dig, kan du rette den i '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Lastbilen er stadig ikke klar til at køre. Måske er der noget, du har glemt?<br><br>Er motoren tændt? Har du løsnet håndbremsen?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Foran dig er der en linje af planker, som gør det ud for en kantsten. For enden af kantstenen er en parkeringsplads. Du vil skulle køre derhen. <br><br><font face=/font/big_bold.font>Fortsæt når du er klar. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Drej mod kantstenen. Brug front- og sidespejlene for at tjekke din position i forhold til kantstenen, men vær også opmærksom på ikke at køre over trafikkeglerne.<br><br><font face=/font/big_bold.font>Kør mod kantstenen og ind på parkeringspladsen.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Sikr lastbilen og sluk motoren.</font>@@aca_goal_tip@@ Du kan bruge forudindstillinger for kabineudsyn for at gøre det lettere at se på spejle. Tjek Indstillingsskærmen - Taster og knapper' for at se og ændre på indstillingerne."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Baglæns parkering ved siden af en forhindring"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "I dette scenarie vil vi bakke lastbilen ind på en parkeringsplads ved siden af en kantsten."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instruktioner"

	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Baglænskørsel mod kantstenen"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Parker lastbilen"
