	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Následující trať tě seznámí se zatáčením dvojitých návěsů přes pravoúhlé zatáčky s různou obtížností."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Prvních několik zatáček je docela širokých a nabízí spoustu prostoru. Využij ho k tomu, abys sis udělal představu o zatáčení návěsů za sebou."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Od této chvíle budou zatáčky užší a techničtější. Najížděj k nim pomalu a ujisti se, že do zatáček vjíždíš co nejhlouběji, aby tvé návěsy měly prostor pro udržení stopy."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Toto je jedna z nejužších zatáček na trati. Možná se bude hodit využít malého prostoru napravo, abys s návěsy objel ty otravné vnitřní kužely."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Vždy bys měl myslet na to, co bude následovat - během toho, co opouštíš jednu zatáčku, už si připravuj plán na průjezd další."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Vždy dávej pozor na své návěsy, dokud nejsou zcela mimo dosah jakýchkoli překážek."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Pokračuj vpřed směrem k první zatáčce."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Sleduj zpětná zrcátka, abys vnímal, jak se návěsy za tebou pohybují."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Před každou zatáčkou si najeď ze široka, což je klíčové, abys měl dostatek prostoru pro otočení návěsu v zatáčce."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Příprava na následující zatáčky je klíčová, protože za nimi následuje velmi ostrá zatáčka. Chyba na začátku ti vše může zkomplikovat i později.<br><br>Jeď pomalu, rozvážně a dávej pozor na své okolí."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Tato zatáčka je extrémně úzká a vede přímo do další úzké zatáčky. Musíš zvážit nejen to, jak do zatáčky vjedeš, ale také jak z ní vyjedeš a jak se připravíš na další."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Pokračuj v jízdě přes poslední zatáčky směrem k vyznačené oblasti."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "První couvání"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "V tomto scénáři si poprvé zacouváme s dvojitými návěsy."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Uvolni se, neměj obavy"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Couvání s dvojitým návěsem vyžaduje zcela nový způsob uvažování o tom, co děláš. Namísto pouhého řízení návěsu nyní používáš přední návěs k řízení návěsu za ním.<br><br>Využij tohoto scénáře pro získání představy o tom, jak to celé funguje. Neexistuje žádný konkrétní cíl, zkrátka nespěchej a snaž se pochopit, o co jde."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Z přímé polohy můžeš natočit tahač stejným směrem, kterým chceš, aby jel i zadní návěs.<br><br>Ale nepřeháněj to; stačí, když zadní návěs nasměruješ požadovaným směrem, poté můžeš tahač vyrovnat s předním návěsem a nechat zadní návěs jet svou cestou."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Jakmile se zadní návěs vydá požadovaným směrem, můžeš zatočit přední návěs tak, aby také jel stejným směrem.<br><br>Jakmile přední návěs následuje zadní, tahačem upravuj úhel mezi oběma návěsy pro ostřejší nebo širší zatáčku."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Neexistuje žádný přesný recept, jak to udělat správně, stačí ale věnovat pozornost tomu, co se děje, poučit se ze svých chyb a neustále cvičit.<br><br>Jakmile budeš spokojen, můžeš se vydat na vyznačené místo a zajistit vozidlo.<br><br>Neváhejte zde strávit tolik času experimentováním, kolik jen budeš potřebovat."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Začni pomalu couvat. Nezapomeň začít s drobnými pohyby, abys hned nezalomil soupravu.<br><br>Zkus jet rovně dozadu nebo přistavit návěs ke straně řidiče."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Nespěchej a nenech se vystresovat.<br><br>Každý mistr byl jednou začátečníkem."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

