#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Závěrečná zkouška (druhá část)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Čeká tě poslední část závěrečné zkoušky, kde budou vyhodnoceny parkovací dovednosti, které ses naučil v předchozích scénářích. Parkuj efektivně a přesně a budeš připraven vyrazit na evropské silnice jako zkušený kamioňák!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Couvání do strany"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Parkování pod úhlem"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Jízda po parkovišti"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Podélné parkování"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Závěrečné parkování"
