	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

 #!}

#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Vyzkoušíš si couvání s návěsem. Je to jednodušší, než se zdá, jen musíš být trpělivý."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Začni couvat a vyrovnej tahač s návěsem."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Ujisti se, že jsi pořádně vyrovnán, jinak se nebudeš moci připojit. Pokud nejsi správně, můžeš vždy popojet dopředu a zkusit to znovu."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Točnice tahače se uzamkne s královským čepem na návěsu."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Zatáhni ruční brzdu a připoj návěs. Ve skutečném světě musíš vystoupit, připojit vzduch, elektrické kabely a zvednout podpěry, ale zde to uděláme za tebe."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Návěs vždy zatáčí na <color value=@@clr_sel@@>opačnou<color value=@@clr_txt@@> stranu než tahač."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Tahačem musíš zatáčet <color value=@@clr_sel@@>opačným<color value=@@clr_txt@@>směrem než tam, kam chceš zatáčet návěs."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Abys návěs znovu vyrovnal, zatoč <br><color value=@@clr_sel@@>k němu<color value=@@clr_txt@@> tahačem."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Pokus se zůstat srovnaný s návěsem - budeš muset neustále dělat drobné korekce, aby návěs stále mířil k vyznačené oblasti."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Odchylky koriguj lehkým zatáčením volantu, jakmile k nim dojde. Pokud to přeženeš, můžeš se dostat mimo požadovanou dráhu."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Zastav na vyznačeném místě. Zajisti kamion a vypni motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Za tebou na straně spolujezdce je návěs. Tvým prvním úkolem je k němu zacouvat.<br><br><font face=/font/big_bold.font>Připrav tahač k couvání.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Začni couvat k návěsu.</font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Srovnej se s návěsem. Točnice musí zachytit královský čep. V případě potřeby si popojeď dopředu.<br><br><font face=/font/big_bold.font>Pokračuj v couvání, dokud neucítíš spojení.</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Točnice se spojila s královským čepem a jsi připraven k připojení tahače.<br><br><font face=/font/big_bold.font>Zatáhni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font>Stiskni @@imv_nrm_attach@@ pro přípojení návěsu.</font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Nyní je návěs připojen k tahači, vzduch a kabely jsou napojené a podpěry vytažené.<br><br><font face=/font/big_bold.font>Uvolni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Zacouvej na parkovací místo přímo za tebou. Nezapomeň, že návěs bude zatáčet v opačném směru než tahač. I drobný pohyb volantu může vést ke značnému vychýlení návěsu.<br><br><font face=/font/big_bold.font>Začni couvat s návěsem.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Nepřežeň to, snaž se udržet návěs vyrovnaný s parkovacím místem.<br><br><font face=/font/big_bold.font>Pokračuj k parkovacímu místu.</font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkování v úzkém prostoru"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "V tomto scénáři budeš parkovat v úzkém prostoru.<br><br>S návěsem musíš manévrovat tak, aby ses vyrovnal s posunutým parkovacím místem."

#### 3_06 goal


	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manévrování na místo"
#!{
	key[]: "aca_goal_book1_3_06_stop"
