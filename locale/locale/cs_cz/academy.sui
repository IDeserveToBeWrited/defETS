#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Vypadá to, že se někdo naštval při couvání a nechal svou soupravu uprostřed parkoviště."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Nevyhnutelně nastanou chvíle, kdy manévr úplně zkazíš. Neměj strach, prostě ze zalomené pozice vyjeď dopředu, dokud nebudeš ve stavu, ze kterého jde opět pokračovat.<br><br>Pokud si nejsi jistý, snaž se vše vyrovnat, abys začal z výchozí situace."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Tohle je slušná výchozí pozice. Zadní návěs je stále namířen tam, kam chceme, a my můžeme rychle dostat tahač před první návěs a začít řídit celou soupravu na místo určení."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Pokračuj na vyznačené místo a zajisti tahač.<br><br>Tento scénář si můžeš procvičovat znovu, dokud se při manévrování s návěsy nebudeš cítit pohodlně."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Z tohoto chaosu už se nedostaneš. Popojeď vpřed, abys měl s čím pracovat."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Začni couvat."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Rovné couvání"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "V tomto scénáři musíš zacouvat s dvojitými návěsy v přímém směru."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Couvání"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Couvání rovně se na první pohled může zdát jednoduché, ale ve skutečnosti je mnohem obtížnější.<br><br>Namísto pouhého korigování úhlu mezi návěsy na jedné straně musíš nyní hlídat obě strany, aby souprava zůstala rovná."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Začni s relativně malými korekcemi. Nevadí, pokud se budeš neustále přehoupávat ze strany na stranu, jen pamatuj, že musíš udržet úhel mezi tahačem a předním návěsem o něco déle, abys změnil úhel mezi předním a zadním návěsem."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Možná budeš muset s tahačem provést několik poměrně velkých manévrů, aby zadní návěs směřoval tam, kam chceš, ale snaž se to nepřehánět a pak k tomu ani nedojde."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Můžeš si několikrát popojet dopředu, abys vše zkorigoval. Důležité je hlavně bezpečně dojet na parkovací místo, zbytek už je jen formalita."

#### Straight Backing Driving Instructions

