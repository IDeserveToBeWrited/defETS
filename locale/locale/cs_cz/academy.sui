	key[]: "aca_goal_book1_3_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "V tomto scénáři budeš čelit řadě různých zatáček, které ti pomohou zvyknout si na jízdu s návěsem. Soustřeď se, přizpůsob svou rychlost podle situace a naplno využij veškerý volný prostor na trati."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Jako první je šikana - dvě zatáčky v jedné. Musíš se připravit na levotočivou zatáčku, ale v půlce přejít do pravotočivé."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Další zatáčkou přejedeš přes dělící pás. Není nijak zvlášť složitá, ale musíš si hlídat, že máš dostatek místa pro návěs."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Dále budeš muset překonat těsný slalom přes betonové překážky. Jeď pomalu, používej zrcátka a ujisti se, že si najíždíš dostatečně široce, aby návěs projel kolem bariér."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "V tomto okamžiku najedeš do dalšího slalomu doplněném o další kužely na vrcholu každé zatáčky.<br>Ujisti se, že žádný z nich netrefíš!"

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Následuje několik snadných zatáček na cestě ke kruhovému objezdu."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Rovný úsek využij k přípravě na vjezd do kruhového objezdu. Než do něj vjedeš, drž se na vnější straně."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Vjeď do kruhového objezdu a sleduj umístění svého návěsu. Jakmile budeš uvnitř kruhového objezdu, bude se pohybovat jinak než před vjezdem do něj."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Opusť kruhový objezd a jeď na další sadu zatáček."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "REMOVE THIS CUTSCENE"

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Zatáčka je zde extrémně ostrá. Jeď pomalu a chytře využij prostor kolem sebe. Nezapomeň na vybočování zadní části návěsu."

	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Při průjezdu dalšími několika zatáčkami se nezapomeň připravovat na další zatáčku hned jakmile opustíš tu předchozí."

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Nespěchej do poslední zatáčky. Vypadá jednoduše, ale je zde méně prostoru pro manévrování, než se zdá."

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Zastav na vyznačeném místě, zajisti kamion a vypni motor."


#### 3_04 Driving Instructions


	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Zrychli směrem k první zatáčce.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "První zatáčkou je jednoduchá šikana.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "REMOVE THIS CHECK"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Dále trať pokračuje vlevo přes dělící pás.<br><br><font face=/font/big_bold.font>Přejeď přes dělící pás.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Manévruj kolem bariér a nezapomeň sledovat svůj návěs.<br><br><font face=/font/big_bold.font>Projeď slalomem.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "Tento slalom je rovnější, ale dopravní kužely jej výrazně zužují.<br><br><font face=/font/big_bold.font>Projeď slalomem a vyhni se kuželům.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Před námi je několik snadných zatáček, stále se musíš správně nastavit, abys udržel návěs dál od vnitřních bariér.<br><br><font face=/font/big_bold.font>Projeď zatáčkami.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Blížíš se ke kruhovému objezdu. Nezapomeň svému návěsu nechat dostatek místa nejen při vjezdu a výjezdu, ale také při projíždění.<br><br><font face=/font/big_bold.font>Projeď kruhovým objezdem.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Před sebou máš krátký rovný úsek, takže pokud chceš, můžeš trochu zrychlit.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Zatáčka je zde extrémně ostrá. Jeď pomalu, využij veškerý dostupný prostor a nezapomeň na vybočování návěsu.<br><br><font face=/font/big_bold.font>Projeď ostrou zatáčkou.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Přímo před tebou je pár posledních zatáček. Stále si hlídej svůj návěs.<br><br><font face=/font/big_bold.font>Pokračuj dále.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "<font face=/font/big_bold.font>Pokračuj k poslednímu parkovacímu místu.</font>"
#!{

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

