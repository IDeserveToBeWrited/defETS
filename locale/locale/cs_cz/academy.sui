#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "V tomto scénáři si poprvé vyzkoušíš připojit a odpojit návěs. Připrav tahač a poté zacouvej k návěsu za tebou."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Připoj návěs a popojeď vpřed."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Zastav na vyznačeném místě."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Odpoj návěs a popojeď vpřed."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Zastav na parkovacím místě a zajisti tahač."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "V tomto scénáři si povíme o činnostech při připojení a odpojení návěsu od tahače. Jde o zjednodušený postup oproti tomu, s čím se řidiči kamionů setkávají ve skutečném životě.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Za tahačem se nachází návěs. Pomalu zacouvej do návěsu, aby královský čep narazil do točnice. Momentálně je tahač správně srovnán, takže nemusíš zatáčet, stačí couvat rovně.<br><br><font face=/font/big_bold.font>Pomalu couvej, dokud neucítíš spojení.</font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Točnice se spojila s královským čepem.<br><br><font face=/font/big_bold.font>Zatažením parkovací brzdy zajisti tahač.</font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "V reálném světě točnice automaticky uzamkne královský čep, poté musí řidič z vozidla vystoupit, zatáhnout podpěry a připojit vzduchové a elektrické kabely.<br><br><font face=/font/big_bold.font>Nám pro připojení návěsu stačí stisknout @@imv_nrm_attach@@.</font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Nyní, když je tahač bezpečně připojený k návěsu, jsi připraven vyrazit vpřed. Měj na paměti, že nyní je tvé vozidlo podstatně delší a těžší a jeho ovládání bude vyžadovat nové dovednosti.<br><br><font face=/font/big_bold.font>Uvolni parkovací brzdu a jeď dopředu.</font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Jeď dopředu.<br><br><font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Zatáhni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Zatáhni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "V reálném světě by řidič opět musel vystoupit z vozidla, snížit podpěry, odpojit vzduchové a elektrické kabely a uvolnit zámek točnice.<br><br><font face=/font/big_bold.font>My jsme proces zjednodušili, takže stačí, když stiskem @@imv_nrm_attach@@ odpojíš návěs.</font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Uvolni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Vyjeď s tahačem zpod návěsu a jeď dopředu.<br><br><font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Brzdění s návěsem"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "V tomto scénáři získáš cit pro řízení a brzdění s připojeným návěsem."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Rozjezd"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Jízda z kopce"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Dosažení rychlosti 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Brzdění"
