	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Vítej u závěrečné zkoušky. Připravili jsme několik realistických situací, se kterými se můžeš setkat na silnici, abychom zjistili, jak se s nimi dokážeš vypořádat. Jako vždy nespěchej a jeď přesně.<br><br>Hodně štěstí!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Cesta před tebou je zablokována, otoč se na dostupném místě."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Pokračuj na trať."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Při sjíždění kopce dosáhni rychlosti alespoň 60 km/h (37 mph)."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Připrav se na brzdění."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Nepodařilo se ti dosáhnout minimální rychlosti 60 km/h (37 mph)."

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Pokračuj jízdou po trati."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "V řadě kamionů napravo je pro tebe parkovací místo. Zacouvej a zaparkuj."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Pokračuj vpřed, jakmile budeš připraven."

