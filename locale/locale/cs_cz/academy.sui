ont><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/time.mat width=22 height=22><offset vshift=2>@@aca_goal_time_limit@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_time_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/camera.mat width=22 height=22><offset vshift=2>@@aca_goal_exterior_drive@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_camera_desc@@</font></margin></align><br><offset vshift=15>"
#!}

#+ Book 2 general
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFORMACE O MODULU ODBORNÉ ŘÍZENÍ KAMIONU" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Požadavky na dokončení"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Scénáře jsou dokončeny splněním všech podmínek pro absolvování"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Hvězdičky získáš splněním bonusových podmínek"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Podmínky"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maximální počet změn mezi směrem jízdy vpřed a vzad"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maximální čas určený k dokončení scénáře pro danou podmínku"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Výhradní použití vnitřní kamery - vnější kamery lze používat při stání"

	key[]: "aca_book_book2_completed_t"
	val[]: "MODUL ODBORNÉ ŘÍZENÍ KAMIONU SPLNĚN"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br><br>Splnil jsi všechny podmínky pro absolvování modulu Odborné řízení kamionu a získal odměny pro svůj kariérní profil. Stále se můžeš pokusit získat další odměny splněním všech bonusových podmínek.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "MODUL ODBORNÉ ŘÍZENÍ KAMIONU DOKONČEN"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br><br>Splnil jsi všechny podmínky pro absolvování i bonusové podmínky modulu Odborné řízení kamionu a získal odměny pro svůj kariérní profil.</font><br><br>"
#@}


#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Odborné řízení kamionu"

#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Vítej zpátky v @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Následující scénáře představují další krok na tvé cestě k profesionálnímu řízení kamionů."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Tentokrát tě nebudeme provádět jednotlivými úkoly, takže je jen na tobě, abys uplatnil své dovednosti a zkušenosti."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Můžeš se setkat s některými známými manévry, ale tentokrát v novém prostředí, které se více podobá skutečnému světu."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Novinkou pro @@driving_academy@@ je přidání podmínek pro absolvování a bonusových podmínek."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Stejně jako dříve musíš každý scénář dokončit tak, aniž bys do něčeho narazil, úspěšně zaparkovat a zajistit tahač..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...teď to ale navíc musíš zvládnout ve stanoveném časovém limitu a s omezením počtu změn směru jízdy."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bonusové podmínky lze splnit dokončením každého scénáře s ještě náročnějšími podmínkami..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...například přísnější časové limity, méně změn směru a používání výhradně vnitřní kamery."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Splněním všech scénářů se můžeš považovat za zkušeného řidiče kamionu a budeš připraven na další výzvy.<br><br>Pro největší výzvu dokonči všechny bonusové podmínky všech scénářů a tím se staneš skutečně hvězdným řidičem kamionu!"

#@}


#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Výuka"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "V tomto výukovém scénáři ti pomůžeme seznámit se s novými funkcemi modulu Odborné řízení kamionu."

#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Na začátku každého scénáře uvidíš okno <color value=@@clr_sel@@>\"Zadání scénáře\"<color value=@@clr_txt@@>. V něm získáš informace o nových podmínkách pro absolvování a bonusových podmínkách daného scénáře.<br><br>Pro úspěšné dokončení scénáře je potřeba splnit podmínky pro absolvování, zatímco bonusové podmínky jsou nepovinnou výzvou navíc pro zručné a zkušené hráče.<br><br><font face=/font/big_bold.font>Pro pokračování zapni napájení.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Jedna z bonusových podmínek vyžaduje, abys scénář dokončil s použitím <color value=@@clr_sel@@>vnitřní kamery<color value=@@clr_txt@@>. Vnější kamery můžeš nadále používat ke kontrole okolí, ale pouze když vozidlo stojí.<br><br>Nyní se můžeš rozhlédnout, abys ses zorientoval, a pak přepni zpět na vnitřní kameru.<br><br><font face=/font/big_bold.font>Přepni na vnější kameru pro zkontrolování okolí</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Zorientuj se a přepni zpět na vnitřní kameru.<br><br><font face=/font/big_bold.font>Rozhlédni se kolem tahače</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Přepni zpět na vnitřní kameru</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Čas<color value=@@clr_txt@@> bude v modulu Odborné řízení kamionu také hrát roli. Všechny scénáře budou mít základní časový limit, ve kterém musí být scénář dokončen, jakožto podmínku pro absolvování, a mnoho z nich bude mít také další, přísnější limit jakožto bonusovou podmínku.<br><br>Časovač se spustí až jakmile se tahač pohne.<br><br><font face=/font/big_bold.font>Nastartuj motor a uvolni parkovací brzdu.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Další novinkou v modulu Odborné řízení kamionu jsou body trasy. Před dokončením scénáře je nutné projet všemi body na trase.<br><br>Kromě toho u některých bodů záleží, jakým směrem je vozidlo otočeno při jeho dosažení, proto dávej pozor na veškerá pozemní značení v blízkosti bodu trasy, abys přijel správným směrem.<br><br><font face=/font/big_bold.font>Rozjeď se k bodu trasy před tebou.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Dosáhl jsi bodu na trase a nyní můžeš pokračovat k dalšímu kroku.<br><br>Za tebou se nachází další bod trasy, do kterého musíš zacouvat. Všimni si šipky na zemi, která ukazuje, jakým směrem by měl být tahač natočen při dosažení daného bodu trasy.<br><br>Další podmínkou pro absolvování a bonusovou podmínkou, kterou je potřeba sledovat, jsou <color value=@@clr_sel@@>změny směru<color value=@@clr_txt@@>. Počítáme, kolikrát změníš směr mezi jízdou vpřed a couváním. Pro splnění podmínky se drž pod jejím limitem.<br><br><font face=/font/big_bold.font>Zacouvej k bodu trasy a zastav.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "V tuto chvíli bys tedy měl mít započtenou jednu změnu směru.<br><br>Připoj návěs za tebou a pokračuj k dalšímu kroku.<br><br><font face=/font/big_bold.font>Zacouvej k návěsu za tebou a připoj ho.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Závěrečné parkovací místo se nachází po tvé pravici. Některé scénáře mohou mít pouze jedno parkovací místo, zatímco jiné jich budou mít na výběr více. Správné zaparkování na kterémkoli z míst ti umožní scénář dokončit.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_attach@@ pro připojení návěsu.</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Parkovací místa také ukazují, jakým směrem musí být tahač na daném místě orientován. Pokud zaparkuješ špatným směrem, nebudeš moci scénář dokončit, dokud se neotočíš, což stojí čas a změny směru.<br><br><font face=/font/big_bold.font>Zajeď na jedno z parkovacích míst a správně zaparkuj.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Nyní bys měl znát parametry nových podmínek pro absolvování i bonusových podmínek, a být tak připraven zvládnout nové scénáře v modulu Odborné řízení kamionu!<br><br><font face=/font/big_bold.font>Zajisti tahač zatažením parkovací brzdy a vypni motor pro dokončení scénáře.</font>"



#@}



#+ Book 2 shortcut_backing
#@{
#### common
	key[]: "aca_scenario_book2_shortcut_backing_title"
	val[]: "Zkratka"

	key[]: "aca_scenario_book2_shortcut_backing_desc"
	val[]: "V tomto scénáři se pokusíš projet zkratkou, která je bohužel na konci zablokovaná. Musíš pak tedy vycouvat zpět stejnou cestou, kterou jsi přijel."

#### intro text

	key[]: "aca_scenario_book2_shortcut_backing_cutscene1"
	val[]: "Přijeď k bodu trasy na vrcholu kopce a poté stejnou cestou zacouvej zpět dolů.<br><br>Jakmile budeš zpátky na silnici, zajeď na finální parkovací místo."



#@}

#+ Book 2 early_bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Ranní ptáče"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "V tomto scénáři se musíš prodrat přeplněným parkovištěm. Prostor je extrémně omezený, takže se snaž své kroky naplánovat předem."

#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Někdy je parkování tak omezené, že ostatní řidiči parkují, kde se dá, i přes noc. To pak může ráno značně ztížit jejich objíždění.<br><br>Snaž se co nejlépe projít parkovištěm až na finální parkovací místo."



#@}

#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Zákruty"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "V tomto scénáři máš za úkol projet velmi složitou tréninkovou tratí. Cestou musíš najít návěs, připojit ho a dojet s ním až do cíle."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Tento scénář prověří tvé prostorové a situační vnímání. Trať před tebou je plná překážek, které ne vždy bude snadné spatřit."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Projeď tratí k návěsu. Jakmile ho najdeš, připoj ho a dojeď s ním až na finální parkovací místo."



#@}

#+ Book 2 vertigo
#@{
#### common
	key[]: "aca_scenario_book2_vertigo_title"
	val[]: "Závrať"

	key[]: "aca_scenario_book2_vertigo_desc"
	val[]: "V tomto scénáři prověříme tvé řidičské dovednosti. Jeď dokola a dokola, dokud nedojedeš do cíle!"

#### intro text

	key[]: "aca_scenario_book2_vertigo_cutscene1"
	val[]: "Je čas otestovat si své dovednosti v řízení tahače; tato trať byla navržena tak, aby se ukázalo, jak dobře svůj tahač znáš!"

	key[]: "aca_scenario_book2_vertigo_cutscene2"
	val[]: "Středobodem je dlouhá spirála, která prověří tvou schopnost ovládat tahač v dlouhých táhlých zatáčkách."

#@}




#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Couvání za roh"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "V tomto scénáři musíš s kamionem zacouvat přes slepou zatáčku na parkovací místo."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Místa pro vykládku nejsou vždy na ideálním místě. V tomto případě je skryto budovou vedle tebe."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Zacouvej kolem budovy a zaparkuj."

#@}



#+ Book 2 depot_options
#@{
#### common
	key[]: "aca_scenario_book2_depot_options_title"
	val[]: "Parkování u skladu"

	key[]: "aca_scenario_book2_depot_options_desc"
	val[]: "V tomto scénáři máš za úkol zaparkovat kamion na jednom ze tří různých parkovacích míst, z nichž každé vyžaduje rozdílné manévry."

#### intro text

	key[]: "aca_scenario_book2_depot_options_cutscene1"
	val[]: "K dispozici máš tři různá parkovací místa, která se liší obtížností. Vyber si jedno, dojeď k němu a zacouvej, jak uznáš za vhodné."


#@}

#+ Book 2 night_parallel
#@{
#### common
	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Podélné parkování v noci"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "V tomto scénáři musíš zaparkovat podélně k obrubníku. Je noc, takže viditelnost bude omezená."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Čas a počasí nejsou vždy ideální, když konečně potřebuješ na noc zaparkovat, takže budeš muset věnovat zvýšenou pozornost svému okolí.<br><br>Nezapomeň si rozsvítit světla!"

#@}

#+ Book 2 slalom_nt
#@{
#### common
	key[]: "aca_scenario_book2_reverse_slalom_nt_title"
	val[]: "Slalom pozpátku"

	key[]: "aca_scenario_book2_reverse_slalom_nt_desc"
	val[]: "V tomto scénáři máš za úkol zdolat sérii propojených slalomů v opačném směru."

#### intro text

	key[]: "aca_scenario_book2_reverse_slalom_nt_cutscene1"
	val[]: "Za tebou je trať složená z několika slalomových úseků."

