#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Volné couvání"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "V tomto scénáři budeš na prázdném parkovišti cvičit couvání s dvojitými návěsy."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Příprava"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Experimentování"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Závěrečné kroky"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Ukončení scénáře"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Couvání s dvojitým návěsem vyžaduje mnohem více pozornosti než s jedním. Musíš předem naplánovat, kam chceš zadní návěs nasměrovat, a zároveň udržet kontrolu nad předním návěsem s tahačem.<br><br>Můžeš o tom přemýšlet nějak takto - je potřeba použít přední návěs pro řízení zadního návěsu."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "V tomto případě chceme zatočit zadním návěsem na stranu řidiče. Abychom jej stočili tímto směrem, musíme přední část zadního návěsu zatlačit na stranu spolujezdce. <br><br>Všimni si, že je tedy vlastně potřeba stočit přední návěs na opačnou stranu, než na kterou chceš zatočit zadním návěsem."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Jakmile se zadní návěs začne otáčet, je potřeba vyrovnat tahač s předním návěsem. Právě v tomto okamžiku většina lidí obvykle udělá první chybu."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "Zde vidíme, že řidič nedokázal udržet směr a hrozí, že se mu návěsy zalomí."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "K zalomení dochází, když úhel mezi dvěma vozidly v kombinaci dosáhne přibližně 90 stupňů. Jakmile k tomu dojde, není možné situaci zachránit - jedinou možností je popojet dopředu a zkusit to znovu.<br><br>Stejně jako při couvání s jedním návěsem je cílem vždy zajistit, aby se všechna kola návěsů pohybovala. Jakmile se jedno kolo zastaví a návěs se otáčí na místě, nemůžeš pokračovat."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Můžeš se vrátit na místo, kde jsi naposledy postupoval správně, respektive na místo, kde můžeš pokračovat v couvání, aniž by ses znovu dostal do stejné situace.<br><br>V tomto případě se vyrovnáme a zkusíme to znovu od začátku."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Jakmile se zadní návěs začne otáčet, opět dostaň tahač dopředu a nech zadní návěs chvíli otáčet se sám."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nyní, když se zadní návěs otáčí tam, kam chceme, je čas nasměrovat přední návěs tak, aby ho následoval. Můžeš upravovat úhel mezi předním a zadním návěsem při průjezdu zatáčkou a projel ji tak ostřeji nebo více ze široka."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Poslední částí manévru je vše vyrovnat. Srovnej přední část se zadní částí."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Měl bys odhadnout, kolik času zabere přesun předního návěsu. Pokud budeš čekat příliš dlouho, zadní návěs se nakonec pokusí vrátit tam, odkud jsi právě přijel!"

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Zde můžeš strávit tolik času, kolik jen chceš, a vyzkoušet si různé manévry, dokud nezískáš hrubou představu o tom, jak manipulovat s návěsy při couvání.<br><br>Ale hlavně si to užij!"

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Připrav se k jízdě."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Využij tohoto parkoviště k vyzkoušení couvání s návěsem.<br><br>@@aca_goal_tip@@ Jsi v couvání s návěsem úplným začátečníkem? Zkus si nejdříve zahrát část Základy řízení kamionu."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Zkoušej si to jak dlouho jen budeš chtít.<br><br>Jakmile budeš spokojen, zastav a zajisti tahač, čímž scénář ukončíš."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Pro ukončení scénáře vypni motor."
#@}


