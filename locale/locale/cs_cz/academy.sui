	key[]: "aca_scenario_book3_parallel_title"
	val[]: "Podélné parkování"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "V tomto scénáři zaparkujeme s dvojitými návěsy paralelně na silnici."

