#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Vítej v @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Následující scénáře představují první krok na tvé cestě k profesionálnímu řízení kamionů."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Dozvíš se vše od základních systémů a ovládacích prvků kamionu..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...až po složité manévry s návěsem i bez něj."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Pomůžeme ti vštípit si návyky pro bezpečné řízení v různých situacích,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "a naučíme tě vhodně využívat dostupný prostor k efektivnímu manévrování s kamionem."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Splněním všech scénářů a závěrečných zkoušek"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "budeš připraven vyrazit na evropské silnice a hledat nové výzvy."

