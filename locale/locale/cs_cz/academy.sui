#### train msg - intro text

	key[]: "aca_msg_book3_train_cutscene1"
	val[]: "Tato testovací trať ti nabídne malou ochutnávku skutečné jízdy v bezpečí našich tréninkových areálů. Vyzkoušej si některé ze svých nově nabytých dovedností a nezapomeň sledovat své okolí a využít veškerý dostupný prostor.<br><br>Vyplatí se také plánovat dopředu!"

#### train Driving Instructions

#!{
	key[]: "aca_msg_book3_train_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_train_forward"
	val[]: "Pokračuj vpřed a najdi cestu na trať."

	key[]: "aca_msg_book3_train_check1"
	val[]: "Před tebou je sjezd, který můžeš využít k vyzkoušení chování dvojitých návěsů při vyšší rychlosti."

	key[]: "aca_msg_book3_train_check2"
	val[]: "Připrav se na brzdění před zatáčkou."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Zatoč doprava, přejeď přes dělící pás a poté hned doleva."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Znovu přejeď přes dělící pás."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Můžou nastat situace, kdy nebudeš mít jinou možnost než celou soupravu zalomit.<br><br>Udělej, co je nutné, abys projel touto extrémně ostrou zatáčkou."

	key[]: "aca_msg_book3_train_check6"
	val[]: "Pokračuj jízdou po trati."

	key[]: "aca_msg_book3_train_check7"
	val[]: "Slalomem jeď opatrně a ujisti se, že nejen návěsy projedou každou bariérou, ale také že jsi připraven na projetí té následující."

	key[]: "aca_msg_book3_train_check8"
	val[]: "Pokračuj doleva a projeď rovně křižovatkami."

	key[]: "aca_msg_book3_train_check9"
	val[]: "Následuj po asfaltu doprava."

	key[]: "aca_msg_book3_train_check10"
	val[]: "Poslední zatáčka je zavádějící; nabízí spoustu místa, ale připrav se na to, že budeš parkovat u vzdálenějšího obrubníku."

#!{
	key[]: "aca_msg_book3_train_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_train_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ double_90
#@{

#### double_90 common

	key[]: "aca_scenario_book3_double_90_title"
	val[]: "Pravoúhlé zatáčky"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "V tomto scénáři budeš mít za úkol projet trať s různými obtížnostmi pravoúhlých zatáček."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Rozjezd"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Jízda vpřed"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Použití zrcátek"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Je to snadné"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Přípava"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Plánování"

#!{
	key[]: "aca_goal_book3_double_90_check5"
