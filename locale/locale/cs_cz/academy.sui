	key[]: "aca_goal_book3_night_slalom_double_check0"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
#### night_slalom_double into text

	key[]: "aca_msg_book3_night_slalom_cutscene01"
	val[]: "Trať před námi nabízí několik slalomů s různou obtížností."

	key[]: "aca_msg_book3_night_slalom_cutscene02"
	val[]: "Nespěchej a nezapomeň si trasu plánovat dopředu."

	key[]: "aca_msg_book3_night_slalom_cutscene03"
	val[]: "Můžeš narazit na místa, kde bude potřeba jet opravdu pomalu a velmi přesně.<br><br>Neuspěchej to!"


#### night_slalom_double driving instructions

#!{
	key[]: "aca_msg_book3_night_slalom_double_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_msg_book3_night_slalom_double_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}
	key[]: "aca_msg_book3_night_slalom_double_forward"
	val[]: "Jakmile budeš připraven, rozjeď se.<br><br>Nezapomeň si rozsvítit světla!"

	key[]: "aca_msg_book3_night_slalom_double_check0"
	val[]: "Projeď slalomy."

	key[]: "aca_msg_book3_night_slalom_double_stop"
	val[]: "Zastav na vyznačeném místě."

	key[]: "aca_msg_book3_night_slalom_double_end"
	val[]: "Zajisti vozidlo a vypni motor."



#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Parkování v zatáčce"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "V tomto scénáři se musíš proplést rušným parkovištěm plným nevhodně zaparkovaných kamionů, abys nakonec mohl zaparkovat v zatáčce."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Není neobvyklé, že přijedeš na parkoviště, které je téměř úplně plné kamionů, takže máš jen velmi málo možností, kde zaparkovat sám."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "V tomto případě zbývá už jen jedno místo, kam se vejdeš se svou soupravou.<br><br>Projeď parkovištěm a zaparkuj v zatáčce poblíž výjezdu."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Projeď parkovištěm a zaparkuj podél zatáčky.<br><br>Jakmile budeš připraven, rozjeď se."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Touto zatáčkou neprojedeš, budeš muset vycouvat a najít jinou cestu."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Zaparkuj v zatáčce před tebou."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Zastav na vyznačeném místě."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Zajisti tahač a vypni motor."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Závěrečná zkouška"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "V tomto scénáři si své nově nabyté dovednosti otestuješ na trati, která prověří tvou přesnost a porozumění jízdě s dvojitými návěsy."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Couvání"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Vjezd na trať"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Zrychlení"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Příprava na brzdění"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Nedostatečná rychlost"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Parkování"

