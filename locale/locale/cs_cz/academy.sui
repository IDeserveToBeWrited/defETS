#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Zastavení u překážky"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "V tomto scénáři si povíme o předním zrcátku - jeho umístění a efektivní využití při zastavení u překážky před tahačem."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Kontrola předního zrcátka"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Pochopení funkce zrcátka"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Zastavení u překážky"
