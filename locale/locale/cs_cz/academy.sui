#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Vítej v první části závěrečné zkoušky. Zjistíme, jak dobře ses naučil během svého času v Academy řídit kamion."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Nejprve připojíš návěs. Poté projedeš kamionem celou testovací oblast."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "První úsek vede od malého parkoviště na trať ve východní části."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Okruh obsahuje náročné průjezdy mezi bariérami."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Značná část cesty vede skrz trať ve východní části."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Otestujeme tvou schopnost manévrovat kamion ve složitých situacích."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Budeš manévrovat kamion skrz ostré zatáčky."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Pojedeš po cestě mezi tratěmi."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Závěrečná část obsahuje řízení na malém okruhu."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Okruh má mnoho spletitých úseků a ostrých zatáček."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Pro dokončení testu musíš správně zaparkovat."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Není důvod být nervózní, naučil ses vše, co budeš potřebovat pro úspěšné splnění.<br><br>Hodně štěstí!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Před tebou je návěs.<br><br><font face=/font/big_bold.font>Jeď k návěsu.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Srovnej tahač s návěsem.<br><br><font face=/font/big_bold.font>Zacouvej a spoj se s královským čepem.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zajisti tahač.</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Stiskni @@imv_nrm_attach@@<font face=/font/big_bold.font>pro připojení návěsu.</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Návěs je připojen a kamion je připraven k jízdě.<br><br><font face=/font/big_bold.font>Uvolni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Jeď k výjezdu z parkoviště.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Jeď podle značek na silnici a dávej pozor na bariéry.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Blíží se náročnější úsek.<br><br><font face=/font/big_bold.font>Opatrně manévruj mezi bariérami.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "V této části otestujeme tvé dovednosti manévrování návěsu různými typy zatáček.<br><br><font face=/font/big_bold.font>Odboč na okruh.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Projeď úsekem.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Jeď rovně.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Opatrně projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Vjíždíš do složitějšího úseku. Jeď opatrně.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě z kopce.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Odboč vlevo do ostré zatáčky.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Opusť okruh.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Vjíždíš do jednoduššího úseku.<br><br><font face=/font/big_bold.font>Pokračuj jízdou z kopce.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Pokračuj jízdou po silnici.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Před tebou je odbočka na další okruh.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Odboč vpravo.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Pokračuj jízdou po okruhu.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Před tebou jsou další ostré zatáčky.<br><br><font face=/font/big_bold.font>Jeď přiměřeně rychle.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Odboč vlevo.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Vjeď do zatáčky a pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "Abys zatáčku zvládnul, budeš možná potřebovat mírně vyjet mimo asfalt.<br><br><font face=/font/big_bold.font>Opatrně odboč, využij tolik místa, kolik potřebuješ.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Opusť okruh a jeď na parkovací místo.</font>"
