#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Vítej ve druhé části závěrečné zkoušky. Přesuneme se na nedaleké parkoviště a otestujeme tvé dovednosti v couvání a manévrování do parkovacích míst."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Čeká tě několik parkovacích výzev v řadě, které otestují tvé schopnosti."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Místa je málo, takže buď opatrný a nespěchej."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Buď opatrný a nespěchej. Je v pořádku, pokud se ti to nepovede na první pokus, důležité je nepoškodit kamion nebo věci kolem sebe.<font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Jeď vpřed k první části zkoušky.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tvým prvním úkolem je předvést parkování do strany. Místo, kam musíš zacouvat, je po tvé levici.<br><br><font face=/font/big_bold.font>Zacouvej do strany na parkovací místo.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Dalším úkolem je zacouvání mezi řadu zaparkovaných kamionů. Buď opatrný, abys nepoškodil ostatní kamiony!<br><br><font face=/font/big_bold.font>Zaparkuj pod úhlem.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Pokračuj parkovištěm. Dávej pozor na nečekané situace.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Nyní vyzkoušíme podélné parkování mezi dvěma kamiony u krajnice před tebou.<br><br><font face=/font/big_bold.font>Zaparkuj podélně.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Poslední parkovací manévr je po tvé levici. Můžeš si vybrat, jak ho provedeš.<br><br><font face=/font/big_bold.font>Zacouvej do vyznačeného místa.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Téměř hotovo. Opusť testovací plochu a zaparkuj kamion.<br><br><font face=/font/big_bold.font>Vlevo vyjeď z testovací plochy.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Můžeš zaparkovat kamion napravo mezi ostatní.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Podélné parkování s návěsem"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "V tomto scénáři se podíváme na podélné parkování s připojeným návěsem."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Zastavení na vyznačeném místě"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
