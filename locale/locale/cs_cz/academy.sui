#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "V tomto scénáři budeš couvat do parkovacího místa vedle obrubníku."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Zacouvej k obrubníku.<br>Při couvání musíš dávat pozor na své okolí, takže používej zrcátka."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Až budeš blíž, můžeš začít vyrovnávat tahač s parkovacím místem. Při couvání si hlídej obě strany tahače."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Zastav na parkovacím místě a zajisti tahač."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Parkovací místo je za tebou na straně spolujezdce. Během jízdy k němu používej zrcátka.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Před jízdou nezapomeň zkontrolovat své okolí pomocí zrcátek.<br><br><font face=/font/big_bold.font>Začni couvat směrem k obrubníku.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Během couvání k parkovacímu místu si neustále hlídej své okolí.<br><br><font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 2_06
