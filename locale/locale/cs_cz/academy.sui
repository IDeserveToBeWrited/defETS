#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkování popředu, takzvaně \"najíždění\" je vcelku jednoduché.<br>I tak ale budeš muset kompenzovat vybočení návěsu."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Musíš přejet místo, kde bys obvykle začal s návěsem zatáčet. To ti pomůže efektivněji vyrovnat návěs."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Jakmile se přiblížíš k parkovacímu místu, zatoč tak, abys dostal tahač před návěsem. Vyrovnej se a pokračuj na místo.<br>Zastav, zaparkuj, zajisti vozidlo a vypni motor."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Před sebou máš parkovací místo, na které budeš muset dojet a zaparkovat.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Rozjeď se a zatoč k parkovacímu místu.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Projeď kolem parkovacího místa, abys svůj návěs vyrovnal s vyznačenou oblastí, poté zajeď do místa s tahačem a vyrovnej se.<br><br><font face=/font/big_bold.font>Zaparkuj na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Zajisti tahač a vypni motor.</font>"
#@}

