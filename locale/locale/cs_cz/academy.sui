	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Začni pomalu couvat."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Vyrovnej se a zastav na vyznačeném místě."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Zajisti vozidlo a vypni motor."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Korekce rovného couvání"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "V tomto scénáři se ujmeš řízení poté, co se někdo jiný pokusil o rovné couvání. Naprav jeho chybu a zaparkuj soupravu na vyznačeném místě."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Vyrovnání se"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Couvání"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Někdo se pokusil zacouvat s touto soupravou na parkovací místo a moc se mu to nedařilo. Teď je na tobě, abys to napravil."

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Prvním krokem je popojet dopředu a vše vyrovnat, aby se s tím dalo pracovat. Zásadní je, aby zadní přívěs směřoval tam, kam chceš."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "V tomto případě jsme se rozhodli jet více směrem k straně řidiče. To nám poskytne lepší výhled na to, co děláme při couvání, a umožní nám to pracovat z jedné strany.<br><br>Nezapomeň, že řídíš zadní návěs tím předním, takže se tolik nesoustřeď na tahač."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Souprava je víceméně tam, kde ji potřebujeme, ale trochu ještě popojeďme dopředu, abychom ji správně vycentrovali."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Odtud velmi opatrně zacouváme na místo a ujistíme se, že zadní návěs drží následuje správnou stopu."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Nyní můžeme vyrovnat přední návěs a samotný tahač."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Popojeď dopředu a vše vyrovnej.<br><br>Jakmile budeš spokojen, zacouvej do vyznačeného místa."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Zacouvej na vyznačené místo."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Zajisti vozidlo a vypni motor."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Pravoúhlé couvání"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "V tomto scénáři provedeš couvací manévr do pravého úhlu, abys zaparkoval do řady dalších kamionů."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Úplné otáčení"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Příprava"

	key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Couvání"

#!{
	key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Couvání do strany je s dvojitými návěsy snazší, protože z bočního okna máš lepší výhled na vše, co se děje."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Nejprve se rozjeď dopředu a na konci řady se otoč. Tím se napozicuješ tak, abys vše lépe viděl z okna na straně řidiče."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Návěsy si můžeš napozicovat tak, jak uznáš za vhodné, třeba se zadním návěsem již směřujícím k danému místu. V tomto případě začneme z rovné polohy.<br><br>Hlavně si to nekomplikuj - zadní návěs koriguj pomocí předního."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Zatoč předním návěsem mírně směrem od parkovacího místa a zadní návěs se k němu začne stáčet. Poté uprav úhel mezi předním a zadním návěsem tak, abys do parkovacího místa zajel pěkným plynulým obloukem."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Nezapomeň, že pokud se zadní návěs stáčí příliš, musíš úhel soupravy trochu narovnat. Pokud najíždí přílíš zeširoka, úhel musí být ostřejší."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Korekce, které provedeš s tahačem, mají na zadní návěs poloviční vliv než na přední návěs, takže se neboj s tahačem pořádně manévrovat."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "V tomto okamžiku musíš začít plánovat dopředu. Na místo určení musíš dostat také přední návěs, takže si už naplánuj, jak ho dostat přímo před zadní."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Bylo by velmi výjimečné, aby se ti podařilo zacouvat s návěsy na první pokus. V tomto případě jsme s narovnáním předního návěsu čekali příliš dlouho a teď nám ten zadní vyjíždí ze stopy.<br><br>Nevadí, popojeď dopředu a zkus to znovu."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Pořádně s tím volantem pracuj a dostaň návěsy tam, kam chceš. Můžeš si popojet dopředu kolikrát jen potřebuješ, dokud nebudeš spokojený."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "A tak jsi úspěšně zaparkoval dvojité návěsy."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Vyjeď dopředu na konec parkoviště a otoč se."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Nezapomeň si najet zeširoka."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Pokračuj vpřed, dokud nebudeš mít dostatek prostoru k manévrování, a poté začni couvat."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Zacouvej na parkovací místo, pokud si máš dostatek prostoru k manévrování."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


