	val[]: "Příprava"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Rozjezd"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Pokračování jízdy"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zastavení"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Zajištění vozidla"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Jízda s dvojitým návěsem může vypadat náročně, ale není zas o moc složitější než jízda s jedním návěsem - stačí jen brát v úvahu dráhu zadního návěsu!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Před tebou je úzké parkovací místo. Před vjezdem nebudeš mít dostatek prostoru pro vyrovnání, takže budeš muset pečlivě zvážit, jak se tam s oběma návěsy dostaneš."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Okamžitě zatoč směrem k protější straně parkovacího místa a projeď daleko za místo, kde bys běžně zatáčel."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Nyní, když je tvůj zadní návěs ve správné pozici, můžeš zamířit k místu určení; jen se ujisti, že jedeš opět směrem k protější straně, abys pomohl otočit první návěs."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Pokračuj na místo, oba návěsy tě budou následovat a vyrovnají se během jízdy."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Zaparkuj na vyznačeném místě a zajisti tahač."

