#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "V závěrečném scénáři této kapitoly si projedeme testovací polygon s komplexním uspořádáním."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "První překážkou je slalom mezi bariérami. Projeď jím a nezapomeň používat zrcátka."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Následuje vlásenková zatáčka. Pořádně si najeď a neměl bys mít problém."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Zde je kolmá zatáčka doleva. Nezapomeň si najet, aby zadní část tahače projela kolem vnitřních bariér."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Rampa může být docela záludná. Než na ni najedeš, vyrovnej se jak nejlépe můžeš a pro lepší přehled používej přední a postranní zrcátko."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Další část musíš projet pozadu. Mysli na to, až budeš najíždět k bariérám před sebou."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Sleduj značení na silnici napravo za tebou."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Zacouvej k bariérám, poté zastav a pokračuj vpřed doleva."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Pokračuj přes dělící pás do dalšího úseku."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Tento průjezd mezi kužely je velmi těsný. Jeď pomalu a při průjezdu se orientuj pomocí zrcátek."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Nezapomeň si najíždět do kolmých zatáček."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Vjíždíš na pěkný otevřený úsek. Můžeš nabrat rychlost, ale nezapomeň, že před zatáčkou budeš muset zpomalit."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Na konci sjezdu jsou bariéry přes silnici. Přijeď k nim a poté zacouvej na parkovací místo nalevo."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Zacouvej na parkovací místo."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Zaparkuj, vypni motor a zajisti tahač."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Před tebou je slalom z bariér.<br><br><font face=/font/big_bold.font>Projeď slalomem.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Drž se na vnější straně zatáčky, aby zadní část tahače nenajela na obrubník.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Blížíš se k levotočivé kolmé zatáčce. Nezapomeň využít veškerý prostor, který máš k dispozici.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Vyrovnej se s rampou. Jakmile na ni najedeš, nebudeš už mít moc prostoru pro korekce.<br><br><font face=/font/big_bold.font>Přejeď přes rampu.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "<font face=/font/big_bold.font>Následuj trať doleva.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "V následujícím úseku budeš muset couvat. Zastav u bariér před sebou tak, abys mohl následně zacouvat doprava.<br><br><font face=/font/big_bold.font>Zastav u bariér.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Zacouvej do prostoru vpravo za tebou. Na zemi jsou šipky, které ti pomohou.<br><br><font face=/font/big_bold.font>Zacouvej k dalšímu úseku.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "<font face=/font/big_bold.font>Pokračuj v couvání k bariérám za sebou.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zastav a zařaď dopředu, poté pokračuj vlevo.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Vlevo je dělící pás. Přejeď přes něj.<br><br><font face=/font/big_bold.font>Pokračuj dále.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Před tebou je úzká klikatá cesta s kužely. Jeď opatrně a v případě potřeby použij zrcátka.<br><br><font face=/font/big_bold.font>Projeď mezi kužely.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Pokračuj po trati.<br><br><font face=/font/big_bold.font>Odboč doleva.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Drž se vlevo, abys měl co nejvíce místa.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Zde můžeš trochu zrychlit, ale blíží se zatáčka.<br><br><font face=/font/big_bold.font>Pokračuj po trati.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Zatáčka se postupně utahuje.<br><br><font face=/font/big_bold.font>Přizpůsob rychlost a pokračuj.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na konci sjezdu uvidíš bariéry blokující silnici.<br><br><font face=/font/big_bold.font>Zastav u bariér.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Vlevo za tebou je parkovací místo.<br><br><font face=/font/big_bold.font>Zacouvej na parkovací místo.</font>"

	key[]: "aca_msg_book1_2_06_check17"
	val[]: "<font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"
#!{
	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

