#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Před tebou se nachází bariéra. Najeď k ní a zastav."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Za tahačem na straně řidiče je další bariéra. Zacouvej k ní obloukem. Navést tě může značení na zemi."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Přímo před tebou je ostrá kolmá zatáčka. Jeď k ní."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Musíš si hodně najet, aby se zadní kola vyhnula kuželu na vnitřní straně zatáčky.<br>Používej zrcátka!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Vyrovnej tahač, dojeď k poslední bariéře, poté zastav a zajisti tahač."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Tahač stále není připraven k jízdě, nezapomněl jsi na něco?<br><br>Nastartoval jsi motor? Uvolnil jsi parkovací brzdu?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "U bariéry přímo před tebou je vyznačené místo.<br><br><font face=/font/big_bold.font>Jeď dopředu a zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Podívej se za sebe na straně řidiče, uvidíš tam další vyznačené místo. Budeš muset couvat a zatáčet zároveň.<br><br><font face=/font/big_bold.font>Zacouvej obloukem a zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "Trať před tebou pokračuje kolmou zatáčkou.<br><br>Drž se na vnější straně zatáčky, co nejvíce si najeď a poté zatoč ostře doprava. Dávej pozor, abys nenarazil do dopravního kuželu na vnitřní straně.<br><br><font face=/font/big_bold.font>Jeď dopředu a projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "Používej přední a postranní zrcátka, abys do ničeho nenarazil.<br><br><font face=/font/big_bold.font>Dokonči zatáčku a zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Vypni motor a zajisti tahač.</font>"
#@}

