#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Jízda kolem bariér"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Před námi je řada složitých zatáček a překážek.<br>Uvědom si vše, co ses doposud naučil, a neměl bys mít problém."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Značení na silnici ti může napovědět, jak postupovat každou sadou překážek."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Najeď si s tahačem k vnějšímu okraji rohu.<br>Musíš si najet hodně, protože návěs následuje kratší trajektorii."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Další je jednoduchá kolmá zatáčka.<br>Opět se drž kamionem po vnější straně a využij všechen prostor, který máš k dispozici."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Nespěchej. Trať je zde otevřenější, ale stále budeš muset jet přesně."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Pořádně si najeď kolem bariér."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Při vjezdu do tohoto úzkého úseku si dávej pozor.<br>Pořádně si s tahačem najeď, než do úseku vjedeš, abys připravil návěs."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Poslední kolmá zatáčka je mnohem ostřejší než ta první, ale je tu spousta místa, pokud ho využiješ chytře."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Zastav na vyznačeném místě, poté zajisti kamion a vypni motor."


#### 3_03 Driving Instructions

	key[]: "aca_msg_book1_3_03_start"
	val[]: "Nezapomeň využívat značení na silnici, které ti usnadní orientaci na trati.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_03_forward"
	val[]: "Používání zrcátek ti také pomůže tratí bezpečně projet. Musíš si být vždy vědom, jak se za tebou pohybuje návěs.<br><br><font face=/font/big_bold.font>Projeď první zatáčkou.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Pozoruj návěs při výjezdu ze zatáčky a připrav se na další.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Projeď další zatáčkou.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Nezapomeň sledovat svůj návěs a před zatáčením se ujisti, že kolem sebe nemáš žádné překážky.<br><br><font face=/font/big_bold.font>Pokračuj kolem bariér před tebou.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Jakmile je tvůj návěs za bariérami, ostře zatoč na stranu spolujezdce, aby ses vyrovnal do zúženého průjezdu.<br><br><font face=/font/big_bold.font>Pokračuj zúženým průjezdem.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Tento úsek vyžaduje velmi přesné řízení. Nespěchej a používej zrcátka.<br><br><font face=/font/big_bold.font>Drž se vnější části každé zatáčky.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Tato zatáčka je velmi ostrá, ale můžeš využít veškeré místo před sebou, abys ji projel bez problémů.<br><br><font face=/font/big_bold.font>Projeď poslední zatáčkou.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Pokročilá jízda na polygonu - návěs"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "V závěrečném scénáři třetí kapitoly si projedeme delší výcvikový polygon s řadou různých zatáček, abychom viděli, jak dobře ses naučil manévrovat s návěsem."

#### 3_04 goal


	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Šikana"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "REMOVE THIS GOAL"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Přejetí dělícího pásu"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "První slalom"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Druhý slalom"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Jednoduché zatáčky"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Kruhový objezd"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Rovný úsek"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Prudká zatáčka"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Závěrečné zatáčky"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Příjezd na parkovací místo"
