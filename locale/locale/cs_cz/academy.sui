#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Ovládání kamer"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "V tomto scénáři se dozvíš o různých kamerách ve hře a jejich užitku pro manévrování s tahačem."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Pozice sedadla"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Pohled dozadu"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Kontrola zrcátek"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Přepnutí na vnější kameru"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Rozhlédnutí kolem kamionu"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "V tomto scénáři si projdeme různé kamery,<br>které jsou k dispozici."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Ve hře máme dohromady sedm kamer, ukážeme si některé z nich<br>a vysvětlíme si, k jakému účelu slouží."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Různé kamery a jejich různé úhly záběru ti mohou pomoci při manévrování ve stísněných místech."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Vidět, kam jedeš, je základním předpokladem bezpečné a profesionální jízdy. Pokud ti aktuální poloha sedadla nevyhovuje, můžeš si ji změnit přes \"@@adjust_link_t@@\" (dostaneš se k ní v menu pauzy).<br><br><font face=/font/big_bold.font>Jakmile budeš připraven, potvrď pomocí @@imv_nrm_activate@@.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Při couvání ti zrcátka neposkytují vždy dostatečný výhled, a tak může být nutné se vyklonit z okna a podívat se za sebe.<br><br><font face=/font/big_bold.font>Otoč kamerou zcela na stranu řidiče a podívej se z okna směrem k zadní části návěsu.</font>@@aca_goal_tip@@ Musíš být uvnitř vozidla."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Tento pohled využívej pro kontrolu návěsu při couvání. Vždy je lepší couvat na stranu řidiče, protože máš k dispozici právě tento pohled. Při couvání na stranu spolujezdce máš mnohem omezenější přehled o tom, co se děje za tebou.<br><br><font face=/font/big_bold.font>Podívej se na stranu spolujezdce.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Přesně proto se obvykle nedoporučuje couvat na stranu spolujezdce. Jak můžeš vidět, výhled je značně omezený. Naštěstí máš k dispozici také sedm venkovních kamer.<br><br>Tlačítko @@imv_nrm_camcycle@@ lze použít pro přepnutí na další kameru v pořadí. Po projetí všech sedmi kamer se vrátíš na začátek cyklu.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_camcycle@@ pro přepnutí na další kameru.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Vnější kamera poskytuje nejlepší přehled o dění kolem kamionu.<br><br><font face=/font/big_bold.font>Rozhlédni se okolo kamionu.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Opětovným stisknutím @@imv_nrm_camcycle@@ se můžeš přepnout na další kameru.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Pohled shora poskytuje výborný přehled o situaci kolem kamionu, zjednodušuje parkování a jízdu v těsných prostorách.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_camcycle@@ pro přepnutí na další kameru.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Střešní kamera poskytuje jasný výhled na vozovku daleko před tahač bez větších překážek.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_camcycle@@ pro přepnutí na poslední kameru, kterou si nyní prohlédneme.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Kamera z okýnka je zkratkou k pohledu, kterého jsi dříve dosáhl otočením vnitřní kamery. Jak už jsme zmiňovali, je užitečný při couvání nebo parkování.<br><br>Ve hře máme ještě další kamery, můžeš si je vyzkoušet opakovaným stisknutím @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_cam1@@ pro návrat do interiéru.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Pro autentický zážitek z autoškoly doporučujeme při plnění scénářů zůstávat ve vnitřní kameře.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro potvrzení a ukončení scénáře.</font>@@aca_goal_tip@@ Můžeš využít funkce @@o_im_cam_zoom@@ pro lepší přehled o svém okolí. Užitečná je zejména při pohledu na zrcátka. Zkontroluj obrazovku Nastavení - „@@options_bindings_screen@@“ pro zobrazení nebo změnu příslušných ovládacích prvků."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "První jízda"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "V tomto scénáři se naučíš základní úkony před jízdou a vyzkoušíš si první jízdu vpřed."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Zapnutí napájení"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Nastartování motoru"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Kontrola okolí"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Použití provozní brzdy"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Zařazení převodového stupně"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Uvolnění parkovací brzdy"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Jízda vpřed"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Zastavení"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Zatažení parkovací brzdy"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Zařazení neutrálu"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Vypnutí motoru"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "V rámci tvých prvních jízd budeme jezdit pouze s tahačem.<br>Nákladní vůz se nazývá tahač, když nemá vlastní korbu a místo toho se spoléhá na použití návěsu pro přepravu zboží a materiálů."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Tahače jsou běžné, protože nabízí větší všestrannost: mohou bez čekání odložit prázdný návěs a vyzvednout naložený nebo připojit úplně jiný druh návěsu."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "V rámci první jízdy je tvým úkolem popojet dopředu a zastavit za přerušovanou čárou.<br>Nastartuj motor a podle pokynů připrav tahač k jízdě. Jakmile budeš připraven, rozjeď se dopředu."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Přejeď přerušovanou čáru, zastav, vypni motor a zajisti tahač."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Jako další krok ve tvém výcviku poprvé popojedeš s tahačem.<br><br>Samozřejmě, že bez běžícího motoru to nepůjde, takže nejprve musíš zapnout napájení.<br><br><font face=/font/big_bold.font>Stisknutím $input engineelect$ zapneš napájení.</font>@@aca_goal_tip@@ V kariéře se ve výchozím nastavení zapne napájení automaticky při nastartování motoru. Pro kariéru můžeš toto chování upravit na obrazovce nastavení - \"Hra\" - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Napájení aktivuje elektroniku tahače. Možná sis všiml, že na palubní desce blikají výstražné kontrolky – to je normální. Pokud by zůstaly svítit i po nastartování motoru, pak to pravděpodobně signalizuje problém s tahačem. Výjimkou je kontrolka parkovací brzdy, která zhasne až jakmile parkovací brzdu uvolníme.<br><br>Tento tahač je naštěstí v dobrém stavu, takže jsme připraveni vyrazit.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_engine@@ pro nastartování motoru.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Nyní, když je motor nastartován, je důležité před zahájením jakéhokoli pohybu zkontrolovat své okolí.<br><br><font face=/font/big_bold.font>Rozhlédni se kolem tahače a zkontroluj boční zrcátka na straně řidiče i spolujezdce, aby ses ujistil, že okolí tvého tahače je volné.</font>@@aca_goal_tip@@ Musíš být uvnitř vozidla."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Může se to zdát samozřejmé, ale před zahájením jakéhokoliv pohybu bys měl vědět, jak zastavit.<br><br><font face=/font/big_bold.font>Aktivuj provozní brzdu pomocí $input backward$.</font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Nyní se naučíme, jak změnit směr jízdy.<br><br>Se zjednodušenou automatickou převodovkou není nutné zařadit směr, vše automaticky dělá hra za tebe, na rozdíl od reality.<font face=/font/big_bold.font><br><br>Použitím $input forward$ aktivuješ jízdu vpřed.</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Nyní se naučíme, jak změnit směr jízdy.<br><br>Reálná automatická převodovka umožňuje řadit mezi jízdou vpřed, neutrálem a zpátečkou stejně jako skutečné automatické převodovky.<br><br><font face=/font/big_bold.font>Stisknutím @@imv_nrm_gearup@@ aktivuješ jízdu vpřed.</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Nyní se naučíme, jak změnit směr jízdy.<br><br>Sekvenční převodovka umožňuje postupné řazení rychlostí stejně jako skutečné sekvenční převodovky.<br><br>Stejným způsobem jako zařadíš rychlost vpřed pak za jízdy při zrychlování řadíš vyšší převodové stupně.<br><br><font face=/font/big_bold.font>Stisknutím @@imv_nrm_gearup@@ zařadíš první stupeň.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Nyní se naučíme, jak změnit směr jízdy.<br><br>S řadicí pákou a spojkou zažiješ stejný pocit z fyzického řazení rychlostí jako se skutečným manuálním řazením.<br><br>Naplno sešlápni spojku a provozní brzdu.<font face=/font/big_bold.font>Použitím řadicí páky zařaď první stupeň.<color value=@@clr_txt@@>Spojku a provozní brzdu nadále drž plně sešlápnuté.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Pro rozjetí je potřeba uvolnit parkovací brzdu.<br><br><font face=/font/big_bold.font>Použij @@imv_nrm_parkingbrake@@ pro uvolnění parkovací brzdy.</font> @@aca_goal_tip@@ V kariéře je parkovací brzda ve výchozím stavu zatažena. Toto chování můžeš upravit na obrazovce nastavení - \"Hra\" - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Nyní je tahač připravený k jízdě vpřed. Rozjeď se a přejeď přes přerušovanou čáru.<br><br><font face=/font/big_bold.font>Rozjeď se použitím akcelerátoru: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Nyní je tahač připravený k jízdě vpřed. Rozjeď se a přejeď přes přerušovanou čáru.<br><br><font face=/font/big_bold.font>Rozjeď se použitím akcelerátoru: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Nyní je tahač připravený k jízdě vpřed. Rozjeď se a přejeď přes přerušovanou čáru.<br><br><font face=/font/big_bold.font>Rozjeď se použitím akcelerátoru: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Nyní je tahač připravený k jízdě vpřed. Rozjeď se a přejeď přes přerušovanou čáru.<br><br><font face=/font/big_bold.font>Uvolni provozní brzdu, pomalu pouštěj spojku tzv. do záběru a přitom pomocí akcelerátoru lehce zvyšuj otáčky motoru, aby nezhasnul. Po úplném uvolnění spojky můžeš podle potřeby zrychlovat a řadit.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "K zastavení použij provozní brzdu.<br><br><font face=/font/big_bold.font>Použij $input backward$ pro zastavení tahače.</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "K zastavení použij provozní brzdu.<br><br><font face=/font/big_bold.font>Použij $input backward$ pro zastavení tahače.</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "K zastavení použij provozní brzdu.<br><br><font face=/font/big_bold.font>Použij $input backward$ pro zastavení tahače.</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Před zastavením plně sešlápni spojku <font face=/font/big_bold.font>a poté zastav tahač provozní brzdou. <color value=@@clr_txt@@>Zařazenou rychlost vyřaď do neutrálu použitím řadicí páky a následně můžeš pustit spojku.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Nyní zajisti tahač. Parkovací brzda zajišťuje, že se vozidlo po zaparkování nechtěně nerozjede.<br><br><font face=/font/big_bold.font>Použij @@imv_nrm_parkingbrake@@ pro zatažení parkovací brzdy.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Se zjednodušenou automatickou převodovkou není potřeba řadit, vše automaticky dělá hra za tebe.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro potvrzení.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Zařaď neutrál stisknutím @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Zařaď neutrál stisknutím @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Vyřaď řadicí páku do neutrálu a následně pusť spojku.</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Nyní už víš, jak se s tahačem rozjet a jak jej bezpečně zastavit.<br><br><font face=/font/big_bold.font>Stisknutím $input engineelect$ vypneš motor.</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Jízda vzad"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "V tomto scénáři si poprvé vyzkoušíš jízdu vzad. Povíme si také, jak používat zrcátka, abys viděl za sebe, jak se na couvání připravit a na co si dávat pozor."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Nastartování motoru"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Kontrola zrcátka na straně spolujezdce"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Kontrola zrcátka na straně řidiče"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Zařazení převodového stupně"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Uvolnění parkovací brzdy"

#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}


	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Zařazení neutrálu"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Vypnutí motoru"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "V této lekci si osvojíme jízdu vzad v přímém směru. Zacouváš za přerušovanou čáru a tam zastavíš."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Pro jízdu vzad je především potřeba rozhlížet se kolem tahače, sledovat zrcátka a hlídat si, zda je za tebou i kolem tebe volno."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Nastartuj, zařaď zpátečku a rozjeď se."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Zacouvej za přerušovanou čáru, zastav, vypni motor a zajisti tahač."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Připrav tahač k jízdě tak, jak ses naučil v předchozím scénáři.<br><br><font face=/font/big_bold.font>Jakmile budeš připraven, nastartuj motor.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Zkontroluj si zrcátka, aby ses ujistil, že máš kolem sebe volno. Pokud nejsi s pozicí zrcátek spokojen, můžeš si je upravit přes \"@@adjust_link_t@@\".<br><br><font face=/font/big_bold.font>Podívej se na boční zrcátko na straně spolujezdce.</font>@@aca_goal_tip@@ Musíš být uvnitř vozidla."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Pojedeš za přerušovanou čáru. Cesta je nyní volná, ale při běžné jízdě bude potřeba si neustále hlídat své okolí rozhlížením se a používáním zrcátek.<br><br><font face=/font/big_bold.font>Podívej se na boční zrcátko na straně řidiče.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Použitím $input backward$ zařaď zpátečku.</font>@@aca_goal_tip@@Při couvání se na většině tahačích rozezní zvukový signál. Můžeš jej vypnout na obrazovce nastavení - \"Zvuk\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Stiskni @@imv_nrm_geardown@@ pro zařazení zpátečky.</font>@@aca_goal_tip@@Při couvání se na většině tahačích rozezní zvukový signál. Můžeš jej vypnout na obrazovce nastavení - \"Zvuk\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Stiskni @@imv_nrm_geardown@@ pro zařazení zpátečky.</font>@@aca_goal_tip@@Při couvání se na většině tahačích rozezní zvukový signál. Můžeš jej vypnout na obrazovce nastavení - \"Zvuk\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Plně sešlápni spojku a zařaď zpátečku.</font>@@aca_goal_tip@@Při couvání se na většině tahačích rozezní zvukový signál. Můžeš jej vypnout na obrazovce nastavení - \"Zvuk\" - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Nyní máš zařazenou zpátečku.<br><br><font face=/font/big_bold.font>Uvolni parkovací brzdu použitím @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Rozjeď se použitím $input backward$.<br><br><font face=/font/big_bold.font>Zacouvej za přerušovanou čáru.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Rozjeď se použitím akcelerátoru: $input forward$.<br><br><font face=/font/big_bold.font>Zacouvej za přerušovanou čáru.</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Rozjeď se použitím akcelerátoru: $input forward$.<br><br><font face=/font/big_bold.font>Zacouvej za přerušovanou čáru.</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Pomalu pouštěj spojku a přitom pomocí akcelerátoru udržuj otáčky motoru.<br><br><font face=/font/big_bold.font>Zacouvej za přerušovanou čáru.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Zastav tahač pomocí provozní brzdy: $input forward$</font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Zastav tahač pomocí provozní brzdy: $input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Zastav tahač pomocí provozní brzdy: $input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Plně sešlápni spojku a zastav tahač pomocí provozní brzdy.</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zatáhni parkovací brzdu použitím @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Se zjednodušenou automatickou převodovkou není potřeba řadit, vše automaticky dělá hra za tebe, na rozdíl od skutečnosti.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro potvrzení.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Zařaď neutrál stisknutím @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderní tahače automaticky zařadí neutrál se zatažením parkovací brzdy. Je však dobrým zvykem vyřazovat do neutrálu sám. V následujících scénářích nebudeme tento krok vyžadovat."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Zařaď neutrál stisknutím @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderní tahače automaticky zařadí neutrál se zatažením parkovací brzdy. Je však dobrým zvykem vyřazovat do neutrálu sám. V následujících scénářích nebudeme tento krok vyžadovat."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Vyřaď do neutrálu a sešlápni spojku.</font>@@aca_goal_tip@@ Moderní tahače automaticky zařadí neutrál se zatažením parkovací brzdy. Je však dobrým zvykem vyřazovat do neutrálu sám. V následujících scénářích nebudeme tento krok vyžadovat."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Při couvání si nezapomeň vždy dávat pozor na své okolí, zejména v rušných oblastech s velkým provozem.<br><br><font face=/font/big_bold.font>Vypni motor stisknutím $input engineelect$.</font>"
#@}

