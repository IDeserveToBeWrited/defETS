	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "V tomto scénáři si projdeme, jak se otočit v omezeném prostoru za použití manévru couvání přes ruku. Tato dovednost se ti bude hodit v situacích, kdy se nemůžeš otočit nebo zacouvat na stranu řidiče."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Značení na silnici ti pomůže s jízdou po trati."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Najeď si zeširoka, aby tvůj návěs bezpečně projel kolem zaparkovaných kamionů."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Jakmile vyjedeš ze zatáčky, mysli na to, jak připravíš svůj kamion na couvací manévr."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Pomůže ti zastavit s tahačem pod úhlem směrem k volnému parkovacímu místu na straně spolujezdce, kam budeš couvat."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Couvání přes ruku by ses měl vyhýbat, pokud je to možné, protože budeš mít značně snížený rozhled. Bohužel jsou situace, kdy je to však nevyhnutelné."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Zatoč volantem, než začneš couvat. Pomůže ti to okamžitě nasměrovat návěs kam potřebuješ, což pomáhá ve stísněných prostorech."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Jakmile je návěs skoro celý na místě, najeď s tahačem před něj a vyrovnej se."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Zastav v momentě, kdy budeš vyrovnán a budeš mít dostek místa k vyjetí. Vyjeď ven, kudy jsi přijel."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Následuj značení na silnici směrem z tréninkové trati."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Projeď zatáčkou a jeď k vyznačenému místu."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Zastavení."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Zajisti tahač a vypni motor."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Před tebou se nachází tréninkový prostor představující parkoviště spediční společnosti. Tvým úkolem je tam zajet, otočit se a přijet zpátky. Dobře využij dostupné místo.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Pokračuj k tréninkovému prostoru.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Zatoč a pokračuj po trati.</font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Následuj značení na silnici k bariérám na konci trati. Zaparkuj lehce pod úhlem, aby tvůj návěs byl natočen k prázdnému parkovacímu místu na straně spolujezdce.<br><br><font face=/font/big_bold.font>Pokračuj vpřed.</font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Při couvání přes ruku máš omezený výhled. Jeď pomalu, využívej zrcátka a buď opatrný.<br><br><font face=/font/big_bold.font>Začni couvat a zatoč s návěsem do prázdného parkovacího místa.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "To stačí. Nyní můžeš vyjet popředu z trénovacího prostoru stejným směrem, odkud jsi přijel.<br><br><font face=/font/big_bold.font>Jeď směrem k výjezdu.</font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Opusť tréninkovou oblast.</font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Postupuj podle značení k závěrečnému parkovacímu místu.<br><br><font face=/font/big_bold.font>Pokračuj na vyznačené místo.</font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Couvání při parkování do strany"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "V tomto scénáři budeš mít za úkol zacouvat na parkovací místo, které není přímo za tebou. Prostor pro manévrování je omezený, takže ho musíš využít moudře."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "V tomto scénáři bude tvým úkolem zaparkovat na místě vedle tebe. Není zde mnoho prostoru pro manévrování, takže se budeš muset trochu více snažit, abys návěs dostal tam, kam chceš."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Jeď rovně až k bariéře."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Zastav před bariérou."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Před rozjetím ostře zatoč volantem na stranu řidiče. Tím se návěs začne stáčet k parkovacímu místu hned jakmile začneš couvat, čímž ušetříš cenný prostor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Jakmile nasměruješ návěs tam, kam chceš, dostaň tahač před návěs a začni s ním zatáčet na parkovací místo."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Odtud už se to v zásadě neliší od běžného parkovacího manévru."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Pokračuj v couvání a sleduj obě strany. Udržuj tahač a návěs srovnaný s parkovacím místem."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zastav na vyznačeném místě, zajisti tahač a vypni motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Nacházíš se na parkovacím místě, ale po své pravici máš druhé parkovací místo, na které musíš přejet.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Před tebou je vyznačená oblast.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Nezapomeň okamžitě začít zatáčet, protože tam není mnoho místa.<br><br><font face=/font/big_bold.font>Zacouvej na označené místo za sebou.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Jízda jednoduchými zatáčkami"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "V tomto scénáři se projedeš krátkou cvičnou dráhou, která ti pomůže naučit se manévrovat s návěsem přes jednoduché pravoúhlé zatáčky."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Projetí první zatáčky"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Druhá zatáčka"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Poslední zatáčka"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Čeká tě několik prudkých zatáček, kde není místa nazbyt. Pomůžou ti naučit se manévrovat s návěsem efektivně."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Následuj značení na silnici vedle bariér na straně řidiče a připrav se na první zatáčku."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "V zatáčce se drž blízko vnějších bariér a návěs by tě měl krásně následovat."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Pokračuj podle značek na silnici k druhé zatáčce - úzký pravoúhlý roh."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Musíš si najet hluboko do rohu, abys měl jistotu, že se návěs vejde mezi bariéry. Použij přední zrcátko jako pomocníka, abys věděl jak daleko můžeš jet, aniž bys do čehokoli narazil."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Pokračuj podél vnější bariéry."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Další úzký pravoúhlý roh, který vyžaduje maximální využití dostupného místa."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Zastav na vyznačeném místě a zajisti tahač."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Nazapomeň plně využít dostupné místo v každé zatáčce.<br><br><font face=/font/big_bold.font>Rozjeď se a jeď podle značek na silnici.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Jeď podél vnější bariéry, ale hlídej si návěs v zrcátku.<br><br><font face=/font/big_bold.font>Projeď první zatáčkou.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Následuj značení na silnici, aby ses připravil na pravoúhlou zatáčku před sebou.<br><br><font face=/font/big_bold.font>Projeď pravoúhlou zatáčkou.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Drž se s kamionem na vnější straně, protože tě čeká další, prudší, pravoúhlá zatáčka.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovací místo před tebou.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}

#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Couvání při parkování pod úhlem"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "V tomto scénáři prozkoumáme parkování pod úhlem při couvání. S tím se můžeš setkat na odpočívadlech, motorestech a dokonce i u dopravců. Často je málo místa, protože parkoviště jsou zaplněná kamiony, takže parkování je těžší."

#### 3_16 goal


	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Zatočení návěsu"
#!{
	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Parkování pod úhlem se na první pohled zdá jednoduché, ale často je těžší než couvání při běžném kolmém parkování."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Zacouvej k parkovacímu místu. Udržuj tahač rovně s návěsem."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Jakmile se začneš přibližovat, nech jet návěs těsněji k zaparkovaným kamionům. To ti pomůže zatočit na parkovací místo, jakmile se k němu dostaneš."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Začni natáčet návěs na parkovací místo. Udržuj svůj návěs blízko kamionu po straně řidiče, neboť místo na druhé straně budeš ještě potřebovat."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "V momentě, kdy je návěs téměř celý na parkovacím místě, začni otáčet tahač a následuj návěs dovnitř."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Zaparkuj na vyznačeném místě, zajisti tahač a vypni motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Zaparkuj na místo za sebou. Při couvání využívej obě zrcátka.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Zkontroluj své okolí a následně vyraž k parkovacímu místu.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Začni se návěsem přibližovat ke kamionům vedle sebe. Jakmile budeš připraven, zatoč návěs na parkovací místo. Nezapomeň na vybočení návěsu.<br><br><font face=/font/big_bold.font>Zatoč na parkovací místo.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Couvání do zatáčky"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "V tomto scénáři budeme poprvé couvat s návěsem do zatáčky. Podíváme se na základy couvání a na co si dávat pozor při couvání do zatáčky."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Zatočení návěsu"
#!{
	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

