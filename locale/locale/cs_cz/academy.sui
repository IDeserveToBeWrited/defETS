#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Jízda složitými zatáčkami"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "V tomto scénáři si vyzkoušíme manévrovat s návěsem po krátké trati s překážkami a složitějšími zatáčkami."

#### 3_03 goal


	key[]: "aca_goal_book1_3_03_check1"
	val[]: "První zatáčky"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Průjezd zúžením"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Úzká kolmá zatáčka"
