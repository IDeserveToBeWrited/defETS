#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Připojení návěsu"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "V tomto scénáři si vysvětlíme základy připojování a odpojování návěsu k tahači."

#### 3_01 goal


	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Couvání k návěsu"



	key[]: "aca_goal_book1_3_01_connect"
