	key[]: "eye_head_walk_pitch_scale_op_tooltip"
	val[]: "Nastavuje, jak moc se kamera ve hře otočí nahoru nebo dolů ve srovnání s tím, jak moc otočíš hlavu (v režimu chůze)."

	key[]: "eye_head_exponent_op_tooltip"
