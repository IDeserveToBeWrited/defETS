#+ Screen link tooltips
#@{
	key[]: "link_locked_msg_quick_jobs" # - tooltip for when the quick jobs are not yet unlocked, appears at the very start of the game before the player is done with the first job and they are doing the tutorial
	val[]: "Pro přístup do rychlých zakázek musíš nejdříve dokončit probíhající výuku."

	key[]: "link_locked_msg_company_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Pro přístup do nabídky zakázek musíš nejdříve koupit svůj první tahač."

	key[]: "link_locked_msg_cargo_market" # - tooltip for when the cargo market is not yet unlocked
	val[]: "Pro přístup do nabídky nákladů musíš nejdříve koupit svůj první návěs."

	key[]: "link_locked_msg_online_jobs" # - tooltip for when the company jobs are not yet unlocked
	val[]: "Pro přístup do externích zakázek musíš nejdříve koupit svůj první tahač a mít připojený profil k World of Trucks."

	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "Pro přístup do externích nákladů musíš nejdříve koupit svůj první návěs a mít připojený profil k World of Trucks."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "Zobraz si mapu světa, objevené oblasti či svou aktuální trasu navigace, kterou si můžeš i upravit."

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "Rychle odcestuj do dříve objeveného města, za poplatek."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "Procházej, vyhledávej a filtruj konvojové relace, ke kterým se můžeš připojit, nebo založ svou vlastní pro ostatní."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "Tvá schránka pro zprávy ze světa obchodu, bank a nových zaměstnanců."

	key[]: "link_locked_msg_mail" # - tooltip for when the mail is not yet unlocked
	val[]: "E-maily začnou přicházet, jakmile postoupíš dále svou kariérou."

	key[]: "real_estate_desc" # - tooltip for explaining what real estate/garage purchase screen is - feature is active
	val[]: "Najdi a kup dostupné garáže na mapě světa."

	key[]: "used_trucks_desc" # - tooltip for explaining what used trucks are - feature is active
	val[]: "Prohlédni si a porovnej ojeté tahače dostupné ke koupi."

	key[]: "link_locked_msg_used_trucks" # - tooltip for when the used trucks are not yet unlocked
	val[]: "Zatím jsi neobjevil žádné prodejce tahačů."

	key[]: "trailer_dealer_desc" # - tooltip for explaining what the trailer dealer is - feature is active
	val[]: "Prohlédni si, porovnej a překonfiguruj návěsy dostupné ke koupi."

	key[]: "radio_desc" # - tooltip for explaining what the radio is - feature is active
	val[]: "Vylepši si zážitek z jízdy trochou hudby."

	key[]: "link_locked_msg_radio" # - tooltip for when the radio is not yet unlocked
	val[]: "Rádio není dostupné."

	key[]: "options_desc" # - tooltip for explaining what the options are
	val[]: "Nastav si grafiku, zvuk, herní prvky, ovládání a online funkce."

	key[]: "career_progress_desc" # - tooltip for explaining what the career screen is - feature is active
	val[]: "Prohlédni si svůj kariérní postup, statistiky a nedávno dokončené zakázky."

	key[]: "link_locked_msg_current_session" # - tooltip for when the Active convoy is not yet unlocked
	val[]: "Pro přístup do aktivního konvoje se musíš nejprve připojit do konvojové relace."
#@}

#+ Intro Scene. Only translate into officially supported languages.
#@{
	key[]: "health_warning"
	val[]: "Zdravotní varování"

	key[]: "health_warning_description"
	val[]: "Několik málo uživatelů může být náchylných k epileptickým záchvatům nebo ztrátě vědomí, pokud jsou vystaveni určitým blikajícím světlům nebo světelným vzorům. Takoví jedinci mohou dostat záchvat při sledování určitých obrázků nebo hraní videohry. Pokud jste vy nebo někdo z vaší rodiny někdy měli příznaky související s epilepsií (záchvaty nebo ztrátu vědomí), když jste byli vystaveni blikajícím světlům, poraďte se s lékařem a před hraním hry proveďte všechna nezbytná opatření.<br offset=20>Pokud vy nebo vaše dítě zaznamenáte některý z následujících příznaků během hraní jakékoliv videohry: závratě, změněné vidění, záškuby očí nebo svalů, ztrátu vědomí, dezorientaci, křeče či mimovolní pohyby, okamžitě ukončete videohru a před pokračováním se poraďte s lékařem."

	key[]: "trademark"
	val[]: "Všechny názvy značek, ochranné známky, registrované značky, loga a symboly na vozidlech ve hře jsou majetkem jejich oprávněných vlastníků. Použito s laskavým svolením. Ochranné známky a vzory MAN® jsou registrovanými právy společnosti MAN Truck & Bus AG a jsou používány na základě licence pro SCS Software s.r.o. „Mercedes-Benz“ a „Třícípá hvězda v kruhu“ jsou ochranné známky společnosti Daimler AG a jsou používány na základě licence pro SCS Software s.r.o. Ochranné známky a vzory RENAULT jsou registrovanými právy skupiny AB Volvo Group nebo jsou jí licencovány a používány na základě licence. Ochranné známky a vzory VOLVO jsou registrovanými právy skupiny AB Volvo Group nebo jsou jí licencovány a používány na základě licence."
#@}

