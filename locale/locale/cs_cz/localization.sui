	key[]: "used_truck_dealer_explanation_state_1"
	val[]: "Vozidlo má značné mechanické problémy ovlivňující výkon a spolehlivost. Možná budeš muset řešit kompletní renovaci nebo výměnu vícero dílů." #+ Explanation of 1-star state.

	key[]: "used_truck_dealer_explanation_state_2"
	val[]: "Vozidlo vykazuje mechanické problémy, které mohou omezit jeho výkon nebo spolehlivost. Servis je vyžadován." #+ Explanation of 2-star state.

	key[]: "used_truck_dealer_explanation_state_3"
	val[]: "Vozidlo je pojízdné, ale může mít nějaké problémy. Servis je doporučen." #+ Explanation of 3-star state.

	key[]: "used_truck_dealer_explanation_state_4"
	val[]: "Vozidlo je v zachovalém stavu, pouze s mírným opotřebením." #+ Explanation of 4-star state.

	key[]: "used_truck_dealer_explanation_state_5"
