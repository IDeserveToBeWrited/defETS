#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "Výběr typu ovladače, aby hra správně zpracovala vstupní rozsahy."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "Výběr způsobu řazení:<br>- „Zjednodušená automatická“ umožňuje použití plynu a brzdy k ovládání pohybu vpřed a vzad.<br>- „Reálná automatická“ vyžaduje vstup pro přepnutí mezi pohybem vpřed a vzad.<br>- „Sekvenční“ vyžaduje manuální řazení všech rychlostních stupňů se vstupy pro řazení nahoru/dolů.<br>- „Řadicí páka“ vyžaduje použití příslušného ovladače pro manuální řazení převodových stupňů."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "Mění průběh řazení automatické převodovky:<br>- „Úsporný“ režim preferuje nižší otáčky pro dosažení maximálního točivého momentu.<br>- „Výkonný“ režim preferuje maximální výkon pro lepší jízdní vlastnosti při velkém zatížení nebo v kopcovitém terénu na úkor spotřeby paliva."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje poměr úhlu zatočení ovladače vůči skutečnému úhlu zatočení vozidla."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje linearitu mezi vstupem a zatáčením vozidla.<br><br>Vyšší nastavení této hodnoty znamená, že zatáčení bude méně reagovat, když je volant uprostřed, a zvýší se citlivost zatáčení volantu směrem k maximální poloze. To může být užitečné pro vyrovnání zásahů do řízení při jízdě rovně."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "Zapíná zpětnou vazbu na ovladačích, které ji podporují."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje celkovou sílu pro všechna nastavení zpětné vazby od 0 N do 10 N.<br><br><color value=@@clr_txt_d@@>Upozorňujeme, že vyšší nastavení u výkonných základen volantů může způsobit zranění prstů nebo rukou."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje sílu centrování při jízdě vysokou rychlostí, která vrcholí při 90 km/h (56 mil/h) a výše.<br><br>Minimální nastavení bude mít za následek žádnou centrovací sílu volantu."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje sílu centrování při jízdě nízkou rychlostí.<br><br>Minimální nastavení bude mít za následek žádnou centrovací sílu volantu."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje sílu umělého vnitřního tření způsobeného mechanickými součástmi řízení."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje sílu umělé rezonance motoru přes sloupek řízení.<br><br><color value=@@clr_txt_d@@>Upozorňujeme, že nastavení této hodnoty nad 15 % může způsobit nadměrné otřesy a vibrace některých volantů."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje sílu efektů terénních povrchů přes sloupek řízení.<br><br><color value=@@clr_txt_d@@>Upozorňujeme, že nastavení této hodnoty nad 20 % může způsobit nadměrné otřesy a vibrace některých volantů při jízdě po nerovném terénu vysokou rychlostí."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje sílu efektů nerovnosti vozovky přes sloupek řízení."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje sílu efektů kolize vozidla přes sloupek řízení."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektů obrušování převodovky."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu efektů nedotáčivého smyku."

	key[]: "force_feedback_assisted_steering_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje intenzitu asistovaného řízení (např. při použití funkce jízdního asistenta)."

	key[]: "force_feedback_vibration_surface_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu vibrací terénních povrchů na ovladačích podporujících vibrační zpětnou vazbu."

	key[]: "force_feedback_vibration_bumps_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu nárazů do zavěšení na ovladačích podporujících vibrační zpětnou vazbu."

	key[]: "force_feedback_vibration_collisions_op_tooltip" # - Controls, Advanced
	val[]: "Upravuje intenzitu kolizí na ovladačích podporujících vibrační zpětnou vazbu."

	key[]: "steer_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa ovladače vybraná pro zatáčení."

	key[]: "steer_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje mrtvou zónu osy zatáčení; část vstupního zatáčení od středu, která je ignorována.<br><br>To může zmírnit nepřesnosti nebo chybné vstupy způsobené opotřebováním hardwaru na starších ovladačích."

	key[]: "steer_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určuje, jakým způsobem hra zpracovává vstup osy zatáčení:<br>- Centrovaný je ideální pro volanty nebo joysticky.<br>- Invertovaný se používá pro korekci osy, která byla detekována špatně."

	key[]: "acc_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa ovladače vybraná pro zrychlení vozidla."

	key[]: "acc_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje mrtvou zónu osy zrychlení; část vstupu, která je ignorována.<br><br>To může zmírnit nepřesnosti nebo chybné vstupy způsobené opotřebováním hardwaru na starších ovladačích."

	key[]: "acc_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určuje, jakým způsobem hra zpracovává vstup osy zrychlení:<br>- Centrovaný je ideální pro joysticky.<br>- Normální je ideální pro triggery nebo pedály.<br>- Invertovaný se používá pro korekci osy, která byla detekována špatně."

	key[]: "brake_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa ovladače vybraná pro brzdění vozidla."

	key[]: "brake_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje mrtvou zónu osy brzdění; část vstupu, která je ignorována.<br><br>To může zmírnit nepřesnosti nebo chybné vstupy způsobené opotřebováním hardwaru na starších ovladačích."

	key[]: "brake_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určuje, jakým způsobem hra zpracovává vstup osy brzdění:<br>- Centrovaný je ideální pro joysticky.<br>- Normální je ideální pro triggery nebo pedály.<br>- Invertovaný se používá pro korekci osy, která byla detekována špatně."

	key[]: "clutch_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa ovladače vybraná pro spojku."

	key[]: "clutch_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje mrtvou zónu osy spojky; část vstupu, která je ignorována.<br><br>To může zmírnit nepřesnosti nebo chybné vstupy způsobené opotřebováním hardwaru na starších ovladačích."

	key[]: "clutch_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určuje, jakým způsobem hra zpracovává vstup osy spojky:<br>- Centrovaný je ideální pro joysticky.<br>- Normální je ideální pro triggery nebo pedály.<br>- Invertovaný se používá pro korekci osy, která byla detekována špatně."

	key[]: "clutch_range_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje rozsah spojky.<br><br>Čím vyšší hodnota, tím více budeš muset sešlápnout pedál, abys sepnul spojku."

	key[]: "look_updown_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa ovladače vybraná pro rozhlížení nahoru a dolů."

	key[]: "look_updown_axis_dz_op_tooltip" # - Controls, Advanced
	val[]: "Nastavuje mrtvou zónu osy pro rozhlížení nahoru a dolů; část vstupu, která je ignorována.<br><br>To může zmírnit nepřesnosti nebo chybné vstupy způsobené opotřebováním hardwaru na starších ovladačích."

	key[]: "look_updown_axis_mode_op_tooltip" # - Controls, Advanced
	val[]: "Určuje, jakým způsobem hra zpracovává vstup osy:<br>- Centrovaný je ideální pro joysticky.<br>- Invertovaný se používá pro korekci osy, která byla detekována špatně."

	key[]: "look_leftright_axis_op_tooltip" # - Controls, Advanced
	val[]: "Osa ovladače vybraná pro rozhlížení doleva a doprava."

	key[]: "look_leftright_axis_dz_op_tooltip" # - Controls, Advanced
