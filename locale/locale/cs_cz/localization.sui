	val[]: "Výběr přednastavení rozšířeného pohledu."

	key[]: "eye_head_mode_op_tooltip"
	val[]: "Výběr režimů snímání hlavy:<br>- V režimu „Přímý“ otáčení hlavy přímo odpovídá otáčení kamery ve hře. Doporučuje se pro běžné používání uvnitř interiéru.<br>- V režimu „Dynamický“ tvůj pohled ovlivní herní kameru, pouze když skutečně otočíš hlavou. Doporučuje se, pokud je žádoucí, aby pohled zůstával zcela vycentrovaný."

	key[]: "eye_autocenter_op_tooltip"
	val[]: "Je-li povoleno, herní kamera se bude pozvolna vracet na střed, když během hraní změníš přirozenou pozici hlavy."

	key[]: "eye_head_position_op_tooltip"
	val[]: "Je-li povoleno, tvoje pozice hlavy ovlivní pozici herní kamery."

	key[]: "eye_head_roll_op_tooltip"
	val[]: "Je-li povoleno, herní kamera se nakloní odpovídajícím způsobem při naklonění hlavy na kteroukoliv stranu."

	key[]: "eye_yaw_scale_op_tooltip"
	val[]: "Násobí společné otáčení hlavou a pohledem ve vodorovném směru (v kabině)."

	key[]: "eye_pitch_scale_op_tooltip"
	val[]: "Násobí společné otáčení hlavou a pohledem ve svislém směru (v kabině)."

	key[]: "eye_walk_mode_yaw_scale_op_tooltip"
	val[]: "Násobí společné otáčení hlavou a pohledem ve vodorovném směru (v režimu chůze)."

	key[]: "eye_walk_mode_pitch_scale_op_tooltip"
	val[]: "Násobí společné otáčení hlavou a pohledem ve svislém směru (v režimu chůze)."

	key[]: "eye_gaze_view_responsiveness_op_tooltip"
	val[]: "Nastavuje, jak rychle bude herní kamera reagovat na tvé pohyby pohledem."

	key[]: "eye_gaze_exponent_op_tooltip"
	val[]: "Nastavuje, jak se postupně zvyšuje rychlost."

	key[]: "eye_gaze_inflection_point_op_tooltip"
	val[]: "Nastavuje vzdálenost od středu obrazovky, kde se zrychlení začne vyrovnávat."

	key[]: "eye_gaze_start_point_op_tooltip"
