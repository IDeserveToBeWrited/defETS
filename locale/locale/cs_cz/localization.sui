	key[]: "eye_head_inflection_point_op_tooltip"
	val[]: "Nastavuje, jak moc je potřeba otočit hlavou, než se zrychlení začne vyrovnávat."

	key[]: "eye_head_start_point_op_tooltip"
	val[]: "Nastavuje, jak moc je potřeba otočit hlavou od středu, než se herní kamera začne pohybovat."

	key[]: "eye_head_end_point_op_tooltip"
	val[]: "Nastavuje, jak moc je potřeba otočit hlavou od středu pro dosažení maximálního otočení kamery."

	key[]: "eye_autopause_mode_op_tooltip"
	val[]: "Výběr režimů automatického pozastavení."

	key[]: "eye_autopause_gaze_op_tooltip"
	val[]: "Nastavuje čas v milisekundách, než se hra automaticky zastaví, když nedokáže detekovat tvůj pohled."

	key[]: "o_im_head_reset_op_tooltip"
