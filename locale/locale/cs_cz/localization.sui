#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "Pokračovat ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "Vítejte v Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "Konečně máš možnost zažít práci svých snů - řízení tahače!"

	key[]: "intro_3"
	val[]: "Tvá společnost nyní začala podnikat, bohužel ale nemáš peníze pro nákup vlastního tahače. Musíš tedy zatím pracovat u jiných společností jako běžný řidič."

	key[]: "intro_4"
	val[]: "Tvým úkolem je bezpečně doručit do firmy $JOB_TARGET_COMPANY$ ve městě $JOB_TARGET_CITY$ tento náklad: $JOB_CARGO$. Zaměstnavatel ti poskytl vozidlo a uhradí veškeré náklady. Hlavně se snaž přijet včas."


	key[]: "intro_garage_1"
	val[]: "Toto je tvoje hlavní sídlo."

	key[]: "intro_garage_2"
	val[]: "Je to velmi obyčejná garáž. Není to mnoho, ale pro začátek dostačující."

	key[]: "intro_garage_3"
	val[]: "Bohužel ještě nemáš žádný tahač, který bys sem mohl zaparkovat."

	key[]: "intro_garage_4"
	val[]: "Jakmile si vyděláš dostatek peněz a koupíš si vlastní tahač, budeš se moci libovolně pohybovat po světě a založit zde svůj vlastní podnik."

	key[]: "intro_garage_5"
	val[]: "Hodně štěstí!"


	key[]: "desktop_tut_t"
	val[]: "FUNKCE ODEMČENA"

	key[]: "desktop_tut_job"
	val[]: "Vyber si další zakázku"

	key[]: "desktop_tut_cargo_market"
	val[]: "Použij svůj vlastní návěs pro přístup do nabídky nákladů, jejímž prostřednictvím můžeš doručovat širokou škálu nákladů do jejich destinací." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "Zde vidíš svůj pokrok:"

	key[]: "desktop_tut_company"
	val[]: "Odsud můžeš sledovat své garáže, najímat nové řidiče a jinak spravovat společnost."

	key[]: "desktop_tut_trailers"
	val[]: "Od teď můžeš nakupovat vlastní návěsy, vylepšovat je a natírat tak, aby ladily s tvým tahačem.<br><br>Návěsy můžeš umístit do svých garáží, kde mohou být používány tvými řidiči pro navýšení zisků. Své návěsy můžeš spravovat ve správě návěsů."

	key[]: "desktop_tut_visit_directive"
	val[]: "Navštiv $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "VÍTEJ"

	key[]: "desktop_tut_tour_welcome"
	val[]: "Vítej na nové domovské obrazovce.<br>Odsud můžeš interagovat se všemi funkcemi ve hře."

	key[]: "desktop_tut_tour_main_menu"
	val[]: "Hlavní nabídka níže poskytuje přímý přístup ke všem základním herním funkcím, které dobře znáte."

	key[]: "desktop_tut_tour_top_bar"
	val[]: "Nový stavový řádek v horní části poskytuje neustálý přehled o užitečných statistikách profilu hráče a místních dopravních předpisech."

	key[]: "desktop_tut_tour_home"
	val[]: "Tlačítko plochy je zde vždy k dispozici pro návrat na plochu."

	key[]: "desktop_tut_tour_burger_menu"
	val[]: "Vždy přítomné rychlé menu nabízí praktickou zkratku ke všem herním funkcím z kterékoli obrazovky."

	key[]: "desktop_tut_tour_drive"
	val[]: "Aktualizované tlačítko jízdy zůstává tvým spojením se světem, připraveno vrátit tě zpět na silnici."

	key[]: "desktop_tut_tour_finish_t"
	val[]: "VÝUKA DOKONČENA"

	key[]: "desktop_tut_tour_finish"
	val[]: "Děkujeme za prohlídku naší aktualizované domovské obrazovky."
#@}


