#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "Vyžadované DLC (oficiální rozšíření hry) $DEPENDENCY_NAME$ chybí. Pro správné fungování této uložené pozice je potřeba mít DLC nainstalované a aktivované na tomto počítači. Před načtením této uložené pozice musíš problém vyřešit." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "Volitelné DLC (oficiální rozšíření hry) $DEPENDENCY_NAME$ chybí. Pokud se domníváš, že by vše mělo být v pořádku, zkontroluj prosím stav DLC.<br><br>Jinak můžeš uloženou pozici nechat načíst, avšak některé funkce obsažené v DLC mohou být ztraceny." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "Modifikace $DEPENDENCY_NAME$ chybí nebo je vypnutá. Pokud se domníváš, že by vše mělo být v pořádku, zkontroluj prosím stav modifikace. Jinak můžeš uloženou pozici nechat načíst, v tomto případě však nemusí správně fungovat nebo může způsobit další problémy v závislosti na rozsahu modifikace." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "Modifikace $DEPENDENCY_NAME$ není kompatibilní s tvojí verzí hry, tzn. autor této modifikace ji označil za kompatibilní pouze s vybranými verzemi hry a ta stávající mezi nimi není.<br><br>Možná řešení:<br>- Zkus najít aktualizovanou verzi modifikace, která je navržena tak, aby fungovala se stávající verzí hry.<br>- Proveď aktualizaci nebo downgrade hry na verzi kompatibilní s modifikací.<br><br>Jinak můžeš uloženou pozici nechat načíst, v tomto případě však nebude modifikace načtena a v závislosti na rozsahu modifikace může načtení této uložené pozice způsobit další problémy." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "CHYBĚJÍCÍ ZÁVISLOSTI" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "DETAILY" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "Zobrazit stránku Workshopu"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "Tato uložená pozice je závislá na některých DLC nebo modifikacích, které momentálně chybí. Jejich seznam najdeš níže. Vybráním položky v seznamu se můžeš o dané položce dozvědět více informací." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "Tato uložená pozice je závislá na alespoň jednom DLC nebo modifikaci. Před načtením této uložené pozice musíš problém vyřešit." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

	key[]: "abort_loading"
	val[]: "Přerušit načítání" #+ Abort loading button.

	key[]: "type"
	val[]: "Typ" #+ Type column.

	key[]: "dependency_name"
	val[]: "Název závislosti" #+ Dependency name column.

	key[]: "local_mod"
	val[]: "Lokální modifikace" #+ Local mod stored in mod directory.

	key[]: "workshop_mod"
	val[]: "Workshop modifikace" #+ Steam Workshop mod.

	key[]: "removable_dlc"
	val[]: "Volitelné DLC" #+ DLC that can be removed or disabled.

	key[]: "required_dlc"
	val[]: "Vyžadované DLC" #+ DLC that is required to load save that is depending on it.
#@}

