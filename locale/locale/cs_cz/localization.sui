#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "Pouze klávesnice" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "Klávesnice" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "Řízení myší" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "Řízení myší včetně pedálů" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "Žádný" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

