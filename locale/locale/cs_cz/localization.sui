	key[]: "error_no_compatible_trailer_owned"
	val[]: "Momentálně nevlastníš žádný návěs, který je s touto zakázkou kompatibilní." #+ Message shown if player does not own any trailer that would be compatible with the job but there is at least one available in trailer dealer.

	key[]: "required_trailer_external_header"
