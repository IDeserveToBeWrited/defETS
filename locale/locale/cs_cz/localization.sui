#+ Bank screen
#+
#+ Provides ability to loan money and management of existing loans.
#@{

	key[]: "bank_title"
	val[]: "BANKA" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "bank_link_title"
	val[]: "Banka" #+ Icon opening the bank screen. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "bank_help"
	val[]: "Pokud potřebuješ peníze, vždycky si můžeš půjčit od banky." #+ Help text associated with the bank icon.

	key[]: "bank_h1"
	val[]: "NABÍZENÉ PŮJČKY" #+ Header of section containing available loans.  Please keep in upper case where possible.

	key[]: "bank_offer_installment"
	val[]: "za $MONEY$ denně" #+ Shown on separate line inside loan description and contains amount you need to repay per day. The $MONEY$ is replaced with the real amount.

	key[]: "bank_active_loans"
	val[]: "Počet aktivních půjček: $NUMBER$" #+ The $NUMBER$ is replaced with number of loans the player is currently repaying.

	key[]: "bank_credit"
	val[]: "Můžeš si půjčit: $MONEY$" #+ The $MONEY$ is replaced with the total sum the player can borrow at this time.

	key[]: "bank_h2"
	val[]: "PŘEHLED AKTIVNÍCH PŮJČEK"  #+ Header of section containing loans the player is currently repaying. Please keep in upper case where possible.

	key[]: "bank_loan_amount"
	val[]: "Půjčka" #+ Header of the column containing the sums borrowed for individual loans.

	key[]: "bank_loan_current"
	val[]: "Zbývá zaplatit" #+ Header of the column containing the sums still left to repay in individual loans.

	key[]: "bank_loan_time"
	val[]: "Doba trvání (ve dnech)" #+ Header of the column containing remaining durations of individual loans.

	key[]: "bank_loan_intrate"
	val[]: "Úroková sazba (p.a.)" #+ Header of the column containing interest rates for individual loans.

	key[]: "bank_loan_installment"
	val[]: "Splátka" #+ Header of the column containing the daily payments for individual loans.

	key[]: "bank_loan_repay"
	val[]: "Splatit" #+ Button allowing to repay the loan at once.

	key[]: "bank_total"
	val[]: "Celkem:" #+ Header of column sums of loans and payments over all active loans.

	key[]: "bank_money"
	val[]: "Zůstatek na účtu: $MONEY$" #+ The $MONEY$ is replaced with the real amount of money on the bank account.

