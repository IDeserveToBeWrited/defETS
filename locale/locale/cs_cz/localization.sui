	key[]: "eye_head_drive_yaw_scale_op_tooltip"
	val[]: "Nastavuje, jak moc se kamera ve hře otočí doleva nebo doprava ve srovnání s tím, jak moc otočíš hlavu (v kabině)."

	key[]: "eye_head_drive_pitch_scale_op_tooltip"
	val[]: "Nastavuje, jak moc se kamera ve hře otočí nahoru nebo dolů ve srovnání s tím, jak moc otočíš hlavu (v kabině)."

	key[]: "eye_head_walk_yaw_scale_op_tooltip"
