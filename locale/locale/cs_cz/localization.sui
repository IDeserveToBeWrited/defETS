	key[]: "load_save_t"
	val[]: "ULOŽIT NEBO NAČÍST HRU" #+ Title of window providing selection between save and load functionality. Please keep in upper case where possible.

	key[]: "load_save"
	val[]: "Uložit a načíst" #+ Icon allowing player to save and load the game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "save_game_reset"
	val[]: "Byla zjištěna úprava hry! Aby ses vyhnul problémům s kompatibilitou kvůli změnám v herním světě, veškeré nedokončené zakázky byly zrušeny bez jakékoliv penalizace." #+ Game state reset info message

	key[]: "save_game_reset_teleport"
	val[]: "Byla zjištěna úprava hry!<br><br>Aby ses vyhnul problémům s kompatibilitou, veškeré nedokončené zakázky byly zrušeny bez jakékoliv penalizace. Je však vyžadováno přemístění tahače na bezpečné místo.<br><br>Pro pokračování vyber destinaci rychlého cestování." #+ Game state reset info message, plus free teleport

	key[]: "save_in_progress"
	val[]: "Ukládám..." #+ Game save indicator message.

	key[]: "cutscene_quit_info"
	val[]: "Stiskni $KEY$ pro přeskočení cutscény." #+ Shown when any key was pressed during viewpoint cutscene.

#+ Message box shown on press of the Drive button when the player does not have any truck.
#@{

	key[]: "no_drive_t"
	val[]: "ŽÁDNÉ VOZIDLO" #+ Message box title. Please keep in upper case where possible.

	key[]: "no_drive"
	val[]: "Nemůžeš se volně pohybovat po světě dokud nebudeš mít vozidlo, kterým bys mohl jet. Mohl by sis nějaký pořídit nebo vzít ze svého vozového parku.<br><br>Chceš si nyní vybrat rychlou zakázku?"
#@}

#+ Game load window
#+
#+ Provides ability to load previously saved game or autosave.
#@{

	key[]: "load_game_t"
	val[]: "NAČÍST HRU"  #+ Title of the window. Please keep in upper case where possible.

	key[]: "load_game"
	val[]: "Načíst hru" #+ Icon allowing player to load previously saved game. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "load_game_desc"
	val[]: "Načíst předchozí uloženou pozici. Aktuální postup bude ztracen!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "Opravdu chceš načíst další hru?<br><br>Pokud jsi předchozí postup hrou neuložil, přijdeš o něj."

	key[]: "load_progress_lost_mp"
	val[]: "Opravdu chceš načíst jinou hru?<br>Pokud tak učiníš ve hře více hráčů, může to mít za následek zrušení či pozastavení zakázky, přesunutí k nejbližšímu servisu nebo nedostupnost vybrané zakázky.<br><br>Tvůj aktuální postup hrou bude ztracen, pokud nebyl uložen dříve."

	key[]: "load_game_mp_suspended_job"
	val[]: "Uložená pozice byla úspěšně načtena, ale tvá zakázka pro World of Trucks byla pozastavena a během této relace není dostupná."

	key[]: "autosave"
	val[]: "- Automaticky uložená pozice -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- Rychlé uložení -" #+ Name used inside slot corresponding to a quick saved game.

	key[]: "show_autosaves"
	val[]: "Zobrazit automaticky ukládané pozice" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "Nenalezeny žádné ručně uložené pozice." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "Načíst" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>Nekompatibilní uložená pozice!<br><color value=@@clr_txt@@>Zkus hru aktualizovat na nejnovější dostupnou verzi." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "Nepodařilo se načíst a zobrazit všechny uložené pozice pro tento profil." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "UPOZORNĚNÍ" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>Problém s načtením uložené pozice.<color value=@@clr_txt@@><br><br>Nepodařilo se načíst uloženou pozici. Pomocí informací níže můžeš zkusit problém zjistit a případně opravit. Stejně tak můžeš načíst jinou uloženou pozici.<br><br>Následující důvody mohou být často příčinou problému:<br><br>1. Uložená pozice je nekompatibilní s některými z nainstalovaných modifikací.<br><br>2. Uložená pozice obsahuje informace z modifikací, které jsou zakázané nebo chybí.<br><br>3. Uložená pozice byla poškozena použitím špatně vytvořené modifikace.<br><br>4. Poškození uložené pozice může také způsobit selhání počítače během nebo krátce po procesu ukládání."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>Nalezena chybějící modifikace.<color value=@@clr_txt@@><br><br>Poslední uložená pozice obsahuje závislosti na chybějící modifikaci či chybějících modifikacích.<br><br>Pokud se domníváš, že je vše v pořádku, zkontroluj prosím stav aktivovaných modifikací.<br><br>Stejně tak můžeš zkusit uloženou pozici normálně načíst, nicméně v závislosti na tom, co modifikace upravila(y), je možné, že by mohlo načítání selhat nebo by mohly vzniknout další problémy.<br><br>Případně můžeš načíst jinou uloženou pozici, která není závislá na chybějící modifikaci či chybějících modifikacích."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>Nalezeno chybějící volitelné DLC.<color value=@@clr_txt@@><br><br>Poslední uložená pozice obsahuje závislosti na chybějícím DLC (oficiální rozšíření hry).<br><br>Pokud se jedná o nečekanou událost, zkontroluj stav jednotlivých DLC.<br><br>V opačném případě můžeš uloženou pozici nechat načíst, avšak některé funkce obsažené v DLC mohou být ztraceny.<br><br>Případně zkus načíst jinou uloženou pozici, která není závislá na chybějících DLC."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>Nalezeno chybějící DLC.<color value=@@clr_txt@@><br><br>Poslední uložená pozice obsahuje závislosti na chybějícím DLC (oficiální rozšíření hry).<br><br>Pro správné fungování této uložené pozice je potřeba mít DLC nainstalované a aktivované na tomto počítači.<br><br>Případně zkus načíst jinou uloženou pozici, která není závislá na chybějícím DLC."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>Modifikace závislá na obsahu DLC.<color value=@@clr_txt@@><br><br>Minimálně jedna modifikace je závislá na obsahu DLC (oficiálního rozšíření hry), které není momentálně nainstalováno.<br><br>Je potřeba toto DLC nainstalovat, případně problémové modifikace odebrat."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>Zjištěn pád hry.<color value=@@clr_txt@@><br><br>Zdá se, že během předchozího načítání spadla hra.<br><br>Pomocí informací níže můžeš zkusit problém zjistit a případně opravit. Stejně tak můžeš načíst jinou uloženou pozici.<br><br>Následující důvody mohou být často příčinou problému:<br><br>1. Jedna nebo více nainstalovaných modifikací jsou poškozené nebo nekompatibilní s aktuální verzí hry.<br><br>2. Uložená pozice obsahuje informace z modifikací, které jsou zakázané nebo chybí.<br><br>3. Uložená pozice byla poškozena použitím špatně vytvořené modifikace.<br><br>4. V některých případech může pád hry způsobit také hardware nebo selhání ovladačů."

	key[]: "mods_detected_warning"
	val[]: "Zjištěna přítomnost herních modifikací. Upozorňujeme, že poškozené, zastaralé nebo nekompatibilní modifikace mohou způsobovat nestabilitu hry. Zkontroluj prosím aktivní modifikace ve správci modifikací." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

