#+ Messages for situations occurring due to management of DLCs.
#@{
	key[]: "dlc_acquire_timeout" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Získávání DLC trvá déle, než se očekávalo. Nyní bude pokračovat na pozadí."

	key[]: "dlc_acquire_timeout_wait_or_continue" #+ Message shown during initial sequence, if DLCs licensing takes too long.
	val[]: "Získávání DLC trvá déle, než se očekávalo. Chceš nadále čekat?<br><br>Pokud budeš pokračovat, získávání bude probíhat na pozadí."

	key[]: "dlc_acquired_return_optional" #+ Message shown in game, when a DLC has been added.
	val[]: "Získal jsi přístup k některým DLC. Chceš nyní přejít na úvodní obrazovku, abys mohl nový obsah použít?<br><br>Tvůj postup hrou bude automaticky uložen."

	key[]: "dlc_lost_return_forced" #+ Message shown in game, when a DLC has been removed.
	val[]: "Ztratil jsi přístup k některým DLC. Nyní se vrátíš na úvodní obrazovku, aby se změna obsahu projevila.<br><br>Tvůj postup hrou bude automaticky uložen."
#@}

