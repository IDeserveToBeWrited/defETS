	key[]: "controller_settings_t"
	val[]: "OVLADAČ" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "ZPĚTNÁ VAZBA OVLADAČE" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

