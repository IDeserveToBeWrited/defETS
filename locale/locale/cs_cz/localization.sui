	key[]: "general_settings"
	val[]: "OBECNÉ NASTAVENÍ" #+ The separator text for the general online settings.

	key[]: "connect_content_t"
	val[]: "PROPOJIT OBSAH" #+ The title of the connect content window.

	key[]: "connect_selected_content"
	val[]: "Propojit" #+ The button which triggers connection of the selected content.

	key[]: "connect_content_help"
	val[]: "World of Trucks detekoval nový herní obsah. Propoj jej s World of Trucks, aby k němu měl přístup." #+ The help text for the connect content dialog. Shows when the user opens the connect content dialog from the online options.

	key[]: "online_options"
	val[]: "Online" #+ Name of the options category.

	key[]: "help_online_options"
	val[]: "Online nastavení. Přizpůsobte si veškerá nastavení týkající se World of Trucks." #+ The help text shown next to the button which opens the online options screen, describing what the user can find inside.

	key[]: "connect_content_leave_confirmation"
	val[]: "Opravdu chceš registraci odložit?<br><br>Dialog s propojením online obsahu můžeš zobrazit později z online nastavení, které najdeš na ploše." #+ The text displayed in the connect content screen exit confirmation. This is only available when the connect content was displayed automatically when new DLC was detected and has to contain information where to find the screen again later.

	key[]: "connecting_content_t"
	val[]: "PROPOJOVÁNÍ OBSAHU" #+ The title of the online wait dialog shown while connecting content is in progress.

	key[]: "connecting_content_init"
	val[]: "Propojuji obsah.." #+ The text shown in the online wait dialog while content connecting is in progress.

	key[]: "connect_content_queue_failed"
	val[]: "Nepodařilo se přidat do fronty operaci pro připojení k: $CONTENT_NAME$" #+ The text displayed when the queue of the content connection fails.

	key[]: "registration_result_steamid_mismatch"
	val[]: "Steam účet použitý pro zaregistrování tohoto DLC není shodný s účtem, který byl použit při vytvoření tvého World of Trucks účtu nebo při registraci hry. Změň prosím svůj Steam účet a zkus to znovu." #+ The error displayed when the connect content operation fails because of a SteamID mismatch.

	key[]: "registration_result_steamid_in_use"
	val[]: "Steam účet, který jsi použil pro registraci tohoto DLC, je již propojen s jiným World of Trucks účtem. Pro zaregistrování DLC do aktuálního účtu musíš použít takový Steam účet, který není propojen s žádným World of Trucks účtem." #+ The error shown to the user when the connect content operation fails because the current Steam account is connected to a different WoTr account.

	key[]: "registration_result_token_expired"
	val[]: "Platnost Steam tokenu vypršela. Zkus to prosím později." #+ The message displayed when the connect content operation fails because the Steam token has expired.

	key[]: "registration_result_serial_invalid"
	val[]: "Produktový klíč použitý k aktivaci tohoto DLC není validní. Pro pomoc prosím kontaktuj podporu na: support@scssoft.com" #+ The message displayed when the connect content operation failed because the serial key is invalid.

	key[]: "registration_result_generic_error"
	val[]: "Během registrování hry nastala vnitřní chyba. Zkus to prosím později." #+ The message displayed when the connect content operation fails and no specific error message was defined to cover it.

	key[]: "success_t"
	val[]: "ÚSPĚCH" #+ Title of the success message box.

	key[]: "info_t"
	val[]: "INFO" #+ The title of the message box displayed when not all of the packages were registered.

	key[]: "online_options_t"
	val[]: "ONLINE" #+ Title of the online options screen.

	key[]: "online_connected_content_browser_t"
	val[]: "PROHLÍŽEČ OBSAHU" #+ Title of the online connected content browser screen.

	key[]: "registration_success"
	val[]: "Gratulujeme! Vybraná DLC byla úspěšně propojena s World of Trucks účtem." #+ The content of the message box shown when selected content was successfully connected.

	key[]: "registration_not_possible_steamid_mismatch"
	val[]: "Nepodařilo se propojit obsah, protože aktuální Steam účet je propojen s jiným World of Trucks účtem." #+ The message displayed when the current Steam account is connected to any world of trucks account that is not a currently used World of Trucks account.

	key[]: "registration_result_some_failed"
	val[]: "Některá DLC se nepodařilo propojit.<br>Pro zobrazení více informací přejeďte myší přes vykřičník u jednotlivých DLC." #+ The content of the message box shown when not all selected content was successfully connected.

	key[]: "content_connect_progress"
	val[]: "Registruji $CURRENT_CONTENT_NAME$" #+ The text used to display the progress of the online content connecting.

	key[]: "online_content_connect_offline_profile"
	val[]: "Aktuální profil není připojen k World of Trucks nebo hra běží v offline režimu. Pro připojení uprav profil." #+ An error shown when a user accesses the online options screen while his profile is not an online one or the online layer was not set up properly.

	key[]: "online_content_connect_offline_profile_dismiss_hint"
	val[]: "Kliknutím zavřeš"

	key[]: "online_connect_content_info"
	val[]: "<color value=@@clr_sel@@>$CONNECTED_CONTENT$ <color value=@@clr_txt@@>/ $TOTAL_CONTENT$ aktuálně kompatibilních DLC propojeno. Pokud některá DLC nejsou propojena s World of Trucks, můžou ti chybět některé jejich funkce." #+ The text displayed in online options which displays a summary of how many DLCs are connected to WoTr.

	key[]: "online_connect_content_all_connected"
	val[]: "<color value=@@clr_sel@@>Gratulujeme!<color value=@@clr_txt@@> Veškerý tvůj obsah je nyní propojen s World of Trucks!  Od teď můžeš využívat všech jeho funkcí." #+ The text displayed in online options which confirms that every DLC the user owns is connected.

	key[]: "online_connect_content_account_mismatch"
	val[]: "Nepodařilo se propojit nový obsah s World of Trucks, protože aktuálně používaný Steam účet není shodný se Steam účtem použitým na profilu World of Trucks." #+ A text displayed in online options when the currently used Steam account does not match a Steam account connected to the WoTr profile.

	key[]: "connected"
	val[]: "Propojeno" #+ The state of the content that is connected.

	key[]: "not_connected"
	val[]: "Nepropojeno" #+ The state of the content that is not connected.

	key[]: "owned_app_list_fetch_failed"
	val[]: "Nepodařilo se načíst informace o vlastněném obsahu." #+ Error displayed when owned DLCs fetch fails.

	key[]: "registered_game_list_fetch_failed"
