#+ Networking errors
#@{

#+ This happens if the online service were not initialized for some reason or -noonline parameter was used.

	key[]: "generic_networking_unavailable"
	val[]: "Síťové rozhraní není k dispozici. Překontroluj prosím nastavení klienta."

#+ Unable to establish connection with the service.

	key[]: "generic_unable_to_connect"
	val[]: "Nelze se připojit k internetové službě. Ověř prosím, zda připojení k internetu funguje v pořádku."

#+ Error during socket read/write.

	key[]: "generic_network_error"
	val[]: "Chyba při komunikaci s internetovou službou. Zkus to prosím znovu později."

#+ Problem while parsing the HTTP transport protocol.

	key[]: "generic_protocol_error"
	val[]: "Internetová služba vrátila nesprávná data. Používáš-li HTTP proxy, ověř její nastavení. V opačném případě zopakuj pokus později."

#+ Reply was returned however its content was not correct (incorrect number or content of lines)

	key[]: "generic_service_protocol_error"
	val[]: "Internetová služba vrátila nesprávná data. Zkus to prosím znovu později."

#+ The service talks using version of the protocol or does not support this version of the game.

	key[]: "generic_version_mismatch"
	val[]: "Tato služba není kompatibilní se stávající verzí hry. Podívej se, zda není ke hře k dispozici nový patch."

#+ The services are currently unavailable for some unspecified reason.

	key[]: "generic_service_unavailable"
	val[]: "Služba není momentálně k dispozici. Zopakuj pokus později."

#+ The services are currently unavailable for maintenance or overload.

	key[]: "generic_service_temporarily_unavailable"
	val[]: "Služba je dočasně mimo provoz kvůli údržbě nebo přetížení. Zopakuj pokus později."

#+ The authentication provided by the client was incorrect.

	key[]: "generic_access_denied"
	val[]: "Zadané přihlašovací údaje jsou nesprávné. Zkus se přihlásit znovu."

#+ The account was locked down because of too many failed login attempts.

	key[]: "generic_failure_lockdown"
	val[]: "Tento účet byl dočasně uzavřen kvůli opakovaným nepovedeným pokusům o přihlášení. Zkus se přihlásit znovu za 30 minut."

#+ The account was locked down because of too many suspicious accesses.

	key[]: "generic_suspicious_lockdown"
	val[]: "Tento účet byl uzavřen kvůli podezřelým přístupům. Zkus se přihlásit znovu po uplynutí 24 hodin."

# The account does not have this game registered to itself.

	key[]: "generic_not_registered"
	val[]: "Na tomto online účtu není hra zaregistrovaná."

# The account was not verified yet.

	key[]: "generic_not_verified"
	val[]: "Tento účet nebyl dosud aktivován. Podívej se do své e-mailové schránky, měl by tam být aktivační e-mail."

# The account was suspended.

	key[]: "generic_suspended"
	val[]: "Účet byl pozastaven. Pro více informací kontaktuj technickou podporu."

# The account was banned.
	key[]: "generic_banned"
	val[]: "Účet byl zablokován. Pro více informací kontaktuj technickou podporu."

#+ The proxy used does require authentication which we do not support.

	key[]: "generic_proxy_authentication_not_supported"
	val[]: "Tato hra nepodporuje přihlašování přes proxy. Použij jinou proxy nebo přímé připojení."

#+ The required object (e.g. replay) is not available.

	key[]: "generic_object_unavailable"
	val[]: "Požadovaný předmět není v současné době k dispozici. Zkus to prosím znovu za několik minut."

#+ Generic SSL (Secure Sockets Layer) protocol error (e.g. expired certificate, untrusted certificate authority, hostname mismatch...)

	key[]: "generic_ssl_error"
	val[]: "Chyba SSL. Nepodařilo se navázat zabezpečené připojení."

#+ The game was suspended during the online communication and the connection was closed before it was finished.

	key[]: "generic_app_suspended"
	val[]: "Hra byla během online komunikace pozastavena. Zkus to prosím znovu později."

#+ Problem not covered by anything above. Currently it means that we generated incorrect URI or that the http client returned error code which
#+ is not handled by http_online_link_t::complete.

	key[]: "generic_internal_error"
	val[]: "Došlo k interní chybě. Více informací možná nalezneš v souboru net.log."

#@}

#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "Euro Truck Simulator 2 má problém a není schopen vykreslovat grafiku na tvém počítači (žádné platné grafické zařízení nebylo nalezeno).\nDoporučený postup:\n\n1. Zkontroluj, zda tvůj počítač a grafická karta splňují minimální hardwarové požadavky,\n2. Aktualizuj svůj počítač na nejnovější verzi Microsoft DirectX.\n3. Stáhni a nainstaluj nejnovější grafické ovladače pro svou grafickou kartu ze stránek prodejce - tvé grafické ovladače jsou pravděpodobně zastaralé.\n4. Zkus změnit metodu vykreslování z OpenGL na DirectX nebo naopak.\n5. Odstraň konfigurační soubor hry 'config.cfg' ve svých 'Dokumentech' - složka 'Euro Truck Simulator 2'. Mohl se poškodit. Při dalším spuštění hry se tento soubor automaticky vytvoří znovu s platnými základními hodnotami."

	key[]: "sys_no_graphics_simple"
	val[]: "Euro Truck Simulator 2 má problém a není schopen vykreslovat grafiku na tvém počítači (žádné platné grafické zařízení nebylo nalezeno)."
#@}

#+ Input wizard
#@{

	key[]: "input_wizard_t"
	val[]: "PRŮVODCE OVLÁDÁNÍM" #+ Title of the screen. Please keep in upper case where possible.

#+ Button switching to the next page.

	key[]: "next"
	val[]: "Další"

#+ Button which finish wizard and starts the game.

	key[]: "finish_wizard"
	val[]: "Dokončit průvodce"

#+ Allows the player to skip the input wizard. (Keyboard + Simple gearbox will be used.)

	key[]: "skip_wizard"
	val[]: "Přeskočit průvodce"

#+ Button launching the input wizard.

	key[]: "input_wizard"
	val[]: "Průvodce ovládáním"

#+ Text of message confirmation message box when the ESC key is pressed while in the input wizard.

	key[]: "cancel_wizard"
	val[]: "Chceš vypnout průvodce ovládáním?"

#+ Control type selection page
#@{

#+ Method selection page title

	key[]: "select_control_method"
	val[]: "VYBER ZPŮSOB OVLÁDÁNÍ" #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that user wants to use wheel, gamepad or joystick for steering.

	key[]: "controllers"
	val[]: "Ovladače"

#+ Steam controller configurator instruction

	key[]: "wiz_control_steam_instruction"
	val[]: "<color value=@@clr_txt_d@@>Tento průvodce automaticky aplikuje doporučená nastavení na základě připojených zařízení.<br><color value=@@clr_sel@@>Pokud používáš gamepad kompatibilní se službou Steam, doporučujeme povolit podporu konfigurace v <br><color value=@@clr_txt_d@@> \"Steam > Nastavení > Ovladač > Obecná nastavení ovladače\"."

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_keyboard"
	val[]: "Řiď pomocí klávesnice a rozhlížej se po okolí pomocí myši. Je to nejjednodušší a nejméně přesná metoda řízení, ale přístupná úplně všem."

	key[]: "wiz_control_mouse"
	val[]: "Pomocí myši se starej o přesné řízení. Klávesnice se ale stále používá pro další úkony. Myš slouží k rozhlížení pouze tehdy, když zároveň držíš tlačítko či klávesu pro ovládání kamery."

	key[]: "wiz_control_controller"
	val[]: "Pomocí volantu, gamepadu či joysticku můžeš dosáhnout co možná nejrealističtějšího zážitku ze hry. Pomocí klávesových zkratek pak můžeš používat spoustu funkcí a úhel kamery můžeš měnit myší."
#@}

#+ Shown besides the controllers text when no controller is connected to the computer.

	key[]: "controller_not_found"
	val[]: "Žádný ovladač nebyl nalezen. Pokud chceš tuto volbu povolit, musíš nějaký připojit!"

#+ Shown besides the controllers text when the wizard is analyzing the available controllers.

	key[]: "detecting"
	val[]: "Zjišťuji dostupné ovladače..."

#@}

#+ Controller API selection page
#+
#+ Only shown if the user has both Steam Input controller and classical (XInput, DirectInput) connected.
#
#@{

#+ Controller API selection page title

	key[]: "select_controller_api"
	val[]: "VYBER API OVLADAČE" #+ Title of the screen. Please keep in upper case where possible.

#+ Buttons in the input wizard used to indicate that the Steam Controller API should be used, one for In-game Mapping Mode (aka Simple Mode), other for Steam Client Mapping Mode (aka Advanced Mode).

	key[]: "api_steam_input_simple"
	val[]: "Steam Input - Režim mapování ve hře (doporučeno)"

	key[]: "api_steam_input_advanced"
	val[]: "Steam Input - Režim mapování Steam klienta"

#+ Button in the input wizard used to indicate that the classical controller API (DirectInput, XInput, evdev,...) should be used.

	key[]: "api_classical_controller"
	val[]: "Standardní ovladač"

#+ Descriptions of individual choices.
#@{
	key[]: "wiz_api_steam_input_simple"
	val[]: "Gamepady jako @@controller_ps5@@, @@controller_xbox_one@@ nebo @@controller_steam_deck@@ nastavené přes rozhraní Steam Input a používající jednoduché rozvržení.<br><br>Podporuje kompletní konfiguraci klávesových zkratek přímo ve hře."

	key[]: "wiz_api_steam_input_advanced"
	val[]: "Gamepady nastavené přes rozhraní Steam Input a používající samostatná rozvržení nakonfigurovaná prostřednictvím klienta služby Steam.<br><br>Omezená podpora pro nápovědu tlačítek ve hře a žádná konfigurace tlačítek ve hře."

	key[]: "wiz_api_classical"
	val[]: "Ovladač, volant či joystick používající DirectInput, XInput nebo podobné rozhraní."
#@}

#@}

#+ Controller type selection page
#@{

#+ Controller type selection page title

	key[]: "select_controller_type"
	val[]: "VYBER TYP OVLADAČE"  #+ Title of the screen. Please keep in upper case where possible.

#+ Button in the input wizard used to indicate that the controller is wheel-like.

	key[]: "driving_wheel"
	val[]: "Volant"

#+ Button in the input wizard used to indicate that the controller is gamepad-like.

	key[]: "gamepad_or_joy"
	val[]: "Gamepad nebo joystick"

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_control_wheel"
	val[]: "Ovladač je vlastně volant, nebo se tak alespoň chová. Pozice ovladače přímo určuje polohu volantu ve hře."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "Ovladač může být gamepad nebo joystick. Pozice ovladače ve hře určuje rychlost otáčení volantu."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "VYBER TYP PŘEVODOVKY" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Stiskem DOPŘEDU jedeš vpřed a stiskem DOZADU couváš. Převodovka se automaticky postará o všechno ostatní – přepínání mezi řízením, brzděním a couváním, stejně tak řazení správných rychlostí."

	key[]: "wiz_gb_automatic"
	val[]: "Použij tlačítka pro přepnutí mezi jízdou vpřed, neutrálem a couváním. Poté sešlápni pedál pro zrychlení a nech automatickou převodovku řadit."

	key[]: "wiz_gb_sequential"
	val[]: "Ručním řazením nahoru a dolů si můžeš vybrat každý jednotlivý rychlostní stupeň převodovky. Tato konfigurace umožňuje plnou kontrolu nad převodovkou vozidla."

	key[]: "wiz_gb_hshifter"
	val[]: "Požadovanou rychlost si zvolíš přímo. Toto nastavení nabízí nejrealističtější konfiguraci. Vyžaduje spojku a doporučuje se fyzická řadicí páka."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "Tato funkce vyžaduje připojený volant, gamepad nebo joystick."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "Žádná externí řadicí páka nebyla nalezena, tato funkce může být tudíž nepoužitelná."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "VYBER ROLOŽENÍ ŘADICÍ PÁKY"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "Převodovky s rozsahem jsou nejsnadnější volbou. Mají dvě sady stupňů. První sada obsahuje rychlosti od 1 do 6 a druhá sada rychlosti od 7 do 12. Přepínací tlačítko přepíná mezi těmito dvěma sadami, zatímco řadicí páka vybírá rychlost z dané sady."

	key[]: "wiz_hs_splitter"
	val[]: "Dělená převodovka je snadnou alternativou. Má dvě sady rychlostí. První sada obsahuje stupně s lichými čísly (1, 3, 5...) a druhá sada stupně se sudými čísly (2, 4, 6...). Přepínací tlačítko přepíná mezi těmito dvěma sadami, zatímco řadicí páka vybírá rychlost z dané sady."

	key[]: "wiz_hs_range_splitter"
	val[]: "Převodovka s děleným rozsahem je založena na rozložení skutečného řazení tahačů s řazením do H. Převodové stupně jsou rozděleny do skupin po čtyřech pro každou pozici řadicí páky s použitím dvou přepínačů, proto se toto řazení doporučuje jen pokročilým řidičům."
#@}

#@}

#+ Auto configuration complete page
#+
#+ Shown if the game identifies the HW and automatically applies reasonable configuration.
#@{
	key[]: "wiz_auto_cfg_done"
	val[]: "Hra je nyní nastavená pomocí výchozího nastavení pro tvůj níže popsaný hardware. Nastavení si můžeš ještě upravit pomocí pokročilého nastavení, nebo můžeš pokračovat přímo do hry."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "Pokročilé nastavení"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "Hra je nyní nakonfigurována a můžeš pokračovat. Konfiguraci můžeš kdykoliv později změnit v Nastavení."

	key[]: "wiz_cfg_steam"
	val[]: "Pro tento ovladač můžeš zkontrolovat i nakonfigurovat mapování tlačítek a os pomocí klienta služby Steam. Nastavení gamepadu pro hru přes službu Steam je k dispozici v Steam > Knihovna > Euro Truck Simulator 2 > Nastavení ovladače."

	key[]: "wiz_cfg_open_overlay"
	val[]: "Otevřít nastavení ovladače"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>Použij @@imm_wiz_dsteerleft@@ a @@imm_wiz_dsteerright@@ pro řízení."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>Pohybem myši vlevo či vpravo otáčíš volantem v odpovídajícím směru."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>Pomocí @@ima_wiz_j_steer@@ řídíš."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "Pomocí @@imm_wiz_dforward@@ jedeš vpřed a pomocí @@imm_wiz_dbackward@@ couváš."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "Pohybem @@ima_wiz_j_throttle@@ dopředu jedeš vpřed a pohybem dozadu couváš."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "Pomocí @@ima_wiz_j_throttle@@ jedeš dopředu a pomocí @@ima_wiz_j_brake@@ couváš."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "Pomocí @@imm_wiz_dforward@@ přidáš plyn a pomocí @@imm_wiz_dbackward@@ brzdíš."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "Pohybem @@ima_wiz_j_throttle@@ dopředu přidáš plyn a pohybem dozadu brzdíš."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "Pomocí @@ima_wiz_j_throttle@@ přidáváš plyn a pomocí @@ima_wiz_j_brake@@ brzdíš."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "Použij @@imv_wiz_gearup@@ pro zařazení dopředu a @@imv_wiz_geardown@@ pro zpátečku."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "Pokud používáš klávesnici nebo tlačítka ovladače, použij @@imv_wiz_gearup@@ pro zařazení dopředu a @@imv_wiz_geardown@@ pro zpátečku. V případě řadicí páky použij @@imv_wiz_drive@@ a @@imv_wiz_reverse@@ pro udání směru."

	key[]: "wiz_cfg_gb_manual"
	val[]: "Pomocí @@imv_wiz_gearup@@ a @@imv_wiz_geardown@@ zařaď požadovanou rychlost."

	key[]: "wiz_cfg_gb_direct"
	val[]: "Použij svou řadicí páku spolu se @@ima_wiz_j_clutch@@ pro zařazení požadovaného stupně."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "NASTAVENÍ OS OVLADAČE" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "Vizualizace os"

	key[]: "wiz_setup_axes_desc"
	val[]: "Můžeš zkusit funkci všech zvolených os vizuálně. Použij ovladač a sleduj pohybující se ukazatele. Ukážou ti limity, centrování, orientaci a celkové chování každé použité osy."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "Nastavení os"

	key[]: "wiz_setup_axes_desc2"
	val[]: "Vyber osu kliknutním na tlačítko vedle názvu osy. Tím se přepneš do režimu ovládání. Poté použitím svého ovladače přiřaď vybranou osu pohybem páčky, volantu či pedálu."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "Mrtvé zóny"

	key[]: "wiz_setup_axes_desc3"
	val[]: "Mrtvá zóna je oblast na ose záměrně navržená tak, aby neposkytovala žádný vstup. Pro upravení mrtvé zóny vybrané osy posuň odpovídající posuvník. Posunutím doprava se mrtvá zóna zvětší. Tato funkce je obzvláště užitečná pro starší ovladače, protože nastavení větší mrtvé zóny může zmírnit nepřesnosti nebo chybné vstupy způsobené opotřebením hardwaru."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "Režimy os"

	key[]: "wiz_setup_axes_desc4"
	val[]: "Režim osy určuje, jak s ní pracuje hra. Prohozená osa obrátí svůj vykazovaný směr, například při zatočení doprava se zatočí doleva. Centrovaná osa má svou výchozí polohu ve středu svého rozsahu, jako například u joysticku. Toto nastavení je užitečné pro korekci osy, která nebyla detekována správně."

	key[]: "normal"
	val[]: "Normální" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "Prohozený" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "Centrovaný" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "Prohozený a centrovaný" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "NASTAVENÍ AUTOMATICKÉ PŘEVODOVKY" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "S automatickou převodovkou potřebuješ přeřazovat pouze mezi jízdou vpřed, couváním a neutrálem. Toho dosáhneš použitím následujících kláves a tlačítek na ovladači. Tyto klávesy si můžeš upravit kliknutím na ně a stisknutím požadované klávesy nebo tlačítka."

	key[]: "automatic_gb_setup_desc2"
	val[]: "Pokud máš připojenou hardwarovou řadicí páku, můžeš s ní simulovat skutečné automatické řazení. Povol tuto možnost a můžeš nastavit pozice páky pro jízdu vpřed a couvání. Všechny ostatní pozice řadicí páky jsou považovány za neutrál. Toto nastavení je vytvořeno speciálně pro řadicí páku, takže nebude fungovat s běžnými klávesami ani tlačítky na ovladači. Pokud chceš cokoliv z tohoto změnit, klikni na tlačítko a pak pohni pákou na požadovanou pozici a poté zpátky do pozice neutrálu."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "NASTAVENÍ SEKVENČNÍ PŘEVODOVKY" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "Sekvenční převodovka řadí mezi všemi rychlostními stupni vpřed, vzad i neutrálem. Zde jsou klávesy nebo tlačítka na ovladači, které jsou použité pro řazení nahoru a dolů v tomto pořadí. Tyto klávesy si můžeš upravit kliknutím na ně a stisknutím požadované klávesy nebo tlačítka na ovladači."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "NASTAVENÍ ŘADICÍ PÁKY" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "Zde si můžeš vybrat hlavní rozložení řadicí páky a vyzkoušet její funkce. Na obrázku můžeš vidět aktuální polohu páky a také jakou máš právě zařazenou rychlost. Vzhledem k tomu, že převodovka obsahuje více rychlostních stupňů, než má řadicí páka, musíš použít přepínací tlačítko pro přepínání mezi různými sadami rychlostních stupňů."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "Pozice řadicí páky i aktivní přepínače jsou vidět dole u názvu příslušné funkce. Chceš-li změnit přiřazení některé z funkcí, klikni na odpovídající tlačítko, pak přesuň řadící páku do požadované pozice a poté zpět na neutrál."
#@}

