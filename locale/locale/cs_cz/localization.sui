	key[]: "used_truck_dealer_explanation_integrity_wear_title"
	val[]: "Údržba" #+ Caption of integrity wear section.

	key[]: "used_truck_dealer_explanation_integrity_wear_text"
	val[]: "Představuje systémové stárnutí a zvyšující se opotřebování celého vozidla. Vyřeší se kompletní renovací." #+ Explanation integrity wear.

	key[]: "used_truck_dealer_explanation_wear_unfixable_title"
	val[]: "Opotřebení dílů" #+ Caption of unfixable wear section.

	key[]: "used_truck_dealer_explanation_wear_unfixable_text"
