#+ Options/Graphics
#+
#+ Screen used to configure graphics related options.
#@{

	key[]: "graphics_t"
	val[]: "ZOBRAZENÍ" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "graphics"
	val[]: "Zobrazení" #+ Icon opening the graphics options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "simple_gfx_hint"
	val[]: "Uprav grafické nastavení pomocí předvoleb pro přizpůsobení herního vizuálu podle svých představ."

	key[]: "apply"
	val[]: "Použít" #+ Button which applies the state configured in the screen.

	key[]: "dt_theme"
	val[]: "Motiv plochy" #+ Combo box for selection of desktop background theme.

	key[]: "display_t"
	val[]: "ZOBRAZENÍ" #+ Header of the section containing resolution related settings.
# display: "Display" - Seems to be not used anymore.

 	key[]: "display_image_quality_t"
 	val[]: "KVALITA OBRAZU" #+ Title of the 'Image quality' section. Please keep in upper case where possible.

	key[]: "display_texture_t"
	val[]: "TEXTURY" #+ Title of the 'Texture' section. Please keep in upper case where possible.

	key[]: "display_reflection_t"
	val[]: "ODRAZY" #+ Title of the 'Reflection' section. Please keep in upper case where possible.

	key[]: "display_shadow_t"
	val[]: "STÍNY" #+ Title of the 'Shadow' section. Please keep in upper case where possible.

	key[]: "display_lighting_t"
	val[]: "OSVĚTLENÍ" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "POSTPROCESSING" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "PROSTŘEDÍ" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "Celá obrazovka" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "Jas / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "Nastavení" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "Rozlišení" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "Obnovovací frekvence" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "Omezení FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "Omezení FPS na pozadí" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "Výchozí frekvence" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "Hz" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "Vertikální synchronizace" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "Ekonomická (šetří energii notebooků)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "ZJEDNODUŠENÉ NASTAVENÍ ZOBRAZENÍ" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "POUŽITO VLASTNÍ NASTAVENÍ" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "POKROČILÉ NASTAVENÍ ZOBRAZENÍ" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "Zjednodušené/pokročilé grafické nastavení" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "Skrýt pokročilé nastavení" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "Zobrazit pokročilé nastavení" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "Změna velikosti" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "Vyhlazování hran" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA ostření jasu" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA ladění" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "Adaptivní ostření" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "Vždy jemné" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "Vždy ostré" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "Ambientní okluze generovaná v obraze (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "Vysoký dynamický rozsah (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "Hloubka ostrosti (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "Sluneční paprsky" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "Korekce barev" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "Změna velikosti (odlesky)" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "Detaily odlesků" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "Kvalita vegetace" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "Hustota trávy" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "Kvalita stínů"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "Velikost stínové textury" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "Vzdálené stíny" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "Interiérové stíny" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "Kvalita počasí"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "Kvalita zrcátek" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "Rozlišení zrcátek" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "Vykreslovaná vzdálenost zrcátek" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "Kvalita textur" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "Anizotropní filtrování" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "Normálové mapování" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "Hlavní světla vozidel" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "Vedlejší světla vozidel" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "Vykreslovaná vzdálenost světel" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "Chodci" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "Nastavení zobrazení bylo změněno.<br>Chceš toto nastavení ponechat?"

	key[]: "reverting_in"
	val[]: "Původní nastavení budou obnovena za:" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "s" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

#+ Tooltips.
#@{
	key[]: "fullscreen_mode_op_tooltip" # - Graphics, Simple
	val[]: "Je-li povoleno, hra bude zobrazena přes celou obrazovku."

	key[]: "brightness_op_tooltip" # - Graphics, Simple
	val[]: "Nastav si celkový jas hry dle svého displeje. Na displejích kompatibilních s HDR je v tomto nastavení k dispozici také možnost kalibrace HDR."

	key[]: "resolution_op_tooltip" # - Graphics, Simple
	val[]: "Nastavuje rozlišení hry."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavuje cílovou obnovovací frekvenci hry."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "Sjednocuje snímkovou frekvenci hry a obnovovací frekvenci monitoru, aby se zabránilo trhání obrazu. Ekonomické nastavení zároveň snižuje snímkovou frekvenci na polovinu, což má za následek nižší spotřebu energie."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavuje maximální povolenou snímkovou frekvenci hry.<br><br>Nastavením hodnoty 0 se funkce deaktivuje."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "Nastavuje maximální povolenou snímkovou frekvenci hry, když je minimalizována na pozadí.<br><br>Nastavením hodnoty 0 se funkce deaktivuje."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "Přepíná mezi zjednodušeným grafickým nastavením (předvolby) a pokročilým grafickým nastavením (možnost upravovat jednotlivé parametry)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Vylepšuje věrnost grafiky tím, že hru interně vykresluje ve vyšším rozlišení, což zjemňuje zubaté okraje a vylepšuje detaily.<br>Například výběr větší velikosti má za následek ostřejší obraz s menším rozmazáním, takže hra celkově vypadá lépe na úkor výkonu.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle značný vliv na výkon."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Výběr vysokorychlostních antialiasingových metod, které vyhlazují zubaté hrany ve hře:<br>- SMAA vzorkuje každý pixel několikrát (v závislosti na zvolené kvalitě) na různých místech v rámci snímku a zprůměruje vzorky pro vytvoření finálního obrazu.<br>- TAA vzorkuje každý pixel pouze jednou za snímek, ale vzorkuje je na různých místech a různých snímcích.<br>- Pro nejlepší výsledek můžeš zvolit kombinaci obou na úkor výkonu.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "Přidává jemné stíny do skulin a mezi objekty, které jsou v těsné blízkosti, a zlepšuje tak vnímanou grafickou věrnost celého světa ve hře.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "Výběr předvoleb pro TAA:<br>- Volba \"Vždy jemné\" má za následek méně blikání/větší rozmazání – je vhodná pro uživatele PC, kteří povolí supersampling nebo mají monitor s vysokým DPI, ale také pro uživatele 1080p TV, kteří sedí dále od své obrazovky.<br>- Volba „Vždy ostré“ má za následek více blikání/menší rozmazání – pravděpodobně nejlepší volba pro použití při rozlišení pod 1080p, jako jsou notebooky nebo Steam Deck.<br>- Volba \"Adaptivní ostření\" dynamicky vypíná TAA jitter, když je kamera statická.<br><br><color value=@@clr_txt_d@@>Toto nastavení lze použít pouze v případě, že je jako metoda vyhlazování vybráno TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje intenzitu luma ostření TAA.<br><br><color value=@@clr_txt_d@@>Toto nastavení lze použít pouze v případě, že je jako metoda vyhlazování vybráno TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "Je-li povoleno, vzdálené oblasti na mapě mohou být uměle rozmazány, aby se na pozadí vytvořilo realistické rozostření."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "Je-li povoleno, paprsky světla mohou být viditelné při pohledu na slunce nebo při pohledu na slunce přes objekty, jako jsou stromy, budovy nebo vozidla."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "Je-li povoleno, barvy hry se dynamicky upravují z estetických důvodů. Scény budou lépe odpovídat denní době a povětrnostním podmínkám, barvy vozidel a jiných objektů mohou být živější apod."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "Vylepšuje odlesky tím, že je interně vykresluje ve vyšším rozlišení a také používá lepší antialiasing.<br><br><color value=@@clr_txt_d@@>Změna tohoto nastavení se projeví až po ručním restartu hry."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje detaily odlesků pozorovaných na površích vozidel, oknech a dalších reflexních površích, jako jsou louže, mokré silnice a otevřené vodní plochy.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon.<br><br>Změna tohoto nastavení se projeví až po ručním restartu hry."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje detaily a složitost rostlin a stromů.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje hustotu trávy po stranách silnice.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu stínů vržených sluncem nebo měsícem.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Povoluje vykreslování stínů i z velmi vzdálených objektů.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Povoluje noční dynamické stíny v interiéru vozidla.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu efektů počasí, jako jsou odrazy na vozovce."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu odrazů pozorovaných v zrcátkách vozidla (nezávisle na nastavení odlesků).<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje rozlišení obrazu vykreslovaného v zrcátkách tvého vozidla."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje vzdálenost, ze které se objekty v zrcátkách začnou vykreslovat.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle značný vliv na výkon."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje kvalitu některých textur aplikovaných na objekty a povrchy ve hře."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "Vylepšuje ostrost textur, zejména těch, které jsou pozorovány z dálky nebo pod šikmým úhlem.<br><br><color value=@@clr_txt_d@@>Změna tohoto nastavení se projeví až po ručním restartu hry."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Přidává podobu geometrických detailů na chodníky, silnice a další objekty pro vylepšení jejich vzhledu.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon.<br><br>Změna tohoto nastavení se projeví až po ručním restartu hry."

	key[]: "traffic_headlights_op_tooltip" # - Graphics, Advanced
	val[]: "Povoluje světelný kužel z předních světel ostatních vozidel v provozu."

	key[]: "secondary_lights_op_tooltip" # - Graphics, Advanced
	val[]: "Povoluje světelný kužel z vedlejších světel ostatních vozidel v provozu, jako např. směrová světla, brzdy, apod."

	key[]: "light_ranges_op_tooltip" # - Graphics, Advanced
	val[]: "Upravuje vzdálenost, ze které lze vidět zdroje umělého světla.<br><br><color value=@@clr_txt_d@@>Toto nastavení má obvykle průměrný vliv na výkon."

	key[]: "pedestrians_op_tooltip" # - Graphics, Advanced
	val[]: "Povoluje chodce v herním světě."
