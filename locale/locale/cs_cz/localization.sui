	key[]: "quick_controller_setup"
	val[]: "Rychlé nastavení gamepadu nebo volantu"

#+ Selection of the controller subtype
#@{

	key[]: "controller_subtype"
	val[]: "Typ ovladače" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "Volant" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
