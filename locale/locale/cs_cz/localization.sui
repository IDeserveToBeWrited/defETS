	key[]: "mp_warning_target_company_sleeping_cancel"
	val[]: "Aktuálně doručuješ náklad do firmy, která v této relaci není aktivní.<br>Pokud se chceš připojit, nejdříve svou zakázku dokonči, jinak bude zrušena.<br><br>Chceš pokračovat?"

	key[]: "mp_warning_close_to_conflicted_company_suspend"
	val[]: "Pro připojení k této relaci bude nutné aktivovat firmu poblíž tvého tahače nebo návěsu.<br>Aby ses vyhnul jakýmkoliv problémům, přesuň svůj tahač a návěs dále od firmy, jinak bude tvá aktuální zakázka pozastavena a nedostupná během této relace a zároveň budeš přesunut k nejbližšímu servisu.<br><br>Chceš pokračovat?"

	key[]: "mp_warning_close_to_conflicted_company_teleport"
	val[]: "Pro připojení k této relaci bude nutné aktivovat firmu poblíž tvého tahače nebo návěsu.<br>Aby ses vyhnul jakýmkoliv problémům, přesuň svůj tahač a návěs dále od firmy, jinak bude tvá aktuální zakázka zrušena a zároveň budeš přesunut k nejbližšímu servisu.<br><br>Chceš pokračovat?"

	key[]: "mp_warning_truck_before_quick_job_close_cancel_teleport"
	val[]: "Pro připojení k této relaci bude nutné aktivovat firmu poblíž místa, kde jsi nechal svůj tahač nebo návěs.<br>Aby ses vyhnul jakýmkoliv problémům po návratu ke svému tahači, tvá rychlá zakázka musí být zrušena a zároveň budeš přesunut k nejbližšímu servisu.<br><br>Chceš pokračovat?"

	key[]: "mp_warning_company_with_selected_job_sleeping"
	val[]: "Tvá vybraná zakázka začíná nebo končí ve firmě, která v této relaci není aktivní a po připojení nebude k dispozici.<br><br>Chceš pokračovat?"

