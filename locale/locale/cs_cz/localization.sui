#+ Tooltips.
#@{
	key[]: "bcg_theme_op_tooltip" # - Gameplay, Simple
	val[]: "Výběr motivů, které se zobrazují na pozadí během procházení menu."

	key[]: "bcg_rnd_op_tooltip" # - Gameplay, Simple
	val[]: "Zapíná výběr náhodného motivu pozadí po každém spuštění hry."

	key[]: "desktop_fadeout_op_tooltip" # - Gameplay, Simple
	val[]: "Nastavuje zpoždění, po kterém zmizí prvky na ploše."

	key[]: "fatigue_simulation_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, začneš časem pociťovat účinky únavy.<br><br>Za nedodržování odpočinku dostaneš pokutu."

	key[]: "traffic_offense_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, musíš dodržovat pravidla silničního provozu nebo riskovat pokuty. Riziko je větší v blízkosti policejních vozidel, radarů a dopravních kamer."

	key[]: "preferred_job_length_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje průměrnou délku nabízených zakázek."

	key[]: "adviser_speed_limit_op_tooltip" # - Gameplay, Advanced
	val[]: "Výběr rychlostního limitu, který se má zobrazit v navigaci."

	key[]: "adviser_speed_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Při překročení rychlostního limitu se aktuální rychlost v navigaci zvýrazní červeně."

	key[]: "adviser_autopark_op_tooltip" # - Gameplay, Advanced
	val[]: "Jakmile dorazíš na místo určení, zobrazí se widget umožňující přeskočit parkování."

	key[]: "adviser_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Skrýt všechny widgety."

	key[]: "mirrors_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Obě zrcátka na obrazovce zůstanou skrytá."

	key[]: "notifications_keep_hidden_op_tooltip" # - Gameplay, Advanced
	val[]: "Všechny notifikace zůstanou skryté i při jejich obdržení."

	key[]: "heavy_cargo_warning_op_tooltip" # - Gameplay, Advanced
	val[]: "Zobrazí okno s informacemi o vhodnosti aktuálního tahače hráče před přijetím zakázky s těžkým nákladem."

	key[]: "map_alignment_op_tooltip" # - Gameplay, Advanced
	val[]: "Vyber způsob, jakým se zobrazuje mapa světa."

	key[]: "map_exploration_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Vyber způsob, jakým způsobem bude prozkoumávána mapa světa:<br>- „Objevování blízkého okolí“ označí jako prozkoumanou větší oblast kolem hráče.<br>- „Přesné objevování“ označí pouze oblasti přímo u hráče."

	key[]: "show_navigation_op_tooltip" # - Gameplay, Advanced
	val[]: "Výběr způsobu, jakým se zobrazuje navigace."

	key[]: "navigation_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Mění způsob výpočtu trasy navigace:<br>- Režim „Nejlepší“ volí nejefektivnější poměr mezi délkou a časem trasy, snaží se vyhýbat křižovatkám se semafory apod.<br>- Režim „Nejkratší“ volí vždy nejkratší možnou trasu.<br>- Režim „Malé silnice“ se snaží vyhýbat dálnicím, kdykoli je to možné."

	key[]: "trailer_parking_difficulty_op_tooltip" # - Gameplay, Advanced
	val[]: "Výběr obtížnosti parkování:<br>- Režim „Vždy zvolit“ nabídne výběr pokaždé, když dorazíš do cíle.<br>- „Bezpečné parkování“ nevyžaduje couvací manévry.<br>- „Zručné parkování“ bude obvykle vyžadovat náročnější couvací manévr."

	key[]: "road_events_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje pravděpodobnost setkání s nebezpečím na silnici, jako např. nehody, nepojízdná vozidla, úlomky na vozovce apod."

	key[]: "detours_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje pravděpodobnost setkání se s událostí na trase způsobující objížďku při aktivní zakázce."

	key[]: "rain_factor_op_tooltip" # - Gameplay, Simple
	val[]: "Upravuje pravděpodobnost nepříznivého počasí."

	key[]: "time_zones_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber, zda se mají kromě aktuálního času zobrazovat i informace o časovém pásmu."

	key[]: "show_cutscenes_op_tooltip" # - Gameplay, Simple
	val[]: "Povoluje herní cutscény, které se obvykle zobrazují po nákupu vozidla, vylepšení garáže nebo při nástupu cestujících."

	key[]: "show_blockers_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber, zda se na nepřístupných cestách mají zobrazovat poloprůsvitné blokace."

	key[]: "mouse_invert_op_tooltip" # - Gameplay, Simple
	val[]: "Invertuje osu Y myši při ovládání kamery ve hře."

	key[]: "trans_type_op_tooltip" # - Gameplay, Advanced
	val[]: "Výběr způsobu řazení:<br>- „Zjednodušená automatická“ umožňuje použití plynu a brzdy k ovládání pohybu vpřed a vzad.<br>- „Reálná automatická“ vyžaduje vstup pro přepnutí mezi pohybem vpřed a vzad.<br>- „Sekvenční“ vyžaduje manuální řazení všech rychlostních stupňů se vstupy pro řazení nahoru/dolů.<br>- „Řadicí páka“ vyžaduje použití příslušného ovladače pro manuální řazení převodových stupňů."

	key[]: "intelligent_sequential_shifting_op_tooltip" # - Gameplay, Advanced
	val[]: "Výběrem této funkce umožníš „přeskakování stupňů“ – přeskákování může být nutné nebo vhodné, aby se zabránilo řazení každého stupně v převodovce."

	key[]: "steering_autocenter_op_tooltip" # - Gameplay, Advanced
	val[]: "Vrací volant zpět do středu při ovládání na klávesnici nebo ovladači.<br><br>Vypnutím této funkce budeš muset ručně zatáčet zpět do středu."

	key[]: "steering_anim_range_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje rozsah animace otáčení volantu."

	key[]: "brake_intensity_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje intenzitu brzd."

	key[]: "truck_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje stabilitu vozidla snížením jeho těžiště."

	key[]: "trailer_stability_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje stabilitu návěsu snížením jeho těžiště."

	key[]: "driveshaft_torque_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje intenzitu točivého momentu generovaného hnací soustavou.<br><br>Zvýšením tohoto nastavení se zvýší pocit „kroucení“ vozidla směrem doprava."

	key[]: "suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje tuhost zavěšení podvozku."

	key[]: "cabin_suspension_stiffness_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje tuhost zavěšení kabiny."

	key[]: "road_bumps_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Upravuje intenzitu procedurálně generovaných povrchových nerovností tak, aby silnice a jiné terény působily nedokonale.<br><br>V závislosti na dalším nastavení odpružení a kamery může být vnímaný efekt více či méně výrazný."

	key[]: "trailer_advanced_coupling_op_tooltip" # - Gameplay, Advanced
	val[]: "Zapíná pokročilé připojování vyžadující přesnější srovnání točnice kamionu s čepem návěsu.<br><br>Pokud je tato funkce vypnuta, připojování návěsu je mnohem snazší, protože nedochází ke kolizi mezi čepem a točnicí."

	key[]: "trailer_cables_mode_op_tooltip" # - Gameplay, Simple
	val[]: "Výběr, na kterých návěsech se mají animovat kabely.<br><br><color value=@@clr_txt_d@@>Zapnutí animace kabelů pro více vozidel může ovlivnit výkon na starších systémech."

	key[]: "truck_speed_limiter_op_tooltip" # - Gameplay, Simple
	val[]: "Zapíná elektronický omezovač rychlosti tahače na 90 km/h (56 mil/h).<br><br><color value=@@clr_txt_d@@>Zakázky přes World of Trucks mají tuto funkci zapnutou permanentně."

	key[]: "rain_sensor_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li tato funkce povolena a stěrače jsou nastavené do první polohy, budou se automaticky zapínat a upravovat svou rychlost podle vnějších podmínek."

	key[]: "auto_retarder_op_tooltip" # - Gameplay, Advanced
	val[]: "Zapíná automatickou funkci retardéru při brzdění."

	key[]: "hill_brake_assist_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, vozidlo pomáhá ve svahu tím, že drží brzdy, což zajišťuje plynulý rozjezd."

	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Zapíná automatickou funkci motorové brzdy při brzdění."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, motor automaticky nastartuje hned po sešlápnutí plynu."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, parkovací brzda vozidla bude ve výchozím stavu vždy zatažena (po použití trajektu, odtažení do servisu, rychlém cestování apod.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "Automaticky spouští zdvihací nápravy, pokud je to potřeba vzhledem k hmotnosti vozidla."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, vozidlo bude ve výchozím stavu méně dávkovat plyn. Po rychlém dvojitém stisknutí tlačítka plynu bude vozidlo držet plný plyn, dokud tlačítko opět neuvolníš.<br><br>Ovlivňuje pouze ovládání na klávesnici."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Simuluje skutečnou ztrátu vzduchu při nadměrném brzdění.<br><br>Při sjíždění kopců nebo pomalých manévrech s častým brzděním budeš muset řešit tlak vzduchu."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "Není-li zapnuto, spotřeba paliva není ovlivněna stylem jízdy nebo stavem vozovky.<br><br>Je-li zapnuto, spotřebu paliva ovlivňuje několik faktorů, včetně stylu jízdy, hmotnosti nákladu, valivého odporu a terénního profilu, namísto herní dovednosti pro úspornou jízdu."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, ABS zabrání zablokování kol pro zachování kontroly nad tahačem při brzdění."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, vozidlo bude aplikovat brzdy na jednotlivá kola, aby se zabránilo prokluzování kol, nedotáčivosti nebo přetáčivosti pro zachování kontroly nad vozidlem."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, při prokluzování kol vozidla uzamkne diferenciál pro zlepšení trakce."

	key[]: "cruise_control_grid_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje změnu rychlosti, o kterou se tempomat zvýší nebo sníží po stisknutí příslušného tlačítka."

	key[]: "smart_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje toleranci tempomatu pro udržení cílové rychlosti."

	key[]: "adaptive_cruise_control_op_tooltip" # - Gameplay, Advanced
	val[]: "Adaptivní tempomat automaticky upravuje rychlost tak, aby udržoval bezpečnou vzdálenost od vozidla před sebou."

	key[]: "emergency_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "Aktivuje nouzové brzdění, pokud systém zaznamená hrozící kolizi.<br>Můžeš vybrat, zda bude systém reagovat pouze na vozidla nebo na všechny překážky."

	key[]: "lane_assistant_mode_op_tooltip" # - Gameplay, Advanced
	val[]: "Výběr režimů jízdního asistenta:<br>- Režim „Výstraha při opuštění pruhu“ tě zvukově upozorní, pokud začneš opouštět jízdní pruh.<br>- Režim „Podpora pro udržení v pruhu“ kromě zvukové výstrahy zároveň automaticky zatočí s tvým vozidlem tak, aby zabránil opuštění jízdního pruhu.<br><br>Oba režimy jsou aktivní pouze při rychlostech nad 55 km/h (~35 mil/h).<br>Jízdní asistent před zásahem bere v potaz použití směrových světel."

	key[]: "blind_spot_op_tooltip" # - Gameplay, Advanced
	val[]: "Zapíná funkce systému hlídání mrtvého úhlu, pokud jím je tvé vozidlo vybaveno."

	key[]: "automatic_headlights_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li tato funkce povolena a přední světla jsou nastavena do první polohy, budou se automaticky zapínat při slabé viditelnosti."

	key[]: "automatic_high_beams_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li tato funkce povolena a přední světla jsou zapnuta spolu s dálkovými světly, budou se automaticky přepínat při detekci protijedoucího vozidla nebo vozidla blízko před tebou."

	key[]: "blinker_auto_off_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, směrová světla se budou automaticky vypínat po dokončení zatáčky, jakmile je volantem zatočeno zpět do středu."

	key[]: "toy_phys_move_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, některé interiérové doplňky reagují na fyzický pohyb vozidla (zavěšené dekorace, bobbleheady apod.)."

	key[]: "steer_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Zapíná otáčení vnitřní kamery na základě řízení."

	key[]: "steer_cam_rotation_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje, jak moc funkce „otáčení kamery při zatáčení“ reaguje na řízení."

	key[]: "steer_cam_rotation_reverse_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje chování funkce „otáčení kamery při řízení“ při couvání."

	key[]: "blinker_cam_rotation_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, vnitřní kamera se otáčí doleva nebo doprava dle použití směrových světel."

	key[]: "phys_cam_move_op_tooltip" # - Gameplay, Advanced
	val[]: "Je-li povoleno, vnitřní kamera reaguje na pohyb vozidla."

	key[]: "phys_cam_move_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje, jak moc vnitřní kamera reaguje na pohyb vozidla."

	key[]: "cam_horizon_lock_factor_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje, jak moc se může vnitřní kamera naklánět vůči pohybu vozidla."

	key[]: "cam_auto_center_delay_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje prodlevu, po které se kamera automaticky vycentruje.<br><br>Pro aktivaci funkce se vozidlo musí pohybovat nezanedbatelnou rychlostí. Platí pouze pro vnitřní a vnější kameru při pohybu vpřed a pro kameru z okýnka při pohybu vzad."

	key[]: "cam_auto_move_speed_op_tooltip" # - Gameplay, Advanced
	val[]: "Nastavuje rychlost pohybu kamery při automatickém centrování kamery a při přepínání mezi pozicemi vnitřní kamery."

	key[]: "cam_interior_zoom_mode_op_tooltip" # - Gameplay
	val[]: "Určuje chování pro přiblížení vnitřní kamery: držením tlačítka se přiblíží dočasně, nebo stisknutím tlačítka se příblíží trvale." #+ Tooltip explaining the zoom mode options.

	key[]: "language_op_tooltip" # - Gameplay, Simple
	val[]: "Výběr jazyka, který se bude používat napříč hrou."

	key[]: "region_op_tooltip" # - Gameplay, Simple
	val[]: "Nastavuje měnu a jednotky na základě vybraného regionu."

	key[]: "localized_city_country_names_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, města a země se budou zobrazovat v tebou vybraném jazyce."

	key[]: "show_secondary_names_in_map_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, města a země na mapě se budou zobrazovat v tebou zvoleném jazyce i v úředním jazyce daného regionu zároveň."

	key[]: "displayed_currency_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber měnu, kterou chceš používat."

	key[]: "clock_notation_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber mezi 12hodinovým nebo 24hodinovým zápisem času."

	key[]: "length_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber jednotky délky, které se budou zobrazovat."

	key[]: "weight_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber jednotky hmotnosti, které se budou zobrazovat."

	key[]: "temperature_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber jednotky teploty, které se budou zobrazovat."

	key[]: "pressure_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber jednotky tlaku, které se budou zobrazovat."

	key[]: "volume_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber jednotky objemu, které se budou zobrazovat."

	key[]: "consumption_units_op_tooltip" # - Gameplay, Simple
	val[]: "Vyber jednotky spotřeby, které se budou zobrazovat."

	key[]: "chat_with_activate_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, pomocí klávesy „Aktivovat“ (@@imv_nrm_activate@@) se otevře chat během konvojové relace."

	key[]: "chat_close_automatic_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, vstupní panel chatu zůstane aktivní i po odeslání zprávy."

	key[]: "chat_full_fade_out_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, zprávy v chatu se schovají několik sekund po každé zprávě."

	key[]: "chat_fade_out_timer_op_tooltip" # - Gameplay, Simple
	val[]: "Nastavuje prodlevu, jak dlouho zůstanou zprávy v chatu zobrazené před jejich schováním."

	key[]: "mp_name_tags_op_tooltip" # - Gameplay, Simple
	val[]: "Je-li povoleno, jmenovky hráčů budou zobrazeny nad jejich tahači během konvojové relace."

	key[]: "configure_quick_replies_op_tooltip" # - Gameplay, Advanced
	val[]: "Otevře rozšířenou konfiguraci rychlých odpovědí pro chatování v konvojových relacích."

	key[]: "wotr_connected_content_op_tooltip" # - Online, Simple
	val[]: "Zkontroluj stav svého obsahu propojeného s World of Trucks."

	key[]: "online_news_op_tooltip" # - Online, Simple
	val[]: "Povoluje stahování online zpráv, které se zobrazují na úvodní obrazovce."

	key[]: "online_loading_screens_op_tooltip" # - Online, Simple
	val[]: "Povoluje stahování komunitních screenshotů vybraných ze stránek World of Trucks, které se zobrazují na načítacích obrazovkách."

	key[]: "online_billboards_op_tooltip" # - Online, Simple
	val[]: "Povoluje stahování skutečných reklam, které se zobrazují na vybraných billboardech ve hře."
