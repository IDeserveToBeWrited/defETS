
    key[]: "hint_engine_title"
	val[]: "Nastartuj motor"

    key[]: "hint_engine_text"
	val[]: "Použij $KEY_engine$ pro nastartování motoru."


    key[]: "hint_ignition_title"
	val[]: "Zapni napájení"

    key[]: "hint_ignition_text"
	val[]: "Použij $KEY_engineelect|KEY_engine$ pro zapnutí napájení."


    key[]: "hint_driv_arc_title"
	val[]: "Jízda"

    key[]: "hint_driv_arc_text"
	val[]: "Použij $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pro jízdu vpřed či vzad.<br><offset vshift=8>Použij $SPECIAL_steering$ pro zatáčení."


    key[]: "hint_driv_auto_title"
	val[]: "Jízda"

    key[]: "hint_driv_auto_text"
	val[]: "Použij $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pro jízdu vpřed či vzad.<br><offset vshift=8>Použij $SPECIAL_steering$ pro zatáčení.<br><offset vshift=8>Stiskni $KEY_gearup$ a $KEY_geardown$ pro výběr rychlostního stupně."


    key[]: "hint_driv_seq_title"
	val[]: "Jízda"

    key[]: "hint_driv_seq_text"
	val[]: "Použij $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pro jízdu vpřed či vzad.<br><offset vshift=8>Použij $SPECIAL_steering$ pro zatáčení.<br><offset vshift=8>Stiskni $KEY_gearup$ a $KEY_geardown$ pro ovládání spojky."


    key[]: "hint_driv_hshift_title"
	val[]: "Jízda"

    key[]: "hint_driv_hshift_text"
	val[]: "Použij $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ a $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ pro jízdu vpřed či vzad.<br><offset vshift=8>Použij $SPECIAL_steering$ pro zatáčení.<br><offset vshift=8>Rychlostní stupeň změníš pomocí <color value=@@clr_sel@@>řadicí páky<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Přijeď na místo určení"

    key[]: "hint_depot_deliv_text"
    val[]: "Zastav na vyznačeném místě pro výběr obtížnosti parkování a získej odpovídající zkušenostní body."


    key[]: "hint_fin_deliv_title"
    val[]: "Dokonči zakázku"

    key[]: "hint_fin_deliv_text"
    val[]: "Zaparkuj na vyznačeném místě. Stisknutím klávesy $KEY_activate$ můžeš parkování přeskočit, jakmile budeš blíže místu doručení."


    key[]: "hint_fin_deliv2_title"
    val[]: "Dokonči zakázku"

    key[]: "hint_fin_deliv2_text"
    val[]: "Zaparkuj na vyznačeném místě. V @@desktop_menu_category_options@@ můžeš povolit widget, který ti umožní parkování přeskočit."


    key[]: "hint_lights_title"
    val[]: "Rozsviť světla"

    key[]: "hint_lights_text"
    val[]: "Použij $KEY_light$ pro rozsvícení světel. Opakovaným stisknutím přepínej mezi různými režimy."


    key[]: "hint_high_beam_title"
    val[]: "Rozsviť dálková světla"

    key[]: "hint_high_beam_text"
    val[]: "Použij $KEY_hblight$ pro rozsvícení dálkových světel."


    key[]: "hint_wipers_title"
    val[]: "Zapni stěrače"

    key[]: "hint_wipers_text"
    val[]: "Použij $KEY_wipers$ pro aktivaci stěračů a procházení různých nastavení rychlosti."


    key[]: "hint_zoom_title"
    val[]: "Přiblížení"

    key[]: "hint_zoom_text"
    val[]: "Použij $KEY_camzoom$ pro přiblížení kamery v interiéru. Režim přiblížení můžeš nastavit na podržení nebo přepínání v @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Rozhlížení"

    key[]: "hint_cam_int_text"
    val[]: "Použij $KEY_cam1$ pro přepnutí na vnitřní kameru."


    key[]: "hint_cam_ext_title"
    val[]: "Rozhlížení"

    key[]: "hint_cam_ext_text"
    val[]: "Přepínat mezi různými kamerami můžeš stisknutím $KEY_camcycle$.<br><offset vshift=8>Použij $KEY_cam2$ pro přepnutí na vnější kameru."


    key[]: "hint_indicators_title"
    val[]: "Směrová světla"

    key[]: "hint_indicators_text"
    val[]: "Použij $KEY_lblinker$ a $KEY_rblinker$ pro zapnutí směrových světel."


    key[]: "hint_tow_title"
    val[]: "Odtahová služba"

    key[]: "hint_tow_text"
    val[]: "Pokud se nemůžeš dostat z jakékoliv obtížné situace, využij odtahové služby. Pro přístup k ní otevři nabídku @@quick_info_word@@ pomocí $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Uzávěrka diferenciálu"

    key[]: "hint_diff_lock_text"
    val[]: "Pokud se nemůžeš rozjet, možná by ti pomohla uzávěrka diferenciálu. Použij $KEY_diflock$ pro její aktivaci nebo zapni automatickou uzávěrka diferenciálu v @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Uzamčená uzávěrka diferenciálu"

    key[]: "hint_diff_unlock_text"
    val[]: "Během běžné jízdy bys měl diferenciál odemknout, jinak hrozí jeho poškození. Použij $KEY_diflock$ pro jeho deaktivaci nebo zapni automatickou uzávěrku diferenciálu v @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Vypni stěrače"

    key[]: "hint_wipers_off_text"
    val[]: "Použij $KEY_wipers$ pro deaktivaci stěračů a procházení různých nastavení rychlosti."


    key[]: "hint_world_map_title"
    val[]: "Zobrazení mapy"

    key[]: "hint_world_map_text"
    val[]: "Použij $KEY_navmap$ pro otevření mapy světa."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Použij $KEY_advmouse$ pro otevření @@quick_info_word@@ - přehled o tvém stavu a praktické zkratky."


    key[]: "hint_pause_border_title"
    val[]: "Místní předpisy"

    key[]: "hint_pause_border_text"
    val[]: "Použij $KEY_advmouse$ pro otevření @@quick_info_word@@ a podívej se na aktuální předpisy v oblasti, do které jsi právě vjel."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Otevři @@quick_info_word@@ pomocí $KEY_advmouse$, aby ses dostal do @@photo_mode_word@@ a mohl vyfotit blízký @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ poblíž"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> se nachází poblíž - najdi jej a aktivuj pro zhlédnutí custcény."


    key[]: "hint_resting_title"
    val[]: "Odpočívadlo poblíž"

    key[]: "hint_resting_text"
    val[]: "Odpočívadla <img src=/material/ui/map/parking_ico.mat width=20 height=20> ti umožňují zmírnit únavu a dodržet povinnou přestávku pro bezpečné pokračování v jízdě."


    key[]: "hint_gas_title"
    val[]: "Čerpací stanice poblíž"

    key[]: "hint_gas_text"
    val[]: "Čerpací stanice <img src=/material/ui/map/gas_ico.mat width=20 height=20> můžeš použít k dotankování paliva do svého vozidla."
