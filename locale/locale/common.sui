
	key[]: "icon_job_cancel"
	val[]: "/material/ui/adviser/cancel.mat right=p22"

	key[]: "icon_call_assistance"
	val[]: "/material/ui/adviser/ico_assistance.mat left=p5 right=p27 top=p5 bottom=p27"

	key[]: "degree"
	val[]: "°"

	key[]: "pipe_char"
	val[]: "|" #+ Helper which can be used when passing text which might contain this character as input to UI templates which use it as parameter separator

	key[]: "check_char"
	val[]:	"✔" #+ WoTr event completion symbol

	key[]: "mp_name_tag_voice_icon"
	val[]: "<img src=/material/ui/multiplayer/nametag_voice.mat yscale=stretch xscale=stretch height=26 width=26 left=p4 right=p28 top=p2 bottom=p30>" #+ MP voice icon

	key[]: "mp_name_tag_muted_icon"
	val[]: "<img src=/material/ui/multiplayer/nametag_muted.mat yscale=stretch xscale=stretch height=26 width=26 left=p4 right=p28 top=p2 bottom=p30>" #+ MP voice icon

	key[]: "mp_name_tag_ghost_icon"
	val[]: "<img src=/material/ui/multiplayer/nametag_ghost.mat yscale=stretch xscale=stretch height=26 width=19 left=p7 right=p25 top=p2 bottom=p30>" #+ MP ghost icon

	key[]: "mp_name_tag_chat_icon"
	val[]: "<img src=/material/ui/multiplayer/nametag_chat.mat yscale=stretch xscale=stretch height=26 width=25 left=p4 right=p27 top=p2 bottom=p30>" #+ MP chat icon

	key[]: "mp_name_tag_menu_icon"
	val[]: "<img src=/material/ui/multiplayer/nametag_menu.mat yscale=stretch xscale=stretch height=26 width=25 left=p4 right=p27 top=p2 bottom=p30>" #+ MP menu icon

	key[]: "mp_name_tag_icon_padding"
	val[]: "<offset hshift=8>" #+ MP icon padding element, empty space to be added between multiple icons

