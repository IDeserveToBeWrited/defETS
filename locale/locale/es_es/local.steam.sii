#!}
#@}

#@}

#+ Steam Input mapping mode introduction message box.
#@{
	key[]: "decide_steam_input_mode_t"
	val[]: "SELECCIÓN DE ASIGNACIÓN DE ENTRADA" #+ Title of the message box.

	key[]: "decide_steam_input_mode"
	val[]: "Se ha añadido un nuevo y recomendado <color value=@@clr_sel@@>modo de asignación en juego<color value=@@clr_txt@@> que ofrece soporte completo de configuraciones de asignación de botones en el juego y mejores sugerencias para los mismos.<br><br>Mantén el <color value=@@clr_sel@@>modo de asignación en Steam<color value=@@clr_txt@@> si has personalizado tu controlador a través de Steam.<br><br>Puedes cambiar de modo en cualquier momento usando el asistente de entrada desde las opciones." #+ Text shown in a message box.

	key[]: "decide_steam_input_mode_keep_advanced"
	val[]: "Mantener modo Steam" #+ Button keeping the old advanced mode of Steam Input.

	key[]: "decide_steam_input_mode_setup_simple"
	val[]: "Abrir asistente de entrada" #+ Button opening Input Wizard.
#@}

#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

#+ Selection of the Steam Input Mapping Mode
#@{
	key[]: "steam_input_mode"
	val[]: "Modo de asignación de Steam Input" #+ Label of the line.

	key[]: "steam_input_mode_simple"
	val[]: "Asignación en juego" #+ Default simple in-game layout.

	key[]: "steam_input_mode_advanced"
	val[]: "Asignación en Steam" #+ Advanced external layout configured in Steam Client.
#@}

#+ Tooltips.
#@{
	key[]: "steam_input_mode_op_tooltip" # - Controls, Advanced
	val[]: "Establece el modo para los mandos que están integrados en la interfaz de Steam Input, como @@controller_ps5@@, @@controller_xbox_one@@ o @@controller_steam_deck@@.<br><br>- Asignación en Steam: usa disposiciones independientes configuradas a través de Steam. Ofrece soporte limitado para sugerencias de botones y no permite configurar las asignaciones dentro del juego.<br>-Asignación en juego: usa una disposición sencilla. Ofrece soporte completo para configurar las asignaciones dentro del juego y mejores sugerencias de botones. Se recomienda utilizar este modo. También se recomienda ejecutar el asistente de entrada al cambiar a este modo."
#@}

#@}

#+ Supported controller names.
#@{
	key[]: "controller_steam"
	val[]: "Steam Controller"

	key[]: "controller_steam_deck"
	val[]: "Interfaz de Steam Deck"

	key[]: "controller_steam_fusion"
	val[]: "Controlador gestionado por Steam"
#@}

#+ Profile selection.
#@{
	key[]: "steam_cloud_synchronization"
	val[]: "Sincronización con Steam Cloud:" #+ Whether is steam cloud synchronization active.
#@}

#+ News.
#@{
	key[]: "new_version_available_steam"
	val[]: "Estás usando una versión más antigua del juego.<br>Steam actualizará el juego automáticamente, a no ser que dicha opción esté desactivada."
#@}

	key[]: "steam_demo"
	val[]: "Si te ha gustado la demo de Euro Truck Simulator 2, puedes comprar la versión completa en <LINK URL=@@steam_buy_url@@ COLOR=@@clr_link@@>Steam</LINK>." #+ Message shown on the "activation" screen for Steam demo only build.

#+ Networking errors
#@{
#+ Error message shown when the game version distributed over Steam can not communicate with the Steam client.

	key[]: "sys_no_steam"
	val[]: "Euro Truck Simulator 2 no puede acceder a Steam. Prueba a seguir los siguientes pasos:\n\n1. Comprueba que Steam se está ejecutando.\n2. Comprueba que la última versión de Steam está instalada.\n3. Comprueba que las actualizaciones automáticas están activadas y que el juego está actualizado a la última versión."
#@}

#+ Message shown when there are DLC packs which are not compatible with the game.
#@{
	key[]: "incompatible_dlc_steam"
	val[]: "Al menos un DLC no es compatible con la versión actual del juego y será desactivado. Comprueba la integridad de la caché del juego en Steam.<br><br>El contenido afectado es el siguiente:"
#@}

#+ Steam cloud.
#@{
	key[]: "steam_profile_already_exists"
	val[]: "No se ha podido crear el perfil de Steam porque ya existe uno con el mismo nombre." #+ Create profile screen, cannot create steam profile because of name conflict.

	key[]: "migration_target_profile_already_exists"
	val[]: "No se ha podido migrar el perfil porque ya existe uno con el mismo nombre." #+ Edit screen, cannot migrate profile from/to steam because of name conflict.

	key[]: "steam_profile_migration_error"
	val[]: "Error al migrar el perfil de Steam." #+ Edit screen, cannot migrate profile because of some internal error.

	key[]: "steam_cloud_settings_label"
	val[]: "Sincronización con Steam Cloud" #+ Edit or create screen checkbox.

	key[]: "load_msg_out_of_steam_intro_has_space"
	val[]: "No hay suficiente espacio para tus partidas guardadas en Steam Cloud." #+ Load screen with out of steam warning when player removed enough save.

	key[]: "load_msg_out_of_steam_intro_no_space"
	val[]: "<color value=@@clr_red@@>Te estás quedando sin espacio en Steam Cloud.<color value=@@clr_txt@@><br><br>Elimina algunas partidas guardadas para proceder. Aquí tienes algo de información para ayudarte:" #+ Load scrren with out of steam warning when player does not yet removed enough save.

	key[]: "load_msg_out_of_steam_to_free_bytes"
	val[]: "Espacio excedido: <color value=@@clr_red@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has to remove.

	key[]: "load_msg_out_of_steam_to_free_files"
	val[]: "Archivos excedidos: <color value=@@clr_red@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has to remove.

	key[]: "load_msg_out_of_steam_used_bytes"
	val[]: "Espacio en Steam Cloud usado: <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@>" #+ Number of Megabytes player has in the cloud.

	key[]: "load_msg_out_of_steam_used_files"
	val[]: "Archivos en Steam Cloud: <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@>" #+ Number of files player has in the cloud.

	key[]: "load_msg_out_of_steam_selected_save"
	val[]: "La partida guardada <color value=@@clr_sel@@>$SAVE$<color value=@@clr_txt@@> contiene <color value=@@clr_sel@@>$BYTES$ MB<color value=@@clr_txt@@> en <color value=@@clr_sel@@>$FILES$<color value=@@clr_txt@@> archivos." #+ Selected save info.

	key[]: "load_msg_out_of_steam_box"
	val[]: "Te estás quedando sin espacio en Steam Cloud. Elimina algunas partidas guardadas para proceder.<br><br>Consulta los detalles en el panel derecho para más información." #+ Popup when trying load game ignoring warning about steam cloud running out of space.

	key[]: "steam_profile_migration_to_local_warning"
	val[]: "Tras migrar el perfil de Steam al modo local, solo estará disponible en este equipo independientemente de la cuenta de Steam registrada." #+ Popup warning when player unchecks the steam cloud checkbox in the profile edit screen.

	key[]: "migration_failed"
	val[]: "Se ha producido un error al migrar el perfil. No se han transferido ningún dato y el original no ha sufrido alteraciones." #+ shown during profile type switching (e.g., Steam ↔ non-Steam) if moving save files fails
#@}

