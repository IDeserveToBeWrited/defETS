	key[]: "display_lighting_t"
	val[]: "ნათება" #+ Title of the 'Lighting' section. Please keep in upper case where possible.

	key[]: "display_postprocessing_t"
	val[]: "დამუშავების შემდგომი" #+ Title of the 'Postprocessing' section. Please keep in upper case where possible.

	key[]: "display_environment_t"
	val[]: "გარემო" #+ Title of the 'Environment' section. Please keep in upper case where possible.

	key[]: "fullscreen_mode"
	val[]: "მთლიან ეკრანზე" #+ Checkbox to enable the full screen mode.

	key[]: "brightness"
	val[]: "სიკაშკაშე / HDR" #+ Button opening brightness or HDR brightness setup.

	key[]: "brightness_setup_button"
	val[]: "გამართვა" #+ Text on the brightness button itself.

	key[]: "resolution"
	val[]: "გარჩევადობა" #+ Combo box for selection of display resolution.


	key[]: "refresh_rate"
	val[]: "განახლების სიხშირე" #+ Combo box for selection of the refresh rate.

	key[]: "fps_limit"
	val[]: "ზღვრული FPS" #+ Maximum FPS allowed while in game.

	key[]: "fps_limit_inactive"
	val[]: "ზღვრული FPS ფონურად" #+ Maximum FPS allowed while the game is alt-tabbed in the background.

	key[]: "default_refresh"
	val[]: "საშუალო" #+ Value in the refresh rate combo box corresponding to default refresh rate as configured in the system.

	key[]: "hz"
	val[]: "ჰერცი" #+ Suffix appended to each value in the refresh rate combo box. For example "60 Hz".


	key[]: "vsync"
	val[]: "შვეული სინქრონიზაცია" #+ Combo box for selection of the vsync enable state.

	key[]: "eco_friendly"
	val[]: "დამზოგავი (ნაკლებ კვებას აცლის ნოუთბუქს)" #+ Special value in the vsync combo box corresponding to limiting the game to half of the refresh rate.


	key[]: "simple_graphical_settings_t"
	val[]: "გრაფიკის გამარტივებული გამართვა" #+ Header of section containing a simple selection between Low/Medium/High/Ultra quality preset.

	key[]: "custom_settings_applied_t"
	val[]: "მიღებულია მორგებული პარამეტრები" #+ Shown if the simple settings section if the current configuration does not correspond to any known preset.


	key[]: "adv_graphical_settings_t"
	val[]: "გრაფიკის დაწვრილებითი გამართვა" #+ Header of section containing all configuration options.

	key[]: "adv_graphical_settings"
	val[]: "გრაფიკის ადვილი/დაწვრილებითი გამართვა" #+ Switch between simple and advanced options.

	key[]: "simple_settings"
	val[]: "დაწვრილებითი პარამეტრების დამალვა" #+ Button used to switch the screen to the simple mode.

	key[]: "adv_settings"
	val[]: "დაწვრილებითი პარამეტრების ჩვენება" #+ Button used to switch the screen to the advanced mode.


	key[]: "scaling"
	val[]: "ზომაცვლა" #+ Combo box selecting the scale with which is the game image rendered. Selecting value bigger than 100% creates anti-aliasing, selecting value lower than 100% increases performance.

	key[]: "aa_mode"
	val[]: "დაკბილვის არიდება (AA)" #+ Combo box selecting anti-aliasing quality.

	key[]: "taa_luma_sharpening"
	val[]: "TAA – მნათი ნაწილის გამკვეთრება" #+ Slider adjusting additional temporal anti-aliasing sharpening.

	key[]: "taa_tuning"
 	val[]: "TAA — დაგლუვება" #+ Combo box selecting the temporal anti-aliasing tuning preset. This mainly impacts resulting image softness - some players may prefer a softer image at the cost of reduced flickering, some may prefer a sharper image.

	key[]: "taa_tuning_adaptive"
	val[]: "ცვალებადი სიმკვეთრე" #+ The default option. Keeps non-moving pixels softer to reduce flicker while keeping anything that moves sharp.

	key[]: "taa_tuning_always_soft"
	val[]: "მუდამ ბუნდოვანი" #+ Always generate a softer (less flickery) image. Best suited for high DPI viewing.

	key[]: "taa_tuning_always_sharp"
	val[]: "მუდამ მკაფიო" #+ Always generate a sharp (more flickery) image. Best suited for low DPI viewing.

	key[]: "ssao_mode"
	val[]: "ეკრანში მოქცეული შუქჩრდილების ასახვა (SSAO)" #+ Combo box selecting the screen space ambient occlusion quality.

	key[]: "hdr"
	val[]: "ფერთა გაუმჯობესებული ფარდობა (HDR)" #+ Checkbox enabling the high dynamic range rendering.

	key[]: "dof"
	val[]: "ხედვის სიშორე (DOF)" #+ Checkbox enabling the depth of field effect.

	key[]: "sunshaft"
	val[]: "მზის სხივები" #+ Checkbox enabling the sunshaft effects.

	key[]: "color_enhancement"
	val[]: "ფერების შესწორება" #+ Checkbox enabling color enhancement features (saturation and color balance changes)

	key[]: "reflection_scaling"
	val[]: "ანარეკლის ზომაცვლა" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "refl_detail"
	val[]: "ანარეკლის ხარისხი" #+ Combo box selecting quality of reflections on metal surfaces and water.

	key[]: "veget_detail"
	val[]: "მცენარეული საფარის ხარისხი" #+ Combo box selecting quality of vegetation.

	key[]: "grass_detail"
	val[]: "ბალახის სიმჭიდროვე" #+ Combo box selecting density of grass.

	key[]: "shadow_quality"
	val[]: "ჩრდილების ხარისხი"  #+ Combo box selecting quality of shadows.

	key[]: "shadow_texture_size"
	val[]: "ჩრდილის აგების ზომა" #+ Comb box for selecting size of the shadowmap textures used.

	key[]: "far_shadow"
	val[]: "შორი ჩრდილები" #+ Checkbox enabling far shadows.

	key[]: "interior_shadow"
	val[]: "ჩრდილები სალონში" #+ Checkbox enabling night-time dynamic shadows in the truck interior.

	key[]: "weather_quality"
	val[]: "ამინდის ხარისხი"  #+ Combo box selecting quality of weather effects (rain reflections).

	key[]: "mirror_quality"
	val[]: "სარკის ხარისხი" #+ Combo box selecting quality of the image reflected inside the mirrors.

	key[]: "mirror_resolution"
	val[]: "სარკის გარჩევადობა" #+ Combo box selecting resolution multiplier of the image reflected inside the mirrors.

	key[]: "mirror_distance"
	val[]: "სარკეში ხედვის სიშორე" #+ Combo box selecting distance visible inside inside the mirrors.

	key[]: "texture_quality"
	val[]: "ზედაპირების ხარისხი" #+ Combo box selecting quality of textures.

	key[]: "anisotrop"
	val[]: "არაერთგვაროვანი ჩვენების არიდება" #+ Slider controlling quality of anisotropic filtering applied to textures.

	key[]: "normal_maps"
	val[]: "ზედაპირის ჩაღრმავებების ასახვა" #+ Slider enabling usage of normal maps on models.

	key[]: "traffic_headlights"
	val[]: "გზის სანათები" #+ Checkbox enabling headlights of AI trucks.

	key[]: "secondary_lights"
	val[]: "სათადარიგო სანათები" #+ Checkbox enabling various auxiliary lights on vehicles (e.g. parking lights).

	key[]: "light_ranges"
	val[]: "სინათლის ხედვის არე" #+ Combo box selecting a distance from the camera inside which the game renders various lights (e.g. lamps)

	key[]: "pedestrians"
	val[]: "ქვეითები" #+ Checkbox enabling the pedestrians.


	key[]: "gfx_changed"
	val[]: "ჩვენების პარამეტრები შეიცვალა<br>გსურთ ამ პარამეტრების დატოვება?"

	key[]: "reverting_in"
	val[]: "გაუქმდება" #+ Shown in message box if the user applies some complex settings. Followed by number of seconds before the settings are reverted unless the player confirms the message box. For example "Reverting in 18 seconds."

	key[]: "sec"
	val[]: "წამში" #+ Suffix added after number of seconds in "Reverting in 18 seconds."

