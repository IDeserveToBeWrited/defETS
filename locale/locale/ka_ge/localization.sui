	key[]: "missing"
	val[]: "არ არის" #+ Specified input (axis or button) is missing. For example joystick is unplugged.

	key[]: "unknown"
	val[]: "უცნობია" #+ Name of specified input (axis or button) could not be determined.

	key[]: "complex"
	val[]: "კომპლექსური" #+ The configuration of input is too complex so the name of the input could not be determined. This can happen if the player manually tweaks the input configuration.

