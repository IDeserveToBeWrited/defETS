	key[]: "imgup_conflicting_upload"
	val[]: "ერთ ადგილზე იტვირთება რამდენიმე სურათი." #+ Error message shown if another client using the same account attempted to upload to the same slot.

	key[]: "imgup_disabled"
	val[]: "ატვირთვა დროებით შეჩერებულია, სცადეთ მოგვიანებით." #+ Error message shown if the service currently can not accept new screenshots.

