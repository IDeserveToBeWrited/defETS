	val[]: "თამაშის პარამეტრები დაყენებელია საწყისზე. შეგიძლიათ გამართოთ დამატებითი პარამეტრებიდან ან პირდაპირ განაგრძოთ თამაში."

#+ Button which opens the advanced setup page.

	key[]: "advanced"
	val[]: "დამატებითი პარამეტრები"
#@}

#+ Configuration complete page
#@{
	key[]: "wiz_cfg_done"
	val[]: "The game is now configured and you can continue. You can change the configuration later in Options."

	key[]: "wiz_cfg_steam"
	val[]: "შეგიძლიათ გადაამოწმოთ და გამართოთ ღილაკების ან ღერძების განლაგება ამ ჯოისტიკისთვის Steam-პროგრამიდან. Steam-ის ჯოისტიკის პარამეტრების შესასწორებლად მოცემული თამაშისთვის იხილეთ Steam > Library > Euro Truck Simulator 2 > Controller Configuration."

	key[]: "wiz_cfg_open_overlay"
	val[]: "სამართავის პარამეტრების გახსნა"

	key[]: "wiz_cfg_steer_keyboard"
	val[]: "<br>საჭის სამართავად გამოიყენეთ @@imm_wiz_dsteerleft@@ და @@imm_wiz_dsteerright@@."

	key[]: "wiz_cfg_steer_mouse"
	val[]: "<br>მისახვევ-მოსახვევად გამოიყენეთ თაგვი."

	key[]: "wiz_cfg_steer_wheel_or_gampead"
	val[]: "<br>საჭის სამართავად გამოიყენეთ @@ima_wiz_j_steer@@."


	key[]: "wiz_cfg_pedals_button_arcade"
	val[]: "წინსვლისთვის გამოიყენეთ @@imm_wiz_dforward@@, უკუსვლისთვის კი @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_arcade"
	val[]: "წინსვლისთვის წინ მისწიეთ @@ima_wiz_j_throttle@@, უკუსვლისთვის კი – უკან."

	key[]: "wiz_cfg_pedals_daxis_arcade"
	val[]: "წინსვლისთვის გამოიყენეთ @@ima_wiz_j_throttle@@, უკუსვლისთვის კი @@ima_wiz_j_brake@@."


	key[]: "wiz_cfg_pedals_button_complex"
	val[]: "დასაძრავად გამოიყენეთ @@imm_wiz_dforward@@, დასამუხრუჭებლად კი @@imm_wiz_dbackward@@."

	key[]: "wiz_cfg_pedals_saxis_complex"
	val[]: "წინსვლის ასაჩქარებლად წინ მისწიეთ @@ima_wiz_j_throttle@@, ხოლო გასაჩერებლად – უკან."

	key[]: "wiz_cfg_pedals_daxis_complex"
	val[]: "ასაჩქარებლად გამოიყენეთ @@ima_wiz_j_throttle@@, ხოლო გასაჩერებლად @@ima_wiz_j_brake@@."


	key[]: "wiz_cfg_gb_arcade"
	val[]: ""

	key[]: "wiz_cfg_gb_automatic_buttons"
	val[]: "სიჩქარის წინ გადასართველად @@imv_wiz_gearup@@ დააჭირეთ ხოლო უკან გადასართველად @@imv_wiz_geardown@@."

	key[]: "wiz_cfg_gb_automatic_positions"
	val[]: "წინსვლისთვის გამოიყენეთ @@imv_wiz_gearup@@, უკუსვლისთვის კი @@imv_wiz_geardown@@ კლავიატურით ან ღილაკებიან სამართავით სარგებლობისას. ხოლო თუ მექანიკური ბერკეტი გაქვთ, მოძრაობის მიმართულების ასარჩევად გამოგადგებათ @@imv_wiz_drive@@ და @@imv_wiz_reverse@@."

	key[]: "wiz_cfg_gb_manual"
	val[]: "სიჩქარის გადასართველად გამოიყენეთ @@imv_wiz_gearup@@ და @@imv_wiz_geardown@@."

	key[]: "wiz_cfg_gb_direct"
	val[]: "სასურველი სიჩქარის ასარჩევად ბერკეტიან კოლოფთან ერთად გამოიყენეთ @@ima_wiz_j_clutch@@."
#@}

#+ Axis setup page
#@{
	key[]: "setup_axes"
	val[]: "სამართავი ღერძების გაწყობა" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "wiz_setup_axes_desc_title"
	val[]: "ღერძების გამოსახულება"

	key[]: "wiz_setup_axes_desc"
	val[]: "მოსინჯეთ სამართავი ღერძების მუშაობა ეკრანზე. აამოქმედეთ და დააკვირდით მოძრავ ზოლებს. ზოლები გიჩვენებთ ზღვარს, გაშუალებას, მიმართულებასა და თითოეული სამართავის მოქმედების შედეგს."

	key[]: "wiz_setup_axes_desc2_title"
	val[]: "ღერძების გამართვა"

	key[]: "wiz_setup_axes_desc2"
	val[]: "სამართავი ღერძის ასარჩევად დაწკაპეთ მისი სახელის გვერდით ღილაკს. გადახვალთ შეტანის რეჟიმში. შემდეგ გამოიყენეთ თქვენი სამართავი."

	key[]: "wiz_setup_axes_desc3_title"
	val[]: "მგრძნობელობის ზღვარი"

	key[]: "wiz_setup_axes_desc3"
	val[]: "მგრძნობელობის ზღვარი ეწოდება არეს, რომელიც უნდა გადაილახოს სამართავის მოქმედების აღსაქმელად. თუ გსურთ შეცვლა, გადასწიეთ სრიალა. რაც მეტად გასწევთ მარჯვნივ, მით უფრო გაიზრდება გადასალახი ზღვარი. გამოსადეგია მოძველებული სამართავებისთვის, გაზრდილი ზღვარით აირიდებთ ცვეთის გამო შემთხვევით ან არაზუსტ ამოძრავებას თამაშში."

	key[]: "wiz_setup_axes_desc4_title"
	val[]: "ღერძების რეჟიმი"

	key[]: "wiz_setup_axes_desc4"
	val[]: "სამართავი ღერძის რეჟიმი განსაზღვრავს, როგორ იმოქმედებს თამაშში. შებრუნებული საჭე მარჯვნივ მოტრიალებისას თამაშში მარცხნივ მოუხვევს. გაშუალებული კი ნიშნავს, რომ საწყისი მდებარეობა სამოძრაო არის შუაში ექნება, მაგალითად, როგორც სახელურიან ჯოისტიკზეა. ამ პარამეტრის შეცვლა მაშინაა საჭირო, როცა სამართავს არასწორად აღიქვამს თამაში."

	key[]: "normal"
	val[]: "ჩვეულებრივი" #+ Normal orientation of axis. Increasing value of axis in <-1;1> range increases controlled value.

	key[]: "inverted"
	val[]: "შებრუნებული" #+ Inverted orientation of axis. Decreasing value of axis in <-1;1> range increases controlled value.

	key[]: "centered"
	val[]: "გაშუალებული" #+ Normal orientation of axis. Increasing value of axis in <0;1> increases controlled value.

	key[]: "inverted_centered"
	val[]: "შებრუნებული და გაშუალებული" #+ Inverted orientation of axis. Decreasing value of axis in <-1;0> range increases controlled value.
#@}

#+ Automatic gearbox setup page
#@{
	key[]: "automatic_gb_setup"
	val[]: "ავტომატურ გადაცემათა გამართვა" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "automatic_gb_setup_desc"
	val[]: "ავტომატური გად. კოლოფით სარგებლობისას გადართვა გიწევთ მხოლოდ წინსვლის, დგომისა და  უკუსვლისას. ამისთვის უნდა გამოიყენოთ მითითებული კლავიშები. შესაცვლელად დააჭირეთ ღილაკს და შემდეგ იმ კლავიშს, რომლის გამოყენებაც გსურთ."

	key[]: "automatic_gb_setup_desc2"
	val[]: "თუ მიერთებული გაქვთ ბერკეტიანი სიჩქარეთა გადამრთველი, შეგიძლიათ გამოიყენოთ ნამდვილი ავტომატური კოლოფის მსგავსად. ჩართეთ ეს პარამეტრი, შემდეგ კი ბერკეტის გადაწევით გადადით წინსვლისა და უკუსვლის რეჟიმებში. ბერკეტის ნებისმიერ სხვა სიჩქარეში ჩაგდებით კი განეიტრალდება. განკუთვნილია საგანგებოდ სიჩქარეთა ბერკეტიანი გადამრთველისთვის და არ იმუშავებს სხვა ღილაკებზე ან სახელურიან ჯოისტიკზე. მითითებულის შესაცვლელად დაწკაპეთ ამ ღილაკს, შემდეგ გადასწიეთ ბერკეტი სასურველ მდგომარეობაში და დააბრუნეთ ნეიტრალურში."
#@}

#+ Sequential gearbox setup page
#@{
	key[]: "sequential_gb_setup"
	val[]: "თანმიმდევრულ გადაცემათა გამართვა" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "sequential_gb_setup_desc"
	val[]: "თანმიმდევრული სიჩქარეთა გადამრთველით სარგებლობისას წინსვლის თითოეულ სიჩქარეში ცალ-ცალკე გიწევთ გადართვა, ასევე დგომისა და უკუსვლისას. ამისთვის უნდა გამოიყენოთ მითითებული კლავიშები მოცემული მიმდევრობით. შესაცვლელად დააჭირეთ ღილაკს და შემდეგ იმ კლავიშს, რომლის გამოყენებაც გსურთ."
#@}

#+ H-Shifter gearbox setup page
#@{
	key[]: "hshifter_gb_setup"
	val[]: "მექანიკურ გადაცემათა გამართვა" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "hshifter_gb_setup_desc"
	val[]: "აქ შეგიძლიათ აირჩიოთ ბერკეტიანი კოლოფის სახეობა და გამოცადოთ მისი შესაძლებლობები. სურათზე იხილავთ ბერკეტის მდებარეობას, თუ რომელ სიჩქარეშია ჩაგდებული. როცა მანქანის გადაცემათა კოლოფს მეტი სიჩქარე აქვს, თქვენს ბერკეტიან კოლოფთან შედარებით, დაგჭირდებათ გადამრთველი ღილაკების მითითება წყობის შესაცვლელად."

	key[]: "hshifter_gb_setup_desc2"
	val[]: "ბერკეტის მიმდინარე მდებარეობა და წყობის გადამრთველები გამოჩნდება ქვემოთაც მითითებული სამართავების გვერდით. სამართავის შესაცვლელად დააჭირეთ შესაბამის ღილაკს და გადასწიეთ ბერკეტი სასურველ მდებარეობაზე, შემდეგ კი დააბრუნეთ ნეიტრალურში."
#@}

