	key[]: "auto_motor_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "უზრუნველყოფს ძრავას მუხრუჭის ავტომატურად ამოქმედებას დამუხრუჭებისას."

	key[]: "auto_engine_start_op_tooltip" # - Gameplay, Advanced
	val[]: "როცა ჩართულია, ძრავა დაიქოქება დაძვრის მცდელობისთანავე."

	key[]: "auto_park_brake_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle's parking brake is applied by default (after using a ferry, towing to service, quick travelling, etc.)."

	key[]: "auto_drop_axles_op_tooltip" # - Gameplay, Advanced
	val[]: "თავისით განსაზღვრავს ღერძების აწევა/დაწევას, როცა საჭიროა მანქანის წონის შესაბამისად."

	key[]: "throttle_double_tap_op_tooltip" # - Gameplay, Advanced
	val[]: "როცა ჩართულია, მანქანა აჩქარდება ნელი სვლით ნაგულისხმევად. წინსვლის ღილაკზე ორჯერ სწარფი დაჭერით კი მანქანა აჩქარდება სრული სვლით  წინსვლის ღილაკის აშვებამდე.<br><br>იმუშავებს კლავიატურით სარგებლობისას მხოლოდ."

	key[]: "air_brake_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "სინამდვილის მსგავსად ჰაერი დაიცლება მუხრუჭის ზედმეტი გამოყენებისას.<br><br>როცა ჩართულია, მოგიწევთ გაითვალისწინოთ ჰაერის წნევა დაღმართზე დაშვებისას ან ნელა მოძრაობისას მუხჭურით სარგებლობისთვის."

	key[]: "fuel_consumption_simulation_op_tooltip" # - Gameplay, Advanced
	val[]: "როცა გამორთულია, საწვავის მოხმარება არ იქნება დამოკიდებული მართვის თავისებურებებზე ან გზის მდგომარეობაზე.<br><br>როცა ჩართულია, წვაზე იმოქმედებას არაერთი გარემოება, მათ შორის თავისებური მართვა, ტვირთის წონა, გორვის წინაღობა და გზის ზედაპირი. აღარ ექნება გავლენა უნარს @@skill_mechanical_title@@."

	key[]: "abs_op_tooltip" # - Gameplay, Advanced
	val[]: "როცა ჩართულია, ABS აირიდებს დამუხრუჭებისას ბორბლების სრულ გაჩერებას მართვის შესანარჩუნებლად შენელებისას."

	key[]: "traction_control_op_tooltip" # - Gameplay, Advanced
	val[]: "When enabled, the vehicle will apply per-wheel braking to prevent wheelspin, understeer or oversteer to help maintain control."

	key[]: "auto_diff_lock_op_tooltip" # - Gameplay, Advanced
