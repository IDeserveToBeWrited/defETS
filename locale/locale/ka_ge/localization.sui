#+ Tooltips.
#@{
	key[]: "controller_subtype_op_tooltip" # - Controls, Advanced
	val[]: "უთითებს სამართავის ქვესახეობას, რომ თამაშმა სწორად აღიქვას შეტანის შუალედები."

	key[]: "transmission_op_tooltip" # - Controls, Advanced
	val[]: "გადაცემის სახეობის ასარჩევი:<br>– „მარტივი ავტომატური“ საშუალებას იძლევა, დაიძრას და დამუხრუჭდეს წინ და უკან სამოძრაო ღილაკებით.<br>– „ნამდვილი ავტომატური“ საჭიროებს წინსვლის ან უკუსვლის გადაცემის წინასწარ არჩევას.<br>– „თანმიმდევრული“ გულისხმობს ყველა სიჩქარეში ხელით ჩაგდებას აწევა/დაწევის ღილაკებით.<br>– „სიჩქარის ბერკეტი“ კი გამოიყენება ისეთი სამართავის ქონისას, რომელსაც სიჩქარეთა კოლოფიც მოჰყვება."

	key[]: "adaptive_auto_transmission_op_tooltip" # - Controls, Advanced
	val[]: "ცვლის ავტომატური გადაცემის კოლოფის მოქმედებას:<br>– „დამზოგავი“ რეჟიმი დაბალ ბრუნზე გადართვას ამჯობინებს მაღალ მაბრუნ ძალას.<br>– „მძლავრი“ რეჟიმი კი უმაღლეს წერტილზე გადართავს მეტი ცხენის ძალის მისაღწევად უკეთესი სისწრაფისა და მძიმე ტვირთისას ან მთაგორიან ადგილებში გავლისას, ოღონდ საწვავის გაზრდილი მოხმარების ხარჯზე."

	key[]: "steer_sens_op_tooltip" # - Controls, Advanced
	val[]: "მოწყობილობის მოტრიალებისა და თამაშში მანქანის საჭის მოტრიალების სიდიდეთა ფარდობა."

	key[]: "steer_nonlin_op_tooltip" # - Controls, Advanced
	val[]: "შეტანის მოწყობილობასა და მანქანის საჭის მოტრიალებას შორის სხვაობა.<br><br>როცა მაღალია, საჭე ნაკლებად მორჩილია შუაში, ხოლო მეტად მგრძნობიარე ხდება ბოლომდე მოტრიალებისას. გამოსადეგია სწორ გზაზე სიარულისას გლუვად მოძრაობისთვის."

	key[]: "force_feedback_op_tooltip" # - Controls, Advanced
	val[]: "ჩართავს უკუქმედების ძალას მხარდაჭერილ სამართავებზე."

	key[]: "force_feedback_gain_op_tooltip" # - Controls, Advanced
	val[]: "უკუქმედების ძალის საერთოდ სიძლიერე 0N და 10N შუალედში.<br><br><color value=@@clr_txt_d@@>გაითვალისწინეთ, რომ ზედმეტად აწევისას მძლავრი საჭის შემთხვევაში შეიძლება დაიზიანოთ თითები ან ხელები."

	key[]: "force_feedback_centering_high_speed_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the centring force when driving at high speed, which peaks at 90 km/h (56 mph) and above.<br><br>The minimum setting will result in no wheel centring force."

	key[]: "force_feedback_centering_low_speed_op_tooltip" # - Controls, Advanced
	val[]: "Adjusts the centring force when driving at low speed.<br><br>The minimum setting will result in no wheel centring force."

	key[]: "force_feedback_internal_friction_op_tooltip" # - Controls, Advanced
	val[]: "შიდა ხახუნის სიდიდე გამოწვეული საჭის მექანიკური ნაწილების მოძრაობით."

	key[]: "force_feedback_engine_op_tooltip" # - Controls, Advanced
	val[]: "განსაზღვრავს ძრავის ხელოვნურ რხევაზე აყოლის შეგრძნების სიდიდეს საჭის ღერძიდან.<br><br><color value=@@clr_txt_d@@>გაითვალისწინეთ, როცა მნიშვნელობა აჭარბებს 15%-ს, იწვევს მეტისმეტ რყევასა და რხევას ზოგიერთ საჭეზე."

	key[]: "force_feedback_surface_op_tooltip" # - Controls, Advanced
	val[]: "განსაზღვრავს გზის ზედაპირის შეგრძნების ძალას საჭის ღერძიდან.<br><br><color value=@@clr_txt_d@@>გაითვალისწინეთ, როცა მნიშვნელობა აჭარბებს 20%-ს, იწვევს მეტისმეტ რყევასა და რხევას ზოგიერთ საჭეზე უწსორწმასწორო გზაზე ჩქარი სიარულისას."

	key[]: "force_feedback_bumps_op_tooltip" # - Controls, Advanced
	val[]: "განსაზღვრავს გზის უსწორმასწორობის შეგრძნების ძალას საჭის ღერძიდან."

	key[]: "force_feedback_collisions_op_tooltip" # - Controls, Advanced
	val[]: "განსაზღვრავს შეჯახების შეგრძნების ძალას საჭის ღერძიდან."

	key[]: "force_feedback_gearbox_grind_op_tooltip" # - Controls, Advanced
	val[]: "ცვლის სიჩქარეთა კოლოფიდან გამოცემული ხრჭიალის დონეს."

	key[]: "force_feedback_understeer_op_tooltip" # - Controls, Advanced
	val[]: "ცვლის მდორედ მოხვევისას მოცურების შეგრძნების დონეს."

