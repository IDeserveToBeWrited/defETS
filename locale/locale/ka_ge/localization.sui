#+ Dependency missing dialog related texts.
#@{
	key[]: "missing_required_dlc"
	val[]: "აკლია საჭირო კრებული (თამაშის ოფიციალური გაფართოება) $DEPENDENCY_NAME$. შენახული თამაშის სათანადოდ მუშაობისთვის, აუცილებელია ამ კრებულის დაყენება და ამოქმედება. უნდა მოაგვაროთ აღნიშნული საკითხი, თამაშის ჩასატვირთად." #+ Information showed when dependency of type required dlc is missing. Player is then unable to continue loading the game.

	key[]: "missing_removable_dlc"
	val[]: "აკლია არასავალდებულო კრებული (თამაშის ოფიციალური გაფართოება) $DEPENDENCY_NAME$. განგებ თუ არ მოგიცილებიათ, შეამოწმეთ, ხომ ყველა კრებული ადგილზეა.<br><br>თუ არადა, თამაში მაინც ჩაიტვირთება, მაგრამ ზოგიერთი რამ, შესაძლოა დაიკარგოს." #+ Information showed when dependency of type optional DLC is missing.

	key[]: "missing_mod"
	val[]: "$DEPENDENCY_NAME$ აკლია ან გათიშულია. განგებ თუ არ გაგითიშავთ, გადაამოწმეთ, ხომ ყველა დანამატი ადგილზეა. თუ არადა, შეგიძლიათ მაინც განაგრძოთ ამ წერტილიდან. გაითვალისწინეთ, რომ ზოგი დანამატის ამოკლებამ შესაძლოა, ხელი შეუშალოს ჩატვირთვას ან სხვა ხარვეზები წარმოშვას." #+ Information displayed when dependency of type mod is missing.

	key[]: "incompatible_mod"
	val[]: "$DEPENDENCY_NAME$ შეუთავსებელია თამაშის ამ ვერსიასთან, ანუ დანამატი თავსებადია თამაშის მხოლოდ ზოგიერთ ვერსიასთან.<br><br>გადაწყვეტები:<br>- სცადეთ, იპოვოთ განახლებული დანამატი, ამ ვერსიასთან თავსებადი.<br>- თავად თამაში განაახლეთ ან წინა ვერსიაზე გადაიყვანეთ.<br><br> თუ არადა, შეგიძლიათ მაინც სცადოთ ჩატვირთვა. თუმცა გაითვალისწინეთ, რომ ვინაიდან დანამატი არ იტვირთება, შესაძლოა, ხელი შეუშალოს თამაშის ჩატვირთვასაც ან სხვა ხარვეზები წარმოშვას." #+ Information displayed when dependency of type mod is incompatible with the version of the game currently used by player.

	key[]: "missing_dependencies_t"
	val[]: "ამოკლებული საჭირო დანამატები" #+ The missing dependencies dialog title.

	key[]: "details_t"
	val[]: "ვრცლად" #+ The missing dependency details dialog title.

	key[]: "open_workshop_page"
	val[]: "სახელოსნოს გვერდის გახსნა"  #+ Button text. Open Steam Workshop page of the missing Workshop mod.

	key[]: "missing_dependencies_info"
	val[]: "თამაშის ამ წერტილიდან ჩასატვირთად საჭიროა დამატება ან კრებული, რომელიც აკლია. მოცემული იქნება ქვემოთ. სიიდან მონიშვნისას თითოეულის შესახებ იხილავთ ვრცლად." #+ The info about the missing dependencies dialog.

	key[]: "missing_dependencies_fatal_error"
	val[]: "თამაშს აკლია სულ მცირე ერთი დამატება ან გადმოსაწერი კრებული. ჩატვირთამდე საჭიროა ამის მოგვარება." #+ Info shown if the continue operation is blocked because the save depends on some required dlc (e.g. map or vehicle)

