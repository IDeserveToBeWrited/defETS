	val[]: "ცვლის გარჩევადობას თამაშში."

	key[]: "refresh_rate_op_tooltip" # - Graphics, Advanced
	val[]: "ცვლის კადრის სასურველ სიხშირეს თამაშში."

	key[]: "vsync_op_tooltip" # - Graphics, Advanced
	val[]: "ამთხვევს კადრის სიხშირესა და მონიტორის ჩვენების სიხშირეს, რომ აირიდოს გამოსახულების დანაწევრება. დამზოგავის მითითება კი ანახევრებს კადრსიხშირეს კვების ნაკლებად მოხმარებისთვის."

	key[]: "fps_limit_op_tooltip" # - Graphics, Advanced
	val[]: "აწესებს კადრის სიხშირის ზედა ზღვარს თამაშში.<br><br> მითითებული 0 ნიშნავს შეზღუდვის მოხსნას."

	key[]: "fps_limit_inactive_op_tooltip" # - Graphics, Advanced
	val[]: "აწესებს კადრის სიხშირის ზედა ზღვარს თამაშში, როცა ჩაკეცილია.<br><br> მითითებული 0 ნიშნავს შეზღუდვის მოხსნას."

	key[]: "adv_graphical_settings_op_tooltip" # - Graphics, Simple
	val[]: "ცვლა გრაფიკის გამარტივებულ (მზა) პარამეტრებსა და დაწვრილებით პარამეტრებს შორის (თითოეული მნიშვნელობის ცალ-ცალკე შეცვლის შესაძლებლობით)."

	key[]: "scaling_op_tooltip" # - Graphics, Advanced
	val[]: "აუმჯობესებს გამოსახულებას თამაშის უფრო მაღალი გარჩევდობის მითითებით, რაც აგლუვებს დაკბილულ კიდეებს და ზრდის სიმკვეთრეს.<br> მაგალითად, ზომაცვლის გაზრდისას გამოსახულება მეტად მკაფიო და ნაკლებად ბუნდოვანია, რის შედეგადაც თამაში გაცილებით უკეთ გამოიყურება, ოღონდ დატვირთვის ზრდის ხარჯზე.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, დიდი გავლენა აქვს წარმადობაზე."

	key[]: "aa_mode_op_tooltip" # - Graphics, Advanced
	val[]: "დაკბილვის ასარიდებელი მაღალსიჩქარიანი საშულებების არჩევა უსწორმასწორო კიდეების დასაგლუვებლად:<br>- SMAA შეარჩევს თითოეულ პიქსელს რამდენჯერმე (მითითებული ხარისხის მიხედვით) კადრის სხვადასხვა ადგილიდან და საშუალოს მიღებით ქმნის გამოსახულებას.<br>- TAA არჩევს თითოეულ პიქსელს თითო კადრიდან, ოღონდ სხვადასხვა ადგილიდან ყოველ კადრში.<br>- საუკეთესო შედეგისთვის ორივეს შეთავსებაც შეგიძლიათ, მაგრამ მეტი დატვირთვის ხარჯზე.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "ssao_mode_op_tooltip" # - Graphics, Advanced
	val[]: "ამატებს გლუვ ჩრდილებს ნაპრალებსა და ერთმანეთთან ახლომდებარე საგნებს შორის, რითაც უმჯობესდება გამოსახულება და უკეთ გარჩევადი ხდება თამაშის მთლიანი სამყარო.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "taa_tuning_op_tooltip" # - Graphics, Advanced
	val[]: "მზა TAA-გამართვის ასარჩევი:<br>– „მუდამ ბუნდოვანი“ უზრუნველყოფს ნაკლებ ციმციმს მეტად დაგლუვებით – გამოსადეგია კომპიუტერზე მომატებული გარჩევადობით ან მაღალი გარჩევადობის ეკრანებზე, აგრეთვე მისაღებია 1080p ტელევიზორზეც ეკრანისგან დაშორებულად ჯდომისას.<br>– „მუდამ მკაფიო“ გულისხმობს მეტ ციმციმს ნაკლები დაგლუვებით — შესაფერისია ეკრანისთვის გარჩევადობით 1080p ან უფრო დაბალი, როცა გამოიყენება ლეპტოპი ან Steam Deck.<br>– „ცვალებადი სიმკვეთრე“ კი ეცდება დროდადრო გათიშოს TAA კამერის უძრაობისას თრთოლის ასარიდებლად.<br><br><color value=@@clr_txt_d@@>ეს პარამეტრი ხელმისაწვდომია მხოლოდ მაშინ, როცა დაკბილვის არიდებისთვის მითითებულია TAA."

	key[]: "taa_luma_sharpening_op_tooltip" # - Graphics, Advanced
	val[]: "მიუთითებს TAA-დაგლუვებისას მნათი ნაწილის გამკვეთრების სიმძლავრეს.<br><br><color value=@@clr_txt_d@@>ეს პარამეტრი ხელმისაწვდომია მხოლოდ მაშინ, როცა დაკბილვის არიდებისთვის მითითებულია TAA."

	key[]: "dof_op_tooltip" # - Graphics, Advanced
	val[]: "როცა ჩართულია, მოშორებული ადგილები ხელოვნურად გაბუნდოვანდება, რომ სინამდვილის მსგავსად უკეთ გამოიკვეთოს უკანა ხედი."

	key[]: "sunshaft_op_tooltip" # - Graphics, Advanced
	val[]: "როცა ჩართულია, სინათლის სხივები ხილული იქნება მზისკენ გახედვისას ან ხეებს, შენობებსა და მანქანებს შორის შუქის გავლისას."

	key[]: "color_enhancement_op_tooltip" # - Graphics, Advanced
	val[]: "როცა ჩართულია, თამაშის ფერები შეიცვლება უფრო ლამაზად გამოსახვისთვის. გათვალისწინებული იქნება დღის მონაკვეთი და ამინდი, აგრეთვე, მანქანებისა თუ სხვა საგანთა ფერები მეტად ხასხასა იქნება."

	key[]: "reflection_scaling_op_tooltip" # - Graphics, Advanced
	val[]: "აუმჯობესებს ანარეკლებს უფრო მაღალხარისხიანად გამოსახვით, აგრეთვე კიდეების უკეთესად დაგლუვებით.<br><br><color value=@@clr_txt_d@@>ამ პარამეტრის ცვლილება აისახება მხოლოდ თამაშის ხელახლა ჩართვის შემდეგ."

	key[]: "refl_detail_op_tooltip" # - Graphics, Advanced
	val[]: "Adjusts the detail of reflections seen on vehicle surfaces, windows and other reflective surfaces such as puddles, wet roads and open bodies of water.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance.<br><br>Changes to this setting will take effect only after a manual restart of the game."

	key[]: "veget_detail_op_tooltip" # - Graphics, Advanced
	val[]: "ხეებისა და მცენარეთა გამოსახულების სიზუსტე და სირთულე.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "grass_detail_op_tooltip" # - Graphics, Advanced
	val[]: "გზის გვერდზე ბალახის სიმჭიდროვე.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "shadow_quality_op_tooltip" # - Graphics, Advanced
	val[]: "ჩრდილის ხარისხი მზისა და მთვარის შუქზე.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "far_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "Enables shadows to be rendered even from very far objects.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance."

	key[]: "interior_shadow_op_tooltip" # - Graphics, Advanced
	val[]: "ცვალებადი ჩრდილები მანქანის სალონში ღამის საათებში.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "weather_quality_op_tooltip" # - Graphics, Advanced
	val[]: "ამინდის ხარისხის მითითება, მათ შორის ანარეკლისას."

	key[]: "mirror_quality_op_tooltip" # - Graphics, Advanced
	val[]: "ანარეკლების ხარისხის მითითება მანქანის სარკეებისთვის (დამოუკიდებლად არეკვლის პარამეტრებისგან).<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "mirror_resolution_op_tooltip" # - Graphics, Advanced
	val[]: "მანქანის სარკეებში გამოსახულების გარჩევადობის მორგება."

	key[]: "mirror_distance_op_tooltip" # - Graphics, Advanced
	val[]: "დაშორება, რომლიდანაც გამოსახულება ჩნდება სარკეში.<br><br><color value=@@clr_txt_d@@>ჩვეულებრივ, საშუალო გავლენა აქვს წარმადობაზე."

	key[]: "texture_quality_op_tooltip" # - Graphics, Advanced
	val[]: "განსაზღვრავს გარკვეული ზედაპირების გამოსახვის ხარისხს საგნებზე თამაშში."

	key[]: "anisotrop_op_tooltip" # - Graphics, Advanced
	val[]: "აუმჯობესებს ზედაპირების მკაფიოდ ჩვენებას განსაკუთრებით შორი ან დახრილი კუთხით ხედვისას.<br><br><color value=@@clr_txt_d@@>ამ პარამეტრის ცვლილება აისახება მხოლოდ თამაშის ხელახლა ჩართვის შემდეგ."

	key[]: "normal_maps_op_tooltip" # - Graphics, Advanced
	val[]: "Adds the appearance of geometric detail to pavements, roads and other objects to improve their appearance.<br><br><color value=@@clr_txt_d@@>This setting usually has a moderate impact on performance.<br><br>Changes to this setting will take effect only after a manual restart of the game."

