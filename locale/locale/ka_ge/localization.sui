	key[]: "link_locked_msg_external_market" # - tooltip for when the external market is not yet unlocked
	val[]: "გარე ბაზართან წვდომისთვის ჯერ უნდა შეიძინოთ თქვენი პირველი მისაბმელი და World of Trucks დაკავშირებული უნდა გქონდეთ თქვენს პროფილთან."

	key[]: "world_map_desc" # - tooltip for explaining what the world map is - feature is active
	val[]: "იხილეთ მსოფლიო რუკა, უკვე მოვლილი მხარეები და ამჟამად გასავლელი გზის მონაკვეთები ან მონიშნეთ ახალი. "

	key[]: "quick_travel_desc" # - tooltip for explaining what the quick travel is - feature is active
	val[]: "სწრაფი გადასვლა უკვე მონახულებულ ქალაქში გარკვეულ ფასად."

	key[]: "convoy_sessions_desc" # - tooltip for explaining what the Convoy Lobby (searching and creating sessions) is - feature is active
	val[]: "გადახედეთ, მოიძიეთ და გამოარჩიეთ ქსელში შეკრების სესიები, რომ შეუერთდეთ ან შექმნათ საკუთარი და უმასპინძლოთ სხვებს."

	key[]: "mail_desc" # - tooltip for explaining what mail is - feature is active
	val[]: "საფოსტო ყუთი წერილებისთვის სამიანობასთან, ბანკებთან ან დაქირავებულებთან დაკავშირებით."

