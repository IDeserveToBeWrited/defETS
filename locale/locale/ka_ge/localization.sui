#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_continue"
	val[]: "განაგრძეთ ($KEY$)" #+ Message box button.


	key[]: "intro_1"
	val[]: "მოგესალმებათ Euro Truck Simulator 2!"

	key[]: "intro_2"
	val[]: "როგორც იქნა შანსი გაქვთ იმუშაოთ საოცნებო სამსახურში - მართოთ სატვირთო!"

	key[]: "intro_3"
	val[]: "თქვენი კუთვნილი გადამზიდი კომპანია უკვე მზადაა საქმიანობისთვის, მაგრამ სამწუხაროდ არ გაქვთ ფული სატვირთოს შესაძენად. ჯერჯერობით, მოგიწევთ იმუშაოთ სხვა კომპანიებში, როგორც დაქირავებულმა მძღოლმა."

	key[]: "intro_4"
	val[]: "გევალებათ $JOB_CARGO$ მიიტანოთ $JOB_TARGET_COMPANY$ საწყობში, ქალაქი $JOB_TARGET_CITY$. დამქირავებელი მოგაწვდით სატვირთოს და დაფარავს ყველა ხარჯს. ეცადეთ, არ დააგვიანოთ."


	key[]: "intro_garage_1"
	val[]: "ესაა თქვენი სამმართველო."

	key[]: "intro_garage_2"
	val[]: "მეტად უბრალო ფარეხია, დიდი არაფერი, მაგრამ ეს მხოლოდ დასაწყისია."

	key[]: "intro_garage_3"
	val[]: "სამწუხაროდ, არაფერი გყავთ ფარეხში გასაჩერებლად, სწორედ ამიტომაა ირგვლივ სიცარიელე."

	key[]: "intro_garage_4"
	val[]: "მას შემდეგ, რაც საკმარისი ფული გექნებათ სატვირთოს შესაძენად, თავისუფლად შეგეძლებათ გადაადგილდეთ მსოფლიოში და აქედანვე აწარმოოთ საქმიანობა."

	key[]: "intro_garage_5"
	val[]: "გისურვებთ წარმატებას!"


	key[]: "desktop_tut_t"
	val[]: "შესაძლებლობა გაგეხსნათ"

	key[]: "desktop_tut_job"
	val[]: "მიიღეთ შემდეგი სამუშაო"

	key[]: "desktop_tut_cargo_market"
	val[]: "გამოიყენეთ თქვენი ახალთახალი მისაბმელი საქონლის გასაყიდ წერტილებთან წვდომისთვის მრავალი სახეობის ტვირთის დანიშნულების ადგილზე მისაწოდებლად." #+ The text of the bubble shown for the player when he has his own trailer attached first time letting him know that cargo market has been unlocked now.

	key[]: "desktop_tut_personal"
	val[]: "აქ იხილავთ თქვენს წინსვლას."

	key[]: "desktop_tut_company"
	val[]: "თვალი ადევნეთ თქვენს ფარეხებს, დაიქირავეთ მძღოლები და მართეთ კომპანია აქედან."

	key[]: "desktop_tut_trailers"
	val[]: "ამიერიდან უკვე შეგეძლებათ საკუთარი მისაბმელების შეძენა, გაუმჯობესება ან სატვირთოების შესაფერისად მოხატვა.<br><br>მისაბმელები განთავსდება შერჩეულ ფარეხ(ებ)ში; მათი მეშვეობით დასაქმებული მძღოლების შემოსავალი მოიმატებს. მათზე წვდომისთვის გამოიყენეთ მისაბმელის სამართავი არე."

	key[]: "desktop_tut_visit_directive"
	val[]: "იხილეთ $SCREEN_NAME$" #+ The $SCREEN_NAME$ text is a placeholder for different screen names in game and should be left intact

	key[]: "desktop_tut_vehicle_mode"
	val[]: "რეჟიმების ღილაკი სამუშაო ეკრანის რეჟიმებისა და მანქანის სახეობებს შორის გადასართავად."

	key[]: "desktop_tut_tour_welcome_t"
	val[]: "მოგესალმებით"

	key[]: "desktop_tut_tour_welcome"
