	val[]: "Failed to load the saved game."

	key[]: "load_game_desc"
	val[]: "წინა შენახულიდან გაგრძელება. ბოლო ცვლილებები დაიკარგება!" #+ Help message associated with load game icon.

	key[]: "load_progress_lost"
	val[]: "ნამდვილად გსურთ სხვა წერტილიდან ჩატვირთვა?<br><br>თქვენი მიმდინარე წინსვლა დაიკარგება."

	key[]: "load_progress_lost_mp"
	val[]: "ნამდვილად გსურთ სხვა შენახულიდან ჩატვირთვა?<br>მრავალმოთამაშიან რეჟიმში ეს იწვევს ხოლმე სამუშაოს გაუქმებას ან შეჩერებას, უახლოეს სახელოსნოში გადაყვანას ან შერჩეული სამუშაოს უქმად ქცევას.<br><br>თქვენი მიმდინარე წინსვლა დაიკარგება, თუ წინასწარ არ გექნებათ შენახული."

	key[]: "load_game_mp_suspended_job"
	val[]: "შენახულიდან წარმატებით ჩაიტვირთა, მაგრამ თქვენი მოქმედი სამუშაო, რომელსაც აღრიცხავს, World of Trucks, ამ სესიაზე მიუწვდომელია."

	key[]: "autosave"
	val[]: "- თვითშენახული -" #+ Name used inside slot corresponding to automatically saved game.

	key[]: "quicksave"
	val[]: "- სწრაფი შენახვით -" #+ Name used inside slot corresponding to a quick saved game.

