#+ Options/Control
#+
#+ Screen used to configure input related to game controllers (axes, force feedback,..)
#@{

	key[]: "controller_t"
	val[]: "მართვა" #+ Title of the screen. Please keep in upper case where possible.

	key[]: "controller_bindings_t"
	val[]: "შერჩეულები" #+ Subtitle of the screen with controller bindings. Please keep in upper case where possible.

	key[]: "controller_advanced_t"
	val[]: "დამატებით გამართვა" #+ Subtitle of the screen with controller advanced setup. Please keep in upper case where possible.

	key[]: "controller"
	val[]: "ღილაკები" #+ Icon opening the controls options window. There is limited space allowing for two lines of 7 'W' characters each.

	key[]: "input_type_settings_t"
	val[]: "შეტანის სახეობა" #+ Title of the 'Input type' settings section. Please keep in upper case where possible.

	key[]: "controller_settings_t"
	val[]: "სამართავი" #+ Title of the 'Controller' settings section. Please keep in upper case where possible.

	key[]: "controller_feedback_settings_t"
	val[]: "სამართავის უკუქმედება" #+ Title of the 'Controller feedback' settings section. Please keep in upper case where possible.

	key[]: "controller_axes_settings_t"
	val[]: "სამართავი ღერძები" #+ Title of the 'Controller axes' settings section. Please keep in upper case where possible.

#+ Driving method
#@{

	key[]: "keyboard_only"
	val[]: "მხოლოდ კლავიატურა" #+ Driving using keyboard steering.

	key[]: "keyboard"
	val[]: "კლავიატურა" #+ Keyboard used in combination with another input device. For example "Keyboard + Logitech ...."

	key[]: "mouse"
	val[]: "მოხვევა თაგვით" #+ Mouse based steering. For example "Keyboard + Mouse Steering".

	key[]: "mouse_full"
	val[]: "თაგვით მართვა სატერფულებიანად" #+ Mouse based steering and pedals. For example "Keyboard + Mouse Steering including pedals".

	key[]: "none"
	val[]: "არცერთი" #+ Used to indicate that nothing was selected in controller slot "+ None"
#@}

#+ Quick setup for Gamepads & Controllers

	key[]: "quick_controller_setup"
	val[]: "ჯოისტიკის ან საჭის სწრაფი გამართვა"

#+ Selection of the controller subtype
#@{

	key[]: "controller_subtype"
	val[]: "სამართავის ნაირსახეობა" #+ Label of the line.

	key[]: "steer_absolute"
	val[]: "საჭე" #+ Driving wheel like device. Position of the wheel corresponds directly to position of the vehicle wheels.

	key[]: "steer_relative"
	val[]: "გეიმპადი, ჯოისტიკი" #+ Gamepad like device. Value of the input controls speed of turning of the vehicle wheels.
#@}


	key[]: "steer_sens"
	val[]: "საჭის მგრძნობელობა"

	key[]: "steer_nonlin"
	val[]: "საჭის არაწრფივობა"

#+ Force feedback setup
#@{

	key[]: "force_feedback"
	val[]: "საჭის წინაღობა" #+ Checkbox enabling force feedback.

	key[]: "force_feedback_reset"
	val[]: "საწყისზე დაბრუნება" #+ Button for resetting force feedback settings to defaults.

	key[]: "force_feedback_gain"
	val[]: "საერთო სიძლიერე" #+ Slider controlling global strength of the force feedback.

	key[]: "force_feedback_centering_high_speed"
	val[]: "შუაში გასწორება მაღალ სიჩქარეზე" #+ Slider controlling strength of the force feedback centring at high speeds.

	key[]: "force_feedback_centering_low_speed"
	val[]: "შუაში გასწორება დაბალ სიჩქარეზე" #+ Slider controlling strength of the force feedback centring at low speeds.

	key[]: "force_feedback_internal_friction"
	val[]: "შიდა ხახუნი" #+ Slider controlling strength of the force feedback internal steering system friction force.

	key[]: "force_feedback_engine"
	val[]: "ძრავას რხევის აყოლა" #+ Slider controlling strength of the force feedback from engine resonance.

	key[]: "force_feedback_surface"
	val[]: "უსწორმასწორო ზედაპირი" #+ Slider controlling strength of the force feedback from terrain surface.

	key[]: "force_feedback_bumps"
	val[]: "დარტყმები" #+ Slider controlling strength of the force feedback from the bumps to the suspension.

	key[]: "force_feedback_collisions"
	val[]: "შეჯახების შეგრძნება" #+ Slider controlling strength of the force feedback when colliding with other objects.

	key[]: "force_feedback_gearbox_grind"
	val[]: "ხრჭიალით ჩაგდება სიჩქარეში" #+ Slider controlling strength of the force feedback when gear can not be engaged during manual shifting.

	key[]: "force_feedback_understeer"
	val[]: "წინა თვლებით მოსრიალება" #+ Slider controlling strength of the force feedback when vehicle is understeering.

	key[]: "force_feedback_assisted_steering"
	val[]: "მოხვევის ხელშემწყობი" #+ Slider controlling strength of the force feedback when lane assistant is active.

	key[]: "force_feedback_vibration_surface"
	val[]: "უსწორმასწორობისას რყევა" #+ Slider controlling strength of the force feedback vibration from terrain surface.

	key[]: "force_feedback_vibration_bumps"
	val[]: "საკიდარით გამოწვეული რყევა" #+ Slider controlling strength of the force feedback vibration from the bumps to the suspension.

	key[]: "force_feedback_vibration_collisions"
	val[]: "შეჯახებით გამოწვეული რყევა" #+ Slider controlling strength of the force feedback vibration when colliding with other objects.

	key[]: "ffb_lut_usage_hint"
	val[]: "თამაში საჭის წინაღობისთვის იყენებს განსაზღვრულ საძიებო ცხრილს (LUT), რომლის მხარდაჭერაც მიუწვდომელია. ხარვეზების შემთხვევაში სცადეთ ცხრილის ფაილის მოცილება მომხმარებლის პროფილის საქაღალდიდან!" #+ Hint telling player that the game is using custom force feedback LUT loaded from profile folder and to remove it in case of problems.
#@}

