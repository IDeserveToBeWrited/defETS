	val[]: "თვითშენახულების გამოჩენა" #+ Description of checkbox allowing user to enable display of automatically generated saves.

	key[]: "no_manual_saves"
	val[]: "ხელით შენახულები არაა." #+ Shown when no saves are found.

	key[]: "load"
	val[]: "ჩატვირთვა" #+ Button triggering load.

	key[]: "incompatible_save_upgrade"
	val[]: "<color value=@@clr_sel@@>არათავსებადია შენახული თამაში!<br><color value=@@clr_txt@@>სცადეთ უახლეს ვერსიამდე განახლება." #+ Warning shown when save has unknown version.

	key[]: "failed_to_acquire_saves"
	val[]: "ვერ მოხერხდა ჩატვირთვა და ჩვენება ყველა შენახვის ფაილისა ამ პროფილისთვის." #+ shown on the save/load screen if the save manager fails to return all saves for the selected profile

#+ Notification shown in the side panel when the load slot selection window appears automatically
#@{
	key[]: "attention_t"
	val[]: "ყურადღება!" #+ Panel title. Please keep in upper case where possible.

	key[]: "load_msg_load_error"
	val[]: "<color value=@@clr_red@@>შეცდომა ჩატვირთვისას.<color value=@@clr_txt@@><br><br>შეგიძლიათ სცადოთ გამოსწორება ქვემოთ მოცემული მითითებებით ან დაიწყოთ სხვა წერტილიდან.<br><br>მიზეზი, შესაძლოა იყოს:<br><br>1. შენახვისას გამოყენებული დანამატი დაზიანებული ან შეუთავსებელია თამაშის ამ ვერსიასთან.<br><br>2. შენახვისას გამოყენებული დანამატი წაშლილი ან გათიშულია.<br><br>3. არასწორად შექმნილმა დანამატმა დააზიანა შენახვის წერტილი.<br><br>4. შენახვისას უეცარმა გათიშვამ დააზიანა შენახვის წერტილი."

	key[]: "load_msg_missing_mod"
	val[]: "<color value=@@clr_sel@@>რომელიღაც დანამატი აკლია.<color value=@@clr_txt@@><br><br>ბოლო შენახვის წერტილიდან ზოგი დანამატი წაშლილი ან გათიშულია.<br><br>თავად თუ არ გაგითიშავთ, გადაამოწმეთ, ხომ ყველა დანამატი ადგილზეა.<br><br>თუ არადა, შეგიძლიათ მაინც განაგრძოთ ამ წერტილიდან. ოღონდ გაითვალისწინეთ, რომ ცალკეული დანამატის მოკლებამ შესაძლოა, ხელი შეუშალოს ჩატვირთვას ან სხვა ხარვეზები წარმოშვას.<br><br>გარდა ამისა, შეგიძლიათ ისეთი წერტილიდანაც განაგრძოთ, რომელიც ამ დანამატს არ შეიცავს."

	key[]: "load_msg_missing_rem_dlc"
	val[]: "<color value=@@clr_sel@@>რომელიღაც კრებული აკლია.<color value=@@clr_txt@@><br><br>ბოლო შენახვის წერტილი საჭიროებს შიგთავსს დაკარგული კრებულიდან (თამაშის გაფართოება).<br><br>განგებ თუ არ მოგიცილებიათ, გთხოვთ გადაამოწმოთ, ხომ ყველა კრებული ადგილზეა.<br><br>თუ არადა, მაინც შეძლებთ ამ წერტილიდან ჩატვირთვას, ოღონდ გაითვალისწინეთ, რომ კრებულ(ებ)ის შიგთავსი დააკლდება.<br><br>გარდა ამისა, შეგიძლიათ ისეთი წერტილიდან განაგრძოთ, რომელიც არ იქნება დამოკიდებული ამ კრებულ(ებ)ზე."

	key[]: "load_msg_missing_dlc"
	val[]: "<color value=@@clr_red@@>რომელიღაც არასავალდებულო კრებული აკლია.<color value=@@clr_txt@@><br><br>ბოლო შენახვის წერტილი საჭიროებს შიგთავსს დაკარგული კრებულიდან (თამაშის გაფართოება).<br><br>სათანადოდ რომ განაგრძოთ ამ წერტილიდან თამაში, საჭიროა კრებული ჩაყენებული და ამოქმედებული გქონდეთ კომპიუტერში.<br><br>გარდა ამისა, შეგიძლიათ ისეთი წერტილიდანაც განაგრძოთ, რომელიც არ იქნება ამ კრებულზე დამოკიდებული."

	key[]: "load_msg_mod_dlc_dep"
	val[]: "<color value=@@clr_red@@>დანამატი ეფუძნება გადმოსაწერ კრებულს,<color value=@@clr_txt@@><br><br>ერთ-ერთი დანამატი საჭიროებს კრებულს (თამაშის ოფიციალურ გაფართოებას), რომელიც ამჟამად არ აყენია.<br><br>საჭიროა გათიშოთ დანამატი ან გადმოწეროთ და დააყენოთ კრებული, რომელზეც დამოკიდებულია ეს დანამატი."

	key[]: "load_msg_crash"
	val[]: "<color value=@@clr_red@@>შეცდომა ჩატვირთვისას.<color value=@@clr_txt@@><br><br>შეგიძლიათ სცადოთ გამოსწორება ქვემოთ მოცემული მითითებებით ან დაიწყოთ სხვა წერტილიდან.<br><br>მიზეზი, შესაძლოა იყოს:<br><br>1. შენახვისას გამოყენებული დანამატი დაზიანებული ან შეუთავსებელია თამაშის ამ ვერსიასთან.<br><br>2. შენახვისას გამოყენებული დანამატი წაშლილი ან გათიშულია.<br><br>3. არასწორად შექმნილმა დანამატმა დააზიანა შენახვის წერტილი.<br><br>4. აპარატურის ან პროგრამული დრაივერის გაუმართაობამ გამოიწვია თამაშის უეცარი გათიშვა."

	key[]: "mods_detected_warning"
	val[]: "გამოვლენილია თამაშის დანამატები. გაითვალისწინეთ, რომ გაუმართავი, მოძველებული ან არათავსებადი დანამატი არამდგრადობის გამომწვევია. გადასამოწმებლად გადადით დანამატების სამართავზე." #+ The warning showed in case game crashed and user has some mods installed - right above the button that opens mod manager.
#@}
#@}

