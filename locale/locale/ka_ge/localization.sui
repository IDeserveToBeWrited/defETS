# shown in job detail widget and pause screen
	key[]: "job_eta"
	val[]: "Estimated Arrival"

	key[]: "job_delay"
	val[]: "Delay"

# mandatory break needed window shown when changing vehicle mode
	key[]: "time_skip_mandatory_break_t"
	val[]: "MANDATORY REST NEEDED"

	key[]: "time_skip_mandatory_break_needed"
	val[]: "The vehicle hasn’t been parked long enough to complete your mandatory rest.<br><br><color value=@@clr_sel@@>$TIME$ of mandatory break left<br><br><color value=@@clr_txt@@>Do you want to rest?"

# mandatory break notifications
	key[]: "mandatory_break_soon"
	val[]: "It’s time to take your mandatory break.<br>You should find a parking spot and rest!"

	key[]: "mandatory_break_overdue"
	val[]: "Exceeded driving time without mandatory break.<br>You should find a parking spot and rest!"

	key[]: "offence_mandatory_break"
	val[]: "Violation of mandatory break."

# shown in options

	key[]: "mandatory_break_simulation"
	val[]: "Mandatory Break simulation"

	key[]: "mandatory_break_simulation_op_tooltip"
	val[]: "When enabled, you must take regular breaks from driving.<br><br>Avoiding mandatory breaks will result in traffic offences."

	key[]: "rest_state_simulation"
	val[]: "Rest State simulation"

	key[]: "rest_state_simulation_op_tooltip"
	val[]: "When enabled, you will experience the effects of fatigue over time.<br><br>You will need to rest to recover."
#@}
