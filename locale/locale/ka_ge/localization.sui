	val[]: "სამართავი მოწყობილობა საჭეა ან მსგავსად მოქმედებს. მოწყობილობის მოძრაობით პირდაპირ აისახება თამაშში საჭის მდგომარეობა."

	key[]: "wiz_control_gamepad_or_joy"
	val[]: "ღილაკებიანი ან სახელურიანი ჯოისტიკია. მოწყობილობის მოძრაობით აისახება თამაშში საჭის ბრუნვის სიჩქარე."
#@}

#@}

#+ Gearbox type selection page
#@{


	key[]: "select_gearbox_type"
	val[]: "სიჩქარეთა კოლოფის სახეობის არჩევა" #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_gb_simple"
	val[]: "Press FORWARD to move ahead, and press BACK to brake or reverse. The gearbox automatically manages everything else, handling transitions between driving, braking, and reversing, as well as selecting the appropriate gears."

	key[]: "wiz_gb_automatic"
	val[]: "Use the buttons to switch between driving forward, neutral, or reversing. Then press the accelerator and let the automatic transmission handle gear changes."

	key[]: "wiz_gb_sequential"
	val[]: "Manually shift gears up and down to select each individual gear within the transmission. This configuration provides full control over the vehicle’s gearbox."

	key[]: "wiz_gb_hshifter"
	val[]: "Select the desired gear directly. This offers the most realistic configuration. A physical H-pattern shifter is recommended and requires clutch input."
#@}

#+ Shown when feature requires a gamming controller.

	key[]: "controller_required"
	val[]: "ამ ფუნქციის გამოსაყენებლად საჭიროა საჭე ან ჯოისტიკი."

#+ Shown when the game did not found a known H-shifter compatible controller (G27, G25, Bodnar).

	key[]: "no_hw_hshifter"
	val[]: "სიჩქარეთა ბერკეტი არაა; ეს შესაძლებლობა გამოუსადეგარი იქნება."

#@}

#+ H-shifter layout selection page
#@{


	key[]: "select_hshifter_layout"
	val[]: "სიჩქარეთა განლაგების არჩევა"  #+ Title of the screen. Please keep in upper case where possible.

#+ Descriptions of individual choices.
#@{

	key[]: "wiz_hs_range"
	val[]: "მაჯგუფებელი მეტად იოლი გამოსაყენებელია. სიჩქარეებს აჯგუფებს ორ წყებად, პირველშია 1-6, მეორეში კი 7-12. ჯერ გადამრთველი ღილაკით აირჩევთ წყობას, შემდეგ კი ბერკეტით ჩააგდებთ შესაბამის სიჩქარეში."

	key[]: "wiz_hs_splitter"
	val[]: "მაცალკევებელიც მისი მარტივი შემცვლელია. სიჩქარეები აქაც ორ წყებადაა, ოღონდ დაცალკევებულია. პირველშია მხოლოდ კენტები (1,3,5...), მეორეში კი ლუწები (2,4,6...). ჯერ გადამრთველი ღილაკით აირჩევთ წყობას, შემდეგ კი ბერკეტით ჩააგდებთ შესაბამის სიჩქარეში."

	key[]: "wiz_hs_range_splitter"
	val[]: "მაჯგუფებელ-მაცალკევებელი ეფუძნება ნამდვილ მექანიკურ კოლოფებს. სიჩქარეები დალაგებულია ოთხ წყებად ბერკეტის მდებარეობის შესაბამისად და იყენებს ორ გადამრთველს. განკუთვნილია, მხოლოდ გამოცდილი მძღოლებისთვის."
#@}

#@}

#+ Auto configuration complete page
