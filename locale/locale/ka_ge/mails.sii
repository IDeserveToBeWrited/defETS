SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "სისტემა" #+ Message sender
		subject: "ტესტური გზავნილი" #+ Message subject
		body: "გამარჯობა!<br><br>ეს არის საცდელი გზავნილი ადმინისტრატორისგან ;-)<br><br>" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "ბანკი" #+ Message sender
		subject: "გჭირდებათ ფული? ჩვენ დაგეხმარებით!" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>საქმიანობის წამოსაწყებად გთავაზობთ ხელსაყრელ სესხს. გსურთ თანხის დაბანდება საკუთარი ბიზნესის განსავითარებლად? მზად ვართ დაგეხმაროთ! გთხოვთ $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>ეწვიოთ ბანკის ადგილობრივ განყოფილებას</link> დაწვრილებითი ინფორმაციისთვის.<br><br>პატივისცემით,<br>გაყიდვების ხელმძღვანელი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "ბანკი" #+ Message sender
		subject: "ჩვენ დაგეხმარებით გაზრდაში" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>ყურადღების მიღმა არ დაგვრჩენია თქვენი მდგრადი განვითარება და გვსურს მხარში ამოგიდგეთ კიდევ უფრო სწრაფი წინსვლისთვის. თქვენი გაზრდილი საკრედიტო ზღვარი უკვე იქნება $MONEY$. როცა მოგესურვებათ, მოხსენით ხელმისაწვდომი თანხა ანგარიშიდან ნებისმიერ დროს $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>ბანკის ახლომდებარე განყოფილებიდან</link>.<br><br>პატივისცემით,<br>გაყიდვების ხელმძღვანელი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "ბანკი" #+ Message sender
		subject: "თქვენს ანგარიშზე გადახარჯვაა" #+ Message subject
		body: "ძვირფასო მომხმარებელი,<br><br>ანგარიშიდან გაიტანეთ იმაზე მეტი თანხა, ვიდრე მისაწვდომი იყო. ჩვენ რამდენიმე დღით მოგეცით მოკლე-ვადიანი კრედიტი, უფასოდ, ამით იმედია მოაგვარებთ სიტუაციას. კრედიტი დაფარეთ რაც შეიძლება მალე.<br><br>საუკეთესო სურვილებით,<br>თქვენი ანგარიშის მმართველი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "ბანკი" #+ Message sender
		subject: "დავალიანება გაქვთ დასაფარი!" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>თქვენის ბანკის ანგარიში უარყოფითია! გადაიხადეთ თანხა შემდეგი $DAYS$ დღის განმავლობაში, წინააღმდეგ შემთხვევაში იძულებული გავხდებით ჩამოგართვათ საკუთრება.<br><br>პატივისცემით,<br>თქვენი ანგარიშის მმართველი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "ბანკი" #+ Message sender
		subject: "ბოლო გაფრთხილება!" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>უკანასკნელად გაფრთხილებთ, რომ თუ არ დაფარავთ არსებულ დავალიანებას, იძულებული გავხდებით ჩამოგართვათ კუთვნილი ქონება სესხის დასაფარად.<br><br>პატივისცემით,<br>საკრედიტო ოფიცერი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "ბანკი" #+ Message sender
		subject: "დავალიანება დაფარულია" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>გაცნობებთ, რომ თქვენს ანგარიშზე დავალიანება დაფარულია. მომავალში თუ დახმარება დაგჭირდეთ, თქვენ გვერდით გვიგულეთ.<br><br>სასიამოვნო დღეს გისურვებთ,<br>საკრედიტო ოფიცერი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "ბანკი" #+ Message sender
		subject: "თქვენი სატვირთო გაიყიდა" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>მინდა გაცნობოთ, რომ თქვენი სატვირთო - $TRUCK_NAME$ - გავყიდეთ $MONEY$-ად. სამწუხაროდ, თქვენ გქონდათ დაუფარავი სესხი და სხვა გზა აღარ დაგვიტოვეთ, გარდა იმისა, რომ გადაგვედგა ეს ნაბიჯი. გირჩევთ, რომ დაიწყოთ მუშაობა და გაიუმჯობესოთ ფინანსური მდგომარეობა.<br><br>პატივისცემით,<br>საკრედიტო ოფიცერი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "ბანკი" #+ Message sender
		subject: "თქვენი კუთვნილი მისაბმელი გაიყიდა" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>მინდა გაცნობოთ, რომ თქვენი კუთვნილი მისაბმელი - $TRAILER_NAME$ - გავყიდეთ ღირებულებით $MONEY$. სამწუხაროდ, თქვენ გქონდათ დაუფარავი სესხი და სხვა გზა აღარ დაგვიტოვეთ, გარდა იმისა, რომ გადაგვედგა ეს ნაბიჯი. გირჩევთ, რომ დაიწყოთ მუშაობა და გაიუმჯობესოთ ფინანსური მდგომარეობა.<br><br>პატივისცემით,<br>საკრედიტო ოფიცერი<br>ბანკი" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "ბანკი" #+ Message sender
		subject: "თქვენი საკუთრება გაიყიდა" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>თქვენს ანგარიშზე არსებული დავალიანების გამო იძულებული გავხდით გაგვეყიდა თქვენი ქონება. მიღებულ თანხას $MONEY$<br>გამოვიყენებთ თქვენი ვალის დასაფარად. ჩამორთმეული ნივთებია:<br><br>$ITEM_LIST$<br>ვწუხვართ, რომ ყველაფერი ასე ცუდად დასრულდა, იმედია, ეს ძალიან არ დააზარალებს თქვენი მიზანდასახულობას.<br><br>საუკეთესო სურვილებით,<br>საკრედიტო ოფიცერი<br>ბანკი" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "ავტოსალონი - $CITY$" #+ Message sender
		subject: "ხელმისაწვდომია ახალი $BRAND$ სატვირთო!" #+ Message subject
		body: "ძვირფასო მომხმარებელო, <br><br>ჩვენ ვართ $BRAND$-(ი)ს სერტიფიცირებული გადამყიდველები. გთავაზობთ სხვადასხვა სატვირთოების  ფართო არჩევანს და შეგირჩევთ  კონფიგურაციას სურვილის მიხედვით. ეწვიეთ $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>ჩვენს ავტოსალონს ქალაქში $CITY$</link>. თქვენი საოცნებო სატვირთო შეიძლება კარის უკან დგას.<br><br>საუკეთესო სურვილებით,<br>$BRAND$-(ი)ს ავტოსალონის დირექტორი" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "მეორადი სატვირთოების ბაზარი" #+ Message sender
		subject: "ნახმარი სატვირთოები ფასდაკლებით!" #+ Message subject
		body: "ძვირფასო ბატონო/ქალბატონო,<br><br>მოხარულნი ვართ გაცნობოთ, რომ ვხსნით მეორადი სატვირთოების სავაჭრო წარმომადგენლობას, რომელიც თქვენი ყველაზე სასურველი ადგილი გახდება უმაღლესი ხარისხის სატვირთოების შესარჩევად! თუ ეძებთ მძლავრ ან საიმედო მანქანას, მშვენიერი სატვირთო გვეგულება თქვენთვის.<br><br>გთხოვთ, გადახედოთ ჩვენს ბმულს $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>მეორადი სატვირთოების შემოთავაზებებისთვის</link>. გვჯერა, რომ იპოვით შესაფერის სატვირთოს თქვენი საჭიროებებისთვის.<br><br>პატივისცემით,<br><br>მეორადი სატვირთოების მომწოდებელთა გუნდი<br><br>ამასთანავე: არ დაგავიწყდეთ, ხშირად შეამოწმოთ ხოლმე ახალი საქონელი! ჩვენი ჩამონათვალი მუდმივად ახლდება, არავინ იცის, რაოდენ ხელსაყრელ შემოთავაზებას შეიძლება წააწყდეთ." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "საჭიროა მძღოლი თავისი აღჭურვილობით" #+ Message subject
		body: "მათთვის, ვინც დაინტერესებულია,<br><br>ვეძებთ გამოცდილ მძღოლებს საკუთარი სატვირთოთი დიდი ოდენობის ტვირთის გადასაზიდად. სამუშაოს შესრულებისთვის ჩვენ გთავაზობთ კონკურენტუნარიან ფასებს, $MONEY$მდე. თუ გყავთ საკუთარი სატვირთო, გთხოვთ მობრძანდეთ ჩვენს საწყობში, ქალაქი $CITY$.<br><br>$COMPANY$,<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "მძღოლი $NAME$" #+ Message sender
		subject: "სამუშაოდ მჭირდება სატვირთო" #+ Message subject
		body: "სალამი უფროსო,<br><br>არ ვიცი შენიშნეთ თუ არა, მაგრამ უკვე $DAYS$ გავიდა, რაც სამუშაოს გარეშე ვარ ფარეხში, ქალაქი $CITY$. მე ფული მჭირდება სხვადასხვა გადასახადისთვის და სამუშაოს გარეშე ნამდვილად ვერ ვიშოვი. სამუშაოს დასაწყებად გთხოვთ, მომეცით სატვირთო $DAYS2$ში, წინააღმდეგ შემთხვევაში მომიწევს თქვენი დატოვება.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "მძღოლი $NAME$" #+ Message sender - written by female
		subject: "სამუშაოდ მჭირდება სატვირთო" #+ Message subject - written by female
		body: "სალამი უფროსო,<br><br>არ ვიცი შენიშნეთ თუ არა, მაგრამ უკვე $DAYS$ გავიდა, რაც სამუშაოს გარეშე ვარ ფარეხში, ქალაქი $CITY$. მე ფული მჭირდება სხვადასხვა გადასახადისთვის და სამუშაოს გარეშე ნამდვილად ვერ ვიშოვი. სამუშაოს დასაწყებად გთხოვთ, მომეცით სატვირთო $DAYS2$ში, წინააღმდეგ შემთხვევაში მომიწევს თქვენი დატოვება.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "მძღოლი $NAME$" #+ Message sender
		subject: "ნახვამდის" #+ Message subject
		body: "მოგესალმებით,<br><br>დროს ტყუილად ვეღარ გავფლანგავ. სატვირთოს გარეშე ვერ ვიმუშავებ და მეტს ვეღარ მოვიცდი. ისედაც ბევრი კარგი შემოთავაზება გავუშვი ხელიდან, ასე რომ თქვენი კომპანიიდან მივდივარ და სხვაგან ვცდი ბედს. გადმოცემული აღჭურვილობა დაგხვდებათ ჩემს ყოფილ ფარეხში, ქალაქი $CITY$.<br><br>მშვიდობით,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "მძღოლი $NAME$" #+ Message sender - written by female
		subject: "ნახვამდის" #+ Message subject - written by female
		body: "მოგესალმებით,<br><br>დროს ტყუილად ვეღარ გავფლანგავ. სატვირთოს გარეშე ვერ ვიმუშავებ და მეტს ვეღარ მოვიცდი. ისედაც ბევრი კარგი შემოთავაზება გავუშვი ხელიდან, ასე რომ თქვენი კომპანიიდან მივდივარ და სხვაგან ვცდი ბედს. გადმოცემული აღჭურვილობა დაგხვდებათ ჩემს ყოფილ ფარეხში, ქალაქი $CITY$.<br><br>მშვიდობით,<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "მძღოლი $NAME$" #+ Message sender
		subject: "ჩემი სატვირთო საფუძვლიან აღდგენას საჭიროებს" #+ Message subject
		body: "სალამი უფროსო,<br><br>ვიცი დაკავებული ხართ, მაგრამ ჩემი სატვირთო საჭიროებს საფუძვლიან შეკეთებას. მეტად მოძველებული და გაცვეთილია უსაფრთხო გადაადგილებისთვის. უკვე $DAYS$ დღეა, ვეღარ ვმუშაობ და სიმართლე გითხრათ, მეტად იმედგაცრუებული ვარ, ვინაიდან ფული მჭირდება გადასახადებისთვის და სამუშაოს გარეშე ნამდვილად ვერ ვიშოვი. თუ შეიძლება, იქნებ ახალი სატვირთო მომცეთ ან ეს აღადგინოთ, რომ ვიმუშაო, თუ არადა სხვა გამოსავალი არაა, მომიწევს თქვენთან გამომშვიდობება.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "მძღოლი $NAME$" #+ Message sender - written by female
		subject: "ჩემი სატვირთო საფუძვლიან აღდგენას საჭიროებს" #+ Message subject - written by female
		body: "სალამი უფროსო,<br><br>ვიცი დაკავებული ხართ, მაგრამ ჩემი სატვირთო საჭიროებს საფუძვლიან შეკეთებას. მეტად მოძველებული და გაცვეთილია უსაფრთხო გადაადგილებისთვის. უკვე $DAYS$ დღეა, ვეღარ ვმუშაობ და სიმართლე გითხრათ, მეტად იმედგაცრუებული ვარ, ვინაიდან ფული მჭირდება გადასახადებისთვის და სამუშაოს გარეშე ნამდვილად ვერ ვიშოვი. თუ შეიძლება, იქნებ ახალი სატვირთო მომცეთ ან ეს აღადგინოთ, რომ ვიმუშაო, თუ არადა სხვა გამოსავალი არაა, მომიწევს თქვენთან გამომშვიდობება.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "მძღოლი $NAME$" #+ Message sender
		subject: "მშვიდობით" #+ Message subject
		body: "სალამი,<br><br>სამწუხაროდ, ჩემი მანქანა გზაში დაიშალა ცვეთისა და სიძველისგან და მეტი დრო აღარ მაქვს. სამუშაოს გარეშე ვარ, ხარჯები კი მეზრდება, ასე რომ გადავწყვიტე წავიდე. გირჩევთ საფუძვლიანად შეაკეთოთ ეს სატვირთო ახალი მძღოლის აყვანამდე. ძველ ნაწილებს იპოვით ჩემს ყოფილ ფარეხში, ქალაქი $CITY$.<br><br>კარგად იყავით.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "მძღოლი $NAME$" #+ Message sender - written by female
		subject: "მშვიდობით" #+ Message subject - written by female
		body: "სალამი,<br><br>სამწუხაროდ, ჩემი მანქანა გზაში დაიშალა ცვეთისა და სიძველისგან და მეტი დრო აღარ მაქვს. სამუშაოს გარეშე ვარ, ხარჯები კი მეზრდება, ასე რომ გადავწყვიტე წავიდე. გირჩევთ საფუძვლიანად შეაკეთოთ ეს სატვირთო ახალი მძღოლის აყვანამდე. ძველ ნაწილებს იპოვით ჩემს ყოფილ ფარეხში, ქალაქი $CITY$.<br><br>კარგად იყავით.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "მძღოლი $NAME$" #+ Message sender
		subject: "მივდივარ" #+ Message subject
		body: "სალამი უფროსო,<br><br>ფარეხი, რომელშიც ვიყავი, დაიხურა, ქალაქი $CITY$. ბანკიდან მოვიდნენ და მითხრეს, დამეცალა აქაურობა. როგორც ჩანს, კომპანიის საქმე კარგად ვერ უნდა იყოს. ასე რომ გადავწყვიტე წავიდე, აქ მაინც ვეღარ ვიმუშავებ სატვირთოსა და დანარჩენი აღჭურვილობის გარეშე.<br><br>ნახვამდის, გული არ გაიტეხოთ,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "მძღოლი $NAME$" #+ Message sender - written by female
		subject: "მივდივარ" #+ Message subject - written by female
		body: "სალამი უფროსო,<br><br>ფარეხი, რომელშიც ვიყავი, დაიხურა, ქალაქი $CITY$. ბანკიდან მოვიდნენ და მითხრეს, დამეცალა აქაურობა. როგორც ჩანს, კომპანიის საქმე კარგად ვერ უნდა იყოს. ასე რომ გადავწყვიტე წავიდე, აქ მაინც ვეღარ ვიმუშავებ სატვირთოსა და დანარჩენი აღჭურვილობის გარეშე.<br><br>ნახვამდის, გული არ გაიტეხოთ,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "დისპეჩერი" #+ Message sender
		subject: "საგანგებო გადაზიდვები" #+ Message subject
		body: "სალამი უფროსო,<br><br>თქვენთვის კარგი წინადადება მაქვს. ჩვენი კავშირების მეშვეობით ახლა უკვე ნამდვილ გამოწვევას შეიძლება შევეჭიდოთ. საჭიროა გარკვეული სახის საგანგებო, მსხვილგაბარიტიანი და მძიმეწონიანი ტვირთის გადაზიდვა გამოცდილი მძღოლის მიერ. ადვილი არ იქნება, ვინაიდან მოითხოვს მაღალგანვითარებულ უნარებს, მოთმინებას, ერთობლივ მოქმედებას გამყოლ მანქანებთან და გამახვილებულ ყურადღებას, მაგრამ ვფიქრობ, თავს გაართმევთ, ასეა? თანაც, დიდი გამბედაობა დიდი მოგების საწინდარია.<br><br>თუ სურვილი გაგიჩნდებათ, შეგიძლიათ ამ ქალაქებს ეწვიოთ:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "დისპეჩერი" #+ Message sender
		subject: "ახალი საგანგებო გადაზიდვები" #+ Message subject
		body: "გამარჯობა უფროსო.<br><br>მეტი და მეტი კომპანია გამოთქვამს სურვილს დაგიქირაოთ თქვენი გამოცდილების გამოსაყენებლად საგანგებო გადაზიდვებისთვის. როგორც წინათ – ადვილი არ იქნება, ვინაიდან მოითხოვს განსაკუთრებულ უნარებს, მოთმინებას, შეთანხმებულ მოქმედებებს თანმხლებ ავტომანქანებთან და გამახვილებულ ყურადღებას, მაგრამ, ვგონებ, თქვენ ამ სამუშაოს თავისუფლად გაართმევთ თავს, ხომ ასეა? ამასთანავე, გახსოვდეთ – ეს ტვირთი დიდი შემოსავლის მომტანია.<br><br>ასე რომ, გარდა ამჟამად ხელმისაწვდომი გადაზიდვის სამუშაოებისა ქალაქებში:<br><br>$OLD_CITIES$<br><br>შეკვეთების აღება ამიერიდან უკვე შეგიძლიათ <color value=@@clr_sel@@>ახალ მხარეშიც<color value=@@clr_txt@@>:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "უძრავი ქონების სააგენტო" #+ Message sender
		subject: "გსურთ, გააფართოვოთ თქვენი კომპანია?" #+ Message subject
		body: "ძვირფასო მომხმარებელო,<br><br>გვსურს მოგილოცოთ წინსვლა თქვენს საქმიანობაში. მოხიბლულნი ვართ თქვენი კომპანიის წარმატებით და გვსურს ახალი გზა შემოგთავაზოთ განვითარებაში ხელშეწყობისთვის. ამიერიდან თქვენ უკვე შეგეძლებათ ჩვენი მომსახურებებით სარგებლობა და ქონების შეძენა მყისიერად! დამატებითი ინფორმაციისთვის $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>ეწვიეთ უძრავი ქონების შესაძენ გვერდს</link>.<br><br>პატივისცემით,<br>პარტნიორებთან ურთიერთობების ხელმძღვანელი<br>უძრავი ქონების განყოფილება" #+ Message body
	}
	
#@}
