    key[]: "hint_driv_arc_text"
	val[]: "გამოიყენეთ $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ და $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ წინსვლისთვის ან უკუსვლისთვის.<br><offset vshift=8>გამოიყენეთ $SPECIAL_steering$ მოხვევისთვის."


    key[]: "hint_driv_auto_title"
	val[]: "Driving"

    key[]: "hint_driv_auto_text"
	val[]: "გამოიყენეთ $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ და $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ წინსვლისთვის ან უკუსვლისთვის.<br><offset vshift=8>გამოიყენეთ $SPECIAL_steering$ მოხვევისთვის.<br><offset vshift=8>დააჭირეთ $KEY_gearup$ და $KEY_geardown$ გადაცემის ასარჩევად."


    key[]: "hint_driv_seq_title"
	val[]: "Driving"

    key[]: "hint_driv_seq_text"
	val[]: "გამოიყენეთ $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ და $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ წინსვლისთვის ან უკუსვლისთვის.<br><offset vshift=8>გამოიყენეთ $SPECIAL_steering$ მოხვევისთვის.<br><offset vshift=8>დააჭირეთ $KEY_gearup$ და $KEY_geardown$ გადაბმულობის სამართავად."


    key[]: "hint_driv_hshift_title"
	val[]: "ტარება"

    key[]: "hint_driv_hshift_text"
	val[]: "გამოიყენეთ $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ და $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ წინსვლისთვის ან უკუსვლისთვის.<br><offset vshift=8>ცვალეთ $SPECIAL_steering$ მოხვევისთვის.<br><offset vshift=8>გადაცემა <color value=@@clr_sel@@>ბერკეტით<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Approach the destination"

    key[]: "hint_depot_deliv_text"
    val[]: "Stop in the marked area to select the final parking spot difficulty and earn corresponding experience."


    key[]: "hint_fin_deliv_title"
    val[]: "Finish the delivery"

    key[]: "hint_fin_deliv_text"
    val[]: "ჩააყენეთ შერჩულ სადგომზე. შეგიძლიათ დააჭიროთ $KEY_activate$ გამოსატოვებლად, როცა მიუახლოვდებით ჩასაბარებელ ადგილს."


    key[]: "hint_fin_deliv2_title"
    val[]: "Finish the delivery"

    key[]: "hint_fin_deliv2_text"
    val[]: "ჩააყენეთ შერჩეულ სადგომ ადგილას. შეგიძლიათ ჩართოთ ეკრანული ჩანამატი @@desktop_menu_category_options@@ სადგომზე ჩაყენების ასარიდებლად."


