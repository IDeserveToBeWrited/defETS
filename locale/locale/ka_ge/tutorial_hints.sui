    key[]: "hint_sm_throttle_text"
    val[]: "შეგიძლიათ აჩქარების ჭკვიანი მართვის ჩასართავად იხილოთ @@desktop_menu_category_options@@. მისი ჩართვით, მანქანა აჩქარდება ნელი სვლით ნაგულისხმევად. წინსვლის ღილაკზე ორჯერ სწრაფი დაჭერით კი მანქანა აჩქარდება სრული სვლით ღილაკის აშვებამდე."

    key[]: "hint_bus_job_title"
	val[]: "ავტობუსით პირველი სამუშაო"

    key[]: "hint_bus_job_text"
    val[]: "გადაიყვანეთ მგზავრები დანიშნულების ადგილას – დროულად და მოხერხებული, რბილი მართვით, ამასთანავე უსაფრთხოდ, რომ კმაყოფილი დარჩნენ.<br><br>თვალი ადევნეთ აჩქარების ძალის მზომ ეკრანულ ჩანამატს გლუვად სიარულისთვის."


    key[]: "hint_satis_dec_title"
	val[]: "მგზავრთა კმაყოფილების უზრუნველყოფა"

    key[]: "hint_satis_dec_text"
    val[]: "შეგიძლიათ გააუმჯობესოთ მგზავრთა კმაყოფილება შეუფერხებელად და ზიანის გარეშე განუწყვეტელი ტარებით მოძრაობის წესების დაურღვევლად გარკვეული დროის განმავლობაში.<br><br>თვალი ადევნეთ აჩქარების ძალის მზომ ეკრანულ ჩანამატს გლუვად სიარულისთვის."


    key[]: "hint_low_satis_title"
	val[]: "იმატებს მგზავრთა კმაყოფილება"

    key[]: "hint_low_satis_text"
    val[]: "მგზავრები უკმაყოფილონი არიან თქვენი ტარებით. შეგიძლიათ გამოასწოროთ მათი კმაყოფილების დონე, თუ უფრო მოსახერხებელს გახდით მგზავრობას.<br><br>შემნელებელი თუ გაქვთ, გამოიყენეთ რბილი მუხრუჭისთვის – დააჭირეთ $KEY_retarderup$ რომ ძალა მოემატოს ან $KEY_retarderdown$ მის შესამცირებლად."


    key[]: "hint_bus_late_title"
	val[]: "დაგვიანებით მიყვანა"

    key[]: "hint_bus_late_text"
    val[]: "განრიგს ჩამორჩებით, რის გამოც მგზავრთა კმაყოფილება მოიკლებს ადგილზე მიყვანისას. შეგიძლიათ ააჩქაროთ სადაც მოხერხდება, მაგრამ უნდა შეინარჩუნოთ უსაფრთხოება."


    key[]: "hint_bus_stop_title"
	val[]: "მიდით ავტობუსის გაჩერებამდე"

    key[]: "hint_bus_stop_text"
    val[]: "გააჩერეთ მონიშნულ ადგილას, რომ მგზავრთა დაცლა და ჩასხდომა მოხერხდეს. ამომსვლელ მგზავრებს აღაფრთოვანებთ სუფთა და დაუზიანებელი ავტობუსი."


    key[]: "hint_bus_stop_fin_title"
	val[]: "მიდით ავტობუსის გაჩერებამდე"

    key[]: "hint_bus_stop_fin_text"
    val[]: "გააჩერეთ მონიშნულ ადგილას მგზავრობის დასასრულებლად."