#+ Books general.
#@{
	key[]: "aca_modded_book"
	val[]: "დანამატი"

	key[]: "aca_book_inaccessible"
	val[]: "სიახლეები მალე დაემატება. დარჩით ყურადღებით."

	key[]: "aca_book_inaccessible_t"
	val[]: "მალე იქნება"

	key[]: "aca_book_inaccessible_u"
	val[]: "მალე იქნება!"

	key[]: "aca_book_disclaimer_t"
	val[]: "პასუხმგებლობის მოხსნა"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "ეს არ წარმოადგენს აღიარებულ სასწავლო გეგმას"

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ არაა განკუთვნილი და არ გამოდგება ნამდვილი გადამზადების ჩასანაცვლებლად.</font><br><br> <color value=@@clr_txt@@>დაჟინებით გირჩევთ, მოიძიოთ და გაიაროთ მართვის სასწავლო გეგმა უფლებამოსილ და აღიარებულ დაწესებულებებში, ვიდრე რეალურ პირობებში ეცდებით სატვირთოს ტარებას.<br><br>იმ სასწავლებლებს კი, რომელთაც სურთ @@driving_academy@@ დამატებით დაურთონ თავიანთ სასწავლო გეგმას, შეუძლიათ შეგვეხმიანონ მისამართზე academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "სატვირთოს მართვის საფუძვლები"

	key[]: "aca_book_book1_desc"
	val[]: "შეისწავლეთ სატვირთოს მართვის საფუძვლები, ძირითადი შესაძლებლობებიდან დაწყებული, ჩაბმული მისაბმელით მარჯვედ მოძრაობამდე."

	key[]: "aca_book_book2_title"
	val[]: "სატვირთოს მართვის დახელოვნება"

	key[]: "aca_book_book2_desc"
	val[]: "დახვეწეთ სტვირთოს მართვის უნარები ახალი მოქმედებების შესრულებით მეტად რთულ გარემო პირობებში."

	key[]: "aca_book_book3_title"
	val[]: "ორმაგი მისაბმელის გადაადგილება"

	key[]: "aca_book_book3_desc"
	val[]: "Take on the curious challenges of driving and reversing with a set of doubles."

#@}

