#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "პირველი რამდენიმე გატარებისას მხოლოდ საწევარს გამოიყენებთ.<br>საწევარი ეწოდება სატვირთოს, რომელსაც ძარაზე არ აქვს ტვირთის საზიდი და ესაჭიროება მისაბმელის ჩაბმა, რომ გადაზიდოს საქონელი და მასალები."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "საწევარი მეტად გავრცელებულია მსოფლიოში, რადგან ყველაზე მოქნილი და მოსახერხებელია: შეუძლია ჩაიხსნას ცარიელი მისაბმელი და ჩაიბას უკვე დატვირთული დაუყოვნებლივ, აგრეთვე შეუძლია, ერთი სახის მისაბმელიდან გადაერთოს სრულიად განსხვავებული სახის მისაბმელზე."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "პირველი გატარებისას მხოლოდ გევალებათ წინ გავლა და გაჩერება წყვეტილი ხაზის შემდეგ.<br>დაქოქეთ ძრავა, მიჰყევით მითითებებს დასაძრავად. როცა მზად იქნებით, დაიწყეთ წინსვლა."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "გასცდით წყვეტილ ხაზს, შეჩერდით, ჩააქრეთ ძრავა და გაამაგრეთ ხელის მუხრუჭით."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "გადამზადების მომდევნო ნაბიჯია სატვირთოს პირველად დაძვრა.<br><br>ცხადია, გათიშული ძრავა ვერ იმუშავებს, ასე რომ ჯერ დაქოქეთ.<br><br><font face=/font/big_bold.font>დააჭირეთ $input engineelect$ დასაქოქად.</font>@@aca_goal_tip@@ ნაგულისხმევად, ძრავა დაიქოქება ელექტრობის ჩართვისთანავე, შეცვლა შეგიძლიათ პარამეტრებიდან - 'თამაში' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "გასაღების გადატრიალებისას ამოქმედდება სატვირთოს ელექტრობა. ალბათ შეამჩნევდით შუქების გამაფრთხილებელ აციმციმებას მაჩვენებლების დაფაზე - აქ უჩვეულო არაფერია. თუ ჩართული დარჩა ძრავის დაქოქვის შემდეგაც, ეგ უკვე რაღაც ხარვეზზე მიუთითებს. გამონაკლისია ხელის მუხრუჭის მაჩვენებელი, რომელიც გაითიშება მუხრუჭის მოხსნისას.<br><br>საბედნიეროდ, ეს სატვირთო კარგ მდგომარეობაშია და მზადაა, რომ განაგრძოთ.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_engine@@ დასაქოქად. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "მას შემდეგ, რაც ძრავა დაიქოქება, გადამწყვეტი მნიშვნელობა ენიჭება ირგვლივ გარემოს შეთვალიერებას მოძრაობის დაწყებამდე.<br><br><font face=/font/big_bold.font>მიმოიხედეთ სატვირთოს გარშემო თქვენსა და მგზავრის მხარეს მდებარე სარკეების მეშვეობით, რომ დარწმუნდეთ, ყველაფერი ნათლად ჩანს.</font>@@aca_goal_tip@@ უნდა იმყოფებოდეთ სატვირთოში."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "შეიძლება თქმაც არ უნდა, მაგრამ მოძრაობის დაწყებამდე ჯერ გაჩერების ცოდნაა საჭირო.<br><br><font face=/font/big_bold.font>დასამუხრუჭებლად გამოიყენეთ $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "შემდეგ შეისწავლით მიმართულების შეცვლას სიარულისას.<br><br>მარტივ ავტომატურ გადაცემათა კოლოფით სარგებლობისას არ მოგიწევთ სიჩქარეში ჩაგდება, ყველაფერი თავისით ხდება<font face=/font/big_bold.font><br><br>გამოიყენეთ $input forward$ წინსვლისთვის. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "შემდეგ შეისწავლით მიმართულების შეცვლას სიარულისას.<br><br>ნამდვილ ავტომატურ გადაცემათა კოლოფით სარგებლობისას საშუალება გაქვთ, აარჩიოთ გადაცემა წინსვლის, უკუსვლისა და უქმ მდგომარეობაში გადასაყვანად.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_gearup@@, რომ აამოქმედოთ წინსვლის გადაცემა. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "შემდეგ შეისწავლით მიმართულების შეცვლას სიარულისას.<br><br>თანმიმდევრულ გადაცემათა კოლოფით სარგებლობისას საშუალება გაქვთ, რიგ-რიგობით ჩააგდოთ სიჩქარეში ისე, როგორც სინამდვილეში ხდება.<br><br>ზუსტად ასევე, წინსვლისას და აჩქარებისას მოგიწევთ მაღალ გადაცემაში ჩაგდება.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_gearup@@  პირველ სიჩქარეში ჩასაგდებად.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "შემდეგ შეისწავლით მიმართულების შეცვლას სიარულისას.<br><br>სიჩქარის ბერკეტითა და მოდების სატერფულით სრულად შეგიძლიათ შეიგრძნოთ, როგორ მუშაობს ნამდვილი მექანიკური გადაცემათა კოლოფი.<br><br>ბოლომდე დააჭირეთ მოდებასა და მუხრუჭს. <font face=/font/big_bold.font>ბერკეტი ჩააგდეთ პირველ სიჩქარეში. <color value=@@clr_txt@@>არ აუშვათ მოდებისა და მუხრუჭის სატერფულებს.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "დაძვრისთვის ჯერ უნდა ახსნათ ხელის მუხრუჭი.<br><br><font face=/font/big_bold.font>გამოიყენეთ @@imv_nrm_parkingbrake@@, რომ მოიხსნას მუხრუჭი.</font> @@aca_goal_tip@@ ნაგულისხმევად ხელის მუხრუჭი გათიშულია ხოლმე. შეგიძლიათ შეცვალოთ პარამეტრებიდან - 'თამაში' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "ყველაფერი მზადაა წინსვლისთვის. დაიწყეთ მოძრაობა და გადაკვეთეთ წყვეტილი ხაზი.<br><br><font face=/font/big_bold.font>თავდაპირველად საჭიროა, რომ დაძრათ: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "ყველაფერი მზადაა წინსვლისთვის. დაიწყეთ მოძრაობა და გადაკვეთეთ წყვეტილი ხაზი.<br><br><font face=/font/big_bold.font>თავდაპირველად საჭიროა, რომ დაძრათ: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "ყველაფერი მზადაა წინსვლისთვის. დაიწყეთ მოძრაობა და გადაკვეთეთ წყვეტილი ხაზი.<br><br><font face=/font/big_bold.font>თავდაპირველად საჭიროა, რომ დაძრათ: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "ყველაფერი მზადაა წინსვლისთვის. დაიწყეთ მოძრაობა და გადაკვეთეთ წყვეტილი ხაზი.<br><br><font face=/font/big_bold.font>აუშვით მუხრუჭს, თანდათან აუშვით მოდებასაც და იმავდროულად მიაჭირეთ სვლას ბრუნთა რიცხვის შესანარჩუნებლად, რომ არ ჩაგიქრეთ სატვირთო. როცა მოდებას სრულად აუშვებთ, შეგეძლებათ აჩქარება და სიჩქარის ცვლა საჭიროებისამებრ. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "მიაჭირეთ მუხრუჭს, რომ გააჩეროთ.<br><br><font face=/font/big_bold.font>გამოიყენეთ $input backward$ სატვირთოს გასაჩერებლად. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "მიაჭირეთ მუხრუჭს, რომ გააჩეროთ.<br><br><font face=/font/big_bold.font>გამოიყენეთ $input backward$ სატვირთოს გასაჩერებლად. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "მიაჭირეთ მუხრუჭს, რომ გააჩეროთ.<br><br><font face=/font/big_bold.font>გამოიყენეთ $input backward$ სატვირთოს გასაჩერებლად. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "გაჩერების დრო რომ მოვა, ბოლომდე მიაჭირეთ მოდებას სრულად გასათიშად <font face=/font/big_bold.font>და შემდეგ გააჩერეთ სატვირთო მუხრუჭზე დაწოლით.<color value=@@clr_txt@@> ჩააგდეთ სიჩქარის გადამრთველი უქმ სვლაში და ამის შემდეგ შეგეძლებათ აუშვათ მოდებას. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "ახლა კი დაიცავით დაგორებისგან. ხელის სადგომი მუხრუჭი უზრუნველყოფს, რომ სატვირთო არ გამოძრავდეს უნებლიედ დაყენების შემდგომ.<br><br><font face=/font/big_bold.font>გამოიყენეთ @@imv_nrm_parkingbrake@@, რომ აამოქმედოთ სადგომი მუხრუჭი.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "მარტივი ავტომატური გადაცემათა კოლოფით სარგებლობისას არ მოგიწევთ სიჩქარეებში ჩაგდება, ყველაფერი თავისთავად მოხდება.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_activate@@ დასტურისთვის. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>ჩააგდეთ უქმ სვლაში, დააჭირეთ @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>ჩააგდეთ უქმ სვლაში, დააჭირეთ @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>ჩააგდეთ გადაცემათა სამართავი უქმ სვლაში, შემდეგ კი აუშვით მოდებას. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "ახლა უკვე იცით, როგორ დაძრათ სატვირთო და როგორ გააჩეროთ უსაფრთხოდ.<br><br><font face=/font/big_bold.font>დააჭირეთ $input engineelect$ ძრავას ჩასაქრობად. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "უკუსვლა"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "ამ მოქმედებაში პირველად ეცდებით უკუსვლით სიარულს. აგრეთვე შეისწავლით, როგორ გამოიყენოთ სარკეები უკანა ხედისთვის, რას უნდა დააკვირდეთ და როგორ მოემზადოთ უკუსვლით მოძრაობისთვის."

