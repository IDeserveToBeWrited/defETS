#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "ამ მოძრაობისას უკუსვლით უნდა იაროთ სწორი მიმართულებით. უნდა გასცდეთ უკუსვლით წყვეტილ ხაზს და იქვე გააჩეროთ."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "სატვირთოს უკუსვლით მოძრაობისას გადამწყვეტია გარემოს მუდმივი შეთვალიერება, თითოეული სარკით დაკვირვება და გადამოწმება, რომ უკან სივრცე თავისუფალია."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "დაქოქეთ ძრავა, ჩააგდეთ უკუსვლაში და დაძარით."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "უკუსვლით გასცდით წყვეტილ ხაზს, გააჩერეთ სატვირთო, ჩააქრეთ ძრავა და დაიცავით დაგორებისგან."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "მოამზადეთ სატვირთო დასაძრავად, როგორც წინა მოქმედებიდან ისწავლეთ.<br><br><font face=/font/big_bold.font>როცა მზად იქნება ყველაფერი, დაქოქეთ ძრავა. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "შეამოწმეთ სარკეები და დარწმუნდით, რომ თქვენ ირგვლივ ყველაფერი კარგად ჩანს. თუ არ ხართ კმაყოფილი, მოსარგებად გამოიყენეთ '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>ჩაიხედეთ მგზავრის გვერდითა სარკეში.</font>@@aca_goal_tip@@ უნდა იმყოფებოდეთ მანქანის შიდა ხედზე."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "უნდა გასცდეთ წყვეტილ ხაზს. ზოლი ამჯერად თავისუფალია, მაგრამ ჩვეულებრივ ტარებისას გადამწყვეტია, გარემოს მუდმივი შეთვალიერება სარკეების მეშვეობით.<br><br><font face=/font/big_bold.font>შეამოწმეთ მძღოლის გვერდითი სარკე.<font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>გამოიყენეთ $input backward$ უკუსვლაში ჩასაგდებად. </font>@@aca_goal_tip@@ უკუსვლისას თავისით ამოქმედდება გამაფრთხილებელი ხმა სატვირთოთა უმეტესობაზე. მისი გამორთვა შეგიძლია პარამეტრებიდან - 'ხმა' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>გამოიყენეთ @@imv_nrm_geardown@@ უკუსვლაში ჩასაგდებად. </font>@@aca_goal_tip@@ უკუსვლისას თავისით ამოქმედდება გამაფრთხილებელი ხმა სატვირთოთა უმეტესობაზე. მისი გამორთვა შეგიძლია პარამეტრებიდან - 'ხმა' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>გამოიყენეთ @@imv_nrm_geardown@@ უკუსვლაში ჩასაგდებად. </font>@@aca_goal_tip@@ უკუსვლისას თავისით ამოქმედდება გამაფრთხილებელი ხმა სატვირთოთა უმეტესობაზე. მისი გამორთვა შეგიძლია პარამეტრებიდან - 'ხმა' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>ბოლომდე მიაჭირეთ მოდებას, სრულად რომ გაითიშოს და სიჩქარეთა გადამრთველი ჩააგდეთ უკუსვლაში. </font>@@aca_goal_tip@@ უკუსვლისას თავისით ამოქმედდება გამაფრთხილებელი ხმა სატვირთოთა უმეტესობაზე. მისი გამორთვა შეგიძლია პარამეტრებიდან - 'ხმა' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "უკვე ამოქმედებულია უკუსვლის გადაცემა.<br><br><font face=/font/big_bold.font>სადგომი მუხრუჭის მოხსნითვის გამოიყენეთ @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "მოძრაობის დასაწყებად გამოიყენეთ $input backward$.<br><br><font face=/font/big_bold.font>უკუსვლით გასცდით წყვეტილ ხაზს. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "მოძრაობის დასაწყებად დაძარით: $input forward$.<br><br><font face=/font/big_bold.font>უკუსვლით გასცდით წყვეტილ ხაზს. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "მოძრაობის დასაწყებად დაძარით: $input forward$.<br><br><font face=/font/big_bold.font>უკუსვლით გასცდით წყვეტილ ხაზს. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "ნელ-ნელა აუშვით მოდებას და იმავდროულად მიაჭირეთ სვლას ბრუნთა რიცხვის შესანარჩუნებლად. <br><br><font face=/font/big_bold.font>უკუსვლით გასცდით წყვეტილ ხაზს. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>გააჩერეთ სატვირთო მუხრუჭზე დაჭერით: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>გააჩერეთ სატვირთო მუხრუჭზე დაჭერით: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>გააჩერეთ სატვირთო მუხრუჭზე დაჭერით: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>ბოლომდე მიაჭირეთ მოდებას სრულად გასათიშად და შემდეგ მუხრუჭზე დაწოლით გააჩერეთ სატვირთო. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>აამოქმედეთ ხელის მუხრუჭი @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "მარტივი ავტომატური გადაცემათა კოლოფით სარგებლობისას არ მოგიწევთ სიჩქარეებში ჩაგდება, ყველაფერი თავისთავად მოხდება, განსხვავებით სინამდვილისგან.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_activate@@ დასტურისთვის. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>უქმ სვლაში გადასაყვანად დააჭირეთ @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ თანამედროვე სატვირთოები თავად გადადიან უქმ სვლაში, როცა ხელის მუხრუჭი ამოქმედდება. მიუხედავად ამისა, სასურველია, ხელით გადაყვანა ჩვევად აქციოთ. მომდევნო მოქმედებებში აღარ იქნება მოთხოვნილი ეს ნაბიჯი."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>უქმ სვლაში გადასაყვანად დააჭირეთ @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@  თანამედროვე სატვირთოები თავად გადადიან უქმ სვლაში, როცა ხელის მუხრუჭი ამოქმედდება. მიუხედავად ამისა, სასურველია, ხელით გადაყვანა ჩვევად აქციოთ. მომდევნო მოქმედებებში აღარ იქნება მოთხოვნილი ეს ნაბიჯი."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>უქმ სვლაში გადაიყვანეთ ბერკეტი, შემდეკ კი აუშვით მოდების სატერფულს</font>@@aca_goal_tip@@  თანამედროვე სატვირთოები თავად გადადიან უქმ სვლაში, როცა ხელის მუხრუჭი ამოქმედდება. მიუხედავად ამისა, სასურველია, ხელით გადაყვანა ჩვევად აქციოთ. მომდევნო მოქმედებებში აღარ იქნება მოთხოვნილი ეს ნაბიჯი."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Remember to always be aware of your surroundings as you reverse, especially in busy areas with lots of traffic.<br><br><font face=/font/big_bold.font>Shut down the engine by pressing $input engineelect$. </font>"
#@}

