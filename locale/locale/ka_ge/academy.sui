#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "ირიბად ჩაყენება"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "ამ მოქმედებაში ირიბად ჩააყენებთ დატვირთულ სადგომზე. <br><br>დიდი სივრცე არაა სამოძრაოდ, ამიტომ მოგიწევთ გამოიჩინოთ მეტი სიზუსტე და წინდახედულობა."

#### 3_09 goal


	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Approaching the Parking Spot"
#!{
	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


#!}
#### 3_09 msg - intro text
	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "ირიბად ჩასაყენებელი ადგილები ხშირია ხოლმე. განსაკუთრებით ბევრია ხოლმე მოსასვენებელ ადგილებში ევროპის გზატკეცილების უმეტესობაზე. <br>კიდევ ერთხელ, წინსვლით მოგიწევთ ჩაყენება სადგომზე."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Drive towards the designated parking spot near the end of the row."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Stay towards the middle of the lane, or slightly to the driver's side. Don't drive too close to the barriers or the rear of the trailer may strike them during the turn in."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Drive past the parking spot a fair amount, and then turn hard and fast towards the spot. You'll need to watch both of your side mirrors: The driver's side mirror to ensure the front of your trailer doesn't hit the trailer beside you, and the passenger's side mirror to see that your trailer is safely entering the parking spot."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "გააჩერეთ საჭირო ადგილას სატვირთო, დაიცავით დაგორებისგან და ჩააქრეთ ძრავა."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "ირიბად ჩაყენებისას მნიშვნელოვანია, ზუსტად განსაზღვროთ თქვენი მდებარეობა. უკვე მოხვეულ მდგომარეობაში ძნელია უკუსვლა და ადგილის შეცვლა უსაფრთხოდ, ამიტომ სასურველია საკმარისი სივრცის დატოვება თავიდანვე.<br><br><font face=/font/big_bold.font>მოემზადეთ დაძვრისთვის.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Start driving towards the parking spot. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Drive past the parking spot so your trailer has room to pivot around the truck on your inside.<br><br><font face=/font/big_bold.font>Turn into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Blind side Reversing"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "In this scenario, we'll look at 'blind side' reversing the truck into a parking spot. Without the ability to look out the window to see where you are going, you'll have to rely on your mirrors alone to get you where you need to go."

#### 3_10 goal

#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "In this scenario, you'll learn the 'blind side' reversing manoeuvre. Blindsiding should generally be avoided unless there is no alternative, as your visibility is severely limited. Take your time and err on the side of extreme caution."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Drive well past the parking spot to give yourself room to work once you start reversing."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Come to a stop, check your surroundings, then start reversing."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Turn the tractor away from the spot. This will push the front of the trailer around, and in turn point the rear of the trailer towards the parking spot you want to go into. Be careful not to overdo it or you can risk 'jack-knifing' the combination."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "As the trailer enters the parking spot, start straightening the truck out."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "გააჩერეთ საჭირო ადგილას სატვირთო და დაიცავით დაგორებისგან."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Blind side reversing requires the same procedures as sight-side reversing, but you will be handicapped by the lack of visibility on that side. Use your mirrors and your best judgement to park the truck.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "There is a parking spot ahead and on the passenger's side. You'll need to pull well past it so that you have room to manoeuvre as you reverse.<br><br><font face=/font/big_bold.font>Drive forwards. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Remember, turning the truck away from the spot will turn the trailer towards it. Use your mirrors to the best of your ability to help you get into the parking spot.<br><br><font face=/font/big_bold.font>Start reversing. </font>"

#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Driving on a Roundabout"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "In this scenario, we'll look at how to negotiate a roundabout.<br><br>You'll have to pay special attention to your trailer as it will be tracking behind you differently as you enter, drive through the roundabout, and as you exit."

#### 3_11 goal



	key[]: "aca_goal_book1_3_11_check1"
	val[]: "შესვლა წრიულზე"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "მოძრაობა წრიულზე"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "მოძრაობა წრიულზე"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "გასვლა წრიულიდან"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "სვლა დანიშნულების ადგილამდე"
#!{
	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Roundabouts are very common on the streets of Europe, so it's important to know how to negotiate them."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Stay to the outside of your lane as you approach the roundabout. This will help your trailer clear the inside of the initial turn in."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Drive towards the centre of the roundabout as you enter. Once inside, you'll have to head towards the outside. This is to keep your trailer away from the centre of the roundabout."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Keep an eye on your mirror to ensure the trailer isn't getting too close to the inside barriers."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Leaving the roundabout is fairly easy since your trailer is already positioned away from the inside of the exit. Swing wide on exit and the trailer should follow nicely."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "ჩააყენეთ საჭირო ადგილას სატვირთო და დაიცავით დაგორებისგან."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "In front of you, there is a roundabout set up for you to drive on. <br><br><font face=/font/big_bold.font>Slowly approach the roundabout. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Make a wide turn when entering the roundabout so your trailer will enter behind you without issue. <br><br><font face=/font/big_bold.font>Enter the roundabout. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Drive towards the outside of the roundabout. You'll need to keep the truck as far away from the centre of the roundabout as possible to keep your trailer away from the center barriers. <br><br><font face=/font/big_bold.font>Continue through the roundabout.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Stay close to the outside cones. <br><br><font face=/font/big_bold.font>Keep driving.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Exit the roundabout.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Proceed to the parking spot ahead.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Stop in the designated area.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>დაიცავით დაგორებისგან და ჩააქრეთ სატვირთოს ძრავა. </font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manoeuvring in a Tight Space"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "For the final scenario, you'll be tasked with turning the truck around in a tight space. It will require you to reverse to the blind side in an area with limited room to manoeuvre, which will require attention to your surroundings and smart use of space."

#### 3_12 goal


	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Driving into the Course"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Setting Up for a Blind Side"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Reversing into the Spot"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Completing the Blind Side"

	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Exiting the Course"
#!{
	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In this scenario, we'll go over how to turn around in a tight space with a blind side reversing manoeuvre. This skill will come in handy when you can't make a U-turn or back in on your driver's side."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "The road markings will help you navigate through the training course."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Make a wide turn to ensure your trailer clears the parked trucks."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "As you exit the turn, consider how you will set up the truck for your reversing manoeuvre."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "It will help to have the truck on an angle pointed towards the empty parking spot on your passenger's side, where you will be reversing into."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Blind side reversing should be avoided when possible as there is significantly less visibility. Unfortunately, there are times when you will have no choice but to do it."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Turn the wheel before reversing. This will help get your trailer pointed where you want it immediately, which helps in very tight situations."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Once the trailer is well into the spot, position the tractor in front of the trailer and straighten it out."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Stop once you've straightened out and have enough room to pull forwards again. Start heading back the same way you came in."

	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Follow the road markings out of the training course."

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Drive through the curve ahead and proceed to the designated area."

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "გაჩერება."

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "დაიცავით დაგორებისგან და ჩააქრეთ სატვირთოს ძრავა."

#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "In the area in front of you there's a training course representing a shipping company's lot. Your task is to head in there and turn the truck around to come back out. Be sure to make good use of the room around you.<br><br><font face=/font/big_bold.font>Prepare to set off </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Proceed towards the training course. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "<font face=/font/big_bold.font>Turn the corner and continue through the course. </font>"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Follow the road markings to the barrier at the end of the course. Park on a bit of an angle so that your trailer is pointed towards the empty parking spot on your passenger's side.<br><br><font face=/font/big_bold.font>Continue forwards. </font>"

	key[]: "aca_msg_book1_3_12_check3"
	val[]: "You have a much more limited view of what's going on around you when you blind side. Go slow, use your mirrors, and err on the side of caution.<br><br><font face=/font/big_bold.font>Start reversing and turn the trailer into the empty parking spot. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "That's far enough. You can now proceed forwards and head out of the training ground from the same direction you came from.<br><br><font face=/font/big_bold.font>Start heading towards the exit. </font>"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "<font face=/font/big_bold.font>Exit the training course. </font>"

	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Follow the road markings to the final parking spot.<br><br><font face=/font/big_bold.font>Proceed to the designated area. </font>"
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Offset Reversing Manoeuvre"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "In this scenario, you'll be tasked with reversing into a parking spot that is not directly behind you. There is limited room to manoeuvre, so you must use your space wisely."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "In this scenario, your task will be to park in the space located next to you. There is not much room to manoeuvre, so you'll have to do a little extra work to get the trailer where you want it."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Drive straight up to the barrier."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Stop before the barrier."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Turn the steering wheel sharply to the driver's side before moving. This way, you'll start turning the trailer toward the parking spot as soon as you begin reversing, saving valuable space."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Once you have the trailer pointed where you want it, get the tractor in front of the trailer and start steering it into the parking spot."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "From this point onwards, it's not so different from a regular parking manoeuvre."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Keep reversing and watch both sides. Keep the tractor and trailer lined up with the parking spot."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "გააჩერეთ საჭირო ადგილას სატვირთო, დაიცავით დაგორებისგან და ჩააქრეთ ძრავა."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "You're in a parking spot, but there's a second parking spot to your right that you must move to.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "There's a marked area in front of you.<br><br><font face=/font/big_bold.font>Drive forwards. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Remember to start steering immediately, as there isn't much room.<br><br><font face=/font/big_bold.font>Reverse to the marked spot behind you. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Driving through Simple Turns"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "In this scenario, you'll take a short drive through a training course that will help you learn to manoeuvre the trailer around simple 90 degree corners."

#### 3_15 goal



	key[]: "aca_goal_book1_3_15_check1"
	val[]: "პირველი მოხვევა"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "მეორე მოსახვევი"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "ბოლო მოსახვევი"
#!{
	key[]: "aca_goal_book1_3_15_check5"
	val[]: "@@aca_goal_book1_3_11_check6@@"

