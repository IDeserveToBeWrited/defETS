#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "ამ მოქმედებაში საწევარს გაატარებთ მცირე მანძილით საგზაო კონუსებს შორის კლაკნილად."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "ატარეთ ფრთხილად და გაითვალისწინეთ გარშემო არსებული დაბრკოლებები. თვალი ადევნეთ სატვირთოს ორივე მხარეს და დაიხმარეთ სარკეები, რომ იოლად მიჰყვეთ გზას."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "გზა ვიწროვდება ბოლოსკენ, ასე რომ მნიშვნელოვანია სიზუსტე."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "ჩააყენეთ საჭირო ადგილას სატვირთო და დაიცავით დაგორებისგან."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "ამ მოქმედების შესასრულებლად უნდა იმოძრაოთ კონუსებს შორის ისე, რომ არ წააქციოთ. <br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_activate@@ დასტურისთვის. </font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "გამოიყენეთ სარკეები სათანადო ხედვისთვის სატვირთოს ორივე მხარეს.<br><br>მგზავრის მხარეს წინა და გვერდითა სარკეები მეტად გამოსადეგია ხოლმე გზის გასაკვლევად.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_activate@@ დასტურისთვის.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "მოირგეთ სარკეები, თუ საჭიროა გამოიყენეთ '@@adjust_link_t@@' (შეჩერების მენიუდან).<br><br><font face=/font/big_bold.font>მოემზადეთ დაძვრისთვის. </font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "სატვირთო ჯერ კიდევ არაა მზად დასაძრავად, რამე ხომ არ გამოგრჩათ?<br><br>ძრავა დაქოქოლია? ხელის მუხრუჭი მოხსნილია?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>განაგრძეთ წინსვლა ნელა, კლაკნილად გასავლელად. </font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>განაგრძეთ და აირიდეთ კონუსები. საგანგებო ყურადღება მიაქციეთ მგზავრის მხარეს.<font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>განაგრძეთ ტეხილი გზით კლაკნილზე ისე, რომ არ წააქციოთ კონუსები. </font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>გააჩერეთ დანიშნულების ადგილას. </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>დაიცავით დაგორებისგან სატვირთო და ჩააქრეთ ძრავა. </font>"
#@}

