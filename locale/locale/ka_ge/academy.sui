#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "In this scenario, we'll try connecting and disconnecting a trailer for the first time. Get the truck ready to go, then reverse under the trailer behind you."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "დააერთეთ მისაბმელი, წინ იმოძრავეთ."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "გააჩერეთ მონიშნულ ადგილას."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "გამოაერთეთ მისაბმელი, წინ იმოძრავეთ."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "ჩააყენეთ სატვირთო სადგომზე და დაიცავით დაგორებისგან."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "In this scenario, we'll discuss the procedures for connecting and disconnecting the tractor and trailer. This is a simplified procedure compared to what a trucker will encounter in real life. <br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "საწევარი სატვირთოს უკან დაყენებულია მისაბმელი. უკუსვლით ნელ-ნელა მიუახლოვდით, სანამ მისაბმელის ქვეშ ღერძი არ გამოედება უნაგირს. ამჯერად საწევარი ზუსტადაა გასწორებული და მოხვევა საჭირო არაა, მხოლოდ უკუსვლით იმოძრავეთ.<br><br><font face=/font/big_bold.font>უკუსვლით იარეთ, სანამ მოდებას არ იგრძნობთ. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "უნაგირს ჩაება ღერძი.<br><br><font face=/font/big_bold.font>დაიცავით სატვირთო დაგორებისგან ხელის მუხრუჭის ამოქმედებით. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "სინამდვილეში, როცა უნაგირი თავისით ჩაკეტავს ღერძს, მძღოლი უნდა გადმოვიდეს, დაატრიალოს ხრახნი სადგამების ასაწევად და დააერთოს ჰაერისა თუ ელგაყვანილობის სადენები. <br><br><font face=/font/big_bold.font>აქ სიმარტივისთვის @@imv_nrm_attach@@ პირდაპირ შეაერთებს მისაბმელს. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Now that the tractor is safely connected to the trailer, you're ready to move forwards. Keep in mind that your vehicle is now considerably longer and heavier and will require a new set of skills to operate. <br><br><font face=/font/big_bold.font>Release your parking brake and prepare to drive forwards. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Drive forwards.<br><br><font face=/font/big_bold.font>Stop in the marked area ahead. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Apply the parking brake. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Activate the parking brake. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Once again, in real life, the trucker would have to exit the vehicle, lower the landing gear, disconnect the air and electrical lines, and release the fifth wheel locking mechanism. <br><br><font face=/font/big_bold.font>We simplify this process for you, so pressing @@imv_nrm_attach@@ will disconnect the trailer. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Release your parking brake. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Pull the tractor out from under the trailer and move forwards.<br><br><font face=/font/big_bold.font>Stop in the marked area. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Stop in the marked area. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "დამუხრუჭება მისაბმელით"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "ამ მოქმედებაში შეეჩვევით ჩაბმული მისაბმელით მართვასა და დამუხრუჭებას."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Setting Off"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "დაღმართზე დაშვება"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "60 კმ/სთ სიჩქარის მიღწევა (37 მილ/სთ)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "მუხრუჭის გამოყენება"
