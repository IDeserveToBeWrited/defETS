	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

#!}
#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "The side-view mirror is another tool that will help you to safely manoeuvre the truck. It's located on the upper frame of the passenger's door."

	key[]: "aca_msg_book1_2_04_cutscene1b"
	val[]: "წინსვლით იარეთ და ნელა მოუხვიოთ მგზავრის მხარეს."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "These wooden planks represent a kerb. You'll need to park next to it. <br>Turn towards the kerb to get the truck into a good position to line up with the parking spot."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Slow down well before the kerb and turn towards the parking spot. As you straighten out, you can use the side-view mirror to judge your distance from the kerb."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "გააჩერეთ სატვირთო სადგომზე და დაიცავით დაგორებისგან."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "<font face=/font/big_bold.font>Look through the window on the passenger's side. You can see the side-view mirror there.</font>@@aca_goal_tip@@ You have to be inside the vehicle."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "The side-view mirror covers the area on the passenger's side where the driver can't see. It's one of the most problematic blind spots on the truck. If the angle of the mirror doesn't suit you, you can adjust it in '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "The truck still isn't ready to move, maybe you've forgotten something?<br><br>Is the engine on? Have you released the parking brake?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Ahead of you there is a line of planks representing a kerb. At the end of the kerb is a parking spot. You'll need to drive there. <br><br><font face=/font/big_bold.font>Proceed when you're ready. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "მოუხვიეთ პირდაპირ ქვეითთა გზის კიდისკენ. სარკეებით თვალი ადევნთ, რომ კიდესთან დაშორებას და ამასთანავე, ეცადეთ, არ წააქციოთ საგზაო კონუსები.<br><br><font face=/font/big_bold.font>იმოძრავეთ კიდის გასწვრივ ჩასაყენებელ ადგილამდე.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Secure the truck and shut down the engine.</font>@@aca_goal_tip@@ You can use Interior Look presets to make looking at mirrors easier. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."
#@}

