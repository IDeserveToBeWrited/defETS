#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In this scenario, we'll take the tractor unit for a short drive to see how you handle it with your newly acquired skills."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "There are various types and combinations of turns on the track. It's not a race and it's not about time. Be patient and adjust your driving speed to the turns and obstacles you encounter."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "დასაწყისისთვის მეტად იოლი და ადვილი გასავლელი იქნება, მაგრამ თანდათან მეტად გაძნელდება."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Be mindful of your speed; it's easy to get going too fast and then misjudge a turn."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "The exit from the track is a very tight hairpin turn. Go slow and use all the space available to you."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "ჩააყენეთ დაბრკოლებებს შორის სატვირთო და დაიცავით დაგორებისგან."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "To complete this scenario successfully, you must not crash, drive off of the track, or hit any traffic cones.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Proceed forwards into the sharp right turn to enter the course. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Drive through the turn at a nice steady speed. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "You're approaching a more complex section of winding turns.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly and continue.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "<font face=/font/big_bold.font>Continue towards the next set of turns.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "There are some easy, gentle turns coming. Keep your speed steady.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "The turn out of the course is a sharp hairpin turn. Slow down and stay to the outside before the turn. Be sure to use your mirrors!<br><br><font face=/font/big_bold.font>Turn out of the course. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Ahead of you there is a parking spot between some barriers.<br><br><font face=/font/big_bold.font>Proceed towards the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

