	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Ahead of you are some tight turns with little room to spare. These will help you learn to manoeuvre the trailer effectively."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "Follow the road markings towards the driver's side barrier to prepare for the first turn."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Stay close to the outside barrier through the turn and the trailer should follow you nicely into the course."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Continue to follow the road markings to set up for the second turn, a tight 90 degree corner."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "You'll have to drive deep into the corner to ensure your trailer will clear the inside barriers. Use your front mirror to help you go as far as you can into the corner without hitting anything."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continue along the outer barrier."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "Once again, another tight 90 degree corner will require that you use all the room available to you."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "გააჩერეთ საჭირო ადგილას სატვირთო და დაიცავით დაგორებისგან."

#### 3_15 Driving Instructions



	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Remember to use all the room available to you to help you negotiate each turn.<br><br><font face=/font/big_bold.font>Set off and follow the road markings to the outside. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Follow the outer barrier around, but keep an eye on your trailer in the mirror.<br><br><font face=/font/big_bold.font>Make the first turn. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Follow the road markings to set up for the 90 degree turn ahead.<br><br><font face=/font/big_bold.font>Make the 90 degree turn. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Keep the truck wide after the turn, as you have another even tighter 90 degree turn ahead.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "<font face=/font/big_bold.font>Proceed to the parking spot ahead. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
