#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Final Exam (Part 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "The last part of the final exam awaits you, where the parking skills you've learned in previous scenarios will be evaluated. Park carefully and accurately and you'll be ready to hit the roads of Europe as a skilled trucker!"

#### 3_20 goal



	key[]: "aca_goal_book1_3_20_park1"
	val[]: "ჩადგომა წანაცვლებით"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "ირიბად ჩაყენება"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "სადგომის გავლით მოძრაობა"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "გასწვრივ ჩაყენება"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "საბოლოო ჩაყენება"
#!{
	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

 #!}
#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Welcome to the second part of the final exam. We'll move to a nearby parking lot and test your skills in reversing and manoeuvring into parking spots."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Several consecutive parking challenges await you to assess your abilities."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Space is limited here, so be careful and take your time."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Remember to be careful and not to rush. It's okay if you can't get it in on the first try, the important thing is not to damage the truck or those around you. <font face=/font/big_bold.font><br><br>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Drive forwards to the first part of the exam.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Your first task is to demonstrate the offset parking manoeuvre. The spot where you need to back up with the trailer is on your left.<br><br><font face=/font/big_bold.font>Perform an offset parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "The next task is to back into a row of stationary trucks. Be careful not to hit the other trucks!<br><br><font face=/font/big_bold.font>Perform a diagonal parking manoeuvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Continue through the parking lot. Watch out for unexpected situations.<br><br><font face=/font/big_bold.font>Continue driving.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "ახლა ეცადეთ ჩააყენოთ ქვეითთა სავალი კიდის გასწვრივ ორ სატვირთოს შორის.<br><br><font face=/font/big_bold.font>შეასრულეთ მოძრაობა ჩასაყენებლად.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "One final parking manoeuvre to your left! You can choose to approach this however you wish.<br><br><font face=/font/big_bold.font>Reverse into the designated area.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Almost done. Leave the testing area and park the truck.<br><br><font face=/font/big_bold.font>Exit the test area to your left.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "შეგიძლიათ ჩააყენოთ სატვირთო დანარჩენების მარჯვნივ.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "გასწვრივ ჩაყენება მისაბმელით."

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "ამ მოქმედებაში განვიხილავთ გზის გასწვრივ ჩაყენებას ორ სატვირთოს შორის ჩაბმული მისაბმელით."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "გაჩერება მონიშნულ ადგილას"

#!{
	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

#!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "კიდის გასწვრივ ჩაყენება მისაბმელით მნიშვნელოვანი უნარია სატვირთოს მძღოლისთვის.<br>ქუჩაში დაყენებისთვის დიდ ქალაქში თუ მოსასვენებლად გაჩერებისთვის ქალაქგარეთ, ნებისმიერ მძღოლს შეიძლება დასჭირდეს და ყველამ უნდა იცოდეს."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "As you pass the parking spot, look carefully to ensure there's enough room for the tractor and trailer to fit. Here, we've ensured that you have plenty of room."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Align yourself with the truck in front of the parking spot. Don't be too close to it, keep some distance from it so you have room to work."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Turn sharply away from the parking spot and start reversing. The idea is to get the trailer turning into the parking spot right away."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Once the trailer is pointed well into the spot, you can start to follow it in."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Start steering the trailer away from the kerb before the driver's side trailer wheels have entered the spot."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "გაასწორეთ საწევარი და მისაბმელი, შემდეგ კი მიმართეთ შუისაკენ სადგომ ადგილას.<br> ჩააყენეთ სატვირთო, ჩააქრეთ ძრავა და დაიცავით დაგორებისგან."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "You can see the parking space in front of you, between the other trucks. While parking, be sure to check your mirrors and maintain a safe distance between the truck and the obstacles around you.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Move through the lot to find your parking space.<br><br><font face=/font/big_bold.font>Drive forwards. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Drive past your the desired parking space into the marked area. From here, you can begin your reversing manoeuvre.<br><br><font face=/font/big_bold.font>Stop in the marked spot. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Turn the tractor away from the spot to begin turning the trailer into it. Don't turn too sharply, or you'll head for the kerb. <br><br><font face=/font/big_bold.font>Start reversing. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "გაუსწორეთ მისაბმელი ადგილს. თუ საჭიროა, დაძარით წინ ან უკან სათანადოდ მოტრიალებით სწორად ჩასაყენებლად.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
#@}

#+ Book 1 Outro
#@{
	key[]: "aca_msg_book1_outro01"
	val[]: "გილოცავთ, წარმატებით დაასრულეთ სატვირთოს მართივს საფუძვლების გამოცდები და შეიძინეთ ყველა უნარი, რომელიც საჭიროა სატვირთოს სათანადო მოძრაობისთვის."

	key[]: "aca_msg_book1_outro02"
	val[]: "This is the first step in your journey towards realizing your dream of becoming a professional truck driver."

	key[]:	"aca_msg_book1_outro03"
	val[]: "You're now ready to head out on to the roads of Europe and face your first challenges..."

	key[]: "aca_msg_book1_outro04"
	val[]: "...მაგრამ თავგადასავალი ახლა იწყება."
#@}


# Book 2 formatting
