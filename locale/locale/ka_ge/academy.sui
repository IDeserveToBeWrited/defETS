#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "სანამ გაატარებთ"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "პირველ მოქმედებაში ძირითადად გაეცნობით მძღოლის კაბინას. მეტად მნიშვნელოვანია, სათანადოდ მოირგოთ სავარძელი, საჭე და გვერდითი სარკეები, ვინაიდან მაღალი ხილვადობა გადამწყვეტია ხოლმე დაძაბულ ან სახიფათო პირობებში მოხვედრისას.<br><br>გავივლით ყველა ამ ნაწილის მორგების საშუალებებს."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "სავარძლისა და სარკის მორგება"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "სარკისა და ხილვადობის შემოწმება"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "მოგესალმებით პირველ გაკვეთილზე!<br>დავიწყოთ შესწავლა, როგორ მოვამზადოთ სატვირთო გზებზე გასაყვანად."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "გადამწყვეტი მნიშვნელობა აქვს უსაფრთხოებას, მოხერხებულობასა და მართვის სადაავეების მოუდუნებლობას მთელი გზის განმავლობაში.<br>სავარძლის სათანადოდ მორგება, საჭისა და სარკეების გასწორება კი ამის უზრუნველყოფაში დაგეხმარებათ."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "სატვრითოს თითოელ მხარეს იდგება რამენიმე მანქანა.<br>მათი მეშვეობით შეძლებთ სარკეების სათანადოდ მორგებას."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "დროის დათმობა ყველაფრის საჭიროებისამებრ მორგებისთვის<br>მნიშვნელოვან გავლენას მოახდენს სატვირთოს სრულყოფილად მართვაზე."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "სავარძლისა და საჭის მორგება"

	key[]: "adj_tut_title_1"
	val[]: "მთავარი სარკეების მორგება"

	key[]: "adj_tut_title_2"
	val[]: "ამოზნექილი სარკეების მორგება"

	key[]: "adj_tut_title_3"
	val[]: "ხილვადობის შემოწმება და სარკის საბოლოო მორგება"

