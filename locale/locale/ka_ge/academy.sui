#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "ჩაყენება დაბრკოლების გვერდით"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "In this scenario, we'll learn to park next to a kerb using the side-view mirror."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Check the Side-view Mirror"


	key[]: "aca_goal_book1_2_04_check1"
	val[]: "წინსვლა ქვეითთა გზის კიდისკენ"
#!{
	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

