	val[]: "ძრავას დაქოქვა"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "მგზავრის გვერდითი სარკის შემოწმება"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "მძღოლის გვერდითი სარკის შემოწმება"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "სიჩქარეში ჩაგდება"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "ხელის მუხრუჭის მოხსნა"

