	key[]: "aca_scenario_book1_2_09_title"
	val[]: "გასწვრივ ჩაყენება"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "ამ მოქმედებაში განვიხილავთ გზის გასწვრივ ჩაყენებას ორ სატვირთოს შორის."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "გაჩერება სადგომის წინ"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Checking the Rear View Mirror"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "უკუსვლით სადგომ ადგილას"

