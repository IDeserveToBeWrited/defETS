#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "ადგილის საგულდაგულოდ შეთვალიერება, საითკენაც მოძრაობთ, უსაფრთხო და პროფესიონალური მართვის საწინდარია. თუ სავარძლის მდებარეობა არ გიწყობთ ხელს, მოსარგებად იხილეთ '@@adjust_link_t@@' (ხელმისაწვდომია თამაშის შეჩერებისას).<br><br><font face=/font/big_bold.font>დაადასტურეთ მზადყოფნა ღილაკით @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "უკუსვლისას სარკეები ყოველთვის არ იძლევა სრულყოფილი ხედვის საშუალებას. შეიძლება მოგიწიოთ ფანჯრიდან გახედვა უკეთ დასანახად.<br><br><font face=/font/big_bold.font>მოაბრუნეთ კამერა მძღოლის მხარეს ფანჯრიდან გასახედად უკან, მისაბმელისკენ.</font>@@aca_goal_tip@@ ამ დროს სატვირთოში უნდა იმყოფებოდეთ."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "ამ ხედით თვალს ადევნებთ მისაბმელს უკუსვლისას. ყოველთვის უმჯობესია, მძღოლის მხარეს ეცადოთ  მობრუნებას, რომ ეს ხედი გამოგადგეთ. მგზავრის მხარეს მობრუნებისას მეტად შეზღუდულად გამოჩნდება, რა ხდება უკან.<br><br><font face=/font/big_bold.font>გაიხედეთ მგზავრის მხარეს. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "სწორედ ამიტომაა ნაკლებ სასურველი უკუსვლა მგზავრის მხრიდან; შეამჩნევდით, რომ ხედი მეტად შეზღუდულია. საბედნიეროდ, შვიდი გარე კამერაა ხელმისაწვდომი დამატებით. <br><br>ღილაკი @@imv_nrm_camcycle@@ გამოგადგებათ მომდევნო კამერაზე გადასასვლელად. ყველა კამერის რიგრიგობით მოვლის შემდეგ დაუბრუნდებით საწყისს. <br><br><font face=/font/big_bold.font>დააჭირეთ ღილაკს @@imv_nrm_camcycle@@ მომდევნო კამერის ასარჩევად. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "გარე კამერა საუკეთესოდ გაჩვენებთ რა ხდება მანქანის ირგვლივ.<br><br><font face=/font/big_bold.font>მიმოიხედეთ სატვირთოს გარშემო.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>კვლავ დააჭირეთ ღილაკს @@imv_nrm_camcycle@@ მომდევნო კამერის ასარჩევად. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "ზედხედი საშუალებას გაძლევთ უკეთ შეაფასოთ გარემო პირობები სატვირთოს ირგვლივ, მნიშვნელოვნად აიოლებს ჩაყენებასა და მართვას ვიწრო ადგილებში.<br><br><font face=/font/big_bold.font>დააჭირეთ ღილაკს @@imv_nrm_camcycle@@ მომდევნო კამერის ასარჩევად.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "სახურავის კამერა გთავაზობთ გზის ფართო ხედს სატვირთოდან დაბრკოლებების გარეშე.<br><br><font face=/font/big_bold.font>დააჭირეთ ღილაკს @@imv_nrm_camcycle@@ მომდევნო და დღეისთვის ბოლო კამერის ასარჩევად.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "უკანა ხედი უფრო იოლი და სწრაფი შემნაცვლებელია ზემოთ ნახსენები კამერის მობრუნებისა. როგორც აღვნიშნეთ, მეტად გამოსადეგია უკუსვლით ჩაყენებისას.<br><br>თამაშში ხელმისაწვდომია კიდევ სხვა კამერებიც, რომელთა მოსინჯვაც შესაძლებელია ღილაკით @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>დააჭირეთ ღილაკს @@imv_nrm_cam1@@ სალონში დასაბრუნებლად.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "პირველი გატარება"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "ამ მოქმედებაში გაეცნობით, როგორ მოამზადოთ სატვირთო დასაძრავად და შემდეგ გაიაროთ წინსვლით პირველად."

