#+ Book 1 intro
#@{
	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "მოგესალმებათ @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "მოცემული მოქმედებები წარმოადგენს თქვენს პირველ ნაბიჯებს სატვირთოს გამოცდილ მძღოლად ჩამოყალიბებაში."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "აქ შეისწავლით სატვირთოს ძირეული მართვის სისტემისა და საშუალებებიდან დაწყებული..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...რთულ მოძრაობებამდე ჩაბმული მისაბმელით თუ მის გარეშე."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "ჩვენ დაგეხმარებით უნარ-ჩვევების გამომუშავებაში უსაფრთხოდ გადაადგილებისთვის სხვადასხვა გარემო პირობებში,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "და შეგასწავლით, როგორ გამოიყენოთ თქვენ ირგვლივ სივრცე გონივრულად და შედეგიანად სატვირთოს მოძრაობისთვის."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "ყველა მოცემული მოქმედების შესრულებით და საბოლოო გამოცდის ჩაბარებით,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "მომზადებული იქნებით ევროპული გზების დასაპყრობად და ახალ გამოწვევებთან შესაჭიდებლად."

