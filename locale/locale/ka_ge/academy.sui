#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "მართვისა და მოძრაობის საფუძვლები"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "შეისწავლეთ მანქანის ძირეული მართვა, როგორ დაძრათ წინ და უკან."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>გილოცავთ!<br>შესრულებულია თავი 1: @@aca_chapter_book1_1_title@@.<br><br>უკვე შეისწავლეთ, როგორ მოამზადოთ სატვირთო მართვის დაწყებამდე,<br>როგორ დაიძრათ წინ, უკან და ამასთანავე, როგორ გამოიყენოთ ფარები და მინასაწმენდები.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "მოძრაობის საფუძვლები"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "შეისწავლეთ მართვა, მოძრაობა და ჩაყენება სატვირთოთი. გაეცანით თითოეული სარკის დანიშნულებასა და გამოყენების გზებს."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>გილოცავთ!<br>შესრულებულია თავი 2: @@aca_chapter_book1_2_title@@.<br><br>უკვე შეისწავლეთ, როგორ გამოიყენოთ მანქანის თითოეული სარკე და როგორ შეამოწმოთ სატვირთოს ირგვლივ სივრცე დაძვრამდე, ამასთანავე, გაეცანით მარტივ და რთული სახის გადაადგილებას.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "მოძრაობა მისაბმელით"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "შეისწავლეთ, როგორ ჩაიბათ და იმოძრაოთ მისაბმელით სხვადასხვა პირობებში."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>გილოცავთ!<br>შესრულებულია თავი 3: @@aca_chapter_book1_3_title@@.<br><br>უკვე შეისწავლეთ მისაბმელის ჩაბმა, ჩახსნა,<br>წონისა თუ ზომების აღქმა მისაბმელთან ერთად<br>და ძნელად დასაძლევი გზების გავლა მისაბმელით.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "უკუსვლა მისაბმელით"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "შეისწავლეთ ახალი მოძრაობები მისაბმელით გონივრულად უკუსვლისა და ჩაყენებისთვის."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>გილოცავთ!<br>შესრულებულია თავი 4: @@aca_chapter_book1_4_title@@.<br><br>უკვე შეისწავლეთ მისაბმელით უკუსვლა<br>და ჩაყენების სხვადასხვა ხერხი.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "საბოლოო გამოცდა"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "გამოამჟღავნეთ თქვენი ცოდნა და უნარები, დაამტკიცეთ, რომ ღირსი ხართ, მართოთ სატვირთო!"

	key[]: "aca_chapter_book1_5_completed"
