#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "ამ მოქმედებაში გაეცნობით სატვირთოს ზოგიერთ მახასიათებელს, რომელიც უზრუნველყოფს სათანადო ხილვადობასა და იმასაც, რომ სხვებმაც სათანადოდ დაგინახონ."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "აამოქმედებთ სინათლის სხვადასხვა რეჟიმებს და შეისწავლით, რომელი რისთვისაა საჭირო."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "გამოვიყენებთ მარცხნივ და მარჯვნივ მოხვევის ციმციმას."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "დაბოლოს, მოირგებთ მინასაწმენდებს, რომ დაწმუნდეთ, სათანადოდ იმუშავებს თუ არა სხვადასხვა სიუხვის ნალექის პირობებში."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "განვიხილოთ სხვადასხვა სახის ნათების გამოყენება, აგრეთვე, საქარი მინის საწმენდები.<br><br>ახლო და შორი ნათების მაშუქები გასავლელი გზის უკეთ დასანახად. მოხვევისა და ავარიულის ციმციმები, რომ მოძრაობის დანარჩენ მონაწილეებს წინასწარ აცნობოთ, საითკენ აპირებთ მოძრაობას.<br><br>საწმენდები უზრუნველყოფს საქარე მინის გასუფთავებას წყლისა და მტვრის სხვა ნაწილაკებისგან.<font face=/font/big_bold.font><br><br>დაქოქეთ ძრავა, მაგრამ არ აუშვათ ხელის მუხრუჭი. </font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "აქამდე თქვენ მხოლოდ დღის სინათლეებს იყენებდით. თავისთავად ირთვება ხოლმე მანქანის გასაღებით ანთებისას, რომ ჩვეულ პირობებში გააუმჯობესოს ხილვადობა. უამინდობის დროს კი, როცა უარესდება გარემო პირობები, საჭირო ხდება სინათლეების სრული რეჟიმით გამოყენება.<font face=/font/big_bold.font><br><br>დააჭირეთ @@imv_nrm_light@@ გაბარიტული მაშუქების ჩასართავად. </font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>საგაბარიტო მაშუქები ანათებს წინ, გვერდით და უკან მანიშნებლად. გამოსადეგია ცუდად განათებულ პირობებში დგომისას, რომ სხვა მძღოლებმა შეძლონ თქვენი დანახვა.<font face=/font/big_bold.font><br><br>დააჭირეთ @@imv_nrm_light@@, ახლოს მაშუქზე რომ გადართოთ. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>ახლოს მაშუქი სანათები გზას გინათებთ წინ და ხილულს ხდის მანქანას დაბალი განათების პირობებში.<font face=/font/big_bold.font><br><br>გამოიყენეთ @@imv_nrm_hblight@@, რომ გადართოთ შორს მაშუქზე. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>შორს მაშუქი სანათები საშუალებას გაძლევთ, მოშორებითაც დაინახოთ გზა დაბალი განათების პირობებში.<br><br>ეცადეთ, გონივრულად გამოიყენოთ, ვინაიდან შეიძლება თვალი მოსჭრას გზაზე სხვებს, განსაკუთრებით კი საპირისპიროდ მოძრავ მძღოლებს. გათიშეთ ხოლმე შორს მაშუქი სხვა მანქანების მოახლოებისას.<font face=/font/big_bold.font><br><br>გამოიყენეთ @@imv_nrm_hblight@@, რომ გამორთოთ შორს მაშუქი სანათები. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "ახლა კი გადავიდეთ მოხვევის ციმციმაზე. ესაა ვიზუალური მანიშნებელი საგზაო მოძრაობის სხვა მონაწილეთათვის, რომ ზოლის შეცვლას აპირებთ და საითკენ აპირებთ გადასვლას.<font face=/font/big_bold.font><br><br>დააჭირეთ @@imv_nrm_lblinker@@ რომ აამოქმედოთ მარცხენა ციმციმა. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>შენიშნავდით, რომ მარცხენა მოხვევის მანიშნებელი აციმიცმდებოდა სატვირთოს მაჩვენებლების დაფაზეც.<font face=/font/big_bold.font><br><br>ახლა კი დააჭირეთ @@imv_nrm_lblinker@@ მარცხენა ციმციმის გასათიშად. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "მიმართულების შეცვლის მანიშნებლები დროულად უნდა ჩართოთ, რომ საგზაო მოძრაობის დანარჩენ მონაწილეებს ჰქონდეთ საშუალება, გაითვალისწინონ და შესაბამისად იმოქმედონ<font face=/font/big_bold.font><br><br>დააჭირეთ @@imv_nrm_rblinker@@ მარჯვენა ციმციმის ჩასართავად. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>მაჩვენებლების დაფაზე აციმციმდება მარჯვნივ მოხვევის ნათურა. იმავდროულად მოხვევის ციმციმა აინთებოდა სატვირთოს მარჯვენა მხარეს.<font face=/font/big_bold.font><br><br>ახლა კი დააჭირეთ @@imv_nrm_rblinker@@, რომ გამოირთოს მარჯვენა ციმციმა. </font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>ავარიული მაშუქების ჩამრთველს აქვს წითელი სამკუთხა ნიშანი. მას დიდი მნიშვნელობა ენიჭება გზაზე უსაფრთხოებისთვის და უნდა გამოიყენებოდეს მხოლოდ საჭიროებისამებრ. იგი ერთდროულად აამოქმედებს მარცხენა და მარჯვენა მოხვევის მაშუქებს.<font face=/font/big_bold.font><br><br>დააჭირეთ @@imv_nrm_flasher4way@@, რომ ჩაირთოს ავარიული განათება.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>მოხვევის ორივე მანიშნებელი ციმციმებს ახლა, რაც მიუთითებს, რომ ავარიულებია ჩართული. აგრეთვე იციმციმებს სატვირთოს ორივე მხარეს.<br><br>ავარიულები გამოიყენება მაშინ, როცა სატვირთო გაჩერებულია არასათანადო ადგილას, მაგალითად გზის პირას, ტექნიკური ან მექანიკური ხარვეზის გამო. აგრეთვე გამოიყენება ხოლმე უკან მომავალი მძღოლების შესატყობინებლად, რომ წინ მოძრაობა გაჩერებულია.<font face=/font/big_bold.font><br><br>ახლა კი დააჭირეთ @@imv_nrm_flasher4way@@ ავარიულების გამოსართავად. </font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "ახლა კი გადავიდეთ საქარე მინის საწმენდებზე. საქარე მინის საწმენდები გამოიყენება წვიმის წვეთებისა და სხვა ნაწილაკების მოსაცილებლად საქარე მინიდან. მათი მთავარი დანიშნულებაა, საქარე მინა მუდამ იყოს სუფთა და გამჭვირვალე. მინასაწმენდებს რამდენიმე სიჩქარე აქვს.<br><br><font face=/font/big_bold.font>დააჭირეთ @@imv_nrm_wipers@@ რომ შეარჩიოთ ქანქარის სისწრაფე. </font>@@aca_goal_tip@@ საქმიანობისას, შეგეძლებათ გამოიყენოთ წვიმის აღმქმელი, რომელიც თავისით ჩართავს საქარე მინის საწმენდებს წვიმის წამოსვლისას. შეგიძლიათ მონახოთ @@rain_sensor@@ პარამეტრებში, „თამაშის“ განყოფილებაში."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "ამ პარამეტრის მეშვეობით მინასაწმენდები დროდადრო ამოქმედდება. გამოსადეგია, როცა ნალექი მეტად წვრილია.<br><br>როგორც ამჩნევთ, მეტად ძლიერად წვიმს და საწმენდები ვერ უმკლავდება საქარე მინაზე მოხვედრილ წვეთებს.<font face=/font/big_bold.font><br><br>კვლავ დააჭირეთ @@imv_nrm_wipers@@ თუ გსურთ მინასაწმენდები გადაირთოს დაბალ სიჩქარეზე. </font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "ახლა უკვე მინასაწმენდები მუდმივ სიჩქარეზე მუშაობს წვეთების მოსაცილებლად.<font face=/font/big_bold.font><br><br>კიდევ დააჭირეთ @@imv_nrm_wipers@@ ასასწრაფებლად. </font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "You can see the wipers are working much faster now to clear the windscreen for maximum visibility. <font face=/font/big_bold.font><br><br>Press @@imv_nrm_wipers@@ to turn the wipers off. </font>@@aca_goal_tip@@ You can also use the @@o_im_wipers_back@@ function to cycle backwards through the wipers speed settings. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "როგორც ამჩნევთ, საწმენდები მეტად სწრაფად მუშაობს და ინარჩუნებს საქარე მინის უმაღლეს ხილვადობას. <font face=/font/big_bold.font><br><br>დააჭირეთ @@imv_nrm_wipersback@@ რამდენჯერმე, სანამ საწმენდები არ გაითიშება. </font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>გათიშეთ სინათლე და ჩააქრეთ ძრავა. </font>"
#@}

