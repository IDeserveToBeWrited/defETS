#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Welcome to the first part of the final exam. Here, we'll see how well you've learned to drive a truck after your time at the Academy."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "First, you'll attach the trailer. Once coupled, you'll drive the truck around the entire test area."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "The first section of the track leads from the small parking lot to the eastern test course."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "The circuit includes challenging passages between barriers."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "A significant part of the route goes through the eastern test course."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "We'll test your ability to manoeuvre the truck through different situations."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "You'll manoeuvre with the truck through some sharp turns."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "You'll drive through the road section connecting the courses."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "The final part involves driving through the small circuit."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "The circuit has many intricate passages and sharp turns."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "To complete the test, you'll need to park accurately."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "There's no need to be nervous, you've already learned everything that will required to pass.<br><br>Good luck!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Ahead of you is the trailer.<br><br><font face=/font/big_bold.font>Drive towards the trailer. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "გაუსწორეთ საწევარი მისაბმელს.<br><br><font face=/font/big_bold.font>უკუსვლით იარეთ ჩასაბმელ ღერძთან მოდებისთვის. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>დაიცავით სატვირთო დაგორებისგან. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "Press @@imv_nrm_attach@@<font face=/font/big_bold.font> to connect the trailer. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "The trailer is connected, and the truck is ready to drive.<br><br><font face=/font/big_bold.font>Release the parking brake. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "<font face=/font/big_bold.font>Start driving towards the exit of the parking lot. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Follow the road markings and watch out for barriers.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "A more challenging section is coming up.<br><br><font face=/font/big_bold.font>Carefully navigate between the barriers. </font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "<font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "This part will test your skills at manoeuvring a trailer around different kinds of corners.<br><br><font face=/font/big_bold.font>Turn onto the course. </font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "<font face=/font/big_bold.font>Drive through the passage. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "<font face=/font/big_bold.font>Drive straight. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "<font face=/font/big_bold.font>Carefully navigate the turn. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "You're entering a more complex section. Drive carefully.<br><br><font face=/font/big_bold.font>Continue driving downhill. </font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "<font face=/font/big_bold.font>Make the sharp left turn. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "<font face=/font/big_bold.font>Exit the circuit. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "You're entering an easier section.<br><br><font face=/font/big_bold.font>Continue driving down the hill. </font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "<font face=/font/big_bold.font>Keep driving on the road. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "Ahead is the turn onto the next course.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Turn right. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "<font face=/font/big_bold.font>Continue driving on the course. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Ahead are more sharp turns.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Make a left turn. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "<font face=/font/big_bold.font>Enter the turn, continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "To make the turn, you may need to go off the asphalt slightly.<br><br><font face=/font/big_bold.font>Turn carefully, use as much space as you need. </font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Exit the circuit and drive into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

