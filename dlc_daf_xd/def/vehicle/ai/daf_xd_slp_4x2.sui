traffic_vehicle : traffic.daf.xd.slp_4x2
{
	accessories[]: .daf.xd.slp_4x2.chassis
	accessories[]: .daf.xd.slp_4x2.fwheel
	accessories[]: .daf.xd.slp_4x2.rwheel
	accessories[]: .daf.xd.slp_4x2.trlr_cables

	max_speed: 90

	trailer_chains[]: "truck_semi low"
	
	tags[]: dealer

	sound_move[]: "/sound/traffic/truck_eu_2.soundref"
	sound_move[]: "/sound/traffic/truck_eu_4.soundref"
	sound_horn[]: "/sound/traffic/truck_horn_1.soundref"
	sound_horn[]: "/sound/traffic/truck_horn_5.soundref"

	vehicle_mass: 7440
	engine_power: 336

	#color from upgrade shop
	color[]: (0.0948, 0.101, 0.1102) #gray
	color[]: (0.8307, 0.8307, 0.8307) #white
	color[]: (0.2269, 0.0129, 0.0129) #red
	color[]: (0.0251, 0.0578, 0.1328) #blue
	color[]: (0.701102, 0.584079, 0.008023) #Tuscan Yellow
	color[]: (0.104616, 0.434154, 0.003347) #Mantis Green
	color[]: (1.000000, 0.198000, 0.004300) #Electric Orange
	color[]: (0.031896, 0.283149, 0.723055) #Jamaica Blue
	

	spawn_ratio: 0.05

@include "drivers_generic.sui"
}

