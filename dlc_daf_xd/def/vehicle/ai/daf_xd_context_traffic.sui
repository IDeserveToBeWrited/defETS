	color[]: (0.104616, 0.434154, 0.003347) #Mantis Green
	color[]: (1.000000, 0.198000, 0.004300) #Electric Orange
	color[]: (0.031896, 0.283149, 0.723055) #Jamaica Blue

	tags[]: dealer
	tags[]: context

	spawn_condition[]: .traffic.daf.xd.slp_4x2.context.spawn.condition
	spawn_condition[]: .traffic.daf.xd.slp_4x2.context.spawn.condition2


