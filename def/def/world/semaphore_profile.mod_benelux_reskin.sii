tr_semaphore_profile : tr_sem_prof.2ph.belgium
{

	name: "two phases - Belgium"

	inherited: tr_sem_prof.2ph
	
	interval[]: (15.0, 2.0, 23.0, 0.0)		# green > yellow > red > yellow
	
	sleep_time_start: 1410			 		# 23:30
	sleep_time_end: 180 					# 03:00

}

