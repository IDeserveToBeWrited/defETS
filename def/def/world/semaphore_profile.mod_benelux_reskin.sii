SiiNunit
{
# For modders: Please do not modify this file if you want to add a new entry. Create in
# this directory a new file "<base_name>.<idofyourmod>.sii" where <base_name> is name of
# base file without the extension (e.g. "city" for "/def/city.sii") and <idofyourmod> is
# some string which is unlikely to conflict with other mod.

tr_semaphore_profile : tr_sem_prof.zal_br
{
	name: "drawbridge_zelzatebrug"
	
	# Minimum delay after orange-to-green distance before barriers go up
	cycle[]: 1.0
	
	# NOTE: 'barrier_distance' semaphore locators are used for *detecting mover* in map which will activate the bridge
	# they must be placed in the middle of the bridge at the *expected water level* (i.e. *below* the bridge)
	
	# Distances in [m]:
	#
	# crossing <-> object rear (green)
	# object front <-> crossing (orange-to-red)
	# object front <-> crossing (red)
	# crossing <-> object rear (orange-to-green)
	#
	# moving bridge part - 'functional' locator with no model
	type[0]: barrier_distance
	model[0]: ""
	interval[0]: (15.0, 150.0, 145.0, 15.0)     # Activation distances in [m] for mover speed 5.0 m/s
	id_map[0]: 0
	
	# barriers around the bridge - 'functional' locator with no model
	type[1]: barrier_distance
	interval[1]: (175.0, 180.0, 155.0, 175)   # Activation distances in [m] for mover speed 5.0 m/s
	model[1]: ""
	id_map[1]: 1

	# semaphores around the bridge - 'functional' locator with no model
	type[2]: barrier_distance
	interval[2]: (180.0, 181.0, 165.0, 175)   # Activation distances in [m] for mover speed 5.0 m/s
	model[2]: ""
	id_map[2]: 2
	
	# the rest of semaphore locators (ID 2+) are just models 'obeying' corresponding functional locators
	type[3]: model_only
	
	# model of moving bridge part
	id_map[3]: 0
	model[3]: "zelz_br"

	# models of bariers
	id_map[4]: 1
	model[4]: "bar_br_13"

	id_map[5]: 1
	model[5]: "bar_br_13"

	id_map[6]: 2
	model[6]: "col_br_01"

	id_map[7]: 2
	model[7]: "col_br_01"

	
}

