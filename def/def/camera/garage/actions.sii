SiiNunit
{

#
# See '/base/def/world/trigger_action.sii' for available commands
#

cutscene_action : _nameless.cutscene_act.1
{
	cutscene_time: 0.0

	command: "ui_create"
	str_params[]: "ui"
	str_params[]: "/ui/cutscene_base.sii"
}

cutscene_action : _nameless.cutscene_act.2
{
	cutscene_time: 0.5

	command: "music"

	str_params[]: "/sound/music/cutscene.soundref"
	num_params[]: 0.5
}

cutscene_action : _nameless.cutscene_act.3
{
	cutscene_time: 1.0

	command: "ui_show"
	str_params[]: "ui"
}

}
