SiiNunit
{
bus_economy_data : bus_economy.data
{
	# Maximum number of stops for one bus line, including the source stop (so must be at least 2)
	stops_per_route_max: 10

	# how many routes will be generated from each city
	#
	departures_per_city_min: 4
	departures_per_city_max: 8

	# How many tourist job offers will be generated from each city
	tourist_departures_per_city_min: 4
	tourist_departures_per_city_max: 8

	# Determines how many closest valid candidates are considered when randomly selecting the next stop,
	# candidates are sorted by distance (increasing).
	selection_count_max: 8

	# Same as selection_count_max but for tourist offers.
	tourist_selection_count_max: 12

	# Hard limit on how many closest candidates are considered when selecting a next stop,
	# even if max selection count hasn't been reached. Candidates are sorted by distance (increasing).
	selection_range_max: 50

	# Stop generation of bus line offer after traffic side change is reached.
	traffic_side_change: last_stop

	# Throw away bus line offer if the percentage of time spent on a ferry is larger than this
	max_ferry_time_percentage: 55

	# Same as max_ferry_time_percentage but for tourist offers.
	tourist_max_ferry_time_percentage: 85

	# the maximal direction difference used to generate every next segment of the route.
	# When new route segment is generated it measures the angle between the last segment
	# and the newly generate one and when the angle is bigger than this limit the code tries
	# to use different city.

	route_dir_diff: 65.0  # degrees

	# Minimum distance a tourist stop must be from a previous stop in km.
	tourist_stop_distance_min_km: 20

	# Maximum distance a local tourist stop can be from the source stop in km.
	tourist_stop_local_distance_max_km: 400

	# Maximum distance a global tourist stop can be from the source stop in km.
	tourist_stop_global_distance_max_km: 1000

	# Factor that multiplies time estimations of bus line offer.
	# Multiplies also per-country factors in /def/country/<country>/bus_data.sii
 	offer_time_factor: 1.0

 	# Additional time per stage added to bus line offer time estimations (in game minutes).
	offer_additional_time_stage_m: 15

	# Factor that multiplies time estimations of tourist offers.
 	tourist_offer_time_factor: 1.3

 	# Additional time per stage added to tourist offer time estimations (in game minutes).
	tourist_offer_additional_time_stage_m: 15

	# Hour when day starts, used for generating arrival times for tourist stops.
	tourist_day_start_hour: 6

	# Hour when evening starts, used for generating arrival times for tourist stops.
	tourist_evening_start_hour: 18

	# Hour when night starts, used for generating arrival times for tourist stops.
	tourist_night_start_hour: 0

	# Determines the weight used for low priority tourist bus stops.
	# The lower the weight is relative to other priority weights, the lower the chance of being selected.
	tourist_low_prio_weight: 2

	# Determines the weight used for mid priority tourist bus stops.
	# The lower the weight is relative to other priority weights, the lower the chance of being selected.
	tourist_mid_prio_weight: 3

	# Determines the weight used for high priority tourist bus stops.
	# The lower the weight is relative to other priority weights, the lower the chance of being selected.
	tourist_high_prio_weight: 4

	satisfaction_new_passenger: (0.45, 0.8)

	satisfaction_new_passenger_core_wear_limit: 0.2
	satisfaction_new_passenger_core_wear_penalty: (0.04, 0.08)
	satisfaction_new_passenger_core_wear_reward: (0.02, 0.04)

	satisfaction_penalty_cooldown_time_s: 5

	satisfaction_acceleration_limits[]: (6.0, 6.0, 6.0)
	satisfaction_acceleration_penalties[]: (0.09, 0.18)
	satisfaction_acceleration_probabilities[]: 1.0

	satisfaction_acceleration_limits[]: (1000.0, 1000.0, 11.0)
	satisfaction_acceleration_penalties[]: (0.6, 0.9)
	satisfaction_acceleration_probabilities[]: 1.0
	satisfaction_accelaration_capture_time_s: 3

	satisfaction_crash_limits_kph[]: 6.0
	satisfaction_crash_penalties[]: (0.05, 0.1)

	satisfaction_speed_trigger_kph: 130.0
	satisfaction_speed_trigger_time_s: 5
	satisfaction_speed_penalty: (0.09, 0.18)

	satisfaction_core_wear_limits[]: 0.01
	satisfaction_core_wear_penalties[]: (0.10, 0.28)

	satisfaction_core_wear_limits[]: 0.05
	satisfaction_core_wear_penalties[]: (0.22, 0.46)

	satisfaction_late_time_m: 15
	satisfaction_late_penalty: (0.05, 0.13)

	satisfaction_offence_penalty: (0.10, 0.20)

	satisfaction_no_penalty_reward_distance_km: 30
	satisfaction_no_penalty_reward: (0.06, 0.12)

	satisfaction_no_penalty_stage_reward: (0.06, 0.12)

	satisfaction_on_time_reward: (0.06, 0.18)

	failure_acceleration_limit: (-1.0, -1.0, 22.0)

	reward_medal[]:		"delivery2"
	reward_medal[]:		"delivery1"
	reward_medal[]:		"delivery4"
	reward_medal[]:		"delivery3"
	reward_medal[]:		"delivery5"
	reward_medal[]:		"delivery5"
	reward_medal[]:		"delivery0"

	reward_title[]:		"@@bus_job_reward_level_0_t@@"
	reward_title[]:		"@@bus_job_reward_level_1_t@@"
	reward_title[]:		"@@bus_job_reward_level_2_t@@"
	reward_title[]:		"@@bus_job_reward_level_3_t@@"
	reward_title[]:		"@@bus_job_reward_level_4_t@@"
	reward_title[]:		"@@bus_job_reward_level_5_t@@"
	reward_title[]:		"@@bus_job_reward_level_6_t@@"

	reward_name[]:		"@@bus_job_reward_level_0@@"
	reward_name[]:		"@@bus_job_reward_level_1@@"
	reward_name[]:		"@@bus_job_reward_level_2@@"
	reward_name[]:		"@@bus_job_reward_level_3@@"
	reward_name[]:		"@@bus_job_reward_level_4@@"
	reward_name[]:		"@@bus_job_reward_level_5@@"
	reward_name[]:		"@@bus_job_reward_level_6@@"

	reward_satisfaction_level[]:	0.86
	reward_satisfaction_level[]:	0.72
	reward_satisfaction_level[]:	0.58
	reward_satisfaction_level[]:	0.43
	reward_satisfaction_level[]:	0.29
	reward_satisfaction_level[]:	0.15
	reward_satisfaction_level[]:	0.0

	reward_color[]: (1.00, 0.78, 0.05)
	reward_color[]: (0.29, 0.51, 0.89)
	reward_color[]: (0.57, 1.00, 0.45)
	reward_color[]: (0.34, 0.29, 0.92)
	reward_color[]: (1.00, 0.25, 0.20)
	reward_color[]: (1.00, 0.25, 0.20)
	reward_color[]: (1.00, 0.00, 0.00)

	#define the passengers per slot

	passengers[]: .passengers.common

	bus_stop_cutscenes[]: bus_st_def

	# Tourist stops which are considered global.
	# Global tourist stops can be farther from the source bus stop than local ones (see tourist_stop_global_distance_max_km).
	# Bus stop names are composed as follows:
	# 1. City stops (bus terminals): bus_stop.city.[city_name]; e.g. bus_stop.city.prague
	# 2. Tourist stops linked to album items: bus_stop.[album_item_type].[album_item_name]; e.g. bus_stop.viewpoints.deduisburg

}

bus_passenger_data : .passengers.common
{
	low_detail_mover: 	mover.bus.pass.low
	medium_detail_mover: 	mover.bus.pass.medium
	high_detail_mover: 	mover.bus.pass.high
}

mover_model_group : mover.bus.pass.high
{
	desc_tags[]: bus
	desc_tags[]: seat
	desc_tags[]: high

	anim_tags[]: bus
	anim_tags[]: sitting

	lod_index_range: (0, 0)
}

mover_model_group : mover.bus.pass.medium
{
	desc_tags[]: bus
	desc_tags[]: seat

	anim_tags[]: bus
	anim_tags[]: sitting

	lod_index_range: (0, 0)
}

mover_model_group : mover.bus.pass.low
{
	desc_tags[]: bus
	desc_tags[]: seat

	anim_tags[]: bus
	anim_tags[]: sitting

	lod_index_range: (1, 1)
}
}
