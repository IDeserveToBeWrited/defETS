#		1 = Lowpass 12dB, 2 = Lowpass 24dB, 3 = Lowpass 48dB.
#		4 = Highpass 12dB, 5 = Highpass 24dB, 6 = Highpass 48dB.
#		7 = Lowshelf, 8 = Highshelf, 9 = Peaking, 10 = Bandpass, 11 = Notch, 12 = Allpass
