# Configuration of the sound effects for the cabin interior/exterior sound equalizations.
	effect_equalizer_cabin_inside: .effect.equalizer.cabin.inside
	effect_equalizer_cabin_outside: .effect.equalizer.cabin.outside

# Configuration of the sound effects for the cabin interior/exterior sound multiband equalizations.
	effect_multiband_eq_cabin_nodes: .effect.multiband.cabin.nodes
	effect_multiband_eq_cabin_inside: .effect.multiband.cabin.inside
	effect_multiband_eq_cabin_outside: .effect.multiband.cabin.outside

# Configuration of the sound effects for the interior reverb and the windows opening sound equalizations.
	effect_reverb_window_closed: .effect.reverb.window.closed
	effect_reverb_window_opened: .effect.reverb.window.opened
	effect_add_window_eq_closed: .effect.add.window_eq.closed
	effect_add_window_eq_opened: .effect.add.window_eq.opened

# Multiband eq versions for windows opening
	effect_add_window_multiband_eq_nodes: .effect.add.window_eq.multiband.nodes
	effect_add_window_multiband_eq_closed: .effect.add.window_eq.multiband.closed
	effect_add_window_multiband_eq_opened: .effect.add.window_eq.multiband.opened