# XXXXXXXXXXXXXXXXXXX Police Germany - Combi XXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.betrude.premium_24.combi.de
{
	accessories[]: .betrude.premium_24.combi.de.chassis
	accessories[]: .betrude.premium_24.combi.de.fwheel
	accessories[]: .betrude.premium_24.combi.de.rwheel

	max_speed: 220

	vehicle_mass: 2000
	spawn_ratio: 0.0

	sound_move[]: "/sound/traffic/car_default_2.soundref"
	sound_move[]: "/sound/traffic/car_normal_3.soundref"

	color[]: (1, 1, 1) #white


@include "drivers_generic_police.sui"
}

vehicle_accessory: .betrude.premium_24.combi.de.chassis
{
	data_path: "/def/vehicle/ai/betrude_premium_24/chassis_c_de.sii"
}

vehicle_wheel_accessory: .betrude.premium_24.combi.de.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_18in.sii"
}

vehicle_wheel_accessory: .betrude.premium_24.combi.de.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_18in.sii"
}

