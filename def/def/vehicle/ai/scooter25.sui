traffic_vehicle : traffic.scooter25
{
	accessories[]: .scooter25.chassis
	accessories[]: .scooter25.fwheel
	accessories[]: .scooter25.rwheel

	max_speed: 60

	vehicle_mass: 200

	tags[]: motorbike

}

vehicle_accessory: .scooter25.chassis
{
	data_path: "/def/vehicle/ai/scooter25/chassis.sii"
}

vehicle_wheel_accessory: .scooter25.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_empty_10cm.sii"
}

vehicle_wheel_accessory: .scooter25.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_empty_10cm.sii"
}