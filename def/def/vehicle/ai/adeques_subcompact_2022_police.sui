# XXXXXXXXXXXXXXXXXXX Belgium Police XXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.adeques.subcompact.bg
{
	accessories[]: .adeques.subcompact.bg.chassis
	accessories[]: .adeques.subcompact.bg.fwheel
	accessories[]: .adeques.subcompact.bg.rwheel

	max_speed: 160

	vehicle_mass: 1600

	sound_move[]: "/sound/traffic/car_default_2.soundref"
	sound_move[]: "/sound/traffic/car_diesel_2.soundref"
	sound_move[]: "/sound/traffic/car_sport_1.soundref"

	spawn_ratio: 0

@include "drivers_generic_police.sui"


@include "drivers_generic.sui"	
}

vehicle_accessory: .adeques.subcompact.bg.chassis
{
	data_path: "/def/vehicle/ai/adeques_subcompact_2022/chassis_bg.sii"
}

vehicle_wheel_accessory: .adeques.subcompact.bg.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_17in.sii"
}

vehicle_wheel_accessory: .adeques.subcompact.bg.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_17in.sii"
}