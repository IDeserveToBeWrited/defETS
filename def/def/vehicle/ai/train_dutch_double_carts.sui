

###---cart1---

traffic_trailer : train_car.dd.cart1
{
	accessories[]: .dd.cart1.chassis
	accessories[]: .dd.cart1.rwheel0
	accessories[]: .dd.cart1.rwheel1
	

	sound_move: "/sound/traffic/train_car_pas.soundref"
	
	displacement_limit: 0.0

}

vehicle_accessory: .dd.cart1.chassis
{
	data_path: "/def/vehicle/ai/train_dutch_double/cart1.sii"
}

vehicle_wheel_accessory: .dd.cart1.rwheel0
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_empty_50cm.sii"
}

vehicle_wheel_accessory: .dd.cart1.rwheel1
{
	offset: 2
	data_path: "/def/vehicle/ai_wheel/rear_empty_50cm.sii"
}



