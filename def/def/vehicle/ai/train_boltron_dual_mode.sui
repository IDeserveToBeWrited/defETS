###########################
##
##  boltron_dual_mode - default
##
###########################

traffic_vehicle : traffic.boltrondual
{
	accessories[]: .boltrondual.chassis
	accessories[]: .boltrondual.fwheel
	accessories[]: .boltrondual.rwheel

	variant[]: traffic.boltrondua2

	max_speed: 120

	vehicle_mass: 83000
	engine_power: 3720

	trailer_chains[]: "train_cargo 6-10"

	sound_move[]: "/sound/traffic/train_electric_1.soundref"
	sound_gears: 1

	displacement_limit: 0.0

	spawn_ratio: 0.0

	tags[]: cargo

}

vehicle_accessory: .boltrondual.chassis
{
	data_path: "/def/vehicle/ai/train_boltron_dual_mode/chassis.sii"
}

vehicle_wheel_accessory: .boltrondual.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_empty_50cm.sii"
}

vehicle_wheel_accessory: .boltrondual.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_empty_50cm.sii"
}

