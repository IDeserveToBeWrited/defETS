# XXXXXXXXXXXXXXXXXXX Netherlands Police XXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.betrude.suv.luxury_25.nl
{
	accessories[]: .betrude.suv.luxury_25.nl.chassis
	accessories[]: .betrude.suv.luxury_25.nl.fwheel
	accessories[]: .betrude.suv.luxury_25.nl.rwheel

	max_speed: 160

	vehicle_mass: 1600

	sound_move[]: "/sound/traffic/car_default_2.soundref"
	sound_move[]: "/sound/traffic/car_diesel_2.soundref"
	sound_move[]: "/sound/traffic/car_sport_1.soundref"

	spawn_ratio: 0

@include "drivers_generic_police.sui"


@include "drivers_generic.sui"	
}

vehicle_accessory: .betrude.suv.luxury_25.nl.chassis
{
	data_path: "/def/vehicle/ai/betrude_suv_luxury_25/chassis_nl.sii"
}

