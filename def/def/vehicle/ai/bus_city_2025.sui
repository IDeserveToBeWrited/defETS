
################################ Netherlands - Eindhover ###################################
############################################################################################

traffic_vehicle : traffic.bus_city25.nl_ei
{
	accessories[]: .bus_city25.nl_ei.chassis
	accessories[]: .bus_city25.nl_ei.fwheel
	accessories[]: .bus_city25.nl_ei.rwheel

	max_speed: 80

	vehicle_mass: 18000

	sound_move[]: "/sound/traffic/bus_1.soundref"

	spawn_ratio: 0
	tags[]: passenger

spawn_condition[]: .traffic.bus_city25.nl_ei.condition.city

@include "drivers_generic.sui"
}

vehicle_accessory: .bus_city25.nl_ei.chassis
{
	data_path: "/def/vehicle/ai/bus_city_2025/nl_ei.sii"
}

vehicle_wheel_accessory: .bus_city25.nl_ei.fwheel
{
	offset: 0
	data_path: "/def/vehicle/f_wheel/steel.sii"
}

vehicle_wheel_accessory: .bus_city25.nl_ei.rwheel
{
	offset: 0
	data_path: "/def/vehicle/r_wheel/steel.sii"
}

traffic_spawn_condition: .traffic.bus_city25.nl_ei.condition.city
{
	type: city
	str_param[]: "eindhoven"
}


