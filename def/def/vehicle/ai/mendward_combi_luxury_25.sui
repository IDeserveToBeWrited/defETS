############### Default ########################

traffic_vehicle : traffic.mendward.combi.luxury.25
{
	accessories[]: .mendward.combi.luxury.25.chassis
	accessories[]: .mendward.combi.luxury.25.fwheel
	accessories[]: .mendward.combi.luxury.25.rwheel
	
	


	max_speed: 140

	

	vehicle_mass: 1000

	sound_move[]: "/sound/traffic/car_default_3.soundref"
	sound_move[]: "/sound/traffic/car_default_4.soundref"
	
	spawn_ratio: 1


@include "drivers_generic.sui"
}

vehicle_accessory: .mendward.combi.luxury.25.chassis
{
	data_path: "/def/vehicle/ai/mendward_combi_luxury_25/chassis.sii"
}

vehicle_wheel_accessory: .mendward.combi.luxury.25.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_19in_l.sii"
}

vehicle_wheel_accessory: .mendward.combi.luxury.25.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_19in_l.sii"
}







