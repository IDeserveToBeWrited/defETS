traffic_vehicle : traffic.mam_loco
{
	accessories[]: .mam_loco.chassis
	accessories[]: .mam_loco.fwheel
	accessories[]: .mam_loco.rwheel

	max_speed: 80

	vehicle_mass: 22000	#
	engine_power: 520	#

	trailer_chains[]: "tram_car.mam_car1 | tram_car.mam_car2 | tram_car.mam_car3 | tram_car.mam_car4 | tram_car.mam_end"

	sound_move[]: "/sound/traffic/tram_1.soundref"
	sound_horn[]: "/sound/traffic/tram_horn_1.soundref"
	sound_gears: 1

	displacement_limit: 0.0

	spawn_ratio: 1.0

	lod_dist[]: 50
	lod_dist[]: 100
	lod_dist[]: 150

	tags[]: metro

	spawn_condition[]: .traffic.mam_loco.condition.city
}

vehicle_accessory: .mam_loco.chassis
{
	data_path: "/def/vehicle/ai/metro_amsterdam/chassis_loco.sii"
}
vehicle_wheel_accessory: .mam_loco.fwheel
{
	data_path: "/def/vehicle/ai_wheel/front_empty_50cm.sii"
}
vehicle_wheel_accessory: .mam_loco.rwheel
{
	data_path: "/def/vehicle/ai_wheel/rear_empty_50cm.sii"
}
traffic_spawn_condition: .traffic.mam_loco.condition.city
{
	# spawn only near city with specified name
	type: city
	str_param[]: "amsterdam"
}