skill_data : .skills.sat_increase
{
    max_rank: 3

    icon_mat: "sat_increase"
    name: "@@skill_satisfaction_increase_title@@"
    description: "@@skill_satisfaction_increase_info@@"

    rank_icons[]: "linear_rank_1"
    rank_icons[]: "linear_rank_2"
    rank_icons[]: "linear_rank_3"

    rank_descriptions[]: "<align hstyle=center vstyle=top><font face=/font/normal_bold.font><color value=$STATE_COLOR$>@@rank@@ 1</color></font><br><br>
<font face=/font/normal.font><color value=@@clr_skill_desc_unimportant@@>
@@satisfaction_increase_desc@@</color></font>"

    rank_descriptions[]: "<align hstyle=center vstyle=top><font face=/font/normal_bold.font><color value=$STATE_COLOR$>@@rank@@ 2</color></font><br><br>
<font face=/font/normal.font><color value=@@clr_skill_desc_unimportant@@>
@@satisfaction_increase_desc@@</color></font>"

    rank_descriptions[]: "<align hstyle=center vstyle=top><font face=/font/normal_bold.font><color value=$STATE_COLOR$>@@rank@@ 3</color></font><br><br>
<font face=/font/normal.font><color value=@@clr_skill_desc_unimportant@@>
@@satisfaction_increase_desc@@</color></font>"


    rank_tooltips[]: "<font face=/font/normal_bold.font><color value=@@clr_white@@>@@rank@@ 1</color></font><br><br>
<font face=/font/normal.font><color value=@@clr_skill_desc_unimportant@@>
@@satisfaction_increase_desc@@</color></font>"

    rank_tooltips[]: "<font face=/font/normal_bold.font><color value=@@clr_white@@>@@rank@@ 2</color></font><br><br>
<font face=/font/normal.font><color value=@@clr_skill_desc_unimportant@@>
@@satisfaction_increase_desc@@</color></font>"

    rank_tooltips[]: "<font face=/font/normal_bold.font><color value=@@clr_white@@>@@rank@@ 3</color></font><br><br>
<font face=/font/normal.font><color value=@@clr_skill_desc_unimportant@@>
@@satisfaction_increase_desc@@</color></font>"

    additional_data: .skills.sat_increase.pos_satis
}

skill_percentage_increase : .skills.sat_increase.pos_satis
{
    percentage_increase_per_rank[]: 0.1
    percentage_increase_per_rank[]: 0.2
    percentage_increase_per_rank[]: 0.3
}


